{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "sososoop",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": true,
	"vars": {
		// Supabase 공개키(클라이언트 번들에도 노출되는 값) — Worker 런타임에서도 접근 가능하게.
		"NEXT_PUBLIC_SUPABASE_URL": "https://fqpjhgenuuxpatrcipwb.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_jsZy-cACk0aNmJfQry10gQ_85R7D7rr"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// OpenNext 증분 캐시(ISR/SSG) 저장소 — 상세페이지가 매 요청 풀 SSR 되지 않도록 캐시.
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "e9361786645a4cc6b87b5b4249d2ce8b"
		},
		// 태그 캐시 — '사이트 새로고침' 시각을 기록. 키가 `빌드ID/_N_T_…`라 증분 캐시(incremental-cache/…)와 같은 네임스페이스를 써도 겹치지 않는다.
		{
			"binding": "NEXT_TAG_CACHE_KV",
			"id": "e9361786645a4cc6b87b5b4249d2ce8b"
		}
	],
	"routes": [
		{
			"pattern": "sososoop.com",
			"custom_domain": true
		}
	]
}
