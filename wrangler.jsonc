{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "sososoop",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": true,
	"vars": {
		// Supabase 공개키(클라이언트 번들에도 노출되는 값) — Worker 런타임에서도 접근 가능하게.
		"NEXT_PUBLIC_SUPABASE_URL": "https://fqpjhgenuuxpatrcipwb.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_jsZy-cACk0aNmJfQry10gQ_85R7D7rr"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// OpenNext 증분 캐시(ISR/SSG) 저장소 — 상세페이지가 매 요청 풀 SSR 되지 않도록 캐시.
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "e9361786645a4cc6b87b5b4249d2ce8b"
		}
	],
	// 태그 캐시 — '사이트 새로고침' 시각을 기록. 매 요청마다 읽으므로 KV(무료 읽기 10만/일)가 아니라
	// D1(무료 행 읽기 500만/일)에 둔다. 2026-10-13 KV 태그 캐시로 하루 만에 읽기 한도 90% 도달.
	"d1_databases": [
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "sososoop-tag-cache",
			"database_id": "842bb632-5f74-4d62-a3d8-09f545492772"
		}
	],
	"routes": [
		{
			"pattern": "sososoop.com",
			"custom_domain": true
		}
	]
}
