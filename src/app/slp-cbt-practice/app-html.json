"<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>언어재활사 CBT 연습</title>\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css\">\n<style>\n:root{\n  /* 새 팔레트 · 민트 + 코발트 · 소프트 뉴브루탈리즘(얇은 검정 테두리 · 각진 모서리 · 그림자 없음) */\n  --mint:#12B5A5; --mint-soft:#e1f6f2; --mint-d:#0e9488;\n  --pop:#3B5BDB;  --pop-soft:#e5e9fb; --pop-d:#2f49b0;\n  --ink:#1a1a1a;  --gray:#6b7280;\n  --red:#e0342a;  --amber:#e8931c;\n  --bg:#e9e9e4;   --paper:#fff;\n  --bd:1.5px solid var(--ink);\n  /* ── 레거시 변수명 호환(인라인 스타일 대비) ── */\n  --navy:#1a1a1a; --navy-d:#000; --navy-btn:#3B5BDB;\n  --blue:#3B5BDB; --blue-l:#e5e9fb; --teal:#12B5A5;\n  --line:#1a1a1a; --omr:#12B5A5; --canvas:#fff; --pearl:#f4f4ef;\n  --ink-muted:#6b7280;\n}\n*{margin:0;padding:0;box-sizing:border-box;}\nhtml,body{height:100%;}\nbody{font-family:\"Pretendard Variable\",Pretendard,\"Apple SD Gothic Neo\",\"Malgun Gothic\",sans-serif;background:var(--paper);color:var(--ink);overflow:hidden;}\nbutton{font-family:inherit;cursor:pointer;}\n.hidden{display:none!important;}\n\n/* ───── 시작(로그인) 화면 ───── */\n#startScreen{height:100vh;display:flex;flex-direction:column;overflow:auto;background:var(--bg);}\n.start-top{background:#fff;color:var(--ink);display:flex;align-items:center;justify-content:space-between;padding:12px 22px;min-height:64px;border-bottom:var(--bd);flex-shrink:0;}\n.start-top .clockbox{text-align:right;font-size:13px;line-height:1.5;font-weight:600;}\n.login-wrap{max-width:900px;margin:26px auto;background:#fff;border:var(--bd);overflow:hidden;width:94%;flex-shrink:0;}\n.login-title{background:var(--mint);color:#fff;text-align:center;font-size:24px;font-weight:900;padding:15px;border-bottom:var(--bd);}\n.login-body{padding:24px 30px;}\n.login-notice{background:var(--mint-soft);border:var(--bd);text-align:center;padding:15px;font-weight:800;margin-bottom:20px;color:var(--ink);}\n.login-table{display:flex;gap:0;border:var(--bd);}\n.photo-col{width:170px;border-right:var(--bd);display:flex;flex-direction:column;}\n.photo{flex:1;display:flex;align-items:center;justify-content:center;background:#f4f4ef;font-size:60px;color:#b6c0ae;min-height:160px;}\n.seat{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px;border-top:var(--bd);}\n.seat-circle{width:82px;height:82px;background:var(--mint);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:900;border:var(--bd);}\n.seat-circle small{font-size:11px;font-weight:700;}\n.seat-circle span{font-size:28px;line-height:1;}\n.info-col{flex:1;}\n.info-row{display:flex;border-bottom:var(--bd);min-height:50px;}\n.info-row:last-child{border-bottom:none;}\n.info-row .th{width:150px;background:#f4f4ef;color:var(--ink);font-weight:800;display:flex;align-items:center;padding-left:16px;border-right:var(--bd);}\n.info-row .td{flex:1;display:flex;align-items:center;padding-left:14px;gap:8px;flex-wrap:wrap;}\n.info-row input[type=text]{border:var(--bd);padding:8px 10px;font-size:15px;width:220px;background:#fff;}\n.info-row input[type=text]::placeholder{color:var(--gray);opacity:.55;}\n.info-row-name{min-height:78px;}\n.info-row-name .td{flex-direction:column;align-items:flex-start;justify-content:center;gap:6px;padding-top:10px;padding-bottom:10px;}\n.name-hint{font-size:12px;color:var(--gray);width:100%;}\n.sess-btn{border:var(--bd);background:#fff;padding:9px 15px;font-size:13.5px;font-weight:700;color:var(--ink);}\n.sess-btn.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.login-foot{background:#f4f4ef;padding:18px;text-align:center;border-top:var(--bd);}\n.login-btn{background:var(--pop);color:#fff;border:var(--bd);border-color:var(--pop);font-size:19px;font-weight:900;padding:13px 64px;}\n.login-btn:hover{background:var(--pop-d);}\n.start-hint{font-size:12.5px;color:var(--gray);margin-top:10px;line-height:1.6;}\n.disclaimer{font-size:11.5px;color:#9aa08f;margin-top:14px;padding-top:12px;border-top:1px dashed #c9c9bf;line-height:1.6;}\n\n/* ───── 시험 화면 레이아웃 ───── */\n#examScreen{height:100vh;display:flex;flex-direction:column;}\n.exam-header{background:#fff;color:var(--ink);display:flex;align-items:center;justify-content:space-between;padding:0 16px;height:62px;flex:0 0 62px;border-bottom:var(--bd);}\n.eh-left{display:flex;align-items:center;gap:10px;}\n.seat-mini{width:40px;height:40px;background:var(--mint);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:900;border:var(--bd);}\n.eh-left .who{font-size:12.5px;line-height:1.5;}\n.eh-title{font-size:18px;font-weight:900;position:absolute;left:50%;transform:translateX(-50%);white-space:nowrap;}\n.eh-right{display:flex;align-items:center;gap:12px;}\n.util-label{font-size:11px;text-align:center;line-height:1.2;color:var(--gray);font-weight:700;}\n.font-btns,.layout-btns{display:flex;gap:5px;align-items:flex-end;}\n.fbtn{width:42px;border:var(--bd);background:#fff;color:var(--ink);padding:6px 0 3px;display:flex;flex-direction:column;align-items:center;font-weight:800;}\n.fbtn small{font-size:9px;color:var(--gray);}\n.fbtn.f80{font-size:13px;} .fbtn.f100{font-size:16px;} .fbtn.f125{font-size:19px;}\n.fbtn.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.fbtn.active small{color:#fff;}\n.lbtn{width:38px;height:38px;border:var(--bd);background:#fff;padding:5px;display:flex;gap:3px;}\n.lbtn div{flex:1;background:var(--mint);}\n.lbtn.active{background:var(--pop);border-color:var(--pop);} .lbtn.active div{background:#fff;}\n.divider{width:1.5px;height:36px;background:var(--ink);}\n.timerbox{display:flex;align-items:center;gap:8px;}\n.clock-ic{width:36px;height:36px;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;border:var(--bd);}\n.timerbox .txt{font-size:12.5px;line-height:1.5;font-weight:600;}\n.timerbox .remain{color:var(--ink);font-weight:800;}\n.timerbox .remain b{background:var(--red);color:#fff;padding:0 5px;font-size:14px;}\n\n.exam-main{flex:1;display:flex;min-height:0;}\n/* 왼쪽 세로 툴바 */\n.leftbar{flex:0 0 auto;width:158px;background:#fafafa;border-right:var(--bd);display:flex;flex-direction:column;gap:12px;padding:12px 8px;overflow-y:auto;}\n.toolv{border:var(--bd);background:#fff;color:var(--ink);font-weight:800;font-size:13px;padding:10px 4px;display:flex;flex-direction:column;align-items:center;gap:4px;}\n.toolv .tv-ic{font-size:18px;line-height:1;}\n.toolv:hover{background:var(--mint-soft);}\n.toolgroup{border:var(--bd);background:#fff;padding:8px;display:flex;flex-direction:column;gap:6px;align-items:center;}\n.toollabel{font-size:11px;font-weight:800;color:var(--gray);}\n.leftbar .font-btns{gap:4px;} .leftbar .fbtn{width:38px;}\n/* 문제 컬럼 + 상단 진행바 */\n.paper-col{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0;}\n.progline{flex:0 0 auto;display:flex;align-items:center;gap:12px;padding:10px 18px;border-bottom:var(--bd);background:#fff;}\n.prognum{font-weight:800;font-size:13px;white-space:nowrap;color:var(--ink);}\n.progwrap{flex:1;height:12px;border:var(--bd);background:#fff;overflow:hidden;}\n.progbar{height:100%;width:0%;background:var(--pop);transition:width .2s;}\n.paper{flex:1;background:#fff;overflow-y:auto;padding:18px 20px;min-width:0;}\n.paper-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 24px;}\n.paper-grid.one{grid-template-columns:1fr;max-width:820px;margin:0 auto;}\n.qcol{border-right:none;padding-right:0;}\n.paper-grid.one .qcol,.qcol:last-child{border-right:none;padding-right:0;}\n\n.qcard{background:#fff;border:var(--bd);padding:16px 18px 20px;margin-bottom:16px;}\n.qtools{display:flex;flex-direction:column;align-items:flex-end;gap:4px;margin-bottom:6px;}\n.qtools-row{display:flex;gap:6px;}\n.tool-btn{border:var(--bd);background:#fff;color:var(--ink);font-size:12px;padding:4px 10px;font-weight:700;display:flex;align-items:center;gap:4px;}\n.tool-btn.on{background:var(--pop);color:#fff;border-color:var(--pop);}\n.tool-btn.memo-on{background:var(--amber);color:#fff;border-color:var(--amber);}\n.tool-btn.pen-on{background:#e8a400;color:#fff;border-color:#e8a400;}\n.qhead{font-weight:800;font-size:1.05em;display:flex;gap:8px;margin-bottom:10px;line-height:1.55;}\n.qhead .subj{color:#fff;font-size:.78em;font-weight:800;background:var(--mint);padding:3px 10px;align-self:flex-start;margin-top:2px;white-space:nowrap;}\n.stem{border:var(--bd);padding:12px 14px;margin:0 0 12px;line-height:1.7;background:var(--mint-soft);white-space:pre-wrap;}\n.qimg-wrap{margin:0 0 12px;}\n.qimg{max-width:100%;max-height:220px;width:auto;height:auto;border:var(--bd);display:block;cursor:zoom-in;background:#fff;}  /* 문제 화면은 작게, 크게 보기는 팝업 창에서 */\n.qimg-hint{margin-top:6px;}\n.qimg-btn{border:var(--bd);background:#fff;padding:4px 10px;font-size:12.5px;font-weight:700;color:var(--ink);cursor:pointer;}\n.qimg-btn:hover{background:var(--mint-soft);}\n/* 문항 이미지 크게 보기(팝업) */\nu.ul{text-decoration:underline;text-decoration-thickness:1.5px;text-underline-offset:4px;}\n/* 문항 이미지 창 — 제목줄 끌어 이동, 오른쪽 아래 모서리 끌어 크기조절(모바일은 전체화면) */\n#imgWin{z-index:70;display:flex;flex-direction:column;min-width:260px;min-height:180px;box-shadow:0 10px 30px rgba(0,0,0,.3);}\n#imgWin .iw-tip{font-weight:500;font-size:12px;opacity:.85;margin-left:10px;}\n#imgWin .iw-body{flex:1;min-height:0;background:#fff;padding:8px;display:flex;align-items:center;justify-content:center;}\n#imgWin .iw-body img{width:100%;height:100%;object-fit:contain;display:block;}\n#imgWin .iw-grip{position:absolute;right:0;bottom:0;width:22px;height:22px;cursor:nwse-resize;background:linear-gradient(135deg,transparent 0 50%,#555 50% 58%,transparent 58% 68%,#555 68% 76%,transparent 76%);}\n@media (max-width:699px){ #imgWin .iw-grip,#imgWin .iw-tip{display:none;} }\n.choices{list-style:none;}\n.choices li{display:flex;align-items:flex-start;gap:9px;padding:9px 11px;line-height:1.6;border:var(--bd);margin-bottom:7px;background:#fff;}\n.choices li .num{flex:0 0 auto;width:1.6em;height:1.6em;border:var(--bd);display:flex;align-items:center;justify-content:center;font-size:.85em;font-weight:800;margin-top:.05em;}\n.choices li .ctext{flex:1;cursor:pointer;}\n.choices li:hover{background:#f7f7f2;}\n.choices li.sel{background:var(--pop-soft);border-color:var(--pop);}\n.choices li.sel .num{background:var(--pop);color:#fff;border-color:var(--pop);}\n.choices li.sel .ctext{font-weight:800;}\n.choices li.strike .ctext{color:#b0b0b0;text-decoration:line-through;}\n.choices li.strike .num{border-color:#b0b0b0;color:#b0b0b0;}\n.strike-btn{flex:0 0 auto;border:var(--bd);background:#fff;color:var(--gray);font-size:11px;padding:2px 7px;margin-top:2px;}\n.strike-btn.on{background:var(--ink);color:#fff;border-color:var(--ink);}\n\n/* OMR */\n.omr{flex:0 0 208px;background:#fafafa;border-right:var(--bd);display:flex;flex-direction:column;}\n.omr-tools{display:flex;gap:6px;padding:8px 8px 0;}\n.omr-tools button{flex:1;border:var(--bd);background:#fff;padding:6px 0;font-size:12px;font-weight:800;color:var(--ink);}\n.omr-tools button:hover{background:var(--mint-soft);}\n.omr-title{background:var(--mint);color:#fff;text-align:center;font-weight:900;padding:10px;font-size:15px;flex:0 0 auto;border-bottom:var(--bd);}\n.omr-list{flex:1;overflow-y:auto;padding-bottom:10px;}\n.omr-row{display:flex;align-items:center;padding:4px 6px 4px 4px;}\n.omr-row.sep{border-bottom:1px dashed var(--mint);}\n.omr-row .flags{width:26px;display:flex;flex-direction:column;font-size:10px;line-height:1;gap:1px;align-items:center;color:var(--amber);}\n.omr-row .flags .chk{color:var(--red);}\n.omr-row .no{width:26px;text-align:center;color:var(--ink);font-weight:800;font-size:13px;background:#fff;border:var(--bd);padding:3px 0;margin-right:5px;cursor:pointer;}\n.omr-row.cur .no{background:var(--pop);color:#fff;border-color:var(--pop);}\n.omr-row .bubbles{display:flex;gap:4px;}\n.bub{width:22px;height:22px;border:var(--bd);color:var(--ink);background:#fff;font-size:11px;display:flex;align-items:center;justify-content:center;padding:0;}\n.bub.mark{background:var(--pop);border-color:var(--pop);color:#fff;}\n\n/* 하단바 */\n.exam-footer{background:#f4f4ef;border-top:var(--bd);display:flex;align-items:center;justify-content:space-between;padding:0 12px;height:60px;flex:0 0 60px;gap:8px;}\n.ef-group{display:flex;align-items:center;gap:8px;}\n.wbtn{background:#fff;border:var(--bd);padding:9px 15px;font-size:13.5px;font-weight:700;color:var(--ink);}\n.wbtn:hover{background:var(--mint-soft);}\n.wbtn.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.pager{display:flex;align-items:center;gap:10px;font-size:16px;font-weight:800;}\n.pager .pbtn{background:#fff;border:var(--bd);padding:9px 16px;font-size:14px;font-weight:800;color:var(--ink);}\n.pager .pbtn:hover{background:var(--mint-soft);}\n.submit-btn{background:var(--pop);color:#fff;border:var(--bd);border-color:var(--pop);padding:11px 20px;font-size:14px;font-weight:800;}\n.submit-btn:hover{background:var(--pop-d);}\n\n/* 모달 */\n.overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;z-index:90;}\n.modal{background:#fff;border:var(--bd);min-width:340px;max-width:560px;overflow:hidden;}\n.modal-head{background:var(--red);color:#fff;font-weight:900;text-align:center;padding:12px;position:relative;font-size:16px;border-bottom:var(--bd);}\n.modal-head.blue{background:var(--pop);}\n.modal-head .x{position:absolute;right:10px;top:8px;background:none;border:none;color:#fff;font-size:20px;}\n.modal-body{padding:24px 28px;text-align:center;font-size:15.5px;line-height:1.7;}\n.modal-body .big-clock{width:54px;height:54px;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 14px;border:var(--bd);}\n.modal-foot{padding:0 0 20px;text-align:center;display:flex;gap:10px;justify-content:center;}\n.m-btn{border:var(--bd);padding:10px 24px;font-size:14px;font-weight:800;color:#fff;background:var(--red);border-color:var(--red);}\n.m-btn.gray{background:var(--gray);border-color:var(--gray);}\n.m-btn.blue{background:var(--pop);border-color:var(--pop);}\n\n/* 메모/계산기/그림판 */\n.float-win{position:fixed;z-index:60;background:#fff;border:var(--bd);overflow:hidden;}\n.fw-head{background:var(--mint);color:#fff;padding:9px 12px;font-weight:800;cursor:move;display:flex;justify-content:space-between;align-items:center;font-size:14px;border-bottom:var(--bd);}\n.fw-head button{background:none;border:none;color:#fff;font-size:17px;}\n#memoText{width:320px;height:180px;border:none;outline:none;padding:12px;font-size:14px;resize:none;font-family:inherit;}\n.calc-body{padding:10px;width:230px;}\n#calcDisp{width:100%;border:var(--bd);text-align:right;font-size:22px;padding:8px;margin-bottom:8px;font-family:inherit;}\n.calc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;}\n.calc-grid button{padding:11px 0;font-size:16px;border:var(--bd);background:#fff;font-weight:700;}\n.calc-grid button.op{background:var(--mint-soft);font-weight:800;}\n.calc-grid button.eq{background:var(--pop);color:#fff;border-color:var(--pop);grid-column:span 2;}\n#padCanvas{display:block;background:#fff;cursor:crosshair;}\n.pad-tools{display:flex;gap:6px;padding:8px;background:var(--mint-soft);border-bottom:var(--bd);}\n.pad-tools button{border:var(--bd);background:#fff;padding:5px 12px;font-size:13px;font-weight:700;}\n.pad-tools button.on{background:var(--pop);color:#fff;border-color:var(--pop);}\n\n/* 결과 화면 */\n#resultScreen{height:100vh;overflow-y:auto;background:var(--bg);}\n.res-wrap{max-width:860px;margin:26px auto 60px;width:94%;}\n.res-card{background:#fff;border:var(--bd);overflow:hidden;margin-bottom:20px;}\n.res-title{background:var(--mint);color:#fff;font-size:21px;font-weight:900;text-align:center;padding:15px;border-bottom:var(--bd);}\n.res-body{padding:26px 30px;}\n.verdict{text-align:center;font-size:30px;font-weight:900;margin-bottom:6px;}\n.verdict.pass{color:var(--mint-d);} .verdict.fail{color:var(--red);}\n.verdict-sub{text-align:center;color:var(--gray);margin-bottom:20px;font-size:13.5px;line-height:1.6;}\ntable.score{width:100%;border-collapse:collapse;font-size:14.5px;}\ntable.score th,table.score td{border:var(--bd);padding:10px;text-align:center;}\ntable.score th{background:var(--mint-soft);color:var(--ink);font-weight:800;}\ntable.score td.bad{color:var(--red);font-weight:800;}\ntable.score tr.total td{font-weight:900;background:#f4f4ef;}\n.res-actions{display:flex;gap:10px;justify-content:center;margin-top:24px;flex-wrap:wrap;}\n.review-filter{display:flex;gap:8px;justify-content:center;margin-bottom:18px;}\n.rv-card{background:#fff;border:var(--bd);padding:20px 22px;margin-bottom:14px;}\n.rv-card .rv-head{font-weight:800;margin-bottom:8px;line-height:1.6;}\n.rv-badge{display:inline-block;font-size:12px;font-weight:800;padding:2px 8px;margin-right:6px;color:#fff;border:var(--bd);}\n.rv-badge.ok{background:var(--mint-d);border-color:var(--mint-d);} .rv-badge.no{background:var(--red);border-color:var(--red);} .rv-badge.skip{background:var(--gray);border-color:var(--gray);}\n.rv-stem{border:var(--bd);padding:10px 12px;margin-bottom:10px;line-height:1.6;font-size:14px;background:var(--mint-soft);white-space:pre-wrap;}\n.rv-choices{list-style:none;font-size:14.5px;line-height:1.8;margin-bottom:10px;}\n.rv-choices li.correct{color:var(--mint-d);font-weight:800;}\n.rv-choices li.mine{text-decoration:underline;}\n.rv-choices li.mine.wrong{color:var(--red);font-weight:800;}\n.rv-explain{background:var(--mint-soft);border:var(--bd);border-left:5px solid var(--mint);padding:10px 14px;font-size:14px;line-height:1.7;}\n\n/* 문제 보기 모달 */\n.viewer{background:#fff;border:var(--bd);width:95vw;max-width:1120px;height:92vh;display:flex;flex-direction:column;overflow:hidden;}\n.viewer-head{background:var(--mint);color:#fff;font-size:19px;font-weight:900;text-align:center;padding:14px;position:relative;flex:0 0 auto;border-bottom:var(--bd);}\n.viewer-head .x{position:absolute;right:14px;top:10px;background:rgba(255,255,255,.25);border:1.5px solid #fff;color:#fff;font-size:18px;width:30px;height:30px;line-height:1;}\n.viewer-guide{padding:9px 20px;font-size:12.5px;color:var(--ink);background:var(--mint-soft);line-height:1.6;flex:0 0 auto;border-bottom:var(--bd);}\n.viewer-tabs{display:flex;flex:0 0 auto;}\n.v-tab{flex:1;padding:12px;font-size:15px;font-weight:800;border:var(--bd);border-top:none;background:#fff;color:var(--ink);}\n.v-tab.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.viewer-body{flex:1;overflow-y:auto;padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:14px;align-content:start;background:var(--bg);}\n.v-card{border:var(--bd);padding:13px 15px;cursor:pointer;background:#fff;}\n.v-card:hover{outline:2px solid var(--pop);border-color:var(--pop);}\n.v-head{display:flex;gap:8px;font-weight:800;margin-bottom:8px;line-height:1.55;font-size:14.5px;}\n.v-no{flex:0 0 auto;background:var(--pop);color:#fff;min-width:1.7em;height:1.7em;padding:0 .3em;display:flex;align-items:center;justify-content:center;font-size:.9em;border:var(--bd);}\n.v-stem{border:var(--bd);padding:8px 10px;margin-bottom:8px;font-size:12.5px;line-height:1.6;white-space:pre-wrap;background:var(--mint-soft);}\n.v-choices{list-style:none;font-size:13.5px;line-height:1.7;}\n.v-choices li.sel{font-weight:800;color:var(--pop);}\n\n/* 형광펜 */\nmark.hl{background:#ffe94d;color:inherit;padding:0;}\n.wbtn.pen-active{background:#e8a400;color:#fff;border-color:#e8a400;}\n.paper.pen-on .stem,.paper.pen-on .ctext,.paper.pen-on .qhead>span{cursor:text;}\n.paper.pen-on mark.hl{cursor:pointer;}\n@media (max-width:900px){ .eh-title{display:none;} .omr{flex-basis:190px;} }\n@media (max-width:760px){ .viewer-body{grid-template-columns:1fr;} }\n\n/* 인쇄(PDF 저장)용 — 결과 화면의 점수표 + 오답풀이만 출력 */\n#printHeader{display:none;}\n@media print{\n  @page{ margin:14mm; }\n  html,body{ height:auto!important; overflow:visible!important; background:#fff!important; }\n  body *{ visibility:hidden; }\n  #resultScreen, #resultScreen *{ visibility:visible; }\n  #resultScreen{ position:static!important; height:auto!important; overflow:visible!important; background:#fff!important; }\n  .res-wrap{ max-width:100%!important; margin:0!important; width:100%!important; }\n  .res-card, .rv-card{ border:1px solid #444; break-inside:avoid; }\n  .res-actions{ display:none!important; }\n  #printHeader{ display:block; text-align:center; margin-bottom:14px; }\n  #printHeader h1{ font-size:19px; color:#0e9488; }\n  #printHeader .sub{ font-size:12px; color:#555; margin-top:4px; }\n  .rv-card{ page-break-inside:avoid; }\n  .res-title{ background:#12B5A5!important; -webkit-print-color-adjust:exact; print-color-adjust:exact; }\n  .rv-badge, .v-no, table.score th, .omr-title{ -webkit-print-color-adjust:exact; print-color-adjust:exact; }\n}\n/* ── 로그인 게이트 ── */\n#authGate{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;background:var(--bg);padding:20px;}\n#authGate.hidden{display:none;}\n.ag-card{width:100%;max-width:380px;background:#fff;border:var(--bd);padding:34px 28px 24px;text-align:center;}\n.ag-logo{font-size:38px;line-height:1;}\n.ag-title{font-size:21px;font-weight:900;color:var(--ink);margin-top:10px;}\n.ag-sub{font-size:13px;color:var(--gray);margin-top:6px;line-height:1.5;}\n.ag-form{margin-top:22px;text-align:left;}\n.ag-label{display:block;font-size:12.5px;font-weight:800;color:var(--ink);margin:14px 2px 6px;}\n.ag-form input{width:100%;box-sizing:border-box;padding:12px 13px;border:var(--bd);font-size:15px;background:#fff;outline:none;}\n.ag-form input:focus{border-color:var(--pop);}\n.ag-err{min-height:18px;font-size:12.5px;color:var(--red);margin:10px 2px 0;line-height:1.4;}\n.ag-btn{width:100%;margin-top:8px;padding:13px;border:var(--bd);border-color:var(--mint);background:var(--mint);color:#fff;font-size:16px;font-weight:900;cursor:pointer;}\n.ag-btn:hover{background:var(--mint-d);}\n.ag-btn:disabled{opacity:.6;cursor:default;}\n.ag-note{margin-top:20px;font-size:11.5px;color:var(--gray);line-height:1.6;border-top:var(--bd);padding-top:15px;}\n.logout-btn{border:var(--bd);background:#fff;color:var(--ink);padding:7px 14px;font-size:12.5px;font-weight:700;cursor:pointer;white-space:nowrap;}\n.logout-btn:hover{background:var(--mint-soft);}\n\n/* ───── 대문(첫 화면) — 소소숲 정식판에서만 켠다(window.SHOW_HOME) ───── */\n#homeScreen{height:100vh;display:flex;flex-direction:column;overflow:auto;background:var(--bg);}\n.home-wrap{max-width:900px;width:94%;margin:26px auto 40px;display:flex;flex-direction:column;gap:18px;flex-shrink:0;}\n.home-hero{background:#fff;border:var(--bd);display:flex;align-items:stretch;}\n.home-hero-main{flex:1;padding:24px 28px;}\n.home-kicker{font-size:13px;font-weight:800;color:var(--mint-d);letter-spacing:.02em;}\n.home-hero h1{font-size:25px;font-weight:900;margin:6px 0 8px;line-height:1.35;}\n.home-hero-sub{font-size:14px;color:var(--gray);line-height:1.6;}\n.home-hero-sub b{color:var(--ink);}\n.home-dday{width:210px;flex-shrink:0;background:var(--mint);color:#fff;border-left:var(--bd);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:18px;text-align:center;}\n.home-dday small{font-size:13px;font-weight:700;opacity:.92;}\n.home-dday b{font-size:46px;font-weight:900;line-height:1.1;margin:4px 0;letter-spacing:-.01em;}\n.home-dday span{font-size:12.5px;font-weight:700;opacity:.92;}\n.home-cta{display:flex;justify-content:center;}\n.home-start{background:var(--pop);color:#fff;border:var(--bd);border-color:var(--pop);font-size:20px;font-weight:900;padding:15px 70px;}\n.home-start:hover{background:var(--pop-d);}\n.home-card{background:#fff;border:var(--bd);}\n.home-card h2{font-size:17px;font-weight:900;padding:13px 20px;border-bottom:var(--bd);background:#f4f4ef;display:flex;align-items:center;justify-content:space-between;gap:10px;}\n.home-card h2 small{font-size:12px;font-weight:600;color:var(--gray);}\n.home-card-body{padding:16px 20px;}\n.home-tbl{width:100%;border-collapse:collapse;font-size:14px;}\n.home-tbl th,.home-tbl td{border:1px solid #c9c9bf;padding:9px 12px;text-align:left;vertical-align:middle;line-height:1.5;}\n.home-tbl th{background:#f4f4ef;font-weight:800;white-space:nowrap;}\n.home-tbl td.num{text-align:center;white-space:nowrap;}\n.home-tbl tr.is-next td{background:var(--mint-soft);font-weight:700;}\n.home-tbl tr.is-done td{color:#9aa08f;}\n.home-tag{display:inline-block;font-size:11.5px;font-weight:800;padding:2px 8px;border:1px solid currentColor;white-space:nowrap;}\n.home-tag.done{color:#9aa08f;}\n.home-tag.now{color:var(--red);}\n.home-tag.next{color:var(--mint-d);}\n.home-tag.plan{color:var(--gray);}\n.home-grade-tabs{display:flex;gap:6px;margin-bottom:12px;}\n.home-grade-tabs button{border:var(--bd);background:#fff;padding:7px 18px;font-size:13.5px;font-weight:800;}\n.home-grade-tabs button.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.home-list{list-style:none;display:flex;flex-direction:column;gap:9px;font-size:14px;line-height:1.6;}\n.home-list li{padding-left:16px;position:relative;}\n.home-list li::before{content:'';position:absolute;left:2px;top:.62em;width:6px;height:6px;background:var(--mint);}\n.home-list li b{font-weight:800;}\n.home-video{display:flex;align-items:center;gap:14px;margin-top:16px;padding:13px 16px;border:var(--bd);background:var(--pop-soft);color:var(--ink);text-decoration:none;}\n.home-video:hover{background:#d6ddf8;}\n.home-video-ic{width:44px;height:44px;flex-shrink:0;background:var(--pop);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;border:var(--bd);border-color:var(--pop);}\n.home-video b{display:block;font-size:14.5px;font-weight:900;}\n.home-video small{font-size:12.5px;color:var(--gray);}\n.home-links{display:flex;flex-wrap:wrap;gap:8px;}\n.home-links a{border:var(--bd);background:#fff;color:var(--ink);text-decoration:none;font-size:13px;font-weight:700;padding:8px 13px;}\n.home-links a:hover{background:var(--mint-soft);}\n.home-note{font-size:12.5px;color:var(--gray);margin-top:10px;line-height:1.6;}\n.home-back{border:var(--bd);background:#fff;color:var(--ink);padding:7px 14px;font-size:12.5px;font-weight:700;white-space:nowrap;}\n.home-back:hover{background:var(--mint-soft);}\n.home-tbl-wrap{overflow-x:auto;}\n@media (max-width:720px){\n  .home-hero{flex-direction:column;}\n  .home-dday{width:auto;border-left:none;border-top:var(--bd);flex-direction:row;gap:12px;padding:12px;}\n  .home-dday b{font-size:34px;margin:0;}\n  .home-start{padding:14px 30px;width:100%;}\n  .home-tbl{font-size:13px;}\n  .home-tbl th,.home-tbl td{padding:8px;}\n}\n\n\n/* ── PC 전용 안내 (모바일·세로 태블릿 차단) ────────────────────────\n   터치 기기이면서 화면 폭이 900px 미만일 때만 뜬다.\n   마우스를 쓰는 노트북은 창을 좁혀도 막히지 않고,\n   아이패드는 가로(1024px)로 돌리면 통과한다.\n   화면을 돌리면 미디어쿼리가 다시 판정하므로 별도 스크립트가 없다. */\n#pcOnly{display:none;}\n@media (max-width:899px) and (pointer:coarse){\n  #pcOnly{\n    display:flex;position:fixed;inset:0;z-index:99999;\n    align-items:center;justify-content:center;\n    background:var(--bg,#eeeeea);padding:22px;\n    -webkit-text-size-adjust:100%;\n  }\n  html,body{overflow:hidden!important;}\n}\n.pc-card{width:100%;max-width:340px;background:#fff;border:2px solid #111;padding:32px 22px 24px;text-align:center;}\n.pc-icon{font-size:44px;line-height:1;}\n.pc-title{font-size:20px;font-weight:900;color:#1c1c1a;margin-top:12px;line-height:1.35;}\n.pc-desc{font-size:14px;color:#444;margin-top:14px;line-height:1.7;}\n.pc-url{margin-top:18px;border:1px dashed #999;background:#f7f7f3;padding:12px 10px;font-size:14px;font-weight:800;color:#1c1c1a;word-break:break-all;line-height:1.5;}\n.pc-note{margin-top:18px;border-top:1px solid #ddd;padding-top:14px;font-size:12px;color:#777;line-height:1.7;}\n</style>\n<script>window.SHOW_HOME = true;</script>\n</head>\n<body>\n\n<!-- ═════════ PC 전용 안내 (모바일에서만 표시) ═════════ -->\n<div id=\"pcOnly\">\n  <div class=\"pc-card\">\n    <div class=\"pc-icon\">💻</div>\n    <div class=\"pc-title\">PC에서 이용해 주세요</div>\n    <div class=\"pc-desc\">\n      실제 국가시험은 컴퓨터로 치릅니다.<br>\n      화면 구성과 조작을 그대로 연습하려면<br>\n      PC나 노트북으로 접속해 주세요.\n    </div>\n    <div class=\"pc-url\" id=\"pcOnlyUrl\"></div>\n    <div class=\"pc-note\">※ 위 주소를 PC 브라우저에 입력하시면<br>바로 시작할 수 있어요.</div>\n  </div>\n</div>\n\n\n<!-- ═════════ 시작(로그인) 화면 ═════════ -->\n<!-- ═════════ 로그인 게이트 (베타) ═════════ -->\n<div id=\"authGate\">\n  <div class=\"ag-card\">\n    <div class=\"ag-title\">언어재활사 CBT 연습</div>\n    <div class=\"ag-sub\" id=\"agSub\">베타 테스트 · 발급받은 계정으로 로그인해 주세요</div>\n    <div class=\"ag-form\">\n      <label class=\"ag-label\">아이디</label>\n      <input type=\"text\" id=\"agId\" autocomplete=\"username\" placeholder=\"예: slp01\" spellcheck=\"false\" autocapitalize=\"off\">\n      <label class=\"ag-label\">비밀번호</label>\n      <input type=\"password\" id=\"agPw\" autocomplete=\"current-password\" placeholder=\"비밀번호\" onkeydown=\"if(event.key==='Enter')doLogin()\">\n      <div id=\"agErr\" class=\"ag-err\"></div>\n      <button class=\"ag-btn\" id=\"agBtn\" onclick=\"doLogin()\">로그인</button>\n    </div>\n    <div class=\"ag-note\">※ 계정은 <b>최초 로그인한 기기 1대</b>에서만 사용할 수 있습니다.<br>기기 변경·문의는 관리자에게 연락해 주세요.</div>\n  </div>\n</div>\n\n<!-- ═════════ 대문(첫 화면) · 소소숲 정식판 전용 ═════════ -->\n<div id=\"homeScreen\" class=\"hidden\">\n  <div class=\"start-top\">\n    <div style=\"width:140px;\"></div>\n    <div style=\"font-weight:700;font-size:20px;\">언어재활사 CBT 연습</div>\n    <div style=\"width:140px;\"></div>\n  </div>\n  <div class=\"home-wrap\">\n    <div class=\"home-hero\">\n      <div class=\"home-hero-main\">\n        <div class=\"home-kicker\" id=\"hmKicker\">2026년도 제15회 언어재활사 국가시험</div>\n        <h1 id=\"hmHeadline\">시험일 12월 5일(토)<br>1급·2급 모두 컴퓨터시험(CBT)으로 봅니다</h1>\n        <div class=\"home-hero-sub\" id=\"hmSub\">실제 시험과 같은 교시·과목 구성으로 연습해 보세요.<br>시험 전날까지 <b>화면 조작과 시간 배분</b>에 익숙해지는 것이 목표예요.</div>\n      </div>\n      <div class=\"home-dday\" id=\"hmDdayBox\">\n        <small>시험까지</small>\n        <b id=\"hmDday\">D-00</b>\n        <span id=\"hmToday\"></span>\n      </div>\n    </div>\n\n    <div class=\"home-cta\"><button class=\"home-start\" onclick=\"goStart()\">모의 CBT 연습 &rarr;</button></div>\n\n    <div class=\"home-card\" id=\"hmScheduleCard\">\n      <h2>시험일정 <small>국시원 공고 기준 · 2026년 제15회</small></h2>\n      <div class=\"home-card-body\">\n        <div class=\"home-tbl-wrap\"><table class=\"home-tbl\" id=\"hmSchedule\"></table></div>\n        <div class=\"home-note\">※ 시험장은 11월 4일 공고 후 선택 기간에 직접 고릅니다. 일정은 바뀔 수 있으니 국시원 공지를 꼭 확인하세요.</div>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>교시별 시간표 <small>입장 마감 이후에는 들어갈 수 없어요</small></h2>\n      <div class=\"home-card-body\">\n        <div class=\"home-grade-tabs\">\n          <button class=\"active\" data-hg=\"1\" onclick=\"homeGrade(1)\">1급</button>\n          <button data-hg=\"2\" onclick=\"homeGrade(2)\">2급</button>\n        </div>\n        <div class=\"home-tbl-wrap\"><table class=\"home-tbl\" id=\"hmTimetable\"></table></div>\n        <div class=\"home-note\" id=\"hmTimeNote\"></div>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>합격 기준</h2>\n      <div class=\"home-card-body\">\n        <ul class=\"home-list\">\n          <li><b>전 과목 총점의 60% 이상</b>, 그리고 <b>각 과목 40% 이상</b>을 받아야 합격이에요.</li>\n          <li>한 과목이라도 40% 미만이면 총점이 높아도 불합격(과락)입니다. 약한 과목부터 챙기세요.</li>\n          <li>1급 140문항(140점) · 2급 150문항(150점), 모두 5지선다 객관식이며 문항당 1점이에요.</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>시험 당일 주의사항</h2>\n      <div class=\"home-card-body\">\n        <ul class=\"home-list\">\n          <li><b>응시표와 신분증</b>을 꼭 챙기세요. 학생증은 신분증으로 인정되지 않아요. 응시표는 11월 11일부터 국시원 홈페이지에서 출력할 수 있어요.</li>\n          <li><b>식수(생수)는 제공하지 않아요.</b> 필요하면 직접 준비하세요.</li>\n          <li><b>입장 마감 시간</b>까지 도착해야 합니다. 시험이 시작된 뒤에는 입실할 수 없어요.</li>\n          <li>휴대전화·스마트워치·이어폰·전자계산기 같은 <b>전자기기는 전원을 끄고 제출</b>합니다. 시험 중 갖고 있다가 적발되면 시험이 무효 처리될 수 있어요.</li>\n          <li><b>컴퓨터시험(CBT)</b>이라 화면에서 문제를 읽고 답을 고릅니다. 시험장은 본인이 직접 선택하므로 선택 기간(11. 4.~11. 8.)을 놓치지 마세요.</li>\n        </ul>\n        <a class=\"home-video\" href=\"https://youtu.be/KlSQ9l0bcYQ\" target=\"_blank\" rel=\"noopener\">\n          <span class=\"home-video-ic\">&#9654;</span>\n          <span><b>컴퓨터시험(CBT) 응시자 유의사항 안내 영상</b><small>한국보건의료인국가시험원 공식 유튜브 · 새 창으로 열려요</small></span>\n        </a>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>이 연습앱 이용 안내</h2>\n      <div class=\"home-card-body\">\n        <ul class=\"home-list\">\n          <li><b>PC·노트북</b>에서 이용해 주세요. 실제 시험과 같은 넓은 화면을 기준으로 만들었어요.</li>\n          <li>교시마다 <b>제한시간</b>이 적용되고, 시간이 다 되면 <b>자동으로 제출</b>됩니다.</li>\n          <li>채점도 실제 합격 기준(과목 40% · 평균 60%)으로 해서 과락 과목을 바로 알려드려요.</li>\n          <li>문항은 실제 시험의 과목 구성·유형을 따른 <b>창작 연습 문항</b>이며, 기출문제가 아니에요.</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>국시원 바로가기</h2>\n      <div class=\"home-card-body\">\n        <div class=\"home-links\">\n          <a href=\"https://www.kuksiwon.or.kr/subcnt/c_2024/1/view.do?seq=7&amp;itm_seq=37\" target=\"_blank\" rel=\"noopener\">언어재활사 시험일정</a>\n          <a href=\"https://www.kuksiwon.or.kr/subcnt/c_2024/7/view.do?seq=7&amp;itm_seq=37\" target=\"_blank\" rel=\"noopener\">시험과목·시간표</a>\n          <a href=\"https://www.kuksiwon.or.kr/subcnt/c_2024/5/view.do?seq=7&amp;itm_seq=37\" target=\"_blank\" rel=\"noopener\">합격기준</a>\n          <a href=\"https://www.kuksiwon.or.kr/notice/brd/m_51/view.do?seq=3990&amp;itm_seq_1=1&amp;etc1=37\" target=\"_blank\" rel=\"noopener\">CBT 종합안내서</a>\n          <a href=\"https://www.kuksiwon.or.kr/main/indexNew.do?seq=2\" target=\"_blank\" rel=\"noopener\">국시원 홈페이지</a>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"home-cta\"><button class=\"home-start\" onclick=\"goStart()\">모의 CBT 연습 &rarr;</button></div>\n    <div class=\"disclaimer\" style=\"text-align:center;border-top:none;margin-top:0;\">본 서비스는 한국보건의료인국가시험원(국시원)과 무관한 개인 학습용 연습 도구이며, 실제 기출문제가 아닌 창작 문항으로 구성되어 있습니다. 시험 정보는 국시원 공고를 요약한 것이므로 최종 확인은 국시원 홈페이지에서 해 주세요.</div>\n  </div>\n</div>\n\n<div id=\"startScreen\" class=\"hidden\">\n  <div class=\"start-top\">\n    <div style=\"width:140px;\"><button id=\"homeBackBtn\" class=\"home-back hidden\" onclick=\"backToHome()\">&larr; 처음 화면</button></div>\n    <div style=\"font-weight:700;font-size:20px;\">언어재활사 CBT 연습</div>\n    <div style=\"display:flex;align-items:center;gap:12px;\">\n      <button id=\"logoutBtn\" class=\"logout-btn\" onclick=\"doLogout()\" title=\"로그아웃\">로그아웃</button>\n    </div>\n  </div>\n  <div class=\"login-wrap\">\n    <div class=\"login-title\">응시 정보 입력</div>\n    <div class=\"login-body\">\n      <div class=\"login-notice\">오늘도 차분하게, 실전처럼 연습해 봐요!</div>\n      <div class=\"login-table\">\n        <div class=\"info-col\">\n          <div class=\"info-row\"><div class=\"th\">시험명</div><div class=\"td\" id=\"stTitle\"></div></div>\n          <div class=\"info-row\"><div class=\"th\">시험일</div><div class=\"td\" id=\"stDate\"></div></div>\n          <div class=\"info-row\" id=\"gradeRow\" style=\"display:none;\"><div class=\"th\">급수</div>\n            <div class=\"td\" id=\"gradeBtns\"></div>\n          </div>\n          <div class=\"info-row\" id=\"setRow\" style=\"display:none;\"><div class=\"th\">회차</div>\n            <div class=\"td\" id=\"setBtns\"></div>\n          </div>\n          <div class=\"info-row\"><div class=\"th\">교시</div>\n            <div class=\"td\" id=\"sessBtns\"></div>\n          </div>\n          <div class=\"info-row info-row-name\"><div class=\"th\">성명</div><div class=\"td\"><input type=\"text\" id=\"inName\" placeholder=\"소소숲\"><div class=\"name-hint\">※ 본인의 성명을 입력해 주세요.</div></div></div>\n          <div class=\"info-row\"><div class=\"th\">시험시간</div><div class=\"td\" id=\"stTime\"></div></div>\n        </div>\n      </div>\n      <div class=\"start-hint\">※ 교시를 선택하고 입장하기를 눌러 연습을 시작하세요.<br>※ 14회(2025) 1급 시험의 과목 구성·문항 유형을 따른 창작 연습 문항입니다(실제 기출 아님). 시험시간도 실제와 동일합니다.</div>\n      <div class=\"disclaimer\">본 서비스는 한국보건의료인국가시험원(국시원)과 무관한 개인 학습용 연습 도구이며, 실제 기출문제가 아닌 창작 문항으로 구성되어 있습니다.</div>\n    </div>\n    <div class=\"login-foot\">\n      <button class=\"login-btn\" onclick=\"startExam()\">입장하기</button>\n    </div>\n  </div>\n</div>\n\n<!-- ═════════ 시험 화면 ═════════ -->\n<div id=\"examScreen\" class=\"hidden\">\n  <div class=\"exam-header\" style=\"position:relative;\">\n    <div class=\"eh-left\">\n      <div class=\"eh-title\" id=\"exTitle\" style=\"position:static;transform:none;font-size:18px;\"></div>\n    </div>\n    <div class=\"timerbox\" style=\"position:absolute;left:50%;transform:translateX(-50%);\">\n      <div class=\"clock-ic\">&#128337;</div>\n      <div class=\"txt\">제한시간 : <span id=\"limitMin\"></span>분<br><span class=\"remain\">남은시간 : <b id=\"remainTxt\">--:--</b></span></div>\n    </div>\n    <div class=\"eh-right\">\n      <div class=\"who\" style=\"text-align:right;\">성명 : <span id=\"exName\"></span></div>\n    </div>\n  </div>\n\n  <div class=\"exam-main\">\n    <div class=\"leftbar\">\n      <button class=\"toolv\" onclick=\"toggleCalc()\"><span class=\"tv-ic\">&#128425;</span>계산기</button>\n      <button class=\"toolv\" onclick=\"togglePad()\"><span class=\"tv-ic\">&#9998;</span>그림판</button>\n      <div class=\"toolgroup\">\n        <div class=\"toollabel\">글자 크기</div>\n        <div class=\"font-btns\">\n          <button class=\"fbtn f80\" data-fs=\"0.85\">가<small>80%</small></button>\n          <button class=\"fbtn f100 active\" data-fs=\"1\">가<small>100%</small></button>\n          <button class=\"fbtn f125\" data-fs=\"1.22\">가<small>125%</small></button>\n        </div>\n      </div>\n      <div class=\"toolgroup\">\n        <div class=\"toollabel\">화면 배치</div>\n        <div class=\"layout-btns\">\n          <button class=\"lbtn active\" id=\"lay1\" title=\"1단 보기\"><div></div></button>\n          <button class=\"lbtn\" id=\"lay2\" title=\"2단 보기\"><div></div><div></div></button>\n        </div>\n      </div>\n    </div>\n    <div class=\"paper-col\">\n      <div class=\"progline\">\n        <span class=\"prognum\" id=\"progText\">0 / 0 문항 풀이</span>\n        <div class=\"progwrap\"><div class=\"progbar\" id=\"progBar\"></div></div>\n      </div>\n      <div class=\"paper\" id=\"paper\">\n        <div class=\"paper-grid\" id=\"paperGrid\"></div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"exam-footer\">\n    <div class=\"ef-group\">\n      <button class=\"wbtn\" onclick=\"goHome()\">&#8617; 처음으로</button>\n    </div>\n    <div class=\"pager\">\n      <button class=\"pbtn\" onclick=\"movePage(-1)\">&#9664; 이전</button>\n      <span id=\"pageInfo\">1/1</span>\n      <button class=\"pbtn\" onclick=\"movePage(1)\">다음 &#9654;</button>\n    </div>\n    <div class=\"ef-group\">\n      <button class=\"wbtn\" id=\"fAll\" onclick=\"openProblemViewer('all')\">전체 문제 (<span id=\"cntAll\">0</span>)</button>\n      <button class=\"wbtn\" id=\"fChk\" onclick=\"openProblemViewer('chk')\">체크 문제 (<span id=\"cntChk\">0</span>)</button>\n      <button class=\"wbtn\" id=\"fUn\" onclick=\"openProblemViewer('un')\">안푼 문제 (<span id=\"cntUn\">0</span>)</button>\n      <button class=\"submit-btn\" onclick=\"askSubmit()\">&#128229; 제출하기</button>\n    </div>\n  </div>\n</div>\n\n<!-- ═════════ 결과 화면 ═════════ -->\n<div id=\"resultScreen\" class=\"hidden\">\n  <div class=\"res-wrap\">\n    <div id=\"printHeader\">\n      <h1>언어재활사 CBT 연습 — 오답풀이</h1>\n      <div class=\"sub\" id=\"printMeta\"></div>\n    </div>\n    <div class=\"res-card\">\n      <div class=\"res-title\">시험 결과</div>\n      <div class=\"res-body\">\n        <div class=\"verdict\" id=\"verdict\"></div>\n        <div class=\"verdict-sub\">합격 기준: 전 과목 총점의 60% 이상 &amp; 매 과목 40% 이상 (실제 필기시험 기준)</div>\n        <table class=\"score\" id=\"scoreTable\"></table>\n        <div class=\"res-actions\">\n          <button class=\"wbtn\" onclick=\"setReviewFilter('wrong')\">틀린 문제만 보기</button>\n          <button class=\"wbtn\" onclick=\"setReviewFilter('all')\">전체 해설 보기</button>\n          <button class=\"wbtn\" onclick=\"savePDF('wrong')\">&#128190; 오답풀이 PDF</button>\n          <button class=\"wbtn\" onclick=\"savePDF('all')\">&#128190; 전체 해설 PDF</button>\n          <button class=\"submit-btn\" onclick=\"location.reload()\">처음으로 (다시 풀기)</button>\n        </div>\n      </div>\n    </div>\n    <div id=\"reviewArea\"></div>\n    <div class=\"disclaimer\" style=\"text-align:center;border-top:none;\">본 서비스는 한국보건의료인국가시험원(국시원)과 무관한 개인 학습용 연습 도구이며, 실제 기출문제가 아닌 창작 문항으로 구성되어 있습니다.</div>\n  </div>\n</div>\n\n<!-- ═════════ 모달들 ═════════ -->\n<div class=\"overlay hidden\" id=\"warnOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head\">&#9888; 시험종료 알림 <button class=\"x\" onclick=\"hide('warnOverlay')\">&times;</button></div>\n    <div class=\"modal-body\"><div class=\"big-clock\">&#128337;</div>시험 종료 전<br><b style=\"color:var(--red)\">5분</b> 남았습니다.</div>\n    <div class=\"modal-foot\"><button class=\"m-btn\" onclick=\"hide('warnOverlay')\">확인</button></div>\n  </div>\n</div>\n\n<div class=\"overlay hidden\" id=\"submitOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">답안 제출 <button class=\"x\" onclick=\"hide('submitOverlay')\">&times;</button></div>\n    <div class=\"modal-body\" id=\"submitMsg\"></div>\n    <div class=\"modal-foot\">\n      <button class=\"m-btn gray\" onclick=\"hide('submitOverlay')\">돌아가기</button>\n      <button class=\"m-btn blue\" onclick=\"doSubmit()\">제출하기</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"overlay hidden\" id=\"timeoverOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head\">&#9888; 시험종료</div>\n    <div class=\"modal-body\"><div class=\"big-clock\">&#128337;</div><span id=\"timeoverMsg\">시험 시간이 종료되어<br>답안이 자동 제출되었습니다.</span></div>\n    <div class=\"modal-foot\"><button class=\"m-btn\" id=\"timeoverBtn\" onclick=\"hide('timeoverOverlay');finishSession();\">결과 확인</button></div>\n  </div>\n</div>\n\n<!-- 교시 전환 안내 -->\n<div class=\"overlay hidden\" id=\"nextSessOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">교시 전환</div>\n    <div class=\"modal-body\" id=\"nextSessMsg\"></div>\n    <div class=\"modal-foot\">\n      <button class=\"m-btn gray\" onclick=\"resultNow()\">결과 보기</button>\n      <button class=\"m-btn blue\" onclick=\"startNextSession()\">다음 교시 시작</button>\n    </div>\n  </div>\n</div>\n\n<!-- 이용 기간 연장 안내 -->\n<div class=\"overlay hidden\" id=\"extendOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">&#127807; 이용 기간 연장 안내 <button class=\"x\" onclick=\"hide('extendOverlay')\">&times;</button></div>\n    <div class=\"modal-body\">\n      베타 피드백 설문에 참여해 주셔서 감사합니다.<br>\n      감사의 마음을 담아 이용 기간을<br>\n      <b style=\"color:var(--pop)\"><span id=\"extendUntilText\"></span>까지</b> 연장해 드렸어요.<br>\n      남은 기간 실전처럼 활용해 보세요! &#127807;\n    </div>\n    <div class=\"modal-foot\"><button class=\"m-btn blue\" onclick=\"hide('extendOverlay')\">확인</button></div>\n  </div>\n</div>\n\n<!-- 문항 이미지 크게 보기(팝업) — 국시원 CBT처럼 클릭 시 확대 -->\n<div class=\"float-win hidden\" id=\"imgWin\">\n  <div class=\"fw-head\" data-drag=\"imgWin\"><span>자료 크게 보기<span class=\"iw-tip\">제목줄을 끌어 이동 · 모서리를 끌어 크기 조절</span></span><button onclick=\"closeImg()\" title=\"닫기 (ESC)\">&times;</button></div>\n  <div class=\"iw-body\"><img id=\"lbImg\" alt=\"문항 자료 이미지 확대\"></div>\n  <div class=\"iw-grip\" id=\"imgGrip\" title=\"끌어서 크기 조절\"></div>\n</div>\n\n<!-- 문제 보기 (전체/체크/안푼) -->\n<div class=\"overlay hidden\" id=\"viewerOverlay\">\n  <div class=\"viewer\">\n    <div class=\"viewer-head\">문제 모아보기 <button class=\"x\" onclick=\"hide('viewerOverlay')\">&times;</button></div>\n    <div class=\"viewer-guide\">※ 전체 / 체크 / 안 푼 문제 탭을 클릭하여 해당 문제를 확인할 수 있습니다.<br>※ 문제를 더블클릭하면 해당 문제로 이동하여 답안을 수정할 수 있습니다.</div>\n    <div class=\"viewer-tabs\">\n      <button class=\"v-tab active\" id=\"vtAll\" onclick=\"switchViewerTab('all')\">전체문제 (0)</button>\n      <button class=\"v-tab\" id=\"vtChk\" onclick=\"switchViewerTab('chk')\">체크문제 (0)</button>\n      <button class=\"v-tab\" id=\"vtUn\" onclick=\"switchViewerTab('un')\">안푼문제 (0)</button>\n    </div>\n    <div class=\"viewer-body\" id=\"viewerBody\"></div>\n  </div>\n</div>\n\n<!-- 메모 -->\n<div class=\"float-win hidden\" id=\"memoWin\" style=\"top:120px;right:250px;\">\n  <div class=\"fw-head\" data-drag=\"memoWin\"><span id=\"memoTitle\">메모</span><button onclick=\"closeMemo()\">&times;</button></div>\n  <textarea id=\"memoText\" placeholder=\"이 문제에 대한 메모를 입력하세요.\"></textarea>\n</div>\n\n<!-- 계산기 -->\n<div class=\"float-win hidden\" id=\"calcWin\" style=\"bottom:90px;left:20px;\">\n  <div class=\"fw-head\" data-drag=\"calcWin\"><span>계산기</span><button onclick=\"hide('calcWin')\">&times;</button></div>\n  <div class=\"calc-body\">\n    <input id=\"calcDisp\" readonly value=\"0\">\n    <div class=\"calc-grid\">\n      <button onclick=\"calcClear()\">C</button><button onclick=\"calcBack()\">&larr;</button><button class=\"op\" onclick=\"calcIn('/')\">&divide;</button><button class=\"op\" onclick=\"calcIn('*')\">&times;</button>\n      <button onclick=\"calcIn('7')\">7</button><button onclick=\"calcIn('8')\">8</button><button onclick=\"calcIn('9')\">9</button><button class=\"op\" onclick=\"calcIn('-')\">&minus;</button>\n      <button onclick=\"calcIn('4')\">4</button><button onclick=\"calcIn('5')\">5</button><button onclick=\"calcIn('6')\">6</button><button class=\"op\" onclick=\"calcIn('+')\">+</button>\n      <button onclick=\"calcIn('1')\">1</button><button onclick=\"calcIn('2')\">2</button><button onclick=\"calcIn('3')\">3</button><button onclick=\"calcIn('.')\">.</button>\n      <button onclick=\"calcIn('0')\">0</button><button class=\"eq\" onclick=\"calcEq()\">=</button><button onclick=\"calcIn('00')\">00</button>\n    </div>\n  </div>\n</div>\n\n<!-- 그림판 -->\n<div class=\"float-win hidden\" id=\"padWin\" style=\"bottom:90px;left:280px;\">\n  <div class=\"fw-head\" data-drag=\"padWin\"><span>그림판</span><button onclick=\"hide('padWin')\">&times;</button></div>\n  <div class=\"pad-tools\">\n    <button id=\"penBtn\" class=\"on\" onclick=\"setPadMode('pen')\">펜</button>\n    <button id=\"eraserBtn\" onclick=\"setPadMode('eraser')\">지우개</button>\n    <button onclick=\"clearPad()\">전체 지우기</button>\n  </div>\n  <canvas id=\"padCanvas\" width=\"420\" height=\"280\"></canvas>\n</div>\n\n<script>\nwindow.EXAM_TITLE = \"1급 언어재활사 모의 CBT\";\nwindow.HIDDEN_SETS = [];\nwindow.QUESTIONS = [{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 좌측 전두엽 하부 손상\\n• 느리고 노력이 많이 드는 비유창한 발화\\n• 조사·어미 등 문법형태소를 자주 생략하는 전보식 발화\\n• 단순한 지시의 청각적 이해는 비교적 양호하나 통사적으로 복잡한 문장의 이해에는 어려움을 보임\\n• 따라말하기도 손상됨\",\"q\":\"위 양상을 보이는 실어증 유형은?\",\"choices\":[\"베르니케실어증\",\"연결피질운동실어증\",\"브로카실어증\",\"전도실어증\",\"명칭실어증\"],\"answer\":3,\"explain\":\"느리고 노력성인 비유창 발화, 실문법증(문법형태소 생략)의 전보식 발화, 손상된 따라말하기, 단순 지시 이해는 비교적 양호하나 통사적으로 복잡한 문장 이해에는 어려움을 보이는 것은 브로카실어증이다. 따라말하기가 유창성에 비해 보존되면 연결피질운동실어증으로 감별한다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R) 결과\\n• 스스로 말하기: 8/20점 (비유창)\\n• 알아듣기: 170/200점\\n• 따라말하기: 88/100점\\n• 이름대기 및 낱말 찾기: 40/100점\",\"q\":\"다음 결과를 보이는 환자의 실어증 유형은?\",\"choices\":[\"연결피질운동실어증\",\"전도실어증\",\"베르니케실어증\",\"브로카실어증\",\"연결피질감각실어증\"],\"answer\":1,\"explain\":\"발화는 비유창하지만 청각적 이해력이 양호하고 따라말하기가 유창성에 비해 뚜렷하게 보존된 양상은 연결피질운동실어증의 특징이다. 브로카실어증은 따라말하기도 손상되고, 전도실어증은 따라말하기가 선택적으로 손상된다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"좌뇌 손상 환자의 낱말 읽기 검사 결과\\n• 실제 낱말을 의미적으로 관련된 다른 낱말로 대치함(예: '버스'→'기차', '사과'→'포도')\\n• 비단어('무핀', '두랍') 읽기가 거의 불가능함\\n• 추상어보다 구체어를 더 잘 읽음\",\"q\":\"위 환자의 실독증 유형으로 가장 적절한 것은?\",\"choices\":[\"표층실독증\",\"음운실독증\",\"순수실독증\",\"심층실독증\",\"무시실독증\"],\"answer\":4,\"explain\":\"실제 낱말을 의미적으로 관련된 낱말로 대치하는 의미착어(예: '버스'→'기차'), 비단어 읽기의 심한 손상, 추상어보다 구체어를 잘 읽는 심상성(imageability) 효과는 심층실독증의 특징이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 기저핵 회로의 퇴행성 병변\\n• 단조로운 음도와 감소된 강도\\n• 말속도가 점점 빨라지며 음절이 뭉개짐\\n• 안정 시 떨림 동반\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"이완형\",\"과소운동형\",\"경직형\",\"실조형\",\"과다운동형\"],\"answer\":2,\"explain\":\"기저핵 병변(파킨슨병)과 단조로운 음도·강도, 말속도 가속, 안정 떨림은 과소운동형 마비말장애의 전형적인 특징이다. 실조형은 소뇌 손상으로 불규칙한 조음 붕괴와 과도한 강세 변동을 보인다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 근력 저하 없이 말소리를 탐색하는 듯한 입술·혀의 모색행동\\n• 같은 낱말에서도 매번 다른 조음 오류\\n• 발화 길이가 길어질수록 오류 증가\\n• 자동구어(숫자세기)는 비교적 유창함\",\"q\":\"다음 특징을 보이는 환자에게 적절한 치료 활동은?\",\"choices\":[\"보완대체의사소통 도구를 즉시 도입한다\",\"빨대 불기 등 구강 근력 강화 훈련을 실시한다\",\"청각적 이해력 훈련을 우선 실시한다\",\"느린 속도로 조음점 전환을 반복 연습한다\",\"호흡 지구력 훈련으로 발화 길이를 늘린다\"],\"answer\":4,\"explain\":\"비일관적 오류, 모색행동, 자동구어의 상대적 보존은 말실행증의 특징이다. 말실행증은 근력의 문제가 아니라 말운동 프로그래밍의 손상이므로 집중적·반복적인 말산출 연습과 운동학습 원리(느린 속도, 점진적 난이도)를 적용한 치료가 적절하다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"비디오투시조영삼킴검사(VFSS) 소견\\n• 삼킴 반사가 유발되기 전에 음식물이 조기에 인두로 흘러내림\\n• 음식물이 후두 전정을 지나 진성대 아래로 내려감\\n• 이때 기침 반응이 나타나지 않음\",\"q\":\"다음 소견에 해당하는 삼킴장애 증상은?\",\"choices\":[\"구강 내 잔여물\",\"삼킴 중 후두 침습\",\"삼킴 후 지연성 흡인\",\"삼킴 전의 무증상 흡인\",\"비강으로의 역류\"],\"answer\":4,\"explain\":\"삼킴 반사가 유발되기 전(삼킴 전)에 음식물이 진성대 아래로 내려갔으므로 흡인이며, 기침 등 방어 반응이 없으므로 무증상(silent) 흡인이다. 침습은 진성대 위까지만 들어간 경우를 말한다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 65세 남성, 발화는 유창하고 문법적으로 완전함\\n• '가위'를 보여주면 이름을 대지 못하고 용도도 설명하지 못함\\n• 단어의 의미를 묻는 과제에서 점진적인 어려움 심화\\n• 불규칙 낱말을 규칙적으로 읽는 오류 동반\\n• 일상생활 기억력과 시공간 능력은 비교적 보존됨\",\"q\":\"다음 양상을 보이는 환자에게 의심되는 진단명은?\",\"choices\":[\"알츠하이머성 치매\",\"의미치매\",\"원발성 진행성 실어증 비유창형\",\"혈관성 치매\",\"루이소체 치매\"],\"answer\":2,\"explain\":\"유창한 발화가 유지되면서 단어 의미 지식이 점진적으로 상실되고(이름대기·의미 이해 저하) 표층실독증 양상이 동반되며 일상 기억이 비교적 보존되는 것은 의미치매(의미변이형 원발성 진행성 실어증)의 특징이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"외상성 뇌손상 환자의 주의력 유형과 평가 과제가 적절하게 연결된 것은?\",\"choices\":[\"선택적 주의력 – 조용한 방에서 숫자 따라 외우기\",\"지속적 주의력 – 목표 소리가 들릴 때마다 버튼 누르기\",\"초점적 주의력 – 두 가지 규칙을 번갈아 적용하기\",\"분리적 주의력 – 두 과제 중 하나만 골라 수행하기\",\"교대적 주의력 – 소음 속에서 이야기 듣고 질문에 답하기\"],\"answer\":2,\"explain\":\"지속적 주의력은 일정 시간 동안 주의를 유지하는 능력으로, 지속 수행 과제(목표 자극에 반응하기)로 평가한다. 소음 속 과제는 선택적 주의력, 규칙 전환 과제는 교대적 주의력, 이중과제는 분리(배분)적 주의력 평가에 해당한다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 광범위한 좌반구 병소\\n• 구어 표현이 몇 개의 상동어에 제한됨\\n• 청각적 이해력도 심하게 손상됨\\n• 몸짓 모방은 부분적으로 가능함\",\"q\":\"다음 환자에게 우선적으로 적용할 수 있는 치료법은?\",\"choices\":[\"멜로디억양치료\",\"지연청각피드백\",\"문장산출프로그램\",\"의미자질분석\",\"시각동작치료\"],\"answer\":5,\"explain\":\"시각동작치료(VAT)는 구어를 사용하지 않고 몸짓 상징을 훈련하는 접근으로, 표현과 이해가 모두 심하게 손상된 전반실어증 환자에게 적용할 수 있다. 멜로디억양치료는 이해력이 양호한 비유창 실어증 환자에게 적합하다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R)에서 실어증지수(AQ) 산출에 포함되지 않는 영역은?\",\"choices\":[\"스스로 말하기\",\"따라말하기\",\"읽기\",\"이름대기 및 낱말 찾기\",\"알아듣기\"],\"answer\":3,\"explain\":\"실어증지수(AQ)는 스스로 말하기, 알아듣기, 따라말하기, 이름대기의 구어 영역 점수로 산출한다. 읽기와 쓰기는 언어지수(LQ) 산출에 포함된다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"아 내: \\\"남편이 말을 잘 못 알아들어서 답답해요. 제가 길게 설명하면 멍하니 있어요.\\\"\\n환자: 중등도 실어증으로 외래 언어치료 중\",\"q\":\"다음 보호자에게 제공할 의사소통 교육 내용으로 옳은 것은?\",\"choices\":[\"짧고 단순한 문장으로 말하고 충분히 기다려 준다\",\"환자가 틀리게 말할 때마다 즉시 교정해 준다\",\"환자가 말하기 전에 미리 대신 말해 준다\",\"의사소통 실패를 줄이기 위해 대화 기회를 최소화한다\",\"빠른 속도로 여러 번 반복해서 말해 준다\"],\"answer\":1,\"explain\":\"실어증 환자와의 의사소통에서는 짧고 단순한 문장, 느린 말속도, 충분한 반응 시간 제공, 제스처 등 다중 양식 활용이 권장된다. 잦은 교정이나 대신 말하기는 의사소통 의욕을 저하시킨다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"성문위삼킴법(supraglottic swallow)의 일차적인 목적은?\",\"choices\":[\"인두 잔여물을 중력으로 제거한다\",\"후두 상승을 연장하여 상부식도괄약근의 개방 시간을 늘린다\",\"혀 기저부의 후방 운동을 강화한다\",\"삼킴 반사의 유발 속도를 높인다\",\"성대를 닫아 삼킴 중 기도를 보호한다\"],\"answer\":5,\"explain\":\"성문위삼킴법은 숨을 참은 상태로 삼킨 뒤 기침을 하는 기법으로, 삼킴 전·중에 진성대 수준에서 기도를 닫아 흡인을 예방한다. 후두 상승 연장과 상부식도괄약근 개방 연장은 멘델슨기법의 목적이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 좌측 상측두회(베르니케 영역) 손상\\n• 유창하지만 착어가 많은 발화\\n• 청각적 이해력이 심하게 저하됨\\n• 따라말하기가 손상되고 병식이 부족함\",\"q\":\"다음 양상을 보이는 실어증 유형은?\",\"choices\":[\"베르니케실어증\",\"전도실어증\",\"명칭실어증\",\"연결피질감각실어증\",\"브로카실어증\"],\"answer\":1,\"explain\":\"유창한 발화, 심한 청각적 이해력 손상, 착어, 병식 부족은 베르니케실어증의 특징이다. 연결피질감각실어증은 유사하나 따라말하기가 상대적으로 보존된다는 점에서 구별된다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"유창한 발화와 비교적 양호한 청각적 이해력을 보이나 따라말하기가 선택적으로 심하게 손상되고 음소착어가 두드러지는 실어증 유형은?\",\"choices\":[\"연결피질운동실어증\",\"베르니케실어증\",\"브로카실어증\",\"전도실어증\",\"전반실어증\"],\"answer\":4,\"explain\":\"전도실어증은 활꼴다발(궁상속)의 손상으로 유창성과 이해력은 보존되나 따라말하기가 선택적으로 손상되고, 음소착어와 스스로 고치려는 접근행동(conduite d'approche)을 보인다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 소뇌 손상\\n• 불규칙하게 조음이 붕괴됨\\n• 과도하고 불규칙한 강세\\n• 술 취한 듯한 말\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"이완형\",\"경직형\",\"실조형\",\"과소운동형\",\"과다운동형\"],\"answer\":3,\"explain\":\"실조형 마비말장애는 소뇌 손상으로 발생하며, 불규칙한 조음 붕괴, 과도하고 불규칙한 강세, 운율 이상('술 취한 듯한 말')이 특징이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 상위운동신경의 양측 손상\\n• 느리고 힘이 많이 드는 말\\n• 쥐어짜는 듯한 거친 음성\\n• 과다비성\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"이완형\",\"과소운동형\",\"실조형\",\"편측 상부운동신경형\",\"경직형\"],\"answer\":5,\"explain\":\"경직형 마비말장애는 상위운동신경의 양측 손상으로 발생하며, 느리고 노력성인 말, 쥐어짜는 거친 음성, 과다비성이 특징이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 뇌신경(안면신경·설하신경 등)의 하위운동신경 손상\\n• 침범된 근육의 약화와 위축\\n• 과다비성과 기식 음성\\n• 부정확한 자음\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"과다운동형\",\"경직형\",\"실조형\",\"이완형\",\"과소운동형\"],\"answer\":4,\"explain\":\"이완형 마비말장애는 하위운동신경(뇌신경·척수신경) 손상으로 근육의 약화·저긴장·위축이 나타나며, 과다비성과 기식 음성이 특징이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"우반구 손상 환자의 의사소통 특징으로 가장 적절한 것은?\",\"choices\":[\"심한 실문법증을 보인다\",\"따라말하기가 선택적으로 손상된다\",\"음소착어가 빈번하게 나타난다\",\"화용언어와 운율에서 결함을 보인다\",\"청각적 이해력이 심하게 손상된다\"],\"answer\":4,\"explain\":\"우반구 손상 환자는 언어 구조 자체보다 화용(담화 조직, 추론, 유머·비유 이해), 운율, 시공간 처리(좌측 무시)에서 결함을 보인다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"멜로디억양치료(MIT)를 적용하기에 가장 적절한 환자는?\",\"choices\":[\"청각적 이해력이 심하게 손상된 전반실어증 환자\",\"발화 산출이 제한된 비유창 실어증 환자\",\"착어가 많은 베르니케실어증 환자\",\"화용 결함을 보이는 우반구 손상 환자\",\"과다비성을 보이는 마비말장애 환자\"],\"answer\":2,\"explain\":\"멜로디억양치료는 보존된 우반구의 멜로디 기능을 활용하는 치료로, 청각적 이해력이 비교적 양호하고 발화 산출이 제한된 비유창(브로카) 실어증 환자에게 적합하다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"이름대기 장애 치료법으로, 목표 낱말의 범주·기능·특징 등 의미 정보를 활성화하여 낱말 인출을 돕는 접근법은?\",\"choices\":[\"멜로디억양치료\",\"의미자질분석\",\"시각동작치료\",\"각본치료\",\"성문위삼킴법\"],\"answer\":2,\"explain\":\"의미자질분석(SFA)은 목표 낱말과 관련된 의미자질(상위범주, 기능, 특징, 위치 등)을 체계적으로 인출하게 하여 이름대기 능력을 향상시키는 치료법이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"한국판 보스턴이름대기검사(K-BNT)가 평가하는 능력은?\",\"choices\":[\"쓰기 표현\",\"청각적 이해력\",\"문장 따라말하기\",\"대면 이름대기\",\"읽기 이해\"],\"answer\":4,\"explain\":\"K-BNT는 흑백 선화를 보고 이름을 말하는 대면 이름대기(confrontation naming) 능력을 평가하는 검사이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"삼킴 시 후두 상승을 인위적으로 연장·유지하여 상부식도괄약근의 개방 시간을 늘리는 삼킴 기법은?\",\"choices\":[\"성문위삼킴법\",\"최대성문위삼킴법\",\"노력삼킴\",\"멘델슨기법\",\"머리 회전법\"],\"answer\":4,\"explain\":\"멘델슨기법은 삼킴 시 후두가 최고로 올라간 지점에서 인위적으로 상승을 유지하여 상부식도괄약근의 개방 시간과 폭을 늘리는 기법이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"알츠하이머성 치매 초기 단계에서 가장 두드러지는 언어 특징은?\",\"choices\":[\"조음의 붕괴\",\"구문 구조의 상실\",\"따라말하기 불능\",\"완전한 함구증\",\"이름대기 어려움\"],\"answer\":5,\"explain\":\"알츠하이머성 치매 초기에는 조음·구문·따라말하기는 비교적 보존되고, 이름대기 어려움과 에두르기 등 의미론적 단어 인출 결함이 먼저 나타난다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"뇌영상 기법에 대한 설명으로 옳은 것은?\",\"choices\":[\"기능자기공명영상(fMRI)은 뇌의 구조적 병변만을 보여준다\",\"fMRI와 PET는 뇌 기능의 활성화를 보여준다\",\"컴퓨터단층촬영(CT)은 과제 수행 중 뇌 활성화를 직접 측정한다\",\"확산텐서영상(DTI)은 뇌혈류 속도를 측정한다\",\"모든 뇌영상은 기능적 정보만 제공한다\"],\"answer\":2,\"explain\":\"CT와 구조 MRI는 뇌의 해부학적 구조·병변을 보여주는 구조적 영상이고, fMRI·PET는 과제 수행 중 신경 활동에 따른 혈류·대사 변화를 측정하는 기능적 영상이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동 발화\\n① \\\"엄마 물 줘\\\"\\n② \\\"이거 안 먹어\\\"\\n③ \\\"곰인형 어디 있어\\\"\\n④ \\\"나도 갈래\\\"\",\"q\":\"다음 아동 발화의 평균낱말길이(MLU-w)는?\",\"choices\":[\"2.25\",\"2.5\",\"2.75\",\"3.0\",\"3.25\"],\"answer\":3,\"explain\":\"각 발화의 낱말 수는 3, 3, 3, 2개로 총 11개이다. MLU-w = 총 낱말 수 ÷ 발화 수 = 11 ÷ 4 = 2.75.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"낱말 이름대기 과제에서 아동이 다음과 같이 반응하였다.\\n가위 → \\\"자르는 거\\\"\\n시계 → \\\"똑딱똑딱\\\"\\n칫솔 → \\\"이 닦는 거\\\"\",\"q\":\"위 아동의 이름대기 반응에 대한 설명으로 옳은 것은?\",\"choices\":[\"기능·특징으로 에둘러 표현하고 있다\",\"음소착어를 반복적으로 보이고 있다\",\"동일한 보속 반응을 보이고 있다\",\"이름대기 능력이 정상 범위이다\",\"의미와 무관한 신조어를 산출하고 있다\"],\"answer\":1,\"explain\":\"낱말 이름대기에서 목표어를 인출하지 못해 그 기능·특징으로 대신 설명하는 것을 에두르기(circumlocution)라 하며, 낱말찾기(인출)의 어려움을 시사한다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동이 산출한 이야기\\n\\\"토끼가 당근을 심었어요. 그리고 매일 물을 주었어요. 그런데 그것이 자라지 않았어요. 왜냐하면 씨앗을 거꾸로 심었기 때문이에요.\\\"\",\"q\":\"위 이야기에서 두드러지게 나타난 언어 특성은?\",\"choices\":[\"대용어를 전혀 사용하지 않았다\",\"이야기 문법 요소가 전혀 나타나지 않았다\",\"접속부사를 사용해 문장을 연결하고 있다\",\"문법형태소 오류가 매우 빈번하다\",\"단문만 반복해서 산출하였다\"],\"answer\":3,\"explain\":\"'그리고, 그런데, 왜냐하면' 등 접속부사는 문장·명제를 이어 주는 결속표지로, 위 이야기에서 이를 활용해 사건을 순서·대조·인과로 연결하고 있다. 이야기에는 '그것'이라는 지시 대용어도 쓰였으므로 ①은 틀리다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"표준화 언어검사와 평가 영역의 연결이 옳지 않은 것은?\",\"choices\":[\"수용·표현 어휘력 검사(REVT) – 수용·표현 어휘력\",\"한국어 읽기 검사(KOLRA) – 자발화 산출 능력\",\"언어문제해결력검사 – 상위언어 및 추론 능력\",\"취학전 아동의 수용언어 및 표현언어 발달 척도(PRES) – 취학전 수용·표현 언어\",\"구문의미이해력검사(KOSECT) – 구문의미 이해력\"],\"answer\":2,\"explain\":\"KOLRA(한국어 읽기 검사)는 해독·읽기이해 등 읽기 능력을 평가하며 자발화 산출 능력을 평가하지 않는다. 나머지는 검사와 평가 영역이 올바르게 연결되어 있다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 5세 아동\\n• 가정에서는 아버지·어머니 모두 베트남어만 사용\\n• 만 3세에 어린이집에 입소하면서 한국어에 처음 본격적으로 노출됨\\n• 현재 한국어 발화가 제한적임\",\"q\":\"위 아동의 이중언어 유형과 평가 시 고려사항으로 옳은 것은?\",\"choices\":[\"동시적 이중언어 아동의 규준을 그대로 적용한다\",\"한국어 검사 결과만으로 언어장애를 진단한다\",\"베트남어 사용을 중단하도록 권고한다\",\"이중언어 노출이 언어지연의 원인이라고 설명한다\",\"노출 기간이 짧은 순차적 이중언어 아동으로 해석한다\"],\"answer\":5,\"explain\":\"만 3세 이후 제2언어(한국어)에 노출된 순차적 이중언어 아동이다. 노출 기간이 짧으면 제2언어 수행이 낮게 나타날 수 있으므로 노출 기간을 고려해 해석해야 하며, 이중언어 노출 자체는 언어지연의 원인이 아니다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 뇌성마비로 사지의 운동 조절이 어려움\\n• 인지 능력과 언어 이해력은 연령 수준\\n• 손가락으로 상징을 직접 짚는 것이 불가능함\\n• 눈 움직임과 머리 움직임은 비교적 안정적임\",\"q\":\"다음 아동의 보완대체의사소통(AAC) 도구 선택 기법으로 가장 적절한 것은?\",\"choices\":[\"수어를 이용한 표현\",\"필담을 이용한 의사 표현\",\"구어 산출 훈련만 집중해 실시\",\"시선이나 스캐닝을 이용한 선택\",\"손가락을 이용한 직접선택\"],\"answer\":4,\"explain\":\"직접선택이 어려운 사지 운동장애 아동에게는 안정적으로 조절 가능한 움직임(시선, 머리)을 활용한 시선 응시 선택이나 스위치를 이용한 스캐닝(간접선택)이 적절하다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 초등학교 3학년 아동, 난독 의심으로 의뢰\\n• 낱말·비단어를 소리 내어 읽는 속도와 정확도는 또래 수준\\n• 읽은 글의 내용을 이해하고 요약하는 데 또래보다 크게 어려움\\n• 들려주면 이해하고 일상 대화에는 어려움이 없음\",\"q\":\"위 아동의 읽기 문제 유형으로 가장 적절한 것은?\",\"choices\":[\"난독증(해독 부진)\",\"읽기이해부진\",\"말소리장애\",\"쓰기장애\",\"유창성장애\"],\"answer\":2,\"explain\":\"해독(낱말·비단어 읽기의 속도·정확도)은 또래 수준이나 읽기이해가 저조하고 듣기이해는 양호한 양상은, 해독 결함의 난독증이 아니라 읽기이해부진에 해당한다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"대화 중 아동이 상대의 말이 끝나기 전에 끼어들어 말하고, 자신의 관심사만 일방적으로 이야기하며, 상대의 질문에 맞지 않는 대답을 자주 한다.\",\"q\":\"위 아동에게 우선 목표로 설정할 화용 능력은?\",\"choices\":[\"낱말 해독과 읽기 정확도\",\"말소리 산출의 정확도\",\"평균발화길이(MLU) 늘리기\",\"차례 주고받기와 주제 유지\",\"음절·음소 인식 능력\"],\"answer\":4,\"explain\":\"상대의 말을 끊고 자기 관심사만 말하며 부적절하게 반응하는 것은 대화 규칙(차례 주고받기·주제 유지)의 어려움이므로, 이를 우선 화용 목표로 설정한다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"언어 이전기 아동의 의사소통 행동을 관찰하였다.\\n• 손이 닿지 않는 과자를 향해 소리를 내며 성인의 손을 끌어당긴다.\\n• 싫어하는 음식을 밀어내며 고개를 돌린다.\",\"q\":\"위 두 행동에 해당하는 의사소통 기능을 순서대로 바르게 짝지은 것은?\",\"choices\":[\"요구하기 - 거부하기\",\"서술하기 - 요구하기\",\"거부하기 - 인사하기\",\"공동주의 - 서술하기\",\"요구하기 - 공동주의\"],\"answer\":1,\"explain\":\"손이 닿지 않는 사물을 향해 성인의 손을 끌며 소리 내는 것은 요구하기, 싫어하는 것을 밀어내고 고개를 돌리는 것은 거부하기 기능이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 1학년 아동 평가 결과\\n• 수용·표현 어휘력 검사(REVT) 백분위수: 수용 8, 표현 6\\n• 비언어성 지능: 정상 범위\\n• 청력: 정상\\n• 자발화: 조사 생략과 제한된 어휘 사용 관찰\",\"q\":\"다음 결과에 근거한 부모 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"\\\"어휘력이 또래보다 유의하게 낮아 언어치료가 필요해요.\\\"\",\"\\\"청력 손실이 원인이므로 보청기 착용이 필요해요.\\\"\",\"\\\"지능이 낮아서 나타나는 현상이므로 인지치료가 우선이에요.\\\"\",\"\\\"발음 문제가 핵심이므로 조음치료를 시작해야 해요.\\\"\",\"\\\"정상 범위이므로 치료 없이 지켜봐도 돼요.\\\"\"],\"answer\":1,\"explain\":\"REVT 백분위수 10 미만은 또래 대비 유의한 어휘 지체를 의미한다. 비언어성 지능과 청력이 정상이므로 언어 영역에 특정된 어려움이며, 어휘·문법을 목표로 한 언어치료가 권고된다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"간식 시간에 치료사가 아동이 좋아하는 주스를 아동 눈에 보이지만 손이 닿지 않는 선반에 올려 두고, 뚜껑을 꼭 닫은 채 건네준 뒤 아동의 반응을 기다린다.\",\"q\":\"위 장면에서 사용된 중재 전략은?\",\"choices\":[\"청각적 집중 자극\",\"스크립트 문맥 활용\",\"비연속 개별시도 교수\",\"반응대가 기법\",\"환경 조성 전략\"],\"answer\":5,\"explain\":\"환경중심 언어중재의 환경 조성 전략은 원하는 물건을 보이지만 닿지 않게 두거나 도움이 필요한 상황(닫힌 뚜껑)을 만들어 아동이 자발적으로 요구하기를 산출하도록 유도하는 방법이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 4학년 아동 언어평가 결과\\n• 상위개념 어휘 이해: 또래 하위 5%\\n• 동의어·반의어 표현: 또래 하위 3%\\n• 복문 산출과 문법형태소 사용: 연령 수준\\n• 조음 및 읽기 해독: 연령 수준\",\"q\":\"다음 아동에게 우선적으로 설정할 중재 목표는?\",\"choices\":[\"문법형태소 오류 수정\",\"낱말 해독 정확도 향상\",\"복문 산출 능력 향상\",\"조음 정확도 향상\",\"의미 관계 어휘 확장\"],\"answer\":5,\"explain\":\"구문·조음·해독은 연령 수준이나 어휘의 의미 관계 영역(상위개념, 동의어·반의어)에서만 유의한 지체를 보이므로, 의미론적 어휘 조직화를 확장하는 중재가 우선 목표가 된다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 5세 남아\\n• 상대방의 말을 그대로 따라 말함\\n• 대명사를 뒤바꿔 사용함(너/나 혼동)\\n• 특정 관심사를 반복적으로 언급하고 눈맞춤이 부족함\",\"q\":\"다음 아동에게 의심되는 장애는?\",\"choices\":[\"단순언어장애\",\"고도 청각장애\",\"경도 지적장애\",\"자폐스펙트럼장애\",\"조음음운장애\"],\"answer\":4,\"explain\":\"반향어, 대명사 전도, 제한된 관심사의 반복, 눈맞춤 부족, 상호작용의 어려움은 자폐스펙트럼장애의 대표적 언어·의사소통 특징이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"(아동 이야기 전사 자료)\\n토끼랑 거북이가 달리기를 했어요. 토끼는 빨리 뛰다가 낮잠을 잤어요. 그래서 거북이가 먼저 도착했어요.\",\"q\":\"위 아동 발화의 최소종결단위(T-unit) 수는?\",\"choices\":[\"2\",\"3\",\"4\",\"5\",\"6\"],\"answer\":2,\"explain\":\"T-unit은 하나의 주절과 그에 딸린 종속절을 한 단위로 센다. 세 문장이 각각 하나의 T-unit이므로 T-unit 수는 3이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"언어재활사가 아동에게 다음과 같이 질문하였다.\\n• \\\"친구가 '창문이 열려 있네'라고 말하면 무슨 뜻일까요?\\\"\\n• \\\"수업 시간에 딴짓하는 친구에게 선생님이 '지금 뭐 하고 있니?'라고 하면 진짜 궁금해서 물어보는 걸까요?\\\"\",\"q\":\"위 질문으로 평가하려는 능력은?\",\"choices\":[\"음운인식 능력\",\"구문 산출 능력\",\"상위화용 능력\",\"낱말 해독 능력\",\"조음 정확도\"],\"answer\":3,\"explain\":\"'창문이 열려 있네'의 함축(닫아 달라)이나 반어적 발화의 진짜 의도를 파악하는 것은 간접표현·함축 이해로, 상위화용 능력에 해당한다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동: 차 가.\\n치료사: 차가 가네.\",\"q\":\"위 장면에서 치료사가 사용한 기법은?\",\"choices\":[\"확장(expansion)\",\"치료사 혼잣말기법\",\"아동 평행발화기법\",\"확대(extension)\",\"낱말 분리 및 합성\"],\"answer\":1,\"explain\":\"확장(expansion)은 아동 발화의 의미는 유지하면서 문법적으로 완전한 형태로 다시 들려주는 기법이다. 확대는 새로운 의미 정보를 덧붙이는 기법이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"생일잔치, 마트 놀이 등 친숙한 일상 활동의 익숙한 순서를 활용하여 언어를 촉진하는 중재 접근은?\",\"choices\":[\"감각통합 치료\",\"청지각 훈련\",\"스크립트 중재\",\"핵심어휘 접근법\",\"청각구어법\"],\"answer\":3,\"explain\":\"스크립트 중재는 아동에게 친숙한 일상 사건의 구조(스크립트)를 활용하여 인지적 부담을 줄이고 새로운 언어 형식의 학습을 촉진한다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"중심축 반응중재(PRT)의 핵심 특징으로 옳은 것은?\",\"choices\":[\"치료사가 모든 자극과 강화를 통제하는 개별시도 형식으로 진행한다\",\"아동의 주도를 활용하고 자연적 강화를 사용한다\",\"구조화된 책상 과제에서 인위적 강화물로 반복 시행한다\",\"언어보다 구강운동 훈련에 초점을 둔다\",\"성인 주도의 지시 따르기를 우선한다\"],\"answer\":2,\"explain\":\"중심축 반응중재(PRT)는 아동의 선택·주도를 활용하고 동기·복합단서 반응 등 중심축(pivotal) 영역을 목표로 하며, 자연적 강화(원하는 것 제공)를 사용하는 자연주의적 중재이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동의 자발화를 분석한 결과, 전체 낱말 수(NTW)는 40개, 서로 다른 낱말 수(NDW)는 20개였다.\",\"q\":\"이 아동의 어휘다양도(TTR)는?\",\"choices\":[\"0.4\",\"0.5\",\"0.6\",\"0.8\",\"2.0\"],\"answer\":2,\"explain\":\"어휘다양도(TTR) = 서로 다른 낱말 수 ÷ 전체 낱말 수 = 20 ÷ 40 = 0.5이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"그림교환의사소통체계(PECS) 훈련에서 가장 먼저 지도하는 것은?\",\"choices\":[\"여러 그림 중에서 목표 그림을 골라 변별하기\",\"'나는 ~을 원해요' 문장판을 구성하기\",\"여러 그림을 보고 감정을 설명하기\",\"그림 없이 음성으로 원하는 것 요구하기\",\"원하는 사물의 그림카드를 상대에게 건네기\"],\"answer\":5,\"explain\":\"PECS는 1단계에서 원하는 사물의 그림카드를 의사소통 상대에게 건네는 '교환(요구하기)'을 먼저 지도하고, 변별·문장 구성 등은 이후 단계에서 다룬다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"이야기 문법(story grammar)의 구성 요소에 해당하지 않는 것은?\",\"choices\":[\"시도\",\"계기사건\",\"내적 반응\",\"어휘다양도\",\"배경\"],\"answer\":4,\"explain\":\"이야기 문법은 배경, 계기사건, 내적 반응, 시도, 결과, 결말 등으로 구성된다. 어휘다양도(TTR)는 어휘 사용의 다양성을 나타내는 지표로 이야기 문법 요소가 아니다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 초등 1학년 아동, 한국 비언어성 지능검사(K-CTONI-2) 지능지수 96(정상)\\n• 또래와 대화 시 눈맞춤이 짧고 상황에 맞지 않는 말과 주제 이탈이 잦음\\n• 농담·비유·간접표현을 문자 그대로 받아들임\\n• 제한된 관심사·상동행동·감각 특이성은 관찰되지 않음\\n• 한국 아동 메타-화용언어 검사(KOPLAC) 상위언어 인식 3%ile\",\"q\":\"위 아동에게 가장 의심되는 진단은?\",\"choices\":[\"고기능 자폐스펙트럼장애\",\"경계선 지적장애\",\"사회적 의사소통장애\",\"단순언어장애\",\"읽기 학습장애\"],\"answer\":3,\"explain\":\"지능이 정상이고 제한된 관심사·상동행동이 없으면서 화용(대화 규칙·간접표현) 결함이 두드러지면 자폐스펙트럼장애가 아니라 사회적(화용) 의사소통장애로 감별한다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등 3학년 아동이 형태소 규칙으로 설명되지 않는 관습적 표기 낱말에서 오류를 보인다.\\n• 할게요 → '할께요'\\n• 왠지 → '웬지'\\n• 며칠 → '몇일'\",\"q\":\"위 아동에게 필요한 쓰기 중재로 가장 적절한 것은?\",\"choices\":[\"표기형을 기억하고 인출하도록 돕는 표기처리 중심 중재\",\"형태소 원형을 밝혀 적도록 하는 형태처리 중재\",\"소리 나는 대로 적도록 하는 음운처리 중심 중재\",\"조음 정확도를 높이는 조음 중재\",\"읽기 유창성 훈련\"],\"answer\":1,\"explain\":\"형태소 규칙으로 설명되지 않고 관습적으로 굳어진 표기(할게요, 왠지, 며칠 등)의 오류는, 낱말의 표기형(철자 패턴) 자체를 기억·인출하도록 돕는 표기처리 중심 중재가 적절하다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"(아동 발화를 전사한 자료)\\n24개월 아동의 발화\\n\\\"엄마 밥\\\", \\\"아빠 어디\\\", \\\"이거 줘\\\", \\\"물 먹어\\\"\",\"q\":\"위 발화 단계에 대한 설명으로 옳은 것은?\",\"choices\":[\"복문을 산출하는 단계이다\",\"두 낱말을 조합하는 초기 문법 단계이다\",\"한 낱말 시기(일어문)에 해당한다\",\"문법형태소 오류가 빈번한 단계이다\",\"이야기 문법을 갖춘 담화를 산출하는 단계이다\"],\"answer\":2,\"explain\":\"'엄마 밥', '이거 줘'처럼 두 낱말을 조합하지만 조사·어미 등 문법형태소가 아직 나타나지 않는 것은 초기 문법 단계(두 낱말 시기)의 특징이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"정상적인 비유창성을 보이는 아동의 말을 부모가 '말더듬'으로 잘못 진단하고 부정적으로 반응함으로써, 아동이 자신의 말을 의식하고 긴장·회피하게 되어 말더듬으로 발전한다고 보는 이론이다.\",\"q\":\"위 설명에 해당하는 말더듬 발생 이론은?\",\"choices\":[\"예기투쟁가설\",\"진단착오이론\",\"요구용량모델\",\"내적수정가설\",\"대뇌반구우세이론\"],\"answer\":2,\"explain\":\"진단착오이론(Johnson)은 정상적 비유창성을 부모가 말더듬으로 잘못 진단·반응하면서 아동이 말을 의식·긴장·회피하게 되어 말더듬으로 발전한다고 보는 이론이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\\\"저저저는 어 (막힘)토요일에 ㅅㅅㅅ수영장에 가서 수---영을 배워요.\\\"\",\"q\":\"다음 발화에서 나타난 진성 비유창성(SLD)의 횟수는?\",\"choices\":[\"2회\",\"3회\",\"4회\",\"5회\",\"6회\"],\"answer\":3,\"explain\":\"진성 비유창성은 단어부분반복('저저저', 'ㅅㅅㅅ수'), 막힘 1회, 연장('수---') 1회로 총 4회이다. 간투사 '어'는 기타(정상적) 비유창성으로 분류한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 발화 표본: 총 150음절\\n• 말더듬이 나타난 음절: 12음절\",\"q\":\"위 대상자의 말더듬 음절 백분율(%SS)은?\",\"choices\":[\"6%\",\"8%\",\"10%\",\"12.5%\",\"15%\"],\"answer\":2,\"explain\":\"%SS = (말더듬 음절 수 ÷ 전체 음절 수) × 100 = 12 ÷ 150 × 100 = 8%.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 '빙산 모델(iceberg model)'에서 수면 아래에 해당하는 요소로 가장 적절한 것은?\",\"choices\":[\"겉으로 드러나는 반복·연장·막힘\",\"관찰 가능한 신체적 부수행동\",\"말속도와 조음의 정확도\",\"말더듬에 대한 두려움과 수치심\",\"발화에서 나타난 문법 오류\"],\"answer\":4,\"explain\":\"빙산 모델에서 수면 위는 반복·연장·막힘 등 겉으로 드러나는 행동이고, 수면 아래는 말더듬에 대한 두려움·수치심·좌절 등 겉으로 드러나지 않는 감정과 태도이다. 치료에서는 수면 아래 요소도 함께 다루어야 한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 38세 여성, 6개월 전 교통사고로 가족을 잃은 후 말더듬 시작\\n• 아동기 말더듬 병력 없음\\n• 모든 낱말과 문법적 위치에서 유사한 형태의 반복이 일관되게 나타남\\n• 반복해서 읽어도 말더듬 빈도가 줄지 않음\\n• 부수행동이나 말에 대한 불안이 거의 관찰되지 않음\",\"q\":\"다음 대상자에게 의심되는 유창성장애 유형은?\",\"choices\":[\"위장 말더듬\",\"신경학적 말더듬\",\"심인성 말더듬\",\"속화\",\"발달성 말더듬\"],\"answer\":3,\"explain\":\"심리적 외상 후 성인기에 갑자기 발생하고, 낱말 유형·위치와 무관하게 일관된 형태를 보이며, 적응효과가 없고 이차행동·불안이 거의 없는 양상은 심인성 말더듬의 특징이다. 신경학적 말더듬은 뇌손상 병력이 확인되어야 한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"파라다이스-유창성 검사-II(P-FA-II) 결과\\n• 필수과제 총점 백분위수: 65%ile\\n• 의사소통태도 평가 백분위수: 70%ile\",\"q\":\"위 결과에 대한 해석으로 옳은 것은?\",\"choices\":[\"말더듬 정도는 '심함'에 해당한다\",\"말더듬 정도는 '약함'에 해당한다\",\"말더듬 정도는 '중간'에 해당한다\",\"정상 범위의 유창성 수준이다\",\"백분위수로는 중증도를 판단할 수 없다\"],\"answer\":3,\"explain\":\"P-FA-II에서 필수과제 백분위수 1~40%ile은 약함, 41~80%ile은 중간, 81%ile 이상은 심함으로 해석한다. 65%ile은 '중간' 정도에 해당한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 남아, 말더듬 시작 10개월 경과\\n• 부모가 훈련을 받고 가정의 일상 대화에서 중재를 실시함\\n• 아동의 유창한 발화에 \\\"부드럽게 잘 말했네!\\\"라고 칭찬함\\n• 말더듬이 나타나면 가끔씩 \\\"방금 좀 울퉁불퉁했네, 다시 말해 볼까?\\\"라고 요청함\\n• 치료사는 매주 말더듬 심한 정도(SR) 기록을 확인함\",\"q\":\"위 중재에 해당하는 프로그램은?\",\"choices\":[\"스토커 프로브 테크닉\",\"말더듬수정법\",\"리드콤 프로그램\",\"점진적 발화길이 및 복잡성 증가 프로그램(GILCU)\",\"페일린 부모-아동 상호작용치료\"],\"answer\":3,\"explain\":\"부모가 일상 대화에서 유창한 발화에 언어적 칭찬을, 말더듬에 간헐적인 수정 요청을 제공하고 말더듬 심한 정도(SR) 척도로 진전을 관리하는 것은 조작적 조건화 기반의 리드콤 프로그램이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대상자가 낱말에서 말을 더듬은 직후 잠시 멈추고, 긴장을 풀고 나서 방금 더듬었던 낱말을 편안한 방식으로 다시 산출하였다.\",\"q\":\"위 장면에서 사용된 말더듬수정법의 기법은?\",\"choices\":[\"가벼운 조음접촉\",\"빠져나오기\",\"예비책\",\"둔감화\",\"취소\"],\"answer\":5,\"explain\":\"취소(cancellation)는 말더듬이 끝난 후 잠시 멈추었다가 더듬은 낱말을 긴장을 줄인 방식으로 다시 말하는 기법이다. 빠져나오기는 말더듬 도중에, 예비책은 말더듬이 예상되는 낱말 이전에 적용한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 말속도가 빠르고 불규칙함\\n• 음절 생략과 낱말 축약이 잦아 명료도가 낮음\\n• 주제에서 자주 벗어나며 발화 조직화가 어려움\\n• 자신의 말 문제를 잘 인식하지 못함\",\"q\":\"다음 특성을 보이는 대상자에게 우선적으로 적용할 중재 방법은?\",\"choices\":[\"가벼운 조음접촉 확립 훈련\",\"호흡과 발성의 협응 훈련\",\"말속도 조절과 자기 인식 훈련\",\"단계적 둔감화 훈련\",\"회피행동 감소 훈련\"],\"answer\":3,\"explain\":\"속화(말빠름증)의 핵심 중재는 말속도를 조절하고(속도 낮추기, 쉼 넣기) 자신의 말을 인식하는 자기 모니터링 능력을 기르는 것이다. 속화 화자는 문제 인식이 부족하므로 녹음 청취 등 인식 훈련이 중요하다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬 정도 측정 검사(SSI-4)에서 말더듬 중증도 산출에 포함되는 요소로 옳게 묶인 것은?\",\"choices\":[\"말더듬 빈도, 말속도, 조음정확도\",\"말더듬 빈도, 어휘다양도, 발화길이\",\"지속시간, 음도, 강도\",\"의사소통태도, 자아효능감, 회피 정도\",\"말더듬 빈도, 지속시간, 신체적 부수행동\"],\"answer\":5,\"explain\":\"SSI-4는 말더듬 빈도(%SS), 지속시간(가장 긴 말더듬 3개의 평균), 신체적 부수행동의 세 요소 점수를 합산하여 중증도를 산출한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인의 치료 전후 자아효능감 척도(SESAS) 수행 점수가 30점에서 74점으로 상승하였다.\",\"q\":\"위 변화에 대한 해석으로 옳은 것은?\",\"choices\":[\"말더듬 빈도가 증가하였다\",\"의사소통 태도가 부정적으로 변하였다\",\"말에 대한 통제력이 감소하였다\",\"치료 효과가 나타나지 않았다\",\"말에 대한 자아효능감이 향상되었다\"],\"answer\":5,\"explain\":\"자아효능감 척도(SESAS)는 점수가 높을수록 유창하게 말할 수 있다는 자신감이 크다는 의미이므로, 30→74점의 상승은 자아효능감(자신감)의 향상을 나타낸다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 아동의 아버지가 아이가 말을 더듬을 때마다 \\\"천천히 말해\\\", \\\"다시 말해 봐\\\"라고 지적하고, 아이의 말을 대신 끝맺어 준다.\",\"q\":\"위 아버지에게 제공할 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"말을 더듬을 때마다 즉시 교정해 주세요\",\"아이의 말을 대신 끝맺어 시간을 줄여 주세요\",\"아이의 말을 끝까지 기다리며 들어 주세요\",\"더 빠르게 말하는 시범을 보여 주세요\",\"말더듬는 낱말을 여러 번 반복시켜 주세요\"],\"answer\":3,\"explain\":\"말더듬 아동에게는 지적·교정·대신 말하기·시간 압박이 유창성을 방해한다. 지적을 줄이고 아이의 말을 끝까지 기다리며 느리고 편안한 대화 분위기를 만드는 것이 권장된다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 핵심행동(core behavior)에 해당하지 않는 것은?\",\"choices\":[\"막힘\",\"소리 연장\",\"단어부분 반복\",\"음절 반복\",\"눈 깜빡임\"],\"answer\":5,\"explain\":\"핵심행동은 반복, 연장, 막힘이다. 눈 깜빡임, 고개 젖히기 등은 핵심행동에서 벗어나거나 피하려는 부수행동(이차행동)이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"발달성 말더듬에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"대부분 성인기에 처음 발생한다\",\"남아가 여아보다 유병률이 높다\",\"상당수는 자연회복된다\",\"발생에 유전적 요인이 관여한다\",\"대부분 학령전기(2~5세)에 시작된다\"],\"answer\":1,\"explain\":\"발달성 말더듬은 대부분 2~5세 학령전기에 시작되며 남아에게 더 흔하고 유전적 요인이 관여하며 상당수 자연회복된다. 성인기 최초 발병이 흔하다는 설명은 옳지 않다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬수정법(Van Riper)의 궁극적인 목표로 가장 적절한 것은?\",\"choices\":[\"말더듬을 편안하고 쉽게 더듬는 것\",\"완전히 유창한 말을 확립하는 것\",\"말더듬을 완전히 제거하는 것\",\"회피행동을 강화하는 것\",\"느린 말을 영구적으로 사용하는 것\"],\"answer\":1,\"explain\":\"말더듬수정법은 말더듬을 완전히 없애기보다, 두려움과 긴장을 줄여 편안하고 쉽게 더듬으면서 자유롭게 의사소통하도록 하는 것을 목표로 한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"정상적 비유창성(기타 비유창성)에 가장 가까운 것은?\",\"choices\":[\"긴장된 막힘\",\"소리 연장\",\"긴장을 동반한 음절 반복\",\"간투사·구 반복·수정\",\"긴장을 동반한 일음절 낱말 반복\"],\"answer\":4,\"explain\":\"간투사, 구 반복, 수정, 미완성 등은 정상적 비유창성(기타 비유창성)에 해당한다. 긴장을 동반한 음절 반복·연장·막힘은 진성 비유창성(SLD)에 가깝다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"신경학적 말더듬(neurogenic stuttering)에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"뇌졸중·외상성 뇌손상 등 이후에 발생할 수 있다\",\"반복해 읽어도 적응효과가 잘 나타나지 않는다\",\"낱말 유형·위치와 무관하게 비유창이 나타나는 경향이 있다\",\"발달성 말더듬에 비해 부수행동과 불안이 적은 편이다\",\"심리적 외상이나 정서적 갈등이 주된 원인이다\"],\"answer\":5,\"explain\":\"신경학적 말더듬은 신경학적 손상 이후 발생하고 적응효과가 미약하며 낱말 위치와 무관하게 나타난다. 심리적 외상이 주된 원인인 것은 심인성 말더듬의 특징이므로 옳지 않다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬을 '말더듬을 예상하고 이를 피하려는 투쟁 반응'으로 설명하는 이론은?\",\"choices\":[\"대뇌우세이론\",\"진단착오이론\",\"요구용량모델\",\"예기투쟁가설\",\"이원이론\"],\"answer\":4,\"explain\":\"예기투쟁가설은 화자가 말더듬을 예상하고 이에 대해 긴장·투쟁·회피하는 반응이 말더듬을 유발·악화시킨다고 보는 이론이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"같은 문장을 여러 번 반복해서 읽을 때 말더듬 빈도가 점차 감소하는 현상은?\",\"choices\":[\"일관성효과\",\"자발회복\",\"인접효과\",\"후속효과\",\"적응효과\"],\"answer\":5,\"explain\":\"적응효과는 동일한 자료를 반복해서 읽을수록 말더듬 빈도가 감소하는 현상이다. 일관성효과는 같은 낱말·위치에서 반복적으로 더듬는 경향을 말한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬 화자의 회피행동(회피)에 해당하지 않는 것은?\",\"choices\":[\"돌려서 에둘러 말하기\",\"막힘 중 고개를 젖히기\",\"말할 순서를 뒤로 미루기\",\"전화 받는 상황을 피하기\",\"다른 낱말로 바꾸어 말하기\"],\"answer\":2,\"explain\":\"낱말 대치, 에두르기, 상황·순서 회피는 말더듬을 예상하고 미리 피하는 회피행동이다. 막힘 도중 벗어나려고 고개를 젖히는 것은 이미 시작된 말더듬에서 빠져나오려는 탈출행동이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"유창성완성법(fluency shaping)에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"느린 말·부드러운 발성 시작으로 유창한 말을 확립한다\",\"느린 속도에서 가벼운 조음접촉을 활용한다\",\"확립된 유창성을 점차 실제 상황으로 일반화한다\",\"말더듬 자체보다 유창한 말 패턴 형성에 초점을 둔다\",\"취소·빠져나오기로 말더듬 순간을 수정한다\"],\"answer\":5,\"explain\":\"취소·빠져나오기는 말더듬수정법의 기법이다. 유창성완성법은 느린 말·부드러운 시작·가벼운 조음접촉으로 유창한 말을 확립하여 일반화하는 접근이므로 '말더듬 순간 수정에 초점'은 옳지 않다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"자신의 말을 짧은 지연 후에 듣게 하여 말속도를 늦추고 유창성을 유도하는 기기는?\",\"choices\":[\"청각 차폐기(MAF)\",\"지연청각피드백(DAF)\",\"비음측정기(나조미터)\",\"전기성문파형기(EGG)\",\"음향 스펙트로그램\"],\"answer\":2,\"explain\":\"지연청각피드백(DAF)은 화자의 말을 짧게 지연시켜 다시 들려줌으로써 말속도를 늦추고 유창성을 촉진하는 기기이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"에릭슨 의사소통태도 검사(S-24)가 측정하는 것은?\",\"choices\":[\"말더듬의 빈도\",\"말더듬 지속시간\",\"의사소통에 대한 태도\",\"신체적 부수행동\",\"말속도와 조음속도\"],\"answer\":3,\"explain\":\"S-24는 말더듬 화자가 의사소통에 대해 갖는 부정적 태도(신념)를 측정하는 자기보고식 척도이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대상자가 말을 더듬을 것으로 예상되는 낱말 직전에, 미리 긴장을 줄이고 부드럽게 첫소리에 접근하여 산출하였다.\",\"q\":\"위 장면에서 사용된 말더듬수정법의 기법은?\",\"choices\":[\"예비책\",\"빠져나오기\",\"취소\",\"둔감화\",\"고유수용감각 훈련\"],\"answer\":1,\"explain\":\"예비책(preparatory set)은 말더듬이 예상되는 낱말을 산출하기 직전에 미리 긴장을 줄이고 부드럽게 접근하여 말더듬을 예방하는 기법이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"음성 산출의 음원-여과기 이론(source-filter theory)에 대한 설명으로 옳은 것은?\",\"choices\":[\"포먼트는 성대 진동수에 의해 직접 결정된다\",\"기본주파수는 성도 길이로만 결정된다\",\"성대 진동이 음원, 성도가 여과기로 작용한다\",\"음원과 여과기는 물리적으로 동일한 구조이다\",\"여과기 기능은 폐의 공기압이 담당한다\"],\"answer\":3,\"explain\":\"음원-여과기 이론에서는 성대 진동이 음원(source)이 되어 기본주파수와 배음을 만들고, 성도(공명강)가 여과기(filter)로 작용하여 특정 주파수를 강조·감쇠함으로써 포먼트가 형성된다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"발성 시 음도(pitch)를 높이는 생리적 기전으로 옳은 것은?\",\"choices\":[\"성대가 짧아지고 두꺼워지면서 진동수가 증가한다\",\"윤상갑상근이 수축해 성대가 길어지고 긴장된다\",\"호기류량만 증가시키면 음도가 높아진다\",\"성문하압을 낮추면 음도가 높아진다\",\"갑상피열근만 이완시키면 음도가 높아진다\"],\"answer\":2,\"explain\":\"음도는 성대의 진동수에 의해 결정된다. 윤상갑상근(CT)이 수축하면 성대가 길어지고 긴장되어 진동수가 증가하므로 음도가 높아진다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"공기역학적 검사 결과\\n• 폐활량: 정상 범위\\n• 최대연장발성시간(MPT): 5.2초\\n• 평균호기류율: 260 mL/sec (증가)\\n• 성문하압: 정상 범위\\n• 청지각적으로 기식적이고 약한 음성\",\"q\":\"다음 결과에서 추정되는 음성장애는?\",\"choices\":[\"근긴장성 발성장애\",\"라인케부종\",\"편측 성대마비\",\"내전형 연축성발성장애\",\"변성발성장애\"],\"answer\":3,\"explain\":\"짧은 MPT와 증가된 평균호기류율은 성문폐쇄부전으로 공기가 새고 있음을 의미하며, 기식적이고 약한 음성과 함께 편측 성대마비를 시사한다. 근긴장성 발성장애나 내전형 연축성발성장애는 과내전 양상으로 호기류율이 감소하는 경향을 보인다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"환자가 지각하는 음성 문제가 일상생활에 미치는 신체적·기능적·정서적 영향을 평가하는 자기보고식 도구는?\",\"choices\":[\"CAPE-V\",\"최대연장발성시간(MPT)\",\"GRBAS 척도\",\"음성장애지수(VHI)\",\"음성범위프로파일(VRP)\"],\"answer\":4,\"explain\":\"음성장애지수(VHI)는 환자 스스로 음성 문제로 인한 신체·기능·정서 영역의 불편감을 평정하는 자기보고식 설문이다. GRBAS와 CAPE-V는 평가자의 청지각적 평가 도구이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음향학적 검사(MDVP) 결과\\n• 기본주파수(F0): 성별·연령 규준 범위\\n• 주파수변동률(jitter): 3.85 % (증가)\\n• 진폭변동률(shimmer): 7.9 % (증가)\\n• 소음대배음비(NHR): 0.28 (증가)\",\"q\":\"위 결과에 대한 설명으로 옳은 것은?\",\"choices\":[\"음성 강도가 과도하게 크다\",\"음성 신호의 주기성이 낮다\",\"습관적 음도가 비정상적으로 높다\",\"공명 문제가 확인된다\",\"정상 음질에 해당한다\"],\"answer\":2,\"explain\":\"jitter(주파수 변동률), shimmer(진폭 변동률), NHR(소음대배음비)의 증가는 성대 진동의 규칙성이 떨어지고 신호 내 소음 성분이 많다는 것, 즉 음성 신호의 주기성이 낮음을 의미한다. F0 자체는 정상 범위이므로 음도 문제로 볼 수 없다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 32세 초등교사\\n• 후두내시경: 양측 성대 막성부 중간 지점의 대칭적인 양성 병변, 모래시계 모양의 성문폐쇄\\n• 음성 남용력: 하루 6교시 수업, 큰 소리 사용 빈번\",\"q\":\"위 환자에게 우선적으로 적용할 치료는?\",\"choices\":[\"음성치료와 음성위생 교육\",\"보툴리눔 독소 주입\",\"성대 내 주입술\",\"제I형 갑상성형술\",\"후두미세수술\"],\"answer\":1,\"explain\":\"양측성·대칭성 병변과 모래시계형 성문폐쇄는 성대결절의 전형적 소견이며, 음성 남용이 원인이므로 일차적 치료는 음성치료(반폐쇄성도훈련 등)와 음성위생 교육이다. 수술은 충분한 음성치료 후에도 호전이 없을 때 고려한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"20대 여성이 특별한 신체 질환 없이 갑자기 목소리가 나오지 않아 속삭이는 소리로만 말한다. 그러나 기침과 웃음에서는 정상적인 유성음이 산출되고, 후두내시경에서 구조적 이상이 없다.\",\"q\":\"위 사례에 대한 설명으로 옳은 것은?\",\"choices\":[\"성대의 구조적 병변에 의한 기질적 실성증이다\",\"반드시 수술적 치료가 필요하다\",\"기침·웃음에서도 발성이 전혀 불가능하다\",\"기능적(심인성) 실성증에 해당한다\",\"신경 손상에 의한 성대마비가 원인이다\"],\"answer\":4,\"explain\":\"구조적 이상 없이 기침·웃음 등 반사적(생리적) 발성에서 정상 유성음이 가능한 것은 기능적(심인성) 실성증의 특징이다. 보존된 생리적 발성(기침·헛기침·허밍)에서 모음·낱말로 확장하며 발성을 재확립한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 17세 남학생, 변성기가 지났으나 지속적으로 높은 음도로 말함\\n• 후두 구조와 호르몬 검사: 정상\",\"q\":\"위 대상자에게 적용할 수 있는 음성치료 기법은?\",\"choices\":[\"음도를 더 높여 가성구 발성을 훈련한다\",\"큰 소리로 고음 발성을 반복시킨다\",\"속삭이는 소리로 말하게 한다\",\"성대 과내전을 유도한다\",\"갑상연골을 눌러 낮은 음도를 유도한다\"],\"answer\":5,\"explain\":\"변성발성장애는 변성기 이후에도 높은 음도가 유지되는 기능적 장애로, 손가락 조작법(갑상연골을 후하방으로 눌러 성대를 이완)으로 낮은 진성 발성을 유도한 뒤 이를 안정화하는 치료가 효과적이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 68세 남성, 파킨슨병 진단\\n• 약한 음성 강도, 단조로운 음도\\n• 말끝이 흐려지며 가족들이 잘 알아듣지 못함\\n• 스스로는 목소리가 작다고 느끼지 않음\",\"q\":\"위 환자에게 가장 적절한 음성치료는?\",\"choices\":[\"차폐를 이용한 강도 증가\",\"속삭임 발성 중심 훈련\",\"가성대 발성 유도 훈련\",\"리실버만음성치료(LSVT)\",\"저작하기 기법으로 이완 유도\"],\"answer\":4,\"explain\":\"리실버만음성치료(LSVT LOUD)는 파킨슨병 환자를 대상으로 '크게 말하기'에 집중하여 고강도로 반복 훈련하는 근거 기반 치료로, 강도 증가와 함께 명료도 개선 효과가 보고된다. 감각 인식 저하(스스로 작다고 느끼지 않음)에 대한 보정 훈련도 포함한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"내전형 연축성발성장애에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"모음으로 시작하는 낱말에서 쥐어짜는 듯한 음성 끊김이 나타난다\",\"성대의 구조적 병변이 주된 원인이다\",\"속삭임·노래·웃음에서는 증상이 감소한다\",\"보툴리눔 독소 주입이 대표적 치료이다\",\"성대 내전근의 불수의적 연축에 의한 신경학적 장애이다\"],\"answer\":2,\"explain\":\"내전형 연축성발성장애는 구조적 병변 없이 성대 내전근의 불수의적 연축으로 발생하는 신경학적 장애이다. 모음 시작 낱말에서 음성 끊김이 두드러지고 속삭임·노래에서 감소하며 보툴리눔 독소로 치료하므로 '구조적 성대 병변이 원인'은 옳지 않다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"후두전적출 환자의 식도발성(esophageal speech)에 대한 설명으로 옳은 것은?\",\"choices\":[\"폐의 공기를 성대로 보내어 소리를 낸다\",\"삼킨 공기를 역류시켜 인두식도분절을 진동시킨다\",\"반드시 보철(프로테제) 삽입이 있어야 발성할 수 있다\",\"전기 진동자를 목에 대어 소리를 낸다\",\"성대가 재생되어 발성이 가능해진다\"],\"answer\":2,\"explain\":\"식도발성은 공기를 삼켜 식도에 넣었다가 역류시키면서 인두식도분절(PE segment)을 진동시켜 소리를 내는 무후두 음성 방법으로, 별도의 보철 없이도 훈련할 수 있다. 성대는 재생되지 않는다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 74세 남성, 목소리가 약하고 쉽게 피로하다고 호소\\n• 후두내시경: 성대 위축과 활모양의 성문틈, 병변 없음\\n• 신경학적 이상 없음\",\"q\":\"위 환자에게 적절한 음성치료 접근은?\",\"choices\":[\"음성 사용을 최대한 제한한다\",\"속삭임으로 말하도록 한다\",\"보툴리눔 독소 주입을 의뢰한다\",\"성대내전을 강화하는 훈련을 실시한다\",\"음도를 낮추는 훈련을 실시한다\"],\"answer\":4,\"explain\":\"노인성 음성(성대 위축, 활모양 성문틈)은 성문폐쇄부전이 핵심이므로 밀기 접근법, 강한 성대접촉 유도, 반폐쇄성도훈련 등 성대내전과 발성 효율을 강화하는 음성치료가 적절하다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"GRBAS 척도에서 'R'이 의미하는 음성 특성은?\",\"choices\":[\"전반적 중증도\",\"조조성\",\"기식성\",\"무력성\",\"긴장성\"],\"answer\":2,\"explain\":\"GRBAS에서 G는 전반적 중증도, R은 조조성(거친 소리), B는 기식성, A는 무력성, S는 긴장성을 의미한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 후두내시경: 편측 성대의 유경성(줄기 달린) 병변\\n• 갑작스러운 고함·큰 소리 이후 발생\\n• 거칠고 낮은 음성\",\"q\":\"위 소견에서 의심되는 질환은?\",\"choices\":[\"성대결절\",\"성대구증\",\"라인케부종\",\"후두유두종\",\"성대폴립\"],\"answer\":5,\"explain\":\"성대폴립은 흔히 편측성이며 유경성 또는 무경성으로 나타나고, 갑작스러운 음성 남용(고함) 후 발생하는 경우가 많다. 성대결절은 대개 양측성·대칭성이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"후두에 기질적 병변이 없으나 후두 주변 근육의 과도한 긴장으로 쥐어짜는 음성을 보이는 장애는?\",\"choices\":[\"편측 성대마비\",\"사춘기 변성발성장애\",\"연축성 발성장애\",\"근긴장성 발성장애\",\"양측 성대구증\"],\"answer\":4,\"explain\":\"근긴장성 발성장애(MTD)는 구조적 병변 없이 후두 내·외근의 과도한 긴장으로 발생하는 기능적 음성장애이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"음향학적 분석에서 진폭(강도)의 주기 간 변동률을 나타내는 측정치는?\",\"choices\":[\"shimmer\",\"F0 표준편차\",\"NHR\",\"CPP\",\"jitter\"],\"answer\":1,\"explain\":\"shimmer는 주기 간 진폭(강도)의 변동률, jitter는 주기 간 기본주파수의 변동률, NHR은 소음 대 배음 비율이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"s/z 비율이 1.4 이상으로 증가했을 때 가장 우선적으로 의심할 수 있는 것은?\",\"choices\":[\"호흡 기능의 단독 저하\",\"조음기관의 구조적 이상\",\"경도의 청력 손실\",\"성대 병변과 성문폐쇄부전\",\"공명강의 구조적 협착\"],\"answer\":4,\"explain\":\"/s/는 호흡 기능, /z/는 호흡과 발성 기능을 함께 반영한다. s/z 비율이 1.4 이상이면 /z/ 연장이 상대적으로 짧다는 의미로, 성대 병변에 의한 성문폐쇄부전을 시사한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"음성위생 교육 내용으로 적절하지 않은 것은?\",\"choices\":[\"충분한 수분을 섭취한다\",\"소음 환경에서 큰 소리로 말하는 것을 줄인다\",\"음성 휴식이 필요하면 속삭여 말한다\",\"습관적인 헛기침을 줄인다\",\"과도한 카페인 섭취를 줄인다\"],\"answer\":3,\"explain\":\"속삭이기는 성대에 오히려 과도한 긴장을 주므로 음성위생법으로 권장되지 않는다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"갑상샘 수술 후 편측 성대마비를 유발하기 쉬운 신경은?\",\"choices\":[\"되돌이후두신경\",\"미주신경 본간\",\"설하신경\",\"삼차신경\",\"상후두신경\"],\"answer\":1,\"explain\":\"미주신경의 분지인 되돌이후두신경(반회후두신경)은 갑상샘 수술 시 손상되기 쉬우며, 손상되면 편측 성대마비로 기식적이고 약한 음성이 나타난다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"최대연장발성시간(MPT)이 정상보다 현저히 짧게 나타날 때 가장 우선적으로 시사되는 것은?\",\"choices\":[\"경도의 청력 손실\",\"성문폐쇄부전과 호흡 부족\",\"성대의 과도한 내전\",\"조음기관의 구조적 이상\",\"공명강의 구조 이상\"],\"answer\":2,\"explain\":\"MPT는 한 번의 흡기 후 낼 수 있는 최대 발성 시간으로, 현저히 짧으면 성문폐쇄부전으로 공기가 새거나 호흡 지지가 부족함을 시사한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"소아에게서 반복적으로 재발하며, 인유두종바이러스(HPV) 감염과 관련되어 성대에 사마귀 모양의 병변이 자라 애성과 기도 폐쇄를 유발하는 질환이 있다.\",\"q\":\"위 설명에 해당하는 질환으로 가장 적절한 것은?\",\"choices\":[\"성대결절\",\"라인케부종\",\"재발성 후두유두종\",\"성대구증\",\"근긴장성 발성장애\"],\"answer\":3,\"explain\":\"재발성 후두유두종(재발성 호흡기 유두종증)은 인유두종바이러스(HPV) 감염과 관련되어 성대에 사마귀 모양 병변이 자라 애성·기도폐쇄를 유발하며, 소아에서 반복 재발하는 경향이 있다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"성대의 접촉 양상(개방·폐쇄 주기)을 비침습적으로 간접 측정하는 데 가장 적절한 도구는?\",\"choices\":[\"전기성문파형검사(EGG)\",\"나조미터(비음도)\",\"음향 스펙트로그램\",\"순음청력검사(PTA)\",\"음성범위프로파일\"],\"answer\":1,\"explain\":\"전기성문파형검사(EGG)는 성대 접촉 면적의 변화를 통해 성대의 개방·폐쇄 주기(접촉 양상)를 비침습적으로 간접 측정하는 도구이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음성치료에서 대상자에게 빨대를 물컵에 담그고 그 안으로 소리를 내게 하거나, 입술 트릴·허밍을 하며 발성하도록 하였다.\",\"q\":\"위 기법들의 공통된 원리로 옳은 것은?\",\"choices\":[\"성대를 강하게 접촉시켜 강도를 높인다\",\"성문을 완전히 개방하여 기식성을 늘린다\",\"음도를 최대한 높여 가성구로만 발성한다\",\"호흡을 멈추고 발성한다\",\"성도를 좁혀 성대 접촉 부담을 줄인다\"],\"answer\":5,\"explain\":\"빨대 발성, 입술 트릴, 허밍 등은 반폐쇄성도훈련(SOVT)으로, 성도를 부분적으로 좁혀 성문 상부 압력을 높임으로써 성대 접촉 부담을 줄이고 효율적인 발성을 유도한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"성대의 유리연을 따라 고랑(구)이 패여 성문폐쇄부전과 기식 음성을 보이는 질환은?\",\"choices\":[\"후두유두종\",\"성대결절\",\"라인케부종\",\"성대폴립\",\"성대구증\"],\"answer\":5,\"explain\":\"성대구증은 성대 유리연을 따라 고랑이 패이는 질환으로, 성문폐쇄부전으로 인한 기식 음성과 음성 피로가 나타난다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"아동1: 4세, 어리고 정상적인 아동에게 나타나는 음운변동(종성생략, 연구개음 전방화)이 지속됨\\n아동2: 혀 내밀기로 인한 /ㅅ/ 왜곡이 모든 문맥에서 일관됨\\n아동3: 어중초성 생략과 어두 자음 첨가 등 발달과정에서 드문 오류패턴이 일관되게 나타남\\n아동4: 같은 낱말을 말할 때마다 40% 이상 서로 다른 형태로 산출함\",\"q\":\"Dodd의 분류에 따라 '음운지연'에 해당하는 아동은?\",\"choices\":[\"아동1\",\"아동2\",\"아동3\",\"아동4\",\"해당 아동 없음\"],\"answer\":1,\"explain\":\"음운지연은 정상 발달과정에서 나타나는 음운변동이 해당 연령이 지나서도 지속되는 경우이다. 아동2는 조음장애(일관된 왜곡), 아동3은 비전형적 패턴이 일관된 일관적 음운장애, 아동4는 비일관적 음운장애에 해당한다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n사자 → [타다]\\n수박 → [투박]\\n코끼리 → [토끼리]\\n그네 → [드네]\\n호랑이 → [호앙이]\",\"q\":\"다음 조음음운장애 아동의 발화에서 나타난 음운오류패턴에 대한 설명으로 적절한 것은?\",\"choices\":[\"종성 생략이 2회 나타났다\",\"유음의 활음화가 모두 2회 나타났다\",\"마찰음·파찰음의 파열음화가 3회 나타났다\",\"연구개음의 전방화가 모두 3회 나타났다\",\"유음의 비음화가 1회 나타났다\"],\"answer\":3,\"explain\":\"파열음화는 사자→[타다]에서 /ㅅ/→[ㅌ], /ㅈ/→[ㄷ] 2회, 수박→[투박]에서 /ㅅ/→[ㅌ] 1회로 총 3회이다. 연구개음 전방화는 코끼리→[토끼리], 그네→[드네]의 2회, 호랑이→[호앙이]는 유음 탈락이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어(자음) → 아동 발화\\n가방 (ㄱ,ㅂ,ㅇ) → [가바]\\n모자 (ㅁ,ㅈ) → [모다]\\n나무 (ㄴ,ㅁ) → [나무]\\n딸기 (ㄸ,ㄹ,ㄱ) → [딸기]\",\"q\":\"위 낱말 검사에서 아동의 자음정확도(PCC)는?\",\"choices\":[\"6/10 × 100\",\"7/10 × 100\",\"8/10 × 100\",\"9/10 × 100\",\"10/10 × 100\"],\"answer\":3,\"explain\":\"조음해야 할 자음은 총 10개이며, 오류는 '가방'의 종성 /ㅇ/ 생략과 '모자'의 /ㅈ/→[ㄷ] 대치 2개이다. 따라서 자음정확도 = 8/10 × 100 = 80%.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 아동이 어두 /ㅅ/를 [ㄷ]로 대치하는 오류를 보인다. 무의미음절 /사/, /수/에서는 청각·시각 단서를 주면 정조음이 가능하여, 낱말 수준으로 확장하려 한다.\",\"q\":\"어두 /ㅅ/ 확립을 위한 낱말 수준 훈련 목록으로 가장 적절한 것은?\",\"choices\":[\"단추, 다리, 도장\",\"거울, 가위, 구두\",\"사탕, 손, 시소\",\"라면, 리본, 로봇\",\"모자, 무지개, 미소\"],\"answer\":3,\"explain\":\"확립 단계에서는 목표음이 포함된 낱말로 연습해야 하므로 어두에 /ㅅ/가 오는 '사탕, 손, 시소'가 적절하다. 목표음이 안정되면 어중·어말, 문장 수준으로 점차 일반화한다. 나머지는 목표음 /ㅅ/가 포함되지 않은 낱말들이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"순음청력검사 결과\\n• 양측 기도 청력역치: 45 dB HL\\n• 양측 골도 청력역치: 10 dB HL\\n• 기도-골도 차(air-bone gap): 35 dB\",\"q\":\"위 결과에 대한 해석으로 적절한 것은?\",\"choices\":[\"감각신경성 난청이 의심된다\",\"전음성 난청이 의심된다\",\"정상 청력 범위이다\",\"혼합성 난청이며 내이 손상이 확실하다\",\"청신경 종양이 의심된다\"],\"answer\":2,\"explain\":\"골도 역치는 정상이나 기도 역치가 상승하여 기도-골도 차가 존재하는 것은 전음성 난청의 소견으로, 중이염 등 외이·중이의 병변을 확인해야 한다. 감각신경성 난청은 기도·골도가 함께 상승하고 기도-골도 차가 없다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n바지 → [빠지]\\n도로 → [또로]\\n가방 → [까방]\",\"q\":\"위 오류에서 아동이 아직 확립하지 못한 변별자질의 대립은?\",\"choices\":[\"지속성\",\"긴장성\",\"비음성\",\"설측성\",\"공명성\"],\"answer\":2,\"explain\":\"평음 /ㅂ, ㄷ, ㄱ/이 경음 /ㅃ, ㄸ, ㄲ/으로 대치되는 경음화로, [−긴장성]과 [+긴장성]의 대립을 아직 확립하지 못한 것이다. 따라서 긴장성 자질의 대조를 목표로 중재한다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말소리 목록이 매우 제한된 어린 아동에게 실시하는 독립분석(independent analysis)에 대한 설명으로 옳은 것은?\",\"choices\":[\"음운변동의 출현 빈도와 유형을 분석한다\",\"자음정확도(PCC)를 백분율로 산출한다\",\"목표 음소 대비 정확도를 산출한다\",\"산출한 말소리 목록과 음절 구조를 분석한다\",\"오류음의 자극반응도를 함께 측정한다\"],\"answer\":4,\"explain\":\"독립분석은 성인(목표) 형태와 대조하지 않고 아동이 실제로 산출한 말소리 목록·음절 구조 등을 그 자체로 기술하는 방법으로, 말소리 목록이 제한적인 어린 아동에게 유용하다. 목표와 비교하여 정확도·음운변동을 분석하는 것은 관계분석에 해당한다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"문맥검사 결과: 아동은 /ㅅ/를 /ㅣ/ 모음 앞에서만 정조음하고('시소'의 '시'), 다른 모음 문맥에서는 [ㄷ]로 대치한다.\",\"q\":\"위 결과를 활용한 중재 방법으로 적절한 것은?\",\"choices\":[\"비언어적 구강운동 훈련만 실시한다\",\"/시/ 문맥에서 시작해 다른 문맥으로 확대한다\",\"오류가 가장 심한 문맥부터 훈련한다\",\"/ㅅ/ 훈련을 중단하고 다른 음소를 목표로 한다\",\"모든 모음 문맥을 무작위로 섞어 훈련한다\"],\"answer\":2,\"explain\":\"문맥검사에서 발견된 촉진 문맥(정조음 가능한 문맥)은 치료의 출발점이 된다. /시/에서 안정적으로 산출한 뒤 다른 모음 문맥, 음절·낱말 수준으로 점진적으로 일반화시키는 것이 적절하다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"음운인식 능력의 발달에 대한 설명으로 옳은 것은?\",\"choices\":[\"음소 분절 능력이 음절 수 세기보다 먼저 발달한다\",\"음소 조작이 각운(rhyme) 인식보다 먼저 발달한다\",\"음운인식은 읽기(해독) 능력과 전혀 관련이 없다\",\"음소 탈락이 음절 탈락보다 이른 시기에 발달한다\",\"음절 수준 인식이 음소 수준 인식보다 먼저 발달한다\"],\"answer\":5,\"explain\":\"음운인식은 대체로 음절 → 초성-각운(음절체-종성) → 음소 순으로, 큰 단위에서 작은 단위로 발달한다. 따라서 음절 수준 인식이 음소 수준 인식보다 먼저 발달하며, 음운인식은 낱말 해독의 중요한 기초가 된다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"• 3세 남아, 기질적 결함 없음\\n• 산출 가능한 자음이 /ㅁ, ㅂ, ㅃ/로 제한됨\\n• 모음은 대부분 정확하게 산출함\",\"q\":\"위 아동의 초기 목표 낱말 선정 원칙으로 가장 적절한 것은?\",\"choices\":[\"아동의 목록에 없는 음소들로만 구성된 낱말을 선정한다\",\"이미 산출 가능한 음소로 된 기능적 낱말을 선정한다\",\"음절 수가 많고 구조가 복잡한 낱말부터 선정한다\",\"의미보다 발음 난이도가 높은 낱말을 우선 선정한다\",\"사용 빈도가 낮은 낱말을 선정한다\"],\"answer\":2,\"explain\":\"초기 목표 낱말은 아동이 이미 산출 가능한 음소(여기서는 양순음)와 단순한 음절 구조로 이루어지고, 일상에서 의사소통 기능이 높은 낱말이 적절하다. 성공 경험을 통해 의사소통 동기를 높이는 것이 목적이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"구개열 수술을 받은 5세 아동이 파열음·마찰음을 산출할 때 코로 공기가 새고 과다비성이 동반되어 말명료도가 낮다.\",\"q\":\"위 아동의 비강누출·과다비성을 간편하게 선별하는 방법으로 적절한 것은?\",\"choices\":[\"교호운동속도(DDK)를 반복해서 측정한다\",\"순음 청력역치를 측정한다\",\"콧구멍 아래 거울을 대고 김서림을 관찰한다\",\"최대연장발성시간(MPT)을 측정한다\",\"수용어휘력 검사를 함께 실시한다\"],\"answer\":3,\"explain\":\"구강 압력이 필요한 압력자음(파열음·마찰음)을 산출할 때 콧구멍 아래 댄 거울(비경)에 김이 서리는지 관찰하면 비강누출과 과다비성을 간편하게 선별할 수 있다. 나머지는 공명·비강누출을 직접 선별하는 방법이 아니다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"청능훈련의 단계를 발달 순서대로 바르게 나열한 것은?\",\"choices\":[\"탐지 → 변별 → 확인 → 이해\",\"변별 → 탐지 → 확인 → 이해\",\"탐지 → 확인 → 변별 → 이해\",\"확인 → 변별 → 탐지 → 이해\",\"이해 → 확인 → 변별 → 탐지\"],\"answer\":1,\"explain\":\"청능훈련은 소리의 유무를 아는 탐지, 두 소리가 같은지 다른지 아는 변별, 무슨 소리인지 알아 반응하는 확인, 말의 의미를 이해하는 이해의 순서로 진행한다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"'불-풀'처럼 하나의 음소 차이로 의미가 달라지는 낱말 쌍을 이용하는 음운론적 치료 접근은?\",\"choices\":[\"짝자극 기법\",\"최소대립쌍 치료\",\"주기법\",\"전통적 조음지시법\",\"구강운동 훈련\"],\"answer\":2,\"explain\":\"최소대립쌍 치료는 한 음소의 차이로 의미가 구별되는 낱말 쌍을 이용하여 음운 대조를 인식시키고 목표음 산출을 유도하는 음운론적 접근이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"명료도가 매우 낮은 아동을 대상으로 여러 오류 음운패턴을 주기마다 순환하며 목표로 삼는 접근법은?\",\"choices\":[\"짝자극 기법\",\"감각운동 기법\",\"조음점 지시법\",\"주기적 접근법\",\"변별자질 접근법\"],\"answer\":4,\"explain\":\"주기법은 명료도가 매우 낮은 아동을 대상으로 오류 음운 패턴들을 주기(cycle)마다 순환하며 목표로 하는 음운적 접근이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"오류음을 청각·시각적 단서나 모방 조건에서 정확히 산출할 수 있는 정도로, 목표음 선정과 예후 판단에 활용되는 것은?\",\"choices\":[\"자극반응도\",\"말명료도\",\"말소리목록\",\"일관성\",\"음운인식\"],\"answer\":1,\"explain\":\"자극반응도(stimulability)는 단서나 모방 조건에서 오류음을 바르게 산출할 수 있는 정도로, 치료 목표음 선정과 예후 판단에 활용된다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말명료도(speech intelligibility)에 대한 설명으로 가장 적절한 것은?\",\"choices\":[\"화자가 산출한 자음의 정확도만을 의미한다\",\"음도와 강도의 적절성을 의미한다\",\"발화의 문법적 정확성을 의미한다\",\"말속도의 적절성을 의미한다\",\"청자가 알아듣는 정도를 의미한다\"],\"answer\":5,\"explain\":\"말명료도는 화자가 전달한 말을 청자가 얼마나 알아듣는가의 정도로, 오류 말소리의 수·유형·일관성, 운율 등 여러 요인의 영향을 받는다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"/ㅂ/와 /ㅁ/를 구별하는 변별자질은?\",\"choices\":[\"비음성\",\"지속성\",\"설정성\",\"긴장성\",\"고설성\"],\"answer\":1,\"explain\":\"/ㅂ/와 /ㅁ/는 모두 양순음이지만 /ㅁ/는 [+비음성], /ㅂ/는 [-비음성]으로 비음성 자질에서 대립한다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 자음 중 일반적으로 가장 늦게 습득되는 말소리는?\",\"choices\":[\"/ㄷ/\",\"/ㅂ/\",\"/ㅁ/\",\"/ㅅ/\",\"/ㅇ/\"],\"answer\":4,\"explain\":\"비음·파열음은 조기에 습득되는 반면, 치경마찰음 /ㅅ, ㅆ/은 가장 늦게 완전 습득되는 말소리에 속한다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n라면 → [야면]\\n리본 → [이본]\\n나라 → [나야]\",\"q\":\"위 발화에서 공통적으로 나타난 음운변동은?\",\"choices\":[\"유음의 비음화\",\"파열음화\",\"종성 생략\",\"전방화\",\"유음의 단순화\"],\"answer\":5,\"explain\":\"유음 /ㄹ/이 활음 /j/ 또는 생략으로 나타나는 유음의 단순화(활음화)이다. 유음의 비음화라면 /ㄹ/이 /ㄴ/으로 대치된다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n코 → [고]\\n토끼 → [도끼]\\n파 → [바]\",\"q\":\"위 발화에서 공통적으로 나타난 음운변동은?\",\"choices\":[\"탈기식음화\",\"전방화\",\"경음화\",\"연구개음화\",\"기식음화\"],\"answer\":1,\"explain\":\"격음(기식음) /ㅋ, ㅌ, ㅍ/이 평음 /ㄱ, ㄷ, ㅂ/으로 대치되는 탈기식음화(이완음화)이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"아동이 산출한 5개의 낱말 중 3개를 목표 형태와 완전히 동일하게 산출하였다.\",\"q\":\"이 아동의 단어단위정확률(PWC)은?\",\"choices\":[\"0.4\",\"0.5\",\"0.6\",\"0.7\",\"0.8\"],\"answer\":3,\"explain\":\"단어단위정확률(PWC) = 완전히 정확하게 산출한 낱말 수 ÷ 전체 낱말 수 = 3 ÷ 5 = 0.6이다. 낱말 전체를 단위로 조음 능력을 평가하는 지표이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"거울·설압자 등을 이용하여 조음 위치와 방법을 직접 지시하고 시범을 통해 목표음을 유도하는 접근법은?\",\"choices\":[\"주기적 접근법\",\"최소대립쌍 치료\",\"조음점 지시법\",\"음운변동 접근법\",\"상위음운 접근법\"],\"answer\":3,\"explain\":\"조음점 지시법(전통적 접근법)은 조음 위치와 방법을 직접 알려주고 청각·시각·촉각 단서와 시범으로 목표음을 유도하는 운동 중심의 조음치료 접근이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"(아동 발화를 전사한 자료)\\n목표 → 아동 발화\\n코끼리 → [토끼리]\\n가위 → [다위]\\n그네 → [드네]\\n나무 → [나무]\\n우산 → [우산]\",\"q\":\"위 발화에서 공통적으로 나타난 음운변동은?\",\"choices\":[\"연구개음의 전방화\",\"치경음의 후방화\",\"마찰음의 파열음화\",\"종성생략\",\"유음의 단순화\"],\"answer\":1,\"explain\":\"연구개음 /ㄱ, ㅋ, ㄲ/이 치경음 /ㄷ, ㅌ/으로 조음 위치가 앞으로 이동하여 대치되는 연구개음의 전방화이다(코끼리→[토끼리], 가위→[다위], 그네→[드네]).\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"(아동 발화를 전사한 자료)\\n목표: 할머니랑 시장 가서 사탕 샀어요\\n아동: [하머니랑 시장 가서 사탕 다떠요]\",\"q\":\"위 발화에 대한 분석으로 옳은 것은?\",\"choices\":[\"자음정확도는 100%이다\",\"종성생략이 나타났다\",\"유음의 비음화가 나타났다\",\"모든 마찰음을 정확하게 조음하였다\",\"연구개음 전방화가 나타났다\"],\"answer\":2,\"explain\":\"'할머니→[하머니]'에서 종성 /ㄹ/이 생략되었다. 또한 '샀어요→[다떠요]'에서 마찰음 /ㅅ/이 파열음으로 대치되어 마찰음을 정확히 조음하지 못했고, 자음정확도는 100%가 아니다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사 B는 자신이 훈련받거나 슈퍼비전을 받은 적이 없는 삼킴장애 환자를, 관련 교육 없이 인터넷 정보에만 의존하여 단독으로 중재하였다.\",\"q\":\"위 사례에서 위반된 언어재활사 윤리강령의 내용으로 가장 적절한 것은?\",\"choices\":[\"비밀유지의 의무\",\"차별금지의 의무\",\"연구 윤리의 준수\",\"전문성 유지의 의무\",\"동료 간 협력의 의무\"],\"answer\":4,\"explain\":\"언어재활사는 자신이 훈련받고 역량을 갖춘 전문 영역 내에서 서비스를 제공해야 한다. 준비되지 않은 영역을 교육·슈퍼비전 없이 단독으로 수행하는 것은 전문성 유지 의무 위반이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"만 7세 등록 장애아동의 보호자가 발달재활서비스 이용을 문의하였다. 가구 소득은 기준 중위소득 이내이다.\",\"q\":\"위 사례에 대한 안내로 옳은 것은?\",\"choices\":[\"본인부담금을 내고 바우처로 이용할 수 있다\",\"등록 장애아동은 이 서비스를 이용할 수 없다\",\"만 18세 이상만 이용할 수 있다\",\"소득과 무관하게 전액 무료로 지원된다\",\"의료기관 입원 치료만 지원한다\"],\"answer\":1,\"explain\":\"발달재활서비스는 만 18세 미만 등록 장애아동에게 소득 수준별 본인부담금과 함께 언어·청능 등 재활 바우처를 지원한다. 따라서 이 아동은 대상에 해당하며 바우처로 서비스를 이용할 수 있다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"연구 주제: \\\"태블릿 기반 AAC 앱 훈련이 뇌성마비 아동의 자발적 의사소통 시도 횟수에 미치는 효과\\\"\",\"q\":\"위 연구에서 '태블릿 기반 AAC 앱 훈련'에 해당하는 변인은?\",\"choices\":[\"혼란변인\",\"매개변인\",\"통제변인\",\"종속변인\",\"독립변인\"],\"answer\":5,\"explain\":\"독립변인은 연구자가 조작하여 그 효과를 알아보려는 처치이다. 이 연구에서 처치인 'AAC 앱 훈련'이 독립변인이고, 그 결과로 측정되는 '자발적 의사소통 시도 횟수'가 종속변인이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"언어치료 효과에 관한 여러 개별 연구의 결과를 통계적으로 통합하여 전체 효과크기를 분석하는 연구 방법은?\",\"choices\":[\"횡단적 기술연구\",\"단일대상연구\",\"질적 사례연구\",\"델파이 조사\",\"메타분석\"],\"answer\":5,\"explain\":\"메타분석은 동일 주제의 개별 연구 결과들을 수집하여 통계적으로 통합·분석함으로써 전체적인 효과크기를 산출하는 연구 방법이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 회기 목표를 \\\"그림자극 10개 중 8개에서 목표 낱말의 어두 /ㅅ/를 3회기 연속 정조음한다.\\\"로 진술하였다.\",\"q\":\"위 행동목표 진술에 포함된 요소로 볼 수 없는 것은?\",\"choices\":[\"수행 조건(그림자극)\",\"관찰 가능한 목표 행동\",\"사용할 치료 기법\",\"도달 준거(10개 중 8개)\",\"숙달 기준(3회기 연속)\"],\"answer\":3,\"explain\":\"잘 진술된 행동목표는 수행 조건, 관찰 가능한 행동, 도달 준거와 숙달 기준을 포함한다. 그러나 '어떤 기법으로 가르칠지'(치료 기법)는 목표 진술 자체에 포함되는 요소가 아니다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"「장애인복지법」상 1급 언어재활사 국가시험 응시자격으로 옳지 않은 것은?\",\"choices\":[\"2급 자격 없이 언어재활 경력이 5년 이상이면 응시할 수 있다\",\"2급 취득 후 관련 대학원에서 석사·박사학위를 받고 언어재활 경력이 1년 이상이면 응시할 수 있다\",\"2급 취득 후 관련 학과 학사학위 취득자로서 언어재활 경력이 3년 이상이면 응시할 수 있다\",\"응시자격에서 요구하는 경력은 언어재활 분야의 경력을 의미한다\",\"2급 언어재활사 자격 취득이 전제되어야 한다\"],\"answer\":1,\"explain\":\"1급은 2급 자격 취득을 전제로, 관련 대학원 석·박사학위+경력 1년 또는 관련 학과 학사학위+경력 3년의 요건을 갖춰야 한다. 2급 자격 없이 경력만으로는 응시할 수 없다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"개인 언어재활센터에 정규직으로 채용된 언어재활사가 4대 사회보험 가입에 대해 문의하였다.\",\"q\":\"다음 중 보험료를 전액 사업주(사용자)가 부담하는 것은?\",\"choices\":[\"국민연금\",\"산업재해보상보험\",\"국민건강보험\",\"고용보험(실업급여)\",\"노인장기요양보험\"],\"answer\":2,\"explain\":\"산업재해보상보험료는 사업주가 전액 부담한다. 국민연금·국민건강보험·고용보험(실업급여)은 근로자와 사업주가 분담한다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어발달지연 아동의 어머니가 평소 아동에게 빠른 속도로 길고 복잡한 문장을 사용하고, 아동이 반응하기 전에 다음 말을 이어간다.\",\"q\":\"위 어머니에게 제공할 상호작용 지도 내용으로 가장 적절한 것은?\",\"choices\":[\"말속도를 늦추고 짧은 문장으로 말해 주세요\",\"더 빠른 속도로 많은 어휘를 들려주세요\",\"낮고 단조로운 억양으로 말해 주세요\",\"아동이 말할 내용을 대신 말해 주세요\",\"아동의 발화를 자주 교정해 주세요\"],\"answer\":1,\"explain\":\"언어발달을 촉진하려면 느린 말속도, 짧고 단순한 문장, 풍부한 억양과 함께 아동이 반응할 시간을 충분히 기다려 주는 것이 중요하다. 빠르고 복잡한 발화나 대신 말하기, 잦은 교정은 바람직하지 않다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"초등학교 3학년 아동이 지능은 정상 범위이나 낱말을 소리 내어 읽을 때 매우 느리고 자주 틀린다. 반면 들려주는 이야기의 이해력은 또래 수준이다.\",\"q\":\"위 아동에게 우선적으로 고려할 수 있는 진단은?\",\"choices\":[\"경계선 지적장애\",\"고도 감각신경성 난청\",\"단순언어장애\",\"난독증(읽기장애)\",\"말소리장애\"],\"answer\":4,\"explain\":\"지능과 듣기 이해는 정상이나 낱말 해독(정확성·유창성)에서 두드러진 어려움을 보이는 것은 신경생물학적 원인의 난독증(읽기 특정학습장애)의 핵심 양상이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"표준화 검사 적용이 어려운 무발화 영유아의 의사소통 능력을 평가하는 방법으로 가장 적절한 것은?\",\"choices\":[\"표준화 언어검사의 원점수만으로 언어 연령을 산출한다\",\"놀이 상황에서 비구어 의사소통을 관찰한다\",\"아동이 말을 시작할 때까지 평가를 미룬다\",\"보호자 정보는 주관적이므로 배제한다\",\"단일 회기의 검사 점수만으로 장애를 확정한다\"],\"answer\":2,\"explain\":\"무발화 영유아는 표준화 검사 적용이 제한되므로, 자연스러운 놀이·일상 맥락에서 발성의 양과 질, 몸짓, 공동주의, 모방 등 비구어 의사소통을 반복 관찰하고 보호자 면담으로 정보를 보완한다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 SNS에 내담자의 실명과 평가 결과를 본인·보호자의 동의 없이 게시하였다.\",\"q\":\"위 사례에서 위반된 언어재활사 윤리강령의 내용은?\",\"choices\":[\"연구 윤리\",\"비밀유지의 의무\",\"전문성 유지의 의무\",\"동료 간 협력\",\"차별금지\"],\"answer\":2,\"explain\":\"내담자의 개인정보·평가결과를 동의 없이 외부에 공개하는 것은 윤리강령의 비밀유지(비밀보장) 의무 위반이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"언어재활사의 보수교육에 대한 설명으로 옳은 것은?\",\"choices\":[\"1급 언어재활사에게만 부과된다\",\"최초 자격 취득 시 한 번만 받으면 된다\",\"이수 여부는 자격 유지와 무관하다\",\"대학원 재학생만 이수 대상이다\",\"자격 유지를 위해 매년 이수해야 한다\"],\"answer\":5,\"explain\":\"언어재활사는 자격 유지를 위해 매년 정해진 시간의 보수교육을 이수해야 하며, 정당한 사유 없이 연속하여 이수하지 않으면 제재 대상이 될 수 있다. 급수와 무관하게 자격을 가진 언어재활사에게 적용된다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"중재 효과 연구에서 독립변인 외에 종속변인에 영향을 줄 수 있는 변인들을 일정하게 통제하는 주된 이유는?\",\"choices\":[\"연구 대상자 수를 줄이기 위해\",\"종속변인의 측정을 생략하기 위해\",\"내적 타당도를 높이기 위해\",\"연구 결과의 일반화를 제한하기 위해\",\"독립변인을 무작위로 바꾸기 위해\"],\"answer\":3,\"explain\":\"외생변인(혼란변인)을 통제하면 종속변인의 변화가 독립변인(중재) 때문임을 더 확신할 수 있어 연구의 내적 타당도가 높아진다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"한 명 또는 소수의 대상에게 기초선-중재 등의 설계를 적용하여 중재 효과를 검증하는 연구 방법은?\",\"choices\":[\"상관연구\",\"집단비교연구\",\"단일대상연구\",\"델파이 조사\",\"메타분석\"],\"answer\":3,\"explain\":\"단일대상연구는 개별 대상에게 기초선-중재-반전(또는 중다기초선) 등의 설계를 적용하여 중재의 효과를 실험적으로 검증하는 방법으로, 언어재활 임상연구에서 널리 사용된다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"검사도구가 측정하고자 하는 바를 정확하게 측정하는 정도를 의미하는 것은?\",\"choices\":[\"타당도\",\"실용도\",\"신뢰도\",\"객관도\",\"난이도\"],\"answer\":1,\"explain\":\"타당도는 검사가 측정하려는 개념을 실제로 측정하고 있는가의 정도이고, 신뢰도는 측정의 일관성·안정성을 의미한다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"언어재활사의 업무로 가장 적절한 것은?\",\"choices\":[\"청력역치 측정과 의학적 진단\",\"후두의 수술적 처치\",\"의약품의 처방\",\"난청의 외과적 치료\",\"의사소통장애의 평가와 중재\"],\"answer\":5,\"explain\":\"언어재활사는 의사소통장애(언어·조음·유창성·음성·삼킴 등)의 평가와 중재, 대상자·보호자 상담 및 교육을 수행한다. 의학적 진단·처방·수술은 의사의 업무이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"아버지는 한국어, 어머니는 몽골어를 사용하는 가정의 4세 아동이 두 언어에 모두 노출되어 있다. 평가 결과 한국어 어휘 수가 또래보다 적었다.\",\"q\":\"위 아동의 어휘 능력 평가·해석으로 가장 적절한 것은?\",\"choices\":[\"두 언어에서 아는 개념을 합산하여 판단한다\",\"한국어 어휘 수만으로 어휘 지체를 판정한다\",\"두 언어 노출이 어휘 지체의 원인이라고 설명한다\",\"몽골어 사용을 즉시 중단하도록 권고한다\",\"이중언어 아동에게 단일언어 규준을 그대로 적용한다\"],\"answer\":1,\"explain\":\"이중언어 아동의 어휘를 한 언어의 낱말 수만으로 판단하면 과소평가되므로, 두 언어에 걸쳐 아는 개념을 합산한 개념 어휘(conceptual vocabulary)로 평가해야 한다. 이중언어 노출 자체는 언어장애의 원인이 아니다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"연구 참여자에게 연구의 목적·절차·위험을 설명하고 자발적 참여 동의를 받는 절차는?\",\"choices\":[\"사후 결과 보고\",\"고지된 사전 동의\",\"사후 디브리핑\",\"무선 할당 배치\",\"이중 은폐법 적용\"],\"answer\":2,\"explain\":\"사전 동의(고지된 동의, informed consent)는 연구 참여 전에 목적·절차·이익·위험 등을 충분히 설명하고 자발적 동의를 받는 연구윤리의 기본 절차이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"첫 상담에서 언어재활사가 보호자에게 상담의 목적과 진행 방식을 설명하고, 아동의 발달력과 가정에서의 의사소통 모습에 대한 정보를 수집하며 신뢰 관계를 형성하였다.\",\"q\":\"위 상담에 해당하는 부모상담 단계는?\",\"choices\":[\"실행 단계\",\"종결 단계\",\"추후 단계\",\"초기 단계\",\"평가 단계\"],\"answer\":4,\"explain\":\"상담의 목적·절차 안내, 라포 형성, 기초 정보 수집은 상담의 초기(준비) 단계에서 이루어진다. 공감적 반응을 바탕으로 구체적 문제해결 방안을 제시·실행하는 것은 실행 단계이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"다문화가족·한부모가족 등의 자녀 중 언어발달이 지연된 아동에게 언어평가와 언어촉진 교육을 제공하는 지원사업이 있다.\",\"q\":\"위 사업에 대한 설명으로 옳은 것은?\",\"choices\":[\"등록 장애아동만을 대상으로 하는 의료 서비스이다\",\"언어를 평가하고 언어촉진 교육을 제공한다\",\"성인을 대상으로 하는 직업재활 사업이다\",\"자격 없이 누구나 중재를 제공할 수 있다\",\"평가 없이 모든 아동에게 동일한 프로그램을 제공한다\"],\"answer\":2,\"explain\":\"다문화가족 자녀 등을 위한 언어발달지원사업은 언어발달이 지연된 아동을 평가하고, 부모교육을 포함한 언어촉진 교육을 제공한다. 등록 장애아동을 주 대상으로 하는 발달재활서비스와는 대상·성격이 다르다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"PK-WAB-R 하위검사 원점수\\n• 스스로 말하기: 14/20\\n• 알아듣기: 160/200\\n• 따라말하기: 80/100\\n• 이름대기: 70/100\",\"q\":\"이 환자의 실어증지수(AQ)로 옳은 것은? (AQ = [스스로말하기 + 알아듣기÷20 + 따라말하기÷10 + 이름대기÷10] × 2)\",\"choices\":[\"68.0\",\"72.0\",\"82.0\",\"74.0\",\"88.0\"],\"answer\":4,\"explain\":\"(14 + 160÷20[=8] + 80÷10[=8] + 70÷10[=7]) × 2 = (14+8+8+7)×2 = 74.0. ※AQ 산출식·중증도 절단점은 사용하는 교재 기준으로 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 발화는 유창하나 착어가 섞임\\n• 청각적 이해가 심하게 손상됨\\n• 따라말하기는 비교적 보존됨(88/100)\\n• 병식이 부족함\",\"q\":\"이 환자의 실어증 유형과 손상 추정 부위로 옳은 것은?\",\"choices\":[\"베르니케실어증 – 상측두회 후방\",\"명칭실어증 – 각회·측두엽 하부\",\"전도실어증 – 궁상다발·연상회\",\"연결피질감각실어증 – 후방 분수계\",\"혼합연결피질실어증 – 광범위 분수계\"],\"answer\":4,\"explain\":\"이해 손상+유창 착어는 베르니케와 유사하나 따라말하기가 보존되면 연결피질감각실어증(분수계 영역)으로 감별한다. 혼합연결피질은 따라말하기만 남고 이해·표현이 모두 심하게 손상되며 반향어를 보인다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"VFSS 소견\\n• 얇은 액체에서 삼킴 전 후두계곡으로 조기 흘러넘침, 삼킴반사 지연\\n• 후두 침습이 관찰되나 반사적 기침이 없음(무증상 침습)\\n• 점도를 높이면 침습이 소실됨\",\"q\":\"이 환자에게 가장 적절한 중재 조합은?\",\"choices\":[\"점도 증가 + 턱 당기기 + 삼킴반사 촉진\",\"얇은 액체 유지 + 성문상 삼킴 교육\",\"전면 금식 후 즉시 비위관 삽입 유지\",\"멘델슨 기법 + 혀 저항 운동 적용\",\"고개 젖히기 + 얇은 액체 여러 번 삼키기\"],\"answer\":1,\"explain\":\"조기 흘러넘침·반사 지연으로 인한 무증상 침습은 점도 증가로 흐름을 늦추고 chin-tuck으로 기도 입구를 보호하며 삼킴반사 촉진을 병행하는 것이 적절하다. 고개 젖히기는 흡인 위험을 높여 금기이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 소뇌 병변\\n• 자음·모음이 불규칙하게 붕괴됨\\n• 음절 강세가 불규칙하고 과도함\\n• 말속도가 느리고 음도·강도가 불규칙하게 변동함\",\"q\":\"이완형 마비말장애와 감별되는 이 유형(실조형)의 핵심 소견은?\",\"choices\":[\"과비성과 기식성 음성 동반\",\"쥐어짜는 듯한 노력성 음성\",\"단조로운 음도와 감소된 발성 강도\",\"불규칙적 조음 오류와 운율 붕괴\",\"말속도가 점점 빨라지고 뭉개짐\"],\"answer\":4,\"explain\":\"실조형(소뇌)은 불규칙한 조음 붕괴와 과도·불규칙한 강세가 특징이다. 이완형은 과비성·기식성(하부운동신경), 경직형은 쥐어짜는 노력성 음성, 과소운동형은 단조·약한 강도와 말속도 가속을 보인다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"낱말 읽기 검사\\n• 규칙어('바다','구름')는 정확히 읽음\\n• 불규칙어('굳이'→'구디')를 규칙화하여 잘못 읽음\\n• 비단어('무핀') 읽기는 양호함\",\"q\":\"이 환자의 실독증 유형과 손상된 읽기 경로는?\",\"choices\":[\"심층실독증 – 의미 경로\",\"표층실독증 – 어휘 경로\",\"음운실독증 – 음운 경로\",\"순수실독증 – 시각 입력\",\"무시실독증 – 주의\"],\"answer\":2,\"explain\":\"규칙어·비단어는 잘 읽으나 불규칙어에서 규칙화 오류가 나타나면 어휘(자소-의미) 경로가 손상되고 음운 경로에 의존하는 표층실독증이다. 심층실독증은 의미착어와 비단어 읽기의 심한 손상, 음운실독증은 비단어 읽기의 선택적 손상을 보인다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 서서히 진행되는 언어 저하\\n• 발화는 유창하나 따라말하기와 낱말 인출이 손상됨\\n• 음소착어가 관찰되고 발화 중 낱말 찾기 지연이 잦음\\n• 낱말·대상 의미 지식과 문법은 상대적으로 보존됨\",\"q\":\"이 환자의 원발진행실어증(PPA) 유형은?\",\"choices\":[\"의미형 PPA\",\"로고페닉형 PPA\",\"비유창/실문법형 PPA\",\"혼합형 PPA\",\"PPA에 해당하지 않음\"],\"answer\":2,\"explain\":\"따라말하기·낱말인출 손상, 음소착어, 의미·문법의 상대적 보존은 로고페닉형 PPA이다. 의미형은 낱말 의미·대상지식 소실, 비유창/실문법형은 문법 붕괴와 말산출의 노력성이 특징이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"브로카실어증 환자의 이름대기 중재로 의미자질분석(SFA)을 적용하려 한다.\",\"q\":\"SFA의 치료 기전으로 옳은 것은?\",\"choices\":[\"조음 운동을 반복 학습시켜 산출을 자동화한다\",\"억양과 리듬을 이용해 발화를 유도한다\",\"의미자질을 활성화하여 낱말 인출을 촉진한다\",\"제스처를 제한하고 구어 산출을 강제한다\",\"문법형태소 산출을 위계적으로 훈련한다\"],\"answer\":3,\"explain\":\"SFA는 목표 낱말의 범주·기능·특성 등 의미자질을 체계적으로 활성화해 어휘-의미망을 강화하고 낱말 인출을 촉진하는 기법이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"우반구 손상 환자\\n• 은유·농담의 함축을 파악하지 못함\\n• 말의 억양이 단조롭고 상대의 감정을 억양으로 읽지 못함\\n• 그림 왼쪽 세부를 자주 놓침\",\"q\":\"이 환자의 중재로 적절하지 않은 것은?\",\"choices\":[\"문법형태소 산출 반복 훈련\",\"함축·화용 추론 훈련\",\"운율 산출·해석 훈련\",\"좌측 훑어보기 훈련\",\"대화 상황에서의 화용 피드백\"],\"answer\":1,\"explain\":\"우반구 손상은 화용·운율·좌측 무시가 특징이므로 그에 맞는 중재가 필요하다. 문법형태소 산출 훈련은 좌반구 실문법증(브로카)에 해당하는 중재로 이 환자에게 부적절하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 비유창성 실어증\\n• 스스로 말하기는 매우 제한적이나 익숙한 노래의 가락에 맞추면 몇몇 구를 산출함\",\"q\":\"이 환자에게 적용할 치료법과 그 근거로 옳은 것은?\",\"choices\":[\"의미자질분석 – 의미망 강화\",\"멜로디 억양 치료 – 우반구 활용\",\"제약유발 언어치료 – 구어 강제\",\"각본 훈련 – 자동구어 활용\",\"보완대체의사소통 – 구어 포기\"],\"answer\":2,\"explain\":\"멜로디 억양 치료(MIT)는 억양·리듬 처리에 관여하는 우반구 기능을 활용하여 비유창성 실어증 환자의 발화 산출을 촉진하는 기법으로, 노래 가락에서 발화가 촉진되는 이 사례에 적합하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"전도실어증 환자\\n• 유창한 발화, 양호한 청각적 이해\\n• 음소착어가 잦고 따라말하기가 선택적으로 손상됨\\n• 자신의 오류를 알아채고 반복 수정(접근 시도)함\",\"q\":\"이 환자의 중재로 가장 적절한 것은?\",\"choices\":[\"청각적 이해력 향상 훈련을 우선한다\",\"문법형태소 산출 훈련을 집중한다\",\"제스처만으로 의사소통하도록 유도한다\",\"음소 단서로 따라말하기를 반복 훈련한다\",\"완전 무발화로 보고 AAC를 즉시 도입한다\"],\"answer\":4,\"explain\":\"전도실어증은 이해가 양호하고 음소착어·따라말하기 손상이 핵심이므로, 따라말하기 과제와 음소 수준의 자기 수정(접근 시도)을 활용한 반복 훈련이 적절하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"전반실어증 환자\\n• 발화·이해·따라말하기·이름대기가 모두 심하게 손상됨\\n• 몇몇 자동구어와 상황에 맞는 표정·제스처는 남아 있음\",\"q\":\"초기 단계에 우선적으로 고려할 중재로 가장 적절한 것은?\",\"choices\":[\"복잡한 통사 구조의 문장 이해 훈련\",\"비단어 따라말하기 훈련\",\"불규칙어 소리 내어 읽기 훈련\",\"빠른 이름대기 속도 훈련\",\"AAC와 의사소통 파트너 훈련\"],\"answer\":5,\"explain\":\"전반실어증 초기에는 잔존 능력(제스처·표정·자동구어)을 활용한 보완대체의사소통(AAC)과 보호자·파트너 훈련으로 기능적 의사소통을 확보하는 것이 우선이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"명칭실어증 환자에게 이름대기 단서를 위계적으로 제공하려 한다.\",\"q\":\"단서(cueing hierarchy)를 강도가 약한 것부터 강한 것 순으로 옳게 배열한 것은?\",\"choices\":[\"초성 음소 단서 → 의미 단서 → 문장 완성 단서 → 따라말하기\",\"의미 단서 → 따라말하기 → 초성 음소 단서 → 문장 완성 단서\",\"따라말하기 → 초성 음소 단서 → 의미 단서 → 문장 완성 단서\",\"문장 완성 단서 → 따라말하기 → 의미 단서 → 초성 음소 단서\",\"의미 단서 → 초성 음소 단서 → 문장 완성 단서 → 따라말하기\"],\"answer\":5,\"explain\":\"단서는 약한(의미) 것에서 강한(따라말하기) 것으로 위계적으로 제공하는 것이 일반적이다. 의미 단서 → 음소(초성) 단서 → 문장 완성 → 따라말하기 순으로 갈수록 인출 지원 강도가 커진다. ※단서 위계 순서는 교재별 차이가 있어 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 근력 저하 없이 말소리를 탐색하는 입술·혀의 모색행동\\n• 같은 낱말에서도 매번 다른 조음 오류\\n• 자동구어는 비교적 유창함\",\"q\":\"이 환자(말실행증)에게 적용할 치료 원리로 가장 적절한 것은?\",\"choices\":[\"운동학습 원리의 집중 조음 연습\",\"구강 근력 강화를 위한 저항 운동\",\"청각적 이해력 향상 훈련\",\"호흡 지구력 강화 반복 훈련\",\"과비성 감소를 위한 공명 훈련\"],\"answer\":1,\"explain\":\"말실행증은 근력 문제가 아니라 말운동 프로그래밍의 손상이므로, 운동학습 원리(반복·점진적 난이도·피드백)를 적용해 조음점 전환을 집중적으로 반복 연습하는 것이 핵심이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 양측 상부운동신경(추체로) 병변\\n• 느리고 노력성인 말, 쥐어짜는 듯한 거친 음성\\n• 과비성 동반, 말속도 저하\",\"q\":\"이 유형(경직형)의 마비말장애 환자에게 적절한 중재는?\",\"choices\":[\"말속도를 더 높여 자연스러움을 늘린다\",\"성대를 더 강하게 조이는 발성 훈련\",\"불수의 운동 억제 약물만 적용한다\",\"비강 공명을 늘리는 비음 강화 훈련\",\"근긴장 완화와 말속도·강세 조절 중재\"],\"answer\":5,\"explain\":\"경직형은 근긴장 항진으로 노력성·쥐어짜는 음성을 보이므로, 과도한 근긴장을 완화하는 이완 중재와 말속도·강세 등 운율 조절 중재가 적절하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 하부운동신경/뇌신경 병변\\n• 과비성이 두드러지고 기식성 음성\\n• 압력 자음 산출이 약하고 콧길로 공기가 새어 나옴\",\"q\":\"이 환자(이완형 마비말장애, 구개인두 기능부전)에게 우선 고려할 중재는?\",\"choices\":[\"말속도 감소 훈련\",\"불수의 운동 억제\",\"구개거상장치 적용\",\"좌측 훑어보기 훈련\",\"억양·리듬 치료\"],\"answer\":3,\"explain\":\"이완형에서 과비성·비누출은 구개인두 폐쇄부전 때문이므로, 구개인두 폐쇄 강화 중재와 필요 시 구개거상장치(palatal lift) 적용이 적절하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 파킨슨병(기저핵 회로 퇴행)\\n• 단조로운 음도, 감소된 강도, 말속도 가속으로 음절이 뭉개짐\\n• 환자는 자신의 목소리가 작다는 것을 잘 인식하지 못함\",\"q\":\"이 환자에게 근거가 확립된 치료법과 표적으로 옳은 것은?\",\"choices\":[\"CILT – 구어 산출 강제\",\"MIT – 억양·리듬 활용\",\"LSVT LOUD – 강도 증대\",\"SFA – 의미자질 분석\",\"chin-tuck – 삼킴 자세\"],\"answer\":3,\"explain\":\"과소운동형(파킨슨) 마비말장애에는 발성 강도(loudness) 증대에 초점을 둔 LSVT LOUD의 근거가 확립되어 있다. 강도 감각의 재보정(calibration)을 통해 말명료도를 높인다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"삼킴장애 환자에게 다음 순서의 기법을 교육하였다.\\n① 음식을 입에 넣고 숨을 참는다 → ② 삼킨다 → ③ 삼킨 직후 기침을 한다 → ④ 다시 삼킨다\",\"q\":\"이 기법의 목적으로 옳은 것은?\",\"choices\":[\"상부식도괄약근의 개방 시간을 늘린다\",\"식도의 연동 운동을 빠르게 촉진한다\",\"혀 기저부의 후방 이동을 강화한다\",\"구강 준비 단계의 저작을 촉진한다\",\"삼킴 전·중 성대를 닫아 기도를 보호한다\"],\"answer\":5,\"explain\":\"성문상 삼킴(supraglottic swallow)은 삼킴 전·중 성대를 닫아 기도를 보호하고, 삼킴 후 기침으로 성문 위 잔여물을 배출하는 기법이다. 상부식도괄약근 개방 연장은 멘델슨 기법의 목적이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"삼킴 시 후두 거상이 불충분하고 상부식도괄약근(UES) 개방이 짧아 인두에 잔여물이 남는 환자.\",\"q\":\"가장 적절한 삼킴 기법은?\",\"choices\":[\"턱 당기기\",\"고개 돌리기\",\"성문상 삼킴\",\"멘델슨 기법\",\"고개 젖히기\"],\"answer\":4,\"explain\":\"멘델슨 기법(Mendelsohn maneuver)은 삼킴 시 후두 거상을 의도적으로 유지하여 상부식도괄약근 개방 시간을 늘리고 인두 잔여물을 줄인다. 턱 당기기(chin-tuck)는 기도 입구 보호, 고개 돌리기(head rotation)는 편측 인두 약화 시 건강한 쪽으로 식괴를 유도하는 자세이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"만성 실어증 환자에게 일상에서 구어 사용을 늘리기 위한 강도 높은 치료를 계획한다.\",\"q\":\"제약유발 언어치료(CILT)의 핵심 원리로 옳은 것은?\",\"choices\":[\"제스처·그림 등 비구어 수단을 적극 허용한다\",\"억양과 리듬을 이용해 발화를 유도한다\",\"비구어 수단을 제한하고 구어 산출을 강제한다\",\"목표 낱말의 의미자질을 분석하게 한다\",\"보호자가 환자 대신 말하도록 연습한다\"],\"answer\":3,\"explain\":\"CILT는 보상적 비구어 수단 사용을 제한하고, 강도 높은 구어 산출을 반복적으로 유도하여 학습된 미사용(learned nonuse)을 극복하는 원리를 따른다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"경도~중등도 실어증 환자가 병원 접수·전화 등 특정 상황에서 필요한 발화를 자동화하고자 한다.\",\"q\":\"이 목표에 가장 적합한 중재는?\",\"choices\":[\"비단어 따라말하기 훈련\",\"각본(스크립트) 훈련\",\"불규칙어 읽기 훈련\",\"좌측 훑어보기 훈련\",\"구강 근력 강화 훈련\"],\"answer\":2,\"explain\":\"각본 훈련은 특정 상황에 필요한 대화를 반복 연습해 유창하고 자동화된 발화를 산출하도록 돕는 기능적 중재로, 상황 특이적 목표에 적합하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사자: \\\"이 그림(복잡한 장면)을 설명해 보세요.\\\"\\n환자A: 문법형태소를 생략한 전보식·비유창 발화\\n환자B: 유창하나 착어가 많고 상황과 무관한 공허한 발화\",\"q\":\"두 환자에 대한 감별과 중재로 옳은 것은?\",\"choices\":[\"A는 브로카·산출 중재, B는 베르니케·이해 중재\",\"A는 베르니케·이해 중재, B는 브로카·문법 중재\",\"A는 브로카·이해 중재, B는 베르니케·문법 중재\",\"A·B 모두 전도실어증으로 따라말하기 중재 우선\",\"A·B 모두 명칭실어증으로 이름대기 중재 우선\"],\"answer\":1,\"explain\":\"전보식·비유창(A)은 브로카로 발화 산출·문법 중재가, 유창하나 공허·착어(B)는 베르니케로 청각적 이해 중재가 우선된다. 진단을 서로 바꾸거나 진단에 맞지 않는 중재를 짝지은 선택지는 틀리다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"외상성 뇌손상(TBI) 환자\\n• 새로 들은 정보를 즉시 회상하지 못하고, 약속·일정을 자주 잊음\\n• 대화가 장황하고 주제에서 벗어남\",\"q\":\"이 환자의 인지-의사소통 중재로 가장 적절한 것은?\",\"choices\":[\"불규칙어 소리 내어 읽기 훈련\",\"과비성 감소를 위한 공명 훈련\",\"외부 기억 보조와 화용 훈련\",\"성문상 삼킴 기법 반복 훈련\",\"좌측 공간 훑어보기 훈련\"],\"answer\":3,\"explain\":\"TBI의 기억·집행기능·화용 저하에는 다이어리·알림 등 외부 기억 보조 전략 활용과 주제 유지를 포함한 화용 중재가 효과적이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"초기 알츠하이머병 치매 환자. 최근 기억 저하가 있으나 절차기억은 비교적 보존됨.\",\"q\":\"이 환자의 이름대기·일상 기억 유지를 위한 중재로 가장 적절한 것은?\",\"choices\":[\"복잡한 통사 이해 훈련\",\"간격 회상 기법 적용\",\"비단어 따라말하기\",\"제약유발 언어치료\",\"구강 근력 강화 훈련\"],\"answer\":2,\"explain\":\"치매에서는 보존된 절차기억·점화를 활용한 간격 회상(spaced retrieval)과 환경 단서·일과표 등 환경 수정이 효과적이며, 무오류 학습 원리를 함께 적용한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"여러 실어증 환자를 대상으로 그룹치료를 운영하며, 실제 대화처럼 새 정보를 주고받는 능력을 기르고자 한다.\",\"q\":\"의사소통효과증진법(PACE)의 원리로 옳은 것은?\",\"choices\":[\"새 정보를 다양한 수단으로 주고받는다\",\"치료사가 정답을 먼저 알려 주고 시작한다\",\"환자가 구어만 사용하도록 제한한다\",\"문법형태소를 정확히 산출하게 한다\",\"그림 이름을 순서대로 따라 말하게 한다\"],\"answer\":1,\"explain\":\"PACE는 치료사와 환자가 순번을 교대하며 상대가 모르는 새 정보를 전달하고, 구어·제스처·그림 등 다양한 수단을 자유롭게 활용해 의사소통 효율을 높이는 화용 중심 접근이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌손상 환자\\n• 근긴장 저하, 안정 시 떨림 없음\\n• 보행이 불안정함\\n• 손가락-코 검사에서 목표를 지나치고 흔들림(측정이상)\",\"q\":\"손상 부위로 가장 적절한 것은?\",\"choices\":[\"시상\",\"소뇌\",\"해마\",\"기저핵\",\"측두엽\"],\"answer\":2,\"explain\":\"근긴장 저하·측정이상(dysmetria)·보행 실조·의도성 떨림은 소뇌 손상의 특징이다. 기저핵 손상은 안정 시 떨림·경직·운동완만을 보인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"혀를 내밀게 하니 혀끝이 왼쪽으로 치우치고, 왼쪽 혀의 위축이 관찰됨.\",\"q\":\"손상된 뇌신경으로 옳은 것은?\",\"choices\":[\"왼쪽 안면신경(7번)\",\"오른쪽 설하신경(12번)\",\"왼쪽 설하신경(12번)\",\"왼쪽 삼차신경(5번)\",\"오른쪽 미주신경(10번)\"],\"answer\":3,\"explain\":\"혀 운동은 설하신경(12번)이 지배하며, 손상 시 혀를 내밀면 손상된 쪽으로 편위되고 그쪽 혀가 위축된다. 왼쪽으로 편위+왼쪽 위축이면 왼쪽 설하신경 손상이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사 설명\\n• 실어증 유무와 유형을 확인함\\n• 스스로 말하기·알아듣기·따라말하기·이름대기를 평가함\\n• 실어증지수(AQ)를 산출함\",\"q\":\"해당하는 검사는?\",\"choices\":[\"한국판 간이정신상태검사(K-MMSE)\",\"한국판 몬트리올 인지평가(K-MoCA)\",\"실어증-신경언어장애 선별검사(STAND)\",\"파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R)\",\"한국 실어증 감별진단 검사(KTDDA)\"],\"answer\":4,\"explain\":\"AQ 산출과 4개 언어영역 평가로 실어증 유형을 진단하는 검사는 PK-WAB-R이다. STAND는 선별검사, K-MMSE·K-MoCA는 인지선별검사이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사자: (사과 그림) \\\"이름이 무엇입니까?\\\"\\n환자: \\\"그… 먹는 거… 빨갛고 둥근… 그거요.\\\"\",\"q\":\"이 환자가 보이는 이름대기 오류 유형은?\",\"choices\":[\"보속증\",\"음소착어\",\"에두르기\",\"신조착어\",\"의미착어\"],\"answer\":3,\"explain\":\"목표 낱말을 산출하지 못하고 그 특징이나 기능을 우회적으로 설명하는 것은 에두르기(circumlocution)이다. 의미착어는 관련 낱말로 대치('사과'→'포도'), 음소착어는 음소 대치('사과'→'다과')이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"낱말 읽기\\n• 실제 낱말을 의미적으로 관련된 낱말로 대치함('버스'→'기차')\\n• 비단어('무핀') 읽기가 거의 불가능함\\n• 추상어보다 구체어를 더 잘 읽음\",\"q\":\"이 실독증 유형은?\",\"choices\":[\"표층실독증\",\"음운실독증\",\"무시실독증\",\"순수실독증\",\"심층실독증\"],\"answer\":5,\"explain\":\"의미착어(의미 대치), 비단어 읽기의 심한 손상, 구체어>추상어의 심상성 효과는 심층실독증의 특징이다. 표층은 불규칙어 규칙화 오류, 음운실독증은 비단어의 선택적 손상을 보인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 발화는 유창하나 착어가 섞임\\n• 청각적 이해가 심하게 손상됨\\n• 따라말하기도 손상됨\\n• 병식이 부족함\",\"q\":\"이 환자의 실어증 유형은?\",\"choices\":[\"브로카실어증\",\"연결피질감각실어증\",\"전도실어증\",\"베르니케실어증\",\"명칭실어증\"],\"answer\":4,\"explain\":\"유창한 착어 발화+이해 손상+따라말하기 손상+병식 부족은 베르니케실어증이다. 따라말하기가 보존되면 연결피질감각실어증으로 감별한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 느리고 노력성인 비유창 발화\\n• 조사·어미 등 문법형태소를 생략하는 전보식 발화\\n• 따라말하기 손상, 단순 지시 이해는 비교적 양호\",\"q\":\"이 환자의 실어증 유형은?\",\"choices\":[\"명칭실어증\",\"베르니케실어증\",\"전도실어증\",\"전반실어증\",\"브로카실어증\"],\"answer\":5,\"explain\":\"비유창·노력성·전보식(실문법) 발화, 손상된 따라말하기, 비교적 양호한 이해는 브로카실어증의 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 유창한 발화에 음소착어가 잦음\\n• 청각적 이해는 양호함\\n• 따라말하기가 선택적으로 뚜렷하게 손상됨\",\"q\":\"이 환자의 실어증 유형과 관련 손상 구조로 옳은 것은?\",\"choices\":[\"베르니케실어증 – 상측두회\",\"전도실어증 – 궁상다발\",\"브로카실어증 – 하전두회\",\"명칭실어증 – 각회\",\"전반실어증 – 광범위\"],\"answer\":2,\"explain\":\"유창+이해 양호+따라말하기의 선택적 손상+음소착어는 전도실어증이며, 브로카·베르니케 영역을 잇는 궁상다발 손상과 관련된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌졸중에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"색전증은 다른 부위의 혈전 조각이 혈관을 막아 발생한다\",\"허혈성 뇌졸중의 가장 대표적인 원인은 혈관 파열이다\",\"혈전증은 혈관벽이 풍선처럼 약하게 부풀어 발생한다\",\"출혈성 뇌졸중은 허혈성 뇌졸중보다 발생 빈도가 높다\",\"지주막하출혈은 혈관이 서서히 좁아지며 막혀 발생한다\"],\"answer\":1,\"explain\":\"색전증은 다른 부위(심장 등)에서 형성된 색전이 이동해 혈관을 막아 갑작스럽게 발생한다. 허혈성이 출혈성보다 흔하며, 허혈성의 주 기전은 혈전·색전에 의한 혈관 폐색이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌경색 환자\\n• 시력·시야 검사 결과 이상 없음\\n• 실제 낱말과 무의미 낱말을 모두 소리 내어 읽지 못함\\n• 받아쓰기와 자발적 글쓰기도 함께 저하됨\",\"q\":\"손상 가능성이 가장 높은 동맥은?\",\"choices\":[\"전대뇌동맥\",\"후대뇌동맥\",\"척추기저동맥\",\"내경동맥 안분지\",\"중대뇌동맥\"],\"answer\":5,\"explain\":\"읽기와 쓰기가 함께 손상된 실서증 동반 실독증은 좌측 각회 손상으로 생기며, 각회는 중대뇌동맥 관류 영역이다. 쓰기가 보존되는 순수 실독증(실서증 없는 실독증)은 좌측 후두엽과 뇌량 팽대부 손상으로 생기고 후대뇌동맥과 관련된다. 두 유형은 쓰기 손상 여부로 구별한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"실어증 환자의 PK-WAB-R 결과\\n• AQ 37점, 스스로 말하기 6/20(비유창)\\n• 알아듣기 양호, 따라말하기 비교적 보존\",\"q\":\"이 프로파일에 가장 부합하는 실어증 유형은?\",\"choices\":[\"연결피질운동실어증\",\"전도실어증\",\"베르니케실어증\",\"명칭실어증\",\"연결피질감각실어증\"],\"answer\":1,\"explain\":\"비유창하나 이해가 양호하고 따라말하기가 유창성에 비해 뚜렷하게 보존되면 연결피질운동실어증이다. 브로카는 따라말하기도 손상된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"마비말장애 유형에 대한 설명이다.\",\"q\":\"유형과 특징이 옳게 연결된 것은?\",\"choices\":[\"실조형 – 불규칙한 조음 오류와 과도·불규칙한 강세\",\"경직형 – 기식음과 가청 흡기음이 두드러짐\",\"이완형 – 쥐어짜는 듯한 노력성 음성이 두드러짐\",\"과소운동형 – 불수의적 과다 운동으로 인한 변동\",\"과다운동형 – 감소된 강도와 짧은 말 돌진이 두드러짐\"],\"answer\":1,\"explain\":\"실조형(소뇌)은 불규칙 조음·과도 강세가 특징이다. 이완형(하부운동신경)은 기식음·가청 흡기음·과비성, 경직형은 쥐어짜는 노력성 음성, 과소운동형은 단조로운 음도·감소된 강도·짧은 말 돌진, 과다운동형은 불수의 운동에 따른 변동을 보인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 같은 낱말에서도 매번 다른 조음 오류를 보임\\n• 말소리를 찾는 듯한 입술·혀의 모색행동\\n• 근력 약화는 뚜렷하지 않음\",\"q\":\"이 환자의 말장애로 가장 적절한 것은?\",\"choices\":[\"이완형 마비말장애\",\"경직형 마비말장애\",\"말실행증(AOS)\",\"실조형 마비말장애\",\"과소운동형 마비말장애\"],\"answer\":3,\"explain\":\"비일관적 조음 오류와 모색행동, 뚜렷하지 않은 근력 약화는 말운동 프로그래밍의 손상인 말실행증의 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"말실행증과 마비말장애를 감별하려 한다.\",\"q\":\"말실행증에 더 부합하는 특징은?\",\"choices\":[\"일관되고 예측 가능한 조음 오류\",\"근긴장 항진에 따른 느리고 힘든 말\",\"지속적인 과비성과 비강 누출\",\"비일관적 조음 오류와 모색행동\",\"호흡·발성 기능의 지속적 약화\"],\"answer\":4,\"explain\":\"말실행증은 비일관적 오류와 모색행동이 특징인 반면, 마비말장애는 근육 약화·마비에 따른 비교적 일관된 오류와 음성·공명 이상을 보인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"수정바륨삼킴검사 단계별 결과\\n• 구강 준비·구강 운반 단계: 정상\\n• 인두 단계: 삼킴반사 지연, 후두계곡·조롱박오목에 잔여물\\n• 식도 단계: 정상\",\"q\":\"문제가 있는 단계는?\",\"choices\":[\"구강 준비 단계\",\"구강 운반 단계\",\"정상 소견\",\"식도 단계\",\"인두 단계\"],\"answer\":5,\"explain\":\"삼킴반사 지연과 인두 잔여물은 인두 단계의 문제이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"삼킴장애 환자에게서 다음 소견이 관찰됨.\\n• 삼킨 뒤에도 기침·목소리 변화가 없으나 흉부 영상에서 흡인 소견이 확인됨\",\"q\":\"이 현상에 대한 설명으로 옳은 것은?\",\"choices\":[\"기침 반사가 유지된 정상적인 방어 반응이다\",\"기도 방어 반사 저하를 시사하는 무증상 흡인\",\"구강 준비 단계의 저작 문제로 인한 것이다\",\"식도 이완불능증에서 보이는 전형적 특징이다\",\"미각 저하로 인한 일시적인 삼킴 지연이다\"],\"answer\":2,\"explain\":\"기침 등 외현적 징후 없이 성문 아래로 이물이 넘어가는 것을 무증상 흡인(silent aspiration)이라 하며, 감각·기도 방어 반사 저하와 관련되어 위험이 크다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"정상 삼킴 생리의 단계에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"구강 준비 단계에서 삼킴반사가 유발된다\",\"인두 단계에서 연구개가 하강하여 비강이 열린다\",\"인두 단계에서 후두가 상승하고 성대가 닫힌다\",\"식도 단계는 주로 수의적으로 조절된다\",\"구강 운반 단계에서 상부식도괄약근이 열린다\"],\"answer\":3,\"explain\":\"인두 단계에서 후두 거상·성대 폐쇄·후두개 하강으로 기도가 보호되고 상부식도괄약근이 열려 음식이 식도로 이동한다. 연구개는 상승하여 비인두를 막는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"DSM-5에서 알츠하이머병으로 인한 경도 신경인지장애를 진단하려 한다.\",\"q\":\"필수적인 조건으로 옳은 것은?\",\"choices\":[\"인지 저하로 일상활동의 독립성이 상실됨\",\"삼킴능력의 뚜렷한 저하가 동반됨\",\"경미한 인지 저하가 있으나 독립성 유지\",\"시각·청각 등 말초 지각능력의 저하\",\"편측 운동마비와 보행장애의 동반\"],\"answer\":3,\"explain\":\"경도 신경인지장애는 인지영역의 경미한 저하가 있으나 일상생활의 독립성은 유지된다. 독립성이 상실되면 주요(major) 신경인지장애로 진단한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"인지의사소통장애·치매 유형에 대한 설명이다.\",\"q\":\"옳게 연결된 것은?\",\"choices\":[\"알츠하이머 치매 – 발병 초기부터 비유창 발화가 두드러짐\",\"혈관성 치매 – 베타 아밀로이드 축적이 주된 원인\",\"원발진행실어증 – 뇌혈관 질환에 의한 급성 발병\",\"파킨슨병 치매 – 발병 초기부터 심한 실어증이 나타남\",\"전두측두엽 치매 – 초기부터 성격·행동 변화가 두드러짐\"],\"answer\":5,\"explain\":\"전두측두엽 치매는 초기부터 성격·행동 변화 또는 언어 변화가 두드러진다. 알츠하이머는 초기 기억·이름대기 저하(발화는 유창), 베타 아밀로이드는 알츠하이머, PPA는 서서히 진행되는 퇴행성 언어장애이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사자: \\\"방금 불러드린 숫자 5-2-8-1을 거꾸로 말해 보세요.\\\"\\n환자: 수행에 어려움을 보임\",\"q\":\"이 과제가 주로 평가하는 기억 유형은?\",\"choices\":[\"절차기억\",\"암묵기억\",\"작업기억\",\"서술적 장기기억\",\"점화\"],\"answer\":3,\"explain\":\"정보를 잠시 유지하면서 조작(역순 말하기)하는 능력은 작업기억이다. 절차·암묵기억은 기술·습관에 관한 비서술 기억이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"기억 유형에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"절차기억은 사건·사실에 대한 의식적 기억이다\",\"서술기억은 자전거 타기 같은 기술에 대한 기억이다\",\"의미기억은 개인적 사건의 시공간 정보를 포함한다\",\"절차기억은 기술·습관에 대한 비서술 기억이다\",\"일화기억은 일반적인 사실과 지식에 대한 기억이다\"],\"answer\":4,\"explain\":\"절차기억은 반복 학습된 운동·기술 습관에 대한 비서술(암묵) 기억이다. 서술기억은 의미기억(일반 지식)과 일화기억(개인적 사건)으로 나뉜다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"우반구 손상 환자의 의사소통 특징이다.\",\"q\":\"가장 적절한 설명은?\",\"choices\":[\"문법형태소를 생략한 전보식 발화가 핵심이다\",\"따라말하기만 선택적으로 심하게 손상된다\",\"심한 청각적 이해 손상과 착어가 핵심이다\",\"은유 이해 어려움, 단조로운 운율, 좌측 무시\",\"비단어 읽기만 선택적으로 심하게 손상된다\"],\"answer\":4,\"explain\":\"우반구 손상은 화용·비유·함축 이해의 어려움, 운율(감정 억양) 저하, 좌측 무시가 특징이다. 나머지는 좌반구 실어증 유형의 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌 영상 기법에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"CT는 방사선을 쓰지 않아 반복 촬영이 안전하다\",\"fMRI는 과제 수행 시 혈류 변화로 뇌 활성을 반영한다\",\"fMRI는 뇌의 구조만 보여주고 기능은 반영하지 못한다\",\"구조적 MRI는 실시간 신경 활동의 전기 신호를 측정한다\",\"EEG는 뇌의 포도당 대사 소비량을 측정한다\"],\"answer\":2,\"explain\":\"fMRI는 과제 중 혈중 산소 수준(BOLD) 변화를 통해 뇌 기능 활성을 간접 측정한다. 구조적 MRI·CT는 구조 영상, EEG는 전기활동, PET는 대사를 측정한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌자기공명영상(B-MRI)에서 양측 선조체에 저음영을 보이는 환자의 말 특성\\n검사자: \\\"몇 시에 약을 드세요?\\\"\\n환자: \\\"나는 약을 12시에, 12시에 먹어야, 12시에 먹어야, 먹어야 해\\\"\",\"q\":\"이 환자가 보이는 증상은?\",\"choices\":[\"반향어증\",\"동어반복증\",\"실구어증\",\"감금증후군\",\"발성실행증\"],\"answer\":2,\"explain\":\"자신의 낱말·구를 반복하는 것은 동어반복증(palilalia)으로, 기저핵(선조체) 병변과 관련될 수 있다. 반향어는 상대의 말을 따라 반복하는 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"실어증 평가의 하위 영역에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"유창성은 청각적 이해 점수로만 판단한다\",\"이름대기 손상은 대부분의 실어증에서 관찰된다\",\"따라말하기 손상 정도는 모든 유형에서 동일하다\",\"알아듣기 검사는 발화의 문법성만 평가한다\",\"스스로 말하기는 읽기 능력으로 대체 평가한다\"],\"answer\":2,\"explain\":\"이름대기 손상은 유형과 무관하게 대부분의 실어증에서 흔히 관찰된다. 따라말하기 손상 여부는 유형 감별의 핵심 지표로 유형마다 다르다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"외상성 뇌손상(TBI) 환자의 인지-의사소통 특징이다.\",\"q\":\"가장 적절한 설명은?\",\"choices\":[\"주의·기억·집행기능 저하와 화용 문제가 두드러진다\",\"언어의 음운·문법 손상이 핵심이며 인지는 보존된다\",\"심한 청각적 이해 손상이 가장 핵심적인 특징이다\",\"편측 무시가 주된 의사소통 특징으로 나타난다\",\"전형적으로 비유창 실어증의 형태로 나타난다\"],\"answer\":1,\"explain\":\"TBI는 주의·기억·집행기능 등 인지 저하와 함께 화용(주제 유지, 장황함, 상황 파악)의 어려움이 두드러지는 인지-의사소통장애 양상을 보인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"낱말 읽기\\n• 실제 낱말('학교','사람') 읽기는 양호함\\n• 비단어('두랍','무핀') 읽기가 선택적으로 손상됨\",\"q\":\"이 실독증 유형과 손상된 경로는?\",\"choices\":[\"표층실독증 – 전체 단어 어휘 경로\",\"심층실독증 – 의미 처리 경로\",\"순수실독증 – 시각 단어형태 입력 경로\",\"음운실독증 – 자소-음소 변환 경로\",\"무시실독증 – 공간 주의 경로\"],\"answer\":4,\"explain\":\"실제 낱말은 잘 읽으나 비단어 읽기가 선택적으로 손상되면 자소-음소 변환(음운 경로) 손상인 음운실독증이다. 표층은 불규칙어 규칙화 오류가 핵심이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"대뇌 반구의 기능 편재화에 대한 설명이다.\",\"q\":\"일반적인 오른손잡이 성인에서 옳은 것은?\",\"choices\":[\"정서적 운율과 화용은 주로 우반구가 관여한다\",\"언어의 음운·통사 처리는 주로 우반구가 담당한다\",\"좌측 무시는 좌반구 손상에서 더 흔하다\",\"좌반구는 얼굴 정서 인식만을 전담한다\",\"우반구 손상은 전형적인 실문법증을 유발한다\"],\"answer\":1,\"explain\":\"대부분의 오른손잡이에서 언어의 음운·통사는 좌반구가 우세하고, 정서적 운율·화용·시공간 주의는 우반구가 관여한다. 좌측 무시는 우반구 손상에서 흔하다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"초기 알츠하이머병 환자의 이름대기 저하를 다루는 치료 원리이다.\",\"q\":\"가장 적절한 것은?\",\"choices\":[\"무오류 학습과 간격 회상을 활용한다\",\"오류를 경험하게 하여 스스로 교정하게 한다\",\"복잡한 통사 이해 과제를 우선 훈련한다\",\"구강 근력 강화 훈련을 우선한다\",\"제약유발 언어치료로 구어를 강제한다\"],\"answer\":1,\"explain\":\"치매에서는 무오류 학습과 간격 회상, 환경 단서 등 보존된 절차·점화 기억을 활용하는 것이 효과적이며, 오류 경험을 최소화하는 것이 원칙이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 발화·청각적 이해·따라말하기·이름대기가 모두 심하게 손상됨\\n• 몇몇 자동구어(인사말 등)와 상황에 맞는 표정·제스처만 남아 있음\",\"q\":\"이 환자의 실어증 유형은?\",\"choices\":[\"브로카실어증\",\"베르니케실어증\",\"전도실어증\",\"명칭실어증\",\"전반실어증\"],\"answer\":5,\"explain\":\"네 가지 언어 영역이 모두 심하게 손상되고 자동구어·비언어 수단만 남으면 전반실어증이다. 광범위한 좌반구(중대뇌동맥 영역) 손상과 관련된다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 2개월 남아, 기질적 결함 없음. 낱말검사·자발화 분석 결과\\n• /ㄱ, ㅋ/ → [ㄷ, ㅌ]: 모든 낱말 위치에서 대치, 자극반응도 있음\\n• 어두 /ㅅ/ → [ㄷ]: 자극반응도 없음\\n• 어중 /ㄹ/ 생략: 자극반응도 있음\\n• 부모 보고: 또래·교사가 말을 잘 알아듣지 못해 아동이 위축됨\",\"q\":\"발달 기준·오류 빈도·자극반응도를 고려하여 말명료도 향상을 최우선 목표로 할 때, 첫 목표음과 그 근거로 가장 적절한 것은?\",\"choices\":[\"/ㅅ/ – 가장 늦게 발달하는 음소라 먼저 훈련하면 다른 음소로 일반화된다\",\"/ㄹ/ – 생략 오류는 대치 오류보다 말명료도를 더 크게 떨어뜨린다\",\"/ㄱ/ – 연령상 습득되었어야 할 고빈도 음소이며 자극반응도가 있다\",\"세 음소를 같은 비중으로 동시에 훈련하여 전체 치료 기간을 단축한다\",\"비구어 구강운동 훈련으로 혀의 힘을 먼저 기른 뒤 목표음을 정한다\"],\"answer\":3,\"explain\":\"발달적(전통적) 목표 선정 원칙에서는 ①해당 연령에 이미 습득되어야 할 이른 발달음 ②사용 빈도가 높아 명료도에 영향이 큰 음 ③자극반응도가 있어 빠른 성공이 기대되는 음을 우선한다. /ㄱ/은 세 조건을 모두 충족한다. ①은 복잡성 접근의 논리이나 이 사례처럼 명료도 향상과 빠른 성공을 최우선할 때는 자극반응도가 없는 늦은 발달음을 첫 목표로 삼지 않는다. ②는 어중 /ㄹ/ 생략이 연구개음 전반의 대치보다 명료도 저하가 크다고 볼 근거가 없다. ⑤ 비구어 구강운동 훈련은 말소리 산출 개선의 근거가 부족하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 남아, 자음정확도 42%, 말명료도 매우 낮음. 음운변동 출현율\\n• 마찰음의 파열음화 90%\\n• 종성생략 78%\\n• 연구개음 전방화 65%\\n• 유음의 활음화 40%\\n• 어중초성 생략 15%\",\"q\":\"이 아동에게 주기법(cycles approach)을 적용할 때 목표 선정과 진행 원칙으로 옳은 것은?\",\"choices\":[\"최소대립쌍의 청각 변별만 반복 실시하고 산출 연습은 주기 후반으로 미룬다\",\"출현율이 가장 높은 파열음화를 90% 정확도에 도달할 때까지 훈련한 뒤 넘어간다\",\"어중초성 생략을 포함한 다섯 패턴 모두를 한 주기 안에 같은 시간으로 배분한다\",\"출현율 40% 이상인 패턴을 순환하되, 각 패턴은 숙달이 아닌 출현을 목표로 한다\",\"출현율이 가장 낮은 어중초성 생략부터 시작하여 점차 높은 패턴으로 이동한다\"],\"answer\":4,\"explain\":\"주기법은 명료도가 매우 낮은 아동을 대상으로 출현율 40% 이상의 음운패턴을 목표로 하며, 음절구조(종성)·초기 자음·연구개음·유음 등의 우선순위에 따라 패턴을 순환(cycle)한다. 정상 음운습득이 점진적으로 이루어지듯 각 패턴은 숙달이 아니라 출현을 목표로 하고, 다음 주기에서 다시 다룬다. ②는 숙달 기준 접근으로 주기법의 원리와 반대이며, ③ 15%인 어중초성 생략은 목표 기준 미달, ⑤는 우선순위와 반대이다. 주기법의 회기는 청각 자극(auditory bombardment)과 산출 연습을 모두 포함한다. ※출현율 절단 기준(40%)은 교재에 따라 표기가 다를 수 있음.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아의 자발화 표본에서 목표 자음 100개를 분석한 결과\\n• 정확 산출: 58개\\n• 대치: 24개\\n• 생략: 15개\\n• 왜곡: 3개\",\"q\":\"Shriberg와 Kwiatkowski의 원래 산출식에 따른 자음정확도(PCC)와 그에 따른 중증도로 옳은 것은?\",\"choices\":[\"58%, 경도-중등도\",\"58%, 경도\",\"58%, 중등도-심도\",\"42%, 심도\",\"61%, 중등도-심도\"],\"answer\":3,\"explain\":\"원래의 PCC는 대치·생략·왜곡을 모두 오류로 계산하므로 58/100 = 58%이다. Shriberg와 Kwiatkowski의 중증도 기준(85% 초과 경도, 65~85% 경도-중등도, 50~65% 중등도-심도, 50% 미만 심도)에 따르면 58%는 중등도-심도에 해당한다. ⑤ 61%는 왜곡을 정확으로 간주하는 수정 자음정확도(PCC-R)의 값이고, ④ 42%는 오류율이다. ※중증도 절단점은 교재별 표기가 다를 수 있어 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 8개월 남아\\n• 25개 낱말을 3회 반복 산출하는 비일관성 검사에서 15개 낱말(60%)이 매번 다른 형태로 산출됨\\n• 모색행동, 운율 이상, 모음 오류는 관찰되지 않음\\n• 구강 구조·기능 정상, 청력 정상\\n• 자극반응도 검사에서 대부분의 음소를 모방 산출할 수 있음\",\"q\":\"이 아동에게 가장 적절한 중재 접근은?\",\"choices\":[\"최소대립쌍 치료 – 음소 대조를 인식하도록 의미가 다른 낱말 쌍으로 훈련한다\",\"전통적 조음치료 – 음소별로 조음 위치를 지시하고 음절부터 반복 연습한다\",\"주기법 – 출현율이 높은 음운패턴을 순환하며 청각 자극과 산출을 훈련한다\",\"핵심어휘 접근 – 기능적 낱말을 최선 산출 형태로 일관되게 산출하도록 훈련한다\",\"DTTC(동적 시간·촉각 단서법) – 말운동 계획을 위해 집중 반복 연습을 한다\"],\"answer\":4,\"explain\":\"Dodd의 비일관성 검사에서 40% 이상의 낱말이 비일관적으로 산출되면 비일관적 음운장애로 분류되며, 이는 음운 계획(phonological planning)의 결함으로 본다. 여기에는 아동이 자주 쓰는 기능적 핵심어휘를 선정해 매 낱말의 최선 산출 형태를 일관되게 산출하도록 하는 핵심어휘 접근이 적합하다. 최소대립쌍·주기법은 일관된 오류패턴을 보이는 일관적 음운장애·음운지연에 적합하고, DTTC는 모색행동·운율 이상·모음 오류가 특징인 아동기 말실행증의 접근인데 이 아동은 해당 징후가 없고 자극반응도도 높다. ※비일관성 절단 기준(40%)은 교재 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 4개월 남아\\n• 같은 낱말의 자음·모음 오류가 매번 달라짐, 모음 왜곡이 두드러짐\\n• 낱말·구가 길어질수록 오류가 급격히 증가함\\n• 산출 전 입술·혀를 움직이며 조음 위치를 더듬는 모색행동 관찰\\n• 음절 강세가 균등하여 단조롭고 운율이 부적절함\\n• 근력 저하·반사 이상 없음, 구강 구조 정상\\n• 자극반응도 낮고 모방 시에도 오류가 지속됨\",\"q\":\"이 아동의 진단과 그에 따른 중재 원리로 가장 적절한 조합은?\",\"choices\":[\"음운지연 – 주기법으로 발달적 음운패턴을 순환하며 훈련\",\"아동기 말실행증 – 운동학습 원리 기반 DTTC 등 말운동 접근\",\"마비말장애 – 구강 근력 강화 훈련을 우선하고 이후 조음 훈련\",\"조음장애 – 조음점 지시법으로 오류 음소를 하나씩 확립\",\"비일관적 음운장애 – 핵심어휘 접근으로 일관된 산출 유도\"],\"answer\":2,\"explain\":\"비일관적 오류, 모음 오류, 발화 길이에 따른 오류 증가, 모색행동, 부적절한 운율은 아동기 말실행증(CAS)의 핵심 징후이며 근력 이상이 없어 마비말장애와 구별된다. CAS는 말운동 계획·프로그래밍의 결함이므로 운동학습 원리를 적용한 DTTC(동적 시간·촉각 단서법) 등 집중적 산출 연습이 적합하다. 비일관적 음운장애도 비일관적이지만 모색행동·운율 이상·모음 오류가 없고 모방 시 산출이 가능하다는 점에서 구별된다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 6개월 여아, 인지·언어 정상. 오류음소와 자극반응도\\n• /ㅅ, ㅆ/ → [ㄷ, ㄸ] (자극반응도 없음)\\n• /ㄹ/ → 생략 또는 [ㅇ] (자극반응도 없음)\\n• /ㅈ, ㅊ/ → [ㄷ, ㅌ] (자극반응도 있음)\\n• /ㄱ/ → [ㄷ] (어두에서만, 자극반응도 있음)\",\"q\":\"복잡성 접근(complexity approach)의 원리에 따라 목표음을 선정할 때 가장 적절한 것은?\",\"choices\":[\"자극반응도가 있는 /ㄱ/부터 훈련하여 빠른 성공 경험을 제공한다\",\"가장 이른 시기에 발달하는 음소부터 먼저 훈련하여 성공 경험을 쌓는다\",\"모음 체계를 먼저 안정시키고 자음 목표는 그 이후에 다룬다\",\"오류 빈도가 가장 낮은 음소부터 훈련하여 오류 목록을 줄여 나간다\",\"늦게 발달하고 자극반응도가 없는 /ㅅ/ 또는 /ㄹ/을 먼저 훈련한다\"],\"answer\":5,\"explain\":\"Gierut 등의 복잡성 접근은 늦게 발달하고, 자극반응도가 없으며, 음운적으로 더 복잡한(유표적인) 음소를 먼저 목표로 하면 더 단순한 음소로 일반화가 일어나 체계 전반의 변화가 크다고 본다. 따라서 이 접근에서는 /ㅅ/, /ㄹ/이 우선 목표가 된다. ①②는 발달적(전통적) 목표 선정 원리로 복잡성 접근과 반대이며, ③④는 어느 접근에서도 근거가 없다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아의 어두 초성 오류\\n• /ㅅ/, /ㅆ/, /ㅈ/, /ㅊ/, /ㄱ/, /ㅋ/ → 모두 [ㄷ]로 대치\\n• 예: 살→[달], 잘→[달], 찰→[달], 갈→[달]\\n• 음소 대치로 인해 낱말 간 의미 구별이 되지 않아 동음이의 형태가 다수 발생\",\"q\":\"이 아동에게 가장 적절한 치료 접근과 자극 세트는?\",\"choices\":[\"다중대립 접근 – 대치음 [ㄷ]과 여러 목표음을 한 세트로 대조\",\"최소대립쌍 접근 – 한 번에 한 쌍(달-살)만 대조하여 순차적으로 훈련\",\"짝자극 기법 – 핵심낱말 '달'과 훈련낱말을 번갈아 짝지어 산출\",\"전통적 조음치료 – /ㅅ/의 조음점을 지시하여 무의미음절부터 확립\",\"상위음운 접근 – 소리의 길고 짧음 개념만 반복하여 가르친다\"],\"answer\":1,\"explain\":\"여러 목표 음소가 하나의 음소로 붕괴(phoneme collapse)되어 동음이의어가 다수 발생한 경우, 대치음과 붕괴된 여러 목표음을 한 세트로 대조하는 다중대립(multiple oppositions) 접근이 음운체계의 재구조화에 효율적이다. 최소대립쌍은 한 번에 한 대조만 다루므로 광범위한 붕괴에는 비효율적이며, 짝자극·전통적 접근은 개별 음소의 운동 확립에 초점을 두어 음운체계 문제를 직접 다루지 못한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아, 구개열로 1세에 구개성형술을 받음\\n• 최근 비인두내시경: 구개인두 폐쇄 양호\\n• 나조미터 구강문장 비음치 정상 범위\\n• 그러나 /ㅂ, ㄷ, ㄱ, ㅍ, ㅌ, ㅋ/를 성문파열음 [ʔ]으로 대치하는 오류가 일관되게 지속됨\\n• 마찰음은 인두마찰음으로 산출\",\"q\":\"이 아동의 오류 성격과 가장 적절한 중재는?\",\"choices\":[\"학습된 보상조음으로 보고 속삭임·/h/ 단서로 조음치료한다\",\"빨기·불기 등 비구어 구강운동으로 구강 내 압력을 높인다\",\"발달적 음운변동이므로 자연 소실을 기다리며 6개월 경과를 본다\",\"구개인두폐쇄부전이 남아 있으므로 재수술을 먼저 의뢰한다\",\"과비성 감소를 위해 청각 피드백으로 비음치를 낮추는 훈련을 한다\"],\"answer\":1,\"explain\":\"폐쇄 기능이 정상인데도 성문파열음·인두마찰음이 지속되는 것은 폐쇄부전 시기에 학습된 보상조음이 습관화된 것이므로 조음치료로 교정한다. 성문 폐쇄를 배제하기 위해 속삭임이나 /h/를 앞에 붙여 성문을 열어 둔 채 구강 조음점에서 산출을 유도하는 것이 핵심이다. 구개인두 기능이 정상이므로 재수술이나 과비성 훈련은 근거가 없고, 비구어 구강운동은 보상조음 교정에 효과가 없다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 남아, 2세에 구개성형술을 받음\\n• 대화 전반에 걸쳐 일관된 과다비성과 압력자음에서의 비강누출\\n• 나조미터: 구강문장 비음치 38%(정상 기준 약 15% 이하), 비음문장 62%\\n• 보상조음은 관찰되지 않고 조음 위치는 정확함\\n• 자극반응도 검사에서 단서를 주어도 과다비성이 감소하지 않음\",\"q\":\"이 아동에 대한 가장 적절한 판단과 조치는?\",\"choices\":[\"불기·빨기 훈련으로 구개인두 폐쇄 근력을 먼저 강화한 뒤 재평가한다\",\"청각 피드백을 통한 비음치 낮추기 훈련을 6개월간 집중 실시한 뒤 재평가한다\",\"조음 위치가 정확하므로 조음치료로 과다비성을 직접 교정한다\",\"기구 평가로 구개인두폐쇄부전을 확인하고 수술적·보철적 관리를 의뢰한다\",\"구강문장 비음치가 정상 범위에 있으므로 6개월 경과를 관찰한다\"],\"answer\":4,\"explain\":\"구강문장 비음치가 정상 기준을 크게 초과하고 비강누출이 일관되며 단서에도 변화가 없는 것은 구조적 구개인두폐쇄부전(VPI)의 소견이다. 이 경우 기구적 평가(비인두내시경·비디오투시)로 폐쇄 양상을 확인한 뒤 인두피판술·보철(구개거상장치 등) 등 물리적 관리를 우선 의뢰해야 하며, 말치료는 구조 교정 후 잔존 오류를 다룬다. 불기·빨기는 구개인두 폐쇄 향상에 근거가 없고, 조음 위치가 정확한 아동에게 조음치료로 과다비성을 교정할 수는 없다. ※나조미터 정상 기준치는 검사 문장·교재별로 다를 수 있음.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"8세 경직형 뇌성마비 남아\\n• 호흡 지지가 약해 한 번의 호흡으로 2~3음절만 산출, 강도가 작음\\n• 자음이 전반적으로 약하고 부정확(왜곡)하며 경도의 과비성\\n• 말속도가 느리고 낱말 명료도 50%\\n• 오류가 특정 음소에 국한되지 않고 모든 음소에 걸쳐 나타남\",\"q\":\"이 아동의 말명료도 향상을 위한 중재로 가장 적절한 것은?\",\"choices\":[\"오류 음소를 하나씩 선정하여 전통적 조음치료로 정확도를 높인다\",\"최소대립쌍 치료로 음운 대조를 확립하여 명료도를 높인다\",\"호흡 지지, 구 단위 끊어 말하기, 말속도 조절 등 보상 전략을 쓴다\",\"주기법으로 여러 음운패턴을 순환하며 출현을 목표로 훈련한다\",\"혀·입술의 비구어 근력강화 운동만 매 회기 집중적으로 반복 실시한다\"],\"answer\":3,\"explain\":\"뇌성마비의 마비말장애는 호흡·발성·공명·조음 하위체계의 신경운동 결함이 전반적으로 나타나므로, 특정 음소의 조음 정확도보다 호흡 지지, 구 단위 끊어 말하기, 과잉조음, 말속도 조절 등 명료도 중심의 보상 전략이 우선되고 필요 시 AAC를 병행한다. 음소별 전통적 접근·최소대립쌍·주기법은 기능적 조음음운장애에 적합하며, 비구어 근력강화만으로는 말명료도 개선 근거가 부족하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 남아, 양측 고도 감각신경성 난청, 3세에 인공와우 이식(보청 상태 역치 30 dB HL)\\n• /ㅅ, ㅆ, ㅈ, ㅊ/ 생략·왜곡, 종성 생략\\n• 모음 길이 연장과 중성화, 단조로운 억양\\n• 파열음·비음은 비교적 정확\",\"q\":\"이 아동의 조음 특성과 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"구어 산출은 어려우므로 수어 중심 의사소통으로 전면 전환한다\",\"청각 단서는 배제하고 거울·촉각 등 시각·촉각 단서로 조음점을 지시한다\",\"비구어 구강운동으로 혀의 민첩성을 높인 뒤 말소리를 훈련한다\",\"마찰음은 정상 발달에서도 늦게 습득되므로 7세 이후로 목표를 보류한다\",\"보청 상태에서 청각 단서를 우선하고 시각·촉각 단서는 보조로 활용한다\"],\"answer\":5,\"explain\":\"청각장애 아동은 고주파수 에너지를 가진 마찰·파찰음, 청각적으로 약한 종성, 모음 연장·중성화, 억양 단조로움 등의 특성을 보인다. 인공와우로 보청된 상태에서는 청각 경로를 최대한 활용하는 것이 원칙이며, 시각·촉각 단서는 보조로 사용하고 청능훈련·초분절 요소 훈련을 통합한다. 청각 단서를 배제하거나 목표를 보류하는 것은 보청 효과를 활용하지 못하는 부적절한 계획이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"7세 여아\\n• 혀를 내밀면 혀끝이 하트 모양으로 패이고 치조에 닿지 않음\\n• /ㄹ/(탄설음)·/ㄷ, ㄴ/ 왜곡이 모든 문맥에서 일관됨, 자극반응도 없음\\n• 그 외 음소는 정상이고 음운변동은 관찰되지 않음\\n• 언어·청력·인지 정상\",\"q\":\"이 아동에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"음운체계의 문제이므로 최소대립쌍으로 음소 대조를 확립한다\",\"설소대 단축에 따른 조음 오류로, 평가 의뢰와 조음 훈련을 병행한다\",\"비일관적 음운장애로 보고 핵심어휘 접근을 우선 적용한다\",\"발달 과정에서 자연히 개선되므로 1년 후 재평가를 권고한다\",\"비구어 혀 스트레칭 운동만으로 설소대를 늘린 뒤 재평가한다\"],\"answer\":2,\"explain\":\"혀끝의 하트 모양 함몰과 치조 접촉 불가는 설소대 단축증의 소견이며, 혀끝 접촉이 필요한 /ㄹ, ㄷ, ㄴ/에 국한된 일관된 왜곡은 구조적 원인의 음성적(조음) 오류이다. 음운변동이 없으므로 음운적 접근은 부적절하고, 의학적 평가 의뢰와 함께 현재 구조에서 가능한 보상 조음 위치를 확립하는 조음치료를 계획한다. 7세에 이미 습득되어야 할 음소이므로 자연 개선을 기다리는 것도 부적절하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 6개월 여아\\n• 연구개음 전방화(ㄱ→ㄷ)와 마찰음의 파열음화(ㅅ→ㄷ)가 일관되게 나타남\\n• 최소대립쌍 낱말('공-동')을 들려주면 그림 변별은 가능하나 자신의 산출이 다르다는 것을 인식하지 못함\\n• 소리의 속성(앞소리·뒷소리, 긴 소리·짧은 소리)을 이야기하는 활동에 흥미를 보임\",\"q\":\"이 아동에게 상위음운 접근(Metaphon)을 적용할 때의 절차로 옳은 것은?\",\"choices\":[\"1단계에서 목표음의 조음 위치를 설압자로 직접 지시하고 2단계에서 문장으로 확장한다\",\"1단계부터 최소대립쌍 낱말의 산출을 90% 정확도에 이를 때까지 반복 훈련한다\",\"1단계에서 소리 속성 개념을 익히고, 2단계에서 최소대립쌍을 의사소통에 쓴다\",\"1단계에서 핵심낱말과 훈련낱말을 번갈아 산출하며 자질 개념을 학습한다\",\"1단계에서 구강운동으로 혀 뒤쪽 근력을 기르고 2단계에서 연구개음을 확립한다\"],\"answer\":3,\"explain\":\"상위음운 접근은 음운장애 아동이 소리의 대조 속성을 인식하지 못한다는 전제에서 1단계(개념 수준→소리 수준→음소 수준→낱말 수준)에서 '앞소리/뒷소리', '긴 소리/짧은 소리' 등의 활동으로 상위음운 인식을 기르고, 2단계에서 최소대립쌍을 실제 의사소통 상황에서 사용하며 청자의 피드백으로 메시지 수정을 유도한다. 조음점 직접 지시(①)와 핵심낱말-훈련낱말(④, 짝자극)은 운동 중심 접근이며, ②는 1단계의 목적과 맞지 않고, ⑤ 구강운동 훈련은 상위음운 접근의 절차가 아니다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 남아, 어두·어중 /ㅅ/를 목표로 8개월간 치료 중\\n• 낱말 수준 정확도 92%, 구조화된 문장 수준 85%\\n• 그러나 놀이 상황의 자발적 대화에서는 정확도 40%\\n• 가정에서도 대화 중 오류가 대부분이라는 부모 보고\\n• 아동은 자신의 오류를 스스로 알아채지 못함\",\"q\":\"이 단계에서 가장 적절한 중재 방향은?\",\"choices\":[\"무의미음절 수준으로 돌아가 /ㅅ/의 조음 운동을 다시 확립한다\",\"구강운동 훈련을 추가하여 혀끝의 안정성과 근력을 높인다\",\"낱말 수준에서 목표 정확도에 도달했으므로 치료를 종결한다\",\"/ㅅ/는 보류하고 발달상 더 이른 새 음소로 목표를 변경한다\",\"자기 모니터링 훈련과 함께 훈련 장면을 가정·학교로 확대한다\"],\"answer\":5,\"explain\":\"구조화된 상황에서는 정확하나 자발적 대화·가정으로 전이되지 않은 것은 상황·문맥 일반화(전이) 단계의 문제이다. 이 단계의 핵심은 자기 모니터링 능력을 길러 오류를 스스로 탐지·수정하게 하고, 훈련 장면을 다양한 상대·장소·활동으로 확대하며 부모·교사를 통해 일상에서 단서·강화를 제공하는 것이다. 이미 확립된 운동을 다시 훈련하거나 종결·목표 변경을 하는 것은 부적절하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아, 연구개음 전방화(ㄱ→ㄷ). 문맥검사 결과\\n• '구', '고' 문맥에서 간헐적으로 정조음\\n• '기', '게' 문맥에서는 항상 [ㄷ]로 대치\\n• 어두보다 모음 사이(어중) 위치에서 정조음 비율이 높음\",\"q\":\"확립 단계의 시작 문맥과 그 근거로 가장 적절한 것은?\",\"choices\":[\"오류가 가장 심한 '기' 문맥부터 시작하여 어려운 것을 먼저 극복한다\",\"'아구', '오고'처럼 후설모음이 결합된 어중 문맥에서 시작한다\",\"문맥 구분 없이 모든 모음 문맥을 무작위로 제시하여 일반화를 유도한다\",\"무의미음절 단계 없이 문장 수준에서 바로 시작하여 전이를 앞당긴다\",\"어두 '가'부터 시작한다 – 첫소리가 지각적으로 가장 두드러지기 때문이다\"],\"answer\":2,\"explain\":\"문맥검사의 목적은 촉진 문맥을 찾아 치료의 출발점으로 삼는 것이다. 후설모음 /ㅜ, ㅗ/는 혀 뒤쪽이 연구개 방향으로 올라가 있어 동시조음(coarticulation)에 의해 연구개 파열음 산출이 촉진되고, 전설모음 /ㅣ, ㅔ/는 혀가 앞으로 이동해 전방화를 오히려 유도한다. 또한 이 아동은 어중 위치에서 성공률이 높으므로 '아구, 오고'와 같은 후설모음·어중 문맥에서 시작해 점차 전설모음·어두 위치로 확장한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아, 어두 /ㅈ/→[ㄷ] 대치. 낱말 조사 결과 '자'가 포함된 '모자'는 10회 중 10회 정조음하지만 '자동차', '잠', '주스' 등 대부분의 낱말에서는 오조음한다.\",\"q\":\"이 아동에게 짝자극 기법을 적용할 때 낱말 선정 기준과 절차로 옳은 것은?\",\"choices\":[\"핵심낱말 '모자'와 오조음하는 훈련낱말 10개를 번갈아 짝지어 산출한다\",\"핵심낱말은 아동이 가장 자주 오조음하는 낱말로 선정하여 집중 훈련한다\",\"훈련낱말은 10회 중 9회 이상 정조음하는 낱말로 선정해야 한다\",\"핵심낱말과 훈련낱말은 한 음소 차이로 의미가 달라지는 최소대립쌍이어야 한다\",\"핵심낱말과 훈련낱말은 서로 다른 목표음을 포함해야 일반화가 촉진된다\"],\"answer\":1,\"explain\":\"짝자극 기법은 아동이 이미 정조음하는 핵심낱말(목표음 10회 중 9회 이상 정확)을 이용하여, 같은 위치에 목표음이 있으나 오조음하는 훈련낱말(3회 중 2회 이상 오류)로 정확한 산출을 전이시키는 방법이다. 핵심낱말 하나에 훈련낱말 10개를 짝지어 번갈아 산출하고, 낱말→문장→대화로 확장한다. 핵심낱말과 훈련낱말은 같은 목표음을 같은 위치에 가져야 하며, 최소대립쌍과 같은 의미 대조는 요구되지 않는다. ※핵심낱말·훈련낱말 선정 기준 수치는 교재 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아, /ㅅ/→[ㄷ], /ㅆ/→[ㄸ]의 파열음화가 일관됨. 조음 위치(치경)와 발성유형(평음·경음)은 정확하게 유지됨. 변별자질 접근으로 치료하려 한다.\",\"q\":\"이 아동이 확립하지 못한 자질만을 대조하는 최소대립쌍으로 가장 적절한 것은?\",\"choices\":[\"달 – 갈\",\"달 – 탈\",\"달 – 날\",\"달 – 살\",\"달 – 딸\"],\"answer\":4,\"explain\":\"파열음화는 [+지속성]인 마찰음이 [−지속성]인 파열음으로 대치되는 것으로, 결함 자질은 지속성이다. '달-살'은 /ㄷ/와 /ㅅ/가 조음 위치(치경)·발성유형(평음)이 같고 지속성만 다른 쌍이므로 목표 자질을 정확히 대조한다. '달-갈'은 조음 위치, '달-탈'은 기식성, '달-날'은 비음성, '달-딸'은 긴장성 대조로 이 아동이 이미 확립한 자질이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"10세 남아\\n• /ㅅ, ㅆ, ㅈ, ㅊ/ 산출 시 혀 옆으로 공기가 새는 측음화 왜곡이 모든 문맥·과제에서 일관됨\\n• 다른 음소는 정상, 음운변동 없음, 음운인식·읽기 정상\\n• 청각 변별 과제에서 정조음과 왜곡음을 잘 구별함\\n• 구강 구조 정상, 자극반응도 낮음\",\"q\":\"이 아동에게 가장 적절한 접근과 절차는?\",\"choices\":[\"전통적 조음치료 – 촉각 단서로 조음 운동을 확립한 뒤 전이한다\",\"주기법 – 마찰음·파찰음 패턴을 다른 음운패턴과 순환하며 훈련한다\",\"핵심어휘 접근 – 기능적 낱말에서 최선 형태의 일관된 산출을 유도한다\",\"최소대립쌍 치료 – 의미 대조를 통해 음운체계를 재구조화한다\",\"상위음운 접근 – 소리 속성 개념을 먼저 가르쳐 음소 대조를 인식시킨다\"],\"answer\":1,\"explain\":\"음운변동이 없고 하나의 소리군에서 일관된 왜곡만 보이며 청각 변별은 정상인 경우 음운적 문제가 아니라 운동적(음성적) 조음장애이다. 왜곡은 음소 대조 자체는 유지되므로 최소대립쌍·상위음운·주기법 등 음운적 접근의 대상이 아니며, 조음점 지시와 촉각 단서로 올바른 조음 운동을 확립하고 위계적으로 안정·전이·유지 단계를 밟는 전통적 접근이 적합하다. 핵심어휘는 비일관적 산출에 적용된다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 여아, 어머니가 베트남어 화자이고 가정에서 두 언어를 사용함. 한국어 조음 평가 결과\\n• 경음 /ㄲ, ㄸ, ㅃ/ → 평음으로 대치, /ㅡ/ → [ㅜ]로 대치\\n• 종성 /ㄹ/ → [ㄴ]\\n• 베트남어 화자인 어머니와 통역사의 평가: 베트남어 말소리 산출은 또래 수준으로 정확\\n• 오류가 나타나는 소리는 모두 베트남어 음운체계에 없거나 다르게 실현되는 소리임\",\"q\":\"이 결과에 대한 가장 적절한 판단은?\",\"choices\":[\"두 언어 모두에서 치료가 필요한 조음음운장애로 판단한다\",\"모국어 음운체계의 영향으로 나타난 언어 차이로 판단한다\",\"비일관적 음운장애이므로 한국어 핵심어휘 접근을 적용한다\",\"한국어 조음 오류가 있으므로 베트남어 사용을 중단시켜야 한다\",\"아동기 말실행증이 의심되므로 말운동 평가를 추가 실시한다\"],\"answer\":2,\"explain\":\"이중언어 아동에서 장애(disorder)는 두 언어 모두에서 오류가 나타나고 모국어 음운체계로 설명되지 않는 경우에 판단한다. 이 아동은 모국어 산출이 정상이고 오류가 모두 모국어에 없는 소리(경음·/ㅡ/·종성 /ㄹ/)에 국한되므로 언어 차이로 보는 것이 타당하다. 차이를 장애로 진단하는 것은 과잉 진단이며, 모국어 사용 중단 권고는 근거가 없고 언어 발달에도 해롭다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아의 말명료도 평가\\n• 어머니의 5점 척도 평정: 4점(대부분 알아들을 수 있음)\\n• 아동을 처음 본 청자 3명이 녹음된 낱말 50개를 받아쓴 낱말확인 과제: 평균 55% 정확\\n• 문장 수준에서 낯선 청자의 이해율은 낱말보다 다소 높음\",\"q\":\"이 결과의 해석과 임상적 활용으로 가장 적절한 것은?\",\"choices\":[\"명료도는 자음정확도와 동일하므로 별도로 측정할 필요가 없다\",\"어머니의 평정이 가장 신뢰할 만하므로 명료도는 양호하다고 결론짓는다\",\"두 결과를 평균한 약 70%를 아동의 대표 명료도 수치로 보고한다\",\"낱말확인 과제는 문맥이 없어 타당하지 않으므로 척도 평정만 사용한다\",\"낯선 청자의 낱말확인 결과를 명료도 기준 지표로 삼아 활용한다\"],\"answer\":5,\"explain\":\"말명료도는 청자 요인(친숙도), 자료 요인(낱말·문장, 문맥 유무), 측정 방법(척도 평정·낱말확인)에 따라 달라진다. 익숙한 청자와 척도 평정은 명료도를 과대평가하는 경향이 있어, 낯선 청자가 실제로 무엇을 알아들었는지를 객관적으로 보여 주는 낱말확인 과제가 기준 지표로 적합하다. 두 값을 평균하는 것은 방법이 다른 결과를 혼합하는 오류이며, 명료도는 자음정확도와 관련은 있으나 동일한 지표가 아니다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 3개월 남아, /ㄱ/ 전방화와 /ㅅ/ 파열음화를 보여 /ㄱ/을 목표로 12주 치료함. 치료 후 /ㄱ/ 정확도가 20%→85%로 향상되었고, 훈련하지 않은 /ㅅ/도 10%→30%로 향상되었다. 부모는 '아이가 크면서 저절로 좋아진 것 아니냐'고 묻는다.\",\"q\":\"치료 효과를 성숙 효과와 구분하여 입증하기 위한 자료 수집 방법으로 가장 적절한 것은?\",\"choices\":[\"치료 회기 내 목표음 /ㄱ/ 정확도만 매 회기 기록하여 비교한다\",\"안정된 기초선과 함께 훈련·통제 음소를 탐침으로 반복 측정한다\",\"치료 종료 후 표준화 조음검사만 한 번 실시하여 규준과 비교한다\",\"치료 전 기초선을 1회만 측정하고 사후 정확도와 비교한다\",\"부모의 만족도 설문과 가정 내 관찰 보고로 효과를 판단한다\"],\"answer\":2,\"explain\":\"단일대상 연구의 논리에 따라 안정된 다중 기초선과 훈련하지 않은 통제 행동(음소)의 탐침 자료를 병행 측정하면, 훈련 음소의 급격한 향상과 통제 음소의 완만한 변화를 비교해 성숙·자연 회복과 치료 효과를 구분할 수 있다. 회기 내 자료나 사후 검사 1회, 부모 설문만으로는 인과를 추정할 수 없다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 9개월 남아\\n• 초성은 대부분 정확하나 모든 종성을 일관되게 생략함(곰→[고], 손→[소], 발→[바])\\n• 종성이 생략되어 '손'과 '소', '곰'과 '고'가 동음이의어로 산출됨\\n• 종성을 모방하라고 하면 종성 자리에서 입을 벌린 채 소리를 끝냄\",\"q\":\"이 아동에게 가장 적절한 중재 계획은?\",\"choices\":[\"어두 초성 대조쌍(공-동)으로 조음 위치 대조를 먼저 훈련한다\",\"종성은 늦게 발달하므로 5세 이후로 종성 목표를 보류한다\",\"비구어 구강운동으로 턱 닫기 근력을 먼저 강화한 뒤 종성을 훈련한다\",\"종성 유무 최소대립쌍과 '곰이' 같은 재음절화 문맥을 활용한다\",\"종성 없는 낱말만 사용하여 초성 정확도를 먼저 더 높여 간다\"],\"answer\":4,\"explain\":\"종성생략은 음절구조 변동으로 낱말 형태 자체를 바꾸어 명료도에 큰 영향을 주므로 우선 목표가 된다. 종성 유무 최소대립쌍은 종성이 의미를 구별한다는 것을 인식시키며, 한국어 종성은 불파음으로 청각적으로 두드러지지 않으므로 시각·촉각 단서를 보강하고 '곰이'처럼 다음 음절 초성으로 연음되어 파열이 드러나는 문맥에서 시작해 어말 위치로 확장한다. 4세 9개월에 종성 전면 생략은 발달적으로 지연된 것이므로 보류는 부적절하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 3개월 여아\\n• 낱말 수준 표준화 조음음운검사: 자음정확도 88%, 백분위 20(정상 범위)\\n• 부모·교사 보고: 대화에서 알아듣기 어려운 경우가 많음\\n• 대화 자발화 분석: 자음정확도 64%, 종성생략·어중초성 생략이 다수, 말속도 빠르고 발화 길이가 길어질수록 오류 증가\",\"q\":\"이 결과에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"표준화 검사가 정상 범위이므로 치료 대상이 아니라고 판정하고 종결한다\",\"부모·교사의 보고는 주관적이므로 판정 근거에서 제외한다\",\"자발화·명료도 자료로 치료 대상으로 판정하고 연결발화 목표를 세운다\",\"낱말 검사를 다른 표준화 도구로 다시 실시하여 정상 범위 여부를 재확인한다\",\"오류가 발화 길이에 따라 늘므로 음운인식 결함으로 보고 읽기 중재를 한다\"],\"answer\":3,\"explain\":\"표준화 낱말 검사는 단일 낱말의 정확도를 측정하므로 연결발화에서 나타나는 오류(동시조음, 빠른 속도, 발화 길이에 따른 붕괴)를 놓칠 수 있다. 임상 결정은 표준화 점수 하나가 아니라 자발화 분석, 명료도, 보호자·교사 보고 등 다각적 자료를 통합하여 내려야 하며, 이 아동은 연결발화 수준의 중재가 필요하다. 발화 길이에 따른 오류 증가는 음운인식이 아니라 말 산출 부담과 관련된다. ※정상 범위 절단점(백분위·표준편차 기준)은 검사 도구·교재별 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 낱말 '사탕' /s a tʰ a ŋ/ 을 아동이 [타당]으로 산출하였다.\\n• PMLU 산출: 목표·아동 산출의 각 분절음(자음·모음)마다 1점, 정확히 산출한 자음마다 1점 추가\\n• PWP(단어단위근접률) = 아동 산출 PMLU ÷ 목표 PMLU\",\"q\":\"이 낱말에 대한 아동의 단어단위근접률(PWP)은?\",\"choices\":[\"0.75\",\"0.625\",\"0.80\",\"0.875\",\"1.0\"],\"answer\":1,\"explain\":\"목표 '사탕'의 PMLU = 분절음 5개(ㅅ, ㅏ, ㅌ, ㅏ, ㅇ) 5점 + 자음 3개 정확 3점 = 8. 아동의 [타당]은 분절음 5개로 5점이며, 자음 중 /ㅅ/→[ㅌ], /ㅌ/→[ㄷ]은 오류이고 종성 /ㅇ/만 정확하므로 1점을 더해 PMLU = 6. 따라서 PWP = 6 ÷ 8 = 0.75이다. ※PMLU 채점 규칙(모음 오류 처리 등)은 교재별 차이가 있어 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"파라다이스-유창성검사-II(P-FA-II) '말하기그림' 과제 분석\\n• 총 발화 음절 수: 300음절\\n• 정상적 비유창성(ND): 9회\\n• 비정상적 비유창성(AD): 12회\\n(ND 점수 = ND 횟수 ÷ 음절 수 × 100, AD 점수 = AD 횟수 ÷ 음절 수 × 100 × 1.5)\",\"q\":\"이 과제의 비유창성 총점(ND 점수 + AD 점수)은?\",\"choices\":[\"7\",\"10.5\",\"9\",\"12\",\"15\"],\"answer\":3,\"explain\":\"ND 점수 = 9 ÷ 300 × 100 = 3, AD 점수 = 12 ÷ 300 × 100 × 1.5 = 4 × 1.5 = 6이므로 총점은 3 + 6 = 9이다. 10.5는 ND에도 1.5 가중치를 잘못 적용한 값, 7은 AD에 가중치를 적용하지 않은 값이다. ※P-FA-II 점수 산출식·가중치는 검사 요강 기준으로 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 3세 6개월 남아, 어머니가 '말이 자꾸 걸린다'며 의뢰\\n• 놀이 상황 대화 표본(400음절) 분석\\n  - 100음절당 진성 비유창성(SLD): 5.2회\\n  - 전체 비유창성 중 SLD 비율: 72%\\n  - 반복 시 반복 단위 수 평균 2.3회\\n  - 음절 반복 시 긴장과 눈 감기 동반\",\"q\":\"위 결과의 해석과 그에 따른 임상적 결정으로 가장 적절한 것은?\",\"choices\":[\"말더듬으로 판정하고, 지속 위험요인을 평가해 치료 착수 여부를 결정한다\",\"SLD 5.2회는 학령전기 정상 범위이므로 6개월 후 재평가만 권고한다\",\"간투사와 구 반복이 적으므로 정상적 비유창성으로 보고 상담 후 종결한다\",\"반복 단위 수 평균이 3회 미만이므로 말더듬으로 볼 수 없어 관찰만 한다\",\"성인 %SS 기준 3%를 넘으므로 즉시 연장된 말 훈련을 시작한다\"],\"answer\":1,\"explain\":\"학령전기 말더듬 판별에서는 100음절당 SLD 3회 이상, 전체 비유창성 중 SLD 비율이 높음(약 2/3 이상), 반복 단위 수 증가, 긴장·부수행동 동반이 말더듬을 시사한다. 이 아동은 모든 지표가 기준을 넘으므로 말더듬으로 판정하되, 발병 경과·가족력·SLD 추이 등 지속 위험요인을 평가해 직접 치료 여부를 결정한다. 정상 범위(②), 반복 단위 3회 미만이면 정상(④)이라는 해석은 틀렸고, 연장된 말 훈련(⑤)은 3세 아동의 1차 선택이 아니다. ※SLD 절단점·비율 기준은 교재(Yairi & Ambrose 등)별로 차이 가능.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 2세 11개월 여아, 말더듬 시작 4개월 경과\\n• 외삼촌이 어린 시절 말을 더듬었으나 자연회복됨\\n• 3개월 간 SLD가 100음절당 8회 → 4회로 감소 추세\\n• 음운·언어발달 정상, 아동은 자신의 말을 의식하지 않음\\n• 부모는 아이가 더듬을 때 불안해하며 \\\"천천히\\\"라고 자주 지시함\",\"q\":\"이 아동에게 현재 가장 적절한 임상적 결정은?\",\"choices\":[\"리드콤 프로그램을 즉시 시작해 부모 수반자극을 훈련한다\",\"말더듬수정법으로 말더듬 순간 확인 훈련을 시작한다\",\"부모 상담과 간접 중재를 시행하며 정기적으로 재평가한다\",\"자연회복 가능성이 높으므로 추후 관리 없이 종결한다\",\"성인용 유창성완성 프로그램을 축약해 아동에게 적용한다\"],\"answer\":3,\"explain\":\"여아, 발병 후 12개월 미만, 자연회복 가족력, SLD 감소 추세, 언어발달 정상, 인식 없음은 모두 자연회복을 예측하는 요인이다. 따라서 직접 치료보다 부모의 부정적 반응(지시·불안)을 줄이는 상담과 간접 중재(상호작용·말속도 조정)를 제공하며 정기 재평가로 추이를 모니터링하는 것이 적절하다. 다만 추후 관리 없이 종결(④)하면 지속 여부를 확인할 수 없어 부적절하고, 리드콤(①)은 위험요인이 뚜렷하거나 관찰 후 호전이 없을 때 고려한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 9세 남아, 5세경 말더듬 시작\\n• 긴장된 막힘과 연장, 막힘 중 발 구르기\\n• 발표·전화 상황을 피하고 어려운 낱말을 다른 낱말로 바꿈\\n• \\\"애들이 놀릴까 봐 말 안 해요\\\"라고 보고함\\n• 의사소통태도 검사에서 부정적 태도 뚜렷\",\"q\":\"이 아동의 말더듬 발달 수준과 그에 맞는 중재 접근으로 가장 적절한 것은?\",\"choices\":[\"경계선 말더듬 – 부모 상호작용 조정 중심의 간접 중재\",\"초기 말더듬 – 부모의 언어적 수반자극 중심 리드콤 프로그램\",\"진전된 말더듬 – 지연청각피드백 기기를 단독으로 사용하는 중재\",\"중간 말더듬 – 유창성 촉진과 말더듬 수정의 통합적 접근\",\"정상적 비유창성 – 추가 중재 없이 부모 교육 후 관찰\"],\"answer\":4,\"explain\":\"학령기에 긴장된 막힘, 탈출행동, 낱말·상황 회피, 두려움과 부정적 태도가 나타나는 것은 Guitar의 발달 수준 중 '중간 말더듬'에 해당한다. 이 단계에서는 유창한 말을 만드는 기법(느린 말·부드러운 시작)과 말더듬 순간을 편하게 수정하는 기법에 회피와 부정적 감정·태도를 줄이는 요소를 결합한 통합적 접근이 권장된다. 리드콤(②)은 학령전기가 주 대상이며, 기기 단독(③)으로는 회피·태도를 다룰 수 없다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 5세 남아, 리드콤 프로그램 1단계 진행 중\\n• 최근 3주 연속 클리닉 내 %SS 0.6, 0.4, 0.5\\n• 부모의 일일 말더듬 심한 정도(SR) 평정: 매일 1~2점 유지\",\"q\":\"이 시점에서 치료사가 취할 조치로 가장 적절한 것은?\",\"choices\":[\"1단계를 6개월 더 유지하며 수반자극 빈도를 늘린다\",\"말더듬수정법으로 전환하여 취소 기법을 지도한다\",\"치료를 즉시 종결하고 추후 방문을 모두 없앤다\",\"언어적 수반자극과 부모 SR 기록을 모두 중단한다\",\"2단계(유지)로 진입하여 방문 간격을 점차 늘린다\"],\"answer\":5,\"explain\":\"리드콤 프로그램에서 3주 연속 클리닉 %SS 1.0 미만과 부모 SR 1~2 유지는 1단계 목표 달성 기준으로, 이때 2단계(유지 단계)로 진입해 방문 간격을 점차 늘리고(예: 2주→4주→8주…) 부모의 언어적 수반자극을 단계적으로 줄이며 재발 여부를 감시한다. 즉시 종결(③)이나 수반자극·기록의 일괄 중단(④)은 재발 감시 원리에 어긋난다. ※2단계 진입 기준 수치(%SS·SR 척도 범위)는 프로그램 지침 판본에 따라 차이 가능.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"리드콤 프로그램 3주차 가정 실습 관찰\\n• 어머니가 아동이 더듬을 때마다 빠짐없이 \\\"울퉁불퉁했어, 다시\\\"라고 요구함\\n• 유창한 발화에 대한 칭찬은 거의 없음\\n• 아동이 말하기를 꺼리고 짜증을 내기 시작함\",\"q\":\"치료사가 어머니에게 제공할 지도로 가장 적절한 것은?\",\"choices\":[\"유창한 발화에 대한 칭찬의 비율을 수정 요구보다 훨씬 높게 한다\",\"말더듬에 대한 수정 요구를 더 강하게 하여 빠르게 효과를 얻도록 한다\",\"수반자극을 모두 중단하고 부모 말속도만 늦추게 한다\",\"아동이 짜증을 낼 때는 타임아웃을 적용해 지도한다\",\"수정 요구 대신 아동에게 말더듬 순간을 스스로 분석하게 한다\"],\"answer\":1,\"explain\":\"리드콤 프로그램의 언어적 수반자극은 유창한 발화에 대한 긍정적 반응이 중심이며, 말더듬에 대한 수정 요구는 간헐적으로만 제공하고 아동이 불편해하면 즉시 줄이거나 중단해야 한다(일반적으로 칭찬 대 수정요구 비율을 5:1 이상으로 권장). 수정 요구가 과도하면 아동이 말하기를 회피하는 부작용이 생긴다. 수반자극 전면 중단(③)은 프로그램 원리를 버리는 것이고, 자기분석(⑤)은 학령전기 아동에게 부적합하다. ※권장 비율 수치는 지침별 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 3세 9개월 여아, 말더듬 시작 8개월\\n• 가정 놀이 영상: 부모의 말속도가 매우 빠르고 질문이 연이어 이어지며, 아동이 말을 마치기 전에 부모가 끼어듦\\n• 부모 모두 아동의 말더듬에 대해 높은 불안과 죄책감을 보고함\\n• 치료사는 페일린 부모-아동 상호작용치료(Palin PCI)를 계획함\",\"q\":\"이 프로그램의 핵심 절차로 옳은 것은?\",\"choices\":[\"부모의 개입을 배제하고 치료사가 단독으로 아동을 주 2회 직접 치료한다\",\"부모가 유창한 발화마다 칭찬하고 말더듬에 수정을 요구하며 SR을 기록한다\",\"아동에게 연장된 말을 시범 보여 클리닉에서 유창한 말 패턴을 확립한다\",\"아동이 자신의 말더듬 순간을 확인하고 취소 기법으로 수정하게 한다\",\"부모가 놀이 영상을 보며 상호작용 전략을 스스로 찾아 특별시간에 실천한다\"],\"answer\":5,\"explain\":\"Palin PCI는 부모-아동 상호작용 영상 피드백을 통해 부모가 아동의 유창성에 도움이 되는 상호작용 전략(속도 늦추기·기다리기·질문 줄이기 등)을 스스로 발견·선택하게 하고, 매주 정해진 '특별시간'(짧은 놀이 시간)에 이를 적용하게 하며, 부모의 불안·죄책감 등을 다루는 가족 전략을 병행하는 간접 중재이다. ②는 리드콤 프로그램, ③은 유창성완성법, ④는 말더듬수정법의 절차이며, ①은 부모 참여를 핵심으로 하는 PCI와 정반대이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 2개월 남아, 최근 이사와 동생 출생 이후 말더듬이 급격히 증가\\n• 어휘·구문은 또래보다 앞서 있으나 말운동 협응(조음 정확도·교대운동)은 다소 느림\\n• 부모는 아동에게 빠른 말로 많은 질문을 하고 즉각적인 대답을 요구함\",\"q\":\"요구-용량 모델(Demands and Capacities Model)에 근거한 중재 방향으로 가장 적절한 것은?\",\"choices\":[\"언어 용량을 키우기 위해 복잡한 문장 산출을 요구하는 언어치료를 강화한다\",\"아동에게 취소·빠져나오기 기법을 직접 가르쳐 용량을 높인다\",\"부모 말속도와 질문·시간 압박을 줄여 요구를 낮춘다\",\"말운동 용량이 회복될 때까지 아동의 발화 기회를 제한한다\",\"동생과의 상호작용을 당분간 차단하여 정서적 요구를 제거한다\"],\"answer\":3,\"explain\":\"요구-용량 모델은 아동의 말운동·언어·정서·인지 용량을 환경적·내적 요구가 초과할 때 비유창성이 나타난다고 본다. 이 아동은 언어 요구(앞선 언어, 빠른 질문)와 정서 요구(이사·동생)가 말운동 용량을 넘어선 상황이므로, 부모 말속도 늦추기·질문과 시간 압박 줄이기·예측 가능한 일과 만들기 등으로 요구를 낮추면서 아동의 말운동·정서 용량을 지지하는 것이 중재 방향이다. 언어 요구를 더 높이는 것(①)은 모델과 정반대이고, 발화 제한(④)이나 상호작용 차단(⑤)은 비현실적이며 해롭다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인이 Van Riper 말더듬수정법의 '확인(identification)' 단계를 마쳤다. 대상자는 자신의 핵심행동·부수행동·회피 패턴을 정확히 기술할 수 있으나, 여전히 말더듬 순간에 강한 공포를 느끼고 청자의 시선을 피한다.\",\"q\":\"다음으로 진행할 단계와 그 활동으로 옳은 것은?\",\"choices\":[\"변형(variation) – 말더듬 순간 직후 취소 기법 적용\",\"접근(approximation) – 빠져나오기와 예비책 훈련\",\"둔감화(desensitization) – 의도적 말더듬과 얼어붙기\",\"안정화(stabilization) – 자기치료 계획 수립과 재발 대비\",\"동기(motivation) – 치료 필요성 인식과 구체적 목표 설정\"],\"answer\":3,\"explain\":\"MIDVAS 순서(동기→확인→둔감화→변형→접근→안정화)에서 확인 단계 다음은 둔감화이다. 둔감화에서는 의도적(가짜) 말더듬, 말더듬 순간 얼어붙기·유지하기, 청자 반응 직면 등을 통해 공포와 긴장을 줄여야 이후 변형·접근 단계의 수정 기법을 배울 수 있다. 취소·빠져나오기·예비책(①②)은 접근 단계의 기법이며, 안정화(④)는 마지막 단계이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 25세 남성, 대화 표본 %SS 1.2로 겉으로는 거의 유창해 보임\\n• 어려운 낱말을 예측하면 항상 다른 낱말로 바꾸고, 전화·주문·자기소개를 철저히 피함\\n• 취업 면접에서 이름을 말하지 못한 경험 후 의뢰됨\\n• OASES 총 영향 점수 '심함', 말더듬 사실을 주변에 숨겨 옴\",\"q\":\"이 대상자의 우선 중재 목표와 기법으로 가장 적절한 것은?\",\"choices\":[\"%SS를 0에 가깝게 낮추기 위한 연장된 말 집중 훈련\",\"회피 감소 – 위계적 노출과 의도적 말더듬, 자기공개\",\"부모가 참여하는 언어적 수반자극 프로그램 적용\",\"취소 기법 반복 연습으로 핵심행동 지속시간 단축\",\"지연청각피드백 기기 착용으로 전체 말속도 저하\"],\"answer\":2,\"explain\":\"겉으로는 유창하나 낱말 대치·상황 회피로 말더듬을 숨기는 내재화(covert) 말더듬은 핵심행동 빈도보다 회피와 두려움이 핵심 문제이다. 따라서 회피하던 낱말·상황의 위계에 따른 점진적 노출, 의도적 말더듬, 말더듬 자기공개(advertising) 등으로 회피를 줄이고 둔감화하는 것이 우선 목표다. 이미 낮은 %SS를 더 낮추는 훈련(①④)이나 기기(⑤)는 문제의 본질(회피·태도)을 다루지 못하고 오히려 '더듬으면 안 된다'는 신념을 강화할 수 있다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"성인 말더듬 대상자의 읽기 표본\\n• 읽기 소요 시간: 2분 30초\\n• 산출한 총 음절 수(비유창 음절 포함): 375음절\\n• 말더듬이 나타난 음절 수: 15음절\",\"q\":\"이 표본의 전체 말속도(분당 음절 수, SPM)와 말더듬 음절 백분율(%SS)로 옳은 것은?\",\"choices\":[\"125 SPM, 4%\",\"150 SPM, 2.5%\",\"187.5 SPM, 4%\",\"150 SPM, 4%\",\"150 SPM, 6%\"],\"answer\":4,\"explain\":\"전체 말속도 = 375음절 ÷ 2.5분 = 150 SPM, %SS = 15 ÷ 375 × 100 = 4%이다. 125 SPM은 3분으로 나눈 오류, 187.5 SPM은 2분으로 나눈 오류이며, 2.5%와 6%는 %SS 산출 오류이다. ※전체 말속도(쉼·비유창 포함)와 조음속도(유창 구간만 측정)의 정의는 교재별로 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 31세 여성 말더듬 성인\\n• 모음으로 시작하는 낱말('아버지', '오늘')에서 성대를 강하게 부딪히는 긴장된 막힘이 빈번함\\n• /ㅂ, ㄷ, ㄱ/ 초성에서 입술·혀를 세게 붙인 채 압력이 쌓여 막힘\\n• 유창성완성법 접근을 선택함\",\"q\":\"이 대상자의 말더듬 양상에 가장 직접적으로 대응하는 기법 조합은?\",\"choices\":[\"취소 + 빠져나오기 + 예비책\",\"부드러운 시작 + 가벼운 조음 접촉\",\"차폐 소음 + 메트로놈 리듬 말하기\",\"의도적 말더듬 + 말더듬 자기공개\",\"호흡 근력 강화 + 큰 소리로 말하기\"],\"answer\":2,\"explain\":\"모음 초성에서의 강한 성대 접촉에는 발성을 기류와 함께 부드럽게 시작하는 부드러운 시작(easy onset)이, 파열음에서 조음기관을 세게 붙여 생기는 막힘에는 조음 접촉을 가볍게 하는 가벼운 조음 접촉(light articulatory contact)이 직접 대응한다. 취소·빠져나오기·예비책(①)과 의도적 말더듬·자기공개(④)는 말더듬수정법의 기법이며, 차폐·리듬(③)은 일시적 유창성 유도 조건이지 이 양상을 겨냥한 기법이 아니다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 22세 남성 말더듬 성인\\n• 치료사가 연장된 말(prolonged speech) 시범 영상을 보여주고 대상자가 이를 모방하도록 함\\n• 대상자는 매 발화 후 말더듬 정도와 말의 자연스러움을 스스로 척도로 평정함\\n• 정해진 말속도 단계나 프로그램된 위계 없이 문제해결식으로 진행\",\"q\":\"이 프로그램에 해당하는 것은?\",\"choices\":[\"캠퍼다운 프로그램\",\"리드콤 프로그램\",\"GILCU 프로그램\",\"페일린 PCI 프로그램\",\"스토커 프로브 테크닉\"],\"answer\":1,\"explain\":\"캠퍼다운 프로그램(Camperdown Program)은 청소년·성인을 대상으로, 프로그램된 단계별 말속도 지시 없이 연장된 말 시범 영상을 모방하여 유창한 말을 배우고, 대상자가 말더듬 정도(SR)와 자연스러움을 스스로 평정하며 문제해결식으로 자연스러운 유창성을 확립·일반화하는 유창성완성 계열 프로그램이다. 리드콤(②)은 학령전기 부모 수반자극 프로그램, GILCU(③, 점진적 발화길이 및 복잡성 증가)는 발화 길이를 단계적으로 늘리는 프로그램된 조작적 접근이다. ※평정 척도 범위 등 세부 절차는 프로그램 판본 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 38세 남성, 유창성완성법 집중치료 종료 시 %SS 0.8, 말의 자연스러움 양호\\n• 치료 종료 6개월 후 %SS 6.2로 상승, 전화를 다시 피하기 시작\\n• \\\"기법을 쓰면 말이 어색해서 점점 안 쓰게 됐다\\\"고 보고\",\"q\":\"이 상황에 대한 판단과 대처로 가장 적절한 것은?\",\"choices\":[\"치료 실패로 판단하고 프로그램을 처음부터 동일하게 반복한다\",\"일시적 변동이므로 별도 조치 없이 1년 뒤 재평가한다\",\"지연청각피드백 기기를 영구적으로 착용하게 한다\",\"말더듬수정법으로 전면 교체하고 유창성 기법 사용을 금지한다\",\"재발로 보고 추후 회기에서 기법을 재확립하며 유지 전략을 보강한다\"],\"answer\":5,\"explain\":\"유창성완성법 이후 재발은 흔하며, 기법 사용 시 어색함·자기관리 부족·회피와 부정적 태도의 잔존이 주요 원인이다. 따라서 추후 회기로 기법을 재확립하되 자연스러움 훈련, 자기 모니터링, 인지-정서적 요소, 자조모임 등 유지·재발방지 전략을 통합해야 한다. 동일 프로그램 반복(①)은 재발 원인을 다루지 못하고, 방치(②)나 전면 교체·금지(④)는 근거가 없다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"아동 A(6세): 긴장된 막힘·연장, 막힘 시 눈 깜빡임, 특정 낱말 회피, \\\"말이 안 나와서 무서워요\\\"라고 보고, 말속도는 정상\\n아동 B(12세): 말속도가 빠르고 불규칙, 음절 축약('선생님'→'샘님')으로 명료도 저하, 이야기 순서가 뒤섞임, 본인은 문제를 잘 인식하지 못하나 집중해서 말하면 뚜렷이 개선됨\",\"q\":\"두 아동의 감별과 각각의 중재 방향으로 옳은 것은?\",\"choices\":[\"A 속화 – 말속도 조절 / B 말더듬 – 취소 기법\",\"A 말더듬 – 긴장 감소 / B 속화 – 말속도 조절 훈련\",\"A 말더듬 – DAF 단독 사용 / B 속화 – 둔감화 훈련\",\"A와 B 모두 속화 – 말속도 조절·자기 모니터링\",\"A와 B 모두 말더듬 – 둘 다 리드콤 프로그램\"],\"answer\":2,\"explain\":\"A는 긴장된 핵심행동, 부수행동, 회피, 두려움이 뚜렷한 말더듬으로 긴장 감소와 유창성 촉진, 두려움을 다루는 직접 중재가 필요하다. B는 빠르고 불규칙한 말속도, 음절 축약, 발화 조직화 문제, 낮은 자기 인식, 주의 집중 시 개선이라는 속화의 전형적 특징을 보이므로 말속도 조절·자기 모니터링·발화 조직화 훈련이 적절하다. 12세 속화 아동에게 리드콤(⑤)이나 둔감화(③)는 목표가 어긋난다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 58세 남성, 좌측 기저핵 뇌경색 후 2개월째 비유창성 발생\\n• 조사·어미 등 기능어와 낱말 끝에서도 반복이 나타나며 문장 내 위치와 무관함\\n• 부수행동과 말에 대한 공포는 거의 없음\\n• 반복 읽기에서 적응효과 미미, 경도의 마비말장애 동반\",\"q\":\"이 대상자에게 가장 적절한 중재 계획은?\",\"choices\":[\"의도적 말더듬과 얼어붙기로 둔감화를 집중적으로 시행한다\",\"pacing 등 보상 전략을 마비말장애 중재와 통합한다\",\"부모 수반자극 방식의 조작적 프로그램을 적용한다\",\"심리치료를 우선 의뢰하고 말 치료는 당분간 보류한다\",\"회피 낱말 목록을 작성해 위계적 노출을 실시한다\"],\"answer\":2,\"explain\":\"뇌손상 후 발생하고 기능어·낱말 끝 등 위치와 무관하게 나타나며 적응효과와 공포가 적은 양상은 신경학적 말더듬이다. 심리적 요소가 작으므로 둔감화·회피 노출(①⑤)의 비중은 낮고, 말속도 감소·pacing·DAF 등 보상 전략, 원인 질환과 약물에 대한 의학적 협진, 동반 마비말장애 중재의 통합이 핵심이다. 심리치료 우선(④)은 심인성 말더듬에 해당하는 접근이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 42세 여성, 직장 내 심한 갈등 직후 갑자기 말더듬 시작(2주 전)\\n• 아동기 말더듬 병력·신경학적 이상 없음(신경과 검사 정상)\\n• 모든 낱말 첫 음절을 3~4회 일정하게 반복하는 기이하고 균일한 양상\\n• 노래·제창 등 유창성 유도 조건에서도 변화 없음\\n• 자신의 증상에 대해 무관심한 태도\",\"q\":\"이 대상자에 대한 감별과 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"심인성 말더듬 – 시험적 치료와 전문가 의뢰\",\"신경학적 말더듬 – pacing 보드와 DAF\",\"속화 – 말속도 조절과 자기 모니터링 훈련\",\"발달성 말더듬 – 말더듬수정법 전 단계 적용\",\"위장 말더듬 – 치료 대상이 아니므로 종결\"],\"answer\":1,\"explain\":\"심리적 스트레스 직후 성인기에 갑자기 발생, 신경학적 이상 없음, 기이하고 균일한 반복 양상, 유창성 유도 조건에서의 무반응, 증상에 대한 무관심은 심인성 말더듬을 시사한다. 심인성 말더듬은 짧은 시험적 치료(속도·발성 조절 지시 등)에 빠르게 반응하는 경우가 많아 진단적 가치가 있으며, 정신건강 전문가 의뢰와 상담을 병행한다. 신경학적 이상이 없으므로 ②는 배제되고, 의도적 위장(⑤)으로 단정할 근거가 없다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 5세 남아, 가정에서 한국어와 영어를 함께 사용하는 이중언어 환경\\n• 두 언어 모두에서 말더듬이 관찰되며 영어에서 다소 더 심함\\n• 부모: \\\"말더듬을 없애려면 영어를 완전히 끊고 한국어만 써야 할까요?\\\"\",\"q\":\"부모에게 제공할 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"이중언어 자체가 말더듬의 원인이므로 단일언어 환경으로 바꾼다\",\"말더듬이 더 심한 영어 사용을 가정에서 즉시 중단시킨다\",\"영어를 끊고 한국어 사용도 줄여 발화량 자체를 낮춘다\",\"말더듬이 덜한 한국어로만 치료하고 영어 유창성은 평가하지 않는다\",\"두 언어를 유지하되 각 언어의 요구와 압박을 줄이도록 안내한다\"],\"answer\":5,\"explain\":\"이중언어 노출 자체가 말더듬을 유발하거나, 한 언어를 없애면 말더듬이 개선된다는 근거는 확립되어 있지 않다. 가족의 의사소통 필요를 고려해 두 언어를 유지하면서 두 언어 모두에서 유창성을 평가하고, 급한 언어 전환 강요나 교정 등 언어별 요구·압박을 줄이는 상호작용 조정을 안내하는 것이 적절하다. 언어 제거(①②④)나 발화량 축소(③)는 언어발달과 가족 관계에 해가 될 수 있다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 초등 3학년 여아, 말더듬 치료 중\\n• 담임교사: 소리 내어 읽기 시간에 아동이 심하게 더듬자 미안한 마음에 아동 순서를 건너뛰고 있음\\n• 아동은 \\\"선생님이 나만 빼요\\\"라며 위축됨\",\"q\":\"치료사가 담임교사에게 제안할 교실 전략으로 가장 적절한 것은?\",\"choices\":[\"읽기와 발표 활동에서 계속 제외하여 부담을 없앤다\",\"아동이 더듬을 때 \\\"천천히, 숨 쉬고\\\"라고 즉시 조언한다\",\"아동이 더듬은 문장을 유창해질 때까지 다시 읽게 한다\",\"순서를 미리 알려 주거나 짝과 함께 읽기를 활용해 참여를 유지한다\",\"말더듬을 학급 앞에서 공개적으로 설명하도록 아동에게 요구한다\"],\"answer\":4,\"explain\":\"학령기 아동을 활동에서 제외하면 회피와 위축을 강화하고 '나만 다르다'는 인식을 키운다. 읽기 순서 예고로 예기 불안을 줄이고 짝과 함께 읽기(제창)라는 유창성 유도 조건을 활용해 참여를 유지하며, 끼어들지 않기·끝까지 듣기 규칙을 학급 전체에 동일하게 적용해 아동만 특별 취급하지 않는 것이 권장된다. \\\"천천히\\\" 조언(②)이나 다시 읽기 요구(③)는 유창성을 방해하고, 공개 설명 요구(⑤)는 아동의 준비와 동의 없이 강요할 사항이 아니다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인 대상자가 \\\"노래할 때, 여럿이 함께 읽을 때, 메트로놈에 맞춰 말할 때는 전혀 안 더듬는데 왜 치료에서 이걸 그냥 쓰지 않느냐\\\"고 질문하였다.\",\"q\":\"치료사의 설명으로 가장 적절한 것은?\",\"choices\":[\"이 조건들은 말더듬의 원인을 제거하므로 충분히 오래 사용하면 완치된다\",\"이 조건들은 촉진 도구로 활용하되 점차 제거하며 전이를 계획한다\",\"이 조건들은 효과가 일관되지 않으므로 치료에 사용하지 않는다\",\"이 조건들에서 유창하면 말더듬이 아니므로 치료 대상이 아니다\",\"이 조건들에서 유창한 것은 말더듬이 심인성임을 증명한다\"],\"answer\":2,\"explain\":\"노래·제창·리듬 말하기·DAF 등은 말산출의 타이밍과 청각 피드백을 외부적으로 변화시켜 일시적으로 유창성을 유도하는 '유창성 유도 조건'으로, 대부분의 말더듬 화자에게 공통적으로 나타나므로 심인성의 증거(⑤)나 비말더듬의 증거(④)가 아니다. 임상적으로는 초기 확립 단계의 촉진 도구로 유용하지만 효과가 조건 의존적이고 자연스러움이 떨어지므로 점진적 제거(fading)와 자연스러운 말·실제 상황으로의 전이·유지 계획이 필수이며, 원인 제거·완치(①)는 근거가 없다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 29세 여성 말더듬 성인, 사회불안 동반\\n• \\\"발표 중 한 번이라도 막히면 모두가 나를 무능하다고 생각할 것이다\\\"라는 신념이 강함\\n• 이 때문에 회의 발언을 포기하고, 이후 자책과 회피가 심해지는 악순환\",\"q\":\"이 대상자의 인지-정서적 문제를 다루기 위한 중재로 가장 적절한 것은?\",\"choices\":[\"말더듬 빈도를 0으로 낮추도록 유창성 기법만 집중 훈련한다\",\"발표 상황을 완전히 피하도록 직장에 조치를 요청한다\",\"왜곡된 신념을 재구조화하고 행동 실험을 수행한다\",\"말더듬 순간마다 취소 기법만 반복해서 연습한다\",\"지연청각피드백 기기를 발표 때마다 착용하게 한다\"],\"answer\":3,\"explain\":\"말더듬 성인의 부정적 신념·사회불안에는 인지행동치료 원리에 따른 인지 재구조화(파국화·독심 등 사고 오류 확인과 근거 검토)와, 실제 발언 후 청자 반응을 확인하는 등 신념을 검증하는 행동 실험·점진적 노출을 결합한 접근이 효과적이다. 유창성 기법이나 기기만으로는(①④⑤) 신념이 유지되고, 상황 회피 조치(②)는 회피를 강화하여 악순환을 심화시킨다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 7세 남아에게 프로그램된 조작적 접근을 적용함\\n• 1낱말 읽기 → 2낱말 → 구 → 문장 → 1분·2분·…·5분 독백·대화 순으로 발화 길이와 복잡성을 단계적으로 늘림\\n• 각 단계에서 정해진 준거(연속 시행에서 말더듬 없음)를 충족해야 다음 단계로 진행\\n• 유창한 반응에는 \\\"잘했어\\\"와 토큰, 말더듬 시 \\\"멈추고 부드럽게 다시\\\" 지시\",\"q\":\"이 프로그램의 명칭과 전체 구조로 옳은 것은?\",\"choices\":[\"리드콤 프로그램 – 1단계(감소)와 2단계(유지)\",\"캠퍼다운 프로그램 – 시범·확립·일반화·유지\",\"말더듬수정법 – 동기·확인·둔감화·변형·접근·안정화\",\"GILCU 프로그램 – 확립·전이·유지 3단계\",\"페일린 PCI – 상호작용 전략·가족 전략·아동 전략\"],\"answer\":4,\"explain\":\"발화 길이와 복잡성을 낱말→구→문장→장시간 대화로 단계적으로 늘리고 각 단계 준거를 통과해야 진행하며, 유창한 반응에 강화를 주는 프로그램은 Ryan의 GILCU이며, 확립(establishment)·전이(transfer)·유지(maintenance)의 3단계로 구성된다. 리드콤(①)은 부모의 일상 대화 수반자극이 중심이고, 캠퍼다운(②)은 프로그램된 위계가 없다. ※단계별 준거(연속 시행 수)와 세부 단계 수는 교재별 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 9세 남아, 중등도 지적장애(IQ 52)와 말더듬 동반\\n• 긴장된 음절 반복과 막힘, 자신의 말더듬 인식은 낮음\\n• 추상적 설명의 이해가 어렵고 새 기술의 유지·일반화가 느림\\n• 특수학급 교사와 부모가 협조적임\",\"q\":\"이 아동의 말더듬 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"단순화한 유창성 기법을 시각적 단서로 지도하고 부모·교사가 강화한다\",\"말더듬 순간을 분석하는 확인 단계와 인지 재구조화를 집중 시행한다\",\"지적장애가 있으면 말더듬 치료 효과가 없으므로 언어치료만 진행한다\",\"성인용 캠퍼다운 프로그램을 수정 없이 그대로 적용한다\",\"말더듬을 스스로 인식하지 못하므로 현재는 중재 대상이 아니다\"],\"answer\":1,\"explain\":\"지적장애 아동은 추상적 자기분석과 인지적 접근(②)의 부담이 크므로, 구체적·단순화된 유창성 촉진 기법을 시범과 반복, 시각적 단서로 지도하고 부모·교사가 동일한 단서와 강화를 제공하는 환경 조정으로 일반화를 돕는 것이 적절하다. 지적장애가 있어도 말더듬 중재는 효과가 있으며(③), 인식 부족은 치료 제외 사유가 아니라(⑤) 중재 설계 시 고려할 특성이다. 성인용 프로그램의 그대로 적용(④)은 부적합하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 여아, 클리닉 초기 평가에서 치료사와 그림 설명 시 %SS 1.5로 거의 유창함\\n• 그러나 부모는 \\\"집에서는 훨씬 심하고, 특히 저녁에 형제와 다툴 때 심하다\\\"고 보고\\n• 치료사는 진단을 보류하고 추가 자료를 수집하기로 함\",\"q\":\"이 결정의 근거와 추가로 수집할 자료로 가장 적절한 것은?\",\"choices\":[\"클리닉 표본이 가장 객관적이므로 부모 보고는 배제하고 재측정한다\",\"부모 보고가 더 정확하므로 이를 근거로 즉시 직접 치료를 시작한다\",\"%SS 1.5는 정상 범위이므로 말더듬이 아니라고 보고 종결한다\",\"말더듬은 맥락별 변이가 크므로 가정 녹화와 부모 평정을 추가한다\",\"아동의 표준화 언어검사만 추가하면 말더듬 진단이 가능하다\"],\"answer\":4,\"explain\":\"말더듬은 상황·과제·시간대·상대·정서 상태에 따라 변이가 매우 커서, 낯선 클리닉의 단일 표본은 대표성이 부족할 수 있다(특히 학령전기). 따라서 가정 녹화, 놀이·대화 등 다양한 과제의 표본, 부모의 일일 말더듬 정도(SR) 평정 등을 종합해 대표성 있는 판단을 해야 한다. 클리닉 표본만 신뢰하거나(①) 부모 보고만으로 치료를 시작하는 것(②), 단일 표본으로 종결하는 것(③) 모두 변이성을 고려하지 않은 결정이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 26개월 남아, 청력 정상, 출생·발달력 특이사항 없음\\n• K M-B CDI 표현어휘 30개(10%ile 미만), 낱말 조합 없음\\n• 언어 이해(SELSI 수용언어)는 생활연령 수준\\n• 가리키기·보여주기 등 몸짓 사용과 상징놀이가 연령에 적절\\n• 언어장애 가족력 없음, 부모는 걱정이 커서 '지금 당장 주 3회 치료'를 요청함\",\"q\":\"이 아동에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"표현어휘 지체가 뚜렷하므로 즉시 주 3회 개별 집중치료를 시작한다\",\"저위험 늦게 말하는 아동으로 보고 부모 언어촉진 교육 후 3~6개월 뒤 재평가한다\",\"24개월 이후 낱말 조합이 없으므로 발달성 언어장애(DLD)로 진단을 확정한다\",\"표현어휘 지체는 대부분 자연 회복되므로 아무 조치 없이 만 4세까지 기다린다\",\"낱말 조합이 없는 것은 자폐스펙트럼장애의 핵심 징후이므로 자폐 진단평가를 의뢰한다\"],\"answer\":2,\"explain\":\"이해력, 몸짓(특히 가리키기), 상징놀이가 정상이고 가족력이 없는 표현어휘 지체는 예후가 좋은 저위험 late talker(늦게 말하는 아동) 프로파일이다. 이 경우 부모 매개 언어촉진(반응적 상호작용·집중자극) 교육과 3~6개월 간격의 추적 재평가가 권장된다. ①은 위험도 대비 과잉 개입, ③은 DLD 진단은 보통 만 4세 전후 언어 문제가 지속될 때 내리므로 조기 확정이 부적절, ④는 추적 없이 방치하는 것으로 부적절, ⑤는 몸짓·놀이·상호작용이 양호하여 근거가 없다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 아동의 수용어휘 검사 결과\\n• 원점수: 34\\n• 해당 연령 규준: 평균 46, 표준편차 8\",\"q\":\"이 아동의 z점수와 그에 대한 해석으로 옳은 것은?\",\"choices\":[\"z = -0.75, 백분위 약 23으로 정상 범위이다\",\"z = -2.0, 백분위 약 2로 심한 지체이다\",\"z = -1.5, 백분위 약 16으로 경계선 수준이다\",\"z = -1.5, 백분위 약 7로 유의한 지체이다\",\"z = +1.5, 백분위 약 93으로 우수하다\"],\"answer\":4,\"explain\":\"z = (원점수 − 평균) ÷ 표준편차 = (34 − 46) ÷ 8 = −1.5. 정규분포에서 z = −1.5는 백분위 약 7(6.7)에 해당하며 −1SD(백분위 16) 미만이므로 유의한 어휘 지체로 해석한다. ③은 z와 백분위가 서로 맞지 않고(백분위 16은 z = −1), ①·②·⑤는 계산이 틀렸다. ※ 백분위 환산값과 '유의한 지체' 절단점(−1SD, −1.25SD, −1.5SD 등)은 검사·교재별로 다를 수 있다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"3세 아동의 자발화(4개 발화)\\n① \\\"아빠 신문 읽어\\\"\\n② \\\"나 우유 먹었어\\\"\\n③ \\\"동생이 울어\\\"\\n④ \\\"엄마가 책 찾아\\\"\",\"q\":\"위 발화의 평균형태소길이(MLU-m)는? (조사·어미·선어말어미는 각각 하나의 형태소로 계산)\",\"choices\":[\"4.5\",\"4.0\",\"3.5\",\"5.0\",\"5.5\"],\"answer\":1,\"explain\":\"① 아빠/신문/읽-/-어 = 4, ② 나/우유/먹-/-었-/-어 = 5, ③ 동생/-이/울-/-어 = 4, ④ 엄마/-가/책/찾-/-아 = 5. 총 18개 형태소 ÷ 4발화 = 4.5. 조사(-이, -가)나 선어말어미(-었-)를 빠뜨리면 값이 낮게, 어간을 더 쪼개면 높게 산출된다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 6개월 여아 평가 결과\\n• 청력 정상, K-CTONI-2 비언어성 지능지수 98\\n• PRES 수용언어 발달연령 4;6, 표현언어 발달연령 3;10\\n• REVT 표현어휘 9%ile\\n• 비단어 따라말하기 3음절 이상에서 급격히 저하\\n• 자발화: 주격조사 생략(\\\"토끼 뛰어\\\"), 시제 오류(\\\"어제 유치원 가요\\\"), 연결어미 없이 단문 나열\\n• 눈맞춤·상호작용·상징놀이 양호, 상동행동 없음\",\"q\":\"이 아동의 진단과 우선 중재 목표로 가장 적절한 조합은?\",\"choices\":[\"발달성 언어장애 – 격조사·시제 등 문법형태소 산출\",\"자폐스펙트럼장애 – 공동주의와 상호작용 시작하기\",\"사회적(화용) 의사소통장애 – 대화 차례 주고받기\",\"지적장애 – 기능적 일상 어휘와 생활 기술 습득\",\"말소리장애 – 종성 산출 정확도와 말 명료도 향상\"],\"answer\":1,\"explain\":\"비언어성 지능·청력이 정상이고 사회적 상호작용에 문제가 없는데 언어(특히 표현·문법형태소)만 지체되고 비단어 따라말하기가 저조한 것은 발달성 언어장애(단순언어장애)의 전형적 프로파일이다. 문법형태소 오류가 두드러지므로 자연스러운 놀이 맥락에서 조사·시제를 목표로 한 집중자극·고쳐말하기 중재가 우선된다. 지능 정상이므로 ④, 사회성 양호하므로 ②·③, 조음 문제가 아니므로 ⑤는 부적절하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"6세 남아\\n• K-WPPSI-IV 전체 지능지수 62, 적응행동 점수도 유의하게 낮음\\n• PRES 수용·표현언어 발달연령 모두 약 3;6 수준\\n• 자발화: 2~3어절 단문, 어휘 제한, 요구하기는 주로 손잡아끌기로 함\\n• 배운 낱말을 치료실 밖에서 잘 쓰지 못함\",\"q\":\"이 아동의 중재 방향으로 가장 적절한 것은?\",\"choices\":[\"인지 수준을 먼저 정상 범위로 끌어올린 뒤 언어치료를 시작한다\",\"언어가 인지보다 유의하게 낮으므로 단순언어장애 중재 프로토콜을 적용한다\",\"요구·거부·선택 등 일상 기능과 생활 어휘를 목표로 일과 속 일반화를 강조한다\",\"연령 수준의 복문 산출을 1차 목표로 설정하여 집중 훈련한다\",\"구어 산출이 가능하므로 몸짓·그림 등 비구어 수단은 모두 제한한다\"],\"answer\":3,\"explain\":\"지적장애 아동은 언어가 인지 수준과 대체로 일치하며 학습 속도가 느리고 일반화가 어렵다. 따라서 발달적으로 적절한 기능적 목표(요구·거부·선택하기, 생활 어휘)를 실제 일과에서 반복·분산 연습하고 여러 사람·환경에서 일반화하는 것이 핵심이다. ②는 언어–인지 불일치가 없으므로 틀리고, ①은 언어와 인지는 병행 촉진 대상이며, ④는 발달 수준보다 지나치게 높은 목표, ⑤는 잔존 수단을 제한하는 것으로 총체적 의사소통 원칙에 어긋난다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"놀이 상황에서 아동이 치료사가 들고 있는 블록을 향해 손을 뻗는다. 치료사는 블록을 아동 눈높이에 들고 기대에 찬 표정으로 바라보며 약 5초간 말없이 기다린다. 아동이 \\\"블록\\\"이라고 말하자 즉시 블록을 건네준다.\",\"q\":\"치료사가 사용한 환경중심 언어중재(milieu teaching) 절차는?\",\"choices\":[\"요구-모델(mand-model)\",\"우연교수(incidental teaching)\",\"아동중심 시범(modeling)\",\"환경 조성(arrangement)\",\"시간지연 기법(time delay)\"],\"answer\":5,\"explain\":\"아동이 원하는 것에 관심을 보일 때 즉시 촉진하지 않고 기대하는 표정으로 일정 시간 기다려 자발적 산출을 유도한 뒤 원하는 물건으로 자연적 강화를 주는 것은 시간지연 절차이다. 요구-모델은 치료사가 '뭐 줄까?'처럼 언어적 요구를 먼저 하고, 시범은 목표 발화를 먼저 들려주며, 우연교수는 아동의 요구 시작 후 정교화를 요청하는 절차이다. 환경 조성은 물건을 닿지 않게 두는 등 사전 상황 설정에 해당한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"4세 발달성 언어장애 아동의 목표는 과거시제 '-었-'의 산출이다. 치료사는 소꿉놀이를 하며 \\\"아기가 밥을 다 먹었어\\\", \\\"곰이 잠을 잤어\\\", \\\"컵이 떨어졌어\\\"처럼 목표 형태를 담은 문장을 한 회기에 수십 번 자연스럽게 들려주되, 아동에게 따라 말하거나 산출하도록 요구하지 않는다.\",\"q\":\"위 중재 기법과 그 원리로 옳은 것은?\",\"choices\":[\"확대(extension) – 아동 발화에 새로운 의미 정보를 덧붙여 되돌려 준다\",\"유도모방(elicited imitation) – 모델 직후 아동이 즉시 따라 말하게 한다\",\"비연속 개별시도 교수 – 자극·반응·강화의 시행을 구조화하여 반복한다\",\"집중자극(focused stimulation) – 목표 형태를 고빈도로 입력한다\",\"혼잣말 기법(self-talk) – 치료사가 자신의 행동을 말로 표현한다\"],\"answer\":4,\"explain\":\"특정 목표 형태를 의미 있는 맥락에서 고빈도로 반복 입력하되 산출을 강요하지 않는 것은 집중자극 기법으로, 아동이 고빈도 입력에서 목표 규칙을 스스로 추출하도록 하는 원리이다. 유도모방·개별시도는 산출을 직접 요구하고, 확대는 아동 발화에 대한 반응 기법이며, 혼잣말은 치료사 자신의 행동을 기술하는 기법으로 특정 문법형태소를 목표로 한 고밀도 입력과는 다르다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 아동에게 ㉠ 주격조사 '이/가', ㉡ 연결어미 '-고', ㉢ 대화에서 차례 기다리기의 세 목표를 설정하였다. 치료사는 매 회기마다 세 목표를 모두 다루며, 각 목표에 회기 시간을 나누어 배분한다.\",\"q\":\"이 치료사가 사용한 목표 공략(goal attack) 전략은?\",\"choices\":[\"수평적 전략 – 여러 목표를 같은 회기에서 동시에 다룬다\",\"주기적 전략 – 정해진 기간마다 목표를 교체하며 순환한다\",\"수직적 전략 – 한 목표가 준거에 도달한 뒤 다음 목표로 넘어간다\",\"위계적 전략 – 쉬운 목표부터 어려운 목표로 순서대로 다룬다\",\"절충적 전략 – 치료사가 목표를, 아동이 활동을 선택한다\"],\"answer\":1,\"explain\":\"매 회기 여러 목표를 동시에 다루는 것은 수평적(horizontal) 목표 공략 전략이다. 수직적 전략은 한 목표씩 준거 도달 후 순차적으로, 주기적 전략은 준거 도달과 무관하게 정해진 기간 단위로 목표를 순환한다. ④·⑤는 목표 공략 전략의 공식적 분류가 아니다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 4세 8개월 아동, 가정에서는 중국어, 어린이집(입소 1년)에서는 한국어 사용\\n• 한국어 표준화 어휘검사: 10%ile 미만\\n• 역동적 평가(검사–교수–재검사): 20분의 짧은 어휘 교수 후 재검사에서 새 낱말 대부분을 습득·사용함\\n• 교수 과정에서 검사자의 촉진 필요량(examiner effort)이 적고 반응 수정 능력(modifiability)이 높음\\n• 부모 보고상 중국어 발달은 또래 수준\",\"q\":\"이 결과에 대한 해석과 조치로 가장 적절한 것은?\",\"choices\":[\"표준화 검사 결과가 낮으므로 발달성 언어장애로 진단하고 주 2회 언어치료를 시작한다\",\"두 언어 모두 사용해 혼란이 생겼으므로 가정에서도 한국어만 쓰도록 권고한다\",\"언어 차이로 판단하고 모국어를 유지하며 한국어 입력을 늘리고 추적 관찰한다\",\"역동적 평가 결과는 참고자료일 뿐이므로 한국어 표준화 검사 점수로 진단한다\",\"중국어가 또래 수준이므로 한국어 문제는 무시하고 평가를 종료한다\"],\"answer\":3,\"explain\":\"역동적 평가에서 짧은 교수 후 높은 학습 반응성(높은 수정가능성, 낮은 검사자 노력)을 보이면 학습 잠재력, 즉 언어 학습 능력 자체는 온전한 것으로 보고, 낮은 표준화 점수는 한국어 노출 부족에 의한 '언어 차이'로 해석한다. 모국어 발달이 정상이라는 점도 이를 지지한다. 따라서 모국어 유지와 한국어 노출·풍부한 입력 확대, 추적 관찰이 적절하다. ①·④는 규준이 맞지 않는 표준화 검사로 진단하는 오류이고, ②는 이중언어가 언어장애를 유발한다는 잘못된 전제이며, ⑤는 한국어 지원 필요성을 무시한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 3세 0개월, 양측 중등고도 감각신경성 난청(70dB HL)\\n• 생후 30개월에 진단, 보청기 착용 1개월째(보청 후 어음역 20~30dB HL)\\n• 표현어휘 15개, 대부분 모음 위주 발성\\n• 부모는 구어(듣기·말하기)를 통한 의사소통을 희망함\",\"q\":\"이 아동에게 청각구어법(auditory-verbal approach)을 적용할 때의 원리로 옳은 것은?\",\"choices\":[\"보청기 효과가 제한적이므로 수어를 주 수단으로 먼저 확립한 뒤 구어를 도입한다\",\"구어 습득이 어려우므로 그림 기반 AAC를 주 의사소통 수단으로 설정한다\",\"독순(입모양 읽기) 훈련을 중심으로 시각적 단서를 최대한 제공한다\",\"시각 단서를 최소화하고 청각을 통한 언어 습득과 부모 코칭을 강조한다\",\"치료사 주도의 낱말 따라말하기 훈련을 주 3회 집중 실시하고 부모 참여는 배제한다\"],\"answer\":4,\"explain\":\"청각구어법은 적절한 보청(보청기·인공와우)과 지속적인 보청 상태 점검을 전제로, 청각을 통한 언어 습득을 최우선으로 하고 입모양 등 시각 단서 의존을 줄이며 부모를 일상의 일차적 언어 촉진자로 코칭하는 접근이다. 보청 후 어음역 청력이 확보된 이 아동은 적용 대상이 된다. ①·②·③은 수어·AAC·시각 중심으로 청각구어법의 원리와 반대이며, ⑤는 부모 참여를 배제하여 핵심 원리에 어긋난다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 4세 뇌성마비 아동, 구어 명료도가 매우 낮아 그림상징 의사소통판 사용 중\\n• 현재 판에는 '과자, 물, 자동차, 블록…' 등 명사 20개만 있음\\n• 사용 양상: 원하는 것 요구하기에만 사용, 판을 사용하는 상대는 대부분 어머니\\n• 언어 이해는 연령 수준\",\"q\":\"이 아동의 AAC 중재를 확장하기 위한 계획으로 가장 적절한 것은?\",\"choices\":[\"핵심어휘를 추가해 의사소통 기능을 넓히고 보조 언어 자극으로 모델을 제공한다\",\"구어 명료도 향상을 위해 조음치료를 우선하고 AAC 사용은 잠시 중단한다\",\"판에 있는 낱말을 짚으며 따라 말하게 하는 구어 산출 훈련으로 전환한다\",\"요구하기가 안정되었으므로 판 사용을 어머니와의 상황으로 한정하여 숙달시킨다\",\"명사 상징을 100개로 늘려 요구할 수 있는 어휘량을 충분히 확보한다\"],\"answer\":1,\"explain\":\"AAC 어휘는 '더, 아니야, 싫어, 다했어, 봐'처럼 다양한 상황·기능에 두루 쓰이는 핵심어휘(core vocabulary)를 포함해야 요구하기 이외의 의사소통 기능(거부·언급·질문 등)과 상징 조합으로 확장될 수 있다. 또한 상대가 상징을 짚으며 말하는 보조 언어 자극(aided language stimulation)은 AAC 사용자에게 필수적인 입력 모델이다. ⑤는 부수어휘만 늘려 기능 확장이 안 되고, ②·③은 AAC 사용을 구어 훈련으로 대체하는 잘못된 접근이며, ④는 의사소통 상대·환경을 오히려 제한한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 30개월 남아, 자폐스펙트럼장애 진단\\n• 무발화, 원하는 물건은 성인의 손을 물건 쪽으로 끌어당김\\n• 흥미로운 것을 보고 가리키거나 성인과 사물을 번갈아 보는 행동이 없음\\n• 성인이 가리키는 곳을 따라 보는 반응(공동주의 반응하기)은 간헐적으로 나타남\\n• 장난감을 줄 세우거나 돌리며 놀고 상징놀이는 없음\",\"q\":\"이 아동의 초기 중재 목표와 근거로 가장 적절한 것은?\",\"choices\":[\"공동주의 시작하기와 상징놀이를 목표로 한다 – 이후 언어 발달의 예측 요인이다\",\"낱말 따라말하기를 우선 목표로 한다 – 무발화이므로 구어 산출이 가장 시급하다\",\"장난감 줄 세우기를 즉시 소거한다 – 상동행동이 언어 습득을 방해한다\",\"글자 카드로 문자 읽기를 가르친다 – 자폐 아동은 시각 학습자여서 읽기가 더 빠르다\",\"성인 지시 따르기를 우선 목표로 한다 – 순응이 있어야 언어 학습이 가능하다\"],\"answer\":1,\"explain\":\"자폐스펙트럼장애 영유아에서 공동주의(특히 시작하기, IJA)와 상징(가장)놀이는 이후 언어 습득을 예측하는 핵심 영역으로, JASPER 등 근거 기반 중재의 우선 목표이다. 무발화 아동에게 사회적 기반 없이 따라말하기(②)나 문자(④)를 우선하는 것은 부적절하고, 반복 놀이는 소거 대상이 아니라 확장의 출발점으로 활용하며(③), 순응 훈련(⑤)은 의사소통 발달의 전제가 아니다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 자폐스펙트럼장애 아동\\n• 넘어져 아플 때마다 예전에 엄마가 하던 말을 그대로 \\\"괜찮아, 호 해줄게\\\"라고 말함\\n• 원하는 과자를 보면 광고 문구를 그대로 \\\"바삭바삭 새로 나왔어요\\\"라고 말함\\n• 두 발화 모두 억양·형태가 매번 동일함\",\"q\":\"이 반향어에 대한 해석과 중재로 가장 적절한 것은?\",\"choices\":[\"의미 없는 자기자극 행동이므로 무시하여 점차 소거한다\",\"기능을 지닌 지연 반향어로 보고 짧고 관습적인 발화로 대치해 간다\",\"발화가 있으므로 언어 수준이 적절하다고 보고 화용 중재는 생략한다\",\"즉각 반향어이므로 발화 직후 '조용히'라고 지시하여 억제한다\",\"반향어를 늘리기 위해 광고·대화 문구를 더 많이 암기시킨다\"],\"answer\":2,\"explain\":\"과거에 들은 말을 나중에 그대로 재현하는 것은 지연 반향어이며, 사례처럼 특정 상황에서 일관되게 나타나면 자기위로·요구 등 의사소통 기능을 지닌 것으로 본다. 중재는 기능을 인정하고 그 상황에서 '아파, 호', '과자 주세요'처럼 더 짧고 관습적·생성적인 발화를 모델링하여 점진적으로 대치(형성)하는 것이 원칙이다. ①·④는 기능을 무시한 억제, ③은 반향어를 생성적 언어로 오판한 것, ⑤는 비생성적 발화를 늘리는 잘못된 방향이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 4학년 아동\\n• 낱말 해독·읽기 유창성: 학년 수준\\n• REVT 수용·표현 어휘: 정상 범위\\n• '물의 순환' 단원을 설명하게 하자 \\\"물이… 그리고 비가… 그래서…\\\"처럼 단문을 '그리고'로만 이어 붙이고 원인–결과 관계를 표현하지 못함\\n• 자발화에서 관형절('-는/-ㄴ')과 '-기 때문에', '-면' 등 종속 연결어미 사용이 거의 없음\\n• 사회·과학 교과 서술형 평가 점수가 낮음\",\"q\":\"이 아동에게 가장 적절한 중재는?\",\"choices\":[\"낱말 해독 정확도와 읽기 속도를 높이는 유창성 훈련\",\"교과 내용을 활용한 문장 결합과 설명담화 구조 지도\",\"일상 어휘의 양을 늘리기 위한 어휘 목록 암기 훈련\",\"이야기 문법 요소를 갖춘 허구적 이야기 다시 말하기\",\"음소 분리·합성 등 음운인식 과제 반복 훈련\"],\"answer\":2,\"explain\":\"해독·어휘는 정상이나 복문 구문과 설명담화(expository discourse) 구조화가 취약한 학령기 언어장애 프로파일이다. 학령기 중재는 교과 내용과 연계하여 관형절·종속 연결어미가 포함된 후기 구문을 문장 결합(sentence combining) 기법으로 지도하고, 원인–결과·비교–대조 등 설명담화 구조를 도식 조직자로 시각화하는 것이 적절하다. ①·⑤는 정상인 해독 영역, ③은 정상인 어휘량, ④는 이야기(서사) 담화로 이 아동의 핵심 결함(설명담화·복문)과 맞지 않는다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"6세 아동의 그림책 이야기 다시 말하기\\n\\\"개구리가 있었어요. 아이가 잤어요. 개구리가 나갔어요. 아이가 일어났어요. 아이가 밖에 갔어요. 개구리를 찾았어요.\\\"\\n• 등장인물과 사건은 대체로 순서대로 나열함\\n• 개구리가 사라졌다는 계기사건에 대한 인물의 반응(놀람·걱정), 찾으려는 목표·시도의 이유가 전혀 표현되지 않음\\n• '그래서, 왜냐하면' 등 인과 표지 없음\",\"q\":\"이 아동의 이야기 중재로 가장 적절한 것은?\",\"choices\":[\"이야기 길이를 늘리기 위해 문장 수를 세어 목표 개수를 채우게 한다\",\"어휘다양도를 높이기 위해 새 낱말을 이야기에 넣게 한다\",\"그림 없이 듣기만으로 이야기를 기억해 말하는 청각 기억 훈련을 한다\",\"이야기 문법 요소를 시각 아이콘으로 제시하여 다시 말하기를 지도한다\",\"발화 명료도를 높이기 위해 조음 정확도를 먼저 훈련한다\"],\"answer\":4,\"explain\":\"사건을 나열만 하고 계기사건–내적 반응–시도의 인과적 연결이 빠진 것은 이야기 문법 구조의 결함이다. 이야기 문법 요소(계기사건·내적 반응·시도·결과)를 시각 아이콘으로 외현화하여 다시 말하기를 지도하고, 인물의 감정·의도 어휘와 '그래서·왜냐하면' 같은 인과 결속표지를 함께 목표로 하는 것이 근거 기반 이야기 중재이다. ①·②는 구조가 아닌 양적 지표만 겨냥하고, ③·⑤는 핵심 결함과 무관하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 10개월 아동(초등 입학 예정) 평가\\n• 음절 수 세기, 음절 합성·분리: 90% 이상 정확\\n• 첫소리(초성) 변별·분리('공'의 첫소리?): 20%\\n• 자모 이름: 일부만 알고 소리값은 모름\\n• 낱말 읽기: 자기 이름 등 통문자 몇 개만 읽음\\n• 어휘·구문: 연령 수준\",\"q\":\"이 아동의 읽기 준비 중재로 가장 적절한 것은?\",\"choices\":[\"이미 습득한 음절 수준 인식 과제를 계속 반복하여 자동화한다\",\"통문자 카드로 자주 보는 낱말 100개를 암기시킨다\",\"음소 수준 인식을 글자–소리 대응과 통합하여 지도한다\",\"자모 이름만 완전히 외운 뒤 음소 인식은 초등 입학 후로 미룬다\",\"어휘 확장을 우선하여 읽기 이해의 기초를 다진다\"],\"answer\":3,\"explain\":\"음절 인식은 완성되었으나 음소 인식과 자소–음소 대응 지식이 부족한 상태이므로, 다음 단계인 음소 수준 인식(초성 변별·분리·합성)을 글자–소리(자소–음소) 대응과 통합하여 지도하는 것이 해독 습득에 가장 효과적이다. ①은 이미 숙달된 수준의 반복, ②는 알파벳 원리를 우회하는 방법, ⑤는 정상인 어휘를 목표로 삼음, ④는 음소 인식 지도를 불필요하게 지연시킨다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"표현어휘가 지체된 3세 아동의 어머니에게 그림책 읽기 방법을 교육하였다.\\n• \\\"토끼가 먹는 건 뭐지?\\\"(빈칸 채우기), \\\"아까 토끼가 어디 갔었지?\\\"(회상)\\n• \\\"이 그림에서 무슨 일이 일어나고 있어?\\\"(개방형), \\\"이건 무슨 색이야?\\\"(wh-질문)\\n• \\\"우리 어제 공원에서 본 토끼 기억나?\\\"(경험과 연결)\\n• 아동이 대답하면 칭찬하고 그 말을 문장으로 다시 들려준 뒤 따라 말하게 함\",\"q\":\"이 부모교육에서 지도한 접근과 원리로 옳은 것은?\",\"choices\":[\"공유책읽기에서 어머니가 글을 정확히 끝까지 읽어 주는 것이 핵심이다\",\"반응적 상호작용 – 성인은 질문을 최소화하고 아동의 주도를 따라간다\",\"스크립트 중재 – 익숙한 일상 사건의 순서를 이용해 말하게 한다\",\"대화식 책읽기 – 질문으로 아동이 이야기의 화자가 되게 한다\",\"청각적 집중 자극 – 목표 낱말을 반복해서 들려주기만 한다\"],\"answer\":4,\"explain\":\"빈칸 채우기·회상·개방형·wh-·경험 연결(CROWD) 질문으로 아동을 이야기의 능동적 화자로 만들고, 아동의 반응을 촉진–평가–확장–반복(PEER)하여 어휘·표현을 촉진하는 것은 대화식 책읽기(dialogic reading)이다. ①은 수동적 읽어주기, ③은 사건 스크립트 활용, ②는 질문을 줄이는 접근으로 질문이 핵심인 이 방법과 반대이며, ⑤는 산출 유도 없이 입력만 주는 기법이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"3세 아동이 얼마 전까지 \\\"들어\\\", \\\"지어\\\"로 바르게 말하다가 최근 \\\"듣어요\\\", \\\"짓어요\\\", \\\"굽어요(구워요)\\\"처럼 말하기 시작했다. 부모는 '말이 퇴보한 것 같다'며 걱정한다.\",\"q\":\"이 현상에 대한 설명과 부모 상담 내용으로 옳은 것은?\",\"choices\":[\"문법형태소 습득이 퇴행한 것이므로 즉시 조음·문법 중재를 시작해야 한다\",\"과잉규칙화로 정상 발달 과정이며, 바른 형태를 모델링하도록 안내한다\",\"청각 문제로 어미를 잘못 듣는 것이므로 청력검사를 우선 의뢰한다\",\"성인의 잘못된 발음을 모방한 결과이므로 가족의 말을 교정해야 한다\",\"언어 처리 속도 저하의 징후이므로 작업기억 훈련이 필요하다\"],\"answer\":2,\"explain\":\"정확히 쓰던 불규칙 형태가 규칙형으로 바뀌는 것(과잉규칙화)은 아동이 단순 모방이 아니라 활용 규칙을 능동적으로 추출해 불규칙 용언에까지 적용한다는 증거로, U자형 발달의 정상 과정이다. 이는 행동주의(모방·강화)만으로 언어 습득을 설명하기 어렵다는 근거이기도 하다. 상담 시에는 병리가 아님을 설명하고 직접 교정보다 바른 형태를 자연스럽게 모델링(고쳐 말하기)하도록 안내한다. ①·③·⑤는 정상 현상을 병리로 오해한 것이며, ④는 성인 입력에는 없는 형태이므로 모방으로 설명되지 않는다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 발달성 언어장애 아동\\n• 비단어 따라말하기와 문장 따라말하기가 또래보다 현저히 낮음\\n• \\\"공을 집어서 상자에 넣고 문 옆에 두세요\\\" 같은 3단계 지시는 첫 단계만 수행\\n• 같은 지시를 한 단계씩 나누어 주면 모두 수행\\n• 빠른 속도로 말하면 이해가 급격히 떨어짐\",\"q\":\"이 아동의 정보처리 특성을 고려한 중재 원리로 가장 적절한 것은?\",\"choices\":[\"숫자 거꾸로 외우기 등 기억 훈련을 언어치료의 주 내용으로 한다\",\"입력 속도를 늦추고 정보를 나누어 제시하며 시각 지원으로 처리 부담을 줄인다\",\"처리 부담과 무관하게 연령 수준의 긴 문장을 그대로 제시하여 익숙해지게 한다\",\"이해가 어려운 것은 주의력 문제이므로 언어 중재 대신 주의력 훈련만 실시한다\",\"지시 따르기가 안 되면 같은 지시를 반복 연습시켜 순응을 높인다\"],\"answer\":2,\"explain\":\"비단어·문장 따라말하기 저조, 정보량·속도에 따른 이해 저하는 발달성 언어장애의 제한된 처리 용량(음운 작업기억·처리 속도)을 반영한다. 정보처리 관점의 중재는 입력 속도 감소, 단위 분할, 핵심어 강조·반복, 시각 지원 등으로 처리 부담을 조절하면서 목표 언어 형식의 학습을 촉진하는 것이다. ①은 언어와 분리된 기억 훈련의 전이 효과가 제한적이고, ③·⑤는 처리 특성을 무시하며, ④는 주의력 문제로 단정할 근거가 없다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 2학년, 사회적(화용) 의사소통장애 아동\\n• 어휘·구문·조음은 연령 수준\\n• 친구에게 다가가 대화를 시작하지 못하고, 시작하더라도 자기 관심사인 공룡 이야기만 계속함\\n• 친구가 지루해하는 표정을 알아채지 못함\\n• 치료실에서 배운 '인사하고 질문하기'를 교실에서는 사용하지 않음\",\"q\":\"이 아동의 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"어휘·문법형태소와 복문 산출 훈련을 우선하여 실시한다\",\"치료실에서 대화 규칙을 설명하고 문제집으로 정답을 고르게 한다\",\"역할놀이·비디오 모델링과 또래 참여로 교실 일반화를 계획한다\",\"조음 정확도 훈련으로 말의 명료도를 높여 친구가 더 잘 반응하도록 한다\",\"관심사(공룡) 이야기를 금지하여 대화 주제 독점을 줄인다\"],\"answer\":3,\"explain\":\"대화 시작·주제 유지·상대 반응 읽기 등 화용 결함은 실제 상호작용 맥락에서 역할놀이·비디오 모델링·또래 매개 중재(소집단)로 연습하고 자연 환경(교실)으로 일반화를 계획해야 효과가 있다. 언어 형식이 정상이므로 ①·④는 표적이 틀리고, ②는 지식 수준에 그쳐 일반화가 어려우며, ⑤는 관심사를 금지하기보다 상대 반응에 맞춰 주제를 조절하도록 지도하는 것이 적절하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"7세 다운증후군 아동\\n• 언어 이해가 표현보다 상대적으로 양호함\\n• 자발화 MLU가 짧고 조사·어미 생략이 잦음\\n• 숫자·낱말 따라말하기 등 청각적 단기기억이 매우 낮음\\n• 시각적 기억·그림 짝짓기 과제는 상대적 강점\\n• 저긴장으로 명료도가 낮음\",\"q\":\"이 아동의 강·약점 프로파일을 반영한 중재로 가장 적절한 것은?\",\"choices\":[\"청각 기억이 약하므로 긴 문장을 반복해서 들려주는 청각 훈련에 집중한다\",\"명료도가 낮으므로 구어를 중단하고 문자 소통으로 전환한다\",\"시각 지원을 병행하며 짧고 명확한 모델로 구문 산출을 목표로 한다\",\"이해가 양호하므로 표현 중재는 생략하고 이해 중심으로 진행한다\",\"시각 자료는 말에 집중하는 것을 방해하므로 사용하지 않는다\"],\"answer\":3,\"explain\":\"다운증후군은 이해 > 표현, 구문·문법형태소 취약, 청각적 단기기억 약점, 시각 처리 상대 강점이라는 전형적 프로파일을 보인다. 따라서 그림·글자·간단한 손짓 등 시각 지원을 병행해 구문·문법형태소 산출을 목표로 하고, 청각 기억 부담을 줄인 짧고 명확한 모델을 주는 것이 적절하다. ①·⑤는 약점에 부담을 주고 강점을 버리는 접근, ②는 구어 가능성을 포기하는 것, ④는 가장 취약한 표현 영역을 방치하는 것이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 3학년 언어장애 아동을 담당하는 언어재활사가 담임교사와 매주 협의하여 다음 주 교과 수업의 핵심 어휘·개념을 미리 파악하고, 일부 회기는 교실에서 수업 활동에 참여하며 아동을 지원한다. 교사에게는 수업 중 아동에게 사용할 언어 촉진 전략을 안내한다.\",\"q\":\"이 서비스 전달 모델의 명칭과 주요 장점으로 옳은 것은?\",\"choices\":[\"분리(pull-out) 모델 – 조용한 환경에서 집중 훈련이 가능하다\",\"의료 모델 – 손상 부위와 원인에 따른 개별 치료가 가능하다\",\"자문 모델만 적용 – 언어재활사가 아동을 직접 보지 않아 효율적이다\",\"비연속 개별시도 모델 – 반응 정확도를 정밀하게 측정한다\",\"교실 중심·협력적 모델 – 교육과정 연계로 실제 환경 일반화를 촉진한다\"],\"answer\":5,\"explain\":\"교사와 협력해 교육과정 어휘를 목표로 삼고 교실에서 직접 지원하며 교사에게 전략을 자문하는 것은 교실 중심(pull-in)·협력적 서비스 모델로, 교육과정과 연계된 목표를 통해 학령기 아동의 실제 환경 일반화와 학업 성취를 촉진하는 것이 장점이다. ①은 치료실 분리 방식, ③은 직접 서비스가 병행되므로 틀리며, ②·④는 서비스 전달 모델의 분류가 아니다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"4세 아동의 목표 '두 낱말 요구하기(예: 물 주세요)'가 치료실에서 치료사와의 간식 활동에서는 3회기 연속 90% 이상 산출된다. 그러나 어머니 보고에 따르면 가정에서는 여전히 손으로 가리키거나 울며, 어린이집에서도 요구 발화가 관찰되지 않는다.\",\"q\":\"다음 단계의 계획으로 가장 적절한 것은?\",\"choices\":[\"어린이집에서 말할 때까지 가정에서 원하는 것을 주지 말도록 지도한다\",\"치료실 정확도가 높으므로 목표를 종결하고 세 낱말 조합으로 넘어간다\",\"치료실에서 같은 과제의 정확도를 100%까지 더 높인 뒤 기다린다\",\"가정에서 산출이 없으므로 목표를 재설정하고 치료실 훈련을 반복한다\",\"부모·교사를 훈련해 가정·어린이집 일과에서 일반화를 촉진한다\"],\"answer\":5,\"explain\":\"치료실 준거는 도달했으나 다른 환경에서 나타나지 않는 것은 자극·환경 일반화 실패이므로, 다음 단계는 가정·어린이집으로 중재 환경을 옮기고 부모·교사가 일과 속에서 요구 기회를 만들고 자연적 강화로 반응하도록 훈련하며 사람·장소·사물을 다양화하는 것이다. ②·③은 일반화 없이 종결하거나 치료실에 머무는 것이고, ④는 이미 습득된 기술을 불필요하게 재훈련하며, ①은 비윤리적이고 좌절만 유발한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"언어 지체가 있는 28개월 아동과 어머니의 10분 놀이 상호작용 관찰\\n• 어머니 발화의 약 80%가 \\\"이건 뭐야?\\\", \\\"이거 해 봐\\\" 같은 질문·지시\\n• 아동이 자동차를 굴리며 소리를 내면 어머니는 그 행동을 보지 않고 그림책을 읽어 주려 함\\n• 아동이 발성·몸짓으로 시작한 행동에 어머니가 반응하는 비율이 낮음\\n• 아동의 놀이 주제와 어머니의 놀이 주제가 자주 어긋남\",\"q\":\"이 관찰에 근거한 부모 코칭의 우선 목표로 가장 적절한 것은?\",\"choices\":[\"소리만 내면 반응하지 말고 낱말을 말할 때만 반응하게 한다\",\"아동이 말할 때까지 질문 횟수를 더 늘려 산출 기회를 확보하게 한다\",\"놀이보다는 그림카드로 낱말 이름대기를 매일 30분 훈련하게 한다\",\"어머니가 정한 주제로 놀이를 이끌어 아동이 따라오게 한다\",\"아동 주도 따르기·즉각 반응·확장 등 반응적 전략을 지도한다\"],\"answer\":5,\"explain\":\"지시·질문 위주의 성인 주도 상호작용과 아동의 시작 행동에 대한 낮은 반응성은 초기 언어 발달을 저해한다. 부모 매개 중재(Hanen 등)의 핵심은 관찰–기다리기–경청, 아동의 관심·주도 따라가기, 시작 행동에 즉시 반응하기, 행동·발성을 모방·해석해 말로 들려주고 확장하기 같은 반응적 상호작용 전략이다. ②·④는 성인 주도를 강화하고, ③은 자연스러운 상호작용을 훈련으로 대체하며, ①은 언어 이전 의사소통 시도를 무시해 시작 행동을 오히려 줄인다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"자폐스펙트럼장애 아동 3명에게 그림교환 기반 '요구하기' 중재를 적용하려 한다.\\n• 목표행동: 자발적 요구하기 횟수\\n• 한 번 습득된 요구하기는 중재를 철회해도 쉽게 사라지지 않을 것으로 예상됨\\n• 중재 효과를 실험적으로 입증하고 싶으나, 습득된 기술을 일부러 되돌리는 것은 윤리적으로 부적절하다고 판단함\",\"q\":\"이 상황에 가장 적합한 단일대상연구 설계는?\",\"choices\":[\"대상자 간 중다기초선 설계\",\"ABAB(반전) 설계\",\"교대중재(중재교대) 설계\",\"단일 AB 설계\",\"기준변경(준거변경) 설계\"],\"answer\":1,\"explain\":\"대상자 간 중다기초선 설계는 여러 대상에게 시차를 두고 중재를 도입하여, 중재를 철회(반전)하지 않고도 중재가 시작된 대상에서만 변화가 나타남을 보여 실험적 통제를 입증한다. 비가역적 행동·윤리적 이유로 반전이 어려운 상황에 적합하다. ABAB는 중재 철회가 필요하므로 부적합하고, AB 설계는 실험적 통제가 없으며, 교대중재는 둘 이상의 중재를 비교할 때, 기준변경 설계는 이미 레퍼토리에 있는 행동의 수준을 단계적으로 높일 때 사용한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"단일대상연구 자료(정반응률 %)\\n• 기초선(A) 5회기: 20, 30, 25, 35, 30\\n• 중재(B) 8회기: 40, 30, 55, 60, 70, 65, 80, 85\",\"q\":\"비중복 자료 비율(PND)로 옳은 것은?\",\"choices\":[\"62.5%\",\"75.0%\",\"100%\",\"87.5%\",\"50.0%\"],\"answer\":4,\"explain\":\"PND는 기초선의 최고점(35)을 초과하는 중재기 자료점의 비율이다. 중재기 8개 중 35를 초과하는 값은 40, 55, 60, 70, 65, 80, 85의 7개이므로 7/8 = 87.5%이다. 두 번째 자료점(30)은 기초선 최고점과 중복되어 제외된다. ※PND 해석 기준(예: 90% 이상 매우 효과적, 70~90% 효과적 등)은 교재별로 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"두 명의 언어재활사가 5세 아동의 자발화 60개 발화에 대해 형태소 분석을 독립적으로 수행하고, 발화별 형태소 수의 일치 여부를 비교하였다.\\n• 일치: 51개 발화\\n• 불일치: 9개 발화\",\"q\":\"발화별(point-by-point) 평가자 간 일치율과 그에 따른 판단으로 옳은 것은?\",\"choices\":[\"15%로, 분석 기준을 재정비한 뒤 전체 자료를 재분석한다\",\"51%로, 분석 기준을 재정비한 뒤 전체 자료를 재분석한다\",\"85%로, 수용 가능한 수준이며 분석 자료로 사용할 수 있다\",\"85%이나 90%에 못 미쳐 자료를 폐기하고 새로 수집한다\",\"567%로, 일치 수를 불일치 수로 나누어 산출한 값이다\"],\"answer\":3,\"explain\":\"발화별 일치율 = 일치 ÷ (일치 + 불일치) × 100 = 51 ÷ 60 × 100 = 85%이다. 일반적으로 80% 이상이면 수용 가능한 신뢰도로 본다. 51%·15%는 산출 오류이고, 90% 미만이라고 자료를 폐기하는 것은 과도한 조치이다. ※수용 기준(80% 또는 90%)은 교재·연구 설계에 따라 다를 수 있음.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"만 4세 6개월 아동의 표준화 언어검사 결과(평균 100, 표준편차 15)\\n• 수용어휘 표준점수 76\\n• 표현어휘 표준점수 94\\n• 검사 시 협조 양호, 청력 정상\",\"q\":\"이 결과의 해석과 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"수용어휘 지체로 보고 이해 중재를 우선하며 표현어휘는 모니터링한다\",\"표현어휘가 수용어휘보다 낮으므로 표현어휘 중재를 우선 실시한다\",\"수용어휘 76은 −1SD 이내의 경계선 수준이므로 관찰만 한다\",\"두 영역 모두 정상범위이므로 중재 없이 6개월 후 재평가한다\",\"표준점수 18점 차이는 측정 오차 범위로 두 영역을 동일 수준으로 본다\"],\"answer\":1,\"explain\":\"표준점수 76은 z = (76−100)/15 = −1.6SD로 백분위 약 5에 해당하여 지체 범위이고, 94는 −0.4SD로 정상범위이다. 따라서 수용어휘(이해)가 우선 중재 목표가 된다. 표현어휘가 더 낮다는 해석(2)과 −1SD 이내라는 해석(3)은 수치상 틀렸으며, 18점 차이는 1SD 이상으로 오차 범위로 보기 어렵다. ※지체 판정 절단점(−1SD, −1.25SD, −1.5SD, −2SD)은 검사·교재별로 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"종합병원에 근무하는 언어재활사가 퇴근 후 개인 언어재활센터를 운영하고 있다. 병원에서 치료 중인 실어증 환자의 보호자에게 \\\"병원보다 제 센터에 오시면 더 자주 볼 수 있다\\\"며 자신의 센터 명함을 건네고 병원 치료 종결을 권유하였다.\",\"q\":\"이 행동에 대한 윤리적 판단과 바람직한 대처로 가장 적절한 것은?\",\"choices\":[\"환자에게 더 많은 치료 기회를 주는 것이므로 윤리적 문제가 없다\",\"병원장에게 사후 보고를 하면 윤리적 문제가 모두 해소된다\",\"보호자가 동의했다면 비밀유지 의무 위반이 아니어서 허용된다\",\"치료 강도를 높이려는 시도로 전문성 유지 의무에 부합한다\",\"이해상충 행위이며, 기관 의뢰 절차와 환자 선택권을 지켜야 한다\"],\"answer\":5,\"explain\":\"언어재활사는 내담자의 이익을 최우선으로 해야 하며, 자신의 경제적 이익을 위해 내담자를 유인하는 것은 이해상충(이중관계) 위반이다. 기관 간 의뢰가 임상적으로 필요하면 소속 기관의 절차를 따르고 환자의 자기결정권(기관 선택권)을 보장해야 한다. 이 사례의 핵심 쟁점은 비밀유지나 전문성 유지가 아니라 이해상충이며, 사후 보고만으로는 위반이 해소되지 않는다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"5세 아동이 치료실에 올 때마다 팔과 등에 새로운 멍이 있고, 놀이 중 \\\"아빠가 밤에 때려서 아파\\\"라고 말하였다. 보호자는 \\\"애가 잘 넘어진다\\\"고 하였다.\",\"q\":\"언어재활사의 대처로 가장 적절한 것은?\",\"choices\":[\"학대 증거가 확실해질 때까지 몇 주 더 관찰한 뒤 신고 여부를 결정한다\",\"보호자에게 사실 여부를 먼저 따져 물은 뒤, 인정하면 신고한다\",\"기관장에게 구두로 보고하는 것으로 신고 의무를 다한 것으로 본다\",\"즉시 112에 신고하고, 관찰한 내용을 객관적으로 기록해 둔다\",\"아동에게 반복 질문하여 피해 진술을 상세히 확보한 뒤 신고한다\"],\"answer\":4,\"explain\":\"아동학대는 '의심'만으로도 즉시 신고해야 하며, 확증을 기다리거나 보호자에게 먼저 확인하는 것은 아동을 더 위험하게 할 수 있다. 재활·복지·의료기관 종사자는 아동학대 신고의무자에 해당하므로 정당한 사유 없이 신고하지 않으면 과태료 대상이 된다. 기관 내 보고는 신고를 대신하지 못하고, 아동에게 반복 질문하는 것은 2차 피해와 진술 오염을 초래할 수 있다. ※신고의무자 범위·과태료 등 법 조항은 최신 「아동학대처벌법」 기준으로 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"36개월 말늦은 아동의 어머니가 인터넷에서 본 '구강 감각 브러싱 프로그램'을 언어치료 대신 해 달라고 강하게 요청하였다. 언어재활사가 문헌을 검토한 결과, 해당 프로그램이 언어 산출을 향상시킨다는 통제된 연구 근거는 확인되지 않았다.\",\"q\":\"근거기반실제(EBP)에 따른 가장 적절한 대응은?\",\"choices\":[\"보호자의 요구가 우선이므로 요청한 브러싱 프로그램만 시행한다\",\"보호자 의견은 배제하고 치료사가 정한 프로그램만 시행한다\",\"근거를 설명하고, 입증된 대안을 제안해 가족과 함께 결정한다\",\"근거가 없는 중재를 요구하므로 치료를 종결하고 타 기관을 안내한다\",\"임상 경험상 효과를 본 사례가 있다면 근거로 충분하므로 시행한다\"],\"answer\":3,\"explain\":\"EBP는 ①최선의 연구 근거 ②임상 전문성 ③내담자·가족의 가치와 선호를 통합하여 의사결정하는 것이다. 근거 검토 결과를 이해하기 쉽게 설명하고 효과가 입증된 대안(예: 부모 실행 언어촉진)을 제시하면서 가족의 우선순위·가치를 반영해 공동으로 결정하는 것이 세 요소를 모두 반영한다. 보호자 요구만 따르거나(1), 가족 가치를 배제하거나(2), 종결하거나(4), 개인 경험만을 근거로 삼는 것(5)은 EBP의 어느 한 요소만 취하거나 모두 무시한 대응이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"회기 기록 내용\\n㉠ 어머니: \\\"주말에 집에서 '물 주세요'를 스스로 두 번 말했어요.\\\"\\n㉡ 그림 자극 20개 중 14개(70%)에서 2어 조합을 자발 산출, 구어 촉진 시 18개(90%)\\n㉢ 지난 회기(55%) 대비 향상되었으나 준거(80%, 3회기 연속)에는 아직 미달\\n㉣ 다음 회기부터 촉진을 시간지연으로 점차 줄이고 놀이 상황으로 확장\",\"q\":\"SOAP 기록 형식에서 각 항목이 해당하는 영역으로 옳은 것은?\",\"choices\":[\"㉠ O, ㉡ S, ㉢ A, ㉣ P\",\"㉠ S, ㉡ A, ㉢ O, ㉣ P\",\"㉠ S, ㉡ O, ㉢ A, ㉣ P\",\"㉠ A, ㉡ O, ㉢ P, ㉣ S\",\"㉠ S, ㉡ O, ㉢ P, ㉣ A\"],\"answer\":3,\"explain\":\"S(주관적)는 보호자·대상자의 보고(㉠), O(객관적)는 측정·관찰된 수행 자료(㉡), A(평가)는 자료에 대한 임상적 해석과 진전 판단(㉢), P(계획)는 다음 회기 계획(㉣)이다. 수치 자료(㉡)를 주관적 정보로, 진전 판단(㉢)을 객관적 자료로 분류한 보기는 틀렸다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"지적장애 6세 아동은 언어재활사가 \\\"이거 뭐야? 사과\\\"라고 완전한 구어 모델을 제시할 때만 '사과'를 산출하며, 모델 없이 자발적으로 명명하는 경우는 거의 없다. 모델 제공 조건에서의 정반응률은 95%에 이르렀다.\",\"q\":\"촉진 의존을 줄이고 자발 산출을 늘리기 위한 절차로 가장 적절한 것은?\",\"choices\":[\"매 시행마다 완전 구어 모델을 계속 제공하여 정확도를 유지한다\",\"모델 제시 전 대기 시간을 점차 늘리는 시간지연을 적용한다\",\"촉진 강도를 더 높여 모델과 함께 신체적 촉진을 추가한다\",\"촉진을 한 번에 모두 제거하고 오반응이 나오면 무시한다\",\"정반응이 나올 때까지 같은 자극을 연속 10회 반복 제시한다\"],\"answer\":2,\"explain\":\"습득이 완료된 반응이 촉진에 의존할 때는 자극 제시 후 모델 제공까지의 대기 시간을 0초에서 2초, 4초로 점진적으로 늘리는 시간지연 절차로 촉진을 체계적으로 소거하여 자극 통제를 촉진에서 자연 자극으로 옮긴다. 촉진을 계속 주면 의존이 유지되고, 한 번에 제거하면 오류가 급증하며, 촉진 강도를 높이는 것은 오히려 의존을 강화한다. 단순 반복 제시는 촉진 소거 원리에 해당하지 않는다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"5세 언어발달지연 아동에게 세 가지 목표(과거시제 '-았/었-', 조사 '-에서', 접속어 '그래서')를 설정하였다. 언어재활사는 한 목표를 3회기씩 다루되, 아동이 준거에 도달하지 않더라도 정해진 회기가 끝나면 다음 목표로 넘어가고, 세 목표를 한 바퀴 돈 뒤 다시 첫 목표로 돌아오도록 계획하였다.\",\"q\":\"이 계획에 해당하는 목표 공격 전략과 그 근거로 옳은 것은?\",\"choices\":[\"주기적 접근 – 여러 형태가 동시에 점진적으로 발달함을 반영\",\"수직적 접근 – 한 목표를 준거까지 집중 훈련한 뒤 다음 목표로 이동\",\"수평적 접근 – 여러 목표를 한 회기 안에서 준거 도달까지 동시에 훈련\",\"위계적 접근 – 발달 순서대로 한 목표씩 준거까지 순차적으로 훈련\",\"선택적 접근 – 아동이 선호하고 흥미를 보이는 목표만 골라 훈련\"],\"answer\":1,\"explain\":\"정해진 기간 동안 각 목표를 다루고 준거 도달과 무관하게 순환하는 방식은 주기적(cyclical) 접근이며, 여러 형태가 점진적·동시적으로 발달한다는 자연 습득 원리를 반영한다. 수직적 접근은 준거 도달까지 한 목표만 훈련하고, 수평적 접근은 한 회기 안에 여러 목표를 동시에 준거까지 훈련하므로 이 계획과 다르다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"7세 말소리장애 아동이 치료실에서 /ㅅ/ 어두·어중·어말 낱말 수준에서 3회기 연속 90% 이상 정조음하여 준거에 도달하였다. 그러나 보호자는 집과 학교 대화에서는 여전히 /ㅅ/→[ㄷ] 오류가 많다고 보고하였다.\",\"q\":\"이 시점에서 가장 적절한 결정은?\",\"choices\":[\"치료실 준거를 충족하였으므로 즉시 종결하고 추후 점검만 한다\",\"낱말 수준을 처음부터 다시 반복하여 정확도를 더 높인다\",\"일반화는 자연히 일어나므로 회기를 늘리지 않고 기다린다\",\"목표음을 /ㅈ/으로 바꾸어 새로운 목표 훈련을 시작한다\",\"대화 수준·다양한 상황으로 확장하고 보호자 훈련을 병행한다\"],\"answer\":5,\"explain\":\"종결 결정은 치료실 준거뿐 아니라 일상 상황으로의 일반화 자료를 근거로 해야 한다. 이 아동은 낱말 수준에서만 준거에 도달했으므로 문장·대화 수준으로 확장하고 상황·대화 상대를 다양화하며 보호자를 훈련하여 일반화를 프로그래밍한 뒤, 회기 간격을 늘리는 점진적 종결과 추후 점검을 계획한다. 즉시 종결·자연 대기는 일반화 실패를 방치하고, 낱말 수준 반복이나 목표 변경은 현재 문제(일반화)를 다루지 못한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"통합어린이집의 4세 아동에게 '또래에게 먼저 말이나 몸짓으로 의사소통을 시작하기'를 목표로 설정하였다. 자유놀이 30분 동안 이 행동은 하루 2~5회 정도 드물게 나타나며, 시작과 끝이 분명하다.\",\"q\":\"이 목표행동의 진전을 측정하기에 가장 적합한 자료수집 방법은?\",\"choices\":[\"지속시간 기록법(각 시도가 이어진 시간을 초 단위로 잰다)\",\"영속적 산물 기록법(활동 후 남은 결과물을 확인한다)\",\"부분간격 기록법(10초 간격 중 한 번이라도 발생하면 기록한다)\",\"지연시간 기록법(교사 지시 후 반응까지의 시간을 잰다)\",\"사건(빈도) 기록법(관찰 시간 중 발생 횟수를 센다)\"],\"answer\":5,\"explain\":\"시작과 끝이 분명한 이산 행동이 낮은 빈도로 나타날 때는 사건(빈도) 기록이 가장 적합하며, 관찰 시간이 달라질 수 있으므로 비율(회/분)로 환산한다. 지속시간·지연시간 기록은 '얼마나 오래·얼마나 빨리'가 목표일 때, 간격기록은 고빈도이거나 지속적인 행동에, 영속적 산물 기록은 결과물이 남는 행동에 적합하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"초등 2학년 특수교육대상 아동(경도 지적장애)이 통합학급에서 교사의 지시 이해와 발표에 어려움을 보인다. 개별 치료실에서는 목표 문장을 잘 산출하지만 교실에서는 거의 사용하지 않는다. 담임교사는 교실에서 어떻게 도와야 할지 모르겠다고 한다.\",\"q\":\"이 아동에게 가장 적절한 서비스 전달 모형은?\",\"choices\":[\"분리(pull-out) 개별치료의 회기 수를 두 배로 늘린다\",\"교사에게 치료 보고서만 전달하고 교실 지원은 교사에게 맡긴다\",\"치료실에서 교과 학습지를 풀게 하여 학업 내용을 보충한다\",\"교실 기반 협력 모형으로 수업 중 목표를 다루고 교사를 코칭한다\",\"아동을 특수학급으로 전일 배치하여 집중 지도하도록 권고한다\"],\"answer\":4,\"explain\":\"치료실에서 습득한 기술이 교실로 일반화되지 않고 교사가 지원 방법을 모르는 상황에서는, 실제 교실 맥락에서 목표를 훈련하고 교사와 협력하는 교실 기반·협력 모형이 적합하다. 분리 치료를 늘리는 것은 일반화 문제를 해결하지 못하고, 보고서 전달만으로는 교사 역량이 강화되지 않으며, 학습지 풀이나 전일 특수학급 배치는 의사소통 목표와 최소제한환경 원칙에 맞지 않는다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"도서 지역에 거주하는 5세 말소리장애 아동의 보호자가 화상 원격 언어치료를 요청하였다. 아동은 화면 주의집중이 짧은 편이고, 가정에는 태블릿과 인터넷이 있다.\\n\\nㄱ. 아동의 원격치료 적합성(주의집중·청각 환경·기기 조작 등)을 사전에 평가한다\\nㄴ. 보호자를 회기 보조자(e-helper)로 교육하여 자료 제시·촉진을 돕게 한다\\nㄷ. 개인정보 보호가 가능한 보안 플랫폼을 사용하고, 녹화 시 사전 동의를 받는다\\nㄹ. 원격치료에서는 대면치료와 달리 자격·윤리 기준이 완화되어 적용된다\",\"q\":\"원격치료 실시 전 고려사항으로 옳은 것을 모두 고른 것은?\",\"choices\":[\"ㄱ, ㄴ\",\"ㄱ, ㄴ, ㄷ\",\"ㄴ, ㄹ\",\"ㄱ, ㄷ, ㄹ\",\"ㄱ, ㄴ, ㄷ, ㄹ\"],\"answer\":2,\"explain\":\"원격치료는 대상자 적합성 평가, 현장 보조자(e-helper) 교육, 보안 플랫폼과 녹화 동의 등 개인정보 보호가 필수이다. 원격치료도 대면치료와 동일한 자격·윤리·서비스 질 기준이 적용되므로 ㄹ은 틀렸다. 주의집중이 짧은 아동일수록 보호자 보조자 역할이 중요하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"자폐스펙트럼장애 평가 결과를 들은 아버지가 \\\"우리 애는 눈도 잘 맞추는데 검사가 잘못된 거 아닙니까? 선생님이 뭘 안다고요\\\"라며 언성을 높였다.\",\"q\":\"언어재활사의 반응으로 가장 적절한 것은?\",\"choices\":[\"검사 점수표를 다시 보여주며 결과가 객관적임을 조목조목 입증한다\",\"진단명을 언급하지 않기로 하고 결과 설명을 모두 생략한다\",\"부정하는 반응은 협조 거부이므로 상담을 종료하고 다른 기관을 안내한다\",\"\\\"아버님이 인정하지 않으면 아이가 더 나빠집니다\\\"라고 경고한다\",\"\\\"많이 놀라고 속상하셨겠어요\\\"라고 감정을 먼저 반영한다\"],\"answer\":5,\"explain\":\"진단 통보 후 부정·분노는 정상적인 애도 반응이다. 상담자는 먼저 반영적 경청과 공감으로 감정을 수용하고, 보호자가 정보를 받아들일 준비가 되었을 때 구체적 관찰 근거를 함께 살펴보며 단계적으로 공유해야 한다. 즉각적 논증(1)이나 경고(4)는 방어를 강화하고, 상담 종료(3)나 정보 생략(2)은 보호자의 알 권리와 라포 형성에 어긋난다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"6세 남아. 3개월 이상 지속되는 쉰 목소리로 어린이집 교사가 언어재활센터에 의뢰하였다. 아동은 소리 지르기가 잦고, 최근 목소리가 자주 갈라지며 말할 때 숨이 찬다고 한다. 이비인후과 진료를 받은 적은 없다.\",\"q\":\"언어재활사의 대처로 가장 적절한 것은?\",\"choices\":[\"진단 의뢰 없이 음성위생 교육과 음성치료를 즉시 시작한다\",\"성장하면 저절로 좋아지므로 경과 관찰만 하도록 권한다\",\"쉰 목소리는 소리 지르기 때문이므로 조음치료로 대체해 진행한다\",\"이비인후과 후두 검진을 먼저 의뢰하고 진단에 따라 계획한다\",\"보호자에게 약국에서 목 스프레이를 구입하도록 안내한다\"],\"answer\":4,\"explain\":\"지속되는 음성 문제는 성대결절 외에도 유두종·낭종 등 의학적 처치가 필요한 병변일 수 있으므로, 음성치료 전에 이비인후과 후두 검진(후두내시경)으로 원인을 확인하고 의학적 진단을 바탕으로 치료 계획을 세운다. 진단 없이 치료를 시작하거나(1) 경과만 관찰하는 것(2)은 병변을 놓칠 수 있고, 조음치료 대체(3)나 약 구입 안내(5)는 언어재활사의 업무 범위와 의뢰 원칙에 맞지 않는다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"18개월 발달지연 영아의 조기개입 팀에 언어재활사·작업치료사·물리치료사·특수교사가 참여한다. 팀은 가족 부담을 줄이기 위해 함께 평가(아레나 평가)하고, 가족과 가장 자주 만나는 특수교사 1명이 주 서비스 제공자가 되어, 다른 전문가가 훈련해 준 언어촉진·자세 지원 전략을 가정 일과에서 통합적으로 실행하도록 하였다.\",\"q\":\"이 팀 모형과 그 핵심 특징으로 옳은 것은?\",\"choices\":[\"다학문적 팀 – 각 전문가가 독립적으로 평가·중재하고 결과만 공유한다\",\"초학문적 팀 – 역할방출을 통해 한 전문가가 통합적으로 중재를 실행한다\",\"다학문적 팀 – 공동 평가 후 한 전문가에게 다른 전문가의 역할을 방출한다\",\"간학문적 팀 – 각자 평가하되 계획을 공동으로 수립하고 중재는 각자 실행한다\",\"협의형 팀 – 언어재활사는 자문만 제공하고 평가에는 참여하지 않는다\"],\"answer\":2,\"explain\":\"공동(아레나) 평가, 역할방출, 주 서비스 제공자를 통한 통합 중재는 초학문적 팀 모형의 핵심 특징이다. 다학문적 팀은 독립적 평가·중재 후 결과만 공유하고, 간학문적 팀은 계획은 공동으로 세우되 중재는 각 전문가가 따로 실행한다. 역할방출은 다학문적 팀의 특징이 아니다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"어린이집 담임교사가 전화로 \\\"우리 반 아동의 언어평가 결과와 진단명을 알려 달라. 교육에 참고하겠다\\\"고 요청하였다. 보호자에게는 이 요청에 대해 아직 알리지 않은 상태이다.\",\"q\":\"가장 적절한 대처는?\",\"choices\":[\"보호자 서면 동의를 받은 뒤 필요한 범위에서 제공한다\",\"진단명은 알려주지 않고 표준점수 등 수치 결과만 알려준다\",\"교사가 소속 기관 공문을 보내면 보호자 동의 없이 제공한다\",\"먼저 교사에게 결과를 제공한 뒤 보호자에게 사후 통보한다\",\"교육 목적의 요청이므로 요약 결과를 전화로 알려준다\"],\"answer\":1,\"explain\":\"평가 결과·진단명은 민감한 개인정보이므로 제3자 제공에는 정보주체(보호자)의 명시적 동의가 필요하며, 동의서에는 제공 목적·범위·대상이 포함되어야 한다. 교육 목적, 기관 공문, 부분 정보 제공, 사후 통보는 모두 동의 없는 제공에 해당하여 비밀유지 의무와 개인정보보호 원칙에 위배된다.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활센터 원장(1급 언어재활사)이 자격이 없는 직원에게 자신의 자격증을 빌려주어, 언어재활사 명의로 아동 치료를 하게 하였다.\",\"q\":\"「장애인복지법」상 이 원장에 대한 조치로 옳은 것은?\",\"choices\":[\"보수교육을 추가로 이수하면 갈음된다\",\"1회 위반이므로 경고 처분에 그친다\",\"자격증 대여는 자격 취소 사유에 해당한다\",\"최대 1년 이내의 자격정지만 가능하다\",\"원장은 처분 대상이 아니고 직원만 책임진다\"],\"answer\":3,\"explain\":\"「장애인복지법」은 언어재활사가 자격증을 다른 사람에게 대여한 경우를 자격 취소 사유로 규정하며, 대여받거나 알선한 사람도 처벌 대상이다. 경고·보수교육·자격정지로 갈음되지 않고, 대여한 원장 본인이 처분 대상이다. ※자격취소·정지 사유의 세부 조항(제74조 등)과 벌칙은 최신 법령으로 확인 권장.\"},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"24개월 아동이 표현 낱말 8개로 말늦은 아동에 해당하며, 이해력과 놀이·상징 발달은 연령 수준이다. 맞벌이 부모는 주 1회 센터 방문도 어렵다고 호소하며, 집에서 어떻게 도와야 할지 모르겠다고 한다.\",\"q\":\"이 가족에게 가장 적절한 중재 접근은?\",\"choices\":[\"센터 방문을 주 3회로 늘려 치료사 주도의 개별치료를 집중 실시한다\",\"가정 일과 속 언어촉진 전략을 부모가 실행하도록 코칭한다\",\"이해력이 정상이므로 만 3세까지 아무 중재 없이 기다린다\",\"어린이집에 보내는 것만으로 충분하므로 별도 중재는 하지 않는다\",\"보호자에게 매일 낱말 카드 학습지를 풀게 하도록 지시한다\"],\"answer\":2,\"explain\":\"조기개입은 가족중심·일과 기반 실제가 원칙이며, 말늦은 아동에게는 부모 실행 언어촉진 중재의 근거가 확립되어 있다. 식사·목욕·놀이 등 가정 일과에 모델링·확장·기다리기 같은 전략을 심도록 부모를 코칭하고, 필요 시 화상 코칭을 병행하며 정기적으로 진전을 점검한다. 가족의 시간 제약을 고려하면 치료사 주도 방문 증가(1)는 실현 가능성이 낮고, 학습지(5)는 영아의 자연스러운 언어 습득에 맞지 않으며, 위험 요인이 있는 아동을 무중재로 기다리거나(3) 어린이집에만 맡기는 것(4)은 적절한 모니터링·촉진을 놓치게 한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 52세 여성, 갑상샘 절제술 2개월 후부터 약하고 기식적인 음성, 물 마실 때 가끔 사레\\n• 후두내시경: 우측 성대가 부정중위(paramedian)에서 고정, 발성 시 성문틈, 가성대의 보상적 과내전\\n• 후두근전도(LEMG): 우측 갑상피열근에서 재신경화 징후(다상성 운동단위전위) 관찰\\n• 환자는 교사로 복직을 앞두고 있음\",\"q\":\"이 시점에서 가장 적절한 관리 계획은?\",\"choices\":[\"회복 가능성이 낮으므로 즉시 제I형 갑상성형술(영구 내측화)을 시행한다\",\"신경 회복을 위해 완전 회복 시까지 절대 음성휴식과 필담만 유지한다\",\"성대 과내전을 막기 위해 우측 갑상피열근에 보툴리눔 독소를 주입한다\",\"음성치료·삼킴 안전 전략을 우선하고 필요 시 일시적 주입술을 고려한다\",\"재신경화 징후는 예후와 무관하므로 즉시 후두신경 재건술을 시행한다\"],\"answer\":4,\"explain\":\"수술 후 2개월이고 LEMG에서 재신경화 징후가 있으면 자연 회복 가능성이 있으므로 비가역적 영구 수술(갑상성형술)은 시기상조이다. 이 시기에는 성대내전 촉진 훈련과 가성대 과보상 감소, 삼킴 안전 전략을 우선하고, 직업적 요구가 크면 흡수성 재료로 일시적 성대주입술을 병행하며 통상 6~12개월 회복 관찰 후 영구 내측화를 결정한다. 보툴리눔 독소는 마비된 성대의 내전을 더 악화시키고, 절대 음성휴식은 성문폐쇄부전 회복에 도움이 되지 않으며 오히려 보상 기전 학습 기회를 잃게 한다. ※영구 수술 결정 시기(6~12개월)는 교재·기관별로 차이가 있을 수 있음.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 56세 여성, 30년간 하루 한 갑 흡연, 최근 전화에서 남성으로 오해받는 일이 잦음\\n• 목소리가 낮고 거칠며 아침에 특히 심하고, 잦은 헛기침·속쓰림 동반\\n• 후두내시경: 양측 성대 전장에 걸친 광범위한 반투명 물주머니 모양의 부종, 성대 상면이 흔들림\\n• 음향분석: 습관적 F0 128 Hz(동연령 여성 규준보다 현저히 낮음)\",\"q\":\"이 사례의 감별과 중재 우선순위로 가장 적절한 것은?\",\"choices\":[\"라인케부종 – 금연·역류 관리를 우선하고, 지속 시 수술을 고려한다\",\"성대낭종 – 즉시 후두미세수술을 시행한 뒤 음성치료를 실시한다\",\"라인케부종 – 음도 높이기 훈련만으로 정상 음도와 병변 회복이 가능하다\",\"성대결절 – 반폐쇄성도훈련만으로 양측 병변 소실을 기대할 수 있다\",\"재발성 후두유두종 – 항바이러스 치료와 레이저 절제를 의뢰한다\"],\"answer\":1,\"explain\":\"양측 성대 전장의 광범위·반투명 부종, 장기 흡연력, 현저히 낮은 F0(여성의 남성화된 음성)는 라인케부종(폴립양 변성)의 전형이다. 원인(흡연·역류·음성 남용) 제거가 일차 과제이며, 원인이 지속되면 수술 후 재발하므로 금연 없이 수술만 하는 것은 의미가 적다. 원인 제거 후에도 부종·음성 문제가 지속되면 미세수술과 수술 전후 음성치료를 병행한다. 부종은 기계적 원인이 아니라 점막 고유층의 액체 저류이므로 음도 훈련이나 SOVT만으로 병변이 소실되지는 않는다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 34세 여성 보육교사, 6개월간 지속된 쉰 목소리\\n• 스트로보스코피: 좌측 성대 막성부 중간의 점막 아래 둥근 백색 병변, 해당 부위 점막파동 소실; 우측 대응 부위에 작은 반응성 부종\\n• 3개월간 음성위생·SOVT 음성치료 실시 → 음성 남용 행동 감소, 우측 부종은 줄었으나 좌측 병변과 음질은 변화 없음\",\"q\":\"가장 적절한 다음 단계는?\",\"choices\":[\"구조적 문제가 아니므로 심인성 음성장애로 보고 정신건강의학과에 의뢰한다\",\"성대결절이 남은 것으로 판단하고 동일한 음성치료를 6개월 더 연장한다\",\"성대폴립으로 판단하고 흡입 스테로이드와 항역류제를 처방받도록 한다\",\"성대낭종으로 보고 후두미세수술 의뢰와 수술 전후 음성치료를 병행한다\",\"양측 병변이므로 양측 성대를 동시에 절제한 뒤 4주간 절대 음성휴식을 취하게 한다\"],\"answer\":4,\"explain\":\"편측성·점막하 병변, 해당 부위의 점막파동 소실, 반대측의 반응성 병변, 그리고 음성치료에 반대측 부종은 반응하나 원발 병변은 반응하지 않는 경과는 성대낭종의 특징이다. 낭종은 행동적 치료로 소실되지 않으므로 미세수술이 필요하며, 수술 전 남용 행동 제거와 수술 후 발성 재교육을 병행한다. 결절은 양측·대칭성이고 점막파동이 보존되며 음성치료에 반응하고, 반응성 부종을 결절로 오인해 양측을 동시에 절제하면 반흔·성대 유착 위험이 커진다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음성범위프로파일(VRP) 결과\\n• 최저 기본주파수: 98 Hz\\n• 최고 기본주파수: 392 Hz\\n• 강도 범위: 55~92 dB SPL\",\"q\":\"이 대상자의 음도 범위를 반음(semitone) 단위로 계산하면?\",\"choices\":[\"12 반음\",\"18 반음\",\"36 반음\",\"30 반음\",\"24 반음\"],\"answer\":5,\"explain\":\"반음 수 = 12 × log₂(최고 F0 ÷ 최저 F0) = 12 × log₂(392 ÷ 98) = 12 × log₂(4) = 12 × 2 = 24 반음(2옥타브). 주파수가 2배가 될 때마다 1옥타브(12반음)이므로 4배는 2옥타브이다. Hz 차이(294 Hz)를 그대로 쓰면 음도 지각의 대수적 특성을 반영하지 못하므로 반드시 비율로 계산한다. ※정상 성인의 VRP 음역 규준(대개 약 24~36반음)은 교재별로 다를 수 있음.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 61세 남성, 약하고 기식적인 음성\\n• 폐활량(VC): 3,500 mL\\n• 최대연장발성시간(MPT): 7초\",\"q\":\"이 환자의 발성지수(phonation quotient, PQ)와 그 시사점으로 옳은 것은?\",\"choices\":[\"175 mL/s – 정상 범위로 발성 효율과 성문폐쇄에 문제가 없다\",\"250 mL/s – 성대 과내전으로 인한 높은 후두저항을 시사한다\",\"350 mL/s – 정상 범위로 호흡 지지와 성문폐쇄가 양호하다\",\"500 mL/s – 성대 과내전으로 인한 높은 후두저항을 시사한다\",\"500 mL/s – 성문폐쇄부전 등으로 인한 공기 낭비를 시사한다\"],\"answer\":5,\"explain\":\"PQ = 폐활량 ÷ MPT = 3,500 mL ÷ 7 s = 500 mL/s. PQ는 발성 1초당 소모되는 공기량의 추정치로, 값이 클수록 같은 공기로 짧게밖에 발성하지 못한다는 뜻이며 성문폐쇄부전(성대마비·위축 등)으로 공기가 새어 나가는 상태를 시사한다. 성대 과내전은 오히려 호기류가 줄어 PQ가 낮아지는 방향이다. ※PQ 정상 범위(대략 120~200 mL/s 내외)는 교재·연령별 규준에 따라 차이가 있음.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 47세 여성, 3년 전부터 서서히 시작되어 점차 악화된 음성 문제\\n• 말할 때 목소리가 쥐어짜듯 끊기며, 특히 모음으로 시작하는 낱말('아침', '오늘')과 전화 통화에서 심함\\n• 노래·웃음·속삭임에서는 거의 정상\\n• 후두 촉진: 압통 없음, 후두 높이 정상\\n• 8주간 후두마사지·SOVT 중심 음성치료 → 변화 없음\\n• 후두내시경: 구조적 병변 없음, 발성 중 불규칙한 성대 과내전 연축\",\"q\":\"이 사례의 감별과 다음 중재로 가장 적절한 것은?\",\"choices\":[\"근긴장성 발성장애 – 후두마사지와 SOVT를 12주 더 지속한다\",\"심인성 발성장애 – 정신건강의학과 의뢰 후 증상 소거 치료를 한다\",\"내전형 연축성발성장애 – 갑상피열근 보툴리눔 독소 주입을 의뢰한다\",\"본태성 음성진전 – 신경과에 프로프라놀롤 약물치료를 의뢰한다\",\"외전형 연축성발성장애 – 후윤상피열근 보툴리눔 독소 주입을 의뢰한다\"],\"answer\":3,\"explain\":\"모음 시작 낱말에서의 과제 특이적 음성 끊김, 노래·속삭임에서의 증상 감소, 서서히 진행하는 경과, 촉진 소견 정상, 충분한 음성치료에 대한 무반응, 내시경상 불규칙한 내전 연축은 내전형 연축성발성장애(신경학적 국소 근긴장이상)를 시사한다. 표준 치료는 갑상피열근 보툴리눔 독소 주입이며, 주입 후 1~2주 일시적 기식성·액체 사레가 흔하므로 사전 상담이 필요하고, 보조적 음성치료를 병행한다. 근긴장성 발성장애는 촉진 압통·후두 상승이 있고 음성치료에 반응하며, 심인성은 급성 발병·정서적 사건 연관과 상황에 따른 변동이 크다. 본태성 음성진전은 규칙적인 율동성 떨림이 특징이다. 외전형은 무성자음에서 기식성 끊김이 나타난다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 39세 남성, 무성자음(/ㅍ, ㅌ, ㅋ, ㅅ, ㅎ/)으로 시작하는 낱말에서 목소리가 바람 빠지듯 갑자기 끊기고 속삭임처럼 됨\\n• 모음이나 유성음으로 시작하는 낱말은 비교적 안정적\\n• 후두내시경: 무성음 산출 시 성대가 과도하게 외전되어 열린 상태가 지연됨, 구조적 병변 없음\",\"q\":\"이 환자의 진단과 보툴리눔 독소 주입의 표적 근육으로 옳은 것은?\",\"choices\":[\"내전형 연축성발성장애 – 갑상피열근\",\"내전형 연축성발성장애 – 외측윤상피열근\",\"외전형 연축성발성장애 – 후윤상피열근\",\"외전형 연축성발성장애 – 갑상피열근\",\"근긴장성 발성장애 – 윤상갑상근 이완 훈련\"],\"answer\":3,\"explain\":\"무성자음 뒤 모음으로 전환할 때 성대가 지연·과도하게 외전되어 기식성 끊김이 생기는 것은 외전형 연축성발성장애이며, 유일한 외전근인 후윤상피열근(PCA)의 불수의적 연축이 원인이므로 이 근육에 보툴리눔 독소를 주입한다. 갑상피열근·외측윤상피열근은 내전근으로 내전형의 표적이다. 근긴장성 발성장애는 특정 음소 환경에 국한된 규칙적 끊김을 보이지 않는다. 외전형은 양측 PCA를 동시에 약화시키면 기도 협착 위험이 있어 한쪽씩·소량으로 주입한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 62세 여성, 갑상샘 전절제술 직후부터 흡기 시 협착음(stridor), 계단 오를 때 호흡곤란\\n• 음성은 약간 약하지만 비교적 잘 유지됨\\n• 후두내시경: 양측 성대가 정중위 부근에서 고정, 흡기 시 성문틈 약 2~3 mm\",\"q\":\"이 환자의 관리 우선순위로 가장 적절한 것은?\",\"choices\":[\"양측 성대주입술로 성문을 완전히 폐쇄하여 음성을 강화한다\",\"기관절개술이나 성문확장술로 기도 확보를 우선한다\",\"밀기 접근법으로 성대 내전을 강화하여 음성을 개선한다\",\"양측 제I형 갑상성형술로 성대를 내측화하여 음량을 높인다\",\"양측 갑상피열근에 보툴리눔 독소를 주입하여 성문을 넓힌다\"],\"answer\":2,\"explain\":\"양측 되돌이후두신경 손상으로 양측 성대가 정중위 부근에 고정되면 음성은 비교적 유지되나 흡기 시 기도가 좁아져 협착음·호흡곤란이 생기므로 생명과 직결되는 기도 확보(기관절개술 또는 성대 외측고정술·피열연골절제술 등 성문확장술)가 최우선이다. 내측화(주입술·갑상성형술)나 내전 강화 훈련은 기도를 더 좁혀 금기이며, 성문확장술은 기도를 넓히는 대신 음성이 약해질 수 있어 이후 기도와 음성의 균형을 고려한 음성치료로 보완한다. 보툴리눔 독소는 근긴장이상에 쓰는 것으로 마비된 성대의 위치를 바꾸지 못한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 후두전적출술 및 방사선치료 종료 후 6개월, 기관식도천공(TEP) 발성을 희망하는 64세 남성\\n• 식도 공기주입검사(insufflation test): 카테터로 공기를 넣으며 발성을 시도했으나 소리가 나지 않고, 목이 조이는 느낌과 함께 하인두 부위가 불룩해지며 공기가 저류됨\",\"q\":\"이 결과의 해석과 조치로 가장 적절한 것은?\",\"choices\":[\"검사를 통과한 것이므로 즉시 TEP를 시행하고 발성 훈련을 시작한다\",\"폐기능 저하가 원인이므로 호흡 근력 훈련을 4주간 실시한 후 재검한다\",\"TEP 발성이 불가능하므로 전기후두 사용도 포기하고 필담으로 전환한다\",\"PE분절 저긴장으로 보고 목 외부 압박 훈련을 실시한 뒤 재검한다\",\"PE분절 과긴장으로 보고 보툴리눔 독소나 근절개술 후 재평가한다\"],\"answer\":5,\"explain\":\"공기주입검사에서 공기를 넣어도 발성이 되지 않고 조임감과 공기 저류(불룩해짐)가 나타나는 것은 PE분절이 과긴장·연축되어 공기가 통과하지 못하는 상태를 뜻한다. 이 경우 TEP를 해도 유창한 발성이 어려우므로 보툴리눔 독소 주입이나 근절개술로 PE분절 긴장을 낮춘 뒤 재평가한다. 저긴장 PE분절은 오히려 소리가 약하고 낮으며 젖은 음질로 나오는 양상이고, 폐기능은 이 검사와 직접 관련이 없다. TEP 부적합이라도 전기후두 등 대안 발성법은 여전히 가능하다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 7세 남아, 축구클럽 활동, 형과 다투며 소리 지르는 일이 잦음, 알레르기 비염으로 입호흡\\n• 후두내시경: 양측 성대 전1/3과 중1/3 경계의 대칭적 소결절\\n• 부모는 빨리 낫게 수술을 원함\",\"q\":\"가장 적절한 중재 계획은?\",\"choices\":[\"후두미세수술을 우선 시행하고 수술 후 음성치료를 한다\",\"4주간 절대 음성휴식을 시킨 뒤 후두내시경으로 재평가한다\",\"부모 교육·환경 조정의 간접치료와 발성 재교육을 병행한다\",\"말하는 대신 속삭이도록 하여 성대 부담과 마찰을 줄인다\",\"음성위생 교육만 실시하고 결절이 자연 소실될 때까지 기다린다\"],\"answer\":3,\"explain\":\"아동 성대결절은 음성 남용이 원인인 행동적 문제이므로 원인 행동을 바꾸지 않으면 수술해도 재발하며, 성장 중인 후두에 대한 수술은 반흔 위험이 있어 일반적으로 보류한다. 아동은 스스로 행동을 조절하기 어려우므로 부모 참여형 간접치료(소리 지르기 대체 행동, 환경 소음 조정, 비염·입호흡 관리 의뢰)와 SOVT·쉬운 시작 등 직접적 발성 훈련을 병행해야 한다. 절대 음성휴식은 아동에게 현실적으로 불가능하고 근본 원인을 바꾸지 못하며, 속삭이기는 오히려 후두 긴장을 높인다. 음성위생만으로는 이미 형성된 습관적 발성 패턴을 바꾸기 어렵다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 45세 남성, 아침에 목 이물감과 잦은 헛기침, 만성 기침, 쉰 목소리\\n• 흉통·속쓰림은 없다고 함\\n• 역류증상지수(RSI): 21점, 역류소견점수(RFS): 12점\\n• 후두내시경: 후두 후방 발적, 피열간 점막 비후(pachydermia), 가성대 부종\",\"q\":\"이 사례의 판단과 중재로 가장 적절한 것은?\",\"choices\":[\"근긴장성 발성장애이므로 후두마사지만 집중적으로 실시한다\",\"인후두역류를 의심해 약물치료 의뢰와 헛기침 대체 훈련을 한다\",\"속쓰림이 없으므로 역류는 배제하고 2주간 음성휴식을 처방한다\",\"성대결절이므로 반폐쇄성도훈련과 음성위생을 실시한다\",\"알레르기 반응이므로 항히스타민제만 복용하도록 한다\"],\"answer\":2,\"explain\":\"RSI가 절단점(>13)을, RFS가 절단점(>7)을 초과하고 후두 후방 발적·피열간 비후·가성대 부종이 있으면 인후두역류(LPR)를 의심한다. LPR은 위식도역류와 달리 속쓰림 등 전형적 위장 증상 없이 후두 증상만 나타나는 경우가 많으므로 속쓰림이 없다고 배제해서는 안 된다. 중재는 이비인후과 의뢰를 통한 약물치료(PPI 등)·식이 및 생활습관 교정과 함께, 후두 점막을 자극해 악순환을 만드는 헛기침을 힘주어 삼키기·물 마시기 등 대체 행동으로 바꾸는 행동 수정이 핵심이다. ※RSI/RFS 절단점은 원저 기준이며 교재별 표기가 다를 수 있음.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음성 피로를 호소하는 성악 전공 대학생에게 성대기능훈련(Vocal Function Exercises, VFE)을 적용하려 한다.\",\"q\":\"VFE의 구성과 시행 원리로 옳은 것은?\",\"choices\":[\"워밍업–스트레칭–수축–내전력 강화를 각 2회씩 하루 2번 부드럽게 한다\",\"워밍업 단계에서는 최고 음도에서 짧고 강하게 스타카토로 여러 번 반복 산출한다\",\"하루 1회, 4단계를 각 1번씩만 실시하며 힘들면 즉시 중단한다\",\"내전력 강화 단계에서는 최대 강도로 고함쳐 성대 접촉과 내전력을 강화한다\",\"스트레칭과 수축 단계는 큰 소리의 스타카토 발성으로 구성된다\"],\"answer\":1,\"explain\":\"Stemple의 VFE는 후두 근육의 균형·지구력을 회복시키는 생리적 접근으로, 워밍업(모음 연장)–스트레칭(상행 활음)–수축(하행 활음)–내전력 강화(음계별 모음 연장)의 4단계를 각 2회씩 하루 2번, 가능한 한 부드럽고 노력 없는 발성으로 수행한다. 연장 시간은 폐활량 기반 목표치를 향해 점진적으로 늘린다. 고함·스타카토·최대 강도 발성은 성대 충격을 높여 VFE의 원리에 반한다. ※사용 모음·기준 음도·목표 산출식 등 세부 프로토콜은 교재별 차이가 있을 수 있음.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"성대결절 치료 후에도 잔여 음성 피로를 호소하는 초등교사에게 치료사가 다음과 같이 지도하였다.\\n\\\"코와 입술 주변 앞쪽에서 울림과 진동을 느끼면서, 성대는 살짝 닿을 듯 말 듯한 상태로 가장 쉽고 편하게 큰 소리를 내 보세요.\\\"\",\"q\":\"이 기법과 그 원리로 옳은 것은?\",\"choices\":[\"악센트 기법 – 복식호흡 리듬의 강세 발성으로 호흡-발성 협응을 높인다\",\"신뢰음성 – 기식적이고 작은 소리로 말해 성대 접촉을 최소화한다\",\"공명음성치료 – 최소한의 성대 충격으로 최대의 음향 출력을 얻는다\",\"밀기 접근법 – 팔을 밀며 발성하여 성대 내전과 성문폐쇄를 강화한다\",\"챈트 말하기 – 음절 강세를 없앤 단조로운 연속 발성으로 후두 긴장을 낮춘다\"],\"answer\":3,\"explain\":\"전방(안면 마스크) 진동감과 '살짝 닿을 듯 말 듯한(barely adducted/abducted)' 성대 자세를 강조하며 쉽고 강한 소리를 찾게 하는 것은 공명음성치료(Lessac-Madsen Resonant Voice Therapy)의 기본 훈련 제스처이다. 성대 충격 응력을 최소화하면서도 충분한 출력을 얻게 하여 직업적 음성 사용자에게 적합하다. 악센트 기법은 리듬·강세와 복식호흡이 핵심이고, 신뢰음성은 수술 직후 등 일시적 보호 목적의 저강도 기식 발성이며 큰 소리를 요구하지 않는다. 밀기 접근법은 성문폐쇄부전에 쓰는 내전 강화 기법이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"42세 남성 영업직 환자가 성대폴립 후두미세수술을 받았다. 수술 후 음성 관리를 담당하게 되었다.\",\"q\":\"수술 후 음성 관리 프로토콜로 가장 적절한 것은?\",\"choices\":[\"수술 직후부터 큰 소리로 발성하여 성대 유착과 반흔을 예방한다\",\"점막이 완전히 재생되도록 3개월간 절대 음성휴식을 유지한다\",\"회복기 3개월 동안 모든 대화는 속삭임으로만 하게 한다\",\"짧은 절대 음성휴식 후 신뢰음성·SOVT로 사용을 늘려 간다\",\"수술로 원인이 제거되었으므로 별도의 음성치료는 필요하지 않다\"],\"answer\":4,\"explain\":\"수술 직후에는 절개 부위 점막 회복을 위해 짧은 절대 음성휴식(대개 수일~1주)을 두고, 이후 신뢰음성(부드럽고 낮은 강도의 약간 기식적인 발성)·SOVT처럼 성대 충격이 적은 발성으로 점진적으로 사용량을 늘리며 음성위생·수분 섭취·역류 관리를 병행한다. 장기간 절대 휴식은 근위축·발성 회피를 초래하고, 속삭이기는 후두 긴장을 높이며, 큰 소리 발성은 치유 중인 점막에 출혈·반흔을 유발한다. 폴립의 배경에는 음성 남용 습관이 있으므로 수술 후 발성 재교육이 없으면 재발 위험이 높다. ※절대 음성휴식 기간은 술식·교재에 따라 차이가 있음.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 55세 남성 영업직, 잦은 헛기침, 강하게 시작하는 말 습관, 만성 소화불량\\n• 6개월 전 전신마취 수술 시 기관내삽관\\n• 후두내시경: 좌측 성대돌기(vocal process) 부위의 육아종성 병변\\n• 3개월 전 병변 절제술을 받았으나 재발함\",\"q\":\"이 사례의 원인 판단과 중재로 가장 적절한 것은?\",\"choices\":[\"접촉성 육아종으로 보고 역류 관리와 저충격 발성 훈련을 한다\",\"재발했으므로 즉시 더 넓은 범위로 재절제하고 조직검사를 한다\",\"원인은 음성 남용뿐이므로 3주간 음성휴식만 처방한다\",\"재발성 후두유두종으로 보고 항바이러스 치료를 의뢰한다\",\"성대 막성부 병변이므로 성대결절로 보고 SOVT를 실시한다\"],\"answer\":1,\"explain\":\"성대돌기(피열연골 부위)의 접촉성 육아종은 삽관 손상, 인후두역류, 강한 성대 접촉(헛기침·거친 성대 시작)이 복합적으로 작용하여 생기며, 원인을 그대로 둔 채 절제하면 재발률이 매우 높아 재절제는 최후 수단으로 둔다. 따라서 역류 치료, 헛기침·강한 시작을 대체하는 행동 수정, 쉬운 시작·하품-한숨 등 성대 충격을 줄이는 발성 훈련이 일차 치료이고, 난치성이면 보툴리눔 독소로 내전력을 낮추는 방법을 고려한다. 병변 위치가 막성부가 아닌 연골부이므로 결절과 다르며, 유두종은 사마귀 모양의 다발성 병변이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 15세 여자 육상선수, 격렬한 달리기 중 갑자기 흡기 시 협착음과 목이 조이는 느낌, 몇 분 쉬면 소실\\n• 흡입 기관지확장제 효과 없음, 폐기능검사 정상\\n• 운동 유발 후 후두내시경: 흡기 시 성대 앞 2/3가 내전되고 후방에 다이아몬드 모양의 작은 틈만 남음\",\"q\":\"이 사례의 진단과 중재로 가장 적절한 것은?\",\"choices\":[\"운동 유발 천식 – 흡입 스테로이드와 기관지확장제를 증량한다\",\"역설적 성대운동 – 이완 후두 호흡법 훈련을 실시한다\",\"양측 성대마비 – 기관절개술 또는 성문확장술을 의뢰한다\",\"내전형 연축성발성장애 – 갑상피열근 보툴리눔 독소를 주입한다\",\"후두연화증 – 성문상부성형술을 이비인후과에 의뢰한다\"],\"answer\":2,\"explain\":\"흡기 시 성대가 역설적으로 내전되며 후방에 다이아몬드형 틈이 남는 것은 역설적 성대운동(PVFM, 성대기능이상)의 특징적 소견이며, 기관지확장제 무반응과 정상 폐기능은 천식과 감별된다. 삽화가 간헐적이고 휴식 시 소실되므로 마비가 아니며, 기도 문제이지 발성 시 연축이 아니므로 연축성발성장애도 아니다. 중재의 핵심은 발작 시 후두를 여는 이완 후두 호흡법(rescue breathing: 코로 짧게 흡기, 오므린 입술로 호기, 복식호흡)과 유발 상황 인식·자가 관리 훈련이며, 필요 시 역류·불안 관리를 병행한다. 언어재활사가 주도적으로 담당하는 영역이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 49세 남성 교사, 심한 후두염 후 목소리가 낮고 거칠어졌으며 발성 시 목에 힘이 많이 들어감\\n• 후두내시경: 진성대는 구조적으로 정상이나, 발성 시 양측 가성대가 서로 접근·진동하며 진성대를 가림\",\"q\":\"이 소견에 대한 중재로 가장 적절한 것은?\",\"choices\":[\"습관화된 가성대 발성을 강화하여 안정된 음성으로 만든다\",\"첫 단계로 양측 가성대에 보툴리눔 독소를 소량 주입한다\",\"밀기 접근법으로 진성대와 가성대의 내전을 한층 더 강화한다\",\"진성대 노출을 위해 성문상부 절제술을 의뢰한다\",\"흡기 발성·하품-한숨 등으로 진성대 발성을 재확립한다\"],\"answer\":5,\"explain\":\"진성대가 정상인데 가성대가 접근·진동하는 것은 후두염 시 보상으로 시작된 가성대 발성(성대 대치 발성)이 습관화된 기능적 과기능 장애이다. 흡기 발성은 흡기 중에는 가성대가 진동하기 어려워 진성대 발성을 유도하는 대표적 촉진 기법이며, 음도 상승과 하품-한숨·후두마사지로 성문상부 압축을 풀어 진성대 발성을 재확립한다. 진성대가 정상이므로 가성대 발성을 강화하거나 침습적 처치를 먼저 할 이유가 없고, 밀기 접근법은 과기능을 더 악화시킨다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"중증 쉰 목소리 환자의 후두 스트로보스코피에서 기본주파수 추적이 되지 않아 화면이 흔들리고 점막파동을 판독할 수 없었다.\",\"q\":\"이 상황의 해석과 대안으로 옳은 것은?\",\"choices\":[\"방법상의 한계로 보고 고속 후두촬영 등으로 보완한다\",\"점막파동이 관찰되지 않았으므로 성대 반흔으로 확진한다\",\"마이크 위치 문제이므로 위치만 조정하여 재검하면 된다\",\"강도를 최대한 높여 발성하게 하면 정상적으로 판독할 수 있다\",\"전기성문파형검사로 대체하여 점막파동을 직접 관찰한다\"],\"answer\":1,\"explain\":\"스트로보스코피는 F0에 동기화된 섬광으로 여러 주기의 조각을 합성해 '느린 움직임'처럼 보이게 하는 착시 기법이므로, 신호가 준주기적이어야 한다. 심한 비주기성(Titze의 3형 신호)에서는 동기화 실패로 판독이 불가능하며, 이는 반흔의 증거가 아니라 방법의 한계이다. 고속 후두촬영은 초당 수천 프레임으로 실제 주기를 촬영하므로 비주기 음성에도 적용된다. EGG는 성대 접촉 면적 변화를 간접 측정할 뿐 점막파동을 시각화하지 못한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"중증 기식성 음성 환자의 음향분석에서 파형이 비주기적이어서 jitter·shimmer 값이 산출되지 않거나 극단적인 값으로 나왔다.\",\"q\":\"이 환자의 음성 중증도를 객관적으로 정량화하기 위해 가장 적절한 음향 지표는?\",\"choices\":[\"켑스트럼 피크 현저도(CPPS)를 사용한다\",\"기본주파수 표준편차를 중증도 지표로 사용한다\",\"소음대배음비(NHR)만을 중증도 지표로 사용한다\",\"jitter를 여러 번 재측정하여 평균값을 사용한다\",\"최대연장발성시간(MPT)으로 음향 지표를 대체한다\"],\"answer\":1,\"explain\":\"jitter·shimmer·NHR은 주기 경계 검출을 전제로 하므로 비주기적(3형) 신호에서는 신뢰할 수 없다. 켑스트럼 피크 현저도(CPP)는 주기 검출 없이 스펙트럼의 배음 구조가 얼마나 뚜렷한지를 정량화하므로 중증·비주기 음성에도 안정적이며, 연결발화에도 적용 가능하고 청지각적 중증도와 상관이 높아 최근 권고되는 지표이다. F0 표준편차는 음도 변동을 반영할 뿐 음질 중증도 지표가 아니며, MPT는 공기역학적 지표로 음향분석을 대체하지 못한다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 36세 여성 콜센터 상담원, 하루 7시간 통화, 목 조임·통증과 음성 피로\\n• 후두 촉진: 후두 상승, 갑상설골 간격 축소, 설골상부 근육 압통\\n• 공기역학 검사: 성문하압 12 cmH₂O(증가), 평균호기류율 80 mL/s(감소), 후두저항 증가\\n• 후두내시경: 병변 없음, 발성 시 후방 성문틈과 전후·좌우 성문상부 압축\",\"q\":\"이 사례의 진단과 중재로 가장 적절한 것은?\",\"choices\":[\"편측 성대마비 – 주입술 등 성대 내측화 수술을 의뢰한다\",\"내전형 연축성발성장애 – 보툴리눔 독소를 주입한다\",\"일차성 근긴장성 발성장애 – 도수치료와 발성 재교육을 한다\",\"심인성 실성증 – 정신건강의학과 의뢰 후 기침 발성을 유도한다\",\"라인케부종 – 금연 교육과 후두미세수술을 의뢰한다\"],\"answer\":3,\"explain\":\"구조적 병변 없이 후두 상승·갑상설골 간격 축소·촉진 압통, 높은 성문하압과 낮은 호기류(높은 후두저항), 성문상부 압축은 과도한 후두 내·외근 긴장에 의한 일차성 근긴장성 발성장애의 전형이다. 중재는 후두 도수치료(circumlaryngeal massage)·후두 하강으로 긴장을 낮춘 뒤 SOVT·공명음성 등으로 효율적 발성 패턴을 재학습시키고, 헤드셋 사용·휴식 등 업무 환경을 조정하는 것이다. 성대마비는 호기류가 증가하고 성문하압이 낮아지는 반대 양상이며, 연축성발성장애는 과제 특이적·불규칙 연축이 특징이고 촉진 소견이 정상이다. ※성문하압·호기류율 정상 범위는 교재별로 차이가 있음.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 58세 여성, 천식으로 고용량 흡입 스테로이드(플루티카손)를 6개월간 사용한 뒤 쉰 목소리 발생, 음성 남용력 없음\\n• 후두내시경: 성대 점막에 백색 반점(칸디다 의심), 성대가 약간 활모양으로 휨\",\"q\":\"언어재활사의 대응으로 가장 적절한 것은?\",\"choices\":[\"환자 스스로 흡입 스테로이드를 즉시 중단하도록 지시한다\",\"반폐쇄성도훈련으로 성대 점막의 백색 반점을 제거한다\",\"성대백반증이므로 즉시 조직검사와 레이저 절제를 의뢰한다\",\"입 헹굼·스페이서 사용을 교육하고 처방의와 협의한다\",\"활모양 성대를 교정하기 위해 밀기 접근법을 집중 실시한다\"],\"answer\":4,\"explain\":\"흡입 스테로이드는 후두 칸디다증과 스테로이드 유발 국소 근병증(성대 활모양)을 일으켜 음성 남용 없이도 애성을 유발한다. 일차 조치는 약물 관련 원인 관리(흡입 후 입 헹굼·가글과 스페이서 사용으로 후두 침착 감소, 처방의와 용량·제형 조정 및 항진균 치료 협의, 수분 섭취)이며, 이는 의학적 처치이므로 언어재활사는 교육·협의 역할을 한다. 원인 교정 후에도 음성 문제가 남으면 음성치료를 계획한다. 천식 약을 환자 임의로 중단하게 하는 것은 위험하고, 병변은 감염성이므로 음성 훈련으로 제거되지 않으며, 백반증으로 단정해 조직검사·절제부터 할 상황도 아니다. 근병증에 의한 활모양은 약물 조정 후 회복되는 경우가 많아 밀기 접근법 집중 훈련은 우선순위가 아니다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 27세 여성 뮤지컬 배우, 공연 중 갑자기 목소리가 끊겼고 다음 날 심한 애성\\n• 월경 중이며 두통으로 아스피린을 복용함\\n• 후두내시경: 우측 성대 전체가 붉게 물든 출혈 소견\",\"q\":\"가장 적절한 즉각적 조치는?\",\"choices\":[\"반폐쇄성도훈련을 즉시 시작하여 혈종의 빠른 흡수를 유도한다\",\"절대 음성휴식과 아스피린 중단 후 점진적으로 복귀시킨다\",\"밀기 접근법으로 성대 내전을 강화하여 공연에 복귀시킨다\",\"온찜질과 함께 큰 소리 발성 연습으로 혈액 흡수를 촉진한다\",\"즉시 후두미세수술로 출혈 부위와 혈종을 제거한다\"],\"answer\":2,\"explain\":\"성대출혈은 음성 외상에 월경기 혈관 취약성과 아스피린(항혈소판 효과)이 겹쳐 발생하기 쉬운 응급 상황으로, 계속 발성하면 반흔·혈관종으로 진행해 영구적 음질 손상을 남길 수 있다. 급성기에는 절대 음성휴식(대개 1~2주)으로 발성을 완전히 중단해 혈액이 흡수되도록 하고 아스피린·NSAID를 중단하며 항응고 위험 요인을 평가하고, 후두과 추적 후 점진적으로 복귀하며 재발 예방(월경 주기·약물·과다 사용) 교육을 한다. 수술은 급성 출혈의 치료가 아니라 재발성 출혈의 원인이 되는 정맥류에 대해 고려한다. SOVT·밀기·큰 소리 발성은 모두 출혈 부위에 기계적 부하를 주어 금기이다.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 68세 여성, 3~4년에 걸쳐 서서히 심해진 목소리 떨림, 노래와 말에서 모두 나타남, 손 떨림 동반\\n• 연장모음 /아/에서 4~6 Hz의 규칙적인 음도·강도 변조\\n• 모음 시작 낱말·무성자음 등 특정 음소 환경과 무관하게 지속되며, 속삭일 때도 떨림이 관찰됨\\n• 후두내시경: 발성 시 후두·인두·연구개가 함께 율동적으로 떨림, 구조적 병변 없음\",\"q\":\"이 사례의 감별과 관리로 가장 적절한 것은?\",\"choices\":[\"내전형 연축성발성장애 – 갑상피열근 보툴리눔 독소를 주입한다\",\"본태성 음성진전 – 신경과 의뢰와 보상적 음성치료를 병행한다\",\"파킨슨병 – LSVT LOUD로 음성 강도를 높인다\",\"근긴장성 발성장애 – 후두마사지와 SOVT를 실시한다\",\"심인성 음성장애 – 정신건강의학과 의뢰 후 상담을 병행한다\"],\"answer\":2,\"explain\":\"특정 음소 환경과 무관하게 규칙적(4~6 Hz)으로 나타나는 음도·강도 변조, 속삭임에서도 지속, 손 떨림 동반, 후두 외 구조(인두·연구개)의 율동적 떨림은 본태성 음성진전의 특징이다. 연축성발성장애는 과제 특이적·불규칙적 끊김이 핵심이고 속삭임에서 감소한다. 진전은 여러 구조가 관여하므로 보툴리눔 독소 효과가 부분적이며, 신경과 의뢰로 약물치료(프로프라놀롤 등)를 검토하고 짧은 구·문장 사용, 음도·강도 조절 등 보상적 음성치료로 지각되는 떨림을 줄인다. 파킨슨병은 단조롭고 약한 음성이 특징이며 안정 시 진전을 보인다. ※음성진전 주파수 범위(4~7 Hz 등)는 교재별 표기가 다를 수 있음.\"},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 6세 남아, 뇌간 종양 수술 후 커프형 기관절개관을 6개월째 유지\\n• 각성 상태 양호, 분비물 적음, 자발 호흡 안정\\n• 아동과 부모 모두 말하기를 강하게 원하며, 의료진과 함께 말하기 밸브(일방향 밸브) 적용을 검토 중\",\"q\":\"말하기 밸브 적용의 필수 조건과 절차로 옳은 것은?\",\"choices\":[\"커프를 팽창시킨 상태로 밸브를 부착하여 기도를 보호한다\",\"상기도가 완전히 폐쇄되어 있어도 밸브 사용이 가능하다\",\"처음부터 수면 중을 포함해 하루 종일 착용시켜 적응하게 한다\",\"커프 완전 감압과 상기도 통기 확인 후 짧은 시간부터 착용한다\",\"분비물이 많을수록 밸브가 분비물 배출을 돕기 때문에 유리하다\"],\"answer\":4,\"explain\":\"일방향 말하기 밸브는 흡기는 관을 통해, 호기는 관 주위를 거쳐 상기도(성대)로 내보내 발성을 가능하게 한다. 따라서 커프를 완전히 감압해야 하고, 관 주위와 상기도가 충분히 열려 있어야 하며(막힘이 있으면 공기가 갇혀 질식 위험), 관을 막고 호기·발성이 가능한지와 산소포화도·호흡 안정을 확인한 뒤 짧은 시간부터 점진적으로 착용한다. 커프 팽창 상태나 상기도 폐쇄에서 밸브를 쓰면 호기가 나가지 못해 매우 위험하고, 과다한 분비물은 밸브 막힘·흡인 위험을 높여 금기에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"단어 '참새'에 포함된 자음(ㅊ, ㅁ, ㅅ)의 조음방법을 순서대로 옳게 나열한 것은?\",\"choices\":[\"파열음 – 비음 – 마찰음\",\"마찰음 – 비음 – 파찰음\",\"파찰음 – 유음 – 마찰음\",\"파찰음 – 비음 – 마찰음\",\"파찰음 – 비음 – 파열음\"],\"answer\":4,\"explain\":\"/ㅊ/은 경구개 파찰음, 종성 /ㅁ/은 양순 비음, /ㅅ/은 치조 마찰음이다. /ㅊ/을 파열음이나 마찰음으로, /ㅁ/을 유음으로, /ㅅ/을 파열음·파찰음으로 분류한 나머지 보기는 모두 틀리다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 자음의 변별자질에 관한 설명으로 옳은 것은?\",\"choices\":[\"비음 /ㅁ, ㄴ, ㅇ/은 [-공명성] 자질을 갖는다\",\"치조음과 경구개음은 [+설정성] 자질을 공유한다\",\"연구개음 /ㄱ, ㄲ, ㅋ/은 [+전방성] 자질을 갖는다\",\"파찰음 /ㅈ, ㅉ, ㅊ/은 [+지속성] 자질을 갖는다\",\"마찰음 /ㅅ, ㅆ/은 [-지속성] 자질을 갖는다\"],\"answer\":2,\"explain\":\"[설정성(coronal)]은 혀끝·혓날이 올라가 조음되는 치조음·경구개음이 공유하는 자질이다. 비음은 공명음이므로 [+공명성], 파찰음은 폐쇄 구간이 있어 [-지속성], 마찰음은 기류가 지속되므로 [+지속성], 연구개음은 치조 뒤에서 조음되므로 [-전방성]이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 종성(받침) 자음에 관한 설명으로 옳은 것은?\",\"choices\":[\"종성에서는 /ㄱ, ㄴ, ㄷ, ㄹ, ㅁ, ㅂ, ㅇ/만 발음된다\",\"종성 /ㄹ/은 초성과 같이 탄설음 [ɾ]으로 실현된다\",\"종성 파열음은 파열 단계까지 개방되어 산출된다\",\"종성 위치에서 파찰음 /ㅈ/은 파찰음 그대로 실현된다\",\"발음상 종성에서는 두 개의 자음이 연이어 모두 실현될 수 있다\"],\"answer\":1,\"explain\":\"한국어는 음절 말에서 7개 자음(7종성)만 실현된다(예: '꽃'→[꼳], '부엌'→[부억]). 종성 파열음은 불파음(미파음)으로 산출되고, 종성 /ㄹ/은 설측음 [l]로 실현되며, 겹받침은 자음군 단순화로 하나만 발음된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"우리말 /ㄹ/의 변이음 실현이 옳게 연결된 것은?\",\"choices\":[\"'라면'의 /ㄹ/ – 설측음 [l]\",\"'노래'의 /ㄹ/ – 설측음 [l]\",\"'달'의 /ㄹ/ – 설측음 [l]\",\"'빨래'의 첫 번째 /ㄹ/ – 탄설음 [ɾ]\",\"'달'의 /ㄹ/ – 탄설음 [ɾ]\"],\"answer\":3,\"explain\":\"/ㄹ/은 초성(어두, 모음 사이)에서 탄설음 [ɾ], 종성에서 설측음 [l]로 실현된다. '빨래'처럼 /ㄹ/이 연이어 나오면 [ll]로 둘 다 설측음이다. 따라서 '달'의 종성 /ㄹ/ – 설측음 연결만 옳다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"'고기'의 표준 발음에 대한 음성 전사로 옳은 것은?\",\"choices\":[\"[koki]\",\"[gogi]\",\"[kʰogi]\",\"[kogi]\",\"[k*ogi]\"],\"answer\":4,\"explain\":\"평음 /ㄱ/은 어두에서 무성 파열음 [k]로, 유성음(모음) 사이에서는 유성음화되어 [g]로 실현된다. 어두를 [g]로 전사하거나 어중을 [k]로 전사한 것, 격음 [kʰ]·경음 [k*]으로 전사한 것은 모두 틀리다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 자음의 일반적인 습득 순서에 관한 설명으로 옳은 것은?\",\"choices\":[\"치조 마찰음 /ㅅ, ㅆ/은 가장 이른 시기에 습득된다\",\"유음 /ㄹ/은 양순 파열음보다 먼저 습득된다\",\"모든 종성 자음은 초성 자음보다 늦게 습득된다\",\"치조 마찰음은 만 3세 이전에 완전 습득된다\",\"비음과 파열음은 파찰음·마찰음보다 먼저 습득된다\"],\"answer\":5,\"explain\":\"우리말 자음은 대체로 비음·파열음 → 파찰음 → 유음·마찰음 순으로 습득되며, /ㅅ, ㅆ/과 /ㄹ/이 가장 늦게 완성된다. 종성 비음(/ㅁ, ㅇ/)은 비교적 이른 시기에 습득되므로 모든 종성이 초성보다 늦다는 설명은 틀리다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 음운인식 과제 중 일반적으로 가장 늦게 발달하는 것은?\",\"choices\":[\"'토마토'를 듣고 손뼉을 치며 음절 수 세기\",\"'밤'에서 /ㅁ/을 빼고 말하기\",\"'바나나'에서 '바'를 빼고 말하기\",\"/ㄱ/, /ㅗ/, /ㅁ/을 합쳐 '곰' 말하기\",\"'사'와 '자'를 합쳐 '사자' 말하기\"],\"answer\":2,\"explain\":\"음운인식은 큰 단위(음절)에서 작은 단위(음소)로 발달하며, 같은 음소 수준에서도 합성보다 탈락·대치 과제가 더 어렵다. 따라서 음소 탈락('밤'에서 /ㅁ/ 빼기)이 가장 늦게 발달한다. 음절 수 세기·음절 합성·음절 탈락은 음절 수준, 음소 합성은 음소 수준이지만 탈락보다 쉽다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말소리 습득 연령 기준에 관한 설명으로 옳은 것은?\",\"choices\":[\"출현연령은 해당 연령 아동의 95% 이상이 정조음한 연령이다\",\"출현연령은 네 단계 중 완전습득연령보다 늦게 나타난다\",\"관습적 습득연령은 해당 연령 아동의 75~94%가 정조음한 연령이다\",\"숙달연령은 해당 연령 아동의 25~49%가 정조음한 연령이다\",\"완전습득연령은 해당 연령 아동의 95~100%가 정조음한 연령이다\"],\"answer\":5,\"explain\":\"우리말 자음 습득 연구(김영태)에서 출현연령은 25~49%, 관습적 습득연령은 50~74%, 숙달연령은 75~94%, 완전습득연령은 95~100%의 아동이 정조음한 연령으로 정의된다. 출현연령이 가장 이르고 완전습득연령이 가장 늦다. ①은 완전습득 기준, ③은 숙달연령 기준, ④는 출현연령 기준을 잘못 연결한 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"아동의 말소리 오류를 '성인 형태를 단순화하는 자연스러운 과정(음운변동)'으로 보고, 발달과 함께 이 과정이 억제되면서 성인 음운체계에 도달한다고 설명한 이론은?\",\"choices\":[\"행동주의 학습이론\",\"생성음운론\",\"자연음운론\",\"최적성이론\",\"운율음운론\"],\"answer\":3,\"explain\":\"자연음운론(Stampe)은 아동이 타고난 자연적 음운변동(단순화 과정)을 성장하면서 억제·제한하여 성인 체계에 이른다고 본다. 생성음운론은 변별자질과 규칙 체계, 최적성이론은 제약의 서열, 행동주의는 강화 학습으로 말소리 발달을 설명한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 중 왜곡(distortion) 오류에 해당하는 것은?\",\"choices\":[\"'사'의 /ㅅ/을 혀 옆으로 공기가 새는 소리로 산출함\",\"'고래'의 /ㄹ/을 산출하지 않고 [고애]로 말함\",\"'오리'의 어두에 /ㅁ/을 덧붙여 [모리]로 말함\",\"'사탕'의 /ㅅ/을 /ㅌ/으로 바꾸어 [타탕]으로 말함\",\"'밥'의 종성 /ㅂ/을 빼고 [바]로 말함\"],\"answer\":1,\"explain\":\"왜곡은 목표음이 우리말 음소 목록에 없는 비표준 소리로 산출되는 오류로, 공기가 혀 옆으로 새는 /ㅅ/의 설측음화가 대표적이다. ④ [타탕]은 다른 음소로 바뀐 대치, ② [고애]·⑤ [바]는 생략, ③ [모리]는 첨가 오류이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"가방 → [다방]\\n코 → [토]\\n공 → [동]\",\"q\":\"이 아동이 보이는 음운오류패턴은?\",\"choices\":[\"파열음화\",\"치조음 후방화\",\"연구개음 전방화\",\"양순음화\",\"탈기식음화\"],\"answer\":3,\"explain\":\"연구개음 /ㄱ, ㅋ/이 조음위치가 앞쪽인 치조음 /ㄷ, ㅌ/으로 바뀌었으므로 연구개음 전방화이다. 조음방법(파열음)과 발성유형(평음·격음)은 유지되어 파열음화나 탈기식음화가 아니며, 뒤쪽으로 이동한 후방화도 아니다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 4세 아동의 오류 중 일반적인 음운발달 과정에서 잘 나타나지 않는 비발달적 오류패턴에 해당하여 우선 중재가 필요한 것은?\",\"choices\":[\"나비 → [아비]\",\"딸기 → [딸디]\",\"라면 → [야면]\",\"사자 → [다자]\",\"책 → [채]\"],\"answer\":1,\"explain\":\"어두 초성 생략(나비→[아비])은 정상 발달에서 거의 나타나지 않는 비발달적 패턴이다. 연구개음 전방화([딸디]), 유음의 활음화([야면]), 마찰음의 파열음화([다자]), 종성생략([채])은 어린 아동에게 흔히 관찰되는 발달적 패턴이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"사과 → [가과]\\n두부 → [부부]\",\"q\":\"두 오류에 공통적으로 해당하는 오류패턴은?\",\"choices\":[\"순행동화\",\"전방화\",\"음절 반복\",\"후방화\",\"역행동화\"],\"answer\":5,\"explain\":\"두 예 모두 앞 자음이 뒤에 오는 자음(/ㄱ/, /ㅂ/)의 영향을 받아 같은 소리로 바뀌었으므로 뒤 소리가 앞 소리에 영향을 준 역행동화이다. 순행동화는 앞 소리가 뒤 소리를 바꾸는 경우이며, 전방화·후방화는 문맥과 무관하게 조음위치가 이동하는 대치 패턴이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"사과 → [자과]\\n새 → [재]\\n수박 → [주박]\",\"q\":\"이 아동이 보이는 오류패턴은?\",\"choices\":[\"마찰음의 파열음화\",\"파찰음의 마찰음화\",\"구개음화\",\"마찰음의 파찰음화\",\"경음화\"],\"answer\":4,\"explain\":\"치조 마찰음 /ㅅ/이 파찰음 /ㅈ/으로 바뀌었으므로 마찰음의 파찰음화이다. 파열음화는 /ㄷ/ 등 파열음으로 바뀌는 것이고, 파찰음의 마찰음화는 반대 방향(/ㅈ/→/ㅅ/)이며, 경음화는 발성유형 변화이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"자극반응도(stimulability)에 관한 설명으로 옳은 것은?\",\"choices\":[\"독립음 수준에서만 평가하며 단어·문장 수준은 평가하지 않는다\",\"자발화에서 목표 음소가 오조음되는 빈도를 백분율로 나타낸 것이다\",\"자극반응도가 높은 음소는 자연 회복 가능성이 낮아 우선 치료한다\",\"모델이나 단서를 주었을 때 오조음을 정조음할 수 있는 정도이다\",\"말명료도와 같은 개념으로, 청자가 알아듣는 정도를 뜻한다\"],\"answer\":4,\"explain\":\"자극반응도는 청각·시각·촉각 단서나 모델을 주었을 때 오조음을 정조음으로 산출할 수 있는 능력으로, 독립음·음절·단어 수준에서 평가한다. 자극반응도가 높은 음소는 예후가 좋고 자연 회복 가능성이 높다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"토끼 신발 → [토띠 신발]\",\"q\":\"이 발화의 자음정확도(PCC)는?\",\"choices\":[\"5/6×100(%)\",\"4/6×100(%)\",\"4/7×100(%)\",\"5/7×100(%)\",\"5/8×100(%)\"],\"answer\":1,\"explain\":\"목표 자음은 '토끼'의 /ㅌ, ㄲ/, '신발'의 /ㅅ, ㄴ, ㅂ, ㄹ/로 총 6개이다. 이 중 /ㄲ/→[ㄸ] 1개만 오류이므로 5/6×100이다. 초성 'ㅇ'(음가 없음)이나 모음은 자음 수에 포함하지 않는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"모자 → [모다]\\n김 → [김]\",\"q\":\"두 단어의 평균음운길이(PMLU)는?\",\"choices\":[\"8/2\",\"9/2\",\"11/2\",\"10/2\",\"12/2\"],\"answer\":4,\"explain\":\"PMLU는 아동 산출의 분절음마다 1점, 정조음한 자음마다 1점을 추가한다. [모다]는 분절음 4개 + 정조음 자음 /ㅁ/ 1개 = 5점(/ㅈ/→[ㄷ]는 추가점 없음), [김]은 분절음 3개 + 정조음 자음 2개 = 5점이다. 합계 10점을 단어 수 2로 나누어 10/2이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말명료도(speech intelligibility)에 관한 설명으로 옳은 것은?\",\"choices\":[\"자음정확도가 같은 아동은 말명료도도 같게 나타난다\",\"말용인도(acceptability)와 같은 개념이다\",\"청자가 화자의 말을 알아듣는 정도로, 평정척도 등으로 측정한다\",\"왜곡 오류가 생략 오류보다 말명료도를 더 크게 떨어뜨린다\",\"청자의 친숙도는 말명료도 평가 결과에 영향을 미치지 않는다\"],\"answer\":3,\"explain\":\"말명료도는 청자가 화자의 메시지를 알아듣는 정도로 등간척도 평정이나 알아들은 단어 비율(단어 확인 과제)로 측정한다. 오류 유형·일관성·문맥·청자 친숙도 등 여러 요인이 영향을 미치므로 자음정확도와 항상 일치하지 않으며, 생략이 왜곡보다 명료도를 더 떨어뜨린다. 말용인도는 말이 자연스럽고 정상적으로 들리는 정도로 다른 개념이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 중 말명료도를 가장 크게 저하시킬 것으로 예상되는 오류는?\",\"choices\":[\"/ㅅ/의 일관된 치간음화 왜곡\",\"어말 종성 /ㄹ/의 가벼운 왜곡\",\"여러 위치에서 나타나는 초성 생략\",\"/ㅈ/ 한 음소의 일관된 파열음화\",\"어말 종성 /ㅇ/의 약화\"],\"answer\":3,\"explain\":\"오류 유형 중 생략이 명료도에 가장 큰 영향을 주고 대치, 왜곡 순이며, 여러 음소·위치에 걸친 오류일수록 명료도가 더 낮아진다. 단일 음소의 왜곡이나 한 음소의 일관된 대치는 비교적 명료도 저하가 적다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"• 37개 단어 이름대기와 연결발화 검사로 구성\\n• 자음정확도와 음운오류패턴 분석 결과를 제공\",\"q\":\"해당하는 검사는?\",\"choices\":[\"아동용 발음평가(APAC)\",\"우리말 조음음운검사2(U-TAP2)\",\"한국어 표준 그림 조음음운검사(KS-PAPT)\",\"한국어 읽기 검사(KOLRA)\",\"취학전 언어발달척도(PRES)\"],\"answer\":1,\"explain\":\"APAC은 37개 단어 검사와 연결발화 검사로 자음정확도와 오류패턴을 분석하는 검사이다. U-TAP2는 단어·문장 수준 검사로 구성되며, KS-PAPT는 선별·정밀검사로 나뉜다. KOLRA는 읽기, PRES는 언어발달 검사이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"독립분석(independent analysis)에 관한 설명으로 옳은 것은?\",\"choices\":[\"성인 목표형과 비교하여 대치·생략·왜곡 오류를 분류한다\",\"성인 목표형과 비교 없이 아동의 음소 목록과 음절구조를 기술한다\",\"자음정확도(PCC)를 산출하여 심각도를 판정하는 분석이다\",\"학령기 잔존오류 아동의 왜곡 분석에 가장 적합하다\",\"음운오류패턴별 출현율을 계산하여 치료 목표를 정한다\"],\"answer\":2,\"explain\":\"독립분석은 아동의 산출 자체를 하나의 체계로 보고 자음·모음 목록과 음절구조 목록을 기술하며, 어리거나 명료도가 매우 낮은 아동에게 유용하다. 성인 목표형과 비교하는 오류 분류, 자음정확도, 오류패턴 출현율은 관계분석에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"자음정확도(PCC)가 48%인 아동의 말소리장애 심각도(Shriberg & Kwiatkowski 기준)는?\",\"choices\":[\"중도(severe)\",\"경도-중등도(mild-moderate)\",\"중등도-중도(moderate-severe)\",\"경도(mild)\",\"정상 범위\"],\"answer\":1,\"explain\":\"PCC 심각도 기준은 85% 초과 경도, 65~85% 경도-중등도, 50~65% 중등도-중도, 50% 미만 중도이다. 48%는 50% 미만이므로 중도에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 아동\\n• 같은 단어를 여러 번 산출할 때 40% 이상 다르게 산출함\\n• 구강운동 기능은 정상이고 모색행동이 없음\\n• 운율은 자연스러움\",\"q\":\"Dodd의 분류에 따른 이 아동의 말소리장애 유형은?\",\"choices\":[\"음운지연\",\"비일관적 음운장애\",\"일관적 음운장애\",\"아동기 말실행증\",\"조음장애\"],\"answer\":2,\"explain\":\"같은 단어를 반복 산출할 때 40% 이상 변이를 보이면서 구강운동·운율 문제가 없으면 비일관적 음운장애이다. 아동기 말실행증도 비일관성을 보이지만 모색행동, 동시조음 전이 어려움, 운율 이상을 동반한다. 음운지연은 발달적 패턴이 늦게까지 남는 것, 일관적 음운장애는 비발달적 패턴을 일관되게 보이는 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"아동기 말실행증(CAS)의 핵심 특징으로 옳게 묶인 것은?\",\"choices\":[\"발달적 오류패턴, 양호한 말명료도, 정확한 모음 산출\",\"과다비성, 말 근육의 근력 약화, 느린 말속도\",\"일관된 대치, 높은 자극반응도, 정상적인 운율\",\"한 음소의 일관된 왜곡, 청력 손실, 구조적 이상\",\"비일관적 오류, 동시조음 전이 어려움, 부적절한 운율\"],\"answer\":5,\"explain\":\"CAS는 말운동 계획·프로그래밍의 문제로 자음·모음의 비일관적 오류, 음소·음절 간 전이의 연장과 단절, 부적절한 강세·운율이 핵심 특징이다. 근력 약화와 과다비성은 마비말장애, 일관된 발달적 대치는 음운지연의 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"구개열 아동의 말 특성에 관한 설명으로 옳은 것은?\",\"choices\":[\"비음 /ㅁ, ㄴ, ㅇ/이 구강 자음보다 더 큰 영향을 받는다\",\"고압력 자음이 약하게 산출되고 비누출이 동반될 수 있다\",\"보상조음은 조음위치가 구강 앞쪽으로 전방화된 것이다\",\"모음이 자음보다 더 큰 영향을 받아 명료도가 낮아진다\",\"비강 공명이 부족한 과소비성이 주된 공명 문제이다\"],\"answer\":2,\"explain\":\"연인두 폐쇄부전이 있으면 구강 내 압력을 형성해야 하는 고압력 자음(파열·마찰·파찰음)이 약해지고 비누출과 과다비성이 나타난다. 비음은 원래 비강 공명을 이용하므로 영향이 적고, 보상조음(성문파열음·인두마찰음 등)은 조음위치가 뒤쪽(후방)으로 이동한 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"선천성 심도 감각신경성 난청 아동의 말 특성으로 옳은 것은?\",\"choices\":[\"저주파수 비음 /ㅁ, ㄴ/이 마찰음보다 먼저 손상된다\",\"모음은 손상되지 않고 자음에서만 오류가 나타난다\",\"운율과 음도는 건청 아동과 같이 정상적으로 유지된다\",\"말속도가 빠르고 말명료도가 대체로 양호하다\",\"고주파수 마찰음의 생략·왜곡, 모음 중립화가 나타난다\"],\"answer\":5,\"explain\":\"청각 피드백 결여로 고주파수 에너지가 큰 마찰음이 생략·왜곡되고, 모음이 중앙화(중립화)되며, 종성 생략과 음도·운율 이상, 과다비성이 나타나 명료도가 낮다. 저주파수 비음은 비교적 잘 산출된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"음운장애보다 조음장애(운동적 말소리장애)에 더 부합하는 특징은?\",\"choices\":[\"여러 음소에 걸쳐 일관되게 나타나는 대치 패턴\",\"종성생략이 많아 나타나는 낮은 말명료도\",\"음운인식 결함과 읽기·쓰기 어려움을 동반함\",\"/ㅅ/의 일관된 설측음화 외 다른 음소는 정확함\",\"여러 음소가 하나의 음소로 대치되는 음소 붕괴 현상\"],\"answer\":4,\"explain\":\"조음장애는 말소리 산출의 운동적 문제로 소수 음소의 일관된 왜곡이 특징이며 명료도 저하가 적다. 여러 음소에 걸친 대치 패턴, 종성생략, 음소 붕괴, 음운인식 결함은 음운 체계(언어적) 문제인 음운장애의 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"전통적 조음치료법(Van Riper)의 단계 순서로 옳은 것은?\",\"choices\":[\"단어 훈련 → 독립음 확립 → 감각-지각 훈련 → 유지 → 전이\",\"감각-지각 훈련 → 독립음 확립 → 안정화 → 전이 → 유지\",\"독립음 확립 → 감각-지각 훈련 → 전이 → 문장 안정화 → 유지\",\"전이 → 감각-지각 훈련 → 독립음 확립 → 안정화 → 유지\",\"감각-지각 훈련 → 문장 훈련 → 독립음 확립 → 유지 → 전이\"],\"answer\":2,\"explain\":\"전통적 접근법은 목표음을 듣고 변별하는 감각-지각(청지각) 훈련으로 시작하여 독립음에서 목표음을 확립한 뒤, 음절·단어·구·문장·대화로 점차 확장(안정화)하고 치료실 밖으로 전이시킨 후 유지 단계를 거친다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"짝자극 기법(paired-stimuli approach)에 관한 설명으로 옳은 것은?\",\"choices\":[\"핵심단어는 목표음을 10회 중 3회 이하로 정조음하는 단어이다\",\"정조음하는 핵심단어와 오조음하는 훈련단어를 짝지어 연습한다\",\"최소대립쌍을 이용하여 단어 간 의미 대조를 가르친다\",\"독립음 수준에서 목표음을 확립하며 훈련을 시작한다\",\"청각적 자극(auditory bombardment)이 핵심이다\"],\"answer\":2,\"explain\":\"짝자극 기법은 아동이 목표음을 안정적으로 정조음하는 핵심단어(10회 중 9회 이상 정조음)를 오조음하는 훈련단어와 번갈아 산출하게 하여 정조음을 전이시키는 단어 수준의 기법이다. 최소대립쌍은 음운론적 접근, 청각적 자극은 주기법의 절차이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 아동이 /ㅅ, ㅈ, ㄱ, ㅋ/을 모두 /ㄷ/으로 대치함\\n(예: 사과 → [다과], 자 → [다], 공 → [동], 코 → [도])\",\"q\":\"이 아동에게 가장 적합한 대조 접근법은?\",\"choices\":[\"최소대립쌍 접근법\",\"최대대립 접근법\",\"짝자극 기법\",\"다중대립 접근법\",\"핵심어휘 접근법\"],\"answer\":4,\"explain\":\"여러 음소가 하나의 음소로 붕괴(phoneme collapse)된 경우, 대치음 /ㄷ/과 여러 목표음을 동시에 대조하는 다중대립 접근법이 적합하다. 최소대립쌍은 한 자질 차이의 두 음소, 최대대립은 자질 차이가 큰 두 음소를 대조하고, 핵심어휘 접근법은 비일관적 음운장애에 사용한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"주기법(cycles approach)에 관한 설명으로 옳은 것은?\",\"choices\":[\"잔존오류를 보이는 학령기 아동이 주된 치료 대상이다\",\"말소리 자질에 대한 상위언어적 인식 지도가 치료의 1단계이다\",\"한 패턴을 완전히 숙달한 뒤에 다음 패턴으로 넘어간다\",\"독립음 수준의 반복적인 산출 훈련이 중심이 된다\",\"숙달 여부와 관계없이 정해진 기간 후 다음 패턴으로 순환한다\"],\"answer\":5,\"explain\":\"주기법(Hodson & Paden)은 말명료도가 매우 낮은 아동을 대상으로 오류패턴별 목표음을 일정 시간 훈련한 뒤 숙달 기준 없이 다음 패턴으로 순환하고, 회기마다 청각적 자극(auditory bombardment)을 제공한다. 숙달 후 진행은 수직적 접근, 상위언어적 인식 지도는 상위음운 접근법이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"상위음운 접근법(Metaphon)의 1단계에서 실시하는 활동으로 적절한 것은?\",\"choices\":[\"최대대립쌍 단어를 반복 산출하며 산출 정확도를 높인다\",\"구강 근육 강화 운동으로 조음기관을 준비시킨다\",\"'긴 소리/짧은 소리' 같은 대조 개념을 인식하게 한다\",\"대화 수준에서 의사소통 수정 전략을 반복 연습한다\",\"비단어 따라말하기로 음운 작업기억을 훈련한다\"],\"answer\":3,\"explain\":\"상위음운 접근법 1단계는 개념 수준(긴/짧은, 앞/뒤 등 비언어적 속성)에서 시작해 소리·음소·단어 수준으로 말소리 자질의 대조를 인식시키는 단계이고, 2단계에서 의사소통 상황에서 이를 활용해 산출을 수정하게 한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"핵심어휘 접근법(core vocabulary approach)에 관한 설명으로 옳은 것은?\",\"choices\":[\"최소대립쌍의 의미 대조를 이용해 음운 체계를 재구조화한다\",\"잔존오류 아동을 대상으로 /ㅅ/ 등의 왜곡음을 교정한다\",\"하나의 음소를 독립음 수준에서 먼저 확립하고 확장한다\",\"말실행증 아동의 운율과 강세 개선을 1차 목표로 삼는다\",\"비일관적 음운장애 아동에게 기능적 단어를 일관되게 산출시킨다\"],\"answer\":5,\"explain\":\"핵심어휘 접근법(Dodd)은 비일관적 음운장애 아동에게 자주 쓰는 기능적 단어를 선정하여 완전한 정조음이 아니더라도 아동이 할 수 있는 최선의 산출을 일관되게 하도록 훈련한다. 의미 대조를 이용한 재구조화는 최소대립쌍 등 음운론적 대조 접근법이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"치료 결과, 어두 초성에서만 훈련한 /ㅅ/를 훈련하지 않은 어중 초성('가수', '버섯')에서도 정조음하게 되었다.\",\"q\":\"이에 해당하는 일반화 유형은?\",\"choices\":[\"위치 일반화\",\"언어단위 일반화\",\"상황 일반화\",\"음소 간 일반화\",\"문맥 일반화\"],\"answer\":1,\"explain\":\"단어 내 훈련하지 않은 위치(어두→어중·어말)로 정조음이 확대되는 것은 위치 일반화이다. 문맥 일반화는 인접 모음 등 음성 문맥, 언어단위 일반화는 음절→단어→문장, 상황 일반화는 치료실 밖 장소·대화상대, 음소 간 일반화는 훈련하지 않은 다른 음소로의 확대를 말한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"치료사가 한 회기 안에서 /ㅅ/, /ㄹ/, 종성 /ㄱ/ 세 가지 목표를 각각 15분씩 나누어 동시에 훈련하고 있다.\",\"q\":\"이 치료사가 사용한 목표 접근 전략은?\",\"choices\":[\"수직적 접근법\",\"주기적 접근법\",\"수평적 접근법\",\"절충적 접근법\",\"위계적 접근법\"],\"answer\":3,\"explain\":\"여러 목표음을 한 회기에서 동시에 다루는 것은 수평적 접근법이다. 수직적 접근법은 한두 개 목표를 준거에 도달할 때까지 집중 훈련한 뒤 다음으로 넘어가고, 주기적 접근법은 일정 기간 단위로 목표를 순환한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 행동을 핵심행동과 부수행동(탈출행동·회피행동)으로 분류하려 한다.\",\"q\":\"행동과 분류가 옳게 연결된 것은?\",\"choices\":[\"말하는 도중 입술이 붙은 채 소리가 막힘 – 탈출행동\",\"막힌 순간 눈을 세게 깜박임 – 핵심행동\",\"첫소리를 길게 늘여 말함(소리 연장) – 회피행동\",\"어려운 낱말을 다른 낱말로 바꿔 말하기 – 회피행동\",\"고개를 갑자기 젖히며 막힘에서 벗어나기 – 핵심행동\"],\"answer\":4,\"explain\":\"핵심행동은 반복·연장·막힘 등 말더듬 자체이고, 부수행동은 이에 대한 반응으로 학습된 행동이다. 낱말 대치(바꿔 말하기)는 말더듬을 예상하고 미리 피하는 회피행동이다. 막힘과 연장은 핵심행동이며, 눈 깜박임·고개 젖히기처럼 이미 시작된 말더듬에서 빠져나오려는 행동은 탈출행동(부수행동)이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"아동의 비유창성을 진성 비유창성(SLD)과 기타 비유창성(OD)으로 나누어 분석하려 한다.\",\"q\":\"비유창성 유형과 분류가 옳게 연결된 것은?\",\"choices\":[\"\\\"나 나 나 갈래\\\"(1음절 낱말 반복) – 기타 비유창성\",\"\\\"나는 나는 갈래\\\"(구 반복) – 기타 비유창성\",\"\\\"음, 어\\\"(간투사) – 진성 비유창성\",\"\\\"나는, 아니 우리는 갈래\\\"(수정) – 진성 비유창성\",\"\\\"ㅅ---사탕\\\"(소리 연장) – 기타 비유창성\"],\"answer\":2,\"explain\":\"진성 비유창성(SLD)은 낱말부분(음소·음절) 반복, 1음절 낱말 반복, 연장·막힘 등 비운율적 발성으로, 말더듬 아동에게 특징적이다. 기타 비유창성(OD)은 간투사, 수정, 미완성, 구·다음절 낱말 전체 반복 등 일반 아동에게도 흔한 비유창성이다. 따라서 구 반복을 기타 비유창성으로 연결한 ②만 옳다. 1음절 낱말 반복(①)과 소리 연장(⑤)은 진성 비유창성이고, 간투사(③)와 수정(④)은 기타 비유창성이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 발생·발달을 설명하는 이론에 대한 설명으로 옳은 것은?\",\"choices\":[\"진단착오이론 – 양쪽 대뇌반구의 우세 경쟁으로 말운동 협응이 실패하여 말더듬이 생긴다\",\"요구-용량 모델 – 환경적 요구가 아동의 말 산출 용량을 초과하면 비유창성이 생긴다\",\"대뇌반구 우세이론 – 부모가 정상적 비유창성을 말더듬으로 낙인찍어 말더듬이 생긴다\",\"예기투쟁가설 – 말더듬은 유전적 요인으로 생기는 말운동 조절 장애로, 학습의 영향은 적다\",\"내적수정가설 – 말더듬은 청자의 부정적 반응에 의해 강화되어 유지되는 조작적 행동이다\"],\"answer\":2,\"explain\":\"요구-용량 모델(Starkweather)은 말속도·언어 복잡성·시간 압박 등 요구가 아동의 말운동·언어·정서·인지 용량을 넘어설 때 비유창성이 발생한다고 본다. 진단착오이론은 부모의 낙인, 대뇌반구 우세이론은 양반구 우세 경쟁, 예기투쟁가설은 말더듬을 예상하고 피하려는 투쟁 반응, 내적수정가설은 음운 계획 오류를 내적으로 감지·수정하는 과정에서 비유창성이 생긴다는 설명이므로 보기의 연결은 모두 잘못되었다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"Guitar의 말더듬 발달 단계 중 '경계선급 말더듬'에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"반복 단위 수가 많으나 긴장·부수행동이 거의 없고 인식도 없다\",\"말더듬을 예상한 낱말 회피와 말하기 상황 회피가 나타나기 시작한다\",\"말더듬에 대한 두려움과 부정적 자아개념이 확고하게 자리 잡혀 있다\",\"막힘과 함께 눈 깜박임 등 탈출행동이 뚜렷하게 나타난다\",\"비유창성 대부분이 간투사·수정이며 그 빈도도 낮은 편이다\"],\"answer\":1,\"explain\":\"경계선급 말더듬은 정상적 비유창성보다 비유창성 빈도가 높고(대략 100낱말당 10회 이상) 반복 단위 수가 2회 이상으로 많으나, 긴장·막힘·탈출행동은 거의 없고 아동이 자신의 말을 의식하지 않는 단계이다. 막힘과 탈출행동은 초기 말더듬, 회피와 두려움은 중간급, 부정적 자아개념의 확립은 심화된 말더듬의 특징이며 간투사·수정 위주의 낮은 빈도는 정상적 비유창성에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 52세 남성, 뇌경색 후 말더듬이 시작됨\\n• 아동기 말더듬 병력 없음\\n• 조사·어미 등 기능어와 내용어를 가리지 않고 반복이 나타남\\n• 같은 문장을 반복해서 읽어도 말더듬이 줄지 않음\\n• 부수행동과 말에 대한 불안이 거의 없음\",\"q\":\"이 대상자에게 가장 적절한 유창성장애 유형은?\",\"choices\":[\"발달성 말더듬\",\"속화(말빠름증)\",\"심인성 말더듬\",\"신경학적 말더듬\",\"경계선급 말더듬\"],\"answer\":4,\"explain\":\"성인기 뇌손상 이후 시작되고, 기능어·내용어 구분 없이 낱말 위치와 무관하게 비유창성이 나타나며, 적응효과가 없고 부수행동과 불안이 적은 것은 신경학적 말더듬의 특징이다. 발달성 말더듬은 아동기에 시작되고 적응효과와 부수행동을 보이며, 심인성 말더듬은 심리적 외상·스트레스 사건 이후 시작되고 뇌손상이 없다. 속화는 빠르고 불규칙한 말속도와 명료도 저하가 핵심이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"속화(cluttering)에 대한 설명으로 옳은 것은?\",\"choices\":[\"자신의 말 문제를 잘 인식하며 말하기 불안과 회피가 높다\",\"소리·음절 반복과 막힘, 탈출행동이 핵심행동으로 나타난다\",\"말에 주의를 기울여 천천히 말할수록 명료도가 더 나빠진다\",\"언어·화용 및 주의집중 문제는 대체로 동반되지 않는다\",\"빠르고 불규칙한 말속도와 음절 축약·생략으로 명료도가 낮다\"],\"answer\":5,\"explain\":\"속화는 빠르거나 불규칙한 말속도, 음절·낱말의 축약과 생략, 과도한 정상적 비유창성으로 명료도가 떨어지는 유창성장애이며, 언어·화용·주의 문제를 자주 동반한다. 말더듬과 달리 자신의 문제에 대한 인식과 불안이 낮고, 주의를 기울이면 말이 오히려 좋아지는 경향이 있다. 막힘·탈출행동은 말더듬의 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말의 유창성을 구성하는 요소로 옳게 묶인 것은?\",\"choices\":[\"명료도 – 강도 – 음도 – 공명\",\"연속성 – 정확성 – 강도 – 음도\",\"정확성 – 명료도 – 억양 – 공명\",\"연속성 – 말속도 – 리듬 – 노력\",\"정확성 – 노력 – 공명 – 억양\"],\"answer\":4,\"explain\":\"유창한 말은 끊김 없이 이어지고(연속성), 적절한 속도와 리듬을 유지하며, 신체적·정신적 노력이 적게 드는 말이다. 명료도·강도·음도·공명·정확성은 조음·음성 영역의 개념으로 유창성 자체의 구성요소가 아니다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"학령전 말더듬 아동 중 자연회복 가능성이 가장 높은 경우는?\",\"choices\":[\"음운·언어 능력이 또래보다 뚜렷하게 낮은 남아이다\",\"말더듬이 성인기까지 지속된 가족력이 있는 남아이다\",\"발병 후 18개월 이상 지속되며 부수행동이 늘고 있다\",\"여아이며 발병 후 수개월 사이 비유창성이 줄고 있다\",\"5세 이후에 발병하였고 비유창성 빈도에 변화가 없다\"],\"answer\":4,\"explain\":\"자연회복과 관련된 긍정적 예후 요인은 여아, 발병 초기 수개월 이내에 비유창성이 감소하는 경향, 이른 발병, 회복된 가족력, 양호한 음운·언어 능력 등이다. 반대로 남아, 지속된 가족력, 발병 후 12개월 이상 지속, 늦은 발병, 음운 능력 저하, 부수행동 증가는 지속 위험 요인이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말을 더듬는 사람의 말더듬이 일반적으로 감소하는 조건은?\",\"choices\":[\"전화로 낯선 사람과 통화하며 용건을 전할 때\",\"노래하거나 다른 사람과 함께 소리 내어 읽을 때\",\"시간 압박이 큰 상황에서 빠르게 대답할 때\",\"이름·주소 등 바꿔 말할 수 없는 정보를 말할 때\",\"권위 있는 사람 앞에서 공식적으로 발표할 때\"],\"answer\":2,\"explain\":\"노래, 합창읽기(함께 읽기), 혼잣말, 리듬에 맞춰 말하기, 속삭이기 등은 대표적인 유창성 유도 조건이다. 전화 통화, 권위 있는 청자, 시간 압박, 대치할 수 없는 고유 정보(이름·주소) 말하기는 말더듬이 증가하는 상황이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인이 같은 지문을 5회 반복해서 읽었다. 1회에서 더듬은 낱말의 대부분을 5회에서도 같은 위치에서 더듬었다.\",\"q\":\"이 현상을 설명하는 용어는?\",\"choices\":[\"적응효과\",\"일관성 효과\",\"인접효과\",\"청자규모효과\",\"교환효과\"],\"answer\":2,\"explain\":\"반복 읽기에서 말더듬이 발생하는 낱말의 위치가 일정하게 유지되는 현상은 일관성 효과이다. 적응효과는 반복 읽기에서 말더듬 빈도가 점차 감소하는 현상, 인접효과는 이전에 더듬었던 낱말을 제거하면 그 인접 낱말에서 말더듬이 나타나는 현상, 청자규모효과는 청자 수가 많아질수록 말더듬이 증가하는 현상이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 역학적 특성에 대한 설명으로 옳은 것은?\",\"choices\":[\"출현율은 일생 동안 한 번이라도 말더듬을 경험한 사람의 비율이다\",\"성인기로 갈수록 남녀 비율이 점차 1:1에 가까워진다\",\"대부분 학령기 이후인 7세 이후에 처음 발병한다\",\"발생률이 출현율보다 높은 것은 상당수가 자연회복되기 때문이다\",\"말더듬 발생은 가족력과 뚜렷한 관련이 없다\"],\"answer\":4,\"explain\":\"발생률(일생 중 말더듬을 경험하는 비율, 약 5% 내외)이 출현율(특정 시점의 말더듬 인구 비율, 약 1%)보다 높은 이유는 학령전기에 발병한 아동의 상당수가 자연회복되기 때문이다. 출현율은 특정 시점의 비율이고, 남녀 비율은 연령이 높아질수록 남성 쪽으로 더 커지며(약 4:1), 발병은 대부분 2~5세 학령전기에 일어나고 가족력은 중요한 위험 요인이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"회피행동의 유형과 예가 옳게 연결된 것은?\",\"choices\":[\"상황회피 – 더듬을 것 같은 어려운 낱말을 쉬운 다른 낱말로 바꿔 말함\",\"대치(substitution) – 막힌 순간 눈을 깜박이며 빠져나옴\",\"에두르기(circumlocution) – 말해야 하는 상황 자체에 참여하지 않음\",\"시작기법(starter) – 더듬었던 낱말을 다시 한 번 말함\",\"연기(postponement) – 어려운 낱말 앞에서 '음…'을 넣어 시작을 미룸\"],\"answer\":5,\"explain\":\"연기는 어려운 낱말 앞에서 간투사·쉼 등으로 시간을 끌어 말더듬을 미루는 회피행동이다. 대치는 어려운 낱말을 다른 낱말로 바꾸는 것이고, 에두르기는 낱말을 피해 돌려 설명하는 것이며, 시작기법은 '그러니까' 같은 말을 앞에 붙여 발화를 시작하는 것, 상황회피는 말하는 상황 자체를 피하는 것이다. 눈 깜박임으로 빠져나오는 것은 회피가 아니라 탈출행동이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"학령기 말더듬 아동의 치료에 대한 설명으로 옳은 것은?\",\"choices\":[\"학교 환경(교사·또래) 요인은 치료 범위에 포함하지 않는다\",\"인식이 생기기 전이므로 부모 중심의 간접치료만 실시한다\",\"놀림에 대처하는 방법과 말더듬에 대한 개방적 태도를 함께 다룬다\",\"부모의 참여는 학령전기에만 필요하므로 치료에서 배제한다\",\"소리 내어 읽기 등 학급 활동에서 면제받도록 교사에게 요청한다\"],\"answer\":3,\"explain\":\"학령기 아동은 말더듬에 대한 인식과 부정적 감정, 또래의 놀림이 문제가 되는 시기이므로 유창성 기법과 함께 놀림·괴롭힘 대처, 말더듬에 대한 개방적 태도, 교사·부모와의 협력을 다룬다. 이 시기에는 직접치료가 중심이 되며, 학급 활동 면제는 회피를 강화하므로 적절하지 않다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"파라다이스-유창성 검사-II(P-FA-II)에 대한 설명으로 옳은 것은?\",\"choices\":[\"의사소통태도 평가는 취학전 아동을 포함한 모든 연령 집단에 실시한다\",\"필수과제는 연령과 관계없이 읽기와 대화 두 가지로만 구성된다\",\"취학전·초등학생·중학생 이상의 연령 집단별로 과제가 구성되어 있다\",\"결과는 %SS로만 산출하며 백분위 점수는 제공하지 않는다\",\"구어 평가에서 핵심행동만 평가하고 부수행동은 평가하지 않는다\"],\"answer\":3,\"explain\":\"P-FA-II는 취학전 아동, 초등학생, 중학생 이상의 세 연령 집단에 맞춘 필수과제와 선택과제로 구성되며, 구어 평가(핵심행동)와 부수행동, 의사소통태도를 평가하고 백분위 점수로 중증도를 해석한다. 의사소통태도 평가는 초등학생 이상에게 실시하며, 필수과제는 연령별로 낱말그림·따라말하기·문장그림·읽기·이야기그림·말하기그림 등 여러 과제로 구성된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대화 발화 표본 분석\\n• 전체 음절 수: 250음절\\n• 말더듬이 나타난 음절 수: 15음절\",\"q\":\"이 대상자의 말더듬 음절 백분율(%SS)은?\",\"choices\":[\"4 %SS\",\"5 %SS\",\"15 %SS\",\"7.5 %SS\",\"6 %SS\"],\"answer\":5,\"explain\":\"%SS = (말더듬 음절 수 ÷ 전체 음절 수) × 100 = 15 ÷ 250 × 100 = 6 %SS이다. 말더듬 음절 백분율은 발화 표본의 전체 음절 수를 분모로 하며, 말더듬 순간의 횟수를 그대로 백분율로 쓰지 않는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬 정도 측정 검사(SSI-4)에서 '지속시간' 점수를 산출하는 방법은?\",\"choices\":[\"가장 긴 말더듬 순간 3개의 평균 지속시간을 구한다\",\"가장 짧은 말더듬 순간의 지속시간을 사용한다\",\"전체 발화 시간에서 말더듬 시간이 차지하는 비율을 구한다\",\"모든 말더듬 순간의 지속시간을 평균한다\",\"모든 말더듬 순간의 지속시간을 합산한다\"],\"answer\":1,\"explain\":\"SSI-4의 지속시간 점수는 발화 표본에서 가장 긴 말더듬 순간 3개의 평균 지속시간을 측정하여 척도 점수로 변환한다. SSI-4의 총점은 빈도(%SS), 지속시간, 신체적 부수행동 점수의 합으로 산출된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인이 말더듬에 대해 느끼는 정서·행동적 반응, 일상 의사소통의 어려움, 삶의 질에 미치는 영향을 자기보고식으로 평가하려 한다.\",\"q\":\"가장 적절한 도구는?\",\"choices\":[\"말더듬 전반적 경험 평가(OASES)\",\"P-FA-II 필수과제\",\"말더듬 음절 백분율(%SS) 산출\",\"말더듬 정도 측정 검사(SSI-4)\",\"한국 아동 말더듬 검사(KOCS)\"],\"answer\":1,\"explain\":\"OASES는 말더듬에 대한 일반 정보, 정서·행동·인지적 반응, 일상 의사소통, 삶의 질의 네 영역을 자기보고로 평가하여 말더듬이 화자의 삶에 미치는 영향을 파악하는 도구이다. SSI-4와 %SS는 외현적 말더듬 행동의 중증도·빈도를 측정하고, KOCS는 아동용 검사이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"아동 발화: \\\"책책책상 위에 있어요.\\\"\",\"q\":\"'책책책상'에서 나타난 낱말부분 반복의 단위반복수는?\",\"choices\":[\"2\",\"1\",\"3\",\"4\",\"5\"],\"answer\":1,\"explain\":\"단위반복수는 목표 낱말이 산출되기 전에 반복된 단위의 횟수이다. '책책책상'은 목표 낱말 '책상'의 첫 음절 '책'이 두 번 더 반복된 것이므로 단위반복수는 2이다. 산출된 음절 '책'의 총 개수(3)와 혼동하지 않아야 한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말속도 측정에 대한 설명으로 옳은 것은?\",\"choices\":[\"전체 말속도는 발화 중 쉼 시간을 제외하고 산출한다\",\"조음속도는 쉼과 비유창성 시간을 제외하고 산출한다\",\"말속도는 분당 낱말 수(WPM)로만 측정할 수 있다\",\"조음속도는 일반적으로 전체 말속도보다 느리게 산출된다\",\"말더듬에 소요된 시간은 조음속도 산출에 포함한다\"],\"answer\":2,\"explain\":\"조음속도는 쉼·주저·말더듬 등 비유창성 시간을 제외한 순수 조음 시간을 기준으로 산출하므로 전체 말속도보다 같거나 빠르게 나온다. 전체 말속도는 쉼을 포함한 전체 발화 시간으로 산출하며, 말속도는 초당 음절 수, 분당 음절 수, 분당 낱말 수 등 여러 단위로 측정할 수 있다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"Yairi와 Ambrose의 기준에 따라 학령전 아동을 말더듬으로 판단하는 진성 비유창성(SLD) 빈도는?\",\"choices\":[\"100음절당 3회 이상\",\"100음절당 2회 이상\",\"100음절당 1회 이상\",\"100음절당 5회 이상\",\"100음절당 10회 이상\"],\"answer\":1,\"explain\":\"Yairi와 Ambrose는 100음절당 진성 비유창성(낱말부분 반복, 1음절 낱말 반복, 비운율적 발성)이 3회 이상이면 말더듬으로 간주하는 기준을 제시하였다. 진성 비유창성이 3회 미만이고 간투사·수정 등 기타 비유창성 위주이면 정상적 비유창성으로 본다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"유창성완성법과 말더듬수정법을 비교한 설명으로 옳은 것은?\",\"choices\":[\"유창성완성법은 조절 유창성과 수용 말더듬을 최종 치료 목표로 한다\",\"말더듬수정법은 느린 말속도·부드러운 발성 등 새 말하기 방식을 모든 발화에 적용한다\",\"말더듬수정법은 더 쉽게 더듬도록 말더듬 순간을 수정하고 두려움·회피를 줄인다\",\"두 접근 모두 부수행동과 말더듬에 대한 정서·태도는 다루지 않는다\",\"유창성완성법은 말더듬에 대한 감정·태도 변화를 가장 우선적인 목표로 한다\"],\"answer\":3,\"explain\":\"말더듬수정법(Van Riper)은 말더듬 순간을 확인·둔감·수정하여 더 쉽고 편하게 더듬게 하며, 말더듬에 대한 두려움과 회피를 줄이는 데 초점을 둔다(목표: 조절 유창성·수용 말더듬). 유창성완성법은 느린 말속도, 부드러운 발성 등 새로운 말하기 방식을 학습하여 유창한 말을 산출하는 것을 목표로 하며 감정·태도는 부차적으로 다룬다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"Van Riper 말더듬수정법의 치료 단계를 순서대로 옳게 나열한 것은?\",\"choices\":[\"둔감 → 확인 → 변형 → 수정 → 안정\",\"확인 → 변형 → 둔감 → 수정 → 안정\",\"확인 → 둔감 → 수정 → 변형 → 안정\",\"변형 → 확인 → 둔감 → 수정 → 안정\",\"확인 → 둔감 → 변형 → 수정 → 안정\"],\"answer\":5,\"explain\":\"말더듬수정법은 자신의 말더듬 행동을 인식하는 확인(동일시) 단계, 말더듬과 청자 반응에 대한 두려움을 줄이는 둔감 단계, 말더듬 형태를 의도적으로 바꾸어 통제 가능성을 경험하는 변형 단계, 취소·빠져나오기·준비하기로 더 쉽게 더듬는 수정(접근) 단계, 이를 일상에 유지·일반화하는 안정 단계 순으로 진행된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대상자가 낱말 도중 막힘이 나타나자 멈추거나 되돌아가지 않고, 막힌 상태에서 조음기관의 긴장을 서서히 풀면서 소리를 부드럽게 늘여 그 낱말을 끝까지 산출하였다.\",\"q\":\"이 장면에서 사용된 말더듬수정법의 기법은?\",\"choices\":[\"준비하기(preparatory set)\",\"취소(cancellation)\",\"빠져나오기(pull-out)\",\"가벼운 조음접촉(light contact)\",\"지연청각피드백(DAF)\"],\"answer\":3,\"explain\":\"빠져나오기는 말더듬이 진행되는 도중에 멈추지 않고 긴장을 풀며 부드럽게 낱말을 완성하는 기법이다. 취소는 더듬은 낱말을 끝낸 뒤 잠시 멈추고 다시 편안하게 말하는 것이고, 준비하기는 더듬을 것이 예상되는 낱말 앞에서 미리 부드럽게 접근하는 것이다. 가벼운 조음접촉과 지연청각피드백은 말더듬수정법의 단계별 기법이 아니다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"리드콤 프로그램(Lidcombe Program)에 대한 설명으로 옳은 것은?\",\"choices\":[\"치료사가 아동에게 느린 말속도와 부드러운 발성을 직접 훈련한다\",\"아동의 말더듬에 대해서는 어떤 언급도 하지 않는 것이 원칙이다\",\"부모의 말속도와 가정 환경을 조정하는 간접치료 방식의 프로그램이다\",\"학령기 이상 아동과 성인에게 주로 적합한 프로그램이다\",\"부모가 아동의 유창한 말에 구어 수반 자극을 제공하는 직접치료이다\"],\"answer\":5,\"explain\":\"리드콤 프로그램은 학령전 말더듬 아동을 대상으로, 훈련받은 부모가 가정의 일상 대화에서 아동의 유창한 말에 칭찬을, 더듬은 말에는 가끔 부드러운 지적을 제공하는 행동주의(조작적 조건화)에 기초한 직접치료이며 부모가 매일 말더듬 중증도를 평정한다. 새로운 말하기 방식을 가르치거나 환경만 조정하는 접근이 아니다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 3세 2개월 아동, 3개월 전부터 말더듬 시작\\n• 긴장이 없는 낱말부분 반복이 주로 관찰됨\\n• 아동은 자신의 말을 의식하지 않음\\n• 부모가 빠른 말속도로 질문을 많이 함\",\"q\":\"이 아동에게 우선적으로 적용할 접근으로 가장 적절한 것은?\",\"choices\":[\"말더듬에 대한 둔감화 훈련을 아동에게 직접 실시한다\",\"아동에게 취소·빠져나오기 기법을 직접 훈련한다\",\"부모 교육으로 부모의 말속도를 늦추고 질문을 줄이게 한다\",\"말할 때 지연청각피드백 기기를 사용하게 한다\",\"아동에게 말더듬을 의도적으로 흉내 내게 하여 인식을 높인다\"],\"answer\":3,\"explain\":\"발병 초기이고 긴장·인식이 없는 학령전 아동에게는 요구-용량 모델에 근거하여 부모의 말속도, 질문 빈도, 대화 차례 주고받기 등 환경적 요구를 줄이는 간접치료(부모 교육)를 우선 적용한다. 취소·빠져나오기·둔감화는 말더듬을 인식하고 있는 학령기 이상 대상자의 말더듬수정법 기법이며, 아동에게 말더듬을 의식시키는 활동은 이 단계에서 적절하지 않다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동은 성인과의 상호작용 속에서 혼자서는 할 수 없지만 도움을 받으면 할 수 있는 수준의 과제를 수행하며 언어를 습득한다. 성인은 아동의 수준에 맞추어 지원(비계)을 제공하고 점차 줄여 나간다.\",\"q\":\"이 설명에 해당하는 언어습득 이론은?\",\"choices\":[\"행동주의 학습 이론\",\"생득주의 언어 이론\",\"인지적 구성주의 이론\",\"연결주의 이론\",\"사회적 상호작용주의 이론\"],\"answer\":5,\"explain\":\"근접발달영역과 비계(scaffolding)는 비고츠키의 사회적 상호작용주의의 핵심 개념으로, 성인과의 상호작용이 언어 습득의 주된 동력이라고 본다. 행동주의는 모방·강화, 생득주의는 타고난 언어습득장치(LAD), 인지적 구성주의(피아제)는 인지 발달이 언어에 선행한다고 보며, 연결주의는 입력의 통계적 규칙성 학습으로 설명한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"반복적(음절성) 옹알이 단계에 관한 설명으로 옳은 것은?\",\"choices\":[\"문장과 유사한 억양 패턴을 지닌 자곤(jargon)이 주로 나타난다\",\"목 뒤쪽에서 나는 '구구' 소리가 특징이며 생후 2~3개월경 나타난다\",\"'바바바'처럼 동일한 자음-모음 음절을 반복하며 6~9개월경 나타난다\",\"관습적 의미를 지닌 첫 낱말이 이 시기에 처음 산출되기 시작한다\",\"서로 다른 자음과 모음이 섞인 '바다구'와 같은 다양한 음절 연쇄가 주를 이룬다\"],\"answer\":3,\"explain\":\"반복적(canonical) 옹알이는 동일 CV 음절을 반복하는 것으로 대략 6~9개월경 출현한다. ②는 쿠잉(2~3개월), ①은 자곤(10개월 이후), ④는 첫 낱말기(12개월 전후), ⑤는 다양한 음절이 섞이는 변형적(variegated) 옹알이에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"12개월 아동\\n• 원하는 장난감을 향해 손을 뻗으며 '어어' 소리를 내고 엄마 얼굴을 번갈아 쳐다본다.\\n• 아직 관습적인 낱말은 산출하지 않는다.\",\"q\":\"베이츠(Bates)의 의사소통 의도 발달 단계 중 이 아동이 속한 단계는?\",\"choices\":[\"언향적(perlocutionary) 단계\",\"언표적(locutionary) 단계\",\"언표내적(illocutionary) 단계\",\"자곤 단계\",\"낱말조합 단계\"],\"answer\":3,\"explain\":\"몸짓·발성·시선 교대로 의도를 관습적으로 표현하지만 아직 낱말을 사용하지 않는 시기는 언표내적 단계(약 8~12개월)이다. 언향적 단계는 아동에게 의도가 없고 성인이 해석해 주는 시기이며, 언표적 단계는 낱말로 의도를 표현하는 시기이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"엄마와 아동이 창가에 있다.\\n아동: (창밖의 새를 가리키며 엄마 얼굴을 쳐다본다) 어! 어!\\n엄마: 응, 새가 있네.\",\"q\":\"아동이 보인 의사소통 기능은?\",\"choices\":[\"사물 요구하기\",\"행동 요구하기\",\"거부하기\",\"인사하기\",\"서술하기\"],\"answer\":5,\"explain\":\"아동이 대상을 가리키며 성인의 시선을 끌어 관심을 공유하려는 행동은 원시서술(protodeclarative)로, 서술·주의끌기 기능에 해당한다. 사물을 얻거나 행동을 시키기 위한 가리키기는 원시명령(protoimperative)에 해당하는 요구하기 기능이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"두 낱말 발화의 의미관계 분석으로 옳은 것은?\",\"choices\":[\"\\\"엄마 가방\\\": 행위자-대상\",\"\\\"공 커\\\": 대상-행위\",\"\\\"또 줘\\\": 재현-행위\",\"\\\"안 먹어\\\": 부정-대상\",\"\\\"여기 앉아\\\": 대상-행위\"],\"answer\":3,\"explain\":\"'또 줘'는 되풀이를 요구하는 재현(recurrence)-행위 관계이다. '엄마 가방'은 소유자-대상, '공 커'는 실체-서술(상태), '안 먹어'는 부정-행위, '여기 앉아'는 장소-행위로 분석한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동 발화 4개\\n① 엄마 물 줘\\n② 공 던져\\n③ 아빠가 왔어\\n④ 안 먹어\",\"q\":\"위 발화의 평균형태소길이(MLU-m)는? (용언의 어간과 어미는 각각 형태소로 계산한다)\",\"choices\":[\"3.75\",\"3.50\",\"3.25\",\"4.00\",\"4.25\"],\"answer\":1,\"explain\":\"①엄마/물/주-/-어(4) ②공/던지-/-어(3) ③아빠/-가/오-/-았-/-어(5) ④안/먹-/-어(3)로 총 15개 형태소이며, 15÷4=3.75이다. 조사(-가)와 선어말어미(-았-), 종결어미(-어)를 각각 세지 않으면 값이 낮게 산출된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"자발화 표본 수집과 분석에 관한 설명으로 옳은 것은?\",\"choices\":[\"'네/아니오'로 답하는 질문을 주로 사용하여 발화를 유도한다\",\"아동이 직전 발화를 그대로 반복한 발화도 모두 분석 대상에 포함한다\",\"발화 10개 정도만 수집해도 신뢰로운 분석이 가능하다\",\"알아들을 수 없는 발화도 형태소 수 계산에 포함한다\",\"놀이·대화 등 두 가지 이상의 상황에서 표본을 수집한다\"],\"answer\":5,\"explain\":\"자발화는 아동의 대표적 언어 수행을 반영해야 하므로 여러 상황·대화 상대에서 충분한 양(일반적으로 50~100발화 이상)을 수집한다. 예/아니오 질문은 발화 길이를 제한하고, 즉각 반복·모방 발화와 불명료 발화는 MLU 등 분석에서 제외하는 것이 원칙이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동: 잼 줘.\\n치료사: 응? 뭐라고?\\n아동: 딸기 잼 줘요, 빵에 발라 먹게.\",\"q\":\"치료사의 명료화 요구에 대해 아동이 사용한 대화 수정 전략은?\",\"choices\":[\"반복(repetition)\",\"첨가(addition)\",\"단서 제공(cue)\",\"수정(revision)\",\"무반응\"],\"answer\":2,\"explain\":\"원래 발화의 내용을 유지하면서 새로운 정보(딸기, 빵에 발라 먹게)를 덧붙였으므로 첨가 전략이다. 반복은 같은 발화를 그대로 되풀이하는 것, 수정은 낱말이나 문장 형태를 바꾸어 말하는 것이며, 단서 제공은 배경 정보를 설명해 청자의 이해를 돕는 전략이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"어느 날 지우는 공원에서 연을 날렸어요.\\n그런데 연줄이 끊어져 연이 나무에 걸렸어요.\\n지우는 너무 속상해서 울고 싶었어요.\\n지우는 긴 막대기로 연을 내리려고 했어요.\\n결국 연을 다시 찾았어요.\\n지우는 기분이 좋아졌어요.\",\"q\":\"세 번째 문장 '지우는 너무 속상해서 울고 싶었어요.'에 해당하는 이야기 문법(story grammar) 요소는?\",\"choices\":[\"내적 반응\",\"계기 사건\",\"배경\",\"시도\",\"결과\"],\"answer\":1,\"explain\":\"계기 사건(연이 나무에 걸림)에 대한 주인공의 감정·생각은 내적 반응이다. 첫 문장은 배경, 둘째는 계기 사건, 넷째는 시도, 다섯째는 결과, 마지막은 반응(결말)에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"이야기에 나타난 결속표지(cohesive device)의 유형이 옳게 연결된 것은?\",\"choices\":[\"\\\"비가 많이 왔어. 그래서 우산을 썼어.\\\" – 생략\",\"\\\"형이 공을 찼어. 그것은 멀리 갔어.\\\" – 지시(대용)\",\"\\\"강아지가 크게 짖었어. 그 개는 무서웠어.\\\" – 접속\",\"\\\"나는 빵을, 동생은 우유를 먹었어.\\\" – 지시(대용)\",\"\\\"먼저 손을 씻고, 그다음에 밥을 먹어.\\\" – 어휘적 결속\"],\"answer\":2,\"explain\":\"'그것'이 앞 문장의 '공'을 가리키므로 지시(대용) 결속이다. ①의 '그래서'와 ⑤의 '먼저·그다음에'는 접속, ③의 '강아지→개'는 상위어를 활용한 어휘적 결속, ④는 서술어 '먹었어'가 앞 절에서 생략된 생략 결속이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"다음 과제 중 상위언어(metalinguistic) 능력을 평가하는 것은?\",\"choices\":[\"들려준 문장을 그대로 따라 말하기\",\"그림을 보고 사물의 이름 말하기\",\"책을 책상 위에 올려놓으세요. 지시 따르기\",\"'나무'에서 '나'를 빼면 무엇이 남지?\",\"그림 속 사물의 색깔과 모양 말하기\"],\"answer\":4,\"explain\":\"상위언어 능력은 언어 자체를 사고의 대상으로 삼아 조작·판단하는 능력으로, 음절 탈락과 같은 음운인식 과제가 대표적이다. 이름대기·지시 따르기·문장 따라말하기·속성 말하기는 언어를 사용하는 과제이지 언어 자체를 분석하는 과제가 아니다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"초기 어휘 습득에 관한 개념과 예가 옳게 연결된 것은?\",\"choices\":[\"과잉확장 – '공'이라는 낱말을 자기 공에만 사용한다\",\"과소확장 – '아빠'를 길에서 본 모든 성인 남자에게 사용한다\",\"전체대상 가정 – 새 낱말을 사물의 부분이나 색깔로 해석한다\",\"상호배타성 가정 – 새 낱말을 이름을 모르는 낯선 사물에 대응시킨다\",\"빠른 연결(fast mapping) – 수십 번의 노출 후에야 낱말을 습득한다\"],\"answer\":4,\"explain\":\"상호배타성 가정은 한 사물에 하나의 이름만 있다고 여겨 새 낱말을 낯선 사물에 연결하는 것이다. ①은 과소확장, ②는 과잉확장의 예이며, 전체대상 가정은 새 낱말을 사물 전체를 지칭하는 것으로 해석하는 것이고, 빠른 연결은 한두 번의 노출로 낱말과 의미를 잠정 연결하는 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"읽기의 단순관점(Simple View of Reading)에 따를 때 난독증(dyslexia) 아동의 전형적인 프로파일은?\",\"choices\":[\"해독 정상, 듣기이해 저하\",\"해독 저하, 듣기이해 저하\",\"해독 정상, 듣기이해 정상, 읽기이해만 저하\",\"해독 저하, 듣기이해 정상\",\"해독과 듣기이해 모두 우수\"],\"answer\":4,\"explain\":\"단순관점에서 읽기이해는 해독과 언어(듣기)이해의 곱으로 설명된다. 난독증은 언어이해가 정상이면서 낱말 해독이 선택적으로 손상된 유형이다. ①은 특정 읽기이해 결함, ②는 혼합형(일반 읽기부진)에 해당하며, ③은 이 모델에서 설명되지 않는 조합이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"다음 음운인식 과제 중 일반적으로 가장 늦게 발달하는 것은?\",\"choices\":[\"낱말의 음절 수를 손뼉으로 세기\",\"'사'와 '자'를 합쳐 '사자' 만들기\",\"'나비'와 '나무'의 첫음절이 같은지 판단하기\",\"두 낱말의 끝음절이 같은지 판단하기\",\"'산'에서 /ㅅ/를 빼고 말하기\"],\"answer\":5,\"explain\":\"음운인식은 음절 수준에서 음소 수준으로 발달하며, 같은 수준 안에서는 변별·합성보다 탈락·대치 같은 조작 과제가 더 어렵다. 음소 탈락 과제는 음소 수준의 조작 과제이므로 음절 세기·음절 합성·음절 변별보다 늦게 발달한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"초등학교 2학년 아동의 받아쓰기 오류\\n• 꽃이 → 꼬치\\n• 먹어서 → 머거서\\n• 높이 → 노피\",\"q\":\"이 아동의 철자 오류 유형과 우선적으로 필요한 교수 초점은?\",\"choices\":[\"음운처리 오류 – 자소-음소 대응 지도\",\"형태처리 오류 – 형태소 원형 인식 지도\",\"표기처리 오류 – 관습적 표기 낱말 암기 지도\",\"의미처리 오류 – 낱말 뜻과 쓰임 지도\",\"시각기억 오류 – 낱말 형태 시각화 지도\"],\"answer\":2,\"explain\":\"발음은 정확히 반영했으나 어간·어미와 조사의 경계를 나누지 못하고 소리 나는 대로 썼으므로 형태소 원형을 유지하지 못한 형태처리 오류이다. 음운처리 오류는 소리 자체가 틀리는 것(꽃→꼭), 표기처리 오류는 소리로 설명되지 않는 관습 표기의 오류(며칠→몇일)이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"표준화 언어검사와 그 특성이 옳게 연결된 것은?\",\"choices\":[\"수용·표현 어휘력 검사(REVT) – 수용과 표현 어휘를 각각 평가하여 등가연령과 백분위수를 산출한다\",\"취학전 아동의 수용언어 및 표현언어 발달척도(PRES) – 초등학생의 담화와 읽기 능력을 평가한다\",\"학령기 아동 언어 검사(LSSC) – 영유아의 의사소통 발달을 선별한다\",\"한국어 읽기 검사(KOLRA) – 학령전기 아동의 어휘 능력을 평가한다\",\"맥아더-베이츠 의사소통발달 검사(K M-B CDI) – 검사자가 아동에게 직접 그림 이름대기를 실시한다\"],\"answer\":1,\"explain\":\"REVT는 그림 지적(수용)과 그림 이름대기(표현)로 어휘력을 각각 평가하여 등가연령과 백분위수를 제공한다. K M-B CDI는 부모 보고형 검사이고, PRES는 학령전기 아동 대상, LSSC와 KOLRA는 초등학생 대상 검사이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"언어검사 결과 아동의 표현 어휘 백분위수가 5로 나타났다.\",\"q\":\"이 결과의 해석으로 옳은 것은?\",\"choices\":[\"전체 검사 문항 중 5%의 문항에 정답을 맞혔음을 뜻한다\",\"규준집단에서 약 5%만이 이 아동보다 낮은 점수를 받았다\",\"또래 규준집단의 평균 점수보다 원점수가 5점 낮음을 뜻한다\",\"규준집단 평균에서 -1 표준편차에 해당하는 위치이다\",\"아동의 표현 어휘 등가연령이 5세 수준에 해당한다\"],\"answer\":2,\"explain\":\"백분위수는 규준집단에서 해당 점수 이하를 받은 사람의 비율이므로 백분위수 5는 하위 5%에 해당한다. 정답률이나 점수 차이를 의미하지 않으며, -1 표준편차는 약 백분위수 16에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"역동적 평가(dynamic assessment)에 관한 설명으로 옳은 것은?\",\"choices\":[\"규준집단과 비교하여 표준점수를 산출하는 것이 목적이다\",\"결과는 규준에 근거한 등가연령으로 보고한다\",\"부모의 보고만으로 아동의 현재 언어 능력을 추정한다\",\"한 시점의 수행만을 측정하므로 이중언어 아동에게는 부적합하다\",\"검사-교수-재검사 형식으로 아동의 학습 잠재력을 평가한다\"],\"answer\":5,\"explain\":\"역동적 평가는 중재 반응을 통해 학습 잠재력을 파악하는 방법으로, 언어 차이와 언어장애를 감별해야 하는 이중언어·다문화 아동 평가에 특히 유용하다. 규준 비교나 표준점수·등가연령 산출은 정적(표준화) 평가의 특성이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"단순언어장애(SLI) 진단 준거로 옳은 것은?\",\"choices\":[\"언어검사 -1.25 SD 이하, 비언어성 지능 85 이상\",\"양측 감각신경성 난청이 언어 지연과 함께 동반된다\",\"자폐스펙트럼장애 진단이 언어 문제와 함께 동반된다\",\"비언어성 지능지수가 70 이하로 지적장애 범위이다\",\"언어 지연을 설명할 수 있는 뇌손상 등 신경학적 손상이 확인된다\"],\"answer\":1,\"explain\":\"레너드(Leonard)의 준거에 따르면 단순언어장애는 언어검사 -1.25 SD 이하이면서 비언어성 지능 85 이상이고, 청력·구강구조·신경학적 손상·자폐 등 언어 지연을 설명할 다른 원인이 배제되어야 한다. 나머지는 모두 배제 준거에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"단순언어장애 아동의 언어 특성으로 옳은 것은?\",\"choices\":[\"비언어성 인지 저하가 언어 지연의 원인이다\",\"수용언어는 손상되지 않으며 표현언어만 손상된다\",\"화용 능력은 영향을 받지 않아 또래와 비슷하다\",\"첫 낱말 출현 시기가 또래보다 빠른 편이다\",\"조사·어미 등 문법형태소 습득이 특히 지연된다\"],\"answer\":5,\"explain\":\"단순언어장애 아동은 문법형태소 습득이 두드러지게 지연되고 낱말 찾기 어려움, 늦은 첫 낱말 등을 보인다. 수용언어도 손상될 수 있고, 언어 문제로 인한 대화·이야기 등 화용의 어려움이 동반될 수 있으며, 비언어성 인지는 정상 범위인 것이 진단의 전제이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"말 늦은 아동(late talker)의 판별 기준으로 옳은 것은?\",\"choices\":[\"18개월에 두 낱말 조합이 아직 나타나지 않는다\",\"24개월에 표현 어휘 50개 미만이거나 낱말 조합이 없다\",\"36개월에 완전한 문장을 아직 산출하지 못한다\",\"수용언어 검사 결과가 -2 SD 이하로 매우 낮게 나타난다\",\"청력 손실을 동반하여 말소리 표현이 늦다\"],\"answer\":2,\"explain\":\"말 늦은 아동은 인지·청력·신경학적 문제 없이 24개월에 표현 어휘 50개 미만 또는 두 낱말 조합이 없는 아동을 말한다. 18개월에 낱말 조합이 없는 것은 정상 범위이다. 수용언어는 대체로 정상 범위이며, 청력 손실이 있으면 말 늦은 아동으로 분류하지 않는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"5세 자폐스펙트럼장애 아동\\n• 과자가 먹고 싶을 때마다 며칠 전에 본 광고 문구인 \\\"맛있게 드세요~\\\"를 억양까지 그대로 말한다.\",\"q\":\"이 발화의 유형과 기능이 옳게 연결된 것은?\",\"choices\":[\"지연 반향어 – 요청\",\"즉각 반향어 – 대답\",\"지연 반향어 – 거부\",\"자곤 – 서술\",\"즉각 반향어 – 요청\"],\"answer\":1,\"explain\":\"이전에 들은 말을 시간이 지난 뒤 그대로 반복하는 것은 지연 반향어이며, 과자를 얻으려는 상황에서 사용하므로 요청 기능을 수행한다. 즉각 반향어는 상대의 말을 직후에 따라 하는 것이고, 자곤은 의미 없는 옹알이성 발화이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"다음 중 '공동주의 시작하기(initiating joint attention)'에 해당하는 행동은?\",\"choices\":[\"성인이 가리키는 곳을 따라 쳐다본다\",\"이름을 부르면 고개를 돌린다\",\"장난감을 들어 성인에게 보여주며 쳐다본다\",\"과자를 얻으려고 성인의 손을 잡아 끌어당긴다\",\"성인의 박수 동작을 따라 한다\"],\"answer\":3,\"explain\":\"공동주의 시작하기는 아동이 먼저 보여주기·가리키기·시선 교대로 성인의 관심을 대상에 끌어들이는 행동이다. ①은 공동주의에 반응하기, ②는 이름 반응, ④는 요구를 위한 도구적 행동, ⑤는 모방으로 공동주의 시작과 구분된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"증후군과 언어 특성이 옳게 연결된 것은?\",\"choices\":[\"윌리엄스증후군 – 어휘와 표현언어가 인지 수준에 비해 현저히 낮다\",\"윌리엄스증후군 – 언어보다 시공간 인지 능력이 상대적 강점이다\",\"취약X증후군 – 사회성이 과도하게 높아 낯선 사람에게도 친근하게 다가간다\",\"다운증후군 – 수용언어가 표현언어보다 더 심하게 손상되는 편이다\",\"다운증후군 – 표현언어와 구문이 인지 수준에 비해 더 지연된다\"],\"answer\":5,\"explain\":\"다운증후군은 수용에 비해 표현·구문이 특히 약하고 저긴장·구강구조 특성으로 말명료도가 낮다. 윌리엄스증후군은 시공간 인지가 약한 반면 어휘·표현언어와 사회성이 상대적 강점이며, 취약X증후군은 사회적 불안·시선 회피와 보속적·빠른 말이 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"청각장애 아동의 언어 특성으로 옳은 것은?\",\"choices\":[\"조사·어미 같은 기능어보다 내용어 습득이 더 어렵다\",\"문장 구조가 단순하고 문법형태소 생략이 흔하다\",\"비유·관용 표현의 이해에 별다른 어려움이 없다\",\"낱말의 다의적 의미 이해가 또래보다 우수하다\",\"말명료도는 청력 손실 정도와 관계가 거의 없다\"],\"answer\":2,\"explain\":\"청각장애 아동은 청각 입력이 제한되어 강세가 약하고 짧은 문법형태소를 놓치기 쉬워 조사·어미 생략과 단순한 문장 구조를 보인다. 내용어보다 기능어 습득이 더 어렵고, 추상어·다의어·비유 이해도 제한되며, 말명료도는 청력 손실 정도와 관련된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"이중언어 아동의 언어장애 판별에 관한 설명으로 옳은 것은?\",\"choices\":[\"한국어 표준화 검사의 규준만으로 언어장애를 판정한다\",\"제2언어인 한국어에서만 지연이 있어도 언어장애로 진단한다\",\"두 언어 모두에서 지연이 나타날 때 언어장애를 의심한다\",\"새 언어에 노출된 초기의 침묵기는 언어장애의 징후이다\",\"모국어 사용을 중단시켜야 한국어 발달이 촉진된다\"],\"answer\":3,\"explain\":\"언어장애는 특정 언어가 아니라 언어 학습 능력 자체의 문제이므로 두 언어 모두에서 지연이 나타나야 의심할 수 있다. 한 언어에서만의 지연은 언어 차이(노출 부족)일 수 있고, 침묵기는 순차적 이중언어 습득의 정상적 과정이며, 모국어 유지는 제2언어 발달에도 도움이 된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동이 블록을 쌓고 있다.\\n치료사: (아동의 행동을 보며) 블록을 높이 쌓네. 또 올리네. 와, 무너졌다.\",\"q\":\"치료사가 사용한 언어촉진 기법은?\",\"choices\":[\"혼잣말 기법(self-talk)\",\"확장(expansion) 기법\",\"확대(extension) 기법\",\"평행발화(parallel talk)\",\"개작(recast) 기법\"],\"answer\":4,\"explain\":\"치료사가 아동이 하고 있는 행동을 아동의 입장에서 말로 묘사하는 것은 평행발화이다. 혼잣말 기법은 치료사 자신의 행동을 말로 표현하는 것이며, 확장·확대·개작은 아동의 발화가 있은 뒤 이를 문법적으로 보완하거나 의미를 덧붙이거나 문장 형태를 바꾸어 되돌려 주는 기법이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"간식 시간마다 치료사가 아동에게 주스를 따라 주는 것이 반복되어 왔다.\\n오늘 치료사는 주스병을 들고 아동을 바라보며 기대하는 표정으로 약 5초간 기다렸다.\\n아동: 주스!\\n치료사: 그래, 주스 줄게.\",\"q\":\"치료사가 사용한 환경중심 언어중재 절차는?\",\"choices\":[\"시간지연(time delay)\",\"요구-모델(mand-model)\",\"아동중심 시범(child-cued modeling)\",\"우발교수(incidental teaching)\",\"스크립트 중재\"],\"answer\":1,\"explain\":\"익숙한 일과에서 성인이 도움을 주지 않고 기대하는 표정으로 기다려 아동의 자발적 의사소통을 유도하는 것은 시간지연 절차이다. 요구-모델은 '뭐 줄까?'와 같은 요구(질문)를 먼저 제시하고, 아동중심 시범은 아동의 관심사에 대해 시범을 보이며, 우발교수는 아동이 먼저 요구를 시작했을 때 이를 확장해 가르친다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"스크립트 중재의 절차로 옳은 것은?\",\"choices\":[\"친숙한 활동 순서를 먼저 확립한 뒤 계획된 위반을 도입한다\",\"첫 회기부터 예고 없이 활동 순서를 바꾸어 아동의 반응을 유도한다\",\"아동에게 낯선 활동을 선택하여 새로운 경험을 제공한다\",\"목표 언어는 스크립트의 하위 행동과 관계없이 삽입한다\",\"스크립트의 하위 행동은 하나로 제한하여 단순화한다\"],\"answer\":1,\"explain\":\"스크립트 중재는 생일잔치·마트놀이 등 친숙한 일상 활동의 순서를 먼저 익히게 하여 인지적 부담을 줄인 뒤, 각 하위 행동에 목표 언어를 배치하고 필요 시 순서를 빠뜨리거나 사물을 빼는 계획된 위반으로 발화를 유도한다. 낯선 활동이나 처음부터의 무작위 변형은 이 원리에 어긋난다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"수직적 목표 달성 전략에 관한 설명으로 옳은 것은?\",\"choices\":[\"여러 목표를 한 회기 안에서 동시에 지도한다\",\"일정 기간마다 여러 목표를 순환하며 번갈아 지도한다\",\"한 목표가 준거에 도달한 뒤 다음 목표로 넘어간다\",\"목표 도달 여부와 관계없이 매 회기 목표를 바꾼다\",\"아동이 선택한 목표만 지도한다\"],\"answer\":3,\"explain\":\"수직적 전략은 한 번에 하나의 목표를 집중 지도하여 준거에 도달한 후 다음 목표로 이동한다. ①은 수평적 전략, ②는 주기적 전략에 해당하며, ④·⑤는 목표 달성 전략에 해당하지 않는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"장기목표: 연결어미가 포함된 복문을 사용하여 사건을 표현할 수 있다.\",\"q\":\"이 장기목표에 대한 단기목표로 가장 적절하게 기술된 것은?\",\"choices\":[\"아동의 구문 능력이 전반적으로 향상된다\",\"아동은 일상 대화에서 복문을 이해하고 사용한다\",\"치료사가 그림을 보며 연결어미 '-고'를 시범 보인다\",\"그림카드 10장 중 '-고' 문장을 8회 이상 말한다\",\"아동은 연결어미를 여러 상황에서 잘 사용할 수 있다\"],\"answer\":4,\"explain\":\"단기목표는 조건(그림카드 10장), 아동의 행동(연결어미 '-고' 문장 말하기), 준거(8회 이상)가 측정 가능하게 기술되어야 한다. ①·②·⑤는 준거가 없거나 장기목표 수준의 포괄적 진술이고, ③은 아동이 아닌 치료사의 행동을 기술한 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"언어 이전기·초기 언어기 아동의 목표 어휘 선정 원칙으로 옳은 것은?\",\"choices\":[\"아동이 이미 자발적으로 산출하는 낱말을 중심으로 선정한다\",\"추상적인 개념어를 구체어보다 우선 선정한다\",\"일상에서 자주 쓰이고 즉각적인 기능을 갖는 낱말을 우선한다\",\"발음이 어려운 낱말을 우선하여 조음 연습을 겸한다\",\"아동이 관심 없는 사물의 이름을 선정하여 새로운 흥미를 유도한다\"],\"answer\":3,\"explain\":\"초기 어휘는 아동의 관심과 일상에서 자주 접하고 요구·거부 등 의사소통 기능을 바로 수행할 수 있는 기능적 낱말이어야 습득과 일반화가 빠르다. 이미 산출하는 낱말은 목표가 아니며, 추상어·발음이 어려운 낱말·관심 없는 사물은 초기 목표로 부적절하다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"보완대체의사소통(AAC) 상징체계에 관한 설명으로 옳은 것은?\",\"choices\":[\"블리스 상징은 도상성이 높아 학습이 쉽다\",\"수어는 도구적(보조) 상징체계이다\",\"도상성이 낮은 상징일수록 초기 학습이 더 쉽다\",\"실물 사진은 선화보다 도상성이 높은 상징이다\",\"스캐닝은 상징의 도상성을 높이는 기법이다\"],\"answer\":4,\"explain\":\"도상성(iconicity)은 상징이 지시 대상과 닮은 정도로, 실물 사진 > 컬러 선화 > 흑백 선화 > 블리스·문자 순으로 낮아지며 도상성이 높을수록 초기 학습이 쉽다. 수어·몸짓은 도구가 필요 없는 비도구적 상징이고, 스캐닝은 상징을 선택하는 기법이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"• 아동이 어려워하는 특정 사회적 상황(예: 줄 서기)을 짧고 구체적인 문장으로 서술한다.\\n• 그 상황에서 다른 사람이 어떻게 느끼고 무엇을 기대하는지, 아동이 할 수 있는 적절한 행동이 무엇인지를 아동의 관점에서 설명한다.\\n• 아동에게 맞게 개별화된 글이며 그림을 함께 제시하기도 한다.\",\"q\":\"이 설명에 해당하는 중재 기법은?\",\"choices\":[\"비디오 모델링\",\"사회적 상황 이야기\",\"사회적 기술 훈련 집단\",\"또래 매개 중재\",\"상호적 모방 훈련\"],\"answer\":2,\"explain\":\"사회적 상황 이야기는 자폐스펙트럼장애 아동이 사회적 상황의 단서와 타인의 관점, 기대되는 행동을 이해하도록 개별화된 짧은 이야기로 설명하는 기법이다. 비디오 모델링은 영상 속 모델을 관찰·모방하게 하는 것이고, 또래 매개 중재는 훈련된 또래가 상호작용을 이끄는 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"부모 교육 프로그램(예: 해넌 프로그램)에서 부모에게 강조하는 반응적 상호작용 전략으로 옳은 것은?\",\"choices\":[\"아동에게 질문을 많이 하여 발화를 유도한다\",\"아동의 발화 오류를 즉시 교정한다\",\"성인이 대화 주제를 정하고 이끌어 간다\",\"아동의 주도를 따르며 관찰하고 기다려 준다\",\"아동에게 더 긴 문장으로 말하도록 요구한다\"],\"answer\":4,\"explain\":\"반응적 상호작용 접근은 아동의 관심과 주도를 따르고(관찰하기-기다리기-듣기), 아동의 신호에 즉각적이고 따뜻하게 반응하며 자연스러운 시범을 제공하는 것을 핵심으로 한다. 잦은 질문·즉각 교정·성인 주도·발화 요구는 아동의 의사소통 시도를 줄이는 지시적 상호작용이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두 연골에 대한 설명으로 옳은 것은?\",\"choices\":[\"갑상연골은 좌우 한 쌍으로 이루어진 연골이다\",\"피열연골은 갑상연골의 앞쪽 내면과 관절을 이룬다\",\"윤상연골은 유일하게 완전한 고리 모양의 연골이다\",\"후두개는 유리연골로 성인기에 빠르게 골화된다\",\"설골은 후두 연골 중 가장 위에 위치한 연골이다\"],\"answer\":3,\"explain\":\"윤상연골은 뒤쪽이 넓은 반지 모양으로, 후두 연골 중 유일하게 기도를 완전히 둘러싸는 고리 형태이다. 갑상연골은 두 판이 앞에서 융합된 단일 연골이고, 피열연골은 윤상연골 위판(후방)에 얹혀 관절하며, 후두개는 탄력연골이라 골화가 잘 일어나지 않는다. 설골은 연골이 아닌 뼈로 후두를 매다는 구조이며 후두 연골에 포함되지 않는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두 내근과 그 작용이 옳게 연결된 것은?\",\"choices\":[\"윤상갑상근 – 성대 신장\",\"측윤상피열근 – 성대 외전\",\"후윤상피열근 – 성대 내전\",\"갑상피열근 – 성문 개방\",\"횡피열근 – 성대의 신장\"],\"answer\":1,\"explain\":\"윤상갑상근은 갑상연골을 앞으로 기울여 성대를 길게 늘이고 긴장시켜 음도를 높이는 근육이다. 후윤상피열근은 유일한 외전근(성문 개방), 측윤상피열근과 횡·사피열근은 내전근이며, 갑상피열근(성대근)은 성대를 짧고 두껍게 하여 긴장을 조절한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두의 신경 지배에 대한 설명으로 옳은 것은?\",\"choices\":[\"상후두신경 외지는 후윤상피열근을 지배한다\",\"왼쪽 되돌이후두신경은 오른쪽보다 주행 경로가 짧다\",\"되돌이후두신경은 윤상갑상근만 지배한다\",\"상후두신경 내지는 성문 상부의 감각을 담당한다\",\"되돌이후두신경은 설인신경(9번)의 가지이다\"],\"answer\":4,\"explain\":\"상후두신경(미주신경 가지)의 내지는 감각 신경으로 성문 상부 점막의 감각을 담당하고, 외지는 운동 신경으로 윤상갑상근을 지배한다. 되돌이후두신경은 미주신경(10번)의 가지로 윤상갑상근을 제외한 모든 후두 내근을 지배하며, 왼쪽은 대동맥궁을 돌아 올라오므로 오른쪽보다 주행이 길어 손상에 더 취약하다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"성대의 층 구조(몸체-덮개 모형)에 대한 설명으로 옳은 것은?\",\"choices\":[\"점막파동은 몸체(body)인 성대근에서 주로 발생한다\",\"갑상피열근(성대근)은 덮개(cover)에 해당한다\",\"성대인대는 상피 바로 아래 고유층 표층으로 이루어진다\",\"라인케 공간은 성대근과 맞닿은 고유층 심층에 위치한다\",\"상피와 고유층 표층은 덮개(cover)에 해당한다\"],\"answer\":5,\"explain\":\"몸체-덮개 모형에서 덮개는 상피와 느슨한 고유층 표층(라인케 공간)으로 구성되어 점막파동이 일어나는 부위이며, 몸체는 성대근(갑상피열근)이다. 성대인대는 고유층 중간층과 심층으로 이루어진 이행부이다. 라인케 공간은 고유층 표층이며, 점막파동은 덮개에서 발생한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"음성 강도를 높일 때 나타나는 생리적 변화로 옳은 것은?\",\"choices\":[\"성문하압이 감소하고 성대 긴장이 줄어든다\",\"진동 주기에서 개방기가 길어지고 폐쇄기가 짧아진다\",\"성문하압이 증가하고 성대 폐쇄기가 길어진다\",\"성대 진동의 진폭이 작아지고 폐쇄가 약해진다\",\"성대 접촉이 느슨해져 성문 통과 기류가 줄어든다\"],\"answer\":3,\"explain\":\"강도를 높이려면 성문하압을 높이고 성대를 더 단단히 접촉시켜 진동 주기 중 폐쇄기가 길어지도록 해야 한다. 이때 성대가 더 크게 열렸다 빠르게 닫히므로 진동 진폭도 커진다. 성문하압 감소, 개방기 연장, 진폭 감소는 오히려 강도를 낮추는 변화이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"45세 여성의 청지각적 평가(GRBAS) 결과\\nG2 R1 B2 A0 S0\",\"q\":\"결과 해석으로 옳은 것은?\",\"choices\":[\"전반적 중증도는 경도이다\",\"거친소리가 바람새는소리보다 더 두드러진다\",\"쥐어짜는소리가 중등도로 지각된다\",\"바람새는소리가 중등도로 지각된다\",\"무력성이 경도로 관찰된다\"],\"answer\":4,\"explain\":\"GRBAS는 각 항목을 0(정상)~3(심도)의 4점 척도로 평정한다. B2는 바람새는소리가 중등도라는 의미이며, G2이므로 전반적 중증도도 중등도이다. R1(경도)은 B2보다 덜 두드러지고, A0·S0은 무력성과 쥐어짜는소리가 관찰되지 않음을 뜻한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"CAPE-V(Consensus Auditory-Perceptual Evaluation of Voice)에 대한 설명으로 옳은 것은?\",\"choices\":[\"평가자가 각 항목을 0~3점의 4점 등간척도로 평정한다\",\"6개 항목을 100mm 시각아날로그척도로 평정한다\",\"문장이나 자발화 없이 지속 모음 과제만으로 평가한다\",\"환자가 스스로 음성 문제의 심각도를 보고하는 도구이다\",\"각 항목의 점수는 음향 분석 소프트웨어가 자동으로 산출한다\"],\"answer\":2,\"explain\":\"CAPE-V는 평가자가 지속 모음, 표준 문장, 자발화를 듣고 6개 핵심 항목(전반적 중증도, 거친소리, 바람새는소리, 쥐어짜는소리, 음도, 강도)을 100mm 시각아날로그척도(VAS)로 표시하고, 각 특성이 지속적(C)인지 간헐적(I)인지도 기록하는 청지각적 평가이다. 4점 척도는 GRBAS의 방식이고, 자기보고 도구(VHI 등)나 음향 분석과는 다르다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"6세 남아\\n• 6개월 전부터 지속되는 쉰 목소리\\n• 음성 문제가 아동의 일상생활과 학교생활에 미치는 영향을 보호자 보고로 파악하려 함\",\"q\":\"가장 적절한 도구는?\",\"choices\":[\"음성장애지수(VHI-30)\",\"소아 음성장애지수(pVHI)\",\"음성피로도 검사(VFI)\",\"음성과 관련된 삶의 질(V-RQOL)\",\"GRBAS 청지각적 평가\"],\"answer\":2,\"explain\":\"pVHI는 성인용 VHI를 아동에게 맞게 수정하여 부모(보호자)가 아동의 음성 문제가 기능·신체·정서 영역에 미치는 영향을 보고하는 도구이다. VHI-30, V-RQOL, VFI는 성인 환자 본인이 작성하는 자기보고 도구이고, GRBAS는 평가자의 청지각적 평정 척도이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"음향학적 변수에 대한 설명으로 옳게 연결된 것은?\",\"choices\":[\"주파수변동률(jitter) – 인접 주기 간 진폭의 변동\",\"진폭변동률(shimmer) – 인접 주기 간 기본주파수의 변동\",\"배음대소음비(HNR) – 값이 클수록 잡음 성분이 많음\",\"발화기본주파수(SFF) – 지속 모음에서 측정한 최고 음도\",\"기본주파수(F0) – 성대가 1초 동안 진동하는 횟수\"],\"answer\":5,\"explain\":\"기본주파수는 1초당 성대 진동 횟수(Hz)이다. jitter는 주기(주파수)의 단기 변동, shimmer는 진폭의 단기 변동으로 서로 바뀌어 있고, HNR은 값이 클수록 배음 성분이 많고 잡음이 적어 음질이 좋음을 뜻한다. 발화기본주파수는 연결발화에서의 평균 F0이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"38세 남성 교사\\n• 최근 3개월간 쉰 목소리\\n• 최대발성지속시간: /s/ 22초, /z/ 11초\",\"q\":\"s/z 비율 결과에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"s/z 비율이 2.0으로, 호흡 지지 부족이 주된 원인으로 추정된다\",\"s/z 비율이 2.0이므로 공명 문제를 우선 평가해야 한다\",\"s/z 비율이 0.5로 정상 범위이며 추가 평가는 불필요하다\",\"s/z 비율이 2.0으로 성대 병변에 의한 폐쇄부전이 의심된다\",\"/s/와 /z/ 모두 정상보다 짧아 폐활량 저하가 의심된다\"],\"answer\":4,\"explain\":\"s/z 비율은 /s/ 지속시간을 /z/ 지속시간으로 나눈 값(22/11=2.0)이다. 무성음 /s/는 정상인데 유성음 /z/만 짧다면 호흡 능력은 보존되었으나 성대 진동 시 공기가 새는 것이므로 성대 병변(결절·폴립 등)에 의한 성문 폐쇄부전을 시사한다. 일반적으로 1.4 이상이면 성대 병리를 의심한다. 호흡 지지 부족이면 /s/와 /z/가 모두 짧아진다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두스트로보스코피 검사에 대한 설명으로 옳은 것은?\",\"choices\":[\"점막파동·진폭·성문폐쇄·대칭성 등을 관찰한다\",\"기본주파수를 알 필요 없이 임의의 빛 주기로 촬영한다\",\"성대 진동의 실제 주기 하나하나를 그대로 보여준다\",\"심한 비주기적 음성일수록 정확한 영상을 얻을 수 있다\",\"성대 접촉 면적의 변화를 전기 신호로 기록한다\"],\"answer\":1,\"explain\":\"스트로보스코피는 성대 진동 주파수와 약간 다른 주기로 빛을 비추어 여러 주기의 조각을 합성한 느린 가상 영상을 만드는 검사로, 점막파동·진동 진폭·성문폐쇄 양상·좌우 대칭성·주기성·비진동 부위 등을 관찰한다. 기본주파수에 동기화해야 하므로 심하게 비주기적인 음성에서는 신뢰도가 떨어진다. 성대 접촉 면적을 전기 신호로 기록하는 것은 전기성문파형검사(EGG)이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"후두스트로보스코피 소견\\n• 양측 성대의 앞쪽 1/3과 중간 1/3 경계 부위에 좌우 대칭적인 작은 융기\\n• 융기 부위 앞뒤로 성문이 닫히지 않는 모래시계형 폐쇄 양상\",\"q\":\"가장 가능성이 높은 병변은?\",\"choices\":[\"성대폴립\",\"성대결절\",\"성대낭종\",\"라인케부종\",\"후두횡격막\"],\"answer\":2,\"explain\":\"성대결절은 음성 남용·오용으로 성대 진동 시 충격이 가장 큰 막성 성대 앞쪽 1/3~중간 1/3 경계에 양측 대칭으로 생기는 병변이며, 두 결절이 맞닿아 그 앞뒤가 열리는 모래시계형 폐쇄부전이 특징이다. 폴립은 대개 편측이고, 낭종은 편측 점막 내 병변이며, 라인케부종은 성대 전체가 붓고, 후두횡격막은 성대 전방이 막으로 붙은 상태이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"56세 여성\\n• 30년 이상 흡연\\n• 낮고 거칠고 굵은 목소리, 전화 통화 시 남성으로 오인됨\\n• 후두내시경: 양측 성대 전체가 물주머니처럼 부어 있음\",\"q\":\"가장 가능성이 높은 진단은?\",\"choices\":[\"성대결절\",\"접촉성 육아종\",\"후두유두종\",\"성대구증\",\"라인케부종\"],\"answer\":5,\"explain\":\"라인케부종은 장기 흡연이 주요 원인으로, 고유층 표층(라인케 공간)에 액체가 차서 양측 성대 전체가 미만성으로 부어 성대 질량이 늘고 음도가 현저히 낮아진다. 중년 여성에서 남성 목소리로 오인되는 것이 전형적이다. 성대결절은 국소적 양측 융기, 접촉성 육아종은 피열연골 성대돌기 부위 병변, 유두종은 사마귀 모양 종양, 성대구증은 성대 가장자리의 홈이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"재발성 호흡기 유두종증(후두유두종)에 대한 설명으로 옳은 것은?\",\"choices\":[\"음성치료만으로 병변을 완전히 소실시킬 수 있다\",\"주로 장기 흡연 성인 남성에게만 발생한다\",\"인유두종바이러스(HPV) 감염과 관련이 있다\",\"양성 병변이므로 기도 폐쇄의 위험은 없다\",\"편측 성대 전방 1/3에만 국한되어 발생한다\"],\"answer\":3,\"explain\":\"후두유두종은 HPV(주로 6·11형) 감염으로 생기는 사마귀 모양의 양성 종양으로, 소아에서 흔하며 수술로 제거해도 재발이 잦다. 기도 여러 부위에 다발성으로 자랄 수 있어 특히 소아에서 기도 폐쇄 위험이 있다. 음성치료는 수술 후 음성 기능 회복을 돕는 보조적 역할이며 병변 자체를 없애지는 못한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"내전형 경련성 발성장애의 특징으로 옳은 것은?\",\"choices\":[\"무성 자음에서 기식성 음성 끊김이 나타난다\",\"음성위생 교육이 일차적 치료법으로 권장된다\",\"속삭이거나 웃을 때 증상이 더 뚜렷하게 심해진다\",\"심리적 갈등에서 비롯된 기능적 음성장애로 분류된다\",\"모음 산출 시 쥐어짜는 듯한 음성 끊김이 나타난다\"],\"answer\":5,\"explain\":\"내전형 경련성 발성장애는 국소 근긴장이상증으로, 발성 중 성대가 불수의적으로 과도하게 내전되어 모음에서 쥐어짜는 듯한 긴장성 음성 끊김이 나타난다. 무성 자음에서 성대가 벌어져 기식성 끊김이 생기는 것은 외전형이다. 속삭임·웃음·노래 등에서는 오히려 증상이 줄어드는 경우가 많고, 신경학적 음성장애로 분류되며 일차 치료는 보툴리눔 독소 주입이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"17세 남학생\\n• 변성기가 지났으나 여전히 높고 가는 목소리\\n• 기침을 하거나 웃을 때는 순간적으로 낮은 음성이 나옴\\n• 후두내시경: 후두 구조와 성대 운동 정상\",\"q\":\"가장 적절한 진단은?\",\"choices\":[\"편측 성대마비\",\"기능적 실성증\",\"내전형 경련성 발성장애\",\"성대구증\",\"변성발성장애\"],\"answer\":5,\"explain\":\"변성발성장애는 후두가 정상적으로 성장했음에도 사춘기 이후에도 소년기의 높은 음도를 유지하는 기능적 음성장애이다. 기침·웃음 시 낮은 음성이 나오는 것은 생리적으로 저음 산출이 가능함을 뜻하며, 후두 하강·손가락 조작·기침 유도 등으로 비교적 빠르게 개선된다. 기능적 실성증은 음성이 전혀 나오지 않고, 성대구증과 성대마비는 내시경에서 이상 소견이 보인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"48세 남성\\n• 아침에 심한 쉰 목소리, 잦은 헛기침, 목 이물감, 가슴쓰림\\n• 후두내시경: 피열연골 부위 점막 발적·부종, 피열간 점막 비후\",\"q\":\"가장 가능성이 높은 진단은?\",\"choices\":[\"인후두역류질환\",\"후두유두종\",\"변성발성장애\",\"급성 바이러스성 후두염\",\"성대낭종\"],\"answer\":1,\"explain\":\"위 내용물이 후두까지 올라오는 인후두역류는 아침 쉰 목소리, 헛기침, 목 이물감, 가슴쓰림을 흔히 동반하며 후두 후방(피열연골·피열간 부위)의 발적·부종·점막 비후가 특징적 소견이다. 급성 후두염은 감기 등에 뒤따르는 단기 증상이고, 유두종·낭종은 종괴성 병변, 변성발성장애는 후두 소견이 정상이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• 소리가 비강이나 인두 뒤쪽에 갇혀 밖으로 잘 나오지 못하는 듯 답답하고 먹먹하게 들림\\n• 비강 앞쪽 폐쇄나 후방 인두 협착 시 나타날 수 있음\",\"q\":\"해당하는 공명 유형은?\",\"choices\":[\"과다비성\",\"과소비성\",\"맹관공명\",\"혼합 공명\",\"비강 난류\"],\"answer\":3,\"explain\":\"맹관공명(cul-de-sac resonance)은 소리가 막힌 공간에 갇혀 흡수되는 듯 답답하게 들리는 공명으로, 앞쪽 비강 폐쇄나 인두 협착, 혀의 후방 위치 등에서 나타난다. 과다비성은 모음에서 비강 공명이 과도한 것, 과소비성은 비음 /m, n/에서 비강 공명이 부족한 것, 비강 난류는 압력자음 산출 시 코로 공기가 새면서 들리는 소음이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"편측 성대마비로 성문 폐쇄가 불완전한 환자에게 성대 내전을 촉진하기 위해 적용하는 음성치료 기법은?\",\"choices\":[\"하품-한숨법\",\"저작하기\",\"속삭이기\",\"밀기 기법\",\"후두 마사지\"],\"answer\":4,\"explain\":\"밀기 기법은 발성하면서 팔로 벽·의자를 밀거나 손을 맞잡아 당기는 등 힘을 주어 성대 내전을 반사적으로 강화하는 기법으로, 성대마비·성대 활 모양 등 저기능성(성문 폐쇄부전) 음성장애에 사용한다. 하품-한숨법, 저작하기, 후두 마사지는 과기능성 음성장애의 긴장을 낮추는 이완 기법이고, 속삭이기는 성대 접촉을 오히려 줄인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"40세 여성 콜센터 상담원\\n• 근긴장성 발성장애(1형)로 진단됨\\n• 발성 시 목 앞쪽 근육이 단단하게 만져지고 후두가 높게 위치함\",\"q\":\"우선적으로 적용할 치료로 적절한 것은?\",\"choices\":[\"밀기 기법으로 성대 내전과 접촉을 강화한다\",\"리실버만 음성치료로 큰 소리 산출을 훈련한다\",\"후두 마사지와 하품-한숨법으로 긴장을 이완한다\",\"강한 성문파열음 시작으로 힘 있는 발성을 유도한다\",\"보툴리눔 독소를 양측 갑상피열근에 주입한다\"],\"answer\":3,\"explain\":\"근긴장성 발성장애는 후두 외근·내근의 과도한 긴장으로 생기는 과기능성 음성장애이므로, 후두 마사지(후두 하강), 하품-한숨법, 저작하기 등 이완 중심 기법이 우선이다. 밀기 기법·강한 성문파열음·큰 소리 훈련은 성대 접촉과 긴장을 더 높여 부적절하고, 보툴리눔 독소 주입은 경련성 발성장애의 치료이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• /m/ 허밍으로 입술·안면 앞쪽의 진동감을 느끼게 함\\n• 성대가 살짝 벌어진 상태에서 최소한의 노력으로 최대의 공명을 얻도록 함\\n• 성대 충격 스트레스를 줄이는 것이 목표\",\"q\":\"해당하는 음성치료는?\",\"choices\":[\"리실버만 음성치료\",\"액센트 기법\",\"성대기능훈련\",\"공명음성치료\",\"빨대발성\"],\"answer\":4,\"explain\":\"공명음성치료(Lessac-Madsen Resonant Voice Therapy)는 성대가 살짝 벌어진 상태에서 앞쪽 안면·입술의 진동감을 단서로 편안하고 울림 있는 음성을 산출하게 하여 성대 충격을 줄이면서도 강도를 확보하는 방법이다. LSVT는 큰 소리 산출 훈련, 액센트 기법은 복식호흡과 리듬 강세 훈련, 성대기능훈련은 4단계 성대 근육 운동, 빨대발성은 반폐쇄성도 기법이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"성대기능훈련(Vocal Function Exercises)에 대한 설명으로 옳은 것은?\",\"choices\":[\"준비·신장·수축·내전력 강화 운동으로 구성된다\",\"최대한 큰 소리로 밀어내며 강하게 발성하도록 한다\",\"속삭임으로 성대를 충분히 쉬게 하는 훈련이다\",\"음도 변화 없이 습관적 음도에서만 모음을 연장한다\",\"후두 마사지로 근육의 긴장을 낮추는 이완 기법이다\"],\"answer\":1,\"explain\":\"Stemple의 성대기능훈련은 준비운동(/i/ 연장), 신장(저음→고음 활주), 수축(고음→저음 활주), 내전력 강화(여러 음도에서 /ol/ 연장)의 4가지를 부드럽고 작은 소리로 하루 2회, 각 2번씩 수행하는 생리적 접근이다. 큰 소리·속삭임·이완 마사지는 해당하지 않으며, 음도 활주가 핵심이므로 습관적 음도에서만 연장하는 것도 틀리다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"68세 남성, 파킨슨병\\n• 목소리가 작고 단조로우며 기식적임\\n• 본인은 자신의 목소리가 충분히 크다고 느낌\",\"q\":\"가장 적절한 음성치료는?\",\"choices\":[\"하품-한숨법\",\"리실버만 음성치료\",\"속삭이기\",\"공명음성치료\",\"흡기발성\"],\"answer\":2,\"explain\":\"LSVT LOUD는 파킨슨병 환자의 낮은 강도·단조로운 음성을 위해 개발된 집중 치료(주 4회, 4주)로, '크게 생각하기'를 통해 발성 노력을 높이고 자기 음성 크기에 대한 지각을 재조정한다. 하품-한숨법·공명음성치료는 과기능성 음성의 긴장을 낮추는 방법이며, 흡기발성은 가성대 발성·기능적 실성증에, 속삭이기는 강도를 더 낮추므로 부적절하다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• 발성 시 진성대 대신 가성대(false vocal folds)가 진동함\\n• 낮고 거친 음질\",\"q\":\"진성대 발성을 유도하기 위해 사용할 수 있는 기법은?\",\"choices\":[\"흡기발성\",\"밀기 기법\",\"강한 성문파열음 시작\",\"큰 소리로 소리 지르기\",\"저음 유지 훈련\"],\"answer\":1,\"explain\":\"흡기발성은 숨을 들이마시면서 소리를 내는 방법으로, 흡기 시에는 가성대가 벌어지고 진성대만 진동하므로 가성대 발성이나 기능적 실성증 환자에게 진성대 발성을 되찾게 하는 데 유용하다. 밀기 기법·강한 성문파열음·소리 지르기는 성문 상부의 압축과 긴장을 더 높이고, 가성대 발성은 이미 낮은 음도이므로 저음 훈련은 목표와 맞지 않는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"기관식도발성(TEP)에 대한 설명으로 옳은 것은?\",\"choices\":[\"전기후두처럼 외부 진동원을 목에 대어 소리를 낸다\",\"폐의 공기를 식도로 보내 인두식도분절을 진동시킨다\",\"식도로 삼킨 공기를 역류시켜 발성하므로 발화 길이가 짧다\",\"후두를 적출하지 않고 시행하는 성대 재건술이다\",\"발성을 위해 호흡과 무관하게 단어 단위로만 말한다\"],\"answer\":2,\"explain\":\"기관식도발성은 후두전적출 후 기관과 식도 사이에 만든 천공에 일방향 밸브 보철을 삽입하여, 기공을 막고 내쉰 폐의 공기를 식도로 보내 인두식도분절을 진동시키는 방법이다. 폐의 공기를 사용하므로 식도발성보다 발화 길이가 길고 강도가 크다. 외부 진동원을 쓰는 것은 전기후두, 삼킨 공기를 쓰는 것은 식도발성이다.\"}];\n</script>\n<script>\n// ═════════ 상태 ═════════\nlet Q = [];                  // 이번 시험 문항\nlet answers = [], checks = [], memos = [], strikes = [];\nlet page = 0, perPage = 1, filter = 'all', fontScale = 1;\nlet limitSec = 0, remainSec = 0, timerId = null, warned = false;\nlet memoTarget = -1, submitted = false, startedAt = null;\nlet hlStore = {}, penMode = 'off';   // 형광펜: 하이라이트 저장소 + 모드(off/on)\n\nconst $ = id => document.getElementById(id);\nconst show = id => $(id).classList.remove('hidden');\nconst hide = id => $(id).classList.add('hidden');\n// 문항 이미지 크게 보기(팝업)\n// 떠 있는 창(메모·계산기·그림판·이미지): 누른 창을 맨 위로\nfunction raiseWin(win){ document.querySelectorAll('.float-win').forEach(w => w.style.zIndex = ''); win.style.zIndex = 75; }\ndocument.addEventListener('mousedown', e => { const w = e.target.closest && e.target.closest('.float-win'); if(w) raiseWin(w); }, true);\nfunction fitImgWin(){\n  const win = $('imgWin'), img = $('lbImg'), vw = innerWidth, vh = innerHeight;\n  if(vw < 700){ Object.assign(win.style, {left:'0px', top:'0px', width:vw+'px', height:vh+'px'}); return; }\n  const head = win.querySelector('.fw-head').offsetHeight || 40, pad = 16;\n  const nw = img.naturalWidth || 800, nh = img.naturalHeight || 500;\n  let bw = Math.min(nw, vw*0.8 - pad), bh = bw * nh / nw;\n  const maxBh = vh*0.8 - head - pad;\n  if(bh > maxBh){ bh = maxBh; bw = bh * nw / nh; }\n  const w = Math.max(320, bw + pad), h = Math.max(200, bh + head + pad);\n  Object.assign(win.style, {width:w+'px', height:h+'px', left:Math.round((vw-w)/2)+'px', top:Math.round((vh-h)/2)+'px', right:'auto', bottom:'auto'});\n}\nfunction openImg(src){\n  const win = $('imgWin'), img = $('lbImg'), wasOpen = !win.classList.contains('hidden');\n  img.onload = () => { if(!wasOpen) fitImgWin(); };\n  img.src = src;\n  show('imgWin'); raiseWin(win);\n  if(!wasOpen && img.complete && img.naturalWidth) fitImgWin();\n}\nfunction closeImg(){ hide('imgWin'); $('lbImg').removeAttribute('src'); }\ndocument.addEventListener('keydown', e => { if(e.key==='Escape' && !$('imgWin').classList.contains('hidden')) closeImg(); });\naddEventListener('resize', () => { if(!$('imgWin').classList.contains('hidden') && innerWidth < 700) fitImgWin(); });\nconst circled = i => ['①','②','③','④','⑤'][i];\n\n// ═════════ 시작 화면 ═════════\n// 급수(1급/2급)별 시험 구조. 급수 → 회차(set) → 교시(session) 순으로 선택한다.\n// 문항 데이터에 존재하는 급수·회차만 버튼으로 노출하고, 1개뿐이면 그 선택 UI는 숨긴다.\n// 2급 실제 구조: 1교시 신경언어30·유창성25·음성25(80) / 2교시 언어발달35·조음음운35(70) = 150문항(현장실무 없음).\nconst GRADE_META = {\n  1: { title: '1급 언어재활사 모의 CBT',\n       sess: { 1: { label: '1교시 (신경언어·언어발달·유창성)', min: 75 },\n               2: { label: '2교시 (음성·조음음운·현장실무)', min: 70 } } },\n  2: { title: '2급 언어재활사 모의 CBT',\n       sess: { 1: { label: '1교시 (신경언어·유창성·음성)', min: 75 },\n               2: { label: '2교시 (언어발달·조음음운)', min: 70 } } },\n};\nlet chosenGrade = 1, chosenSet = 1, chosenSess = 1;\n\nconst qGrade = q => q.grade || 1;\nconst qSet   = q => q.set   || 1;\n// HIDDEN_SETS(questions.js)에 적힌 급수/회차는 앱에서 보이지 않게 한다(비공개 세트).\nconst isHidden = q => (window.HIDDEN_SETS || []).some(h => h.grade === qGrade(q) && h.set === qSet(q));\nconst VIS = () => QUESTIONS.filter(q => !isHidden(q));\nfunction availableGrades(){ return Array.from(new Set(VIS().map(qGrade))).sort((a,b)=>a-b); }\nfunction availableSets(g){ return Array.from(new Set(VIS().filter(q=>qGrade(q)===g).map(qSet))).sort((a,b)=>a-b); }\nfunction availableSessions(){ return [1,2].filter(s => VIS().some(q=>qGrade(q)===chosenGrade && qSet(q)===chosenSet && q.session===s)); }\nfunction gradeMeta(){ return GRADE_META[chosenGrade] || GRADE_META[1]; }\nfunction sessMeta(s){ return gradeMeta().sess[s] || { label: s+'교시', min: 70 }; }\n\nfunction poolFor(s){ return VIS().filter(q => q.session===s && qGrade(q)===chosenGrade && qSet(q)===chosenSet); }\nfunction minutesFor(s){ return sessMeta(s).min; }\n// 선택한 교시부터 진행, 끝나면 나머지 교시 이어풀기 — 존재하는 교시 기준으로 큐 구성.\nfunction sessionQueueFrom(s){ const av = availableSessions(); return s===av[0] ? av.slice() : av.slice().reverse(); }\nfunction setLabel(){ return availableSets(chosenGrade).length > 1 ? ` ${chosenSet}회차` : ''; }\nfunction examTitle(){ return gradeMeta().title; }\n\n// 급수·회차·교시 버튼을 데이터에 맞춰 다시 그린다.\nfunction renderStartSelectors(){\n  const grades = availableGrades();\n  if(!grades.includes(chosenGrade)) chosenGrade = grades[0] || 1;\n  const gRow=$('gradeRow'), gBox=$('gradeBtns');\n  if(grades.length <= 1){ if(gRow) gRow.style.display='none'; }\n  else if(gRow && gBox){\n    gRow.style.display='';\n    gBox.innerHTML = grades.map(g=>`<button class=\"sess-btn${g===chosenGrade?' active':''}\" data-grade=\"${g}\">${g}급</button>`).join(' ');\n    gBox.querySelectorAll('button').forEach(b=>b.onclick=()=>{\n      chosenGrade=+b.dataset.grade; chosenSet=availableSets(chosenGrade)[0]||1; renderStartSelectors();\n    });\n  }\n  const sets = availableSets(chosenGrade);\n  if(!sets.includes(chosenSet)) chosenSet = sets[0] || 1;\n  const sRow=$('setRow'), sBox=$('setBtns');\n  if(sets.length <= 1){ if(sRow) sRow.style.display='none'; }\n  else if(sRow && sBox){\n    sRow.style.display='';\n    sBox.innerHTML = sets.map(s=>`<button class=\"sess-btn${s===chosenSet?' active':''}\" data-set=\"${s}\">${s}회차</button>`).join(' ');\n    sBox.querySelectorAll('button').forEach(b=>b.onclick=()=>{ chosenSet=+b.dataset.set; renderStartSelectors(); });\n  }\n  const av = availableSessions();\n  if(!av.includes(chosenSess)) chosenSess = av[0] || 1;\n  const seBox=$('sessBtns');\n  if(seBox){\n    seBox.innerHTML = av.map(s=>`<button class=\"sess-btn${s===chosenSess?' active':''}\" data-sess=\"${s}\">${sessMeta(s).label}</button>`).join(' ');\n    seBox.querySelectorAll('button').forEach(b=>b.onclick=()=>{ chosenSess=+b.dataset.sess; renderStartSelectors(); });\n  }\n  updateStartInfo();\n}\nfunction updateStartInfo(){\n  const other = availableSessions().find(x=>x!==chosenSess);\n  $('stTitle').textContent = examTitle() + setLabel() + ` ${chosenSess}교시`;\n  const tail = other ? ` · 제출 후 ${other}교시 이어풀기 선택` : '';\n  $('stTime').textContent = `${poolFor(chosenSess).length}문항 / ${minutesFor(chosenSess)}분${tail}`;\n}\nfunction tickClock(){\n  const d = new Date();\n  const nd = $('nowDate'), nt = $('nowTime');\n  if(nd) nd.textContent = d.toLocaleDateString('ko-KR');\n  if(nt) nt.textContent = d.toLocaleTimeString('ko-KR', {hour12:false});\n}\nsetInterval(tickClock, 1000); tickClock();\n$('stDate').textContent = new Date().toLocaleDateString('ko-KR');\nrenderStartSelectors();\n\n// ═════════ 로그인 · 기기 바인딩 (베타) ═════════\n// 각 계정(slp01~)은 최초 로그인한 기기 1대에서만 사용 가능.\n// deviceId: 이 브라우저에 저장되는 임의 식별자. Firestore users/{uid}.device 와 일치해야 입장.\nconst EMAIL_DOMAIN = '@kcbt.test';           // slp01 → slp01@kcbt.test (실제로 발송되지 않는 가짜 도메인)\nlet fbAuth = null, fbDb = null, CURRENT_ID = null, loginInProgress = false;\n\n// 체험 계정 제한 — users/{uid}.plan 이 'set1'이면 체험판 사이트에서만 쓸 수 있고,\n// users/{uid}.trialGrade(1 또는 2) 에 적힌 급수의 체험판 사이트에서만 입장된다.\n// 체험판 사이트는 자기 Firebase 설정 파일에서 IS_TRIAL_SITE=true, TRIAL_GRADE=급수 를 켠다.\nconst TRIAL_SITE = !!window.IS_TRIAL_SITE;\nconst TRIAL_GRADE = +(window.TRIAL_GRADE || 1);\nconst TRIAL_URLS = { 1: 'cbt1.sososoop.com', 2: 'cbt2.sososoop.com' };\nfunction trialGradeOf(data){ return +((data && data.trialGrade) || 1); }   // 없으면 1급(기존 계정 호환)\n// users/{uid}.trialEnd('YYYY-MM-DD')가 있으면 그날 밤 12시(한국 시간)까지만 입장된다.\nfunction trialEnded(data){\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String((data && data.trialEnd) || ''));\n  return !!m && Date.now() > Date.parse(m[1] + '-' + m[2] + '-' + m[3] + 'T23:59:59+09:00');\n}\nfunction planBlocked(data){\n  if(!data || data.plan !== 'set1') return false;          // 정식 계정은 제한 없음\n  if(trialEnded(data)) return true;                         // 체험 기간이 지남\n  return !TRIAL_SITE || trialGradeOf(data) !== TRIAL_GRADE; // 체험 계정은 자기 급수 사이트에서만\n}\nfunction planBlockMsg(data){\n  if(trialEnded(data)){\n    return formatExtendDate(data.trialEnd) + '로 체험 기간이 끝났어요.\\n이용해 주셔서 감사합니다. 🌿';\n  }\n  const g = trialGradeOf(data);\n  return '이 계정은 ' + g + '급 1회차 체험판 전용입니다.\\n' + (TRIAL_URLS[g] || TRIAL_URLS[1]) + ' 으로 접속해 주세요.';\n}\nif(TRIAL_SITE){\n  const _s = $('agSub'), _i = $('agId');\n  if(_s) _s.textContent = TRIAL_GRADE + '급 1회차 체험판 · 발급받은 계정으로 로그인해 주세요';\n  if(_i) _i.placeholder = '예: cbt01';\n}\n\nfunction getDeviceId(){\n  let d = localStorage.getItem('kcbt_device_id');\n  if(!d){\n    d = (window.crypto && crypto.randomUUID) ? crypto.randomUUID()\n        : 'dev-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2);\n    localStorage.setItem('kcbt_device_id', d);\n  }\n  return d;\n}\nfunction agShowErr(msg){ $('agErr').textContent = msg || ''; }\nfunction enterApp(id, extendedUntil){\n  CURRENT_ID = id;\n  hide('authGate');\n  if(SHOW_HOME){ renderHome(); show('homeScreen'); show('homeBackBtn'); } else show('startScreen');\n  // 설문 참여로 연장된 계정 → 접속 시 안내 팝업(브라우저 세션당 1회)\n  if(extendedUntil && !sessionStorage.getItem('kcbt_extend_notice_shown')){\n    const el = $('extendUntilText');\n    if(el) el.textContent = formatExtendDate(extendedUntil);\n    show('extendOverlay');\n    try{ sessionStorage.setItem('kcbt_extend_notice_shown', '1'); }catch(e){}\n  }\n}\n// ═════════ 대문(첫 화면) ═════════\n// 소소숲 번들 빌드가 window.SHOW_HOME=true 를 넣는다. 베타·체험판은 대문 없이 바로 응시 정보 입력.\nconst SHOW_HOME = !!window.SHOW_HOME;\n// 제15회(2026) 국시원 공고 기준. 다음 회차 공고가 나오면 이 블록만 고친다.\nconst EXAM_INFO = {\n  round: '2026년도 제15회',\n  exam: '2026-12-05',\n  result: '2026-12-23',\n  schedule: [\n    ['응시원서 접수', '2026-09-02', '2026-09-09', '9. 2.(수) ~ 9. 9.(수)', '국시원 홈페이지 인터넷 접수'],\n    ['시험장 공고 · 선택', '2026-11-04', '2026-11-08', '11. 4.(수) ~ 11. 8.(일)', '본인이 시험장을 직접 선택'],\n    ['응시표 출력', '2026-11-11', '2026-12-05', '11. 11.(수)부터', '시험 당일 아침까지 출력 가능'],\n    ['시험 시행', '2026-12-05', '2026-12-05', '12. 5.(토)', '1급·2급 컴퓨터시험(CBT)'],\n    ['최종합격자 발표', '2026-12-23', '2026-12-23', '12. 23.(수)', '국시원 홈페이지 [합격자조회]'],\n  ],\n  timetable: {\n    1: [['1교시', '신경언어장애 24 · 언어발달장애 24 · 유창성장애 24', 72, '13:30까지', '14:00 ~ 15:15 (75분)'],\n        ['2교시', '음성장애 24 · 조음음운장애 24 · 언어재활현장실무 20', 68, '15:40까지', '15:50 ~ 17:00 (70분)']],\n    2: [['1교시', '신경언어장애 30 · 유창성장애 25 · 음성장애 25', 80, '08:30까지', '09:00 ~ 10:15 (75분)'],\n        ['2교시', '언어발달장애 35 · 조음음운장애 35', 70, '10:40까지', '10:50 ~ 11:55 (65분)']],\n  },\n};\n// 한국 시간 기준 오늘 날짜(YYYY-MM-DD)\nfunction kstToday(){\n  const d = new Date(Date.now() + 9*3600*1000);\n  return d.toISOString().slice(0,10);\n}\nfunction dayDiff(a, b){ return Math.round((Date.parse(b) - Date.parse(a)) / 86400000); }\nfunction renderHome(){\n  const today = kstToday();\n  const toExam = dayDiff(today, EXAM_INFO.exam);\n  const toResult = dayDiff(today, EXAM_INFO.result);\n  const [, tm, td] = today.split('-');\n  $('hmToday').textContent = `오늘 ${parseInt(tm,10)}월 ${parseInt(td,10)}일 기준`;\n  if(toExam > 0){\n    $('hmDday').textContent = 'D-' + toExam;\n  } else if(toExam === 0){\n    $('hmDday').textContent = 'D-DAY';\n    $('hmHeadline').innerHTML = '오늘이 시험일이에요<br>차분하게, 연습한 대로!';\n  } else if(toResult >= 0){\n    $('hmDday').parentNode.querySelector('small').textContent = '합격자 발표까지';\n    $('hmDday').textContent = toResult === 0 ? 'D-DAY' : 'D-' + toResult;\n    $('hmHeadline').innerHTML = '시험 수고 많으셨어요<br>합격자 발표는 12월 23일(수)입니다';\n  } else {\n    // 발표까지 끝나면 다음 회차 공고 전까지 일정 대신 안내만 띄운다\n    $('hmDdayBox').classList.add('hidden');\n    $('hmScheduleCard').classList.add('hidden');\n    $('hmKicker').textContent = '언어재활사 국가시험';\n    $('hmHeadline').innerHTML = '다음 시험 일정은<br>국시원 공고 후 안내해 드릴게요';\n  }\n  let nextMarked = false;\n  $('hmSchedule').innerHTML =\n    '<tr><th>구분</th><th>일정</th><th>비고</th><th style=\"text-align:center;\">상태</th></tr>' +\n    EXAM_INFO.schedule.map(([name, from, to, label, note]) => {\n      let cls = '', tag;\n      if(today > to){ cls = 'is-done'; tag = '<span class=\"home-tag done\">완료</span>'; }\n      else if(today >= from){ cls = 'is-next'; nextMarked = true; tag = '<span class=\"home-tag now\">진행 중</span>'; }\n      else if(!nextMarked){ cls = 'is-next'; nextMarked = true; tag = '<span class=\"home-tag next\">다음 일정</span>'; }\n      else tag = '<span class=\"home-tag plan\">예정</span>';\n      return `<tr class=\"${cls}\"><th>${name}</th><td>${label}</td><td>${note}</td><td class=\"num\">${tag}</td></tr>`;\n    }).join('');\n  homeGrade(1);\n}\nfunction homeGrade(g){\n  document.querySelectorAll('.home-grade-tabs button').forEach(b => b.classList.toggle('active', b.dataset.hg == g));\n  const rows = EXAM_INFO.timetable[g];\n  $('hmTimetable').innerHTML =\n    '<tr><th>교시</th><th>시험과목(문항 수)</th><th style=\"text-align:center;\">문항</th><th style=\"text-align:center;\">입장 마감</th><th style=\"text-align:center;\">시험시간</th></tr>' +\n    rows.map(([s, subj, n, enter, time]) =>\n      `<tr><th>${s}</th><td>${subj}</td><td class=\"num\">${n}</td><td class=\"num\">${enter}</td><td class=\"num\">${time}</td></tr>`).join('');\n  const total = rows.reduce((a, r) => a + r[2], 0);\n  $('hmTimeNote').textContent = `※ ${g}급 총 ${total}문항 · ${g === 1 ? '1교시 오후 2시' : '1교시 오전 9시'} 시작. 시간표는 국시원 공고 기준이에요.`;\n}\nfunction goStart(){ hide('homeScreen'); show('startScreen'); }\nfunction backToHome(){ hide('startScreen'); renderHome(); show('homeScreen'); }\nfunction formatExtendDate(s){\n  // '2026-09-30' → '2026년 9월 30일'\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(s).trim());\n  return m ? `${m[1]}년 ${parseInt(m[2],10)}월 ${parseInt(m[3],10)}일` : String(s);\n}\nfunction showGate(){\n  hide('startScreen'); hide('homeScreen');\n  const g = $('authGate'); g.classList.remove('hidden');\n}\n\n// 설정이 비어있으면(로컬 개발) 로그인 건너뛰고 바로 시작화면\nconst _cfg = window.FIREBASE_CONFIG;\nif(!_cfg || !_cfg.apiKey || String(_cfg.apiKey).indexOf('PASTE') === 0){\n  console.warn('[kcbt] Firebase 설정 없음 — 로그인 없이 실행(로컬 개발 모드).');\n  enterApp('local');\n} else {\n  firebase.initializeApp(_cfg);\n  fbAuth = firebase.auth();\n  fbDb = firebase.firestore();\n\n  // 새로고침해도 로그인 유지 — 단, 기기 일치 재확인 후 입장\n  fbAuth.onAuthStateChanged(async (user) => {\n    if(loginInProgress) return;   // 대화형 로그인 진행 중엔 doLogin이 처리하므로 개입 안 함(레이스 방지)\n    if(!user){ showGate(); return; }\n    try{\n      const snap = await fbDb.collection('users').doc(user.uid).get();\n      const data = snap.exists ? snap.data() : null;\n      if(planBlocked(data)){\n        await fbAuth.signOut(); showGate(); agShowErr(planBlockMsg(data));\n      } else if(data && data.device && data.device === getDeviceId()){\n        enterApp(data.name || (user.email || '').split('@')[0], data.extendedUntil);\n      } else {\n        await fbAuth.signOut();   // 기기 불일치/미등록 → 로그아웃 후 게이트\n        showGate();\n      }\n    }catch(e){ console.error(e); await fbAuth.signOut(); showGate(); }\n  });\n}\n\nasync function doLogin(){\n  if(!fbAuth){ enterApp('local'); return; }         // 로컬 개발 모드\n  const id = ($('agId').value || '').trim().toLowerCase();\n  const pw = $('agPw').value || '';\n  if(!id || !pw){ agShowErr('아이디와 비밀번호를 입력해 주세요.'); return; }\n  const btn = $('agBtn'); btn.disabled = true; agShowErr('');\n  loginInProgress = true;   // onAuthStateChanged가 로그인 중 개입해 로그아웃시키는 레이스 방지\n  try{\n    const cred = await fbAuth.signInWithEmailAndPassword(id + EMAIL_DOMAIN, pw);\n    const uid = cred.user.uid;\n    const dev = getDeviceId();\n    const ref = fbDb.collection('users').doc(uid);\n    const snap = await ref.get();\n    if(!snap.exists){\n      await fbAuth.signOut();\n      agShowErr('등록되지 않은 계정입니다. 관리자에게 문의해 주세요.');\n      return;\n    }\n    const data = snap.data();\n    if(planBlocked(data)){\n      await fbAuth.signOut();\n      agShowErr(planBlockMsg(data));\n      return;\n    }\n    if(!data.device){\n      // 최초 로그인 → 이 기기를 등록(바인딩)\n      await ref.update({ device: dev, boundAt: firebase.firestore.FieldValue.serverTimestamp() });\n    } else if(data.device !== dev){\n      // 다른 기기에서 로그인 시도 → 차단\n      await fbAuth.signOut();\n      agShowErr('이미 다른 기기에 등록된 계정입니다.\\n기기 변경은 관리자에게 문의해 주세요.');\n      return;\n    }\n    enterApp(data.name || id, data.extendedUntil);\n  }catch(e){\n    console.error(e);\n    const code = e && e.code || '';\n    if(code === 'permission-denied'){\n      agShowErr('기기 등록에 실패했습니다. 관리자에게 문의해 주세요.');\n    } else if(code.indexOf('auth/user-disabled') >= 0){\n      agShowErr('베타 이용 기간이 종료되었습니다.\\n이용해 주셔서 감사합니다. 🌿');\n    } else if(code.indexOf('auth/too-many-requests') >= 0){\n      agShowErr('로그인 시도가 많습니다. 잠시 후 다시 시도해 주세요.');\n    } else {\n      agShowErr('아이디 또는 비밀번호가 올바르지 않습니다.');\n    }\n  }finally{\n    btn.disabled = false;\n    loginInProgress = false;\n  }\n}\n\nasync function doLogout(){\n  try{ if(fbAuth) await fbAuth.signOut(); }catch(e){}\n  $('agId').value = ''; $('agPw').value = ''; agShowErr('');\n  showGate();\n}\n\n// ═════════ 시험 시작 ═════════\n// 실제 시험 실행부(샘플·커스텀 공용). qArr: 문항배열, minutes: 제한시간, title: 헤더 표기\nfunction _launch(qArr, minutes, title){\n  Q = qArr;\n  if(!Q.length){ alert('시작할 문항이 없습니다.'); return false; }\n  answers = Array(Q.length).fill(0);\n  checks  = Array(Q.length).fill(false);\n  memos   = Array(Q.length).fill('');\n  strikes = Q.map(() => [false,false,false,false,false]);\n  page = 0; filter = 'all'; warned = false; submitted = false;\n  hlStore = {}; penMode = 'off'; $('paper').classList.remove('pen-on');\n  limitSec = remainSec = Math.max(1, minutes) * 60;\n  startedAt = new Date();\n  $('exName').textContent = $('inName').value || '소소숲';\n  $('exTitle').textContent = title;\n  $('limitMin').textContent = Math.round(limitSec/60);\n  hide('startScreen'); show('examScreen');\n  buildOMR(); render();\n  clearInterval(timerId);\n  timerId = setInterval(tickTimer, 1000); tickTimer();\n  return true;\n}\nlet sessQueue = [1], sessPos = 0, accQ = [], accAns = [], accUsedSec = 0, accLimitSec = 0;\nfunction startExam(){\n  sessQueue = sessionQueueFrom(chosenSess);\n  sessPos = 0; accQ = []; accAns = []; accUsedSec = 0; accLimitSec = 0;\n  launchCurrentSession();\n}\nfunction launchCurrentSession(){\n  const s = sessQueue[sessPos];\n  const p = poolFor(s);\n  if(!p.length){ alert('선택한 교시에 문항이 없습니다.'); return; }\n  _launch(p, minutesFor(s), examTitle() + setLabel() + ` ${s}교시`);\n}\nfunction startNextSession(){ hide('nextSessOverlay'); sessPos++; launchCurrentSession(); }   // 다음 교시로 진행\nfunction resultNow(){ hide('nextSessOverlay'); finishAll(); }                                 // 여기서 멈추고 결과\nfunction finishAll(){\n  Q = accQ; answers = accAns;\n  limitSec = accLimitSec; remainSec = accLimitSec - accUsedSec;   // 지금까지 합산 풀이시간\n  showResult();\n}\n// 한 교시 제출/종료 → 누적 후, 다음 교시가 있으면 [다음 교시 시작 / 결과 보기] 선택\nfunction finishSession(){\n  clearInterval(timerId);\n  accQ = accQ.concat(Q);\n  accAns = accAns.concat(answers);\n  accUsedSec += (limitSec - Math.max(0, remainSec));\n  accLimitSec += limitSec;\n  if(sessPos < sessQueue.length - 1){\n    const done = sessQueue[sessPos], next = sessQueue[sessPos+1];\n    $('nextSessMsg').innerHTML = `<b>${done}교시</b>가 종료되었습니다.<br>이어서 <b>${next}교시</b>(${minutesFor(next)}분)를 풀거나,<br>여기서 <b>${done}교시 결과</b>만 볼 수 있어요.`;\n    show('nextSessOverlay');\n  } else {\n    finishAll();\n  }\n}\nfunction tickTimer(){\n  remainSec--;\n  if(remainSec < 0){ clearInterval(timerId); autoSubmit(); return; }\n  const m = Math.floor(remainSec/60), s = remainSec%60;\n  $('remainTxt').textContent = `${m}분 ${String(s).padStart(2,'0')}초`;\n  if(!warned && remainSec <= 300 && limitSec > 300){ warned = true; show('warnOverlay'); }\n}\n\n// ═════════ 페이지 (시험지는 항상 전체 문제) ═════════\nfunction totalPages(){ return Math.max(1, Math.ceil(Q.length / perPage)); }\nfunction movePage(d){\n  const t = totalPages();\n  page = Math.min(t-1, Math.max(0, page+d));\n  render();\n}\nfunction jumpTo(qi){\n  page = Math.floor(qi / perPage);\n  render();\n}\n\n// ═════════ 렌더링 ═════════\nfunction render(){\n  const t = totalPages();\n  if(page >= t) page = t-1;\n  if(page < 0) page = 0;\n  const start = page*perPage;\n  const slice = Q.map((_,i)=>i).slice(start, start + perPage);\n  const grid = $('paperGrid');\n  grid.className = 'paper-grid' + (perPage===1 ? ' one' : '');\n  grid.style.fontSize = fontScale + 'em';\n  grid.innerHTML = slice.map(i => qcardHTML(i)).join('');\n  $('pageInfo').textContent = `${page+1}/${t}`;\n  updateCounts(); updateOMR(slice);\n  $('paper').scrollTop = 0;\n}\n\n// ═════════ 문제 보기 모달 (전체/체크/안푼) ═════════\nlet viewerMode = 'all';\nfunction viewerIdx(mode){\n  if(mode==='chk') return Q.map((_,i)=>i).filter(i=>checks[i]);\n  if(mode==='un')  return Q.map((_,i)=>i).filter(i=>!answers[i]);\n  return Q.map((_,i)=>i);\n}\nfunction openProblemViewer(mode){\n  viewerMode = mode;\n  renderViewer();\n  show('viewerOverlay');\n}\nfunction switchViewerTab(mode){ viewerMode = mode; renderViewer(); }\nfunction renderViewer(){\n  $('vtAll').textContent = `전체문제 (${Q.length})`;\n  $('vtChk').textContent = `체크문제 (${checks.filter(Boolean).length})`;\n  $('vtUn').textContent  = `안푼문제 (${answers.filter(a=>!a).length})`;\n  ['vtAll','vtChk','vtUn'].forEach(id=>$(id).classList.remove('active'));\n  $(viewerMode==='all'?'vtAll':viewerMode==='chk'?'vtChk':'vtUn').classList.add('active');\n  const idxs = viewerIdx(viewerMode);\n  const body = $('viewerBody');\n  body.innerHTML = idxs.length\n    ? idxs.map(i => viewerCard(i)).join('')\n    : '<div style=\"padding:60px;text-align:center;color:#68738a;grid-column:1/-1;\">해당하는 문제가 없습니다.</div>';\n  body.scrollTop = 0;\n}\nfunction viewerCard(i){\n  const q = Q[i];\n  return `<div class=\"v-card\" ondblclick=\"viewerJump(${i})\" title=\"더블클릭하면 이 문제로 이동합니다\">\n    <div class=\"v-head\"><span class=\"v-no\">${i+1}</span><span style=\"flex:1\">${esc(q.q)}</span></div>\n    ${q.stem ? `<div class=\"v-stem\">${fmt(q.stem)}</div>` : ''}\n    <ul class=\"v-choices\">\n      ${q.choices.map((c,ci)=>`<li class=\"${answers[i]===ci+1?'sel':''}\">${circled(ci)} ${esc(c)}</li>`).join('')}\n    </ul>\n  </div>`;\n}\nfunction viewerJump(i){ hide('viewerOverlay'); jumpTo(i); }\nfunction esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\n// 문항 텍스트 서식: __구간__ → 밑줄(발화 전사의 비유창 구간 표시 등)\nfunction fmt(s){ return esc(s).replace(/__(.+?)__/g, '<u class=\"ul\">$1</u>'); }\nfunction qcardHTML(i){\n  const q = Q[i];\n  return `<div class=\"qcol\"><div class=\"qcard\" data-qi=\"${i}\">\n    <div class=\"qtools\">\n      <div class=\"qtools-row\">\n        <button class=\"tool-btn ${checks[i]?'on':''}\" onclick=\"toggleCheck(${i})\">&#10003; 체크문제</button>\n        <button class=\"tool-btn ${memos[i]?'memo-on':''}\" onclick=\"openMemo(${i})\">&#9998; 메모</button>\n      </div>\n      <div class=\"qtools-row\">\n        <button class=\"tool-btn ${penMode==='on'?'pen-on':''}\" onclick=\"togglePen()\">&#128396; 형광펜 ${penMode==='on'?'켜짐':'꺼짐'}</button>\n        <button class=\"tool-btn\" onclick=\"clearHighlights(${i})\">&#9003; 형광펜 지우기</button>\n      </div>\n    </div>\n    <div class=\"qhead\"><span>${i+1}.</span><span style=\"flex:1\" data-hl=\"${i}-q\">${hlHTML(i,'q',q.q)}</span><span class=\"subj\">${esc(q.subject)}</span></div>\n    ${q.stem ? `<div class=\"stem\" data-hl=\"${i}-s\">${hlHTML(i,'s',q.stem)}</div>` : ''}\n    ${q.image ? `<div class=\"qimg-wrap\"><img class=\"qimg\" src=\"${esc(q.image)}\" alt=\"문항 자료 이미지\" title=\"클릭하면 크게 볼 수 있습니다\" onclick=\"openImg(this.src)\"><div class=\"qimg-hint\"><button type=\"button\" class=\"qimg-btn\" onclick=\"openImg(this.closest('.qimg-wrap').querySelector('img').src)\">&#128269; 크게 보기</button></div></div>` : ''}\n    <ul class=\"choices\">\n      ${q.choices.map((c,ci)=>`\n        <li class=\"${answers[i]===ci+1?'sel':''} ${strikes[i][ci]?'strike':''}\">\n          <span class=\"num\">${ci+1}</span>\n          <span class=\"ctext\" data-hl=\"${i}-c${ci}\">${hlHTML(i,'c'+ci,c)}</span>\n          <button class=\"strike-btn ${strikes[i][ci]?'on':''}\" onclick=\"toggleStrike(${i},${ci})\">오답</button>\n        </li>`).join('')}\n    </ul>\n  </div></div>`;\n}\nfunction updateCounts(){\n  $('cntAll').textContent = Q.length;\n  $('cntChk').textContent = checks.filter(Boolean).length;\n  $('cntUn').textContent = answers.filter(a=>!a).length;\n}\n\n// ═════════ OMR ═════════\nfunction buildOMR(){\n  // OMR 패널 제거됨 — 남아있는 경우에만 렌더(호환용)\n  const list = $('omrList'); if(!list) return;\n  list.innerHTML = Q.map((_,i)=>`\n    <div class=\"omr-row ${(i+1)%5===0?'sep':''}\" id=\"omr${i}\">\n      <span class=\"flags\" id=\"flag${i}\"></span>\n      <span class=\"no\" onclick=\"jumpTo(${i})\">${String(i+1).padStart(2,'0')}</span>\n      <span class=\"bubbles\">${[1,2,3,4,5].map(n=>`<button class=\"bub\" onclick=\"pick(${i},${n})\">${circled(n-1)}</button>`).join('')}</span>\n    </div>`).join('');\n}\nfunction updateOMR(visible){\n  // 진행바 갱신(푼 문항 수 기준)\n  const total = Q.length, done = answers.filter(a=>a>0).length;\n  const pb = $('progBar'), pt = $('progText');\n  if(pb) pb.style.width = (total ? done/total*100 : 0) + '%';\n  if(pt) pt.textContent = `${done} / ${total} 문항 풀이`;\n  // OMR 패널이 남아있으면 함께 갱신(호환용)\n  if(!$('omrList')) return;\n  Q.forEach((_,i)=>{\n    const row = $('omr'+i); if(!row) return;\n    row.classList.toggle('cur', visible.includes(i));\n    row.querySelectorAll('.bub').forEach((b,bi)=>b.classList.toggle('mark', answers[i]===bi+1));\n    $('flag'+i).innerHTML = (checks[i]?'<span class=\"chk\">&#10003;</span>':'') + (memos[i]?'<span>&#9998;</span>':'');\n  });\n}\nfunction goHome(){\n  if(!confirm('처음(입장) 화면으로 돌아갈까요?\\n지금까지 푼 답안은 저장되지 않습니다.')) return;\n  clearInterval(timerId);\n  hide('examScreen'); hide('resultScreen'); show('startScreen');\n}\n\n// ═════════ 상호작용 ═════════\nfunction pick(i,n){\n  answers[i] = (answers[i]===n) ? 0 : n;\n  render();\n}\nfunction toggleStrike(i,ci){ strikes[i][ci] = !strikes[i][ci]; render(); }\nfunction toggleCheck(i){ checks[i] = !checks[i]; render(); }\n\n// 글자 크기 / 화면 배치\ndocument.querySelectorAll('.fbtn').forEach(b=>b.onclick=()=>{\n  document.querySelectorAll('.fbtn').forEach(x=>x.classList.remove('active'));\n  b.classList.add('active'); fontScale = +b.dataset.fs; render();\n});\n$('lay1').onclick = ()=>{ perPage=1; $('lay1').classList.add('active'); $('lay2').classList.remove('active'); page=0; render(); };\n$('lay2').onclick = ()=>{ perPage=2; $('lay2').classList.add('active'); $('lay1').classList.remove('active'); page=0; render(); };\n\n// ═════════ 형광펜 ═════════\n// 하이라이트는 문항별(data-hl 키)로 innerHTML을 저장해 페이지 이동·재렌더 후에도 유지된다.\nfunction hlHTML(i, part, text){\n  const k = i + '-' + part;\n  return hlStore[k] !== undefined ? hlStore[k] : fmt(text);\n}\nfunction togglePen(){\n  penMode = penMode==='on' ? 'off' : 'on';\n  $('paper').classList.toggle('pen-on', penMode==='on');\n  const sel = window.getSelection && window.getSelection();\n  if(sel) sel.removeAllRanges();\n  render();   // 문제 카드의 형광펜 버튼 상태(켜짐/꺼짐) 갱신\n}\nfunction hlContainerOf(node){\n  while(node){\n    if(node.nodeType===1 && node.dataset && node.dataset.hl!==undefined) return node;\n    node = node.parentNode;\n  }\n  return null;\n}\nfunction saveHl(c){ if(c) hlStore[c.dataset.hl] = c.innerHTML; }\nfunction clearHighlights(i){   // 해당 문항의 모든 형광펜 하이라이트 제거\n  ['q','s','c0','c1','c2','c3','c4'].forEach(p => delete hlStore[i+'-'+p]);\n  render();\n}\nfunction onPaperMouseUp(){\n  if(penMode!=='on') return;\n  const sel = window.getSelection();\n  if(!sel || sel.isCollapsed || !String(sel).trim()) return;\n  const range = sel.getRangeAt(0);\n  const startC = hlContainerOf(range.startContainer);\n  const endC = hlContainerOf(range.endContainer);\n  if(!startC || startC !== endC){ sel.removeAllRanges(); return; }   // 한 영역 안에서만 허용\n  const mark = document.createElement('mark');\n  mark.className = 'hl';\n  try{ range.surroundContents(mark); }\n  catch(_){ try{ mark.appendChild(range.extractContents()); range.insertNode(mark); }\n            catch(e){ sel.removeAllRanges(); return; } }\n  saveHl(startC);\n  sel.removeAllRanges();\n}\nfunction onPaperClick(e){\n  const mark = e.target.closest ? e.target.closest('mark.hl') : null;\n  if(penMode==='on' && mark){                       // 형광펜 모드에서 하이라이트 클릭 → 지우기\n    const cont = hlContainerOf(mark), parent = mark.parentNode;\n    while(mark.firstChild) parent.insertBefore(mark.firstChild, mark);\n    parent.removeChild(mark); parent.normalize();\n    saveHl(cont);\n    return;\n  }\n  if(window.getSelection && String(window.getSelection()).trim()) return;  // 드래그 선택 중이면 클릭 무시\n  const ct = e.target.closest ? e.target.closest('.ctext') : null;         // 보기 텍스트 클릭 → 답 선택\n  if(ct){\n    const li = ct.closest('li');\n    const ci = [...li.parentNode.children].indexOf(li);\n    const qi = +li.closest('.qcard').dataset.qi;\n    pick(qi, ci+1);\n  }\n}\n$('paper').addEventListener('mouseup', onPaperMouseUp);\n$('paper').addEventListener('click', onPaperClick);\n\n// ═════════ 메모 ═════════\nfunction openMemo(i){\n  memoTarget = i;\n  $('memoTitle').textContent = `${i+1}번 문제 메모`;\n  $('memoText').value = memos[i];\n  show('memoWin'); $('memoText').focus();\n}\nfunction closeMemo(){\n  if(memoTarget>=0) memos[memoTarget] = $('memoText').value.trim();\n  memoTarget = -1; hide('memoWin'); render();\n}\n\n// ═════════ 계산기 ═════════\nfunction toggleCalc(){ $('calcWin').classList.toggle('hidden'); }\nfunction calcIn(v){ const d=$('calcDisp'); d.value = d.value==='0'&&!'+-*/.'.includes(v) ? v : d.value+v; }\nfunction calcClear(){ $('calcDisp').value='0'; }\nfunction calcBack(){ const d=$('calcDisp'); d.value=d.value.slice(0,-1)||'0'; }\nfunction calcEq(){\n  const d=$('calcDisp');\n  if(!/^[\\d+\\-*/.() ]+$/.test(d.value)) return;\n  try{ d.value = String(Function('\"use strict\";return ('+d.value+')')()); }catch(e){ d.value='오류'; }\n}\n\n// ═════════ 그림판 ═════════\nconst pc = $('padCanvas'), pctx = pc.getContext('2d');\nlet padMode='pen', drawing=false;\nfunction togglePad(){ $('padWin').classList.toggle('hidden'); }\nfunction setPadMode(m){ padMode=m; $('penBtn').classList.toggle('on',m==='pen'); $('eraserBtn').classList.toggle('on',m==='eraser'); }\nfunction clearPad(){ pctx.clearRect(0,0,pc.width,pc.height); }\npc.addEventListener('mousedown',e=>{ drawing=true; pctx.beginPath(); pctx.moveTo(e.offsetX,e.offsetY); });\npc.addEventListener('mousemove',e=>{\n  if(!drawing) return;\n  pctx.lineWidth = padMode==='pen'?2:18;\n  pctx.strokeStyle='#1f3358';\n  pctx.globalCompositeOperation = padMode==='pen'?'source-over':'destination-out';\n  pctx.lineTo(e.offsetX,e.offsetY); pctx.stroke();\n});\n['mouseup','mouseleave'].forEach(ev=>pc.addEventListener(ev,()=>drawing=false));\n\n// 플로팅 창 드래그\ndocument.querySelectorAll('[data-drag]').forEach(h=>{\n  h.addEventListener('mousedown',e=>{\n    if(e.target.tagName==='BUTTON') return;\n    e.preventDefault();\n    const win=$(h.dataset.drag), r=win.getBoundingClientRect();\n    const ox=e.clientX-r.left, oy=e.clientY-r.top;\n    win.style.left=r.left+'px'; win.style.top=r.top+'px'; win.style.right='auto'; win.style.bottom='auto';\n    const mv=ev=>{   // 제목줄 일부는 항상 화면 안에 남도록 제한\n      const x=Math.min(innerWidth-80, Math.max(80-r.width, ev.clientX-ox));\n      const y=Math.min(innerHeight-40, Math.max(0, ev.clientY-oy));\n      win.style.left=x+'px'; win.style.top=y+'px';\n    };\n    const up=()=>{ document.removeEventListener('mousemove',mv); document.removeEventListener('mouseup',up); };\n    document.addEventListener('mousemove',mv); document.addEventListener('mouseup',up);\n  });\n});\n$('imgGrip').addEventListener('mousedown', e => {\n  e.preventDefault(); e.stopPropagation();\n  const win=$('imgWin'), r=win.getBoundingClientRect(), sx=e.clientX, sy=e.clientY;\n  win.style.left=r.left+'px'; win.style.top=r.top+'px';\n  const mv=ev=>{\n    win.style.width = Math.max(260, Math.min(innerWidth - r.left, r.width + ev.clientX - sx)) + 'px';\n    win.style.height = Math.max(180, Math.min(innerHeight - r.top, r.height + ev.clientY - sy)) + 'px';\n  };\n  const up=()=>{ document.removeEventListener('mousemove',mv); document.removeEventListener('mouseup',up); };\n  document.addEventListener('mousemove',mv); document.addEventListener('mouseup',up);\n});\n\n// ═════════ 제출 ═════════\nfunction askSubmit(){\n  const un = answers.filter(a=>!a).length;\n  const isLast = sessPos >= sessQueue.length - 1;\n  const tail = isLast ? '답안을 제출하시겠습니까?'\n                      : `${sessQueue[sessPos]}교시 답안을 제출할까요?`;\n  $('submitMsg').innerHTML = un\n    ? `안 푼 문제가 <b style=\"color:var(--red)\">${un}개</b> 있습니다.<br>${tail}<br><small style=\"color:#68738a\">제출 후에는 수정할 수 없습니다.</small>`\n    : `모든 문제에 답하였습니다.<br>${tail}`;\n  show('submitOverlay');\n}\nfunction autoSubmit(){\n  if(submitted) return; submitted=true; clearInterval(timerId); hide('warnOverlay');\n  const isLast = sessPos >= sessQueue.length - 1;\n  const btn = $('timeoverBtn'); if(btn) btn.textContent = isLast ? '결과 확인' : '확인';\n  const msg = $('timeoverMsg'); if(msg) msg.innerHTML = isLast\n    ? '시험 시간이 종료되어<br>답안이 자동 제출되었습니다.'\n    : `${sessQueue[sessPos]}교시 시간이 종료되어<br>답안이 자동 제출되었습니다.`;\n  show('timeoverOverlay');\n}\nfunction doSubmit(){ submitted=true; clearInterval(timerId); hide('submitOverlay'); finishSession(); }\n\n// ═════════ 결과 ═════════\nfunction showResult(){\n  clearInterval(timerId);\n  hide('examScreen'); closeMemo(); hide('calcWin'); hide('padWin'); show('resultScreen');\n  const graded = q => q.answer>=1 && q.answer<=5;   // 정답이 지정된 채점 가능 문항\n  const bySub = {};\n  Q.forEach((q,i)=>{\n    if(!graded(q)) return;                            // 정답 미설정 → 채점 제외\n    if(!bySub[q.subject]) bySub[q.subject]={n:0,ok:0};\n    bySub[q.subject].n++;\n    if(answers[i]===q.answer) bySub[q.subject].ok++;\n  });\n  const totalN = Q.filter(graded).length;\n  const totalOk = Q.reduce((s,q,i)=>s+((graded(q)&&answers[i]===q.answer)?1:0),0);\n  const usedSec = limitSec - Math.max(0, remainSec);\n  const timeLine = `풀이 시간: ${Math.floor(usedSec/60)}분 ${usedSec%60}초 / 제한 ${Math.round(limitSec/60)}분`;\n\n  if(totalN === 0){   // 방어용: 채점 가능한 문항이 없을 때\n    $('scoreTable').innerHTML =\n      `<tr><th>과목</th><th>문항 수</th><th>정답 수</th><th>정답률</th></tr>\n       <tr class=\"total\"><td>총계</td><td>${Q.length}</td><td>-</td><td>채점 제외</td></tr>`;\n    $('verdict').textContent = '풀이를 마쳤어요 ✅';\n    $('verdict').className = 'verdict pass';\n    document.querySelector('.verdict-sub').innerHTML =\n      `이 세트는 정답이 지정된 문항이 없어 채점을 생략했어요. 아래에서 내가 고른 답을 확인해 보세요.<br>${timeLine}`;\n    setReviewFilter('all');\n    return;\n  }\n\n  let anyFail = false;\n  let rows = Object.entries(bySub).map(([s,v])=>{\n    const pct = Math.round(v.ok/v.n*100);\n    const bad = pct < 40; if(bad) anyFail = true;\n    return `<tr><td>${s}</td><td>${v.n}</td><td>${v.ok}</td><td class=\"${bad?'bad':''}\">${pct}%${bad?' (과락)':''}</td></tr>`;\n  }).join('');\n  const totalPct = Math.round(totalOk/totalN*100);\n  const pass = totalPct >= 60 && !anyFail;\n  $('scoreTable').innerHTML =\n    `<tr><th>과목</th><th>문항 수</th><th>정답 수</th><th>정답률</th></tr>${rows}\n     <tr class=\"total\"><td>총계</td><td>${totalN}</td><td>${totalOk}</td><td class=\"${totalPct<60?'bad':''}\">${totalPct}%</td></tr>`;\n  $('verdict').textContent = pass ? '합격권입니다! 🎉' : '아쉽지만 불합격권입니다';\n  $('verdict').className = 'verdict ' + (pass?'pass':'fail');\n  document.querySelector('.verdict-sub').innerHTML =\n    `합격 기준: 전 과목 총점의 60% 이상 &amp; 매 과목 40% 이상 (실제 필기시험 기준)<br>${timeLine}`;\n  setReviewFilter('wrong');\n}\nfunction savePDF(mode){\n  // mode: 'wrong'(틀린 문제 해설) | 'all'(전체 문항 해설). 인쇄 시 오답풀이 영역만 출력됨\n  mode = (mode === 'all') ? 'all' : 'wrong';\n  setReviewFilter(mode);\n  const name = ($('exName') && $('exName').textContent) || '소소숲';\n  const title = ($('exTitle') && $('exTitle').textContent) || (typeof EXAM_TITLE !== 'undefined' ? EXAM_TITLE : '언어재활사 CBT 연습');\n  const label = (mode === 'all') ? '전체 해설' : '오답풀이';\n  document.querySelector('#printHeader h1').textContent = `${title} — ${label}`;\n  $('printMeta').textContent = `${name} · ${new Date().toLocaleDateString('ko-KR')}`;\n  setTimeout(() => window.print(), 100);\n}\nfunction setReviewFilter(mode){\n  const area = $('reviewArea');\n  const graded = q => q.answer>=1 && q.answer<=5;\n  const items = Q.map((q,i)=>({q,i})).filter(({q,i}) => mode==='all' || (graded(q) && answers[i]!==q.answer));\n  if(!items.length){\n    area.innerHTML = '<div class=\"rv-card\" style=\"text-align:center;color:#1a7f37;font-weight:700;\">틀린 문제가 없습니다! 완벽해요 👏</div>';\n    return;\n  }\n  area.innerHTML = `<div style=\"text-align:center;color:#68738a;margin-bottom:12px;font-size:14px;\">${mode==='all'?'전체':'틀린'} 문제 해설 (${items.length}문항)</div>` +\n    items.map(({q,i})=>{\n      const my = answers[i], g = graded(q);\n      const badge = !g ? '<span class=\"rv-badge skip\">정답 미설정</span>'\n                  : !my ? '<span class=\"rv-badge skip\">안 품</span>'\n                  : my===q.answer ? '<span class=\"rv-badge ok\">정답</span>'\n                  : '<span class=\"rv-badge no\">오답</span>';\n      return `<div class=\"rv-card\">\n        <div class=\"rv-head\">${badge}<b>${i+1}.</b> ${esc(q.q)} <span class=\"subj\" style=\"font-size:12px;color:#33518e;\">[${esc(q.subject)}]</span></div>\n        ${q.stem?`<div class=\"rv-stem\">${fmt(q.stem)}</div>`:''}\n        ${q.image?`<div class=\"qimg-wrap\"><img class=\"qimg\" src=\"${esc(q.image)}\" alt=\"문항 자료 이미지\" title=\"클릭하면 크게 볼 수 있습니다\" onclick=\"openImg(this.src)\"><div class=\"qimg-hint\"><button type=\"button\" class=\"qimg-btn\" onclick=\"openImg(this.closest('.qimg-wrap').querySelector('img').src)\">&#128269; 크게 보기</button></div></div>`:''}\n        <ul class=\"rv-choices\">\n          ${q.choices.map((c,ci)=>{\n            const cls = [g&&ci+1===q.answer?'correct':'', my===ci+1?('mine'+(g&&my!==q.answer?' wrong':'')):''].join(' ');\n            return `<li class=\"${cls}\">${circled(ci)} ${esc(c)}${g&&ci+1===q.answer?' ✔':''}${g&&my===ci+1&&my!==q.answer?' ← 내 답':''}${!g&&my===ci+1?' ← 내 답':''}</li>`;\n          }).join('')}\n        </ul>\n        ${q.explain?`<div class=\"rv-explain\"><b>해설</b> · ${esc(q.explain)}</div>`:''}\n      </div>`;\n    }).join('');\n  window.scrollTo(0,0);\n}\n\n</script>\n<script>\n// PC 안내에 지금 접속한 주소를 그대로 표시(소소숲·Vercel 등 배포처가 여럿이라 고정하지 않음)\n(function(){var e=document.getElementById('pcOnlyUrl');\n if(e) e.textContent = location.host + location.pathname.replace(/\\/index\\.html$/,'');})();\n</script>\n</body>\n</html>\n"