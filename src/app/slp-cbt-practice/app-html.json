"<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>언어재활사 CBT 연습</title>\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css\">\n<style>\n:root{\n  /* 새 팔레트 · 민트 + 코발트 · 소프트 뉴브루탈리즘(얇은 검정 테두리 · 각진 모서리 · 그림자 없음) */\n  --mint:#12B5A5; --mint-soft:#e1f6f2; --mint-d:#0e9488;\n  --pop:#3B5BDB;  --pop-soft:#e5e9fb; --pop-d:#2f49b0;\n  --ink:#1a1a1a;  --gray:#6b7280;\n  --red:#e0342a;  --amber:#e8931c;\n  --bg:#e9e9e4;   --paper:#fff;\n  --bd:1.5px solid var(--ink);\n  /* ── 레거시 변수명 호환(인라인 스타일 대비) ── */\n  --navy:#1a1a1a; --navy-d:#000; --navy-btn:#3B5BDB;\n  --blue:#3B5BDB; --blue-l:#e5e9fb; --teal:#12B5A5;\n  --line:#1a1a1a; --omr:#12B5A5; --canvas:#fff; --pearl:#f4f4ef;\n  --ink-muted:#6b7280;\n}\n*{margin:0;padding:0;box-sizing:border-box;}\nhtml,body{height:100%;}\nbody{font-family:\"Pretendard Variable\",Pretendard,\"Apple SD Gothic Neo\",\"Malgun Gothic\",sans-serif;background:var(--paper);color:var(--ink);overflow:hidden;}\nbutton{font-family:inherit;cursor:pointer;}\n.hidden{display:none!important;}\n\n/* ───── 시작(로그인) 화면 ───── */\n#startScreen{height:100vh;display:flex;flex-direction:column;overflow:auto;background:var(--bg);}\n.start-top{background:#fff;color:var(--ink);display:flex;align-items:center;justify-content:space-between;padding:12px 22px;min-height:64px;border-bottom:var(--bd);flex-shrink:0;}\n.start-top .clockbox{text-align:right;font-size:13px;line-height:1.5;font-weight:600;}\n.login-wrap{max-width:900px;margin:26px auto;background:#fff;border:var(--bd);overflow:hidden;width:94%;flex-shrink:0;}\n.login-title{background:var(--mint);color:#fff;text-align:center;font-size:24px;font-weight:900;padding:15px;border-bottom:var(--bd);}\n.login-body{padding:24px 30px;}\n.login-notice{background:var(--mint-soft);border:var(--bd);text-align:center;padding:15px;font-weight:800;margin-bottom:20px;color:var(--ink);}\n.login-table{display:flex;gap:0;border:var(--bd);}\n.photo-col{width:170px;border-right:var(--bd);display:flex;flex-direction:column;}\n.photo{flex:1;display:flex;align-items:center;justify-content:center;background:#f4f4ef;font-size:60px;color:#b6c0ae;min-height:160px;}\n.seat{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px;border-top:var(--bd);}\n.seat-circle{width:82px;height:82px;background:var(--mint);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:900;border:var(--bd);}\n.seat-circle small{font-size:11px;font-weight:700;}\n.seat-circle span{font-size:28px;line-height:1;}\n.info-col{flex:1;}\n.info-row{display:flex;border-bottom:var(--bd);min-height:50px;}\n.info-row:last-child{border-bottom:none;}\n.info-row .th{width:150px;background:#f4f4ef;color:var(--ink);font-weight:800;display:flex;align-items:center;padding-left:16px;border-right:var(--bd);}\n.info-row .td{flex:1;display:flex;align-items:center;padding-left:14px;gap:8px;flex-wrap:wrap;}\n.info-row input[type=text]{border:var(--bd);padding:8px 10px;font-size:15px;width:220px;background:#fff;}\n.info-row input[type=text]::placeholder{color:var(--gray);opacity:.55;}\n.info-row-name{min-height:78px;}\n.info-row-name .td{flex-direction:column;align-items:flex-start;justify-content:center;gap:6px;padding-top:10px;padding-bottom:10px;}\n.name-hint{font-size:12px;color:var(--gray);width:100%;}\n.sess-btn{border:var(--bd);background:#fff;padding:9px 15px;font-size:13.5px;font-weight:700;color:var(--ink);}\n.sess-btn.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.login-foot{background:#f4f4ef;padding:18px;text-align:center;border-top:var(--bd);}\n.login-btn{background:var(--pop);color:#fff;border:var(--bd);border-color:var(--pop);font-size:19px;font-weight:900;padding:13px 64px;}\n.login-btn:hover{background:var(--pop-d);}\n.start-hint{font-size:12.5px;color:var(--gray);margin-top:10px;line-height:1.6;}\n.disclaimer{font-size:11.5px;color:#9aa08f;margin-top:14px;padding-top:12px;border-top:1px dashed #c9c9bf;line-height:1.6;}\n\n/* ───── 시험 화면 레이아웃 ───── */\n#examScreen{height:100vh;display:flex;flex-direction:column;}\n.exam-header{background:#fff;color:var(--ink);display:flex;align-items:center;justify-content:space-between;padding:0 16px;height:62px;flex:0 0 62px;border-bottom:var(--bd);}\n.eh-left{display:flex;align-items:center;gap:10px;}\n.seat-mini{width:40px;height:40px;background:var(--mint);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:900;border:var(--bd);}\n.eh-left .who{font-size:12.5px;line-height:1.5;}\n.eh-title{font-size:18px;font-weight:900;position:absolute;left:50%;transform:translateX(-50%);white-space:nowrap;}\n.eh-right{display:flex;align-items:center;gap:12px;}\n.util-label{font-size:11px;text-align:center;line-height:1.2;color:var(--gray);font-weight:700;}\n.font-btns,.layout-btns{display:flex;gap:5px;align-items:flex-end;}\n.fbtn{width:42px;border:var(--bd);background:#fff;color:var(--ink);padding:6px 0 3px;display:flex;flex-direction:column;align-items:center;font-weight:800;}\n.fbtn small{font-size:9px;color:var(--gray);}\n.fbtn.f80{font-size:13px;} .fbtn.f100{font-size:16px;} .fbtn.f125{font-size:19px;}\n.fbtn.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.fbtn.active small{color:#fff;}\n.lbtn{width:38px;height:38px;border:var(--bd);background:#fff;padding:5px;display:flex;gap:3px;}\n.lbtn div{flex:1;background:var(--mint);}\n.lbtn.active{background:var(--pop);border-color:var(--pop);} .lbtn.active div{background:#fff;}\n.divider{width:1.5px;height:36px;background:var(--ink);}\n.timerbox{display:flex;align-items:center;gap:8px;}\n.clock-ic{width:36px;height:36px;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;border:var(--bd);}\n.timerbox .txt{font-size:12.5px;line-height:1.5;font-weight:600;}\n.timerbox .remain{color:var(--ink);font-weight:800;}\n.timerbox .remain b{background:var(--red);color:#fff;padding:0 5px;font-size:14px;}\n\n.exam-main{flex:1;display:flex;min-height:0;}\n/* 왼쪽 세로 툴바 */\n.leftbar{flex:0 0 auto;width:158px;background:#fafafa;border-right:var(--bd);display:flex;flex-direction:column;gap:12px;padding:12px 8px;overflow-y:auto;}\n.toolv{border:var(--bd);background:#fff;color:var(--ink);font-weight:800;font-size:13px;padding:10px 4px;display:flex;flex-direction:column;align-items:center;gap:4px;}\n.toolv .tv-ic{font-size:18px;line-height:1;}\n.toolv:hover{background:var(--mint-soft);}\n.toolgroup{border:var(--bd);background:#fff;padding:8px;display:flex;flex-direction:column;gap:6px;align-items:center;}\n.toollabel{font-size:11px;font-weight:800;color:var(--gray);}\n.leftbar .font-btns{gap:4px;} .leftbar .fbtn{width:38px;}\n/* 문제 컬럼 + 상단 진행바 */\n.paper-col{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0;}\n.progline{flex:0 0 auto;display:flex;align-items:center;gap:12px;padding:10px 18px;border-bottom:var(--bd);background:#fff;}\n.prognum{font-weight:800;font-size:13px;white-space:nowrap;color:var(--ink);}\n.progwrap{flex:1;height:12px;border:var(--bd);background:#fff;overflow:hidden;}\n.progbar{height:100%;width:0%;background:var(--pop);transition:width .2s;}\n.paper{flex:1;background:#fff;overflow-y:auto;padding:18px 20px;min-width:0;}\n.paper-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 24px;}\n.paper-grid.one{grid-template-columns:1fr;max-width:820px;margin:0 auto;}\n.qcol{border-right:none;padding-right:0;}\n.paper-grid.one .qcol,.qcol:last-child{border-right:none;padding-right:0;}\n\n.qcard{background:#fff;border:var(--bd);padding:16px 18px 20px;margin-bottom:16px;}\n.qtools{display:flex;flex-direction:column;align-items:flex-end;gap:4px;margin-bottom:6px;}\n.qtools-row{display:flex;gap:6px;}\n.tool-btn{border:var(--bd);background:#fff;color:var(--ink);font-size:12px;padding:4px 10px;font-weight:700;display:flex;align-items:center;gap:4px;}\n.tool-btn.on{background:var(--pop);color:#fff;border-color:var(--pop);}\n.tool-btn.memo-on{background:var(--amber);color:#fff;border-color:var(--amber);}\n.tool-btn.pen-on{background:#e8a400;color:#fff;border-color:#e8a400;}\n.qhead{font-weight:800;font-size:1.05em;display:flex;gap:8px;margin-bottom:10px;line-height:1.55;}\n.qhead .subj{color:#fff;font-size:.78em;font-weight:800;background:var(--mint);padding:3px 10px;align-self:flex-start;margin-top:2px;white-space:nowrap;}\n.stem{border:var(--bd);padding:12px 14px;margin:0 0 12px;line-height:1.7;background:var(--mint-soft);white-space:pre-wrap;}\n.qimg-wrap{margin:0 0 12px;}\n.qimg{max-width:100%;max-height:220px;width:auto;height:auto;border:var(--bd);display:block;cursor:zoom-in;background:#fff;}  /* 문제 화면은 작게, 크게 보기는 팝업 창에서 */\n.qimg-hint{margin-top:6px;}\n.qimg-btn{border:var(--bd);background:#fff;padding:4px 10px;font-size:12.5px;font-weight:700;color:var(--ink);cursor:pointer;}\n.qimg-btn:hover{background:var(--mint-soft);}\n/* 문항 이미지 크게 보기(팝업) */\nu.ul{text-decoration:underline;text-decoration-thickness:1.5px;text-underline-offset:4px;}\n/* 문항 이미지 창 — 제목줄 끌어 이동, 오른쪽 아래 모서리 끌어 크기조절(모바일은 전체화면) */\n#imgWin{z-index:70;display:flex;flex-direction:column;min-width:260px;min-height:180px;box-shadow:0 10px 30px rgba(0,0,0,.3);}\n#imgWin .iw-tip{font-weight:500;font-size:12px;opacity:.85;margin-left:10px;}\n#imgWin .iw-body{flex:1;min-height:0;background:#fff;padding:8px;display:flex;align-items:center;justify-content:center;}\n#imgWin .iw-body img{width:100%;height:100%;object-fit:contain;display:block;}\n#imgWin .iw-grip{position:absolute;right:0;bottom:0;width:22px;height:22px;cursor:nwse-resize;background:linear-gradient(135deg,transparent 0 50%,#555 50% 58%,transparent 58% 68%,#555 68% 76%,transparent 76%);}\n@media (max-width:699px){ #imgWin .iw-grip,#imgWin .iw-tip{display:none;} }\n.choices{list-style:none;}\n.choices li{display:flex;align-items:flex-start;gap:9px;padding:9px 11px;line-height:1.6;border:var(--bd);margin-bottom:7px;background:#fff;}\n.choices li .num{flex:0 0 auto;width:1.6em;height:1.6em;border:var(--bd);display:flex;align-items:center;justify-content:center;font-size:.85em;font-weight:800;margin-top:.05em;}\n.choices li .ctext{flex:1;cursor:pointer;}\n.choices li:hover{background:#f7f7f2;}\n.choices li.sel{background:var(--pop-soft);border-color:var(--pop);}\n.choices li.sel .num{background:var(--pop);color:#fff;border-color:var(--pop);}\n.choices li.sel .ctext{font-weight:800;}\n.choices li.strike .ctext{color:#b0b0b0;text-decoration:line-through;}\n.choices li.strike .num{border-color:#b0b0b0;color:#b0b0b0;}\n.strike-btn{flex:0 0 auto;border:var(--bd);background:#fff;color:var(--gray);font-size:11px;padding:2px 7px;margin-top:2px;}\n.strike-btn.on{background:var(--ink);color:#fff;border-color:var(--ink);}\n\n/* OMR */\n.omr{flex:0 0 208px;background:#fafafa;border-right:var(--bd);display:flex;flex-direction:column;}\n.omr-tools{display:flex;gap:6px;padding:8px 8px 0;}\n.omr-tools button{flex:1;border:var(--bd);background:#fff;padding:6px 0;font-size:12px;font-weight:800;color:var(--ink);}\n.omr-tools button:hover{background:var(--mint-soft);}\n.omr-title{background:var(--mint);color:#fff;text-align:center;font-weight:900;padding:10px;font-size:15px;flex:0 0 auto;border-bottom:var(--bd);}\n.omr-list{flex:1;overflow-y:auto;padding-bottom:10px;}\n.omr-row{display:flex;align-items:center;padding:4px 6px 4px 4px;}\n.omr-row.sep{border-bottom:1px dashed var(--mint);}\n.omr-row .flags{width:26px;display:flex;flex-direction:column;font-size:10px;line-height:1;gap:1px;align-items:center;color:var(--amber);}\n.omr-row .flags .chk{color:var(--red);}\n.omr-row .no{width:26px;text-align:center;color:var(--ink);font-weight:800;font-size:13px;background:#fff;border:var(--bd);padding:3px 0;margin-right:5px;cursor:pointer;}\n.omr-row.cur .no{background:var(--pop);color:#fff;border-color:var(--pop);}\n.omr-row .bubbles{display:flex;gap:4px;}\n.bub{width:22px;height:22px;border:var(--bd);color:var(--ink);background:#fff;font-size:11px;display:flex;align-items:center;justify-content:center;padding:0;}\n.bub.mark{background:var(--pop);border-color:var(--pop);color:#fff;}\n\n/* 하단바 */\n.exam-footer{background:#f4f4ef;border-top:var(--bd);display:flex;align-items:center;justify-content:space-between;padding:0 12px;height:60px;flex:0 0 60px;gap:8px;}\n.ef-group{display:flex;align-items:center;gap:8px;}\n.wbtn{background:#fff;border:var(--bd);padding:9px 15px;font-size:13.5px;font-weight:700;color:var(--ink);}\n.wbtn:hover{background:var(--mint-soft);}\n.wbtn.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.pager{display:flex;align-items:center;gap:10px;font-size:16px;font-weight:800;}\n.pager .pbtn{background:#fff;border:var(--bd);padding:9px 16px;font-size:14px;font-weight:800;color:var(--ink);}\n.pager .pbtn:hover{background:var(--mint-soft);}\n.submit-btn{background:var(--pop);color:#fff;border:var(--bd);border-color:var(--pop);padding:11px 20px;font-size:14px;font-weight:800;}\n.submit-btn:hover{background:var(--pop-d);}\n\n/* 모달 */\n.overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;z-index:90;}\n.modal{background:#fff;border:var(--bd);min-width:340px;max-width:560px;overflow:hidden;}\n.modal-head{background:var(--red);color:#fff;font-weight:900;text-align:center;padding:12px;position:relative;font-size:16px;border-bottom:var(--bd);}\n.modal-head.blue{background:var(--pop);}\n.modal-head .x{position:absolute;right:10px;top:8px;background:none;border:none;color:#fff;font-size:20px;}\n.modal-body{padding:24px 28px;text-align:center;font-size:15.5px;line-height:1.7;}\n.modal-body .big-clock{width:54px;height:54px;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 14px;border:var(--bd);}\n.modal-foot{padding:0 0 20px;text-align:center;display:flex;gap:10px;justify-content:center;}\n.m-btn{border:var(--bd);padding:10px 24px;font-size:14px;font-weight:800;color:#fff;background:var(--red);border-color:var(--red);}\n.m-btn.gray{background:var(--gray);border-color:var(--gray);}\n.m-btn.blue{background:var(--pop);border-color:var(--pop);}\n/* 일시정지: 문제를 가리도록 불투명 배경, 떠 있는 창·모달보다 위 */\n.pause-overlay{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:95;}\n.pause-overlay .modal-body .big-clock{background:var(--pop);}\n/* 제출 완료 창은 버튼이 셋이라 조금 넓게 */\n#submittedOverlay .modal{min-width:480px;}\n#submittedOverlay .modal-foot{padding:0 24px 22px;}\n#submittedOverlay .m-btn{padding:10px 18px;}\n\n/* 메모/계산기/그림판 */\n.float-win{position:fixed;z-index:60;background:#fff;border:var(--bd);overflow:hidden;}\n.fw-head{background:var(--mint);color:#fff;padding:9px 12px;font-weight:800;cursor:move;display:flex;justify-content:space-between;align-items:center;font-size:14px;border-bottom:var(--bd);}\n.fw-head button{background:none;border:none;color:#fff;font-size:17px;}\n#memoText{width:320px;height:180px;border:none;outline:none;padding:12px;font-size:14px;resize:none;font-family:inherit;}\n.calc-body{padding:10px;width:230px;}\n#calcDisp{width:100%;border:var(--bd);text-align:right;font-size:22px;padding:8px;margin-bottom:8px;font-family:inherit;}\n.calc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;}\n.calc-grid button{padding:11px 0;font-size:16px;border:var(--bd);background:#fff;font-weight:700;}\n.calc-grid button.op{background:var(--mint-soft);font-weight:800;}\n.calc-grid button.eq{background:var(--pop);color:#fff;border-color:var(--pop);grid-column:span 2;}\n#padCanvas{display:block;background:#fff;cursor:crosshair;}\n.pad-tools{display:flex;gap:6px;padding:8px;background:var(--mint-soft);border-bottom:var(--bd);}\n.pad-tools button{border:var(--bd);background:#fff;padding:5px 12px;font-size:13px;font-weight:700;}\n.pad-tools button.on{background:var(--pop);color:#fff;border-color:var(--pop);}\n\n/* 결과 화면 */\n#resultScreen{height:100vh;overflow-y:auto;background:var(--bg);}\n.res-wrap{max-width:860px;margin:26px auto 60px;width:94%;}\n.res-card{background:#fff;border:var(--bd);overflow:hidden;margin-bottom:20px;}\n.res-title{background:var(--mint);color:#fff;font-size:21px;font-weight:900;text-align:center;padding:15px;border-bottom:var(--bd);}\n.res-body{padding:26px 30px;}\n.verdict{text-align:center;font-size:30px;font-weight:900;margin-bottom:6px;}\n.verdict.pass{color:var(--mint-d);} .verdict.fail{color:var(--red);}\n.verdict-sub{text-align:center;color:var(--gray);margin-bottom:20px;font-size:13.5px;line-height:1.6;}\ntable.score{width:100%;border-collapse:collapse;font-size:14.5px;}\ntable.score th,table.score td{border:var(--bd);padding:10px;text-align:center;}\ntable.score th{background:var(--mint-soft);color:var(--ink);font-weight:800;}\ntable.score td.bad{color:var(--red);font-weight:800;}\ntable.score tr.total td{font-weight:900;background:#f4f4ef;}\n.res-actions{display:flex;gap:10px;justify-content:center;margin-top:24px;flex-wrap:wrap;}\n.review-filter{display:flex;gap:8px;justify-content:center;margin-bottom:18px;}\n.rv-card{background:#fff;border:var(--bd);padding:20px 22px;margin-bottom:14px;}\n.rv-card .rv-head{font-weight:800;margin-bottom:8px;line-height:1.6;}\n.rv-badge{display:inline-block;font-size:12px;font-weight:800;padding:2px 8px;margin-right:6px;color:#fff;border:var(--bd);}\n.rv-badge.ok{background:var(--mint-d);border-color:var(--mint-d);} .rv-badge.no{background:var(--red);border-color:var(--red);} .rv-badge.skip{background:var(--gray);border-color:var(--gray);}\n.rv-stem{border:var(--bd);padding:10px 12px;margin-bottom:10px;line-height:1.6;font-size:14px;background:var(--mint-soft);white-space:pre-wrap;}\n.rv-choices{list-style:none;font-size:14.5px;line-height:1.8;margin-bottom:10px;}\n.rv-choices li.correct{color:var(--mint-d);font-weight:800;}\n.rv-choices li.mine{text-decoration:underline;}\n.rv-choices li.mine.wrong{color:var(--red);font-weight:800;}\n.rv-explain{background:var(--mint-soft);border:var(--bd);border-left:5px solid var(--mint);padding:10px 14px;font-size:14px;line-height:1.7;}\n/* 상세해설(정답 근거·오답 점검) — 버튼 하나로 모든 문항이 함께 펼쳐지고 접힌다 */\n.rv-dbtn-row{margin:8px 0 0;}\n.rv-dbtn{padding:6px 12px;font-size:12.5px;}\n.rv-dbtn .d-close{display:none;}\nhtml.show-detail .rv-dbtn .d-open{display:none;} html.show-detail .rv-dbtn .d-close{display:inline;}\n.rv-detail{display:none;margin-top:8px;background:#fff;border:var(--bd);border-left:5px solid var(--mint);padding:10px 14px;font-size:14px;line-height:1.7;}\nhtml.show-detail .rv-detail{display:block;}\n.rv-detail ul{list-style:none;margin:4px 0 0;padding:0;}\n.rv-detail li{margin:4px 0;padding-left:1.4em;text-indent:-1.4em;}\n.rv-detail .rv-dt{margin-bottom:8px;}\n/* 문항 태그(분류·세부 영역·유형 키워드·출제 포인트·핵심개념) — 정식판·베타 */\n.rv-tags{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 6px;}\n.rv-tags span{font-size:12px;font-weight:800;padding:2px 9px;border:1px solid currentColor;line-height:1.6;}\n.rv-tags .tg-cat{color:var(--pop);} .rv-tags .tg-area{color:var(--mint-d);} .rv-tags .tg-kw{color:var(--ink);border-color:#c9c9bf;font-weight:700;}\n.rv-meta{font-size:13.5px;line-height:1.7;margin-bottom:8px;padding:8px 12px;background:#fff;border:1px dashed #c9c9bf;}\n.rv-meta div + div{margin-top:2px;}\n.rv-meta b{color:var(--pop);margin-right:4px;}\n/* 오답노트 약점 그래프 */\n.wk-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;}\n.wk-card{background:#fff;border:var(--bd);padding:12px 14px;}\n.wk-card h3{font-size:15px;margin:0 0 4px;display:flex;justify-content:space-between;align-items:baseline;gap:8px;}\n.wk-card h3 button{border:none;background:none;color:var(--pop);font-size:12.5px;font-weight:700;padding:0;text-decoration:underline;}\n.wk-cats{font-size:12.5px;color:var(--gray);margin-bottom:8px;}\n.wk-row{display:grid;grid-template-columns:128px 1fr 92px;gap:8px;align-items:center;font-size:12.5px;padding:3px 0;}\n.wk-row.click{cursor:pointer;} .wk-row.click:hover .wk-lbl{text-decoration:underline;}\n.wk-row.on .wk-lbl{color:var(--pop);font-weight:800;}\n.wk-lbl{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n.wk-bar{height:12px;background:#ecece6;position:relative;}\n.wk-bar i{position:absolute;left:0;top:0;bottom:0;background:var(--mint);}\n.wk-row.hot .wk-bar i{background:var(--red);} .wk-row.hot .wk-lbl{font-weight:800;}\n.wk-row.few{color:#a3a39a;} .wk-row.few .wk-bar i{background:#d6d6cc;}\n.wk-val{text-align:right;white-space:nowrap;}\n.wk-big .wk-row{grid-template-columns:170px 1fr 110px;font-size:13.5px;padding:4px 0;}\n.wk-big .wk-bar{height:16px;}\n.wk-sub{font-size:13px;font-weight:800;margin:12px 0 4px;color:var(--ink);}\n.wk-note{font-size:12.5px;color:var(--gray);margin-top:6px;line-height:1.6;}\n.wk-chip{display:inline-flex;gap:6px;align-items:center;font-size:12.5px;font-weight:700;border:1px solid var(--pop);color:var(--pop);padding:2px 8px;margin-left:6px;}\n.res-area{margin-top:18px;}\n.res-area h3.ra-h{font-size:15px;margin:0 0 4px;}\n.res-area .wk-grid{grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr));}\n.wk-chip button{border:none;background:none;color:inherit;padding:0;font-weight:800;}\n\n/* 문제 보기 모달 */\n.viewer{background:#fff;border:var(--bd);width:95vw;max-width:1120px;height:92vh;display:flex;flex-direction:column;overflow:hidden;}\n.viewer-head{background:var(--mint);color:#fff;font-size:19px;font-weight:900;text-align:center;padding:14px;position:relative;flex:0 0 auto;border-bottom:var(--bd);}\n.viewer-head .x{position:absolute;right:14px;top:10px;background:rgba(255,255,255,.25);border:1.5px solid #fff;color:#fff;font-size:18px;width:30px;height:30px;line-height:1;}\n.viewer-guide{padding:9px 20px;font-size:12.5px;color:var(--ink);background:var(--mint-soft);line-height:1.6;flex:0 0 auto;border-bottom:var(--bd);}\n.viewer-tabs{display:flex;flex:0 0 auto;}\n.v-tab{flex:1;padding:12px;font-size:15px;font-weight:800;border:var(--bd);border-top:none;background:#fff;color:var(--ink);}\n.v-tab.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.viewer-body{flex:1;overflow-y:auto;padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:14px;align-content:start;background:var(--bg);}\n.v-card{border:var(--bd);padding:13px 15px;cursor:pointer;background:#fff;}\n.v-card:hover{outline:2px solid var(--pop);border-color:var(--pop);}\n.v-head{display:flex;gap:8px;font-weight:800;margin-bottom:8px;line-height:1.55;font-size:14.5px;}\n.v-no{flex:0 0 auto;background:var(--pop);color:#fff;min-width:1.7em;height:1.7em;padding:0 .3em;display:flex;align-items:center;justify-content:center;font-size:.9em;border:var(--bd);}\n.v-stem{border:var(--bd);padding:8px 10px;margin-bottom:8px;font-size:12.5px;line-height:1.6;white-space:pre-wrap;background:var(--mint-soft);}\n.v-choices{list-style:none;font-size:13.5px;line-height:1.7;}\n.v-choices li.sel{font-weight:800;color:var(--pop);}\n\n/* 형광펜 */\nmark.hl{background:#ffe94d;color:inherit;padding:0;}\n.wbtn.pen-active{background:#e8a400;color:#fff;border-color:#e8a400;}\n.paper.pen-on .stem,.paper.pen-on .ctext,.paper.pen-on .qhead>span{cursor:text;}\n.paper.pen-on mark.hl{cursor:pointer;}\n@media (max-width:900px){ .eh-title{display:none;} .omr{flex-basis:190px;} }\n@media (max-width:760px){ .viewer-body{grid-template-columns:1fr;} }\n\n/* 인쇄(PDF 저장)용 — 결과 화면의 점수표 + 오답풀이만 출력 */\n/* 인쇄·PDF 저장 막기 — 문항과 해설은 화면에서만 본다. 인쇄하면 안내 문구만 나온다 */\n@media print{\n  html,body{ height:auto!important; overflow:visible!important; background:#fff!important; }\n  body > *{ display:none!important; }\n  body::after{ content:'이 화면은 인쇄하거나 PDF로 저장할 수 없어요. 문항과 해설은 앱 화면에서만 볼 수 있어요.'; display:block; padding:60px 20px; text-align:center; font-size:15px; color:#333; }\n}\n/* 결과·오답노트는 글자 선택·복사를 막는다 */\n#resultScreen, #studyScreen{ -webkit-user-select:none; user-select:none; }\n.copy-note{margin-top:14px;font-size:12.5px;color:#68738a;text-align:center;line-height:1.6;}\n.copy-note a{color:inherit;text-decoration:underline;}\n/* ── 로그인 게이트 ── */\n#authGate{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;background:var(--bg);padding:20px;}\n#authGate.hidden{display:none;}\n.ag-card{width:100%;max-width:380px;background:#fff;border:var(--bd);padding:34px 28px 24px;text-align:center;}\n.ag-logo{font-size:38px;line-height:1;}\n.ag-title{font-size:21px;font-weight:900;color:var(--ink);margin-top:10px;}\n.ag-sub{font-size:13px;color:var(--gray);margin-top:6px;line-height:1.5;}\n.ag-form{margin-top:22px;text-align:left;}\n.ag-label{display:block;font-size:12.5px;font-weight:800;color:var(--ink);margin:14px 2px 6px;}\n.ag-form input{width:100%;box-sizing:border-box;padding:12px 13px;border:var(--bd);font-size:15px;background:#fff;outline:none;}\n.ag-form input:focus{border-color:var(--pop);}\n.ag-err{min-height:18px;font-size:12.5px;color:var(--red);margin:10px 2px 0;line-height:1.4;}\n.ag-btn{width:100%;margin-top:8px;padding:13px;border:var(--bd);border-color:var(--mint);background:var(--mint);color:#fff;font-size:16px;font-weight:900;cursor:pointer;}\n.ag-btn:hover{background:var(--mint-d);}\n.ag-btn:disabled{opacity:.6;cursor:default;}\n.ag-note{margin-top:20px;font-size:11.5px;color:var(--gray);line-height:1.6;border-top:var(--bd);padding-top:15px;}\n.logout-btn{border:var(--bd);background:#fff;color:var(--ink);padding:7px 14px;font-size:12.5px;font-weight:700;cursor:pointer;white-space:nowrap;}\n.logout-btn:hover{background:var(--mint-soft);}\n\n/* ───── 대문(첫 화면) — 소소숲 정식판에서만 켠다(window.SHOW_HOME) ───── */\n#homeScreen{height:100vh;display:flex;flex-direction:column;overflow:auto;background:var(--bg);}\n.home-wrap{max-width:900px;width:94%;margin:26px auto 40px;display:flex;flex-direction:column;gap:18px;flex-shrink:0;}\n.home-hero{background:#fff;border:var(--bd);display:flex;align-items:stretch;}\n.home-hero-main{flex:1;padding:24px 28px;}\n.home-kicker{font-size:13px;font-weight:800;color:var(--mint-d);letter-spacing:.02em;}\n.home-hero h1{font-size:25px;font-weight:900;margin:6px 0 8px;line-height:1.35;}\n.home-hero-sub{font-size:14px;color:var(--gray);line-height:1.6;}\n.home-hero-sub b{color:var(--ink);}\n.home-dday{width:210px;flex-shrink:0;background:var(--mint);color:#fff;border-left:var(--bd);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:18px;text-align:center;}\n.home-dday small{font-size:13px;font-weight:700;opacity:.92;}\n.home-dday b{font-size:46px;font-weight:900;line-height:1.1;margin:4px 0;letter-spacing:-.01em;}\n.home-dday span{font-size:12.5px;font-weight:700;opacity:.92;}\n.home-cta{display:flex;justify-content:center;}\n.home-start{background:var(--pop);color:#fff;border:var(--bd);border-color:var(--pop);font-size:20px;font-weight:900;padding:15px 70px;}\n.home-start:hover{background:var(--pop-d);}\n.home-card{background:#fff;border:var(--bd);}\n.home-card h2{font-size:17px;font-weight:900;padding:13px 20px;border-bottom:var(--bd);background:#f4f4ef;display:flex;align-items:center;justify-content:space-between;gap:10px;}\n.home-card h2 small{font-size:12px;font-weight:600;color:var(--gray);}\n.home-card-body{padding:16px 20px;}\n.home-tbl{width:100%;border-collapse:collapse;font-size:14px;}\n.home-tbl th,.home-tbl td{border:1px solid #c9c9bf;padding:9px 12px;text-align:left;vertical-align:middle;line-height:1.5;}\n.home-tbl th{background:#f4f4ef;font-weight:800;white-space:nowrap;}\n.home-tbl td.num{text-align:center;white-space:nowrap;}\n.home-tbl tr.is-next td{background:var(--mint-soft);font-weight:700;}\n.home-tbl tr.is-done td{color:#9aa08f;}\n.home-tag{display:inline-block;font-size:11.5px;font-weight:800;padding:2px 8px;border:1px solid currentColor;white-space:nowrap;}\n.home-tag.done{color:#9aa08f;}\n.home-tag.now{color:var(--red);}\n.home-tag.next{color:var(--mint-d);}\n.home-tag.plan{color:var(--gray);}\n.home-grade-tabs{display:flex;gap:6px;margin-bottom:12px;}\n.home-grade-tabs button{border:var(--bd);background:#fff;padding:7px 18px;font-size:13.5px;font-weight:800;}\n.home-grade-tabs button.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.home-list{list-style:none;display:flex;flex-direction:column;gap:9px;font-size:14px;line-height:1.6;}\n.home-list li{padding-left:16px;position:relative;}\n.home-list li::before{content:'';position:absolute;left:2px;top:.62em;width:6px;height:6px;background:var(--mint);}\n.home-list li b{font-weight:800;}\n.home-video{display:flex;align-items:center;gap:14px;margin-top:16px;padding:13px 16px;border:var(--bd);background:var(--pop-soft);color:var(--ink);text-decoration:none;}\n.home-video:hover{background:#d6ddf8;}\n.home-video-ic{width:44px;height:44px;flex-shrink:0;background:var(--pop);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;border:var(--bd);border-color:var(--pop);}\n.home-video b{display:block;font-size:14.5px;font-weight:900;}\n.home-video small{font-size:12.5px;color:var(--gray);}\n.home-links{display:flex;flex-wrap:wrap;gap:8px;}\n.home-links a{border:var(--bd);background:#fff;color:var(--ink);text-decoration:none;font-size:13px;font-weight:700;padding:8px 13px;}\n.home-links a:hover{background:var(--mint-soft);}\n.home-note{font-size:12.5px;color:var(--gray);margin-top:10px;line-height:1.6;}\n.home-back{border:var(--bd);background:#fff;color:var(--ink);padding:7px 14px;font-size:12.5px;font-weight:700;white-space:nowrap;}\n.home-back:hover{background:var(--mint-soft);}\n.home-tbl-wrap{overflow-x:auto;}\n\n/* ───── 내 학습 기록(오답노트·응시 기록) — 정식판 전용 ───── */\n#studyScreen{height:100vh;display:flex;flex-direction:column;overflow:auto;background:var(--bg);}\n.hs-line{font-size:14px;line-height:1.7;}\n.hs-line + .hs-line{margin-top:4px;}\n.hs-empty{font-size:14px;color:var(--gray);line-height:1.7;}\n.hs-btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;}\n.hs-btns .wbtn b{color:var(--pop);}\n.risk-tag{display:inline-block;font-size:11.5px;font-weight:800;padding:1px 7px;border:1px solid currentColor;white-space:nowrap;margin-right:4px;}\n.risk-tag.fail{color:var(--red);} .risk-tag.warn{color:#b86a00;} .risk-tag.ok{color:var(--mint-d);}\n.st-tabs{display:flex;gap:6px;}\n.st-tabs button{border:var(--bd);background:#fff;padding:10px 22px;font-size:15px;font-weight:900;}\n.st-tabs button.active{background:var(--ink);color:#fff;}\n.st-filter{display:flex;flex-wrap:wrap;gap:6px;align-items:center;}\n.st-filter .lbl{font-size:12.5px;font-weight:800;color:var(--gray);margin-right:4px;min-width:30px;}\n.st-filter button{border:var(--bd);background:#fff;padding:6px 12px;font-size:13px;font-weight:700;}\n.st-filter button.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.st-filter + .st-filter{margin-top:8px;}\n.st-drill{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:14px;padding-top:14px;border-top:1px solid #d6d6cc;font-size:13px;color:var(--gray);}\n.sw-item{background:#fff;border:var(--bd);padding:14px 18px;}\n.sw-item + .sw-item{margin-top:10px;}\n.sw-meta{font-size:12.5px;color:var(--gray);display:flex;flex-wrap:wrap;gap:4px 10px;align-items:center;}\n.sw-meta b{color:var(--ink);font-size:13px;}\n.sw-n{color:var(--red);font-weight:800;}\n.sw-tag{font-size:11.5px;font-weight:700;padding:0 7px;border:1px solid currentColor;line-height:1.6;color:var(--mint-d);}\n.sw-tag.kw{color:var(--ink);border-color:#c9c9bf;}\n.sw-q{margin-top:6px;font-size:14.5px;font-weight:700;line-height:1.55;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}\n.sw-item.open .sw-q{display:block;-webkit-line-clamp:unset;}\n.sw-actions{display:flex;gap:6px;margin-top:10px;}\n.sw-actions .wbtn{padding:6px 12px;font-size:12.5px;}\n.sw-detail{margin-top:12px;}\n.st-clear{border:none;background:none;color:var(--gray);font-size:12.5px;text-decoration:underline;padding:4px;}\n.st-tbl td.bars{min-width:190px;}\n.st-bars{display:flex;align-items:flex-end;gap:3px;height:56px;position:relative;border-bottom:1px solid #9aa08f;}\n.st-bars::before,.st-bars::after{content:'';position:absolute;left:0;right:0;border-top:1px dashed #c9c9bf;}\n.st-bars::before{bottom:40%;} .st-bars::after{bottom:60%;}\n.st-bar{flex:0 0 22px;background:var(--mint);border-radius:4px 4px 0 0;position:relative;z-index:1;min-height:2px;}\n.st-bar:hover{background:var(--mint-d);}\n.st-bar.empty{background:transparent;}\n.st-axis{font-size:11px;color:var(--gray);margin-top:3px;}\n.study-note{margin:-6px 0 18px;padding:10px 14px;border:var(--bd);background:var(--pop-soft);font-size:13.5px;line-height:1.7;text-align:center;}\n.rv-origin{display:inline-block;font-size:12px;font-weight:700;color:var(--gray);margin-right:6px;}\n@media (max-width:720px){\n  .home-hero{flex-direction:column;}\n  .home-dday{width:auto;border-left:none;border-top:var(--bd);flex-direction:row;gap:12px;padding:12px;}\n  .home-dday b{font-size:34px;margin:0;}\n  .home-start{padding:14px 30px;width:100%;}\n  .home-tbl{font-size:13px;}\n  .home-tbl th,.home-tbl td{padding:8px;}\n}\n\n\n/* ── PC 전용 안내 (모바일·세로 태블릿 차단) ────────────────────────\n   터치 기기이면서 화면 폭이 900px 미만일 때만 뜬다.\n   마우스를 쓰는 노트북은 창을 좁혀도 막히지 않고,\n   아이패드는 가로(1024px)로 돌리면 통과한다.\n   화면을 돌리면 미디어쿼리가 다시 판정하므로 별도 스크립트가 없다. */\n#pcOnly{display:none;}\n@media (max-width:899px) and (pointer:coarse){\n  #pcOnly{\n    display:flex;position:fixed;inset:0;z-index:99999;\n    align-items:center;justify-content:center;\n    background:var(--bg,#eeeeea);padding:22px;\n    -webkit-text-size-adjust:100%;\n  }\n  html,body{overflow:hidden!important;}\n}\n.pc-card{width:100%;max-width:340px;background:#fff;border:2px solid #111;padding:32px 22px 24px;text-align:center;}\n.pc-icon{font-size:44px;line-height:1;}\n.pc-title{font-size:20px;font-weight:900;color:#1c1c1a;margin-top:12px;line-height:1.35;}\n.pc-desc{font-size:14px;color:#444;margin-top:14px;line-height:1.7;}\n.pc-url{margin-top:18px;border:1px dashed #999;background:#f7f7f3;padding:12px 10px;font-size:14px;font-weight:800;color:#1c1c1a;word-break:break-all;line-height:1.5;}\n.pc-note{margin-top:18px;border-top:1px solid #ddd;padding-top:14px;font-size:12px;color:#777;line-height:1.7;}\n</style>\n<script>window.SHOW_HOME = true;</script>\n</head>\n<body>\n\n<!-- ═════════ PC 전용 안내 (모바일에서만 표시) ═════════ -->\n<div id=\"pcOnly\">\n  <div class=\"pc-card\">\n    <div class=\"pc-icon\">💻</div>\n    <div class=\"pc-title\">PC에서 이용해 주세요</div>\n    <div class=\"pc-desc\">\n      실제 국가시험은 컴퓨터로 치릅니다.<br>\n      화면 구성과 조작을 그대로 연습하려면<br>\n      PC나 노트북으로 접속해 주세요.\n    </div>\n    <div class=\"pc-url\" id=\"pcOnlyUrl\"></div>\n    <div class=\"pc-note\">※ 위 주소를 PC 브라우저에 입력하시면<br>바로 시작할 수 있어요.</div>\n  </div>\n</div>\n\n\n<!-- ═════════ 시작(로그인) 화면 ═════════ -->\n<!-- ═════════ 로그인 게이트 (베타) ═════════ -->\n<div id=\"authGate\">\n  <div class=\"ag-card\">\n    <div class=\"ag-title\">언어재활사 CBT 연습</div>\n    <div class=\"ag-sub\" id=\"agSub\">베타 테스트 · 발급받은 계정으로 로그인해 주세요</div>\n    <div class=\"ag-form\">\n      <label class=\"ag-label\">아이디</label>\n      <input type=\"text\" id=\"agId\" autocomplete=\"username\" placeholder=\"예: slp01\" spellcheck=\"false\" autocapitalize=\"off\">\n      <label class=\"ag-label\">비밀번호</label>\n      <input type=\"password\" id=\"agPw\" autocomplete=\"current-password\" placeholder=\"비밀번호\" onkeydown=\"if(event.key==='Enter')doLogin()\">\n      <div id=\"agErr\" class=\"ag-err\"></div>\n      <button class=\"ag-btn\" id=\"agBtn\" onclick=\"doLogin()\">로그인</button>\n    </div>\n    <div class=\"ag-note\">※ 계정은 <b>최초 로그인한 기기 1대</b>에서만 사용할 수 있습니다.<br>기기 변경·문의는 관리자에게 연락해 주세요.</div>\n  </div>\n</div>\n\n<!-- ═════════ 대문(첫 화면) · 소소숲 정식판 전용 ═════════ -->\n<div id=\"homeScreen\" class=\"hidden\">\n  <div class=\"start-top\">\n    <div style=\"width:140px;\"></div>\n    <div style=\"font-weight:700;font-size:20px;\">언어재활사 CBT 연습</div>\n    <div style=\"width:140px;\"></div>\n  </div>\n  <div class=\"home-wrap\">\n    <div class=\"home-hero\">\n      <div class=\"home-hero-main\">\n        <div class=\"home-kicker\" id=\"hmKicker\">2026년도 제15회 언어재활사 국가시험</div>\n        <h1 id=\"hmHeadline\">시험일 12월 5일(토)<br>1급·2급 모두 컴퓨터시험(CBT)으로 봅니다</h1>\n        <div class=\"home-hero-sub\" id=\"hmSub\">실제 시험과 같은 교시 구성·제한시간으로 연습해 보세요.<br>시험 전날까지 <b>화면 조작과 시간 배분</b>에 익숙해지는 것이 목표예요.</div>\n      </div>\n      <div class=\"home-dday\" id=\"hmDdayBox\">\n        <small>시험까지</small>\n        <b id=\"hmDday\">D-00</b>\n        <span id=\"hmToday\"></span>\n      </div>\n    </div>\n\n    <div class=\"home-cta\"><button class=\"home-start\" onclick=\"goStart()\">모의 CBT 연습 &rarr;</button></div>\n\n    <div class=\"home-card hidden\" id=\"hmStudyCard\">\n      <h2>내 학습 기록 <small>이 기기에만 저장돼요</small></h2>\n      <div class=\"home-card-body\" id=\"hmStudyBody\"></div>\n    </div>\n\n    <div class=\"home-card\" id=\"hmScheduleCard\">\n      <h2>시험일정 <small>국시원 공고 기준 · 2026년 제15회</small></h2>\n      <div class=\"home-card-body\">\n        <div class=\"home-tbl-wrap\"><table class=\"home-tbl\" id=\"hmSchedule\"></table></div>\n        <div class=\"home-note\">※ 시험장은 11월 4일 공고 후 선택 기간에 직접 고릅니다. 일정은 바뀔 수 있으니 국시원 공지를 꼭 확인하세요.</div>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>교시별 시간표 <small>입장 마감 이후에는 들어갈 수 없어요</small></h2>\n      <div class=\"home-card-body\">\n        <div class=\"home-grade-tabs\">\n          <button class=\"active\" data-hg=\"1\" onclick=\"homeGrade(1)\">1급</button>\n          <button data-hg=\"2\" onclick=\"homeGrade(2)\">2급</button>\n        </div>\n        <div class=\"home-tbl-wrap\"><table class=\"home-tbl\" id=\"hmTimetable\"></table></div>\n        <div class=\"home-note\" id=\"hmTimeNote\"></div>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>합격 기준</h2>\n      <div class=\"home-card-body\">\n        <ul class=\"home-list\">\n          <li><b>전 과목 총점의 60% 이상</b>, 그리고 <b>각 과목 40% 이상</b>을 받아야 합격이에요.</li>\n          <li>한 과목이라도 40% 미만이면 총점이 높아도 불합격(과락)입니다. 약한 과목부터 챙기세요.</li>\n          <li>1급 140문항(140점) · 2급 150문항(150점), 모두 5지선다 객관식이며 문항당 1점이에요.</li>\n          <li><b>문항 수로 보면 (1급)</b> · 24문항 과목은 <b>10문항 이상</b>(현장실무 20문항은 <b>8문항 이상</b>) 맞혀야 과락을 면하고, 총점은 140문항 중 <b>84문항 이상</b>이어야 해요. 24문항 과목으로 치면 과목당 평균 <b>약 15문항</b>(14.4문항)씩이에요.</li>\n          <li><b>문항 수로 보면 (2급)</b> · 신경언어(30) <b>12문항</b> · 유창성·음성(25) <b>10문항</b> · 언어발달·조음음운(35) <b>14문항</b> 이상이면 과락을 면하고, 총점은 150문항 중 <b>90문항 이상</b>이어야 해요. 과목마다 60%씩(30문항 18 · 25문항 15 · 35문항 21문항) 맞히는 셈이에요.</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>시험 당일 주의사항</h2>\n      <div class=\"home-card-body\">\n        <ul class=\"home-list\">\n          <li><b>응시표와 신분증</b>을 꼭 챙기세요. 학생증은 신분증으로 인정되지 않아요. 응시표는 11월 11일부터 국시원 홈페이지에서 출력할 수 있어요.</li>\n          <li><b>식수(생수)는 제공하지 않아요.</b> 필요하면 직접 준비하세요.</li>\n          <li><b>입장 마감 시간</b>까지 도착해야 합니다. 시험이 시작된 뒤에는 입실할 수 없어요.</li>\n          <li>휴대전화·스마트워치·이어폰·전자계산기 같은 <b>전자기기는 전원을 끄고 제출</b>합니다. 시험 중 갖고 있다가 적발되면 시험이 무효 처리될 수 있어요.</li>\n          <li><b>컴퓨터시험(CBT)</b>이라 화면에서 문제를 읽고 답을 고릅니다. 시험장은 본인이 직접 선택하므로 선택 기간(11. 4.~11. 8.)을 놓치지 마세요.</li>\n        </ul>\n        <a class=\"home-video\" href=\"https://youtu.be/KlSQ9l0bcYQ\" target=\"_blank\" rel=\"noopener\">\n          <span class=\"home-video-ic\">&#9654;</span>\n          <span><b>컴퓨터시험(CBT) 응시자 유의사항 안내 영상</b><small>한국보건의료인국가시험원 공식 유튜브 · 새 창으로 열려요</small></span>\n        </a>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>이 연습앱 이용 안내</h2>\n      <div class=\"home-card-body\">\n        <ul class=\"home-list\">\n          <li><b>PC·노트북</b>에서 이용해 주세요. 실제 시험과 같은 넓은 화면을 기준으로 만들었어요.</li>\n          <li>교시마다 <b>실제와 같은 제한시간</b>이 적용되고, 시간이 다 되면 <b>자동으로 제출</b>됩니다.</li>\n          <li>채점도 실제 합격 기준(과목 40% · 평균 60%)으로 해서 과락 과목을 바로 알려드려요.</li>\n          <li>문항은 실제 시험의 과목 구성·유형을 따른 <b>창작 연습 문항</b>이며, 기출문제가 아니에요.</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>국시원 바로가기</h2>\n      <div class=\"home-card-body\">\n        <div class=\"home-links\">\n          <a href=\"https://www.kuksiwon.or.kr/subcnt/c_2024/1/view.do?seq=7&amp;itm_seq=37\" target=\"_blank\" rel=\"noopener\">언어재활사 시험정보</a>\n          <a href=\"https://www.kuksiwon.or.kr/notice/brd/m_51/view.do?seq=3990&amp;itm_seq_1=1&amp;etc1=37\" target=\"_blank\" rel=\"noopener\">CBT 종합안내서</a>\n          <a href=\"https://www.kuksiwon.or.kr/main/indexNew.do?seq=2\" target=\"_blank\" rel=\"noopener\">국시원 홈페이지</a>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"home-cta\"><button class=\"home-start\" onclick=\"goStart()\">모의 CBT 연습 &rarr;</button></div>\n    <div class=\"disclaimer\" style=\"text-align:center;border-top:none;margin-top:0;\">본 서비스는 한국보건의료인국가시험원(국시원)과 무관한 개인 학습용 연습 도구이며, 실제 기출문제가 아닌 창작 문항으로 구성되어 있습니다. 시험 정보는 국시원 공고를 요약한 것이므로 최종 확인은 국시원 홈페이지에서 해 주세요.</div>\n  </div>\n</div>\n\n<div id=\"startScreen\" class=\"hidden\">\n  <div class=\"start-top\">\n    <div style=\"width:140px;\"><button id=\"homeBackBtn\" class=\"home-back hidden\" onclick=\"backToHome()\">&larr; 처음 화면</button></div>\n    <div style=\"font-weight:700;font-size:20px;\">언어재활사 CBT 연습</div>\n    <div style=\"display:flex;align-items:center;gap:12px;\">\n      <button id=\"logoutBtn\" class=\"logout-btn\" onclick=\"doLogout()\" title=\"로그아웃\">로그아웃</button>\n    </div>\n  </div>\n  <div class=\"login-wrap\">\n    <div class=\"login-title\">응시 정보 입력</div>\n    <div class=\"login-body\">\n      <div class=\"login-notice\">오늘도 차분하게, 실전처럼 연습해 봐요!</div>\n      <div class=\"login-table\">\n        <div class=\"info-col\">\n          <div class=\"info-row\"><div class=\"th\">시험명</div><div class=\"td\" id=\"stTitle\"></div></div>\n          <div class=\"info-row\"><div class=\"th\">시험일</div><div class=\"td\" id=\"stDate\"></div></div>\n          <div class=\"info-row\" id=\"gradeRow\" style=\"display:none;\"><div class=\"th\">급수</div>\n            <div class=\"td\" id=\"gradeBtns\"></div>\n          </div>\n          <div class=\"info-row\" id=\"setRow\" style=\"display:none;\"><div class=\"th\">회차</div>\n            <div class=\"td\" id=\"setBtns\"></div>\n          </div>\n          <div class=\"info-row\"><div class=\"th\">교시</div>\n            <div class=\"td\" id=\"sessBtns\"></div>\n          </div>\n          <div class=\"info-row info-row-name\"><div class=\"th\">성명</div><div class=\"td\"><input type=\"text\" id=\"inName\" placeholder=\"소소숲\"><div class=\"name-hint\">※ 본인의 성명을 입력해 주세요.</div></div></div>\n          <div class=\"info-row\"><div class=\"th\">시험시간</div><div class=\"td\" id=\"stTime\"></div></div>\n        </div>\n      </div>\n      <div class=\"start-hint\">※ 교시를 선택하고 입장하기를 눌러 연습을 시작하세요.<br>※ 언어재활사 국가시험의 과목 구성·문항 유형을 따른 창작 연습 문항입니다(실제 기출 아님). 시험시간도 실제와 동일합니다.</div>\n      <div class=\"disclaimer\">본 서비스는 한국보건의료인국가시험원(국시원)과 무관한 개인 학습용 연습 도구이며, 실제 기출문제가 아닌 창작 문항으로 구성되어 있습니다.</div>\n    </div>\n    <div class=\"login-foot\">\n      <button class=\"login-btn\" onclick=\"startExam()\">입장하기</button>\n    </div>\n  </div>\n</div>\n\n<!-- ═════════ 내 학습 기록(오답노트·응시 기록) · 소소숲 정식판 전용 ═════════ -->\n<div id=\"studyScreen\" class=\"hidden\">\n  <div class=\"start-top\">\n    <div style=\"width:140px;\"><button class=\"home-back\" onclick=\"closeStudy()\">&larr; 처음 화면</button></div>\n    <div style=\"font-weight:700;font-size:20px;\">내 학습 기록</div>\n    <div style=\"width:140px;\"></div>\n  </div>\n  <div class=\"home-wrap\">\n    <div class=\"st-tabs\">\n      <button data-st=\"wrong\" onclick=\"openStudy('wrong')\">&#128213; 오답노트</button>\n      <button data-st=\"hist\" onclick=\"openStudy('hist')\">&#128202; 응시 기록</button>\n    </div>\n    <div id=\"studyBody\" style=\"display:flex;flex-direction:column;gap:18px;\"></div>\n    <div class=\"disclaimer\" style=\"text-align:center;border-top:none;margin-top:0;\">기록은 지금 쓰는 기기의 브라우저에만 저장돼요. 브라우저 데이터를 지우거나 기기를 바꾸면 기록이 초기화됩니다.</div>\n  </div>\n</div>\n\n<!-- ═════════ 시험 화면 ═════════ -->\n<div id=\"examScreen\" class=\"hidden\">\n  <div class=\"exam-header\" style=\"position:relative;\">\n    <div class=\"eh-left\">\n      <div class=\"eh-title\" id=\"exTitle\" style=\"position:static;transform:none;font-size:18px;\"></div>\n    </div>\n    <div class=\"timerbox\" style=\"position:absolute;left:50%;transform:translateX(-50%);\">\n      <div class=\"clock-ic\">&#128337;</div>\n      <div class=\"txt\">제한시간 : <span id=\"limitMin\"></span>분<br><span class=\"remain\">남은시간 : <b id=\"remainTxt\">--:--</b></span></div>\n    </div>\n    <div class=\"eh-right\">\n      <div class=\"who\" style=\"text-align:right;\">성명 : <span id=\"exName\"></span></div>\n    </div>\n  </div>\n\n  <div class=\"exam-main\">\n    <div class=\"leftbar\">\n      <button class=\"toolv\" onclick=\"toggleCalc()\"><span class=\"tv-ic\">&#128425;</span>계산기</button>\n      <button class=\"toolv\" onclick=\"togglePad()\"><span class=\"tv-ic\">&#9998;</span>그림판</button>\n      <div class=\"toolgroup\">\n        <div class=\"toollabel\">글자 크기</div>\n        <div class=\"font-btns\">\n          <button class=\"fbtn f80\" data-fs=\"0.85\">가<small>80%</small></button>\n          <button class=\"fbtn f100 active\" data-fs=\"1\">가<small>100%</small></button>\n          <button class=\"fbtn f125\" data-fs=\"1.22\">가<small>125%</small></button>\n        </div>\n      </div>\n      <div class=\"toolgroup\">\n        <div class=\"toollabel\">화면 배치</div>\n        <div class=\"layout-btns\">\n          <button class=\"lbtn active\" id=\"lay1\" title=\"1단 보기\"><div></div></button>\n          <button class=\"lbtn\" id=\"lay2\" title=\"2단 보기\"><div></div><div></div></button>\n        </div>\n      </div>\n    </div>\n    <div class=\"paper-col\">\n      <div class=\"progline\">\n        <span class=\"prognum\" id=\"progText\">0 / 0 문항 풀이</span>\n        <div class=\"progwrap\"><div class=\"progbar\" id=\"progBar\"></div></div>\n      </div>\n      <div class=\"paper\" id=\"paper\">\n        <div class=\"paper-grid\" id=\"paperGrid\"></div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"exam-footer\">\n    <div class=\"ef-group\">\n      <button class=\"wbtn\" onclick=\"goHome()\">&#8617; 처음으로</button>\n      <button class=\"wbtn\" onclick=\"pauseExam()\">&#9208; 일시정지</button>\n    </div>\n    <div class=\"pager\">\n      <button class=\"pbtn\" id=\"pgPrev\" onclick=\"movePage(-1)\">&#9664; 이전</button>\n      <span id=\"pageInfo\">1/1</span>\n      <button class=\"pbtn\" id=\"pgNext\" onclick=\"movePage(1)\">다음 &#9654;</button>\n    </div>\n    <div class=\"ef-group\">\n      <button class=\"wbtn\" id=\"fAll\" onclick=\"openProblemViewer('all')\">전체 문제 (<span id=\"cntAll\">0</span>)</button>\n      <button class=\"wbtn\" id=\"fChk\" onclick=\"openProblemViewer('chk')\">체크 문제 (<span id=\"cntChk\">0</span>)</button>\n      <button class=\"wbtn\" id=\"fUn\" onclick=\"openProblemViewer('un')\">안푼 문제 (<span id=\"cntUn\">0</span>)</button>\n      <button class=\"submit-btn\" onclick=\"askSubmit()\">&#128229; 제출하기</button>\n    </div>\n  </div>\n</div>\n\n<!-- ═════════ 결과 화면 ═════════ -->\n<div id=\"resultScreen\" class=\"hidden\">\n  <div class=\"res-wrap\">\n    <div class=\"res-card\">\n      <div class=\"res-title\">시험 결과</div>\n      <div class=\"res-body\">\n        <div class=\"verdict\" id=\"verdict\"></div>\n        <div class=\"verdict-sub\">합격 기준: 전 과목 총점의 60% 이상 &amp; 매 과목 40% 이상 (실제 필기시험 기준)</div>\n        <table class=\"score\" id=\"scoreTable\"></table>\n        <div class=\"res-area hidden\" id=\"resArea\"></div>\n        <div class=\"study-note hidden\" id=\"studyNote\"></div>\n        <div class=\"res-actions\">\n          <button class=\"wbtn hidden\" id=\"resStudyBtn\" onclick=\"openStudy('wrong')\">&#128213; 오답노트</button>\n          <button class=\"wbtn\" onclick=\"setReviewFilter('wrong')\">틀린 문제만 보기</button>\n          <button class=\"wbtn\" onclick=\"setReviewFilter('all')\">전체 해설 보기</button>\n          <button class=\"submit-btn\" onclick=\"location.reload()\">처음으로 (다시 풀기)</button>\n        </div>\n        <div class=\"copy-note\">ⓒ 소소숲 · 문항·해설의 무단 복제·배포(캡처·공유 포함)는 금지되며, 위반 시 이용 제한과 법적 책임이 따를 수 있습니다. <a href=\"https://sososoop.com/terms\" target=\"_blank\" rel=\"noopener\">이용약관</a></div>\n      </div>\n    </div>\n    <div id=\"reviewArea\"></div>\n    <div class=\"disclaimer\" style=\"text-align:center;border-top:none;\">본 서비스는 한국보건의료인국가시험원(국시원)과 무관한 개인 학습용 연습 도구이며, 실제 기출문제가 아닌 창작 문항으로 구성되어 있습니다.</div>\n  </div>\n</div>\n\n<!-- ═════════ 모달들 ═════════ -->\n<!-- 일시정지 — 연습용(실제 시험에는 없음). 문제를 가리고 타이머를 멈춘다 -->\n<div class=\"pause-overlay hidden\" id=\"pauseOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">&#9208; 일시정지</div>\n    <div class=\"modal-body\"><div class=\"big-clock\">&#9208;</div>타이머를 멈췄어요. 문제는 잠시 가려 둘게요.<br>남은 시간 <b id=\"pauseRemain\">--</b><br><small style=\"color:#68738a\">실제 시험에는 일시정지가 없어요. 쓴 횟수는 결과 화면에 적어 둡니다.</small></div>\n    <div class=\"modal-foot\"><button class=\"m-btn blue\" onclick=\"resumeExam()\">&#9654; 계속 풀기</button></div>\n  </div>\n</div>\n<!-- 풀던 시험 이어 풀기 (정식판·베타) -->\n<div class=\"overlay hidden\" id=\"resumeOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">풀던 시험이 있어요</div>\n    <div class=\"modal-body\" id=\"resumeMsg\"></div>\n    <div class=\"modal-foot\">\n      <button class=\"m-btn gray\" onclick=\"resumeDiscard()\">새로 시작</button>\n      <button class=\"m-btn blue\" onclick=\"resumeContinue()\">이어서 풀기</button>\n    </div>\n  </div>\n</div>\n<div class=\"overlay hidden\" id=\"warnOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head\">&#9888; 시험종료 알림 <button class=\"x\" onclick=\"hide('warnOverlay')\">&times;</button></div>\n    <div class=\"modal-body\"><div class=\"big-clock\">&#128337;</div>시험 종료 전<br><b style=\"color:var(--red)\" id=\"warnMin\">5분</b> 남았습니다.</div>\n    <div class=\"modal-foot\"><button class=\"m-btn\" onclick=\"hide('warnOverlay')\">확인</button></div>\n  </div>\n</div>\n\n<div class=\"overlay hidden\" id=\"submitOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">답안 제출 <button class=\"x\" onclick=\"hide('submitOverlay')\">&times;</button></div>\n    <div class=\"modal-body\" id=\"submitMsg\"></div>\n    <div class=\"modal-foot\">\n      <button class=\"m-btn gray\" onclick=\"hide('submitOverlay')\">돌아가기</button>\n      <button class=\"m-btn blue\" onclick=\"doSubmit()\">제출하기</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"overlay hidden\" id=\"timeoverOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head\">&#9888; 시험종료</div>\n    <div class=\"modal-body\"><div class=\"big-clock\">&#128337;</div><span id=\"timeoverMsg\">시험 시간이 종료되어<br>답안이 자동 제출되었습니다.</span></div>\n    <div class=\"modal-foot\"><button class=\"m-btn\" id=\"timeoverBtn\" onclick=\"hide('timeoverOverlay');finishSession();\">결과 확인</button></div>\n  </div>\n</div>\n\n<!-- 제출 완료 — 이 교시 시간이 남아 있으면 문제로 돌아가 고칠 수 있다. 이 창이 떠 있는 동안에도 시간은 흐른다 -->\n<div class=\"overlay hidden\" id=\"submittedOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">제출 완료</div>\n    <div class=\"modal-body\"><b id=\"subdTitle\">답안을 제출했어요</b><br>이 교시 남은 시간 <b id=\"subdRemain\">--</b><br><small style=\"color:#68738a\">시간이 남아 있는 동안에는 문제로 돌아가 답을 고칠 수 있어요.<br>이 창이 떠 있는 동안에도 시간은 흘러요.</small></div>\n    <div class=\"modal-foot\">\n      <button class=\"m-btn gray\" onclick=\"backToQuestions()\">문제로 돌아가기</button>\n      <button class=\"m-btn blue\" id=\"subdNext\" onclick=\"endSession('next')\">다음 교시 시작</button>\n      <button class=\"m-btn blue\" onclick=\"endSession('result')\">결과 보기</button>\n    </div>\n  </div>\n</div>\n\n<!-- 교시 전환 안내 -->\n<div class=\"overlay hidden\" id=\"nextSessOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">교시 전환</div>\n    <div class=\"modal-body\" id=\"nextSessMsg\"></div>\n    <div class=\"modal-foot\">\n      <button class=\"m-btn gray\" onclick=\"resultNow()\">결과 보기</button>\n      <button class=\"m-btn blue\" onclick=\"startNextSession()\">다음 교시 시작</button>\n    </div>\n  </div>\n</div>\n\n<!-- 이용 기간 연장 안내 -->\n<div class=\"overlay hidden\" id=\"extendOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">&#127807; 이용 기간 연장 안내 <button class=\"x\" onclick=\"hide('extendOverlay')\">&times;</button></div>\n    <div class=\"modal-body\">\n      베타 피드백 설문에 참여해 주셔서 감사합니다.<br>\n      감사의 마음을 담아 이용 기간을<br>\n      <b style=\"color:var(--pop)\"><span id=\"extendUntilText\"></span>까지</b> 연장해 드렸어요.<br>\n      남은 기간 실전처럼 활용해 보세요! &#127807;\n    </div>\n    <div class=\"modal-foot\"><button class=\"m-btn blue\" onclick=\"hide('extendOverlay')\">확인</button></div>\n  </div>\n</div>\n\n<!-- 문항 이미지 크게 보기(팝업) — 국시원 CBT처럼 클릭 시 확대 -->\n<div class=\"float-win hidden\" id=\"imgWin\">\n  <div class=\"fw-head\" data-drag=\"imgWin\"><span>자료 크게 보기<span class=\"iw-tip\">제목줄을 끌어 이동 · 모서리를 끌어 크기 조절</span></span><button onclick=\"closeImg()\" title=\"닫기 (ESC)\">&times;</button></div>\n  <div class=\"iw-body\"><img id=\"lbImg\" alt=\"문항 자료 이미지 확대\"></div>\n  <div class=\"iw-grip\" id=\"imgGrip\" title=\"끌어서 크기 조절\"></div>\n</div>\n\n<!-- 문제 보기 (전체/체크/안푼) -->\n<div class=\"overlay hidden\" id=\"viewerOverlay\">\n  <div class=\"viewer\">\n    <div class=\"viewer-head\">문제 모아보기 <button class=\"x\" onclick=\"hide('viewerOverlay')\">&times;</button></div>\n    <div class=\"viewer-guide\">※ 전체 / 체크 / 안 푼 문제 탭을 클릭하여 해당 문제를 확인할 수 있습니다.<br>※ 문제를 더블클릭하면 해당 문제로 이동하여 답안을 수정할 수 있습니다.</div>\n    <div class=\"viewer-tabs\">\n      <button class=\"v-tab active\" id=\"vtAll\" onclick=\"switchViewerTab('all')\">전체문제 (0)</button>\n      <button class=\"v-tab\" id=\"vtChk\" onclick=\"switchViewerTab('chk')\">체크문제 (0)</button>\n      <button class=\"v-tab\" id=\"vtUn\" onclick=\"switchViewerTab('un')\">안푼문제 (0)</button>\n    </div>\n    <div class=\"viewer-body\" id=\"viewerBody\"></div>\n  </div>\n</div>\n\n<!-- 메모 -->\n<div class=\"float-win hidden\" id=\"memoWin\" style=\"top:120px;right:250px;\">\n  <div class=\"fw-head\" data-drag=\"memoWin\"><span id=\"memoTitle\">메모</span><button onclick=\"closeMemo()\">&times;</button></div>\n  <textarea id=\"memoText\" placeholder=\"이 문제에 대한 메모를 입력하세요.\"></textarea>\n</div>\n\n<!-- 계산기 -->\n<div class=\"float-win hidden\" id=\"calcWin\" style=\"bottom:90px;left:20px;\">\n  <div class=\"fw-head\" data-drag=\"calcWin\"><span>계산기</span><button onclick=\"hide('calcWin')\">&times;</button></div>\n  <div class=\"calc-body\">\n    <input id=\"calcDisp\" readonly value=\"0\">\n    <div class=\"calc-grid\">\n      <button onclick=\"calcClear()\">C</button><button onclick=\"calcBack()\">&larr;</button><button class=\"op\" onclick=\"calcIn('/')\">&divide;</button><button class=\"op\" onclick=\"calcIn('*')\">&times;</button>\n      <button onclick=\"calcIn('7')\">7</button><button onclick=\"calcIn('8')\">8</button><button onclick=\"calcIn('9')\">9</button><button class=\"op\" onclick=\"calcIn('-')\">&minus;</button>\n      <button onclick=\"calcIn('4')\">4</button><button onclick=\"calcIn('5')\">5</button><button onclick=\"calcIn('6')\">6</button><button class=\"op\" onclick=\"calcIn('+')\">+</button>\n      <button onclick=\"calcIn('1')\">1</button><button onclick=\"calcIn('2')\">2</button><button onclick=\"calcIn('3')\">3</button><button onclick=\"calcIn('.')\">.</button>\n      <button onclick=\"calcIn('0')\">0</button><button class=\"eq\" onclick=\"calcEq()\">=</button><button onclick=\"calcIn('00')\">00</button>\n    </div>\n  </div>\n</div>\n\n<!-- 그림판 -->\n<div class=\"float-win hidden\" id=\"padWin\" style=\"bottom:90px;left:280px;\">\n  <div class=\"fw-head\" data-drag=\"padWin\"><span>그림판</span><button onclick=\"hide('padWin')\">&times;</button></div>\n  <div class=\"pad-tools\">\n    <button id=\"penBtn\" class=\"on\" onclick=\"setPadMode('pen')\">펜</button>\n    <button id=\"eraserBtn\" onclick=\"setPadMode('eraser')\">지우개</button>\n    <button onclick=\"clearPad()\">전체 지우기</button>\n  </div>\n  <canvas id=\"padCanvas\" width=\"420\" height=\"280\"></canvas>\n</div>\n\n<script>\nwindow.EXAM_TITLE = \"1급 언어재활사 모의 CBT\";\nwindow.HIDDEN_SETS = [];\nwindow.QUESTIONS = [{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 좌측 전두엽 하부 손상\\n• 느리고 노력이 많이 드는 비유창한 발화\\n• 조사·어미 등 문법형태소를 자주 생략하는 전보식 발화\\n• 단순한 지시의 청각적 이해는 비교적 양호하나 통사적으로 복잡한 문장의 이해에는 어려움을 보임\\n• 따라말하기도 손상됨\",\"q\":\"위 양상을 보이는 실어증 유형은?\",\"choices\":[\"베르니케실어증\",\"연결피질운동실어증\",\"브로카실어증\",\"전도실어증\",\"명칭실어증\"],\"answer\":3,\"explain\":\"느리고 노력성인 비유창 발화, 실문법증(문법형태소 생략)의 전보식 발화, 손상된 따라말하기, 단순 지시 이해는 비교적 양호하나 통사적으로 복잡한 문장 이해에는 어려움을 보이는 것은 브로카실어증이다. 따라말하기가 유창성에 비해 보존되면 연결피질운동실어증으로 감별한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형 감별\",\"p\":\"비유창·실문법·따라말하기 손상 조합으로 실어증 유형 판단\",\"n\":\"브로카실어증: 비유창·전보식 발화·단순 이해 양호·따라말하기 손상\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R) 결과\\n• 스스로 말하기: 8/20점 (비유창)\\n• 알아듣기: 170/200점\\n• 따라말하기: 88/100점\\n• 이름대기 및 낱말 찾기: 40/100점\",\"q\":\"다음 결과를 보이는 환자의 실어증 유형은?\",\"choices\":[\"연결피질운동실어증\",\"전도실어증\",\"베르니케실어증\",\"브로카실어증\",\"연결피질감각실어증\"],\"answer\":1,\"explain\":\"발화는 비유창하지만 청각적 이해력이 양호하고 따라말하기가 유창성에 비해 뚜렷하게 보존된 양상은 연결피질운동실어증의 특징이다. 브로카실어증은 따라말하기도 손상되고, 전도실어증은 따라말하기가 선택적으로 손상된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"PK-WAB-R 결과 해석\",\"p\":\"PK-WAB-R 하위점수의 유창성·이해·따라말하기 비교로 유형 판단\",\"n\":\"연결피질운동실어증: 비유창·이해 양호·따라말하기 뚜렷한 보존\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"좌뇌 손상 환자의 낱말 읽기 검사 결과\\n• 실제 낱말을 의미적으로 관련된 다른 낱말로 대치함(예: '버스'→'기차', '사과'→'포도')\\n• 비단어('무핀', '두랍') 읽기가 거의 불가능함\\n• 추상어보다 구체어를 더 잘 읽음\",\"q\":\"위 환자의 실독증 유형으로 가장 적절한 것은?\",\"choices\":[\"표층실독증\",\"음운실독증\",\"순수실독증\",\"심층실독증\",\"무시실독증\"],\"answer\":4,\"explain\":\"실제 낱말을 의미적으로 관련된 낱말로 대치하는 의미착어(예: '버스'→'기차'), 비단어 읽기의 심한 손상, 추상어보다 구체어를 잘 읽는 심상성(imageability) 효과는 심층실독증의 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실독증·실서증\",\"k\":\"실독증 유형 감별\",\"p\":\"의미착어·비단어 읽기 불능·구체어 우세로 실독증 유형 판단\",\"n\":\"심층실독증: 의미착어, 비단어 읽기 심한 손상, 심상성 효과\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 기저핵 회로의 퇴행성 병변\\n• 단조로운 음도와 감소된 강도\\n• 말속도가 점점 빨라지며 음절이 뭉개짐\\n• 안정 시 떨림 동반\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"이완형\",\"과소운동형\",\"경직형\",\"실조형\",\"과다운동형\"],\"answer\":2,\"explain\":\"기저핵 병변(파킨슨병)과 단조로운 음도·강도, 말속도 가속, 안정 떨림은 과소운동형 마비말장애의 전형적인 특징이다. 실조형은 소뇌 손상으로 불규칙한 조음 붕괴와 과도한 강세 변동을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"마비말장애 유형 감별\",\"p\":\"기저핵 병변과 단조로운 음도·말속도 가속·안정 떨림으로 유형 판단\",\"n\":\"과소운동형: 기저핵(파킨슨병), 단음도·단강도, 가속 말속도, 안정 떨림\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 근력 저하 없이 말소리를 탐색하는 듯한 입술·혀의 모색행동\\n• 같은 낱말에서도 매번 다른 조음 오류\\n• 발화 길이가 길어질수록 오류 증가\\n• 자동구어(숫자세기)는 비교적 유창함\",\"q\":\"다음 특징을 보이는 환자에게 적절한 치료 활동은?\",\"choices\":[\"보완대체의사소통 도구를 즉시 도입한다\",\"빨대 불기 등 구강 근력 강화 훈련을 실시한다\",\"청각적 이해력 훈련을 우선 실시한다\",\"느린 속도로 조음점 전환을 반복 연습한다\",\"호흡 지구력 훈련으로 발화 길이를 늘린다\"],\"answer\":4,\"explain\":\"비일관적 오류, 모색행동, 자동구어의 상대적 보존은 말실행증의 특징이다. 말실행증은 근력의 문제가 아니라 말운동 프로그래밍의 손상이므로 집중적·반복적인 말산출 연습과 운동학습 원리(느린 속도, 점진적 난이도)를 적용한 치료가 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"말실행증 치료 활동\",\"p\":\"모색행동·비일관 오류·자동구어 보존으로 말실행증 치료 활동 선택\",\"n\":\"말실행증: 운동 프로그래밍 손상, 느린 속도·반복 연습의 운동학습 원리 적용\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"비디오투시조영삼킴검사(VFSS) 소견\\n• 삼킴 반사가 유발되기 전에 음식물이 조기에 인두로 흘러내림\\n• 음식물이 후두 전정을 지나 진성대 아래로 내려감\\n• 이때 기침 반응이 나타나지 않음\",\"q\":\"다음 소견에 해당하는 삼킴장애 증상은?\",\"choices\":[\"구강 내 잔여물\",\"삼킴 중 후두 침습\",\"삼킴 후 지연성 흡인\",\"삼킴 전의 무증상 흡인\",\"비강으로의 역류\"],\"answer\":4,\"explain\":\"삼킴 반사가 유발되기 전(삼킴 전)에 음식물이 진성대 아래로 내려갔으므로 흡인이며, 기침 등 방어 반응이 없으므로 무증상(silent) 흡인이다. 침습은 진성대 위까지만 들어간 경우를 말한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"삼킴장애\",\"k\":\"VFSS 소견 해석\",\"p\":\"진성대 하방 진입 시점과 기침 유무로 흡인 유형 판단\",\"n\":\"삼킴 전 무증상 흡인: 반사 전 진성대 아래 진입, 방어 기침 부재\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 65세 남성, 발화는 유창하고 문법적으로 완전함\\n• '가위'를 보여주면 이름을 대지 못하고 용도도 설명하지 못함\\n• 단어의 의미를 묻는 과제에서 점진적인 어려움 심화\\n• 불규칙 낱말을 규칙적으로 읽는 오류 동반\\n• 일상생활 기억력과 시공간 능력은 비교적 보존됨\",\"q\":\"다음 양상을 보이는 환자에게 의심되는 진단명은?\",\"choices\":[\"알츠하이머성 치매\",\"의미치매\",\"원발성 진행성 실어증 비유창형\",\"혈관성 치매\",\"루이소체 치매\"],\"answer\":2,\"explain\":\"유창한 발화가 유지되면서 단어 의미 지식이 점진적으로 상실되고(이름대기·의미 이해 저하) 표층실독증 양상이 동반되며 일상 기억이 비교적 보존되는 것은 의미치매(의미변이형 원발성 진행성 실어증)의 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"진행성 언어장애 감별\",\"p\":\"유창 발화 속 의미 지식 상실과 표층실독 양상으로 진단명 판단\",\"n\":\"의미치매: 유창 발화 유지, 이름대기·의미 이해 점진 저하, 일상 기억 보존\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"외상성 뇌손상 환자의 주의력 유형과 평가 과제가 적절하게 연결된 것은?\",\"choices\":[\"선택적 주의력 – 조용한 방에서 숫자 따라 외우기\",\"지속적 주의력 – 목표 소리가 들릴 때마다 버튼 누르기\",\"초점적 주의력 – 두 가지 규칙을 번갈아 적용하기\",\"분리적 주의력 – 두 과제 중 하나만 골라 수행하기\",\"교대적 주의력 – 소음 속에서 이야기 듣고 질문에 답하기\"],\"answer\":2,\"explain\":\"지속적 주의력은 일정 시간 동안 주의를 유지하는 능력으로, 지속 수행 과제(목표 자극에 반응하기)로 평가한다. 소음 속 과제는 선택적 주의력, 규칙 전환 과제는 교대적 주의력, 이중과제는 분리(배분)적 주의력 평가에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"주의력 유형별 평가 과제\",\"p\":\"주의력 하위 유형의 정의에 맞는 평가 과제 연결 식별\",\"n\":\"지속적 주의력: 일정 시간 주의 유지, 목표 자극 반응 과제로 평가\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 광범위한 좌반구 병소\\n• 구어 표현이 몇 개의 상동어에 제한됨\\n• 청각적 이해력도 심하게 손상됨\\n• 몸짓 모방은 부분적으로 가능함\",\"q\":\"다음 환자에게 우선적으로 적용할 수 있는 치료법은?\",\"choices\":[\"멜로디억양치료\",\"지연청각피드백\",\"문장산출프로그램\",\"의미자질분석\",\"시각동작치료\"],\"answer\":5,\"explain\":\"시각동작치료(VAT)는 구어를 사용하지 않고 몸짓 상징을 훈련하는 접근으로, 표현과 이해가 모두 심하게 손상된 전반실어증 환자에게 적용할 수 있다. 멜로디억양치료는 이해력이 양호한 비유창 실어증 환자에게 적합하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"전반실어증 치료법\",\"p\":\"표현·이해 모두 심한 손상과 몸짓 모방 가능성으로 치료법 선택\",\"n\":\"시각동작치료(VAT): 구어 없이 몸짓 상징 훈련, 전반실어증에 적용\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R)에서 실어증지수(AQ) 산출에 포함되지 않는 영역은?\",\"choices\":[\"스스로 말하기\",\"따라말하기\",\"읽기\",\"이름대기 및 낱말 찾기\",\"알아듣기\"],\"answer\":3,\"explain\":\"실어증지수(AQ)는 스스로 말하기, 알아듣기, 따라말하기, 이름대기의 구어 영역 점수로 산출한다. 읽기와 쓰기는 언어지수(LQ) 산출에 포함된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"PK-WAB-R AQ 구성\",\"p\":\"AQ와 LQ의 산출 영역 구분으로 AQ 비포함 영역 식별\",\"n\":\"AQ: 스스로 말하기·알아듣기·따라말하기·이름대기, 읽기·쓰기는 LQ\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"아 내: \\\"남편이 말을 잘 못 알아들어서 답답해요. 제가 길게 설명하면 멍하니 있어요.\\\"\\n환자: 중등도 실어증으로 외래 언어치료 중\",\"q\":\"다음 보호자에게 제공할 의사소통 교육 내용으로 옳은 것은?\",\"choices\":[\"짧고 단순한 문장으로 말하고 충분히 기다려 준다\",\"환자가 틀리게 말할 때마다 즉시 교정해 준다\",\"환자가 말하기 전에 미리 대신 말해 준다\",\"의사소통 실패를 줄이기 위해 대화 기회를 최소화한다\",\"빠른 속도로 여러 번 반복해서 말해 준다\"],\"answer\":1,\"explain\":\"실어증 환자와의 의사소통에서는 짧고 단순한 문장, 느린 말속도, 충분한 반응 시간 제공, 제스처 등 다중 양식 활용이 권장된다. 잦은 교정이나 대신 말하기는 의사소통 의욕을 저하시킨다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"실어증 보호자 교육\",\"p\":\"이해 저하 환자와의 대화 곤란 호소에 맞는 의사소통 교육 선택\",\"n\":\"실어증 대화 전략: 짧고 단순한 문장, 느린 속도, 충분한 반응 시간\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"성문위삼킴법(supraglottic swallow)의 일차적인 목적은?\",\"choices\":[\"인두 잔여물을 중력으로 제거한다\",\"후두 상승을 연장하여 상부식도괄약근의 개방 시간을 늘린다\",\"혀 기저부의 후방 운동을 강화한다\",\"삼킴 반사의 유발 속도를 높인다\",\"성대를 닫아 삼킴 중 기도를 보호한다\"],\"answer\":5,\"explain\":\"성문위삼킴법은 숨을 참은 상태로 삼킨 뒤 기침을 하는 기법으로, 삼킴 전·중에 진성대 수준에서 기도를 닫아 흡인을 예방한다. 후두 상승 연장과 상부식도괄약근 개방 연장은 멘델슨기법의 목적이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"삼킴장애\",\"k\":\"성문위삼킴법 목적\",\"p\":\"삼킴 기법별 작용 기전 구분으로 성문위삼킴법 목적 식별\",\"n\":\"성문위삼킴법: 숨 참고 삼킨 뒤 기침, 진성대 폐쇄로 기도 보호\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 좌측 상측두회 손상\\n• 유창하지만 착어가 많은 발화\\n• 청각적 이해력이 심하게 저하됨\\n• 따라말하기가 손상되고 병식이 부족함\",\"q\":\"다음 양상을 보이는 실어증 유형은?\",\"choices\":[\"베르니케실어증\",\"전도실어증\",\"명칭실어증\",\"연결피질감각실어증\",\"브로카실어증\"],\"answer\":1,\"explain\":\"유창한 발화, 심한 청각적 이해력 손상, 착어, 병식 부족은 베르니케실어증의 특징이다. 연결피질감각실어증은 유사하나 따라말하기가 상대적으로 보존된다는 점에서 구별된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형 감별\",\"p\":\"유창·착어·심한 이해 저하·따라말하기 손상 조합으로 유형 판단\",\"n\":\"베르니케실어증: 유창·착어·이해 심한 손상·따라말하기 손상·병식 부족\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"유창한 발화와 비교적 양호한 청각적 이해력을 보이나 따라말하기가 선택적으로 심하게 손상되고 음소착어가 두드러지는 실어증 유형은?\",\"choices\":[\"연결피질운동실어증\",\"베르니케실어증\",\"브로카실어증\",\"전도실어증\",\"전반실어증\"],\"answer\":4,\"explain\":\"전도실어증은 활꼴다발(궁상속)의 손상으로 유창성과 이해력은 보존되나 따라말하기가 선택적으로 손상되고, 음소착어와 스스로 고치려는 접근행동(conduite d'approche)을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"전도실어증 특징\",\"p\":\"유창성·이해 보존과 따라말하기 선택적 손상으로 유형 판단\",\"n\":\"전도실어증: 궁상속 손상, 따라말하기 선택 손상, 음소착어·접근행동\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 소뇌 손상\\n• 불규칙하게 조음이 붕괴됨\\n• 과도하고 불규칙한 강세\\n• 술 취한 듯한 말\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"이완형\",\"경직형\",\"실조형\",\"과소운동형\",\"과다운동형\"],\"answer\":3,\"explain\":\"실조형 마비말장애는 소뇌 손상으로 발생하며, 불규칙한 조음 붕괴, 과도하고 불규칙한 강세, 운율 이상('술 취한 듯한 말')이 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"마비말장애 유형 감별\",\"p\":\"소뇌 손상과 불규칙 조음 붕괴·과도한 강세로 유형 판단\",\"n\":\"실조형: 소뇌 손상, 불규칙 조음 붕괴, 과도·불규칙 강세, 취한 듯한 말\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 상위운동신경의 양측 손상\\n• 느리고 힘이 많이 드는 말\\n• 쥐어짜는 듯한 거친 음성\\n• 과다비성\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"이완형\",\"과소운동형\",\"실조형\",\"편측 상부운동신경형\",\"경직형\"],\"answer\":5,\"explain\":\"경직형 마비말장애는 상위운동신경의 양측 손상으로 발생하며, 느리고 노력성인 말, 쥐어짜는 거친 음성, 과다비성이 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"마비말장애 유형 감별\",\"p\":\"양측 상위운동신경 손상과 쥐어짜는 음성·과다비성으로 유형 판단\",\"n\":\"경직형: 양측 상위운동신경 손상, 느리고 노력성 말, 쥐어짜는 음성\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 뇌신경(안면신경·설하신경 등)의 하위운동신경 손상\\n• 침범된 근육의 약화와 위축\\n• 과다비성과 기식 음성\\n• 부정확한 자음\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"과다운동형\",\"경직형\",\"실조형\",\"이완형\",\"과소운동형\"],\"answer\":4,\"explain\":\"이완형 마비말장애는 하위운동신경(뇌신경·척수신경) 손상으로 근육의 약화·저긴장·위축이 나타나며, 과다비성과 기식 음성이 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"마비말장애 유형 감별\",\"p\":\"하위운동신경 손상과 근약화·위축·기식 음성으로 유형 판단\",\"n\":\"이완형: 하위운동신경 손상, 근약화·저긴장·위축, 과다비성·기식 음성\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"우반구 손상 환자의 의사소통 특징으로 가장 적절한 것은?\",\"choices\":[\"심한 실문법증을 보인다\",\"따라말하기가 선택적으로 손상된다\",\"음소착어가 빈번하게 나타난다\",\"화용언어와 운율에서 결함을 보인다\",\"청각적 이해력이 심하게 손상된다\"],\"answer\":4,\"explain\":\"우반구 손상 환자는 언어 구조 자체보다 화용(담화 조직, 추론, 유머·비유 이해), 운율, 시공간 처리(좌측 무시)에서 결함을 보인다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"인지의사소통장애\",\"k\":\"우반구 손상 의사소통 특징\",\"p\":\"언어 구조와 화용·운율 결함 구분으로 우반구 손상 특징 식별\",\"n\":\"우반구 손상: 담화 조직·추론·비유 이해 등 화용과 운율 결함\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"멜로디억양치료(MIT)를 적용하기에 가장 적절한 환자는?\",\"choices\":[\"청각적 이해력이 심하게 손상된 전반실어증 환자\",\"발화 산출이 제한된 비유창 실어증 환자\",\"착어가 많은 베르니케실어증 환자\",\"화용 결함을 보이는 우반구 손상 환자\",\"과다비성을 보이는 마비말장애 환자\"],\"answer\":2,\"explain\":\"멜로디억양치료는 보존된 우반구의 멜로디 기능을 활용하는 치료로, 청각적 이해력이 비교적 양호하고 발화 산출이 제한된 비유창(브로카) 실어증 환자에게 적합하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"MIT 적용 대상\",\"p\":\"이해력 보존 여부와 발화 산출 제한으로 MIT 적합 대상 선택\",\"n\":\"멜로디억양치료: 우반구 멜로디 기능 활용, 이해 양호한 비유창 실어증\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"이름대기 장애 치료법으로, 목표 낱말의 범주·기능·특징 등 의미 정보를 활성화하여 낱말 인출을 돕는 접근법은?\",\"choices\":[\"멜로디억양치료\",\"의미자질분석\",\"시각동작치료\",\"각본치료\",\"성문위삼킴법\"],\"answer\":2,\"explain\":\"의미자질분석(SFA)은 목표 낱말과 관련된 의미자질(상위범주, 기능, 특징, 위치 등)을 체계적으로 인출하게 하여 이름대기 능력을 향상시키는 치료법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"이름대기 치료법\",\"p\":\"범주·기능·특징 등 의미 정보 활성화 설명으로 치료법 식별\",\"n\":\"의미자질분석(SFA): 목표어 의미자질 체계적 인출로 이름대기 향상\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"한국판 보스턴이름대기검사(K-BNT)가 평가하는 능력은?\",\"choices\":[\"쓰기 표현\",\"청각적 이해력\",\"문장 따라말하기\",\"대면 이름대기\",\"읽기 이해\"],\"answer\":4,\"explain\":\"K-BNT는 흑백 선화를 보고 이름을 말하는 대면 이름대기(confrontation naming) 능력을 평가하는 검사이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"K-BNT 평가 영역\",\"p\":\"검사 과제 형식으로 K-BNT가 평가하는 능력 식별\",\"n\":\"K-BNT: 흑백 선화 보고 이름 말하기, 대면 이름대기 평가\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"삼킴 시 후두 상승을 인위적으로 연장·유지하여 상부식도괄약근의 개방 시간을 늘리는 삼킴 기법은?\",\"choices\":[\"성문위삼킴법\",\"최대성문위삼킴법\",\"노력삼킴\",\"멘델슨기법\",\"머리 회전법\"],\"answer\":4,\"explain\":\"멘델슨기법은 삼킴 시 후두가 최고로 올라간 지점에서 인위적으로 상승을 유지하여 상부식도괄약근의 개방 시간과 폭을 늘리는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"삼킴장애\",\"k\":\"멘델슨기법 정의\",\"p\":\"후두 상승 유지와 상부식도괄약근 개방 연장 설명으로 기법 식별\",\"n\":\"멘델슨기법: 후두 최고 상승 지점 유지, 상부식도괄약근 개방 시간·폭 증가\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"알츠하이머성 치매 초기 단계에서 가장 두드러지는 언어 특징은?\",\"choices\":[\"조음의 붕괴\",\"구문 구조의 상실\",\"따라말하기 불능\",\"완전한 함구증\",\"이름대기 어려움\"],\"answer\":5,\"explain\":\"알츠하이머성 치매 초기에는 조음·구문·따라말하기는 비교적 보존되고, 이름대기 어려움과 에두르기 등 의미론적 단어 인출 결함이 먼저 나타난다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"인지의사소통장애\",\"k\":\"알츠하이머 초기 언어 특징\",\"p\":\"초기에 보존되는 영역과 먼저 저하되는 영역 구분으로 특징 식별\",\"n\":\"알츠하이머 초기: 조음·구문 보존, 이름대기 어려움·에두르기 선행\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"뇌영상 기법에 대한 설명으로 옳은 것은?\",\"choices\":[\"기능자기공명영상(fMRI)은 뇌의 구조적 병변만을 보여준다\",\"fMRI와 PET는 뇌 기능의 활성화를 보여준다\",\"컴퓨터단층촬영(CT)은 과제 수행 중 뇌 활성화를 직접 측정한다\",\"확산텐서영상(DTI)은 뇌혈류 속도를 측정한다\",\"모든 뇌영상은 기능적 정보만 제공한다\"],\"answer\":2,\"explain\":\"CT와 구조 MRI는 뇌의 해부학적 구조·병변을 보여주는 구조적 영상이고, fMRI·PET는 과제 수행 중 신경 활동에 따른 혈류·대사 변화를 측정하는 기능적 영상이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"신경해부·뇌혈관\",\"k\":\"뇌영상 기법 구분\",\"p\":\"구조적 영상과 기능적 영상의 측정 대상 구분으로 옳은 설명 식별\",\"n\":\"구조 영상: CT·MRI, 기능 영상: fMRI·PET(혈류·대사 변화 측정)\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동 발화\\n① \\\"엄마 물 줘\\\"\\n② \\\"이거 안 먹어\\\"\\n③ \\\"곰인형 어디 있어\\\"\\n④ \\\"나도 갈래\\\"\",\"q\":\"다음 아동 발화의 평균낱말길이(MLU-w)는?\",\"choices\":[\"2.25\",\"2.5\",\"2.75\",\"3.0\",\"3.25\"],\"answer\":4,\"explain\":\"낱말 수를 셀 때 체언에 붙은 조사는 따로 한 낱말로 센다. ① 엄마/물/줘 3개, ② 이거/안/먹어 3개, ③ 곰인형/어디/있어 3개, ④ 나/도/갈래 3개('나도'는 체언 '나'와 조사 '도'로 2낱말)로 총 12개이다. MLU-w = 총 낱말 수 ÷ 발화 수 = 12 ÷ 4 = 3.0.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"MLU-w 산출\",\"p\":\"발화별 낱말 수 합계를 발화 수로 나누어 MLU-w 산출\",\"n\":\"MLU-w: 총 낱말 수 ÷ 발화 수 (체언에 붙은 조사는 한 낱말로 셈)\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"낱말 이름대기 과제에서 아동이 다음과 같이 반응하였다.\\n가위 → \\\"자르는 거\\\"\\n시계 → \\\"똑딱똑딱\\\"\\n칫솔 → \\\"이 닦는 거\\\"\",\"q\":\"위 아동의 이름대기 반응에 대한 설명으로 옳은 것은?\",\"choices\":[\"기능·특징으로 에둘러 표현하고 있다\",\"음소착어를 반복적으로 보이고 있다\",\"동일한 보속 반응을 보이고 있다\",\"이름대기 능력이 정상 범위이다\",\"의미와 무관한 신조어를 산출하고 있다\"],\"answer\":1,\"explain\":\"낱말 이름대기에서 목표어를 인출하지 못해 그 기능·특징으로 대신 설명하는 것을 에두르기(circumlocution)라 하며, 낱말찾기(인출)의 어려움을 시사한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"이름대기 반응 분석\",\"p\":\"목표어 대신 기능·특징 설명 반응으로 이름대기 오류 유형 판단\",\"n\":\"에두르기: 목표어 인출 실패 시 기능·특징으로 대신 설명, 낱말찾기 어려움\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동이 산출한 이야기\\n\\\"토끼가 당근을 심었어요. 그리고 매일 물을 주었어요. 그런데 그것이 자라지 않았어요. 왜냐하면 씨앗을 거꾸로 심었기 때문이에요.\\\"\",\"q\":\"위 이야기에서 두드러지게 나타난 언어 특성은?\",\"choices\":[\"대용어를 전혀 사용하지 않았다\",\"이야기 문법 요소가 전혀 나타나지 않았다\",\"접속부사를 사용해 문장을 연결하고 있다\",\"문법형태소 오류가 매우 빈번하다\",\"단문만 반복해서 산출하였다\"],\"answer\":3,\"explain\":\"'그리고, 그런데, 왜냐하면' 등 접속부사는 문장·명제를 이어 주는 결속표지로, 위 이야기에서 이를 활용해 사건을 순서·대조·인과로 연결하고 있다. 이야기에는 '그것'이라는 지시 대용어도 쓰였으므로 ①은 틀리다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"이야기·담화\",\"k\":\"이야기 결속표지 분석\",\"p\":\"문장 간 연결 표현 사용 양상으로 이야기의 언어 특성 판단\",\"n\":\"접속부사: 순서·대조·인과로 문장을 잇는 결속표지\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"표준화 언어검사와 평가 영역의 연결이 옳지 않은 것은?\",\"choices\":[\"수용·표현 어휘력 검사(REVT) – 수용·표현 어휘력\",\"한국어 읽기 검사(KOLRA) – 자발화 산출 능력\",\"언어문제해결력검사 – 상위언어 및 추론 능력\",\"취학전 아동의 수용언어 및 표현언어 발달 척도(PRES) – 취학전 수용·표현 언어\",\"구문의미이해력검사(KOSECT) – 구문의미 이해력\"],\"answer\":2,\"explain\":\"KOLRA(한국어 읽기 검사)는 해독·읽기이해 등 읽기 능력을 평가하며 자발화 산출 능력을 평가하지 않는다. 나머지는 검사와 평가 영역이 올바르게 연결되어 있다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"읽기·쓰기\",\"k\":\"표준화 검사 평가 영역\",\"p\":\"각 표준화 언어검사의 측정 영역 비교로 잘못된 연결 식별\",\"n\":\"KOLRA: 해독·읽기이해 등 읽기 능력 평가, 자발화 평가 아님\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 5세 아동\\n• 가정에서는 아버지·어머니 모두 베트남어만 사용\\n• 만 3세에 어린이집에 입소하면서 한국어에 처음 본격적으로 노출됨\\n• 현재 한국어 발화가 제한적임\",\"q\":\"위 아동의 이중언어 유형과 평가 시 고려사항으로 옳은 것은?\",\"choices\":[\"동시적 이중언어 아동의 규준을 그대로 적용한다\",\"한국어 검사 결과만으로 언어장애를 진단한다\",\"베트남어 사용을 중단하도록 권고한다\",\"이중언어 노출이 언어지연의 원인이라고 설명한다\",\"노출 기간이 짧은 순차적 이중언어 아동으로 해석한다\"],\"answer\":5,\"explain\":\"만 3세 이후 제2언어(한국어)에 노출된 순차적 이중언어 아동이다. 노출 기간이 짧으면 제2언어 수행이 낮게 나타날 수 있으므로 노출 기간을 고려해 해석해야 하며, 이중언어 노출 자체는 언어지연의 원인이 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"이중언어 유형과 평가\",\"p\":\"제2언어 노출 시기·기간으로 이중언어 유형과 해석 방향 판단\",\"n\":\"순차적 이중언어: 3세 이후 제2언어 노출, 노출 기간 고려해 해석\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 뇌성마비로 사지의 운동 조절이 어려움\\n• 인지 능력과 언어 이해력은 연령 수준\\n• 손가락으로 상징을 직접 짚는 것이 불가능함\\n• 눈 움직임과 머리 움직임은 비교적 안정적임\",\"q\":\"다음 아동의 보완대체의사소통(AAC) 도구 선택 기법으로 가장 적절한 것은?\",\"choices\":[\"수어를 이용한 표현\",\"필담을 이용한 의사 표현\",\"구어 산출 훈련만 집중해 실시\",\"시선이나 스캐닝을 이용한 선택\",\"손가락을 이용한 직접선택\"],\"answer\":4,\"explain\":\"직접선택이 어려운 사지 운동장애 아동에게는 안정적으로 조절 가능한 움직임(시선, 머리)을 활용한 시선 응시 선택이나 스위치를 이용한 스캐닝(간접선택)이 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"AAC 선택 기법\",\"p\":\"직접선택 불가와 안정적 시선·머리 움직임으로 선택 기법 결정\",\"n\":\"간접선택: 직접 지적 불가 시 시선 응시·스위치 스캐닝 활용\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 초등학교 3학년 아동, 난독 의심으로 의뢰\\n• 낱말·비단어를 소리 내어 읽는 속도와 정확도는 또래 수준\\n• 읽은 글의 내용을 이해하고 요약하는 데 또래보다 크게 어려움\\n• 들려주면 이해하고 일상 대화에는 어려움이 없음\",\"q\":\"위 아동의 읽기 문제 유형으로 가장 적절한 것은?\",\"choices\":[\"난독증(해독 부진)\",\"읽기이해부진\",\"말소리장애\",\"쓰기장애\",\"유창성장애\"],\"answer\":2,\"explain\":\"해독(낱말·비단어 읽기의 속도·정확도)은 또래 수준이나 읽기이해가 저조하고 듣기이해는 양호한 양상은, 해독 결함의 난독증이 아니라 읽기이해부진에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"읽기·쓰기\",\"k\":\"읽기 문제 유형 감별\",\"p\":\"해독 정상·읽기이해 저하·듣기이해 양호 조합으로 유형 판단\",\"n\":\"읽기이해부진: 해독은 또래 수준, 읽기이해만 저조, 듣기이해 양호\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"대화 중 아동이 상대의 말이 끝나기 전에 끼어들어 말하고, 자신의 관심사만 일방적으로 이야기하며, 상대의 질문에 맞지 않는 대답을 자주 한다.\",\"q\":\"위 아동에게 우선 목표로 설정할 화용 능력은?\",\"choices\":[\"낱말 해독과 읽기 정확도\",\"말소리 산출의 정확도\",\"평균발화길이(MLU) 늘리기\",\"차례 주고받기와 주제 유지\",\"음절·음소 인식 능력\"],\"answer\":4,\"explain\":\"상대의 말을 끊고 자기 관심사만 말하며 부적절하게 반응하는 것은 대화 규칙(차례 주고받기·주제 유지)의 어려움이므로, 이를 우선 화용 목표로 설정한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"화용·대화\",\"k\":\"화용 중재 목표 설정\",\"p\":\"끼어들기·일방적 주제·부적절 응답으로 우선 화용 목표 선택\",\"n\":\"대화 규칙 결함 목표: 차례 주고받기와 주제 유지\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"언어 이전기 아동의 의사소통 행동을 관찰하였다.\\n• 손이 닿지 않는 과자를 향해 소리를 내며 성인의 손을 끌어당긴다.\\n• 싫어하는 음식을 밀어내며 고개를 돌린다.\",\"q\":\"위 두 행동에 해당하는 의사소통 기능을 순서대로 바르게 짝지은 것은?\",\"choices\":[\"요구하기 - 거부하기\",\"서술하기 - 요구하기\",\"거부하기 - 인사하기\",\"공동주의 - 서술하기\",\"요구하기 - 공동주의\"],\"answer\":1,\"explain\":\"손이 닿지 않는 사물을 향해 성인의 손을 끌며 소리 내는 것은 요구하기, 싫어하는 것을 밀어내고 고개를 돌리는 것은 거부하기 기능이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"의사소통 기능 분류\",\"p\":\"언어 이전기 비구어 행동의 의도로 의사소통 기능 판단\",\"n\":\"요구하기: 원하는 사물 획득 시도, 거부하기: 싫은 것 밀어내기·외면\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 1학년 아동 평가 결과\\n• 수용·표현 어휘력 검사(REVT) 백분위수: 수용 8, 표현 6\\n• 비언어성 지능: 정상 범위\\n• 청력: 정상\\n• 자발화: 조사 생략과 제한된 어휘 사용 관찰\",\"q\":\"다음 결과에 근거한 부모 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"\\\"어휘력이 또래보다 유의하게 낮아 언어치료가 필요해요.\\\"\",\"\\\"청력 손실이 원인이므로 보청기 착용이 필요해요.\\\"\",\"\\\"지능이 낮아서 나타나는 현상이므로 인지치료가 우선이에요.\\\"\",\"\\\"발음 문제가 핵심이므로 조음치료를 시작해야 해요.\\\"\",\"\\\"정상 범위이므로 치료 없이 지켜봐도 돼요.\\\"\"],\"answer\":1,\"explain\":\"REVT 백분위수 10 미만은 또래 대비 유의한 어휘 지체를 의미한다. 비언어성 지능과 청력이 정상이므로 언어 영역에 특정된 어려움이며, 어휘·문법을 목표로 한 언어치료가 권고된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"어휘·의미\",\"k\":\"어휘 지체 부모 상담\",\"p\":\"REVT 백분위와 지능·청력 정상 결과로 부모 상담 내용 선택\",\"n\":\"REVT 백분위 10 미만: 유의한 어휘 지체, 언어 특정 어려움으로 치료 권고\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"간식 시간에 치료사가 아동이 좋아하는 주스를 아동 눈에 보이지만 손이 닿지 않는 선반에 올려 두고, 뚜껑을 꼭 닫은 채 건네준 뒤 아동의 반응을 기다린다.\",\"q\":\"위 장면에서 사용된 중재 전략은?\",\"choices\":[\"청각적 집중 자극\",\"스크립트 문맥 활용\",\"비연속 개별시도 교수\",\"반응대가 기법\",\"환경 조성 전략\"],\"answer\":5,\"explain\":\"환경중심 언어중재의 환경 조성 전략은 원하는 물건을 보이지만 닿지 않게 두거나 도움이 필요한 상황(닫힌 뚜껑)을 만들어 아동이 자발적으로 요구하기를 산출하도록 유도하는 방법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"환경중심 중재 전략\",\"p\":\"보이지만 닿지 않는 배치와 닫힌 뚜껑 상황으로 중재 전략 식별\",\"n\":\"환경 조성 전략: 도움이 필요한 상황을 만들어 자발적 요구 유도\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 4학년 아동 언어평가 결과\\n• 상위개념 어휘 이해: 또래 하위 5%\\n• 동의어·반의어 표현: 또래 하위 3%\\n• 복문 산출과 문법형태소 사용: 연령 수준\\n• 조음 및 읽기 해독: 연령 수준\",\"q\":\"다음 아동에게 우선적으로 설정할 중재 목표는?\",\"choices\":[\"문법형태소 오류 수정\",\"낱말 해독 정확도 향상\",\"복문 산출 능력 향상\",\"조음 정확도 향상\",\"의미 관계 어휘 확장\"],\"answer\":5,\"explain\":\"구문·조음·해독은 연령 수준이나 어휘의 의미 관계 영역(상위개념, 동의어·반의어)에서만 유의한 지체를 보이므로, 의미론적 어휘 조직화를 확장하는 중재가 우선 목표가 된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"어휘·의미\",\"k\":\"의미 관계 어휘 목표\",\"p\":\"구문·조음 정상과 상위개념·동의어 지체로 우선 중재 목표 선택\",\"n\":\"의미 관계 어휘 지체: 상위개념·동의어·반의어 중심 어휘 조직화 확장\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 5세 남아\\n• 상대방의 말을 그대로 따라 말함\\n• 대명사를 뒤바꿔 사용함(너/나 혼동)\\n• 특정 관심사를 반복적으로 언급하고 눈맞춤이 부족함\",\"q\":\"다음 아동에게 의심되는 장애는?\",\"choices\":[\"단순언어장애\",\"고도 청각장애\",\"경도 지적장애\",\"자폐스펙트럼장애\",\"조음음운장애\"],\"answer\":4,\"explain\":\"반향어, 대명사 전도, 제한된 관심사의 반복, 눈맞춤 부족, 상호작용의 어려움은 자폐스펙트럼장애의 대표적 언어·의사소통 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"자폐스펙트럼장애 특성\",\"p\":\"반향어·대명사 전도·제한된 관심사·눈맞춤 부족으로 장애 판단\",\"n\":\"자폐스펙트럼장애: 반향어, 대명사 전도, 반복 관심사, 상호작용 결함\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"(아동 이야기 전사 자료)\\n토끼랑 거북이가 달리기를 했어요. 토끼는 빨리 뛰다가 낮잠을 잤어요. 그래서 거북이가 먼저 도착했어요.\",\"q\":\"위 아동 발화의 최소종결단위(T-unit) 수는?\",\"choices\":[\"2\",\"3\",\"4\",\"5\",\"6\"],\"answer\":2,\"explain\":\"T-unit은 하나의 주절과 그에 딸린 종속절을 한 단위로 센다. 세 문장이 각각 하나의 T-unit이므로 T-unit 수는 3이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"T-unit 수 산출\",\"p\":\"주절과 딸린 종속절 단위로 이야기 전사의 T-unit 수 산출\",\"n\":\"T-unit: 하나의 주절과 그에 딸린 종속절을 한 단위로 계산\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"언어재활사가 아동에게 다음과 같이 질문하였다.\\n• \\\"친구가 '창문이 열려 있네'라고 말하면 무슨 뜻일까요?\\\"\\n• \\\"수업 시간에 딴짓하는 친구에게 선생님이 '지금 뭐 하고 있니?'라고 하면 진짜 궁금해서 물어보는 걸까요?\\\"\",\"q\":\"위 질문으로 평가하려는 능력은?\",\"choices\":[\"음운인식 능력\",\"구문 산출 능력\",\"상위화용 능력\",\"낱말 해독 능력\",\"조음 정확도\"],\"answer\":3,\"explain\":\"'창문이 열려 있네'의 함축(닫아 달라)이나 반어적 발화의 진짜 의도를 파악하는 것은 간접표현·함축 이해로, 상위화용 능력에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"화용·대화\",\"k\":\"상위화용 평가 과제\",\"p\":\"함축·반어적 발화의 의도 파악 질문으로 평가 능력 식별\",\"n\":\"상위화용: 간접표현·함축·반어의 진짜 의도 이해\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동: 차 가.\\n치료사: 차가 가네.\",\"q\":\"위 장면에서 치료사가 사용한 기법은?\",\"choices\":[\"확장(expansion)\",\"치료사 혼잣말기법\",\"아동 평행발화기법\",\"확대(extension)\",\"낱말 분리 및 합성\"],\"answer\":1,\"explain\":\"확장(expansion)은 아동 발화의 의미는 유지하면서 문법적으로 완전한 형태로 다시 들려주는 기법이다. 확대는 새로운 의미 정보를 덧붙이는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"확장 기법 식별\",\"p\":\"아동 발화 의미 유지와 문법적 완성 여부로 치료사 기법 식별\",\"n\":\"확장: 의미 유지하며 문법적으로 완전하게 재진술, 확대는 새 정보 추가\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"생일잔치, 마트 놀이 등 친숙한 일상 활동의 익숙한 순서를 활용하여 언어를 촉진하는 중재 접근은?\",\"choices\":[\"감각통합 치료\",\"청지각 훈련\",\"스크립트 중재\",\"핵심어휘 접근법\",\"청각구어법\"],\"answer\":3,\"explain\":\"스크립트 중재는 아동에게 친숙한 일상 사건의 구조(스크립트)를 활용하여 인지적 부담을 줄이고 새로운 언어 형식의 학습을 촉진한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"스크립트 중재 정의\",\"p\":\"친숙한 일상 활동의 순서 구조 활용 설명으로 중재 접근 식별\",\"n\":\"스크립트 중재: 익숙한 사건 구조로 인지 부담 감소, 새 언어 형식 촉진\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"중심축 반응중재(PRT)의 핵심 특징으로 옳은 것은?\",\"choices\":[\"치료사가 모든 자극과 강화를 통제하는 개별시도 형식으로 진행한다\",\"아동의 주도를 활용하고 자연적 강화를 사용한다\",\"구조화된 책상 과제에서 인위적 강화물로 반복 시행한다\",\"언어보다 구강운동 훈련에 초점을 둔다\",\"성인 주도의 지시 따르기를 우선한다\"],\"answer\":2,\"explain\":\"중심축 반응중재(PRT)는 아동의 선택·주도를 활용하고 동기·복합단서 반응 등 중심축(pivotal) 영역을 목표로 하며, 자연적 강화(원하는 것 제공)를 사용하는 자연주의적 중재이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"PRT 핵심 특징\",\"p\":\"아동 주도와 강화 유형 구분으로 PRT의 특징 식별\",\"n\":\"중심축 반응중재: 아동 선택·주도 활용, 자연적 강화의 자연주의 중재\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동의 자발화를 분석한 결과, 전체 낱말 수(NTW)는 40개, 서로 다른 낱말 수(NDW)는 20개였다.\",\"q\":\"이 아동의 어휘다양도(TTR)는?\",\"choices\":[\"0.4\",\"0.5\",\"0.6\",\"0.8\",\"2.0\"],\"answer\":2,\"explain\":\"어휘다양도(TTR) = 서로 다른 낱말 수 ÷ 전체 낱말 수 = 20 ÷ 40 = 0.5이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"TTR 산출\",\"p\":\"서로 다른 낱말 수를 전체 낱말 수로 나누어 TTR 산출\",\"n\":\"TTR: NDW ÷ NTW\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"그림교환의사소통체계(PECS) 훈련에서 가장 먼저 지도하는 것은?\",\"choices\":[\"여러 그림 중에서 목표 그림을 골라 변별하기\",\"'나는 ~을 원해요' 문장판을 구성하기\",\"여러 그림을 보고 감정을 설명하기\",\"그림 없이 음성으로 원하는 것 요구하기\",\"원하는 사물의 그림카드를 상대에게 건네기\"],\"answer\":5,\"explain\":\"PECS는 1단계에서 원하는 사물의 그림카드를 의사소통 상대에게 건네는 '교환(요구하기)'을 먼저 지도하고, 변별·문장 구성 등은 이후 단계에서 다룬다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"PECS 훈련 단계\",\"p\":\"PECS 단계 순서 지식으로 가장 먼저 지도할 내용 식별\",\"n\":\"PECS 1단계: 원하는 사물 그림카드를 상대에게 건네는 교환\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"이야기 문법(story grammar)의 구성 요소에 해당하지 않는 것은?\",\"choices\":[\"시도\",\"계기사건\",\"내적 반응\",\"어휘다양도\",\"배경\"],\"answer\":4,\"explain\":\"이야기 문법은 배경, 계기사건, 내적 반응, 시도, 결과, 결말 등으로 구성된다. 어휘다양도(TTR)는 어휘 사용의 다양성을 나타내는 지표로 이야기 문법 요소가 아니다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"이야기·담화\",\"k\":\"이야기 문법 구성 요소\",\"p\":\"이야기 문법 요소와 어휘 지표 구분으로 비해당 요소 식별\",\"n\":\"이야기 문법: 배경·계기사건·내적 반응·시도·결과·결말\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 초등 1학년 아동, 한국 비언어성 지능검사(K-CTONI-2) 지능지수 96(정상)\\n• 또래와 대화 시 눈맞춤이 짧고 상황에 맞지 않는 말과 주제 이탈이 잦음\\n• 농담·비유·간접표현을 문자 그대로 받아들임\\n• 제한된 관심사·상동행동·감각 특이성은 관찰되지 않음\\n• 한국 아동 메타-화용언어 검사(KOPLAC) 상위언어 인식 3%ile\",\"q\":\"위 아동에게 가장 의심되는 진단은?\",\"choices\":[\"고기능 자폐스펙트럼장애\",\"경계선 지적장애\",\"사회적 의사소통장애\",\"단순언어장애\",\"읽기 학습장애\"],\"answer\":3,\"explain\":\"지능이 정상이고 제한된 관심사·상동행동이 없으면서 화용(대화 규칙·간접표현) 결함이 두드러지면 자폐스펙트럼장애가 아니라 사회적(화용) 의사소통장애로 감별한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"화용·대화\",\"k\":\"사회적 의사소통장애 감별\",\"p\":\"지능 정상·제한된 관심사 부재·화용 결함 조합으로 진단 판단\",\"n\":\"사회적 의사소통장애: 화용 결함 중심, 제한·반복 행동 없음으로 ASD와 감별\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등 3학년 아동이 형태소 규칙으로 설명되지 않는 관습적 표기 낱말에서 오류를 보인다.\\n• 할게요 → '할께요'\\n• 왠지 → '웬지'\\n• 며칠 → '몇일'\",\"q\":\"위 아동에게 필요한 쓰기 중재로 가장 적절한 것은?\",\"choices\":[\"표기형을 기억하고 인출하도록 돕는 표기처리 중심 중재\",\"형태소 원형을 밝혀 적도록 하는 형태처리 중재\",\"소리 나는 대로 적도록 하는 음운처리 중심 중재\",\"조음 정확도를 높이는 조음 중재\",\"읽기 유창성 훈련\"],\"answer\":1,\"explain\":\"형태소 규칙으로 설명되지 않고 관습적으로 굳어진 표기(할게요, 왠지, 며칠 등)의 오류는, 낱말의 표기형(철자 패턴) 자체를 기억·인출하도록 돕는 표기처리 중심 중재가 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"읽기·쓰기\",\"k\":\"철자 오류 쓰기 중재\",\"p\":\"형태소 규칙으로 설명 안 되는 관습 표기 오류로 중재 유형 선택\",\"n\":\"표기처리 중심 중재: 관습적 표기형 자체를 기억·인출하도록 지도\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"(아동 발화를 전사한 자료)\\n24개월 아동의 발화\\n\\\"엄마 밥\\\", \\\"아빠 어디\\\", \\\"이거 줘\\\", \\\"물 먹어\\\"\",\"q\":\"위 발화 단계에 대한 설명으로 옳은 것은?\",\"choices\":[\"복문을 산출하는 단계이다\",\"두 낱말을 조합하는 초기 문법 단계이다\",\"한 낱말 시기(일어문)에 해당한다\",\"문법형태소 오류가 빈번한 단계이다\",\"이야기 문법을 갖춘 담화를 산출하는 단계이다\"],\"answer\":2,\"explain\":\"'엄마 밥', '이거 줘'처럼 두 낱말을 조합하지만 조사·어미 등 문법형태소가 아직 나타나지 않는 것은 초기 문법 단계(두 낱말 시기)의 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"초기 문법 발달 단계\",\"p\":\"두 낱말 조합과 문법형태소 부재로 발화 발달 단계 판단\",\"n\":\"두 낱말 시기: 낱말 조합 시작, 조사·어미 등 문법형태소 미출현\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"정상적인 비유창성을 보이는 아동의 말을 부모가 '말더듬'으로 잘못 진단하고 부정적으로 반응함으로써, 아동이 자신의 말을 의식하고 긴장·회피하게 되어 말더듬으로 발전한다고 보는 이론이다.\",\"q\":\"위 설명에 해당하는 말더듬 발생 이론은?\",\"choices\":[\"예기투쟁가설\",\"진단착오이론\",\"요구용량모델\",\"내적수정가설\",\"대뇌반구우세이론\"],\"answer\":2,\"explain\":\"진단착오이론(Johnson)은 정상적 비유창성을 부모가 말더듬으로 잘못 진단·반응하면서 아동이 말을 의식·긴장·회피하게 되어 말더듬으로 발전한다고 보는 이론이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"말더듬 발생 이론\",\"p\":\"부모의 잘못된 진단·반응이 원인이라는 설명으로 이론 식별\",\"n\":\"진단착오이론(Johnson): 정상 비유창을 말더듬으로 오진·반응해 발전\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\\\"저저저는 어 (막힘)토요일에 ㅅㅅㅅ수영장에 가서 수---영을 배워요.\\\"\",\"q\":\"다음 발화에서 나타난 진성 비유창성(SLD)의 횟수는?\",\"choices\":[\"2회\",\"3회\",\"4회\",\"5회\",\"6회\"],\"answer\":3,\"explain\":\"진성 비유창성은 단어부분반복('저저저', 'ㅅㅅㅅ수'), 막힘 1회, 연장('수---') 1회로 총 4회이다. 간투사 '어'는 기타(정상적) 비유창성으로 분류한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"SLD 횟수 산출\",\"p\":\"반복·막힘·연장과 간투사 구분으로 진성 비유창성 횟수 산출\",\"n\":\"SLD: 단어부분반복·연장·막힘, 간투사는 기타 비유창성\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 발화 표본: 총 150음절\\n• 말더듬이 나타난 음절: 12음절\",\"q\":\"위 대상자의 말더듬 음절 백분율(%SS)은?\",\"choices\":[\"6%\",\"8%\",\"10%\",\"12.5%\",\"15%\"],\"answer\":2,\"explain\":\"%SS = (말더듬 음절 수 ÷ 전체 음절 수) × 100 = 12 ÷ 150 × 100 = 8%.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"%SS 산출\",\"p\":\"말더듬 음절 수를 전체 음절 수로 나누어 %SS 산출\",\"n\":\"%SS: 말더듬 음절 수 ÷ 전체 음절 수 × 100\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 '빙산 모델(iceberg model)'에서 수면 아래에 해당하는 요소로 가장 적절한 것은?\",\"choices\":[\"겉으로 드러나는 반복·연장·막힘\",\"관찰 가능한 신체적 부수행동\",\"말속도와 조음의 정확도\",\"말더듬에 대한 두려움과 수치심\",\"발화에서 나타난 문법 오류\"],\"answer\":4,\"explain\":\"빙산 모델에서 수면 위는 반복·연장·막힘 등 겉으로 드러나는 행동이고, 수면 아래는 말더듬에 대한 두려움·수치심·좌절 등 겉으로 드러나지 않는 감정과 태도이다. 치료에서는 수면 아래 요소도 함께 다루어야 한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"빙산 모델 구성\",\"p\":\"관찰 가능한 행동과 내면 감정·태도 구분으로 수면 아래 요소 식별\",\"n\":\"빙산 모델: 수면 위 핵심행동, 수면 아래 두려움·수치심·좌절\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 38세 여성, 6개월 전 교통사고로 가족을 잃은 후 말더듬 시작\\n• 아동기 말더듬 병력 없음\\n• 모든 낱말과 문법적 위치에서 유사한 형태의 반복이 일관되게 나타남\\n• 반복해서 읽어도 말더듬 빈도가 줄지 않음\\n• 부수행동이나 말에 대한 불안이 거의 관찰되지 않음\",\"q\":\"다음 대상자에게 의심되는 유창성장애 유형은?\",\"choices\":[\"위장 말더듬\",\"신경학적 말더듬\",\"심인성 말더듬\",\"속화\",\"발달성 말더듬\"],\"answer\":3,\"explain\":\"심리적 외상 후 성인기에 갑자기 발생하고, 낱말 유형·위치와 무관하게 일관된 형태를 보이며, 적응효과가 없고 이차행동·불안이 거의 없는 양상은 심인성 말더듬의 특징이다. 신경학적 말더듬은 뇌손상 병력이 확인되어야 한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"발달 단계·감별\",\"k\":\"후천성 말더듬 감별\",\"p\":\"외상 후 성인기 발병·적응효과 부재·불안 없음으로 유형 판단\",\"n\":\"심인성 말더듬: 심리적 외상 후 발병, 일관된 형태, 적응효과 없음\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 초등학교 4학년 남아\\n• 파라다이스-유창성 검사-II(P-FA-II) 필수과제 백분위: 1~10%ile\\n• 의사소통태도 평가 점수: 17점\",\"q\":\"이 아동의 평가 결과에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"말더듬 정도와 의사소통태도가 모두 약하므로 유창성 완성법에 비중을 둔다\",\"말더듬에 비해 의사소통태도가 부정적이어서 핸디캡을 줄이는 상담·치료가 필요하다\",\"말더듬 정도와 의사소통태도가 모두 심하므로 말더듬 수정법과 심리치료 의뢰를 고려한다\",\"의사소통태도 점수가 높을수록 긍정적이므로 말하기에 자신감이 있는 상태이다\",\"필수과제가 1~10%ile이므로 정상 범위로 보고 치료가 필요하지 않다\"],\"answer\":2,\"explain\":\"P-FA-II 필수과제 1~10%ile은 말더듬 정도 '약함'에 해당한다. 의사소통태도 평가는 말을 더듬는 사람이 할 법한 답에 1점을 주므로 점수가 높을수록 부정적이며, 초등학생 17점은 81~90%ile로 '심함'에 해당한다(초등학생 평균 12.0점). 구어평가 결과보다 의사소통태도 평가 결과가 더 심하게 나타나면 말더듬으로 인한 심리적 문제와 핸디캡이 심각하므로 이를 줄이는 상담과 치료가 필요하다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"P-FA-II 구어·태도 불일치 해석\",\"p\":\"말더듬 정도와 의사소통태도 결과를 비교해 임상적 의미 판단\",\"n\":\"P-FA-II 의사소통태도: 점수 높을수록 부정적, 구어보다 태도가 심하면 핸디캡 줄이는 상담·치료\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 남아, 말더듬 시작 10개월 경과\\n• 부모가 훈련을 받고 가정의 일상 대화에서 중재를 실시함\\n• 아동의 유창한 발화에 \\\"부드럽게 잘 말했네!\\\"라고 칭찬함\\n• 말더듬이 나타나면 가끔씩 \\\"방금 좀 울퉁불퉁했네, 다시 말해 볼까?\\\"라고 요청함\\n• 치료사는 매주 말더듬 심한 정도(SR) 기록을 확인함\",\"q\":\"위 중재에 해당하는 프로그램은?\",\"choices\":[\"스토커 프로브 테크닉\",\"말더듬수정법\",\"리드콤 프로그램\",\"점진적 발화길이 및 복잡성 증가 프로그램(GILCU)\",\"페일린 부모-아동 상호작용치료\"],\"answer\":3,\"explain\":\"부모가 일상 대화에서 유창한 발화에 언어적 칭찬을, 말더듬에 간헐적인 수정 요청을 제공하고 말더듬 심한 정도(SR) 척도로 진전을 관리하는 것은 조작적 조건화 기반의 리드콤 프로그램이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"리드콤 프로그램 식별\",\"p\":\"부모 실시 언어적 수반자극과 SR 기록으로 치료 프로그램 식별\",\"n\":\"리드콤: 부모가 유창 발화 칭찬·말더듬 수정 요청, SR로 진전 관리\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대상자가 낱말에서 말을 더듬은 직후 잠시 멈추고, 긴장을 풀고 나서 방금 더듬었던 낱말을 편안한 방식으로 다시 산출하였다.\",\"q\":\"위 장면에서 사용된 말더듬수정법의 기법은?\",\"choices\":[\"가벼운 조음접촉\",\"빠져나오기\",\"예비책\",\"둔감화\",\"취소\"],\"answer\":5,\"explain\":\"취소(cancellation)는 말더듬이 끝난 후 잠시 멈추었다가 더듬은 낱말을 긴장을 줄인 방식으로 다시 말하는 기법이다. 빠져나오기는 말더듬 도중에, 예비책은 말더듬이 예상되는 낱말 이전에 적용한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬 수정법 단계\",\"p\":\"더듬은 뒤 멈추고 다시 말하는 시점으로 수정 기법 식별\",\"n\":\"취소: 말더듬 종료 후 멈추고 더듬은 낱말을 편안하게 재산출\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 말속도가 빠르고 불규칙함\\n• 음절 생략과 낱말 축약이 잦아 명료도가 낮음\\n• 주제에서 자주 벗어나며 발화 조직화가 어려움\\n• 자신의 말 문제를 잘 인식하지 못함\",\"q\":\"다음 특성을 보이는 대상자에게 우선적으로 적용할 중재 방법은?\",\"choices\":[\"가벼운 조음접촉 확립 훈련\",\"호흡과 발성의 협응 훈련\",\"말속도 조절과 자기 인식 훈련\",\"단계적 둔감화 훈련\",\"회피행동 감소 훈련\"],\"answer\":3,\"explain\":\"속화(말빠름증)의 핵심 중재는 말속도를 조절하고(속도 낮추기, 쉼 넣기) 자신의 말을 인식하는 자기 모니터링 능력을 기르는 것이다. 속화 화자는 문제 인식이 부족하므로 녹음 청취 등 인식 훈련이 중요하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"발달 단계·감별\",\"k\":\"속화 중재 방법\",\"p\":\"빠르고 불규칙한 말속도와 문제 인식 부족으로 중재 방법 선택\",\"n\":\"속화 중재: 말속도 조절과 녹음 청취 등 자기 모니터링 훈련\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬 정도 측정 검사(SSI-4)에서 말더듬 중증도 산출에 포함되는 요소로 옳게 묶인 것은?\",\"choices\":[\"말더듬 빈도, 말속도, 조음정확도\",\"말더듬 빈도, 어휘다양도, 발화길이\",\"지속시간, 음도, 강도\",\"의사소통태도, 자아효능감, 회피 정도\",\"말더듬 빈도, 지속시간, 신체적 부수행동\"],\"answer\":5,\"explain\":\"SSI-4는 말더듬 빈도(%SS), 지속시간(가장 긴 말더듬 3개의 평균), 신체적 부수행동의 세 요소 점수를 합산하여 중증도를 산출한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"SSI-4 산출 요소\",\"p\":\"SSI-4 하위 점수 구성 지식으로 중증도 산출 요소 식별\",\"n\":\"SSI-4: 말더듬 빈도·지속시간·신체적 부수행동 점수 합산\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인의 치료 전후 자아효능감 척도(SESAS) 수행 점수가 30점에서 74점으로 상승하였다.\",\"q\":\"위 변화에 대한 해석으로 옳은 것은?\",\"choices\":[\"말더듬 빈도가 증가하였다\",\"의사소통 태도가 부정적으로 변하였다\",\"말에 대한 통제력이 감소하였다\",\"치료 효과가 나타나지 않았다\",\"말에 대한 자아효능감이 향상되었다\"],\"answer\":5,\"explain\":\"자아효능감 척도(SESAS)는 점수가 높을수록 유창하게 말할 수 있다는 자신감이 크다는 의미이므로, 30→74점의 상승은 자아효능감(자신감)의 향상을 나타낸다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"SESAS 점수 해석\",\"p\":\"척도 점수 방향과 전후 변화로 치료 효과 해석 판단\",\"n\":\"SESAS: 점수가 높을수록 유창하게 말할 수 있다는 자아효능감 큼\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 아동의 아버지가 아이가 말을 더듬을 때마다 \\\"천천히 말해\\\", \\\"다시 말해 봐\\\"라고 지적하고, 아이의 말을 대신 끝맺어 준다.\",\"q\":\"위 아버지에게 제공할 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"말을 더듬을 때마다 즉시 교정해 주세요\",\"아이의 말을 대신 끝맺어 시간을 줄여 주세요\",\"아이의 말을 끝까지 기다리며 들어 주세요\",\"더 빠르게 말하는 시범을 보여 주세요\",\"말더듬는 낱말을 여러 번 반복시켜 주세요\"],\"answer\":3,\"explain\":\"말더듬 아동에게는 지적·교정·대신 말하기·시간 압박이 유창성을 방해한다. 지적을 줄이고 아이의 말을 끝까지 기다리며 느리고 편안한 대화 분위기를 만드는 것이 권장된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"말더듬 아동 부모 상담\",\"p\":\"지적·대신 말하기 등 부모 반응으로 적절한 상담 내용 선택\",\"n\":\"부모 상담: 지적·교정·대신 말하기 지양, 끝까지 기다리며 듣기\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 핵심행동(core behavior)에 해당하지 않는 것은?\",\"choices\":[\"막힘\",\"소리 연장\",\"단어부분 반복\",\"음절 반복\",\"눈 깜빡임\"],\"answer\":5,\"explain\":\"핵심행동은 반복, 연장, 막힘이다. 눈 깜빡임, 고개 젖히기 등은 핵심행동에서 벗어나거나 피하려는 부수행동(이차행동)이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"핵심행동과 부수행동\",\"p\":\"핵심행동과 부수행동의 구분으로 핵심행동 비해당 요소 식별\",\"n\":\"핵심행동: 반복·연장·막힘, 눈 깜빡임 등은 부수행동\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"발달성 말더듬에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"대부분 성인기에 처음 발생한다\",\"남아가 여아보다 유병률이 높다\",\"상당수는 자연회복된다\",\"발생에 유전적 요인이 관여한다\",\"대부분 학령전기(2~5세)에 시작된다\"],\"answer\":1,\"explain\":\"발달성 말더듬은 대부분 2~5세 학령전기에 시작되며 남아에게 더 흔하고 유전적 요인이 관여하며 상당수 자연회복된다. 성인기 최초 발병이 흔하다는 설명은 옳지 않다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"발달성 말더듬 역학\",\"p\":\"발생 시기·성비·자연회복·유전 요인 지식으로 틀린 설명 식별\",\"n\":\"발달성 말더듬: 2~5세 시작, 남아 우세, 유전 관여, 상당수 자연회복\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬수정법(Van Riper)의 궁극적인 목표로 가장 적절한 것은?\",\"choices\":[\"말더듬을 편안하고 쉽게 더듬는 것\",\"완전히 유창한 말을 확립하는 것\",\"말더듬을 완전히 제거하는 것\",\"회피행동을 강화하는 것\",\"느린 말을 영구적으로 사용하는 것\"],\"answer\":1,\"explain\":\"말더듬수정법은 말더듬을 완전히 없애기보다, 두려움과 긴장을 줄여 편안하고 쉽게 더듬으면서 자유롭게 의사소통하도록 하는 것을 목표로 한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬 수정법 목표\",\"p\":\"유창성 확립과 편하게 더듬기 목표 구분으로 수정법 목표 식별\",\"n\":\"말더듬수정법: 두려움·긴장 감소, 편안하고 쉽게 더듬기가 목표\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"정상적 비유창성(기타 비유창성)에 가장 가까운 것은?\",\"choices\":[\"긴장된 막힘\",\"소리 연장\",\"긴장을 동반한 음절 반복\",\"간투사·구 반복·수정\",\"긴장을 동반한 일음절 낱말 반복\"],\"answer\":4,\"explain\":\"간투사, 구 반복, 수정, 미완성 등은 정상적 비유창성(기타 비유창성)에 해당한다. 긴장을 동반한 음절 반복·연장·막힘은 진성 비유창성(SLD)에 가깝다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"비유창성 분석\",\"k\":\"정상적 비유창성 유형\",\"p\":\"긴장 동반 여부와 비유창성 유형으로 정상적 비유창성 식별\",\"n\":\"기타 비유창성: 간투사·구 반복·수정·미완성\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"신경학적 말더듬(neurogenic stuttering)에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"뇌졸중·외상성 뇌손상 등 이후에 발생할 수 있다\",\"반복해 읽어도 적응효과가 잘 나타나지 않는다\",\"낱말 유형·위치와 무관하게 비유창이 나타나는 경향이 있다\",\"발달성 말더듬에 비해 부수행동과 불안이 적은 편이다\",\"심리적 외상이나 정서적 갈등이 주된 원인이다\"],\"answer\":5,\"explain\":\"신경학적 말더듬은 신경학적 손상 이후 발생하고 적응효과가 미약하며 낱말 위치와 무관하게 나타난다. 심리적 외상이 주된 원인인 것은 심인성 말더듬의 특징이므로 옳지 않다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"발달 단계·감별\",\"k\":\"신경학적 말더듬 특징\",\"p\":\"발생 원인과 적응효과·부수행동 특성으로 틀린 설명 식별\",\"n\":\"신경학적 말더듬: 뇌손상 후 발생, 적응효과 미약, 위치 무관 비유창\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬을 '말더듬을 예상하고 이를 피하려는 투쟁 반응'으로 설명하는 이론은?\",\"choices\":[\"대뇌우세이론\",\"진단착오이론\",\"요구용량모델\",\"예기투쟁가설\",\"이원이론\"],\"answer\":4,\"explain\":\"예기투쟁가설은 화자가 말더듬을 예상하고 이에 대해 긴장·투쟁·회피하는 반응이 말더듬을 유발·악화시킨다고 보는 이론이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"말더듬 발생 이론\",\"p\":\"말더듬 예상과 투쟁·회피 반응 설명으로 이론 식별\",\"n\":\"예기투쟁가설: 말더듬 예상에 따른 긴장·투쟁·회피가 말더듬 유발\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"같은 문장을 여러 번 반복해서 읽을 때 말더듬 빈도가 점차 감소하는 현상은?\",\"choices\":[\"일관성효과\",\"자발회복\",\"인접효과\",\"후속효과\",\"적응효과\"],\"answer\":5,\"explain\":\"적응효과는 동일한 자료를 반복해서 읽을수록 말더듬 빈도가 감소하는 현상이다. 일관성효과는 같은 낱말·위치에서 반복적으로 더듬는 경향을 말한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"적응효과 정의\",\"p\":\"동일 자료 반복 읽기 시 빈도 감소 현상으로 용어 식별\",\"n\":\"적응효과: 반복 읽기로 말더듬 빈도 감소, 일관성효과와 구분\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬 화자의 회피행동(회피)에 해당하지 않는 것은?\",\"choices\":[\"돌려서 에둘러 말하기\",\"막힘 중 고개를 젖히기\",\"말할 순서를 뒤로 미루기\",\"전화 받는 상황을 피하기\",\"다른 낱말로 바꾸어 말하기\"],\"answer\":2,\"explain\":\"낱말 대치, 에두르기, 상황·순서 회피는 말더듬을 예상하고 미리 피하는 회피행동이다. 막힘 도중 벗어나려고 고개를 젖히는 것은 이미 시작된 말더듬에서 빠져나오려는 탈출행동이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"회피행동과 탈출행동\",\"p\":\"말더듬 발생 전후 시점으로 회피행동과 탈출행동 구분 식별\",\"n\":\"회피행동: 낱말 대치·에두르기·상황 회피, 탈출행동: 막힘 중 벗어나기\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"유창성완성법(fluency shaping)에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"느린 말·부드러운 발성 시작으로 유창한 말을 확립한다\",\"느린 속도에서 가벼운 조음접촉을 활용한다\",\"확립된 유창성을 점차 실제 상황으로 일반화한다\",\"말더듬 자체보다 유창한 말 패턴 형성에 초점을 둔다\",\"취소·빠져나오기로 말더듬 순간을 수정한다\"],\"answer\":5,\"explain\":\"취소·빠져나오기는 말더듬수정법의 기법이다. 유창성완성법은 느린 말·부드러운 시작·가벼운 조음접촉으로 유창한 말을 확립하여 일반화하는 접근이므로 '말더듬 순간 수정에 초점'은 옳지 않다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"유창성완성법 특징\",\"p\":\"두 치료 접근의 기법 구분으로 유창성완성법의 틀린 설명 식별\",\"n\":\"유창성완성법: 느린 말·부드러운 시작·가벼운 접촉, 취소·빠져나오기는 수정법\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"자신의 말을 짧은 지연 후에 듣게 하여 말속도를 늦추고 유창성을 유도하는 기기는?\",\"choices\":[\"청각 차폐기(MAF)\",\"지연청각피드백(DAF)\",\"비음측정기(나조미터)\",\"전기성문파형기(EGG)\",\"음향 스펙트로그램\"],\"answer\":2,\"explain\":\"지연청각피드백(DAF)은 화자의 말을 짧게 지연시켜 다시 들려줌으로써 말속도를 늦추고 유창성을 촉진하는 기기이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"유창성 보조 기기\",\"p\":\"자기 말을 지연시켜 들려주는 원리로 해당 기기 식별\",\"n\":\"지연청각피드백(DAF): 지연 청취로 말속도 저하·유창성 촉진\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"에릭슨 의사소통태도 검사(S-24)가 측정하는 것은?\",\"choices\":[\"말더듬의 빈도\",\"말더듬 지속시간\",\"의사소통에 대한 태도\",\"신체적 부수행동\",\"말속도와 조음속도\"],\"answer\":3,\"explain\":\"S-24는 말더듬 화자가 의사소통에 대해 갖는 부정적 태도(신념)를 측정하는 자기보고식 척도이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"S-24 측정 영역\",\"p\":\"자기보고 척도의 측정 대상 지식으로 S-24 평가 영역 식별\",\"n\":\"S-24: 의사소통에 대한 부정적 태도를 측정하는 자기보고식 척도\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대상자가 말을 더듬을 것으로 예상되는 낱말 직전에, 미리 긴장을 줄이고 부드럽게 첫소리에 접근하여 산출하였다.\",\"q\":\"위 장면에서 사용된 말더듬수정법의 기법은?\",\"choices\":[\"예비책\",\"빠져나오기\",\"취소\",\"둔감화\",\"고유수용감각 훈련\"],\"answer\":1,\"explain\":\"예비책(preparatory set)은 말더듬이 예상되는 낱말을 산출하기 직전에 미리 긴장을 줄이고 부드럽게 접근하여 말더듬을 예방하는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬 수정법 단계\",\"p\":\"말더듬 예상 낱말 직전 적용 시점으로 수정 기법 식별\",\"n\":\"예비책: 더듬을 것이 예상되는 낱말 직전 긴장 줄이고 부드럽게 접근\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"음성 산출의 음원-여과기 이론(source-filter theory)에 대한 설명으로 옳은 것은?\",\"choices\":[\"포먼트는 성대 진동수에 의해 직접 결정된다\",\"기본주파수는 성도 길이로만 결정된다\",\"성대 진동이 음원, 성도가 여과기로 작용한다\",\"음원과 여과기는 물리적으로 동일한 구조이다\",\"여과기 기능은 폐의 공기압이 담당한다\"],\"answer\":3,\"explain\":\"음원-여과기 이론에서는 성대 진동이 음원(source)이 되어 기본주파수와 배음을 만들고, 성도(공명강)가 여과기(filter)로 작용하여 특정 주파수를 강조·감쇠함으로써 포먼트가 형성된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"음원-여과기 이론\",\"p\":\"성대와 성도의 역할 구분으로 음원-여과기 이론 설명 식별\",\"n\":\"음원-여과기 이론: 성대 진동이 음원, 성도가 여과기로 포먼트 형성\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"발성 시 음도(pitch)를 높이는 생리적 기전으로 옳은 것은?\",\"choices\":[\"성대가 짧아지고 두꺼워지면서 진동수가 증가한다\",\"윤상갑상근이 수축해 성대가 길어지고 긴장된다\",\"호기류량만 증가시키면 음도가 높아진다\",\"성문하압을 낮추면 음도가 높아진다\",\"갑상피열근만 이완시키면 음도가 높아진다\"],\"answer\":2,\"explain\":\"음도는 성대의 진동수에 의해 결정된다. 윤상갑상근(CT)이 수축하면 성대가 길어지고 긴장되어 진동수가 증가하므로 음도가 높아진다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"음도 상승 생리 기전\",\"p\":\"성대 길이·긴장 변화 근거로 음도 상승 기전 식별\",\"n\":\"윤상갑상근 수축: 성대 신장·긴장 증가로 진동수·음도 상승\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"공기역학적 검사 결과\\n• 폐활량: 정상 범위\\n• 최대연장발성시간(MPT): 5.2초\\n• 평균호기류율: 260 mL/sec (증가)\\n• 성문하압: 정상 범위\\n• 청지각적으로 기식적이고 약한 음성\",\"q\":\"다음 결과에서 추정되는 음성장애는?\",\"choices\":[\"근긴장성 발성장애\",\"라인케부종\",\"편측 성대마비\",\"내전형 연축성발성장애\",\"변성발성장애\"],\"answer\":3,\"explain\":\"짧은 MPT와 증가된 평균호기류율은 성문폐쇄부전으로 공기가 새고 있음을 의미하며, 기식적이고 약한 음성과 함께 편측 성대마비를 시사한다. 근긴장성 발성장애나 내전형 연축성발성장애는 과내전 양상으로 호기류율이 감소하는 경향을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"공기역학 검사 결과 해석\",\"p\":\"짧은 MPT와 평균호기류율 증가 조합으로 음성장애 판단\",\"n\":\"성문폐쇄부전: MPT 단축·호기류율 증가·기식 음성, 편측 성대마비 시사\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"환자가 지각하는 음성 문제가 일상생활에 미치는 신체적·기능적·정서적 영향을 평가하는 자기보고식 도구는?\",\"choices\":[\"CAPE-V\",\"최대연장발성시간(MPT)\",\"GRBAS 척도\",\"음성장애지수(VHI)\",\"음성범위프로파일(VRP)\"],\"answer\":4,\"explain\":\"음성장애지수(VHI)는 환자 스스로 음성 문제로 인한 신체·기능·정서 영역의 불편감을 평정하는 자기보고식 설문이다. GRBAS와 CAPE-V는 평가자의 청지각적 평가 도구이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"자기보고식 음성 평가도구\",\"p\":\"환자 자기평정 여부로 음성 평가도구 식별\",\"n\":\"VHI: 신체·기능·정서 영역 자기보고식 설문, GRBAS·CAPE-V는 청지각 평가\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음향학적 검사(MDVP) 결과\\n• 기본주파수(F0): 성별·연령 규준 범위\\n• 주파수변동률(jitter): 3.85 % (증가)\\n• 진폭변동률(shimmer): 7.9 % (증가)\\n• 소음대배음비(NHR): 0.28 (증가)\",\"q\":\"위 결과에 대한 설명으로 옳은 것은?\",\"choices\":[\"음성 강도가 과도하게 크다\",\"음성 신호의 주기성이 낮다\",\"습관적 음도가 비정상적으로 높다\",\"공명 문제가 확인된다\",\"정상 음질에 해당한다\"],\"answer\":2,\"explain\":\"jitter(주파수 변동률), shimmer(진폭 변동률), NHR(소음대배음비)의 증가는 성대 진동의 규칙성이 떨어지고 신호 내 소음 성분이 많다는 것, 즉 음성 신호의 주기성이 낮음을 의미한다. F0 자체는 정상 범위이므로 음도 문제로 볼 수 없다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"MDVP 음향 지표 해석\",\"p\":\"jitter·shimmer·NHR 증가로 음성 신호 특성 판단\",\"n\":\"jitter·shimmer·NHR 증가: 성대 진동 불규칙·소음 증가로 주기성 저하\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 32세 초등교사\\n• 후두내시경: 양측 성대 막성부 중간 지점의 대칭적인 양성 병변, 모래시계 모양의 성문폐쇄\\n• 음성 남용력: 하루 6교시 수업, 큰 소리 사용 빈번\",\"q\":\"위 환자에게 우선적으로 적용할 치료는?\",\"choices\":[\"음성치료와 음성위생 교육\",\"보툴리눔 독소 주입\",\"성대 내 주입술\",\"제I형 갑상성형술\",\"후두미세수술\"],\"answer\":1,\"explain\":\"양측성·대칭성 병변과 모래시계형 성문폐쇄는 성대결절의 전형적 소견이며, 음성 남용이 원인이므로 일차적 치료는 음성치료(반폐쇄성도훈련 등)와 음성위생 교육이다. 수술은 충분한 음성치료 후에도 호전이 없을 때 고려한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성대결절 일차 치료 선택\",\"p\":\"양측 대칭 병변과 음성 남용력으로 우선 치료 선택\",\"n\":\"성대결절: 양측 대칭·모래시계형 폐쇄, 일차 치료는 음성치료·음성위생\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"20대 여성이 특별한 신체 질환 없이 갑자기 목소리가 나오지 않아 속삭이는 소리로만 말한다. 그러나 기침과 웃음에서는 정상적인 유성음이 산출되고, 후두내시경에서 구조적 이상이 없다.\",\"q\":\"위 사례에 대한 설명으로 옳은 것은?\",\"choices\":[\"성대의 구조적 병변에 의한 기질적 실성증이다\",\"반드시 수술적 치료가 필요하다\",\"기침·웃음에서도 발성이 전혀 불가능하다\",\"기능적(심인성) 실성증에 해당한다\",\"신경 손상에 의한 성대마비가 원인이다\"],\"answer\":4,\"explain\":\"구조적 이상 없이 기침·웃음 등 반사적(생리적) 발성에서 정상 유성음이 가능한 것은 기능적(심인성) 실성증의 특징이다. 보존된 생리적 발성(기침·헛기침·허밍)에서 모음·낱말로 확장하며 발성을 재확립한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"기능적 실성증 식별\",\"p\":\"구조 정상과 반사적 발성 보존으로 실성증 유형 판단\",\"n\":\"기능적(심인성) 실성증: 구조 이상 없음, 기침·웃음 시 정상 유성음\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 17세 남학생, 변성기가 지났으나 지속적으로 높은 음도로 말함\\n• 후두 구조와 호르몬 검사: 정상\",\"q\":\"위 대상자에게 적용할 수 있는 음성치료 기법은?\",\"choices\":[\"음도를 더 높여 가성구 발성을 훈련한다\",\"큰 소리로 고음 발성을 반복시킨다\",\"속삭이는 소리로 말하게 한다\",\"성대 과내전을 유도한다\",\"갑상연골을 눌러 낮은 음도를 유도한다\"],\"answer\":5,\"explain\":\"변성발성장애는 변성기 이후에도 높은 음도가 유지되는 기능적 장애로, 손가락 조작법(갑상연골을 후하방으로 눌러 성대를 이완)으로 낮은 진성 발성을 유도한 뒤 이를 안정화하는 치료가 효과적이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"변성발성장애 치료 기법\",\"p\":\"변성기 후 고음도 지속 사례에 맞는 치료 기법 선택\",\"n\":\"변성발성장애: 갑상연골 후하방 압박 손가락 조작법으로 낮은 진성 유도\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 68세 남성, 파킨슨병 진단\\n• 약한 음성 강도, 단조로운 음도\\n• 말끝이 흐려지며 가족들이 잘 알아듣지 못함\\n• 스스로는 목소리가 작다고 느끼지 않음\",\"q\":\"위 환자에게 가장 적절한 음성치료는?\",\"choices\":[\"차폐를 이용한 강도 증가\",\"속삭임 발성 중심 훈련\",\"가성대 발성 유도 훈련\",\"리실버만음성치료(LSVT)\",\"저작하기 기법으로 이완 유도\"],\"answer\":4,\"explain\":\"리실버만음성치료(LSVT LOUD)는 파킨슨병 환자를 대상으로 '크게 말하기'에 집중하여 고강도로 반복 훈련하는 근거 기반 치료로, 강도 증가와 함께 명료도 개선 효과가 보고된다. 감각 인식 저하(스스로 작다고 느끼지 않음)에 대한 보정 훈련도 포함한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"파킨슨병 음성치료 선택\",\"p\":\"약한 강도·단조 음도·자기인식 저하로 음성치료 선택\",\"n\":\"LSVT LOUD: 파킨슨병 대상 크게 말하기 중심 고강도 반복 훈련\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"내전형 연축성발성장애에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"모음으로 시작하는 낱말에서 쥐어짜는 듯한 음성 끊김이 나타난다\",\"성대의 구조적 병변이 주된 원인이다\",\"속삭임·노래·웃음에서는 증상이 감소한다\",\"보툴리눔 독소 주입이 대표적 치료이다\",\"성대 내전근의 불수의적 연축에 의한 신경학적 장애이다\"],\"answer\":2,\"explain\":\"내전형 연축성발성장애는 구조적 병변 없이 성대 내전근의 불수의적 연축으로 발생하는 신경학적 장애이다. 모음 시작 낱말에서 음성 끊김이 두드러지고 속삭임·노래에서 감소하며 보툴리눔 독소로 치료하므로 '구조적 성대 병변이 원인'은 옳지 않다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"연축성발성장애 특성\",\"p\":\"원인·증상·치료 특성으로 내전형 연축성발성장애 오류 진술 식별\",\"n\":\"내전형 연축성발성장애: 내전근 불수의 연축의 신경학적 장애, 보툴리눔 치료\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"후두전적출 환자의 식도발성(esophageal speech)에 대한 설명으로 옳은 것은?\",\"choices\":[\"폐의 공기를 성대로 보내어 소리를 낸다\",\"삼킨 공기를 역류시켜 인두식도분절을 진동시킨다\",\"반드시 보철(프로테제) 삽입이 있어야 발성할 수 있다\",\"전기 진동자를 목에 대어 소리를 낸다\",\"성대가 재생되어 발성이 가능해진다\"],\"answer\":2,\"explain\":\"식도발성은 공기를 삼켜 식도에 넣었다가 역류시키면서 인두식도분절(PE segment)을 진동시켜 소리를 내는 무후두 음성 방법으로, 별도의 보철 없이도 훈련할 수 있다. 성대는 재생되지 않는다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"특수 대상\",\"k\":\"식도발성 원리\",\"p\":\"공기 공급원과 진동체 근거로 식도발성 원리 식별\",\"n\":\"식도발성: 삼킨 공기 역류로 인두식도분절 진동, 보철 없이 훈련 가능\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 74세 남성, 목소리가 약하고 쉽게 피로하다고 호소\\n• 후두내시경: 성대 위축과 활모양의 성문틈, 병변 없음\\n• 신경학적 이상 없음\",\"q\":\"위 환자에게 적절한 음성치료 접근은?\",\"choices\":[\"음성 사용을 최대한 제한한다\",\"속삭임으로 말하도록 한다\",\"보툴리눔 독소 주입을 의뢰한다\",\"성대내전을 강화하는 훈련을 실시한다\",\"음도를 낮추는 훈련을 실시한다\"],\"answer\":4,\"explain\":\"노인성 음성(성대 위축, 활모양 성문틈)은 성문폐쇄부전이 핵심이므로 밀기 접근법, 강한 성대접촉 유도, 반폐쇄성도훈련 등 성대내전과 발성 효율을 강화하는 음성치료가 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"노인성 음성 치료 접근\",\"p\":\"성대 위축과 활모양 성문틈 소견으로 치료 방향 선택\",\"n\":\"노인성 음성: 성문폐쇄부전 핵심, 밀기 접근 등 성대내전 강화 훈련\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"GRBAS 척도에서 'R'이 의미하는 음성 특성은?\",\"choices\":[\"전반적 중증도\",\"조조성\",\"기식성\",\"무력성\",\"긴장성\"],\"answer\":2,\"explain\":\"GRBAS에서 G는 전반적 중증도, R은 조조성(거친 소리), B는 기식성, A는 무력성, S는 긴장성을 의미한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"GRBAS 척도 항목\",\"p\":\"GRBAS 약자별 의미로 R 항목 식별\",\"n\":\"GRBAS: 전반적 중증도·조조성·기식성·무력성·긴장성\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 후두내시경: 편측 성대의 유경성(줄기 달린) 병변\\n• 갑작스러운 고함·큰 소리 이후 발생\\n• 거칠고 낮은 음성\",\"q\":\"위 소견에서 의심되는 질환은?\",\"choices\":[\"성대결절\",\"성대구증\",\"라인케부종\",\"후두유두종\",\"성대폴립\"],\"answer\":5,\"explain\":\"성대폴립은 흔히 편측성이며 유경성 또는 무경성으로 나타나고, 갑작스러운 음성 남용(고함) 후 발생하는 경우가 많다. 성대결절은 대개 양측성·대칭성이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"성대 병변 감별\",\"p\":\"편측 유경성 병변과 고함 후 발병으로 질환 판단\",\"n\":\"성대폴립: 편측·유경성 또는 무경성, 급성 음성 남용 후 발생, 결절은 양측성\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"후두에 기질적 병변이 없으나 후두 주변 근육의 과도한 긴장으로 쥐어짜는 음성을 보이는 장애는?\",\"choices\":[\"편측 성대마비\",\"사춘기 변성발성장애\",\"연축성 발성장애\",\"근긴장성 발성장애\",\"양측 성대구증\"],\"answer\":4,\"explain\":\"근긴장성 발성장애(MTD)는 구조적 병변 없이 후두 내·외근의 과도한 긴장으로 발생하는 기능적 음성장애이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"근긴장성 발성장애 정의\",\"p\":\"구조 병변 부재와 후두근 과긴장 특성으로 장애 식별\",\"n\":\"근긴장성 발성장애: 병변 없이 후두 내·외근 과긴장에 의한 기능적 장애\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"음향학적 분석에서 진폭(강도)의 주기 간 변동률을 나타내는 측정치는?\",\"choices\":[\"shimmer\",\"F0 표준편차\",\"NHR\",\"CPP\",\"jitter\"],\"answer\":1,\"explain\":\"shimmer는 주기 간 진폭(강도)의 변동률, jitter는 주기 간 기본주파수의 변동률, NHR은 소음 대 배음 비율이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"음향 측정치 정의\",\"p\":\"주기 간 진폭 변동 개념으로 음향 측정치 식별\",\"n\":\"shimmer: 주기 간 진폭 변동률, jitter: 주기 간 주파수 변동률\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"s/z 비율이 1.4 이상으로 증가했을 때 가장 우선적으로 의심할 수 있는 것은?\",\"choices\":[\"호흡 기능의 단독 저하\",\"조음기관의 구조적 이상\",\"경도의 청력 손실\",\"성대 병변과 성문폐쇄부전\",\"공명강의 구조적 협착\"],\"answer\":4,\"explain\":\"/s/는 호흡 기능, /z/는 호흡과 발성 기능을 함께 반영한다. s/z 비율이 1.4 이상이면 /z/ 연장이 상대적으로 짧다는 의미로, 성대 병변에 의한 성문폐쇄부전을 시사한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"s/z 비율 해석\",\"p\":\"s/z 비율 1.4 이상 증가로 의심 소견 판단\",\"n\":\"s/z 비율 1.4 이상: /z/ 상대적 단축, 성대 병변·성문폐쇄부전 시사\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"음성위생 교육 내용으로 적절하지 않은 것은?\",\"choices\":[\"충분한 수분을 섭취한다\",\"소음 환경에서 큰 소리로 말하는 것을 줄인다\",\"음성 휴식이 필요하면 속삭여 말한다\",\"습관적인 헛기침을 줄인다\",\"과도한 카페인 섭취를 줄인다\"],\"answer\":3,\"explain\":\"속삭이기는 성대에 오히려 과도한 긴장을 주므로 음성위생법으로 권장되지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"음성위생 교육 내용\",\"p\":\"성대 부담 여부로 부적절한 음성위생 지침 식별\",\"n\":\"음성위생: 속삭이기는 성대 긴장을 유발하므로 권장하지 않음\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"갑상샘 수술 후 편측 성대마비를 유발하기 쉬운 신경은?\",\"choices\":[\"되돌이후두신경\",\"미주신경 본간\",\"설하신경\",\"삼차신경\",\"상후두신경\"],\"answer\":1,\"explain\":\"미주신경의 분지인 되돌이후두신경(반회후두신경)은 갑상샘 수술 시 손상되기 쉬우며, 손상되면 편측 성대마비로 기식적이고 약한 음성이 나타난다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"성대마비 관련 신경\",\"p\":\"갑상샘 수술 시 손상 위험 근거로 원인 신경 식별\",\"n\":\"되돌이후두신경: 미주신경 분지, 갑상샘 수술 시 손상되어 편측 성대마비\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"최대연장발성시간(MPT)이 정상보다 현저히 짧게 나타날 때 가장 우선적으로 시사되는 것은?\",\"choices\":[\"경도의 청력 손실\",\"성문폐쇄부전과 호흡 부족\",\"성대의 과도한 내전\",\"조음기관의 구조적 이상\",\"공명강의 구조 이상\"],\"answer\":2,\"explain\":\"MPT는 한 번의 흡기 후 낼 수 있는 최대 발성 시간으로, 현저히 짧으면 성문폐쇄부전으로 공기가 새거나 호흡 지지가 부족함을 시사한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"MPT 단축 해석\",\"p\":\"MPT의 현저한 단축으로 시사되는 기능 문제 판단\",\"n\":\"MPT 단축: 성문폐쇄부전에 따른 공기 누출 또는 호흡 지지 부족\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"소아에게서 반복적으로 재발하며, 인유두종바이러스(HPV) 감염과 관련되어 성대에 사마귀 모양의 병변이 자라 애성과 기도 폐쇄를 유발하는 질환이 있다.\",\"q\":\"위 설명에 해당하는 질환으로 가장 적절한 것은?\",\"choices\":[\"성대결절\",\"라인케부종\",\"재발성 후두유두종\",\"성대구증\",\"근긴장성 발성장애\"],\"answer\":3,\"explain\":\"재발성 후두유두종(재발성 호흡기 유두종증)은 인유두종바이러스(HPV) 감염과 관련되어 성대에 사마귀 모양 병변이 자라 애성·기도폐쇄를 유발하며, 소아에서 반복 재발하는 경향이 있다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"재발성 후두유두종 특성\",\"p\":\"HPV 관련성과 소아 재발 특성으로 질환 식별\",\"n\":\"재발성 후두유두종: HPV 관련 사마귀 모양 병변, 애성·기도폐쇄, 소아 재발\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"성대의 접촉 양상(개방·폐쇄 주기)을 비침습적으로 간접 측정하는 데 가장 적절한 도구는?\",\"choices\":[\"전기성문파형검사(EGG)\",\"나조미터(비음도)\",\"음향 스펙트로그램\",\"순음청력검사(PTA)\",\"음성범위프로파일\"],\"answer\":1,\"explain\":\"전기성문파형검사(EGG)는 성대 접촉 면적의 변화를 통해 성대의 개방·폐쇄 주기(접촉 양상)를 비침습적으로 간접 측정하는 도구이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"EGG 측정 목적\",\"p\":\"성대 접촉 양상 측정 목적으로 검사도구 선택\",\"n\":\"EGG: 성대 접촉 면적 변화로 개방·폐쇄 주기를 비침습 간접 측정\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음성치료에서 대상자에게 빨대를 물컵에 담그고 그 안으로 소리를 내게 하거나, 입술 트릴·허밍을 하며 발성하도록 하였다.\",\"q\":\"위 기법들의 공통된 원리로 옳은 것은?\",\"choices\":[\"성대를 강하게 접촉시켜 강도를 높인다\",\"성문을 완전히 개방하여 기식성을 늘린다\",\"음도를 최대한 높여 가성구로만 발성한다\",\"호흡을 멈추고 발성한다\",\"성도를 좁혀 성대 접촉 부담을 줄인다\"],\"answer\":5,\"explain\":\"빨대 발성, 입술 트릴, 허밍 등은 반폐쇄성도훈련(SOVT)으로, 성도를 부분적으로 좁혀 성문 상부 압력을 높임으로써 성대 접촉 부담을 줄이고 효율적인 발성을 유도한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"반폐쇄성도훈련 원리\",\"p\":\"빨대·입술 트릴·허밍의 공통점으로 치료 원리 식별\",\"n\":\"SOVT: 성도 부분 폐쇄로 성문상압 상승, 성대 접촉 부담 감소\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"성대의 유리연을 따라 고랑(구)이 패여 성문폐쇄부전과 기식 음성을 보이는 질환은?\",\"choices\":[\"후두유두종\",\"성대결절\",\"라인케부종\",\"성대폴립\",\"성대구증\"],\"answer\":5,\"explain\":\"성대구증은 성대 유리연을 따라 고랑이 패이는 질환으로, 성문폐쇄부전으로 인한 기식 음성과 음성 피로가 나타난다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"성대구증 특성\",\"p\":\"유리연 고랑과 성문폐쇄부전 특성으로 질환 식별\",\"n\":\"성대구증: 성대 유리연 고랑, 성문폐쇄부전·기식 음성·음성 피로\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"아동1: 4세, 어리고 정상적인 아동에게 나타나는 음운변동(종성생략, 연구개음 전방화)이 지속됨\\n아동2: 혀 내밀기로 인한 /ㅅ/ 왜곡이 모든 문맥에서 일관됨\\n아동3: 어중초성 생략과 어두 자음 첨가 등 발달과정에서 드문 오류패턴이 일관되게 나타남\\n아동4: 같은 낱말을 말할 때마다 40% 이상 서로 다른 형태로 산출함\",\"q\":\"Dodd의 분류에 따라 '음운지연'에 해당하는 아동은?\",\"choices\":[\"아동1\",\"아동2\",\"아동3\",\"아동4\",\"해당 아동 없음\"],\"answer\":1,\"explain\":\"음운지연은 정상 발달과정에서 나타나는 음운변동이 해당 연령이 지나서도 지속되는 경우이다. 아동2는 조음장애(일관된 왜곡), 아동3은 비전형적 패턴이 일관된 일관적 음운장애, 아동4는 비일관적 음운장애에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"Dodd 말소리장애 분류\",\"p\":\"오류 양상의 발달성·일관성으로 음운지연 아동 식별\",\"n\":\"음운지연: 정상 발달 음운변동이 해당 연령 이후에도 지속되는 유형\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n사자 → [타다]\\n수박 → [투박]\\n코끼리 → [토끼리]\\n그네 → [드네]\\n호랑이 → [호앙이]\",\"q\":\"다음 조음음운장애 아동의 발화에서 나타난 음운오류패턴에 대한 설명으로 적절한 것은?\",\"choices\":[\"종성 생략이 2회 나타났다\",\"유음의 활음화가 모두 2회 나타났다\",\"마찰음·파찰음의 파열음화가 3회 나타났다\",\"연구개음의 전방화가 모두 3회 나타났다\",\"유음의 비음화가 1회 나타났다\"],\"answer\":3,\"explain\":\"파열음화는 사자→[타다]에서 /ㅅ/→[ㅌ], /ㅈ/→[ㄷ] 2회, 수박→[투박]에서 /ㅅ/→[ㅌ] 1회로 총 3회이다. 연구개음 전방화는 코끼리→[토끼리], 그네→[드네]의 2회, 호랑이→[호앙이]는 유음 탈락이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"음운오류패턴 빈도 분석\",\"p\":\"발화 전사의 대치 양상 집계로 음운변동 출현 횟수 판단\",\"n\":\"파열음화: 마찰음·파찰음의 파열음 대치, 사자·수박에서 총 3회\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어(자음) → 아동 발화\\n가방 (ㄱ,ㅂ,ㅇ) → [가바]\\n모자 (ㅁ,ㅈ) → [모다]\\n나무 (ㄴ,ㅁ) → [나무]\\n딸기 (ㄸ,ㄹ,ㄱ) → [딸기]\",\"q\":\"위 낱말 검사에서 아동의 자음정확도(PCC)는?\",\"choices\":[\"6/10 × 100\",\"7/10 × 100\",\"8/10 × 100\",\"9/10 × 100\",\"10/10 × 100\"],\"answer\":3,\"explain\":\"조음해야 할 자음은 총 10개이며, 오류는 '가방'의 종성 /ㅇ/ 생략과 '모자'의 /ㅈ/→[ㄷ] 대치 2개이다. 따라서 자음정확도 = 8/10 × 100 = 80%.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PCC 산출\",\"p\":\"목표 자음 수와 오류 자음 수로 자음정확도 산출\",\"n\":\"PCC: 바르게 조음한 자음 수 ÷ 조음해야 할 자음 수 × 100\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 아동이 어두 /ㅅ/를 [ㄷ]로 대치하는 오류를 보인다. 무의미음절 /사/, /수/에서는 청각·시각 단서를 주면 정조음이 가능하여, 낱말 수준으로 확장하려 한다.\",\"q\":\"어두 /ㅅ/ 확립을 위한 낱말 수준 훈련 목록으로 가장 적절한 것은?\",\"choices\":[\"단추, 다리, 도장\",\"거울, 가위, 구두\",\"사탕, 손, 시소\",\"라면, 리본, 로봇\",\"모자, 무지개, 미소\"],\"answer\":3,\"explain\":\"확립 단계에서는 목표음이 포함된 낱말로 연습해야 하므로 어두에 /ㅅ/가 오는 '사탕, 손, 시소'가 적절하다. 목표음이 안정되면 어중·어말, 문장 수준으로 점차 일반화한다. 나머지는 목표음 /ㅅ/가 포함되지 않은 낱말들이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"훈련 낱말 목록 선정\",\"p\":\"목표음 위치 조건 충족 여부로 확립 단계 낱말 선택\",\"n\":\"확립 단계: 목표음이 어두에 포함된 낱말로 연습 후 위치·문장으로 확장\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"순음청력검사 결과\\n• 양측 기도 청력역치: 45 dB HL\\n• 양측 골도 청력역치: 10 dB HL\\n• 기도-골도 차(air-bone gap): 35 dB\",\"q\":\"위 결과에 대한 해석으로 적절한 것은?\",\"choices\":[\"감각신경성 난청이 의심된다\",\"전음성 난청이 의심된다\",\"정상 청력 범위이다\",\"혼합성 난청이며 내이 손상이 확실하다\",\"청신경 종양이 의심된다\"],\"answer\":2,\"explain\":\"골도 역치는 정상이나 기도 역치가 상승하여 기도-골도 차가 존재하는 것은 전음성 난청의 소견으로, 중이염 등 외이·중이의 병변을 확인해야 한다. 감각신경성 난청은 기도·골도가 함께 상승하고 기도-골도 차가 없다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"청각·청각장애\",\"k\":\"순음청력검사 해석\",\"p\":\"기도·골도 역치와 기도-골도 차로 난청 유형 판단\",\"n\":\"전음성 난청: 골도 정상·기도 상승으로 기도-골도 차 존재\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n바지 → [빠지]\\n도로 → [또로]\\n가방 → [까방]\",\"q\":\"위 오류에서 아동이 아직 확립하지 못한 변별자질의 대립은?\",\"choices\":[\"지속성\",\"긴장성\",\"비음성\",\"설측성\",\"공명성\"],\"answer\":2,\"explain\":\"평음 /ㅂ, ㄷ, ㄱ/이 경음 /ㅃ, ㄸ, ㄲ/으로 대치되는 경음화로, [−긴장성]과 [+긴장성]의 대립을 아직 확립하지 못한 것이다. 따라서 긴장성 자질의 대조를 목표로 중재한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성학·음운론 기초\",\"k\":\"오류의 변별자질 분석\",\"p\":\"평음의 경음 대치 양상으로 미확립 변별자질 판단\",\"n\":\"긴장성 자질: 평음 [-긴장성]과 경음 [+긴장성]의 대립\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말소리 목록이 매우 제한된 어린 아동에게 실시하는 독립분석(independent analysis)에 대한 설명으로 옳은 것은?\",\"choices\":[\"음운변동의 출현 빈도와 유형을 분석한다\",\"자음정확도(PCC)를 백분율로 산출한다\",\"목표 음소 대비 정확도를 산출한다\",\"산출한 말소리 목록과 음절 구조를 분석한다\",\"오류음의 자극반응도를 함께 측정한다\"],\"answer\":4,\"explain\":\"독립분석은 성인(목표) 형태와 대조하지 않고 아동이 실제로 산출한 말소리 목록·음절 구조 등을 그 자체로 기술하는 방법으로, 말소리 목록이 제한적인 어린 아동에게 유용하다. 목표와 비교하여 정확도·음운변동을 분석하는 것은 관계분석에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"독립분석과 관계분석\",\"p\":\"목표 형태 대조 여부로 독립분석 특성 식별\",\"n\":\"독립분석: 목표와 비교 없이 산출 말소리 목록·음절구조 기술\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"문맥검사 결과: 아동은 /ㅅ/를 /ㅣ/ 모음 앞에서만 정조음하고('시소'의 '시'), 다른 모음 문맥에서는 [ㄷ]로 대치한다.\",\"q\":\"위 결과를 활용한 중재 방법으로 적절한 것은?\",\"choices\":[\"비언어적 구강운동 훈련만 실시한다\",\"/시/ 문맥에서 시작해 다른 문맥으로 확대한다\",\"오류가 가장 심한 문맥부터 훈련한다\",\"/ㅅ/ 훈련을 중단하고 다른 음소를 목표로 한다\",\"모든 모음 문맥을 무작위로 섞어 훈련한다\"],\"answer\":2,\"explain\":\"문맥검사에서 발견된 촉진 문맥(정조음 가능한 문맥)은 치료의 출발점이 된다. /시/에서 안정적으로 산출한 뒤 다른 모음 문맥, 음절·낱말 수준으로 점진적으로 일반화시키는 것이 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"촉진 문맥 활용 중재\",\"p\":\"문맥검사의 정조음 문맥 근거로 중재 출발점 선택\",\"n\":\"촉진 문맥: 정조음 가능한 문맥에서 시작해 다른 문맥으로 일반화\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"음운인식 능력의 발달에 대한 설명으로 옳은 것은?\",\"choices\":[\"음소 분절 능력이 음절 수 세기보다 먼저 발달한다\",\"음소 조작이 각운(rhyme) 인식보다 먼저 발달한다\",\"음운인식은 읽기(해독) 능력과 전혀 관련이 없다\",\"음소 탈락이 음절 탈락보다 이른 시기에 발달한다\",\"음절 수준 인식이 음소 수준 인식보다 먼저 발달한다\"],\"answer\":5,\"explain\":\"음운인식은 대체로 음절 → 초성-각운(음절체-종성) → 음소 순으로, 큰 단위에서 작은 단위로 발달한다. 따라서 음절 수준 인식이 음소 수준 인식보다 먼저 발달하며, 음운인식은 낱말 해독의 중요한 기초가 된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음운인식\",\"k\":\"음운인식 발달 순서\",\"p\":\"음운 단위 크기에 따른 발달 순서로 옳은 진술 식별\",\"n\":\"음운인식 발달: 음절 → 초성-각운 → 음소, 큰 단위에서 작은 단위로\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"• 3세 남아, 기질적 결함 없음\\n• 산출 가능한 자음이 /ㅁ, ㅂ, ㅃ/로 제한됨\\n• 모음은 대부분 정확하게 산출함\",\"q\":\"위 아동의 초기 목표 낱말 선정 원칙으로 가장 적절한 것은?\",\"choices\":[\"아동의 목록에 없는 음소들로만 구성된 낱말을 선정한다\",\"이미 산출 가능한 음소로 된 기능적 낱말을 선정한다\",\"음절 수가 많고 구조가 복잡한 낱말부터 선정한다\",\"의미보다 발음 난이도가 높은 낱말을 우선 선정한다\",\"사용 빈도가 낮은 낱말을 선정한다\"],\"answer\":2,\"explain\":\"초기 목표 낱말은 아동이 이미 산출 가능한 음소(여기서는 양순음)와 단순한 음절 구조로 이루어지고, 일상에서 의사소통 기능이 높은 낱말이 적절하다. 성공 경험을 통해 의사소통 동기를 높이는 것이 목적이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"초기 목표 낱말 선정\",\"p\":\"제한된 자음 목록 아동에 맞는 초기 목표 낱말 원칙 선택\",\"n\":\"초기 목표 낱말: 산출 가능 음소·단순 음절구조·높은 의사소통 기능\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"구개열 수술을 받은 5세 아동이 파열음·마찰음을 산출할 때 코로 공기가 새고 과다비성이 동반되어 말명료도가 낮다.\",\"q\":\"위 아동의 비강누출·과다비성을 간편하게 선별하는 방법으로 적절한 것은?\",\"choices\":[\"교호운동속도(DDK)를 반복해서 측정한다\",\"순음 청력역치를 측정한다\",\"콧구멍 아래 거울을 대고 김서림을 관찰한다\",\"최대연장발성시간(MPT)을 측정한다\",\"수용어휘력 검사를 함께 실시한다\"],\"answer\":3,\"explain\":\"구강 압력이 필요한 압력자음(파열음·마찰음)을 산출할 때 콧구멍 아래 댄 거울(비경)에 김이 서리는지 관찰하면 비강누출과 과다비성을 간편하게 선별할 수 있다. 나머지는 공명·비강누출을 직접 선별하는 방법이 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"비강누출 선별 방법\",\"p\":\"압력자음 산출 시 비강 기류 관찰 근거로 선별법 선택\",\"n\":\"거울 김서림 관찰: 압력자음 산출 시 비강누출·과다비성 간편 선별\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"청능훈련의 단계를 발달 순서대로 바르게 나열한 것은?\",\"choices\":[\"탐지 → 변별 → 확인 → 이해\",\"변별 → 탐지 → 확인 → 이해\",\"탐지 → 확인 → 변별 → 이해\",\"확인 → 변별 → 탐지 → 이해\",\"이해 → 확인 → 변별 → 탐지\"],\"answer\":1,\"explain\":\"청능훈련은 소리의 유무를 아는 탐지, 두 소리가 같은지 다른지 아는 변별, 무슨 소리인지 알아 반응하는 확인, 말의 의미를 이해하는 이해의 순서로 진행한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"청각·청각장애\",\"k\":\"청능훈련 단계 순서\",\"p\":\"청각 처리 수준의 위계로 청능훈련 순서 선택\",\"n\":\"청능훈련 순서: 탐지 → 변별 → 확인 → 이해\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"'불-풀'처럼 하나의 음소 차이로 의미가 달라지는 낱말 쌍을 이용하는 음운론적 치료 접근은?\",\"choices\":[\"짝자극 기법\",\"최소대립쌍 치료\",\"주기법\",\"전통적 조음지시법\",\"구강운동 훈련\"],\"answer\":2,\"explain\":\"최소대립쌍 치료는 한 음소의 차이로 의미가 구별되는 낱말 쌍을 이용하여 음운 대조를 인식시키고 목표음 산출을 유도하는 음운론적 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"최소대립쌍 치료\",\"p\":\"한 음소 차이 낱말쌍 활용 특징으로 치료 접근 식별\",\"n\":\"최소대립쌍 치료: 한 음소 차이 낱말쌍으로 음운 대조 인식·산출 유도\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"명료도가 매우 낮은 아동을 대상으로 여러 오류 음운패턴을 주기마다 순환하며 목표로 삼는 접근법은?\",\"choices\":[\"짝자극 기법\",\"감각운동 기법\",\"조음점 지시법\",\"주기적 접근법\",\"변별자질 접근법\"],\"answer\":4,\"explain\":\"주기법은 명료도가 매우 낮은 아동을 대상으로 오류 음운 패턴들을 주기(cycle)마다 순환하며 목표로 하는 음운적 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"주기적 접근법\",\"p\":\"낮은 명료도 대상과 패턴 순환 특징으로 접근법 식별\",\"n\":\"주기법: 여러 오류 음운패턴을 주기마다 순환하며 목표화\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"오류음을 청각·시각적 단서나 모방 조건에서 정확히 산출할 수 있는 정도로, 목표음 선정과 예후 판단에 활용되는 것은?\",\"choices\":[\"자극반응도\",\"말명료도\",\"말소리목록\",\"일관성\",\"음운인식\"],\"answer\":1,\"explain\":\"자극반응도(stimulability)는 단서나 모방 조건에서 오류음을 바르게 산출할 수 있는 정도로, 치료 목표음 선정과 예후 판단에 활용된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"자극반응도 개념\",\"p\":\"단서·모방 조건의 정조음 정도 개념으로 용어 식별\",\"n\":\"자극반응도: 단서·모방 시 오류음 정조음 정도, 목표음 선정·예후 판단 활용\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말명료도(speech intelligibility)에 대한 설명으로 가장 적절한 것은?\",\"choices\":[\"화자가 산출한 자음의 정확도만을 의미한다\",\"음도와 강도의 적절성을 의미한다\",\"발화의 문법적 정확성을 의미한다\",\"말속도의 적절성을 의미한다\",\"청자가 알아듣는 정도를 의미한다\"],\"answer\":5,\"explain\":\"말명료도는 화자가 전달한 말을 청자가 얼마나 알아듣는가의 정도로, 오류 말소리의 수·유형·일관성, 운율 등 여러 요인의 영향을 받는다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"말명료도 정의\",\"p\":\"청자 이해 기준 여부로 말명료도 정의 식별\",\"n\":\"말명료도: 청자가 화자의 말을 알아듣는 정도, 오류 수·유형·운율 영향\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"/ㅂ/와 /ㅁ/를 구별하는 변별자질은?\",\"choices\":[\"비음성\",\"지속성\",\"설정성\",\"긴장성\",\"고설성\"],\"answer\":1,\"explain\":\"/ㅂ/와 /ㅁ/는 모두 양순음이지만 /ㅁ/는 [+비음성], /ㅂ/는 [-비음성]으로 비음성 자질에서 대립한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"변별자질 대립\",\"p\":\"같은 조음 위치 자음쌍의 차이로 변별자질 식별\",\"n\":\"/ㅂ/와 /ㅁ/: 양순음 공통, 비음성 자질에서 대립\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 자음 중 일반적으로 가장 늦게 습득되는 말소리는?\",\"choices\":[\"/ㄷ/\",\"/ㅂ/\",\"/ㅁ/\",\"/ㅅ/\",\"/ㅇ/\"],\"answer\":4,\"explain\":\"비음·파열음은 조기에 습득되는 반면, 치경마찰음 /ㅅ, ㅆ/은 가장 늦게 완전 습득되는 말소리에 속한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"자음 습득 순서\",\"p\":\"조음방법별 습득 시기로 가장 늦은 자음 식별\",\"n\":\"치경마찰음 /ㅅ, ㅆ/: 가장 늦게 완전 습득, 비음·파열음은 조기 습득\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n라면 → [야면]\\n리본 → [이본]\\n나라 → [나야]\",\"q\":\"위 발화에서 공통적으로 나타난 음운변동은?\",\"choices\":[\"유음의 비음화\",\"파열음화\",\"종성 생략\",\"전방화\",\"유음의 단순화\"],\"answer\":5,\"explain\":\"유음 /ㄹ/이 활음 /j/ 또는 생략으로 나타나는 유음의 단순화(활음화)이다. 유음의 비음화라면 /ㄹ/이 /ㄴ/으로 대치된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"유음 단순화 식별\",\"p\":\"/ㄹ/의 활음 대치·생략 양상으로 음운변동 판단\",\"n\":\"유음의 단순화: /ㄹ/이 활음 /j/로 대치되거나 생략, 비음화와 구별\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n코 → [고]\\n토끼 → [도끼]\\n파 → [바]\",\"q\":\"위 발화에서 공통적으로 나타난 음운변동은?\",\"choices\":[\"탈기식음화\",\"전방화\",\"경음화\",\"연구개음화\",\"기식음화\"],\"answer\":1,\"explain\":\"격음(기식음) /ㅋ, ㅌ, ㅍ/이 평음 /ㄱ, ㄷ, ㅂ/으로 대치되는 탈기식음화(이완음화)이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"탈기식음화 식별\",\"p\":\"격음의 평음 대치 양상으로 음운변동 판단\",\"n\":\"탈기식음화: 격음 /ㅋ, ㅌ, ㅍ/이 평음 /ㄱ, ㄷ, ㅂ/으로 대치\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"아동이 산출한 5개의 낱말 중 3개를 목표 형태와 완전히 동일하게 산출하였다.\",\"q\":\"이 아동의 단어단위정확률(PWC)은?\",\"choices\":[\"0.4\",\"0.5\",\"0.6\",\"0.7\",\"0.8\"],\"answer\":3,\"explain\":\"단어단위정확률(PWC) = 완전히 정확하게 산출한 낱말 수 ÷ 전체 낱말 수 = 3 ÷ 5 = 0.6이다. 낱말 전체를 단위로 조음 능력을 평가하는 지표이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PWC 산출\",\"p\":\"정확 산출 낱말 수와 전체 낱말 수로 단어단위정확률 산출\",\"n\":\"PWC: 완전히 정확하게 산출한 낱말 수 ÷ 전체 낱말 수\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"거울·설압자 등을 이용하여 조음 위치와 방법을 직접 지시하고 시범을 통해 목표음을 유도하는 접근법은?\",\"choices\":[\"주기적 접근법\",\"최소대립쌍 치료\",\"조음점 지시법\",\"음운변동 접근법\",\"상위음운 접근법\"],\"answer\":3,\"explain\":\"조음점 지시법(전통적 접근법)은 조음 위치와 방법을 직접 알려주고 청각·시각·촉각 단서와 시범으로 목표음을 유도하는 운동 중심의 조음치료 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"조음점 지시법\",\"p\":\"조음 위치·방법 직접 지시 특징으로 치료 접근 식별\",\"n\":\"조음점 지시법: 위치·방법 지시와 다감각 단서·시범의 운동 중심 접근\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"(아동 발화를 전사한 자료)\\n목표 → 아동 발화\\n코끼리 → [토끼리]\\n가위 → [다위]\\n그네 → [드네]\\n나무 → [나무]\\n우산 → [우산]\",\"q\":\"위 발화에서 공통적으로 나타난 음운변동은?\",\"choices\":[\"연구개음의 전방화\",\"치경음의 후방화\",\"마찰음의 파열음화\",\"종성생략\",\"유음의 단순화\"],\"answer\":1,\"explain\":\"연구개음 /ㄱ, ㅋ, ㄲ/이 치경음 /ㄷ, ㅌ/으로 조음 위치가 앞으로 이동하여 대치되는 연구개음의 전방화이다(코끼리→[토끼리], 가위→[다위], 그네→[드네]).\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"연구개음 전방화 식별\",\"p\":\"연구개음의 치경음 대치 양상으로 음운변동 판단\",\"n\":\"연구개음 전방화: /ㄱ, ㅋ, ㄲ/이 /ㄷ, ㅌ/으로 앞쪽 위치 대치\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"(아동 발화를 전사한 자료)\\n목표: 할머니랑 시장 가서 사탕 샀어요\\n아동: [하머니랑 시장 가서 사탕 다떠요]\",\"q\":\"위 발화에 대한 분석으로 옳은 것은?\",\"choices\":[\"자음정확도는 100%이다\",\"종성생략이 나타났다\",\"유음의 비음화가 나타났다\",\"모든 마찰음을 정확하게 조음하였다\",\"연구개음 전방화가 나타났다\"],\"answer\":2,\"explain\":\"'할머니→[하머니]'에서 종성 /ㄹ/이 생략되었다. 또한 '샀어요→[다떠요]'에서 마찰음 /ㅅ/이 파열음으로 대치되어 마찰음을 정확히 조음하지 못했고, 자음정확도는 100%가 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"문장 발화 오류 분석\",\"p\":\"문장 전사의 생략·대치 양상으로 옳은 분석 판단\",\"n\":\"종성생략: 할머니→[하머니]의 종성 /ㄹ/ 생략, 마찰음 파열음화 동반\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사 B는 자신이 훈련받거나 슈퍼비전을 받은 적이 없는 삼킴장애 환자를, 관련 교육 없이 인터넷 정보에만 의존하여 단독으로 중재하였다.\",\"q\":\"위 사례에서 위반된 언어재활사 윤리강령의 내용으로 가장 적절한 것은?\",\"choices\":[\"비밀유지의 의무\",\"차별금지의 의무\",\"연구 윤리의 준수\",\"전문성 유지의 의무\",\"동료 간 협력의 의무\"],\"answer\":4,\"explain\":\"언어재활사는 자신이 훈련받고 역량을 갖춘 전문 영역 내에서 서비스를 제공해야 한다. 준비되지 않은 영역을 교육·슈퍼비전 없이 단독으로 수행하는 것은 전문성 유지 의무 위반이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"윤리강령 위반 판단\",\"p\":\"훈련받지 않은 영역 단독 중재 사례로 위반 조항 식별\",\"n\":\"전문성 유지 의무: 훈련·역량을 갖춘 영역 내에서만 서비스 제공\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"만 7세 등록 장애아동의 보호자가 발달재활서비스 이용을 문의하였다. 가구 소득은 기준 중위소득 이내이다.\",\"q\":\"위 사례에 대한 안내로 옳은 것은?\",\"choices\":[\"본인부담금을 내고 바우처로 이용할 수 있다\",\"등록 장애아동은 이 서비스를 이용할 수 없다\",\"만 18세 이상만 이용할 수 있다\",\"소득과 무관하게 전액 무료로 지원된다\",\"의료기관 입원 치료만 지원한다\"],\"answer\":1,\"explain\":\"발달재활서비스는 만 18세 미만 등록 장애아동에게 소득 수준별 본인부담금과 함께 언어·청능 등 재활 바우처를 지원한다. 따라서 이 아동은 대상에 해당하며 바우처로 서비스를 이용할 수 있다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"법·제도\",\"k\":\"발달재활서비스 이용 안내\",\"p\":\"연령·장애 등록·소득 조건으로 서비스 이용 가능 여부 판단\",\"n\":\"발달재활서비스: 만 18세 미만 등록 장애아동, 소득별 본인부담금 바우처\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"연구 주제: \\\"태블릿 기반 AAC 앱 훈련이 뇌성마비 아동의 자발적 의사소통 시도 횟수에 미치는 효과\\\"\",\"q\":\"위 연구에서 '태블릿 기반 AAC 앱 훈련'에 해당하는 변인은?\",\"choices\":[\"혼란변인\",\"매개변인\",\"통제변인\",\"종속변인\",\"독립변인\"],\"answer\":5,\"explain\":\"독립변인은 연구자가 조작하여 그 효과를 알아보려는 처치이다. 이 연구에서 처치인 'AAC 앱 훈련'이 독립변인이고, 그 결과로 측정되는 '자발적 의사소통 시도 횟수'가 종속변인이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"연구 변인 구분\",\"p\":\"연구자가 조작하는 처치 여부로 변인 유형 식별\",\"n\":\"독립변인: 연구자가 조작하는 처치, 종속변인: 결과로 측정되는 변인\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"언어치료 효과에 관한 여러 개별 연구의 결과를 통계적으로 통합하여 전체 효과크기를 분석하는 연구 방법은?\",\"choices\":[\"횡단적 기술연구\",\"단일대상연구\",\"질적 사례연구\",\"델파이 조사\",\"메타분석\"],\"answer\":5,\"explain\":\"메타분석은 동일 주제의 개별 연구 결과들을 수집하여 통계적으로 통합·분석함으로써 전체적인 효과크기를 산출하는 연구 방법이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"메타분석 개념\",\"p\":\"개별 연구 결과의 통계적 통합 특징으로 연구 방법 식별\",\"n\":\"메타분석: 동일 주제 개별 연구를 통계적으로 통합해 효과크기 산출\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 회기 목표를 \\\"그림자극 10개 중 8개에서 목표 낱말의 어두 /ㅅ/를 3회기 연속 정조음한다.\\\"로 진술하였다.\",\"q\":\"위 행동목표 진술에 포함된 요소로 볼 수 없는 것은?\",\"choices\":[\"수행 조건(그림자극)\",\"관찰 가능한 목표 행동\",\"사용할 치료 기법\",\"도달 준거(10개 중 8개)\",\"숙달 기준(3회기 연속)\"],\"answer\":3,\"explain\":\"잘 진술된 행동목표는 수행 조건, 관찰 가능한 행동, 도달 준거와 숙달 기준을 포함한다. 그러나 '어떤 기법으로 가르칠지'(치료 기법)는 목표 진술 자체에 포함되는 요소가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"통합 사례\",\"k\":\"행동목표 진술 요소\",\"p\":\"조건·행동·준거 요소 구분으로 목표 진술에 없는 요소 식별\",\"n\":\"행동목표: 수행 조건·관찰 가능 행동·도달 준거·숙달 기준 포함, 기법 제외\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"「장애인복지법」상 1급 언어재활사 국가시험 응시자격으로 옳지 않은 것은?\",\"choices\":[\"2급 자격 없이 언어재활 경력이 5년 이상이면 응시할 수 있다\",\"2급 취득 후 관련 대학원에서 석사·박사학위를 받고 언어재활 경력이 1년 이상이면 응시할 수 있다\",\"2급 취득 후 관련 학과 학사학위 취득자로서 언어재활 경력이 3년 이상이면 응시할 수 있다\",\"응시자격에서 요구하는 경력은 언어재활 분야의 경력을 의미한다\",\"2급 언어재활사 자격 취득이 전제되어야 한다\"],\"answer\":1,\"explain\":\"1급은 2급 자격 취득을 전제로, 관련 대학원 석·박사학위+경력 1년 또는 관련 학과 학사학위+경력 3년의 요건을 갖춰야 한다. 2급 자격 없이 경력만으로는 응시할 수 없다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"법·제도\",\"k\":\"1급 응시자격\",\"p\":\"2급 전제와 학위·경력 요건으로 1급 응시자격 오류 식별\",\"n\":\"1급 응시: 2급 취득 전제, 석·박사+경력 1년 또는 학사+경력 3년\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"개인 언어재활센터에 정규직으로 채용된 언어재활사가 4대 사회보험 가입에 대해 문의하였다.\",\"q\":\"다음 중 보험료를 전액 사업주(사용자)가 부담하는 것은?\",\"choices\":[\"국민연금\",\"산업재해보상보험\",\"국민건강보험\",\"고용보험(실업급여)\",\"노인장기요양보험\"],\"answer\":2,\"explain\":\"산업재해보상보험료는 사업주가 전액 부담한다. 국민연금·국민건강보험·고용보험(실업급여)은 근로자와 사업주가 분담한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"법·제도\",\"k\":\"사회보험 부담 주체\",\"p\":\"보험별 보험료 분담 구조로 사업주 전액 부담 보험 식별\",\"n\":\"산재보험: 사업주 전액 부담, 국민연금·건강보험·고용보험은 노사 분담\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어발달지연 아동의 어머니가 평소 아동에게 빠른 속도로 길고 복잡한 문장을 사용하고, 아동이 반응하기 전에 다음 말을 이어간다.\",\"q\":\"위 어머니에게 제공할 상호작용 지도 내용으로 가장 적절한 것은?\",\"choices\":[\"말속도를 늦추고 짧은 문장으로 말해 주세요\",\"더 빠른 속도로 많은 어휘를 들려주세요\",\"낮고 단조로운 억양으로 말해 주세요\",\"아동이 말할 내용을 대신 말해 주세요\",\"아동의 발화를 자주 교정해 주세요\"],\"answer\":1,\"explain\":\"언어발달을 촉진하려면 느린 말속도, 짧고 단순한 문장, 풍부한 억양과 함께 아동이 반응할 시간을 충분히 기다려 주는 것이 중요하다. 빠르고 복잡한 발화나 대신 말하기, 잦은 교정은 바람직하지 않다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"상담\",\"k\":\"부모 상호작용 지도\",\"p\":\"어머니의 빠르고 복잡한 발화 양상에 맞는 지도 내용 선택\",\"n\":\"언어 촉진 상호작용: 느린 말속도·짧은 문장·풍부한 억양·반응 기다리기\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"초등학교 3학년 아동이 지능은 정상 범위이나 낱말을 소리 내어 읽을 때 매우 느리고 자주 틀린다. 반면 들려주는 이야기의 이해력은 또래 수준이다.\",\"q\":\"위 아동에게 우선적으로 고려할 수 있는 진단은?\",\"choices\":[\"경계선 지적장애\",\"고도 감각신경성 난청\",\"단순언어장애\",\"난독증(읽기장애)\",\"말소리장애\"],\"answer\":4,\"explain\":\"지능과 듣기 이해는 정상이나 낱말 해독(정확성·유창성)에서 두드러진 어려움을 보이는 것은 신경생물학적 원인의 난독증(읽기 특정학습장애)의 핵심 양상이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"통합 사례\",\"k\":\"난독증 감별\",\"p\":\"정상 지능·듣기 이해와 해독 곤란 조합으로 진단 판단\",\"n\":\"난독증: 지능·듣기 이해 정상, 낱말 해독의 정확성·유창성 저하\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"표준화 검사 적용이 어려운 무발화 영유아의 의사소통 능력을 평가하는 방법으로 가장 적절한 것은?\",\"choices\":[\"표준화 언어검사의 원점수만으로 언어 연령을 산출한다\",\"놀이 상황에서 비구어 의사소통을 관찰한다\",\"아동이 말을 시작할 때까지 평가를 미룬다\",\"보호자 정보는 주관적이므로 배제한다\",\"단일 회기의 검사 점수만으로 장애를 확정한다\"],\"answer\":2,\"explain\":\"무발화 영유아는 표준화 검사 적용이 제한되므로, 자연스러운 놀이·일상 맥락에서 발성의 양과 질, 몸짓, 공동주의, 모방 등 비구어 의사소통을 반복 관찰하고 보호자 면담으로 정보를 보완한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"통합 사례\",\"k\":\"무발화 영유아 평가\",\"p\":\"표준화 검사 적용 제한 조건에 맞는 평가 방법 선택\",\"n\":\"무발화 영유아 평가: 놀이 맥락 비구어 의사소통 반복 관찰·보호자 면담\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 SNS에 내담자의 실명과 평가 결과를 본인·보호자의 동의 없이 게시하였다.\",\"q\":\"위 사례에서 위반된 언어재활사 윤리강령의 내용은?\",\"choices\":[\"연구 윤리\",\"비밀유지의 의무\",\"전문성 유지의 의무\",\"동료 간 협력\",\"차별금지\"],\"answer\":2,\"explain\":\"내담자의 개인정보·평가결과를 동의 없이 외부에 공개하는 것은 윤리강령의 비밀유지(비밀보장) 의무 위반이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"비밀유지 의무 위반\",\"p\":\"동의 없는 개인정보 공개 사례로 위반 조항 식별\",\"n\":\"비밀유지 의무: 내담자 개인정보·평가 결과의 동의 없는 공개 금지\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"언어재활사의 보수교육에 대한 설명으로 옳은 것은?\",\"choices\":[\"1급 언어재활사에게만 부과된다\",\"최초 자격 취득 시 한 번만 받으면 된다\",\"이수 여부는 자격 유지와 무관하다\",\"대학원 재학생만 이수 대상이다\",\"자격 유지를 위해 매년 이수해야 한다\"],\"answer\":5,\"explain\":\"언어재활사는 자격 유지를 위해 매년 정해진 시간의 보수교육을 이수해야 하며, 정당한 사유 없이 연속하여 이수하지 않으면 제재 대상이 될 수 있다. 급수와 무관하게 자격을 가진 언어재활사에게 적용된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"보수교육 의무\",\"p\":\"이수 주기와 대상 범위로 보수교육 옳은 진술 식별\",\"n\":\"보수교육: 급수 무관 자격 유지를 위해 매년 이수, 미이수 시 제재\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"중재 효과 연구에서 독립변인 외에 종속변인에 영향을 줄 수 있는 변인들을 일정하게 통제하는 주된 이유는?\",\"choices\":[\"연구 대상자 수를 줄이기 위해\",\"종속변인의 측정을 생략하기 위해\",\"내적 타당도를 높이기 위해\",\"연구 결과의 일반화를 제한하기 위해\",\"독립변인을 무작위로 바꾸기 위해\"],\"answer\":3,\"explain\":\"외생변인(혼란변인)을 통제하면 종속변인의 변화가 독립변인(중재) 때문임을 더 확신할 수 있어 연구의 내적 타당도가 높아진다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"외생변인 통제 목적\",\"p\":\"외생변인 통제의 효과로 관련 타당도 개념 식별\",\"n\":\"외생변인 통제: 종속변인 변화를 독립변인에 귀속, 내적 타당도 향상\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"한 명 또는 소수의 대상에게 기초선-중재 등의 설계를 적용하여 중재 효과를 검증하는 연구 방법은?\",\"choices\":[\"상관연구\",\"집단비교연구\",\"단일대상연구\",\"델파이 조사\",\"메타분석\"],\"answer\":3,\"explain\":\"단일대상연구는 개별 대상에게 기초선-중재-반전(또는 중다기초선) 등의 설계를 적용하여 중재의 효과를 실험적으로 검증하는 방법으로, 언어재활 임상연구에서 널리 사용된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"단일대상연구 설계\",\"p\":\"소수 대상과 기초선-중재 설계 특징으로 연구 방법 식별\",\"n\":\"단일대상연구: 개별 대상에 기초선-중재-반전 등 설계로 효과 검증\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"검사도구가 측정하고자 하는 바를 정확하게 측정하는 정도를 의미하는 것은?\",\"choices\":[\"타당도\",\"실용도\",\"신뢰도\",\"객관도\",\"난이도\"],\"answer\":1,\"explain\":\"타당도는 검사가 측정하려는 개념을 실제로 측정하고 있는가의 정도이고, 신뢰도는 측정의 일관성·안정성을 의미한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"타당도·신뢰도 구분\",\"p\":\"측정 목적 부합 여부로 검사도구 특성 개념 식별\",\"n\":\"타당도: 측정하려는 것을 측정하는 정도, 신뢰도: 측정의 일관성\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"언어재활사의 업무로 가장 적절한 것은?\",\"choices\":[\"청력역치 측정과 의학적 진단\",\"후두의 수술적 처치\",\"의약품의 처방\",\"난청의 외과적 치료\",\"의사소통장애의 평가와 중재\"],\"answer\":5,\"explain\":\"언어재활사는 의사소통장애(언어·조음·유창성·음성·삼킴 등)의 평가와 중재, 대상자·보호자 상담 및 교육을 수행한다. 의학적 진단·처방·수술은 의사의 업무이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"언어재활사 업무 범위\",\"p\":\"의료 행위와의 구분으로 언어재활사 업무 식별\",\"n\":\"언어재활사 업무: 의사소통장애 평가·중재·상담, 진단·처방·수술 제외\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"아버지는 한국어, 어머니는 몽골어를 사용하는 가정의 4세 아동이 두 언어에 모두 노출되어 있다. 평가 결과 한국어 어휘 수가 또래보다 적었다.\",\"q\":\"위 아동의 어휘 능력 평가·해석으로 가장 적절한 것은?\",\"choices\":[\"두 언어에서 아는 개념을 합산하여 판단한다\",\"한국어 어휘 수만으로 어휘 지체를 판정한다\",\"두 언어 노출이 어휘 지체의 원인이라고 설명한다\",\"몽골어 사용을 즉시 중단하도록 권고한다\",\"이중언어 아동에게 단일언어 규준을 그대로 적용한다\"],\"answer\":1,\"explain\":\"이중언어 아동의 어휘를 한 언어의 낱말 수만으로 판단하면 과소평가되므로, 두 언어에 걸쳐 아는 개념을 합산한 개념 어휘(conceptual vocabulary)로 평가해야 한다. 이중언어 노출 자체는 언어장애의 원인이 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"다문화·이중언어\",\"k\":\"이중언어 아동 어휘 평가\",\"p\":\"두 언어 노출 아동의 어휘 평가·해석 방식 선택\",\"n\":\"개념 어휘: 두 언어의 아는 개념 합산, 이중언어 노출은 장애 원인 아님\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"연구 참여자에게 연구의 목적·절차·위험을 설명하고 자발적 참여 동의를 받는 절차는?\",\"choices\":[\"사후 결과 보고\",\"고지된 사전 동의\",\"사후 디브리핑\",\"무선 할당 배치\",\"이중 은폐법 적용\"],\"answer\":2,\"explain\":\"사전 동의(고지된 동의, informed consent)는 연구 참여 전에 목적·절차·이익·위험 등을 충분히 설명하고 자발적 동의를 받는 연구윤리의 기본 절차이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"연구 참여 사전 동의\",\"p\":\"연구 전 설명과 자발적 동의 절차 특징으로 용어 식별\",\"n\":\"고지된 사전 동의: 목적·절차·위험 설명 후 자발적 참여 동의 획득\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"첫 상담에서 언어재활사가 보호자에게 상담의 목적과 진행 방식을 설명하고, 아동의 발달력과 가정에서의 의사소통 모습에 대한 정보를 수집하며 신뢰 관계를 형성하였다.\",\"q\":\"위 상담에 해당하는 부모상담 단계는?\",\"choices\":[\"실행 단계\",\"종결 단계\",\"추후 단계\",\"초기 단계\",\"평가 단계\"],\"answer\":4,\"explain\":\"상담의 목적·절차 안내, 라포 형성, 기초 정보 수집은 상담의 초기(준비) 단계에서 이루어진다. 공감적 반응을 바탕으로 구체적 문제해결 방안을 제시·실행하는 것은 실행 단계이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"상담\",\"k\":\"부모상담 단계\",\"p\":\"목적 안내·라포 형성·정보 수집 활동으로 상담 단계 판단\",\"n\":\"상담 초기 단계: 목적·절차 안내, 라포 형성, 기초 정보 수집\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"다문화가족·한부모가족 등의 자녀 중 언어발달이 지연된 아동에게 언어평가와 언어촉진 교육을 제공하는 지원사업이 있다.\",\"q\":\"위 사업에 대한 설명으로 옳은 것은?\",\"choices\":[\"등록 장애아동만을 대상으로 하는 의료 서비스이다\",\"언어를 평가하고 언어촉진 교육을 제공한다\",\"성인을 대상으로 하는 직업재활 사업이다\",\"자격 없이 누구나 중재를 제공할 수 있다\",\"평가 없이 모든 아동에게 동일한 프로그램을 제공한다\"],\"answer\":2,\"explain\":\"다문화가족 자녀 등을 위한 언어발달지원사업은 언어발달이 지연된 아동을 평가하고, 부모교육을 포함한 언어촉진 교육을 제공한다. 등록 장애아동을 주 대상으로 하는 발달재활서비스와는 대상·성격이 다르다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"다문화·이중언어\",\"k\":\"언어발달지원사업 특성\",\"p\":\"대상과 제공 내용으로 언어발달지원사업 특성 식별\",\"n\":\"언어발달지원사업: 다문화가족 자녀 등 대상 언어평가·언어촉진 교육\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"PK-WAB-R 하위검사 원점수\\n• 스스로 말하기: 14/20\\n• 알아듣기: 160/200\\n• 따라말하기: 80/100\\n• 이름대기: 70/100\",\"q\":\"이 환자의 실어증지수(AQ)로 옳은 것은? (AQ = [스스로말하기 + 알아듣기÷20 + 따라말하기÷10 + 이름대기÷10] × 2)\",\"choices\":[\"68.0\",\"72.0\",\"82.0\",\"74.0\",\"88.0\"],\"answer\":4,\"explain\":\"(14 + 160÷20[=8] + 80÷10[=8] + 70÷10[=7]) × 2 = (14+8+8+7)×2 = 74.0. ※AQ 산출식·중증도 절단점은 사용하는 교재 기준으로 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"PK-WAB-R AQ 산출\",\"p\":\"하위검사 원점수를 환산식에 대입해 실어증지수 산출\",\"n\":\"AQ: (스스로말하기+알아듣기÷20+따라말하기÷10+이름대기÷10)×2\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 발화는 유창하나 착어가 섞임\\n• 청각적 이해가 심하게 손상됨\\n• 따라말하기는 비교적 보존됨(88/100)\\n• 병식이 부족함\",\"q\":\"이 환자의 실어증 유형과 손상 추정 부위로 옳은 것은?\",\"choices\":[\"베르니케실어증 – 상측두회 후방\",\"명칭실어증 – 각회·측두엽 하부\",\"전도실어증 – 궁상다발·연상회\",\"연결피질감각실어증 – 후방 분수계\",\"혼합연결피질실어증 – 광범위 분수계\"],\"answer\":4,\"explain\":\"이해 손상+유창 착어는 베르니케와 유사하나 따라말하기가 보존되면 연결피질감각실어증(분수계 영역)으로 감별한다. 혼합연결피질은 따라말하기만 남고 이해·표현이 모두 심하게 손상되며 반향어를 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형·병변 감별\",\"p\":\"유창·이해 저하에 따라말하기 보존 조합으로 유형과 병변 판단\",\"n\":\"연결피질감각실어증: 유창·이해 저하·따라말하기 보존, 후방 분수계 병변\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"VFSS 소견\\n• 얇은 액체에서 삼킴 전 후두계곡으로 조기 흘러넘침, 삼킴반사 지연\\n• 후두 침습이 관찰되나 반사적 기침이 없음(무증상 침습)\\n• 점도를 높이면 침습이 소실됨\",\"q\":\"이 환자에게 가장 적절한 중재 조합은?\",\"choices\":[\"점도 증가 + 턱 당기기 + 삼킴반사 촉진\",\"얇은 액체 유지 + 성문상 삼킴 교육\",\"전면 금식 후 즉시 비위관 삽입 유지\",\"멘델슨 기법 + 혀 저항 운동 적용\",\"고개 젖히기 + 얇은 액체 여러 번 삼키기\"],\"answer\":1,\"explain\":\"조기 흘러넘침·반사 지연으로 인한 무증상 침습은 점도 증가로 흐름을 늦추고 chin-tuck으로 기도 입구를 보호하며 삼킴반사 촉진을 병행하는 것이 적절하다. 고개 젖히기는 흡인 위험을 높여 금기이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"삼킴장애\",\"k\":\"VFSS 소견별 중재 선택\",\"p\":\"조기 흘러넘침·무증상 침습 소견으로 삼킴 중재 조합 선택\",\"n\":\"조기 흘러넘침 침습: 점도 증가+턱 당기기+삼킴반사 촉진, 고개 젖히기 금기\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 소뇌 병변\\n• 자음·모음이 불규칙하게 붕괴됨\\n• 음절 강세가 불규칙하고 과도함\\n• 말속도가 느리고 음도·강도가 불규칙하게 변동함\",\"q\":\"이완형 마비말장애와 감별되는 이 유형(실조형)의 핵심 소견은?\",\"choices\":[\"과비성과 기식성 음성 동반\",\"쥐어짜는 듯한 노력성 음성\",\"단조로운 음도와 감소된 발성 강도\",\"불규칙적 조음 오류와 운율 붕괴\",\"말속도가 점점 빨라지고 뭉개짐\"],\"answer\":4,\"explain\":\"실조형(소뇌)은 불규칙한 조음 붕괴와 과도·불규칙한 강세가 특징이다. 이완형은 과비성·기식성(하부운동신경), 경직형은 쥐어짜는 노력성 음성, 과소운동형은 단조·약한 강도와 말속도 가속을 보인다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말운동장애\",\"k\":\"실조형 마비말장애 특징\",\"p\":\"소뇌 병변 말 특성으로 이완형과 구별되는 실조형 소견 식별\",\"n\":\"실조형: 불규칙 조음 붕괴·과도한 강세, 이완형은 과비성·기식성\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"낱말 읽기 검사\\n• 규칙어('바다','구름')는 정확히 읽음\\n• 불규칙어('굳이'→'구디')를 규칙화하여 잘못 읽음\\n• 비단어('무핀') 읽기는 양호함\",\"q\":\"이 환자의 실독증 유형과 손상된 읽기 경로는?\",\"choices\":[\"심층실독증 – 의미 경로\",\"표층실독증 – 어휘 경로\",\"음운실독증 – 음운 경로\",\"순수실독증 – 시각 입력\",\"무시실독증 – 주의\"],\"answer\":2,\"explain\":\"규칙어·비단어는 잘 읽으나 불규칙어에서 규칙화 오류가 나타나면 어휘(자소-의미) 경로가 손상되고 음운 경로에 의존하는 표층실독증이다. 심층실독증은 의미착어와 비단어 읽기의 심한 손상, 음운실독증은 비단어 읽기의 선택적 손상을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실독증·실서증\",\"k\":\"실독증 유형 감별\",\"p\":\"규칙어·비단어 보존과 불규칙어 규칙화 오류로 실독증 유형 판단\",\"n\":\"표층실독증: 어휘 경로 손상, 음운 경로 의존으로 불규칙어 규칙화\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 서서히 진행되는 언어 저하\\n• 발화는 유창하나 따라말하기와 낱말 인출이 손상됨\\n• 음소착어가 관찰되고 발화 중 낱말 찾기 지연이 잦음\\n• 낱말·대상 의미 지식과 문법은 상대적으로 보존됨\",\"q\":\"이 환자의 원발진행실어증(PPA) 유형은?\",\"choices\":[\"의미형 PPA\",\"로고페닉형 PPA\",\"비유창/실문법형 PPA\",\"혼합형 PPA\",\"PPA에 해당하지 않음\"],\"answer\":2,\"explain\":\"따라말하기·낱말인출 손상, 음소착어, 의미·문법의 상대적 보존은 로고페닉형 PPA이다. 의미형은 낱말 의미·대상지식 소실, 비유창/실문법형은 문법 붕괴와 말산출의 노력성이 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"PPA 하위유형 감별\",\"p\":\"낱말인출·따라말하기 손상과 의미·문법 보존으로 PPA 유형 판단\",\"n\":\"로고페닉형 PPA: 낱말인출·따라말하기 손상, 음소착어, 의미·문법 보존\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"브로카실어증 환자의 이름대기 중재로 의미자질분석(SFA)을 적용하려 한다.\",\"q\":\"SFA의 치료 기전으로 옳은 것은?\",\"choices\":[\"조음 운동을 반복 학습시켜 산출을 자동화한다\",\"억양과 리듬을 이용해 발화를 유도한다\",\"의미자질을 활성화하여 낱말 인출을 촉진한다\",\"제스처를 제한하고 구어 산출을 강제한다\",\"문법형태소 산출을 위계적으로 훈련한다\"],\"answer\":3,\"explain\":\"SFA는 목표 낱말의 범주·기능·특성 등 의미자질을 체계적으로 활성화해 어휘-의미망을 강화하고 낱말 인출을 촉진하는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"SFA 치료 기전\",\"p\":\"이름대기 중재 기법인 SFA의 작용 원리 식별\",\"n\":\"SFA: 범주·기능·특성 등 의미자질 활성화로 어휘-의미망 강화·인출 촉진\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"우반구 손상 환자\\n• 은유·농담의 함축을 파악하지 못함\\n• 말의 억양이 단조롭고 상대의 감정을 억양으로 읽지 못함\\n• 그림 왼쪽 세부를 자주 놓침\",\"q\":\"이 환자의 중재로 적절하지 않은 것은?\",\"choices\":[\"문법형태소 산출 반복 훈련\",\"함축·화용 추론 훈련\",\"운율 산출·해석 훈련\",\"좌측 훑어보기 훈련\",\"대화 상황에서의 화용 피드백\"],\"answer\":1,\"explain\":\"우반구 손상은 화용·운율·좌측 무시가 특징이므로 그에 맞는 중재가 필요하다. 문법형태소 산출 훈련은 좌반구 실문법증(브로카)에 해당하는 중재로 이 환자에게 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"인지의사소통장애\",\"k\":\"우반구 손상 중재 선택\",\"p\":\"화용·운율·좌측 무시 특성에 맞지 않는 중재 식별\",\"n\":\"우반구 손상: 화용·운율·좌측 무시 중재, 문법형태소 훈련은 브로카 대상\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 비유창성 실어증\\n• 스스로 말하기는 매우 제한적이나 익숙한 노래의 가락에 맞추면 몇몇 구를 산출함\",\"q\":\"이 환자에게 적용할 치료법과 그 근거로 옳은 것은?\",\"choices\":[\"의미자질분석 – 의미망 강화\",\"멜로디 억양 치료 – 우반구 활용\",\"제약유발 언어치료 – 구어 강제\",\"각본 훈련 – 자동구어 활용\",\"보완대체의사소통 – 구어 포기\"],\"answer\":2,\"explain\":\"멜로디 억양 치료(MIT)는 억양·리듬 처리에 관여하는 우반구 기능을 활용하여 비유창성 실어증 환자의 발화 산출을 촉진하는 기법으로, 노래 가락에서 발화가 촉진되는 이 사례에 적합하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"MIT 적용 근거\",\"p\":\"노래 가락에서 발화가 촉진되는 비유창 실어증에 치료법과 근거 선택\",\"n\":\"MIT: 억양·리듬 담당 우반구 기능 활용으로 비유창 실어증 발화 촉진\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"전도실어증 환자\\n• 유창한 발화, 양호한 청각적 이해\\n• 음소착어가 잦고 따라말하기가 선택적으로 손상됨\\n• 자신의 오류를 알아채고 반복 수정(접근 시도)함\",\"q\":\"이 환자의 중재로 가장 적절한 것은?\",\"choices\":[\"청각적 이해력 향상 훈련을 우선한다\",\"문법형태소 산출 훈련을 집중한다\",\"제스처만으로 의사소통하도록 유도한다\",\"음소 단서로 따라말하기를 반복 훈련한다\",\"완전 무발화로 보고 AAC를 즉시 도입한다\"],\"answer\":4,\"explain\":\"전도실어증은 이해가 양호하고 음소착어·따라말하기 손상이 핵심이므로, 따라말하기 과제와 음소 수준의 자기 수정(접근 시도)을 활용한 반복 훈련이 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"전도실어증 중재 선택\",\"p\":\"이해 양호·따라말하기 선택 손상 특성으로 중재 선택\",\"n\":\"전도실어증 중재: 음소 단서 활용 따라말하기 반복과 자기 수정 훈련\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"전반실어증 환자\\n• 발화·이해·따라말하기·이름대기가 모두 심하게 손상됨\\n• 몇몇 자동구어와 상황에 맞는 표정·제스처는 남아 있음\",\"q\":\"초기 단계에 우선적으로 고려할 중재로 가장 적절한 것은?\",\"choices\":[\"복잡한 통사 구조의 문장 이해 훈련\",\"비단어 따라말하기 훈련\",\"불규칙어 소리 내어 읽기 훈련\",\"빠른 이름대기 속도 훈련\",\"AAC와 의사소통 파트너 훈련\"],\"answer\":5,\"explain\":\"전반실어증 초기에는 잔존 능력(제스처·표정·자동구어)을 활용한 보완대체의사소통(AAC)과 보호자·파트너 훈련으로 기능적 의사소통을 확보하는 것이 우선이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"전반실어증 초기 중재\",\"p\":\"전 영역 중증 손상과 잔존 제스처·표정으로 초기 우선 중재 선택\",\"n\":\"전반실어증 초기: 잔존 능력 활용 AAC와 의사소통 파트너 훈련 우선\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"명칭실어증 환자에게 이름대기 단서를 위계적으로 제공하려 한다.\",\"q\":\"단서(cueing hierarchy)를 강도가 약한 것부터 강한 것 순으로 옳게 배열한 것은?\",\"choices\":[\"초성 음소 단서 → 의미 단서 → 문장 완성 단서 → 따라말하기\",\"의미 단서 → 따라말하기 → 초성 음소 단서 → 문장 완성 단서\",\"따라말하기 → 초성 음소 단서 → 의미 단서 → 문장 완성 단서\",\"문장 완성 단서 → 따라말하기 → 의미 단서 → 초성 음소 단서\",\"의미 단서 → 초성 음소 단서 → 문장 완성 단서 → 따라말하기\"],\"answer\":5,\"explain\":\"단서는 약한(의미) 것에서 강한(따라말하기) 것으로 위계적으로 제공하는 것이 일반적이다. 의미 단서 → 음소(초성) 단서 → 문장 완성 → 따라말하기 순으로 갈수록 인출 지원 강도가 커진다. ※단서 위계 순서는 교재별 차이가 있어 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"이름대기 단서 위계\",\"p\":\"단서의 인출 지원 강도 기준으로 약한 것부터 제공 순서 판단\",\"n\":\"단서 위계: 의미→초성 음소→문장 완성→따라말하기 순으로 강도 증가\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 근력 저하 없이 말소리를 탐색하는 입술·혀의 모색행동\\n• 같은 낱말에서도 매번 다른 조음 오류\\n• 자동구어는 비교적 유창함\",\"q\":\"이 환자(말실행증)에게 적용할 치료 원리로 가장 적절한 것은?\",\"choices\":[\"운동학습 원리의 집중 조음 연습\",\"구강 근력 강화를 위한 저항 운동\",\"청각적 이해력 향상 훈련\",\"호흡 지구력 강화 반복 훈련\",\"과비성 감소를 위한 공명 훈련\"],\"answer\":1,\"explain\":\"말실행증은 근력 문제가 아니라 말운동 프로그래밍의 손상이므로, 운동학습 원리(반복·점진적 난이도·피드백)를 적용해 조음점 전환을 집중적으로 반복 연습하는 것이 핵심이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"말실행증 치료 원리\",\"p\":\"근력 저하 없는 모색행동·비일관 오류로 치료 원리 선택\",\"n\":\"말실행증: 말운동 프로그래밍 손상, 운동학습 원리의 집중 반복 연습\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 양측 상부운동신경(추체로) 병변\\n• 느리고 노력성인 말, 쥐어짜는 듯한 거친 음성\\n• 과비성 동반, 말속도 저하\",\"q\":\"이 유형(경직형)의 마비말장애 환자에게 적절한 중재는?\",\"choices\":[\"말속도를 더 높여 자연스러움을 늘린다\",\"성대를 더 강하게 조이는 발성 훈련\",\"불수의 운동 억제 약물만 적용한다\",\"비강 공명을 늘리는 비음 강화 훈련\",\"근긴장 완화와 말속도·강세 조절 중재\"],\"answer\":5,\"explain\":\"경직형은 근긴장 항진으로 노력성·쥐어짜는 음성을 보이므로, 과도한 근긴장을 완화하는 이완 중재와 말속도·강세 등 운율 조절 중재가 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"경직형 마비말장애 중재\",\"p\":\"양측 상부운동신경 병변의 노력성 음성 특성으로 중재 선택\",\"n\":\"경직형: 근긴장 항진, 근긴장 완화 중재와 말속도·강세 조절\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 하부운동신경/뇌신경 병변\\n• 과비성이 두드러지고 기식성 음성\\n• 압력 자음 산출이 약하고 콧길로 공기가 새어 나옴\",\"q\":\"이 환자(이완형 마비말장애, 구개인두 기능부전)에게 우선 고려할 중재는?\",\"choices\":[\"말속도 감소 훈련\",\"불수의 운동 억제\",\"구개거상장치 적용\",\"좌측 훑어보기 훈련\",\"억양·리듬 치료\"],\"answer\":3,\"explain\":\"이완형에서 과비성·비누출은 구개인두 폐쇄부전 때문이므로, 구개인두 폐쇄 강화 중재와 필요 시 구개거상장치(palatal lift) 적용이 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"이완형 과비성 중재\",\"p\":\"과비성·비누출의 구개인두 폐쇄부전 원인으로 우선 중재 선택\",\"n\":\"이완형 구개인두 기능부전: 폐쇄 강화 중재와 필요 시 구개거상장치\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 파킨슨병(기저핵 회로 퇴행)\\n• 단조로운 음도, 감소된 강도, 말속도 가속으로 음절이 뭉개짐\\n• 환자는 자신의 목소리가 작다는 것을 잘 인식하지 못함\",\"q\":\"이 환자에게 근거가 확립된 치료법과 표적으로 옳은 것은?\",\"choices\":[\"CILT – 구어 산출 강제\",\"MIT – 억양·리듬 활용\",\"LSVT LOUD – 강도 증대\",\"SFA – 의미자질 분석\",\"chin-tuck – 삼킴 자세\"],\"answer\":3,\"explain\":\"과소운동형(파킨슨) 마비말장애에는 발성 강도(loudness) 증대에 초점을 둔 LSVT LOUD의 근거가 확립되어 있다. 강도 감각의 재보정(calibration)을 통해 말명료도를 높인다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"LSVT LOUD 적용\",\"p\":\"과소운동형 말 특성으로 근거 확립 치료법과 표적 선택\",\"n\":\"LSVT LOUD: 과소운동형 대상 발성 강도 증대, 강도 감각 재보정\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"삼킴장애 환자에게 다음 순서의 기법을 교육하였다.\\n① 음식을 입에 넣고 숨을 참는다 → ② 삼킨다 → ③ 삼킨 직후 기침을 한다 → ④ 다시 삼킨다\",\"q\":\"이 기법의 목적으로 옳은 것은?\",\"choices\":[\"상부식도괄약근의 개방 시간을 늘린다\",\"식도의 연동 운동을 빠르게 촉진한다\",\"혀 기저부의 후방 이동을 강화한다\",\"구강 준비 단계의 저작을 촉진한다\",\"삼킴 전·중 성대를 닫아 기도를 보호한다\"],\"answer\":5,\"explain\":\"성문상 삼킴(supraglottic swallow)은 삼킴 전·중 성대를 닫아 기도를 보호하고, 삼킴 후 기침으로 성문 위 잔여물을 배출하는 기법이다. 상부식도괄약근 개방 연장은 멘델슨 기법의 목적이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"삼킴장애\",\"k\":\"성문상 삼킴 목적\",\"p\":\"숨 참기·삼킴·기침 절차로 해당 삼킴 기법의 목적 식별\",\"n\":\"성문상 삼킴: 삼킴 전·중 성대 폐쇄로 기도 보호, 삼킴 후 기침으로 배출\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"삼킴 시 후두 거상이 불충분하고 상부식도괄약근(UES) 개방이 짧아 인두에 잔여물이 남는 환자.\",\"q\":\"가장 적절한 삼킴 기법은?\",\"choices\":[\"턱 당기기\",\"고개 돌리기\",\"성문상 삼킴\",\"멘델슨 기법\",\"고개 젖히기\"],\"answer\":4,\"explain\":\"멘델슨 기법(Mendelsohn maneuver)은 삼킴 시 후두 거상을 의도적으로 유지하여 상부식도괄약근 개방 시간을 늘리고 인두 잔여물을 줄인다. 턱 당기기(chin-tuck)는 기도 입구 보호, 고개 돌리기(head rotation)는 편측 인두 약화 시 건강한 쪽으로 식괴를 유도하는 자세이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"삼킴장애\",\"k\":\"멘델슨 기법 선택\",\"p\":\"후두 거상 부족·UES 개방 단축 소견으로 삼킴 기법 선택\",\"n\":\"멘델슨 기법: 후두 거상 유지로 UES 개방 연장, 인두 잔여물 감소\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"만성 실어증 환자에게 일상에서 구어 사용을 늘리기 위한 강도 높은 치료를 계획한다.\",\"q\":\"제약유발 언어치료(CILT)의 핵심 원리로 옳은 것은?\",\"choices\":[\"제스처·그림 등 비구어 수단을 적극 허용한다\",\"억양과 리듬을 이용해 발화를 유도한다\",\"비구어 수단을 제한하고 구어 산출을 강제한다\",\"목표 낱말의 의미자질을 분석하게 한다\",\"보호자가 환자 대신 말하도록 연습한다\"],\"answer\":3,\"explain\":\"CILT는 보상적 비구어 수단 사용을 제한하고, 강도 높은 구어 산출을 반복적으로 유도하여 학습된 미사용(learned nonuse)을 극복하는 원리를 따른다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"CILT 핵심 원리\",\"p\":\"만성 실어증 구어 사용 증대를 위한 CILT 원리 식별\",\"n\":\"CILT: 비구어 수단 제한·집중 구어 산출로 학습된 미사용 극복\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"경도~중등도 실어증 환자가 병원 접수·전화 등 특정 상황에서 필요한 발화를 자동화하고자 한다.\",\"q\":\"이 목표에 가장 적합한 중재는?\",\"choices\":[\"비단어 따라말하기 훈련\",\"각본(스크립트) 훈련\",\"불규칙어 읽기 훈련\",\"좌측 훑어보기 훈련\",\"구강 근력 강화 훈련\"],\"answer\":2,\"explain\":\"각본 훈련은 특정 상황에 필요한 대화를 반복 연습해 유창하고 자동화된 발화를 산출하도록 돕는 기능적 중재로, 상황 특이적 목표에 적합하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"각본 훈련 적용\",\"p\":\"상황 특이적 발화 자동화 목표에 맞는 중재 선택\",\"n\":\"각본 훈련: 특정 상황 대화 반복 연습으로 자동화된 발화 산출\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사자: \\\"이 그림(복잡한 장면)을 설명해 보세요.\\\"\\n환자A: 문법형태소를 생략한 전보식·비유창 발화\\n환자B: 유창하나 착어가 많고 상황과 무관한 공허한 발화\",\"q\":\"두 환자에 대한 감별과 중재로 옳은 것은?\",\"choices\":[\"A는 브로카·산출 중재, B는 베르니케·이해 중재\",\"A는 베르니케·이해 중재, B는 브로카·문법 중재\",\"A는 브로카·이해 중재, B는 베르니케·문법 중재\",\"A·B 모두 전도실어증으로 따라말하기 중재 우선\",\"A·B 모두 명칭실어증으로 이름대기 중재 우선\"],\"answer\":1,\"explain\":\"전보식·비유창(A)은 브로카로 발화 산출·문법 중재가, 유창하나 공허·착어(B)는 베르니케로 청각적 이해 중재가 우선된다. 진단을 서로 바꾸거나 진단에 맞지 않는 중재를 짝지은 선택지는 틀리다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"브로카·베르니케 감별 중재\",\"p\":\"전보식 발화와 공허한 유창 발화로 유형 감별 후 중재 선택\",\"n\":\"브로카는 산출·문법 중재, 베르니케는 청각적 이해 중재 우선\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"외상성 뇌손상(TBI) 환자\\n• 새로 들은 정보를 즉시 회상하지 못하고, 약속·일정을 자주 잊음\\n• 대화가 장황하고 주제에서 벗어남\",\"q\":\"이 환자의 인지-의사소통 중재로 가장 적절한 것은?\",\"choices\":[\"불규칙어 소리 내어 읽기 훈련\",\"과비성 감소를 위한 공명 훈련\",\"외부 기억 보조와 화용 훈련\",\"성문상 삼킴 기법 반복 훈련\",\"좌측 공간 훑어보기 훈련\"],\"answer\":3,\"explain\":\"TBI의 기억·집행기능·화용 저하에는 다이어리·알림 등 외부 기억 보조 전략 활용과 주제 유지를 포함한 화용 중재가 효과적이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"인지의사소통장애\",\"k\":\"TBI 인지-의사소통 중재\",\"p\":\"기억 저하와 장황·주제 이탈 양상으로 TBI 중재 선택\",\"n\":\"TBI 중재: 다이어리·알림 등 외부 기억 보조와 주제 유지 화용 훈련\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"초기 알츠하이머병 치매 환자. 최근 기억 저하가 있으나 절차기억은 비교적 보존됨.\",\"q\":\"이 환자의 이름대기·일상 기억 유지를 위한 중재로 가장 적절한 것은?\",\"choices\":[\"복잡한 통사 이해 훈련\",\"간격 회상 기법 적용\",\"비단어 따라말하기\",\"제약유발 언어치료\",\"구강 근력 강화 훈련\"],\"answer\":2,\"explain\":\"치매에서는 보존된 절차기억·점화를 활용한 간격 회상(spaced retrieval)과 환경 단서·일과표 등 환경 수정이 효과적이며, 무오류 학습 원리를 함께 적용한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"인지의사소통장애\",\"k\":\"치매 간격 회상 기법\",\"p\":\"절차기억 보존 특성으로 치매 기억·이름대기 중재 선택\",\"n\":\"간격 회상: 보존된 절차기억·점화 활용, 무오류 학습 원리 병행\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"여러 실어증 환자를 대상으로 그룹치료를 운영하며, 실제 대화처럼 새 정보를 주고받는 능력을 기르고자 한다.\",\"q\":\"의사소통효과증진법(PACE)의 원리로 옳은 것은?\",\"choices\":[\"새 정보를 다양한 수단으로 주고받는다\",\"치료사가 정답을 먼저 알려 주고 시작한다\",\"환자가 구어만 사용하도록 제한한다\",\"문법형태소를 정확히 산출하게 한다\",\"그림 이름을 순서대로 따라 말하게 한다\"],\"answer\":1,\"explain\":\"PACE는 치료사와 환자가 순번을 교대하며 상대가 모르는 새 정보를 전달하고, 구어·제스처·그림 등 다양한 수단을 자유롭게 활용해 의사소통 효율을 높이는 화용 중심 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"PACE 원리\",\"p\":\"실제 대화형 정보 교환 목표에 맞는 PACE 운영 원리 식별\",\"n\":\"PACE: 순번 교대로 새 정보 전달, 구어·제스처·그림 등 수단 자유 선택\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌손상 환자\\n• 근긴장 저하, 안정 시 떨림 없음\\n• 보행이 불안정함\\n• 손가락-코 검사에서 목표를 지나치고 흔들림(측정이상)\",\"q\":\"손상 부위로 가장 적절한 것은?\",\"choices\":[\"시상\",\"소뇌\",\"해마\",\"기저핵\",\"측두엽\"],\"answer\":2,\"explain\":\"근긴장 저하·측정이상(dysmetria)·보행 실조·의도성 떨림은 소뇌 손상의 특징이다. 기저핵 손상은 안정 시 떨림·경직·운동완만을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"신경해부·뇌혈관\",\"k\":\"소뇌 손상 부위 추론\",\"p\":\"근긴장 저하·측정이상·보행 실조 소견으로 손상 부위 판단\",\"n\":\"소뇌 손상: 근긴장 저하·측정이상·보행 실조·의도성 떨림, 기저핵은 안정 시 떨림\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"혀를 내밀게 하니 혀끝이 왼쪽으로 치우치고, 왼쪽 혀의 위축이 관찰됨.\",\"q\":\"손상된 뇌신경으로 옳은 것은?\",\"choices\":[\"왼쪽 안면신경(7번)\",\"오른쪽 설하신경(12번)\",\"왼쪽 설하신경(12번)\",\"왼쪽 삼차신경(5번)\",\"오른쪽 미주신경(10번)\"],\"answer\":3,\"explain\":\"혀 운동은 설하신경(12번)이 지배하며, 손상 시 혀를 내밀면 손상된 쪽으로 편위되고 그쪽 혀가 위축된다. 왼쪽으로 편위+왼쪽 위축이면 왼쪽 설하신경 손상이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"신경해부·뇌혈관\",\"k\":\"설하신경 손상 측 판별\",\"p\":\"혀 내밀기 편위 방향과 위축 측으로 손상 뇌신경 식별\",\"n\":\"설하신경(12번) 손상: 혀가 손상된 쪽으로 편위되고 같은 쪽 혀 위축\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사 설명\\n• 실어증 유무와 유형을 확인함\\n• 스스로 말하기·알아듣기·따라말하기·이름대기를 평가함\\n• 실어증지수(AQ)를 산출함\",\"q\":\"해당하는 검사는?\",\"choices\":[\"한국판 간이정신상태검사(K-MMSE)\",\"한국판 몬트리올 인지평가(K-MoCA)\",\"실어증-신경언어장애 선별검사(STAND)\",\"파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R)\",\"한국 실어증 감별진단 검사(KTDDA)\"],\"answer\":4,\"explain\":\"AQ 산출과 4개 언어영역 평가로 실어증 유형을 진단하는 검사는 PK-WAB-R이다. STAND는 선별검사, K-MMSE·K-MoCA는 인지선별검사이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 검사도구 식별\",\"p\":\"4개 언어영역 평가와 AQ 산출 특징으로 해당 검사 식별\",\"n\":\"PK-WAB-R: 말하기·알아듣기·따라말하기·이름대기 평가, AQ로 유형 진단\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사자: (사과 그림) \\\"이름이 무엇입니까?\\\"\\n환자: \\\"그… 먹는 거… 빨갛고 둥근… 그거요.\\\"\",\"q\":\"이 환자가 보이는 이름대기 오류 유형은?\",\"choices\":[\"보속증\",\"음소착어\",\"에두르기\",\"신조착어\",\"의미착어\"],\"answer\":3,\"explain\":\"목표 낱말을 산출하지 못하고 그 특징이나 기능을 우회적으로 설명하는 것은 에두르기(circumlocution)이다. 의미착어는 관련 낱말로 대치('사과'→'포도'), 음소착어는 음소 대치('사과'→'다과')이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"이름대기 오류 유형\",\"p\":\"목표어 대신 특징·기능을 설명하는 반응으로 오류 유형 판단\",\"n\":\"에두르기: 목표 낱말 대신 특징·기능을 돌려 설명, 의미착어·음소착어와 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"낱말 읽기\\n• 실제 낱말을 의미적으로 관련된 낱말로 대치함('버스'→'기차')\\n• 비단어('무핀') 읽기가 거의 불가능함\\n• 추상어보다 구체어를 더 잘 읽음\",\"q\":\"이 실독증 유형은?\",\"choices\":[\"표층실독증\",\"음운실독증\",\"무시실독증\",\"순수실독증\",\"심층실독증\"],\"answer\":5,\"explain\":\"의미착어(의미 대치), 비단어 읽기의 심한 손상, 구체어>추상어의 심상성 효과는 심층실독증의 특징이다. 표층은 불규칙어 규칙화 오류, 음운실독증은 비단어의 선택적 손상을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실독증·실서증\",\"k\":\"실독증 유형 감별\",\"p\":\"의미 대치·비단어 읽기 불가·구체어 우위로 실독증 유형 판단\",\"n\":\"심층실독증: 의미착어, 비단어 읽기 심한 손상, 구체어>추상어 심상성 효과\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 발화는 유창하나 착어가 섞임\\n• 청각적 이해가 심하게 손상됨\\n• 따라말하기도 손상됨\\n• 병식이 부족함\",\"q\":\"이 환자의 실어증 유형은?\",\"choices\":[\"브로카실어증\",\"연결피질감각실어증\",\"전도실어증\",\"베르니케실어증\",\"명칭실어증\"],\"answer\":4,\"explain\":\"유창한 착어 발화+이해 손상+따라말하기 손상+병식 부족은 베르니케실어증이다. 따라말하기가 보존되면 연결피질감각실어증으로 감별한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형 감별\",\"p\":\"유창·이해 손상·따라말하기 손상·병식 부족 조합으로 유형 판단\",\"n\":\"베르니케실어증: 유창한 착어 발화·이해 손상·따라말하기 손상·병식 부족\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 느리고 노력성인 비유창 발화\\n• 조사·어미 등 문법형태소를 생략하는 전보식 발화\\n• 따라말하기 손상, 단순 지시 이해는 비교적 양호\",\"q\":\"이 환자의 실어증 유형은?\",\"choices\":[\"명칭실어증\",\"베르니케실어증\",\"전도실어증\",\"전반실어증\",\"브로카실어증\"],\"answer\":5,\"explain\":\"비유창·노력성·전보식(실문법) 발화, 손상된 따라말하기, 비교적 양호한 이해는 브로카실어증의 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형 감별\",\"p\":\"비유창·전보식 발화와 비교적 양호한 이해로 실어증 유형 판단\",\"n\":\"브로카실어증: 노력성 비유창·실문법 발화, 따라말하기 손상, 이해 비교적 양호\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 유창한 발화에 음소착어가 잦음\\n• 청각적 이해는 양호함\\n• 따라말하기가 선택적으로 뚜렷하게 손상됨\",\"q\":\"이 환자의 실어증 유형과 관련 손상 구조로 옳은 것은?\",\"choices\":[\"베르니케실어증 – 상측두회\",\"전도실어증 – 궁상다발\",\"브로카실어증 – 하전두회\",\"명칭실어증 – 각회\",\"전반실어증 – 광범위\"],\"answer\":2,\"explain\":\"유창+이해 양호+따라말하기의 선택적 손상+음소착어는 전도실어증이며, 브로카·베르니케 영역을 잇는 궁상다발 손상과 관련된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형·병변 연결\",\"p\":\"따라말하기의 선택적 손상과 음소착어로 유형과 손상 구조 판단\",\"n\":\"전도실어증: 유창·이해 양호·따라말하기 선택적 손상, 궁상다발 손상\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌졸중에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"색전증은 다른 부위의 혈전 조각이 혈관을 막아 발생한다\",\"허혈성 뇌졸중의 가장 대표적인 원인은 혈관 파열이다\",\"혈전증은 혈관벽이 풍선처럼 약하게 부풀어 발생한다\",\"출혈성 뇌졸중은 허혈성 뇌졸중보다 발생 빈도가 높다\",\"지주막하출혈은 혈관이 서서히 좁아지며 막혀 발생한다\"],\"answer\":1,\"explain\":\"색전증은 다른 부위(심장 등)에서 형성된 색전이 이동해 혈관을 막아 갑작스럽게 발생한다. 허혈성이 출혈성보다 흔하며, 허혈성의 주 기전은 혈전·색전에 의한 혈관 폐색이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"신경해부·뇌혈관\",\"k\":\"뇌졸중 유형·기전\",\"p\":\"허혈성·출혈성 뇌졸중의 발생 기전과 빈도 구분으로 옳은 설명 식별\",\"n\":\"색전증: 다른 부위 색전이 이동해 혈관 폐색, 허혈성이 출혈성보다 흔함\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌경색 환자\\n• 시력·시야 검사 결과 이상 없음\\n• 실제 낱말과 무의미 낱말을 모두 소리 내어 읽지 못함\\n• 받아쓰기와 자발적 글쓰기도 함께 저하됨\",\"q\":\"손상 가능성이 가장 높은 동맥은?\",\"choices\":[\"전대뇌동맥\",\"후대뇌동맥\",\"척추기저동맥\",\"내경동맥 안분지\",\"중대뇌동맥\"],\"answer\":5,\"explain\":\"읽기와 쓰기가 함께 손상된 실서증 동반 실독증은 좌측 각회 손상으로 생기며, 각회는 중대뇌동맥 관류 영역이다. 쓰기가 보존되는 순수 실독증(실서증 없는 실독증)은 좌측 후두엽과 뇌량 팽대부 손상으로 생기고 후대뇌동맥과 관련된다. 두 유형은 쓰기 손상 여부로 구별한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"신경해부·뇌혈관\",\"k\":\"실독증 관련 동맥 추론\",\"p\":\"읽기·쓰기 동반 손상 양상으로 병변과 관류 동맥 판단\",\"n\":\"실서증 동반 실독증: 좌측 각회 손상, 중대뇌동맥 영역, 순수 실독증은 후대뇌동맥\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"실어증 환자의 PK-WAB-R 결과\\n• AQ 37점, 스스로 말하기 6/20(비유창)\\n• 알아듣기 양호, 따라말하기 비교적 보존\",\"q\":\"이 프로파일에 가장 부합하는 실어증 유형은?\",\"choices\":[\"연결피질운동실어증\",\"전도실어증\",\"베르니케실어증\",\"명칭실어증\",\"연결피질감각실어증\"],\"answer\":1,\"explain\":\"비유창하나 이해가 양호하고 따라말하기가 유창성에 비해 뚜렷하게 보존되면 연결피질운동실어증이다. 브로카는 따라말하기도 손상된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"PK-WAB-R 프로파일 해석\",\"p\":\"비유창·이해 양호·따라말하기 보존 프로파일로 실어증 유형 판단\",\"n\":\"연결피질운동실어증: 비유창·이해 양호·따라말하기 보존, 브로카와 따라말하기로 감별\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"마비말장애 유형에 대한 설명이다.\",\"q\":\"유형과 특징이 옳게 연결된 것은?\",\"choices\":[\"실조형 – 불규칙한 조음 오류와 과도·불규칙한 강세\",\"경직형 – 기식음과 가청 흡기음이 두드러짐\",\"이완형 – 쥐어짜는 듯한 노력성 음성이 두드러짐\",\"과소운동형 – 불수의적 과다 운동으로 인한 변동\",\"과다운동형 – 감소된 강도와 짧은 말 돌진이 두드러짐\"],\"answer\":1,\"explain\":\"실조형(소뇌)은 불규칙 조음·과도 강세가 특징이다. 이완형(하부운동신경)은 기식음·가청 흡기음·과비성, 경직형은 쥐어짜는 노력성 음성, 과소운동형은 단조로운 음도·감소된 강도·짧은 말 돌진, 과다운동형은 불수의 운동에 따른 변동을 보인다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말운동장애\",\"k\":\"마비말장애 유형별 특징\",\"p\":\"손상 부위별 마비말장애 말 특성 연결로 옳은 짝 식별\",\"n\":\"실조형: 불규칙 조음·과도 강세, 이완형 기식음, 경직형 노력성, 과소운동형 짧은 말 돌진\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 같은 낱말에서도 매번 다른 조음 오류를 보임\\n• 말소리를 찾는 듯한 입술·혀의 모색행동\\n• 근력 약화는 뚜렷하지 않음\",\"q\":\"이 환자의 말장애로 가장 적절한 것은?\",\"choices\":[\"이완형 마비말장애\",\"경직형 마비말장애\",\"말실행증(AOS)\",\"실조형 마비말장애\",\"과소운동형 마비말장애\"],\"answer\":3,\"explain\":\"비일관적 조음 오류와 모색행동, 뚜렷하지 않은 근력 약화는 말운동 프로그래밍의 손상인 말실행증의 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"말실행증 식별\",\"p\":\"비일관적 오류·모색행동·근력 약화 없음으로 말장애 유형 판단\",\"n\":\"말실행증: 말운동 프로그래밍 손상, 비일관적 조음 오류와 모색행동, 근력 약화 없음\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"말실행증과 마비말장애를 감별하려 한다.\",\"q\":\"말실행증에 더 부합하는 특징은?\",\"choices\":[\"일관되고 예측 가능한 조음 오류\",\"근긴장 항진에 따른 느리고 힘든 말\",\"지속적인 과비성과 비강 누출\",\"비일관적 조음 오류와 모색행동\",\"호흡·발성 기능의 지속적 약화\"],\"answer\":4,\"explain\":\"말실행증은 비일관적 오류와 모색행동이 특징인 반면, 마비말장애는 근육 약화·마비에 따른 비교적 일관된 오류와 음성·공명 이상을 보인다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말운동장애\",\"k\":\"말실행증·마비말장애 감별\",\"p\":\"오류 일관성과 근력·음성 이상 유무로 말실행증 특징 식별\",\"n\":\"말실행증은 비일관적 오류·모색행동, 마비말장애는 일관된 오류와 음성·공명 이상\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"수정바륨삼킴검사 단계별 결과\\n• 구강 준비·구강 운반 단계: 정상\\n• 인두 단계: 삼킴반사 지연, 후두계곡·조롱박오목에 잔여물\\n• 식도 단계: 정상\",\"q\":\"문제가 있는 단계는?\",\"choices\":[\"구강 준비 단계\",\"구강 운반 단계\",\"정상 소견\",\"식도 단계\",\"인두 단계\"],\"answer\":5,\"explain\":\"삼킴반사 지연과 인두 잔여물은 인두 단계의 문제이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"삼킴장애\",\"k\":\"VFSS 소견 해석\",\"p\":\"삼킴반사 지연과 후두계곡·조롱박오목 잔여물로 문제 단계 판단\",\"n\":\"인두 단계 문제: 삼킴반사 지연, 후두계곡·조롱박오목 잔여물\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"삼킴장애 환자에게서 다음 소견이 관찰됨.\\n• 삼킨 뒤에도 기침·목소리 변화가 없으나 흉부 영상에서 흡인 소견이 확인됨\",\"q\":\"이 현상에 대한 설명으로 옳은 것은?\",\"choices\":[\"기침 반사가 유지된 정상적인 방어 반응이다\",\"기도 방어 반사 저하를 시사하는 무증상 흡인\",\"구강 준비 단계의 저작 문제로 인한 것이다\",\"식도 이완불능증에서 보이는 전형적 특징이다\",\"미각 저하로 인한 일시적인 삼킴 지연이다\"],\"answer\":2,\"explain\":\"기침 등 외현적 징후 없이 성문 아래로 이물이 넘어가는 것을 무증상 흡인(silent aspiration)이라 하며, 감각·기도 방어 반사 저하와 관련되어 위험이 크다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"삼킴장애\",\"k\":\"무증상 흡인 해석\",\"p\":\"기침 없이 영상에서 확인된 흡인 소견의 의미 판단\",\"n\":\"무증상 흡인: 외현 징후 없이 성문 아래로 흡인, 감각·기도 방어 반사 저하\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"정상 삼킴 생리의 단계에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"구강 준비 단계에서 삼킴반사가 유발된다\",\"인두 단계에서 연구개가 하강하여 비강이 열린다\",\"인두 단계에서 후두가 상승하고 성대가 닫힌다\",\"식도 단계는 주로 수의적으로 조절된다\",\"구강 운반 단계에서 상부식도괄약근이 열린다\"],\"answer\":3,\"explain\":\"인두 단계에서 후두 거상·성대 폐쇄·후두개 하강으로 기도가 보호되고 상부식도괄약근이 열려 음식이 식도로 이동한다. 연구개는 상승하여 비인두를 막는다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"삼킴장애\",\"k\":\"정상 삼킴 단계 생리\",\"p\":\"단계별 기도 보호 기전과 구조 움직임으로 옳은 설명 식별\",\"n\":\"인두 단계: 후두 거상·성대 폐쇄·후두개 하강, 연구개 상승, 상부식도괄약근 개방\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"DSM-5에서 알츠하이머병으로 인한 경도 신경인지장애를 진단하려 한다.\",\"q\":\"필수적인 조건으로 옳은 것은?\",\"choices\":[\"인지 저하로 일상활동의 독립성이 상실됨\",\"삼킴능력의 뚜렷한 저하가 동반됨\",\"경미한 인지 저하가 있으나 독립성 유지\",\"시각·청각 등 말초 지각능력의 저하\",\"편측 운동마비와 보행장애의 동반\"],\"answer\":3,\"explain\":\"경도 신경인지장애는 인지영역의 경미한 저하가 있으나 일상생활의 독립성은 유지된다. 독립성이 상실되면 주요(major) 신경인지장애로 진단한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"경도 신경인지장애 진단 기준\",\"p\":\"일상생활 독립성 유지 여부로 경도·주요 신경인지장애 구분 판단\",\"n\":\"경도 신경인지장애: 경미한 인지 저하와 독립성 유지, 독립성 상실 시 주요 신경인지장애\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"인지의사소통장애·치매 유형에 대한 설명이다.\",\"q\":\"옳게 연결된 것은?\",\"choices\":[\"알츠하이머 치매 – 발병 초기부터 비유창 발화가 두드러짐\",\"혈관성 치매 – 베타 아밀로이드 축적이 주된 원인\",\"원발진행실어증 – 뇌혈관 질환에 의한 급성 발병\",\"파킨슨병 치매 – 발병 초기부터 심한 실어증이 나타남\",\"전두측두엽 치매 – 초기부터 성격·행동 변화가 두드러짐\"],\"answer\":5,\"explain\":\"전두측두엽 치매는 초기부터 성격·행동 변화 또는 언어 변화가 두드러진다. 알츠하이머는 초기 기억·이름대기 저하(발화는 유창), 베타 아밀로이드는 알츠하이머, PPA는 서서히 진행되는 퇴행성 언어장애이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"인지의사소통장애\",\"k\":\"치매 유형별 특징\",\"p\":\"치매 유형별 원인과 초기 증상 연결로 옳은 짝 식별\",\"n\":\"전두측두엽 치매: 초기부터 성격·행동 변화, 알츠하이머는 초기 기억·이름대기 저하\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사자: \\\"방금 불러드린 숫자 5-2-8-1을 거꾸로 말해 보세요.\\\"\\n환자: 수행에 어려움을 보임\",\"q\":\"이 과제가 주로 평가하는 기억 유형은?\",\"choices\":[\"절차기억\",\"암묵기억\",\"작업기억\",\"서술적 장기기억\",\"점화\"],\"answer\":3,\"explain\":\"정보를 잠시 유지하면서 조작(역순 말하기)하는 능력은 작업기억이다. 절차·암묵기억은 기술·습관에 관한 비서술 기억이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"숫자 거꾸로 따라하기 해석\",\"p\":\"정보 유지와 조작을 요구하는 과제 특성으로 평가 기억 유형 판단\",\"n\":\"작업기억: 정보를 잠시 유지하며 조작하는 능력, 숫자 역순 따라하기로 평가\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"기억 유형에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"절차기억은 사건·사실에 대한 의식적 기억이다\",\"서술기억은 자전거 타기 같은 기술에 대한 기억이다\",\"의미기억은 개인적 사건의 시공간 정보를 포함한다\",\"절차기억은 기술·습관에 대한 비서술 기억이다\",\"일화기억은 일반적인 사실과 지식에 대한 기억이다\"],\"answer\":4,\"explain\":\"절차기억은 반복 학습된 운동·기술 습관에 대한 비서술(암묵) 기억이다. 서술기억은 의미기억(일반 지식)과 일화기억(개인적 사건)으로 나뉜다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"인지의사소통장애\",\"k\":\"기억 유형 분류\",\"p\":\"서술·비서술 기억과 하위 유형의 정의 구분으로 옳은 설명 식별\",\"n\":\"절차기억: 기술·습관의 비서술 기억, 서술기억은 의미기억과 일화기억으로 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"우반구 손상 환자의 의사소통 특징이다.\",\"q\":\"가장 적절한 설명은?\",\"choices\":[\"문법형태소를 생략한 전보식 발화가 핵심이다\",\"따라말하기만 선택적으로 심하게 손상된다\",\"심한 청각적 이해 손상과 착어가 핵심이다\",\"은유 이해 어려움, 단조로운 운율, 좌측 무시\",\"비단어 읽기만 선택적으로 심하게 손상된다\"],\"answer\":4,\"explain\":\"우반구 손상은 화용·비유·함축 이해의 어려움, 운율(감정 억양) 저하, 좌측 무시가 특징이다. 나머지는 좌반구 실어증 유형의 특징이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"인지의사소통장애\",\"k\":\"우반구 손상 의사소통 특징\",\"p\":\"화용·운율·주의 문제와 좌반구 실어증 특징 구분으로 설명 선택\",\"n\":\"우반구 손상: 비유·함축 이해 어려움, 정서 운율 저하, 좌측 무시\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌 영상 기법에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"CT는 방사선을 쓰지 않아 반복 촬영이 안전하다\",\"fMRI는 과제 수행 시 혈류 변화로 뇌 활성을 반영한다\",\"fMRI는 뇌의 구조만 보여주고 기능은 반영하지 못한다\",\"구조적 MRI는 실시간 신경 활동의 전기 신호를 측정한다\",\"EEG는 뇌의 포도당 대사 소비량을 측정한다\"],\"answer\":2,\"explain\":\"fMRI는 과제 중 혈중 산소 수준(BOLD) 변화를 통해 뇌 기능 활성을 간접 측정한다. 구조적 MRI·CT는 구조 영상, EEG는 전기활동, PET는 대사를 측정한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"신경해부·뇌혈관\",\"k\":\"뇌 영상 기법 원리\",\"p\":\"영상 기법별 측정 대상(구조·혈류·전기·대사) 구분으로 옳은 설명 식별\",\"n\":\"fMRI: 과제 중 BOLD 혈류 변화로 기능 측정, EEG 전기활동, PET 대사\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌자기공명영상(B-MRI)에서 양측 선조체에 이상 신호를 보이는 환자의 말 특성\\n검사자: \\\"몇 시에 약을 드세요?\\\"\\n환자: \\\"나는 약을 12시에, 12시에 먹어야, 12시에 먹어야, 먹어야 해\\\"\",\"q\":\"이 환자가 보이는 증상은?\",\"choices\":[\"반향어증\",\"동어반복증\",\"실구어증\",\"감금증후군\",\"발성실행증\"],\"answer\":2,\"explain\":\"자신의 낱말·구를 반복하는 것은 동어반복증(palilalia)으로, 기저핵(선조체) 병변과 관련될 수 있다. 반향어는 상대의 말을 따라 반복하는 것이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"동어반복증 식별\",\"p\":\"기저핵 병변과 자기 말의 반복 양상으로 증상 명칭 판단\",\"n\":\"동어반복증: 자신의 낱말·구를 반복, 기저핵 병변 관련, 반향어는 상대 말 반복\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"실어증 평가의 하위 영역에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"유창성은 청각적 이해 점수로만 판단한다\",\"이름대기 손상은 대부분의 실어증에서 관찰된다\",\"따라말하기 손상 정도는 모든 유형에서 동일하다\",\"알아듣기 검사는 발화의 문법성만 평가한다\",\"스스로 말하기는 읽기 능력으로 대체 평가한다\"],\"answer\":2,\"explain\":\"이름대기 손상은 유형과 무관하게 대부분의 실어증에서 흔히 관찰된다. 따라말하기 손상 여부는 유형 감별의 핵심 지표로 유형마다 다르다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 평가 하위 영역\",\"p\":\"하위 영역별 평가 의미와 유형 간 차이로 옳은 설명 식별\",\"n\":\"이름대기 손상은 대부분 실어증에서 관찰, 따라말하기는 유형 감별 핵심 지표\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"외상성 뇌손상(TBI) 환자의 인지-의사소통 특징이다.\",\"q\":\"가장 적절한 설명은?\",\"choices\":[\"주의·기억·집행기능 저하와 화용 문제가 두드러진다\",\"언어의 음운·문법 손상이 핵심이며 인지는 보존된다\",\"심한 청각적 이해 손상이 가장 핵심적인 특징이다\",\"편측 무시가 주된 의사소통 특징으로 나타난다\",\"전형적으로 비유창 실어증의 형태로 나타난다\"],\"answer\":1,\"explain\":\"TBI는 주의·기억·집행기능 등 인지 저하와 함께 화용(주제 유지, 장황함, 상황 파악)의 어려움이 두드러지는 인지-의사소통장애 양상을 보인다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"인지의사소통장애\",\"k\":\"TBI 인지-의사소통 특징\",\"p\":\"인지 저하와 화용 문제 중심 양상으로 TBI 특징 식별\",\"n\":\"외상성 뇌손상: 주의·기억·집행기능 저하와 주제 유지·장황함 등 화용 문제\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"낱말 읽기\\n• 실제 낱말('학교','사람') 읽기는 양호함\\n• 비단어('두랍','무핀') 읽기가 선택적으로 손상됨\",\"q\":\"이 실독증 유형과 손상된 경로는?\",\"choices\":[\"표층실독증 – 전체 단어 어휘 경로\",\"심층실독증 – 의미 처리 경로\",\"순수실독증 – 시각 단어형태 입력 경로\",\"음운실독증 – 자소-음소 변환 경로\",\"무시실독증 – 공간 주의 경로\"],\"answer\":4,\"explain\":\"실제 낱말은 잘 읽으나 비단어 읽기가 선택적으로 손상되면 자소-음소 변환(음운 경로) 손상인 음운실독증이다. 표층은 불규칙어 규칙화 오류가 핵심이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실독증·실서증\",\"k\":\"실독증 유형·손상 경로\",\"p\":\"실제 낱말 보존과 비단어 선택적 손상으로 유형과 경로 판단\",\"n\":\"음운실독증: 자소-음소 변환 경로 손상, 비단어 읽기 선택적 손상\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"대뇌 반구의 기능 편재화에 대한 설명이다.\",\"q\":\"일반적인 오른손잡이 성인에서 옳은 것은?\",\"choices\":[\"정서적 운율과 화용은 주로 우반구가 관여한다\",\"언어의 음운·통사 처리는 주로 우반구가 담당한다\",\"좌측 무시는 좌반구 손상에서 더 흔하다\",\"좌반구는 얼굴 정서 인식만을 전담한다\",\"우반구 손상은 전형적인 실문법증을 유발한다\"],\"answer\":1,\"explain\":\"대부분의 오른손잡이에서 언어의 음운·통사는 좌반구가 우세하고, 정서적 운율·화용·시공간 주의는 우반구가 관여한다. 좌측 무시는 우반구 손상에서 흔하다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"신경해부·뇌혈관\",\"k\":\"대뇌 반구 편재화\",\"p\":\"좌우 반구의 언어·운율·주의 기능 분담으로 옳은 설명 식별\",\"n\":\"오른손잡이: 음운·통사는 좌반구, 정서 운율·화용·시공간 주의는 우반구\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"초기 알츠하이머병 환자의 이름대기 저하를 다루는 치료 원리이다.\",\"q\":\"가장 적절한 것은?\",\"choices\":[\"무오류 학습과 간격 회상을 활용한다\",\"오류를 경험하게 하여 스스로 교정하게 한다\",\"복잡한 통사 이해 과제를 우선 훈련한다\",\"구강 근력 강화 훈련을 우선한다\",\"제약유발 언어치료로 구어를 강제한다\"],\"answer\":1,\"explain\":\"치매에서는 무오류 학습과 간격 회상, 환경 단서 등 보존된 절차·점화 기억을 활용하는 것이 효과적이며, 오류 경험을 최소화하는 것이 원칙이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"인지의사소통장애\",\"k\":\"치매 이름대기 중재 원리\",\"p\":\"보존된 기억 체계 활용 원리로 치매 이름대기 치료 방법 선택\",\"n\":\"치매 중재: 무오류 학습·간격 회상·환경 단서, 오류 경험 최소화\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 발화·청각적 이해·따라말하기·이름대기가 모두 심하게 손상됨\\n• 몇몇 자동구어(인사말 등)와 상황에 맞는 표정·제스처만 남아 있음\",\"q\":\"이 환자의 실어증 유형은?\",\"choices\":[\"브로카실어증\",\"베르니케실어증\",\"전도실어증\",\"명칭실어증\",\"전반실어증\"],\"answer\":5,\"explain\":\"네 가지 언어 영역이 모두 심하게 손상되고 자동구어·비언어 수단만 남으면 전반실어증이다. 광범위한 좌반구(중대뇌동맥 영역) 손상과 관련된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형 감별\",\"p\":\"모든 언어 영역의 심한 손상과 자동구어 잔존으로 유형 판단\",\"n\":\"전반실어증: 4개 언어 영역 모두 심한 손상, 자동구어·비언어 수단만 잔존\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 2개월 남아, 기질적 결함 없음. 낱말검사·자발화 분석 결과\\n• /ㄱ, ㅋ/ → [ㄷ, ㅌ]: 모든 낱말 위치에서 대치, 자극반응도 있음\\n• 어두 /ㅅ/ → [ㄷ]: 자극반응도 없음\\n• 어중 /ㄹ/ 생략: 자극반응도 있음\\n• 부모 보고: 또래·교사가 말을 잘 알아듣지 못해 아동이 위축됨\",\"q\":\"발달 기준·오류 빈도·자극반응도를 고려하여 말명료도 향상을 최우선 목표로 할 때, 첫 목표음과 그 근거로 가장 적절한 것은?\",\"choices\":[\"/ㅅ/ – 가장 늦게 발달하는 음소라 먼저 훈련하면 다른 음소로 일반화된다\",\"/ㄹ/ – 생략 오류는 대치 오류보다 말명료도를 더 크게 떨어뜨린다\",\"/ㄱ/ – 연령상 습득되었어야 할 고빈도 음소이며 자극반응도가 있다\",\"세 음소를 같은 비중으로 동시에 훈련하여 전체 치료 기간을 단축한다\",\"비구어 구강운동 훈련으로 혀의 힘을 먼저 기른 뒤 목표음을 정한다\"],\"answer\":3,\"explain\":\"발달적(전통적) 목표 선정 원칙에서는 ①해당 연령에 이미 습득되어야 할 이른 발달음 ②사용 빈도가 높아 명료도에 영향이 큰 음 ③자극반응도가 있어 빠른 성공이 기대되는 음을 우선한다. /ㄱ/은 세 조건을 모두 충족한다. ①은 복잡성 접근의 논리이나 이 사례처럼 명료도 향상과 빠른 성공을 최우선할 때는 자극반응도가 없는 늦은 발달음을 첫 목표로 삼지 않는다. ②는 어중 /ㄹ/ 생략이 연구개음 전반의 대치보다 명료도 저하가 크다고 볼 근거가 없다. ⑤ 비구어 구강운동 훈련은 말소리 산출 개선의 근거가 부족하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"발달적 첫 목표음 선정\",\"p\":\"발달 시기·빈도·자극반응도로 명료도 우선 첫 목표음 선택\",\"n\":\"전통적 목표 선정: 연령상 습득 기대음·고빈도음·자극반응도 있는 음 우선\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 남아, 자음정확도 42%, 말명료도 매우 낮음. 음운변동 출현율\\n• 마찰음의 파열음화 90%\\n• 종성생략 78%\\n• 연구개음 전방화 65%\\n• 유음의 활음화 40%\\n• 어중초성 생략 15%\",\"q\":\"이 아동에게 주기법(cycles approach)을 적용할 때 목표 선정과 진행 원칙으로 옳은 것은?\",\"choices\":[\"최소대립쌍의 청각 변별만 반복 실시하고 산출 연습은 주기 후반으로 미룬다\",\"출현율이 가장 높은 파열음화를 90% 정확도에 도달할 때까지 훈련한 뒤 넘어간다\",\"어중초성 생략을 포함한 다섯 패턴 모두를 한 주기 안에 같은 시간으로 배분한다\",\"출현율 40% 이상인 패턴을 순환하되, 각 패턴은 숙달이 아닌 출현을 목표로 한다\",\"출현율이 가장 낮은 어중초성 생략부터 시작하여 점차 높은 패턴으로 이동한다\"],\"answer\":4,\"explain\":\"주기법은 명료도가 매우 낮은 아동을 대상으로 출현율 40% 이상의 음운패턴을 목표로 하며, 음절구조(종성)·초기 자음·연구개음·유음 등의 우선순위에 따라 패턴을 순환(cycle)한다. 정상 음운습득이 점진적으로 이루어지듯 각 패턴은 숙달이 아니라 출현을 목표로 하고, 다음 주기에서 다시 다룬다. ②는 숙달 기준 접근으로 주기법의 원리와 반대이며, ③ 15%인 어중초성 생략은 목표 기준 미달, ⑤는 우선순위와 반대이다. 주기법의 회기는 청각 자극(auditory bombardment)과 산출 연습을 모두 포함한다. ※출현율 절단 기준(40%)은 교재에 따라 표기가 다를 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"주기법 목표·진행 원칙\",\"p\":\"음운변동 출현율과 주기법 원리로 목표 패턴과 진행 방식 선택\",\"n\":\"주기법: 출현율 40% 이상 패턴 순환, 숙달이 아닌 출현 목표, 청각자극·산출 병행\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아의 자발화 표본에서 목표 자음 100개를 분석한 결과\\n• 정확 산출: 58개\\n• 대치: 24개\\n• 생략: 15개\\n• 왜곡: 3개\",\"q\":\"Shriberg와 Kwiatkowski의 원래 산출식에 따른 자음정확도(PCC)와 그에 따른 중증도로 옳은 것은?\",\"choices\":[\"58%, 경도-중등도\",\"58%, 경도\",\"58%, 중등도-심도\",\"42%, 심도\",\"61%, 중등도-심도\"],\"answer\":3,\"explain\":\"원래의 PCC는 대치·생략·왜곡을 모두 오류로 계산하므로 58/100 = 58%이다. Shriberg와 Kwiatkowski의 중증도 기준(85% 초과 경도, 65~85% 경도-중등도, 50~65% 중등도-심도, 50% 미만 심도)에 따르면 58%는 중등도-심도에 해당한다. ⑤ 61%는 왜곡을 정확으로 간주하는 수정 자음정확도(PCC-R)의 값이고, ④ 42%는 오류율이다. ※중증도 절단점은 교재별 표기가 다를 수 있어 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PCC 산출·중증도\",\"p\":\"대치·생략·왜곡을 모두 오류로 계산해 PCC와 중증도 산출\",\"n\":\"원래 PCC는 왜곡도 오류 처리, 50~65%는 중등도-심도, PCC-R은 왜곡을 정확 처리\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 8개월 남아\\n• 25개 낱말을 3회 반복 산출하는 비일관성 검사에서 15개 낱말(60%)이 매번 다른 형태로 산출됨\\n• 모색행동, 운율 이상, 모음 오류는 관찰되지 않음\\n• 구강 구조·기능 정상, 청력 정상\\n• 자극반응도 검사에서 대부분의 음소를 모방 산출할 수 있음\",\"q\":\"이 아동에게 가장 적절한 중재 접근은?\",\"choices\":[\"최소대립쌍 치료 – 음소 대조를 인식하도록 의미가 다른 낱말 쌍으로 훈련한다\",\"전통적 조음치료 – 음소별로 조음 위치를 지시하고 음절부터 반복 연습한다\",\"주기법 – 출현율이 높은 음운패턴을 순환하며 청각 자극과 산출을 훈련한다\",\"핵심어휘 접근 – 기능적 낱말을 최선 산출 형태로 일관되게 산출하도록 훈련한다\",\"DTTC(동적 시간·촉각 단서법) – 말운동 계획을 위해 집중 반복 연습을 한다\"],\"answer\":4,\"explain\":\"Dodd의 비일관성 검사에서 40% 이상의 낱말이 비일관적으로 산출되면 비일관적 음운장애로 분류되며, 이는 음운 계획(phonological planning)의 결함으로 본다. 여기에는 아동이 자주 쓰는 기능적 핵심어휘를 선정해 매 낱말의 최선 산출 형태를 일관되게 산출하도록 하는 핵심어휘 접근이 적합하다. 최소대립쌍·주기법은 일관된 오류패턴을 보이는 일관적 음운장애·음운지연에 적합하고, DTTC는 모색행동·운율 이상·모음 오류가 특징인 아동기 말실행증의 접근인데 이 아동은 해당 징후가 없고 자극반응도도 높다. ※비일관성 절단 기준(40%)은 교재 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"비일관적 음운장애 중재\",\"p\":\"비일관성 검사 결과와 CAS 징후 부재로 중재 접근 선택\",\"n\":\"비일관적 음운장애(음운 계획 결함)에는 기능 낱말 최선 형태를 일관되게 하는 핵심어휘 접근\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 4개월 남아\\n• 같은 낱말의 자음·모음 오류가 매번 달라짐, 모음 왜곡이 두드러짐\\n• 낱말·구가 길어질수록 오류가 급격히 증가함\\n• 산출 전 입술·혀를 움직이며 조음 위치를 더듬는 모색행동 관찰\\n• 음절 강세가 균등하여 단조롭고 운율이 부적절함\\n• 근력 저하·반사 이상 없음, 구강 구조 정상\\n• 자극반응도 낮고 모방 시에도 오류가 지속됨\",\"q\":\"이 아동의 진단과 그에 따른 중재 원리로 가장 적절한 조합은?\",\"choices\":[\"음운지연 – 주기법으로 발달적 음운패턴을 순환하며 훈련\",\"아동기 말실행증 – 운동학습 원리 기반 DTTC 등 말운동 접근\",\"마비말장애 – 구강 근력 강화 훈련을 우선하고 이후 조음 훈련\",\"조음장애 – 조음점 지시법으로 오류 음소를 하나씩 확립\",\"비일관적 음운장애 – 핵심어휘 접근으로 일관된 산출 유도\"],\"answer\":2,\"explain\":\"비일관적 오류, 모음 오류, 발화 길이에 따른 오류 증가, 모색행동, 부적절한 운율은 아동기 말실행증(CAS)의 핵심 징후이며 근력 이상이 없어 마비말장애와 구별된다. CAS는 말운동 계획·프로그래밍의 결함이므로 운동학습 원리를 적용한 DTTC(동적 시간·촉각 단서법) 등 집중적 산출 연습이 적합하다. 비일관적 음운장애도 비일관적이지만 모색행동·운율 이상·모음 오류가 없고 모방 시 산출이 가능하다는 점에서 구별된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동 말소리장애\",\"k\":\"아동기 말실행증 감별\",\"p\":\"모음 오류·모색행동·운율 이상 조합으로 진단과 중재 원리 판단\",\"n\":\"CAS: 비일관 오류·모음 오류·모색행동·운율 이상, 운동학습 원리 기반 DTTC 적용\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 6개월 여아, 인지·언어 정상. 오류음소와 자극반응도\\n• /ㅅ, ㅆ/ → [ㄷ, ㄸ] (자극반응도 없음)\\n• /ㄹ/ → 생략 또는 [ㅇ] (자극반응도 없음)\\n• /ㅈ, ㅊ/ → [ㄷ, ㅌ] (자극반응도 있음)\\n• /ㄱ/ → [ㄷ] (어두에서만, 자극반응도 있음)\",\"q\":\"복잡성 접근(complexity approach)의 원리에 따라 목표음을 선정할 때 가장 적절한 것은?\",\"choices\":[\"자극반응도가 있는 /ㄱ/부터 훈련하여 빠른 성공 경험을 제공한다\",\"가장 이른 시기에 발달하는 음소부터 먼저 훈련하여 성공 경험을 쌓는다\",\"모음 체계를 먼저 안정시키고 자음 목표는 그 이후에 다룬다\",\"오류 빈도가 가장 낮은 음소부터 훈련하여 오류 목록을 줄여 나간다\",\"늦게 발달하고 자극반응도가 없는 /ㅅ/ 또는 /ㄹ/을 먼저 훈련한다\"],\"answer\":5,\"explain\":\"Gierut 등의 복잡성 접근은 늦게 발달하고, 자극반응도가 없으며, 음운적으로 더 복잡한(유표적인) 음소를 먼저 목표로 하면 더 단순한 음소로 일반화가 일어나 체계 전반의 변화가 크다고 본다. 따라서 이 접근에서는 /ㅅ/, /ㄹ/이 우선 목표가 된다. ①②는 발달적(전통적) 목표 선정 원리로 복잡성 접근과 반대이며, ③④는 어느 접근에서도 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"복잡성 접근 목표음\",\"p\":\"복잡성 접근 원리에 따라 늦게 발달하고 자극반응도 없는 목표음 선택\",\"n\":\"복잡성 접근: 늦은 발달·자극반응도 없음·유표적 음소 우선, 단순 음소로 일반화 기대\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아의 어두 초성 오류\\n• /ㅅ/, /ㅆ/, /ㅈ/, /ㅊ/, /ㄱ/, /ㅋ/ → 모두 [ㄷ]로 대치\\n• 예: 살→[달], 잘→[달], 찰→[달], 갈→[달]\\n• 음소 대치로 인해 낱말 간 의미 구별이 되지 않아 동음이의 형태가 다수 발생\",\"q\":\"이 아동에게 가장 적절한 치료 접근과 자극 세트는?\",\"choices\":[\"다중대립 접근 – 대치음 [ㄷ]과 여러 목표음을 한 세트로 대조\",\"최소대립쌍 접근 – 한 번에 한 쌍(달-살)만 대조하여 순차적으로 훈련\",\"짝자극 기법 – 핵심낱말 '달'과 훈련낱말을 번갈아 짝지어 산출\",\"전통적 조음치료 – /ㅅ/의 조음점을 지시하여 무의미음절부터 확립\",\"상위음운 접근 – 소리의 길고 짧음 개념만 반복하여 가르친다\"],\"answer\":1,\"explain\":\"여러 목표 음소가 하나의 음소로 붕괴(phoneme collapse)되어 동음이의어가 다수 발생한 경우, 대치음과 붕괴된 여러 목표음을 한 세트로 대조하는 다중대립(multiple oppositions) 접근이 음운체계의 재구조화에 효율적이다. 최소대립쌍은 한 번에 한 대조만 다루므로 광범위한 붕괴에는 비효율적이며, 짝자극·전통적 접근은 개별 음소의 운동 확립에 초점을 두어 음운체계 문제를 직접 다루지 못한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"다중대립 접근 선택\",\"p\":\"여러 음소가 한 음으로 붕괴된 양상으로 치료 접근과 자극 세트 선택\",\"n\":\"음소 붕괴·동음이의어 다수 시 대치음과 여러 목표음을 한 세트로 대조하는 다중대립 접근\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아, 구개열로 1세에 구개성형술을 받음\\n• 최근 비인두내시경: 구개인두 폐쇄 양호\\n• 나조미터 구강문장 비음치 정상 범위\\n• 그러나 /ㅂ, ㄷ, ㄱ, ㅍ, ㅌ, ㅋ/를 성문파열음 [ʔ]으로 대치하는 오류가 일관되게 지속됨\\n• 마찰음은 인두마찰음으로 산출\",\"q\":\"이 아동의 오류 성격과 가장 적절한 중재는?\",\"choices\":[\"학습된 보상조음으로 보고 속삭임·/h/ 단서로 조음치료한다\",\"빨기·불기 등 비구어 구강운동으로 구강 내 압력을 높인다\",\"발달적 음운변동이므로 자연 소실을 기다리며 6개월 경과를 본다\",\"구개인두폐쇄부전이 남아 있으므로 재수술을 먼저 의뢰한다\",\"과비성 감소를 위해 청각 피드백으로 비음치를 낮추는 훈련을 한다\"],\"answer\":1,\"explain\":\"폐쇄 기능이 정상인데도 성문파열음·인두마찰음이 지속되는 것은 폐쇄부전 시기에 학습된 보상조음이 습관화된 것이므로 조음치료로 교정한다. 성문 폐쇄를 배제하기 위해 속삭임이나 /h/를 앞에 붙여 성문을 열어 둔 채 구강 조음점에서 산출을 유도하는 것이 핵심이다. 구개인두 기능이 정상이므로 재수술이나 과비성 훈련은 근거가 없고, 비구어 구강운동은 보상조음 교정에 효과가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"구개열 보상조음 중재\",\"p\":\"폐쇄 기능 정상인데 지속되는 성문파열음으로 오류 성격과 중재 선택\",\"n\":\"학습된 보상조음은 조음치료 대상, 속삭임·/h/ 단서로 성문 폐쇄 없이 구강 조음 유도\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 남아, 2세에 구개성형술을 받음\\n• 대화 전반에 걸쳐 일관된 과다비성과 압력자음에서의 비강누출\\n• 나조미터: 구강문장 비음치 38%(정상 기준 약 15% 이하), 비음문장 62%\\n• 보상조음은 관찰되지 않고 조음 위치는 정확함\\n• 자극반응도 검사에서 단서를 주어도 과다비성이 감소하지 않음\",\"q\":\"이 아동에 대한 가장 적절한 판단과 조치는?\",\"choices\":[\"불기·빨기 훈련으로 구개인두 폐쇄 근력을 먼저 강화한 뒤 재평가한다\",\"청각 피드백을 통한 비음치 낮추기 훈련을 6개월간 집중 실시한 뒤 재평가한다\",\"조음 위치가 정확하므로 조음치료로 과다비성을 직접 교정한다\",\"기구 평가로 구개인두폐쇄부전을 확인하고 수술적·보철적 관리를 의뢰한다\",\"구강문장 비음치가 정상 범위에 있으므로 6개월 경과를 관찰한다\"],\"answer\":4,\"explain\":\"구강문장 비음치가 정상 기준을 크게 초과하고 비강누출이 일관되며 단서에도 변화가 없는 것은 구조적 구개인두폐쇄부전(VPI)의 소견이다. 이 경우 기구적 평가(비인두내시경·비디오투시)로 폐쇄 양상을 확인한 뒤 인두피판술·보철(구개거상장치 등) 등 물리적 관리를 우선 의뢰해야 하며, 말치료는 구조 교정 후 잔존 오류를 다룬다. 불기·빨기는 구개인두 폐쇄 향상에 근거가 없고, 조음 위치가 정확한 아동에게 조음치료로 과다비성을 교정할 수는 없다. ※나조미터 정상 기준치는 검사 문장·교재별로 다를 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"구개인두폐쇄부전 판단\",\"p\":\"높은 비음치·비강누출·단서 무반응으로 구조적 VPI 판단\",\"n\":\"구조적 VPI는 기구 평가 후 수술·보철 관리 우선, 말치료는 구조 교정 후 잔존 오류 대상\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"8세 경직형 뇌성마비 남아\\n• 호흡 지지가 약해 한 번의 호흡으로 2~3음절만 산출, 강도가 작음\\n• 자음이 전반적으로 약하고 부정확(왜곡)하며 경도의 과비성\\n• 말속도가 느리고 낱말 명료도 50%\\n• 오류가 특정 음소에 국한되지 않고 모든 음소에 걸쳐 나타남\",\"q\":\"이 아동의 말명료도 향상을 위한 중재로 가장 적절한 것은?\",\"choices\":[\"오류 음소를 하나씩 선정하여 전통적 조음치료로 정확도를 높인다\",\"최소대립쌍 치료로 음운 대조를 확립하여 명료도를 높인다\",\"호흡 지지, 구 단위 끊어 말하기, 말속도 조절 등 보상 전략을 쓴다\",\"주기법으로 여러 음운패턴을 순환하며 출현을 목표로 훈련한다\",\"혀·입술의 비구어 근력강화 운동만 매 회기 집중적으로 반복 실시한다\"],\"answer\":3,\"explain\":\"뇌성마비의 마비말장애는 호흡·발성·공명·조음 하위체계의 신경운동 결함이 전반적으로 나타나므로, 특정 음소의 조음 정확도보다 호흡 지지, 구 단위 끊어 말하기, 과잉조음, 말속도 조절 등 명료도 중심의 보상 전략이 우선되고 필요 시 AAC를 병행한다. 음소별 전통적 접근·최소대립쌍·주기법은 기능적 조음음운장애에 적합하며, 비구어 근력강화만으로는 말명료도 개선 근거가 부족하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동 말소리장애\",\"k\":\"뇌성마비 명료도 중재\",\"p\":\"전반적 하위체계 결함 양상으로 명료도 향상 보상 전략 선택\",\"n\":\"마비말장애 아동은 음소별 훈련보다 호흡 지지·구 단위 끊어 말하기·속도 조절 등 보상 전략\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 남아, 양측 고도 감각신경성 난청, 3세에 인공와우 이식(보청 상태 역치 30 dB HL)\\n• /ㅅ, ㅆ, ㅈ, ㅊ/ 생략·왜곡, 종성 생략\\n• 모음 길이 연장과 중성화, 단조로운 억양\\n• 파열음·비음은 비교적 정확\",\"q\":\"이 아동의 조음 특성과 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"구어 산출은 어려우므로 수어 중심 의사소통으로 전면 전환한다\",\"청각 단서는 배제하고 거울·촉각 등 시각·촉각 단서로 조음점을 지시한다\",\"비구어 구강운동으로 혀의 민첩성을 높인 뒤 말소리를 훈련한다\",\"마찰음은 정상 발달에서도 늦게 습득되므로 7세 이후로 목표를 보류한다\",\"보청 상태에서 청각 단서를 우선하고 시각·촉각 단서는 보조로 활용한다\"],\"answer\":5,\"explain\":\"청각장애 아동은 고주파수 에너지를 가진 마찰·파찰음, 청각적으로 약한 종성, 모음 연장·중성화, 억양 단조로움 등의 특성을 보인다. 인공와우로 보청된 상태에서는 청각 경로를 최대한 활용하는 것이 원칙이며, 시각·촉각 단서는 보조로 사용하고 청능훈련·초분절 요소 훈련을 통합한다. 청각 단서를 배제하거나 목표를 보류하는 것은 보청 효과를 활용하지 못하는 부적절한 계획이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"청각·청각장애\",\"k\":\"인공와우 아동 조음 중재\",\"p\":\"인공와우 보청 아동의 조음 특성으로 단서 활용 우선순위 선택\",\"n\":\"보청 상태 청각장애 아동은 청각 경로 최대 활용, 시각·촉각 단서는 보조로 사용\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"7세 여아\\n• 혀를 내밀면 혀끝이 하트 모양으로 패이고 치조에 닿지 않음\\n• /ㄹ/(탄설음)·/ㄷ, ㄴ/ 왜곡이 모든 문맥에서 일관됨, 자극반응도 없음\\n• 그 외 음소는 정상이고 음운변동은 관찰되지 않음\\n• 언어·청력·인지 정상\",\"q\":\"이 아동에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"음운체계의 문제이므로 최소대립쌍으로 음소 대조를 확립한다\",\"설소대 단축에 따른 조음 오류로, 평가 의뢰와 조음 훈련을 병행한다\",\"비일관적 음운장애로 보고 핵심어휘 접근을 우선 적용한다\",\"발달 과정에서 자연히 개선되므로 1년 후 재평가를 권고한다\",\"비구어 혀 스트레칭 운동만으로 설소대를 늘린 뒤 재평가한다\"],\"answer\":2,\"explain\":\"혀끝의 하트 모양 함몰과 치조 접촉 불가는 설소대 단축증의 소견이며, 혀끝 접촉이 필요한 /ㄹ, ㄷ, ㄴ/에 국한된 일관된 왜곡은 구조적 원인의 음성적(조음) 오류이다. 음운변동이 없으므로 음운적 접근은 부적절하고, 의학적 평가 의뢰와 함께 현재 구조에서 가능한 보상 조음 위치를 확립하는 조음치료를 계획한다. 7세에 이미 습득되어야 할 음소이므로 자연 개선을 기다리는 것도 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"설소대 단축 조음 오류\",\"p\":\"하트 모양 혀끝과 혀끝 음소 국한 왜곡으로 구조적 원인 판단\",\"n\":\"설소대 단축: 혀끝 접촉음(/ㄹ,ㄷ,ㄴ/) 일관된 왜곡, 의학적 평가 의뢰와 조음치료 병행\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 6개월 여아\\n• 연구개음 전방화(ㄱ→ㄷ)와 마찰음의 파열음화(ㅅ→ㄷ)가 일관되게 나타남\\n• 최소대립쌍 낱말('공-동')을 들려주면 그림 변별은 가능하나 자신의 산출이 다르다는 것을 인식하지 못함\\n• 소리의 속성(앞소리·뒷소리, 긴 소리·짧은 소리)을 이야기하는 활동에 흥미를 보임\",\"q\":\"이 아동에게 상위음운 접근(Metaphon)을 적용할 때의 절차로 옳은 것은?\",\"choices\":[\"1단계에서 목표음의 조음 위치를 설압자로 직접 지시하고 2단계에서 문장으로 확장한다\",\"1단계부터 최소대립쌍 낱말의 산출을 90% 정확도에 이를 때까지 반복 훈련한다\",\"1단계에서 소리 속성 개념을 익히고, 2단계에서 최소대립쌍을 의사소통에 쓴다\",\"1단계에서 핵심낱말과 훈련낱말을 번갈아 산출하며 자질 개념을 학습한다\",\"1단계에서 구강운동으로 혀 뒤쪽 근력을 기르고 2단계에서 연구개음을 확립한다\"],\"answer\":3,\"explain\":\"상위음운 접근은 음운장애 아동이 소리의 대조 속성을 인식하지 못한다는 전제에서 1단계(개념 수준→소리 수준→음소 수준→낱말 수준)에서 '앞소리/뒷소리', '긴 소리/짧은 소리' 등의 활동으로 상위음운 인식을 기르고, 2단계에서 최소대립쌍을 실제 의사소통 상황에서 사용하며 청자의 피드백으로 메시지 수정을 유도한다. 조음점 직접 지시(①)와 핵심낱말-훈련낱말(④, 짝자극)은 운동 중심 접근이며, ②는 1단계의 목적과 맞지 않고, ⑤ 구강운동 훈련은 상위음운 접근의 절차가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"상위음운 접근 절차\",\"p\":\"소리 속성 인식 부족 특성으로 Metaphon 단계별 절차 선택\",\"n\":\"Metaphon: 1단계 소리 속성 개념·상위음운 인식, 2단계 최소대립쌍의 의사소통적 사용\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 남아, 어두·어중 /ㅅ/를 목표로 8개월간 치료 중\\n• 낱말 수준 정확도 92%, 구조화된 문장 수준 85%\\n• 그러나 놀이 상황의 자발적 대화에서는 정확도 40%\\n• 가정에서도 대화 중 오류가 대부분이라는 부모 보고\\n• 아동은 자신의 오류를 스스로 알아채지 못함\",\"q\":\"이 단계에서 가장 적절한 중재 방향은?\",\"choices\":[\"무의미음절 수준으로 돌아가 /ㅅ/의 조음 운동을 다시 확립한다\",\"구강운동 훈련을 추가하여 혀끝의 안정성과 근력을 높인다\",\"낱말 수준에서 목표 정확도에 도달했으므로 치료를 종결한다\",\"/ㅅ/는 보류하고 발달상 더 이른 새 음소로 목표를 변경한다\",\"자기 모니터링 훈련과 함께 훈련 장면을 가정·학교로 확대한다\"],\"answer\":5,\"explain\":\"구조화된 상황에서는 정확하나 자발적 대화·가정으로 전이되지 않은 것은 상황·문맥 일반화(전이) 단계의 문제이다. 이 단계의 핵심은 자기 모니터링 능력을 길러 오류를 스스로 탐지·수정하게 하고, 훈련 장면을 다양한 상대·장소·활동으로 확대하며 부모·교사를 통해 일상에서 단서·강화를 제공하는 것이다. 이미 확립된 운동을 다시 훈련하거나 종결·목표 변경을 하는 것은 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"조음치료 전이 단계 중재\",\"p\":\"구조화 상황 정확·대화 전이 실패로 다음 중재 방향 선택\",\"n\":\"전이 단계 핵심: 자기 모니터링 훈련과 훈련 장면·상대의 가정·학교 확대\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아, 연구개음 전방화(ㄱ→ㄷ). 문맥검사 결과\\n• '구', '고' 문맥에서 간헐적으로 정조음\\n• '기', '게' 문맥에서는 항상 [ㄷ]로 대치\\n• 어두보다 모음 사이(어중) 위치에서 정조음 비율이 높음\",\"q\":\"확립 단계의 시작 문맥과 그 근거로 가장 적절한 것은?\",\"choices\":[\"오류가 가장 심한 '기' 문맥부터 시작하여 어려운 것을 먼저 극복한다\",\"'아구', '오고'처럼 후설모음이 결합된 어중 문맥에서 시작한다\",\"문맥 구분 없이 모든 모음 문맥을 무작위로 제시하여 일반화를 유도한다\",\"무의미음절 단계 없이 문장 수준에서 바로 시작하여 전이를 앞당긴다\",\"어두 '가'부터 시작한다 – 첫소리가 지각적으로 가장 두드러지기 때문이다\"],\"answer\":2,\"explain\":\"문맥검사의 목적은 촉진 문맥을 찾아 치료의 출발점으로 삼는 것이다. 후설모음 /ㅜ, ㅗ/는 혀 뒤쪽이 연구개 방향으로 올라가 있어 동시조음(coarticulation)에 의해 연구개 파열음 산출이 촉진되고, 전설모음 /ㅣ, ㅔ/는 혀가 앞으로 이동해 전방화를 오히려 유도한다. 또한 이 아동은 어중 위치에서 성공률이 높으므로 '아구, 오고'와 같은 후설모음·어중 문맥에서 시작해 점차 전설모음·어두 위치로 확장한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"촉진 문맥 선정\",\"p\":\"문맥검사 결과로 연구개음 확립의 시작 문맥 선택\",\"n\":\"후설모음은 동시조음으로 연구개음 산출 촉진, 성공률 높은 어중 문맥에서 시작\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아, 어두 /ㅈ/→[ㄷ] 대치. 낱말 조사 결과 '자'가 포함된 '모자'는 10회 중 10회 정조음하지만 '자동차', '잠', '주스' 등 대부분의 낱말에서는 오조음한다.\",\"q\":\"이 아동에게 짝자극 기법을 적용할 때 낱말 선정 기준과 절차로 옳은 것은?\",\"choices\":[\"핵심낱말 '모자'와 오조음하는 훈련낱말 10개를 번갈아 짝지어 산출한다\",\"핵심낱말은 아동이 가장 자주 오조음하는 낱말로 선정하여 집중 훈련한다\",\"훈련낱말은 10회 중 9회 이상 정조음하는 낱말로 선정해야 한다\",\"핵심낱말과 훈련낱말은 한 음소 차이로 의미가 달라지는 최소대립쌍이어야 한다\",\"핵심낱말과 훈련낱말은 서로 다른 목표음을 포함해야 일반화가 촉진된다\"],\"answer\":1,\"explain\":\"짝자극 기법은 아동이 이미 정조음하는 핵심낱말(목표음 10회 중 9회 이상 정확)을 이용하여, 같은 위치에 목표음이 있으나 오조음하는 훈련낱말(3회 중 2회 이상 오류)로 정확한 산출을 전이시키는 방법이다. 핵심낱말 하나에 훈련낱말 10개를 짝지어 번갈아 산출하고, 낱말→문장→대화로 확장한다. 핵심낱말과 훈련낱말은 같은 목표음을 같은 위치에 가져야 하며, 최소대립쌍과 같은 의미 대조는 요구되지 않는다. ※핵심낱말·훈련낱말 선정 기준 수치는 교재 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"짝자극 기법 절차\",\"p\":\"정조음 핵심낱말과 오조음 훈련낱말 조건으로 짝자극 절차 선택\",\"n\":\"짝자극: 정조음 핵심낱말 1개와 같은 목표음 위치의 오조음 훈련낱말 10개를 번갈아 산출\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아, /ㅅ/→[ㄷ], /ㅆ/→[ㄸ]의 파열음화가 일관됨. 조음 위치(치경)와 발성유형(평음·경음)은 정확하게 유지됨. 변별자질 접근으로 치료하려 한다.\",\"q\":\"이 아동이 확립하지 못한 자질만을 대조하는 최소대립쌍으로 가장 적절한 것은?\",\"choices\":[\"달 – 갈\",\"달 – 탈\",\"달 – 날\",\"달 – 살\",\"달 – 딸\"],\"answer\":4,\"explain\":\"파열음화는 [+지속성]인 마찰음이 [−지속성]인 파열음으로 대치되는 것으로, 결함 자질은 지속성이다. '달-살'은 /ㄷ/와 /ㅅ/가 조음 위치(치경)·발성유형(평음)이 같고 지속성만 다른 쌍이므로 목표 자질을 정확히 대조한다. '달-갈'은 조음 위치, '달-탈'은 기식성, '달-날'은 비음성, '달-딸'은 긴장성 대조로 이 아동이 이미 확립한 자질이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"변별자질 최소대립쌍 선정\",\"p\":\"파열음화의 결함 자질을 찾아 그 자질만 대조하는 낱말쌍 선택\",\"n\":\"마찰음의 파열음화 결함 자질은 지속성, 위치·발성유형이 같은 /ㄷ/-/ㅅ/ 쌍이 목표 대조\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"10세 남아\\n• /ㅅ, ㅆ, ㅈ, ㅊ/ 산출 시 혀 옆으로 공기가 새는 측음화 왜곡이 모든 문맥·과제에서 일관됨\\n• 다른 음소는 정상, 음운변동 없음, 음운인식·읽기 정상\\n• 청각 변별 과제에서 정조음과 왜곡음을 잘 구별함\\n• 구강 구조 정상, 자극반응도 낮음\",\"q\":\"이 아동에게 가장 적절한 접근과 절차는?\",\"choices\":[\"전통적 조음치료 – 촉각 단서로 조음 운동을 확립한 뒤 전이한다\",\"주기법 – 마찰음·파찰음 패턴을 다른 음운패턴과 순환하며 훈련한다\",\"핵심어휘 접근 – 기능적 낱말에서 최선 형태의 일관된 산출을 유도한다\",\"최소대립쌍 치료 – 의미 대조를 통해 음운체계를 재구조화한다\",\"상위음운 접근 – 소리 속성 개념을 먼저 가르쳐 음소 대조를 인식시킨다\"],\"answer\":1,\"explain\":\"음운변동이 없고 하나의 소리군에서 일관된 왜곡만 보이며 청각 변별은 정상인 경우 음운적 문제가 아니라 운동적(음성적) 조음장애이다. 왜곡은 음소 대조 자체는 유지되므로 최소대립쌍·상위음운·주기법 등 음운적 접근의 대상이 아니며, 조음점 지시와 촉각 단서로 올바른 조음 운동을 확립하고 위계적으로 안정·전이·유지 단계를 밟는 전통적 접근이 적합하다. 핵심어휘는 비일관적 산출에 적용된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"측음화 왜곡 치료 접근\",\"p\":\"음운변동 없는 일관된 왜곡과 정상 변별로 운동적 접근 선택\",\"n\":\"음소 대조가 유지되는 왜곡은 음성적 오류, 조음점 지시·촉각 단서의 전통적 접근 적합\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 여아, 어머니가 베트남어 화자이고 가정에서 두 언어를 사용함. 한국어 조음 평가 결과\\n• 경음 /ㄲ, ㄸ, ㅃ/ → 평음으로 대치, /ㅡ/ → [ㅜ]로 대치\\n• 종성 /ㄹ/ → [ㄴ]\\n• 베트남어 화자인 어머니와 통역사의 평가: 베트남어 말소리 산출은 또래 수준으로 정확\\n• 오류가 나타나는 소리는 모두 베트남어 음운체계에 없거나 다르게 실현되는 소리임\",\"q\":\"이 결과에 대한 가장 적절한 판단은?\",\"choices\":[\"두 언어 모두에서 치료가 필요한 조음음운장애로 판단한다\",\"모국어 음운체계의 영향으로 나타난 언어 차이로 판단한다\",\"비일관적 음운장애이므로 한국어 핵심어휘 접근을 적용한다\",\"한국어 조음 오류가 있으므로 베트남어 사용을 중단시켜야 한다\",\"아동기 말실행증이 의심되므로 말운동 평가를 추가 실시한다\"],\"answer\":2,\"explain\":\"이중언어 아동에서 장애(disorder)는 두 언어 모두에서 오류가 나타나고 모국어 음운체계로 설명되지 않는 경우에 판단한다. 이 아동은 모국어 산출이 정상이고 오류가 모두 모국어에 없는 소리(경음·/ㅡ/·종성 /ㄹ/)에 국한되므로 언어 차이로 보는 것이 타당하다. 차이를 장애로 진단하는 것은 과잉 진단이며, 모국어 사용 중단 권고는 근거가 없고 언어 발달에도 해롭다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"이중언어 아동 차이 판별\",\"p\":\"모국어 산출 정상과 모국어에 없는 소리 국한 오류로 차이 여부 판단\",\"n\":\"이중언어 아동 장애는 두 언어 모두 오류이고 모국어 음운체계로 설명 안 될 때 판단\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아의 말명료도 평가\\n• 어머니의 5점 척도 평정: 4점(대부분 알아들을 수 있음)\\n• 아동을 처음 본 청자 3명이 녹음된 낱말 50개를 받아쓴 낱말확인 과제: 평균 55% 정확\\n• 문장 수준에서 낯선 청자의 이해율은 낱말보다 다소 높음\",\"q\":\"이 결과의 해석과 임상적 활용으로 가장 적절한 것은?\",\"choices\":[\"명료도는 자음정확도와 동일하므로 별도로 측정할 필요가 없다\",\"어머니의 평정이 가장 신뢰할 만하므로 명료도는 양호하다고 결론짓는다\",\"두 결과를 평균한 약 70%를 아동의 대표 명료도 수치로 보고한다\",\"낱말확인 과제는 문맥이 없어 타당하지 않으므로 척도 평정만 사용한다\",\"낯선 청자의 낱말확인 결과를 명료도 기준 지표로 삼아 활용한다\"],\"answer\":5,\"explain\":\"말명료도는 청자 요인(친숙도), 자료 요인(낱말·문장, 문맥 유무), 측정 방법(척도 평정·낱말확인)에 따라 달라진다. 익숙한 청자와 척도 평정은 명료도를 과대평가하는 경향이 있어, 낯선 청자가 실제로 무엇을 알아들었는지를 객관적으로 보여 주는 낱말확인 과제가 기준 지표로 적합하다. 두 값을 평균하는 것은 방법이 다른 결과를 혼합하는 오류이며, 명료도는 자음정확도와 관련은 있으나 동일한 지표가 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"말명료도 측정 해석\",\"p\":\"청자 친숙도·측정 방법 차이로 명료도 기준 지표 선택\",\"n\":\"낯선 청자 낱말확인 과제가 객관적 명료도 기준, 친숙 청자·척도 평정은 과대평가 경향\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 3개월 남아, /ㄱ/ 전방화와 /ㅅ/ 파열음화를 보여 /ㄱ/을 목표로 12주 치료함. 치료 후 /ㄱ/ 정확도가 20%→85%로 향상되었고, 훈련하지 않은 /ㅅ/도 10%→30%로 향상되었다. 부모는 '아이가 크면서 저절로 좋아진 것 아니냐'고 묻는다.\",\"q\":\"치료 효과를 성숙 효과와 구분하여 입증하기 위한 자료 수집 방법으로 가장 적절한 것은?\",\"choices\":[\"치료 회기 내 목표음 /ㄱ/ 정확도만 매 회기 기록하여 비교한다\",\"안정된 기초선과 함께 훈련·통제 음소를 탐침으로 반복 측정한다\",\"치료 종료 후 표준화 조음검사만 한 번 실시하여 규준과 비교한다\",\"치료 전 기초선을 1회만 측정하고 사후 정확도와 비교한다\",\"부모의 만족도 설문과 가정 내 관찰 보고로 효과를 판단한다\"],\"answer\":2,\"explain\":\"단일대상 연구의 논리에 따라 안정된 다중 기초선과 훈련하지 않은 통제 행동(음소)의 탐침 자료를 병행 측정하면, 훈련 음소의 급격한 향상과 통제 음소의 완만한 변화를 비교해 성숙·자연 회복과 치료 효과를 구분할 수 있다. 회기 내 자료나 사후 검사 1회, 부모 설문만으로는 인과를 추정할 수 없다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"치료 효과 입증 자료\",\"p\":\"성숙 효과와 치료 효과를 구분할 수 있는 자료 수집 방법 선택\",\"n\":\"안정된 기초선과 훈련·통제 음소 탐침 반복 측정으로 치료 효과와 성숙 효과 구분\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 9개월 남아\\n• 초성은 대부분 정확하나 모든 종성을 일관되게 생략함(곰→[고], 손→[소], 발→[바])\\n• 종성이 생략되어 '손'과 '소', '곰'과 '고'가 동음이의어로 산출됨\\n• 종성을 모방하라고 하면 종성 자리에서 입을 벌린 채 소리를 끝냄\",\"q\":\"이 아동에게 가장 적절한 중재 계획은?\",\"choices\":[\"어두 초성 대조쌍(공-동)으로 조음 위치 대조를 먼저 훈련한다\",\"종성은 늦게 발달하므로 5세 이후로 종성 목표를 보류한다\",\"비구어 구강운동으로 턱 닫기 근력을 먼저 강화한 뒤 종성을 훈련한다\",\"종성 유무 최소대립쌍과 '곰이' 같은 재음절화 문맥을 활용한다\",\"종성 없는 낱말만 사용하여 초성 정확도를 먼저 더 높여 간다\"],\"answer\":4,\"explain\":\"종성생략은 음절구조 변동으로 낱말 형태 자체를 바꾸어 명료도에 큰 영향을 주므로 우선 목표가 된다. 종성 유무 최소대립쌍은 종성이 의미를 구별한다는 것을 인식시키며, 한국어 종성은 불파음으로 청각적으로 두드러지지 않으므로 시각·촉각 단서를 보강하고 '곰이'처럼 다음 음절 초성으로 연음되어 파열이 드러나는 문맥에서 시작해 어말 위치로 확장한다. 4세 9개월에 종성 전면 생략은 발달적으로 지연된 것이므로 보류는 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"종성생략 중재 계획\",\"p\":\"전면적 종성생략과 동음이의어 발생으로 종성 목표 중재 선택\",\"n\":\"종성생략은 명료도 영향 큰 우선 목표, 종성 유무 최소대립쌍과 연음 재음절화 문맥 활용\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 3개월 여아\\n• 낱말 수준 표준화 조음음운검사: 자음정확도 88%, 백분위 20(정상 범위)\\n• 부모·교사 보고: 대화에서 알아듣기 어려운 경우가 많음\\n• 대화 자발화 분석: 자음정확도 64%, 종성생략·어중초성 생략이 다수, 말속도 빠르고 발화 길이가 길어질수록 오류 증가\",\"q\":\"이 결과에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"표준화 검사가 정상 범위이므로 치료 대상이 아니라고 판정하고 종결한다\",\"부모·교사의 보고는 주관적이므로 판정 근거에서 제외한다\",\"자발화·명료도 자료로 치료 대상으로 판정하고 연결발화 목표를 세운다\",\"낱말 검사를 다른 표준화 도구로 다시 실시하여 정상 범위 여부를 재확인한다\",\"오류가 발화 길이에 따라 늘므로 음운인식 결함으로 보고 읽기 중재를 한다\"],\"answer\":3,\"explain\":\"표준화 낱말 검사는 단일 낱말의 정확도를 측정하므로 연결발화에서 나타나는 오류(동시조음, 빠른 속도, 발화 길이에 따른 붕괴)를 놓칠 수 있다. 임상 결정은 표준화 점수 하나가 아니라 자발화 분석, 명료도, 보호자·교사 보고 등 다각적 자료를 통합하여 내려야 하며, 이 아동은 연결발화 수준의 중재가 필요하다. 발화 길이에 따른 오류 증가는 음운인식이 아니라 말 산출 부담과 관련된다. ※정상 범위 절단점(백분위·표준편차 기준)은 검사 도구·교재별 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"평가·분석 지표\",\"k\":\"표준화·자발화 결과 통합\",\"p\":\"낱말검사 정상과 대화 PCC 저하 불일치로 치료 대상 여부 판단\",\"n\":\"낱말 검사는 연결발화 오류를 놓칠 수 있어 자발화·명료도·보고를 통합해 판정\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 낱말 '사탕' /s a tʰ a ŋ/ 을 아동이 [타당]으로 산출하였다.\\n• PMLU 산출: 목표·아동 산출의 각 분절음(자음·모음)마다 1점, 정확히 산출한 자음마다 1점 추가\\n• PWP(단어단위근접률) = 아동 산출 PMLU ÷ 목표 PMLU\",\"q\":\"이 낱말에 대한 아동의 단어단위근접률(PWP)은?\",\"choices\":[\"0.75\",\"0.625\",\"0.80\",\"0.875\",\"1.0\"],\"answer\":1,\"explain\":\"목표 '사탕'의 PMLU = 분절음 5개(ㅅ, ㅏ, ㅌ, ㅏ, ㅇ) 5점 + 자음 3개 정확 3점 = 8. 아동의 [타당]은 분절음 5개로 5점이며, 자음 중 /ㅅ/→[ㅌ], /ㅌ/→[ㄷ]은 오류이고 종성 /ㅇ/만 정확하므로 1점을 더해 PMLU = 6. 따라서 PWP = 6 ÷ 8 = 0.75이다. ※PMLU 채점 규칙(모음 오류 처리 등)은 교재별 차이가 있어 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PWP(단어단위근접률) 산출\",\"p\":\"목표·산출 PMLU를 채점 규칙대로 계산해 PWP 산출\",\"n\":\"PWP는 아동 PMLU÷목표 PMLU, PMLU는 분절음 수에 정확 자음 수를 더한 값\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"파라다이스-유창성검사-II(P-FA-II) '말하기그림' 과제 분석\\n• 총 발화 음절 수: 300음절\\n• 정상적 비유창성(ND): 9회\\n• 비정상적 비유창성(AD): 12회\\n(ND 점수 = ND 횟수 ÷ 음절 수 × 100, AD 점수 = AD 횟수 ÷ 음절 수 × 100 × 1.5)\",\"q\":\"이 과제의 비유창성 총점(ND 점수 + AD 점수)은?\",\"choices\":[\"7\",\"10.5\",\"9\",\"12\",\"15\"],\"answer\":3,\"explain\":\"ND 점수 = 9 ÷ 300 × 100 = 3, AD 점수 = 12 ÷ 300 × 100 × 1.5 = 4 × 1.5 = 6이므로 총점은 3 + 6 = 9이다. 10.5는 ND에도 1.5 가중치를 잘못 적용한 값, 7은 AD에 가중치를 적용하지 않은 값이다. ※P-FA-II 점수 산출식·가중치는 검사 요강 기준으로 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"P-FA-II 비유창성 점수 산출\",\"p\":\"ND·AD 횟수와 음절 수에 가중치 적용해 비유창성 총점 산출\",\"n\":\"P-FA-II 총점: ND 점수+AD 점수, 1.5 가중치는 AD에만 적용\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 3세 6개월 남아, 어머니가 '말이 자꾸 걸린다'며 의뢰\\n• 놀이 상황 대화 표본(400음절) 분석\\n  - 100음절당 진성 비유창성(SLD): 5.2회\\n  - 전체 비유창성 중 SLD 비율: 72%\\n  - 반복 시 반복 단위 수 평균 2.3회\\n  - 음절 반복 시 긴장과 눈 감기 동반\",\"q\":\"위 결과의 해석과 그에 따른 임상적 결정으로 가장 적절한 것은?\",\"choices\":[\"말더듬으로 판정하고, 지속 위험요인을 평가해 치료 착수 여부를 결정한다\",\"SLD 5.2회는 학령전기 정상 범위이므로 6개월 후 재평가만 권고한다\",\"간투사와 구 반복이 적으므로 정상적 비유창성으로 보고 상담 후 종결한다\",\"반복 단위 수 평균이 3회 미만이므로 말더듬으로 볼 수 없어 관찰만 한다\",\"성인 %SS 기준 3%를 넘으므로 즉시 연장된 말 훈련을 시작한다\"],\"answer\":1,\"explain\":\"학령전기 말더듬 판별에서는 100음절당 SLD 3회 이상, 전체 비유창성 중 SLD 비율이 높음(약 2/3 이상), 반복 단위 수 증가, 긴장·부수행동 동반이 말더듬을 시사한다. 이 아동은 모든 지표가 기준을 넘으므로 말더듬으로 판정하되, 발병 경과·가족력·SLD 추이 등 지속 위험요인을 평가해 직접 치료 여부를 결정한다. 정상 범위(②), 반복 단위 3회 미만이면 정상(④)이라는 해석은 틀렸고, 연장된 말 훈련(⑤)은 3세 아동의 1차 선택이 아니다. ※SLD 절단점·비율 기준은 교재(Yairi & Ambrose 등)별로 차이 가능.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"학령전 말더듬 판별\",\"p\":\"SLD 빈도·비율·반복 단위 수·긴장 동반으로 말더듬 여부 판단\",\"n\":\"학령전 말더듬 지표: SLD 3회 이상/100음절, 높은 SLD 비율, 긴장 동반\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 2세 11개월 여아, 말더듬 시작 4개월 경과\\n• 외삼촌이 어린 시절 말을 더듬었으나 자연회복됨\\n• 3개월 간 SLD가 100음절당 8회 → 4회로 감소 추세\\n• 음운·언어발달 정상, 아동은 자신의 말을 의식하지 않음\\n• 부모는 아이가 더듬을 때 불안해하며 \\\"천천히\\\"라고 자주 지시함\",\"q\":\"이 아동에게 현재 가장 적절한 임상적 결정은?\",\"choices\":[\"리드콤 프로그램을 즉시 시작해 부모 수반자극을 훈련한다\",\"말더듬수정법으로 말더듬 순간 확인 훈련을 시작한다\",\"부모 상담과 간접 중재를 시행하며 정기적으로 재평가한다\",\"자연회복 가능성이 높으므로 추후 관리 없이 종결한다\",\"성인용 유창성완성 프로그램을 축약해 아동에게 적용한다\"],\"answer\":3,\"explain\":\"여아, 발병 후 12개월 미만, 자연회복 가족력, SLD 감소 추세, 언어발달 정상, 인식 없음은 모두 자연회복을 예측하는 요인이다. 따라서 직접 치료보다 부모의 부정적 반응(지시·불안)을 줄이는 상담과 간접 중재(상호작용·말속도 조정)를 제공하며 정기 재평가로 추이를 모니터링하는 것이 적절하다. 다만 추후 관리 없이 종결(④)하면 지속 여부를 확인할 수 없어 부적절하고, 리드콤(①)은 위험요인이 뚜렷하거나 관찰 후 호전이 없을 때 고려한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"자연회복 예측과 치료 결정\",\"p\":\"자연회복 예측 요인 조합으로 간접 중재와 재평가 선택\",\"n\":\"자연회복 예측: 여아·발병 12개월 미만·가족 회복력·SLD 감소·인식 없음\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 9세 남아, 5세경 말더듬 시작\\n• 긴장된 막힘과 연장, 막힘 중 발 구르기\\n• 발표·전화 상황을 피하고 어려운 낱말을 다른 낱말로 바꿈\\n• \\\"애들이 놀릴까 봐 말 안 해요\\\"라고 보고함\\n• 의사소통태도 검사에서 부정적 태도 뚜렷\",\"q\":\"이 아동의 말더듬 발달 수준과 그에 맞는 중재 접근으로 가장 적절한 것은?\",\"choices\":[\"경계선 말더듬 – 부모 상호작용 조정 중심의 간접 중재\",\"초기 말더듬 – 부모의 언어적 수반자극 중심 리드콤 프로그램\",\"진전된 말더듬 – 지연청각피드백 기기를 단독으로 사용하는 중재\",\"중간 말더듬 – 유창성 촉진과 말더듬 수정의 통합적 접근\",\"정상적 비유창성 – 추가 중재 없이 부모 교육 후 관찰\"],\"answer\":4,\"explain\":\"학령기에 긴장된 막힘, 탈출행동, 낱말·상황 회피, 두려움과 부정적 태도가 나타나는 것은 Guitar의 발달 수준 중 '중간 말더듬'에 해당한다. 이 단계에서는 유창한 말을 만드는 기법(느린 말·부드러운 시작)과 말더듬 순간을 편하게 수정하는 기법에 회피와 부정적 감정·태도를 줄이는 요소를 결합한 통합적 접근이 권장된다. 리드콤(②)은 학령전기가 주 대상이며, 기기 단독(③)으로는 회피·태도를 다룰 수 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"발달 단계·감별\",\"k\":\"중간 말더듬 단계와 중재\",\"p\":\"막힘·탈출행동·회피·부정적 태도로 발달 수준과 중재 접근 판단\",\"n\":\"중간 말더듬: 막힘·탈출·회피·두려움, 유창성 형성과 말더듬 수정 통합\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 5세 남아, 리드콤 프로그램 1단계 진행 중\\n• 최근 3주 연속 클리닉 내 %SS 0.6, 0.4, 0.5\\n• 부모의 일일 말더듬 심한 정도(SR) 평정: 매일 1~2점 유지\",\"q\":\"이 시점에서 치료사가 취할 조치로 가장 적절한 것은?\",\"choices\":[\"1단계를 6개월 더 유지하며 수반자극 빈도를 늘린다\",\"말더듬수정법으로 전환하여 취소 기법을 지도한다\",\"치료를 즉시 종결하고 추후 방문을 모두 없앤다\",\"언어적 수반자극과 부모 SR 기록을 모두 중단한다\",\"2단계(유지)로 진입하여 방문 간격을 점차 늘린다\"],\"answer\":5,\"explain\":\"리드콤 프로그램에서 3주 연속 클리닉 %SS 1.0 미만과 부모 SR 1~2 유지는 1단계 목표 달성 기준으로, 이때 2단계(유지 단계)로 진입해 방문 간격을 점차 늘리고(예: 2주→4주→8주…) 부모의 언어적 수반자극을 단계적으로 줄이며 재발 여부를 감시한다. 즉시 종결(③)이나 수반자극·기록의 일괄 중단(④)은 재발 감시 원리에 어긋난다. ※2단계 진입 기준 수치(%SS·SR 척도 범위)는 프로그램 지침 판본에 따라 차이 가능.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"리드콤 2단계 진입 기준\",\"p\":\"3주 연속 클리닉 %SS와 부모 SR 평정으로 단계 진행 판단\",\"n\":\"리드콤 2단계 진입: 3주 연속 %SS 1.0 미만·SR 1~2, 방문 간격 점진 확대\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"리드콤 프로그램 3주차 가정 실습 관찰\\n• 어머니가 아동이 더듬을 때마다 빠짐없이 \\\"울퉁불퉁했어, 다시\\\"라고 요구함\\n• 유창한 발화에 대한 칭찬은 거의 없음\\n• 아동이 말하기를 꺼리고 짜증을 내기 시작함\",\"q\":\"치료사가 어머니에게 제공할 지도로 가장 적절한 것은?\",\"choices\":[\"유창한 발화에 대한 칭찬의 비율을 수정 요구보다 훨씬 높게 한다\",\"말더듬에 대한 수정 요구를 더 강하게 하여 빠르게 효과를 얻도록 한다\",\"수반자극을 모두 중단하고 부모 말속도만 늦추게 한다\",\"아동이 짜증을 낼 때는 타임아웃을 적용해 지도한다\",\"수정 요구 대신 아동에게 말더듬 순간을 스스로 분석하게 한다\"],\"answer\":1,\"explain\":\"리드콤 프로그램의 언어적 수반자극은 유창한 발화에 대한 긍정적 반응이 중심이며, 말더듬에 대한 수정 요구는 간헐적으로만 제공하고 아동이 불편해하면 즉시 줄이거나 중단해야 한다(일반적으로 칭찬 대 수정요구 비율을 5:1 이상으로 권장). 수정 요구가 과도하면 아동이 말하기를 회피하는 부작용이 생긴다. 수반자극 전면 중단(③)은 프로그램 원리를 버리는 것이고, 자기분석(⑤)은 학령전기 아동에게 부적합하다. ※권장 비율 수치는 지침별 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"리드콤 수반자극 지도\",\"p\":\"수정 요구 과다와 아동 회피 반응으로 부모 지도 내용 선택\",\"n\":\"리드콤 수반자극: 유창 발화 칭찬 중심, 수정 요구는 간헐적으로만 제공\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 3세 9개월 여아, 말더듬 시작 8개월\\n• 가정 놀이 영상: 부모의 말속도가 매우 빠르고 질문이 연이어 이어지며, 아동이 말을 마치기 전에 부모가 끼어듦\\n• 부모 모두 아동의 말더듬에 대해 높은 불안과 죄책감을 보고함\\n• 치료사는 페일린 부모-아동 상호작용치료(Palin PCI)를 계획함\",\"q\":\"이 프로그램의 핵심 절차로 옳은 것은?\",\"choices\":[\"부모의 개입을 배제하고 치료사가 단독으로 아동을 주 2회 직접 치료한다\",\"부모가 유창한 발화마다 칭찬하고 말더듬에 수정을 요구하며 SR을 기록한다\",\"아동에게 연장된 말을 시범 보여 클리닉에서 유창한 말 패턴을 확립한다\",\"아동이 자신의 말더듬 순간을 확인하고 취소 기법으로 수정하게 한다\",\"부모가 놀이 영상을 보며 상호작용 전략을 스스로 찾아 특별시간에 실천한다\"],\"answer\":5,\"explain\":\"Palin PCI는 부모-아동 상호작용 영상 피드백을 통해 부모가 아동의 유창성에 도움이 되는 상호작용 전략(속도 늦추기·기다리기·질문 줄이기 등)을 스스로 발견·선택하게 하고, 매주 정해진 '특별시간'(짧은 놀이 시간)에 이를 적용하게 하며, 부모의 불안·죄책감 등을 다루는 가족 전략을 병행하는 간접 중재이다. ②는 리드콤 프로그램, ③은 유창성완성법, ④는 말더듬수정법의 절차이며, ①은 부모 참여를 핵심으로 하는 PCI와 정반대이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"Palin PCI 핵심 절차\",\"p\":\"부모 상호작용 양상과 불안·죄책감 보고로 PCI 절차 식별\",\"n\":\"Palin PCI: 영상 피드백으로 부모가 상호작용 전략 발견, 특별시간 실천\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 2개월 남아, 최근 이사와 동생 출생 이후 말더듬이 급격히 증가\\n• 어휘·구문은 또래보다 앞서 있으나 말운동 협응(조음 정확도·교대운동)은 다소 느림\\n• 부모는 아동에게 빠른 말로 많은 질문을 하고 즉각적인 대답을 요구함\",\"q\":\"요구-용량 모델(Demands and Capacities Model)에 근거한 중재 방향으로 가장 적절한 것은?\",\"choices\":[\"언어 용량을 키우기 위해 복잡한 문장 산출을 요구하는 언어치료를 강화한다\",\"아동에게 취소·빠져나오기 기법을 직접 가르쳐 용량을 높인다\",\"부모 말속도와 질문·시간 압박을 줄여 요구를 낮춘다\",\"말운동 용량이 회복될 때까지 아동의 발화 기회를 제한한다\",\"동생과의 상호작용을 당분간 차단하여 정서적 요구를 제거한다\"],\"answer\":3,\"explain\":\"요구-용량 모델은 아동의 말운동·언어·정서·인지 용량을 환경적·내적 요구가 초과할 때 비유창성이 나타난다고 본다. 이 아동은 언어 요구(앞선 언어, 빠른 질문)와 정서 요구(이사·동생)가 말운동 용량을 넘어선 상황이므로, 부모 말속도 늦추기·질문과 시간 압박 줄이기·예측 가능한 일과 만들기 등으로 요구를 낮추면서 아동의 말운동·정서 용량을 지지하는 것이 중재 방향이다. 언어 요구를 더 높이는 것(①)은 모델과 정반대이고, 발화 제한(④)이나 상호작용 차단(⑤)은 비현실적이며 해롭다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"요구-용량 모델 적용 중재\",\"p\":\"언어·정서 요구가 말운동 용량을 넘는 사례로 중재 방향 선택\",\"n\":\"요구-용량 모델: 요구가 용량 초과 시 비유창, 부모 말속도·시간 압박 감소\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인이 Van Riper 말더듬수정법의 '확인(identification)' 단계를 마쳤다. 대상자는 자신의 핵심행동·부수행동·회피 패턴을 정확히 기술할 수 있으나, 여전히 말더듬 순간에 강한 공포를 느끼고 청자의 시선을 피한다.\",\"q\":\"다음으로 진행할 단계와 그 활동으로 옳은 것은?\",\"choices\":[\"변형(variation) – 말더듬 순간 직후 취소 기법 적용\",\"접근(approximation) – 빠져나오기와 예비책 훈련\",\"둔감화(desensitization) – 의도적 말더듬과 얼어붙기\",\"안정화(stabilization) – 자기치료 계획 수립과 재발 대비\",\"동기(motivation) – 치료 필요성 인식과 구체적 목표 설정\"],\"answer\":3,\"explain\":\"MIDVAS 순서(동기→확인→둔감화→변형→접근→안정화)에서 확인 단계 다음은 둔감화이다. 둔감화에서는 의도적(가짜) 말더듬, 말더듬 순간 얼어붙기·유지하기, 청자 반응 직면 등을 통해 공포와 긴장을 줄여야 이후 변형·접근 단계의 수정 기법을 배울 수 있다. 취소·빠져나오기·예비책(①②)은 접근 단계의 기법이며, 안정화(④)는 마지막 단계이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"MIDVAS 단계 순서\",\"p\":\"확인 단계 완료 후 공포 잔존 상태로 다음 단계와 활동 선택\",\"n\":\"MIDVAS: 동기→확인→둔감화→변형→접근→안정화, 둔감화는 의도적 말더듬\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 25세 남성, 대화 표본 %SS 1.2로 겉으로는 거의 유창해 보임\\n• 어려운 낱말을 예측하면 항상 다른 낱말로 바꾸고, 전화·주문·자기소개를 철저히 피함\\n• 취업 면접에서 이름을 말하지 못한 경험 후 의뢰됨\\n• OASES 총 영향 점수 '심함', 말더듬 사실을 주변에 숨겨 옴\",\"q\":\"이 대상자의 우선 중재 목표와 기법으로 가장 적절한 것은?\",\"choices\":[\"%SS를 0에 가깝게 낮추기 위한 연장된 말 집중 훈련\",\"회피 감소 – 위계적 노출과 의도적 말더듬, 자기공개\",\"부모가 참여하는 언어적 수반자극 프로그램 적용\",\"취소 기법 반복 연습으로 핵심행동 지속시간 단축\",\"지연청각피드백 기기 착용으로 전체 말속도 저하\"],\"answer\":2,\"explain\":\"겉으로는 유창하나 낱말 대치·상황 회피로 말더듬을 숨기는 내재화(covert) 말더듬은 핵심행동 빈도보다 회피와 두려움이 핵심 문제이다. 따라서 회피하던 낱말·상황의 위계에 따른 점진적 노출, 의도적 말더듬, 말더듬 자기공개(advertising) 등으로 회피를 줄이고 둔감화하는 것이 우선 목표다. 이미 낮은 %SS를 더 낮추는 훈련(①④)이나 기기(⑤)는 문제의 본질(회피·태도)을 다루지 못하고 오히려 '더듬으면 안 된다'는 신념을 강화할 수 있다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"내재화 말더듬 중재 목표\",\"p\":\"낮은 %SS와 심한 회피·높은 영향 점수로 우선 중재 목표 선택\",\"n\":\"내재화 말더듬: 회피·두려움이 핵심, 위계적 노출·의도적 말더듬·자기공개\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"성인 말더듬 대상자의 읽기 표본\\n• 읽기 소요 시간: 2분 30초\\n• 산출한 총 음절 수(비유창 음절 포함): 375음절\\n• 말더듬이 나타난 음절 수: 15음절\",\"q\":\"이 표본의 전체 말속도(분당 음절 수, SPM)와 말더듬 음절 백분율(%SS)로 옳은 것은?\",\"choices\":[\"125 SPM, 4%\",\"150 SPM, 2.5%\",\"187.5 SPM, 4%\",\"150 SPM, 4%\",\"150 SPM, 6%\"],\"answer\":4,\"explain\":\"전체 말속도 = 375음절 ÷ 2.5분 = 150 SPM, %SS = 15 ÷ 375 × 100 = 4%이다. 125 SPM은 3분으로 나눈 오류, 187.5 SPM은 2분으로 나눈 오류이며, 2.5%와 6%는 %SS 산출 오류이다. ※전체 말속도(쉼·비유창 포함)와 조음속도(유창 구간만 측정)의 정의는 교재별로 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"말속도·%SS 산출\",\"p\":\"읽기 시간과 총·말더듬 음절 수로 SPM과 %SS 산출\",\"n\":\"SPM=총 음절 수÷분, %SS=말더듬 음절 수÷총 음절 수×100\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 31세 여성 말더듬 성인\\n• 모음으로 시작하는 낱말('아버지', '오늘')에서 성대를 강하게 부딪히는 긴장된 막힘이 빈번함\\n• /ㅂ, ㄷ, ㄱ/ 초성에서 입술·혀를 세게 붙인 채 압력이 쌓여 막힘\\n• 유창성완성법 접근을 선택함\",\"q\":\"이 대상자의 말더듬 양상에 가장 직접적으로 대응하는 기법 조합은?\",\"choices\":[\"취소 + 빠져나오기 + 예비책\",\"부드러운 시작 + 가벼운 조음 접촉\",\"차폐 소음 + 메트로놈 리듬 말하기\",\"의도적 말더듬 + 말더듬 자기공개\",\"호흡 근력 강화 + 큰 소리로 말하기\"],\"answer\":2,\"explain\":\"모음 초성에서의 강한 성대 접촉에는 발성을 기류와 함께 부드럽게 시작하는 부드러운 시작(easy onset)이, 파열음에서 조음기관을 세게 붙여 생기는 막힘에는 조음 접촉을 가볍게 하는 가벼운 조음 접촉(light articulatory contact)이 직접 대응한다. 취소·빠져나오기·예비책(①)과 의도적 말더듬·자기공개(④)는 말더듬수정법의 기법이며, 차폐·리듬(③)은 일시적 유창성 유도 조건이지 이 양상을 겨냥한 기법이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"유창성완성 기법 선택\",\"p\":\"모음 초성 성대 충돌과 파열음 조음 압력 막힘에 대응 기법 선택\",\"n\":\"부드러운 시작은 강한 성대 접촉, 가벼운 조음 접촉은 조음기관 막힘 대응\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 22세 남성 말더듬 성인\\n• 치료사가 연장된 말(prolonged speech) 시범 영상을 보여주고 대상자가 이를 모방하도록 함\\n• 대상자는 매 발화 후 말더듬 정도와 말의 자연스러움을 스스로 척도로 평정함\\n• 정해진 말속도 단계나 프로그램된 위계 없이 문제해결식으로 진행\",\"q\":\"이 프로그램에 해당하는 것은?\",\"choices\":[\"캠퍼다운 프로그램\",\"리드콤 프로그램\",\"GILCU 프로그램\",\"페일린 PCI 프로그램\",\"스토커 프로브 테크닉\"],\"answer\":1,\"explain\":\"캠퍼다운 프로그램(Camperdown Program)은 청소년·성인을 대상으로, 프로그램된 단계별 말속도 지시 없이 연장된 말 시범 영상을 모방하여 유창한 말을 배우고, 대상자가 말더듬 정도(SR)와 자연스러움을 스스로 평정하며 문제해결식으로 자연스러운 유창성을 확립·일반화하는 유창성완성 계열 프로그램이다. 리드콤(②)은 학령전기 부모 수반자극 프로그램, GILCU(③, 점진적 발화길이 및 복잡성 증가)는 발화 길이를 단계적으로 늘리는 프로그램된 조작적 접근이다. ※평정 척도 범위 등 세부 절차는 프로그램 판본 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"캠퍼다운 프로그램 식별\",\"p\":\"시범 영상 모방·자기 평정·비프로그램 진행 특징으로 프로그램 식별\",\"n\":\"캠퍼다운: 청소년·성인 대상 연장된 말 영상 모방, SR·자연스러움 자기 평정\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 38세 남성, 유창성완성법 집중치료 종료 시 %SS 0.8, 말의 자연스러움 양호\\n• 치료 종료 6개월 후 %SS 6.2로 상승, 전화를 다시 피하기 시작\\n• \\\"기법을 쓰면 말이 어색해서 점점 안 쓰게 됐다\\\"고 보고\",\"q\":\"이 상황에 대한 판단과 대처로 가장 적절한 것은?\",\"choices\":[\"치료 실패로 판단하고 프로그램을 처음부터 동일하게 반복한다\",\"일시적 변동이므로 별도 조치 없이 1년 뒤 재평가한다\",\"지연청각피드백 기기를 영구적으로 착용하게 한다\",\"말더듬수정법으로 전면 교체하고 유창성 기법 사용을 금지한다\",\"재발로 보고 추후 회기에서 기법을 재확립하며 유지 전략을 보강한다\"],\"answer\":5,\"explain\":\"유창성완성법 이후 재발은 흔하며, 기법 사용 시 어색함·자기관리 부족·회피와 부정적 태도의 잔존이 주요 원인이다. 따라서 추후 회기로 기법을 재확립하되 자연스러움 훈련, 자기 모니터링, 인지-정서적 요소, 자조모임 등 유지·재발방지 전략을 통합해야 한다. 동일 프로그램 반복(①)은 재발 원인을 다루지 못하고, 방치(②)나 전면 교체·금지(④)는 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"치료 후 재발 대처\",\"p\":\"종료 후 %SS 상승과 기법 미사용 보고로 재발 대처 방안 선택\",\"n\":\"재발 대처: 추후 회기로 기법 재확립, 자연스러움·자기 모니터링 등 유지 보강\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"아동 A(6세): 긴장된 막힘·연장, 막힘 시 눈 깜빡임, 특정 낱말 회피, \\\"말이 안 나와서 무서워요\\\"라고 보고, 말속도는 정상\\n아동 B(12세): 말속도가 빠르고 불규칙, 음절 축약('선생님'→'샘님')으로 명료도 저하, 이야기 순서가 뒤섞임, 본인은 문제를 잘 인식하지 못하나 집중해서 말하면 뚜렷이 개선됨\",\"q\":\"두 아동의 감별과 각각의 중재 방향으로 옳은 것은?\",\"choices\":[\"A 속화 – 말속도 조절 / B 말더듬 – 취소 기법\",\"A 말더듬 – 긴장 감소 / B 속화 – 말속도 조절 훈련\",\"A 말더듬 – DAF 단독 사용 / B 속화 – 둔감화 훈련\",\"A와 B 모두 속화 – 말속도 조절·자기 모니터링\",\"A와 B 모두 말더듬 – 둘 다 리드콤 프로그램\"],\"answer\":2,\"explain\":\"A는 긴장된 핵심행동, 부수행동, 회피, 두려움이 뚜렷한 말더듬으로 긴장 감소와 유창성 촉진, 두려움을 다루는 직접 중재가 필요하다. B는 빠르고 불규칙한 말속도, 음절 축약, 발화 조직화 문제, 낮은 자기 인식, 주의 집중 시 개선이라는 속화의 전형적 특징을 보이므로 말속도 조절·자기 모니터링·발화 조직화 훈련이 적절하다. 12세 속화 아동에게 리드콤(⑤)이나 둔감화(③)는 목표가 어긋난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"발달 단계·감별\",\"k\":\"말더듬·속화 감별과 중재\",\"p\":\"긴장·회피 양상과 빠른 말속도·낮은 인식으로 감별 후 중재 선택\",\"n\":\"속화: 빠르고 불규칙한 말속도·음절 축약·낮은 인식, 집중 시 개선\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 58세 남성, 좌측 기저핵 뇌경색 후 2개월째 비유창성 발생\\n• 조사·어미 등 기능어와 낱말 끝에서도 반복이 나타나며 문장 내 위치와 무관함\\n• 부수행동과 말에 대한 공포는 거의 없음\\n• 반복 읽기에서 적응효과 미미, 경도의 마비말장애 동반\",\"q\":\"이 대상자에게 가장 적절한 중재 계획은?\",\"choices\":[\"의도적 말더듬과 얼어붙기로 둔감화를 집중적으로 시행한다\",\"pacing 등 보상 전략을 마비말장애 중재와 통합한다\",\"부모 수반자극 방식의 조작적 프로그램을 적용한다\",\"심리치료를 우선 의뢰하고 말 치료는 당분간 보류한다\",\"회피 낱말 목록을 작성해 위계적 노출을 실시한다\"],\"answer\":2,\"explain\":\"뇌손상 후 발생하고 기능어·낱말 끝 등 위치와 무관하게 나타나며 적응효과와 공포가 적은 양상은 신경학적 말더듬이다. 심리적 요소가 작으므로 둔감화·회피 노출(①⑤)의 비중은 낮고, 말속도 감소·pacing·DAF 등 보상 전략, 원인 질환과 약물에 대한 의학적 협진, 동반 마비말장애 중재의 통합이 핵심이다. 심리치료 우선(④)은 심인성 말더듬에 해당하는 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"발달 단계·감별\",\"k\":\"신경학적 말더듬 중재\",\"p\":\"뇌손상 후 발생·위치 무관 반복·적응효과 미미로 중재 계획 선택\",\"n\":\"신경학적 말더듬: 기능어·낱말 끝 반복, 적응효과·공포 적음, pacing 등 보상\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 42세 여성, 직장 내 심한 갈등 직후 갑자기 말더듬 시작(2주 전)\\n• 아동기 말더듬 병력·신경학적 이상 없음(신경과 검사 정상)\\n• 모든 낱말 첫 음절을 3~4회 일정하게 반복하는 기이하고 균일한 양상\\n• 노래·제창 등 유창성 유도 조건에서도 변화 없음\\n• 자신의 증상에 대해 무관심한 태도\",\"q\":\"이 대상자에 대한 감별과 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"심인성 말더듬 – 시험적 치료와 전문가 의뢰\",\"신경학적 말더듬 – pacing 보드와 DAF\",\"속화 – 말속도 조절과 자기 모니터링 훈련\",\"발달성 말더듬 – 말더듬수정법 전 단계 적용\",\"위장 말더듬 – 치료 대상이 아니므로 종결\"],\"answer\":1,\"explain\":\"심리적 스트레스 직후 성인기에 갑자기 발생, 신경학적 이상 없음, 기이하고 균일한 반복 양상, 유창성 유도 조건에서의 무반응, 증상에 대한 무관심은 심인성 말더듬을 시사한다. 심인성 말더듬은 짧은 시험적 치료(속도·발성 조절 지시 등)에 빠르게 반응하는 경우가 많아 진단적 가치가 있으며, 정신건강 전문가 의뢰와 상담을 병행한다. 신경학적 이상이 없으므로 ②는 배제되고, 의도적 위장(⑤)으로 단정할 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"발달 단계·감별\",\"k\":\"심인성 말더듬 감별과 중재\",\"p\":\"스트레스 후 급발·균일 반복·유도조건 무반응으로 감별과 중재 선택\",\"n\":\"심인성 말더듬: 스트레스 후 급발, 균일 반복·무관심, 시험적 치료와 의뢰\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 5세 남아, 가정에서 한국어와 영어를 함께 사용하는 이중언어 환경\\n• 두 언어 모두에서 말더듬이 관찰되며 영어에서 다소 더 심함\\n• 부모: \\\"말더듬을 없애려면 영어를 완전히 끊고 한국어만 써야 할까요?\\\"\",\"q\":\"부모에게 제공할 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"이중언어 자체가 말더듬의 원인이므로 단일언어 환경으로 바꾼다\",\"말더듬이 더 심한 영어 사용을 가정에서 즉시 중단시킨다\",\"영어를 끊고 한국어 사용도 줄여 발화량 자체를 낮춘다\",\"말더듬이 덜한 한국어로만 치료하고 영어 유창성은 평가하지 않는다\",\"두 언어를 유지하되 각 언어의 요구와 압박을 줄이도록 안내한다\"],\"answer\":5,\"explain\":\"이중언어 노출 자체가 말더듬을 유발하거나, 한 언어를 없애면 말더듬이 개선된다는 근거는 확립되어 있지 않다. 가족의 의사소통 필요를 고려해 두 언어를 유지하면서 두 언어 모두에서 유창성을 평가하고, 급한 언어 전환 강요나 교정 등 언어별 요구·압박을 줄이는 상호작용 조정을 안내하는 것이 적절하다. 언어 제거(①②④)나 발화량 축소(③)는 언어발달과 가족 관계에 해가 될 수 있다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"이중언어 말더듬 부모 상담\",\"p\":\"두 언어 모두 더듬는 아동 부모의 언어 단절 질문에 상담 내용 선택\",\"n\":\"이중언어는 말더듬 원인 아님, 두 언어 유지하며 언어별 요구·압박 감소\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 초등 3학년 여아, 말더듬 치료 중\\n• 담임교사: 소리 내어 읽기 시간에 아동이 심하게 더듬자 미안한 마음에 아동 순서를 건너뛰고 있음\\n• 아동은 \\\"선생님이 나만 빼요\\\"라며 위축됨\",\"q\":\"치료사가 담임교사에게 제안할 교실 전략으로 가장 적절한 것은?\",\"choices\":[\"읽기와 발표 활동에서 계속 제외하여 부담을 없앤다\",\"아동이 더듬을 때 \\\"천천히, 숨 쉬고\\\"라고 즉시 조언한다\",\"아동이 더듬은 문장을 유창해질 때까지 다시 읽게 한다\",\"순서를 미리 알려 주거나 짝과 함께 읽기를 활용해 참여를 유지한다\",\"말더듬을 학급 앞에서 공개적으로 설명하도록 아동에게 요구한다\"],\"answer\":4,\"explain\":\"학령기 아동을 활동에서 제외하면 회피와 위축을 강화하고 '나만 다르다'는 인식을 키운다. 읽기 순서 예고로 예기 불안을 줄이고 짝과 함께 읽기(제창)라는 유창성 유도 조건을 활용해 참여를 유지하며, 끼어들지 않기·끝까지 듣기 규칙을 학급 전체에 동일하게 적용해 아동만 특별 취급하지 않는 것이 권장된다. \\\"천천히\\\" 조언(②)이나 다시 읽기 요구(③)는 유창성을 방해하고, 공개 설명 요구(⑤)는 아동의 준비와 동의 없이 강요할 사항이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"교실 말더듬 지원 전략\",\"p\":\"읽기 활동 제외로 위축된 학령기 아동에게 교실 전략 선택\",\"n\":\"교실 지원: 읽기 순서 예고·짝과 함께 읽기로 참여 유지, 제외는 회피 강화\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인 대상자가 \\\"노래할 때, 여럿이 함께 읽을 때, 메트로놈에 맞춰 말할 때는 전혀 안 더듬는데 왜 치료에서 이걸 그냥 쓰지 않느냐\\\"고 질문하였다.\",\"q\":\"치료사의 설명으로 가장 적절한 것은?\",\"choices\":[\"이 조건들은 말더듬의 원인을 제거하므로 충분히 오래 사용하면 완치된다\",\"이 조건들은 촉진 도구로 활용하되 점차 제거하며 전이를 계획한다\",\"이 조건들은 효과가 일관되지 않으므로 치료에 사용하지 않는다\",\"이 조건들에서 유창하면 말더듬이 아니므로 치료 대상이 아니다\",\"이 조건들에서 유창한 것은 말더듬이 심인성임을 증명한다\"],\"answer\":2,\"explain\":\"노래·제창·리듬 말하기·DAF 등은 말산출의 타이밍과 청각 피드백을 외부적으로 변화시켜 일시적으로 유창성을 유도하는 '유창성 유도 조건'으로, 대부분의 말더듬 화자에게 공통적으로 나타나므로 심인성의 증거(⑤)나 비말더듬의 증거(④)가 아니다. 임상적으로는 초기 확립 단계의 촉진 도구로 유용하지만 효과가 조건 의존적이고 자연스러움이 떨어지므로 점진적 제거(fading)와 자연스러운 말·실제 상황으로의 전이·유지 계획이 필수이며, 원인 제거·완치(①)는 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"유창성 유도 조건 활용\",\"p\":\"노래·제창·리듬 조건의 일시적 유창성을 치료에 쓰는 방식 판단\",\"n\":\"유창성 유도 조건: 일시적 유창성, 촉진 도구로 쓰되 점진적 제거·전이 계획\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 29세 여성 말더듬 성인, 사회불안 동반\\n• \\\"발표 중 한 번이라도 막히면 모두가 나를 무능하다고 생각할 것이다\\\"라는 신념이 강함\\n• 이 때문에 회의 발언을 포기하고, 이후 자책과 회피가 심해지는 악순환\",\"q\":\"이 대상자의 인지-정서적 문제를 다루기 위한 중재로 가장 적절한 것은?\",\"choices\":[\"말더듬 빈도를 0으로 낮추도록 유창성 기법만 집중 훈련한다\",\"발표 상황을 완전히 피하도록 직장에 조치를 요청한다\",\"왜곡된 신념을 재구조화하고 행동 실험을 수행한다\",\"말더듬 순간마다 취소 기법만 반복해서 연습한다\",\"지연청각피드백 기기를 발표 때마다 착용하게 한다\"],\"answer\":3,\"explain\":\"말더듬 성인의 부정적 신념·사회불안에는 인지행동치료 원리에 따른 인지 재구조화(파국화·독심 등 사고 오류 확인과 근거 검토)와, 실제 발언 후 청자 반응을 확인하는 등 신념을 검증하는 행동 실험·점진적 노출을 결합한 접근이 효과적이다. 유창성 기법이나 기기만으로는(①④⑤) 신념이 유지되고, 상황 회피 조치(②)는 회피를 강화하여 악순환을 심화시킨다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬 인지행동 중재\",\"p\":\"막힘에 대한 파국적 신념과 회피 악순환으로 인지-정서 중재 선택\",\"n\":\"인지 재구조화와 행동 실험·점진적 노출 결합으로 부정적 신념 수정\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 7세 남아에게 프로그램된 조작적 접근을 적용함\\n• 1낱말 읽기 → 2낱말 → 구 → 문장 → 1분·2분·…·5분 독백·대화 순으로 발화 길이와 복잡성을 단계적으로 늘림\\n• 각 단계에서 정해진 준거(연속 시행에서 말더듬 없음)를 충족해야 다음 단계로 진행\\n• 유창한 반응에는 \\\"잘했어\\\"와 토큰, 말더듬 시 \\\"멈추고 부드럽게 다시\\\" 지시\",\"q\":\"이 프로그램의 명칭과 전체 구조로 옳은 것은?\",\"choices\":[\"리드콤 프로그램 – 1단계(감소)와 2단계(유지)\",\"캠퍼다운 프로그램 – 시범·확립·일반화·유지\",\"말더듬수정법 – 동기·확인·둔감화·변형·접근·안정화\",\"GILCU 프로그램 – 확립·전이·유지 3단계\",\"페일린 PCI – 상호작용 전략·가족 전략·아동 전략\"],\"answer\":4,\"explain\":\"발화 길이와 복잡성을 낱말→구→문장→장시간 대화로 단계적으로 늘리고 각 단계 준거를 통과해야 진행하며, 유창한 반응에 강화를 주는 프로그램은 Ryan의 GILCU이며, 확립(establishment)·전이(transfer)·유지(maintenance)의 3단계로 구성된다. 리드콤(①)은 부모의 일상 대화 수반자극이 중심이고, 캠퍼다운(②)은 프로그램된 위계가 없다. ※단계별 준거(연속 시행 수)와 세부 단계 수는 교재별 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"GILCU 프로그램 구조\",\"p\":\"발화 길이·복잡성 단계 증가와 준거 진행 특징으로 프로그램 식별\",\"n\":\"GILCU: 발화 길이·복잡성 점진 증가, 확립·전이·유지 3단계\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 9세 남아, 중등도 지적장애(IQ 52)와 말더듬 동반\\n• 긴장된 음절 반복과 막힘, 자신의 말더듬 인식은 낮음\\n• 추상적 설명의 이해가 어렵고 새 기술의 유지·일반화가 느림\\n• 특수학급 교사와 부모가 협조적임\",\"q\":\"이 아동의 말더듬 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"단순화한 유창성 기법을 시각적 단서로 지도하고 부모·교사가 강화한다\",\"말더듬 순간을 분석하는 확인 단계와 인지 재구조화를 집중 시행한다\",\"지적장애가 있으면 말더듬 치료 효과가 없으므로 언어치료만 진행한다\",\"성인용 캠퍼다운 프로그램을 수정 없이 그대로 적용한다\",\"말더듬을 스스로 인식하지 못하므로 현재는 중재 대상이 아니다\"],\"answer\":1,\"explain\":\"지적장애 아동은 추상적 자기분석과 인지적 접근(②)의 부담이 크므로, 구체적·단순화된 유창성 촉진 기법을 시범과 반복, 시각적 단서로 지도하고 부모·교사가 동일한 단서와 강화를 제공하는 환경 조정으로 일반화를 돕는 것이 적절하다. 지적장애가 있어도 말더듬 중재는 효과가 있으며(③), 인식 부족은 치료 제외 사유가 아니라(⑤) 중재 설계 시 고려할 특성이다. 성인용 프로그램의 그대로 적용(④)은 부적합하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"지적장애 동반 말더듬 중재\",\"p\":\"추상적 이해 제한과 일반화 지연 특성으로 중재 계획 선택\",\"n\":\"지적장애 동반 말더듬: 단순화한 유창성 기법·시각 단서, 부모·교사 강화\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 여아, 클리닉 초기 평가에서 치료사와 그림 설명 시 %SS 1.5로 거의 유창함\\n• 그러나 부모는 \\\"집에서는 훨씬 심하고, 특히 저녁에 형제와 다툴 때 심하다\\\"고 보고\\n• 치료사는 진단을 보류하고 추가 자료를 수집하기로 함\",\"q\":\"이 결정의 근거와 추가로 수집할 자료로 가장 적절한 것은?\",\"choices\":[\"클리닉 표본이 가장 객관적이므로 부모 보고는 배제하고 재측정한다\",\"부모 보고가 더 정확하므로 이를 근거로 즉시 직접 치료를 시작한다\",\"%SS 1.5는 정상 범위이므로 말더듬이 아니라고 보고 종결한다\",\"말더듬은 맥락별 변이가 크므로 가정 녹화와 부모 평정을 추가한다\",\"아동의 표준화 언어검사만 추가하면 말더듬 진단이 가능하다\"],\"answer\":4,\"explain\":\"말더듬은 상황·과제·시간대·상대·정서 상태에 따라 변이가 매우 커서, 낯선 클리닉의 단일 표본은 대표성이 부족할 수 있다(특히 학령전기). 따라서 가정 녹화, 놀이·대화 등 다양한 과제의 표본, 부모의 일일 말더듬 정도(SR) 평정 등을 종합해 대표성 있는 판단을 해야 한다. 클리닉 표본만 신뢰하거나(①) 부모 보고만으로 치료를 시작하는 것(②), 단일 표본으로 종결하는 것(③) 모두 변이성을 고려하지 않은 결정이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"말더듬 표본 대표성 확보\",\"p\":\"클리닉 표본과 부모 보고 불일치로 추가 수집할 자료 선택\",\"n\":\"말더듬 맥락별 변이: 가정 녹화·다양한 과제 표본·부모 SR 평정 종합\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 26개월 남아, 청력 정상, 출생·발달력 특이사항 없음\\n• K M-B CDI 표현어휘 30개(10%ile 미만), 낱말 조합 없음\\n• 언어 이해(SELSI 수용언어)는 생활연령 수준\\n• 가리키기·보여주기 등 몸짓 사용과 상징놀이가 연령에 적절\\n• 언어장애 가족력 없음, 부모는 걱정이 커서 '지금 당장 주 3회 치료'를 요청함\",\"q\":\"이 아동에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"표현어휘 지체가 뚜렷하므로 즉시 주 3회 개별 집중치료를 시작한다\",\"저위험 늦게 말하는 아동으로 보고 부모 언어촉진 교육 후 3~6개월 뒤 재평가한다\",\"24개월 이후 낱말 조합이 없으므로 발달성 언어장애(DLD)로 진단을 확정한다\",\"표현어휘 지체는 대부분 자연 회복되므로 아무 조치 없이 만 4세까지 기다린다\",\"낱말 조합이 없는 것은 자폐스펙트럼장애의 핵심 징후이므로 자폐 진단평가를 의뢰한다\"],\"answer\":2,\"explain\":\"이해력, 몸짓(특히 가리키기), 상징놀이가 정상이고 가족력이 없는 표현어휘 지체는 예후가 좋은 저위험 late talker(늦게 말하는 아동) 프로파일이다. 이 경우 부모 매개 언어촉진(반응적 상호작용·집중자극) 교육과 3~6개월 간격의 추적 재평가가 권장된다. ①은 위험도 대비 과잉 개입, ③은 DLD 진단은 보통 만 4세 전후 언어 문제가 지속될 때 내리므로 조기 확정이 부적절, ④는 추적 없이 방치하는 것으로 부적절, ⑤는 몸짓·놀이·상호작용이 양호하여 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"늦게 말하는 아동 위험도 판단\",\"p\":\"이해·몸짓·상징놀이 정상과 표현어휘 지체로 위험도와 조치 판단\",\"n\":\"저위험 late talker: 이해·몸짓·놀이 정상, 부모 언어촉진 교육과 추적 재평가\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 아동의 수용어휘 검사 결과\\n• 원점수: 34\\n• 해당 연령 규준: 평균 46, 표준편차 8\",\"q\":\"이 아동의 z점수와 그에 대한 해석으로 옳은 것은?\",\"choices\":[\"z = -0.75, 백분위 약 23으로 정상 범위이다\",\"z = -2.0, 백분위 약 2로 심한 지체이다\",\"z = -1.5, 백분위 약 16으로 경계선 수준이다\",\"z = -1.5, 백분위 약 7로 유의한 지체이다\",\"z = +1.5, 백분위 약 93으로 우수하다\"],\"answer\":4,\"explain\":\"z = (원점수 − 평균) ÷ 표준편차 = (34 − 46) ÷ 8 = −1.5. 정규분포에서 z = −1.5는 백분위 약 7(6.7)에 해당하며 −1SD(백분위 16) 미만이므로 유의한 어휘 지체로 해석한다. ③은 z와 백분위가 서로 맞지 않고(백분위 16은 z = −1), ①·②·⑤는 계산이 틀렸다. ※ 백분위 환산값과 '유의한 지체' 절단점(−1SD, −1.25SD, −1.5SD 등)은 검사·교재별로 다를 수 있다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"z점수 산출과 해석\",\"p\":\"원점수·평균·표준편차로 z점수와 백분위 수준 산출\",\"n\":\"z=(원점수−평균)÷SD, z −1.5는 백분위 약 7로 −1SD 미만 지체\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"3세 아동의 자발화(4개 발화)\\n① \\\"아빠 신문 읽어\\\"\\n② \\\"나 우유 먹었어\\\"\\n③ \\\"동생이 울어\\\"\\n④ \\\"엄마가 책 찾아\\\"\",\"q\":\"위 발화의 평균형태소길이(MLU-m)는? (조사·어미·선어말어미는 각각 하나의 형태소로 계산)\",\"choices\":[\"4.5\",\"4.0\",\"3.5\",\"5.0\",\"5.5\"],\"answer\":1,\"explain\":\"① 아빠/신문/읽-/-어 = 4, ② 나/우유/먹-/-었-/-어 = 5, ③ 동생/-이/울-/-어 = 4, ④ 엄마/-가/책/찾-/-아 = 5. 총 18개 형태소 ÷ 4발화 = 4.5. 조사(-이, -가)나 선어말어미(-었-)를 빠뜨리면 값이 낮게, 어간을 더 쪼개면 높게 산출된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"MLU-m 산출\",\"p\":\"조사·어미·선어말어미 분리 규칙으로 평균형태소길이 산출\",\"n\":\"MLU-m=총 형태소 수÷발화 수, 조사·어미·선어말어미 각 1개로 계산\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 6개월 여아 평가 결과\\n• 청력 정상, K-CTONI-2 비언어성 지능지수 98\\n• PRES 수용언어 발달연령 4;6, 표현언어 발달연령 3;10\\n• REVT 표현어휘 9%ile\\n• 비단어 따라말하기 3음절 이상에서 급격히 저하\\n• 자발화: 주격조사 생략(\\\"토끼 뛰어\\\"), 시제 오류(\\\"어제 유치원 가요\\\"), 연결어미 없이 단문 나열\\n• 눈맞춤·상호작용·상징놀이 양호, 상동행동 없음\",\"q\":\"이 아동의 진단과 우선 중재 목표로 가장 적절한 조합은?\",\"choices\":[\"발달성 언어장애 – 격조사·시제 등 문법형태소 산출\",\"자폐스펙트럼장애 – 공동주의와 상호작용 시작하기\",\"사회적(화용) 의사소통장애 – 대화 차례 주고받기\",\"지적장애 – 기능적 일상 어휘와 생활 기술 습득\",\"말소리장애 – 종성 산출 정확도와 말 명료도 향상\"],\"answer\":1,\"explain\":\"비언어성 지능·청력이 정상이고 사회적 상호작용에 문제가 없는데 언어(특히 표현·문법형태소)만 지체되고 비단어 따라말하기가 저조한 것은 발달성 언어장애(단순언어장애)의 전형적 프로파일이다. 문법형태소 오류가 두드러지므로 자연스러운 놀이 맥락에서 조사·시제를 목표로 한 집중자극·고쳐말하기 중재가 우선된다. 지능 정상이므로 ④, 사회성 양호하므로 ②·③, 조음 문제가 아니므로 ⑤는 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"DLD 감별과 중재 목표\",\"p\":\"지능·사회성 정상과 문법형태소 오류 프로파일로 진단과 목표 선택\",\"n\":\"DLD: 지능·청력·사회성 정상, 문법형태소 결함·비단어 따라말하기 저조\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"6세 남아\\n• K-WPPSI-IV 전체 지능지수 62, 적응행동 점수도 유의하게 낮음\\n• PRES 수용·표현언어 발달연령 모두 약 3;6 수준\\n• 자발화: 2~3어절 단문, 어휘 제한, 요구하기는 주로 손잡아끌기로 함\\n• 배운 낱말을 치료실 밖에서 잘 쓰지 못함\",\"q\":\"이 아동의 중재 방향으로 가장 적절한 것은?\",\"choices\":[\"인지 수준을 먼저 정상 범위로 끌어올린 뒤 언어치료를 시작한다\",\"언어가 인지보다 유의하게 낮으므로 단순언어장애 중재 프로토콜을 적용한다\",\"요구·거부·선택 등 일상 기능과 생활 어휘를 목표로 일과 속 일반화를 강조한다\",\"연령 수준의 복문 산출을 1차 목표로 설정하여 집중 훈련한다\",\"구어 산출이 가능하므로 몸짓·그림 등 비구어 수단은 모두 제한한다\"],\"answer\":3,\"explain\":\"지적장애 아동은 언어가 인지 수준과 대체로 일치하며 학습 속도가 느리고 일반화가 어렵다. 따라서 발달적으로 적절한 기능적 목표(요구·거부·선택하기, 생활 어휘)를 실제 일과에서 반복·분산 연습하고 여러 사람·환경에서 일반화하는 것이 핵심이다. ②는 언어–인지 불일치가 없으므로 틀리고, ①은 언어와 인지는 병행 촉진 대상이며, ④는 발달 수준보다 지나치게 높은 목표, ⑤는 잔존 수단을 제한하는 것으로 총체적 의사소통 원칙에 어긋난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"지적장애 아동 중재 방향\",\"p\":\"인지·언어 수준 일치와 일반화 곤란 특성으로 중재 방향 선택\",\"n\":\"지적장애: 언어가 인지 수준과 일치, 기능적 생활 어휘와 일과 속 일반화\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"놀이 상황에서 아동이 치료사가 들고 있는 블록을 향해 손을 뻗는다. 치료사는 블록을 아동 눈높이에 들고 기대에 찬 표정으로 바라보며 약 5초간 말없이 기다린다. 아동이 \\\"블록\\\"이라고 말하자 즉시 블록을 건네준다.\",\"q\":\"치료사가 사용한 환경중심 언어중재(milieu teaching) 절차는?\",\"choices\":[\"요구-모델(mand-model)\",\"우연교수(incidental teaching)\",\"아동중심 시범(modeling)\",\"환경 조성(arrangement)\",\"시간지연 기법(time delay)\"],\"answer\":5,\"explain\":\"아동이 원하는 것에 관심을 보일 때 즉시 촉진하지 않고 기대하는 표정으로 일정 시간 기다려 자발적 산출을 유도한 뒤 원하는 물건으로 자연적 강화를 주는 것은 시간지연 절차이다. 요구-모델은 치료사가 '뭐 줄까?'처럼 언어적 요구를 먼저 하고, 시범은 목표 발화를 먼저 들려주며, 우연교수는 아동의 요구 시작 후 정교화를 요청하는 절차이다. 환경 조성은 물건을 닿지 않게 두는 등 사전 상황 설정에 해당한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"환경중심 시간지연 기법\",\"p\":\"기대 표정으로 말없이 기다리는 절차로 환경중심 중재 기법 식별\",\"n\":\"시간지연: 즉시 촉진 없이 기다려 자발 산출 유도 후 자연적 강화\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"4세 발달성 언어장애 아동의 목표는 과거시제 '-었-'의 산출이다. 치료사는 소꿉놀이를 하며 \\\"아기가 밥을 다 먹었어\\\", \\\"곰이 잠을 잤어\\\", \\\"컵이 떨어졌어\\\"처럼 목표 형태를 담은 문장을 한 회기에 수십 번 자연스럽게 들려주되, 아동에게 따라 말하거나 산출하도록 요구하지 않는다.\",\"q\":\"위 중재 기법과 그 원리로 옳은 것은?\",\"choices\":[\"확대(extension) – 아동 발화에 새로운 의미 정보를 덧붙여 되돌려 준다\",\"유도모방(elicited imitation) – 모델 직후 아동이 즉시 따라 말하게 한다\",\"비연속 개별시도 교수 – 자극·반응·강화의 시행을 구조화하여 반복한다\",\"집중자극(focused stimulation) – 목표 형태를 고빈도로 입력한다\",\"혼잣말 기법(self-talk) – 치료사가 자신의 행동을 말로 표현한다\"],\"answer\":4,\"explain\":\"특정 목표 형태를 의미 있는 맥락에서 고빈도로 반복 입력하되 산출을 강요하지 않는 것은 집중자극 기법으로, 아동이 고빈도 입력에서 목표 규칙을 스스로 추출하도록 하는 원리이다. 유도모방·개별시도는 산출을 직접 요구하고, 확대는 아동 발화에 대한 반응 기법이며, 혼잣말은 치료사 자신의 행동을 기술하는 기법으로 특정 문법형태소를 목표로 한 고밀도 입력과는 다르다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"집중자극 기법 원리\",\"p\":\"목표 형태 고빈도 입력·산출 비요구 특징으로 기법과 원리 식별\",\"n\":\"집중자극: 목표 형태를 의미 맥락에서 고빈도 입력, 산출 강요 없음\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 아동에게 ㉠ 주격조사 '이/가', ㉡ 연결어미 '-고', ㉢ 대화에서 차례 기다리기의 세 목표를 설정하였다. 치료사는 매 회기마다 세 목표를 모두 다루며, 각 목표에 회기 시간을 나누어 배분한다.\",\"q\":\"이 치료사가 사용한 목표 공략(goal attack) 전략은?\",\"choices\":[\"수평적 전략 – 여러 목표를 같은 회기에서 동시에 다룬다\",\"주기적 전략 – 정해진 기간마다 목표를 교체하며 순환한다\",\"수직적 전략 – 한 목표가 준거에 도달한 뒤 다음 목표로 넘어간다\",\"위계적 전략 – 쉬운 목표부터 어려운 목표로 순서대로 다룬다\",\"절충적 전략 – 치료사가 목표를, 아동이 활동을 선택한다\"],\"answer\":1,\"explain\":\"매 회기 여러 목표를 동시에 다루는 것은 수평적(horizontal) 목표 공략 전략이다. 수직적 전략은 한 목표씩 준거 도달 후 순차적으로, 주기적 전략은 준거 도달과 무관하게 정해진 기간 단위로 목표를 순환한다. ④·⑤는 목표 공략 전략의 공식적 분류가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"목표 공략 전략 유형\",\"p\":\"매 회기 여러 목표를 나눠 다루는 방식으로 목표 공략 전략 식별\",\"n\":\"수평적 전략: 한 회기에 여러 목표 동시, 수직적은 준거 도달 후 순차\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 4세 8개월 아동, 가정에서는 중국어, 어린이집(입소 1년)에서는 한국어 사용\\n• 한국어 표준화 어휘검사: 10%ile 미만\\n• 역동적 평가(검사–교수–재검사): 20분의 짧은 어휘 교수 후 재검사에서 새 낱말 대부분을 습득·사용함\\n• 교수 과정에서 검사자의 촉진 필요량(examiner effort)이 적고 반응 수정 능력(modifiability)이 높음\\n• 부모 보고상 중국어 발달은 또래 수준\",\"q\":\"이 결과에 대한 해석과 조치로 가장 적절한 것은?\",\"choices\":[\"표준화 검사 결과가 낮으므로 발달성 언어장애로 진단하고 주 2회 언어치료를 시작한다\",\"두 언어 모두 사용해 혼란이 생겼으므로 가정에서도 한국어만 쓰도록 권고한다\",\"언어 차이로 판단하고 모국어를 유지하며 한국어 입력을 늘리고 추적 관찰한다\",\"역동적 평가 결과는 참고자료일 뿐이므로 한국어 표준화 검사 점수로 진단한다\",\"중국어가 또래 수준이므로 한국어 문제는 무시하고 평가를 종료한다\"],\"answer\":3,\"explain\":\"역동적 평가에서 짧은 교수 후 높은 학습 반응성(높은 수정가능성, 낮은 검사자 노력)을 보이면 학습 잠재력, 즉 언어 학습 능력 자체는 온전한 것으로 보고, 낮은 표준화 점수는 한국어 노출 부족에 의한 '언어 차이'로 해석한다. 모국어 발달이 정상이라는 점도 이를 지지한다. 따라서 모국어 유지와 한국어 노출·풍부한 입력 확대, 추적 관찰이 적절하다. ①·④는 규준이 맞지 않는 표준화 검사로 진단하는 오류이고, ②는 이중언어가 언어장애를 유발한다는 잘못된 전제이며, ⑤는 한국어 지원 필요성을 무시한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"역동적 평가와 언어 차이\",\"p\":\"짧은 교수 후 높은 수정가능성으로 언어 차이 판단과 조치 선택\",\"n\":\"역동적 평가: 높은 수정가능성·낮은 검사자 노력은 장애 아닌 언어 차이\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 3세 0개월, 양측 중등고도 감각신경성 난청(70dB HL)\\n• 생후 30개월에 진단, 보청기 착용 1개월째(보청 후 어음역 20~30dB HL)\\n• 표현어휘 15개, 대부분 모음 위주 발성\\n• 부모는 구어(듣기·말하기)를 통한 의사소통을 희망함\",\"q\":\"이 아동에게 청각구어법(auditory-verbal approach)을 적용할 때의 원리로 옳은 것은?\",\"choices\":[\"보청기 효과가 제한적이므로 수어를 주 수단으로 먼저 확립한 뒤 구어를 도입한다\",\"구어 습득이 어려우므로 그림 기반 AAC를 주 의사소통 수단으로 설정한다\",\"독순(입모양 읽기) 훈련을 중심으로 시각적 단서를 최대한 제공한다\",\"시각 단서를 최소화하고 청각을 통한 언어 습득과 부모 코칭을 강조한다\",\"치료사 주도의 낱말 따라말하기 훈련을 주 3회 집중 실시하고 부모 참여는 배제한다\"],\"answer\":4,\"explain\":\"청각구어법은 적절한 보청(보청기·인공와우)과 지속적인 보청 상태 점검을 전제로, 청각을 통한 언어 습득을 최우선으로 하고 입모양 등 시각 단서 의존을 줄이며 부모를 일상의 일차적 언어 촉진자로 코칭하는 접근이다. 보청 후 어음역 청력이 확보된 이 아동은 적용 대상이 된다. ①·②·③은 수어·AAC·시각 중심으로 청각구어법의 원리와 반대이며, ⑤는 부모 참여를 배제하여 핵심 원리에 어긋난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"청각구어법 원리\",\"p\":\"보청 후 어음역 확보된 난청 아동에게 청각구어법 원리 식별\",\"n\":\"청각구어법: 청각 통한 언어 습득 우선, 시각 단서 최소화, 부모 코칭\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 4세 뇌성마비 아동, 구어 명료도가 매우 낮아 그림상징 의사소통판 사용 중\\n• 현재 판에는 '과자, 물, 자동차, 블록…' 등 명사 20개만 있음\\n• 사용 양상: 원하는 것 요구하기에만 사용, 판을 사용하는 상대는 대부분 어머니\\n• 언어 이해는 연령 수준\",\"q\":\"이 아동의 AAC 중재를 확장하기 위한 계획으로 가장 적절한 것은?\",\"choices\":[\"핵심어휘를 추가해 의사소통 기능을 넓히고 보조 언어 자극으로 모델을 제공한다\",\"구어 명료도 향상을 위해 조음치료를 우선하고 AAC 사용은 잠시 중단한다\",\"판에 있는 낱말을 짚으며 따라 말하게 하는 구어 산출 훈련으로 전환한다\",\"요구하기가 안정되었으므로 판 사용을 어머니와의 상황으로 한정하여 숙달시킨다\",\"명사 상징을 100개로 늘려 요구할 수 있는 어휘량을 충분히 확보한다\"],\"answer\":1,\"explain\":\"AAC 어휘는 '더, 아니야, 싫어, 다했어, 봐'처럼 다양한 상황·기능에 두루 쓰이는 핵심어휘(core vocabulary)를 포함해야 요구하기 이외의 의사소통 기능(거부·언급·질문 등)과 상징 조합으로 확장될 수 있다. 또한 상대가 상징을 짚으며 말하는 보조 언어 자극(aided language stimulation)은 AAC 사용자에게 필수적인 입력 모델이다. ⑤는 부수어휘만 늘려 기능 확장이 안 되고, ②·③은 AAC 사용을 구어 훈련으로 대체하는 잘못된 접근이며, ④는 의사소통 상대·환경을 오히려 제한한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"AAC 어휘 확장 계획\",\"p\":\"명사 위주 판과 요구 기능 한정 사용으로 AAC 확장 계획 선택\",\"n\":\"AAC 확장: 핵심어휘로 기능 확대, 보조 언어 자극으로 상징 사용 모델\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 30개월 남아, 자폐스펙트럼장애 진단\\n• 무발화, 원하는 물건은 성인의 손을 물건 쪽으로 끌어당김\\n• 흥미로운 것을 보고 가리키거나 성인과 사물을 번갈아 보는 행동이 없음\\n• 성인이 가리키는 곳을 따라 보는 반응(공동주의 반응하기)은 간헐적으로 나타남\\n• 장난감을 줄 세우거나 돌리며 놀고 상징놀이는 없음\",\"q\":\"이 아동의 초기 중재 목표와 근거로 가장 적절한 것은?\",\"choices\":[\"공동주의 시작하기와 상징놀이를 목표로 한다 – 이후 언어 발달의 예측 요인이다\",\"낱말 따라말하기를 우선 목표로 한다 – 무발화이므로 구어 산출이 가장 시급하다\",\"장난감 줄 세우기를 즉시 소거한다 – 상동행동이 언어 습득을 방해한다\",\"글자 카드로 문자 읽기를 가르친다 – 자폐 아동은 시각 학습자여서 읽기가 더 빠르다\",\"성인 지시 따르기를 우선 목표로 한다 – 순응이 있어야 언어 학습이 가능하다\"],\"answer\":1,\"explain\":\"자폐스펙트럼장애 영유아에서 공동주의(특히 시작하기, IJA)와 상징(가장)놀이는 이후 언어 습득을 예측하는 핵심 영역으로, JASPER 등 근거 기반 중재의 우선 목표이다. 무발화 아동에게 사회적 기반 없이 따라말하기(②)나 문자(④)를 우선하는 것은 부적절하고, 반복 놀이는 소거 대상이 아니라 확장의 출발점으로 활용하며(③), 순응 훈련(⑤)은 의사소통 발달의 전제가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"자폐 영유아 초기 중재 목표\",\"p\":\"공동주의 시작 부재와 상징놀이 부재로 초기 중재 목표 선택\",\"n\":\"공동주의 시작하기·상징놀이: 자폐 영유아 이후 언어 발달의 예측 요인\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 자폐스펙트럼장애 아동\\n• 넘어져 아플 때마다 예전에 엄마가 하던 말을 그대로 \\\"괜찮아, 호 해줄게\\\"라고 말함\\n• 원하는 과자를 보면 광고 문구를 그대로 \\\"바삭바삭 새로 나왔어요\\\"라고 말함\\n• 두 발화 모두 억양·형태가 매번 동일함\",\"q\":\"이 반향어에 대한 해석과 중재로 가장 적절한 것은?\",\"choices\":[\"의미 없는 자기자극 행동이므로 무시하여 점차 소거한다\",\"기능을 지닌 지연 반향어로 보고 짧고 관습적인 발화로 대치해 간다\",\"발화가 있으므로 언어 수준이 적절하다고 보고 화용 중재는 생략한다\",\"즉각 반향어이므로 발화 직후 '조용히'라고 지시하여 억제한다\",\"반향어를 늘리기 위해 광고·대화 문구를 더 많이 암기시킨다\"],\"answer\":2,\"explain\":\"과거에 들은 말을 나중에 그대로 재현하는 것은 지연 반향어이며, 사례처럼 특정 상황에서 일관되게 나타나면 자기위로·요구 등 의사소통 기능을 지닌 것으로 본다. 중재는 기능을 인정하고 그 상황에서 '아파, 호', '과자 주세요'처럼 더 짧고 관습적·생성적인 발화를 모델링하여 점진적으로 대치(형성)하는 것이 원칙이다. ①·④는 기능을 무시한 억제, ③은 반향어를 생성적 언어로 오판한 것, ⑤는 비생성적 발화를 늘리는 잘못된 방향이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"지연 반향어 해석과 중재\",\"p\":\"상황별로 일관되게 재현되는 발화로 반향어 기능 판단 후 중재 선택\",\"n\":\"지연 반향어: 의사소통 기능 인정, 짧고 관습적인 발화로 점진적 대치\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 4학년 아동\\n• 낱말 해독·읽기 유창성: 학년 수준\\n• REVT 수용·표현 어휘: 정상 범위\\n• '물의 순환' 단원을 설명하게 하자 \\\"물이… 그리고 비가… 그래서…\\\"처럼 단문을 '그리고'로만 이어 붙이고 원인–결과 관계를 표현하지 못함\\n• 자발화에서 관형절('-는/-ㄴ')과 '-기 때문에', '-면' 등 종속 연결어미 사용이 거의 없음\\n• 사회·과학 교과 서술형 평가 점수가 낮음\",\"q\":\"이 아동에게 가장 적절한 중재는?\",\"choices\":[\"낱말 해독 정확도와 읽기 속도를 높이는 유창성 훈련\",\"교과 내용을 활용한 문장 결합과 설명담화 구조 지도\",\"일상 어휘의 양을 늘리기 위한 어휘 목록 암기 훈련\",\"이야기 문법 요소를 갖춘 허구적 이야기 다시 말하기\",\"음소 분리·합성 등 음운인식 과제 반복 훈련\"],\"answer\":2,\"explain\":\"해독·어휘는 정상이나 복문 구문과 설명담화(expository discourse) 구조화가 취약한 학령기 언어장애 프로파일이다. 학령기 중재는 교과 내용과 연계하여 관형절·종속 연결어미가 포함된 후기 구문을 문장 결합(sentence combining) 기법으로 지도하고, 원인–결과·비교–대조 등 설명담화 구조를 도식 조직자로 시각화하는 것이 적절하다. ①·⑤는 정상인 해독 영역, ③은 정상인 어휘량, ④는 이야기(서사) 담화로 이 아동의 핵심 결함(설명담화·복문)과 맞지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"이야기·담화\",\"k\":\"설명담화·복문 중재\",\"p\":\"해독·어휘 정상과 복문·인과 표현 결함으로 학령기 중재 선택\",\"n\":\"학령기 설명담화 중재: 교과 연계 문장 결합과 담화 구조 도식화\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"6세 아동의 그림책 이야기 다시 말하기\\n\\\"개구리가 있었어요. 아이가 잤어요. 개구리가 나갔어요. 아이가 일어났어요. 아이가 밖에 갔어요. 개구리를 찾았어요.\\\"\\n• 등장인물과 사건은 대체로 순서대로 나열함\\n• 개구리가 사라졌다는 계기사건에 대한 인물의 반응(놀람·걱정), 찾으려는 목표·시도의 이유가 전혀 표현되지 않음\\n• '그래서, 왜냐하면' 등 인과 표지 없음\",\"q\":\"이 아동의 이야기 중재로 가장 적절한 것은?\",\"choices\":[\"이야기 길이를 늘리기 위해 문장 수를 세어 목표 개수를 채우게 한다\",\"어휘다양도를 높이기 위해 새 낱말을 이야기에 넣게 한다\",\"그림 없이 듣기만으로 이야기를 기억해 말하는 청각 기억 훈련을 한다\",\"이야기 문법 요소를 시각 아이콘으로 제시하여 다시 말하기를 지도한다\",\"발화 명료도를 높이기 위해 조음 정확도를 먼저 훈련한다\"],\"answer\":4,\"explain\":\"사건을 나열만 하고 계기사건–내적 반응–시도의 인과적 연결이 빠진 것은 이야기 문법 구조의 결함이다. 이야기 문법 요소(계기사건·내적 반응·시도·결과)를 시각 아이콘으로 외현화하여 다시 말하기를 지도하고, 인물의 감정·의도 어휘와 '그래서·왜냐하면' 같은 인과 결속표지를 함께 목표로 하는 것이 근거 기반 이야기 중재이다. ①·②는 구조가 아닌 양적 지표만 겨냥하고, ③·⑤는 핵심 결함과 무관하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"이야기·담화\",\"k\":\"이야기 문법 중재\",\"p\":\"사건 나열과 내적 반응·시도 누락으로 이야기 중재 선택\",\"n\":\"이야기 문법 요소(계기사건·내적 반응·시도·결과) 시각화 다시 말하기\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 10개월 아동(초등 입학 예정) 평가\\n• 음절 수 세기, 음절 합성·분리: 90% 이상 정확\\n• 첫소리(초성) 변별·분리('공'의 첫소리?): 20%\\n• 자모 이름: 일부만 알고 소리값은 모름\\n• 낱말 읽기: 자기 이름 등 통문자 몇 개만 읽음\\n• 어휘·구문: 연령 수준\",\"q\":\"이 아동의 읽기 준비 중재로 가장 적절한 것은?\",\"choices\":[\"이미 습득한 음절 수준 인식 과제를 계속 반복하여 자동화한다\",\"통문자 카드로 자주 보는 낱말 100개를 암기시킨다\",\"음소 수준 인식을 글자–소리 대응과 통합하여 지도한다\",\"자모 이름만 완전히 외운 뒤 음소 인식은 초등 입학 후로 미룬다\",\"어휘 확장을 우선하여 읽기 이해의 기초를 다진다\"],\"answer\":3,\"explain\":\"음절 인식은 완성되었으나 음소 인식과 자소–음소 대응 지식이 부족한 상태이므로, 다음 단계인 음소 수준 인식(초성 변별·분리·합성)을 글자–소리(자소–음소) 대응과 통합하여 지도하는 것이 해독 습득에 가장 효과적이다. ①은 이미 숙달된 수준의 반복, ②는 알파벳 원리를 우회하는 방법, ⑤는 정상인 어휘를 목표로 삼음, ④는 음소 인식 지도를 불필요하게 지연시킨다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"읽기·쓰기\",\"k\":\"음소 인식 읽기 준비 중재\",\"p\":\"음절 인식 완성과 음소 인식·자모 소리값 부족으로 중재 선택\",\"n\":\"음소 수준 인식과 자소-음소 대응 통합 지도로 해독 습득 촉진\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"표현어휘가 지체된 3세 아동의 어머니에게 그림책 읽기 방법을 교육하였다.\\n• \\\"토끼가 먹는 건 뭐지?\\\"(빈칸 채우기), \\\"아까 토끼가 어디 갔었지?\\\"(회상)\\n• \\\"이 그림에서 무슨 일이 일어나고 있어?\\\"(개방형), \\\"이건 무슨 색이야?\\\"(wh-질문)\\n• \\\"우리 어제 공원에서 본 토끼 기억나?\\\"(경험과 연결)\\n• 아동이 대답하면 칭찬하고 그 말을 문장으로 다시 들려준 뒤 따라 말하게 함\",\"q\":\"이 부모교육에서 지도한 접근과 원리로 옳은 것은?\",\"choices\":[\"공유책읽기에서 어머니가 글을 정확히 끝까지 읽어 주는 것이 핵심이다\",\"반응적 상호작용 – 성인은 질문을 최소화하고 아동의 주도를 따라간다\",\"스크립트 중재 – 익숙한 일상 사건의 순서를 이용해 말하게 한다\",\"대화식 책읽기 – 질문으로 아동이 이야기의 화자가 되게 한다\",\"청각적 집중 자극 – 목표 낱말을 반복해서 들려주기만 한다\"],\"answer\":4,\"explain\":\"빈칸 채우기·회상·개방형·wh-·경험 연결(CROWD) 질문으로 아동을 이야기의 능동적 화자로 만들고, 아동의 반응을 촉진–평가–확장–반복(PEER)하여 어휘·표현을 촉진하는 것은 대화식 책읽기(dialogic reading)이다. ①은 수동적 읽어주기, ③은 사건 스크립트 활용, ②는 질문을 줄이는 접근으로 질문이 핵심인 이 방법과 반대이며, ⑤는 산출 유도 없이 입력만 주는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"대화식 책읽기 원리\",\"p\":\"질문 유형과 칭찬·확장 반응 절차로 부모교육 접근 식별\",\"n\":\"대화식 책읽기: CROWD 질문과 PEER 반응으로 아동을 이야기 화자로 만듦\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"3세 아동이 얼마 전까지 \\\"들어\\\", \\\"지어\\\"로 바르게 말하다가 최근 \\\"듣어요\\\", \\\"짓어요\\\", \\\"굽어요(구워요)\\\"처럼 말하기 시작했다. 부모는 '말이 퇴보한 것 같다'며 걱정한다.\",\"q\":\"이 현상에 대한 설명과 부모 상담 내용으로 옳은 것은?\",\"choices\":[\"문법형태소 습득이 퇴행한 것이므로 즉시 조음·문법 중재를 시작해야 한다\",\"과잉규칙화로 정상 발달 과정이며, 바른 형태를 모델링하도록 안내한다\",\"청각 문제로 어미를 잘못 듣는 것이므로 청력검사를 우선 의뢰한다\",\"성인의 잘못된 발음을 모방한 결과이므로 가족의 말을 교정해야 한다\",\"언어 처리 속도 저하의 징후이므로 작업기억 훈련이 필요하다\"],\"answer\":2,\"explain\":\"정확히 쓰던 불규칙 형태가 규칙형으로 바뀌는 것(과잉규칙화)은 아동이 단순 모방이 아니라 활용 규칙을 능동적으로 추출해 불규칙 용언에까지 적용한다는 증거로, U자형 발달의 정상 과정이다. 이는 행동주의(모방·강화)만으로 언어 습득을 설명하기 어렵다는 근거이기도 하다. 상담 시에는 병리가 아님을 설명하고 직접 교정보다 바른 형태를 자연스럽게 모델링(고쳐 말하기)하도록 안내한다. ①·③·⑤는 정상 현상을 병리로 오해한 것이며, ④는 성인 입력에는 없는 형태이므로 모방으로 설명되지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"문법·형태\",\"k\":\"과잉규칙화 부모 상담\",\"p\":\"바른 불규칙형에서 규칙형으로 바뀐 발화로 정상 발달 여부 판단\",\"n\":\"과잉규칙화: 활용 규칙 능동 추출의 증거, U자형 정상 발달·모델링 안내\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 발달성 언어장애 아동\\n• 비단어 따라말하기와 문장 따라말하기가 또래보다 현저히 낮음\\n• \\\"공을 집어서 상자에 넣고 문 옆에 두세요\\\" 같은 3단계 지시는 첫 단계만 수행\\n• 같은 지시를 한 단계씩 나누어 주면 모두 수행\\n• 빠른 속도로 말하면 이해가 급격히 떨어짐\",\"q\":\"이 아동의 정보처리 특성을 고려한 중재 원리로 가장 적절한 것은?\",\"choices\":[\"숫자 거꾸로 외우기 등 기억 훈련을 언어치료의 주 내용으로 한다\",\"입력 속도를 늦추고 정보를 나누어 제시하며 시각 지원으로 처리 부담을 줄인다\",\"처리 부담과 무관하게 연령 수준의 긴 문장을 그대로 제시하여 익숙해지게 한다\",\"이해가 어려운 것은 주의력 문제이므로 언어 중재 대신 주의력 훈련만 실시한다\",\"지시 따르기가 안 되면 같은 지시를 반복 연습시켜 순응을 높인다\"],\"answer\":2,\"explain\":\"비단어·문장 따라말하기 저조, 정보량·속도에 따른 이해 저하는 발달성 언어장애의 제한된 처리 용량(음운 작업기억·처리 속도)을 반영한다. 정보처리 관점의 중재는 입력 속도 감소, 단위 분할, 핵심어 강조·반복, 시각 지원 등으로 처리 부담을 조절하면서 목표 언어 형식의 학습을 촉진하는 것이다. ①은 언어와 분리된 기억 훈련의 전이 효과가 제한적이고, ③·⑤는 처리 특성을 무시하며, ④는 주의력 문제로 단정할 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"DLD 정보처리 고려 중재\",\"p\":\"따라말하기 저조와 정보량·속도 따른 이해 저하로 중재 원리 선택\",\"n\":\"DLD 처리 용량 제한: 입력 속도 감소·단위 분할·시각 지원으로 부담 조절\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 2학년, 사회적(화용) 의사소통장애 아동\\n• 어휘·구문·조음은 연령 수준\\n• 친구에게 다가가 대화를 시작하지 못하고, 시작하더라도 자기 관심사인 공룡 이야기만 계속함\\n• 친구가 지루해하는 표정을 알아채지 못함\\n• 치료실에서 배운 '인사하고 질문하기'를 교실에서는 사용하지 않음\",\"q\":\"이 아동의 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"어휘·문법형태소와 복문 산출 훈련을 우선하여 실시한다\",\"치료실에서 대화 규칙을 설명하고 문제집으로 정답을 고르게 한다\",\"역할놀이·비디오 모델링과 또래 참여로 교실 일반화를 계획한다\",\"조음 정확도 훈련으로 말의 명료도를 높여 친구가 더 잘 반응하도록 한다\",\"관심사(공룡) 이야기를 금지하여 대화 주제 독점을 줄인다\"],\"answer\":3,\"explain\":\"대화 시작·주제 유지·상대 반응 읽기 등 화용 결함은 실제 상호작용 맥락에서 역할놀이·비디오 모델링·또래 매개 중재(소집단)로 연습하고 자연 환경(교실)으로 일반화를 계획해야 효과가 있다. 언어 형식이 정상이므로 ①·④는 표적이 틀리고, ②는 지식 수준에 그쳐 일반화가 어려우며, ⑤는 관심사를 금지하기보다 상대 반응에 맞춰 주제를 조절하도록 지도하는 것이 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"화용·대화\",\"k\":\"화용 결함 일반화 중재\",\"p\":\"대화 시작·주제 유지 결함과 교실 미사용으로 중재 계획 선택\",\"n\":\"화용 중재: 역할놀이·비디오 모델링·또래 매개로 자연 환경 일반화\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"7세 다운증후군 아동\\n• 언어 이해가 표현보다 상대적으로 양호함\\n• 자발화 MLU가 짧고 조사·어미 생략이 잦음\\n• 숫자·낱말 따라말하기 등 청각적 단기기억이 매우 낮음\\n• 시각적 기억·그림 짝짓기 과제는 상대적 강점\\n• 저긴장으로 명료도가 낮음\",\"q\":\"이 아동의 강·약점 프로파일을 반영한 중재로 가장 적절한 것은?\",\"choices\":[\"청각 기억이 약하므로 긴 문장을 반복해서 들려주는 청각 훈련에 집중한다\",\"명료도가 낮으므로 구어를 중단하고 문자 소통으로 전환한다\",\"시각 지원을 병행하며 짧고 명확한 모델로 구문 산출을 목표로 한다\",\"이해가 양호하므로 표현 중재는 생략하고 이해 중심으로 진행한다\",\"시각 자료는 말에 집중하는 것을 방해하므로 사용하지 않는다\"],\"answer\":3,\"explain\":\"다운증후군은 이해 > 표현, 구문·문법형태소 취약, 청각적 단기기억 약점, 시각 처리 상대 강점이라는 전형적 프로파일을 보인다. 따라서 그림·글자·간단한 손짓 등 시각 지원을 병행해 구문·문법형태소 산출을 목표로 하고, 청각 기억 부담을 줄인 짧고 명확한 모델을 주는 것이 적절하다. ①·⑤는 약점에 부담을 주고 강점을 버리는 접근, ②는 구어 가능성을 포기하는 것, ④는 가장 취약한 표현 영역을 방치하는 것이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"다운증후군 강약점 중재\",\"p\":\"이해 우위·청각 기억 약점·시각 강점 프로파일로 중재 선택\",\"n\":\"다운증후군: 이해>표현, 청각 단기기억 약점, 시각 강점 활용 구문 중재\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 3학년 언어장애 아동을 담당하는 언어재활사가 담임교사와 매주 협의하여 다음 주 교과 수업의 핵심 어휘·개념을 미리 파악하고, 일부 회기는 교실에서 수업 활동에 참여하며 아동을 지원한다. 교사에게는 수업 중 아동에게 사용할 언어 촉진 전략을 안내한다.\",\"q\":\"이 서비스 전달 모델의 명칭과 주요 장점으로 옳은 것은?\",\"choices\":[\"분리(pull-out) 모델 – 조용한 환경에서 집중 훈련이 가능하다\",\"의료 모델 – 손상 부위와 원인에 따른 개별 치료가 가능하다\",\"자문 모델만 적용 – 언어재활사가 아동을 직접 보지 않아 효율적이다\",\"비연속 개별시도 모델 – 반응 정확도를 정밀하게 측정한다\",\"교실 중심·협력적 모델 – 교육과정 연계로 실제 환경 일반화를 촉진한다\"],\"answer\":5,\"explain\":\"교사와 협력해 교육과정 어휘를 목표로 삼고 교실에서 직접 지원하며 교사에게 전략을 자문하는 것은 교실 중심(pull-in)·협력적 서비스 모델로, 교육과정과 연계된 목표를 통해 학령기 아동의 실제 환경 일반화와 학업 성취를 촉진하는 것이 장점이다. ①은 치료실 분리 방식, ③은 직접 서비스가 병행되므로 틀리며, ②·④는 서비스 전달 모델의 분류가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"교실 중심 협력 모델\",\"p\":\"교사 협의·교실 참여·전략 자문 방식으로 서비스 전달 모델 식별\",\"n\":\"교실 중심·협력적 모델: 교육과정 연계로 실제 환경 일반화 촉진\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"4세 아동의 목표 '두 낱말 요구하기(예: 물 주세요)'가 치료실에서 치료사와의 간식 활동에서는 3회기 연속 90% 이상 산출된다. 그러나 어머니 보고에 따르면 가정에서는 여전히 손으로 가리키거나 울며, 어린이집에서도 요구 발화가 관찰되지 않는다.\",\"q\":\"다음 단계의 계획으로 가장 적절한 것은?\",\"choices\":[\"어린이집에서 말할 때까지 가정에서 원하는 것을 주지 말도록 지도한다\",\"치료실 정확도가 높으므로 목표를 종결하고 세 낱말 조합으로 넘어간다\",\"치료실에서 같은 과제의 정확도를 100%까지 더 높인 뒤 기다린다\",\"가정에서 산출이 없으므로 목표를 재설정하고 치료실 훈련을 반복한다\",\"부모·교사를 훈련해 가정·어린이집 일과에서 일반화를 촉진한다\"],\"answer\":5,\"explain\":\"치료실 준거는 도달했으나 다른 환경에서 나타나지 않는 것은 자극·환경 일반화 실패이므로, 다음 단계는 가정·어린이집으로 중재 환경을 옮기고 부모·교사가 일과 속에서 요구 기회를 만들고 자연적 강화로 반응하도록 훈련하며 사람·장소·사물을 다양화하는 것이다. ②·③은 일반화 없이 종결하거나 치료실에 머무는 것이고, ④는 이미 습득된 기술을 불필요하게 재훈련하며, ①은 비윤리적이고 좌절만 유발한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"환경 일반화 촉진 계획\",\"p\":\"치료실 준거 도달과 가정·기관 미산출로 다음 단계 계획 선택\",\"n\":\"환경 일반화 실패 시 부모·교사 훈련으로 일과 속 요구 기회 제공\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"언어 지체가 있는 28개월 아동과 어머니의 10분 놀이 상호작용 관찰\\n• 어머니 발화의 약 80%가 \\\"이건 뭐야?\\\", \\\"이거 해 봐\\\" 같은 질문·지시\\n• 아동이 자동차를 굴리며 소리를 내면 어머니는 그 행동을 보지 않고 그림책을 읽어 주려 함\\n• 아동이 발성·몸짓으로 시작한 행동에 어머니가 반응하는 비율이 낮음\\n• 아동의 놀이 주제와 어머니의 놀이 주제가 자주 어긋남\",\"q\":\"이 관찰에 근거한 부모 코칭의 우선 목표로 가장 적절한 것은?\",\"choices\":[\"소리만 내면 반응하지 말고 낱말을 말할 때만 반응하게 한다\",\"아동이 말할 때까지 질문 횟수를 더 늘려 산출 기회를 확보하게 한다\",\"놀이보다는 그림카드로 낱말 이름대기를 매일 30분 훈련하게 한다\",\"어머니가 정한 주제로 놀이를 이끌어 아동이 따라오게 한다\",\"아동 주도 따르기·즉각 반응·확장 등 반응적 전략을 지도한다\"],\"answer\":5,\"explain\":\"지시·질문 위주의 성인 주도 상호작용과 아동의 시작 행동에 대한 낮은 반응성은 초기 언어 발달을 저해한다. 부모 매개 중재(Hanen 등)의 핵심은 관찰–기다리기–경청, 아동의 관심·주도 따라가기, 시작 행동에 즉시 반응하기, 행동·발성을 모방·해석해 말로 들려주고 확장하기 같은 반응적 상호작용 전략이다. ②·④는 성인 주도를 강화하고, ③은 자연스러운 상호작용을 훈련으로 대체하며, ①은 언어 이전 의사소통 시도를 무시해 시작 행동을 오히려 줄인다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"반응적 상호작용 부모 코칭\",\"p\":\"질문·지시 위주와 낮은 반응성 관찰로 부모 코칭 목표 선택\",\"n\":\"반응적 전략: 아동 주도 따르기·즉각 반응·모방·확장\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"자폐스펙트럼장애 아동 3명에게 그림교환 기반 '요구하기' 중재를 적용하려 한다.\\n• 목표행동: 자발적 요구하기 횟수\\n• 한 번 습득된 요구하기는 중재를 철회해도 쉽게 사라지지 않을 것으로 예상됨\\n• 중재 효과를 실험적으로 입증하고 싶으나, 습득된 기술을 일부러 되돌리는 것은 윤리적으로 부적절하다고 판단함\",\"q\":\"이 상황에 가장 적합한 단일대상연구 설계는?\",\"choices\":[\"대상자 간 중다기초선 설계\",\"ABAB(반전) 설계\",\"교대중재(중재교대) 설계\",\"단일 AB 설계\",\"기준변경(준거변경) 설계\"],\"answer\":1,\"explain\":\"대상자 간 중다기초선 설계는 여러 대상에게 시차를 두고 중재를 도입하여, 중재를 철회(반전)하지 않고도 중재가 시작된 대상에서만 변화가 나타남을 보여 실험적 통제를 입증한다. 비가역적 행동·윤리적 이유로 반전이 어려운 상황에 적합하다. ABAB는 중재 철회가 필요하므로 부적합하고, AB 설계는 실험적 통제가 없으며, 교대중재는 둘 이상의 중재를 비교할 때, 기준변경 설계는 이미 레퍼토리에 있는 행동의 수준을 단계적으로 높일 때 사용한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"단일대상연구 설계 선택\",\"p\":\"비가역적 행동과 반전 불가 조건으로 적합한 연구 설계 선택\",\"n\":\"대상자 간 중다기초선 설계: 시차 도입으로 반전 없이 실험적 통제 입증\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"단일대상연구 자료(정반응률 %)\\n• 기초선(A) 5회기: 20, 30, 25, 35, 30\\n• 중재(B) 8회기: 40, 30, 55, 60, 70, 65, 80, 85\",\"q\":\"비중복 자료 비율(PND)로 옳은 것은?\",\"choices\":[\"62.5%\",\"75.0%\",\"100%\",\"87.5%\",\"50.0%\"],\"answer\":4,\"explain\":\"PND는 기초선의 최고점(35)을 초과하는 중재기 자료점의 비율이다. 중재기 8개 중 35를 초과하는 값은 40, 55, 60, 70, 65, 80, 85의 7개이므로 7/8 = 87.5%이다. 두 번째 자료점(30)은 기초선 최고점과 중복되어 제외된다. ※PND 해석 기준(예: 90% 이상 매우 효과적, 70~90% 효과적 등)은 교재별로 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"연구·통계\",\"k\":\"PND 산출\",\"p\":\"기초선 최고점 초과 중재기 자료점 비율로 PND 산출\",\"n\":\"PND는 기초선 최고점을 초과하는 중재기 자료점 수를 전체 중재기 자료점 수로 나눈 비율\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"두 명의 언어재활사가 5세 아동의 자발화 60개 발화에 대해 형태소 분석을 독립적으로 수행하고, 발화별 형태소 수의 일치 여부를 비교하였다.\\n• 일치: 51개 발화\\n• 불일치: 9개 발화\",\"q\":\"발화별(point-by-point) 평가자 간 일치율과 그에 따른 판단으로 옳은 것은?\",\"choices\":[\"15%로, 분석 기준을 재정비한 뒤 전체 자료를 재분석한다\",\"51%로, 분석 기준을 재정비한 뒤 전체 자료를 재분석한다\",\"85%로, 수용 가능한 수준이며 분석 자료로 사용할 수 있다\",\"85%이나 90%에 못 미쳐 자료를 폐기하고 새로 수집한다\",\"567%로, 일치 수를 불일치 수로 나누어 산출한 값이다\"],\"answer\":3,\"explain\":\"발화별 일치율 = 일치 ÷ (일치 + 불일치) × 100 = 51 ÷ 60 × 100 = 85%이다. 일반적으로 80% 이상이면 수용 가능한 신뢰도로 본다. 51%·15%는 산출 오류이고, 90% 미만이라고 자료를 폐기하는 것은 과도한 조치이다. ※수용 기준(80% 또는 90%)은 교재·연구 설계에 따라 다를 수 있음.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"연구·통계\",\"k\":\"평가자 간 일치율 산출\",\"p\":\"일치·불일치 발화 수로 발화별 일치율을 계산해 수용 여부 판단\",\"n\":\"발화별 일치율=일치÷(일치+불일치)×100, 일반적으로 80% 이상 수용 가능\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"만 4세 6개월 아동의 표준화 언어검사 결과(평균 100, 표준편차 15)\\n• 수용어휘 표준점수 76\\n• 표현어휘 표준점수 94\\n• 검사 시 협조 양호, 청력 정상\",\"q\":\"이 결과의 해석과 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"수용어휘 지체로 보고 이해 중재를 우선하며 표현어휘는 모니터링한다\",\"표현어휘가 수용어휘보다 낮으므로 표현어휘 중재를 우선 실시한다\",\"수용어휘 76은 −1SD 이내의 경계선 수준이므로 관찰만 한다\",\"두 영역 모두 정상범위이므로 중재 없이 6개월 후 재평가한다\",\"표준점수 18점 차이는 측정 오차 범위로 두 영역을 동일 수준으로 본다\"],\"answer\":1,\"explain\":\"표준점수 76은 z = (76−100)/15 = −1.6SD로 백분위 약 5에 해당하여 지체 범위이고, 94는 −0.4SD로 정상범위이다. 따라서 수용어휘(이해)가 우선 중재 목표가 된다. 표현어휘가 더 낮다는 해석(2)과 −1SD 이내라는 해석(3)은 수치상 틀렸으며, 18점 차이는 1SD 이상으로 오차 범위로 보기 어렵다. ※지체 판정 절단점(−1SD, −1.25SD, −1.5SD, −2SD)은 검사·교재별로 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"통합 사례\",\"k\":\"표준점수 해석과 중재 우선순위\",\"p\":\"수용·표현어휘 표준점수의 SD 위치로 지체 영역과 중재 우선순위 판단\",\"n\":\"표준점수 76은 약 -1.6SD로 지체 범위, 94는 정상범위이므로 수용어휘 중재 우선\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"종합병원에 근무하는 언어재활사가 퇴근 후 개인 언어재활센터를 운영하고 있다. 병원에서 치료 중인 실어증 환자의 보호자에게 \\\"병원보다 제 센터에 오시면 더 자주 볼 수 있다\\\"며 자신의 센터 명함을 건네고 병원 치료 종결을 권유하였다.\",\"q\":\"이 행동에 대한 윤리적 판단과 바람직한 대처로 가장 적절한 것은?\",\"choices\":[\"환자에게 더 많은 치료 기회를 주는 것이므로 윤리적 문제가 없다\",\"병원장에게 사후 보고를 하면 윤리적 문제가 모두 해소된다\",\"보호자가 동의했다면 비밀유지 의무 위반이 아니어서 허용된다\",\"치료 강도를 높이려는 시도로 전문성 유지 의무에 부합한다\",\"이해상충 행위이며, 기관 의뢰 절차와 환자 선택권을 지켜야 한다\"],\"answer\":5,\"explain\":\"언어재활사는 내담자의 이익을 최우선으로 해야 하며, 자신의 경제적 이익을 위해 내담자를 유인하는 것은 이해상충(이중관계) 위반이다. 기관 간 의뢰가 임상적으로 필요하면 소속 기관의 절차를 따르고 환자의 자기결정권(기관 선택권)을 보장해야 한다. 이 사례의 핵심 쟁점은 비밀유지나 전문성 유지가 아니라 이해상충이며, 사후 보고만으로는 위반이 해소되지 않는다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"내담자 유인 이해상충\",\"p\":\"소속 기관 환자를 개인 센터로 유인한 행위의 윤리 쟁점 판단\",\"n\":\"경제적 이익을 위한 내담자 유인은 이해상충, 기관 의뢰 절차와 환자 선택권 보장\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"5세 아동이 치료실에 올 때마다 팔과 등에 새로운 멍이 있고, 놀이 중 \\\"아빠가 밤에 때려서 아파\\\"라고 말하였다. 보호자는 \\\"애가 잘 넘어진다\\\"고 하였다.\",\"q\":\"언어재활사의 대처로 가장 적절한 것은?\",\"choices\":[\"학대 증거가 확실해질 때까지 몇 주 더 관찰한 뒤 신고 여부를 결정한다\",\"보호자에게 사실 여부를 먼저 따져 물은 뒤, 인정하면 신고한다\",\"기관장에게 구두로 보고하는 것으로 신고 의무를 다한 것으로 본다\",\"즉시 112에 신고하고, 관찰한 내용을 객관적으로 기록해 둔다\",\"아동에게 반복 질문하여 피해 진술을 상세히 확보한 뒤 신고한다\"],\"answer\":4,\"explain\":\"아동학대는 '의심'만으로도 즉시 신고해야 하며, 확증을 기다리거나 보호자에게 먼저 확인하는 것은 아동을 더 위험하게 할 수 있다. 재활·복지·의료기관 종사자는 아동학대 신고의무자에 해당하므로 정당한 사유 없이 신고하지 않으면 과태료 대상이 된다. 기관 내 보고는 신고를 대신하지 못하고, 아동에게 반복 질문하는 것은 2차 피해와 진술 오염을 초래할 수 있다. ※신고의무자 범위·과태료 등 법 조항은 최신 「아동학대처벌법」 기준으로 확인 권장.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"법·제도\",\"k\":\"아동학대 신고의무\",\"p\":\"학대 의심 정황에서 신고의무자의 적절한 대처 선택\",\"n\":\"아동학대는 의심만으로 즉시 신고, 기관 내 보고는 신고를 대신하지 못함\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"36개월 말늦은 아동의 어머니가 인터넷에서 본 '구강 감각 브러싱 프로그램'을 언어치료 대신 해 달라고 강하게 요청하였다. 언어재활사가 문헌을 검토한 결과, 해당 프로그램이 언어 산출을 향상시킨다는 통제된 연구 근거는 확인되지 않았다.\",\"q\":\"근거기반실제(EBP)에 따른 가장 적절한 대응은?\",\"choices\":[\"보호자의 요구가 우선이므로 요청한 브러싱 프로그램만 시행한다\",\"보호자 의견은 배제하고 치료사가 정한 프로그램만 시행한다\",\"근거를 설명하고, 입증된 대안을 제안해 가족과 함께 결정한다\",\"근거가 없는 중재를 요구하므로 치료를 종결하고 타 기관을 안내한다\",\"임상 경험상 효과를 본 사례가 있다면 근거로 충분하므로 시행한다\"],\"answer\":3,\"explain\":\"EBP는 ①최선의 연구 근거 ②임상 전문성 ③내담자·가족의 가치와 선호를 통합하여 의사결정하는 것이다. 근거 검토 결과를 이해하기 쉽게 설명하고 효과가 입증된 대안(예: 부모 실행 언어촉진)을 제시하면서 가족의 우선순위·가치를 반영해 공동으로 결정하는 것이 세 요소를 모두 반영한다. 보호자 요구만 따르거나(1), 가족 가치를 배제하거나(2), 종결하거나(4), 개인 경험만을 근거로 삼는 것(5)은 EBP의 어느 한 요소만 취하거나 모두 무시한 대응이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"상담\",\"k\":\"근거기반실제 보호자 대응\",\"p\":\"근거 없는 중재 요구 상황에서 EBP 3요소를 통합한 대응 선택\",\"n\":\"EBP는 연구 근거·임상 전문성·내담자 가치의 통합, 근거 설명 후 대안 제시와 공동 결정\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"회기 기록 내용\\n㉠ 어머니: \\\"주말에 집에서 '물 주세요'를 스스로 두 번 말했어요.\\\"\\n㉡ 그림 자극 20개 중 14개(70%)에서 2어 조합을 자발 산출, 구어 촉진 시 18개(90%)\\n㉢ 지난 회기(55%) 대비 향상되었으나 준거(80%, 3회기 연속)에는 아직 미달\\n㉣ 다음 회기부터 촉진을 시간지연으로 점차 줄이고 놀이 상황으로 확장\",\"q\":\"SOAP 기록 형식에서 각 항목이 해당하는 영역으로 옳은 것은?\",\"choices\":[\"㉠ O, ㉡ S, ㉢ A, ㉣ P\",\"㉠ S, ㉡ A, ㉢ O, ㉣ P\",\"㉠ S, ㉡ O, ㉢ A, ㉣ P\",\"㉠ A, ㉡ O, ㉢ P, ㉣ S\",\"㉠ S, ㉡ O, ㉢ P, ㉣ A\"],\"answer\":3,\"explain\":\"S(주관적)는 보호자·대상자의 보고(㉠), O(객관적)는 측정·관찰된 수행 자료(㉡), A(평가)는 자료에 대한 임상적 해석과 진전 판단(㉢), P(계획)는 다음 회기 계획(㉣)이다. 수치 자료(㉡)를 주관적 정보로, 진전 판단(㉢)을 객관적 자료로 분류한 보기는 틀렸다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"SOAP 기록 구분\",\"p\":\"회기 기록 각 내용의 성격에 따라 SOAP 영역 식별\",\"n\":\"SOAP: S 보호자 보고, O 측정 자료, A 임상적 해석·진전 판단, P 다음 회기 계획\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"지적장애 6세 아동은 언어재활사가 \\\"이거 뭐야? 사과\\\"라고 완전한 구어 모델을 제시할 때만 '사과'를 산출하며, 모델 없이 자발적으로 명명하는 경우는 거의 없다. 모델 제공 조건에서의 정반응률은 95%에 이르렀다.\",\"q\":\"촉진 의존을 줄이고 자발 산출을 늘리기 위한 절차로 가장 적절한 것은?\",\"choices\":[\"매 시행마다 완전 구어 모델을 계속 제공하여 정확도를 유지한다\",\"모델 제시 전 대기 시간을 점차 늘리는 시간지연을 적용한다\",\"촉진 강도를 더 높여 모델과 함께 신체적 촉진을 추가한다\",\"촉진을 한 번에 모두 제거하고 오반응이 나오면 무시한다\",\"정반응이 나올 때까지 같은 자극을 연속 10회 반복 제시한다\"],\"answer\":2,\"explain\":\"습득이 완료된 반응이 촉진에 의존할 때는 자극 제시 후 모델 제공까지의 대기 시간을 0초에서 2초, 4초로 점진적으로 늘리는 시간지연 절차로 촉진을 체계적으로 소거하여 자극 통제를 촉진에서 자연 자극으로 옮긴다. 촉진을 계속 주면 의존이 유지되고, 한 번에 제거하면 오류가 급증하며, 촉진 강도를 높이는 것은 오히려 의존을 강화한다. 단순 반복 제시는 촉진 소거 원리에 해당하지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"통합 사례\",\"k\":\"시간지연 촉진 소거\",\"p\":\"모델 촉진 의존 양상으로 자발 산출 유도 절차 선택\",\"n\":\"시간지연: 모델 제공 전 대기 시간을 점진적으로 늘려 촉진을 체계적으로 소거\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"5세 언어발달지연 아동에게 세 가지 목표(과거시제 '-았/었-', 조사 '-에서', 접속어 '그래서')를 설정하였다. 언어재활사는 한 목표를 3회기씩 다루되, 아동이 준거에 도달하지 않더라도 정해진 회기가 끝나면 다음 목표로 넘어가고, 세 목표를 한 바퀴 돈 뒤 다시 첫 목표로 돌아오도록 계획하였다.\",\"q\":\"이 계획에 해당하는 목표 공격 전략과 그 근거로 옳은 것은?\",\"choices\":[\"주기적 접근 – 여러 형태가 동시에 점진적으로 발달함을 반영\",\"수직적 접근 – 한 목표를 준거까지 집중 훈련한 뒤 다음 목표로 이동\",\"수평적 접근 – 여러 목표를 한 회기 안에서 준거 도달까지 동시에 훈련\",\"위계적 접근 – 발달 순서대로 한 목표씩 준거까지 순차적으로 훈련\",\"선택적 접근 – 아동이 선호하고 흥미를 보이는 목표만 골라 훈련\"],\"answer\":1,\"explain\":\"정해진 기간 동안 각 목표를 다루고 준거 도달과 무관하게 순환하는 방식은 주기적(cyclical) 접근이며, 여러 형태가 점진적·동시적으로 발달한다는 자연 습득 원리를 반영한다. 수직적 접근은 준거 도달까지 한 목표만 훈련하고, 수평적 접근은 한 회기 안에 여러 목표를 동시에 준거까지 훈련하므로 이 계획과 다르다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"통합 사례\",\"k\":\"목표 공격 전략 구분\",\"p\":\"준거와 무관하게 목표를 순환하는 계획으로 목표 공격 전략 식별\",\"n\":\"주기적 접근: 정해진 기간씩 목표 순환, 여러 형태의 점진적·동시적 발달 반영\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"7세 말소리장애 아동이 치료실에서 /ㅅ/ 어두·어중·어말 낱말 수준에서 3회기 연속 90% 이상 정조음하여 준거에 도달하였다. 그러나 보호자는 집과 학교 대화에서는 여전히 /ㅅ/→[ㄷ] 오류가 많다고 보고하였다.\",\"q\":\"이 시점에서 가장 적절한 결정은?\",\"choices\":[\"치료실 준거를 충족하였으므로 즉시 종결하고 추후 점검만 한다\",\"낱말 수준을 처음부터 다시 반복하여 정확도를 더 높인다\",\"일반화는 자연히 일어나므로 회기를 늘리지 않고 기다린다\",\"목표음을 /ㅈ/으로 바꾸어 새로운 목표 훈련을 시작한다\",\"대화 수준·다양한 상황으로 확장하고 보호자 훈련을 병행한다\"],\"answer\":5,\"explain\":\"종결 결정은 치료실 준거뿐 아니라 일상 상황으로의 일반화 자료를 근거로 해야 한다. 이 아동은 낱말 수준에서만 준거에 도달했으므로 문장·대화 수준으로 확장하고 상황·대화 상대를 다양화하며 보호자를 훈련하여 일반화를 프로그래밍한 뒤, 회기 간격을 늘리는 점진적 종결과 추후 점검을 계획한다. 즉시 종결·자연 대기는 일반화 실패를 방치하고, 낱말 수준 반복이나 목표 변경은 현재 문제(일반화)를 다루지 못한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"통합 사례\",\"k\":\"일반화·종결 결정\",\"p\":\"치료실 준거 도달과 일상 전이 실패로 다음 결정 선택\",\"n\":\"종결은 일상 일반화 자료로 결정, 대화 수준·상황 확대와 보호자 훈련으로 일반화 프로그래밍\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"통합어린이집의 4세 아동에게 '또래에게 먼저 말이나 몸짓으로 의사소통을 시작하기'를 목표로 설정하였다. 자유놀이 30분 동안 이 행동은 하루 2~5회 정도 드물게 나타나며, 시작과 끝이 분명하다.\",\"q\":\"이 목표행동의 진전을 측정하기에 가장 적합한 자료수집 방법은?\",\"choices\":[\"지속시간 기록법(각 시도가 이어진 시간을 초 단위로 잰다)\",\"영속적 산물 기록법(활동 후 남은 결과물을 확인한다)\",\"부분간격 기록법(10초 간격 중 한 번이라도 발생하면 기록한다)\",\"지연시간 기록법(교사 지시 후 반응까지의 시간을 잰다)\",\"사건(빈도) 기록법(관찰 시간 중 발생 횟수를 센다)\"],\"answer\":5,\"explain\":\"시작과 끝이 분명한 이산 행동이 낮은 빈도로 나타날 때는 사건(빈도) 기록이 가장 적합하며, 관찰 시간이 달라질 수 있으므로 비율(회/분)로 환산한다. 지속시간·지연시간 기록은 '얼마나 오래·얼마나 빨리'가 목표일 때, 간격기록은 고빈도이거나 지속적인 행동에, 영속적 산물 기록은 결과물이 남는 행동에 적합하다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"연구·통계\",\"k\":\"행동 자료수집 방법\",\"p\":\"목표행동의 빈도와 시작·끝 명확성으로 기록법 선택\",\"n\":\"시작과 끝이 분명한 저빈도 이산 행동은 사건(빈도) 기록법, 필요 시 비율로 환산\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"초등 2학년 특수교육대상 아동(경도 지적장애)이 통합학급에서 교사의 지시 이해와 발표에 어려움을 보인다. 개별 치료실에서는 목표 문장을 잘 산출하지만 교실에서는 거의 사용하지 않는다. 담임교사는 교실에서 어떻게 도와야 할지 모르겠다고 한다.\",\"q\":\"이 아동에게 가장 적절한 서비스 전달 모형은?\",\"choices\":[\"분리(pull-out) 개별치료의 회기 수를 두 배로 늘린다\",\"교사에게 치료 보고서만 전달하고 교실 지원은 교사에게 맡긴다\",\"치료실에서 교과 학습지를 풀게 하여 학업 내용을 보충한다\",\"교실 기반 협력 모형으로 수업 중 목표를 다루고 교사를 코칭한다\",\"아동을 특수학급으로 전일 배치하여 집중 지도하도록 권고한다\"],\"answer\":4,\"explain\":\"치료실에서 습득한 기술이 교실로 일반화되지 않고 교사가 지원 방법을 모르는 상황에서는, 실제 교실 맥락에서 목표를 훈련하고 교사와 협력하는 교실 기반·협력 모형이 적합하다. 분리 치료를 늘리는 것은 일반화 문제를 해결하지 못하고, 보고서 전달만으로는 교사 역량이 강화되지 않으며, 학습지 풀이나 전일 특수학급 배치는 의사소통 목표와 최소제한환경 원칙에 맞지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"윤리·역할\",\"k\":\"서비스 전달 모형 선택\",\"p\":\"치료실 기술의 교실 일반화 실패와 교사 요구로 서비스 모형 선택\",\"n\":\"교실 기반 협력 모형: 실제 교실 맥락에서 목표를 다루고 교사를 코칭\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"도서 지역에 거주하는 5세 말소리장애 아동의 보호자가 화상 원격 언어치료를 요청하였다. 아동은 화면 주의집중이 짧은 편이고, 가정에는 태블릿과 인터넷이 있다.\\n\\nㄱ. 아동의 원격치료 적합성(주의집중·청각 환경·기기 조작 등)을 사전에 평가한다\\nㄴ. 보호자를 회기 보조자(e-helper)로 교육하여 자료 제시·촉진을 돕게 한다\\nㄷ. 개인정보 보호가 가능한 보안 플랫폼을 사용하고, 녹화 시 사전 동의를 받는다\\nㄹ. 원격치료에서는 대면치료와 달리 자격·윤리 기준이 완화되어 적용된다\",\"q\":\"원격치료 실시 전 고려사항으로 옳은 것을 모두 고른 것은?\",\"choices\":[\"ㄱ, ㄴ\",\"ㄱ, ㄴ, ㄷ\",\"ㄴ, ㄹ\",\"ㄱ, ㄷ, ㄹ\",\"ㄱ, ㄴ, ㄷ, ㄹ\"],\"answer\":2,\"explain\":\"원격치료는 대상자 적합성 평가, 현장 보조자(e-helper) 교육, 보안 플랫폼과 녹화 동의 등 개인정보 보호가 필수이다. 원격치료도 대면치료와 동일한 자격·윤리·서비스 질 기준이 적용되므로 ㄹ은 틀렸다. 주의집중이 짧은 아동일수록 보호자 보조자 역할이 중요하다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"원격치료 사전 고려사항\",\"p\":\"원격치료 실시 전 필요 조건과 적용 기준의 옳고 그름 판단\",\"n\":\"원격치료는 적합성 평가·e-helper 교육·보안과 동의가 필수, 자격·윤리 기준은 대면과 동일\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"자폐스펙트럼장애 평가 결과를 들은 아버지가 \\\"우리 애는 눈도 잘 맞추는데 검사가 잘못된 거 아닙니까? 선생님이 뭘 안다고요\\\"라며 언성을 높였다.\",\"q\":\"언어재활사의 반응으로 가장 적절한 것은?\",\"choices\":[\"검사 점수표를 다시 보여주며 결과가 객관적임을 조목조목 입증한다\",\"진단명을 언급하지 않기로 하고 결과 설명을 모두 생략한다\",\"부정하는 반응은 협조 거부이므로 상담을 종료하고 다른 기관을 안내한다\",\"\\\"아버님이 인정하지 않으면 아이가 더 나빠집니다\\\"라고 경고한다\",\"\\\"많이 놀라고 속상하셨겠어요\\\"라고 감정을 먼저 반영한다\"],\"answer\":5,\"explain\":\"진단 통보 후 부정·분노는 정상적인 애도 반응이다. 상담자는 먼저 반영적 경청과 공감으로 감정을 수용하고, 보호자가 정보를 받아들일 준비가 되었을 때 구체적 관찰 근거를 함께 살펴보며 단계적으로 공유해야 한다. 즉각적 논증(1)이나 경고(4)는 방어를 강화하고, 상담 종료(3)나 정보 생략(2)은 보호자의 알 권리와 라포 형성에 어긋난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"상담\",\"k\":\"진단 통보 후 부정 반응\",\"p\":\"진단 결과에 분노하는 보호자에게 적절한 상담 반응 선택\",\"n\":\"진단 후 부정·분노는 정상적 애도 반응, 감정 반영과 공감으로 먼저 수용\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"6세 남아. 3개월 이상 지속되는 쉰 목소리로 어린이집 교사가 언어재활센터에 의뢰하였다. 아동은 소리 지르기가 잦고, 최근 목소리가 자주 갈라지며 말할 때 숨이 찬다고 한다. 이비인후과 진료를 받은 적은 없다.\",\"q\":\"언어재활사의 대처로 가장 적절한 것은?\",\"choices\":[\"진단 의뢰 없이 음성위생 교육과 음성치료를 즉시 시작한다\",\"성장하면 저절로 좋아지므로 경과 관찰만 하도록 권한다\",\"쉰 목소리는 소리 지르기 때문이므로 조음치료로 대체해 진행한다\",\"이비인후과 후두 검진을 먼저 의뢰하고 진단에 따라 계획한다\",\"보호자에게 약국에서 목 스프레이를 구입하도록 안내한다\"],\"answer\":4,\"explain\":\"지속되는 음성 문제는 성대결절 외에도 유두종·낭종 등 의학적 처치가 필요한 병변일 수 있으므로, 음성치료 전에 이비인후과 후두 검진(후두내시경)으로 원인을 확인하고 의학적 진단을 바탕으로 치료 계획을 세운다. 진단 없이 치료를 시작하거나(1) 경과만 관찰하는 것(2)은 병변을 놓칠 수 있고, 조음치료 대체(3)나 약 구입 안내(5)는 언어재활사의 업무 범위와 의뢰 원칙에 맞지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"윤리·역할\",\"k\":\"지속 애성 의뢰 원칙\",\"p\":\"진료 이력 없는 지속 음성 문제에서 치료 전 조치 선택\",\"n\":\"지속되는 음성 문제는 음성치료 전 이비인후과 후두 검진으로 의학적 원인 확인\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"18개월 발달지연 영아의 조기개입 팀에 언어재활사·작업치료사·물리치료사·특수교사가 참여한다. 팀은 가족 부담을 줄이기 위해 함께 평가(아레나 평가)하고, 가족과 가장 자주 만나는 특수교사 1명이 주 서비스 제공자가 되어, 다른 전문가가 훈련해 준 언어촉진·자세 지원 전략을 가정 일과에서 통합적으로 실행하도록 하였다.\",\"q\":\"이 팀 모형과 그 핵심 특징으로 옳은 것은?\",\"choices\":[\"다학문적 팀 – 각 전문가가 독립적으로 평가·중재하고 결과만 공유한다\",\"초학문적 팀 – 역할방출을 통해 한 전문가가 통합적으로 중재를 실행한다\",\"다학문적 팀 – 공동 평가 후 한 전문가에게 다른 전문가의 역할을 방출한다\",\"간학문적 팀 – 각자 평가하되 계획을 공동으로 수립하고 중재는 각자 실행한다\",\"협의형 팀 – 언어재활사는 자문만 제공하고 평가에는 참여하지 않는다\"],\"answer\":2,\"explain\":\"공동(아레나) 평가, 역할방출, 주 서비스 제공자를 통한 통합 중재는 초학문적 팀 모형의 핵심 특징이다. 다학문적 팀은 독립적 평가·중재 후 결과만 공유하고, 간학문적 팀은 계획은 공동으로 세우되 중재는 각 전문가가 따로 실행한다. 역할방출은 다학문적 팀의 특징이 아니다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"조기개입 팀 모형 구분\",\"p\":\"공동 평가와 주 서비스 제공자 운영 방식으로 팀 모형 식별\",\"n\":\"초학문적 팀: 아레나 평가, 역할방출, 주 서비스 제공자의 통합 중재\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"어린이집 담임교사가 전화로 \\\"우리 반 아동의 언어평가 결과와 진단명을 알려 달라. 교육에 참고하겠다\\\"고 요청하였다. 보호자에게는 이 요청에 대해 아직 알리지 않은 상태이다.\",\"q\":\"가장 적절한 대처는?\",\"choices\":[\"보호자 서면 동의를 받은 뒤 필요한 범위에서 제공한다\",\"진단명은 알려주지 않고 표준점수 등 수치 결과만 알려준다\",\"교사가 소속 기관 공문을 보내면 보호자 동의 없이 제공한다\",\"먼저 교사에게 결과를 제공한 뒤 보호자에게 사후 통보한다\",\"교육 목적의 요청이므로 요약 결과를 전화로 알려준다\"],\"answer\":1,\"explain\":\"평가 결과·진단명은 민감한 개인정보이므로 제3자 제공에는 정보주체(보호자)의 명시적 동의가 필요하며, 동의서에는 제공 목적·범위·대상이 포함되어야 한다. 교육 목적, 기관 공문, 부분 정보 제공, 사후 통보는 모두 동의 없는 제공에 해당하여 비밀유지 의무와 개인정보보호 원칙에 위배된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"평가 정보 제3자 제공\",\"p\":\"교사의 결과 요청 상황에서 개인정보 제공 절차 선택\",\"n\":\"평가 결과·진단명의 제3자 제공은 보호자 서면 동의 후 필요한 범위에서만 허용\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활센터 원장(1급 언어재활사)이 자격이 없는 직원에게 자신의 자격증을 빌려주어, 언어재활사 명의로 아동 치료를 하게 하였다.\",\"q\":\"「장애인복지법」상 이 원장에 대한 조치로 옳은 것은?\",\"choices\":[\"보수교육을 추가로 이수하면 갈음된다\",\"1회 위반이므로 경고 처분에 그친다\",\"자격증 대여는 자격 취소 사유에 해당한다\",\"최대 1년 이내의 자격정지만 가능하다\",\"원장은 처분 대상이 아니고 직원만 책임진다\"],\"answer\":3,\"explain\":\"「장애인복지법」은 언어재활사가 자격증을 다른 사람에게 대여한 경우를 자격 취소 사유로 규정하며, 대여받거나 알선한 사람도 처벌 대상이다. 경고·보수교육·자격정지로 갈음되지 않고, 대여한 원장 본인이 처분 대상이다. ※자격취소·정지 사유의 세부 조항(제74조 등)과 벌칙은 최신 법령으로 확인 권장.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"법·제도\",\"k\":\"자격증 대여 처분\",\"p\":\"자격증 대여 행위에 대한 장애인복지법상 처분 판단\",\"n\":\"장애인복지법상 언어재활사 자격증 대여는 자격 취소 사유, 대여한 본인이 처분 대상\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"24개월 아동이 표현 낱말 8개로 말늦은 아동에 해당하며, 이해력과 놀이·상징 발달은 연령 수준이다. 맞벌이 부모는 주 1회 센터 방문도 어렵다고 호소하며, 집에서 어떻게 도와야 할지 모르겠다고 한다.\",\"q\":\"이 가족에게 가장 적절한 중재 접근은?\",\"choices\":[\"센터 방문을 주 3회로 늘려 치료사 주도의 개별치료를 집중 실시한다\",\"가정 일과 속 언어촉진 전략을 부모가 실행하도록 코칭한다\",\"이해력이 정상이므로 만 3세까지 아무 중재 없이 기다린다\",\"어린이집에 보내는 것만으로 충분하므로 별도 중재는 하지 않는다\",\"보호자에게 매일 낱말 카드 학습지를 풀게 하도록 지시한다\"],\"answer\":2,\"explain\":\"조기개입은 가족중심·일과 기반 실제가 원칙이며, 말늦은 아동에게는 부모 실행 언어촉진 중재의 근거가 확립되어 있다. 식사·목욕·놀이 등 가정 일과에 모델링·확장·기다리기 같은 전략을 심도록 부모를 코칭하고, 필요 시 화상 코칭을 병행하며 정기적으로 진전을 점검한다. 가족의 시간 제약을 고려하면 치료사 주도 방문 증가(1)는 실현 가능성이 낮고, 학습지(5)는 영아의 자연스러운 언어 습득에 맞지 않으며, 위험 요인이 있는 아동을 무중재로 기다리거나(3) 어린이집에만 맡기는 것(4)은 적절한 모니터링·촉진을 놓치게 한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"상담\",\"k\":\"말늦은 아동 부모 코칭\",\"p\":\"말늦은 아동과 가족 시간 제약을 고려해 중재 접근 선택\",\"n\":\"말늦은 아동에는 가족중심·일과 기반의 부모 실행 언어촉진 중재 코칭\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 52세 여성, 갑상샘 절제술 2개월 후부터 약하고 기식적인 음성, 물 마실 때 가끔 사레\\n• 후두내시경: 우측 성대가 부정중위(paramedian)에서 고정, 발성 시 성문틈, 가성대의 보상적 과내전\\n• 후두근전도(LEMG): 우측 갑상피열근에서 재신경화 징후(다상성 운동단위전위) 관찰\\n• 환자는 교사로 복직을 앞두고 있음\",\"q\":\"이 시점에서 가장 적절한 관리 계획은?\",\"choices\":[\"회복 가능성이 낮으므로 즉시 제I형 갑상성형술(영구 내측화)을 시행한다\",\"신경 회복을 위해 완전 회복 시까지 절대 음성휴식과 필담만 유지한다\",\"성대 과내전을 막기 위해 우측 갑상피열근에 보툴리눔 독소를 주입한다\",\"음성치료·삼킴 안전 전략을 우선하고 필요 시 일시적 주입술을 고려한다\",\"재신경화 징후는 예후와 무관하므로 즉시 후두신경 재건술을 시행한다\"],\"answer\":4,\"explain\":\"수술 후 2개월이고 LEMG에서 재신경화 징후가 있으면 자연 회복 가능성이 있으므로 비가역적 영구 수술(갑상성형술)은 시기상조이다. 이 시기에는 성대내전 촉진 훈련과 가성대 과보상 감소, 삼킴 안전 전략을 우선하고, 직업적 요구가 크면 흡수성 재료로 일시적 성대주입술을 병행하며 통상 6~12개월 회복 관찰 후 영구 내측화를 결정한다. 보툴리눔 독소는 마비된 성대의 내전을 더 악화시키고, 절대 음성휴식은 성문폐쇄부전 회복에 도움이 되지 않으며 오히려 보상 기전 학습 기회를 잃게 한다. ※영구 수술 결정 시기(6~12개월)는 교재·기관별로 차이가 있을 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"편측 성대마비 초기 관리\",\"p\":\"술후 경과 기간과 재신경화 징후로 관리 우선순위 선택\",\"n\":\"재신경화 징후가 있는 초기 편측마비는 영구 수술 보류, 음성치료·삼킴 전략과 일시적 주입술\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 56세 여성, 30년간 하루 한 갑 흡연, 최근 전화에서 남성으로 오해받는 일이 잦음\\n• 목소리가 낮고 거칠며 아침에 특히 심하고, 잦은 헛기침·속쓰림 동반\\n• 후두내시경: 양측 성대 전장에 걸친 광범위한 반투명 물주머니 모양의 부종, 성대 상면이 흔들림\\n• 음향분석: 습관적 F0 128 Hz(동연령 여성 규준보다 현저히 낮음)\",\"q\":\"이 사례의 감별과 중재 우선순위로 가장 적절한 것은?\",\"choices\":[\"라인케부종 – 금연·역류 관리를 우선하고, 지속 시 수술을 고려한다\",\"성대낭종 – 즉시 후두미세수술을 시행한 뒤 음성치료를 실시한다\",\"라인케부종 – 음도 높이기 훈련만으로 정상 음도와 병변 회복이 가능하다\",\"성대결절 – 반폐쇄성도훈련만으로 양측 병변 소실을 기대할 수 있다\",\"재발성 후두유두종 – 항바이러스 치료와 레이저 절제를 의뢰한다\"],\"answer\":1,\"explain\":\"양측 성대 전장의 광범위·반투명 부종, 장기 흡연력, 현저히 낮은 F0(여성의 남성화된 음성)는 라인케부종(폴립양 변성)의 전형이다. 원인(흡연·역류·음성 남용) 제거가 일차 과제이며, 원인이 지속되면 수술 후 재발하므로 금연 없이 수술만 하는 것은 의미가 적다. 원인 제거 후에도 부종·음성 문제가 지속되면 미세수술과 수술 전후 음성치료를 병행한다. 부종은 기계적 원인이 아니라 점막 고유층의 액체 저류이므로 음도 훈련이나 SOVT만으로 병변이 소실되지는 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"라인케부종 감별\",\"p\":\"흡연력·광범위 반투명 부종·낮은 F0로 병변 감별과 중재 판단\",\"n\":\"라인케부종: 흡연·역류 관련 양측 전장 부종과 낮은 음도, 원인 제거 우선 후 지속 시 수술\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 34세 여성 보육교사, 6개월간 지속된 쉰 목소리\\n• 스트로보스코피: 좌측 성대 막성부 중간의 점막 아래 둥근 백색 병변, 해당 부위 점막파동 소실; 우측 대응 부위에 작은 반응성 부종\\n• 3개월간 음성위생·SOVT 음성치료 실시 → 음성 남용 행동 감소, 우측 부종은 줄었으나 좌측 병변과 음질은 변화 없음\",\"q\":\"가장 적절한 다음 단계는?\",\"choices\":[\"구조적 문제가 아니므로 심인성 음성장애로 보고 정신건강의학과에 의뢰한다\",\"성대결절이 남은 것으로 판단하고 동일한 음성치료를 6개월 더 연장한다\",\"성대폴립으로 판단하고 흡입 스테로이드와 항역류제를 처방받도록 한다\",\"성대낭종으로 보고 후두미세수술 의뢰와 수술 전후 음성치료를 병행한다\",\"양측 병변이므로 양측 성대를 동시에 절제한 뒤 4주간 절대 음성휴식을 취하게 한다\"],\"answer\":4,\"explain\":\"편측성·점막하 병변, 해당 부위의 점막파동 소실, 반대측의 반응성 병변, 그리고 음성치료에 반대측 부종은 반응하나 원발 병변은 반응하지 않는 경과는 성대낭종의 특징이다. 낭종은 행동적 치료로 소실되지 않으므로 미세수술이 필요하며, 수술 전 남용 행동 제거와 수술 후 발성 재교육을 병행한다. 결절은 양측·대칭성이고 점막파동이 보존되며 음성치료에 반응하고, 반응성 부종을 결절로 오인해 양측을 동시에 절제하면 반흔·성대 유착 위험이 커진다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"성대낭종 다음 단계\",\"p\":\"편측 점막하 병변과 음성치료 무반응 경과로 다음 조치 선택\",\"n\":\"성대낭종: 편측·점막파동 소실·행동치료 무반응, 미세수술과 수술 전후 음성치료 병행\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음성범위프로파일(VRP) 결과\\n• 최저 기본주파수: 98 Hz\\n• 최고 기본주파수: 392 Hz\\n• 강도 범위: 55~92 dB SPL\",\"q\":\"이 대상자의 음도 범위를 반음(semitone) 단위로 계산하면?\",\"choices\":[\"12 반음\",\"18 반음\",\"36 반음\",\"30 반음\",\"24 반음\"],\"answer\":5,\"explain\":\"반음 수 = 12 × log₂(최고 F0 ÷ 최저 F0) = 12 × log₂(392 ÷ 98) = 12 × log₂(4) = 12 × 2 = 24 반음(2옥타브). 주파수가 2배가 될 때마다 1옥타브(12반음)이므로 4배는 2옥타브이다. Hz 차이(294 Hz)를 그대로 쓰면 음도 지각의 대수적 특성을 반영하지 못하므로 반드시 비율로 계산한다. ※정상 성인의 VRP 음역 규준(대개 약 24~36반음)은 교재별로 다를 수 있음.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"VRP 반음 범위 산출\",\"p\":\"최고·최저 기본주파수 비율로 음도 범위 반음 수 산출\",\"n\":\"반음 수=12×log2(최고 F0÷최저 F0), 주파수 2배마다 1옥타브(12반음)\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 61세 남성, 약하고 기식적인 음성\\n• 폐활량(VC): 3,500 mL\\n• 최대연장발성시간(MPT): 7초\",\"q\":\"이 환자의 발성지수(phonation quotient, PQ)와 그 시사점으로 옳은 것은?\",\"choices\":[\"175 mL/s – 정상 범위로 발성 효율과 성문폐쇄에 문제가 없다\",\"250 mL/s – 성대 과내전으로 인한 높은 후두저항을 시사한다\",\"350 mL/s – 정상 범위로 호흡 지지와 성문폐쇄가 양호하다\",\"500 mL/s – 성대 과내전으로 인한 높은 후두저항을 시사한다\",\"500 mL/s – 성문폐쇄부전 등으로 인한 공기 낭비를 시사한다\"],\"answer\":5,\"explain\":\"PQ = 폐활량 ÷ MPT = 3,500 mL ÷ 7 s = 500 mL/s. PQ는 발성 1초당 소모되는 공기량의 추정치로, 값이 클수록 같은 공기로 짧게밖에 발성하지 못한다는 뜻이며 성문폐쇄부전(성대마비·위축 등)으로 공기가 새어 나가는 상태를 시사한다. 성대 과내전은 오히려 호기류가 줄어 PQ가 낮아지는 방향이다. ※PQ 정상 범위(대략 120~200 mL/s 내외)는 교재·연령별 규준에 따라 차이가 있음.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"발성지수(PQ) 산출\",\"p\":\"폐활량과 MPT로 PQ를 계산해 공기 효율의 의미 판단\",\"n\":\"PQ=폐활량÷MPT, 값이 크면 성문폐쇄부전 등으로 인한 공기 낭비 시사\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 47세 여성, 3년 전부터 서서히 시작되어 점차 악화된 음성 문제\\n• 말할 때 목소리가 쥐어짜듯 끊기며, 특히 모음으로 시작하는 낱말('아침', '오늘')과 전화 통화에서 심함\\n• 노래·웃음·속삭임에서는 거의 정상\\n• 후두 촉진: 압통 없음, 후두 높이 정상\\n• 8주간 후두마사지·SOVT 중심 음성치료 → 변화 없음\\n• 후두내시경: 구조적 병변 없음, 발성 중 불규칙한 성대 과내전 연축\",\"q\":\"이 사례의 감별과 다음 중재로 가장 적절한 것은?\",\"choices\":[\"근긴장성 발성장애 – 후두마사지와 SOVT를 12주 더 지속한다\",\"심인성 발성장애 – 정신건강의학과 의뢰 후 증상 소거 치료를 한다\",\"내전형 연축성발성장애 – 갑상피열근 보툴리눔 독소 주입을 의뢰한다\",\"본태성 음성진전 – 신경과에 프로프라놀롤 약물치료를 의뢰한다\",\"외전형 연축성발성장애 – 후윤상피열근 보툴리눔 독소 주입을 의뢰한다\"],\"answer\":3,\"explain\":\"모음 시작 낱말에서의 과제 특이적 음성 끊김, 노래·속삭임에서의 증상 감소, 서서히 진행하는 경과, 촉진 소견 정상, 충분한 음성치료에 대한 무반응, 내시경상 불규칙한 내전 연축은 내전형 연축성발성장애(신경학적 국소 근긴장이상)를 시사한다. 표준 치료는 갑상피열근 보툴리눔 독소 주입이며, 주입 후 1~2주 일시적 기식성·액체 사레가 흔하므로 사전 상담이 필요하고, 보조적 음성치료를 병행한다. 근긴장성 발성장애는 촉진 압통·후두 상승이 있고 음성치료에 반응하며, 심인성은 급성 발병·정서적 사건 연관과 상황에 따른 변동이 크다. 본태성 음성진전은 규칙적인 율동성 떨림이 특징이다. 외전형은 무성자음에서 기식성 끊김이 나타난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"내전형 연축성발성장애 감별\",\"p\":\"과제 특이적 끊김과 음성치료 무반응으로 감별과 다음 중재 판단\",\"n\":\"내전형 SD: 모음 시작 낱말 끊김, 노래·속삭임 호전, 갑상피열근 보툴리눔 독소 주입\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 39세 남성, 무성자음(/ㅍ, ㅌ, ㅋ, ㅅ, ㅎ/)으로 시작하는 낱말에서 목소리가 바람 빠지듯 갑자기 끊기고 속삭임처럼 됨\\n• 모음이나 유성음으로 시작하는 낱말은 비교적 안정적\\n• 후두내시경: 무성음 산출 시 성대가 과도하게 외전되어 열린 상태가 지연됨, 구조적 병변 없음\",\"q\":\"이 환자의 진단과 보툴리눔 독소 주입의 표적 근육으로 옳은 것은?\",\"choices\":[\"내전형 연축성발성장애 – 갑상피열근\",\"내전형 연축성발성장애 – 외측윤상피열근\",\"외전형 연축성발성장애 – 후윤상피열근\",\"외전형 연축성발성장애 – 갑상피열근\",\"근긴장성 발성장애 – 윤상갑상근 이완 훈련\"],\"answer\":3,\"explain\":\"무성자음 뒤 모음으로 전환할 때 성대가 지연·과도하게 외전되어 기식성 끊김이 생기는 것은 외전형 연축성발성장애이며, 유일한 외전근인 후윤상피열근(PCA)의 불수의적 연축이 원인이므로 이 근육에 보툴리눔 독소를 주입한다. 갑상피열근·외측윤상피열근은 내전근으로 내전형의 표적이다. 근긴장성 발성장애는 특정 음소 환경에 국한된 규칙적 끊김을 보이지 않는다. 외전형은 양측 PCA를 동시에 약화시키면 기도 협착 위험이 있어 한쪽씩·소량으로 주입한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"외전형 연축성발성장애 감별\",\"p\":\"무성자음 환경의 기식성 끊김으로 진단과 주입 표적 근육 판단\",\"n\":\"외전형 SD: 무성자음 뒤 과도한 외전, 유일한 외전근인 후윤상피열근에 보툴리눔 독소\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 62세 여성, 갑상샘 전절제술 직후부터 흡기 시 협착음(stridor), 계단 오를 때 호흡곤란\\n• 음성은 약간 약하지만 비교적 잘 유지됨\\n• 후두내시경: 양측 성대가 정중위 부근에서 고정, 흡기 시 성문틈 약 2~3 mm\",\"q\":\"이 환자의 관리 우선순위로 가장 적절한 것은?\",\"choices\":[\"양측 성대주입술로 성문을 완전히 폐쇄하여 음성을 강화한다\",\"기관절개술이나 성문확장술로 기도 확보를 우선한다\",\"밀기 접근법으로 성대 내전을 강화하여 음성을 개선한다\",\"양측 제I형 갑상성형술로 성대를 내측화하여 음량을 높인다\",\"양측 갑상피열근에 보툴리눔 독소를 주입하여 성문을 넓힌다\"],\"answer\":2,\"explain\":\"양측 되돌이후두신경 손상으로 양측 성대가 정중위 부근에 고정되면 음성은 비교적 유지되나 흡기 시 기도가 좁아져 협착음·호흡곤란이 생기므로 생명과 직결되는 기도 확보(기관절개술 또는 성대 외측고정술·피열연골절제술 등 성문확장술)가 최우선이다. 내측화(주입술·갑상성형술)나 내전 강화 훈련은 기도를 더 좁혀 금기이며, 성문확장술은 기도를 넓히는 대신 음성이 약해질 수 있어 이후 기도와 음성의 균형을 고려한 음성치료로 보완한다. 보툴리눔 독소는 근긴장이상에 쓰는 것으로 마비된 성대의 위치를 바꾸지 못한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"양측 성대마비 관리 우선순위\",\"p\":\"양측 정중위 고정과 흡기 협착음으로 관리 우선순위 선택\",\"n\":\"양측 정중위 마비는 음성보다 기도 확보 우선, 내측화·내전 강화는 금기\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 후두전적출술 및 방사선치료 종료 후 6개월, 기관식도천공(TEP) 발성을 희망하는 64세 남성\\n• 식도 공기주입검사(insufflation test): 카테터로 공기를 넣으며 발성을 시도했으나 소리가 나지 않고, 목이 조이는 느낌과 함께 하인두 부위가 불룩해지며 공기가 저류됨\",\"q\":\"이 결과의 해석과 조치로 가장 적절한 것은?\",\"choices\":[\"검사를 통과한 것이므로 즉시 TEP를 시행하고 발성 훈련을 시작한다\",\"폐기능 저하가 원인이므로 호흡 근력 훈련을 4주간 실시한 후 재검한다\",\"TEP 발성이 불가능하므로 전기후두 사용도 포기하고 필담으로 전환한다\",\"PE분절 저긴장으로 보고 목 외부 압박 훈련을 실시한 뒤 재검한다\",\"PE분절 과긴장으로 보고 보툴리눔 독소나 근절개술 후 재평가한다\"],\"answer\":5,\"explain\":\"공기주입검사에서 공기를 넣어도 발성이 되지 않고 조임감과 공기 저류(불룩해짐)가 나타나는 것은 PE분절이 과긴장·연축되어 공기가 통과하지 못하는 상태를 뜻한다. 이 경우 TEP를 해도 유창한 발성이 어려우므로 보툴리눔 독소 주입이나 근절개술로 PE분절 긴장을 낮춘 뒤 재평가한다. 저긴장 PE분절은 오히려 소리가 약하고 낮으며 젖은 음질로 나오는 양상이고, 폐기능은 이 검사와 직접 관련이 없다. TEP 부적합이라도 전기후두 등 대안 발성법은 여전히 가능하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"TEP 공기주입검사 해석\",\"p\":\"공기주입 시 발성 불가와 공기 저류 소견으로 PE분절 상태 판단\",\"n\":\"PE분절 과긴장은 공기주입검사 실패 원인, 보툴리눔 독소·근절개술 후 재평가\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 7세 남아, 축구클럽 활동, 형과 다투며 소리 지르는 일이 잦음, 알레르기 비염으로 입호흡\\n• 후두내시경: 양측 성대 전1/3과 중1/3 경계의 대칭적 소결절\\n• 부모는 빨리 낫게 수술을 원함\",\"q\":\"가장 적절한 중재 계획은?\",\"choices\":[\"후두미세수술을 우선 시행하고 수술 후 음성치료를 한다\",\"4주간 절대 음성휴식을 시킨 뒤 후두내시경으로 재평가한다\",\"부모 교육·환경 조정의 간접치료와 발성 재교육을 병행한다\",\"말하는 대신 속삭이도록 하여 성대 부담과 마찰을 줄인다\",\"음성위생 교육만 실시하고 결절이 자연 소실될 때까지 기다린다\"],\"answer\":3,\"explain\":\"아동 성대결절은 음성 남용이 원인인 행동적 문제이므로 원인 행동을 바꾸지 않으면 수술해도 재발하며, 성장 중인 후두에 대한 수술은 반흔 위험이 있어 일반적으로 보류한다. 아동은 스스로 행동을 조절하기 어려우므로 부모 참여형 간접치료(소리 지르기 대체 행동, 환경 소음 조정, 비염·입호흡 관리 의뢰)와 SOVT·쉬운 시작 등 직접적 발성 훈련을 병행해야 한다. 절대 음성휴식은 아동에게 현실적으로 불가능하고 근본 원인을 바꾸지 못하며, 속삭이기는 오히려 후두 긴장을 높인다. 음성위생만으로는 이미 형성된 습관적 발성 패턴을 바꾸기 어렵다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"아동 성대결절 중재\",\"p\":\"음성 남용 행동과 아동 특성으로 결절 중재 계획 선택\",\"n\":\"아동 결절은 수술 보류, 부모 참여 간접치료·환경 조정과 직접 발성 재교육 병행\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 45세 남성, 아침에 목 이물감과 잦은 헛기침, 만성 기침, 쉰 목소리\\n• 흉통·속쓰림은 없다고 함\\n• 역류증상지수(RSI): 21점, 역류소견점수(RFS): 12점\\n• 후두내시경: 후두 후방 발적, 피열간 점막 비후(pachydermia), 가성대 부종\",\"q\":\"이 사례의 판단과 중재로 가장 적절한 것은?\",\"choices\":[\"근긴장성 발성장애이므로 후두마사지만 집중적으로 실시한다\",\"인후두역류를 의심해 약물치료 의뢰와 헛기침 대체 훈련을 한다\",\"속쓰림이 없으므로 역류는 배제하고 2주간 음성휴식을 처방한다\",\"성대결절이므로 반폐쇄성도훈련과 음성위생을 실시한다\",\"알레르기 반응이므로 항히스타민제만 복용하도록 한다\"],\"answer\":2,\"explain\":\"RSI가 절단점(>13)을, RFS가 절단점(>7)을 초과하고 후두 후방 발적·피열간 비후·가성대 부종이 있으면 인후두역류(LPR)를 의심한다. LPR은 위식도역류와 달리 속쓰림 등 전형적 위장 증상 없이 후두 증상만 나타나는 경우가 많으므로 속쓰림이 없다고 배제해서는 안 된다. 중재는 이비인후과 의뢰를 통한 약물치료(PPI 등)·식이 및 생활습관 교정과 함께, 후두 점막을 자극해 악순환을 만드는 헛기침을 힘주어 삼키기·물 마시기 등 대체 행동으로 바꾸는 행동 수정이 핵심이다. ※RSI/RFS 절단점은 원저 기준이며 교재별 표기가 다를 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"인후두역류 판단\",\"p\":\"RSI·RFS 초과와 후두 후방 소견으로 원인 판단과 중재 선택\",\"n\":\"LPR은 속쓰림 없이도 발생, 약물치료 의뢰와 헛기침 대체 행동 수정이 핵심\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음성 피로를 호소하는 성악 전공 대학생에게 성대기능훈련(Vocal Function Exercises, VFE)을 적용하려 한다.\",\"q\":\"VFE의 구성과 시행 원리로 옳은 것은?\",\"choices\":[\"워밍업–스트레칭–수축–내전력 강화를 각 2회씩 하루 2번 부드럽게 한다\",\"워밍업 단계에서는 최고 음도에서 짧고 강하게 스타카토로 여러 번 반복 산출한다\",\"하루 1회, 4단계를 각 1번씩만 실시하며 힘들면 즉시 중단한다\",\"내전력 강화 단계에서는 최대 강도로 고함쳐 성대 접촉과 내전력을 강화한다\",\"스트레칭과 수축 단계는 큰 소리의 스타카토 발성으로 구성된다\"],\"answer\":1,\"explain\":\"Stemple의 VFE는 후두 근육의 균형·지구력을 회복시키는 생리적 접근으로, 워밍업(모음 연장)–스트레칭(상행 활음)–수축(하행 활음)–내전력 강화(음계별 모음 연장)의 4단계를 각 2회씩 하루 2번, 가능한 한 부드럽고 노력 없는 발성으로 수행한다. 연장 시간은 폐활량 기반 목표치를 향해 점진적으로 늘린다. 고함·스타카토·최대 강도 발성은 성대 충격을 높여 VFE의 원리에 반한다. ※사용 모음·기준 음도·목표 산출식 등 세부 프로토콜은 교재별 차이가 있을 수 있음.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성대기능훈련 구성\",\"p\":\"VFE의 단계 구성과 시행 횟수·발성 방식 원리 식별\",\"n\":\"VFE: 워밍업-스트레칭-수축-내전력 강화 4단계, 각 2회씩 하루 2번 부드러운 발성\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"성대결절 치료 후에도 잔여 음성 피로를 호소하는 초등교사에게 치료사가 다음과 같이 지도하였다.\\n\\\"코와 입술 주변 앞쪽에서 울림과 진동을 느끼면서, 성대는 살짝 닿을 듯 말 듯한 상태로 가장 쉽고 편하게 큰 소리를 내 보세요.\\\"\",\"q\":\"이 기법과 그 원리로 옳은 것은?\",\"choices\":[\"악센트 기법 – 복식호흡 리듬의 강세 발성으로 호흡-발성 협응을 높인다\",\"신뢰음성 – 기식적이고 작은 소리로 말해 성대 접촉을 최소화한다\",\"공명음성치료 – 최소한의 성대 충격으로 최대의 음향 출력을 얻는다\",\"밀기 접근법 – 팔을 밀며 발성하여 성대 내전과 성문폐쇄를 강화한다\",\"챈트 말하기 – 음절 강세를 없앤 단조로운 연속 발성으로 후두 긴장을 낮춘다\"],\"answer\":3,\"explain\":\"전방(안면 마스크) 진동감과 '살짝 닿을 듯 말 듯한(barely adducted/abducted)' 성대 자세를 강조하며 쉽고 강한 소리를 찾게 하는 것은 공명음성치료(Lessac-Madsen Resonant Voice Therapy)의 기본 훈련 제스처이다. 성대 충격 응력을 최소화하면서도 충분한 출력을 얻게 하여 직업적 음성 사용자에게 적합하다. 악센트 기법은 리듬·강세와 복식호흡이 핵심이고, 신뢰음성은 수술 직후 등 일시적 보호 목적의 저강도 기식 발성이며 큰 소리를 요구하지 않는다. 밀기 접근법은 성문폐쇄부전에 쓰는 내전 강화 기법이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"공명음성치료 원리\",\"p\":\"전방 진동감과 살짝 닿는 성대 자세 지시로 기법과 원리 식별\",\"n\":\"공명음성치료: 전방 진동감과 약한 내전 자세로 최소 성대 충격에 최대 음향 출력\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"42세 남성 영업직 환자가 성대폴립 후두미세수술을 받았다. 수술 후 음성 관리를 담당하게 되었다.\",\"q\":\"수술 후 음성 관리 프로토콜로 가장 적절한 것은?\",\"choices\":[\"수술 직후부터 큰 소리로 발성하여 성대 유착과 반흔을 예방한다\",\"점막이 완전히 재생되도록 3개월간 절대 음성휴식을 유지한다\",\"회복기 3개월 동안 모든 대화는 속삭임으로만 하게 한다\",\"짧은 절대 음성휴식 후 신뢰음성·SOVT로 사용을 늘려 간다\",\"수술로 원인이 제거되었으므로 별도의 음성치료는 필요하지 않다\"],\"answer\":4,\"explain\":\"수술 직후에는 절개 부위 점막 회복을 위해 짧은 절대 음성휴식(대개 수일~1주)을 두고, 이후 신뢰음성(부드럽고 낮은 강도의 약간 기식적인 발성)·SOVT처럼 성대 충격이 적은 발성으로 점진적으로 사용량을 늘리며 음성위생·수분 섭취·역류 관리를 병행한다. 장기간 절대 휴식은 근위축·발성 회피를 초래하고, 속삭이기는 후두 긴장을 높이며, 큰 소리 발성은 치유 중인 점막에 출혈·반흔을 유발한다. 폴립의 배경에는 음성 남용 습관이 있으므로 수술 후 발성 재교육이 없으면 재발 위험이 높다. ※절대 음성휴식 기간은 술식·교재에 따라 차이가 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성대 수술 후 음성 관리\",\"p\":\"미세수술 후 점막 회복 단계에 맞는 음성 관리 프로토콜 선택\",\"n\":\"수술 후 짧은 절대 음성휴식 뒤 신뢰음성·SOVT로 점진적 사용 증가와 재발 예방 재교육\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 55세 남성 영업직, 잦은 헛기침, 강하게 시작하는 말 습관, 만성 소화불량\\n• 6개월 전 전신마취 수술 시 기관내삽관\\n• 후두내시경: 좌측 성대돌기(vocal process) 부위의 육아종성 병변\\n• 3개월 전 병변 절제술을 받았으나 재발함\",\"q\":\"이 사례의 원인 판단과 중재로 가장 적절한 것은?\",\"choices\":[\"접촉성 육아종으로 보고 역류 관리와 저충격 발성 훈련을 한다\",\"재발했으므로 즉시 더 넓은 범위로 재절제하고 조직검사를 한다\",\"원인은 음성 남용뿐이므로 3주간 음성휴식만 처방한다\",\"재발성 후두유두종으로 보고 항바이러스 치료를 의뢰한다\",\"성대 막성부 병변이므로 성대결절로 보고 SOVT를 실시한다\"],\"answer\":1,\"explain\":\"성대돌기(피열연골 부위)의 접촉성 육아종은 삽관 손상, 인후두역류, 강한 성대 접촉(헛기침·거친 성대 시작)이 복합적으로 작용하여 생기며, 원인을 그대로 둔 채 절제하면 재발률이 매우 높아 재절제는 최후 수단으로 둔다. 따라서 역류 치료, 헛기침·강한 시작을 대체하는 행동 수정, 쉬운 시작·하품-한숨 등 성대 충격을 줄이는 발성 훈련이 일차 치료이고, 난치성이면 보툴리눔 독소로 내전력을 낮추는 방법을 고려한다. 병변 위치가 막성부가 아닌 연골부이므로 결절과 다르며, 유두종은 사마귀 모양의 다발성 병변이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"접촉성 육아종 판단\",\"p\":\"성대돌기 병변 위치와 삽관·역류·헛기침 병력으로 원인과 중재 판단\",\"n\":\"접촉성 육아종: 성대돌기 병변, 원인 방치 시 재발, 역류 관리와 저충격 발성 훈련 우선\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 15세 여자 육상선수, 격렬한 달리기 중 갑자기 흡기 시 협착음과 목이 조이는 느낌, 몇 분 쉬면 소실\\n• 흡입 기관지확장제 효과 없음, 폐기능검사 정상\\n• 운동 유발 후 후두내시경: 흡기 시 성대 앞 2/3가 내전되고 후방에 다이아몬드 모양의 작은 틈만 남음\",\"q\":\"이 사례의 진단과 중재로 가장 적절한 것은?\",\"choices\":[\"운동 유발 천식 – 흡입 스테로이드와 기관지확장제를 증량한다\",\"역설적 성대운동 – 이완 후두 호흡법 훈련을 실시한다\",\"양측 성대마비 – 기관절개술 또는 성문확장술을 의뢰한다\",\"내전형 연축성발성장애 – 갑상피열근 보툴리눔 독소를 주입한다\",\"후두연화증 – 성문상부성형술을 이비인후과에 의뢰한다\"],\"answer\":2,\"explain\":\"흡기 시 성대가 역설적으로 내전되며 후방에 다이아몬드형 틈이 남는 것은 역설적 성대운동(PVFM, 성대기능이상)의 특징적 소견이며, 기관지확장제 무반응과 정상 폐기능은 천식과 감별된다. 삽화가 간헐적이고 휴식 시 소실되므로 마비가 아니며, 기도 문제이지 발성 시 연축이 아니므로 연축성발성장애도 아니다. 중재의 핵심은 발작 시 후두를 여는 이완 후두 호흡법(rescue breathing: 코로 짧게 흡기, 오므린 입술로 호기, 복식호흡)과 유발 상황 인식·자가 관리 훈련이며, 필요 시 역류·불안 관리를 병행한다. 언어재활사가 주도적으로 담당하는 영역이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"역설적 성대운동 감별\",\"p\":\"흡기 시 성대 내전과 기관지확장제 무반응으로 진단과 중재 판단\",\"n\":\"PVFM: 흡기 시 역설적 내전·후방 다이아몬드형 틈, 이완 후두 호흡법 훈련\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 49세 남성 교사, 심한 후두염 후 목소리가 낮고 거칠어졌으며 발성 시 목에 힘이 많이 들어감\\n• 후두내시경: 진성대는 구조적으로 정상이나, 발성 시 양측 가성대가 서로 접근·진동하며 진성대를 가림\",\"q\":\"이 소견에 대한 중재로 가장 적절한 것은?\",\"choices\":[\"습관화된 가성대 발성을 강화하여 안정된 음성으로 만든다\",\"첫 단계로 양측 가성대에 보툴리눔 독소를 소량 주입한다\",\"밀기 접근법으로 진성대와 가성대의 내전을 한층 더 강화한다\",\"진성대 노출을 위해 성문상부 절제술을 의뢰한다\",\"흡기 발성·하품-한숨 등으로 진성대 발성을 재확립한다\"],\"answer\":5,\"explain\":\"진성대가 정상인데 가성대가 접근·진동하는 것은 후두염 시 보상으로 시작된 가성대 발성(성대 대치 발성)이 습관화된 기능적 과기능 장애이다. 흡기 발성은 흡기 중에는 가성대가 진동하기 어려워 진성대 발성을 유도하는 대표적 촉진 기법이며, 음도 상승과 하품-한숨·후두마사지로 성문상부 압축을 풀어 진성대 발성을 재확립한다. 진성대가 정상이므로 가성대 발성을 강화하거나 침습적 처치를 먼저 할 이유가 없고, 밀기 접근법은 과기능을 더 악화시킨다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"가성대 발성 중재\",\"p\":\"진성대 정상과 가성대 진동 소견으로 진성대 발성 재확립 기법 선택\",\"n\":\"가성대 발성은 습관화된 과기능, 흡기 발성·하품-한숨으로 진성대 발성 유도\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"중증 쉰 목소리 환자의 후두 스트로보스코피에서 기본주파수 추적이 되지 않아 화면이 흔들리고 점막파동을 판독할 수 없었다.\",\"q\":\"이 상황의 해석과 대안으로 옳은 것은?\",\"choices\":[\"방법상의 한계로 보고 고속 후두촬영 등으로 보완한다\",\"점막파동이 관찰되지 않았으므로 성대 반흔으로 확진한다\",\"마이크 위치 문제이므로 위치만 조정하여 재검하면 된다\",\"강도를 최대한 높여 발성하게 하면 정상적으로 판독할 수 있다\",\"전기성문파형검사로 대체하여 점막파동을 직접 관찰한다\"],\"answer\":1,\"explain\":\"스트로보스코피는 F0에 동기화된 섬광으로 여러 주기의 조각을 합성해 '느린 움직임'처럼 보이게 하는 착시 기법이므로, 신호가 준주기적이어야 한다. 심한 비주기성(Titze의 3형 신호)에서는 동기화 실패로 판독이 불가능하며, 이는 반흔의 증거가 아니라 방법의 한계이다. 고속 후두촬영은 초당 수천 프레임으로 실제 주기를 촬영하므로 비주기 음성에도 적용된다. EGG는 성대 접촉 면적 변화를 간접 측정할 뿐 점막파동을 시각화하지 못한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"스트로보스코피 한계\",\"p\":\"비주기 음성에서 동기화 실패 상황의 해석과 대체 검사 선택\",\"n\":\"스트로보스코피는 준주기 신호 전제, 심한 비주기 음성은 고속 후두촬영으로 보완\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"중증 기식성 음성 환자의 음향분석에서 파형이 비주기적이어서 jitter·shimmer 값이 산출되지 않거나 극단적인 값으로 나왔다.\",\"q\":\"이 환자의 음성 중증도를 객관적으로 정량화하기 위해 가장 적절한 음향 지표는?\",\"choices\":[\"켑스트럼 피크 현저도(CPPS)를 사용한다\",\"기본주파수 표준편차를 중증도 지표로 사용한다\",\"소음대배음비(NHR)만을 중증도 지표로 사용한다\",\"jitter를 여러 번 재측정하여 평균값을 사용한다\",\"최대연장발성시간(MPT)으로 음향 지표를 대체한다\"],\"answer\":1,\"explain\":\"jitter·shimmer·NHR은 주기 경계 검출을 전제로 하므로 비주기적(3형) 신호에서는 신뢰할 수 없다. 켑스트럼 피크 현저도(CPP)는 주기 검출 없이 스펙트럼의 배음 구조가 얼마나 뚜렷한지를 정량화하므로 중증·비주기 음성에도 안정적이며, 연결발화에도 적용 가능하고 청지각적 중증도와 상관이 높아 최근 권고되는 지표이다. F0 표준편차는 음도 변동을 반영할 뿐 음질 중증도 지표가 아니며, MPT는 공기역학적 지표로 음향분석을 대체하지 못한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"비주기 음성 음향 지표\",\"p\":\"주기 검출 불가 음성에서 중증도 정량 지표 선택\",\"n\":\"CPPS는 주기 검출 없이 배음 구조 뚜렷함을 측정, 중증·비주기 음성에도 안정적\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 36세 여성 콜센터 상담원, 하루 7시간 통화, 목 조임·통증과 음성 피로\\n• 후두 촉진: 후두 상승, 갑상설골 간격 축소, 설골상부 근육 압통\\n• 공기역학 검사: 성문하압 12 cmH₂O(증가), 평균호기류율 80 mL/s(감소), 후두저항 증가\\n• 후두내시경: 병변 없음, 발성 시 후방 성문틈과 전후·좌우 성문상부 압축\",\"q\":\"이 사례의 진단과 중재로 가장 적절한 것은?\",\"choices\":[\"편측 성대마비 – 주입술 등 성대 내측화 수술을 의뢰한다\",\"내전형 연축성발성장애 – 보툴리눔 독소를 주입한다\",\"일차성 근긴장성 발성장애 – 도수치료와 발성 재교육을 한다\",\"심인성 실성증 – 정신건강의학과 의뢰 후 기침 발성을 유도한다\",\"라인케부종 – 금연 교육과 후두미세수술을 의뢰한다\"],\"answer\":3,\"explain\":\"구조적 병변 없이 후두 상승·갑상설골 간격 축소·촉진 압통, 높은 성문하압과 낮은 호기류(높은 후두저항), 성문상부 압축은 과도한 후두 내·외근 긴장에 의한 일차성 근긴장성 발성장애의 전형이다. 중재는 후두 도수치료(circumlaryngeal massage)·후두 하강으로 긴장을 낮춘 뒤 SOVT·공명음성 등으로 효율적 발성 패턴을 재학습시키고, 헤드셋 사용·휴식 등 업무 환경을 조정하는 것이다. 성대마비는 호기류가 증가하고 성문하압이 낮아지는 반대 양상이며, 연축성발성장애는 과제 특이적·불규칙 연축이 특징이고 촉진 소견이 정상이다. ※성문하압·호기류율 정상 범위는 교재별로 차이가 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"근긴장성 발성장애 감별\",\"p\":\"촉진 소견·높은 후두저항·성문상부 압축으로 진단과 중재 판단\",\"n\":\"일차성 MTD: 후두 상승·압통·높은 성문하압과 낮은 호기류, 도수치료와 발성 재교육\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 58세 여성, 천식으로 고용량 흡입 스테로이드(플루티카손)를 6개월간 사용한 뒤 쉰 목소리 발생, 음성 남용력 없음\\n• 후두내시경: 성대 점막에 백색 반점(칸디다 의심), 성대가 약간 활모양으로 휨\",\"q\":\"언어재활사의 대응으로 가장 적절한 것은?\",\"choices\":[\"환자 스스로 흡입 스테로이드를 즉시 중단하도록 지시한다\",\"반폐쇄성도훈련으로 성대 점막의 백색 반점을 제거한다\",\"성대백반증이므로 즉시 조직검사와 레이저 절제를 의뢰한다\",\"입 헹굼·스페이서 사용을 교육하고 처방의와 협의한다\",\"활모양 성대를 교정하기 위해 밀기 접근법을 집중 실시한다\"],\"answer\":4,\"explain\":\"흡입 스테로이드는 후두 칸디다증과 스테로이드 유발 국소 근병증(성대 활모양)을 일으켜 음성 남용 없이도 애성을 유발한다. 일차 조치는 약물 관련 원인 관리(흡입 후 입 헹굼·가글과 스페이서 사용으로 후두 침착 감소, 처방의와 용량·제형 조정 및 항진균 치료 협의, 수분 섭취)이며, 이는 의학적 처치이므로 언어재활사는 교육·협의 역할을 한다. 원인 교정 후에도 음성 문제가 남으면 음성치료를 계획한다. 천식 약을 환자 임의로 중단하게 하는 것은 위험하고, 병변은 감염성이므로 음성 훈련으로 제거되지 않으며, 백반증으로 단정해 조직검사·절제부터 할 상황도 아니다. 근병증에 의한 활모양은 약물 조정 후 회복되는 경우가 많아 밀기 접근법 집중 훈련은 우선순위가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"흡입 스테로이드 유발 애성\",\"p\":\"흡입 스테로이드 사용력과 칸디다 소견으로 언어재활사 대응 선택\",\"n\":\"흡입 스테로이드는 후두 칸디다증·근병증 유발, 입 헹굼·스페이서 교육과 처방의 협의\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 27세 여성 뮤지컬 배우, 공연 중 갑자기 목소리가 끊겼고 다음 날 심한 애성\\n• 월경 중이며 두통으로 아스피린을 복용함\\n• 후두내시경: 우측 성대 전체가 붉게 물든 출혈 소견\",\"q\":\"가장 적절한 즉각적 조치는?\",\"choices\":[\"반폐쇄성도훈련을 즉시 시작하여 혈종의 빠른 흡수를 유도한다\",\"절대 음성휴식과 아스피린 중단 후 점진적으로 복귀시킨다\",\"밀기 접근법으로 성대 내전을 강화하여 공연에 복귀시킨다\",\"온찜질과 함께 큰 소리 발성 연습으로 혈액 흡수를 촉진한다\",\"즉시 후두미세수술로 출혈 부위와 혈종을 제거한다\"],\"answer\":2,\"explain\":\"성대출혈은 음성 외상에 월경기 혈관 취약성과 아스피린(항혈소판 효과)이 겹쳐 발생하기 쉬운 응급 상황으로, 계속 발성하면 반흔·혈관종으로 진행해 영구적 음질 손상을 남길 수 있다. 급성기에는 절대 음성휴식(대개 1~2주)으로 발성을 완전히 중단해 혈액이 흡수되도록 하고 아스피린·NSAID를 중단하며 항응고 위험 요인을 평가하고, 후두과 추적 후 점진적으로 복귀하며 재발 예방(월경 주기·약물·과다 사용) 교육을 한다. 수술은 급성 출혈의 치료가 아니라 재발성 출혈의 원인이 되는 정맥류에 대해 고려한다. SOVT·밀기·큰 소리 발성은 모두 출혈 부위에 기계적 부하를 주어 금기이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성대출혈 즉각 조치\",\"p\":\"급성 성대출혈과 아스피린·월경 요인으로 즉각 조치 선택\",\"n\":\"급성 성대출혈은 절대 음성휴식과 아스피린 중단 후 점진 복귀, 발성 부하 기법은 금기\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 68세 여성, 3~4년에 걸쳐 서서히 심해진 목소리 떨림, 노래와 말에서 모두 나타남, 손 떨림 동반\\n• 연장모음 /아/에서 4~6 Hz의 규칙적인 음도·강도 변조\\n• 모음 시작 낱말·무성자음 등 특정 음소 환경과 무관하게 지속되며, 속삭일 때도 떨림이 관찰됨\\n• 후두내시경: 발성 시 후두·인두·연구개가 함께 율동적으로 떨림, 구조적 병변 없음\",\"q\":\"이 사례의 감별과 관리로 가장 적절한 것은?\",\"choices\":[\"내전형 연축성발성장애 – 갑상피열근 보툴리눔 독소를 주입한다\",\"본태성 음성진전 – 신경과 의뢰와 보상적 음성치료를 병행한다\",\"파킨슨병 – LSVT LOUD로 음성 강도를 높인다\",\"근긴장성 발성장애 – 후두마사지와 SOVT를 실시한다\",\"심인성 음성장애 – 정신건강의학과 의뢰 후 상담을 병행한다\"],\"answer\":2,\"explain\":\"특정 음소 환경과 무관하게 규칙적(4~6 Hz)으로 나타나는 음도·강도 변조, 속삭임에서도 지속, 손 떨림 동반, 후두 외 구조(인두·연구개)의 율동적 떨림은 본태성 음성진전의 특징이다. 연축성발성장애는 과제 특이적·불규칙적 끊김이 핵심이고 속삭임에서 감소한다. 진전은 여러 구조가 관여하므로 보툴리눔 독소 효과가 부분적이며, 신경과 의뢰로 약물치료(프로프라놀롤 등)를 검토하고 짧은 구·문장 사용, 음도·강도 조절 등 보상적 음성치료로 지각되는 떨림을 줄인다. 파킨슨병은 단조롭고 약한 음성이 특징이며 안정 시 진전을 보인다. ※음성진전 주파수 범위(4~7 Hz 등)는 교재별 표기가 다를 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"본태성 음성진전 감별\",\"p\":\"규칙적 변조·속삭임 지속·손 떨림 동반으로 감별과 관리 판단\",\"n\":\"본태성 음성진전: 음소 무관 규칙적 떨림, 신경과 의뢰와 보상적 음성치료 병행\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 6세 남아, 뇌간 종양 수술 후 커프형 기관절개관을 6개월째 유지\\n• 각성 상태 양호, 분비물 적음, 자발 호흡 안정\\n• 아동과 부모 모두 말하기를 강하게 원하며, 의료진과 함께 말하기 밸브(일방향 밸브) 적용을 검토 중\",\"q\":\"말하기 밸브 적용의 필수 조건과 절차로 옳은 것은?\",\"choices\":[\"커프를 팽창시킨 상태로 밸브를 부착하여 기도를 보호한다\",\"상기도가 완전히 폐쇄되어 있어도 밸브 사용이 가능하다\",\"처음부터 수면 중을 포함해 하루 종일 착용시켜 적응하게 한다\",\"커프 완전 감압과 상기도 통기 확인 후 짧은 시간부터 착용한다\",\"분비물이 많을수록 밸브가 분비물 배출을 돕기 때문에 유리하다\"],\"answer\":4,\"explain\":\"일방향 말하기 밸브는 흡기는 관을 통해, 호기는 관 주위를 거쳐 상기도(성대)로 내보내 발성을 가능하게 한다. 따라서 커프를 완전히 감압해야 하고, 관 주위와 상기도가 충분히 열려 있어야 하며(막힘이 있으면 공기가 갇혀 질식 위험), 관을 막고 호기·발성이 가능한지와 산소포화도·호흡 안정을 확인한 뒤 짧은 시간부터 점진적으로 착용한다. 커프 팽창 상태나 상기도 폐쇄에서 밸브를 쓰면 호기가 나가지 못해 매우 위험하고, 과다한 분비물은 밸브 막힘·흡인 위험을 높여 금기에 해당한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"말하기 밸브 적용 조건\",\"p\":\"기관절개 아동의 말하기 밸브 적용 필수 조건과 절차 선택\",\"n\":\"말하기 밸브는 커프 완전 감압과 상기도 통기 확인 후 짧은 시간부터 착용\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"단어 '참새'에 포함된 자음(ㅊ, ㅁ, ㅅ)의 조음방법을 순서대로 옳게 나열한 것은?\",\"choices\":[\"파열음 – 비음 – 마찰음\",\"마찰음 – 비음 – 파찰음\",\"파찰음 – 유음 – 마찰음\",\"파찰음 – 비음 – 마찰음\",\"파찰음 – 비음 – 파열음\"],\"answer\":4,\"explain\":\"/ㅊ/은 경구개 파찰음, 종성 /ㅁ/은 양순 비음, /ㅅ/은 치조 마찰음이다. /ㅊ/을 파열음이나 마찰음으로, /ㅁ/을 유음으로, /ㅅ/을 파열음·파찰음으로 분류한 나머지 보기는 모두 틀리다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"자음 조음방법 분류\",\"p\":\"낱말 속 자음별 조음방법을 순서대로 식별\",\"n\":\"ㅊ 파찰음, ㅁ 비음, ㅅ 마찰음의 조음방법 분류\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 자음의 변별자질에 관한 설명으로 옳은 것은?\",\"choices\":[\"비음 /ㅁ, ㄴ, ㅇ/은 [-공명성] 자질을 갖는다\",\"치조음과 경구개음은 [+설정성] 자질을 공유한다\",\"연구개음 /ㄱ, ㄲ, ㅋ/은 [+전방성] 자질을 갖는다\",\"파찰음 /ㅈ, ㅉ, ㅊ/은 [+지속성] 자질을 갖는다\",\"마찰음 /ㅅ, ㅆ/은 [-지속성] 자질을 갖는다\"],\"answer\":2,\"explain\":\"[설정성(coronal)]은 혀끝·혓날이 올라가 조음되는 치조음·경구개음이 공유하는 자질이다. 비음은 공명음이므로 [+공명성], 파찰음은 폐쇄 구간이 있어 [-지속성], 마찰음은 기류가 지속되므로 [+지속성], 연구개음은 치조 뒤에서 조음되므로 [-전방성]이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"자음 변별자질\",\"p\":\"자음 부류별 변별자질 값의 옳고 그름 판단\",\"n\":\"[+설정성]: 치조음·경구개음 공유, 연구개음은 [-전방성]\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 종성(받침) 자음에 관한 설명으로 옳은 것은?\",\"choices\":[\"종성에서는 /ㄱ, ㄴ, ㄷ, ㄹ, ㅁ, ㅂ, ㅇ/만 발음된다\",\"종성 /ㄹ/은 초성과 같이 탄설음 [ɾ]으로 실현된다\",\"종성 파열음은 파열 단계까지 개방되어 산출된다\",\"종성 위치에서 파찰음 /ㅈ/은 파찰음 그대로 실현된다\",\"발음상 종성에서는 두 개의 자음이 연이어 모두 실현될 수 있다\"],\"answer\":1,\"explain\":\"한국어는 음절 말에서 7개 자음(7종성)만 실현된다(예: '꽃'→[꼳], '부엌'→[부억]). 종성 파열음은 불파음(미파음)으로 산출되고, 종성 /ㄹ/은 설측음 [l]로 실현되며, 겹받침은 자음군 단순화로 하나만 발음된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"종성 실현 규칙\",\"p\":\"음절 말 자음의 실현 방식에 대한 설명 판단\",\"n\":\"7종성 규칙, 종성 파열음 불파, 종성 ㄹ 설측음, 자음군 단순화\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"우리말 /ㄹ/의 변이음 실현이 옳게 연결된 것은?\",\"choices\":[\"'라면'의 /ㄹ/ – 설측음 [l]\",\"'노래'의 /ㄹ/ – 설측음 [l]\",\"'달'의 /ㄹ/ – 설측음 [l]\",\"'빨래'의 첫 번째 /ㄹ/ – 탄설음 [ɾ]\",\"'달'의 /ㄹ/ – 탄설음 [ɾ]\"],\"answer\":3,\"explain\":\"/ㄹ/은 초성(어두, 모음 사이)에서 탄설음 [ɾ], 종성에서 설측음 [l]로 실현된다. '빨래'처럼 /ㄹ/이 연이어 나오면 [ll]로 둘 다 설측음이다. 따라서 '달'의 종성 /ㄹ/ – 설측음 연결만 옳다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"유음 변이음 실현\",\"p\":\"음절 위치에 따른 /ㄹ/ 변이음 연결 판단\",\"n\":\"/ㄹ/: 초성·모음 사이 탄설음 [ɾ], 종성·ㄹㄹ 연쇄 설측음 [l]\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"'고기'의 표준 발음에 대한 음성 전사로 옳은 것은?\",\"choices\":[\"[koki]\",\"[gogi]\",\"[kʰogi]\",\"[kogi]\",\"[k*ogi]\"],\"answer\":4,\"explain\":\"평음 /ㄱ/은 어두에서 무성 파열음 [k]로, 유성음(모음) 사이에서는 유성음화되어 [g]로 실현된다. 어두를 [g]로 전사하거나 어중을 [k]로 전사한 것, 격음 [kʰ]·경음 [k*]으로 전사한 것은 모두 틀리다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"평음 유성음화 전사\",\"p\":\"어두·모음 사이 평음의 실현을 근거로 음성 전사 선택\",\"n\":\"평음 /ㄱ/: 어두 무성 [k], 유성음 사이 유성음화 [g]\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 자음의 일반적인 습득 순서에 관한 설명으로 옳은 것은?\",\"choices\":[\"치조 마찰음 /ㅅ, ㅆ/은 가장 이른 시기에 습득된다\",\"유음 /ㄹ/은 양순 파열음보다 먼저 습득된다\",\"모든 종성 자음은 초성 자음보다 늦게 습득된다\",\"치조 마찰음은 만 3세 이전에 완전 습득된다\",\"비음과 파열음은 파찰음·마찰음보다 먼저 습득된다\"],\"answer\":5,\"explain\":\"우리말 자음은 대체로 비음·파열음 → 파찰음 → 유음·마찰음 순으로 습득되며, /ㅅ, ㅆ/과 /ㄹ/이 가장 늦게 완성된다. 종성 비음(/ㅁ, ㅇ/)은 비교적 이른 시기에 습득되므로 모든 종성이 초성보다 늦다는 설명은 틀리다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"자음 습득 순서\",\"p\":\"조음방법별 자음 습득 시기 차이로 옳은 설명 판단\",\"n\":\"비음·파열음 → 파찰음 → 유음·마찰음 순 습득, /ㅅ, ㄹ/ 가장 늦음\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 음운인식 과제 중 일반적으로 가장 늦게 발달하는 것은?\",\"choices\":[\"'토마토'를 듣고 손뼉을 치며 음절 수 세기\",\"'밤'에서 /ㅁ/을 빼고 말하기\",\"'바나나'에서 '바'를 빼고 말하기\",\"/ㄱ/, /ㅗ/, /ㅁ/을 합쳐 '곰' 말하기\",\"'사'와 '자'를 합쳐 '사자' 말하기\"],\"answer\":2,\"explain\":\"음운인식은 큰 단위(음절)에서 작은 단위(음소)로 발달하며, 같은 음소 수준에서도 합성보다 탈락·대치 과제가 더 어렵다. 따라서 음소 탈락('밤'에서 /ㅁ/ 빼기)이 가장 늦게 발달한다. 음절 수 세기·음절 합성·음절 탈락은 음절 수준, 음소 합성은 음소 수준이지만 탈락보다 쉽다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음운인식\",\"k\":\"음운인식 발달 위계\",\"p\":\"단위 크기와 과제 유형으로 가장 늦은 과제 식별\",\"n\":\"음운인식: 음절→음소 순 발달, 합성보다 탈락이 어려움\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말소리 습득 연령 기준에 관한 설명으로 옳은 것은?\",\"choices\":[\"출현연령은 해당 연령 아동의 95% 이상이 정조음한 연령이다\",\"출현연령은 네 단계 중 완전습득연령보다 늦게 나타난다\",\"관습적 습득연령은 해당 연령 아동의 75~94%가 정조음한 연령이다\",\"숙달연령은 해당 연령 아동의 25~49%가 정조음한 연령이다\",\"완전습득연령은 해당 연령 아동의 95~100%가 정조음한 연령이다\"],\"answer\":5,\"explain\":\"우리말 자음 습득 연구(김영태)에서 출현연령은 25~49%, 관습적 습득연령은 50~74%, 숙달연령은 75~94%, 완전습득연령은 95~100%의 아동이 정조음한 연령으로 정의된다. 출현연령이 가장 이르고 완전습득연령이 가장 늦다. ①은 완전습득 기준, ③은 숙달연령 기준, ④는 출현연령 기준을 잘못 연결한 것이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"말소리 습득연령 기준\",\"p\":\"정조음 아동 비율에 따른 습득연령 단계 정의 판단\",\"n\":\"출현 25~49%, 관습 50~74%, 숙달 75~94%, 완전습득 95~100%\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"아동의 말소리 오류를 '성인 형태를 단순화하는 자연스러운 과정(음운변동)'으로 보고, 발달과 함께 이 과정이 억제되면서 성인 음운체계에 도달한다고 설명한 이론은?\",\"choices\":[\"행동주의 학습이론\",\"생성음운론\",\"자연음운론\",\"최적성이론\",\"운율음운론\"],\"answer\":3,\"explain\":\"자연음운론(Stampe)은 아동이 타고난 자연적 음운변동(단순화 과정)을 성장하면서 억제·제한하여 성인 체계에 이른다고 본다. 생성음운론은 변별자질과 규칙 체계, 최적성이론은 제약의 서열, 행동주의는 강화 학습으로 말소리 발달을 설명한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"자연음운론 개념\",\"p\":\"음운변동 억제로 발달을 설명하는 이론 식별\",\"n\":\"자연음운론(Stampe): 타고난 음운변동을 억제해 성인 체계 도달\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 중 왜곡(distortion) 오류에 해당하는 것은?\",\"choices\":[\"'사'의 /ㅅ/을 혀 옆으로 공기가 새는 소리로 산출함\",\"'고래'의 /ㄹ/을 산출하지 않고 [고애]로 말함\",\"'오리'의 어두에 /ㅁ/을 덧붙여 [모리]로 말함\",\"'사탕'의 /ㅅ/을 /ㅌ/으로 바꾸어 [타탕]으로 말함\",\"'밥'의 종성 /ㅂ/을 빼고 [바]로 말함\"],\"answer\":1,\"explain\":\"왜곡은 목표음이 우리말 음소 목록에 없는 비표준 소리로 산출되는 오류로, 공기가 혀 옆으로 새는 /ㅅ/의 설측음화가 대표적이다. ④ [타탕]은 다른 음소로 바뀐 대치, ② [고애]·⑤ [바]는 생략, ③ [모리]는 첨가 오류이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"조음 오류 유형 분류\",\"p\":\"오조음 예시를 보고 왜곡 오류 식별\",\"n\":\"왜곡: 음소 목록에 없는 비표준음 산출, 예 /ㅅ/ 설측음화\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"가방 → [다방]\\n코 → [토]\\n공 → [동]\",\"q\":\"이 아동이 보이는 음운오류패턴은?\",\"choices\":[\"파열음화\",\"치조음 후방화\",\"연구개음 전방화\",\"양순음화\",\"탈기식음화\"],\"answer\":3,\"explain\":\"연구개음 /ㄱ, ㅋ/이 조음위치가 앞쪽인 치조음 /ㄷ, ㅌ/으로 바뀌었으므로 연구개음 전방화이다. 조음방법(파열음)과 발성유형(평음·격음)은 유지되어 파열음화나 탈기식음화가 아니며, 뒤쪽으로 이동한 후방화도 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"음운오류패턴 판별\",\"p\":\"연구개음이 치조음으로 바뀐 예를 근거로 패턴 판단\",\"n\":\"연구개음 전방화: /ㄱ, ㅋ/ → /ㄷ, ㅌ/, 조음방법·발성유형 유지\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 4세 아동의 오류 중 일반적인 음운발달 과정에서 잘 나타나지 않는 비발달적 오류패턴에 해당하여 우선 중재가 필요한 것은?\",\"choices\":[\"나비 → [아비]\",\"딸기 → [딸디]\",\"라면 → [야면]\",\"사자 → [다자]\",\"책 → [채]\"],\"answer\":1,\"explain\":\"어두 초성 생략(나비→[아비])은 정상 발달에서 거의 나타나지 않는 비발달적 패턴이다. 연구개음 전방화([딸디]), 유음의 활음화([야면]), 마찰음의 파열음화([다자]), 종성생략([채])은 어린 아동에게 흔히 관찰되는 발달적 패턴이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"비발달적 오류 식별\",\"p\":\"발달 과정에서 드문 오류를 근거로 우선 중재 대상 식별\",\"n\":\"어두 초성 생략: 정상 발달에서 드문 비발달적 오류패턴\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"사과 → [가과]\\n두부 → [부부]\",\"q\":\"두 오류에 공통적으로 해당하는 오류패턴은?\",\"choices\":[\"순행동화\",\"전방화\",\"음절 반복\",\"후방화\",\"역행동화\"],\"answer\":5,\"explain\":\"두 예 모두 앞 자음이 뒤에 오는 자음(/ㄱ/, /ㅂ/)의 영향을 받아 같은 소리로 바뀌었으므로 뒤 소리가 앞 소리에 영향을 준 역행동화이다. 순행동화는 앞 소리가 뒤 소리를 바꾸는 경우이며, 전방화·후방화는 문맥과 무관하게 조음위치가 이동하는 대치 패턴이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"동화 방향 판별\",\"p\":\"뒤 자음이 앞 자음을 바꾼 공통점으로 동화 유형 판단\",\"n\":\"역행동화: 뒤 소리가 앞 소리에 영향, 순행동화는 반대 방향\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"사과 → [자과]\\n새 → [재]\\n수박 → [주박]\",\"q\":\"이 아동이 보이는 오류패턴은?\",\"choices\":[\"마찰음의 파열음화\",\"파찰음의 마찰음화\",\"구개음화\",\"마찰음의 파찰음화\",\"경음화\"],\"answer\":4,\"explain\":\"치조 마찰음 /ㅅ/이 파찰음 /ㅈ/으로 바뀌었으므로 마찰음의 파찰음화이다. 파열음화는 /ㄷ/ 등 파열음으로 바뀌는 것이고, 파찰음의 마찰음화는 반대 방향(/ㅈ/→/ㅅ/)이며, 경음화는 발성유형 변화이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"조음방법 변동 판별\",\"p\":\"/ㅅ/→/ㅈ/ 대치 예를 근거로 오류패턴 판단\",\"n\":\"마찰음의 파찰음화: /ㅅ/ → /ㅈ/, 반대 방향은 파찰음의 마찰음화\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"자극반응도(stimulability)에 관한 설명으로 옳은 것은?\",\"choices\":[\"독립음 수준에서만 평가하며 단어·문장 수준은 평가하지 않는다\",\"자발화에서 목표 음소가 오조음되는 빈도를 백분율로 나타낸 것이다\",\"자극반응도가 높은 음소는 자연 회복 가능성이 낮아 우선 치료한다\",\"모델이나 단서를 주었을 때 오조음을 정조음할 수 있는 정도이다\",\"말명료도와 같은 개념으로, 청자가 알아듣는 정도를 뜻한다\"],\"answer\":4,\"explain\":\"자극반응도는 청각·시각·촉각 단서나 모델을 주었을 때 오조음을 정조음으로 산출할 수 있는 능력으로, 독립음·음절·단어 수준에서 평가한다. 자극반응도가 높은 음소는 예후가 좋고 자연 회복 가능성이 높다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"자극반응도 개념\",\"p\":\"자극반응도의 정의와 예후 관련성 판단\",\"n\":\"자극반응도: 모델·단서 제공 시 정조음 가능 정도, 높을수록 예후 양호\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"토끼 신발 → [토띠 신발]\",\"q\":\"이 발화의 자음정확도(PCC)는?\",\"choices\":[\"5/6×100(%)\",\"4/6×100(%)\",\"4/7×100(%)\",\"5/7×100(%)\",\"5/8×100(%)\"],\"answer\":1,\"explain\":\"목표 자음은 '토끼'의 /ㅌ, ㄲ/, '신발'의 /ㅅ, ㄴ, ㅂ, ㄹ/로 총 6개이다. 이 중 /ㄲ/→[ㄸ] 1개만 오류이므로 5/6×100이다. 초성 'ㅇ'(음가 없음)이나 모음은 자음 수에 포함하지 않는다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PCC 산출\",\"p\":\"목표 자음 수와 오류 자음 수로 자음정확도 산출\",\"n\":\"PCC: 정조음 자음 수/목표 자음 수×100, 음가 없는 ㅇ 제외\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"모자 → [모다]\\n김 → [김]\",\"q\":\"두 단어의 평균음운길이(PMLU)는?\",\"choices\":[\"8/2\",\"9/2\",\"11/2\",\"10/2\",\"12/2\"],\"answer\":4,\"explain\":\"PMLU는 아동 산출의 분절음마다 1점, 정조음한 자음마다 1점을 추가한다. [모다]는 분절음 4개 + 정조음 자음 /ㅁ/ 1개 = 5점(/ㅈ/→[ㄷ]는 추가점 없음), [김]은 분절음 3개 + 정조음 자음 2개 = 5점이다. 합계 10점을 단어 수 2로 나누어 10/2이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PMLU 산출\",\"p\":\"분절음 수와 정조음 자음 가산점으로 평균음운길이 산출\",\"n\":\"PMLU: 분절음당 1점 + 정조음 자음당 1점, 단어 수로 나눔\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말명료도(speech intelligibility)에 관한 설명으로 옳은 것은?\",\"choices\":[\"자음정확도가 같은 아동은 말명료도도 같게 나타난다\",\"말용인도(acceptability)와 같은 개념이다\",\"청자가 화자의 말을 알아듣는 정도로, 평정척도 등으로 측정한다\",\"왜곡 오류가 생략 오류보다 말명료도를 더 크게 떨어뜨린다\",\"청자의 친숙도는 말명료도 평가 결과에 영향을 미치지 않는다\"],\"answer\":3,\"explain\":\"말명료도는 청자가 화자의 메시지를 알아듣는 정도로 등간척도 평정이나 알아들은 단어 비율(단어 확인 과제)로 측정한다. 오류 유형·일관성·문맥·청자 친숙도 등 여러 요인이 영향을 미치므로 자음정확도와 항상 일치하지 않으며, 생략이 왜곡보다 명료도를 더 떨어뜨린다. 말용인도는 말이 자연스럽고 정상적으로 들리는 정도로 다른 개념이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"말명료도 개념\",\"p\":\"말명료도의 정의·측정·영향 요인에 대한 설명 판단\",\"n\":\"말명료도: 청자가 알아듣는 정도, 평정척도·단어 확인으로 측정\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 중 말명료도를 가장 크게 저하시킬 것으로 예상되는 오류는?\",\"choices\":[\"/ㅅ/의 일관된 치간음화 왜곡\",\"어말 종성 /ㄹ/의 가벼운 왜곡\",\"여러 위치에서 나타나는 초성 생략\",\"/ㅈ/ 한 음소의 일관된 파열음화\",\"어말 종성 /ㅇ/의 약화\"],\"answer\":3,\"explain\":\"오류 유형 중 생략이 명료도에 가장 큰 영향을 주고 대치, 왜곡 순이며, 여러 음소·위치에 걸친 오류일수록 명료도가 더 낮아진다. 단일 음소의 왜곡이나 한 음소의 일관된 대치는 비교적 명료도 저하가 적다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"명료도 영향 요인\",\"p\":\"오류 유형과 범위를 근거로 명료도 저하가 큰 오류 판단\",\"n\":\"명료도 영향: 생략 > 대치 > 왜곡, 여러 음소·위치일수록 더 저하\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"• 37개 단어 이름대기와 연결발화 검사로 구성\\n• 자음정확도와 음운오류패턴 분석 결과를 제공\",\"q\":\"해당하는 검사는?\",\"choices\":[\"아동용 발음평가(APAC)\",\"우리말 조음음운검사2(U-TAP2)\",\"한국어 표준 그림 조음음운검사(KS-PAPT)\",\"한국어 읽기 검사(KOLRA)\",\"취학전 언어발달척도(PRES)\"],\"answer\":1,\"explain\":\"APAC은 37개 단어 검사와 연결발화 검사로 자음정확도와 오류패턴을 분석하는 검사이다. U-TAP2는 단어·문장 수준 검사로 구성되며, KS-PAPT는 선별·정밀검사로 나뉜다. KOLRA는 읽기, PRES는 언어발달 검사이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"조음음운 검사도구 식별\",\"p\":\"검사 구성과 분석 결과 특성으로 해당 검사 식별\",\"n\":\"APAC: 37개 단어 + 연결발화, 자음정확도·오류패턴 분석\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"독립분석(independent analysis)에 관한 설명으로 옳은 것은?\",\"choices\":[\"성인 목표형과 비교하여 대치·생략·왜곡 오류를 분류한다\",\"성인 목표형과 비교 없이 아동의 음소 목록과 음절구조를 기술한다\",\"자음정확도(PCC)를 산출하여 심각도를 판정하는 분석이다\",\"학령기 잔존오류 아동의 왜곡 분석에 가장 적합하다\",\"음운오류패턴별 출현율을 계산하여 치료 목표를 정한다\"],\"answer\":2,\"explain\":\"독립분석은 아동의 산출 자체를 하나의 체계로 보고 자음·모음 목록과 음절구조 목록을 기술하며, 어리거나 명료도가 매우 낮은 아동에게 유용하다. 성인 목표형과 비교하는 오류 분류, 자음정확도, 오류패턴 출현율은 관계분석에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"독립분석과 관계분석\",\"p\":\"성인 목표형 비교 여부로 독립분석 특성 판단\",\"n\":\"독립분석: 목표형 비교 없이 음소·음절구조 목록 기술\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"자음정확도(PCC)가 48%인 아동의 말소리장애 심각도(Shriberg & Kwiatkowski 기준)는?\",\"choices\":[\"중도(severe)\",\"경도-중등도(mild-moderate)\",\"중등도-중도(moderate-severe)\",\"경도(mild)\",\"정상 범위\"],\"answer\":1,\"explain\":\"PCC 심각도 기준은 85% 초과 경도, 65~85% 경도-중등도, 50~65% 중등도-중도, 50% 미만 중도이다. 48%는 50% 미만이므로 중도에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PCC 심각도 판정\",\"p\":\"자음정확도 수치를 기준 구간에 대응해 심각도 판단\",\"n\":\"PCC 심각도: 50% 미만 중도, 50~65% 중등도-중도\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 아동\\n• 같은 단어를 여러 번 산출할 때 40% 이상 다르게 산출함\\n• 구강운동 기능은 정상이고 모색행동이 없음\\n• 운율은 자연스러움\",\"q\":\"Dodd의 분류에 따른 이 아동의 말소리장애 유형은?\",\"choices\":[\"음운지연\",\"비일관적 음운장애\",\"일관적 음운장애\",\"아동기 말실행증\",\"조음장애\"],\"answer\":2,\"explain\":\"같은 단어를 반복 산출할 때 40% 이상 변이를 보이면서 구강운동·운율 문제가 없으면 비일관적 음운장애이다. 아동기 말실행증도 비일관성을 보이지만 모색행동, 동시조음 전이 어려움, 운율 이상을 동반한다. 음운지연은 발달적 패턴이 늦게까지 남는 것, 일관적 음운장애는 비발달적 패턴을 일관되게 보이는 것이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"말소리장애 하위유형 감별\",\"p\":\"반복 산출 변이율과 운동 소견으로 Dodd 유형 판단\",\"n\":\"비일관적 음운장애: 40% 이상 변이, 모색행동·운율 이상 없음\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"아동기 말실행증(CAS)의 핵심 특징으로 옳게 묶인 것은?\",\"choices\":[\"발달적 오류패턴, 양호한 말명료도, 정확한 모음 산출\",\"과다비성, 말 근육의 근력 약화, 느린 말속도\",\"일관된 대치, 높은 자극반응도, 정상적인 운율\",\"한 음소의 일관된 왜곡, 청력 손실, 구조적 이상\",\"비일관적 오류, 동시조음 전이 어려움, 부적절한 운율\"],\"answer\":5,\"explain\":\"CAS는 말운동 계획·프로그래밍의 문제로 자음·모음의 비일관적 오류, 음소·음절 간 전이의 연장과 단절, 부적절한 강세·운율이 핵심 특징이다. 근력 약화와 과다비성은 마비말장애, 일관된 발달적 대치는 음운지연의 특징이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말운동 말소리장애\",\"k\":\"아동기 말실행증 특징\",\"p\":\"말운동 계획 결함의 핵심 증상 조합 식별\",\"n\":\"CAS: 비일관적 오류, 음소·음절 간 전이 어려움, 부적절한 운율\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"구개열 아동의 말 특성에 관한 설명으로 옳은 것은?\",\"choices\":[\"비음 /ㅁ, ㄴ, ㅇ/이 구강 자음보다 더 큰 영향을 받는다\",\"고압력 자음이 약하게 산출되고 비누출이 동반될 수 있다\",\"보상조음은 조음위치가 구강 앞쪽으로 전방화된 것이다\",\"모음이 자음보다 더 큰 영향을 받아 명료도가 낮아진다\",\"비강 공명이 부족한 과소비성이 주된 공명 문제이다\"],\"answer\":2,\"explain\":\"연인두 폐쇄부전이 있으면 구강 내 압력을 형성해야 하는 고압력 자음(파열·마찰·파찰음)이 약해지고 비누출과 과다비성이 나타난다. 비음은 원래 비강 공명을 이용하므로 영향이 적고, 보상조음(성문파열음·인두마찰음 등)은 조음위치가 뒤쪽(후방)으로 이동한 것이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"구개열 말 특성\",\"p\":\"연인두 폐쇄부전 영향을 근거로 말 특성 판단\",\"n\":\"연인두 폐쇄부전: 고압력 자음 약화, 비누출, 과다비성, 후방 보상조음\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"선천성 심도 감각신경성 난청 아동의 말 특성으로 옳은 것은?\",\"choices\":[\"저주파수 비음 /ㅁ, ㄴ/이 마찰음보다 먼저 손상된다\",\"모음은 손상되지 않고 자음에서만 오류가 나타난다\",\"운율과 음도는 건청 아동과 같이 정상적으로 유지된다\",\"말속도가 빠르고 말명료도가 대체로 양호하다\",\"고주파수 마찰음의 생략·왜곡, 모음 중립화가 나타난다\"],\"answer\":5,\"explain\":\"청각 피드백 결여로 고주파수 에너지가 큰 마찰음이 생략·왜곡되고, 모음이 중앙화(중립화)되며, 종성 생략과 음도·운율 이상, 과다비성이 나타나 명료도가 낮다. 저주파수 비음은 비교적 잘 산출된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"청각·청각장애\",\"k\":\"청각장애 말 특성\",\"p\":\"청각 피드백 결여에 따른 말 산출 특성 식별\",\"n\":\"심도 난청: 고주파 마찰음 생략·왜곡, 모음 중립화, 운율 이상\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"음운장애보다 조음장애(운동적 말소리장애)에 더 부합하는 특징은?\",\"choices\":[\"여러 음소에 걸쳐 일관되게 나타나는 대치 패턴\",\"종성생략이 많아 나타나는 낮은 말명료도\",\"음운인식 결함과 읽기·쓰기 어려움을 동반함\",\"/ㅅ/의 일관된 설측음화 외 다른 음소는 정확함\",\"여러 음소가 하나의 음소로 대치되는 음소 붕괴 현상\"],\"answer\":4,\"explain\":\"조음장애는 말소리 산출의 운동적 문제로 소수 음소의 일관된 왜곡이 특징이며 명료도 저하가 적다. 여러 음소에 걸친 대치 패턴, 종성생략, 음소 붕괴, 음운인식 결함은 음운 체계(언어적) 문제인 음운장애의 특징이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"조음장애·음운장애 구분\",\"p\":\"오류 범위와 일관성으로 조음장애 특징 식별\",\"n\":\"조음장애: 소수 음소 일관된 왜곡, 음운장애는 체계적 대치 패턴\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"전통적 조음치료법(Van Riper)의 단계 순서로 옳은 것은?\",\"choices\":[\"단어 훈련 → 독립음 확립 → 감각-지각 훈련 → 유지 → 전이\",\"감각-지각 훈련 → 독립음 확립 → 안정화 → 전이 → 유지\",\"독립음 확립 → 감각-지각 훈련 → 전이 → 문장 안정화 → 유지\",\"전이 → 감각-지각 훈련 → 독립음 확립 → 안정화 → 유지\",\"감각-지각 훈련 → 문장 훈련 → 독립음 확립 → 유지 → 전이\"],\"answer\":2,\"explain\":\"전통적 접근법은 목표음을 듣고 변별하는 감각-지각(청지각) 훈련으로 시작하여 독립음에서 목표음을 확립한 뒤, 음절·단어·구·문장·대화로 점차 확장(안정화)하고 치료실 밖으로 전이시킨 후 유지 단계를 거친다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"전통적 조음치료 단계\",\"p\":\"Van Riper 접근의 치료 단계 순서 선택\",\"n\":\"감각-지각 훈련 → 독립음 확립 → 안정화 → 전이 → 유지\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"짝자극 기법(paired-stimuli approach)에 관한 설명으로 옳은 것은?\",\"choices\":[\"핵심단어는 목표음을 10회 중 3회 이하로 정조음하는 단어이다\",\"정조음하는 핵심단어와 오조음하는 훈련단어를 짝지어 연습한다\",\"최소대립쌍을 이용하여 단어 간 의미 대조를 가르친다\",\"독립음 수준에서 목표음을 확립하며 훈련을 시작한다\",\"청각적 자극(auditory bombardment)이 핵심이다\"],\"answer\":2,\"explain\":\"짝자극 기법은 아동이 목표음을 안정적으로 정조음하는 핵심단어(10회 중 9회 이상 정조음)를 오조음하는 훈련단어와 번갈아 산출하게 하여 정조음을 전이시키는 단어 수준의 기법이다. 최소대립쌍은 음운론적 접근, 청각적 자극은 주기법의 절차이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"짝자극 기법 원리\",\"p\":\"핵심단어와 훈련단어 짝짓기 원리로 기법 특성 판단\",\"n\":\"짝자극 기법: 정조음 핵심단어와 오조음 훈련단어 교대 산출\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 아동이 /ㅅ, ㅈ, ㄱ, ㅋ/을 모두 /ㄷ/으로 대치함\\n(예: 사과 → [다과], 자 → [다], 공 → [동], 코 → [도])\",\"q\":\"이 아동에게 가장 적합한 대조 접근법은?\",\"choices\":[\"최소대립쌍 접근법\",\"최대대립 접근법\",\"짝자극 기법\",\"다중대립 접근법\",\"핵심어휘 접근법\"],\"answer\":4,\"explain\":\"여러 음소가 하나의 음소로 붕괴(phoneme collapse)된 경우, 대치음 /ㄷ/과 여러 목표음을 동시에 대조하는 다중대립 접근법이 적합하다. 최소대립쌍은 한 자질 차이의 두 음소, 최대대립은 자질 차이가 큰 두 음소를 대조하고, 핵심어휘 접근법은 비일관적 음운장애에 사용한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"대조 접근법 선택\",\"p\":\"여러 음소가 한 음소로 붕괴된 양상으로 접근법 선택\",\"n\":\"다중대립 접근법: 음소 붕괴 시 대치음과 여러 목표음 동시 대조\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"주기법(cycles approach)에 관한 설명으로 옳은 것은?\",\"choices\":[\"잔존오류를 보이는 학령기 아동이 주된 치료 대상이다\",\"말소리 자질에 대한 상위언어적 인식 지도가 치료의 1단계이다\",\"한 패턴을 완전히 숙달한 뒤에 다음 패턴으로 넘어간다\",\"독립음 수준의 반복적인 산출 훈련이 중심이 된다\",\"숙달 여부와 관계없이 정해진 기간 후 다음 패턴으로 순환한다\"],\"answer\":5,\"explain\":\"주기법(Hodson & Paden)은 말명료도가 매우 낮은 아동을 대상으로 오류패턴별 목표음을 일정 시간 훈련한 뒤 숙달 기준 없이 다음 패턴으로 순환하고, 회기마다 청각적 자극(auditory bombardment)을 제공한다. 숙달 후 진행은 수직적 접근, 상위언어적 인식 지도는 상위음운 접근법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"주기법 원리\",\"p\":\"숙달 기준 없는 순환 진행을 근거로 주기법 특성 판단\",\"n\":\"주기법: 명료도 낮은 아동, 숙달과 무관한 패턴 순환, 청각적 자극\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"상위음운 접근법(Metaphon)의 1단계에서 실시하는 활동으로 적절한 것은?\",\"choices\":[\"최대대립쌍 단어를 반복 산출하며 산출 정확도를 높인다\",\"구강 근육 강화 운동으로 조음기관을 준비시킨다\",\"'긴 소리/짧은 소리' 같은 대조 개념을 인식하게 한다\",\"대화 수준에서 의사소통 수정 전략을 반복 연습한다\",\"비단어 따라말하기로 음운 작업기억을 훈련한다\"],\"answer\":3,\"explain\":\"상위음운 접근법 1단계는 개념 수준(긴/짧은, 앞/뒤 등 비언어적 속성)에서 시작해 소리·음소·단어 수준으로 말소리 자질의 대조를 인식시키는 단계이고, 2단계에서 의사소통 상황에서 이를 활용해 산출을 수정하게 한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"상위음운 접근법 단계\",\"p\":\"개념 수준 대조 인식 여부로 Metaphon 1단계 활동 선택\",\"n\":\"Metaphon 1단계: 긴/짧은 등 개념 수준부터 소리 자질 대조 인식\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"핵심어휘 접근법(core vocabulary approach)에 관한 설명으로 옳은 것은?\",\"choices\":[\"최소대립쌍의 의미 대조를 이용해 음운 체계를 재구조화한다\",\"잔존오류 아동을 대상으로 /ㅅ/ 등의 왜곡음을 교정한다\",\"하나의 음소를 독립음 수준에서 먼저 확립하고 확장한다\",\"말실행증 아동의 운율과 강세 개선을 1차 목표로 삼는다\",\"비일관적 음운장애 아동에게 기능적 단어를 일관되게 산출시킨다\"],\"answer\":5,\"explain\":\"핵심어휘 접근법(Dodd)은 비일관적 음운장애 아동에게 자주 쓰는 기능적 단어를 선정하여 완전한 정조음이 아니더라도 아동이 할 수 있는 최선의 산출을 일관되게 하도록 훈련한다. 의미 대조를 이용한 재구조화는 최소대립쌍 등 음운론적 대조 접근법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"핵심어휘 접근법 대상\",\"p\":\"대상 유형과 훈련 목표로 핵심어휘 접근법 특성 판단\",\"n\":\"핵심어휘 접근법: 비일관적 음운장애, 기능적 단어의 일관된 산출\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"치료 결과, 어두 초성에서만 훈련한 /ㅅ/를 훈련하지 않은 어중 초성('가수', '버섯')에서도 정조음하게 되었다.\",\"q\":\"이에 해당하는 일반화 유형은?\",\"choices\":[\"위치 일반화\",\"언어단위 일반화\",\"상황 일반화\",\"음소 간 일반화\",\"문맥 일반화\"],\"answer\":1,\"explain\":\"단어 내 훈련하지 않은 위치(어두→어중·어말)로 정조음이 확대되는 것은 위치 일반화이다. 문맥 일반화는 인접 모음 등 음성 문맥, 언어단위 일반화는 음절→단어→문장, 상황 일반화는 치료실 밖 장소·대화상대, 음소 간 일반화는 훈련하지 않은 다른 음소로의 확대를 말한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"일반화 유형 판별\",\"p\":\"훈련하지 않은 단어 내 위치로의 확대를 근거로 일반화 유형 판단\",\"n\":\"위치 일반화: 어두 훈련 효과가 어중·어말 위치로 확대\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"치료사가 한 회기 안에서 /ㅅ/, /ㄹ/, 종성 /ㄱ/ 세 가지 목표를 각각 15분씩 나누어 동시에 훈련하고 있다.\",\"q\":\"이 치료사가 사용한 목표 접근 전략은?\",\"choices\":[\"수직적 접근법\",\"주기적 접근법\",\"수평적 접근법\",\"절충적 접근법\",\"위계적 접근법\"],\"answer\":3,\"explain\":\"여러 목표음을 한 회기에서 동시에 다루는 것은 수평적 접근법이다. 수직적 접근법은 한두 개 목표를 준거에 도달할 때까지 집중 훈련한 뒤 다음으로 넘어가고, 주기적 접근법은 일정 기간 단위로 목표를 순환한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"목표 접근 전략 구분\",\"p\":\"한 회기 여러 목표 동시 훈련을 근거로 전략 식별\",\"n\":\"수평적 접근: 여러 목표 동시 훈련, 수직적은 준거 도달 후 이동\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 행동을 핵심행동과 부수행동(탈출행동·회피행동)으로 분류하려 한다.\",\"q\":\"행동과 분류가 옳게 연결된 것은?\",\"choices\":[\"말하는 도중 입술이 붙은 채 소리가 막힘 – 탈출행동\",\"막힌 순간 눈을 세게 깜박임 – 핵심행동\",\"첫소리를 길게 늘여 말함(소리 연장) – 회피행동\",\"어려운 낱말을 다른 낱말로 바꿔 말하기 – 회피행동\",\"고개를 갑자기 젖히며 막힘에서 벗어나기 – 핵심행동\"],\"answer\":4,\"explain\":\"핵심행동은 반복·연장·막힘 등 말더듬 자체이고, 부수행동은 이에 대한 반응으로 학습된 행동이다. 낱말 대치(바꿔 말하기)는 말더듬을 예상하고 미리 피하는 회피행동이다. 막힘과 연장은 핵심행동이며, 눈 깜박임·고개 젖히기처럼 이미 시작된 말더듬에서 빠져나오려는 행동은 탈출행동(부수행동)이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"핵심·부수행동 분류\",\"p\":\"말더듬 자체와 학습된 반응의 구분으로 행동 분류 짝 식별\",\"n\":\"핵심행동은 반복·연장·막힘, 낱말 대치는 회피행동, 눈 깜박임·고개 젖히기는 탈출행동\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"아동의 비유창성을 진성 비유창성(SLD)과 기타 비유창성(OD)으로 나누어 분석하려 한다.\",\"q\":\"비유창성 유형과 분류가 옳게 연결된 것은?\",\"choices\":[\"\\\"나 나 나 갈래\\\"(1음절 낱말 반복) – 기타 비유창성\",\"\\\"나는 나는 갈래\\\"(구 반복) – 기타 비유창성\",\"\\\"음, 어\\\"(간투사) – 진성 비유창성\",\"\\\"나는, 아니 우리는 갈래\\\"(수정) – 진성 비유창성\",\"\\\"ㅅ---사탕\\\"(소리 연장) – 기타 비유창성\"],\"answer\":2,\"explain\":\"진성 비유창성(SLD)은 낱말부분(음소·음절) 반복, 1음절 낱말 반복, 연장·막힘 등 비운율적 발성으로, 말더듬 아동에게 특징적이다. 기타 비유창성(OD)은 간투사, 수정, 미완성, 구·다음절 낱말 전체 반복 등 일반 아동에게도 흔한 비유창성이다. 따라서 구 반복을 기타 비유창성으로 연결한 ②만 옳다. 1음절 낱말 반복(①)과 소리 연장(⑤)은 진성 비유창성이고, 간투사(③)와 수정(④)은 기타 비유창성이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"SLD·OD 분류\",\"p\":\"비유창성 형태별 특성으로 진성·기타 비유창성 분류 판단\",\"n\":\"SLD: 낱말부분·1음절 낱말 반복·연장·막힘, OD: 간투사·수정·구 반복\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 발생·발달을 설명하는 이론에 대한 설명으로 옳은 것은?\",\"choices\":[\"진단착오이론 – 양쪽 대뇌반구의 우세 경쟁으로 말운동 협응이 실패하여 말더듬이 생긴다\",\"요구-용량 모델 – 환경적 요구가 아동의 말 산출 용량을 초과하면 비유창성이 생긴다\",\"대뇌반구 우세이론 – 부모가 정상적 비유창성을 말더듬으로 낙인찍어 말더듬이 생긴다\",\"예기투쟁가설 – 말더듬은 유전적 요인으로 생기는 말운동 조절 장애로, 학습의 영향은 적다\",\"내적수정가설 – 말더듬은 청자의 부정적 반응에 의해 강화되어 유지되는 조작적 행동이다\"],\"answer\":2,\"explain\":\"요구-용량 모델(Starkweather)은 말속도·언어 복잡성·시간 압박 등 요구가 아동의 말운동·언어·정서·인지 용량을 넘어설 때 비유창성이 발생한다고 본다. 진단착오이론은 부모의 낙인, 대뇌반구 우세이론은 양반구 우세 경쟁, 예기투쟁가설은 말더듬을 예상하고 피하려는 투쟁 반응, 내적수정가설은 음운 계획 오류를 내적으로 감지·수정하는 과정에서 비유창성이 생긴다는 설명이므로 보기의 연결은 모두 잘못되었다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"말더듬 발생 이론\",\"p\":\"이론별 핵심 설명 내용 대조로 옳은 이론 연결 식별\",\"n\":\"요구-용량 모델: 환경적 요구가 아동의 말 산출 용량을 초과하면 비유창성 발생\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"Guitar의 말더듬 발달 단계 중 '경계선급 말더듬'에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"반복 단위 수가 많으나 긴장·부수행동이 거의 없고 인식도 없다\",\"말더듬을 예상한 낱말 회피와 말하기 상황 회피가 나타나기 시작한다\",\"말더듬에 대한 두려움과 부정적 자아개념이 확고하게 자리 잡혀 있다\",\"막힘과 함께 눈 깜박임 등 탈출행동이 뚜렷하게 나타난다\",\"비유창성 대부분이 간투사·수정이며 그 빈도도 낮은 편이다\"],\"answer\":1,\"explain\":\"경계선급 말더듬은 정상적 비유창성보다 비유창성 빈도가 높고(대략 100낱말당 10회 이상) 반복 단위 수가 2회 이상으로 많으나, 긴장·막힘·탈출행동은 거의 없고 아동이 자신의 말을 의식하지 않는 단계이다. 막힘과 탈출행동은 초기 말더듬, 회피와 두려움은 중간급, 부정적 자아개념의 확립은 심화된 말더듬의 특징이며 간투사·수정 위주의 낮은 빈도는 정상적 비유창성에 해당한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"발달 단계·감별\",\"k\":\"Guitar 발달 단계 특징\",\"p\":\"반복 단위 수·긴장·인식 유무로 경계선급 말더듬 특징 식별\",\"n\":\"경계선급 말더듬: 반복 단위 수 많음, 긴장·부수행동 거의 없음, 인식 없음\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 52세 남성, 뇌경색 후 말더듬이 시작됨\\n• 아동기 말더듬 병력 없음\\n• 조사·어미 등 기능어와 내용어를 가리지 않고 반복이 나타남\\n• 같은 문장을 반복해서 읽어도 말더듬이 줄지 않음\\n• 부수행동과 말에 대한 불안이 거의 없음\",\"q\":\"이 대상자에게 가장 적절한 유창성장애 유형은?\",\"choices\":[\"발달성 말더듬\",\"속화(말빠름증)\",\"심인성 말더듬\",\"신경학적 말더듬\",\"경계선급 말더듬\"],\"answer\":4,\"explain\":\"성인기 뇌손상 이후 시작되고, 기능어·내용어 구분 없이 낱말 위치와 무관하게 비유창성이 나타나며, 적응효과가 없고 부수행동과 불안이 적은 것은 신경학적 말더듬의 특징이다. 발달성 말더듬은 아동기에 시작되고 적응효과와 부수행동을 보이며, 심인성 말더듬은 심리적 외상·스트레스 사건 이후 시작되고 뇌손상이 없다. 속화는 빠르고 불규칙한 말속도와 명료도 저하가 핵심이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"발달 단계·감별\",\"k\":\"신경학적 말더듬 감별\",\"p\":\"뇌손상 후 발병·적응효과 부재·불안 부재로 유창성장애 유형 판단\",\"n\":\"신경학적 말더듬: 뇌손상 후 발병, 낱말 위치 무관, 적응효과 없음, 불안 적음\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"속화(cluttering)에 대한 설명으로 옳은 것은?\",\"choices\":[\"자신의 말 문제를 잘 인식하며 말하기 불안과 회피가 높다\",\"소리·음절 반복과 막힘, 탈출행동이 핵심행동으로 나타난다\",\"말에 주의를 기울여 천천히 말할수록 명료도가 더 나빠진다\",\"언어·화용 및 주의집중 문제는 대체로 동반되지 않는다\",\"빠르고 불규칙한 말속도와 음절 축약·생략으로 명료도가 낮다\"],\"answer\":5,\"explain\":\"속화는 빠르거나 불규칙한 말속도, 음절·낱말의 축약과 생략, 과도한 정상적 비유창성으로 명료도가 떨어지는 유창성장애이며, 언어·화용·주의 문제를 자주 동반한다. 말더듬과 달리 자신의 문제에 대한 인식과 불안이 낮고, 주의를 기울이면 말이 오히려 좋아지는 경향이 있다. 막힘·탈출행동은 말더듬의 특징이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"발달 단계·감별\",\"k\":\"속화 특징\",\"p\":\"말속도·명료도·인식 수준으로 말더듬과 구별되는 속화 특징 식별\",\"n\":\"속화: 빠르고 불규칙한 말속도, 음절 축약·생략, 명료도 저하, 인식·불안 낮음\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말의 유창성을 구성하는 요소로 옳게 묶인 것은?\",\"choices\":[\"명료도 – 강도 – 음도 – 공명\",\"연속성 – 정확성 – 강도 – 음도\",\"정확성 – 명료도 – 억양 – 공명\",\"연속성 – 말속도 – 리듬 – 노력\",\"정확성 – 노력 – 공명 – 억양\"],\"answer\":4,\"explain\":\"유창한 말은 끊김 없이 이어지고(연속성), 적절한 속도와 리듬을 유지하며, 신체적·정신적 노력이 적게 드는 말이다. 명료도·강도·음도·공명·정확성은 조음·음성 영역의 개념으로 유창성 자체의 구성요소가 아니다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"유창성 구성요소\",\"p\":\"유창성 요소와 조음·음성 영역 개념 구분으로 구성요소 식별\",\"n\":\"유창성 구성요소: 연속성·말속도·리듬·노력, 명료도·공명은 조음·음성 개념\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"학령전 말더듬 아동 중 자연회복 가능성이 가장 높은 경우는?\",\"choices\":[\"음운·언어 능력이 또래보다 뚜렷하게 낮은 남아이다\",\"말더듬이 성인기까지 지속된 가족력이 있는 남아이다\",\"발병 후 18개월 이상 지속되며 부수행동이 늘고 있다\",\"여아이며 발병 후 수개월 사이 비유창성이 줄고 있다\",\"5세 이후에 발병하였고 비유창성 빈도에 변화가 없다\"],\"answer\":4,\"explain\":\"자연회복과 관련된 긍정적 예후 요인은 여아, 발병 초기 수개월 이내에 비유창성이 감소하는 경향, 이른 발병, 회복된 가족력, 양호한 음운·언어 능력 등이다. 반대로 남아, 지속된 가족력, 발병 후 12개월 이상 지속, 늦은 발병, 음운 능력 저하, 부수행동 증가는 지속 위험 요인이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말더듬 이론·특성\",\"k\":\"자연회복 예후 요인\",\"p\":\"성별·발병 후 경과·가족력으로 자연회복 가능성 판단\",\"n\":\"자연회복 긍정 요인: 여아, 발병 초기 비유창성 감소, 회복된 가족력, 양호한 언어능력\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말을 더듬는 사람의 말더듬이 일반적으로 감소하는 조건은?\",\"choices\":[\"전화로 낯선 사람과 통화하며 용건을 전할 때\",\"노래하거나 다른 사람과 함께 소리 내어 읽을 때\",\"시간 압박이 큰 상황에서 빠르게 대답할 때\",\"이름·주소 등 바꿔 말할 수 없는 정보를 말할 때\",\"권위 있는 사람 앞에서 공식적으로 발표할 때\"],\"answer\":2,\"explain\":\"노래, 합창읽기(함께 읽기), 혼잣말, 리듬에 맞춰 말하기, 속삭이기 등은 대표적인 유창성 유도 조건이다. 전화 통화, 권위 있는 청자, 시간 압박, 대치할 수 없는 고유 정보(이름·주소) 말하기는 말더듬이 증가하는 상황이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"유창성 유도 조건\",\"p\":\"말더듬 감소 조건과 증가 상황 구분으로 해당 조건 식별\",\"n\":\"유창성 유도 조건: 노래·합창읽기·리듬 말하기·속삭이기, 시간 압박은 증가 요인\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인이 같은 지문을 5회 반복해서 읽었다. 1회에서 더듬은 낱말의 대부분을 5회에서도 같은 위치에서 더듬었다.\",\"q\":\"이 현상을 설명하는 용어는?\",\"choices\":[\"적응효과\",\"일관성 효과\",\"인접효과\",\"청자규모효과\",\"교환효과\"],\"answer\":2,\"explain\":\"반복 읽기에서 말더듬이 발생하는 낱말의 위치가 일정하게 유지되는 현상은 일관성 효과이다. 적응효과는 반복 읽기에서 말더듬 빈도가 점차 감소하는 현상, 인접효과는 이전에 더듬었던 낱말을 제거하면 그 인접 낱말에서 말더듬이 나타나는 현상, 청자규모효과는 청자 수가 많아질수록 말더듬이 증가하는 현상이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"반복 읽기 효과 용어\",\"p\":\"반복 읽기에서 같은 위치 말더듬 유지 현상으로 용어 식별\",\"n\":\"일관성 효과: 반복 읽기에서 같은 낱말 위치에 말더듬 유지, 적응효과는 빈도 감소\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 역학적 특성에 대한 설명으로 옳은 것은?\",\"choices\":[\"출현율은 일생 동안 한 번이라도 말더듬을 경험한 사람의 비율이다\",\"성인기로 갈수록 남녀 비율이 점차 1:1에 가까워진다\",\"대부분 학령기 이후인 7세 이후에 처음 발병한다\",\"발생률이 출현율보다 높은 것은 상당수가 자연회복되기 때문이다\",\"말더듬 발생은 가족력과 뚜렷한 관련이 없다\"],\"answer\":4,\"explain\":\"발생률(일생 중 말더듬을 경험하는 비율, 약 5% 내외)이 출현율(특정 시점의 말더듬 인구 비율, 약 1%)보다 높은 이유는 학령전기에 발병한 아동의 상당수가 자연회복되기 때문이다. 출현율은 특정 시점의 비율이고, 남녀 비율은 연령이 높아질수록 남성 쪽으로 더 커지며(약 4:1), 발병은 대부분 2~5세 학령전기에 일어나고 가족력은 중요한 위험 요인이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"말더듬 역학\",\"p\":\"발생률과 출현율 정의 및 자연회복 관계로 옳은 설명 식별\",\"n\":\"발생률이 출현율보다 높은 이유: 학령전 발병 아동 상당수의 자연회복\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"회피행동의 유형과 예가 옳게 연결된 것은?\",\"choices\":[\"상황회피 – 더듬을 것 같은 어려운 낱말을 쉬운 다른 낱말로 바꿔 말함\",\"대치(substitution) – 막힌 순간 눈을 깜박이며 빠져나옴\",\"에두르기(circumlocution) – 말해야 하는 상황 자체에 참여하지 않음\",\"시작기법(starter) – 더듬었던 낱말을 다시 한 번 말함\",\"연기(postponement) – 어려운 낱말 앞에서 '음…'을 넣어 시작을 미룸\"],\"answer\":5,\"explain\":\"연기는 어려운 낱말 앞에서 간투사·쉼 등으로 시간을 끌어 말더듬을 미루는 회피행동이다. 대치는 어려운 낱말을 다른 낱말로 바꾸는 것이고, 에두르기는 낱말을 피해 돌려 설명하는 것이며, 시작기법은 '그러니까' 같은 말을 앞에 붙여 발화를 시작하는 것, 상황회피는 말하는 상황 자체를 피하는 것이다. 눈 깜박임으로 빠져나오는 것은 회피가 아니라 탈출행동이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"회피행동 유형\",\"p\":\"회피행동 하위 유형의 정의와 예의 연결로 옳은 짝 식별\",\"n\":\"연기: 어려운 낱말 앞 간투사·쉼으로 시작 지연, 대치·에두르기·상황회피와 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"학령기 말더듬 아동의 치료에 대한 설명으로 옳은 것은?\",\"choices\":[\"학교 환경(교사·또래) 요인은 치료 범위에 포함하지 않는다\",\"인식이 생기기 전이므로 부모 중심의 간접치료만 실시한다\",\"놀림에 대처하는 방법과 말더듬에 대한 개방적 태도를 함께 다룬다\",\"부모의 참여는 학령전기에만 필요하므로 치료에서 배제한다\",\"소리 내어 읽기 등 학급 활동에서 면제받도록 교사에게 요청한다\"],\"answer\":3,\"explain\":\"학령기 아동은 말더듬에 대한 인식과 부정적 감정, 또래의 놀림이 문제가 되는 시기이므로 유창성 기법과 함께 놀림·괴롭힘 대처, 말더듬에 대한 개방적 태도, 교사·부모와의 협력을 다룬다. 이 시기에는 직접치료가 중심이 되며, 학급 활동 면제는 회피를 강화하므로 적절하지 않다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"학령기 말더듬 치료 원칙\",\"p\":\"학령기 인식·놀림 문제 고려로 적절한 치료 내용 선택\",\"n\":\"학령기 치료: 직접치료 중심, 놀림 대처·개방적 태도·교사·부모 협력\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"파라다이스-유창성 검사-II(P-FA-II)에 대한 설명으로 옳은 것은?\",\"choices\":[\"의사소통태도 평가는 취학전 아동을 포함한 모든 연령 집단에 실시한다\",\"필수과제는 연령과 관계없이 읽기와 대화 두 가지로만 구성된다\",\"취학전·초등학생·중학생 이상의 연령 집단별로 과제가 구성되어 있다\",\"결과는 %SS로만 산출하며 백분위 점수는 제공하지 않는다\",\"구어 평가에서 핵심행동만 평가하고 부수행동은 평가하지 않는다\"],\"answer\":3,\"explain\":\"P-FA-II는 취학전 아동, 초등학생, 중학생 이상의 세 연령 집단에 맞춘 필수과제와 선택과제로 구성되며, 구어 평가(핵심행동)와 부수행동, 의사소통태도를 평가하고 백분위 점수로 중증도를 해석한다. 의사소통태도 평가는 초등학생 이상에게 실시하며, 필수과제는 연령별로 낱말그림·따라말하기·문장그림·읽기·이야기그림·말하기그림 등 여러 과제로 구성된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"P-FA-II 구성\",\"p\":\"연령 집단별 과제 구성과 평가 영역으로 검사 특징 식별\",\"n\":\"P-FA-II: 취학전·초등·중학생 이상별 과제, 구어·부수행동·의사소통태도, 백분위\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대화 발화 표본 분석\\n• 전체 음절 수: 250음절\\n• 말더듬이 나타난 음절 수: 15음절\",\"q\":\"이 대상자의 말더듬 음절 백분율(%SS)은?\",\"choices\":[\"4 %SS\",\"5 %SS\",\"15 %SS\",\"7.5 %SS\",\"6 %SS\"],\"answer\":5,\"explain\":\"%SS = (말더듬 음절 수 ÷ 전체 음절 수) × 100 = 15 ÷ 250 × 100 = 6 %SS이다. 말더듬 음절 백분율은 발화 표본의 전체 음절 수를 분모로 하며, 말더듬 순간의 횟수를 그대로 백분율로 쓰지 않는다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"%SS 산출\",\"p\":\"말더듬 음절 수와 전체 음절 수로 말더듬 음절 백분율 산출\",\"n\":\"%SS: 말더듬 음절 수 ÷ 전체 음절 수 × 100\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬 정도 측정 검사(SSI-4)에서 '지속시간' 점수를 산출하는 방법은?\",\"choices\":[\"가장 긴 말더듬 순간 3개의 평균 지속시간을 구한다\",\"가장 짧은 말더듬 순간의 지속시간을 사용한다\",\"전체 발화 시간에서 말더듬 시간이 차지하는 비율을 구한다\",\"모든 말더듬 순간의 지속시간을 평균한다\",\"모든 말더듬 순간의 지속시간을 합산한다\"],\"answer\":1,\"explain\":\"SSI-4의 지속시간 점수는 발화 표본에서 가장 긴 말더듬 순간 3개의 평균 지속시간을 측정하여 척도 점수로 변환한다. SSI-4의 총점은 빈도(%SS), 지속시간, 신체적 부수행동 점수의 합으로 산출된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"SSI-4 지속시간 채점\",\"p\":\"SSI-4 채점 규칙으로 지속시간 점수 산출 방법 선택\",\"n\":\"SSI-4 지속시간: 가장 긴 말더듬 3개의 평균, 총점은 빈도·지속시간·부수행동 합\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인이 말더듬에 대해 느끼는 정서·행동적 반응, 일상 의사소통의 어려움, 삶의 질에 미치는 영향을 자기보고식으로 평가하려 한다.\",\"q\":\"가장 적절한 도구는?\",\"choices\":[\"말더듬 전반적 경험 평가(OASES)\",\"P-FA-II 필수과제\",\"말더듬 음절 백분율(%SS) 산출\",\"말더듬 정도 측정 검사(SSI-4)\",\"한국 아동 말더듬 검사(KOCS)\"],\"answer\":1,\"explain\":\"OASES는 말더듬에 대한 일반 정보, 정서·행동·인지적 반응, 일상 의사소통, 삶의 질의 네 영역을 자기보고로 평가하여 말더듬이 화자의 삶에 미치는 영향을 파악하는 도구이다. SSI-4와 %SS는 외현적 말더듬 행동의 중증도·빈도를 측정하고, KOCS는 아동용 검사이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"말더듬 삶의 질 평가도구\",\"p\":\"자기보고로 정서·일상·삶의 질 영향을 보는 목적으로 도구 선택\",\"n\":\"OASES: 정서·행동·인지 반응, 일상 의사소통, 삶의 질을 자기보고로 평가\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"아동 발화: \\\"책책책상 위에 있어요.\\\"\",\"q\":\"'책책책상'에서 나타난 낱말부분 반복의 단위반복수는?\",\"choices\":[\"2\",\"1\",\"3\",\"4\",\"5\"],\"answer\":1,\"explain\":\"단위반복수는 목표 낱말이 산출되기 전에 반복된 단위의 횟수이다. '책책책상'은 목표 낱말 '책상'의 첫 음절 '책'이 두 번 더 반복된 것이므로 단위반복수는 2이다. 산출된 음절 '책'의 총 개수(3)와 혼동하지 않아야 한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"단위반복수 산출\",\"p\":\"목표 낱말 산출 전 반복된 단위 횟수로 단위반복수 산출\",\"n\":\"단위반복수: 목표 낱말 산출 전에 반복된 단위의 횟수, 산출 음절 총수와 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말속도 측정에 대한 설명으로 옳은 것은?\",\"choices\":[\"전체 말속도는 발화 중 쉼 시간을 제외하고 산출한다\",\"조음속도는 쉼과 비유창성 시간을 제외하고 산출한다\",\"말속도는 분당 낱말 수(WPM)로만 측정할 수 있다\",\"조음속도는 일반적으로 전체 말속도보다 느리게 산출된다\",\"말더듬에 소요된 시간은 조음속도 산출에 포함한다\"],\"answer\":2,\"explain\":\"조음속도는 쉼·주저·말더듬 등 비유창성 시간을 제외한 순수 조음 시간을 기준으로 산출하므로 전체 말속도보다 같거나 빠르게 나온다. 전체 말속도는 쉼을 포함한 전체 발화 시간으로 산출하며, 말속도는 초당 음절 수, 분당 음절 수, 분당 낱말 수 등 여러 단위로 측정할 수 있다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"말속도·조음속도 측정\",\"p\":\"쉼·비유창성 시간 포함 여부로 말속도와 조음속도 구분 판단\",\"n\":\"조음속도: 쉼·비유창성 시간 제외로 산출, 전체 말속도보다 같거나 빠름\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"Yairi와 Ambrose의 기준에 따라 학령전 아동을 말더듬으로 판단하는 진성 비유창성(SLD) 빈도는?\",\"choices\":[\"100음절당 3회 이상\",\"100음절당 2회 이상\",\"100음절당 1회 이상\",\"100음절당 5회 이상\",\"100음절당 10회 이상\"],\"answer\":1,\"explain\":\"Yairi와 Ambrose는 100음절당 진성 비유창성(낱말부분 반복, 1음절 낱말 반복, 비운율적 발성)이 3회 이상이면 말더듬으로 간주하는 기준을 제시하였다. 진성 비유창성이 3회 미만이고 간투사·수정 등 기타 비유창성 위주이면 정상적 비유창성으로 본다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"발달 단계·감별\",\"k\":\"말더듬 판정 SLD 기준\",\"p\":\"100음절당 진성 비유창성 빈도로 학령전 말더듬 여부 판단\",\"n\":\"Yairi와 Ambrose 기준: 100음절당 SLD 3회 이상이면 말더듬으로 간주\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"유창성완성법과 말더듬수정법을 비교한 설명으로 옳은 것은?\",\"choices\":[\"유창성완성법은 조절 유창성과 수용 말더듬을 최종 치료 목표로 한다\",\"말더듬수정법은 느린 말속도·부드러운 발성 등 새 말하기 방식을 모든 발화에 적용한다\",\"말더듬수정법은 더 쉽게 더듬도록 말더듬 순간을 수정하고 두려움·회피를 줄인다\",\"두 접근 모두 부수행동과 말더듬에 대한 정서·태도는 다루지 않는다\",\"유창성완성법은 말더듬에 대한 감정·태도 변화를 가장 우선적인 목표로 한다\"],\"answer\":3,\"explain\":\"말더듬수정법(Van Riper)은 말더듬 순간을 확인·둔감·수정하여 더 쉽고 편하게 더듬게 하며, 말더듬에 대한 두려움과 회피를 줄이는 데 초점을 둔다(목표: 조절 유창성·수용 말더듬). 유창성완성법은 느린 말속도, 부드러운 발성 등 새로운 말하기 방식을 학습하여 유창한 말을 산출하는 것을 목표로 하며 감정·태도는 부차적으로 다룬다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"유창성완성법·수정법 비교\",\"p\":\"두 치료 접근의 목표와 초점 차이로 옳은 비교 설명 선택\",\"n\":\"말더듬수정법: 더 쉽게 더듬기와 두려움·회피 감소, 유창성완성법은 새 말하기 방식 학습\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"Van Riper 말더듬수정법의 치료 단계를 순서대로 옳게 나열한 것은?\",\"choices\":[\"둔감 → 확인 → 변형 → 수정 → 안정\",\"확인 → 변형 → 둔감 → 수정 → 안정\",\"확인 → 둔감 → 수정 → 변형 → 안정\",\"변형 → 확인 → 둔감 → 수정 → 안정\",\"확인 → 둔감 → 변형 → 수정 → 안정\"],\"answer\":5,\"explain\":\"말더듬수정법은 자신의 말더듬 행동을 인식하는 확인(동일시) 단계, 말더듬과 청자 반응에 대한 두려움을 줄이는 둔감 단계, 말더듬 형태를 의도적으로 바꾸어 통제 가능성을 경험하는 변형 단계, 취소·빠져나오기·준비하기로 더 쉽게 더듬는 수정(접근) 단계, 이를 일상에 유지·일반화하는 안정 단계 순으로 진행된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬 수정법 단계\",\"p\":\"Van Riper 말더듬수정법 단계의 진행 순서 선택\",\"n\":\"Van Riper 단계: 확인→둔감→변형→수정→안정\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대상자가 낱말 도중 막힘이 나타나자 멈추거나 되돌아가지 않고, 막힌 상태에서 조음기관의 긴장을 서서히 풀면서 소리를 부드럽게 늘여 그 낱말을 끝까지 산출하였다.\",\"q\":\"이 장면에서 사용된 말더듬수정법의 기법은?\",\"choices\":[\"준비하기(preparatory set)\",\"취소(cancellation)\",\"빠져나오기(pull-out)\",\"가벼운 조음접촉(light contact)\",\"지연청각피드백(DAF)\"],\"answer\":3,\"explain\":\"빠져나오기는 말더듬이 진행되는 도중에 멈추지 않고 긴장을 풀며 부드럽게 낱말을 완성하는 기법이다. 취소는 더듬은 낱말을 끝낸 뒤 잠시 멈추고 다시 편안하게 말하는 것이고, 준비하기는 더듬을 것이 예상되는 낱말 앞에서 미리 부드럽게 접근하는 것이다. 가벼운 조음접촉과 지연청각피드백은 말더듬수정법의 단계별 기법이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬 수정 기법 식별\",\"p\":\"막힘 도중 긴장을 풀며 낱말을 완성하는 장면으로 기법 식별\",\"n\":\"빠져나오기: 말더듬 도중 멈추지 않고 긴장을 풀며 낱말 완성, 취소·준비하기와 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"리드콤 프로그램(Lidcombe Program)에 대한 설명으로 옳은 것은?\",\"choices\":[\"치료사가 아동에게 느린 말속도와 부드러운 발성을 직접 훈련한다\",\"아동의 말더듬에 대해서는 어떤 언급도 하지 않는 것이 원칙이다\",\"부모의 말속도와 가정 환경을 조정하는 간접치료 방식의 프로그램이다\",\"학령기 이상 아동과 성인에게 주로 적합한 프로그램이다\",\"부모가 아동의 유창한 말에 구어 수반 자극을 제공하는 직접치료이다\"],\"answer\":5,\"explain\":\"리드콤 프로그램은 학령전 말더듬 아동을 대상으로, 훈련받은 부모가 가정의 일상 대화에서 아동의 유창한 말에 칭찬을, 더듬은 말에는 가끔 부드러운 지적을 제공하는 행동주의(조작적 조건화)에 기초한 직접치료이며 부모가 매일 말더듬 중증도를 평정한다. 새로운 말하기 방식을 가르치거나 환경만 조정하는 접근이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"리드콤 프로그램 원리\",\"p\":\"부모가 제공하는 구어 수반 자극 방식으로 프로그램 특징 식별\",\"n\":\"리드콤: 학령전 대상, 부모가 유창한 말에 칭찬·더듬은 말에 지적하는 직접치료\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 3세 2개월 아동, 3개월 전부터 말더듬 시작\\n• 긴장이 없는 낱말부분 반복이 주로 관찰됨\\n• 아동은 자신의 말을 의식하지 않음\\n• 부모가 빠른 말속도로 질문을 많이 함\",\"q\":\"이 아동에게 우선적으로 적용할 접근으로 가장 적절한 것은?\",\"choices\":[\"말더듬에 대한 둔감화 훈련을 아동에게 직접 실시한다\",\"아동에게 취소·빠져나오기 기법을 직접 훈련한다\",\"부모 교육으로 부모의 말속도를 늦추고 질문을 줄이게 한다\",\"말할 때 지연청각피드백 기기를 사용하게 한다\",\"아동에게 말더듬을 의도적으로 흉내 내게 하여 인식을 높인다\"],\"answer\":3,\"explain\":\"발병 초기이고 긴장·인식이 없는 학령전 아동에게는 요구-용량 모델에 근거하여 부모의 말속도, 질문 빈도, 대화 차례 주고받기 등 환경적 요구를 줄이는 간접치료(부모 교육)를 우선 적용한다. 취소·빠져나오기·둔감화는 말더듬을 인식하고 있는 학령기 이상 대상자의 말더듬수정법 기법이며, 아동에게 말더듬을 의식시키는 활동은 이 단계에서 적절하지 않다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"학령전 간접치료 선택\",\"p\":\"발병 초기·인식 없음·부모 빠른 말속도로 우선 중재 접근 선택\",\"n\":\"인식 없는 학령전 아동: 부모 말속도·질문 줄이기 등 환경 요구 조정 간접치료\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동은 성인과의 상호작용 속에서 혼자서는 할 수 없지만 도움을 받으면 할 수 있는 수준의 과제를 수행하며 언어를 습득한다. 성인은 아동의 수준에 맞추어 지원(비계)을 제공하고 점차 줄여 나간다.\",\"q\":\"이 설명에 해당하는 언어습득 이론은?\",\"choices\":[\"행동주의 학습 이론\",\"생득주의 언어 이론\",\"인지적 구성주의 이론\",\"연결주의 이론\",\"사회적 상호작용주의 이론\"],\"answer\":5,\"explain\":\"근접발달영역과 비계(scaffolding)는 비고츠키의 사회적 상호작용주의의 핵심 개념으로, 성인과의 상호작용이 언어 습득의 주된 동력이라고 본다. 행동주의는 모방·강화, 생득주의는 타고난 언어습득장치(LAD), 인지적 구성주의(피아제)는 인지 발달이 언어에 선행한다고 보며, 연결주의는 입력의 통계적 규칙성 학습으로 설명한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"언어습득 이론 구분\",\"p\":\"근접발달영역과 비계 개념으로 언어습득 이론 식별\",\"n\":\"사회적 상호작용주의(비고츠키): 근접발달영역, 비계, 성인과의 상호작용\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"반복적(음절성) 옹알이 단계에 관한 설명으로 옳은 것은?\",\"choices\":[\"문장과 유사한 억양 패턴을 지닌 자곤(jargon)이 주로 나타난다\",\"목 뒤쪽에서 나는 '구구' 소리가 특징이며 생후 2~3개월경 나타난다\",\"'바바바'처럼 동일한 자음-모음 음절을 반복하며 6~9개월경 나타난다\",\"관습적 의미를 지닌 첫 낱말이 이 시기에 처음 산출되기 시작한다\",\"서로 다른 자음과 모음이 섞인 '바다구'와 같은 다양한 음절 연쇄가 주를 이룬다\"],\"answer\":3,\"explain\":\"반복적(canonical) 옹알이는 동일 CV 음절을 반복하는 것으로 대략 6~9개월경 출현한다. ②는 쿠잉(2~3개월), ①은 자곤(10개월 이후), ④는 첫 낱말기(12개월 전후), ⑤는 다양한 음절이 섞이는 변형적(variegated) 옹알이에 해당한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"옹알이 발달 단계\",\"p\":\"음절 반복 형태와 출현 시기로 반복적 옹알이 특성 판단\",\"n\":\"반복적 옹알이: 동일 CV 음절 반복, 6~9개월경 출현\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"12개월 아동\\n• 원하는 장난감을 향해 손을 뻗으며 '어어' 소리를 내고 엄마 얼굴을 번갈아 쳐다본다.\\n• 아직 관습적인 낱말은 산출하지 않는다.\",\"q\":\"베이츠(Bates)의 의사소통 의도 발달 단계 중 이 아동이 속한 단계는?\",\"choices\":[\"언향적(perlocutionary) 단계\",\"언표적(locutionary) 단계\",\"언표내적(illocutionary) 단계\",\"자곤 단계\",\"낱말조합 단계\"],\"answer\":3,\"explain\":\"몸짓·발성·시선 교대로 의도를 관습적으로 표현하지만 아직 낱말을 사용하지 않는 시기는 언표내적 단계(약 8~12개월)이다. 언향적 단계는 아동에게 의도가 없고 성인이 해석해 주는 시기이며, 언표적 단계는 낱말로 의도를 표현하는 시기이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"의사소통 의도 발달 단계\",\"p\":\"몸짓·시선 교대 사용과 낱말 부재로 Bates 단계 판단\",\"n\":\"언표내적 단계: 몸짓·발성·시선 교대로 의도 표현, 낱말 이전\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"엄마와 아동이 창가에 있다.\\n아동: (창밖의 새를 가리키며 엄마 얼굴을 쳐다본다) 어! 어!\\n엄마: 응, 새가 있네.\",\"q\":\"아동이 보인 의사소통 기능은?\",\"choices\":[\"사물 요구하기\",\"행동 요구하기\",\"거부하기\",\"인사하기\",\"서술하기\"],\"answer\":5,\"explain\":\"아동이 대상을 가리키며 성인의 시선을 끌어 관심을 공유하려는 행동은 원시서술(protodeclarative)로, 서술·주의끌기 기능에 해당한다. 사물을 얻거나 행동을 시키기 위한 가리키기는 원시명령(protoimperative)에 해당하는 요구하기 기능이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"의사소통 기능 판별\",\"p\":\"관심 공유를 위한 가리키기와 시선으로 기능 판단\",\"n\":\"원시서술: 관심 공유를 위한 가리키기, 원시명령은 요구 목적\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"두 낱말 발화의 의미관계 분석으로 옳은 것은?\",\"choices\":[\"\\\"엄마 가방\\\": 행위자-대상\",\"\\\"공 커\\\": 대상-행위\",\"\\\"또 줘\\\": 재현-행위\",\"\\\"안 먹어\\\": 부정-대상\",\"\\\"여기 앉아\\\": 대상-행위\"],\"answer\":3,\"explain\":\"'또 줘'는 되풀이를 요구하는 재현(recurrence)-행위 관계이다. '엄마 가방'은 소유자-대상, '공 커'는 실체-서술(상태), '안 먹어'는 부정-행위, '여기 앉아'는 장소-행위로 분석한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"두 낱말 의미관계 분석\",\"p\":\"두 낱말 발화의 의미 구성으로 의미관계 판단\",\"n\":\"재현-행위: 또 줘, 소유자-대상·부정-행위·장소-행위 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동 발화 4개\\n① 엄마 물 줘\\n② 공 던져\\n③ 아빠가 왔어\\n④ 안 먹어\",\"q\":\"위 발화의 평균형태소길이(MLU-m)는? (용언의 어간과 어미는 각각 형태소로 계산한다)\",\"choices\":[\"3.75\",\"3.50\",\"3.25\",\"4.00\",\"4.25\"],\"answer\":1,\"explain\":\"①엄마/물/주-/-어(4) ②공/던지-/-어(3) ③아빠/-가/오-/-았-/-어(5) ④안/먹-/-어(3)로 총 15개 형태소이며, 15÷4=3.75이다. 조사(-가)와 선어말어미(-았-), 종결어미(-어)를 각각 세지 않으면 값이 낮게 산출된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"MLU-m 산출\",\"p\":\"어간·어미·조사를 각각 세어 평균형태소길이 산출\",\"n\":\"MLU-m: 총 형태소 수/발화 수, 조사·선어말어미·어말어미 각각 계산\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"자발화 표본 수집과 분석에 관한 설명으로 옳은 것은?\",\"choices\":[\"'네/아니오'로 답하는 질문을 주로 사용하여 발화를 유도한다\",\"아동이 직전 발화를 그대로 반복한 발화도 모두 분석 대상에 포함한다\",\"발화 10개 정도만 수집해도 신뢰로운 분석이 가능하다\",\"알아들을 수 없는 발화도 형태소 수 계산에 포함한다\",\"놀이·대화 등 두 가지 이상의 상황에서 표본을 수집한다\"],\"answer\":5,\"explain\":\"자발화는 아동의 대표적 언어 수행을 반영해야 하므로 여러 상황·대화 상대에서 충분한 양(일반적으로 50~100발화 이상)을 수집한다. 예/아니오 질문은 발화 길이를 제한하고, 즉각 반복·모방 발화와 불명료 발화는 MLU 등 분석에서 제외하는 것이 원칙이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"자발화 표본 수집 원칙\",\"p\":\"표본 수집 상황과 분석 제외 기준으로 옳은 원칙 판단\",\"n\":\"자발화: 둘 이상 상황에서 충분히 수집, 모방·불명료 발화 제외\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동: 잼 줘.\\n치료사: 응? 뭐라고?\\n아동: 딸기 잼 줘요, 빵에 발라 먹게.\",\"q\":\"치료사의 명료화 요구에 대해 아동이 사용한 대화 수정 전략은?\",\"choices\":[\"반복(repetition)\",\"첨가(addition)\",\"단서 제공(cue)\",\"수정(revision)\",\"무반응\"],\"answer\":2,\"explain\":\"원래 발화의 내용을 유지하면서 새로운 정보(딸기, 빵에 발라 먹게)를 덧붙였으므로 첨가 전략이다. 반복은 같은 발화를 그대로 되풀이하는 것, 수정은 낱말이나 문장 형태를 바꾸어 말하는 것이며, 단서 제공은 배경 정보를 설명해 청자의 이해를 돕는 전략이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"화용·대화\",\"k\":\"대화 수정 전략 판별\",\"p\":\"원 발화에 새 정보를 덧붙인 반응으로 수정 전략 판단\",\"n\":\"첨가 전략: 원 발화 유지하며 새 정보 추가, 수정은 형태 변경\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"어느 날 지우는 공원에서 연을 날렸어요.\\n그런데 연줄이 끊어져 연이 나무에 걸렸어요.\\n지우는 너무 속상해서 울고 싶었어요.\\n지우는 긴 막대기로 연을 내리려고 했어요.\\n결국 연을 다시 찾았어요.\\n지우는 기분이 좋아졌어요.\",\"q\":\"세 번째 문장 '지우는 너무 속상해서 울고 싶었어요.'에 해당하는 이야기 문법(story grammar) 요소는?\",\"choices\":[\"내적 반응\",\"계기 사건\",\"배경\",\"시도\",\"결과\"],\"answer\":1,\"explain\":\"계기 사건(연이 나무에 걸림)에 대한 주인공의 감정·생각은 내적 반응이다. 첫 문장은 배경, 둘째는 계기 사건, 넷째는 시도, 다섯째는 결과, 마지막은 반응(결말)에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"이야기·담화\",\"k\":\"이야기 문법 요소 판별\",\"p\":\"계기 사건에 대한 인물의 감정 진술로 이야기 문법 요소 판단\",\"n\":\"내적 반응: 계기 사건에 대한 주인공의 감정·생각\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"이야기에 나타난 결속표지(cohesive device)의 유형이 옳게 연결된 것은?\",\"choices\":[\"\\\"비가 많이 왔어. 그래서 우산을 썼어.\\\" – 생략\",\"\\\"형이 공을 찼어. 그것은 멀리 갔어.\\\" – 지시(대용)\",\"\\\"강아지가 크게 짖었어. 그 개는 무서웠어.\\\" – 접속\",\"\\\"나는 빵을, 동생은 우유를 먹었어.\\\" – 지시(대용)\",\"\\\"먼저 손을 씻고, 그다음에 밥을 먹어.\\\" – 어휘적 결속\"],\"answer\":2,\"explain\":\"'그것'이 앞 문장의 '공'을 가리키므로 지시(대용) 결속이다. ①의 '그래서'와 ⑤의 '먼저·그다음에'는 접속, ③의 '강아지→개'는 상위어를 활용한 어휘적 결속, ④는 서술어 '먹었어'가 앞 절에서 생략된 생략 결속이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"이야기·담화\",\"k\":\"결속표지 유형 판별\",\"p\":\"지시어가 앞 문장 명사를 가리키는지로 결속 유형 판단\",\"n\":\"지시(대용) 결속: 대명사가 앞 명사 지칭, 접속·어휘·생략과 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"다음 과제 중 상위언어(metalinguistic) 능력을 평가하는 것은?\",\"choices\":[\"들려준 문장을 그대로 따라 말하기\",\"그림을 보고 사물의 이름 말하기\",\"책을 책상 위에 올려놓으세요. 지시 따르기\",\"'나무'에서 '나'를 빼면 무엇이 남지?\",\"그림 속 사물의 색깔과 모양 말하기\"],\"answer\":4,\"explain\":\"상위언어 능력은 언어 자체를 사고의 대상으로 삼아 조작·판단하는 능력으로, 음절 탈락과 같은 음운인식 과제가 대표적이다. 이름대기·지시 따르기·문장 따라말하기·속성 말하기는 언어를 사용하는 과제이지 언어 자체를 분석하는 과제가 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"읽기·쓰기\",\"k\":\"상위언어 과제 식별\",\"p\":\"언어 자체를 조작하는 과제인지로 상위언어 평가 과제 식별\",\"n\":\"상위언어 능력: 언어를 분석·조작하는 능력, 예 음절 탈락\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"초기 어휘 습득에 관한 개념과 예가 옳게 연결된 것은?\",\"choices\":[\"과잉확장 – '공'이라는 낱말을 자기 공에만 사용한다\",\"과소확장 – '아빠'를 길에서 본 모든 성인 남자에게 사용한다\",\"전체대상 가정 – 새 낱말을 사물의 부분이나 색깔로 해석한다\",\"상호배타성 가정 – 새 낱말을 이름을 모르는 낯선 사물에 대응시킨다\",\"빠른 연결(fast mapping) – 수십 번의 노출 후에야 낱말을 습득한다\"],\"answer\":4,\"explain\":\"상호배타성 가정은 한 사물에 하나의 이름만 있다고 여겨 새 낱말을 낯선 사물에 연결하는 것이다. ①은 과소확장, ②는 과잉확장의 예이며, 전체대상 가정은 새 낱말을 사물 전체를 지칭하는 것으로 해석하는 것이고, 빠른 연결은 한두 번의 노출로 낱말과 의미를 잠정 연결하는 것이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"어휘·의미\",\"k\":\"초기 어휘 습득 원리\",\"p\":\"어휘 습득 제약과 확장 현상의 개념-예 연결 판단\",\"n\":\"상호배타성 가정: 한 사물에 한 이름, 새 낱말을 낯선 사물에 연결\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"읽기의 단순관점(Simple View of Reading)에 따를 때 난독증(dyslexia) 아동의 전형적인 프로파일은?\",\"choices\":[\"해독 정상, 듣기이해 저하\",\"해독 저하, 듣기이해 저하\",\"해독 정상, 듣기이해 정상, 읽기이해만 저하\",\"해독 저하, 듣기이해 정상\",\"해독과 듣기이해 모두 우수\"],\"answer\":4,\"explain\":\"단순관점에서 읽기이해는 해독과 언어(듣기)이해의 곱으로 설명된다. 난독증은 언어이해가 정상이면서 낱말 해독이 선택적으로 손상된 유형이다. ①은 특정 읽기이해 결함, ②는 혼합형(일반 읽기부진)에 해당하며, ③은 이 모델에서 설명되지 않는 조합이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"읽기·쓰기\",\"k\":\"읽기 단순관점 프로파일\",\"p\":\"해독과 듣기이해 조합으로 난독증 프로파일 판단\",\"n\":\"단순관점: 읽기이해=해독×언어이해, 난독증은 해독 저하·이해 정상\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"다음 음운인식 과제 중 일반적으로 가장 늦게 발달하는 것은?\",\"choices\":[\"낱말의 음절 수를 손뼉으로 세기\",\"'사'와 '자'를 합쳐 '사자' 만들기\",\"'나비'와 '나무'의 첫음절이 같은지 판단하기\",\"두 낱말의 끝음절이 같은지 판단하기\",\"'산'에서 /ㅅ/를 빼고 말하기\"],\"answer\":5,\"explain\":\"음운인식은 음절 수준에서 음소 수준으로 발달하며, 같은 수준 안에서는 변별·합성보다 탈락·대치 같은 조작 과제가 더 어렵다. 음소 탈락 과제는 음소 수준의 조작 과제이므로 음절 세기·음절 합성·음절 변별보다 늦게 발달한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"읽기·쓰기\",\"k\":\"음운인식 발달 위계\",\"p\":\"단위 크기와 조작 유형으로 가장 늦은 과제 식별\",\"n\":\"음운인식: 음절→음소 순 발달, 변별·합성보다 탈락·대치가 어려움\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"초등학교 2학년 아동의 받아쓰기 오류\\n• 꽃이 → 꼬치\\n• 먹어서 → 머거서\\n• 높이 → 노피\",\"q\":\"이 아동의 철자 오류 유형과 우선적으로 필요한 교수 초점은?\",\"choices\":[\"음운처리 오류 – 자소-음소 대응 지도\",\"형태처리 오류 – 형태소 원형 인식 지도\",\"표기처리 오류 – 관습적 표기 낱말 암기 지도\",\"의미처리 오류 – 낱말 뜻과 쓰임 지도\",\"시각기억 오류 – 낱말 형태 시각화 지도\"],\"answer\":2,\"explain\":\"발음은 정확히 반영했으나 어간·어미와 조사의 경계를 나누지 못하고 소리 나는 대로 썼으므로 형태소 원형을 유지하지 못한 형태처리 오류이다. 음운처리 오류는 소리 자체가 틀리는 것(꽃→꼭), 표기처리 오류는 소리로 설명되지 않는 관습 표기의 오류(며칠→몇일)이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"읽기·쓰기\",\"k\":\"철자 오류 유형과 지도\",\"p\":\"소리 나는 대로 쓴 오류를 근거로 교수 초점 선택\",\"n\":\"형태처리 오류: 형태소 경계 미표기, 형태소 원형 인식 지도\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"표준화 언어검사와 그 특성이 옳게 연결된 것은?\",\"choices\":[\"수용·표현 어휘력 검사(REVT) – 수용과 표현 어휘를 각각 평가하여 등가연령과 백분위수를 산출한다\",\"취학전 아동의 수용언어 및 표현언어 발달척도(PRES) – 초등학생의 담화와 읽기 능력을 평가한다\",\"학령기 아동 언어 검사(LSSC) – 영유아의 의사소통 발달을 선별한다\",\"한국어 읽기 검사(KOLRA) – 학령전기 아동의 어휘 능력을 평가한다\",\"맥아더-베이츠 의사소통발달 검사(K M-B CDI) – 검사자가 아동에게 직접 그림 이름대기를 실시한다\"],\"answer\":1,\"explain\":\"REVT는 그림 지적(수용)과 그림 이름대기(표현)로 어휘력을 각각 평가하여 등가연령과 백분위수를 제공한다. K M-B CDI는 부모 보고형 검사이고, PRES는 학령전기 아동 대상, LSSC와 KOLRA는 초등학생 대상 검사이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"언어검사 특성 연결\",\"p\":\"검사별 대상 연령과 평가 방식으로 옳은 연결 판단\",\"n\":\"REVT: 수용·표현 어휘 각각 평가, 등가연령·백분위수 제공\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"언어검사 결과 아동의 표현 어휘 백분위수가 5로 나타났다.\",\"q\":\"이 결과의 해석으로 옳은 것은?\",\"choices\":[\"전체 검사 문항 중 5%의 문항에 정답을 맞혔음을 뜻한다\",\"규준집단에서 약 5%만이 이 아동보다 낮은 점수를 받았다\",\"또래 규준집단의 평균 점수보다 원점수가 5점 낮음을 뜻한다\",\"규준집단 평균에서 -1 표준편차에 해당하는 위치이다\",\"아동의 표현 어휘 등가연령이 5세 수준에 해당한다\"],\"answer\":2,\"explain\":\"백분위수는 규준집단에서 해당 점수 이하를 받은 사람의 비율이므로 백분위수 5는 하위 5%에 해당한다. 정답률이나 점수 차이를 의미하지 않으며, -1 표준편차는 약 백분위수 16에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"백분위수 해석\",\"p\":\"백분위수 정의를 근거로 검사 결과 의미 판단\",\"n\":\"백분위수: 규준집단 중 해당 점수 이하 비율, 5는 하위 5%\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"역동적 평가(dynamic assessment)에 관한 설명으로 옳은 것은?\",\"choices\":[\"규준집단과 비교하여 표준점수를 산출하는 것이 목적이다\",\"결과는 규준에 근거한 등가연령으로 보고한다\",\"부모의 보고만으로 아동의 현재 언어 능력을 추정한다\",\"한 시점의 수행만을 측정하므로 이중언어 아동에게는 부적합하다\",\"검사-교수-재검사 형식으로 아동의 학습 잠재력을 평가한다\"],\"answer\":5,\"explain\":\"역동적 평가는 중재 반응을 통해 학습 잠재력을 파악하는 방법으로, 언어 차이와 언어장애를 감별해야 하는 이중언어·다문화 아동 평가에 특히 유용하다. 규준 비교나 표준점수·등가연령 산출은 정적(표준화) 평가의 특성이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"역동적 평가 특성\",\"p\":\"검사-교수-재검사 형식을 근거로 역동적 평가 특성 판단\",\"n\":\"역동적 평가: 중재 반응으로 학습 잠재력 파악, 이중언어 아동에 유용\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"단순언어장애(SLI) 진단 준거로 옳은 것은?\",\"choices\":[\"언어검사 -1.25 SD 이하, 비언어성 지능 85 이상\",\"양측 감각신경성 난청이 언어 지연과 함께 동반된다\",\"자폐스펙트럼장애 진단이 언어 문제와 함께 동반된다\",\"비언어성 지능지수가 70 이하로 지적장애 범위이다\",\"언어 지연을 설명할 수 있는 뇌손상 등 신경학적 손상이 확인된다\"],\"answer\":1,\"explain\":\"레너드(Leonard)의 준거에 따르면 단순언어장애는 언어검사 -1.25 SD 이하이면서 비언어성 지능 85 이상이고, 청력·구강구조·신경학적 손상·자폐 등 언어 지연을 설명할 다른 원인이 배제되어야 한다. 나머지는 모두 배제 준거에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"단순언어장애 진단 준거\",\"p\":\"언어 점수와 비언어성 지능 기준으로 진단 준거 판단\",\"n\":\"SLI 준거: 언어 -1.25 SD 이하, 비언어성 지능 85 이상, 타 원인 배제\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"단순언어장애 아동의 언어 특성으로 옳은 것은?\",\"choices\":[\"비언어성 인지 저하가 언어 지연의 원인이다\",\"수용언어는 손상되지 않으며 표현언어만 손상된다\",\"화용 능력은 영향을 받지 않아 또래와 비슷하다\",\"첫 낱말 출현 시기가 또래보다 빠른 편이다\",\"조사·어미 등 문법형태소 습득이 특히 지연된다\"],\"answer\":5,\"explain\":\"단순언어장애 아동은 문법형태소 습득이 두드러지게 지연되고 낱말 찾기 어려움, 늦은 첫 낱말 등을 보인다. 수용언어도 손상될 수 있고, 언어 문제로 인한 대화·이야기 등 화용의 어려움이 동반될 수 있으며, 비언어성 인지는 정상 범위인 것이 진단의 전제이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"대상군 특성\",\"k\":\"단순언어장애 언어 특성\",\"p\":\"문법형태소 습득 지연 여부로 SLI 특성 판단\",\"n\":\"SLI: 문법형태소 습득 지연 두드러짐, 낱말 찾기 어려움, 늦은 첫 낱말\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"말 늦은 아동(late talker)의 판별 기준으로 옳은 것은?\",\"choices\":[\"18개월에 두 낱말 조합이 아직 나타나지 않는다\",\"24개월에 표현 어휘 50개 미만이거나 낱말 조합이 없다\",\"36개월에 완전한 문장을 아직 산출하지 못한다\",\"수용언어 검사 결과가 -2 SD 이하로 매우 낮게 나타난다\",\"청력 손실을 동반하여 말소리 표현이 늦다\"],\"answer\":2,\"explain\":\"말 늦은 아동은 인지·청력·신경학적 문제 없이 24개월에 표현 어휘 50개 미만 또는 두 낱말 조합이 없는 아동을 말한다. 18개월에 낱말 조합이 없는 것은 정상 범위이다. 수용언어는 대체로 정상 범위이며, 청력 손실이 있으면 말 늦은 아동으로 분류하지 않는다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"말 늦은 아동 판별 기준\",\"p\":\"24개월 표현 어휘 수와 낱말 조합 여부로 판별 기준 판단\",\"n\":\"말 늦은 아동: 24개월 표현 어휘 50개 미만 또는 낱말 조합 없음\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"5세 자폐스펙트럼장애 아동\\n• 과자가 먹고 싶을 때마다 며칠 전에 본 광고 문구인 \\\"맛있게 드세요~\\\"를 억양까지 그대로 말한다.\",\"q\":\"이 발화의 유형과 기능이 옳게 연결된 것은?\",\"choices\":[\"지연 반향어 – 요청\",\"즉각 반향어 – 대답\",\"지연 반향어 – 거부\",\"자곤 – 서술\",\"즉각 반향어 – 요청\"],\"answer\":1,\"explain\":\"이전에 들은 말을 시간이 지난 뒤 그대로 반복하는 것은 지연 반향어이며, 과자를 얻으려는 상황에서 사용하므로 요청 기능을 수행한다. 즉각 반향어는 상대의 말을 직후에 따라 하는 것이고, 자곤은 의미 없는 옹알이성 발화이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"반향어 유형·기능 판별\",\"p\":\"반복 시점과 사용 상황으로 반향어 유형과 기능 판단\",\"n\":\"지연 반향어: 시간 지난 뒤 반복, 상황에 따라 요청 기능 수행\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"다음 중 '공동주의 시작하기(initiating joint attention)'에 해당하는 행동은?\",\"choices\":[\"성인이 가리키는 곳을 따라 쳐다본다\",\"이름을 부르면 고개를 돌린다\",\"장난감을 들어 성인에게 보여주며 쳐다본다\",\"과자를 얻으려고 성인의 손을 잡아 끌어당긴다\",\"성인의 박수 동작을 따라 한다\"],\"answer\":3,\"explain\":\"공동주의 시작하기는 아동이 먼저 보여주기·가리키기·시선 교대로 성인의 관심을 대상에 끌어들이는 행동이다. ①은 공동주의에 반응하기, ②는 이름 반응, ④는 요구를 위한 도구적 행동, ⑤는 모방으로 공동주의 시작과 구분된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"공동주의 시작하기\",\"p\":\"아동이 먼저 관심을 끄는 행동인지로 공동주의 시작 식별\",\"n\":\"공동주의 시작: 보여주기·가리키기·시선 교대로 성인 관심 유도\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"증후군과 언어 특성이 옳게 연결된 것은?\",\"choices\":[\"윌리엄스증후군 – 어휘와 표현언어가 인지 수준에 비해 현저히 낮다\",\"윌리엄스증후군 – 언어보다 시공간 인지 능력이 상대적 강점이다\",\"취약X증후군 – 사회성이 과도하게 높아 낯선 사람에게도 친근하게 다가간다\",\"다운증후군 – 수용언어가 표현언어보다 더 심하게 손상되는 편이다\",\"다운증후군 – 표현언어와 구문이 인지 수준에 비해 더 지연된다\"],\"answer\":5,\"explain\":\"다운증후군은 수용에 비해 표현·구문이 특히 약하고 저긴장·구강구조 특성으로 말명료도가 낮다. 윌리엄스증후군은 시공간 인지가 약한 반면 어휘·표현언어와 사회성이 상대적 강점이며, 취약X증후군은 사회적 불안·시선 회피와 보속적·빠른 말이 특징이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"대상군 특성\",\"k\":\"증후군별 언어 특성\",\"p\":\"증후군별 강약점 프로파일로 옳은 연결 판단\",\"n\":\"다운증후군: 수용보다 표현·구문 지연, 윌리엄스는 시공간 약점\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"청각장애 아동의 언어 특성으로 옳은 것은?\",\"choices\":[\"조사·어미 같은 기능어보다 내용어 습득이 더 어렵다\",\"문장 구조가 단순하고 문법형태소 생략이 흔하다\",\"비유·관용 표현의 이해에 별다른 어려움이 없다\",\"낱말의 다의적 의미 이해가 또래보다 우수하다\",\"말명료도는 청력 손실 정도와 관계가 거의 없다\"],\"answer\":2,\"explain\":\"청각장애 아동은 청각 입력이 제한되어 강세가 약하고 짧은 문법형태소를 놓치기 쉬워 조사·어미 생략과 단순한 문장 구조를 보인다. 내용어보다 기능어 습득이 더 어렵고, 추상어·다의어·비유 이해도 제한되며, 말명료도는 청력 손실 정도와 관련된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"대상군 특성\",\"k\":\"청각장애 아동 언어 특성\",\"p\":\"청각 입력 제한의 영향으로 언어 특성 판단\",\"n\":\"청각장애 아동: 문법형태소 생략, 단순 문장 구조, 기능어 습득 어려움\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"이중언어 아동의 언어장애 판별에 관한 설명으로 옳은 것은?\",\"choices\":[\"한국어 표준화 검사의 규준만으로 언어장애를 판정한다\",\"제2언어인 한국어에서만 지연이 있어도 언어장애로 진단한다\",\"두 언어 모두에서 지연이 나타날 때 언어장애를 의심한다\",\"새 언어에 노출된 초기의 침묵기는 언어장애의 징후이다\",\"모국어 사용을 중단시켜야 한국어 발달이 촉진된다\"],\"answer\":3,\"explain\":\"언어장애는 특정 언어가 아니라 언어 학습 능력 자체의 문제이므로 두 언어 모두에서 지연이 나타나야 의심할 수 있다. 한 언어에서만의 지연은 언어 차이(노출 부족)일 수 있고, 침묵기는 순차적 이중언어 습득의 정상적 과정이며, 모국어 유지는 제2언어 발달에도 도움이 된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"이중언어 아동 장애 판별\",\"p\":\"두 언어 모두의 지연 여부로 언어장애 판별 원칙 판단\",\"n\":\"이중언어 아동: 두 언어 모두 지연 시 장애 의심, 한 언어만은 언어 차이\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동이 블록을 쌓고 있다.\\n치료사: (아동의 행동을 보며) 블록을 높이 쌓네. 또 올리네. 와, 무너졌다.\",\"q\":\"치료사가 사용한 언어촉진 기법은?\",\"choices\":[\"혼잣말 기법(self-talk)\",\"확장(expansion) 기법\",\"확대(extension) 기법\",\"평행발화(parallel talk)\",\"개작(recast) 기법\"],\"answer\":4,\"explain\":\"치료사가 아동이 하고 있는 행동을 아동의 입장에서 말로 묘사하는 것은 평행발화이다. 혼잣말 기법은 치료사 자신의 행동을 말로 표현하는 것이며, 확장·확대·개작은 아동의 발화가 있은 뒤 이를 문법적으로 보완하거나 의미를 덧붙이거나 문장 형태를 바꾸어 되돌려 주는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"언어촉진 기법 구분\",\"p\":\"아동 행동을 치료사가 묘사하는 방식으로 기법 식별\",\"n\":\"평행발화: 아동 행동을 아동 입장에서 묘사, 혼잣말은 자기 행동 묘사\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"간식 시간마다 치료사가 아동에게 주스를 따라 주는 것이 반복되어 왔다.\\n오늘 치료사는 주스병을 들고 아동을 바라보며 기대하는 표정으로 약 5초간 기다렸다.\\n아동: 주스!\\n치료사: 그래, 주스 줄게.\",\"q\":\"치료사가 사용한 환경중심 언어중재 절차는?\",\"choices\":[\"시간지연(time delay)\",\"요구-모델(mand-model)\",\"아동중심 시범(child-cued modeling)\",\"우발교수(incidental teaching)\",\"스크립트 중재\"],\"answer\":1,\"explain\":\"익숙한 일과에서 성인이 도움을 주지 않고 기대하는 표정으로 기다려 아동의 자발적 의사소통을 유도하는 것은 시간지연 절차이다. 요구-모델은 '뭐 줄까?'와 같은 요구(질문)를 먼저 제시하고, 아동중심 시범은 아동의 관심사에 대해 시범을 보이며, 우발교수는 아동이 먼저 요구를 시작했을 때 이를 확장해 가르친다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"환경중심 언어중재 절차\",\"p\":\"익숙한 일과에서 기대하며 기다리는 방식으로 절차 식별\",\"n\":\"시간지연: 익숙한 일과에서 기대 표정으로 기다려 자발적 요구 유도\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"스크립트 중재의 절차로 옳은 것은?\",\"choices\":[\"친숙한 활동 순서를 먼저 확립한 뒤 계획된 위반을 도입한다\",\"첫 회기부터 예고 없이 활동 순서를 바꾸어 아동의 반응을 유도한다\",\"아동에게 낯선 활동을 선택하여 새로운 경험을 제공한다\",\"목표 언어는 스크립트의 하위 행동과 관계없이 삽입한다\",\"스크립트의 하위 행동은 하나로 제한하여 단순화한다\"],\"answer\":1,\"explain\":\"스크립트 중재는 생일잔치·마트놀이 등 친숙한 일상 활동의 순서를 먼저 익히게 하여 인지적 부담을 줄인 뒤, 각 하위 행동에 목표 언어를 배치하고 필요 시 순서를 빠뜨리거나 사물을 빼는 계획된 위반으로 발화를 유도한다. 낯선 활동이나 처음부터의 무작위 변형은 이 원리에 어긋난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"스크립트 중재 절차\",\"p\":\"친숙한 활동 확립과 계획된 위반 순서로 절차 판단\",\"n\":\"스크립트 중재: 친숙한 일상 순서 확립 후 계획된 위반으로 발화 유도\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"수직적 목표 달성 전략에 관한 설명으로 옳은 것은?\",\"choices\":[\"여러 목표를 한 회기 안에서 동시에 지도한다\",\"일정 기간마다 여러 목표를 순환하며 번갈아 지도한다\",\"한 목표가 준거에 도달한 뒤 다음 목표로 넘어간다\",\"목표 도달 여부와 관계없이 매 회기 목표를 바꾼다\",\"아동이 선택한 목표만 지도한다\"],\"answer\":3,\"explain\":\"수직적 전략은 한 번에 하나의 목표를 집중 지도하여 준거에 도달한 후 다음 목표로 이동한다. ①은 수평적 전략, ②는 주기적 전략에 해당하며, ④·⑤는 목표 달성 전략에 해당하지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"목표 달성 전략 구분\",\"p\":\"준거 도달 후 이동 여부로 수직적 전략 특성 판단\",\"n\":\"수직적 전략: 한 목표 준거 도달 후 다음 목표, 수평적은 동시 지도\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"장기목표: 연결어미가 포함된 복문을 사용하여 사건을 표현할 수 있다.\",\"q\":\"이 장기목표에 대한 단기목표로 가장 적절하게 기술된 것은?\",\"choices\":[\"아동의 구문 능력이 전반적으로 향상된다\",\"아동은 일상 대화에서 복문을 이해하고 사용한다\",\"치료사가 그림을 보며 연결어미 '-고'를 시범 보인다\",\"그림카드 10장 중 '-고' 문장을 8회 이상 말한다\",\"아동은 연결어미를 여러 상황에서 잘 사용할 수 있다\"],\"answer\":4,\"explain\":\"단기목표는 조건(그림카드 10장), 아동의 행동(연결어미 '-고' 문장 말하기), 준거(8회 이상)가 측정 가능하게 기술되어야 한다. ①·②·⑤는 준거가 없거나 장기목표 수준의 포괄적 진술이고, ③은 아동이 아닌 치료사의 행동을 기술한 것이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"단기목표 기술\",\"p\":\"조건·행동·준거 포함 여부로 적절한 단기목표 선택\",\"n\":\"단기목표: 조건·아동 행동·준거를 측정 가능하게 기술\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"언어 이전기·초기 언어기 아동의 목표 어휘 선정 원칙으로 옳은 것은?\",\"choices\":[\"아동이 이미 자발적으로 산출하는 낱말을 중심으로 선정한다\",\"추상적인 개념어를 구체어보다 우선 선정한다\",\"일상에서 자주 쓰이고 즉각적인 기능을 갖는 낱말을 우선한다\",\"발음이 어려운 낱말을 우선하여 조음 연습을 겸한다\",\"아동이 관심 없는 사물의 이름을 선정하여 새로운 흥미를 유도한다\"],\"answer\":3,\"explain\":\"초기 어휘는 아동의 관심과 일상에서 자주 접하고 요구·거부 등 의사소통 기능을 바로 수행할 수 있는 기능적 낱말이어야 습득과 일반화가 빠르다. 이미 산출하는 낱말은 목표가 아니며, 추상어·발음이 어려운 낱말·관심 없는 사물은 초기 목표로 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"초기 목표 어휘 선정\",\"p\":\"일상 빈도와 기능성을 근거로 목표 어휘 선정 원칙 선택\",\"n\":\"초기 목표 어휘: 일상에서 자주 쓰이고 즉각적 기능을 갖는 낱말\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"보완대체의사소통(AAC) 상징체계에 관한 설명으로 옳은 것은?\",\"choices\":[\"블리스 상징은 도상성이 높아 학습이 쉽다\",\"수어는 도구적(보조) 상징체계이다\",\"도상성이 낮은 상징일수록 초기 학습이 더 쉽다\",\"실물 사진은 선화보다 도상성이 높은 상징이다\",\"스캐닝은 상징의 도상성을 높이는 기법이다\"],\"answer\":4,\"explain\":\"도상성(iconicity)은 상징이 지시 대상과 닮은 정도로, 실물 사진 > 컬러 선화 > 흑백 선화 > 블리스·문자 순으로 낮아지며 도상성이 높을수록 초기 학습이 쉽다. 수어·몸짓은 도구가 필요 없는 비도구적 상징이고, 스캐닝은 상징을 선택하는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"AAC 상징 도상성\",\"p\":\"상징이 지시 대상과 닮은 정도로 AAC 상징 특성 판단\",\"n\":\"도상성: 실물 사진 > 컬러 선화 > 흑백 선화 > 블리스, 높을수록 학습 쉬움\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"• 아동이 어려워하는 특정 사회적 상황(예: 줄 서기)을 짧고 구체적인 문장으로 서술한다.\\n• 그 상황에서 다른 사람이 어떻게 느끼고 무엇을 기대하는지, 아동이 할 수 있는 적절한 행동이 무엇인지를 아동의 관점에서 설명한다.\\n• 아동에게 맞게 개별화된 글이며 그림을 함께 제시하기도 한다.\",\"q\":\"이 설명에 해당하는 중재 기법은?\",\"choices\":[\"비디오 모델링\",\"사회적 상황 이야기\",\"사회적 기술 훈련 집단\",\"또래 매개 중재\",\"상호적 모방 훈련\"],\"answer\":2,\"explain\":\"사회적 상황 이야기는 자폐스펙트럼장애 아동이 사회적 상황의 단서와 타인의 관점, 기대되는 행동을 이해하도록 개별화된 짧은 이야기로 설명하는 기법이다. 비디오 모델링은 영상 속 모델을 관찰·모방하게 하는 것이고, 또래 매개 중재는 훈련된 또래가 상호작용을 이끄는 것이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"자폐 사회성 중재 기법\",\"p\":\"개별화된 짧은 이야기로 상황 설명하는 방식으로 기법 식별\",\"n\":\"사회적 상황 이야기: 사회적 단서·타인 관점·기대 행동을 개별화된 글로 설명\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"부모 교육 프로그램(예: 해넌 프로그램)에서 부모에게 강조하는 반응적 상호작용 전략으로 옳은 것은?\",\"choices\":[\"아동에게 질문을 많이 하여 발화를 유도한다\",\"아동의 발화 오류를 즉시 교정한다\",\"성인이 대화 주제를 정하고 이끌어 간다\",\"아동의 주도를 따르며 관찰하고 기다려 준다\",\"아동에게 더 긴 문장으로 말하도록 요구한다\"],\"answer\":4,\"explain\":\"반응적 상호작용 접근은 아동의 관심과 주도를 따르고(관찰하기-기다리기-듣기), 아동의 신호에 즉각적이고 따뜻하게 반응하며 자연스러운 시범을 제공하는 것을 핵심으로 한다. 잦은 질문·즉각 교정·성인 주도·발화 요구는 아동의 의사소통 시도를 줄이는 지시적 상호작용이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"반응적 상호작용 전략\",\"p\":\"아동 주도 따르기 여부로 부모 교육 전략 선택\",\"n\":\"반응적 상호작용: 아동 주도 따르기, 관찰-기다리기-듣기, 즉각 반응\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두 연골에 대한 설명으로 옳은 것은?\",\"choices\":[\"갑상연골은 좌우 한 쌍으로 이루어진 연골이다\",\"피열연골은 갑상연골의 앞쪽 내면과 관절을 이룬다\",\"윤상연골은 유일하게 완전한 고리 모양의 연골이다\",\"후두개는 유리연골로 성인기에 빠르게 골화된다\",\"설골은 후두 연골 중 가장 위에 위치한 연골이다\"],\"answer\":3,\"explain\":\"윤상연골은 뒤쪽이 넓은 반지 모양으로, 후두 연골 중 유일하게 기도를 완전히 둘러싸는 고리 형태이다. 갑상연골은 두 판이 앞에서 융합된 단일 연골이고, 피열연골은 윤상연골 위판(후방)에 얹혀 관절하며, 후두개는 탄력연골이라 골화가 잘 일어나지 않는다. 설골은 연골이 아닌 뼈로 후두를 매다는 구조이며 후두 연골에 포함되지 않는다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"후두 연골 구조\",\"p\":\"연골별 형태·수·위치 특징으로 옳은 설명 식별\",\"n\":\"윤상연골: 유일한 완전 고리 모양 후두 연골, 설골은 뼈로 후두 연골 아님\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두 내근과 그 작용이 옳게 연결된 것은?\",\"choices\":[\"윤상갑상근 – 성대 신장\",\"측윤상피열근 – 성대 외전\",\"후윤상피열근 – 성대 내전\",\"갑상피열근 – 성문 개방\",\"횡피열근 – 성대의 신장\"],\"answer\":1,\"explain\":\"윤상갑상근은 갑상연골을 앞으로 기울여 성대를 길게 늘이고 긴장시켜 음도를 높이는 근육이다. 후윤상피열근은 유일한 외전근(성문 개방), 측윤상피열근과 횡·사피열근은 내전근이며, 갑상피열근(성대근)은 성대를 짧고 두껍게 하여 긴장을 조절한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"후두 내근 작용\",\"p\":\"내근별 내전·외전·신장 작용 연결로 옳은 짝 식별\",\"n\":\"윤상갑상근은 성대 신장, 후윤상피열근은 유일한 외전근, 측윤상피열근은 내전근\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두의 신경 지배에 대한 설명으로 옳은 것은?\",\"choices\":[\"상후두신경 외지는 후윤상피열근을 지배한다\",\"왼쪽 되돌이후두신경은 오른쪽보다 주행 경로가 짧다\",\"되돌이후두신경은 윤상갑상근만 지배한다\",\"상후두신경 내지는 성문 상부의 감각을 담당한다\",\"되돌이후두신경은 설인신경(9번)의 가지이다\"],\"answer\":4,\"explain\":\"상후두신경(미주신경 가지)의 내지는 감각 신경으로 성문 상부 점막의 감각을 담당하고, 외지는 운동 신경으로 윤상갑상근을 지배한다. 되돌이후두신경은 미주신경(10번)의 가지로 윤상갑상근을 제외한 모든 후두 내근을 지배하며, 왼쪽은 대동맥궁을 돌아 올라오므로 오른쪽보다 주행이 길어 손상에 더 취약하다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"후두 신경 지배\",\"p\":\"상후두신경 가지와 되돌이후두신경의 지배 범위로 설명 식별\",\"n\":\"상후두신경 내지는 성문 상부 감각, 외지는 윤상갑상근, 되돌이후두신경은 나머지 내근\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"성대의 층 구조(몸체-덮개 모형)에 대한 설명으로 옳은 것은?\",\"choices\":[\"점막파동은 몸체(body)인 성대근에서 주로 발생한다\",\"갑상피열근(성대근)은 덮개(cover)에 해당한다\",\"성대인대는 상피 바로 아래 고유층 표층으로 이루어진다\",\"라인케 공간은 성대근과 맞닿은 고유층 심층에 위치한다\",\"상피와 고유층 표층은 덮개(cover)에 해당한다\"],\"answer\":5,\"explain\":\"몸체-덮개 모형에서 덮개는 상피와 느슨한 고유층 표층(라인케 공간)으로 구성되어 점막파동이 일어나는 부위이며, 몸체는 성대근(갑상피열근)이다. 성대인대는 고유층 중간층과 심층으로 이루어진 이행부이다. 라인케 공간은 고유층 표층이며, 점막파동은 덮개에서 발생한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"성대 몸체-덮개 모형\",\"p\":\"성대 층별 구성과 점막파동 발생 부위로 옳은 설명 식별\",\"n\":\"덮개: 상피와 고유층 표층(라인케 공간), 몸체: 성대근, 점막파동은 덮개에서 발생\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"음성 강도를 높일 때 나타나는 생리적 변화로 옳은 것은?\",\"choices\":[\"성문하압이 감소하고 성대 긴장이 줄어든다\",\"진동 주기에서 개방기가 길어지고 폐쇄기가 짧아진다\",\"성문하압이 증가하고 성대 폐쇄기가 길어진다\",\"성대 진동의 진폭이 작아지고 폐쇄가 약해진다\",\"성대 접촉이 느슨해져 성문 통과 기류가 줄어든다\"],\"answer\":3,\"explain\":\"강도를 높이려면 성문하압을 높이고 성대를 더 단단히 접촉시켜 진동 주기 중 폐쇄기가 길어지도록 해야 한다. 이때 성대가 더 크게 열렸다 빠르게 닫히므로 진동 진폭도 커진다. 성문하압 감소, 개방기 연장, 진폭 감소는 오히려 강도를 낮추는 변화이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"음성 강도 조절 생리\",\"p\":\"성문하압과 폐쇄기 변화로 강도 상승 시 생리적 변화 식별\",\"n\":\"강도 증가: 성문하압 증가, 성대 폐쇄기 연장, 진동 진폭 증가\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"45세 여성의 청지각적 평가(GRBAS) 결과\\nG2 R1 B2 A0 S0\",\"q\":\"결과 해석으로 옳은 것은?\",\"choices\":[\"전반적 중증도는 경도이다\",\"거친소리가 바람새는소리보다 더 두드러진다\",\"쥐어짜는소리가 중등도로 지각된다\",\"바람새는소리가 중등도로 지각된다\",\"무력성이 경도로 관찰된다\"],\"answer\":4,\"explain\":\"GRBAS는 각 항목을 0(정상)~3(심도)의 4점 척도로 평정한다. B2는 바람새는소리가 중등도라는 의미이며, G2이므로 전반적 중증도도 중등도이다. R1(경도)은 B2보다 덜 두드러지고, A0·S0은 무력성과 쥐어짜는소리가 관찰되지 않음을 뜻한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"GRBAS 결과 해석\",\"p\":\"항목별 0~3점 평정값으로 음질 특성과 중증도 판단\",\"n\":\"GRBAS: 0 정상~3 심도, B2는 바람새는소리 중등도, G는 전반적 중증도\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"CAPE-V(Consensus Auditory-Perceptual Evaluation of Voice)에 대한 설명으로 옳은 것은?\",\"choices\":[\"평가자가 각 항목을 0~3점의 4점 등간척도로 평정한다\",\"6개 항목을 100mm 시각아날로그척도로 평정한다\",\"문장이나 자발화 없이 지속 모음 과제만으로 평가한다\",\"환자가 스스로 음성 문제의 심각도를 보고하는 도구이다\",\"각 항목의 점수는 음향 분석 소프트웨어가 자동으로 산출한다\"],\"answer\":2,\"explain\":\"CAPE-V는 평가자가 지속 모음, 표준 문장, 자발화를 듣고 6개 핵심 항목(전반적 중증도, 거친소리, 바람새는소리, 쥐어짜는소리, 음도, 강도)을 100mm 시각아날로그척도(VAS)로 표시하고, 각 특성이 지속적(C)인지 간헐적(I)인지도 기록하는 청지각적 평가이다. 4점 척도는 GRBAS의 방식이고, 자기보고 도구(VHI 등)나 음향 분석과는 다르다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"CAPE-V 평정 방식\",\"p\":\"평정 척도·항목 수·과제 구성으로 CAPE-V 특징 식별\",\"n\":\"CAPE-V: 6개 항목을 100mm 시각아날로그척도로 평정, 지속 모음·문장·자발화 사용\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"6세 남아\\n• 6개월 전부터 지속되는 쉰 목소리\\n• 음성 문제가 아동의 일상생활과 학교생활에 미치는 영향을 보호자 보고로 파악하려 함\",\"q\":\"가장 적절한 도구는?\",\"choices\":[\"음성장애지수(VHI-30)\",\"소아 음성장애지수(pVHI)\",\"음성피로도 검사(VFI)\",\"음성과 관련된 삶의 질(V-RQOL)\",\"GRBAS 청지각적 평가\"],\"answer\":2,\"explain\":\"pVHI는 성인용 VHI를 아동에게 맞게 수정하여 부모(보호자)가 아동의 음성 문제가 기능·신체·정서 영역에 미치는 영향을 보고하는 도구이다. VHI-30, V-RQOL, VFI는 성인 환자 본인이 작성하는 자기보고 도구이고, GRBAS는 평가자의 청지각적 평정 척도이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"아동 음성 자기보고 도구\",\"p\":\"아동 대상·보호자 보고 목적으로 적절한 음성 평가 도구 선택\",\"n\":\"pVHI: 보호자가 아동 음성 문제의 기능·신체·정서 영향을 보고하는 도구\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"음향학적 변수에 대한 설명으로 옳게 연결된 것은?\",\"choices\":[\"주파수변동률(jitter) – 인접 주기 간 진폭의 변동\",\"진폭변동률(shimmer) – 인접 주기 간 기본주파수의 변동\",\"배음대소음비(HNR) – 값이 클수록 잡음 성분이 많음\",\"발화기본주파수(SFF) – 지속 모음에서 측정한 최고 음도\",\"기본주파수(F0) – 성대가 1초 동안 진동하는 횟수\"],\"answer\":5,\"explain\":\"기본주파수는 1초당 성대 진동 횟수(Hz)이다. jitter는 주기(주파수)의 단기 변동, shimmer는 진폭의 단기 변동으로 서로 바뀌어 있고, HNR은 값이 클수록 배음 성분이 많고 잡음이 적어 음질이 좋음을 뜻한다. 발화기본주파수는 연결발화에서의 평균 F0이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"음향학적 변수 정의\",\"p\":\"jitter·shimmer·HNR·F0의 측정 내용 구분으로 옳은 연결 식별\",\"n\":\"F0는 초당 성대 진동 횟수, jitter는 주기 변동, shimmer는 진폭 변동, HNR 클수록 양호\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"38세 남성 교사\\n• 최근 3개월간 쉰 목소리\\n• 최대발성지속시간: /s/ 22초, /z/ 11초\",\"q\":\"s/z 비율 결과에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"s/z 비율이 2.0으로, 호흡 지지 부족이 주된 원인으로 추정된다\",\"s/z 비율이 2.0이므로 공명 문제를 우선 평가해야 한다\",\"s/z 비율이 0.5로 정상 범위이며 추가 평가는 불필요하다\",\"s/z 비율이 2.0으로 성대 병변에 의한 폐쇄부전이 의심된다\",\"/s/와 /z/ 모두 정상보다 짧아 폐활량 저하가 의심된다\"],\"answer\":4,\"explain\":\"s/z 비율은 /s/ 지속시간을 /z/ 지속시간으로 나눈 값(22/11=2.0)이다. 무성음 /s/는 정상인데 유성음 /z/만 짧다면 호흡 능력은 보존되었으나 성대 진동 시 공기가 새는 것이므로 성대 병변(결절·폴립 등)에 의한 성문 폐쇄부전을 시사한다. 일반적으로 1.4 이상이면 성대 병리를 의심한다. 호흡 지지 부족이면 /s/와 /z/가 모두 짧아진다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"s/z 비율 해석\",\"p\":\"/s/ 정상·/z/ 단축 결과로 s/z 비율 산출과 원인 판단\",\"n\":\"s/z 비율 상승: 호흡 보존·유성음만 단축, 성대 병변에 의한 폐쇄부전 시사\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두스트로보스코피 검사에 대한 설명으로 옳은 것은?\",\"choices\":[\"점막파동·진폭·성문폐쇄·대칭성 등을 관찰한다\",\"기본주파수를 알 필요 없이 임의의 빛 주기로 촬영한다\",\"성대 진동의 실제 주기 하나하나를 그대로 보여준다\",\"심한 비주기적 음성일수록 정확한 영상을 얻을 수 있다\",\"성대 접촉 면적의 변화를 전기 신호로 기록한다\"],\"answer\":1,\"explain\":\"스트로보스코피는 성대 진동 주파수와 약간 다른 주기로 빛을 비추어 여러 주기의 조각을 합성한 느린 가상 영상을 만드는 검사로, 점막파동·진동 진폭·성문폐쇄 양상·좌우 대칭성·주기성·비진동 부위 등을 관찰한다. 기본주파수에 동기화해야 하므로 심하게 비주기적인 음성에서는 신뢰도가 떨어진다. 성대 접촉 면적을 전기 신호로 기록하는 것은 전기성문파형검사(EGG)이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"후두스트로보스코피 원리\",\"p\":\"가상 느린 영상 원리와 관찰 항목으로 검사 특징 식별\",\"n\":\"스트로보스코피: F0 동기화 섬광으로 점막파동·진폭·성문폐쇄·대칭성 관찰\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"후두스트로보스코피 소견\\n• 양측 성대의 앞쪽 1/3과 중간 1/3 경계 부위에 좌우 대칭적인 작은 융기\\n• 융기 부위 앞뒤로 성문이 닫히지 않는 모래시계형 폐쇄 양상\",\"q\":\"가장 가능성이 높은 병변은?\",\"choices\":[\"성대폴립\",\"성대결절\",\"성대낭종\",\"라인케부종\",\"후두횡격막\"],\"answer\":2,\"explain\":\"성대결절은 음성 남용·오용으로 성대 진동 시 충격이 가장 큰 막성 성대 앞쪽 1/3~중간 1/3 경계에 양측 대칭으로 생기는 병변이며, 두 결절이 맞닿아 그 앞뒤가 열리는 모래시계형 폐쇄부전이 특징이다. 폴립은 대개 편측이고, 낭종은 편측 점막 내 병변이며, 라인케부종은 성대 전체가 붓고, 후두횡격막은 성대 전방이 막으로 붙은 상태이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"스트로보 소견으로 병변 판별\",\"p\":\"양측 대칭 융기 위치와 모래시계형 폐쇄로 병변 판단\",\"n\":\"성대결절: 앞쪽 1/3~중간 1/3 경계 양측 대칭 병변, 모래시계형 폐쇄부전\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"56세 여성\\n• 30년 이상 흡연\\n• 낮고 거칠고 굵은 목소리, 전화 통화 시 남성으로 오인됨\\n• 후두내시경: 양측 성대 전체가 물주머니처럼 부어 있음\",\"q\":\"가장 가능성이 높은 진단은?\",\"choices\":[\"성대결절\",\"접촉성 육아종\",\"후두유두종\",\"성대구증\",\"라인케부종\"],\"answer\":5,\"explain\":\"라인케부종은 장기 흡연이 주요 원인으로, 고유층 표층(라인케 공간)에 액체가 차서 양측 성대 전체가 미만성으로 부어 성대 질량이 늘고 음도가 현저히 낮아진다. 중년 여성에서 남성 목소리로 오인되는 것이 전형적이다. 성대결절은 국소적 양측 융기, 접촉성 육아종은 피열연골 성대돌기 부위 병변, 유두종은 사마귀 모양 종양, 성대구증은 성대 가장자리의 홈이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"흡연 관련 음성장애 진단\",\"p\":\"장기 흡연·저음·양측 성대 미만성 부종으로 진단 판단\",\"n\":\"라인케부종: 장기 흡연, 고유층 표층 부종으로 양측 성대 전체 부음, 음도 저하\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"재발성 호흡기 유두종증(후두유두종)에 대한 설명으로 옳은 것은?\",\"choices\":[\"음성치료만으로 병변을 완전히 소실시킬 수 있다\",\"주로 장기 흡연 성인 남성에게만 발생한다\",\"인유두종바이러스(HPV) 감염과 관련이 있다\",\"양성 병변이므로 기도 폐쇄의 위험은 없다\",\"편측 성대 전방 1/3에만 국한되어 발생한다\"],\"answer\":3,\"explain\":\"후두유두종은 HPV(주로 6·11형) 감염으로 생기는 사마귀 모양의 양성 종양으로, 소아에서 흔하며 수술로 제거해도 재발이 잦다. 기도 여러 부위에 다발성으로 자랄 수 있어 특히 소아에서 기도 폐쇄 위험이 있다. 음성치료는 수술 후 음성 기능 회복을 돕는 보조적 역할이며 병변 자체를 없애지는 못한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"후두유두종 특징\",\"p\":\"원인·호발 대상·재발성·기도 위험으로 옳은 설명 식별\",\"n\":\"후두유두종: HPV 감염 관련 양성 종양, 소아 호발, 재발 잦고 기도 폐쇄 위험\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"내전형 경련성 발성장애의 특징으로 옳은 것은?\",\"choices\":[\"무성 자음에서 기식성 음성 끊김이 나타난다\",\"음성위생 교육이 일차적 치료법으로 권장된다\",\"속삭이거나 웃을 때 증상이 더 뚜렷하게 심해진다\",\"심리적 갈등에서 비롯된 기능적 음성장애로 분류된다\",\"모음 산출 시 쥐어짜는 듯한 음성 끊김이 나타난다\"],\"answer\":5,\"explain\":\"내전형 경련성 발성장애는 국소 근긴장이상증으로, 발성 중 성대가 불수의적으로 과도하게 내전되어 모음에서 쥐어짜는 듯한 긴장성 음성 끊김이 나타난다. 무성 자음에서 성대가 벌어져 기식성 끊김이 생기는 것은 외전형이다. 속삭임·웃음·노래 등에서는 오히려 증상이 줄어드는 경우가 많고, 신경학적 음성장애로 분류되며 일차 치료는 보툴리눔 독소 주입이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"경련성 발성장애 특징\",\"p\":\"음성 끊김 양상과 분류·치료로 내전형 특징 식별\",\"n\":\"내전형 경련성 발성장애: 모음에서 쥐어짜는 음성 끊김, 신경학적, 보툴리눔 치료\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"17세 남학생\\n• 변성기가 지났으나 여전히 높고 가는 목소리\\n• 기침을 하거나 웃을 때는 순간적으로 낮은 음성이 나옴\\n• 후두내시경: 후두 구조와 성대 운동 정상\",\"q\":\"가장 적절한 진단은?\",\"choices\":[\"편측 성대마비\",\"기능적 실성증\",\"내전형 경련성 발성장애\",\"성대구증\",\"변성발성장애\"],\"answer\":5,\"explain\":\"변성발성장애는 후두가 정상적으로 성장했음에도 사춘기 이후에도 소년기의 높은 음도를 유지하는 기능적 음성장애이다. 기침·웃음 시 낮은 음성이 나오는 것은 생리적으로 저음 산출이 가능함을 뜻하며, 후두 하강·손가락 조작·기침 유도 등으로 비교적 빠르게 개선된다. 기능적 실성증은 음성이 전혀 나오지 않고, 성대구증과 성대마비는 내시경에서 이상 소견이 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"변성발성장애 진단\",\"p\":\"변성기 이후 고음 유지·기침 시 저음·정상 후두로 진단 판단\",\"n\":\"변성발성장애: 정상 후두에서 사춘기 이후 높은 음도 유지, 기침·웃음 시 저음 가능\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"48세 남성\\n• 아침에 심한 쉰 목소리, 잦은 헛기침, 목 이물감, 가슴쓰림\\n• 후두내시경: 피열연골 부위 점막 발적·부종, 피열간 점막 비후\",\"q\":\"가장 가능성이 높은 진단은?\",\"choices\":[\"인후두역류질환\",\"후두유두종\",\"변성발성장애\",\"급성 바이러스성 후두염\",\"성대낭종\"],\"answer\":1,\"explain\":\"위 내용물이 후두까지 올라오는 인후두역류는 아침 쉰 목소리, 헛기침, 목 이물감을 흔히 동반하며(전형적인 가슴쓰림은 없는 경우도 많음) 후두 후방(피열연골·피열간 부위)의 발적·부종·점막 비후가 특징적 소견이다. 급성 후두염은 감기 등에 뒤따르는 단기 증상이고, 유두종·낭종은 종괴성 병변, 변성발성장애는 후두 소견이 정상이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"인후두역류 진단\",\"p\":\"아침 쉰 목소리·헛기침과 후두 후방 점막 소견으로 진단 판단\",\"n\":\"인후두역류: 아침 쉰 목소리·헛기침·이물감, 피열연골·피열간 부위 발적·비후\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• 소리가 비강이나 인두 뒤쪽에 갇혀 밖으로 잘 나오지 못하는 듯 답답하고 먹먹하게 들림\\n• 비강 앞쪽 폐쇄나 후방 인두 협착 시 나타날 수 있음\",\"q\":\"해당하는 공명 유형은?\",\"choices\":[\"과다비성\",\"과소비성\",\"맹관공명\",\"혼합 공명\",\"비강 난류\"],\"answer\":3,\"explain\":\"맹관공명(cul-de-sac resonance)은 소리가 막힌 공간에 갇혀 흡수되는 듯 답답하게 들리는 공명으로, 앞쪽 비강 폐쇄나 인두 협착, 혀의 후방 위치 등에서 나타난다. 과다비성은 모음에서 비강 공명이 과도한 것, 과소비성은 비음 /m, n/에서 비강 공명이 부족한 것, 비강 난류는 압력자음 산출 시 코로 공기가 새면서 들리는 소음이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"공명장애\",\"k\":\"공명 유형 식별\",\"p\":\"답답하게 갇힌 음질과 비강·인두 폐쇄 원인으로 공명 유형 판단\",\"n\":\"맹관공명: 막힌 공간에 소리가 갇혀 먹먹함, 앞쪽 비강 폐쇄·인두 협착에서 발생\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"편측 성대마비로 성문 폐쇄가 불완전한 환자에게 성대 내전을 촉진하기 위해 적용하는 음성치료 기법은?\",\"choices\":[\"하품-한숨법\",\"저작하기\",\"속삭이기\",\"밀기 기법\",\"후두 마사지\"],\"answer\":4,\"explain\":\"밀기 기법은 발성하면서 팔로 벽·의자를 밀거나 손을 맞잡아 당기는 등 힘을 주어 성대 내전을 반사적으로 강화하는 기법으로, 성대마비·성대 활 모양 등 저기능성(성문 폐쇄부전) 음성장애에 사용한다. 하품-한숨법, 저작하기, 후두 마사지는 과기능성 음성장애의 긴장을 낮추는 이완 기법이고, 속삭이기는 성대 접촉을 오히려 줄인다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성문 폐쇄부전 치료 기법\",\"p\":\"편측 성대마비의 폐쇄 부전 개선 목표로 내전 촉진 기법 선택\",\"n\":\"밀기 기법: 힘주기로 성대 내전 반사 강화, 저기능성 음성장애에 적용\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"40세 여성 콜센터 상담원\\n• 근긴장성 발성장애(1형)로 진단됨\\n• 발성 시 목 앞쪽 근육이 단단하게 만져지고 후두가 높게 위치함\",\"q\":\"우선적으로 적용할 치료로 적절한 것은?\",\"choices\":[\"밀기 기법으로 성대 내전과 접촉을 강화한다\",\"리실버만 음성치료로 큰 소리 산출을 훈련한다\",\"후두 마사지와 하품-한숨법으로 긴장을 이완한다\",\"강한 성문파열음 시작으로 힘 있는 발성을 유도한다\",\"보툴리눔 독소를 양측 갑상피열근에 주입한다\"],\"answer\":3,\"explain\":\"근긴장성 발성장애는 후두 외근·내근의 과도한 긴장으로 생기는 과기능성 음성장애이므로, 후두 마사지(후두 하강), 하품-한숨법, 저작하기 등 이완 중심 기법이 우선이다. 밀기 기법·강한 성문파열음·큰 소리 훈련은 성대 접촉과 긴장을 더 높여 부적절하고, 보툴리눔 독소 주입은 경련성 발성장애의 치료이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"근긴장성 발성장애 치료\",\"p\":\"과기능성 긴장과 후두 상승 소견으로 우선 치료 기법 선택\",\"n\":\"근긴장성 발성장애: 과기능성, 후두 마사지·하품-한숨법 등 이완 기법 우선\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• /m/ 허밍으로 입술·안면 앞쪽의 진동감을 느끼게 함\\n• 성대가 살짝 벌어진 상태에서 최소한의 노력으로 최대의 공명을 얻도록 함\\n• 성대 충격 스트레스를 줄이는 것이 목표\",\"q\":\"해당하는 음성치료는?\",\"choices\":[\"리실버만 음성치료\",\"액센트 기법\",\"성대기능훈련\",\"공명음성치료\",\"빨대발성\"],\"answer\":4,\"explain\":\"공명음성치료(Lessac-Madsen Resonant Voice Therapy)는 성대가 살짝 벌어진 상태에서 앞쪽 안면·입술의 진동감을 단서로 편안하고 울림 있는 음성을 산출하게 하여 성대 충격을 줄이면서도 강도를 확보하는 방법이다. LSVT는 큰 소리 산출 훈련, 액센트 기법은 복식호흡과 리듬 강세 훈련, 성대기능훈련은 4단계 성대 근육 운동, 빨대발성은 반폐쇄성도 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"음성치료 기법 식별\",\"p\":\"앞쪽 진동감과 최소 노력 최대 공명 목표로 치료법 식별\",\"n\":\"공명음성치료: 성대 살짝 벌린 상태에서 앞쪽 안면 진동감으로 성대 충격 감소\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"성대기능훈련(Vocal Function Exercises)에 대한 설명으로 옳은 것은?\",\"choices\":[\"준비·신장·수축·내전력 강화 운동으로 구성된다\",\"최대한 큰 소리로 밀어내며 강하게 발성하도록 한다\",\"속삭임으로 성대를 충분히 쉬게 하는 훈련이다\",\"음도 변화 없이 습관적 음도에서만 모음을 연장한다\",\"후두 마사지로 근육의 긴장을 낮추는 이완 기법이다\"],\"answer\":1,\"explain\":\"Stemple의 성대기능훈련은 준비운동(/i/ 연장), 신장(저음→고음 활주), 수축(고음→저음 활주), 내전력 강화(여러 음도에서 /ol/ 연장)의 4가지를 부드럽고 작은 소리로 하루 2회, 각 2번씩 수행하는 생리적 접근이다. 큰 소리·속삭임·이완 마사지는 해당하지 않으며, 음도 활주가 핵심이므로 습관적 음도에서만 연장하는 것도 틀리다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성대기능훈련 구성\",\"p\":\"4가지 운동 구성과 발성 방식으로 성대기능훈련 특징 식별\",\"n\":\"성대기능훈련: 준비·신장·수축·내전력 강화 4운동, 부드럽고 작은 소리로 수행\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"68세 남성, 파킨슨병\\n• 목소리가 작고 단조로우며 기식적임\\n• 본인은 자신의 목소리가 충분히 크다고 느낌\",\"q\":\"가장 적절한 음성치료는?\",\"choices\":[\"하품-한숨법\",\"리실버만 음성치료\",\"속삭이기\",\"공명음성치료\",\"흡기발성\"],\"answer\":2,\"explain\":\"LSVT LOUD는 파킨슨병 환자의 낮은 강도·단조로운 음성을 위해 개발된 집중 치료(주 4회, 4주)로, '크게 생각하기'를 통해 발성 노력을 높이고 자기 음성 크기에 대한 지각을 재조정한다. 하품-한숨법·공명음성치료는 과기능성 음성의 긴장을 낮추는 방법이며, 흡기발성은 가성대 발성·기능적 실성증에, 속삭이기는 강도를 더 낮추므로 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"파킨슨병 음성치료 선택\",\"p\":\"작고 단조로운 음성과 자기 음량 지각 저하로 치료법 선택\",\"n\":\"LSVT LOUD: 파킨슨병 저강도 음성, 크게 생각하기로 발성 노력과 음량 지각 재조정\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• 발성 시 진성대 대신 가성대(false vocal folds)가 진동함\\n• 낮고 거친 음질\",\"q\":\"진성대 발성을 유도하기 위해 사용할 수 있는 기법은?\",\"choices\":[\"흡기발성\",\"밀기 기법\",\"강한 성문파열음 시작\",\"큰 소리로 소리 지르기\",\"저음 유지 훈련\"],\"answer\":1,\"explain\":\"흡기발성은 숨을 들이마시면서 소리를 내는 방법으로, 흡기 시에는 가성대가 벌어지고 진성대만 진동하므로 가성대 발성이나 기능적 실성증 환자에게 진성대 발성을 되찾게 하는 데 유용하다. 밀기 기법·강한 성문파열음·소리 지르기는 성문 상부의 압축과 긴장을 더 높이고, 가성대 발성은 이미 낮은 음도이므로 저음 훈련은 목표와 맞지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"가성대 발성 치료 기법\",\"p\":\"가성대 진동 소견으로 진성대 발성 유도 기법 선택\",\"n\":\"흡기발성: 흡기 시 가성대 벌어지고 진성대만 진동, 가성대 발성·기능적 실성증에 적용\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"기관식도발성(TEP)에 대한 설명으로 옳은 것은?\",\"choices\":[\"전기후두처럼 외부 진동원을 목에 대어 소리를 낸다\",\"폐의 공기를 식도로 보내 인두식도분절을 진동시킨다\",\"식도로 삼킨 공기를 역류시켜 발성하므로 발화 길이가 짧다\",\"후두를 적출하지 않고 시행하는 성대 재건술이다\",\"발성을 위해 호흡과 무관하게 단어 단위로만 말한다\"],\"answer\":2,\"explain\":\"기관식도발성은 후두전적출 후 기관과 식도 사이에 만든 천공에 일방향 밸브 보철을 삽입하여, 기공을 막고 내쉰 폐의 공기를 식도로 보내 인두식도분절을 진동시키는 방법이다. 폐의 공기를 사용하므로 식도발성보다 발화 길이가 길고 강도가 크다. 외부 진동원을 쓰는 것은 전기후두, 삼킨 공기를 쓰는 것은 식도발성이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"특수 대상\",\"k\":\"무후두 발성 방법 비교\",\"p\":\"진동원과 공기 공급원 구분으로 기관식도발성 특징 식별\",\"n\":\"기관식도발성: 폐 공기를 보철로 식도에 보내 인두식도분절 진동, 발화 길이 김\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"다음은 좌측 중대뇌동맥 경색 환자의 파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R) 하위검사 원점수를 치료 전과 6개월 치료 후에 비교한 것이다.\\n• 스스로 말하기: 9/20 → 12/20\\n• 알아듣기: 120/200 → 150/200\\n• 따라말하기: 40/100 → 55/100\\n• 이름대기 및 낱말 찾기: 30/100 → 45/100\\n※ AQ = (스스로 말하기 + 알아듣기÷20 + 따라말하기÷10 + 이름대기÷10) × 2\",\"q\":\"이 환자의 치료 전후 실어증지수(AQ) 변화량은?\",\"choices\":[\"7.5점 증가\",\"12.5점 증가\",\"15.0점 증가\",\"17.5점 증가\",\"30.0점 증가\"],\"answer\":3,\"explain\":\"치료 전 AQ = (9 + 120÷20 + 40÷10 + 30÷10) × 2 = (9 + 6 + 4 + 3) × 2 = 44.0. 치료 후 AQ = (12 + 150÷20 + 55÷10 + 45÷10) × 2 = (12 + 7.5 + 5.5 + 4.5) × 2 = 59.0. 따라서 변화량은 59.0 − 44.0 = 15.0점이다. ⑤ 30.0은 ×2를 한 번 더 적용한 오류, ① 7.5는 마지막 ×2를 빠뜨린 오류에서 나오기 쉬운 값이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"PK-WAB-R AQ 변화량\",\"p\":\"치료 전후 하위검사 원점수를 환산식에 대입해 AQ 차이 산출\",\"n\":\"AQ: (스스로말하기+알아듣기÷20+따라말하기÷10+이름대기÷10)×2, 전후 차이 15.0점\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"62세 실어증 환자에게 복잡한 그림 설명하기 과제를 실시하였다.\\n• 발화 시간: 2분\\n• 산출한 총 낱말 수: 150개\\n• 이 중 정확하고 정보적이며 과제와 관련된 낱말(CIU): 90개\",\"q\":\"Nicholas와 Brookshire의 CIU 분석에 따른 이 환자의 %CIU와 분당 CIU 수는?\",\"choices\":[\"%CIU 45, 분당 CIU 60개\",\"%CIU 60, 분당 CIU 45개\",\"%CIU 60, 분당 CIU 90개\",\"%CIU 75, 분당 CIU 45개\",\"%CIU 40, 분당 CIU 75개\"],\"answer\":2,\"explain\":\"%CIU = CIU 수 ÷ 총 낱말 수 × 100 = 90 ÷ 150 × 100 = 60%. 분당 CIU = CIU 수 ÷ 발화 시간(분) = 90 ÷ 2 = 45개/분이다. 분당 낱말 수(WPM)는 150 ÷ 2 = 75개로, ⑤는 %CIU와 WPM을 혼동한 것이고 ③은 발화 시간을 나누지 않은 값이다. %CIU는 발화의 정보성(산출한 낱말 중 정보를 담은 낱말의 비율)을, 분당 CIU는 정보 전달의 효율성을 나타낸다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"%CIU·분당 CIU 산출\",\"p\":\"총 낱말 수·CIU 수·발화 시간으로 정보성과 효율성 지표 계산\",\"n\":\"%CIU=CIU÷총 낱말×100(정보성), 분당 CIU=CIU÷발화 시간(효율성)\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"다음은 58세 여자 환자의 뇌자기공명영상(B-MRI) 축상면이다. [그림 1]\",\"q\":\"빗금 친 영역이 손상되었을 때 이 환자에게 나타날 가능성이 가장 높은 의사소통·인지 특성은?\",\"choices\":[\"글을 읽을 때 줄의 왼쪽을 빠뜨리고 그림의 왼쪽 세부를 놓친다\",\"조사와 어미를 생략한 짧은 전보식 발화를 주로 산출한다\",\"음소착어가 잦고 따라말하기가 선택적으로 심하게 손상된다\",\"근력 저하 없이 조음 모색행동을 보이며 자동구어는 비교적 유창하다\",\"글자를 하나씩 짚어 가며 읽고 자신이 쓴 글을 다시 읽지 못한다\"],\"answer\":1,\"explain\":\"[그림 1]의 빗금은 R로 표시된 쪽, 곧 환자의 우측 대뇌반구 뒤쪽 바깥 부위(측두두정엽, 하두정소엽 및 상측두회 후방)에 있다. 우측 측두두정엽(하두정소엽) 손상은 좌측 편측무시의 대표적인 병소로, 읽기에서 줄의 왼쪽을 빠뜨리는 무시실독과 그림의 왼쪽 세부를 놓치는 시공간적 무시가 나타난다. ②는 좌측 하전두회(브로카 영역), ③은 좌측 궁상다발(전도실어증), ④는 좌측 전운동/뇌섬엽(말실행증), ⑤는 좌측 후두엽·뇌량 팽대(순수실독증) 손상에서 나타나는 특성이다.\",\"image\":\"data:image/webp;base64,\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"신경해부·뇌혈관\",\"k\":\"우측 측두두정엽 손상 특성\",\"p\":\"MRI 빗금 영역의 반구·위치로 손상 시 의사소통·인지 특성 추론\",\"n\":\"우측 측두두정엽(하두정소엽) 손상: 좌측 편측무시, 무시실독·그림 왼쪽 세부 누락\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"56세 남자 환자가 일산화탄소 중독으로 인한 저산소성 뇌손상 후 언어평가를 받았다.\\n• 파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R) 결과\\n – 스스로 말하기: 5/20점(내용전달 3점, 유창성 2점)\\n – 알아듣기: 64/200점\\n – 따라말하기: 82/100점\\n – 이름대기 및 낱말 찾기: 12/100점\\n• 검사자의 질문을 그대로 되풀이하는 반향어가 빈번함\",\"q\":\"이 환자의 실어증 유형과 추정되는 손상 부위가 옳게 연결된 것은?\",\"choices\":[\"전반실어증 – 좌측 중대뇌동맥 영역 전체\",\"브로카실어증 – 좌측 하전두회 후방\",\"베르니케실어증 – 좌측 상측두회 후방\",\"연결피질운동실어증 – 좌측 보충운동영역\",\"혼합연결피질실어증 – 분수계 영역\"],\"answer\":5,\"explain\":\"비유창한 발화(유창성 2점), 심하게 저하된 청각적 이해(64/200), 심한 이름대기 장애에도 불구하고 따라말하기만 82/100으로 뚜렷하게 보존되고 반향어가 나타나는 양상은 혼합연결피질실어증(고립증후군)의 특징이다. PK-WAB-R 10점 척도로 환산하면 유창성 2, 알아듣기 3.2(64÷20), 따라말하기 8.2(82÷10), 이름대기 1.2(12÷10)로, 혼합연결피질실어증 분류 기준(유창성 0~4, 알아듣기 0~3.9, 따라말하기 5~10, 이름대기 0~6)에 모두 들어간다. 저산소성 뇌손상이나 일산화탄소 중독은 전·후 분수계(경계역) 영역을 함께 손상시켜 언어 영역(페리실비안)은 남기고 주변 연합영역을 손상시키므로 이 유형이 발생한다. 전반실어증(①)은 따라말하기도 심하게 손상되며, 연결피질운동실어증(④)은 청각적 이해가 비교적 양호하다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"혼합연결피질실어증 감별\",\"p\":\"따라말하기만 보존된 비유창·이해 저하와 저산소성 원인으로 유형·병소 판단\",\"n\":\"혼합연결피질실어증: 따라말하기 보존·반향어, 저산소성 손상에 의한 분수계 영역 병변\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"브로카실어증 환자의 문장-그림 짝짓기 검사 결과\\n• 비가역 문장(예: '소년이 사과를 먹었다'): 정답률 95%\\n• 가역 능동문(예: '소녀가 소년을 밀었다'): 정답률 45%\\n• 가역 피동문(예: '소년이 소녀에게 밀렸다'): 정답률 40%\\n• 오류는 대부분 행위자와 대상이 뒤바뀐 그림을 선택하는 것이었음\",\"q\":\"이 환자의 문장 이해 결함을 개선하기 위해 가장 적절한 치료법은?\",\"choices\":[\"멜로디억양치료\",\"의미자질분석\",\"시각동작치료\",\"매핑치료\",\"의사소통효과증진법\"],\"answer\":4,\"explain\":\"비가역 문장은 의미·상식 단서로 이해할 수 있어 정답률이 높지만, 가역 문장에서 행위자와 대상을 뒤바꾸는 오류는 통사 구조에 의미역(행위자·대상)을 할당하는 '매핑'의 결함을 시사한다. 매핑치료는 동사를 중심으로 '누가·무엇을·누구에게'를 확인하며 문장 구조와 의미역의 대응을 훈련하는 방법으로 이러한 실문법성 이해 결함에 직접 적용된다. ①은 비유창 환자의 구어 산출 유도, ②는 이름대기, ③은 전반실어증의 제스처 소통, ⑤는 기능적 정보 교환 훈련이 목적이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"매핑치료 선택\",\"p\":\"가역 문장에서 행위자·대상을 뒤바꾸는 오류로 문장 이해 치료법 선택\",\"n\":\"매핑치료: 동사 중심으로 문장 구조와 의미역 대응 훈련, 실문법성 이해 결함에 적용\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"언어재활사가 실문법증 환자의 문장 산출 치료를 계획하면서 단순한 능동문 대신 목적어 관계절이 포함된 문장(예: '엄마가 아이가 안고 있는 강아지를 쓰다듬는다')을 먼저 훈련하기로 하였다. 치료 후 훈련하지 않은, 같은 유형의 구조를 공유하는 더 단순한 문장(목적어를 묻는 의문사 의문문, 예: '아이가 무엇을 안고 있니?')에서도 산출이 향상되었다.\",\"q\":\"이러한 치료 계획의 근거가 되는 원리는?\",\"choices\":[\"자극의 난이도 위계에 따라 쉬운 구조부터 훈련해야 오류가 줄어든다\",\"복잡한 구조 훈련이 언어학적으로 관련된 단순 구조로 일반화된다\",\"오류 없는 학습을 통해 잘못된 반응이 강화되는 것을 막는다\",\"자동구어를 먼저 활용하면 명제적 발화의 산출이 촉진된다\",\"우반구의 운율 처리 능력을 활용하여 좌반구 기능을 보완한다\"],\"answer\":2,\"explain\":\"Thompson 등의 복잡성 효과(complexity account of treatment efficacy, CATE)와 기저형 치료(TUF)에 따르면, 언어학적으로 더 복잡한 구조(목적어 관계절 등 논항 이동이 포함된 구조)를 훈련하면 그 하위 과정을 공유하는 단순한 구조로 일반화되지만, 반대 방향의 일반화는 잘 일어나지 않는다. 일반화는 같은 유형의 이동(wh-이동)을 공유하는 구조 사이에서 일어나며, 이동 유형이 다른 피동문(NP-이동)이나 이동이 없는 능동문으로는 일반화되지 않는다. ①은 전통적 난이도 위계 원리로 문제의 계획과 반대이며, ③·④·⑤는 각각 오류 없는 학습, 자동구어 활용, 멜로디억양치료의 원리이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"복잡성 효과(CATE) 원리\",\"p\":\"복잡한 구조 훈련 후 미훈련 단순 구조 향상으로 치료 계획의 원리 판단\",\"n\":\"CATE: 복잡한 구조 훈련이 같은 이동 유형을 공유하는 단순 구조로 일반화\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"세 명의 환자에게 교대운동속도(AMR: /퍼/, /터/, /커/ 각각 반복)와 일련운동속도(SMR: /퍼터커/ 반복) 과제를 실시하였다.\\n• 환자 A: AMR은 속도와 규칙성이 정상 범위이나, SMR에서 음절 순서가 뒤바뀌고 모색행동이 나타나며 여러 번 시도함\\n• 환자 B: AMR과 SMR 모두 느리지만 규칙적이고, 쥐어짜는 듯한 거친 음성이 동반됨\\n• 환자 C: AMR의 속도·강도·음도가 불규칙하게 변동하고 음절이 갑자기 폭발적으로 산출됨\",\"q\":\"세 환자의 말운동장애 유형이 옳게 연결된 것은?\",\"choices\":[\"A: 말실행증, B: 경직형 마비말장애, C: 실조형 마비말장애\",\"A: 실조형 마비말장애, B: 말실행증, C: 경직형 마비말장애\",\"A: 경직형 마비말장애, B: 실조형 마비말장애, C: 말실행증\",\"A: 말실행증, B: 실조형 마비말장애, C: 이완형 마비말장애\",\"A: 이완형 마비말장애, B: 경직형 마비말장애, C: 말실행증\"],\"answer\":1,\"explain\":\"말실행증은 근력·협응의 문제가 아니라 운동 계획·프로그래밍의 문제이므로 단일 음절 반복(AMR)은 비교적 정상이지만 조음 위치를 순서대로 전환해야 하는 SMR에서 순서 오류와 모색행동이 두드러진다(A). 경직형은 양측 상부운동신경 손상으로 느리지만 규칙적인 AMR·SMR과 쥐어짜는 음성이 특징이다(B). 실조형은 소뇌 손상으로 운동의 시간·힘 조절이 불규칙해져 AMR의 속도·강도·음도가 불규칙하고 폭발적인 산출을 보인다(C). 이완형은 AMR이 느리고 약하며 기식 음성·과다비성이 동반된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"AMR·SMR로 말운동장애 감별\",\"p\":\"AMR·SMR 수행 양상과 음성 특성으로 세 환자의 장애 유형 구분\",\"n\":\"말실행증: SMR 순서 오류·모색, 경직형: 느리고 규칙적, 실조형: 불규칙·폭발적\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"좌측 전운동피질 손상으로 말실행증을 보이는 54세 환자의 치료 경과\\n• 회기 내에서는 목표 낱말('구두', '기차', '토마토')의 정확도가 90%까지 향상됨\\n• 그러나 다음 회기 시작 시 정확도가 40%로 떨어지고, 훈련하지 않은 낱말로의 전이가 거의 없음\\n• 현재 치료 방식: 목표 낱말별 블록 연습, 매 시행마다 즉각적인 피드백 제공\",\"q\":\"운동학습 원리에 근거하여 파지와 전이를 높이기 위해 치료 조건을 조정한 것으로 가장 적절한 것은?\",\"choices\":[\"블록 연습을 유지하고 매 시행 피드백 횟수를 더 늘린다\",\"목표 낱말 수를 줄이고 매 시행마다 즉각 피드백을 계속 제공한다\",\"한 회기에 많은 시행을 몰아서 하는 집중(massed) 연습만 한다\",\"모든 시행에서 치료사가 먼저 모델을 제공한 후 따라 하게 한다\",\"낱말을 무작위 순서로 연습하고 피드백을 지연·저빈도로 준다\"],\"answer\":5,\"explain\":\"운동학습 원리(Maas 등)에 따르면 블록 연습과 매 시행 즉각 피드백은 회기 내 수행(습득)은 높이지만 파지·전이에는 불리하다. 무작위 연습, 분산 연습, 지연·저빈도(매 시행이 아닌 일부 시행에만 주는) 결과지식(KR) 피드백은 학습자의 내적 오류 탐지와 문제 해결을 촉진하여 장기 파지와 일반화를 향상시킨다. ①·②·③·④는 모두 습득 단계의 수행은 높여도 파지를 저해하는 조건이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"말실행증 운동학습 원리\",\"p\":\"회기 내 향상에 비해 낮은 파지·전이로 연습·피드백 조건 조정\",\"n\":\"무작위·분산 연습과 지연·저빈도 피드백이 파지와 전이를 향상\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"48세 헌팅턴병 환자의 말 평가 결과\\n• 얼굴·사지의 무도성 불수의 운동이 지속적으로 나타남\\n• 발화 중 갑작스러운 음성 강도 변동과 호흡의 흐트러짐\\n• 불규칙한 말속도와 부적절한 침묵, 예기치 않은 모음 왜곡\\n• 근력 저하는 뚜렷하지 않음\",\"q\":\"이 환자의 마비말장애 유형과 적절한 중재가 옳게 연결된 것은?\",\"choices\":[\"과소운동형 – 리실버만음성치료로 음성 강도 증진\",\"실조형 – 메트로놈을 이용한 규칙적 음절 산출 훈련\",\"과다운동형 – 구 단위 끊어 말하기와 페이싱\",\"경직형 – 하품한숨기법으로 후두 긴장 이완\",\"이완형 – 저항 운동을 통한 구강 근력 강화\"],\"answer\":3,\"explain\":\"헌팅턴병은 기저핵(미상핵·피각) 퇴행으로 무도증을 일으키며, 불수의 운동이 말에 침범되어 갑작스러운 강도·호흡 변동, 불규칙한 말속도, 예기치 않은 왜곡을 보이는 과다운동형 마비말장애를 유발한다. 불수의 운동 자체를 직접 없앨 수 없으므로 짧은 구 단위로 나누어 말하기, 페이싱, 불수의 운동이 덜 개입되는 자세 및 보상 전략이 적절하다. ①은 파킨슨병(과소운동형), ②는 소뇌 손상(실조형), ④는 경직형, ⑤는 근력 저하가 있는 이완형에 해당한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"과다운동형 마비말장애 중재\",\"p\":\"헌팅턴병의 무도성 불수의 운동과 불규칙한 말 특성으로 유형·중재 연결\",\"n\":\"과다운동형: 기저핵 퇴행, 구 단위 끊어 말하기·페이싱 등 보상 전략\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"42세 여자 환자의 호소\\n• \\\"오후가 되면 눈꺼풀이 처지고 말이 더 어눌해져요.\\\"\\n• \\\"전화를 오래 하면 점점 콧소리가 나고 목소리에 바람이 새는데, 잠깐 쉬면 다시 괜찮아져요.\\\"\\n• 검사 시 1부터 100까지 세는 동안 과다비성과 기식성이 점차 심해졌고 5분 휴식 후 회복됨\",\"q\":\"이 환자의 마비말장애 유형과 손상 부위가 옳게 연결된 것은?\",\"choices\":[\"경직형 – 양측 상부운동신경\",\"과소운동형 – 기저핵 조절회로\",\"실조형 – 소뇌와 그 연결 경로\",\"이완형 – 신경근접합부\",\"편측 상부운동신경형 – 피질뇌간로\"],\"answer\":4,\"explain\":\"지속적인 근육 사용에 따라 악화되고 휴식 후 회복되는 피로성 약화, 안검하수, 점진적 과다비성·기식성은 신경근접합부의 아세틸콜린 수용체 장애인 중증근무력증의 전형적인 소견이다. 신경근접합부 병변은 하부운동신경 단위(운동단위)의 병변에 포함되므로 이완형 마비말장애로 분류된다. 스트레스 검사(숫자 세기 등 지속 발화)로 피로에 따른 악화를 확인하는 것이 진단에 유용하다. 나머지 유형은 말을 계속할수록 악화되고 휴식하면 회복되는 피로성 변동이 특징적이지 않다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"중증근무력증 마비말장애\",\"p\":\"지속 사용 시 악화되고 휴식 후 회복되는 피로성 약화로 유형·병소 판단\",\"n\":\"중증근무력증: 신경근접합부 병변으로 이완형 마비말장애, 피로성 과다비성·기식성\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"66세 남자 환자\\n• 좌측 후대뇌동맥 경색, 우측 동측반맹\\n• 글을 읽을 때 글자를 하나씩 짚어 가며 읽고, 낱말이 길수록 읽는 시간이 뚜렷하게 길어짐\\n• 받아쓰기와 자발적 쓰기는 정상이나, 방금 자신이 쓴 문장을 다시 읽지 못함\\n• 구어 표현과 청각적 이해는 정상 범위\",\"q\":\"이 환자의 진단명과 손상 부위가 옳게 연결된 것은?\",\"choices\":[\"순수실독증 – 좌측 후두엽과 뇌량 팽대\",\"심층실독증 – 좌측 전두·두정 광범위 병변\",\"표층실독증 – 좌측 측두엽 전방부\",\"무시실독증 – 우측 하두정소엽\",\"실독증을 동반한 실서증 – 좌측 각회\"],\"answer\":1,\"explain\":\"쓰기는 보존되나 자신이 쓴 글조차 읽지 못하는 '실서증 없는 실독증', 글자 하나씩 읽기(letter-by-letter reading)와 낱말 길이 효과, 우측 동측반맹의 동반은 순수실독증의 전형적 특징이다. 좌측 후두엽(시각피질) 손상으로 좌측 시야의 시각 정보만 우측 후두엽에서 처리되는데, 뇌량 팽대가 함께 손상되어 이 정보가 좌반구의 언어 영역(각회)으로 전달되지 못하는 단절증후군이다. ⑤ 각회 손상은 읽기와 쓰기가 모두 손상되는 실독·실서증을 일으킨다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실독증·실서증\",\"k\":\"순수실독증 진단·병소\",\"p\":\"쓰기 보존·글자 하나씩 읽기·우측 반맹으로 실독증 유형과 병소 판단\",\"n\":\"순수실독증: 좌측 후두엽·뇌량 팽대 손상, 실서증 없는 실독, 낱말 길이 효과\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"좌반구 뇌졸중 환자의 받아쓰기 검사 결과\\n• 규칙어('나무', '바지')와 불규칙어('닭', '굳이', '넋'): 모두 정확하게 씀\\n• 비단어('소딥', '가믄', '누텔'): 쓰지 못하거나 실제 낱말로 바꾸어 씀('소딥'→'소득')\\n• 구체어와 추상어 쓰기의 차이는 뚜렷하지 않음\\n• 베껴 쓰기와 글자 형태는 정상\",\"q\":\"이 환자의 실서증 유형과 손상된 쓰기 경로가 옳게 연결된 것은?\",\"choices\":[\"표층실서증 – 어휘 경로\",\"심층실서증 – 의미 경로\",\"실행실서증 – 운동 프로그래밍\",\"공간실서증 – 시공간 처리\",\"음운실서증 – 음운 경로\"],\"answer\":5,\"explain\":\"비단어는 음소-자소 변환(음운 경로)을 거쳐야만 쓸 수 있는데 이것이 선택적으로 손상되고, 어휘 경로가 보존되어 불규칙어를 포함한 실제 낱말은 정확히 쓰는 양상은 음운실서증이다. 표층실서증(①)은 반대로 어휘 경로가 손상되어 불규칙어를 소리 나는 대로('닭'→'닥') 쓰고 비단어는 잘 쓴다. 심층실서증(②)은 비단어 쓰기 불가에 더해 의미착오('의자'→'책상')와 구체어-추상어 차이가 나타난다. ③·④는 언어적 경로가 아닌 운동·공간 처리의 문제로 글자 형태나 배열이 손상된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실독증·실서증\",\"k\":\"음운실서증 감별\",\"p\":\"규칙어·불규칙어 보존과 비단어 쓰기 실패로 손상된 쓰기 경로 판단\",\"n\":\"음운실서증: 음운 경로(음소-자소 변환) 선택적 손상, 어휘 경로 보존\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"70세 남자 환자\\n• 고혈압·당뇨 병력, 3년 동안 두 차례 소혈관 뇌졸중\\n• 인지 저하가 뇌졸중 시점마다 계단식으로 악화됨\\n• 처리속도와 실행기능(계획, 전환)이 뚜렷하게 저하됨\\n• 이야기 지연회상은 낮으나 재인 단서를 주면 대부분 회상함\\n• 보행 불안정과 배뇨 절박 동반\",\"q\":\"이 환자에게 가장 의심되는 진단명은?\",\"choices\":[\"알츠하이머 치매\",\"루이소체 치매\",\"혈관성 치매\",\"전두측두치매\",\"의미치매\"],\"answer\":3,\"explain\":\"혈관 위험인자, 뇌졸중 병력과 시간적으로 연관된 계단식 악화, 실행기능·처리속도의 초기 저하, 저장보다 인출의 결함(단서 제공 시 회상 향상), 보행 장애와 배뇨 증상 같은 국소 신경학적 징후는 혈관성 치매(특히 피질하 소혈관성)의 전형적 특징이다. 알츠하이머 치매(①)는 서서히 진행하며 단서를 주어도 회상되지 않는 저장 결함이 특징이고, 루이소체 치매(②)는 인지 변동·시각환각·파킨슨증, 전두측두치매(④, 특히 행동변이형)는 탈억제·무감동 등 행동 변화, 의미치매(⑤)는 낱말 의미와 사물 지식 상실이 두드러진다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"혈관성 치매 감별\",\"p\":\"혈관 위험인자·계단식 악화·단서 시 회상 향상으로 치매 유형 판단\",\"n\":\"혈관성 치매: 계단식 악화, 실행기능·처리속도 저하, 인출 결함, 국소 신경학적 징후\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"63세 여자 환자\\n• 2년 전부터 서서히 진행되는 노력성·비유창 발화\\n• 조사·어미를 생략하고 문장이 짧음\\n• 발화 중 모색행동과 일관성 없는 조음 오류가 관찰됨\\n• 피동문과 관계절이 포함된 문장의 이해가 저하됨\\n• 뇌 영상에서 좌측 하전두회·뇌섬엽의 위축\",\"q\":\"이 환자의 진단명을 고려할 때, 질환 초기에 상대적으로 보존될 것으로 기대되는 능력은?\",\"choices\":[\"문법형태소의 정확한 산출\",\"조음의 순서화와 프로그래밍\",\"피동문의 이해\",\"단일 낱말의 의미 이해\",\"긴 문장의 따라말하기\"],\"answer\":4,\"explain\":\"점진적 진행, 실문법증, 말실행증 동반, 복잡한 통사 이해 저하, 좌측 하전두회·뇌섬엽 위축은 원발성 진행성 실어증의 비유창/실문법형(nfvPPA)에 해당한다. 이 유형의 핵심 진단 기준은 단일 낱말 이해와 사물 지식이 상대적으로 보존된다는 점으로, 의미형 PPA와 감별되는 핵심 특징이다. ①·②·③·⑤는 모두 이 유형에서 손상되는 영역이다(긴 문장 따라말하기는 통사·운동 프로그래밍 부담으로 손상된다).\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"실어증\",\"k\":\"비유창형 PPA 보존 능력\",\"p\":\"진행성 비유창 발화·실문법증·하전두회 위축으로 유형 판단 후 보존 능력 추론\",\"n\":\"비유창/실문법형 PPA: 단일 낱말 이해·사물 지식 상대적 보존, 의미형과 감별\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"79세 여자 환자, 고관절 골절 수술 3일째 언어치료 의뢰됨\\n• 수술 전 인지·언어 기능은 정상이었다고 가족이 보고함\\n• 밤에 심해지는 혼란, 대화 중 주의가 갑자기 흐트러졌다가 돌아오는 변동\\n• 낮에는 졸려 하고 질문에 맥락 없는 답을 함\\n• 보호자: \\\"어제는 멀쩡하게 이야기했는데 오늘은 저를 못 알아봐요.\\\"\",\"q\":\"이 상황에서 언어재활사의 판단으로 가장 적절한 것은?\",\"choices\":[\"알츠하이머 치매 초기로 판단하고 기억 훈련을 즉시 시작한다\",\"섬망을 의심하여 의료진에게 알리고 공식 평가는 연기한다\",\"베르니케실어증으로 판단하고 청각적 이해력 훈련을 계획한다\",\"PK-WAB-R을 즉시 실시하여 실어증 유형을 분류한다\",\"우반구 손상에 의한 화용 결함으로 판단하고 대화 훈련을 시작한다\"],\"answer\":2,\"explain\":\"급성 발병, 수술·입원과의 시간적 연관성, 하루 중 변동하는 의식 수준과 주의력, 야간 악화, 이전 정상 인지는 치매가 아닌 섬망의 핵심 특징이다. 섬망은 감염·약물·대사 이상 등 급성 의학적 원인에 의한 가역적 상태이므로 언어재활사는 이 시기에 공식 평가나 치료를 시행해 결과를 해석하기보다 의료진에게 알리고 원인 교정 후 안정된 상태에서 재평가해야 한다. 변동하는 주의력 상태에서 얻은 검사 결과는 실어증이나 치매로 잘못 해석될 수 있다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"인지의사소통장애\",\"k\":\"섬망 의심 시 대처\",\"p\":\"수술 후 급성 발병과 하루 중 변동하는 주의력으로 섬망 판단과 조치 선택\",\"n\":\"섬망: 급성·가역적 상태, 의료진에게 알리고 공식 평가는 안정 후 재평가\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"외상성 뇌손상 후 3주가 지난 27세 남자 환자\\n• 랜초 로스 아미고스 인지기능척도(RLA) IV 수준(혼돈-초조)\\n• 주변 소음이나 낯선 사람에게 공격적으로 반응함\\n• 주의 지속 시간이 수 분 이내이고 시간·장소 지남력이 없음\\n• 자신이 어디에 있는지 반복해서 묻고 병실을 벗어나려 함\",\"q\":\"이 시기에 적절한 인지-의사소통 중재 접근은?\",\"choices\":[\"자극을 줄인 구조화된 환경에서 짧고 잦은 회기로 지남력을 유지한다\",\"실행기능 회복을 위해 복잡한 문제 해결 과제를 집중적으로 훈련한다\",\"표준화된 인지·언어검사 배터리를 완료하여 정확한 기초선을 먼저 확보한다\",\"또래 환자와의 그룹 대화 훈련으로 사회적 의사소통을 촉진한다\",\"공격 행동이 나타날 때 과제 난이도를 높여 주의를 다른 곳으로 돌린다\"],\"answer\":1,\"explain\":\"RLA IV(혼돈-초조) 수준은 주의 지속이 매우 짧고 외부 자극에 과민하게 반응하며 새로운 학습이 어려운 시기이다. 이때는 회복 훈련보다 환경 조절(자극 감소, 일관된 일과와 사람), 짧고 잦은 접촉, 지남력 정보의 반복 제공, 안전 확보, 익숙한 사람·물건 활용이 원칙이다. 복잡한 과제(②), 긴 표준화 검사(③), 자극이 많은 그룹 활동(④)은 초조를 악화시키며, 난이도를 높이는 것(⑤)은 좌절과 공격성을 유발한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"인지의사소통장애\",\"k\":\"RLA IV 단계 중재\",\"p\":\"혼돈-초조 수준의 짧은 주의와 자극 과민으로 적절한 중재 접근 선택\",\"n\":\"RLA IV: 자극 감소·구조화된 환경, 짧고 잦은 접촉, 지남력 정보 반복 제공\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"외상성 뇌손상 후 8개월 된 35세 환자\\n• 기억력과 언어 능력은 비교적 보존됨\\n• 과제 수행 전에 계획을 세우지 못하고 충동적으로 시작함\\n• 자신의 오류를 알아차리지 못하며, \\\"나는 아무 문제 없다\\\"고 말함\\n• 직장 복귀를 원하나 스스로의 능력을 과대평가함\",\"q\":\"이 환자에게 가장 적절한 중재는?\",\"choices\":[\"반복적인 컴퓨터 자극 훈련으로 손상된 기능을 회복시킨다\",\"외부 기억 보조 도구(다이어리, 알림) 사용만 훈련한다\",\"메타인지 전략과 자기 예측·평가 비교로 병식을 높인다\",\"오류 없는 학습을 적용하여 오류에 노출되지 않도록 한다\",\"문장 산출을 위한 통사 구조 훈련을 집중 실시한다\"],\"answer\":3,\"explain\":\"계획 부족, 충동성, 오류 인식 부재, 병식 결여는 실행기능과 자기 인식(self-awareness)의 결함으로 TBI 후 흔한 양상이다. 목표-계획-실행-점검(Goal-Plan-Do-Review) 등 메타인지 전략 교수(MSI)는 자기 조절 능력을 기르는 근거 기반 접근이며, 수행 전 예측과 실제 수행을 비교하는 절차는 병식 향상에 효과적이다. 기억(②)과 언어(⑤)는 보존되어 있어 주 표적이 아니며, 오류 없는 학습(④)은 오류를 경험하고 알아차리는 것이 목표인 이 환자에게는 적합하지 않다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"인지의사소통장애\",\"k\":\"TBI 병식 결여 중재\",\"p\":\"계획 부족·충동성·오류 인식 부재로 실행기능·자기 인식 중재 선택\",\"n\":\"메타인지 전략 교수: 목표-계획-실행-점검, 수행 전 예측과 실제 비교로 병식 향상\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"우반구 뇌졸중 환자\\n• 감정적으로 중립인 문장(\\\"그 사람이 집에 왔어\\\")을 화난 목소리, 기쁜 목소리, 슬픈 목소리로 들려주고 감정을 고르게 하면 우연 수준으로 반응함\\n• 문장의 언어적 의미 이해는 정상\\n• 환자 자신의 발화 억양은 다양하고 감정 표현이 자연스러움\",\"q\":\"이 환자의 운율장애 유형과 추정 병소가 옳게 연결된 것은?\",\"choices\":[\"표현성 감정 운율장애 – 우측 전두엽\",\"실어증성 운율 결함 – 좌측 하전두회\",\"과소운동형 운율 저하 – 양측 기저핵\",\"언어적 운율 결함 – 좌측 측두두정엽\",\"수용성 감정 운율장애 – 우측 측두두정\"],\"answer\":5,\"explain\":\"언어적 의미 이해는 정상이면서 감정 운율의 해석만 손상되고 자신의 운율 산출은 보존된 양상은 수용성(감각성) 감정 운율장애로, Ross의 모델에 따르면 우반구 후방(베르니케 영역의 우반구 상동 부위인 측두두정)이 담당한다. 표현성 운율장애(①)는 우반구 전방 손상으로 단조로운 억양 산출이 문제가 되며, 이 환자는 산출이 보존되어 해당하지 않는다. 기저핵 손상(③)은 산출의 단조로움, 좌반구 손상(②·④)은 감정 운율보다 언어적 운율·문법적 강세와 관련된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"수용성 감정 운율장애\",\"p\":\"감정 운율 해석만 손상되고 운율 산출은 보존된 양상으로 유형·병소 판단\",\"n\":\"수용성 감정 운율장애: Ross 모델상 우반구 후방(측두두정) 손상\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"비디오투시조영삼킴검사(VFSS)에서 얇은 액체 5mL 삼킴 시 관찰된 소견\\n• 조영제가 후두 전정을 지나 진성대 아래 기관으로 들어감\\n• 기침이나 헛기침 등 배출 시도가 전혀 없음\\n• 환자는 이상을 전혀 느끼지 못한다고 보고함\",\"q\":\"침습-흡인 척도(Penetration-Aspiration Scale, PAS)에 따른 이 소견의 점수와 해석은?\",\"choices\":[\"2점 – 성대 위 침습 후 배출됨\",\"3점 – 성대 위 침습, 배출되지 않음\",\"5점 – 성대 접촉 침습, 배출되지 않음\",\"6점 – 흡인 후 기도 밖으로 배출됨\",\"8점 – 배출 시도 없는 무증상 흡인\"],\"answer\":5,\"explain\":\"PAS는 1(기도 진입 없음)에서 8까지의 8단계로, 진성대 아래로 들어가면 흡인(6~8점)이다. 6점은 흡인 후 배출됨, 7점은 배출 시도가 있으나 배출되지 않음, 8점은 배출 시도 자체가 없는 무증상 흡인(silent aspiration)이다. 이 환자는 기관으로 들어간 조영제에 대해 기침 등 반응이 전혀 없으므로 8점에 해당하며, 감각 결함으로 인한 무증상 흡인은 임상(침상) 평가에서 놓치기 쉬워 기기 검사가 필수적임을 시사한다. ①~③은 성대 위에 머무는 침습(2~5점)에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"삼킴장애\",\"k\":\"PAS 점수 판정\",\"p\":\"진성대 아래 진입과 배출 시도 부재로 침습-흡인 척도 점수 판정\",\"n\":\"PAS 8점: 배출 시도 없는 무증상 흡인, 진성대 아래 진입은 흡인(6~8점)\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"68세 삼킴장애 환자의 VFSS 소견\\n• 삼킴 중 후두 거상과 전방 이동이 불충분함\\n• 상부식도괄약근의 개방이 짧고 불완전하여 이상동(조롱박오목)에 다량의 잔여물이 남음\\n• 멘델슨기법을 적용하면 잔여물이 감소하나, 언어재활사는 보상이 아닌 근본적 기능 개선을 위한 운동 훈련을 병행하고자 함\",\"q\":\"이 목적에 가장 적합한 운동 훈련과 그 기전은?\",\"choices\":[\"샤커 운동 – 설골상근의 근력과 지구력 강화\",\"마사코 기법 – 혀 기저부와 인두벽 접촉 강화\",\"온도촉각자극법 – 인두 삼킴 반사 유발 촉진\",\"노력삼킴 – 혀 기저부의 후방 이동 강화\",\"턱 당기기 – 기도 입구 좁힘으로 흡인 예방\"],\"answer\":1,\"explain\":\"샤커(Shaker) 운동은 누운 자세에서 어깨를 바닥에 붙인 채 머리만 들어 발끝을 보는 등척성·등장성 운동으로, 설골상근(턱끝목뿔근·턱목뿔근 등)을 강화하여 후두의 전상방 이동을 늘리고 그 결과 상부식도괄약근의 개방을 개선한다는 근거가 확립된 재활 운동이다. 마사코(②)와 노력삼킴(④)은 혀 기저부-인두벽 접촉 문제, 온도촉각자극(③)은 삼킴 반사 지연이 주된 문제일 때 적용한다. 턱 당기기(⑤)는 자세 보상 기법으로 근본적 기능 개선 목적이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"삼킴장애\",\"k\":\"샤커 운동 기전\",\"p\":\"후두 거상 부족과 UES 개방 부전 소견으로 근본적 운동 훈련 선택\",\"n\":\"샤커 운동: 설골상근 강화로 후두 전상방 이동 증가, 상부식도괄약근 개방 개선\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"61세 남자 환자\\n• 우측 외측 연수 경색(발렌베르크 증후군)\\n• 쉰 목소리, 우측 얼굴 감각 저하, 어지럼과 보행 불안정\\n• 삼킴장애로 언어치료 의뢰됨\",\"q\":\"이 환자에게 예상되는 삼킴 소견으로 가장 적절한 것은?\",\"choices\":[\"저작 곤란과 음식덩이 형성 실패가 두드러진다\",\"인두 삼킴 지연, 우측 인두 약화와 이상동 잔여물\",\"혀의 운동 저하로 구강 내 측면 고랑에 잔여물이 남는다\",\"식도 연동 운동 저하로 인한 식도기 정체만 관찰된다\",\"연구개 기능은 정상이나 비강 역류가 반복된다\"],\"answer\":2,\"explain\":\"외측 연수에는 삼킴 중추(고립로핵·의문핵)와 미주신경 관련 구조가 있어 발렌베르크 증후군은 심한 인두기 삼킴장애를 일으키는 대표적인 병변이다. 삼킴 반사의 촉발 지연·부재, 병변 동측 인두·후두 약화, 윤상인두근 이완 실패로 인한 상부식도괄약근 개방 부전과 이상동 잔여물이 전형적이며, 구강기는 상대적으로 보존된다. ①·③은 구강기(피질·하위 뇌신경 V·XII) 문제이며, ④는 인두기 문제 없이 식도기만 문제된다는 점에서, ⑤는 미주신경 손상 시 연구개 약화가 동반된다는 점에서 옳지 않다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"삼킴장애\",\"k\":\"발렌베르크 증후군 삼킴\",\"p\":\"외측 연수 경색 병변으로 예상되는 단계별 삼킴 소견 추론\",\"n\":\"외측 연수 손상: 인두 삼킴 지연, 동측 인두 약화, UES 개방 부전·이상동 잔여물\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"중환자실 환자의 삼킴 평가 의뢰\\n• 인공호흡기 이탈 후 2일째, 기관절개관 유지 중\\n• 혈역학적으로 불안정하여 방사선실로 이동이 어려움\\n• 침상 평가에서 젖은 음성이 관찰되어 삼킴 전 분비물 고임과 후두 감각 확인이 필요함\\n• 향후 여러 차례 반복 평가가 예상됨\",\"q\":\"이 환자에게 비디오투시조영삼킴검사(VFSS)보다 내시경삼킴검사(FEES)를 우선 선택하는 근거로 옳은 것은?\",\"choices\":[\"구강 준비기와 식도기를 직접 관찰할 수 있다\",\"삼킴 순간의 흡인을 실시간으로 직접 볼 수 있다\",\"휴대용 장비로 침상에서 반복 시행할 수 있다\",\"조영제로 음식물 이동 경로를 정량화할 수 있다\",\"후두 거상과 상부식도괄약근 개방을 측정할 수 있다\"],\"answer\":3,\"explain\":\"FEES는 휴대용 장비로 침상·중환자실에서 시행할 수 있고, 방사선 노출이 없어 반복 검사가 가능하며, 삼킴 전 후두·이상동의 분비물 고임과 후두 감각(공기 자극 또는 내시경 접촉 반응)을 직접 평가할 수 있다는 점에서 이 환자에게 적합하다. 반면 FEES는 삼킴 순간 인두 수축으로 화면이 하얗게 가려지는 '백색 소실(white-out)'로 흡인의 순간을 직접 보지 못하고(②), 구강기·식도기 관찰(①), 후두 거상·UES 개방 등 생리 측정(⑤), 조영제 이동의 정량화(④)는 VFSS의 장점이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"삼킴장애\",\"k\":\"FEES 우선 선택 근거\",\"p\":\"이동 불가·반복 평가·분비물 확인 필요 상황으로 기기 검사 선택\",\"n\":\"FEES: 휴대용으로 침상 반복 시행, 방사선 노출 없음, 분비물·후두 감각 평가\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"중등도 실어증 환자와 배우자의 대화 관찰\\n• 환자가 낱말을 찾는 동안 배우자가 대신 대답하고 대화를 이어감\\n• 환자가 오류를 보이면 즉시 교정하고 다시 말해 보게 함\\n• 배우자: \\\"남편이 무슨 말을 하려는지 몰라서 제가 그냥 넘겨요.\\\"\\n• 환자는 대화 참여를 점점 피함\",\"q\":\"성인 실어증을 위한 지원대화(SCA) 원리에 근거한 의사소통 파트너 훈련 목표로 가장 적절한 것은?\",\"choices\":[\"환자의 발화 오류를 정확히 교정해 주는 방법을 익힌다\",\"대화의 혼란을 줄이기 위해 그림이나 몸짓 사용을 삼간다\",\"환자가 글자를 쓰려 할 때 구어로만 말하도록 유도한다\",\"핵심어·그림·몸짓으로 이해와 표현을 돕고 확인한다\",\"배우자가 대화의 주제와 순서를 주도하여 환자의 부담을 줄인다\"],\"answer\":4,\"explain\":\"SCA(Supported Conversation for Adults with Aphasia)는 실어증이 언어의 문제이지 능력의 문제가 아니라는 전제에서 파트너가 '능력 인정하기(acknowledging competence)'와 '능력 드러내기(revealing competence)'를 실천하도록 훈련한다. 능력 드러내기는 핵심어 쓰기·그림·제스처 등 다중 양식으로 정보를 '들어가게(getting the message in)' 하고, 환자가 표현할 수 있도록 선택지·예/아니오 질문 등으로 '나오게(getting the message out)' 도우며, 이해했는지 확인하는 세 요소로 이루어진다. 배우자의 대화 주도(⑤), 즉시 교정(①), 다중 양식 제한(②·③)은 환자의 참여를 위축시킨다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"지원대화(SCA) 파트너 훈련\",\"p\":\"배우자의 대화 주도·즉시 교정으로 위축된 환자에 맞는 훈련 목표 선택\",\"n\":\"SCA: 능력 인정·드러내기, 핵심어·그림·몸짓으로 이해·표현을 돕고 확인\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"치료사: (연필 그림을 보여주며) \\\"이것의 이름을 말해 보세요.\\\"\\n환자 A: \\\"어… 이거… 쓰는 거… 아, 연필!\\\" (에두르기 후 스스로 목표 낱말을 인출하여 정반응)\\n환자 B: \\\"여, 열, 연빌… 연필.\\\" (음소를 바꾸어 여러 차례 접근하다가 정반응)\\n환자 C: \\\"…\\\" (무반응) → 치료사: \\\"글씨를 쓸 때 사용하는…\\\" → 환자 C: \\\"연필.\\\"\\n※ 세 환자 모두 발화는 유창하고 청각적 이해력은 양호함\",\"q\":\"세 환자의 이름대기 오류 특성과 우선 적용할 중재의 연결로 가장 적절한 것은?\",\"choices\":[\"A: 음소 접근 행동 – 음소 단서 위계 / B: 낱말 인출 지연 – 의미 단서 / C: 인출 실패 – 따라말하기\",\"A: 낱말 인출 지연 – 자기 단서 전략 / B: 음소 접근 행동 – 음운 단서 / C: 인출 실패 – 의미자질분석\",\"A: 인출 실패 – 의미자질분석 / B: 낱말 인출 지연 – 에두르기 / C: 음소 접근 행동 – 음운 단서\",\"A: 의미착어 – 의미자질분석 / B: 신조어 – 따라말하기 / C: 반향어 – 문장 완성 단서\",\"A: 낱말 인출 지연 – 멜로디억양치료 / B: 음소 접근 행동 – 제약유발 언어치료 / C: 인출 실패 – 시각동작치료\"],\"answer\":2,\"explain\":\"A는 에두르기(우회 표현) 후 스스로 목표 낱말에 도달하는 인출 지연으로, 이미 효과적인 에두르기 등 자기 단서 전략을 강화하고 인출 속도를 높이는 접근이 적합하다. B는 음소를 조금씩 바꾸며 목표에 접근하는 음소 접근 행동(conduite d'approche)으로 전도실어증에서 흔하며, 음소 수준의 자기 점검과 음운 단서가 효과적이다. C는 자발 인출은 실패하나 의미 단서(기능 설명)에 즉시 반응하므로 의미망을 활성화하는 의미자질분석이 적합하다. ④는 관찰되지 않은 오류 유형(신조어·반향어)을 기술하였고, ⑤의 치료법들(MIT·CILT·VAT)은 이름대기 오류 유형에 맞춘 중재가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"이름대기 오류별 중재\",\"p\":\"에두르기·음소 접근·의미 단서 반응 양상으로 오류 특성과 중재 연결\",\"n\":\"인출 지연은 자기 단서, 음소 접근 행동은 음운 단서, 의미 단서 반응은 의미자질분석\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"25개월 아동의 두 낱말 발화와 산출 맥락\\n㉠ \\\"엄마 신발\\\" – 현관에 놓인 엄마의 구두를 가리키며\\n㉡ \\\"아빠 가\\\" – 아빠가 문을 열고 나가는 것을 보며\\n㉢ \\\"안 먹어\\\" – 숟가락을 밀어내며\\n㉣ \\\"빵 먹어\\\" – 빵을 집어 입에 넣으며\\n㉤ \\\"여기 앉아\\\" – 의자를 두드리며 엄마를 부르며\",\"q\":\"위 발화의 의미관계 분석이 옳은 것은?\",\"choices\":[\"㉠ 행위자–대상\",\"㉡ 소유자–대상\",\"㉢ 행위자–행위\",\"㉣ 대상–행위\",\"㉤ 대상–장소\"],\"answer\":4,\"explain\":\"㉣ '빵 먹어'는 행위의 대상(빵)과 행위(먹어)가 결합한 대상–행위 관계이다. ㉠ '엄마 신발'은 엄마의 신발을 가리키는 소유자–대상(소유), ㉡ '아빠 가'는 행위자–행위, ㉢ '안 먹어'는 부정–행위, ㉤ '여기 앉아'는 장소–행위 관계이다. 의미관계는 발화 형태만이 아니라 산출 맥락(가리키는 대상, 동작)을 근거로 판단해야 한다. ※ 의미관계 범주의 명칭·분류는 교재별로 다를 수 있다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"두 낱말 의미관계 분석\",\"p\":\"발화 형태와 산출 맥락으로 두 낱말 조합의 의미관계 판단\",\"n\":\"의미관계: '빵 먹어'는 대상–행위, 가리킴·동작 등 산출 맥락을 근거로 판단\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"엄마: 어린이집에서 뭐 했어?\\n아동: 친구랑 블록으로 성 만들었어.\\n엄마: 우와, 누구랑 만들었어?\\n아동: 형아랑 같이 만들었어.\\n엄마: 성 다 만들었어?\\n아동: 선생님이 밥 먹으라고 해서 못 만들었어.\\n엄마: 아이고, 그래서?\\n아동: 내일 또 만들 거야.\",\"q\":\"위 대화에서 아동 발화를 분석한 결과로 옳은 것은? (엄마 발화 제외, 체언에 붙은 조사는 한 낱말로 계산)\",\"choices\":[\"아동의 평균낱말길이는 4.0이다.\",\"부사격 조사를 사용하지 않았다.\",\"인용절을 포함한 복문을 산출하였다.\",\"과거시제 선어말어미 오류가 나타났다.\",\"부정 부사를 사용한 발화가 없었다.\"],\"answer\":3,\"explain\":\"'선생님이 밥 먹으라고 해서 못 만들었어'는 인용절(먹으라고)과 연결어미 '-어서'가 결합된 복문이다. ① 체언에 붙은 조사를 따로 한 낱말로 세면 친구/랑/블록/으로/성/만들었어(6), 형아/랑/같이/만들었어(4), 선생님/이/밥/먹으라고/해서/못/만들었어(7), 내일/또/만들/거/야(5, '거야'는 의존명사 '거'와 서술격조사 '이다'로 나누어 2낱말)로 총 22낱말이고, 발화 수 4이므로 MLU-w는 22÷4=5.5이다. 조사를 앞말에 붙여 어절로 세면 평균어절길이(MLU-c) 17÷4=4.25가 되며, MLU-w와 구별해야 한다. ② '친구랑', '블록으로', '형아랑'에 부사격 조사(공동·도구)가 사용되었다. ④ '만들었어'의 과거시제는 정확하다. ⑤ 부정 부사 '못'이 사용되었다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"아동 발화 문법 분석\",\"p\":\"아동 발화의 조사·어미·절 구조를 분석해 문장 유형과 MLU 판단\",\"n\":\"인용절(먹으라고)과 연결어미 '-어서'가 결합된 복문, MLU-w와 MLU-c 구별\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 1학년 아동의 이야기 산출\\n\\\"곰이 꿀을 먹고 싶어서 나무에 올라갔어요. 그런데 벌들이 나와서 곰을 쏘았어요. 곰은 아파서 울었고 토끼가 약을 발라 주었어요. 곰은 다시는 꿀을 훔치지 않겠다고 약속했어요.\\\"\",\"q\":\"위 이야기의 최소종결단위(T-unit) 수와 T-unit당 평균어절수(MLT-c)는? (대등절은 분리하고 종속절·인용절은 주절에 포함하여 계산)\",\"choices\":[\"4개, 6.0\",\"5개, 4.8\",\"4개, 4.8\",\"5개, 6.0\",\"6개, 4.0\"],\"answer\":2,\"explain\":\"첫째 문장(종속절 '-어서'+주절)=1, 둘째 문장=1, 셋째 문장은 대등 연결어미 '-고'로 이어진 두 절이므로 2, 넷째 문장(인용절 내포)=1 → T-unit 5개. 어절 수는 6+5+7+6=24이므로 MLT-c=24÷5=4.8이다. 대등절을 분리하지 않으면 4개(①·③)로 잘못 세게 된다. ※ 대등절 분리 여부 등 T-unit 산정 기준은 교재별로 차이가 있을 수 있다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"T-unit 수·MLT-c 산출\",\"p\":\"대등절 분리·종속절 포함 기준으로 T-unit을 세고 평균어절수 계산\",\"n\":\"T-unit: 대등절 분리·종속절 포함, MLT-c=24어절÷5=4.8\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 2개월 아동의 표준화 언어검사 결과(평균 100, 표준편차 15)\\n• 수용언어: 표준점수 84, 백분위 14, 등가연령 4;4\\n• 표현언어: 표준점수 68, 백분위 2, 등가연령 3;2\\n• 청력·비언어성 지능: 정상 범위\",\"q\":\"위 결과의 해석으로 가장 적절한 것은?\",\"choices\":[\"표현언어는 −2SD 이하로 유의하게 지체되어 우선 중재 목표가 된다.\",\"수용언어 표준점수 84는 −1SD 이상이므로 수용언어에는 문제가 없다.\",\"등가연령 3;2는 아동의 언어 특성이 3세 2개월 아동과 동일하다는 의미이다.\",\"수용·표현 표준점수 차이 16점은 우연 범위이므로 두 영역에 차이가 없다고 본다.\",\"표현언어 백분위 2는 또래 98%보다 높은 수행 수준을 의미한다.\"],\"answer\":1,\"explain\":\"표현언어 표준점수 68은 z=(68−100)÷15≈−2.1로 −2SD 이하의 유의한 지체이며, 수용언어 84는 z≈−1.07로 −1SD 부근의 경계선 수준이다. 따라서 결함이 뚜렷한 표현언어를 우선 목표로 한다. ② 84는 −1SD(85)보다 낮다. ③ 등가연령은 원점수가 해당 연령 평균과 같다는 뜻일 뿐 언어 특성이 동일함을 의미하지 않는다. ④ 16점은 약 1SD 이상의 차이로 무시할 수 없다. ⑤ 백분위 2는 또래의 2%만이 이 아동보다 낮다는 뜻이다. ※ 지체 판정 절단점(−1SD, −1.25SD, −2SD 등)은 검사·기관별로 다를 수 있다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"중재 방법·AAC\",\"k\":\"표준점수·백분위 해석\",\"p\":\"표준점수를 z점수로 환산해 영역별 지체 정도와 우선 목표 판단\",\"n\":\"표준점수 68은 z≈−2.1로 −2SD 이하 유의한 지체, 등가연령은 특성 동일 의미 아님\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"6세 아동의 자발화 일부\\n• \\\"놀이터에 친구랑 놀았어요.\\\"\\n• \\\"인형이 상자 안에서 있어요.\\\"\\n• \\\"동생이 의자에서 앉았어요.\\\"\\n• \\\"내가 우유를 다 먹었어요.\\\"\\n• \\\"아빠가 어제 늦게 왔어요.\\\"\",\"q\":\"위 아동에게 우선적으로 중재가 필요한 문법형태소는?\",\"choices\":[\"부사격 조사 '에/에서'의 구분\",\"주격 조사 '이/가'의 산출\",\"목적격 조사 '을/를'의 산출\",\"과거시제 어미 '-었-'의 산출\",\"종결어미 '-어요'의 산출\"],\"answer\":1,\"explain\":\"'놀이터에 놀았어요'(→놀이터에서), '상자 안에서 있어요'(→상자 안에), '의자에서 앉았어요'(→의자에)처럼 처소를 나타내는 부사격 조사 '에'(도착점·정지 위치)와 '에서'(행위가 일어나는 장소)를 서로 바꾸어 쓰는 오류가 일관되게 나타난다. 주격 조사(동생이, 내가, 아빠가), 목적격 조사(우유를), 과거시제(놀았어요, 앉았어요, 왔어요), 종결어미는 모두 정확하게 산출되었다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"문법·형태\",\"k\":\"부사격 조사 에/에서 오류\",\"p\":\"처소 조사 '에'와 '에서'를 바꿔 쓰는 일관된 오류로 중재 형태소 선택\",\"n\":\"'에'는 도착점·정지 위치, '에서'는 행위 장소, 처소 부사격 조사 구분 중재\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"4세 6개월 발달성 언어장애 아동의 구조화된 문장 완성 과제에서 문법형태소별 정확률\\n• 주격 조사 '이/가': 92%\\n• 목적격 조사 '을/를': 45%\\n• 과거시제 선어말어미 '-었-': 88%\\n• 연결어미 '-어서': 5%\\n• 관형사형 어미 '-ㄴ/은': 0%\",\"q\":\"중재 효율성을 고려할 때 가장 먼저 목표로 설정할 문법형태소는?\",\"choices\":[\"주격 조사 '이/가'\",\"목적격 조사 '을/를'\",\"과거시제 선어말어미 '-었-'\",\"연결어미 '-어서'\",\"관형사형 어미 '-ㄴ/은'\"],\"answer\":2,\"explain\":\"목표 선택의 일반 원칙은 이미 나타나기 시작했으나 아직 불안정한(출현 단계, 대략 10~50% 수준) 형태를 우선하는 것이다. 목적격 조사(45%)는 출현했으나 숙달되지 않아 중재 효과가 가장 빠르게 나타날 수 있다. 주격 조사와 과거시제는 이미 90% 가까이 숙달되어 목표로 부적절하고, '-어서'(5%)와 관형사형 어미(0%)는 아직 거의 출현하지 않은 형태로 이후 단계에서 다룬다. ※ '출현 단계' 판정 기준(10~50%, 30~60% 등)은 교재별로 다를 수 있다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"문법·형태\",\"k\":\"출현 단계 목표 형태소\",\"p\":\"형태소별 정확률로 출현했으나 불안정한 형태를 우선 목표로 선택\",\"n\":\"목표 선택: 출현했으나 불안정한 형태(대략 10~50%) 우선, 목적격 조사 45%\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"7세 자폐스펙트럼장애 아동(표현어휘 약 20개)\\n• 교실에서 쓰기 과제를 제시하면 소리를 지르고 학습지를 던짐\\n• ABC 관찰: 선행사건은 대부분 '어려운 과제 제시', 후속결과는 '교사가 과제를 치우고 아동을 쉬게 함'\\n• 자유놀이 시간에는 문제행동이 거의 나타나지 않음\",\"q\":\"긍정적 행동지원 관점에서 가장 적절한 중재는?\",\"choices\":[\"문제행동이 나타날 때마다 교실 밖 타임아웃을 실시한다.\",\"문제행동을 무시하고 과제를 그대로 계속 제시하여 소거한다.\",\"과제를 끝낼 때마다 좋아하는 간식을 제공하여 과제 수행을 강화한다.\",\"문제행동을 유발하는 쓰기 과제를 교육과정에서 완전히 제외한다.\",\"휴식을 요구하는 카드 사용을 가르치고 과제 난이도를 조정한다.\"],\"answer\":5,\"explain\":\"기능평가 결과 문제행동의 기능은 어려운 과제로부터의 회피(도피)이다. 긍정적 행동지원에서는 같은 기능을 하는 적절한 의사소통 행동('쉬고 싶어요/도와주세요' 카드 등으로 휴식·도움 요구)을 가르치고, 카드를 사용하면 즉시 휴식이나 도움을 제공해 대체하는 기능적 의사소통 훈련과, 선행사건(과제 난이도) 조정을 함께 실시한다. ① 타임아웃은 과제 회피를 오히려 강화한다. ② 대체행동 없는 소거만으로는 문제행동이 일시 증가(소거 폭발)할 수 있고 의사소통 수단을 주지 못한다. ③ 간식 강화는 회피 기능과 무관하다. ④ 과제 제거는 학습 기회를 박탈하고 기능을 다루지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"회피 기능 문제행동 중재\",\"p\":\"ABC 관찰의 선행사건·후속결과로 행동 기능 파악 후 대체행동 선택\",\"n\":\"기능적 의사소통 훈련: 회피 기능에 휴식 요구 카드 지도, 과제 난이도 조정 병행\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"4세 발달성 언어장애 아동에게 '햄버거 가게 놀이' 스크립트(주문하기 → 돈 내기 → 햄버거 받기 → 먹기)를 4회기에 걸쳐 익히도록 하였다. 5회기에 치료사(점원)는 돈을 받은 뒤 햄버거를 넣지 않은 빈 쟁반을 아동에게 건넸다. 아동은 \\\"햄버거 없어요. 햄버거 주세요.\\\"라고 말하였다.\",\"q\":\"5회기에 치료사가 사용한 절차와 그 목적으로 옳은 것은?\",\"choices\":[\"스크립트 위반 – 익숙한 사건 순서를 어겨 자발적 요구를 유도한다.\",\"시간지연 – 아동의 발화 뒤에 반응을 지연시켜 발화 길이를 늘린다.\",\"우발교수 – 아동이 먼저 시작한 주제를 따라가며 정교화된 발화를 요구한다.\",\"역할 교대 – 아동이 점원 역할을 맡게 하여 스크립트 어휘를 일반화한다.\",\"스크립트 소거 – 스크립트 단서를 점차 줄여 자연스러운 대화로 전환한다.\"],\"answer\":1,\"explain\":\"스크립트 중재에서 아동이 사건 순서를 충분히 익힌 뒤 예상되는 단계를 빠뜨리거나 잘못 수행하는 '스크립트 위반(사건 방해)'을 도입하면, 아동은 익숙한 맥락 지식을 바탕으로 문제를 지적하고 요구하는 발화를 자발적으로 산출하게 된다. ②는 발화 유도 시 반응을 기다리는 환경중심 기법이고, ③은 아동이 시작한 상호작용에 성인이 반응하는 절차이며, ④·⑤는 스크립트 중재의 다른 단계로 이 장면의 절차가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"스크립트 위반 절차\",\"p\":\"익힌 스크립트에서 빈 쟁반을 건넨 장면으로 절차와 목적 식별\",\"n\":\"스크립트 위반: 익숙한 사건 순서를 어겨 자발적인 지적·요구 발화 유도\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"3세 다운증후군 아동\\n• 표현어휘 5개, 언어 이해는 표현보다 상대적으로 양호\\n• 요구는 주로 손잡아 끌기와 소리 내기로 표현\\n• 치료사가 그림상징 의사소통판 도입을 제안하자 어머니가 \\\"그림으로 말하면 아이가 말을 아예 안 배울까 봐 걱정돼요.\\\"라고 함\",\"q\":\"어머니에게 제공할 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"\\\"구어가 나올 때까지 기다렸다가 그래도 안 되면 그때 그림판을 시작하겠습니다.\\\"\",\"\\\"AAC는 구어 발달을 방해하지 않으며, 구어 자극과 함께 병행해서 사용합니다.\\\"\",\"\\\"그림판을 시작하면 구어 중재는 중단하고 상징 사용에만 집중하게 됩니다.\\\"\",\"\\\"AAC는 구어가 전혀 불가능한 아동에게만 적용하므로 이 아동에게는 아직 이릅니다.\\\"\",\"\\\"지적장애 아동은 상징을 이해하기 어려우므로 AAC보다 구어 모방 훈련이 우선입니다.\\\"\"],\"answer\":2,\"explain\":\"AAC가 구어 발달을 저해한다는 것은 대표적인 오해이며, 연구들은 AAC 사용이 구어 산출을 감소시키지 않고 오히려 증가시키는 경향을 보고한다. AAC는 구어 자극과 병행(다중양식)하며, 의사소통 의도가 있으나 표현 수단이 부족한 아동에게 조기에 도입해 좌절과 문제행동을 줄이고 언어 발달을 지원한다. ①·④는 도입 시기를 부당하게 늦추고, ③은 구어 중재 중단이 옳지 않으며, ⑤는 지적장애 아동도 실물·사진 등 투명도 높은 상징부터 단계적으로 사용할 수 있으므로 틀렸다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"AAC 도입 부모 상담\",\"p\":\"그림판이 말 발달을 막을까 걱정하는 어머니에게 AAC 오해 설명\",\"n\":\"AAC는 구어 발달을 방해하지 않음, 구어 자극과 병행하며 조기 도입\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 인공와우 착용 아동(착용 2년, 인공와우 착용 역치 25dB HL)\\n• 수용·표현 어휘: 또래 범위\\n• 자발화: \\\"엄마 회사 가\\\", \\\"어제 놀이터 놀아\\\", \\\"형 과자 먹어\\\"처럼 조사와 과거시제 선어말어미가 대부분 생략됨\\n• 내용어는 비교적 정확하게 산출함\",\"q\":\"이 아동의 문법형태소 습득을 촉진하기 위한 중재 전략으로 가장 적절한 것은?\",\"choices\":[\"의미 이해가 우선이므로 어휘 확장 활동에 집중한다.\",\"입 모양을 크게 보여 주는 독화 훈련으로 형태소를 지도한다.\",\"조음 정확도 훈련을 통해 어미 산출을 유도한다.\",\"청각적 강조 기법으로 조사·어미를 두드러지게 들려준다.\",\"구어 대신 수어를 도입하여 문법 표지를 시각적으로 제시한다.\"],\"answer\":4,\"explain\":\"조사와 선어말어미는 짧고 강세가 약해 음향적으로 두드러지지 않는 요소로, 청각장애 아동이 놓치기 쉽다. 청각적 강조(acoustic highlighting)는 목표 형태소를 약간 크고 느리게, 문장 끝이나 앞에 두어 두드러지게 들려준 뒤 점차 자연스러운 강도로 되돌리는 청각구어 기법이다. 착용 역치가 어음역을 충분히 포함하고 어휘가 또래 수준이므로 ①은 초점이 어긋나고, ②·⑤는 청각 활용을 우선하는 아동에게 시각 양식을 앞세우는 것이며, ③은 조음이 아닌 형태소 사용의 문제이므로 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"인공와우 아동 청각적 강조\",\"p\":\"내용어는 정확하나 조사·어미가 생략되는 양상으로 형태소 촉진 전략 선택\",\"n\":\"청각적 강조: 목표 형태소를 크고 느리게 두드러지게 들려준 뒤 점차 자연스럽게\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 1학년 양측 중등도 감각신경성 난청 아동(보청기 착용)\\n• 조용한 방에서 어음 인지 정확도 90%\\n• 소음 상황(신호대잡음비 +5dB) 어음 인지 정확도 40%\\n• 담임교사 보고: 수업 중 지시를 자주 놓치고 되묻는 일이 많음\\n• 어휘·구문은 또래 범위\",\"q\":\"이 아동에게 가장 우선적으로 권고할 조치는?\",\"choices\":[\"교사가 원격 마이크 송신기를 착용하여 수업한다.\",\"수어를 병행하는 이중양식 의사소통으로 전환한다.\",\"보청기 대신 인공와우 이식 수술을 의뢰한다.\",\"개별 언어치료 회기를 주 1회에서 주 3회로 늘린다.\",\"소음 속 듣기 훈련 전까지 통합학급 수업을 보류한다.\"],\"answer\":1,\"explain\":\"조용한 곳에서는 양호하지만 소음에서 어음 인지가 급격히 떨어지는 양상은 교실 소음·거리·반향의 영향을 시사한다. 원격 마이크 시스템은 교사의 음성을 아동 보청기로 직접 전달해 신호대잡음비를 개선하는 가장 직접적인 교육적 지원이다. ② 어휘·구문이 또래 수준이고 청각 활용이 양호하므로 수어 전환의 근거가 없다. ③ 중등도 난청은 보청기 적용 대상이며 인공와우 적응증이 아니다. ④ 언어 능력은 정상 범위이므로 치료 빈도 증가가 핵심 해결책이 아니다. ⑤ 수업 배제는 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"난청 아동 원격 마이크\",\"p\":\"조용한 곳 대비 소음 속 어음 인지 급락으로 우선 교육적 지원 선택\",\"n\":\"원격 마이크 시스템: 교사 음성을 보청기로 직접 전달해 신호대잡음비 개선\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"17세 중등도 지적장애 학생(특수학급)\\n• 언어 능력은 대략 5세 수준, 2~3어절 단문으로 의사소통\\n• 졸업 후 지역 보호작업장 취업 예정\\n• 낯선 사람에게 도움을 요청하지 못하고, 작업 지시를 이해하지 못해도 아는 척하고 넘어감\",\"q\":\"이 학생의 언어 중재 목표로 가장 적절한 것은?\",\"choices\":[\"언어연령에 맞는 그림책으로 어휘를 확장한다.\",\"복문 산출과 문법형태소 정확도를 높인다.\",\"도움 요청과 지시 확인하기를 작업 현장에서 교수한다.\",\"음운인식과 낱말 해독 훈련으로 읽기를 지도한다.\",\"표준화 언어검사를 반복하여 언어연령 향상을 확인한다.\"],\"answer\":3,\"explain\":\"전환기 지적장애 청소년의 중재는 생활연령과 미래 환경(직장·지역사회)의 요구에 맞춘 기능적 의사소통에 초점을 두며, 일반화를 위해 실제 또는 유사 환경에서 교수한다. 특히 '모르면 다시 묻기', '도움 요청하기'는 안전과 직무 수행에 직결되는 기술이다. ①·②·④는 언어연령 중심의 발달적 목표로 생활연령·환경 요구와 맞지 않고, ⑤는 평가일 뿐 중재 목표가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"전환기 지적장애 기능적 목표\",\"p\":\"생활연령과 졸업 후 작업장 요구로 기능적 의사소통 목표 선택\",\"n\":\"전환기 중재: 생활연령·미래 환경 요구 중심, 도움 요청·지시 확인을 실제 환경에서 교수\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"3세 6개월 아동\\n• 출생 시부터 어머니는 한국어, 아버지는 영어로 대화(동시적 이중언어)\\n• 한국어 표현어휘 검사: 12%ile / 영어 표현어휘 검사: 15%ile\\n• 두 언어 어휘를 합산하고 번역 등가어(같은 뜻의 두 낱말)는 하나로 세는 개념적 어휘 점수: 또래 단일언어 아동 평균 범위\\n• 두 언어의 이해 모두 양호, \\\"엄마, water 줘\\\"와 같은 혼용 발화가 자주 나타남\",\"q\":\"이 결과에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"한국어 어휘가 12%ile이므로 표현어휘 지체로 진단하고 어휘 중재를 시작한다.\",\"혼용 발화는 언어 혼란의 징후이므로 가정에서 한 언어만 사용하도록 권고한다.\",\"동시적 이중언어 아동이므로 단일언어 규준을 그대로 적용해 각 언어를 판정한다.\",\"개념적 어휘와 이해가 정상 범위이므로 전형적인 이중언어 발달로 본다.\",\"두 언어 모두 20%ile 미만이므로 두 언어에서 동시에 지체된 발달성 언어장애이다.\"],\"answer\":4,\"explain\":\"이중언어 아동은 어휘가 두 언어에 분산되므로 한 언어만 단일언어 규준과 비교하면 지체로 오판되기 쉽다. 번역 등가어를 하나로 세는 개념적 채점에서 정상 범위이고 이해력이 양호하면 전형적인 이중언어 발달로 본다. 코드 혼용(부호 혼용)은 이중언어 아동의 정상적이고 규칙적인 현상이며(②), 언어장애라면 두 언어 모두에서 개념적 어휘를 포함한 전반적 결함이 나타난다(⑤). ①·③은 단일언어 규준을 한 언어에만 적용하는 오류이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"이중언어 개념적 어휘 해석\",\"p\":\"언어별 백분위는 낮으나 개념적 어휘·이해가 정상인 점으로 발달 양상 판단\",\"n\":\"개념적 채점: 번역 등가어를 하나로 계산, 정상 범위면 전형적 이중언어 발달\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 2학년 2학기 아동의 읽기 평가 결과\\n• 자소–음소 대응 지식: 95% / 규칙 낱말 읽기 정확도: 92% / 비단어 읽기 정확도: 85%\\n• 1분당 정확하게 읽은 어절 수: 학년 규준 −2SD\\n• 글 읽기 이해: 학년 규준 −1.5SD / 듣기 이해: 정상 범위\\n• 관찰: 한 글자씩 끊어 읽으며 음운변동 낱말(예: '국물', '읽고')에서 머뭇거림\",\"q\":\"이 아동에게 가장 우선적으로 실시할 읽기 중재는?\",\"choices\":[\"음절·음소 수준의 음운인식 훈련\",\"총체적 언어 접근의 이야기책 통독\",\"반복 읽기 중심의 읽기 유창성 중재\",\"읽기이해 전략(예측·요약) 교수\",\"자소–음소 대응의 체계적 재교수\"],\"answer\":3,\"explain\":\"해독 정확도는 확립되었으나(규칙 낱말 92%, 비단어 85%) 읽기 속도가 −2SD로 현저히 느리고 한 글자씩 읽는 양상은 해독의 자동화(유창성) 부족이며, 듣기 이해가 정상인 점으로 보아 읽기 이해 저하는 느린 해독의 결과이다. 따라서 반복 읽기·짝 읽기와 음운변동 낱말 자동화로 유창성을 높이는 것이 우선이다. ①·⑤는 이미 확립된 기초 기술의 중복 훈련이고, ②는 해독 결함 아동에게 근거가 약하며, ④는 유창성이 확보된 뒤 병행할 목표이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"읽기·쓰기\",\"k\":\"읽기 유창성 중재 선택\",\"p\":\"해독 정확도는 양호하나 읽기 속도 −2SD인 양상으로 우선 중재 선택\",\"n\":\"해독 자동화 부족: 반복 읽기로 유창성 향상, 읽기 이해 저하는 느린 해독의 결과\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 5학년 아동\\n• 문장 수준 쓰기: 문법·철자 오류 거의 없음, 어휘 또래 범위\\n• '우리 학교 소개하기' 글쓰기: 계획 없이 바로 쓰기 시작하여 떠오르는 문장을 나열, 문단 구분·주제문 없음, 다 쓴 뒤 다시 읽지 않음\\n• 읽기 이해: 정상 범위\",\"q\":\"이 아동에게 가장 적절한 쓰기 중재는?\",\"choices\":[\"받아쓰기 훈련을 통해 문장 정확도를 높인다.\",\"철자 규칙을 지도하여 맞춤법 오류를 줄인다.\",\"두 문장을 하나로 합치는 문장 결합 훈련을 실시한다.\",\"학습 어휘를 확장하여 다양한 낱말을 사용하게 한다.\",\"그래픽 조직자로 글의 계획·수정 전략을 지도한다.\"],\"answer\":5,\"explain\":\"문장 수준의 형식(문법·철자·어휘)은 양호하나 글 수준의 계획·조직·점검이 부재한 아동이므로, 쓰기 과정(계획–작성–수정) 전략과 그래픽 조직자(생각 그물, 개요표)를 활용한 담화 구조 지도가 적절하다. ①~④는 이미 또래 수준인 낱말·문장 단위의 기술을 반복하는 것으로 아동의 핵심 결함(텍스트 조직·자기 점검)을 다루지 못한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"읽기·쓰기\",\"k\":\"쓰기 계획·수정 전략\",\"p\":\"문장 수준은 양호하나 글 조직·점검이 없는 양상으로 쓰기 중재 선택\",\"n\":\"쓰기 과정(계획–작성–수정) 전략과 그래픽 조직자로 글 수준의 조직 지도\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 4학년 아동\\n• 어휘·구문·읽기 해독·읽기 유창성: 또래 범위\\n• 글에 직접 나온 사실을 묻는 질문(누가, 어디서, 무엇을)에는 대부분 정확히 답함\\n• \\\"민수는 펼친 우산을 현관에 세워 두고 젖은 양말부터 벗었다.\\\"를 읽은 뒤 \\\"밖의 날씨는 어땠을까?\\\"라는 질문에 \\\"글에 안 나와 있어요.\\\"라고 답함\\n• 사건의 원인이나 이어질 결과를 묻는 질문에서 오답이 많음\",\"q\":\"이 아동에게 가장 적절한 중재 활동은?\",\"choices\":[\"글 속 단서와 배경지식을 연결해 숨은 내용을 추론하고 근거를 말하게 한다.\",\"글을 읽은 뒤 누가·언제·어디서를 묻는 사실 확인 질문에 답하는 연습을 반복한다.\",\"같은 글을 소리 내어 여러 번 반복해 읽게 하여 읽기 속도를 높인다.\",\"글에 나온 낱말의 사전적 정의를 찾아 쓰게 하여 어휘 지식을 늘린다.\",\"이야기를 들은 순서대로 다시 말하게 하여 사건 순서 기억을 강화한다.\"],\"answer\":1,\"explain\":\"글에 명시된 사실의 이해는 양호하나, 글 속 단서(펼친 우산, 젖은 양말)와 배경지식을 연결해야 알 수 있는 내용(비가 왔다)이나 사건의 원인·결과를 파악하지 못하는 것은 추론적 이해의 결함이다. 효과적인 중재는 글에서 단서를 찾아 표시하고, 관련 배경지식을 떠올려 연결한 뒤, 추론한 내용과 그 근거를 말로 설명하게 하는 것이다(예: 질문-대답 관계 전략의 '생각하고 찾기' 질문, 소리 내어 생각하기 시범). ② 사실적 이해는 이미 양호하고, ③ 해독·유창성과 ④ 어휘는 또래 범위이므로 초점이 어긋난다. ⑤ 순서대로 다시 말하기는 글에 나온 내용의 회상에 머물러 추론 결함을 직접 다루지 못한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"읽기·쓰기\",\"k\":\"추론적 읽기 이해 중재\",\"p\":\"사실 질문은 맞히나 숨은 내용·인과 질문에 실패하는 양상으로 중재 선택\",\"n\":\"추론적 이해: 글 속 단서와 배경지식을 연결해 추론하고 그 근거를 말하기\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"26개월 아동\\n• 표현어휘 8개, 언어 이해도 또래보다 지체\\n• 놀이 관찰: 블록을 두드리거나 던지고, 자동차 바퀴를 돌리며 봄. 컵을 입에 대는 척하기, 인형에게 밥 먹이기 등은 관찰되지 않음\\n• 성인의 동작 모방은 가끔 나타남\",\"q\":\"이 아동의 놀이 수준을 고려한 중재 방향으로 가장 적절한 것은?\",\"choices\":[\"상징놀이가 가능한 수준이므로 역할놀이 대본을 이용해 대화를 지도한다.\",\"사물의 기능적 놀이를 모델링하고 그 행동에 낱말을 짝지어 준다.\",\"놀이는 언어와 무관하므로 낱말 따라 말하기 훈련에 집중한다.\",\"규칙이 있는 보드게임을 통해 차례 지키기를 지도한다.\",\"또래와의 협동 놀이를 우선 목표로 하여 집단 활동에 참여시킨다.\"],\"answer\":2,\"explain\":\"두드리기·던지기·바퀴 돌리기는 감각운동적 탐색 놀이로, 26개월에 기대되는 초기 상징놀이(자기 중심 가상행동)가 나타나지 않는다. 상징놀이는 표상 능력을 반영하여 초기 낱말 발달과 밀접히 관련되므로, 사물의 기능적 사용과 자기 중심 가상놀이를 모델링하고 그 행동에 언어를 연결하는 것이 적절하다. ①·④·⑤는 아동의 현재 놀이 수준을 크게 넘어서는 목표이고, ③은 놀이(표상)와 언어의 관계를 무시한 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"놀이 수준 기반 중재\",\"p\":\"감각운동적 탐색 놀이만 보이고 가상놀이가 없는 수준으로 중재 방향 선택\",\"n\":\"상징놀이는 초기 낱말 발달과 관련, 기능적 놀이·가상놀이 모델링에 낱말 연결\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"30개월 아동의 20분 자유놀이 표본에서 관찰된 의사소통 행위\\n• 총 100회(몸짓·발성·낱말 포함)\\n• 기능별 빈도: 물건 요구 60회, 행동 요구 25회, 거부 12회, 언급(사물 보여주기·가리키며 이름 말하기) 3회, 정보 요구 0회\",\"q\":\"이 결과의 해석과 우선 중재 목표로 가장 적절한 것은?\",\"choices\":[\"의사소통 빈도가 매우 낮으므로 전체 빈도 증가를 우선 목표로 한다.\",\"요구하기가 가장 많으므로 요구 발화를 3어절로 늘린다.\",\"거부하기 빈도가 낮으므로 거부 표현을 우선 지도한다.\",\"정보 요구가 없으므로 의문사 질문하기를 우선 목표로 한다.\",\"기능이 요구에 편중되어 있으므로 언급 기능 확대를 우선한다.\"],\"answer\":5,\"explain\":\"분당 5회의 의사소통 빈도는 이 연령대 기대 수준(여러 낱말 단계 약 분당 5회)으로 부족하지 않으나, 100회 중 85회(85%)가 행동 조절(요구) 기능이고 사회적 상호작용·공동주의 기능(언급·보여주기)이 거의 없어 기능 분포가 편중되어 있다. 언급하기와 공동주의는 어휘·사회적 의사소통 발달의 토대이므로 우선 목표가 된다. ① 빈도는 낮지 않다. ②는 이미 우세한 기능의 정교화, ③은 이미 나타나는 기능이며, ④ 의문사 질문은 언급·공동주의 기능이 확립된 이후에 기대되는 발달 순서상 뒤의 목표이다. ※ 연령별 의사소통 빈도 기준치는 자료마다 차이가 있다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"의사소통 기능 편중 분석\",\"p\":\"의사소통 행위의 빈도와 기능별 분포로 해석과 우선 목표 판단\",\"n\":\"요구 기능 85% 편중, 언급·공동주의 기능 확대가 어휘·사회적 의사소통의 토대\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 2학년 자폐스펙트럼장애 아동\\n• 언어성 지능 정상, 어휘·구문 또래 범위\\n• 친구가 넘어진 뒤 \\\"아, 진짜 좋다.\\\"라고 말하자 정말 좋아하는 줄 알고 웃음\\n• 틀린 믿음 과제(위치 바꾸기)에서 \\\"원래 있던 데를 찾는다\\\"고 답하지 못하고 실제 위치를 말함\\n• 이야기 속 인물이 왜 화가 났는지 설명하지 못함\",\"q\":\"이 아동에게 가장 적절한 중재는?\",\"choices\":[\"복문 산출 훈련으로 구문 복잡성을 높인다.\",\"비디오 자기모델링으로 인사하기 행동을 습득시킨다.\",\"생각 풍선으로 인물의 생각과 감정을 추론하게 한다.\",\"음운인식 훈련으로 읽기 기초를 다진다.\",\"감정 어휘 목록을 정의와 함께 암기하도록 한다.\"],\"answer\":3,\"explain\":\"틀린 믿음 과제 실패, 반어 이해 실패, 인물의 정서 원인 추론 실패는 타인의 마음 상태를 표상하는 마음이론 결함을 반영한다. 생각 풍선, 만화 대화 등 시각적 지원을 활용해 인물의 생각·믿음·감정과 화자의 의도를 명시적으로 추론하게 하는 중재가 적절하다. ①·④는 이미 양호한 영역이고, ②는 특정 행동 습득에 유용하나 마음 상태 추론을 다루지 못하며, ⑤ 감정 어휘 암기만으로는 맥락에서 상대의 마음을 추론하는 능력이 길러지지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"화용·대화\",\"k\":\"마음이론 결함 중재\",\"p\":\"틀린 믿음 과제·반어 이해·정서 원인 추론 실패로 중재 선택\",\"n\":\"마음이론 결함: 생각 풍선 등 시각적 지원으로 인물의 생각·감정·의도 추론\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"18개월 아동의 발달 선별 결과\\n• 표현 낱말 0개, 옹알이는 있으나 자음 종류가 적음\\n• 원하는 것을 가리키지 않고 관심 있는 것을 보여 주지 않음\\n• 이름을 불러도 반응이 드물고 눈맞춤이 짧음\\n• 신생아 청력 선별 통과, 최근 청력 재검사도 정상\\n• 운동 발달은 정상\",\"q\":\"이 아동에 대한 조치로 가장 적절한 것은?\",\"choices\":[\"늦게 말하는 아동으로 보고 6개월 후 재평가까지 추적 관찰만 한다.\",\"24개월까지는 개인차가 크므로 그때 다시 검사하도록 안내한다.\",\"낱말 모방을 목표로 한 개별시도 훈련을 즉시 시작한다.\",\"청력이 정상이므로 언어 문제가 아니라고 안심시킨다.\",\"자폐 선별검사를 의뢰하고 부모 매개 중재를 바로 시작한다.\"],\"answer\":5,\"explain\":\"18개월에 가리키기·보여주기 부재, 이름 반응 저하, 눈맞춤 부족은 낱말 지체와 함께 나타날 때 자폐스펙트럼장애의 조기 위험 신호(red flags)이므로 선별검사와 종합 평가를 지체 없이 의뢰해야 한다. 진단 확정을 기다리지 않고 공동주의·사회적 상호작용을 표적으로 하는 부모 매개 조기 중재를 병행하는 것이 권장된다. ①·②는 사회적 의사소통 위험 신호를 간과한 것이고, ③은 전제 기술(공동주의·모방)이 없는 상태에서 낱말 모방을 앞세우는 것이며, ④ 청력 정상은 원인 하나를 배제할 뿐 문제가 없음을 의미하지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"자폐 조기 위험 신호 조치\",\"p\":\"가리키기·보여주기 부재와 이름 반응 저하로 선별 의뢰와 조기 중재 판단\",\"n\":\"자폐 조기 위험 신호: 선별검사 의뢰와 함께 진단 전 부모 매개 조기 중재 병행\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"언어 중재의 행동 목표로 가장 적절하게 진술된 것은?\",\"choices\":[\"아동은 간식 시간에 요구하기를 잘하게 된다.\",\"간식 시간에 아동은 2어절 요구를 80% 이상 산출한다.\",\"아동의 어휘력과 의사소통 능력을 향상시킨다.\",\"치료사는 아동이 요구할 때마다 원하는 간식을 제공한다.\",\"아동은 두 낱말로 요구하는 것이 필요함을 이해한다.\"],\"answer\":2,\"explain\":\"행동 목표는 조건(어떤 상황·자극에서), 관찰 가능한 행동(무엇을 산출하는가), 준거(어느 수준까지)의 세 요소를 구체적으로 포함해야 측정과 진전 평가가 가능하다. ②는 조건(간식 시간), 행동(2어절 요구 산출), 준거(80% 이상)를 모두 갖추었다. ①·③은 관찰·측정할 수 없는 모호한 진술이고(①은 상황이 제시되었으나 행동과 준거가 불명확하다), ④는 아동이 아닌 치료사의 행동이며, ⑤는 '이해한다'가 직접 관찰 가능한 행동이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"행동 목표 진술 요건\",\"p\":\"조건·관찰 가능한 행동·준거 포함 여부로 적절한 목표 진술 판단\",\"n\":\"행동 목표: 조건·관찰 가능한 행동·준거의 세 요소를 구체적으로 포함\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 4학년 언어학습장애 아동의 담임교사가 사회 교과 '옛날과 오늘날의 생활 도구' 단원 지문을 보내며, 제한된 회기 안에 어떤 낱말을 가르쳐야 할지 문의하였다. 지문에는 다음 낱말들이 포함되어 있다.\\n밥, 집, 사람 / 변화, 영향, 비교하다, 발달하다, 원인 / 맷돌, 다듬잇돌, 절구\",\"q\":\"교과 학습 전반에 대한 효과를 고려할 때 우선적으로 지도할 어휘군과 그 근거로 옳은 것은?\",\"choices\":[\"밥·집·사람 – 고빈도 기본 어휘이므로 정확한 이해가 최우선이다.\",\"맷돌·다듬잇돌·절구 – 단원 내용 이해에 직접 필요한 전문 어휘이다.\",\"변화·영향·비교하다·발달하다·원인 – 교과 공통 학습 어휘이다.\",\"아동이 이미 아는 낱말 – 반복 노출로 인출 자동화를 높인다.\",\"지문 속 관용어와 속담 – 비유언어 이해가 학습의 핵심이다.\"],\"answer\":3,\"explain\":\"어휘 선정의 3층위 틀에서 '변화, 영향, 비교하다, 원인' 같은 2층위(Tier 2) 어휘는 일상 대화보다 학습 상황에서 여러 교과와 텍스트에 걸쳐 반복 등장하므로 제한된 회기에 가르칠 때 학업 전반에 대한 전이 효과가 가장 크다. 1층위(밥·집·사람)는 대부분 이미 습득된 기본 어휘이고, 3층위(맷돌·절구)는 특정 단원에만 국한된 저빈도 전문 어휘로 교과 수업에서 다루는 것이 효율적이다. ④는 새로운 학습이 없고, ⑤는 지문에 제시된 낱말군이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"어휘·의미\",\"k\":\"2층위 학습 어휘 선정\",\"p\":\"교과 지문 낱말을 3층위로 나눠 학업 전이가 큰 어휘군 선택\",\"n\":\"2층위 어휘: 여러 교과·텍스트에 반복 등장하는 학습 어휘, 학업 전반 전이 효과\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 여아, 유치원 교사가 '언어장애 의심'으로 의뢰\\n• 유치원 입학 후 8개월째 교사·또래에게 말을 전혀 하지 않고 고개 끄덕임으로만 반응\\n• 어머니가 제공한 가정 녹음: 복문 산출, 어휘·발음 연령 적절, 동생과 활발히 대화\\n• 치료실 첫 방문 시 표준화 표현언어 검사에서 무반응으로 원점수 0\\n• 낯선 사람 앞에서 몸이 굳고, 상동행동·제한된 관심사는 없음\",\"q\":\"이 아동에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"검사 결과 원점수 0이므로 −2SD 이하의 심한 표현언어 지체로 진단한다.\",\"발달성 언어장애로 판단하고 표현언어 중재를 시작한다.\",\"유치원에서 말할 때까지 발화를 강하게 요구하는 훈련을 실시한다.\",\"선택적 함구증을 의심하여 전문가와 협력하고 점진적 노출을 계획한다.\",\"눈맞춤 회피와 무발화를 근거로 자폐스펙트럼장애 평가를 우선 의뢰한다.\"],\"answer\":4,\"explain\":\"특정 사회적 상황(유치원)에서만 지속적으로 말하지 않고 다른 상황(가정)에서는 연령 적절한 언어를 사용하는 양상은 언어 능력의 결함이 아니라 불안 관련 장애인 선택적 함구증의 특징이다. 이 경우 정신건강 전문가와 협력하여 자극 용암법, 점진적 노출 등 불안을 낮추는 행동적 접근을 적용하고 언어재활사는 말하기를 강요하지 않는다. ①·②는 가정 자료와 모순되는 검사 결과를 그대로 해석한 오류이며, ③ 압박은 불안을 높여 증상을 악화시키고, ⑤는 상동행동·제한된 관심사가 없고 가정에서 상호작용이 활발하므로 근거가 부족하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"선택적 함구증 판단·조치\",\"p\":\"유치원에서만 말하지 않고 가정에서는 연령 적절한 언어로 판단과 조치 선택\",\"n\":\"선택적 함구증: 불안 관련 장애, 전문가 협력과 점진적 노출, 말하기 강요 금지\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 3학년 아동의 그림책 이야기 다시 말하기 평가 결과이다. 어휘·구문·읽기 해독은 또래 범위이며, 아동은 이야기할 때 \\\"그 사람이 그거를 했어요. 그리고 갔어요.\\\"처럼 말해 듣는 사람이 누구·무엇을 가리키는지 되묻는 일이 잦다.\\n\\n〈이야기 다시 말하기 평가 기록〉\\n평가 영역 | 아동 점수 | 또래 평균(표준편차)\\n이야기 문법 요소 회상률 | 78% | 74%(13)\\n완전한 일화 수 | 3개 | 2.9개(1.0)\\n결속표지 정확률 | 52% | 88%(15)\\n지시 대용어 적절 사용률 | 48% | 82%(16)\\nT-unit당 비유창성률 | 4% | 4%(2)\\n문법형태소 오류율 | 1.2% | 1.6%(2.0)\",\"q\":\"위 결과에 근거한 중재 방향으로 가장 적절한 것은?\",\"choices\":[\"계기사건–시도–결과를 갖춘 완전한 일화 구성을 지도한다.\",\"조사·어미의 정확한 산출에 초점을 둔 문법형태소 중재를 실시한다.\",\"이야기 산출 시 반복·수정 등 비유창성을 줄이는 중재를 실시한다.\",\"문장을 잇는 접속 표현과 지시어를 명확히 쓰도록 지도한다.\",\"T-unit 길이를 늘리기 위해 문장 확장 훈련을 실시한다.\"],\"answer\":4,\"explain\":\"각 영역의 z점수를 구하면 이야기 문법 요소 회상률 (78−74)÷13 ≈ +0.3, 완전한 일화 수 (3−2.9)÷1.0 = +0.1, 결속표지 정확률 (52−88)÷15 = −2.4, 지시 대용어 적절 사용률 (48−82)÷16 ≈ −2.1, 비유창성률 (4−4)÷2 = 0.0, 문법형태소 오류율 (1.2−1.6)÷2.0 = −0.2(오류율은 평균보다 낮을수록 양호)이다. 결속표지 정확률과 지시 대용어 적절 사용률만 −2SD 미만이고 나머지는 평균 범위이다. 즉 이야기의 거시구조(사건 구성)는 갖추었으나 문장·명제를 이어 주고 지시 대상을 명확히 하는 미시구조(결속)가 약하므로, 접속·연결 표지와 대용어의 적절한 사용을 목표로 하는 결속표지 중재가 우선이다. \\\"그 사람이 그거를\\\"처럼 지시 대상이 불분명한 발화도 이를 뒷받침한다. ①·②·③은 표에서 평균 범위인 영역을 목표로 한 것이고, ⑤ T-unit 길이는 표에 제시되지 않았으며 구문이 또래 범위이므로 우선 목표가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"이야기·담화\",\"k\":\"결속표지 중재 방향\",\"p\":\"영역별 z점수로 −2SD 미만인 결속·지시 대용어 결함을 찾아 중재 선택\",\"n\":\"미시구조(결속) 결함: 접속·연결 표지와 대용어의 적절한 사용을 목표로 중재\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"치료사: 주말에 뭐 했어요?\\n대상자: 저는 저는 음 (쉼) 가족이랑 ㅂㅂㅂ백화점에 갔어요. 거기서 거기서 시---계를 샀어요. (막힘)기분이 좋았어요.\\n\\na. 저는 저는   b. 음 (쉼)   c. ㅂㅂㅂ백화점   d. 거기서 거기서   e. 시---계   f. (막힘)기분\",\"q\":\"EXPLAN 모델에서 계획이 완성되기 전에 낱말 산출을 시작하는 '진행(advancing)' 유형으로 설명되는 비유창성만 묶인 것은?\",\"choices\":[\"a, b, d\",\"a, c, e\",\"c, e, f\",\"b, d, f\",\"c, d, e\"],\"answer\":3,\"explain\":\"EXPLAN 모델(Howell)은 언어 계획(PLAN)과 실행(EX)의 비동시성으로 비유창성을 설명한다. 다음 낱말의 계획이 준비되지 않았을 때 화자가 (1) 앞선 낱말·구를 반복하거나 쉼·간투사로 시간을 버는 '지연(stalling)'을 택하면 낱말전체 반복·구 반복·간투사·쉼이 나타나고, (2) 불완전한 계획으로 낱말 산출을 시작하는 '진행(advancing)'을 택하면 낱말의 일부만 산출되어 음소·음절 반복, 연장, 막힘이 나타난다. 따라서 c(음소 반복), e(연장), f(막힘)이 진행 유형이다. a(낱말전체 반복), b(간투사·쉼), d(구 반복)은 지연 유형으로, 어린 아동의 비유창성과 회복군에서 우세하다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"EXPLAN 진행 유형\",\"p\":\"비유창성을 지연과 진행 전략으로 구분해 진행 유형 선택\",\"n\":\"EXPLAN: 진행은 음소·음절 반복·연장·막힘, 지연은 낱말·구 반복·간투사·쉼\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인에 관한 연구 결과\\n• 말 산출 시 우반구 운동·전운동 영역의 과활성과 좌반구 청각 영역의 활성 저하\\n• 좌측 하전두회 아래 백질(궁상다발) 완전성 저하\\n• 도파민 D2 수용체 길항제 투여 후 말더듬 감소, 도파민 작용제 투여 후 악화 보고\\n• 일란성 쌍생아의 말더듬 일치율이 이란성보다 높음\",\"q\":\"위 결과들을 통합적으로 설명하는 진술로 옳은 것은?\",\"choices\":[\"부모가 정상적 비유창성을 말더듬으로 잘못 진단해 반응함으로써 학습된 행동이다.\",\"좌반구 말운동 신경망 취약성과 기저핵-도파민 타이밍 문제에 유전적 소인이 관여한다.\",\"우반구 과활성이 말더듬의 일차 원인이므로 우반구 활성을 억제하는 훈련이 근본 치료가 된다.\",\"도파민 결핍이 일차 원인이므로 도파민 작용제가 우선적인 약물 치료제로 권고된다.\",\"조음 실행에는 문제가 없고 음운 부호화의 사후 점검 과정에서만 문제가 생긴다.\"],\"answer\":2,\"explain\":\"제시된 영상·백질·약물·유전 자료는 신경생리학적 모델의 근거다. 좌반구 언어-운동 신경망(하전두회, 궁상다발)의 취약성, 기저핵-시상-피질 회로의 도파민 과활성으로 인한 말운동 타이밍 문제, 유전적 소인이 함께 작용한다고 본다. ①은 진단착오이론, ⑤는 내적수정가설의 설명이다. ③ 우반구 과활성은 좌반구 결함에 대한 보상적 활성으로 해석되므로 억제 훈련이 근본 치료라는 주장은 틀리다. ④ 도파민 작용제는 오히려 악화시키며, 감소 효과가 보고된 것은 길항제이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"말더듬 신경생리 모델\",\"p\":\"영상·백질·약물·쌍생아 연구 결과를 통합하는 설명 선택\",\"n\":\"좌반구 언어-운동망 취약성, 기저핵-도파민 타이밍 문제, 유전적 소인 작용\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 5세 4개월 여아\\n• 6개월 전 큰 개에게 쫓겨 크게 놀란 사건 직후 말더듬이 갑자기 시작됨\\n• 그 이전 말·언어발달 정상, 가족력 없음\\n• 주 비유창성: 긴장된 막힘, 후두 부위 긴장과 숨 참기 동반\\n• 말하기를 두려워하며 \\\"말이 안 나와\\\"라고 울음\",\"q\":\"Van Riper의 말더듬 발달 경로(track) 중 이 아동에 해당하는 경로와 그 특징으로 옳은 것은?\",\"choices\":[\"경로 I – 점진적 시작, 긴장 없는 음절 반복, 말더듬에 대한 인식 없음\",\"경로 II – 언어발달 지연 동반, 빠르고 불규칙한 말, 속화와 유사한 양상\",\"경로 IV – 늦은 시작, 의도적이고 고정된 형태의 반복, 회피 없음\",\"경로 III – 외상 후 갑작스러운 시작, 긴장된 막힘, 높은 인식과 공포\",\"경로 II – 갑작스러운 시작, 긴장 없는 연장 위주, 말더듬에 대한 인식 없음\"],\"answer\":4,\"explain\":\"Van Riper의 경로 III은 놀람·외상 사건 후 갑작스럽게 시작되며, 처음부터 긴장된 막힘·후두 긴장·숨 참기가 나타나고 아동이 말더듬을 뚜렷이 인식해 공포와 회피가 빠르게 발달하는 것이 특징이다. 경로 I은 가장 흔한 형태로 점진적 시작과 쉬운 반복, 경로 II는 언어발달 지연과 속화 유사 양상, 경로 IV는 늦은 시작과 의도적·상동적 반복 및 회피 결여가 특징이다. ⑤는 경로 II의 특징을 잘못 기술한 것이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"발달 단계·감별\",\"k\":\"Van Riper 경로 III\",\"p\":\"외상 후 갑작스러운 시작과 긴장된 막힘·공포로 발달 경로 판단\",\"n\":\"경로 III: 외상 후 갑작스러운 시작, 처음부터 긴장된 막힘, 높은 인식·공포\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"[그림 1]은 초등학교 2학년 아동이 \\\"우리 반은 금요일에 미술관으로 견학을 갔는데 거기서 커다란 공룡 뼈를 봤어요.\\\"라고 말한 발화를 전사한 것이다. 목표 음절 수는 반복·연장 등 비유창 부분을 제외한 의도한 발화의 음절 수로 산정한다.\",\"q\":\"[그림 1]의 비유창성 분석으로 옳은 것은?\",\"choices\":[\"발화의 목표 음절 수는 41음절이다.\",\"단어부분 반복은 모두 3회 나타났다.\",\"반복의 평균 단위반복수는 1.8회이다.\",\"비운율적 발성은 모두 2회 나타났다.\",\"100음절당 진성 비유창성은 20회이다.\"],\"answer\":3,\"explain\":\"목표 발화 '우리 반은 금요일에 미술관으로 견학을 갔는데 거기서 커다란 공룡 뼈를 봤어요'는 2+2+4+5+3+3+3+3+2+2+3 = 32음절이다(①은 '---' 칸을 뺀 전체 칸 수 41과 혼동한 것). 단어부분 반복은 우우우리(단위 2), 금금요일(1), 거거거거기서(3), ㅋㅋ커다란(음소 반복, 단위 2), 봤봤어요(1)로 5회이며, 음소 반복 'ㅋㅋ커'를 따로 분류하더라도 4회이므로 ②의 3회는 오답이다, 총 단위반복수 2+1+3+2+1 = 9회 ÷ 5회 = 평균 단위반복수 1.8회로 ③이 옳다. 비운율적 발성은 연장 1회(미---)와 막힘 2회(견, 공)로 3회이다(④ 오답). 진성 비유창성은 5+3 = 8회이므로 100음절당 8/32×100 = 25회이다(⑤ 오답). 부수행동은 눈 깜박임 1회로 핵심행동 계산에 포함하지 않는다.\",\"image\":\"data:image/svg+xml;base64,\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"평균 단위반복수 산출\",\"p\":\"전사 자료에서 반복 횟수와 단위반복수를 세어 평균값 계산\",\"n\":\"평균 단위반복수: 총 단위반복수 9회÷반복 5회=1.8회, 목표 음절은 32음절\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"치료사: 요즘 회사 생활은 어때요?\\n대상자: (목청 가다듬기) 요즘 ㅂㅂ바쁜 편이에요.\\n치료사: 주로 어떤 일을 하세요?\\n대상자: (목청 가다듬기) 보고… (고개를 옆으로 홱 돌리며)보고서 쓰는 일이요.\\n치료사: 회의도 자주 있나요?\\n대상자: 있잖아요, 회의는 팀장님이 (3초 쉼)진행하세요. 저는 ㅍㅍ (손으로 책상을 치며)프레젠테이션… 아니 발표 자료만 만들어요.\\n치료사: 발표는 직접 하시나요?\\n대상자: (목청 가다듬기) 웬만하면 동료한테 부탁해요.\",\"q\":\"위 대화에서 가장 많이 나타난 이차행동(부수행동)은?\",\"choices\":[\"시작행동\",\"연기책\",\"도피(탈출)행동\",\"대용어 사용하기\",\"상황 회피\"],\"answer\":1,\"explain\":\"시작행동(starter)은 말을 시작하기 위해 덧붙이는 소리·말·동작으로, 목청 가다듬기 3회와 '있잖아요' 1회, 총 4회로 가장 많다. 도피(탈출)행동은 막힘에서 빠져나오기 위한 고개 돌리기·책상 치기 2회, 연기책(postponement)은 어려운 낱말 앞의 3초 쉼 1회, 대용어 사용은 '프레젠테이션'을 '발표 자료'로 바꾼 1회, 상황 회피는 발표를 동료에게 부탁하는 1회이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"이차행동 유형 분류\",\"p\":\"목청 가다듬기·고개 돌리기·쉼·대용어 등을 유형별로 세어 비교\",\"n\":\"시작행동: 말을 시작하려고 덧붙이는 소리·말·동작, 목청 가다듬기 등 4회\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"성인 대상자의 발화\\n\\\"저는 (막힘)주말에 어 동생이랑 ㅈㅈㅈ자전거를 타고 하---ㄴ강에 갔다가 갔다가 라면을 먹었어요.\\\"\\n(총 발화 시간: 12초, 말속도는 목표 음절 수 기준으로 산출)\",\"q\":\"위 발화의 분석 내용으로 옳은 것은?\",\"choices\":[\"기타 비유창성은 3회이고 진성 비유창성은 3회이다.\",\"진성 비유창성은 4회이고 기타 비유창성은 2회이다.\",\"말속도는 140 SPM이고 %SS는 약 7.1이다.\",\"말속도는 120 SPM이고 %SS는 약 10.7이다.\",\"말속도는 140 SPM이고 %SS는 약 10.7이다.\"],\"answer\":5,\"explain\":\"목표 발화 '저는 주말에 동생이랑 자전거를 타고 한강에 갔다가 라면을 먹었어요'는 2+3+4+4+2+3+3+3+4 = 28음절이다. 말속도는 28음절 ÷ 12초 × 60 = 140 SPM이다(④ 오답). 말더듬이 나타난 음절은 막힘(주), 음소 반복(자), 연장(하) 3음절이므로 %SS = 3/28 × 100 ≈ 10.7이다(③은 2/28로 잘못 계산한 값). 진성 비유창성은 막힘·음소 반복·연장 3회(② 오답), 기타 비유창성은 간투사 '어'와 구 반복 '갔다가 갔다가' 2회이다(① 오답).\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"말속도·%SS 산출\",\"p\":\"목표 음절 수와 발화 시간, 말더듬 음절 수로 SPM과 %SS 계산\",\"n\":\"말속도=28음절÷12초×60=140 SPM, %SS=3/28×100≈10.7\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"4세 아동의 발화 (밑줄은 각 기호가 가리키는 구간)\\n\\\"__엄마가 엄마가(a)__ 어제 __음(b)__ __시---장에서(c)__ __귤을, 아니 사과를(d)__ __사 사 사 왔는데(e)__ __(막힘)너무(f)__ 맛있었어요.\\\"\",\"q\":\"위 발화에서 기타(정상적) 비유창성에 해당하는 것만 묶인 것은?\",\"choices\":[\"a, b, c\",\"a, b, d\",\"b, d, e\",\"a, d, f\",\"b, c, e\"],\"answer\":2,\"explain\":\"기타 비유창성(OD)은 다음절 낱말전체 반복·구 반복, 간투사, 수정·미완성 구 등이다. a '엄마가 엄마가'는 다음절 어절(낱말) 전체 반복, b '음'은 간투사, d '귤을, 아니 사과를'은 수정으로 모두 OD이다. c '시---장'은 연장, f '(막힘)너무'는 막힘으로 비운율적 발성(진성 비유창성)이며, e '사 사 사'는 일음절 낱말 전체 반복으로 Yairi와 Ambrose의 분류 및 P-FA-II의 R2(비정상적 반복)에서 모두 진성(비정상적) 비유창성으로 분류된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"기타 비유창성 구분\",\"p\":\"반복 단위·간투사·수정·연장·막힘을 분류해 정상적 비유창성 선택\",\"n\":\"기타 비유창성: 다음절 낱말·구 반복, 간투사, 수정, 일음절 낱말 반복은 진성\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"다음 중 말더듬 지속(persistence) 위험이 가장 높아 직접치료를 우선 고려해야 하는 아동은?\",\"choices\":[\"3세 2개월 여아, 발병 3개월, 가족력 없음, 최근 진성 비유창성 감소 추세, 음운발달 정상\",\"4세 남아, 발병 5개월, 삼촌이 어릴 때 더듬다 자연회복, 긴장 없는 음절 반복 위주, 인식 없음\",\"3세 8개월 여아, 발병 4개월, 가족력 없음, 언어발달이 또래보다 앞섬, 비유창성 빈도 증가 없음\",\"4세 6개월 남아, 발병 15개월, 아버지가 지속형 말더듬, 음운장애 동반, 막힘·연장 증가\",\"2세 10개월 남아, 발병 2개월, 가족력 없음, 다음절 낱말 전체 반복 위주, 말더듬 인식 없음\"],\"answer\":4,\"explain\":\"지속 위험요인은 남아, 지속형 말더듬 가족력, 발병 후 12개월 이상 경과, 발병 후 비유창성이 감소하지 않거나 증가, 막힘·연장 등 비운율적 발성 증가, 음운·언어 능력 저하, 아동의 인식·부정적 반응 등이다. ④는 남아, 아버지의 성인기까지 지속된 말더듬, 발병 15개월 경과, 음운장애 동반, 막힘·연장 증가로 이 요인을 다수 충족하므로 자연회복을 기다리기보다 직접치료를 우선해야 한다. ①·③은 여아·가족력 없음·감소 또는 증가 없음으로 회복 가능성이 높고, ②는 회복형 가족력과 쉬운 반복, 인식 없음으로 위험이 낮으며, ⑤는 발병 직후이고 비유창성이 정상적 비유창성에 가까워 관찰이 우선이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"발달 단계·감별\",\"k\":\"말더듬 지속 위험요인\",\"p\":\"성별·가족력·발병 경과·비유창성 추이·음운 능력으로 지속 위험 판단\",\"n\":\"지속 위험: 남아, 지속형 가족력, 발병 12개월 이상, 막힘·연장 증가, 음운 저하\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"리드콤 프로그램 훈련 중 어머니의 발화\\nㄱ. (유창한 발화 후) \\\"부드럽게 잘 말했네!\\\"\\nㄴ. (유창한 발화 후) \\\"방금 말 부드러웠어?\\\"\\nㄷ. (말더듬 후) \\\"조금 울퉁불퉁했네.\\\"\\nㄹ. (말더듬 후) \\\"울퉁불퉁했지? 다시 한 번 말해 볼래?\\\"\\nㅁ. (유창한 발화 후) \\\"그렇지, 부드러운 말이야.\\\"\",\"q\":\"언어적 수반자극(verbal contingency)의 유형이 옳게 연결된 것은?\",\"choices\":[\"ㄱ – 유창한 발화에 대한 인정\",\"ㄴ – 말더듬에 대한 자기평가 요청\",\"ㄷ – 말더듬에 대한 인정\",\"ㄹ – 말더듬에 대한 칭찬\",\"ㅁ – 유창한 발화에 대한 자기수정 요청\"],\"answer\":3,\"explain\":\"리드콤 프로그램의 언어적 수반자극은 유창한 발화에 대해 칭찬(ㄱ), 인정(acknowledgement, ㅁ), 자기평가 요청(ㄴ)의 세 가지, 명백한 말더듬에 대해 인정(ㄷ)과 자기수정 요청(ㄹ)의 두 가지이다. 따라서 ㄷ이 '말더듬에 대한 인정'으로 옳다. ㄱ은 칭찬, ㄴ은 유창한 발화에 대한 자기평가 요청, ㄹ은 자기수정 요청, ㅁ은 유창한 발화에 대한 인정이다. 말더듬에 대해서는 칭찬이나 자기평가 요청을 하지 않으며, 유창한 발화에는 자기수정을 요청하지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"리드콤 언어적 수반자극\",\"p\":\"유창·말더듬 발화 뒤 어머니 반응을 수반자극 유형별로 구분\",\"n\":\"리드콤: 유창 발화에 칭찬·인정·자기평가 요청, 말더듬에 인정·자기수정 요청\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"스토커 프로브 테크닉(Stocker Probe Technique)을 적용 중인 5세 아동\\n• 치료사가 장난감 자동차를 보여주며 \\\"이것에 대해 이야기해 줄래?\\\"(4수준)라고 묻자 아동이 \\\"이이이거는 (막힘)바퀴가…\\\"라며 심하게 더듬음\",\"q\":\"이 상황에서 치료사가 취할 조치로 가장 적절한 것은?\",\"choices\":[\"같은 4수준 질문을 아동이 유창하게 답할 때까지 반복한다.\",\"5수준 질문(이야기 만들기)으로 올려 도전하게 한다.\",\"사물을 다른 장난감으로 바꾸어 같은 수준의 질문을 계속한다.\",\"말더듬이 나타났으므로 강화물을 주고 활동을 종료한다.\",\"더 낮은 수준의 질문으로 내려가 유창성을 회복시킨다.\"],\"answer\":5,\"explain\":\"스토커 프로브 테크닉은 의사소통 요구 수준을 5단계(두 사물 중 선택 → 이름 대기 → 위치·기능 → 사물 설명 → 이야기 만들기)로 나누어, 아동이 유창하면 요구 수준을 올리고 더듬으면 요구 수준을 낮추어 유창성을 유지하도록 조절하는 접근이다. 따라서 4수준에서 더듬으면 낮은 수준 질문(\\\"이건 뭐야?\\\", \\\"이건 자동차야, 기차야?\\\")으로 내려가 유창한 반응을 확보한 뒤 다시 단계적으로 올린다. ①·③은 같은 요구 수준을 유지해 말더듬을 지속시키고, ②는 요구를 더 높이며, ④는 조절 원리에 맞지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"스토커 프로브 요구 조절\",\"p\":\"4수준 질문에서 심하게 더듬은 상황으로 요구 수준 조절 판단\",\"n\":\"스토커 프로브: 유창하면 요구 수준을 올리고 더듬으면 낮추어 유창성 유지\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 14세 중학생, 파라다이스-유창성 검사-II(P-FA-II) 실시 계획\\n• 치료사가 준비한 과제: ㄱ. 읽기  ㄴ. 이야기그림  ㄷ. 말하기그림  ㄹ. 대화  ㅁ. 의사소통태도 평가\",\"q\":\"위 계획에 대한 설명으로 옳은 것은?\",\"choices\":[\"ㄱ, ㄷ, ㄹ이 필수과제이며 ㅁ을 함께 실시한다.\",\"ㄴ이 필수과제이고 ㄹ은 선택과제이다.\",\"ㅁ은 성인에게만 실시하므로 제외한다.\",\"낱말그림과 따라말하기를 필수과제로 추가한다.\",\"읽기는 초등학생에게만 실시하므로 ㄱ을 제외한다.\"],\"answer\":1,\"explain\":\"P-FA-II에서 중·고등학생과 성인의 필수과제는 읽기, 말하기그림, 대화이며, 낱말그림·따라말하기는 선택과제이다(문장그림은 취학 전 필수과제). 이야기그림은 초등학생 필수과제이므로 중학생에게는 해당하지 않는다(② 오답). 의사소통태도 평가는 초등학생 이상에게 실시하므로 중학생도 포함된다(③ 오답). ④ 낱말그림·따라말하기는 선택과제이다. ⑤ 읽기는 초등학생 이상 모두의 필수과제이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"P-FA-II 중학생 과제\",\"p\":\"대상 연령에 따른 필수·선택과제와 의사소통태도 평가 적용 판단\",\"n\":\"P-FA-II 중·고등학생·성인: 읽기·말하기그림·대화 필수, 태도 평가는 초등 이상\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인의 사전-사후 평가 결과\\n가. 말더듬 음절 백분율(%SS): 14 → 3\\n나. 전반적 말더듬 경험 평가(OASES) 총 영향 점수: 3.6 → 2.1\\n다. 행동통제소 검사(LCB): 42 → 24\\n라. 말더듬 지각 검사(PSI) 기대(expectancy) 점수: 15 → 5\\n마. 의사소통태도 검사(S-24): 22 → 8\",\"q\":\"위 결과의 해석으로 옳은 것은?\",\"choices\":[\"나: 말더듬이 삶에 미치는 부정적 영향이 커졌다.\",\"다: 말의 통제가 자신에게 있다고 느끼게 되었다.\",\"라: 말을 더듬을 것이라고 예상하는 상황이 늘어났다.\",\"마: 의사소통 태도가 부정적으로 변하였다.\",\"가: 말더듬 빈도에는 의미 있는 변화가 없다.\"],\"answer\":2,\"explain\":\"LCB는 점수가 높을수록 외적 통제소재(운·타인이 결과를 결정한다고 믿음)를 뜻하므로 42 → 24로 감소한 것은 내적 통제감이 커진 긍정적 변화이다. OASES는 점수가 낮을수록 말더듬의 부정적 영향이 적으므로 나는 영향이 줄어든 것이고(① 오답), PSI 기대 점수 감소는 말더듬을 예상하는 상황이 줄었음을(③ 오답), S-24 점수 감소는 의사소통 태도가 긍정적으로 변했음을(④ 오답) 의미한다. %SS는 14에서 3으로 크게 감소하였다(⑤ 오답).\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"태도·심리 검사 점수 해석\",\"p\":\"%SS·OASES·LCB·PSI·S-24의 점수 방향으로 사전-사후 변화 해석\",\"n\":\"LCB 점수 감소는 내적 통제감 증가, OASES·PSI·S-24 감소는 긍정적 변화\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"치료사: 지난주 녹화를 보면 막힐 때마다 입술을 꽉 다물고 힘을 주셨죠. 오늘은 일부러 막히는 순간에 그 형태를 바꿔 볼 거예요. 입술에 힘을 주는 대신 '바바바'처럼 가볍게 반복해서 더듬어 보세요.\\n대상자: 바바바바나나… (웃으며) 이렇게요?\\n치료사: 네. 같은 낱말을 이번엔 첫소리를 길게 늘여서 더듬어 볼까요?\",\"q\":\"위 대화에 해당하는 Van Riper 말더듬수정법의 치료 단계는?\",\"choices\":[\"확인\",\"둔감화\",\"접근\",\"변형\",\"안정화\"],\"answer\":4,\"explain\":\"변형(variation) 단계는 대상자가 습관적으로 굳어진 말더듬 형태(예: 입술에 힘을 주는 막힘)를 의도적으로 다른 형태(가벼운 반복, 연장 등)로 바꾸어 보게 함으로써 말더듬이 고정된 반응이 아니라 스스로 변화시킬 수 있는 행동임을 경험하게 하는 단계이다. 확인 단계는 자신의 말더듬 행동을 분석·기술하고, 둔감화는 말더듬과 청자 반응에 대한 두려움을 줄이며, 접근 단계에서는 취소·빠져나오기·예비책으로 더 쉬운 말더듬을 배우고, 안정화는 자기치료와 재발 대비를 다룬다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬수정법 변형 단계\",\"p\":\"습관적 막힘 형태를 의도적으로 반복·연장으로 바꾸는 활동으로 단계 판단\",\"n\":\"변형 단계: 고정된 말더듬 형태를 다른 형태로 바꿔 스스로 변화시킬 수 있음 경험\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 68세 남성, 파킨슨병 진단 8년\\n• \\\"밥 먹었어요 먹었어요 먹었어요 먹었어요…\\\"처럼 낱말·구를 여러 차례 반복하며, 반복할수록 속도가 빨라지고 목소리가 작아짐\\n• 반복이 발화의 끝부분에서도 나타나며 긴장·막힘·연장은 없음\\n• 반복을 스스로 멈추기 어렵다고 하나 불안이나 부수행동은 없음\",\"q\":\"이 대상자의 유창성 문제로 가장 적절한 것은?\",\"choices\":[\"발달성 말더듬(developmental stuttering)\",\"신경인성 말더듬(neurogenic stuttering)\",\"동어반복증(palilalia)\",\"심인성 말더듬(psychogenic stuttering)\",\"속화(cluttering)\"],\"answer\":3,\"explain\":\"동어반복증(palilalia)은 기저핵 병변(파킨슨병 등)과 관련되어 낱말이나 구를 강박적으로 여러 번 반복하되 반복할수록 속도가 빨라지고 음량이 감소하는 것이 특징이며, 발화의 끝부분에서도 잘 나타난다. 신경인성 말더듬은 음소·음절 반복, 연장, 막힘이 낱말 위치와 무관하게 나타나는 것으로 낱말·구 전체의 가속·감음 반복과 구분된다. 발달성 말더듬은 아동기 발병과 긴장·부수행동, 심인성 말더듬은 심리적 외상 후 발생과 기이한 양상, 속화는 빠르고 불규칙한 말속도와 명료도 저하가 특징이므로 해당하지 않는다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"발달 단계·감별\",\"k\":\"동어반복증 감별\",\"p\":\"파킨슨병과 가속·감음되는 낱말·구 반복으로 유창성 문제 판단\",\"n\":\"동어반복증: 기저핵 병변, 낱말·구 강박적 반복, 반복할수록 빨라지고 작아짐\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 10세 남아, 통합적 말더듬 치료 18개월째\\n• 치료실 대화 %SS 0.8, 자기 평정 말더듬 정도 1~2점(9점 척도)\\n• 가정 녹음 %SS 1.5\\n• 학교 발표 상황 %SS 6.5, 담임 보고: 발표 순서가 오면 화장실에 간다며 자리를 비움\\n• 아동: \\\"학교에서는 기법이 생각 안 나요.\\\"\\n• 부모가 치료 종결을 문의함\",\"q\":\"치료사의 결정으로 가장 적절한 것은?\",\"choices\":[\"치료실·가정 준거를 충족했으므로 종결하고 추후 관리는 생략한다.\",\"유창성 확립 단계부터 프로그램 전체를 처음부터 다시 실시한다.\",\"리드콤 프로그램으로 전환하여 부모의 언어적 수반자극을 시작한다.\",\"학교에 발표 면제를 요청하여 말하기 부담을 없애 준다.\",\"종결을 보류하고 학교 발표 상황으로의 전이 활동을 실시한다.\"],\"answer\":5,\"explain\":\"치료실·가정에서는 유창하지만 학교 발표에서 %SS가 높고 회피(자리 비움)가 지속되므로 전이(일반화)가 완료되지 않은 상태이다. 종결 준거는 여러 상황·대화상대에서의 유창성과 회피·태도 개선까지 포함하므로, 종결을 보류하고 발표 상황 위계(짝 → 모둠 → 학급)에 따른 전이 활동, 교사 협력, 기법 사용 자기점검과 회피 감소 활동을 거쳐 유지 단계로 넘어가는 것이 적절하다. ①은 전이 미완료 상태의 조기 종결, ②는 이미 확립된 기술을 불필요하게 반복, ③은 학령전기 아동용 프로그램으로 부적절, ④는 회피를 강화한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"종결 보류와 전이 활동\",\"p\":\"치료실·가정은 유창하나 학교 발표의 %SS 상승·회피로 종결 여부 판단\",\"n\":\"종결 준거는 여러 상황의 유창성과 회피·태도 개선 포함, 미완료 시 전이 활동\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 9세 여아, 말더듬 치료 중\\n• 최근 반 친구들이 \\\"말 좀 똑바로 해\\\"라며 말더듬을 흉내 내어 놀림\\n• 아동은 말수가 줄고 학교에 가기 싫다고 함\\n• 부모: \\\"놀리는 애들 부모한테 직접 따지겠어요.\\\"\",\"q\":\"치료사가 우선적으로 취할 접근으로 가장 적절한 것은?\",\"choices\":[\"아동과 놀림 대응법을 역할극으로 연습하고 담임교사와 협력한다.\",\"유창성 기법 훈련 시간을 늘려 말더듬을 빨리 감소시킨다.\",\"부모가 놀린 아동의 부모와 직접 만나 항의하도록 지지한다.\",\"놀림이 줄어들 때까지 등교를 잠시 중단하도록 권고한다.\",\"친구들이 눈치채지 못하게 어려운 낱말을 바꾸어 말하도록 지도한다.\"],\"answer\":1,\"explain\":\"놀림(bullying) 대응은 아동 자신의 대처 기술 훈련과 학교 환경 개입을 병행하는 것이 핵심이다. 역할극으로 놀림에 대한 대응(사실대로 말하기, 유머, 무시, 도움 요청)을 연습하고, 아동의 동의하에 담임교사와 협력하여 학급 차원의 말더듬 이해 교육을 계획하면 놀림이 줄고 아동의 위축과 회피를 예방할 수 있다. ②는 말더듬 감소가 곧 놀림 해결이라는 잘못된 전제이며 유창성 압박을 높인다. ③은 갈등을 키우고 아동의 문제해결 경험을 빼앗으며, ④는 회피를 강화하고, ⑤는 낱말 회피를 가르쳐 말더듬을 숨기게 만드는 부적절한 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"놀림 대응 지도\",\"p\":\"친구들의 놀림 후 위축·등교 거부 상황에서 우선 접근 선택\",\"n\":\"놀림 대응: 역할극으로 대처 기술 연습, 담임교사와 협력해 학급 이해 교육\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 15세 남학생, 어머니의 권유로 방문\\n• \\\"저는 괜찮아요. 엄마가 오라고 해서 왔어요.\\\"\\n• 대화 %SS 9, 전화·발표 상황 회피 뚜렷, 면담 중 눈맞춤을 피함\",\"q\":\"첫 회기에서 치료사의 접근으로 가장 적절한 것은?\",\"choices\":[\"어머니가 정한 목표에 따라 곧바로 유창성 확립 훈련을 시작한다.\",\"청소년 본인이 바라는 변화를 탐색하고 목표 설정에 참여시킨다.\",\"치료 동기가 없으므로 치료가 불가능하다고 알리고 종결한다.\",\"어머니에게 리드콤 프로그램의 언어적 수반자극 방법을 훈련한다.\",\"회피를 줄이기 위해 첫 회기에 낯선 사람에게 전화하게 한다.\"],\"answer\":2,\"explain\":\"청소년 말더듬 치료에서는 본인의 동기와 참여가 성과를 좌우한다. 부모가 의뢰했더라도 청소년 스스로 말더듬의 영향(회피, 눈맞춤 회피 등)을 인식하고 원하는 변화를 찾아 목표 설정에 참여하도록 돕는 동기 단계가 우선이며, 비밀보장과 자율성 존중이 신뢰 관계의 기초가 된다. ①·④는 본인의 동기를 배제한 채 부모 중심으로 진행하는 것이고(리드콤은 학령전기용), ③은 동기 형성을 치료의 일부로 보지 않는 잘못된 판단, ⑤는 준비 없는 급격한 노출로 회피와 불안을 오히려 강화할 수 있다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"청소년 치료 동기 형성\",\"p\":\"부모 권유로 온 청소년의 낮은 동기와 회피로 첫 회기 접근 선택\",\"n\":\"청소년 말더듬: 본인 동기·참여가 성과 좌우, 원하는 변화 탐색과 목표 설정 참여\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"13세 남학생. 담임교사가 \\\"말이 너무 빨라 무슨 말인지 모르겠다\\\"며 의뢰하였다.\\n• 음절 축약('할머니가'→'함니가'), 낱말·구 반복과 수정이 잦음\\n• 천천히 말하라고 하면 잠시 명료해지나 곧 원래 속도로 돌아감\\n• \\\"다들 잘 알아듣는데요?\\\"라고 말함\",\"q\":\"이 학생을 말더듬이 아닌 속화로 판단하는 근거로 가장 적절한 것은?\",\"choices\":[\"막힘이 나타날 때 후두와 입술에 긴장이 동반된다.\",\"말하기 어려운 낱말과 상황을 미리 예상하고 피한다.\",\"말을 더듬을 때 눈 깜박임 같은 부수행동이 나타난다.\",\"주의를 기울이면 나아지고 말 문제를 잘 인식하지 못한다.\",\"말을 더듬을 것이라는 예기 불안과 두려움을 호소한다.\"],\"answer\":4,\"explain\":\"속화는 말속도가 빠르거나 불규칙하여 음절 축약, 명료도 저하, 과도한 정상적 비유창성(낱말·구 반복, 수정)이 나타나는 유창성장애로, 말에 주의를 기울이거나 천천히 말하면 일시적으로 나아지고 자신의 말 문제에 대한 인식이 낮은 것이 말더듬과 구별되는 특징이다. 반대로 말더듬은 말에 주의를 기울이거나 긴장할수록 오히려 심해지는 경향이 있고, 자신의 말더듬을 뚜렷이 인식하여 예기 불안과 회피가 발달한다. ①(막힘과 긴장), ②(낱말·상황 회피), ③(부수행동), ⑤(예기 불안과 두려움)은 모두 말더듬의 특징이며 이 학생에게서 보고되지 않았다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"발달 단계·감별\",\"k\":\"속화와 말더듬 감별\",\"p\":\"빠른 말·음절 축약과 주의 시 호전·낮은 인식으로 속화 근거 판단\",\"n\":\"속화: 주의 기울이면 일시 호전, 말 문제 인식 낮음, 말더듬은 예기 불안·회피\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 32세 남성 말더듬 성인, 지연청각피드백(DAF)을 이용한 유창성 형성 치료 중\\n• 250 ms 지연 조건에서 매우 느리고 연장된 말로 거의 유창하게 말함\",\"q\":\"이후 치료 진행 방향으로 가장 적절한 것은?\",\"choices\":[\"250 ms 지연을 유지한 채 일상에서도 계속 착용하게 한다.\",\"지연 시간을 더 늘려 말속도를 더욱 느리게 만든다.\",\"지연 시간을 단계적으로 줄이며 기기 없는 말로 전이한다.\",\"즉시 기기를 제거하고 곧바로 정상 속도로 말하게 한다.\",\"DAF 대신 차폐 소음 기기를 영구적으로 병행 사용한다.\"],\"answer\":3,\"explain\":\"DAF 기반 유창성 형성에서는 긴 지연(약 250 ms)으로 느리고 연장된 유창한 말을 확립한 뒤, 각 단계에서 유창성이 유지되면 지연을 점진적으로 줄여(예: 250 → 200 → … → 50 ms) 말속도와 자연스러움을 회복하고, 마지막에는 기기를 제거한 상태에서 유창성을 유지·전이하도록 진행한다. ①·⑤는 기기 의존을 고착시키고, ②는 자연스러움을 해치며, ④는 단계적 전이 없이 급격히 제거하여 재발을 초래하기 쉽다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"DAF 지연 단계적 감소\",\"p\":\"긴 지연 조건에서 유창성을 확립한 뒤 이후 치료 진행 방향 판단\",\"n\":\"DAF 유창성 형성: 지연을 점진적으로 줄여 자연스러움 회복, 기기 없는 말로 전이\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 34세 여성 말더듬 성인\\n• %SS: 대화 11, 읽기 4\\n• 주 비유창성: 긴장된 막힘(최장 4초), 부수행동으로 눈 감기·턱 떨림\\n• 의사소통태도 검사(S-24): 20점(부정적)\\n• 어려운 낱말을 자주 바꾸어 말하며 자기소개 상황을 회피함\\n• 치료 목표: 관찰 가능한 말더듬 감소와 태도·회피 개선\",\"q\":\"가장 적절한 치료 계획은?\",\"choices\":[\"유창성완성법만 적용하고 태도와 회피는 다루지 않는다.\",\"말더듬수정법만 적용하고 유창성 촉진 기법은 배제한다.\",\"지연청각피드백 기기만 단독으로 장기간 사용한다.\",\"리드콤 프로그램을 성인용으로 축약하여 적용한다.\",\"유창성 형성 기법과 말더듬수정법, 둔감화를 병행한다.\"],\"answer\":5,\"explain\":\"대상자는 말더듬 빈도와 긴장이 높고(핵심행동) 동시에 부정적 태도·회피(내면 요소)도 뚜렷하므로, 부드러운 발성 시작·가벼운 조음접촉 등 유창성 형성 기법으로 유창성을 확립하면서 남는 막힘에는 말더듬수정법의 기법(빠져나오기·취소)을 적용하고, 낱말 회피와 부정적 태도에는 의도적 말더듬·자기공개·상황 위계 노출로 둔감화를 병행하는 통합적 접근이 목표에 부합한다. ①·③은 태도·회피를 다루지 못하고, ②는 %SS 11의 빈번한 긴장 막힘을 줄일 유창성 촉진 요소를 배제하며, ④는 부모 수반자극에 기반한 학령전기 프로그램이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"성인 통합적 치료 계획\",\"p\":\"높은 %SS·긴장 막힘과 부정적 태도·회피가 함께 있어 치료 계획 선택\",\"n\":\"통합적 접근: 유창성 형성 기법, 남은 막힘에 말더듬수정법, 회피·태도에 둔감화 병행\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 남아, 300음절 대화 표본 분석\\n• 단어부분 반복 9회(총 단위반복수 18회)\\n• 일음절 낱말 전체 반복 3회(총 단위반복수 3회)\\n• 비운율적 발성 6회\\n• 간투사 5회, 구 반복 2회, 수정 1회\",\"q\":\"위 자료의 분석으로 옳은 것은?\",\"choices\":[\"100음절당 진성 비유창성은 6회이다.\",\"100음절당 기타 비유창성은 8회이다.\",\"가중 진성 비유창성 점수는 6이다.\",\"진성 비유창성 반복(단어부분·일음절 낱말 반복)의 평균 단위반복수는 2.0회이다.\",\"진성 비유창성의 비율은 약 40%이다.\"],\"answer\":1,\"explain\":\"진성 비유창성(SLD) = 단어부분 반복 9 + 일음절 낱말 반복 3 + 비운율적 발성 6 = 18회 → 100음절당 18/300×100 = 6회로, 말더듬 기준(100음절당 진성 비유창성 3회 이상)을 충족한다. 평균 단위반복수 = (18+3)/(9+3) = 21/12 = 1.75회(④ 오답). 기타 비유창성 = 5+2+1 = 8회 → 100음절당 2.67회(② 오답). 전체 비유창성 26회 중 SLD 비율 = 18/26 ≈ 69%로 말더듬 아동에서 나타나는 높은 비율이다(⑤ 오답). 가중 SLD(weighted SLD) = [(단어부분 반복 + 일음절 낱말 반복) × 평균 단위반복수 + 2 × 비운율적 발성] ÷ 총 음절 × 100 = [(12 × 1.75) + 12]/300 × 100 = 33/300 × 100 = 11(③ 오답).\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"100음절당 진성 비유창성\",\"p\":\"비유창성 유형별 빈도를 진성·기타로 나눠 100음절당 빈도 계산\",\"n\":\"SLD=단어부분 반복+일음절 낱말 반복+비운율적 발성, 18/300×100=6회\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"ㄱ. 음운적으로 복잡하거나 사용 빈도가 낮은 낱말에서 말더듬이 더 많이 나타난다.\\nㄴ. 말더듬은 부모의 부정적 반응에 대한 학습된 회피 반응이다.\\nㄷ. 말더듬 화자는 음운 부호화(음운 표상 활성화) 속도가 느리다.\\nㄹ. 비유창성은 조음 전에 음성 계획의 오류를 감지하고 수정하는 과정의 부산물이다.\\nㅁ. 말더듬은 예상되는 말더듬을 피하려는 투쟁 반응이다.\",\"q\":\"내적수정가설(Covert Repair Hypothesis)에 근거해 설명되는 것만 묶인 것은?\",\"choices\":[\"ㄱ, ㄴ, ㄷ\",\"ㄴ, ㄷ, ㅁ\",\"ㄱ, ㄹ, ㅁ\",\"ㄱ, ㄷ, ㄹ\",\"ㄷ, ㄹ, ㅁ\"],\"answer\":4,\"explain\":\"내적수정가설(Postma & Kolk)은 말더듬 화자의 음운 부호화가 느리고 오류가 잦으며(ㄷ), 내적 모니터가 조음 전에 음성 계획의 오류를 감지해 중단·수정하는 과정에서 반복·연장·막힘이 부산물로 나타난다고 본다(ㄹ). 따라서 부호화 부담이 큰 음운적으로 복잡하거나 저빈도 낱말에서 말더듬이 증가한다고 예측한다(ㄱ). ㄴ은 진단착오이론·학습이론, ㅁ은 예기투쟁가설의 설명이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"내적수정가설 설명\",\"p\":\"각 진술을 이론별로 구분해 내적수정가설로 설명되는 것 선택\",\"n\":\"내적수정가설: 느린 음운 부호화, 조음 전 오류 감지·수정의 부산물이 비유창성\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 8개월 남아, 말더듬 시작 10개월 경과\\n• 수용·표현언어 검사 결과 모두 -1.5 SD\\n• 단문에서는 거의 유창하나 복문을 시도할 때 비유창성이 급증함\\n• 부모: \\\"언어를 먼저 치료해야 하나요, 말더듬을 먼저 치료해야 하나요?\\\"\",\"q\":\"이 아동의 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"언어치료가 끝날 때까지 말더듬 중재는 모두 보류한다.\",\"유창성이 유지되는 발화 수준에서 언어 목표를 점차 늘린다.\",\"복문 산출을 집중 훈련해 언어 수준을 먼저 끌어올린다.\",\"말더듬이 사라질 때까지 부모의 언어 자극을 최소화한다.\",\"리드콤 프로그램의 수반자극을 언어 오류에도 동일하게 적용한다.\"],\"answer\":2,\"explain\":\"언어 능력이 낮은 아동에게 언어적 요구(복문)가 용량을 초과하면 비유창성이 증가한다(요구-용량 관점). 따라서 언어 목표와 유창성 목표를 분리하지 않고 통합하여, 유창성이 유지되는 발화 길이·복잡성에서 언어 목표를 시작해 점진적으로 늘리며 느린 말속도·기다리기 등 유창성 촉진 전략을 병행하는 계획이 적절하다. ①은 발병 10개월이 지난 아동의 말더듬을 방치하고, ③은 요구를 급격히 높여 비유창성을 악화시키며, ④는 언어발달을 저해하고, ⑤는 리드콤 수반자극이 말더듬 여부에만 적용되는 원칙에 어긋난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"언어지체 동반 말더듬 중재\",\"p\":\"복문 시도 시 비유창성 급증과 언어 −1.5SD로 통합 중재 계획 선택\",\"n\":\"요구-용량 관점: 유창성이 유지되는 발화 수준에서 언어 목표를 점진적으로 확대\"}},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 24세 남성, 소송과 관련하여 말더듬 장애 진단서를 요구하며 방문\\n• 아동기 말더듬 병력 없음, 신경학적 검사 정상\\n• 검사 시 모든 낱말의 첫 음절을 5~6회씩 균일하게 반복하며 부수행동이 과장됨\\n• 대기실에서 보호자와 대화할 때는 전혀 더듬지 않음\\n• 읽기를 반복해도 빈도 변화가 없고, 제창·노래 조건에서도 비유창성이 그대로이나 회기마다 양상이 크게 달라짐\",\"q\":\"이 대상자에 대한 감별과 대처로 가장 적절한 것은?\",\"choices\":[\"위장 말더듬 가능성을 고려해 여러 조건의 발화를 체계적으로 비교한다.\",\"심인성 말더듬으로 판단하고 정신건강의학과 의뢰 후 치료를 종결한다.\",\"신경인성 말더듬으로 판단하고 신경학적 정밀검사를 의뢰한다.\",\"발달성 말더듬으로 판단하고 말더듬수정법을 바로 시작한다.\",\"속화로 판단하고 말속도 조절 훈련을 곧바로 시작한다.\"],\"answer\":1,\"explain\":\"외적 이득(소송)이 걸려 있고, 관찰되지 않는다고 여길 때 유창하며, 병력·신경학적 근거가 없고, 지나치게 균일하고 과장된 반복과 회기 간 비일관성이 나타나는 점은 위장(malingering) 말더듬을 시사한다. 이 경우 여러 조건·시점의 발화 표본, 관찰 인식 여부에 따른 비교, 적응·제창 등 유창성 유도 조건에 대한 반응을 체계적으로 검토해 일관성을 확인하고 객관적으로 기록해야 하며, 단정적으로 낙인찍는 판단은 피해야 한다. ②는 심인성 말더듬의 경우에도 관찰되지 않는 상황에서 유창한 점과 이득 동기를 설명하지 못하고, ③은 신경학적 검사가 정상이며, ④는 아동기 병력이 없고, ⑤는 속화의 특징(빠른 속도, 명료도 저하)이 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"발달 단계·감별\",\"k\":\"위장 말더듬 감별·대처\",\"p\":\"소송 이득과 관찰 여부에 따른 유창성 변화·비일관성으로 감별과 대처 판단\",\"n\":\"위장 말더듬: 여러 조건·시점 발화를 체계적으로 비교해 일관성 확인, 객관적 기록\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 41세 여성 학원 강사, 6개월 전부터 말할 때 목소리가 끊기고 힘이 든다고 호소\\n• 연장모음 /아/: CPP 13.8 dB, jitter 0.52 %, HNR 21 dB, CAPE-V 전반적 중증도 8/100 mm\\n• 표준 문장 읽기: CPPS 4.2 dB, CAPE-V 전반적 중증도 62/100 mm\\n• VHI-10: 26점\\n• 후두스트로보스코피: 구조적 병변 없음\",\"q\":\"이 결과에 대한 해석과 조치로 가장 적절한 것은?\",\"choices\":[\"연장모음 지표가 정상이므로 음성장애가 없다고 판정하고 심리 상담을 의뢰한다\",\"문장 과제의 낮은 CPPS는 검사자의 마이크 거리 오류로 보고 모음 결과를 채택한다\",\"연장모음 결과만으로 정상 판정하지 말고 연결발화 지표로 정밀 평가한다\",\"VHI-10 26점은 정상 범위이므로 치료 없이 6개월 뒤 추적 관찰만 한다\",\"모음과 문장 결과가 서로 다르므로 두 값을 평균하여 경도 음성장애로 판정한다\"],\"answer\":3,\"explain\":\"연장모음에서는 CPP·jitter·HNR과 청지각 중증도가 모두 정상 범위이지만 연결발화에서는 CPPS가 현저히 낮고 청지각 중증도가 높으며, 환자의 핸디캡(VHI-10 26점)도 크다. 이는 음성 문제가 과제 의존적으로 연결발화에서 두드러진다는 뜻이며(연축성발성장애·근긴장성발성장애 등에서 흔함), 모음 지표만으로 정상 판정하면 위음성이 된다. CPPS는 연결발화에서도 산출할 수 있는 안정적 지표이므로 문장 과제 결과를 중증도 판정에 반영해야 한다. VHI-10은 통상 11점을 넘으면 비정상으로 보므로 26점은 정상이 아니며, 서로 다른 과제의 값을 평균하는 것은 근거가 없다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"연결발화 CPPS 해석\",\"p\":\"모음 지표 정상·문장 CPPS 저하·VHI-10 고점으로 과제 의존적 문제 판단\",\"n\":\"CPPS: 연결발화에서도 산출 가능한 안정적 지표, 모음 지표만으로 정상 판정 시 위음성\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 29세 남성 콜센터 상담원, 목 조임과 음성 피로 호소\\n• /파/ 음절 반복 과제에서 추정한 성문하압(구강내압 최고치): 12.0 cmH₂O\\n• 동일 과제에서 모음 구간의 평균호기류율: 100 mL/sec\",\"q\":\"이 환자의 후두기류저항(laryngeal airway resistance)과 해석으로 옳은 것은?\",\"choices\":[\"120 cmH₂O/(L/sec)로 정상보다 높으며, 성대 과내전을 시사한다\",\"120 cmH₂O/(L/sec)로 정상보다 낮으며, 성문폐쇄부전을 시사한다\",\"0.12 cmH₂O/(L/sec)로 정상 범위이며, 효율적 발성을 시사한다\",\"1,200 cmH₂O·L/sec로 정상보다 높으며, 호흡 지지 부족을 시사한다\",\"8.3 (L/sec)/cmH₂O로 정상보다 높으며, 성대 과내전을 시사한다\"],\"answer\":1,\"explain\":\"후두기류저항 = 성문하압 ÷ 성문통과기류율이다. 100 mL/sec = 0.1 L/sec이므로 12.0 ÷ 0.1 = 120 cmH₂O/(L/sec)이다. 성인 편안한 발성의 정상 저항은 대략 30~70 cmH₂O/(L/sec) 범위로 보고되므로 120은 뚜렷이 증가된 값이며, 성문하압이 높은데 기류가 적게 통과한다는 것은 성대가 과도하게 내전(과기능)되어 있음을 뜻한다. ②는 값은 맞으나 방향 해석이 반대이고, ③·④·⑤는 단위 환산이나 분수 방향이 틀렸다. ※정상 저항 범위는 측정 방법·교재별로 차이가 있음.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"후두기류저항 산출\",\"p\":\"성문하압과 평균호기류율을 단위 환산해 저항 산출·해석\",\"n\":\"후두기류저항=성문하압÷기류율, 정상보다 높으면 성대 과내전 시사\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"세 환자의 공기역학적 검사 결과(폐활량 외 모든 과제는 편안한 발성)\\n• 환자 A: MPT 6초, 평균호기류율 380 mL/sec, 성문하압 5.5 cmH₂O, 폐활량 3.6 L(정상)\\n• 환자 B: MPT 9초, 평균호기류율 60 mL/sec, 성문하압 13 cmH₂O, 폐활량 정상\\n• 환자 C: MPT 7초, 평균호기류율 110 mL/sec, 성문하압 4 cmH₂O, 폐활량 1.9 L(저하)\",\"q\":\"각 환자에게 가장 가능성이 높은 발성 문제의 기전을 옳게 연결한 것은?\",\"choices\":[\"A – 과기능적 성대 과내전, B – 성문폐쇄부전, C – 호흡 지지 부족\",\"A – 호흡 지지 부족, B – 성문폐쇄부전, C – 과기능적 성대 과내전\",\"A – 성문폐쇄부전, B – 호흡 지지 부족, C – 과기능적 성대 과내전\",\"A – 성문폐쇄부전, B – 과기능적 성대 과내전, C – 호흡 지지 부족\",\"A – 호흡 지지 부족, B – 과기능적 성대 과내전, C – 성문폐쇄부전\"],\"answer\":4,\"explain\":\"A는 폐활량이 정상인데 기류율이 크게 증가(정상 약 80~200 mL/sec)하고 MPT가 짧으므로 성문에서 공기가 새는 성문폐쇄부전(성대마비·위축 등)이다. B는 기류율이 낮고 성문하압이 높으므로(정상 약 5~10 cmH₂O) 성대를 과도하게 조여 발성하는 과기능 양상이다. C는 기류율은 정상 범위이나 성문하압이 낮고 폐활량 자체가 저하되어 있어 발성을 구동할 호흡 지지가 부족한 경우(신경근육질환·폐질환 등)이다. 세 환자 모두 MPT가 짧지만 원인 기전이 다르므로 MPT만으로는 감별할 수 없다. ※기류율·성문하압 정상 범위는 교재별로 차이가 있음.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"공기역학 지표 기전 감별\",\"p\":\"기류율·성문하압·폐활량 조합으로 환자별 발성 기전 판단\",\"n\":\"기류율↑는 성문폐쇄부전, 기류율↓·성문하압↑는 과내전, 폐활량↓는 호흡 지지 부족\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 26세 성악 전공 대학원생, 고음역에서 소리가 갈라지고 연습 후 피로 호소\\n• GRBAS: G1 R0 B1 A0 S0\\n• 음성장애지수(VHI-30): 14점\\n• 가창음성장애지수(SVHI): 92/144점\\n• 후두스트로보스코피: 양측 성대에 경미한 부종, 발성 시 미세한 방추형 성문틈\",\"q\":\"이 결과에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"VHI-30이 낮으므로 음성 문제가 일상에 미치는 영향이 없다고 판단하고 치료를 종결한다\",\"SVHI는 VHI-30과 달리 가창 핸디캡을 반영하므로 가창 요구를 치료 목표에 둔다\",\"GRBAS가 경도이므로 자기보고 도구의 높은 점수는 과장된 호소로 보고 해석에서 제외한다\",\"SVHI는 청지각적 평가 도구이므로 GRBAS 등급과 일치할 때에만 타당하다고 본다\",\"두 설문 점수가 서로 크게 다르므로 검사 신뢰도가 낮다고 보고 전체 재검사를 실시한다\"],\"answer\":2,\"explain\":\"VHI-30은 일상적 말하기 음성이 신체·기능·정서 영역에 미치는 영향을 묻는 도구여서 말 음성이 비교적 유지되는 가수에서는 낮게 나올 수 있다. SVHI는 노래 수행에 특화된 자기보고 도구로 92/144점은 상당한 핸디캡을 나타내며, 스트로보스코피의 경미한 부종·성문틈이 고음역 문제와 부합한다. 청지각적 중증도가 경도라도 직업적 요구가 높은 가수에게는 작은 변화가 큰 기능 손실이 되므로 자기보고 결과를 과장으로 보아서는 안 된다. SVHI는 청지각 평가가 아니라 자기보고 도구이며, 두 도구는 측정 영역이 달라 점수 불일치가 신뢰도 문제를 뜻하지 않는다. ※VHI-30 절단점은 연구별로 차이가 있음.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"SVHI와 VHI-30 해석\",\"p\":\"VHI-30 저점과 SVHI 고점의 불일치로 가수의 가창 핸디캡 판단\",\"n\":\"SVHI: 가창 특화 자기보고 도구, 말 음성 중심의 VHI-30과 측정 영역이 다름\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 31세 여성 실용음악 보컬, 수년간 지속된 기식적 음성과 음성 피로, 고음 산출 곤란\\n• 후두스트로보스코피: 양측 성대 유리연을 따라 길게 파인 홈, 방추형 성문틈, 홈 부위 점막파동 현저히 감소\\n• 8개월 전 흡수성 재료 성대주입술 후 일시 호전되었으나 재발\\n• 발성 시 목과 어깨에 힘을 주어 소리를 내는 습관이 생김\",\"q\":\"이 환자의 음성치료 계획으로 가장 적절한 것은?\",\"choices\":[\"밀기 기법을 집중 적용하여 성문틈을 강제로 닫도록 훈련한다\",\"3개월간 절대 음성휴식을 지시한 뒤 후두 상태를 재평가한다\",\"보툴리눔 독소 주입을 의뢰하여 성대와 후두 긴장을 낮춘다\",\"제II형 갑상성형술을 의뢰하여 성문을 넓히고 긴장을 줄인다\",\"반폐쇄성도훈련으로 효율적 발성을 익히고 과기능을 줄인다\"],\"answer\":5,\"explain\":\"성대 유리연의 홈과 국소적 점막파동 소실, 방추형 성문틈은 성대구증(고유층 결손)의 소견으로, 병변 자체는 음성치료로 없어지지 않고 수술(주입술·성형술)의 효과도 제한적이거나 일시적이다. 따라서 치료 목표는 남은 조직으로 가장 효율적인 발성을 얻는 것이며, 반폐쇄성도훈련과 공명음성으로 성문 상부 압력을 활용해 성문틈을 보상하고, 이미 형성된 목·어깨의 보상적 과기능을 줄이면서 현실적인 기대치를 상담하는 것이 적절하다. 밀기 기법은 이미 있는 과기능을 강화하고, 장기 절대 음성휴식은 근거가 없으며, 보툴리눔 독소는 연축성발성장애의 치료이고, 제II형 갑상성형술은 성문을 넓히는 수술이라 성문틈이 있는 환자에게 반대 방향의 처치이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성대구증 음성치료\",\"p\":\"유리연 홈·방추형 성문틈과 주입술 후 재발로 치료 목표 설정\",\"n\":\"성대구증: 병변 자체는 불변, 반폐쇄성도훈련으로 효율적 발성·과기능 감소\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 71세 남성, 폐암으로 좌측 상엽 절제술 14개월 후, 수술 직후부터 약하고 기식적인 음성과 물 마실 때 사레\\n• 4개월간 성대내전 촉진 음성치료를 받았으나 MPT 5초, 평균호기류율 420 mL/sec로 변화 없음\\n• 후두근전도: 좌측 갑상피열근에서 재신경화 징후 없음\\n• 발성 시 후두내시경 소견: 좌측 성대 부정중위 고정 및 궁형(bowing) 변화, 우측 성대의 보상적 과내전에도 성문 후방부 폐쇄 부전 지속, 좌측 성대 수직 위치 저하\",\"q\":\"후두내시경 소견과 경과를 고려할 때 가장 적절한 치료는?\",\"choices\":[\"제I형 갑상성형술과 피열연골내전술 병행을 고려한다\",\"제II형 갑상성형술로 성문을 넓혀 기도를 확보한다\",\"건측 성대에 보툴리눔 독소를 주입하여 보상적 과내전을 줄인다\",\"흡수성 젤 성대주입술 후 6개월간 자연 회복을 더 기다린다\",\"양측 후윤상피열근 절제술로 성대 위치를 교정한다\"],\"answer\":1,\"explain\":\"수술 후 14개월이 지났고 후두근전도에서 재신경화 징후가 없으며 충분한 음성치료에도 공기역학 지표가 개선되지 않았으므로 자연 회복 가능성은 낮고 영구적 내측화 수술의 적응증이다. 내시경의 성문 후방부 폐쇄 부전은 후방 성문틈이 크다는 뜻이고, 마비측 성대의 수직 위치 저하는 좌우 성대의 높이 차이를 뜻한다. 제I형 갑상성형술은 마비된 성대를 정중선 쪽으로 밀어 성문틈을 줄이지만 성대 앞쪽 위주로 작용하므로, 후방 성문틈이 넓고 좌우 성대의 높이 차이가 있으면 피열연골내전술을 병행하여 후방 폐쇄와 높이를 맞춘다. 제II형은 성문을 넓히는 수술(연축성발성장애 등), 보툴리눔 독소는 건측의 보상까지 없애 음성을 악화시키며, 흡수성 주입은 회복이 기대되는 시기의 임시 처치이고, 후윤상피열근 절제술은 존재하지 않는 표준 술식이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"성대마비 내측화 수술\",\"p\":\"재신경화 없음·후방 성문틈·수직 높이 차로 병행 수술 판단\",\"n\":\"제I형 갑상성형술은 앞쪽 위주 내측화, 후방 성문틈·높이 차 있으면 피열연골내전술 병행\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 58세 남성 회사원, 6개월 전부터 목소리가 쉬고 숨이 새며 점점 콧소리가 심해짐, 최근 물을 마실 때 가끔 사레가 들림\\n• 후두내시경: 구조적 병변 없음, 성대 내전이 다소 약하나 마비는 없음\\n• 구강 검사: 혀 가장자리의 위축과 혀 표면의 미세한 꿈틀거림(섬유속연축)\\n• 최근 오른손으로 젓가락질과 단추 채우기가 서툴러졌다고 함\\n• 휴식 후에도 증상의 변화가 없음\",\"q\":\"언어재활사의 대응으로 가장 적절한 것은?\",\"choices\":[\"기능적 음성장애로 판단하고 성대기능훈련을 바로 시작한다\",\"음성 과사용에 의한 근피로이므로 음성위생 교육과 확성기 사용을 권한다\",\"운동신경원질환을 의심하여 신경과 진료를 먼저 의뢰한다\",\"내전형 연축성발성장애로 판단하고 보툴리눔 독소 주입을 의뢰한다\",\"성대마비 초기로 판단하고 밀기 기법으로 성대 내전을 강화한다\"],\"answer\":3,\"explain\":\"수개월에 걸쳐 진행하는 쉰·기식 음성과 과다비성, 삼킴 곤란에 더해 혀의 위축과 섬유속연축(하부운동신경원 징후), 손의 미세운동 저하(사지 침범)가 함께 나타나는 것은 근위축성 측삭경화증(ALS) 등 운동신경원질환을 시사한다. 구근형으로 시작하는 경우 음성·말 증상이 첫 증상이어서 음성장애로 먼저 의뢰되기도 하므로, 언어재활사는 음성 문제로만 해석하지 말고 신경과 진료를 먼저 의뢰해야 한다. 진단 후의 중재는 근력 강화보다 에너지 보존, 보완대체의사소통(AAC)의 조기 준비, 삼킴 관리가 중심이 된다. ① 기능적 음성장애와 ② 음성 과사용은 혀 위축·섬유속연축·사지 근력 저하를 설명하지 못하고, ④ 연축성발성장애는 과제 특이적인 긴장성 음성 단절이 특징이며, ⑤ 성대마비 소견이 없고, 진행성 신경근 질환에서 밀기 기법 같은 근력 강화 훈련은 피로를 가중시킬 수 있다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"운동신경원질환 의심 의뢰\",\"p\":\"진행성 음성 증상에 혀 위축·섬유속연축·손 기능 저하 동반으로 의뢰 판단\",\"n\":\"ALS 구근형: 음성·말 증상이 첫 증상일 수 있어 신경과 진료 우선 의뢰\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 34세 여성 합창단원, 상기도 감염 후 2개월째 고음이 나오지 않음, 노래할 때 음도를 올리려 하면 소리가 갈라지고 말소리는 약간 낮아지고 숨이 섞임\\n• 음성범위프로파일: 최고 주파수가 이전 기록보다 1옥타브 이상 감소\\n• 후두내시경: 양측 성대의 내·외전 운동은 정상 범위이나, 음도 활주 시 좌측 성대가 짧고 처져 보이며 후방 성문이 좌측으로 회전되어 성대 길이가 비대칭임\",\"q\":\"이 사례의 진단과 중재로 가장 적절한 것은?\",\"choices\":[\"좌측 되돌이후두신경 마비 – 제I형 갑상성형술을 의뢰한다\",\"좌측 상후두신경 외지 마비 – 음도 확장 훈련 등 음성치료를 한다\",\"변성발성장애 – 손가락 조작법으로 습관적 음도를 낮춘다\",\"근긴장성발성장애 – 후두 마사지로 후두 긴장을 이완한다\",\"양측 성대마비 – 기도 확보를 위해 성대 외측고정술을 의뢰한다\"],\"answer\":2,\"explain\":\"상후두신경 외지는 윤상갑상근을 지배하며, 이 근육은 성대를 늘여 음도를 높인다. 바이러스성 상기도 감염 후 한쪽 윤상갑상근이 약해지면 내·외전은 정상이지만 고음 산출이 안 되고, 활주 시 마비측 성대가 짧고 처지며 후방 성문이 마비측으로 회전하는 특징적인 비대칭이 나타난다. 치료는 회복을 기다리며 음도 확장 훈련·건측 보상 등 음성치료가 중심이며, 되돌이후두신경 마비처럼 성대 내전이 안 되는 것이 아니므로 내측화 수술은 적응증이 아니다. 변성발성장애·근긴장성발성장애는 신경학적 비대칭 소견을 설명하지 못하고, 양측 성대마비는 내·외전 운동 자체가 소실된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"상후두신경 외지 마비\",\"p\":\"감염 후 고음 소실과 음도 활주 시 성대 비대칭으로 진단과 중재 판단\",\"n\":\"상후두신경 외지: 윤상갑상근 지배, 마비 시 고음 곤란, 음도 확장 등 음성치료 중심\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 68세 남성, 후두전적출술과 경부 방사선치료 종료 후 3개월, 전기후두 훈련을 시작함\\n• 경부형 전기후두를 목 여러 부위에 대어 보았으나 피부가 단단하고 부어 있어 소리가 거의 입 밖으로 전달되지 않음\\n• 인지·손 기능은 양호하고 구강 구조와 조음 기능은 정상\",\"q\":\"이 시점에서 가장 적절한 조치는?\",\"choices\":[\"전기후두를 포기하고 식도발성 훈련으로 즉시 전환한다\",\"기기의 진동 강도를 최대로 높여 목에 세게 눌러 사용하도록 한다\",\"방사선 부종이 있으므로 모든 무후두 발성 훈련을 1년 뒤로 미룬다\",\"구강형 어댑터로 진동음을 입안에 전달하며 조음 훈련을 한다\",\"기관식도천공 발성이 가능하도록 즉시 보철 삽입을 의뢰한다\"],\"answer\":4,\"explain\":\"경부형 전기후두는 목 조직을 통해 진동을 인두·구강으로 전달하는데, 방사선치료 후 부종·섬유화가 있으면 진동이 흡수되어 소리가 나오지 않는다. 이때는 기기에 구강형 어댑터(튜브)를 연결해 진동음을 입안으로 직접 넣어 조음하는 방법으로 즉시 의사소통을 확보할 수 있으며, 조직 상태가 좋아지면 경부형으로 옮겨갈 수 있다. 식도발성은 습득에 오랜 시간이 걸려 당장의 대안이 되지 못하고, 강한 압박은 조직 손상과 통증을 유발하며, 훈련을 미루면 의사소통 단절 기간이 길어진다. 기관식도천공 발성은 별도의 적응 평가(공기주입검사 등)가 필요하므로 이 시점의 즉각적 해결책이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"방사선 후 전기후두 대안\",\"p\":\"방사선 후 단단해진 목 조직으로 경부형 전달이 안 될 때 대안 선택\",\"n\":\"구강형 어댑터: 진동음을 입안에 직접 전달, 경부 섬유화·부종 시 즉시 의사소통 확보\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 62세 남성, 기관식도천공(TEP) 발성으로 2년간 잘 지내 옴\\n• 최근 2주 전부터 물을 마시면 기침이 나고, 확인해 보니 물이 보철의 가운데 구멍을 통해 기관 쪽으로 새어 나옴\\n• 발성은 이전과 같이 잘 되며 보철 주변 조직에서는 누출이 없음\\n• 보철을 교체한 지 9개월 됨\",\"q\":\"이 문제의 원인과 조치로 가장 적절한 것은?\",\"choices\":[\"천공이 늘어나 보철 둘레로 새는 것이므로 더 큰 지름의 보철로 교체한다\",\"인두식도분절 경직이 원인이므로 보툴리눔 독소 주입을 의뢰한다\",\"보철을 제거하고 천공을 폐쇄한 뒤 식도발성으로 전환한다\",\"보철 위치가 잘못되었으므로 기공을 완전히 막고 발성 연습을 늘린다\",\"밸브가 완전히 닫히지 않는 보철 고장이므로 보철 교체를 의뢰한다\"],\"answer\":5,\"explain\":\"TEP 보철의 일방향 밸브는 발성 시 폐 공기를 식도로 보내고 삼킬 때는 닫혀 식도 내용물이 기관으로 넘어오지 않게 한다. 밸브 중심(내강)을 통한 누출은 밸브 판막이 칸디다 집락·마모로 완전히 닫히지 않는 보철 자체의 고장이며, 통상 보철 교체와 항진균 관리로 해결된다. 보철 둘레 누출은 천공 확대가 원인으로 다른 처치(작은 지름·조직 수축 조치)가 필요하고, 발성이 잘 되므로 인두식도분절 경직은 아니며, 잘 작동하던 TEP를 폐쇄할 이유도 없다. 기공 폐쇄나 발성 연습은 흡인 위험을 해결하지 못한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"TEP 보철 내강 누출\",\"p\":\"보철 가운데 구멍으로 누출되나 발성은 유지되는 양상으로 원인 판단\",\"n\":\"밸브 중심 누출은 칸디다·마모에 의한 보철 고장으로 교체, 둘레 누출은 천공 확대\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 7세 여아, 생후 12개월에 구개열 봉합술, 최근 심한 알레르기 비염으로 입으로 숨 쉼\\n• 나조미터 검사: 구강음 문장 비성치 36 %, 비음 문장 비성치 42 %\\n• 청지각: 모음에서 과다비성이 들리고, /ㅁ, ㄴ/의 비음 공명은 오히려 약하며 압력자음에서 비강 난기류가 들림\",\"q\":\"이 결과의 해석과 다음 조치로 가장 적절한 것은?\",\"choices\":[\"구강음 비성치가 높은 전형적 과다비성이므로 즉시 인두피판술을 의뢰한다\",\"혼합비성이 의심되므로 연인두 폐쇄와 비강 기도 폐쇄를 함께 평가한다\",\"비강 폐쇄에 의한 과소비성이므로 아데노이드 절제술을 의뢰한다\",\"두 비성치가 모두 정상 범위이므로 압력자음 조음치료만 실시한다\",\"연인두 폐쇄가 정상이므로 비강 기류 훈련(부는 연습)을 실시한다\"],\"answer\":2,\"explain\":\"구강음 문장 비성치는 정상 상한(대략 15~20 %)을 크게 넘고 비음 문장 비성치는 정상(대략 55~65 %)보다 낮다. 구강음에서 코로 소리가 새면서(연인두 폐쇄부전) 동시에 비음의 비강 공명이 부족한 것은 비강 기도 폐쇄가 함께 있는 혼합비성의 전형이다. 비강 폐쇄가 있으면 나조미터 값이 실제 연인두 기능보다 낮게 나와 과다비성이 과소평가될 수 있으므로, 수술 결정 전에 비강 기도 문제를 평가·관리하고 비인두내시경으로 폐쇄 양상을 직접 확인해야 한다. 과소비성 단독이나 정상 판정은 구강음 문장의 높은 비성치와 맞지 않고, 부는 연습은 연인두 폐쇄부전을 개선하지 못한다. ※비성치 정상 범위는 검사 문장·연령·교재별로 차이가 있음.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"공명장애\",\"k\":\"나조미터 혼합비성 해석\",\"p\":\"구강음 비성치 상승과 비음 비성치 저하로 혼합비성 판단\",\"n\":\"혼합비성: 연인두 폐쇄부전과 비강 기도 폐쇄 공존, 비강 폐쇄 시 과다비성 과소평가\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 45세 여성, 1년 전부터 말할 때 목소리가 걸린 듯 끊기고 쥐어짜는 소리가 남\\n• 모음이 많은 문장('아이와 엄마가 우유를 마셔요')에서 음성 단절이 특히 잦음\\n• 웃거나 울 때, 노래하거나 속삭일 때는 음성이 비교적 정상\\n• 후두내시경: 구조적 병변 없음, 발화 중 간헐적인 성대 과내전\\n• 6개월간 음성치료(하품-한숨, 반폐쇄성도훈련) 후에도 변화 없음\",\"q\":\"이 환자에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"내전형 연축성발성장애를 의심해 보툴리눔 독소 치료를 의뢰한다\",\"근긴장성발성장애로 보고 같은 음성치료를 더 오래 지속한다\",\"외전형 연축성발성장애로 보고 무성자음 문장으로 재평가한다\",\"심인성 실성증으로 보고 정신건강의학과 의뢰 후 종결한다\",\"성대마비 초기로 보고 제I형 갑상성형술을 의뢰한다\"],\"answer\":1,\"explain\":\"말하기에서만 나타나고 웃음·울음·노래·속삭임에서는 비교적 정상인 과제 특이성, 모음(유성음)이 많은 문장에서 두드러지는 쥐어짜는 음성 단절, 구조적 병변 없이 발화 중 간헐적으로 나타나는 성대 과내전은 내전형 연축성발성장애의 특징이다. 이는 후두의 국소 근긴장이상(신경학적 질환)이어서 음성치료 단독으로는 효과가 제한적이며, 갑상피열근에 대한 보툴리눔 독소 주입이 표준 치료이고 음성치료는 주입 후 보조적으로 병행한다. ② 근긴장성발성장애는 음성치료에 반응하는 경우가 많고 이처럼 과제 특이적인 단절 양상을 보이지 않는다. ③ 외전형은 무성자음이 많은 문장에서 숨이 새는 단절이 특징으로, 이 환자의 쥐어짜는 단절과 반대 양상이다. ④ 심인성 실성증은 대개 갑자기 시작되어 속삭임 음성이 지속되는 양상이며, ⑤ 성대 운동 저하가 아니라 과내전이 문제이므로 내측화 수술은 적응증이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"내전형 연축성발성장애\",\"p\":\"말하기 과제 특이성과 모음 문장의 쥐어짜는 단절로 진단과 치료 선택\",\"n\":\"내전형 SD: 후두 국소 근긴장이상, 보툴리눔 독소가 표준 치료·음성치료는 보조\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 33세 여성 유치원 교사, 하루 6시간 이상 소음이 큰 교실에서 발화, 오후마다 쉰 목소리와 목 통증, 주말이면 회복\\n• 후두내시경: 양측 성대 경미한 발적과 부종, 명확한 결절 없음\\n• 음성 사용을 줄이기는 현실적으로 어렵다고 함\",\"q\":\"이 교사에게 가장 적절한 음성 관리 지도는?\",\"choices\":[\"수업 중에는 속삭여서 말하여 성대 접촉 부담을 줄이도록 한다\",\"목이 쉬면 멘톨 사탕과 진한 커피로 목을 풀고 수업하도록 한다\",\"확성기 사용과 잦은 음성휴식으로 하루 음성 부하량을 낮춘다\",\"음성 문제가 반복되므로 3개월간 절대 음성휴식을 취하게 한다\",\"큰 소리로 말하는 훈련을 통해 성대 근육을 단련하도록 한다\"],\"answer\":3,\"explain\":\"직업적 음성 사용자의 과사용 초기 소견(발적·부종, 주말 회복)에서는 음성 부하량을 낮추는 환경·행동 조정이 핵심이다. 확성기는 소음 환경에서 강도를 높이지 않고도 전달을 가능하게 해 부하를 실질적으로 줄이며, 소음 감소·짧고 잦은 휴식·수분 섭취가 함께 권장된다. 속삭임은 성대에 오히려 긴장을 주고, 멘톨과 카페인은 점막을 건조하게 하며, 장기 절대 휴식은 근거가 없고 직업적으로 비현실적이다. 큰 소리 훈련은 부하를 더 늘려 병변으로 진행시킬 위험이 있다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"교사 음성 부하 관리\",\"p\":\"과사용 초기 소견과 음성 사용 감축이 어려운 상황으로 관리 방법 선택\",\"n\":\"음성 부하량 감소: 확성기·짧고 잦은 휴식·소음 감소·수분 섭취\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 22세 여성 서비스직, 약하고 기식적이며 단조로운 목소리로 손님이 잘 못 알아듣는다고 호소\\n• 관찰: 말할 때 어깨가 들리는 얕은 쇄골호흡, 짧은 구절 단위로 자주 숨을 쉼, 리듬과 억양의 변화가 거의 없음\\n• MPT 8초, 후두내시경: 병변 없음, 발성 시 경미한 방추형 성문틈\",\"q\":\"이 대상자에게 가장 적합한 음성치료는?\",\"choices\":[\"리실버만음성치료로 큰 소리 산출을 집중 훈련한다\",\"손가락 조작법으로 습관적 음도를 낮추도록 훈련한다\",\"흡기발성으로 진성대 발성을 유도하여 훈련한다\",\"악센트 기법으로 복식호흡과 리듬적 강세를 결합한다\",\"차폐 기법으로 무의식적인 음성 강도 증가를 유도한다\"],\"answer\":4,\"explain\":\"얕은 쇄골호흡, 호흡 지지 부족에 따른 약하고 기식적인 음성, 단조로운 리듬·억양은 악센트 기법의 주된 적응증이다. 악센트 기법은 복식(횡격막)호흡을 기반으로 느린 템포부터 빠른 템포까지 리듬적 강세를 주며 발성하여 호흡-발성-조음의 협응을 개선하고 음성의 역동성을 높인다. LSVT는 파킨슨병의 감소된 강도에 특화된 방법이고, 손가락 조작법·흡기발성은 각각 변성발성장애·가성대 발성/기능적 실성증에 쓰이며, 차폐 기법은 롬바르드 효과로 강도만 올리는 방법이라 호흡 양상과 리듬 문제를 다루지 못한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"악센트 기법 적응증\",\"p\":\"얕은 쇄골호흡·약하고 기식적인 음성·단조로운 억양으로 기법 선택\",\"n\":\"악센트 기법: 복식호흡 기반 리듬적 강세로 호흡-발성-조음 협응 개선\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 58세 여성, 폐 결핵 수술 후 우측 성대마비로 진단, 발성 시 기식적이고 약한 음성\\n• 음성치료 중 치료사가 환자의 갑상연골 우측 판(lamina)을 손가락으로 안쪽으로 부드럽게 누른 상태에서 /아/를 연장하게 하자 음성이 즉시 뚜렷하게 커지고 맑아짐\",\"q\":\"이 절차의 명칭과 임상적 의미로 옳은 것은?\",\"choices\":[\"후두 하강법 – 후두를 낮춰 근긴장을 이완시키는 절차이다\",\"갑상연골 전방 압박 – 음도를 낮추는 변성발성장애 치료이다\",\"후두 마사지 – 후두 외근의 긴장을 줄여 근긴장성발성장애를 치료한다\",\"윤상갑상근 자극법 – 성대를 늘여 음도 범위를 넓히는 절차이다\",\"갑상연골 측면 압박 – 마비 성대를 내측화하여 수술 효과를 예측한다\"],\"answer\":5,\"explain\":\"갑상연골 판을 옆에서 안쪽으로 누르면 그 아래의 성대가 정중선 쪽으로 밀려 성문 폐쇄가 일시적으로 좋아진다. 편측 성대마비에서 이 조작으로 음성이 즉시 개선되면 내측화(갑상성형술·주입술)의 효과를 예측할 수 있고, 치료 중에는 성문 폐쇄 감각을 익히는 촉진 기법으로도 쓴다. 갑상연골을 앞에서 뒤로 눌러 성대를 느슨하게 하여 음도를 낮추는 것은 변성발성장애의 손가락 조작법이며, 후두 하강·후두 마사지는 과기능성 음성장애의 이완 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"갑상연골 측면 압박\",\"p\":\"갑상연골 판을 누를 때 즉각적인 음성 개선으로 절차와 의미 판단\",\"n\":\"갑상연골 측면 압박: 마비 성대 일시 내측화, 내측화 수술 효과 예측·촉진 기법\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 38세 남성, 성인형 재발성 후두유두종으로 4년간 CO₂ 레이저 수술 6회\\n• 후두내시경: 현재 활동성 유두종은 소량이나 전방 성문 유착(전교련 웹)과 양측 성대 반흔이 있음\\n• 음성: 거칠고 기식적이며, 발성 시 가성대가 좁혀지고 목에 힘을 많이 줌\\n• 이비인후과에서 음성치료를 의뢰함\",\"q\":\"이 환자의 음성치료 목표와 원칙으로 가장 적절한 것은?\",\"choices\":[\"음성치료로 남은 유두종을 소실시키고 재발을 막는 것을 일차 목표로 한다\",\"남은 조직으로 효율적인 발성을 얻고 보상적 과기능 발성을 줄인다\",\"유착 부위를 벌리기 위해 밀기 기법과 강한 성문파열음 시작을 훈련한다\",\"유두종은 전염성이므로 대면 치료를 중단하고 음성위생 자료만 제공한다\",\"완전한 정상 음성 회복을 목표로 주 5회 강도 높은 훈련을 계획한다\"],\"answer\":2,\"explain\":\"반복 수술로 생긴 전교련 웹과 성대 반흔은 진동 조직 자체의 손실이므로 음성치료로 되돌릴 수 없고, 활동성 유두종 병변은 수술(그리고 필요 시 보조 약물)로 관리한다. 언어재활사의 역할은 남은 조직의 진동 효율을 높이고 보상적으로 생긴 가성대 압박·노력 발성을 줄여 음성과 피로를 개선하는 것이며, 병변 재발이나 기도 협착의 징후를 관찰해 의뢰하는 것이다. 밀기·강한 성문파열음은 과기능을 강화하고 반흔 조직에 부담을 주며, 유두종은 일상적 대면 치료로 전염되는 것이 아니고, 구조적 손상이 있어 완전한 정상 음성이라는 목표는 비현실적이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"유두종 수술 후 반흔 치료\",\"p\":\"반복 수술 후 전교련 웹·반흔과 가성대 과기능으로 치료 목표 설정\",\"n\":\"반흔·웹은 되돌릴 수 없음, 남은 조직의 진동 효율 향상과 보상적 과기능 감소\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"성대폴립 후두미세수술 후 1주가 지난 영업직 환자에게 이비인후과에서 '비밀스러운 음성(confidential voice)'으로 말하도록 하라는 의뢰가 왔다.\",\"q\":\"이 기법을 적용할 때 언어재활사의 지도로 가장 적절한 것은?\",\"choices\":[\"속삭임이 아닌 낮은 강도의 유성 발성으로, 수술 후 단기간만 사용한다\",\"성대를 완전히 벌리고 공기 소리만 내는 속삭임으로 말하도록 안내한다\",\"기식성이 좋은 음질이므로 수술 후 6개월 이상 습관화되도록 유지한다\",\"낮은 강도가 목표이므로 목을 조여 작은 소리를 내도록 지도한다\",\"음성휴식과 같은 효과이므로 말하는 양을 제한할 필요는 없다고 안내한다\"],\"answer\":1,\"explain\":\"비밀스러운 음성은 가까운 사람에게 비밀을 말하듯 낮은 강도에 약간 기식적인, 그러나 유성음이 유지되는 편안한 음성으로, 성대 접촉 충격을 줄이면서 최소한의 의사소통을 가능하게 한다. 속삭임은 성대를 강하게 벌리고 후두 긴장을 높여 오히려 해롭고, 목을 조이는 것은 과기능을 유발한다. 이 기법은 수술 직후나 급성 염증기에 단기간 쓰는 과도기적 방법이며, 장기간 사용하면 기식성 발성이 습관화될 수 있으므로 상처 회복 후 공명음성·반폐쇄성도훈련 등 정상 발성 훈련으로 옮겨가야 한다. 또한 음성휴식을 완전히 대체하는 것은 아니므로 말하는 양도 함께 조절한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"비밀스러운 음성 지도\",\"p\":\"폴립 수술 후 1주 의뢰에 비밀스러운 음성의 적용 원칙 판단\",\"n\":\"비밀스러운 음성: 속삭임 아닌 낮은 강도의 유성 발성, 수술 직후 단기간만 사용\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 29세 여성 뮤지컬 배우, 감기 후 2일 전부터 목이 쉬고 통증, 이틀 뒤 주연 공연 예정\\n• 공연을 강행하려 하며 '목을 아끼기 위해 리허설은 속삭여서 하겠다'고 함\\n• 후두내시경: 양측 성대 전반의 발적과 부종, 점막파동 감소, 출혈·종괴 없음\",\"q\":\"언어재활사의 대응으로 가장 적절한 것은?\",\"choices\":[\"속삭임은 성대 접촉이 없으므로 리허설 방식으로 적절하다고 확인해 준다\",\"밀기 기법으로 성대 접촉을 강화하여 공연에 필요한 강도를 확보한다\",\"부종이 심한 급성기이므로 즉시 후두미세수술을 의뢰한다\",\"손상 위험을 설명하고 이비인후과 치료와 상대적 음성휴식을 권한다\",\"공연 전까지 고음 발성 연습량을 늘려 성대를 부하에 적응시킨다\"],\"answer\":4,\"explain\":\"급성 후두염으로 부종·발적이 있는 성대에 공연 수준의 발성 부하가 가해지면 성대 출혈이나 폴립 등 영구적 손상으로 이어질 수 있어, 전문 공연자에게는 특히 위험을 명확히 설명하고 의료진과 공연 여부를 결정하게 해야 한다. 이 시기의 관리는 이비인후과 약물 치료와 상대적 음성휴식, 가습·수분 섭취이며 속삭임은 후두 긴장을 높여 회복에 해롭다. 밀기 기법과 고음 연습은 부하를 늘리고, 급성 염증은 수술 대상이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"급성 후두염 공연자 관리\",\"p\":\"공연 앞둔 배우의 성대 발적·부종과 속삭임 계획에 대응 선택\",\"n\":\"급성 후두염: 이비인후과 치료와 상대적 음성휴식, 속삭임은 후두 긴장을 높여 해로움\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 62세 남성, 30년 흡연·잦은 음주, 3개월 전부터 점차 심해지는 쉰 목소리, 최근 목 이물감\\n• 후두스트로보스코피: 우측 성대 중간부에 경계가 불규칙한 두꺼운 백색 융기 병변, 병변 부위 점막파동 소실, 좌측은 정상\\n• 이비인후과 진료 없이 지인의 소개로 음성치료를 받으러 옴\",\"q\":\"언어재활사의 대응으로 가장 적절한 것은?\",\"choices\":[\"성대결절로 판단하고 음성위생 교육과 반폐쇄성도훈련을 시작한다\",\"라인케부종이므로 금연 상담을 하고 3개월 뒤 재평가한다\",\"음성치료를 보류하고 즉시 이비인후과에 정밀 진단을 의뢰한다\",\"음성 남용에 의한 접촉성 육아종이므로 헛기침 줄이기를 지도한다\",\"기능적 음성장애이므로 심리 상담과 함께 하품-한숨법을 실시한다\"],\"answer\":3,\"explain\":\"장기 흡연·음주력이 있는 60대 남성의 진행하는 쉰 목소리에서 편측의 불규칙한 백색 융기 병변과 국소적 점막파동 소실은 백반증(이형성)이나 침윤성 후두암을 시사하는 적신호이며, 조직검사 없이는 양성 여부를 판단할 수 없다. 음성치료는 악성이 배제된 뒤 시작해야 하므로 우선 이비인후과 정밀 진단을 의뢰한다. 성대결절은 양측 대칭 병변, 라인케부종은 양측 전장의 반투명 부종, 접촉성 육아종은 성대돌기(후방) 부위 병변이고, 구조적 병변이 뚜렷하므로 기능적 음성장애로 볼 수 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"후두암 적신호 의뢰\",\"p\":\"흡연력과 편측 불규칙 백색 병변·점막파동 소실로 의뢰 판단\",\"n\":\"편측 불규칙 백색 병변: 백반증·후두암 적신호, 악성 배제 전까지 음성치료 보류\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 55세 여성, 8개월간 지속되는 마른 기침, 하루 수십 회 발작적으로 나타나며 말하거나 웃을 때, 향수·찬 공기에 노출될 때 유발됨\\n• 목이 간질거리는 느낌이 기침에 선행, 밤에 잠들면 기침 없음\\n• 흉부 영상·폐기능검사·역류 치료·천식 치료·비염 치료에 반응 없음\\n• 후두내시경: 구조적 이상 없음, 흡기 시 성대가 살짝 안쪽으로 모이는 경향\",\"q\":\"이 사례의 판단과 중재로 가장 적절한 것은?\",\"choices\":[\"역류가 원인이므로 양성자펌프억제제 용량을 늘리도록 권한다\",\"기침을 참으면 해로우므로 기침을 충분히 하도록 교육한다\",\"말할 때 유발되므로 성대결절을 의심하고 음성휴식을 지시한다\",\"심인성 기침으로 판단하고 정신건강의학과 의뢰만 한다\",\"후두 과민성 기침으로 보고 행동적 기침 억제 치료를 실시한다\"],\"answer\":5,\"explain\":\"흉부·폐기능 검사가 정상이고 역류·천식·비염 치료에 반응하지 않으며, 목의 간질거림이 선행하고 말·웃음·냄새·찬 공기 같은 비특이 자극에 유발되면서 수면 중에는 없는 기침은 후두 과민성에 의한 만성 난치성 기침의 전형이다. 이 경우 언어재활사가 시행하는 행동적 기침 억제 치료(교육, 기침 대체 전략, 후두 이완·호흡 재훈련, 유발 요인 관리)가 근거 있는 중재이며, 흡기 시 성대가 모이는 경향은 역행성 성대운동과의 연관성을 시사한다. 이미 효과 없던 역류 치료를 늘리는 것은 근거가 없고, 기침을 반복하면 후두 자극이 강화되어 악순환이 된다. 병변이 없으므로 결절·음성휴식과는 무관하며, 심인성으로 단정해 정신과에만 의뢰하는 것도 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"후두 과민성 기침 치료\",\"p\":\"약물치료 무반응과 비특이 자극 유발·수면 중 소실로 기침 유형 판단\",\"n\":\"후두 과민성 만성 기침: 교육·기침 대체 전략·후두 이완 등 행동적 기침 억제 치료\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 37세 남성 강사, 근긴장성발성장애로 8회기 음성치료(후두 마사지, 하품-한숨, 반폐쇄성도훈련) 실시\\n• 전기성문파형검사(EGG) 접촉률(CQ, closed quotient): 치료 전 0.71 → 치료 후 0.52\\n• 청지각: 쥐어짜는 소리(S) 2 → 0\",\"q\":\"이 결과에 대한 해석으로 옳은 것은?\",\"choices\":[\"과도했던 성대 접촉이 완화되어 정상 범위에 가까워졌음을 뜻한다\",\"접촉률이 감소하였으므로 성문폐쇄부전이 새로 발생했음을 뜻한다\",\"EGG는 성문하압을 직접 측정하므로 호흡 지지가 감소한 것이다\",\"접촉률은 점막파동의 진폭을 나타내므로 점막 유연성이 줄어든 것이다\",\"접촉률 증가가 치료 목표였으므로 밀기 기법을 추가해야 한다\"],\"answer\":1,\"explain\":\"EGG 접촉률(CQ)은 성대 진동 한 주기에서 성대가 접촉(폐쇄)되어 있는 시간의 비율로, 과기능적 발성에서 높고 기식적 발성에서 낮다. 편안한 발성의 CQ는 대략 0.4~0.6 범위로 보고되므로 0.71에서 0.52로의 감소는 과도한 성대 접촉이 완화되어 정상 범위로 들어왔음을 의미하며, 청지각적 긴장성 감소와 부합한다. 0.52는 성문폐쇄부전을 뜻하는 낮은 값이 아니고, EGG는 목에 댄 전극으로 성대 접촉 면적 변화를 기록하는 검사이지 압력이나 점막파동 진폭을 측정하지 않는다. 과기능 환자에게 접촉률 증가는 목표가 아니며 밀기 기법은 금기에 가깝다. ※CQ 정상 범위는 기기·산출 방식(기준선 설정)에 따라 차이가 있음.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"EGG 접촉률 변화 해석\",\"p\":\"치료 전후 CQ 감소와 긴장성 소실로 성대 접촉 변화 해석\",\"n\":\"EGG CQ: 진동 주기 중 성대 접촉 시간 비율, 과기능에서 높고 기식적 발성에서 낮음\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 47세 남성, 좌측 성대 중간부 폴립(우측 성대 정상)\\n• 거칠고 두 개의 음이 동시에 들리는 듯한 음성을 호소함\\n• 후두스트로보스코피: 좌우 성대의 진동이 비대칭적이고 불규칙함, 가성대 접근 없음\\n• 연인두 기능 정상\\n• 청지각: G2 R2 B1 A0 S1\",\"q\":\"이 환자에게서 두 개의 음이 동시에 들리는 현상(이중음성)을 가장 잘 설명하는 기전은?\",\"choices\":[\"성대 긴장이 높아져 기본주파수 자체가 상승하였다\",\"연인두 폐쇄부전으로 비강 공명이 함께 들린다\",\"가성대가 진성대와 함께 진동하여 낮은 음이 더해진다\",\"좌우 성대 질량 차이로 두 성대가 다른 주기로 진동한다\",\"성문이 완전히 닫히지 않아 기류 소음이 섞여 들린다\"],\"answer\":4,\"explain\":\"편측 폴립처럼 좌우 성대의 질량·긴장이 다르면 두 성대가 각자 다른 주기로 진동하거나 진동 주기가 두 배로 늘어나, 두 개의 음높이가 동시에 지각되는 이중음성과 거친 음질(R2)이 나타난다. 이는 성대 진동이 완전히 주기적이지 않다는 뜻으로, 스트로보스코피의 비대칭·불규칙 진동과 부합한다. ① 이중음성은 기본주파수 상승이 아니라 서로 다른 두 진동이 겹쳐 생기고, ② 연인두 기능은 정상이며, ③ 가성대 발성도 이중음성을 만들 수 있으나 이 환자는 가성대 접근이 없다. ⑤ 불완전한 성문 폐쇄에 의한 기류 소음은 기식성(B1)을 설명할 뿐 두 음이 동시에 들리는 현상을 설명하지 못한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"이중음성 발생 기전\",\"p\":\"편측 폴립과 비대칭·불규칙 진동 소견으로 이중음성 기전 판단\",\"n\":\"이중음성: 좌우 성대 질량·긴장 차이로 두 성대가 서로 다른 주기로 진동\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 24세 트랜스젠더 남성, 테스토스테론 호르몬 치료 10개월째\\n• 습관적 F0: 치료 전 210 Hz → 현재 125 Hz\\n• 호소: 목소리가 낮아지긴 했으나 갈라지고 갑자기 높은 음이 튀어나오며, 조금만 말해도 목이 피로하고 조임\\n• 후두내시경: 병변 없음, 발성 시 전후 압축과 가성대 접근 관찰\",\"q\":\"이 사례에 대한 판단과 중재로 가장 적절한 것은?\",\"choices\":[\"음도가 남성 범위에 못 미치므로 제III형 갑상성형술을 의뢰한다\",\"새 음도의 안정화와 과기능 감소를 목표로 음성치료를 실시한다\",\"여성 음성이 남아 있으므로 흉성 공명 강화를 위해 밀기 기법을 훈련한다\",\"호르몬 부작용에 의한 증상이므로 테스토스테론 중단을 권한다\",\"가성구 발성을 집중 훈련하여 음도 급변을 없애도록 한다\"],\"answer\":2,\"explain\":\"테스토스테론은 성대의 질량과 두께를 늘려 트랜스젠더 남성의 음도를 대개 남성 범위로 낮추므로, 트랜스젠더 여성과 달리 음도 자체를 바꾸는 수술은 보통 필요하지 않다(125 Hz는 성인 남성 범위). 문제는 변화한 후두에 맞는 발성 조절을 아직 익히지 못해 생기는 음도 불안정(갈라짐, 음도 급변)과 이를 보상하려는 과기능(전후 압축, 가성대 접근, 피로)이며, 이는 음성치료의 영역이다. 제III형 갑상성형술은 음도를 더 낮추는 수술로 적응증이 아니고, 밀기 기법은 과기능을 악화시키며, 호르몬 중단 권고는 언어재활사의 역할을 벗어나고, 가성구 훈련은 낮은 음도 안정화와 반대 방향이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"트랜스젠더 남성 음성치료\",\"p\":\"호르몬 후 음도는 남성 범위이나 음도 불안정·과기능으로 중재 판단\",\"n\":\"테스토스테론으로 음도 하강, 새 음도 안정화와 과기능 감소가 음성치료 목표\"}},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 생후 4개월 영아, 동맥관개존증(PDA) 결찰술 후 울음소리가 약하고 쉬었으며, 수유 중 기침과 사레가 잦음\\n• 후두내시경: 좌측 성대가 부정중위에서 움직이지 않음, 우측 성대 운동 정상\\n• 체중 증가가 느려 부모가 걱정함\",\"q\":\"이 영아의 관리 계획으로 가장 적절한 것은?\",\"choices\":[\"성문을 닫아 흡인을 막도록 즉시 제I형 갑상성형술을 의뢰한다\",\"울음 강화를 위해 밀기 기법을 부모에게 교육하여 시행한다\",\"편측 마비이므로 기도 확보를 위해 기관절개술을 의뢰한다\",\"음성 문제는 성인이 된 뒤 치료하면 되므로 그대로 퇴원시킨다\",\"삼킴 평가와 안전한 수유 관리를 하며 성대 운동을 추적한다\"],\"answer\":5,\"explain\":\"좌측 되돌이후두신경은 대동맥궁 아래를 돌아 올라오므로 동맥관 결찰술 중 손상되기 쉽고, 영아에서 편측 성대마비는 약한 울음보다 흡인과 수유 곤란·체중 증가 지연이 더 시급한 문제이다. 따라서 우선 기기적 삼킴 평가로 흡인 여부를 확인하고 수유 전략과 영양을 관리해야 하며, 신경 손상은 수개월~1년 이상에 걸쳐 회복될 수 있으므로 성대 운동을 추적 관찰하고 영구 수술은 보류한다. 갑상성형술은 성장 중인 영아의 후두에 시행하지 않으며, 밀기 기법은 영아에게 적용할 수 없고, 편측 마비는 기도 폐쇄를 일으키지 않아 기관절개술의 적응증이 아니다. 흡인 위험을 방치한 채 퇴원시키는 것은 위험하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"영아 편측 성대마비 관리\",\"p\":\"PDA 결찰술 후 좌측 성대마비와 수유 곤란으로 관리 우선순위 판단\",\"n\":\"영아 편측 성대마비: 흡인·수유 관리 우선, 회복 가능성 있어 추적·영구 수술 보류\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"[그림 1]은 7세 아동의 순음청력검사 결과이다(우측 귀는 반대 귀를 차폐한 역치, 좌측 귀는 비차폐 역치, 헤드폰 검사).\",\"q\":\"[그림 1]에 대한 설명으로 옳은 것은?\",\"choices\":[\"왼쪽 귀의 3분법 기도 청력역치는 40 dB HL로 중등도 난청이다\",\"오른쪽 귀는 혼합성, 왼쪽 귀는 고주파수 경사형 감각신경성 난청이다\",\"오른쪽 귀는 기도-골도 차가 없으므로 감각신경성 난청으로 본다\",\"오른쪽 귀 기도 검사에서는 교차청취 우려가 없어 차폐가 필요하지 않다\",\"오른쪽 귀의 3분법 기도 청력역치는 55 dB HL로 중등도 난청이다\"],\"answer\":2,\"explain\":\"그림에서 읽은 값 — 오른쪽 기도(△, 차폐): 250 Hz 55, 500 Hz 60, 1 kHz 65, 2 kHz 70, 4 kHz 75, 8 kHz 80 dB HL / 오른쪽 골도([, 차폐): 500 Hz 35, 1 kHz 40, 2 kHz 45, 4 kHz 55 / 왼쪽 기도(X): 250 Hz 10, 500 Hz 15, 1 kHz 20, 2 kHz 40, 4 kHz 65, 8 kHz 75 / 왼쪽 골도(>): 500 Hz 15, 1 kHz 20, 2 kHz 40, 4 kHz 60. 오른쪽은 골도 자체가 상승(3분법 골도 (35+40+45)/3=40)하면서 기도-골도 차가 25 dB로 10 dB 이상 존재하므로 혼합성 난청이고, 왼쪽은 기도·골도가 거의 일치(차 0~5 dB)하며 2 kHz 이상에서 급격히 나빠지는 고주파수 경사형 감각신경성 난청이다(②). 3분법 기도역치는 오른쪽 (60+65+70)/3=65 dB HL(중등고도), 왼쪽 (15+20+40)/3=25 dB HL(경도)이므로 ①·⑤는 틀리다. ③은 기골도차 25 dB가 있어 틀리다. ④ 헤드폰 기도검사에서 검사 귀 기도역치와 반대 귀 골도역치의 차가 이간감쇠(약 40 dB) 이상이면 교차청취가 일어날 수 있다. 오른쪽 500 Hz 기도 60 − 왼쪽 골도 15 = 45 dB이므로 차폐가 필요했고, 그래서 오른쪽은 왼쪽 귀를 차폐한 역치로 기록되었다. 골도는 이간감쇠가 거의 0이어서 비차폐로는 어느 귀가 반응했는지 알 수 없으므로, 오른쪽의 혼합성 판단은 차폐한 골도역치를 근거로 한다. ※ 이간감쇠 기준(헤드폰 40 dB, 삽입형 이어폰은 더 큼)과 난청 정도 분류 절단점은 교재에 따라 다를 수 있음.\",\"image\":\"data:image/svg+xml;base64,\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"청각·청각장애\",\"k\":\"청력도 난청 유형 판독\",\"p\":\"차폐 골도역치와 기도-골도 차로 귀별 난청 유형 판단\",\"n\":\"혼합성: 골도 상승과 기골도차 10 dB 이상, 감각신경성: 기도·골도 역치 일치\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아의 낱말검사 전사 자료(목표 낱말 /표준 발음/ → 아동 발화)\\n김밥 /kimp*ap̚/ → [kiba]\\n연필 /jʌnpʰil/ → [jʌpʰil]\\n장갑 /tɕaŋgap̚/ → [tɕaŋga]\\n손톱 /sontʰop̚/ → [sontʰo]\\n풍선 /pʰuŋsʌn/ → [pʰusʌn]\\n바지 /padʑi/ → [padʑi]\",\"q\":\"위 자료에서 종성생략의 출현율은? (출현율 = 음운변동 출현 횟수 ÷ 출현 기회 수 × 100)\",\"choices\":[\"5/10 × 100\",\"5/12 × 100\",\"6/10 × 100\",\"6/12 × 100\",\"7/12 × 100\"],\"answer\":3,\"explain\":\"종성생략의 출현 기회는 목표 낱말에 종성이 있는 자리의 수이다. 김밥(ㅁ, ㅂ)·연필(ㄴ, ㄹ)·장갑(ㅇ, ㅂ)·손톱(ㄴ, ㅂ)·풍선(ㅇ, ㄴ) 각 2개, 바지 0개로 총 10개이다(김밥은 표준 발음 /kimp*ap̚/에서도 종성이 /m/, /p̚/ 두 개). 실제 생략은 [kiba](/m/, /p̚/ 2회), [jʌpʰil](/n/ 1회), [tɕaŋga](/p̚/ 1회), [sontʰo](/p̚/ 1회), [pʰusʌn](/ŋ/ 1회)로 총 6회이므로 출현율은 6/10 × 100 = 60%이다. 분모를 12로 둔 보기는 종성이 없는 '바지'까지 기회로 잘못 계산한 것이고, 5/10은 [kiba]의 이중 생략을 1회로 센 오류이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"종성생략 출현율 계산\",\"p\":\"목표 낱말의 종성 자리를 출현 기회로 세어 종성생략 출현율 산출\",\"n\":\"출현율=변동 출현 횟수÷출현 기회 수×100, 기회는 목표 낱말의 종성 자리 수\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아의 문장 따라말하기\\n목표 문장: 고구마 캐러 갔다가 개구리 잡았어요\\n표준 발음: /koguma kʰɛɾʌ kat̚t*aga kɛguɾi tɕabas*ʌjo/\\n아동 발화: [toduma kʰɛɾʌ tat̚t*aga kɛduɾi tɕabat*ʌjo]\",\"q\":\"위 발화에서 연구개 파열음(/ㄱ, ㄲ, ㅋ/)의 정확도는?\",\"choices\":[\"3/7 × 100\",\"4/7 × 100\",\"3/8 × 100\",\"4/8 × 100\",\"2/7 × 100\"],\"answer\":1,\"explain\":\"목표 문장의 연구개 파열음은 고/k/·구/g/·캐/kʰ/·갔/k/·가/g/·개/k/·구/g/의 7개이다(표준 발음 /kat̚t*aga/의 /t*/는 경음화된 치조음, /tɕabas*ʌjo/의 /s*/는 치조 마찰음이므로 연구개음이 아니다). 아동은 [toduma]에서 2개, [tat̚t*aga]에서 첫 /k/ 1개, [kɛduɾi]에서 /g/ 1개를 치조음 [t, d]로 전방화하여 총 4개 오류이고, 캐[kʰ]·가[g]·개[k] 3개는 정확하므로 3/7 × 100이다. [tɕabat*ʌjo]의 /s*/→[t*] 파열음화는 연구개음 정확도와 무관하다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"연구개 파열음 정확도\",\"p\":\"표준 발음 기준 연구개 파열음 수와 전방화 오류로 정확도 산출\",\"n\":\"경음화된 치조음·마찰음 자리는 연구개음 기회에서 제외, 정조음 수÷목표 수×100\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"두 아동의 낱말 전사 자료\\n목표 낱말 → 아동 A / 아동 B\\n다리 [taɾi] → [paɾi] / [kaɾi]\\n두부 [tubu] → [pubu] / [kubu]\\n나비 [nabi] → [mabi] / [ŋabi]\\n언니 [ʌnni] → [ʌmmi] / [ʌŋŋi]\",\"q\":\"두 아동의 오류에서 공통적으로 상실된 변별자질은?\",\"choices\":[\"[+전방성]\",\"[+비음성]\",\"[+지속성]\",\"[+설정성]\",\"[+긴장성]\"],\"answer\":4,\"explain\":\"아동 A는 치경음 /ㄷ, ㄴ/을 양순음 [ㅂ, ㅁ]으로, 아동 B는 같은 치경음을 연구개음 [ㄱ, ŋ]으로 대치한다. 치경음은 혀끝·혓날로 조음되는 [+설정성(coronal)] 음인데 양순음과 연구개음은 모두 [−설정성]이므로 두 아동이 공통으로 잃은 자질은 설정성이다. [+전방성]은 아동 B(연구개음, [−전방성])만 상실했고 아동 A의 양순음은 [+전방성]을 유지한다. 비음성은 두 아동 모두 /ㄴ/→비음으로 유지되었고, 지속성·긴장성(파열음·평음 유지)도 변화가 없다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성학·음운론 기초\",\"k\":\"설정성 자질 상실\",\"p\":\"치경음이 양순음·연구개음으로 대치된 두 아동의 공통 자질 판단\",\"n\":\"설정성: 혀끝·혓날 조음 자질, 치경음은 [+설정성], 양순·연구개음은 [−설정성]\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"7세 남아 두 명의 말 평가 소견\\n아동 A: 같은 낱말의 자음·모음 오류가 매번 다르고, 낱말이 길어질수록 오류가 급증하며, 발화 전 입 모양을 더듬는 모색행동과 균등한 강세가 관찰됨. 혀·입술 근력과 반사는 정상\\n아동 B: 모든 음소가 일관되게 약하고 부정확(왜곡)하며, 과다비성·침 흘림·혀와 입술의 근력 저하가 있고 말속도가 느림\",\"q\":\"두 아동을 아동기 말실행증과 마비말장애로 감별할 때 근거로 옳은 것은?\",\"choices\":[\"아동 A는 근력 저하와 침 흘림이 있어 마비말장애, 아동 B는 오류가 일관되어 말실행증이다\",\"두 아동 모두 비일관적 오류와 느린 말속도를 보이므로 말실행증과 마비말장애를 감별할 수 없다\",\"아동 B가 /퍼터커/ 순서 오류만 보이고 /퍼퍼퍼/ 반복은 정상이면 마비말장애이다\",\"아동 A는 오류가 비일관적이고 근력이 정상이므로 소수 음소에 국한된 운동적 조음장애이다\",\"아동 A는 비일관성·모색행동으로 말실행증, 아동 B는 근력 저하·일관된 왜곡으로 마비말장애이다\"],\"answer\":5,\"explain\":\"아동기 말실행증은 신경근육 결함 없이 말운동의 계획·프로그래밍이 손상된 것으로 비일관적 자음·모음 오류, 발화 길이가 늘수록 오류 증가, 모색행동, 부적절한 운율(균등 강세)이 핵심 특징이다. 마비말장애는 신경근육 실행의 문제로 근력 저하·침 흘림·과다비성과 함께 모든 음소에 걸친 일관된 왜곡, 느린 말속도를 보인다. ①은 두 아동의 소견을 바꿔 기술했고, ②는 아동 B의 오류가 일관적이므로 틀리다. ③에서 /퍼터커/ 순서 오류는 있으나 단일 음절 반복은 정상인 양상은 순서화 결함인 말실행증에 가깝고, 마비말장애는 단일 음절 반복도 느리고 약하다. ④ 운동적 조음장애는 소수 음소의 일관된 오류가 특징이므로 아동 A와 맞지 않는다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동 말소리장애\",\"k\":\"CAS와 마비말장애 감별\",\"p\":\"비일관성·모색행동 대 근력 저하·일관된 왜곡으로 두 장애 감별\",\"n\":\"CAS: 비일관 오류·모색·균등 강세, 마비말장애: 근력 저하·일관된 왜곡·느린 말속도\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 여아, 양측 심도 감각신경성 난청으로 2세에 양이 인공와우 이식. 최근 청능 평가\\n• Ling 6음 탐지·변별: 모두 가능\\n• 폐쇄형(그림 4장 제시) 낱말 확인: 90%\\n• 개방형(그림 없이 듣고 따라 말하기) 낱말 확인: 30%\\n• 짧은 이야기를 듣고 질문에 답하기: 거의 불가\",\"q\":\"청능훈련 위계에 따라 다음 단계로 적절한 활동은?\",\"choices\":[\"북소리와 종소리를 들려주고 소리가 났는지 안 났는지 손 들기\",\"'공'과 '곰' 그림 두 장을 보여 주고 들은 낱말의 그림 가리키기\",\"그림 없이 친숙한 낱말을 듣고 따라 말하며 범주 단서를 줄여 가기\",\"긴 이야기를 들려주고 등장인물과 사건을 순서대로 다시 말하기\",\"입 모양을 보고 낱말을 알아맞히는 독화 중심 연습으로 전환하기\"],\"answer\":3,\"explain\":\"청능훈련은 탐지 → 변별 → 확인 → 이해 순으로 진행하며, 확인 단계에서도 보기가 있는 폐쇄형에서 보기가 없는 개방형으로 난이도를 높인다. 이 아동은 탐지·변별과 폐쇄형 확인을 통과했으나 개방형 확인이 30%로 낮으므로, 보기 없이 낱말을 듣고 반응하는 개방형 확인 과제를 의미 범주 단서(예: '과일 이름이야')를 주었다가 점차 줄이며 훈련하는 것이 다음 단계이다. ①·②는 이미 통과한 탐지·폐쇄형 확인 수준, ④는 개방형 확인이 미완성인 상태에서 지나치게 어려운 이해 수준이며, ⑤는 청각 정보 처리를 훈련하는 청능훈련의 방향과 맞지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"청각·청각장애\",\"k\":\"청능훈련 위계 단계\",\"p\":\"폐쇄형 확인 통과·개방형 확인 30%로 다음 훈련 단계 선택\",\"n\":\"청능훈련: 탐지→변별→확인→이해, 확인 단계는 폐쇄형에서 개방형으로 진행\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"8세 남아, 양측 고주파수 경사형 감각신경성 난청(2 kHz 이상 60~70 dB HL), 양측 보청기 착용\\n• /ㅅ, ㅆ, ㅊ/ 생략 또는 약화, '옷'·'빗'처럼 마찰음이 든 낱말 구별이 어려움\\n• /ㅁ, ㄴ, ㅂ, ㄷ/와 모음은 정확\\n• 청각 모델만 반복해 들려주어도 /ㅅ/ 산출이 개선되지 않음\\n• 구강 구조·운동 기능 정상\",\"q\":\"이 아동의 오류 원인 해석과 중재 방향으로 가장 적절한 것은?\",\"choices\":[\"고주파수 마찰음을 잘 듣지 못한 오류로 보고 보청기 점검과 시각·촉각 단서를 병행한다\",\"마찰음의 파열음화가 지속된 음운지연이므로 최소대립쌍 변별 훈련만 실시한다\",\"혀 근력 부족으로 인한 조음장애이므로 비구어 구강운동 훈련을 먼저 충분히 실시한다\",\"저주파수 음소인 비음부터 다시 훈련하여 청각적 자신감을 높인 뒤 마찰음으로 넘어간다\",\"청각 단서를 더 크게 반복 제시하면 충분하므로 보청기 조정은 따로 필요하지 않다\"],\"answer\":1,\"explain\":\"/ㅅ, ㅆ, ㅊ/의 마찰 소음은 4~8 kHz의 고주파수에 에너지가 집중되어 있어 고주파수 손실이 큰 아동은 보청기를 착용해도 이 소리를 충분히 듣지 못하며, 그 결과 저주파수 에너지가 큰 비음·파열음·모음은 정확한데 마찰음만 생략·약화되는 양상이 나타난다. 청각 모델 반복이 효과가 없는 것도 같은 이유이다. 따라서 보청기 적합 상태(고주파수 이득, 주파수 하향 변환 기능)를 청각사에게 점검 의뢰하고, 청각으로 접근이 어려운 소리는 시각·촉각 단서로 산출을 확립하는 것이 적절하다. ②는 청력 손실이라는 원인을 무시한 해석이고, ③ 구강 기능 정상, ④ 이미 정확한 비음 훈련은 불필요, ⑤는 청각 접근 자체가 제한된 상황에서 효과가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"청각·청각장애\",\"k\":\"고주파 난청 마찰음 오류\",\"p\":\"고주파수 경사형 난청과 마찰음에 국한된 오류로 원인과 중재 판단\",\"n\":\"마찰음 에너지는 고주파수 집중, 보청기 점검과 시각·촉각 단서로 산출 확립\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아, 구개열 병력 없음, 구강 구조 정상\\n• /ㅅ, ㅆ/ 산출 시에만 콧구멍에서 기류가 새고 비강 마찰 소음이 들림\\n• 파열음·파찰음·/ㅎ/와 모음에서는 비강누출·과다비성 없음\\n• 나조미터 구강문장 비음치 정상 범위\\n• 코를 손으로 막고 /ㅅ/를 산출하게 하면 정조음 가능\",\"q\":\"이 아동에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"연인두폐쇄부전이 확실하므로 인두피판술을 위해 성형외과에 의뢰한다\",\"음소특정적 비강누출로 보고 구강 기류를 유도하는 조음치료를 실시한다\",\"과소비성이므로 비음이 든 낱말로 비음 산출 훈련을 먼저 실시한다\",\"구개거상기를 제작하여 착용시킨 뒤 /ㅅ/ 계열 조음치료를 시작한다\",\"청력 손실에 의한 마찰음 왜곡이므로 청력검사 결과가 나올 때까지 치료를 보류한다\"],\"answer\":2,\"explain\":\"비강누출이 특정 음소(/ㅅ, ㅆ/)에서만 나타나고 다른 압력자음과 모음은 정상이며 비음치도 정상이라면, 구조적 연인두폐쇄부전이 아니라 해당 음소를 비강 마찰음(인두·비강 통로)으로 잘못 학습한 음소특정적 비강누출이다. 이는 기질적 문제가 아니라 학습된 오조음이므로 수술(①)·구개거상기(④) 대상이 아니고, 코를 막았을 때 정조음이 가능하다는 점이 구강 기류 유도 조음치료의 근거가 된다. ③ 과다비성·과소비성이 아니며, ⑤ 다른 고주파수 음소가 정상이고 소견이 학습된 오류에 부합하므로 치료를 보류할 이유가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"음소특정적 비강누출\",\"p\":\"/ㅅ, ㅆ/에서만 비강누출되고 코를 막으면 정조음되는 양상으로 판단\",\"n\":\"음소특정적 비강누출: 학습된 오조음, 수술 아닌 구강 기류 유도 조음치료\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"생후 14개월 여아, 편측 완전 구순구개열로 3개월에 구순성형술, 12개월에 구개성형술을 받음\\n• 옹알이에서 [ʔaʔa], [hã], [mama] 위주로 산출하고 구강 파열음은 거의 나타나지 않음\\n• 반복성 중이염 병력이 있으나 현재 환기관 삽입 상태로 청력 정상\\n• 부모가 '말이 늦을까 봐' 걱정하며 상담을 요청함\",\"q\":\"이 시기의 중재 목표로 가장 적절한 것은?\",\"choices\":[\"비인두내시경으로 연인두 기능을 먼저 평가하고 그때까지 중재를 보류한다\",\"/ㅅ, ㅈ/ 등 후기 발달음을 독립음 수준에서 반복하여 따라 말하게 한다\",\"성문파열음도 발성 시도이므로 그대로 강화하여 발화량을 늘린다\",\"부모 교육으로 놀이 중 구강 앞쪽 파열음이 든 초기 낱말을 모델링·강화한다\",\"과다비성 감소를 위해 구개거상기를 제작하여 가정에서 착용시킨다\"],\"answer\":4,\"explain\":\"구개성형술 직후의 영아기 중재 목표는 구강 압력자음(특히 양순·치경 파열음)이 옹알이와 초기 낱말에 출현하도록 부모 중심의 모델링과 놀이로 촉진하고(예: [바바], [빠], [마마], [두] 같은 초기 낱말), 수술 전에 형성되기 쉬운 성문파열음 등 보상조음이 굳어지지 않게 하는 것이다. ① 이 연령에서는 협조가 어렵고 발화 표본이 충분히 쌓인 뒤(대개 3세 전후) 연인두 기능을 평가하므로 중재를 보류할 이유가 없다. ② 14개월에게 후기 발달음 독립음 훈련은 발달적으로 부적절하다. ③ 성문파열음을 강화하면 보상조음이 습관화된다. ⑤ 과다비성이 확인되지 않았고 영아에게 구개거상기는 적용하지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"구개성형술 후 영아 중재\",\"p\":\"구개성형술 직후 구강 파열음이 없는 옹알이로 중재 목표 선택\",\"n\":\"부모 중심 모델링으로 구강 앞쪽 파열음 출현 촉진, 성문파열음 등 보상조음 예방\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"9세 남아, 어두 /ㄹ/(탄설음) 왜곡. 12회기 치료 후\\n• 독립음·음절·낱말 수준 정확도 95% 이상(치료사가 매 시행마다 즉각 피드백)\\n• 매 회기 같은 낱말 목록을 같은 순서로 반복 연습함\\n• 문장·대화 수준 정확도 35%, 가정에서도 오류 지속\",\"q\":\"운동학습 원리에 근거하여 이 단계의 연습 조건을 수정한 것으로 가장 적절한 것은?\",\"choices\":[\"같은 낱말 목록을 더 많이 반복하고 매 시행 즉각 피드백을 유지한다\",\"낱말 연습을 중단하고 독립음 수준으로 돌아가 정확도를 100%로 만든다\",\"시각·촉각 단서를 늘려 낱말 수준의 정확도를 100%까지 더 높인다\",\"치료사가 혀끝 위치를 매 시행 설명하는 수행 지식(KP) 피드백을 늘린다\",\"여러 낱말·문맥을 무작위로 섞어 연습하고 KR 피드백 빈도를 줄인다\"],\"answer\":5,\"explain\":\"운동학습 원리에서 구획(blocked)·일정(constant) 연습과 빈번한 즉각 피드백·수행 지식(KP)은 습득(확립) 단계의 수행은 높이지만 파지·전이는 오히려 저해한다. 이미 낱말 수준에서 95% 이상 확립된 아동이 문장·대화로 일반화되지 않는다면, 무작위(random)·변동(variable) 연습으로 여러 낱말·문맥·과제를 섞고 피드백은 결과 지식(KR) 위주로 빈도를 낮추고 지연시켜 아동이 스스로 오류를 탐지·수정하게 해야 전이가 촉진된다. ①·④는 습득기 조건을 유지·강화하는 것이고, ②·③은 이미 확립된 단계로 되돌아가거나 단서 의존을 높여 일반화를 늦춘다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"운동학습 원리 연습 조건\",\"p\":\"낱말 수준 확립 후 문장·대화 일반화 실패로 연습 조건 수정\",\"n\":\"전이 촉진: 무작위·변동 연습, KR 위주로 피드백 빈도를 줄이고 지연\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아, 자음정확도 45%\\n• 산출 자음 목록: /ㅁ, ㄴ, ㅇ, ㅂ, ㅃ, ㄷ, ㄸ, ㄱ, ㄲ/\\n• 미습득 음소: /ㅍ, ㅌ, ㅋ, ㅅ, ㅆ, ㅈ, ㅉ, ㅊ, ㅎ, ㄹ/\\n• 여러 음소가 [ㄷ] 또는 [ㅂ]로 붕괴됨\",\"q\":\"최대대립(maximal opposition)·빈 집합(empty set) 원리에 따라 대립쌍을 선정할 때 가장 적절한 것은?\",\"choices\":[\"'살–달': 미습득 /ㅅ/와 습득 /ㄷ/의 자질 차이를 최소로 한 쌍\",\"'사–싸': 둘 다 미습득이지만 긴장성 자질 하나만 다른 쌍\",\"'코–소': 둘 다 미습득이고 위치·방법·기식성이 모두 다른 쌍\",\"'방–망': 이미 습득한 두 음소로 비음성 대조를 확인하는 쌍\",\"'토–코': 둘 다 미습득이지만 조음위치 자질 하나만 다른 쌍\"],\"answer\":3,\"explain\":\"최대대립 접근은 아동이 모르는 음소를 목표로 하되 대립하는 두 음소가 조음위치·조음방법·발성유형 등 여러 자질(가능하면 주요 부류까지)에서 최대한 다른 쌍을 사용하며, 특히 빈 집합(empty set)은 두 음소 모두 아동의 목록에 없는 쌍을 대조하여 음운 체계 전반의 재구조화와 폭넓은 일반화를 노린다. '코–소'는 /ㅋ/(연구개 파열 격음)와 /ㅅ/(치경 마찰 평음)가 모두 미습득이면서 위치·방법·기식성이 모두 다르므로 가장 부합한다. ①은 최소대립쌍 논리이고, ②·⑤는 둘 다 미습득이지만 자질 차이가 하나뿐이며, ④는 이미 습득한 음소끼리의 쌍이어서 치료 목표가 되지 않는다. ※ 최대대립·빈 집합의 정의와 자질 수 기준은 교재에 따라 표기가 다를 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"최대대립 빈 집합 쌍\",\"p\":\"미습득 음소 중 자질 차이가 가장 큰 두 음소로 대립쌍 선정\",\"n\":\"빈 집합: 두 음소 모두 미습득, 여러 자질이 최대한 다른 쌍으로 음운 체계 재구조화\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 6개월 남아, 청력·구강 구조·언어 이해 정상\\n• 어두 초성 생략(사과→[아과], 나비→[아비])과 치경음의 후방화(다리→[가리], 두부→[구부])가 모든 낱말에서 일관되게 나타남\\n• 같은 낱말 25개를 3회 산출했을 때 변이율 8%\\n• 모색행동·운율 이상 없음, 교대운동속도 정상\",\"q\":\"Dodd의 분류에 따른 유형과 그에 적합한 중재 접근은?\",\"choices\":[\"음운지연 – 발달 순서에 따른 전통적 조음 훈련\",\"일관적 음운장애 – 최소대립쌍 등 음운 대조 접근\",\"비일관적 음운장애 – 핵심어휘 접근으로 일관성 확립\",\"조음장애 – 조음점 지시법으로 개별 음소의 운동을 확립\",\"아동기 말실행증 – 촉각 단서 기반 PROMPT 훈련\"],\"answer\":2,\"explain\":\"어두 초성 생략과 후방화는 정상 발달에서 거의 나타나지 않는 비발달적(비전형적) 오류패턴이고, 변이율 8%로 일관되며 운동 결함이 없으므로 Dodd 분류의 일관적 음운장애이다. 이 유형은 음운 규칙(대조) 체계의 문제이므로 최소대립쌍·상위음운 접근 등 음운 대조 접근이 적합하다. ① 음운지연은 발달적 패턴이 늦게까지 남는 것, ③ 비일관적 음운장애는 변이율 40% 이상일 때, ④ 조음장애는 소수 음소의 일관된 왜곡, ⑤ 말실행증은 비일관성·모색·운율 이상을 동반할 때 해당한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"Dodd 일관적 음운장애\",\"p\":\"비발달적 오류패턴과 변이율 8%로 Dodd 유형과 중재 판단\",\"n\":\"일관적 음운장애: 비발달적 오류의 일관된 출현, 최소대립쌍 등 음운 대조 접근\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아, 아동기 말실행증 진단\\n• 산출 가능 자음 /ㅁ, ㅂ, ㄷ/, 모음 왜곡 다수\\n• 2음절 이상 낱말에서 음절 순서 오류·모색행동\\n• 자극반응도: 치료사와 동시에 천천히 말하면 [바], [마]는 산출 가능\",\"q\":\"동적 시간·촉각 단서법(DTTC)의 원리에 따른 중재 절차로 옳은 것은?\",\"choices\":[\"기능적 낱말을 동시 산출에서 시작해 단서를 점차 줄이며 집중 반복한다\",\"음운변동별 목표를 주기마다 순환하며 청각적 자극을 제공한다\",\"'말–발'과 같은 최소대립쌍의 의미 대조를 통해 음운 체계를 재구조화한다\",\"빨대 불기·혀 내밀기 등 비구어 구강운동으로 근력을 키운 뒤 말소리 훈련을 시작한다\",\"말소리 자질 개념(긴 소리/짧은 소리)을 상위언어적으로 인식시킨 뒤 산출로 넘어간다\"],\"answer\":1,\"explain\":\"DTTC(Strand)는 운동학습 원리에 기반한 말실행증 중재로, 통합자극(동시 산출)에서 시작해 아동의 수행에 따라 촉각·시각·청각 단서와 속도를 동적으로 조절하고, 직접 모방→지연 모방→자발 산출로 단서를 점차 소거하면서 자연스러운 속도·운율을 회복시키며, 소수의 기능적 목표를 집중적으로 많은 시행 반복하는 것이 핵심이다. ②는 주기법, ③은 최소대립쌍 접근, ⑤는 상위음운 접근으로 음운 체계 문제에 쓰는 방법이며, ④ 비구어 구강운동은 근력 결함이 없는 말실행증에 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동 말소리장애\",\"k\":\"DTTC 중재 절차\",\"p\":\"말실행증 아동의 동시 산출 시 자극반응도로 DTTC 절차 선택\",\"n\":\"DTTC: 동시 산출에서 시작해 단서를 동적으로 조절·소거, 기능적 목표 집중 반복\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 남아, 어두 /ㅅ/→[ㄷ] 대치. 표준화 낱말검사에는 /ㅅ/ 검사 낱말이 3개뿐이어서 촉진 문맥을 확인할 수 없었다.\",\"q\":\"촉진 문맥을 찾기 위한 심층검사(문맥검사) 자극 구성으로 가장 적절한 것은?\",\"choices\":[\"'사자, 사과, 사탕'처럼 /ㅏ/ 모음 앞 어두 문맥만 10회 반복 유도\",\"사자–자자 최소대립쌍을 듣고 같은지 다른지 판단하는 변별 과제\",\"긴 문장을 따라 말하게 하여 자발화에 가까운 /ㅅ/ 산출을 관찰\",\"인접 모음과 낱말 내 위치를 체계적으로 바꾼 음절·낱말을 반복 유도\",\"/ㅅ/를 독립음으로 길게 산출하게 하고 마찰 지속시간을 측정\"],\"answer\":4,\"explain\":\"문맥검사(심층검사)는 목표음이 정조음되는 촉진 문맥을 찾기 위해 인접 모음, 낱말 내 위치(어두·어중·연음 환경), 선행·후행 자음 등 음성 문맥을 체계적으로 변화시킨 다수의 자극으로 목표음을 반복 유도하는 검사이다(예: '사·시·수·세·소', '아사·이시·우수·에세·오소', '옷을·빗이'(연음)). ①은 한 문맥만 반복하므로 문맥 간 비교가 불가능하고, ②는 산출이 아닌 지각 검사, ③은 문맥 통제가 되지 않으며, ⑤는 독립음 지속시간 측정으로 문맥 효과와 무관하다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"문맥검사 자극 구성\",\"p\":\"표준화 검사의 목표음 낱말 부족으로 심층검사 자극 구성 판단\",\"n\":\"문맥검사: 인접 모음·낱말 내 위치 등 문맥을 체계적으로 바꿔 촉진 문맥 탐색\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"2세 2개월 남아의 자발화 표본(부모 보고 및 관찰)\\n[마], [마마], [빠], [바바], [뿌], [암], [빠빠], [무], [아빠], [엄마]\\n(부모가 알아들은 의도: 엄마, 밥, 물, 아빠, 안아 등)\",\"q\":\"독립분석(independent analysis)의 결과로 옳은 것은?\",\"choices\":[\"종성생략이 대부분의 낱말에서 나타난다\",\"자음정확도(PCC)는 약 80%이다\",\"연구개음 전방화가 일관되게 나타난다\",\"치경음 /ㄷ, ㄴ/이 초성 목록에 포함된다\",\"초성 자음 목록은 양순음으로 제한된다\"],\"answer\":5,\"explain\":\"독립분석은 성인 목표형과 비교하지 않고 아동이 실제 산출한 말소리 목록과 음절구조를 그 자체로 기술한다. 표본에서 초성 자음은 [ㅁ, ㅂ, ㅃ]뿐이고 종성은 [암], [엄마]의 /ㅁ/만 나타나며, 음절구조는 CV([마], [빠], [뿌], [무]), VC([암]), CVCV([마마], [바바], [빠빠]), VCV([아빠]), VCCV([엄마])로 제한된다. ①·②·③은 목표형과 비교해야 알 수 있는 관계분석 항목이고, ④ 치경음은 표본에 전혀 나타나지 않는다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"독립분석 결과 기술\",\"p\":\"2세 아동 자발화의 산출 자음과 음절구조를 목표형과 비교 없이 기술\",\"n\":\"독립분석: 성인 목표형과 비교 없이 아동이 산출한 말소리 목록·음절구조 기술\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 여아. '가위', '고기', '거울'에서 /ㄱ/을 정조음한다.\",\"q\":\"다음 오류 가운데 동화(assimilation)로 분석해야 하는 것은?\",\"choices\":[\"가방 /kabaŋ/ → [pabaŋ]\",\"토끼 /tʰok*i/ → [tok*i]\",\"시소 /ɕiso/ → [tido]\",\"라면 /ɾamjʌn/ → [jamjʌn]\",\"책 /tɕʰɛk̚/ → [tɕʰɛ]\"],\"answer\":1,\"explain\":\"동화는 낱말 안의 다른 소리의 영향을 받아 목표음이 그 소리와 같거나 비슷하게 바뀌는 문맥 의존적 오류이다. '가방 /kabaŋ/→[pabaŋ]'은 뒤에 오는 양순음 /b/의 영향으로 /k/가 [p]로 바뀐 역행 양순음 동화이며, 아동이 '가위·고기·거울'에서는 /ㄱ/을 정조음한다는 점이 문맥에 의한 동화임을 뒷받침한다. ②는 격음→평음의 탈기식음화, ③은 마찰음의 파열음화(낱말 안에 영향을 줄 파열음이 없음), ④는 유음의 활음화, ⑤는 종성생략으로 모두 문맥과 무관한 대치·생략 변동이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"역행 양순음 동화\",\"p\":\"다른 낱말의 /ㄱ/ 정조음과 뒤따르는 양순음의 영향으로 동화 판단\",\"n\":\"동화: 낱말 안 다른 소리의 영향으로 목표음이 그 소리와 닮아 가는 문맥 의존적 오류\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"3세 남아, 양측 중등고도(65~70 dB HL) 감각신경성 난청. 보청기 착용 6개월\\n• 보청 상태 음장 역치: 전 주파수 25~30 dB HL\\n• Ling 6음 탐지·확인 모두 가능, 보청기 착용 후 낱말 산출이 빠르게 증가\\n• 부모가 인공와우 수술을 받아야 하는지 문의함\",\"q\":\"언어재활사의 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"심도 난청이 아니어도 3세 이전 조기 이식이 원칙이므로 즉시 수술을 권한다\",\"보청기 이득이 충분하므로 현재 중재를 지속하며 청력과 발달을 추적한다\",\"보청기 이득이 확인되었으므로 청능훈련은 종결하고 조음치료만 진행한다\",\"감각신경성 난청은 보청기 효과가 없으므로 골도 보청기로 교체한다\",\"한쪽 귀만 인공와우를 이식하고 반대쪽 귀의 보청기는 제거하도록 한다\"],\"answer\":2,\"explain\":\"인공와우는 일반적으로 양측 고도~심도 감각신경성 난청이면서 적절한 보청기 착용에도 말소리 접근·청능 발달 이득이 제한적일 때 적응증이 된다. 이 아동은 중등고도 난청이지만 보청 역치가 말소리 범위(25~30 dB HL)에 들어오고 Ling 6음 확인과 낱말 산출이 빠르게 늘고 있으므로 보청기 이득이 충분하다. 따라서 보청기와 청능·언어 중재를 지속하며 청력 변동(진행성 여부)과 발달을 추적하는 것이 적절하고, 최종 판단은 이비인후과·청각사와 협진한다. ①·⑤는 적응증 미충족, ③ 청능훈련은 이득이 있어도 지속해야 하며, ④ 골도 보청기는 전음성·편측 난청 등에 쓰이고 감각신경성 난청도 기도 보청기 효과가 있다. ※ 인공와우 적응증의 세부 역치 기준(국내 급여 기준 등)은 시기·기관에 따라 다를 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"청각·청각장애\",\"k\":\"인공와우 문의 부모 상담\",\"p\":\"중등고도 난청 아동의 보청 역치와 청능 발달로 인공와우 문의 상담\",\"n\":\"인공와우는 고도~심도 난청에 보청기 이득이 제한될 때 적응증, 이득 충분하면 중재 지속\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아, 인공와우 착용 3년, 개방형 문장 지각 80%\\n• /ㅅ/를 [ʃ]에 가깝게 왜곡, /ㅈ/를 [ㄷ]로 대치\\n• 치료사가 입 모양을 보여 주면 정조음하지만 청각 자극만 주면 오류가 지속됨\\n• 자신의 산출 오류를 듣고 알아채지 못함\",\"q\":\"청각 활용(auditory-verbal) 원리에 따른 중재로 가장 적절한 것은?\",\"choices\":[\"매 시행 입 모양 시범을 먼저 제시하여 정확도를 빠르게 높인다\",\"청각 단서를 배제하고 촉각 단서만 사용하여 조음 위치를 익힌다\",\"독화(입술 읽기) 훈련을 병행하여 부족한 청각 지각을 보완한다\",\"청각 단서를 우선 제시하고 청각 자기 모니터링을 훈련한다\",\"왜곡 오류는 명료도에 영향이 적으므로 /ㅈ/ 대치만 치료한다\"],\"answer\":4,\"explain\":\"인공와우로 개방형 문장 지각이 80%에 이르는 아동은 청각 경로로 말소리를 학습할 수 있으므로, 청각 활용 원리에 따라 청각 단서를 우선 제시하고(음향적 강조) 시각·촉각 단서는 보조적으로 잠시만 사용한 뒤 다시 청각 단서로 돌아가야 청각 피드백에 기반한 자기 모니터링이 발달한다. 이 아동은 시각 단서에 의존하고 자기 오류를 듣지 못하므로 청각 자기 모니터링 훈련이 특히 필요하다. ①·③은 시각 의존을 강화하고, ②는 잘 발달한 청각 경로를 버리는 것이며, ⑤ /ㅅ/ 왜곡도 청각 피드백을 활용해 수정할 수 있는 목표이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"청각·청각장애\",\"k\":\"청각 활용 원리 중재\",\"p\":\"시각 단서 의존과 자기 오류 미인식으로 청각 우선 중재 선택\",\"n\":\"청각 활용 원리: 청각 단서 우선, 시각·촉각은 잠시 보조, 청각 자기 모니터링 훈련\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아, 어두 /ㄱ/ 전방화. 확립 단계 치료계획서를 작성하려 한다.\",\"q\":\"측정 가능한 단기 행동목표로 가장 적절하게 진술된 것은?\",\"choices\":[\"아동은 치료 후 /ㄱ/ 소리를 여러 낱말에서 잘 낼 수 있다\",\"아동은 연구개음 /ㄱ/의 조음 위치와 조음 방법을 이해한다\",\"아동은 청각 모델 후 어두 /ㄱ/ 낱말을 3회기 연속 80% 이상 정조음한다\",\"치료사는 거울과 설압자를 이용하여 아동에게 /ㄱ/의 조음점을 지시한다\",\"아동은 가정과 학교의 대화 상황에서 /ㄱ/ 오류를 보이지 않는다\"],\"answer\":3,\"explain\":\"행동목표는 수행 주체(아동), 관찰 가능한 행동(정조음), 조건(청각 모델 후, 어두 /ㄱ/ 낱말), 준거(3회기 연속 80% 이상)를 포함해야 측정·판정이 가능하다. ①·②는 '잘', '이해'처럼 관찰·측정할 수 없고, ④는 아동의 행동이 아닌 치료사의 활동이며, ⑤는 측정 기준(몇 회, 몇 %)이 불분명하고, 확립 단계가 아닌 일반화 단계의 장기목표 수준 진술이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"단기 행동목표 진술\",\"p\":\"주체·행동·조건·준거 포함 여부로 측정 가능한 목표 진술 판단\",\"n\":\"행동목표: 수행 주체·관찰 가능한 행동·조건·준거를 포함해야 측정 가능\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"11세 남아, /ㅅ, ㅆ/ 치간음화 왜곡 잔존(다른 음소 정상). 청각 변별은 정상이나 자신의 산출을 조절하지 못해 실시간 스펙트로그램 시각 피드백을 도입하려 한다.\",\"q\":\"피드백 화면에서 아동에게 목표로 제시할 음향 지표로 가장 적절한 것은?\",\"choices\":[\"모음의 제1·제2 포먼트 위치\",\"기본주파수(F0)의 높이\",\"파열음의 성대진동 시작시간(VOT)\",\"마찰 구간을 포함한 음절 지속시간\",\"마찰 소음의 에너지 집중 주파수 대역\"],\"answer\":5,\"explain\":\"정상 /ㅅ, ㅆ/는 혀끝이 치조에 좁은 틈을 만들어 4 kHz 이상 고주파수에 에너지가 집중된 마찰 소음을 만든다. 혀가 앞니 사이로 나오는 치간음화는 마찰 소음의 에너지가 낮은 주파수로 분산·약화되므로, 스펙트로그램에서 마찰 구간 소음 에너지가 고주파수 대역에 집중되도록 시각 목표를 제시하는 것이 적절하다. 포먼트(①)는 모음·유음 왜곡, F0(②)는 음도, VOT(③)는 파열음 발성유형, 지속시간(④)은 말속도·운율 피드백에 해당한다. ※ 마찰 소음의 구체적 주파수 기준값은 화자·교재에 따라 다를 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성학·음운론 기초\",\"k\":\"치간음화 시각 피드백 지표\",\"p\":\"/ㅅ/ 치간음화 교정용 스펙트로그램에서 제시할 음향 지표 선택\",\"n\":\"정상 /ㅅ/: 고주파수에 에너지가 집중된 마찰 소음, 치간음화는 낮은 주파수로 분산\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 9개월 여아, /ㅈ/→[ㄷ], /ㅋ/→[ㄷ] 오류. 자극반응도 검사 결과\\n• /ㅈ/: 독립음·음절·낱말 수준 모두 모방 불가(시각·촉각 단서를 주어도 불가)\\n• /ㅋ/: 독립음 모방 가능, 음절 '카'·'쿠'는 청각+시각 단서로 가능, 낱말 수준은 불가\",\"q\":\"자극반응도 결과의 해석과 활용으로 옳은 것은?\",\"choices\":[\"/ㅋ/는 음절 수준부터 확립하고, /ㅈ/는 조음 위치·방법 지시부터 시작한다\",\"/ㅈ/는 자극반응도가 없으므로 자연 회복 가능성이 높아 치료에서 제외한다\",\"자극반응도는 낱말 수준에서만 평가하므로 두 음소 모두 자극반응도가 없다\",\"/ㅋ/는 낱말 수준에서 산출하지 못하므로 자극반응도가 없다고 판정한다\",\"자극반응도가 있는 /ㅋ/는 저절로 습득되므로 /ㅈ/만 치료 목표로 삼는다\"],\"answer\":1,\"explain\":\"자극반응도는 독립음·음절·낱말 등 여러 수준에서 단서·모방 조건으로 평가하며, 어느 수준에서든 산출이 가능하면 자극반응도가 있다고 본다. /ㅋ/는 음절 수준까지 가능하므로 예후가 좋고 가능한 수준에서 단서를 소거하며 빠르게 확립할 수 있다. 자극반응도가 없는 /ㅈ/는 자연 회복 가능성이 낮아 치료가 필요하고, 모방이 되지 않으므로 청지각 훈련과 조음점 지시 등 직접적 확립 절차부터 시작한다. ②는 자극반응도와 자연 회복의 관계를 반대로 기술했고, ③·④는 평가 수준을 잘못 제한했으며, ⑤ 자극반응도가 있어도 반드시 저절로 습득되는 것은 아니다. ※ 자극반응도가 없는 음소를 먼저 목표로 하는 복잡성 접근의 논리도 있으나, 자극반응도가 있는 음소를 치료 대상에서 제외하는 것은 어느 접근에서도 타당하지 않음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"자극반응도 해석과 활용\",\"p\":\"음소별로 다른 모방 가능 수준으로 치료 시작 수준 판단\",\"n\":\"자극반응도: 어느 수준이든 산출 가능하면 있음, 없으면 조음점 지시 등 확립부터\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 4개월 남아(취학 전)\\n• /ㅅ, ㅈ/의 파열음화가 지속되고 낱말 수준 정확도 50%\\n• 음운인식 평가: 음절 수 세기·음절 합성은 가능, 첫소리 변별('사'와 '다'의 첫소리가 같은가)·음소 탈락은 불가\\n• 부모는 입학 전 읽기 준비를 걱정함\",\"q\":\"말소리 산출과 읽기 준비를 함께 고려한 중재로 가장 적절한 것은?\",\"choices\":[\"읽기 문제는 별개이므로 조음치료를 종결한 뒤 음운인식 훈련을 시작한다\",\"/ㅅ, ㅈ/가 든 낱말로 첫소리 변별 활동과 산출 연습을 결합한다\",\"음절 수 세기 활동만 반복하여 음운인식의 기초를 먼저 다진다\",\"음소 탈락 과제부터 시작하여 가장 어려운 수준을 먼저 훈련한다\",\"한글 자모 이름 외우기를 조음치료보다 우선하여 실시한다\"],\"answer\":2,\"explain\":\"말소리장애 아동, 특히 취학 직전까지 오류가 지속되는 아동은 음운인식·읽기 어려움의 위험이 높으므로 산출 중재에 음운인식 활동을 통합하는 것이 권장된다. 이 아동은 음절 수준은 통과했고 음소 수준(첫소리 변별)에서 실패하므로, 목표음이 든 낱말로 첫소리 변별·짝 맞추기 등 음소 수준 활동을 하면서 자소 단서를 결합해 산출을 연습하면 두 영역을 동시에 촉진할 수 있다. ①은 통합 중재의 이점을 버리고, ③은 이미 가능한 수준의 반복, ④는 발달 순서를 무시한 가장 어려운 과제, ⑤ 자모 이름 암기는 음소 인식·산출과 직접 관련이 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음운인식\",\"k\":\"산출·음운인식 통합 중재\",\"p\":\"음절 수준 통과·음소 수준 실패와 지속되는 파열음화로 통합 중재 선택\",\"n\":\"말소리장애 아동은 읽기 위험, 목표음 낱말로 음소 수준 음운인식과 산출 연습 결합\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"13세 여학생, /ㅅ, ㅆ, ㅈ, ㅊ/의 치간음화(혀끝이 앞니 사이로 나옴) 왜곡\\n• 개방교합(앞니가 다물어지지 않음), 안정 시 혀 내밀기, 삼킴 시 혀 밀기 관찰\\n• 치과 교정 계획 중\\n• 자극반응도: 거울 단서로 혀끝을 앞니 뒤에 두게 하면 산출 가능\",\"q\":\"가장 적절한 중재 계획은?\",\"choices\":[\"교정 치료가 끝날 때까지 조음치료를 보류하고 경과를 관찰한다\",\"혀 밀기 삼킴과 무관하므로 /ㅅ/ 계열 조음치료만 실시한다\",\"치과와 협진하여 구강근기능 훈련과 /ㅅ/ 계열 조음치료를 병행한다\",\"혀 근력이 약한 것이 원인이므로 혀 저항 운동만 집중 실시한다\",\"사춘기 이후에는 조음 교정이 어려우므로 보호자에게 치료 불가를 안내한다\"],\"answer\":3,\"explain\":\"개방교합·안정 시 혀 내밀기·혀 밀기 삼킴과 치간음화가 함께 나타나는 경우, 혀 밀기 습관은 교정 후 재발(교합 재개방)의 원인이 되고 치간음화 지속과도 관련되므로 치과 협진 아래 구강근기능 훈련(안정 시 혀 위치, 삼킴 패턴)과 조음치료를 병행하는 것이 적절하다. 자극반응도가 있으므로 시각 단서로 혀끝을 치조에 두는 산출을 확립하고 자기 모니터링으로 일반화한다. ①은 습관이 굳어지고 교정 효과를 해칠 수 있으며, ②는 재발 요인을 방치하고, ④ 근력 저하의 근거가 없으며, ⑤ 청소년·성인도 잔존오류 치료가 가능하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"혀 밀기 동반 치간음화\",\"p\":\"개방교합·혀 밀기 삼킴과 치간음화 동반으로 협진 중재 선택\",\"n\":\"혀 밀기 습관은 교정 후 재발 요인, 치과 협진 아래 구강근기능 훈련과 조음치료 병행\"}},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"3세 8개월 남아, 자음정확도 55%\\n• 할아버지 /haɾabʌdʑi/ → [habʌdʑi], 자전거 /tɕadʑʌngʌ/ → [tɕagʌ], 냉장고 /nɛŋdʑaŋgo/ → [nɛŋgo]\\n• 코끼리 /kʰok*iɾi/ → [kʰok*i], 크레파스 /kʰɯɾepʰasɯ/ → [pʰasɯ]\\n• 1~2음절 낱말은 비교적 정확하며 각 음소는 단독으로 산출 가능\",\"q\":\"이 오류 양상에 대한 분석과 중재로 가장 적절한 것은?\",\"choices\":[\"종성생략이 주된 문제이므로 종성 /ŋ, l/을 먼저 확립하는 음소 중심 중재를 한다\",\"연구개음 전방화가 주된 문제이므로 /k, kʰ/를 목표로 최소대립쌍 중재를 한다\",\"개별 음소 오류가 주된 문제이므로 음소별 전통적 조음 접근으로 정확도를 높인다\",\"음절 생략이 주된 문제이므로 음절 수를 늘려 가며 박수 등 리듬 단서로 산출을 돕는다\",\"비일관적 음운장애이므로 핵심어휘 접근으로 자주 쓰는 낱말의 산출 일관성을 높인다\"],\"answer\":4,\"explain\":\"오류는 모두 3음절 이상 낱말에서 음절 전체가 탈락하는 음절 생략(다음절 축약)으로, 음소가 아니라 음절구조·낱말 길이의 문제이다. 따라서 음절 수를 단계적으로 늘리며 박수·리듬으로 각 음절을 표시하는 운율 단서를 활용해 모든 음절을 산출하게 하는 음절구조 중재가 적절하다. ① 종성만 생략된 것이 아니라 음절째 사라진 것이며 [nɛŋgo]에서 종성 /ŋ/은 정확하고, ② 연구개음은 [kʰok*i], [nɛŋgo], [tɕagʌ]에서 정확하며, ③ 각 음소는 단독으로 산출 가능하므로 음소별 전통적 접근은 문제의 본질과 맞지 않고, ⑤ 같은 낱말을 매번 다르게 산출한다는 비일관성의 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"음절 생략 중재\",\"p\":\"3음절 이상 낱말의 음절 탈락과 음소 단독 산출 가능으로 오류 분석\",\"n\":\"음절 생략: 음절구조·낱말 길이 문제, 음절 수를 늘리며 박수 등 리듬 단서 활용\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"[그림 1]은 7세 지적장애 아동의 '두 낱말 요구 발화' 정반응률을 A-B 설계로 측정한 결과이다(1~5회기 기초선, 6~15회기 중재).\",\"q\":\"[그림 1]에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"기초선 자료의 변동 폭이 커서 안정적이지 않으므로 중재를 시작하기에 부적절한 시점이었다\",\"중재 첫 회기(6회기)부터 기초선 최고점을 초과하였으므로 즉각적인 수준 변화가 확인된다\",\"PND는 90%이지만 A-B 설계이므로 중재의 인과적 효과로 단정할 수 없다\",\"중재기 자료점이 모두 기초선 최고점을 초과하므로 PND는 100%이며 실험적 통제가 입증되었다\",\"기초선과 중재기의 평균 차이가 크므로 반전(A2) 구간 없이도 기능적 관계가 실험적으로 입증되었다\"],\"answer\":3,\"explain\":\"그래프 값: 기초선 20, 25, 20, 30, 25(범위 20~30, 최고점 30, 상승 추세 없음 → 비교적 안정적), 중재기 30, 35, 45, 50, 60, 65, 70, 75, 80, 85. PND는 기초선 최고점(30)을 '초과'하는 중재기 자료점의 비율로, 6회기 값 30은 최고점과 같아 제외되므로 9/10 = 90%이다(④의 100%는 오류). 6회기는 최고점을 초과하지 않았으므로 ②도 틀렸다. 기초선은 10%p 범위에서 안정적이므로 ①은 부적절하다. A-B 설계는 반전이나 중다기초선처럼 효과의 반복 입증이 없어 실험적 통제(기능적 관계)를 입증하지 못하므로 ④·⑤처럼 인과 관계를 단정할 수 없다. ※PND 산출 시 '초과' 기준과 해석 절단점은 교재별로 확인 권장.\",\"image\":\"data:image/svg+xml;base64,\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"연구·통계\",\"k\":\"A-B 설계 PND 해석\",\"p\":\"기초선 최고점을 초과한 중재기 자료점 비율과 설계 한계로 효과 해석\",\"n\":\"PND: 기초선 최고점을 초과하는 중재기 자료점 비율, A-B 설계는 인과 단정 불가\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"8세 지적장애 아동에게 '조사 -을/를 포함한 3어절 문장 산출'을 목표로 ABAB 설계를 적용하였다.\\n• A1(기초선 5회기): 10~15%\\n• B1(중재 8회기): 점진적 상승 후 70% 도달\\n• A2(중재 철회 5회기): 65~70%로 유지\\n• B2(중재 재도입 5회기): 72~78%\",\"q\":\"이 결과에 대한 해석과 후속 판단으로 가장 적절한 것은?\",\"choices\":[\"A2에서 수행이 유지된 것은 중재 효과가 강력하다는 실험적 증거이므로 기능적 관계가 입증되었다\",\"A2에서 기초선 수준으로 되돌아가지 않아 기능적 관계를 입증하지 못했으며 중다기초선 설계가 더 적합했다\",\"B1의 상승은 우연에 의한 것이므로 중재는 효과가 없었다고 결론 내리고 중재를 종료한다\",\"기능적 관계를 입증하기 위해 행동이 기초선 수준으로 떨어질 때까지 A2 구간을 무기한 연장한다\",\"A2 자료는 관찰자 기록 오류로 간주하여 분석에서 제외하고 B1·B2 자료만으로 효과를 판단한다\"],\"answer\":2,\"explain\":\"ABAB 설계는 중재 철회 시 행동이 기초선 방향으로 되돌아가고 재도입 시 다시 개선되는 '반복 입증'으로 기능적 관계를 보여 준다. A2에서 수행이 그대로 유지되면 B1의 변화가 중재 때문인지 성숙·연습 등 외부 요인 때문인지 구분할 수 없어 실험적 통제가 입증되지 않는다(①은 반대로 해석). 한 번 학습되면 되돌리기 어려운 언어 기술(비가역성)에는 반전을 요구하지 않는 중다기초선 설계가 적합하다. 중재 효과가 없었다고 단정하거나(③), 윤리적으로 문제가 되는 무기한 철회(④), 자료 임의 제외(⑤)는 부적절하다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"연구·통계\",\"k\":\"ABAB 설계 반전 실패\",\"p\":\"중재 철회 구간에서 수행이 유지된 결과로 기능적 관계 입증 여부 판단\",\"n\":\"ABAB: 철회 시 기초선 복귀로 반복 입증, 비가역적 기술에는 중다기초선 설계 적합\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"6세 말소리장애 아동 1명에게 전통적 조음치료와 최소대립쌍 치료 중 어느 것이 더 효과적인지 알아보기 위해, 한 회기 안에서 두 중재를 번갈아 실시하는 교대중재 설계를 계획하였다.\",\"q\":\"이 설계의 내적 타당도를 확보하기 위한 절차로 가장 적절한 것은?\",\"choices\":[\"두 중재를 동일한 목표 음소에 적용하여 비교 조건을 같게 만들고 회기마다 번갈아 실시한다\",\"실시 순서를 매 회기 고정하여 절차의 일관성을 높이고 아동의 예측 가능성을 확보한다\",\"기초선 측정을 생략하고 중재 종료 후 두 중재의 최종 정반응률만 t검정으로 비교한다\",\"두 중재에 난이도가 동등한 서로 다른 목표 음소를 배정하고 실시 순서를 역균형화한다\",\"아동이 더 좋아하는 중재를 매 회기 먼저 실시하여 동기를 유지하고 참여를 높인다\"],\"answer\":4,\"explain\":\"교대중재 설계의 주요 위협은 한 중재의 효과가 다른 중재로 번지는 다중처치 간섭(이월 효과)과 순서 효과이다. 이를 통제하려면 각 중재에 독립적이면서 난이도가 동등한 목표 세트를 배정하고 실시 순서를 역균형화(counterbalancing)해야 한다. 같은 목표 음소에 두 중재를 적용하면(①) 효과가 섞여 구분되지 않고, 순서 고정(②·⑤)은 순서 효과를 혼입시키며, 단일대상연구에서 기초선 생략과 t검정만의 비교(③)는 설계 논리에 맞지 않는다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"교대중재 설계 내적 타당도\",\"p\":\"한 회기 안 두 중재 교대 시 이월·순서 효과의 통제 절차 판단\",\"n\":\"교대중재 설계: 난이도가 동등한 독립 목표 세트 배정과 실시 순서 역균형화\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 5분 만에 실시할 수 있는 학령전 어휘 선별검사를 개발하였다. 타당화를 위해 아동 120명에게 새 선별검사와 기존 표준화 어휘검사를 같은 날 실시하고 두 점수 간 상관(r = .82)을 구하였다.\",\"q\":\"이 절차로 확인하려는 것은?\",\"choices\":[\"공인타당도\",\"예측타당도\",\"내용타당도\",\"검사-재검사 신뢰도\",\"반분 신뢰도\"],\"answer\":1,\"explain\":\"공인(동시)타당도는 새 검사와 이미 타당성이 확립된 준거 검사를 '같은 시점'에 실시하여 상관을 구하는 준거관련 타당도이다. 예측타당도는 일정 기간 후의 준거(예: 1년 후 언어장애 진단 여부)를 예측하는 정도, 내용타당도는 문항이 측정 영역을 대표하는지에 대한 전문가 판단, 검사-재검사 신뢰도는 같은 검사를 시간 간격을 두고 두 번 실시한 일관성, 반분 신뢰도는 한 검사를 두 부분으로 나누어 얻는 내적 일관성이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"공인타당도 확인 절차\",\"p\":\"새 검사와 기존 표준화 검사를 같은 날 실시한 상관으로 타당도 유형 판단\",\"n\":\"공인타당도: 새 검사와 확립된 준거 검사를 같은 시점에 실시해 구한 상관\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"연구 요약\\n• 실어증 환자 16명을 무작위로 중재집단(8명)과 대기집단(8명)에 배정\\n• 8주 이름대기 중재 후 사후 점수 비교: p = .08 (유의수준 .05), Cohen's d = 0.92\\n• 사전 동질성 확인, 중도 탈락 없음\",\"q\":\"이 결과에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"통계적으로 유의하지 않으므로 이 중재는 효과가 없다고 결론 내린다\",\"효과크기는 통계적 유의성보다 중요하지 않으므로 보고에서 제외한다\",\"p 값이 .05에 근접하므로 이 결과에서는 1종 오류가 발생하였다고 본다\",\"유의수준을 .10으로 사후 조정하여 중재 효과가 유의한 것으로 보고한다\",\"표본이 작아 검정력이 낮을 수 있으므로 더 큰 표본으로 반복 연구한다\"],\"answer\":5,\"explain\":\"집단당 8명은 매우 작은 표본이어서 검정력이 낮고, 실제 효과가 있어도 유의하지 않게 나올(2종 오류) 가능성이 크다. Cohen's d 0.92는 큰 효과에 해당하므로 '효과 없음'(①)으로 단정할 수 없고, 효과크기는 유의성과 함께 보고해야 한다(②). 1종 오류는 효과가 없는데 있다고 판단하는 오류이므로(③) 상황에 맞지 않고, 결과를 본 뒤 유의수준을 올리는 것(④)은 연구 윤리와 통계 원칙에 어긋난다. ※효과크기 해석 기준(0.2/0.5/0.8)은 교재별 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"연구·통계\",\"k\":\"작은 표본 검정력 해석\",\"p\":\"집단당 8명·p=.08·큰 효과크기로 유의하지 않은 결과의 의미 판단\",\"n\":\"작은 표본은 검정력이 낮아 2종 오류 가능, d 0.92는 큰 효과로 효과 없음 단정 불가\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"만 4세 아동 80명에게 언어 선별검사를 실시하고, 전원에게 정밀 언어평가를 실시하여 언어장애 여부를 확정하였다.\\n• 정밀평가 결과 언어장애: 16명, 비장애: 64명\\n• 선별검사 '양성': 언어장애 아동 16명 중 14명, 비장애 아동 64명 중 16명\",\"q\":\"이 선별검사의 정확도에 대한 설명으로 옳은 것은?\",\"choices\":[\"민감도는 75%, 특이도는 87.5%이다\",\"민감도는 87.5%, 특이도는 75%이다\",\"민감도는 30명 중 14명인 46.7%이다\",\"특이도는 64명 중 16명이므로 25%이다\",\"위양성률은 16명 중 2명이므로 12.5%이다\"],\"answer\":2,\"explain\":\"민감도 = 실제 장애 아동 중 선별 양성 비율 = 14/16 = 87.5%. 특이도 = 실제 비장애 아동 중 선별 음성 비율 = (64−16)/64 = 48/64 = 75%. ①은 두 값을 바꾼 것이다. ③의 14/30(=46.7%)은 양성예측도이지 민감도가 아니다. 16/64 = 25%는 특이도가 아니라 위양성률이므로 ④는 틀렸다. ⑤의 2/16(=12.5%)은 장애 아동을 놓친 위음성률이며, 위양성률은 16/64 = 25%이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"연구·통계\",\"k\":\"선별검사 민감도·특이도\",\"p\":\"정밀평가 기준 장애·비장애 아동의 선별 양성 수로 정확도 산출\",\"n\":\"민감도: 실제 장애 아동 중 양성 비율, 특이도: 실제 비장애 아동 중 음성 비율\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 3세 아동의 언어평가 보고서를 작성하고 있다. 아동은 검사 중 눈맞춤과 공동주의가 제한되었고, 검사자의 지시에 반응하지 않는 경우가 잦았으며, 어머니는 직장 때문에 아동과 보내는 시간이 적다고 보고하였다.\",\"q\":\"평가보고서에 기술할 문장으로 가장 적절한 것은?\",\"choices\":[\"검사 중 관찰된 행동으로 보아 아동은 자폐스펙트럼장애로 진단됨\",\"어머니의 양육 시간 부족이 언어지연의 원인으로 판단됨\",\"아동이 게으르고 비협조적이어서 검사 결과는 신뢰할 수 없음\",\"관찰된 사회적 의사소통 특성을 기술하고 전문의 의뢰를 권고함\",\"수용어휘 원점수가 35점이므로 심각한 수준의 언어지체로 판단됨\"],\"answer\":4,\"explain\":\"보고서는 관찰된 행동(눈맞춤·공동주의 제한, 지시 반응의 비일관성)을 객관적으로 기술하고, 그 함의에 따라 사회적 의사소통 특성의 감별을 위한 소아정신건강의학과 의뢰 등 권고를 제시해야 한다(④). 자폐스펙트럼장애의 확정 진단은 의사의 영역이므로 언어재활사가 '진단됨'이라고 쓰는 것(①)은 업무 범위를 벗어나고, 근거 없는 인과 귀인(②)이나 가치 판단적 표현(③)은 부적절하다. 원점수만으로 지체 정도를 판정하는 것(⑤)은 규준 참조(표준점수·백분위·등가연령) 없이 해석한 오류이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"윤리·역할\",\"k\":\"평가보고서 기술 원칙\",\"p\":\"눈맞춤·공동주의 제한 관찰을 보고서에 기술하는 적절한 방식 판단\",\"n\":\"관찰 행동은 객관적으로 기술하고 전문의 의뢰 권고, 자폐 확정 진단은 의사의 영역\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"대학 부설 언어치료실에서 학생 임상가가 '임상 슈퍼비전 목적'이라고 명시된 동의서를 보호자에게 받고 회기를 녹화하였다. 이후 지도교수가 이 영상을 학부 강의 자료로 사용하고자 한다.\",\"q\":\"가장 적절한 조치는?\",\"choices\":[\"동의서의 목적을 벗어나므로 강의 활용에 대한 별도 동의를 새로 받는다\",\"이미 녹화에 대한 동의를 받았으므로 추가 동의 없이 사용할 수 있다\",\"얼굴을 모자이크 처리하여 식별할 수 없게 하면 동의 없이 사용할 수 있다\",\"교육 목적의 활용은 개인정보 이용 동의의 예외이므로 사용할 수 있다\",\"치료가 종결된 후에는 기관 소유 자료이므로 자유롭게 사용할 수 있다\"],\"answer\":1,\"explain\":\"개인정보(영상)는 동의받은 목적 범위 안에서만 이용할 수 있으며, 목적이 달라지면(슈퍼비전 → 강의) 활용 목적·범위·대상을 명시한 별도 동의를 보호자에게 새로 받아야 한다. 모자이크를 하더라도 음성·발화 내용 등으로 식별 가능성이 남고, 교육 목적이라는 이유만으로 동의가 면제되지 않으며, 치료 종결이나 기관 보관 여부는 이용 목적 제한을 해제하지 않는다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"녹화 영상 목적 외 이용\",\"p\":\"슈퍼비전 목적으로 동의받은 영상을 강의에 쓰려는 상황의 조치 판단\",\"n\":\"개인정보는 동의받은 목적 범위 안에서만 이용, 목적 변경 시 별도 동의 필요\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"임상실습 3학기째인 학생 임상가는 회기 계획을 스스로 세우고 자료를 분석하며, 슈퍼비전 시간에 \\\"촉진을 줄이는 시점을 어떻게 잡아야 할지 의견을 듣고 싶다\\\"처럼 구체적인 질문을 가지고 온다. 다만 아직 자신의 문제를 완전히 독립적으로 해결하지는 못한다.\",\"q\":\"Anderson의 슈퍼비전 연속체 모형에 따를 때 이 학생에게 가장 적합한 슈퍼비전 방식은?\",\"choices\":[\"평가-피드백 단계의 지시적 방식으로 매 회기 계획을 슈퍼바이저가 작성해 준다\",\"전환 단계의 협력적 방식으로 학생과 함께 문제를 분석하고 대안을 정한다\",\"자기 슈퍼비전 단계로 보고 슈퍼바이저의 관찰과 피드백을 모두 중단한다\",\"학생의 판단이 아직 미숙하므로 모든 임상 결정을 슈퍼바이저가 내린다\",\"자문 방식으로 학생이 요청할 때만 개입하고 회기 관찰은 하지 않는다\"],\"answer\":2,\"explain\":\"Anderson의 연속체 모형은 평가-피드백(직접·지시적) → 전환(협력적) → 자기 슈퍼비전(자문적) 단계로 이어진다. 스스로 계획·분석하고 구체적 질문을 가져오지만 아직 독립적 문제 해결이 어려운 학생은 전환 단계에 해당하므로 협력적 방식이 적합하다. 지시적 방식(①·④)은 초기 단계에, 자문 방식(③·⑤)은 자기 슈퍼비전 단계에 해당하며, 관찰과 피드백을 중단하는 것은 내담자 보호 책무에도 어긋난다. ※단계 명칭과 구분 기준은 교재별 확인 권장.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"Anderson 슈퍼비전 연속체\",\"p\":\"스스로 계획·분석하나 독립적 문제 해결은 미흡한 학생의 단계 판단\",\"n\":\"Anderson 모형: 평가-피드백(지시적)→전환(협력적)→자기 슈퍼비전(자문적)\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"뇌전증 병력이 있는 5세 아동이 치료 중 갑자기 의식을 잃고 전신 경직-간대 발작을 보였다. 치료실에는 언어재활사 혼자 있고 보호자는 대기실에 있다.\",\"q\":\"언어재활사의 대처로 가장 적절한 것은?\",\"choices\":[\"혀를 깨물지 않도록 설압자나 손수건을 입에 물려 기도를 확보한다\",\"부상을 막기 위해 팔다리를 단단히 붙잡아 경련 움직임을 억제한다\",\"위험물을 치우고 머리를 보호하며 옆으로 눕힌 뒤 발작 지속 시간을 확인한다\",\"의식 회복을 돕기 위해 물을 조금씩 마시게 하고 이름을 불러 깨운다\",\"발작이 끝나고 안정되면 바로 회기를 재개하고 보호자에게는 회기 후 알린다\"],\"answer\":3,\"explain\":\"발작 시에는 억제하거나 입에 물건을 넣지 말고, 부상 방지(위험물 제거·머리 보호)와 기도 확보(회복 자세로 옆으로 눕힘)를 하며, 발작 시작 시각을 확인하여 5분 이상 지속·반복되거나 호흡 곤란이 있으면 119에 신고한다. 입에 물건을 넣는 것(①)은 치아 손상·기도 폐쇄 위험, 신체 억제(②)는 골절 위험, 의식이 불분명한 상태에서 물을 먹이는 것(④)은 흡인 위험이 있다. 발작 후에는 회기를 중단하고 보호자에게 즉시 알리며 기록을 남겨야 한다(⑤).\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"치료 중 발작 대처\",\"p\":\"치료 중 전신 경직-간대 발작이 일어난 상황에서 안전 조치 판단\",\"n\":\"발작 시 억제·입에 물건 넣기 금지, 위험물 제거·머리 보호·옆으로 눕히고 시간 확인\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"영유아를 주로 보는 언어재활센터의 감염관리 지침을 점검하였다.\\n\\nㄱ. 회기 전후와 구강 접촉 도구를 다룬 뒤에는 손위생을 실시한다\\nㄴ. 아동이 입에 넣는 장난감은 회기마다 세척·소독한 뒤 재사용한다\\nㄷ. 설압자 등 구강 접촉 일회용품은 소독 후 다른 아동에게 재사용할 수 있다\\nㄹ. 수족구병으로 진단된 아동은 전염 가능 기간 동안 회기를 연기한다\",\"q\":\"옳은 것을 모두 고른 것은?\",\"choices\":[\"ㄱ, ㄴ\",\"ㄱ, ㄷ\",\"ㄴ, ㄷ, ㄹ\",\"ㄱ, ㄴ, ㄹ\",\"ㄱ, ㄴ, ㄷ, ㄹ\"],\"answer\":4,\"explain\":\"표준주의 원칙에 따라 손위생(ㄱ), 구강 접촉 장난감의 회기별 세척·소독(ㄴ), 전염성 질환 시 회기 연기(ㄹ)는 옳다. 설압자·일회용 장갑 등 일회용품은 소독하더라도 다른 아동에게 재사용해서는 안 되므로(ㄷ) 틀렸다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"치료실 감염관리 지침\",\"p\":\"손위생·장난감 소독·일회용품·전염성 질환 지침의 적절성 판단\",\"n\":\"표준주의: 손위생·구강 접촉 장난감 소독, 일회용품은 소독해도 재사용 금지\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"내년에 초등학교 입학 예정인 6세 언어장애 아동의 어머니가 \\\"장애인 등록은 하지 않았는데, 학교에서도 언어치료 지원을 받을 수 있나요?\\\"라고 물었다.\",\"q\":\"「장애인 등에 대한 특수교육법」에 근거한 안내로 옳은 것은?\",\"choices\":[\"등록 여부와 무관하게 특수교육대상자로 선정되면 치료지원으로 언어치료를 받을 수 있다\",\"장애인복지법상 장애인으로 등록된 아동만 특수교육대상자로 선정될 수 있다\",\"특수교육대상자로 선정되더라도 특수학교에 배치되어야만 치료지원을 받을 수 있다\",\"담임교사의 판단만으로 별도의 선정 절차 없이 치료지원이 바로 제공된다\",\"발달재활서비스를 이용 중이면 특수교육대상자 선정 없이 학교 치료지원이 자동으로 제공된다\"],\"answer\":1,\"explain\":\"장애인 등록 여부와 관계없이 보호자가 교육장(교육감)에게 진단·평가를 의뢰할 수 있다. 특수교육대상자 선정은 특수교육지원센터의 진단·평가와 특수교육운영위원회 심사를 거쳐 교육장·교육감이 결정하며, 장애인 등록 여부와 별개이다. 선정되면 일반학급·특수학급·특수학교 어디에 배치되든 관련서비스로 치료지원(언어치료 포함)을 받을 수 있다. 등록 장애인 한정(②), 특수학교 배치 조건(③), 교사 단독 판단(④), 발달재활서비스와의 자동 연계(⑤)는 모두 법의 절차와 다르다. ※진단·평가 기한(30일), 통지 기한 등 세부 절차는 최신 법령 확인 권장.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"법·제도\",\"k\":\"특수교육 치료지원 안내\",\"p\":\"장애인 미등록 아동의 학교 언어치료 지원 가능 여부 판단\",\"n\":\"특수교육대상자 선정은 장애인 등록과 별개, 선정되면 배치와 무관하게 치료지원\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"55세 남성이 뇌졸중으로 실어증이 발생한 지 2개월 되었고, 현재 재활병원에서 언어치료를 받고 있다. 보호자가 \\\"지금 바로 언어장애로 장애인 등록을 하고 싶다\\\"고 문의하였다.\",\"q\":\"「장애인복지법」상 장애 판정에 대한 안내로 가장 적절한 것은?\",\"choices\":[\"발병 즉시 언어검사 결과만 있으면 판정할 수 있다\",\"언어재활사가 장애진단서를 작성하여 주민센터에 제출하면 된다\",\"장애 심사는 국민건강보험공단에서 담당하므로 공단에 직접 신청한다\",\"실어증은 언어장애 판정 대상이 아니므로 등록할 수 없다\",\"장애가 고착된 뒤 의사가 판정하므로 아직 시기가 아니다\"],\"answer\":5,\"explain\":\"언어장애 판정은 원인 질환을 충분히 치료하여 장애가 고착된 뒤에 하며, 뇌졸중 등 후천적 원인은 원칙적으로 발병 후 6개월 이상 치료 후 판정한다. 장애진단은 의료기관의 전문의(재활의학과·신경과·정신건강의학과·이비인후과 등)가 언어검사 결과를 근거로 하며, 언어재활사는 검사·소견 제공은 할 수 있으나 진단서를 작성할 수 없다(②). 장애 심사는 국민연금공단이 담당한다(③). 실어증은 언어장애 판정 대상에 포함된다(④). ※판정 시기(6개월)와 진단 가능 전문의 범위는 최신 장애정도판정기준으로 확인 권장.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"법·제도\",\"k\":\"실어증 장애 판정 시기\",\"p\":\"뇌졸중 발병 2개월 시점의 장애 등록 문의에 판정 요건 안내\",\"n\":\"언어장애 판정: 장애 고착 후 전문의 진단, 후천적 원인은 원칙적으로 발병 6개월 이후\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"5세 언어발달지연 아동의 두 목표에 대한 회기별 정반응률\\n• 목표 A(낱말 수준 /ㄱ/ 산출, 준거 90% 3회기 연속): 최근 3회기 92%, 95%, 96%\\n• 목표 B(2어절 요구 문장): 최근 6회기 35%, 40%, 30%, 40%, 35%, 40%\",\"q\":\"자료에 근거한 목표 수정으로 가장 적절한 것은?\",\"choices\":[\"목표 A는 문장 수준으로 상향하고, 목표 B는 단계를 세분화하거나 촉진을 조정한다\",\"목표 A는 안정성을 위해 낱말 수준을 5회기 더 반복하고, 목표 B는 그대로 유지한다\",\"목표 A는 종결하고, 목표 B는 아동에게 어려우므로 목표에서 삭제한다\",\"목표 A는 문장 수준으로 상향하고, 목표 B는 동기 유발을 위해 3어절 문장으로 상향한다\",\"두 목표 모두 현재 절차를 4회기 더 유지한 뒤 자료를 모아 다시 검토한다\"],\"answer\":1,\"explain\":\"목표 A는 준거(90%, 3회기 연속)를 충족하였으므로 다음 수준으로 진행해야 하며, 준거 달성 후 불필요한 반복(②)은 회기를 낭비한다. 목표 B는 6회기 동안 30~40%에 정체되어 있으므로 현재 절차가 효과적이지 않다는 신호이며, 과제 분석·단계 세분화·촉진 조정·선수 기술 점검 등 절차 수정이 필요하다. 목표 삭제(③)는 아동의 요구를 방치하고, 더 어려운 수준으로 상향(④)하거나 무변화 유지(⑤)는 자료에 반하는 결정이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"통합 사례\",\"k\":\"자료 기반 목표 수정\",\"p\":\"준거를 충족한 목표와 정체된 목표의 회기별 정반응률로 수정 판단\",\"n\":\"준거 충족 시 다음 수준으로 진행, 정체 시 단계 세분화·촉진 조정 등 절차 수정\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"파킨슨병으로 운동저하형 마비말장애를 보이는 60대 남성이 집중 음성치료를 권유받자 \\\"어차피 병은 진행하는데 해봤자 소용없다\\\"며 참여를 거부하였다. 보호자는 손주와 전화 통화가 어려워진 것을 환자가 속상해한다고 전하였다.\",\"q\":\"언어재활사의 상담 접근으로 가장 적절한 것은?\",\"choices\":[\"보호자를 설득하여 환자가 치료에 참여하도록 가정에서 매일 강하게 권하게 한다\",\"환자의 치료 거부 의사를 존중하여 기록하고 즉시 서비스를 종결한다\",\"\\\"치료를 안 하면 곧 말을 전혀 못 하게 됩니다\\\"라고 경고하여 동기를 높인다\",\"양가감정을 반영하고 중요한 목표와 치료를 연결하되 결정은 환자에게 맡긴다\",\"저항을 줄이기 위해 환자 모르게 보호자와 치료 일정을 정해 진행한다\"],\"answer\":4,\"explain\":\"치료 동기가 낮은 성인에게는 동기강화상담의 원리(공감·반영적 경청, 양가감정 탐색, 손주와의 통화처럼 개인이 중요하게 여기는 가치·목표와 연결, 허락 후 정보 제공, 자율성 존중)가 적합하다. 보호자를 통한 압박(①), 겁주기(③), 환자 배제(⑤)는 저항을 키우고 자기결정권을 침해하며, 거부 즉시 종결(②)은 양가감정을 다룰 기회를 놓친다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"상담\",\"k\":\"동기강화상담 적용\",\"p\":\"진행성 질환 환자의 치료 거부와 손주 통화 고충으로 상담 접근 선택\",\"n\":\"동기강화상담: 양가감정 반영, 개인의 가치·목표와 치료 연결, 자율성 존중\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 종이 치료기록지에 회기 날짜와 정반응률을 잘못 기재한 것을 이틀 뒤 발견하였다.\",\"q\":\"기록 수정 방법으로 옳은 것은?\",\"choices\":[\"수정액으로 오류를 완전히 지우고 올바른 내용을 적는다\",\"원 기록에 한 줄을 긋고 바른 내용과 수정 일자·서명을 적는다\",\"해당 페이지를 새로 작성하여 교체하고 원본은 파기한다\",\"오류가 있었음을 기관장에게 구두로 보고하는 것으로 갈음한다\",\"다음 회기 기록에 올바른 값을 적고 이전 기록은 그대로 둔다\"],\"answer\":2,\"explain\":\"임상 기록은 법적 문서이므로 수정 시 원 기록의 흔적을 남기고(한 줄 긋기) 수정 내용·일자·서명(필요시 사유)을 기재하여 누가 언제 무엇을 고쳤는지 추적할 수 있어야 한다. 수정액 사용(①), 원본 파기(③)는 기록 위·변조 의혹을 낳고, 구두 보고(④)나 이전 기록 방치(⑤)는 기록의 정확성을 확보하지 못한다. 전자기록도 수정 이력이 남도록 처리한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"치료기록 수정 방법\",\"p\":\"종이 기록지 오기를 발견했을 때 법적 문서로서의 수정 방법 판단\",\"n\":\"임상 기록 수정: 원 기록에 한 줄 긋고 바른 내용·수정 일자·서명 기재\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"센터에 근무하는 언어재활사가 자신이 치료 중인 학령전 아동들을 대상으로 새로운 어휘 중재의 효과 연구를 수행하려 한다.\",\"q\":\"연구 윤리상 가장 적절한 절차는?\",\"choices\":[\"자신의 내담자는 치료의 일부이므로 별도 동의 없이 연구에 포함한다\",\"아동은 미성년자이므로 보호자 동의만 받고 아동의 참여 의사는 확인하지 않는다\",\"IRB 승인과 보호자 동의·아동 승낙을 받고 불참 시 불이익이 없음을 알린다\",\"참여를 거부하면 치료를 종결할 수 있음을 미리 알려 참여율을 높인다\",\"참여 아동에게만 추가 회기를 무료로 제공하겠다고 약속하여 모집한다\"],\"answer\":3,\"explain\":\"치료자가 자신의 내담자를 연구 대상으로 삼을 때는 치료 관계에서 오는 강압 가능성이 크므로, IRB 심의, 보호자 동의와 아동 연령에 맞는 승낙, 불참·철회 시 불이익 없음 보장이 필수이다. 동의 생략(①), 아동 의사 무시(②), 치료 종결 위협(④)은 자발성을 침해하고, 참여자에게만 특혜를 주는 것(⑤)은 부당한 유인에 해당한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"내담자 대상 연구 윤리\",\"p\":\"치료 중인 아동을 연구 대상으로 삼을 때의 윤리적 절차 판단\",\"n\":\"IRB 승인, 보호자 동의·아동 승낙, 불참·철회 시 불이익 없음 보장 필수\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"개인 언어재활센터 홈페이지에 다음 문구가 게시되어 있다.\\n\\\"국내 유일! 3개월 안에 완치를 보장합니다. 해외 특허 언어치료법(근거 자료 없음).\\\"\",\"q\":\"이 광고에 대한 판단으로 가장 적절한 것은?\",\"choices\":[\"홍보 문구는 사업자의 영업 자유에 해당하므로 윤리적 문제가 없다\",\"결과 보장은 치료사의 전문성과 자신감을 표현한 것이므로 허용된다\",\"완치된 사례가 실제로 1건이라도 있으면 완치 보장 표현이 허용된다\",\"내담자 후기를 실명으로 함께 게시하면 신뢰성이 확보되어 문제가 없다\",\"치료 효과를 보장하는 허위·과장 광고로 전문가 윤리에 위배된다\"],\"answer\":5,\"explain\":\"전문가 윤리는 서비스 효과를 보장하거나 근거 없는 우수성을 주장하는 광고를 금지한다. '완치 보장', '국내 유일', 근거 없는 '특허 치료법'은 소비자를 오인하게 하는 허위·과장 광고로, 언어재활사의 정직성·품위 유지 윤리에 위배되며 표시·광고 관련 법 위반 소지도 있다. 사업자의 자유(①), 자신감(②), 단일 사례(③)는 정당화 근거가 되지 못하며, 내담자 실명 후기 게시(④)는 오히려 비밀유지 문제를 추가로 일으킨다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"효과 보장 과장 광고\",\"p\":\"완치 보장·국내 유일·근거 없는 특허 문구의 윤리 위배 여부 판단\",\"n\":\"치료 효과 보장·근거 없는 우수성 주장은 허위·과장 광고로 전문가 윤리 위배\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"베트남어를 주로 사용하고 한국어가 서툰 어머니에게 4세 아동의 언어평가 결과를 설명해야 한다. 한국어가 유창한 8세 형이 \\\"제가 통역할게요\\\"라고 나섰다.\",\"q\":\"언어재활사의 대처로 가장 적절한 것은?\",\"choices\":[\"형이 한국어에 능숙하므로 형에게 통역을 맡겨 결과를 전달한다\",\"번역 앱으로 결과지를 번역해 전달하고 질문은 받지 않는다\",\"한국어로 천천히 크게 말하면 이해할 수 있으므로 그대로 진행한다\",\"어머니 대신 한국어가 가능한 아버지에게만 설명하고 결정을 맡긴다\",\"전문 통역 지원을 요청하고 형에게는 통역을 맡기지 않는다\"],\"answer\":5,\"explain\":\"가족 구성원, 특히 아동에게 통역을 맡기면 정보 왜곡, 민감한 내용(진단·예후) 전달 부담, 가족 역할 혼란이 생기므로 다문화가족지원센터 통·번역 서비스 등 훈련된 통역사를 이용해야 한다(①은 틀림). 통역 시에는 통역사와 용어·목적을 사전에 협의하고, 짧은 문장으로 어머니를 직접 바라보며 말하는 것이 원칙이다. 번역 앱만으로 결과를 통보하거나(②), 큰 소리로 말하기(③), 어머니를 의사결정에서 배제하기(④)는 정보 접근권과 가족중심 원칙에 어긋난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"다문화·이중언어\",\"k\":\"다문화 가족 통역 이용\",\"p\":\"한국어가 서툰 어머니에게 결과 설명 시 아동 형의 통역 제안에 대처\",\"n\":\"가족·아동 통역은 정보 왜곡·부담을 낳으므로 훈련된 전문 통역사 이용이 원칙\"}},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"9세 뇌성마비 아동(경직형 마비말장애)의 평가 내용을 ICF(국제 기능·장애·건강 분류) 틀로 정리하려 한다.\\n㉠ 문장 수준 말명료도 55%\\n㉡ 모둠 토론 시간에 발표를 전혀 하지 않음\\n㉢ 소음이 큰 교실 환경과 또래의 놀림\\n㉣ 실패를 걱정하여 말하기를 스스로 피하는 성향\",\"q\":\"ICF 구성요소로 옳게 분류한 것은?\",\"choices\":[\"㉠ 활동, ㉡ 신체기능, ㉢ 환경요인, ㉣ 참여\",\"㉠ 신체기능, ㉡ 참여, ㉢ 개인요인, ㉣ 환경요인\",\"㉠ 신체기능, ㉡ 참여, ㉢ 환경요인, ㉣ 개인요인\",\"㉠ 신체구조, ㉡ 활동, ㉢ 개인요인, ㉣ 참여\",\"㉠ 참여, ㉡ 활동, ㉢ 환경요인, ㉣ 신체기능\"],\"answer\":3,\"explain\":\"ICF에서 말명료도 저하는 음성·말 기능의 손상이므로 신체기능(㉠), 학교 모둠 토론이라는 생활 상황 참여의 제한은 참여(㉡), 물리적 환경(소음)과 타인의 태도(놀림)는 환경요인(㉢), 성격·대처 방식 등 개인의 특성은 개인요인(㉣)에 해당한다. 환경요인과 개인요인을 바꾼 ②, 신체기능·활동·참여를 뒤섞은 ①·④·⑤는 틀렸다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"통합 사례\",\"k\":\"ICF 구성요소 분류\",\"p\":\"말명료도·발표 회피·교실 소음·회피 성향을 ICF 요소로 분류\",\"n\":\"ICF: 말명료도는 신체기능, 토론 참여는 참여, 소음·놀림은 환경요인, 성향은 개인요인\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"\",\"q\":\"대뇌 피질과 뇌간·척수를 위아래로 잇는 투사섬유가 모여 지나가는 구조로 옳은 것은?\",\"choices\":[\"뇌들보(뇌량)\",\"궁상다발\",\"앞맞교차(전교련)\",\"속섬유막(내포)\",\"갈고리다발\"],\"answer\":4,\"explain\":\"속섬유막(내포)은 피질척수로·피질연수로 등 투사섬유가 모여 지나가는 통로로, 손상되면 반대쪽 편마비가 나타난다. ①뇌량과 ③앞맞교차는 좌우 반구를 잇는 교련섬유이고, ②궁상다발과 ⑤갈고리다발은 같은 반구 안의 피질을 잇는 연합섬유이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"신경해부·뇌혈관\",\"k\":\"백질 섬유 종류(투사섬유)\",\"p\":\"투사·교련·연합섬유를 구분해 투사섬유가 지나는 구조 식별\",\"n\":\"내포는 투사섬유 통로, 뇌량·전교련은 교련섬유, 궁상다발·갈고리다발은 연합섬유\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌손상 환자\\n• 입을 크게 벌리게 하면 아래턱이 오른쪽으로 치우침\\n• 어금니를 꽉 물게 하면 오른쪽 깨물근의 수축이 약하게 만져짐\\n• 오른쪽 얼굴의 촉각이 저하됨\",\"q\":\"손상된 뇌신경으로 가장 적절한 것은?\",\"choices\":[\"왼쪽 삼차신경(5번)\",\"오른쪽 삼차신경(5번)\",\"오른쪽 안면신경(7번)\",\"왼쪽 설하신경(12번)\",\"오른쪽 미주신경(10번)\"],\"answer\":2,\"explain\":\"삼차신경은 운동가지로 깨물근·날개근 등 씹기근육을, 감각가지로 얼굴 감각을 담당한다. 한쪽 삼차신경이 손상되면 반대쪽 날개근이 턱을 밀어 입을 벌릴 때 턱이 손상된 쪽으로 치우치므로 오른쪽 삼차신경 손상이다. ③안면신경은 얼굴 표정근을 담당하며 씹기근육·얼굴 촉각과는 관련이 없다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"신경해부·뇌혈관\",\"k\":\"삼차신경 손상 측 판별\",\"p\":\"턱 편위 방향·깨물근 약화·얼굴 감각 저하로 손상 뇌신경과 측 판단\",\"n\":\"삼차신경(5번) 손상: 씹기근육 약화, 입 벌릴 때 턱이 손상된 쪽으로 편위, 얼굴 감각 저하\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌졸중 환자\\n• 어지럼증과 걸음 실조가 갑자기 나타남\\n• 말이 느리고 불분명하며 삼킴 곤란이 있음\\n• 낱말 이해·이름대기·따라말하기·읽기는 정상 범위\",\"q\":\"폐색이 의심되는 혈관 계통으로 가장 적절한 것은?\",\"choices\":[\"왼쪽 중대뇌동맥 위분지\",\"왼쪽 중대뇌동맥 아래분지\",\"오른쪽 전대뇌동맥\",\"왼쪽 전대뇌동맥\",\"척추-뇌바닥동맥 계통\"],\"answer\":5,\"explain\":\"척추동맥·뇌바닥동맥(추골-기저동맥) 계통은 뇌간과 소뇌를 공급하므로 폐색 시 어지럼·실조·마비말장애·삼킴장애가 나타나고 언어 기능은 보존된다. ①②왼쪽 중대뇌동맥 분지 폐색은 실어증을 일으키고, ③④전대뇌동맥은 전두엽 안쪽을 공급해 반대쪽 다리 중심의 마비와 발동성 저하를 주로 일으킨다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"신경해부·뇌혈관\",\"k\":\"척추-뇌바닥동맥 폐색 추론\",\"p\":\"실조·마비말·삼킴장애가 있으나 언어는 보존된 양상으로 폐색 혈관 계통 판단\",\"n\":\"척추-뇌바닥동맥 계통은 뇌간·소뇌 공급: 실조·어지럼·마비말장애·삼킴장애, 실어증은 없음\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 아침 식사 중 갑자기 오른손에 힘이 빠지고 말이 어눌해짐\\n• 약 30분 뒤 증상이 완전히 사라짐\\n• 응급실 MRI에서 새로운 경색 병변이 확인되지 않음\",\"q\":\"이 상태로 가장 적절한 것은?\",\"choices\":[\"일과성 허혈발작\",\"소혈관 열공경색\",\"거미막밑 출혈\",\"뇌실질 내 출혈\",\"만성 경막하 혈종\"],\"answer\":1,\"explain\":\"국소 신경 증상이 짧은 시간 안에 완전히 회복되고 영상에 경색이 남지 않으면 일과성 허혈발작(TIA)이며, 이후 뇌경색 위험이 높아 예방 관리가 필요하다. ②열공경색은 영상에서 작은 경색 병변이 확인되고, ③④출혈과 ⑤경막하 혈종은 영상에서 출혈·혈종이 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"신경해부·뇌혈관\",\"k\":\"일과성 허혈발작 식별\",\"p\":\"빠르게 완전 회복되고 영상 병변이 없는 국소 증상으로 TIA 판단\",\"n\":\"일과성 허혈발작: 일시적 국소 신경 증상이 완전히 회복되고 영상에서 경색이 없음, 뇌경색의 경고 신호\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"좌반구 뇌졸중 환자(오른손잡이)\\n• 소리 내어 읽기와 읽기 이해가 모두 저하되고, 받아쓰기·자발적 쓰기도 저하됨\\n• 손가락 이름을 대거나 가리키지 못하고, 좌우 구분과 간단한 계산이 어려움\\n• 발화는 유창하고 청각적 이해·따라말하기는 비교적 양호함\",\"q\":\"[그림 1]에서 손상 가능성이 가장 높은 영역은?\",\"choices\":[\"㉠\",\"㉡\",\"㉢\",\"㉣\",\"㉤\"],\"answer\":4,\"explain\":\"읽기·쓰기가 함께 손상된 실서증 동반 실독증과 손가락 실인증·좌우 혼동·계산 장애(게르스트만 증후군)는 위관자고랑 끝을 감싸는 각회(㉣) 손상의 특징이다. 그림에서 ㉠은 하전두회 뒷부분(브로카 영역), ㉡은 중심앞이랑(일차운동피질), ㉢은 외측고랑 끝을 감싸는 모서리위이랑(연상회, 궁상다발 주변), ㉤은 상측두회 뒷부분(베르니케 영역)이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"신경해부·뇌혈관\",\"k\":\"각회 손상 부위 식별(그림)\",\"p\":\"실독·실서와 게르스트만 증상으로 뇌 외측면 그림에서 손상 영역 판단\",\"n\":\"각회 손상: 실서증 동반 실독증, 게르스트만 증후군(손가락 실인증·좌우 혼동·계산장애·실서증)\"},\"image\":\"data:image/svg+xml;base64,\"},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"실어증 환자의 PK-WAB-R 결과\\n• 스스로 말하기: 내용 전달 6점, 유창성 8점\\n• 알아듣기 환산점수 3.5점(10점 만점)\\n• 따라말하기 환산점수 9.0점(10점 만점)\\n• 이름대기 환산점수 4.0점(10점 만점)\\n• 질문과 무관한 유창한 발화, 검사자의 말을 그대로 따라 하는 모습이 잦음\",\"q\":\"실어증지수(AQ)와 실어증 유형으로 옳은 것은?\",\"choices\":[\"AQ 30.5 – 연결피질감각실어증\",\"AQ 61.0 – 베르니케실어증\",\"AQ 61.0 – 연결피질감각실어증\",\"AQ 61.0 – 명칭실어증\",\"AQ 30.5 – 전도실어증\"],\"answer\":3,\"explain\":\"AQ는 (스스로 말하기 6+8 + 알아듣기 3.5 + 따라말하기 9.0 + 이름대기 4.0)×2 = 30.5×2 = 61.0이다. 유창성이 높고 알아듣기는 낮으나 따라말하기가 보존되며 반향어가 있으므로 연결피질감각실어증이다. ②베르니케실어증은 따라말하기도 손상되고, ④명칭실어증은 알아듣기가 양호하며, ①⑤의 30.5는 합계에 2를 곱하지 않은 값이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"PK-WAB-R AQ 계산·유형\",\"p\":\"하위검사 점수로 AQ를 계산하고 유창성·이해·따라말하기 조합으로 유형 판단\",\"n\":\"AQ=(스스로 말하기+알아듣기+따라말하기+이름대기)×2, 연결피질감각실어증은 유창·이해 저하·따라말하기 보존\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"\",\"q\":\"이름대기 검사에서 나타난 반응 중 의미착어에 해당하는 것은?\",\"choices\":[\"연필 → \\\"연빌\\\"\",\"가방 → \\\"가반\\\"\",\"의자 → \\\"책상\\\"\",\"가위 → \\\"모두리\\\"\",\"칫솔 → \\\"이 닦는 거\\\"\"],\"answer\":3,\"explain\":\"의미착어는 목표어와 의미적으로 관련된 다른 실제 낱말로 대치하는 오류로, '의자→책상'이 해당한다. ①②는 음소 일부가 바뀐 음소착어, ④는 실재하지 않는 낱말을 만들어 낸 신조어, ⑤는 기능을 풀어 설명하는 에두르기이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"착어 유형 구분\",\"p\":\"이름대기 반응을 의미착어·음소착어·신조어·에두르기로 분류\",\"n\":\"의미착어: 의미적으로 관련된 실제 낱말로 대치, 음소착어: 음소 일부 대치, 신조어: 비단어 산출\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"명칭실어증 환자의 치료 장면\\n• 목표 그림(예: 우산)을 가운데 두고 둘레 칸을 채우게 함\\n• 범주, 용도, 생김새, 쓰는 장소, 떠오르는 것을 차례로 말하게 함\\n• 이후 목표 낱말의 이름대기를 다시 시도함\",\"q\":\"이 치료 기법은?\",\"choices\":[\"멜로디 억양 치료(MIT)\",\"음운성분분석(PCA)\",\"의사소통 효과 증진법(PACE)\",\"시각 동작 치료(VAT)\",\"의미자질분석(SFA)\"],\"answer\":5,\"explain\":\"목표 낱말의 범주·용도·속성·장소·연상 같은 의미 자질을 스스로 산출하게 해 의미망을 활성화하는 기법은 의미자질분석(SFA)이다. ②음운성분분석은 첫소리·음절 수·운 같은 음운 자질을 산출하게 하고, ①MIT는 억양 패턴을 이용해 비유창 실어증의 발화를 촉진한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"의미자질분석(SFA)\",\"p\":\"의미 자질을 산출하게 하는 절차로 이름대기 치료 기법 식별\",\"n\":\"SFA: 범주·용도·속성·장소·연상 등 의미 자질 산출로 낱말 인출 촉진, PCA는 음운 자질 산출\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"비유창 실어증 환자의 집중 치료\\n• 하루 3시간 안팎, 2주 동안 주 5일(총 10일) 시행함\\n• 카드 게임 상황에서 원하는 카드를 말로만 요청하게 함\\n• 손짓·가리키기·쓰기 같은 보상 수단의 사용을 제한함\",\"q\":\"이 치료 기법은?\",\"choices\":[\"의사소통 효과 증진법(PACE)\",\"제약유도 실어증 치료(CIAT)\",\"멜로디 억양 치료(MIT)\",\"반응 정교화 훈련(RET)\",\"시각 동작 치료(VAT)\"],\"answer\":2,\"explain\":\"구어 이외의 보상 수단을 제한하고 짧은 기간 고강도로 구어 사용을 이끄는 방식은 제약유도 실어증 치료(CIAT)이다. ①PACE는 오히려 제스처·그림 등 모든 의사소통 수단을 허용하고, ⑤VAT는 말 대신 제스처 산출을 훈련하는 중증 환자용 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"제약유도 실어증 치료(CIAT)\",\"p\":\"보상 수단 제한과 고강도 집중 구어 사용으로 치료 기법 식별\",\"n\":\"CIAT: 비구어 보상 수단을 제한하고 짧은 기간 집중적으로 구어 사용을 유도\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"60대 환자, 2년에 걸쳐 서서히 진행\\n• 발화는 유창하고 문법·조음은 비교적 정확함\\n• \\\"낙타가 뭐예요? 처음 들어 보는 말인데요.\\\"처럼 낱말 뜻을 잃어버림\\n• 사물 이름대기와 낱말 이해가 심하게 저하되고, 따라말하기는 보존됨\\n• 일상 사건 기억과 길 찾기는 비교적 유지됨\",\"q\":\"가장 적절한 진단은?\",\"choices\":[\"의미변이형 원발진행실어증\",\"비유창형 원발진행실어증\",\"로고페닉형 원발진행실어증\",\"뇌졸중 후 베르니케실어증\",\"피질하 혈관성 치매\"],\"answer\":1,\"explain\":\"서서히 진행하면서 유창한 발화, 낱말 의미의 상실(낱말 이해·이름대기 저하), 보존된 따라말하기를 보이면 의미변이형 원발진행실어증이다. ②비유창형은 실문법증·말실행증이 두드러지고, ③로고페닉형은 낱말 찾기 휴지와 문장 따라말하기 저하가 특징이며 낱말 뜻은 비교적 유지된다. ④베르니케실어증은 따라말하기도 손상된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"원발진행실어증 변이형 감별\",\"p\":\"진행 경과와 낱말 의미 상실·따라말하기 보존으로 PPA 변이형 판단\",\"n\":\"의미변이형 PPA: 유창, 낱말 의미 상실(이해·이름대기 저하), 따라말하기 보존, 점진적 진행\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"유창성 실어증 환자의 그림 설명 발화\\n• \\\"엄마가 접시를 씻으면서 물에게 넘쳐서 했어요.\\\"\\n• \\\"남자아이는 의자에 올라가서 과자로 꺼내다가 넘어지고 있었는데요.\\\"\\n• 발화 길이와 속도는 정상 범위이고, 조사·어미가 빠지지는 않음\",\"q\":\"이 발화에서 두드러지는 문법 오류 특성으로 가장 적절한 것은?\",\"choices\":[\"실문법증\",\"반향어\",\"보속증\",\"에두르기\",\"착문법증\"],\"answer\":5,\"explain\":\"조사·어미를 생략하지는 않지만 '물에게', '과자로'처럼 잘못된 조사를 쓰고 어미와 문장 구조가 뒤엉키는 것은 유창성 실어증(주로 베르니케실어증)에서 나타나는 착문법증이다. ①실문법증은 비유창 실어증(브로카실어증)에서 조사·어미 같은 문법형태소를 생략하는 전보식 발화이고, ②반향어는 상대의 말을 그대로 따라 하는 것, ③보속증은 앞의 반응을 되풀이하는 것, ④에두르기는 목표 낱말을 설명으로 돌려 말하는 것이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"착문법증 식별\",\"p\":\"조사·어미 오용과 문장 구조 혼란을 보이는 발화로 문법 오류 유형 판단\",\"n\":\"착문법증: 유창성 실어증에서 문법형태소를 생략하지 않고 잘못 사용, 실문법증: 비유창 실어증에서 문법형태소 생략\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"\",\"q\":\"멜로디 억양 치료(MIT)의 대상자로 가장 적절한 환자는?\",\"choices\":[\"유창하게 말하지만 청각적 이해가 심하게 떨어지는 환자\",\"따라말하기만 선택적으로 손상되고 발화는 유창한 환자\",\"발화가 극히 제한되나 청각적 이해가 비교적 양호한 환자\",\"우반구 손상 후 단조로운 운율과 좌측 무시를 보이는 환자\",\"청각적 이해와 발화가 모두 극히 제한된 전반실어증 환자\"],\"answer\":3,\"explain\":\"MIT는 억양과 리듬을 붙인 발화로 구어 산출을 이끄는 기법으로, 좌반구 손상 후 발화가 극히 제한된 비유창 실어증이면서 청각적 이해가 비교적 양호하고 따라말하기가 불량한 환자에게 적합하다. ⑤청각적 이해까지 심하게 손상된 전반실어증은 절차를 따르기 어렵고, ①②는 발화가 유창해 대상이 아니며, ④우반구 손상 환자는 MIT가 활용하는 우반구의 운율 처리 기능이 손상되어 있다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"MIT 대상자 선택\",\"p\":\"실어증 프로파일별로 멜로디 억양 치료의 적용 조건 판단\",\"n\":\"MIT 적합 대상: 좌반구 손상 비유창 실어증, 발화 극히 제한, 청각적 이해 비교적 양호, 따라말하기 불량\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"오른쪽 대뇌반구 뇌졸중 환자\\n• '자동차'를 \\\"동차\\\"로, '바나나우유'를 \\\"나나우유\\\"로 읽음\\n• 문장을 읽을 때 각 줄의 왼쪽 앞부분을 자주 건너뜀\\n• 낱말의 오른쪽 부분은 정확히 읽고, 시력은 정상 범위임\",\"q\":\"이 환자의 읽기 장애 유형은?\",\"choices\":[\"순수실독증\",\"무시실독증\",\"주의실독증\",\"표면실독증\",\"심층실독증\"],\"answer\":2,\"explain\":\"우반구 손상 후 낱말·문장의 왼쪽 부분을 생략하거나 대치하는 것은 편측무시로 인한 말초성 실독증인 무시실독증이다. ①순수실독증은 좌측 후두엽 손상으로 글자를 하나씩 읽는 낱자 읽기가 특징이고, ③주의실독증은 낱자 하나는 읽지만 여러 글자·낱말이 함께 제시되면 글자가 섞이는 오류를 보인다. ⑤심층실독증은 의미 오류가 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실독증·실서증\",\"k\":\"무시실독증 식별\",\"p\":\"우반구 손상 후 낱말 왼쪽 부분 오류로 실독증 유형 판단\",\"n\":\"무시실독증: 편측무시로 낱말·줄의 왼쪽 부분을 생략·대치하는 말초성 실독증\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"받아쓰기 결과\\n• '나무', '바다'처럼 소리와 표기가 같은 낱말: 정확\\n• '구벙', '다룸' 같은 비단어: 정확\\n• '같이' → '가치', '국물' → '궁물', '맑다' → '막따'로 씀\",\"q\":\"이 환자의 실서증 유형으로 가장 적절한 것은?\",\"choices\":[\"음운실서증\",\"심층실서증\",\"실행성 실서증\",\"표면실서증\",\"공간성 실서증\"],\"answer\":4,\"explain\":\"소리와 표기가 같은 낱말과 비단어는 정확하지만 표기가 소리와 다른 낱말을 소리 나는 대로 쓰는 것은, 철자 어휘 경로가 손상되어 소리-글자 변환 경로에 의존하는 표면실서증이다. ①음운실서증은 비단어 받아쓰기가 손상되고, ②심층실서증은 비단어 손상과 함께 의미 오류가 나타나며, ③실행성 실서증은 철자 지식이 아니라 글자 획 형성에 문제가 있다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실독증·실서증\",\"k\":\"표면실서증 식별\",\"p\":\"받아쓰기에서 소리 나는 대로 쓰는 오류로 실서증 유형 판단\",\"n\":\"표면실서증: 어휘(철자) 경로 손상, 비단어·규칙 낱말은 정확하나 불규칙 표기 낱말을 소리대로 씀\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"실독증 환자\\n• '가방', '우유' 같은 친숙한 낱말은 정확히 읽음\\n• '보탕', '미숟' 같은 비단어를 거의 읽지 못하고 비슷한 실제 낱말로 바꿔 읽음\",\"q\":\"이 환자에게 우선 적용할 중재로 가장 적절한 것은?\",\"choices\":[\"글자와 소리의 대응을 단서 낱말과 연결해 익히게 한다\",\"낱말 전체의 모양을 통째로 반복해 기억하게 한다\",\"줄의 왼쪽 끝에 색 선을 그어 읽기 시작점을 표시한다\",\"손가락으로 글자 윤곽을 따라 그리며 읽게 한다\",\"목표 낱말의 의미 자질을 차례로 말하게 한다\"],\"answer\":1,\"explain\":\"친숙한 낱말은 읽지만 비단어를 읽지 못하는 음운실독증은 자소-음소 변환 경로의 손상이므로, 글자와 소리의 대응을 단서 낱말과 연결해 재훈련하는 접근이 우선이다. ②는 어휘 경로를 강화하는 표면실독증용, ③은 무시실독증용, ④는 순수실독증에 쓰는 촉각·운동감각 단서 전략이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실독증·실서증\",\"k\":\"음운실독증 중재\",\"p\":\"비단어 읽기 손상 프로파일에 맞는 읽기 중재 선택\",\"n\":\"음운실독증 중재: 자소-음소 대응 재훈련(단서 낱말 활용), 어휘 경로 훈련은 표면실독증에 적용\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"50대 환자, 1년 전부터 말과 삼킴이 점차 나빠짐\\n• 혀의 위축과 근섬유다발수축(섬유속연축)이 관찰됨\\n• 쥐어짜는 듯한 거친 음성, 느린 말속도, 과대비성\\n• 턱반사가 항진되고, 상황과 맞지 않는 웃음·울음이 터짐\",\"q\":\"가장 적절한 마비말장애 유형은?\",\"choices\":[\"이완형(하위운동신경)\",\"경직형(양측 상위운동신경)\",\"실조형(소뇌)\",\"과소운동형(기저핵)\",\"혼합형(경직형+이완형)\"],\"answer\":5,\"explain\":\"하위운동신경세포 징후(혀 위축·섬유속연축)와 상위운동신경세포 징후(쥐어짜는 음성, 반사 항진, 가성연수 정동)가 함께 나타나면 경직형과 이완형이 섞인 혼합형으로, 근위축성 측삭경화증(ALS)이 대표적이다. ①은 위축·섬유속연축만, ②는 반사 항진·쥐어짜는 음성만 설명할 뿐 전체 소견을 설명하지 못한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"혼합형 마비말장애(ALS)\",\"p\":\"상위·하위운동신경세포 징후가 함께 나타나는 사례로 마비말장애 유형 판단\",\"n\":\"ALS: 상위(경직형)·하위(이완형) 운동신경세포 징후가 함께 나타나는 혼합형 마비말장애\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"파킨슨병 환자\\n• 말이 점점 빨라지며 음절이 뭉개지는 말 돌진(가속)이 있음\\n• 음량은 대화에 지장이 없을 정도로 유지됨\\n• 음도·강세 변화가 단조로움\",\"q\":\"말 명료도 향상을 위한 중재로 가장 적절한 것은?\",\"choices\":[\"성대 내전 밀기(pushing) 운동\",\"속도 조절판(페이싱 보드)\",\"근전도 바이오피드백 이완\",\"구개거상 보철기 착용\",\"코 막고 압력자음 훈련\"],\"answer\":2,\"explain\":\"과소운동형 마비말장애에서 말 돌진(가속)으로 명료도가 떨어지면 칸마다 한 음절(낱말)씩 짚으며 말하게 하는 속도 조절판으로 말속도를 늦춘다. ①밀기 운동은 성대 내전이 약한 이완형에, ④구개거상 보철기는 연인두 폐쇄 부전에 의한 과대비성에 적용한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"과소운동형 말속도 조절\",\"p\":\"말 돌진을 보이는 과소운동형 환자의 명료도 중재 선택\",\"n\":\"과소운동형의 빠른 말속도·말 돌진에는 속도 조절판 등 말속도 조절 전략 적용\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"말실행증 환자 치료 절차\\n• 첫 단계: 환자가 치료사의 입 모양을 보고 들으며 치료사와 동시에 말함\\n• 이후 입 모양만 보여 주기, 듣고 따라 하기, 글자 보고 읽기 순으로 단서를 줄임\\n• 마지막에는 역할극 등 자발적 상황에서 목표 발화를 산출하게 함\",\"q\":\"이 치료 기법은?\",\"choices\":[\"8단계 연속 통합자극법\",\"멜로디 억양 치료(MIT)\",\"촉각 단서 기법(PROMPT)\",\"리 실버만 음성치료(LSVT)\",\"대조 강세 훈련\"],\"answer\":1,\"explain\":\"보고 듣고 동시에 말하는 통합 자극에서 시작해 단서를 점차 줄이고 자발 산출로 나아가는 위계적 절차는 Rosenbek의 8단계 연속 통합자극법이다. ③PROMPT는 치료사가 환자의 얼굴·턱에 촉각 단서를 주는 기법이고, ②MIT는 억양과 손 두드리기를 이용한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"8단계 연속 통합자극법\",\"p\":\"통합 자극과 단서 소거 위계로 말실행증 치료 기법 식별\",\"n\":\"8단계 연속 통합자극법: 보고 듣고 동시에 말하기에서 시작해 단서를 줄이며 자발 산출로 진행\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"마비말장애 환자 평가\\n• 단어 명료도: 낱말 50개를 녹음해 낯선 청자가 받아 적게 하니 34개를 바르게 적음\\n• 말속도: 문단 읽기에서 30초 동안 108음절을 산출함\",\"q\":\"단어 명료도(%)와 말속도로 옳은 것은?\",\"choices\":[\"34% – 초당 3.6음절\",\"72% – 초당 3.6음절\",\"68% – 초당 3.6음절\",\"68% – 분당 108음절\",\"68% – 초당 2.8음절\"],\"answer\":3,\"explain\":\"단어 명료도는 바르게 받아 적은 낱말 수 ÷ 전체 낱말 수 × 100 = 34 ÷ 50 × 100 = 68%이다. 말속도는 108음절 ÷ 30초 = 초당 3.6음절(분당 216음절)이다. ④의 분당 108음절은 30초 동안의 음절 수를 1분 값으로 잘못 본 것이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"명료도·말속도 계산\",\"p\":\"받아 적기 결과와 산출 음절 수로 단어 명료도와 말속도 계산\",\"n\":\"단어 명료도=바르게 받아 적은 낱말÷전체 낱말×100, 말속도=음절 수÷시간\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"\",\"q\":\"마비말장애 유형과 주된 병변 부위의 연결로 옳은 것은?\",\"choices\":[\"이완형 – 양측 상위운동신경세포\",\"실조형 – 기저핵 조절회로\",\"경직형 – 말초 뇌신경\",\"과소운동형 – 흑질-선조체 경로\",\"과다운동형 – 소뇌 조절회로\"],\"answer\":4,\"explain\":\"과소운동형은 흑질의 도파민 신경세포가 소실되어 흑질-선조체 경로(기저핵 회로)가 손상되어 생긴다(파킨슨병). ①이완형은 하위운동신경세포(뇌신경·척수신경), ②실조형은 소뇌 조절회로, ③경직형은 양측 상위운동신경세포, ⑤과다운동형은 기저핵 조절회로의 손상과 관련된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말운동장애\",\"k\":\"마비말장애 유형별 병변\",\"p\":\"마비말장애 유형과 손상 부위의 대응 판단\",\"n\":\"이완형-하위운동신경, 경직형-양측 상위운동신경, 실조형-소뇌, 과소·과다운동형-기저핵 회로\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"\",\"q\":\"마비말장애 평가 과제와 주로 확인하는 기능의 연결로 옳은 것은?\",\"choices\":[\"모음 연장 – 조음기관 사이의 빠른 전환\",\"/퍼퍼퍼/ 반복 – 호흡과 발성의 지속 능력\",\"/퍼터커/ 반복 – 조음 운동의 순서화\",\"문단 읽기 – 단일 조음기관의 반복 속도\",\"음도 올리며 /아/ 내기 – 연인두 폐쇄 기능\"],\"answer\":3,\"explain\":\"/퍼터커/처럼 조음 위치가 다른 음절을 빠르게 이어 반복하는 연속운동속도(SMR) 과제는 조음기관 사이를 전환하며 운동을 순서화하는 능력을 보며, 말실행증에서는 순서가 뒤바뀌거나 모색행동이 나타난다. ①모음 연장은 호흡·발성의 지속 능력과 음질을, ②/퍼퍼퍼/ 같은 교대운동속도(AMR) 과제는 한 조음기관의 반복 속도·규칙성을, ④문단 읽기는 말속도·명료도·운율을, ⑤음도 올리기는 후두의 음도 조절 범위를 주로 본다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"말 평가 과제(AMR·SMR·모음 연장)\",\"p\":\"마비말장애 평가 과제별로 주로 확인하는 기능 판단\",\"n\":\"모음 연장-호흡·발성 지속, AMR-한 조음기관의 반복 속도·규칙성, SMR-조음기관 사이 전환·순서화\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"50대 환자, 유전성 퇴행성 신경질환 진단\\n• 얼굴·어깨·손가락이 예측할 수 없이 빠르게 움찔거림\\n• 말하는 도중 갑자기 음도·음량이 커지거나 숨을 들이켜며 말이 끊김\\n• 말속도가 일정하지 않고, 손가락-코 검사의 측정이상은 뚜렷하지 않음\",\"q\":\"이 환자의 말 특성과 가장 관련 있는 마비말장애 유형은?\",\"choices\":[\"이완형\",\"과다운동형\",\"경직형\",\"실조형\",\"과소운동형\"],\"answer\":2,\"explain\":\"얼굴·몸의 빠르고 예측할 수 없는 불수의 운동(무도증)과 함께 갑작스러운 음도·음량 변화, 강제적 흡기로 인한 말 끊김이 나타나는 것은 기저핵 조절회로 손상에 의한 과다운동형 마비말장애로, 헌팅턴병이 대표적이다. ④실조형도 불규칙한 말 특성을 보이지만 측정이상 같은 소뇌 징후가 동반되고 불수의 운동은 없으며, ⑤과소운동형은 단조로운 음도·작은 음량과 말 돌진이 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"과다운동형 마비말장애(무도증)\",\"p\":\"불수의 운동과 갑작스러운 음도·음량 변화로 마비말장애 유형 판단\",\"n\":\"과다운동형: 기저핵 조절회로 손상, 불수의 운동으로 예측할 수 없는 음도·음량·말속도 변화(헌팅턴병 등)\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"비디오투시조영 삼킴검사(VFSS) 소견\\n• 묽은 액체 5mL를 삼키는 동안 조영제가 후두 입구로 들어감\\n• 조영제는 성대 아래로 내려가지 않았고, 삼킨 직후 후두 밖으로 배출됨\",\"q\":\"이 소견에 해당하는 용어로 옳은 것은?\",\"choices\":[\"후두 침투\",\"흡인\",\"무증상 흡인\",\"비강 역류\",\"인두 잔여물\"],\"answer\":1,\"explain\":\"음식물이 후두 입구(후두 전정)로 들어갔으나 성대 아래로 내려가지 않은 것은 후두 침투이다. ②흡인은 성대 아래(기관)까지 들어간 경우이고, ③무증상 흡인은 흡인되었는데도 기침 등 반응이 없는 경우이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"삼킴장애\",\"k\":\"후두 침투와 흡인 구분\",\"p\":\"VFSS에서 조영제가 내려간 깊이로 침투와 흡인 구분\",\"n\":\"후두 침투: 성대 위까지만 들어감, 흡인: 성대 아래로 내려감\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"VFSS 소견\\n• 후두 상승의 높이와 유지 시간이 부족함\\n• 상부식도괄약근이 충분히 열리지 않아 조롱박오목에 잔여물이 남음\\n• 지시 따르기와 새로운 동작 학습이 가능함\",\"q\":\"적용할 삼킴 기법으로 가장 적절한 것은?\",\"choices\":[\"성문위 삼킴법\",\"최대 성문위 삼킴법\",\"노력 삼킴법\",\"혀 내밀고 삼키기(마사코)\",\"멘델슨 기법\"],\"answer\":5,\"explain\":\"삼키는 동안 올라간 후두를 몇 초간 의도적으로 유지하게 하는 멘델슨 기법은 후두 상승의 범위·지속 시간을 늘려 상부식도괄약근이 더 넓고 길게 열리게 한다. ①②성문위 삼킴법은 성대 폐쇄를 돕는 기도 보호 기법이고, ④마사코 기법은 혀뿌리와 인두 후벽의 접촉을 강화하는 운동이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"삼킴장애\",\"k\":\"멘델슨 기법\",\"p\":\"후두 상승·상부식도괄약근 개방 저하에 맞는 삼킴 기법 선택\",\"n\":\"멘델슨 기법: 후두 상승을 유지해 상승 범위·시간과 상부식도괄약근 개방을 늘림\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"\",\"q\":\"비디오투시조영 삼킴검사(VFSS)와 비교한 섬유내시경 삼킴검사(FEES)의 특징으로 옳지 않은 것은?\",\"choices\":[\"방사선 노출이 없어 반복 검사가 쉽다\",\"병실 침상에서도 실시할 수 있다\",\"조영제 없이 실제 음식으로 검사한다\",\"삼키는 순간의 인두 내부를 가장 잘 본다\",\"인두·후두 점막과 분비물을 직접 본다\"],\"answer\":4,\"explain\":\"FEES는 삼키는 순간 인두가 수축하며 내시경 시야가 가려지는 화이트아웃이 생겨 그 순간을 직접 볼 수 없으므로, 삼킴 중 흡인과 구강·식도 단계 평가는 VFSS가 유리하다. ①②③⑤는 FEES의 장점이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"삼킴장애\",\"k\":\"FEES와 VFSS 비교\",\"p\":\"두 삼킴 검사의 장단점을 비교해 FEES에 대한 잘못된 진술 판별\",\"n\":\"FEES: 방사선 없음·침상 가능·점막 직접 관찰, 삼키는 순간은 화이트아웃으로 보이지 않음\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"70대 환자\\n• 하루에도 주의력과 각성 수준이 크게 오르내림\\n• 방 안에 아이들이 앉아 있다는 구체적이고 생생한 환시를 반복해 호소함\\n• 손 떨림, 느린 동작, 근육 경직이 동반됨\\n• 잠을 자며 꿈속 행동을 실제로 하는 렘수면 행동장애가 있음\",\"q\":\"가장 가능성이 높은 진단은?\",\"choices\":[\"루이소체 치매\",\"알츠하이머 치매\",\"혈관성 치매\",\"행동변이 전두측두엽 치매\",\"크로이츠펠트-야콥병\"],\"answer\":1,\"explain\":\"인지 기능의 변동, 반복되는 생생한 환시, 파킨슨증, 렘수면 행동장애는 루이소체 치매의 핵심 특징이다. ②알츠하이머 치매는 초기 일화기억 저하가 두드러지고, ④행동변이 전두측두엽 치매는 초기 성격·행동 변화가 두드러진다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"루이소체 치매 식별\",\"p\":\"인지 변동·환시·파킨슨증·렘수면 행동장애로 치매 유형 판단\",\"n\":\"루이소체 치매: 인지 변동, 생생한 환시, 파킨슨증, 렘수면 행동장애\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"외상성 뇌손상 후 회복 중인 환자\\n• 깨어 있으나 매우 흥분해 소리를 지르고 침대에서 내려오려 함\\n• 주의 지속 시간이 매우 짧고, 자신의 상황과 주변 환경을 이해하지 못함\\n• 치료사가 다가가면 밀치며 협조를 거부함\",\"q\":\"란초 로스 아미고스 인지기능척도(RLA)에서 이 환자의 수준으로 가장 적절한 것은?\",\"choices\":[\"Ⅱ단계 – 전반적 반응\",\"Ⅲ단계 – 국소적 반응\",\"Ⅳ단계 – 혼돈·초조\",\"Ⅴ단계 – 혼돈·부적절\",\"Ⅶ단계 – 자동적·적절\"],\"answer\":3,\"explain\":\"깨어 있으나 과활동·공격성 같은 초조 행동이 두드러지고, 주의가 매우 짧으며 상황을 이해하지 못하는 시기는 RLA Ⅳ단계(혼돈·초조)이다. ②Ⅲ단계는 자극에 특정하지만 일관되지 않은 반응을 보이는 단계이고, ④Ⅴ단계는 초조는 줄었으나 혼돈과 부적절한 반응이 남는 단계이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"란초 로스 아미고스 단계\",\"p\":\"외상성 뇌손상 환자의 행동 양상으로 RLA 인지기능 단계 판단\",\"n\":\"RLA Ⅳ단계(혼돈·초조): 초조·공격 행동, 매우 짧은 주의, 상황 이해 불가\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"우반구 뇌졸중 환자와의 대화\\n치료사: (부채질하며) \\\"창문 좀 열어 줄 수 있으세요?\\\"\\n환자: \\\"네, 열 수 있어요.\\\" (그대로 앉아 있음)\\n• 오른팔 사용에는 제한이 없음\\n• 낱말 이해·문법·이름대기 검사 결과는 정상 범위\",\"q\":\"이 반응에서 드러나는 문제로 가장 적절한 것은?\",\"choices\":[\"청각적 낱말 이해의 손상\",\"간접 요청의 의도 이해 저하\",\"작업기억 용량의 감소\",\"왼쪽 공간에 대한 편측무시\",\"정서적 운율 산출의 저하\"],\"answer\":2,\"explain\":\"언어 형식은 정상인데 '열어 줄 수 있느냐'를 능력에 대한 질문으로만 받아들이고 요청 의도를 알아차리지 못하는 것은 우반구 손상 후 나타나는 간접화행·함축 이해의 화용 문제이다. ①낱말 이해는 검사에서 정상이며, ④편측무시와 ⑤운율 산출 저하로는 이 반응을 설명할 수 없다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"우반구 손상 간접화행 이해\",\"p\":\"간접 요청을 문자 그대로 해석하는 반응으로 우반구 손상의 화용 문제 판단\",\"n\":\"우반구 손상: 간접화행·함축·비유 등 문자 그대로가 아닌 의미 이해 저하\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사 설명\\n• 기억, 지남력, 판단력과 문제해결, 사회활동, 집안생활과 취미, 위생과 몸치장의 6개 영역을 평정함\\n• 환자와 보호자 면담 정보를 종합해 치매의 전반적 중증도를 0, 0.5, 1, 2, 3 등으로 판정함\",\"q\":\"해당하는 검사 도구는?\",\"choices\":[\"한국판 간이정신상태검사(K-MMSE)\",\"서울신경심리검사(SNSB)\",\"한국판 보스턴 이름대기 검사(K-BNT)\",\"전반적 퇴화 척도(GDS)\",\"임상치매척도(CDR)\"],\"answer\":5,\"explain\":\"6개 영역을 면담으로 평정해 0(정상)~3(중증) 등으로 치매의 전반적 중증도를 판정하는 도구는 임상치매척도(CDR)이다. ④GDS는 정상부터 최중증까지 7단계로 퇴화 정도를 구분하고, ①K-MMSE는 환자가 직접 수행하는 30점 만점의 인지 선별검사이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"임상치매척도(CDR)\",\"p\":\"평정 영역과 판정 방식으로 치매 중증도 평가 도구 식별\",\"n\":\"CDR: 6개 영역을 면담으로 평정해 0~3 등으로 치매 중증도 판정\"}},{\"grade\":2,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌손상 환자의 주의 훈련 과제\\n• 화면에 숫자가 하나씩 나타남\\n• 처음에는 홀수가 나오면 버튼을 누르고, 신호음이 울리면 짝수가 나올 때 누르도록 바꿈\\n• 신호음이 날 때마다 두 규칙을 번갈아 적용함\",\"q\":\"이 과제가 주로 훈련하는 주의 유형은?\",\"choices\":[\"지속적 주의\",\"선택적 주의\",\"분할 주의\",\"교대 주의\",\"초점 주의\"],\"answer\":4,\"explain\":\"신호에 따라 반응 규칙을 바꾸며 주의를 옮기는 인지적 유연성을 요구하는 과제는 교대 주의 훈련이다. ①지속적 주의는 한 과제에 오랫동안 주의를 유지하는 것, ②선택적 주의는 방해 자극을 무시하고 목표에 집중하는 것, ③분할 주의는 두 과제를 동시에 처리하는 것이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"인지의사소통장애\",\"k\":\"교대 주의 훈련\",\"p\":\"규칙 전환 과제가 훈련하는 주의 유형 판단\",\"n\":\"교대 주의: 서로 다른 인지 요구를 가진 과제 사이를 유연하게 전환하는 능력\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\",\"q\":\"말더듬 성인의 신경생리학적 특성에 대한 설명으로 옳은 것은?\",\"choices\":[\"말할 때 좌반구 청각 영역의 활성화가 정상 화자보다 증가한다\",\"말할 때 우반구 운동·전운동 영역의 과활성화가 관찰된다\",\"좌우 대뇌 반구의 언어 기능 분화가 정상 화자보다 뚜렷하다\",\"말할 때 소뇌의 활성화가 정상 화자보다 일관되게 감소한다\",\"지연청각피드백을 주면 말더듬이 일관되게 증가한다\"],\"answer\":2,\"explain\":\"뇌영상 연구에서 말더듬 성인은 말할 때 우반구 운동·전운동 영역의 과활성화와 좌반구 청각 영역의 활성 저하를 보인다. ①은 증가가 아니라 감소이고, ③ 반구 기능 분화는 오히려 덜 뚜렷하며, ④ 소뇌는 과활성화가 보고된다. ⑤ 지연청각피드백은 말더듬을 줄이는 조건이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"말더듬 신경생리 특성\",\"p\":\"뇌영상 연구에서 보고된 말더듬 성인의 뇌 활성 특성 판별\",\"n\":\"말더듬 성인: 우반구 운동영역 과활성화, 좌반구 청각영역 활성 저하, 소뇌 과활성화\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 3세 아동이 또래 수준의 긴장 없는 반복을 보임\\n• 부모가 이를 '말더듬'이라 부르며 아동이 말할 때마다 지적하기 시작함\\n• 이후 아동이 반복하지 않으려 애쓰며 말하기 전에 긴장하게 되었고 비유창성이 심해짐\",\"q\":\"이 과정을 가장 잘 설명하는 이론은?\",\"choices\":[\"요구-용량 모델\",\"대뇌 반구 우세 이론\",\"이중 접근-회피 갈등 이론\",\"진단착오 이론\",\"내적 수정 가설\"],\"answer\":4,\"explain\":\"Johnson의 진단착오 이론은 정상적 비유창성을 부모가 말더듬으로 잘못 판단하고 반응하면 아동이 말을 피하고 긴장하게 되어 말더듬이 생긴다고 본다. ① 요구-용량 모델은 환경 요구가 아동의 말 산출 용량을 넘을 때, ③ Sheehan의 이론은 말하려는 욕구와 피하려는 욕구의 갈등으로, ⑤ 내적 수정 가설은 음운 부호화 오류를 말하기 전에 고치는 과정으로 말더듬을 설명한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"진단착오 이론\",\"p\":\"부모의 잘못된 명명과 반응이 말더듬을 만든다는 이론 식별\",\"n\":\"진단착오 이론(Johnson): 정상적 비유창성을 말더듬으로 진단·반응한 것이 말더듬의 원인\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\",\"q\":\"성인 말더듬에서 말더듬이 더 자주 나타나는 언어적 위치로 옳은 것은?\",\"choices\":[\"문장의 첫머리에 놓인 낱말\",\"문장의 끝에 놓인 서술어\",\"조사·어미 같은 짧은 기능어\",\"낱말의 마지막 음절\",\"자주 쓰는 친숙한 낱말\"],\"answer\":1,\"explain\":\"Brown은 성인 말더듬이 문장의 앞부분, 내용어, 긴 낱말, 자음으로 시작하는 낱말에서 더 많이 나타난다고 보고하였다. 낱말 안에서는 첫 음절에 집중되므로 ④는 틀리고, ③ 기능어에서 더 더듬는 경향은 학령전 아동의 특성이다. ⑤ 사용 빈도가 낮은 낱말에서 오히려 더 많이 더듬는다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"말더듬 출현 위치(Brown)\",\"p\":\"성인 말더듬이 많이 나타나는 언어적 위치 판단\",\"n\":\"성인 말더듬은 문장 앞부분·내용어·긴 낱말·낱말 첫 음절에서 많음(Brown)\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\",\"q\":\"말더듬의 유전적 요인에 대한 설명으로 옳은 것은?\",\"choices\":[\"단일 우성 유전자로 말더듬 발생 여부가 결정된다\",\"말더듬 가족력은 발생 위험과 관련이 없다\",\"일란성 쌍생아의 일치율이 이란성보다 높다\",\"입양 아동은 양부모의 말더듬 여부와 가장 관련된다\",\"남녀 비율은 연령이 높아질수록 1:1에 가까워진다\"],\"answer\":3,\"explain\":\"쌍생아 연구에서 일란성 쌍생아의 말더듬 일치율이 이란성보다 높아 유전적 소인이 지지된다. 말더듬은 여러 유전자와 환경이 함께 작용하므로 ①은 틀리고, ② 가족력은 발생 위험을 높인다. ⑤ 여아의 자연회복률이 높아 연령이 높아질수록 남아 비율이 더 커진다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"말더듬 유전 요인\",\"p\":\"쌍생아·가족력·성비 자료로 본 말더듬 유전 특성 판별\",\"n\":\"일란성 쌍생아 일치율 > 이란성, 가족력은 위험 요인, 성비는 연령 증가에 따라 남아 쪽으로 커짐\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 아동의 대화 발화 다섯 개를 전사함\\n• '―'는 앞 소리를 늘여 발음한 것을 나타냄\",\"q\":\"비정상적 비유창성(진성 비유창성)이 포함된 발화는?\",\"choices\":[\"\\\"음, 나 그거 먹을래.\\\"\",\"\\\"엄마가, 아니 아빠가 사 줬어.\\\"\",\"\\\"그래서 그래서 놀이터 갔어.\\\"\",\"\\\"내가 그거, 그 장난감 할래.\\\"\",\"\\\"ㅅ――사탕 주세요.\\\"\"],\"answer\":5,\"explain\":\"⑤는 /ㅅ/를 늘인 연장(비운율적 발성)으로 P-FA-II의 비정상적 비유창성, Yairi와 Ambrose의 진성 비유창성(SLD)에 모두 해당한다. ①은 간투사, ②는 수정, ④는 미완성·수정이다. ③은 다음절 낱말을 긴장 없이 1회 반복한 것으로 P-FA-II에서는 정상적 비유창성(반복1), Yairi와 Ambrose 체계에서는 기타 비유창성이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"비정상적 비유창성 판별\",\"p\":\"전사 발화에서 두 분류 체계 모두 비정상적으로 보는 비유창성 찾기\",\"n\":\"연장·막힘(비운율적 발성)과 낱말부분 반복은 비정상적(진성) 비유창성, 간투사·수정·다음절 낱말/구 반복은 정상적(기타) 비유창성\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 3세 6개월 아동의 대화 표본: 300음절\\n• 낱말부분 반복 7회, 막힘 3회, 연장 2회\\n• 간투사 9회, 수정 4회, 구 반복 3회\\n• 분류 기준: Yairi와 Ambrose 체계(낱말부분 반복·단음절 낱말 반복·비운율적 발성을 진성 비유창성으로 봄)\",\"q\":\"100음절당 진성 비유창성(SLD) 빈도는?\",\"choices\":[\"2.0회\",\"4.0회\",\"5.3회\",\"9.3회\",\"12.0회\"],\"answer\":2,\"explain\":\"진성 비유창성은 낱말부분 반복 7회+막힘 3회+연장 2회 = 12회이고, 12 ÷ 300 × 100 = 4.0회이다. ③ 5.3회는 기타 비유창성(16회)의 빈도, ④ 9.3회는 전체 비유창성(28회)의 빈도이며, ⑤는 100음절 기준으로 환산하지 않은 횟수이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"100음절당 SLD 빈도 계산\",\"p\":\"유형별 비유창성 횟수로 100음절당 진성 비유창성 빈도 산출\",\"n\":\"SLD 빈도 = 진성 비유창성 횟수 ÷ 전체 음절 수 × 100\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 아동 발화에서 관찰된 낱말부분 반복 4개\\n• \\\"자자자동차\\\", \\\"바바바나나\\\", \\\"토토토토끼\\\", \\\"기기기기차\\\"\",\"q\":\"평균 단위반복수는?\",\"choices\":[\"2.5\",\"3\",\"3.5\",\"4\",\"10\"],\"answer\":1,\"explain\":\"단위반복수는 목표 낱말을 말하기 전에 반복 단위가 되풀이된 횟수로, '자자자동차' 2, '바바바나나' 2, '토토토토끼' 3, '기기기기차' 3이다. 합계 10을 반복 사례 4개로 나누면 평균 단위반복수는 2.5이다. ② 3은 최댓값, ③ 3.5는 반복 단위가 산출된 전체 횟수(예: '자자자'를 3으로 셈)의 평균, ④ 4는 사례 수, ⑤ 10은 합계이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"평균 단위반복수 산출\",\"p\":\"여러 낱말부분 반복의 단위반복수를 세어 평균 구하기\",\"n\":\"단위반복수 = 목표 산출 전 반복된 횟수, 평균 = 합계 ÷ 반복 사례 수\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 대화 표본 발화 시간(쉼 포함): 1분 30초\\n• 전체 음절 수(비유창 음절 포함): 270음절\\n• 250ms 이상의 쉼 시간 합계: 18초\",\"q\":\"전체 말속도는?\",\"choices\":[\"120음절/분\",\"150음절/분\",\"180음절/분\",\"225음절/분\",\"270음절/분\"],\"answer\":3,\"explain\":\"전체 말속도는 쉼을 포함한 전체 발화 시간으로 전체 음절 수를 나눈 값이므로 270음절 ÷ 1.5분 = 180음절/분이다. ④ 225음절/분은 쉼 18초를 뺀 72초로 나눈 값으로 조음속도 산출 방식에 가깝다. ⑤는 발화 시간을 1분으로 잘못 계산한 값이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"전체 말속도 계산\",\"p\":\"발화 시간과 음절 수로 분당 음절수(전체 말속도) 산출\",\"n\":\"전체 말속도 = 전체 음절 수 ÷ 쉼 포함 발화 시간(분), 조음속도는 쉼·비유창 시간을 제외\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 아동의 대화 표본에서 나타난 비유창성을 유형별 비율로 나타냄 [그림 1]\\n• 분석 기준: 간투사·수정·구 반복은 정상적 비유창성(ND), 낱말부분 반복·연장·막힘은 비정상적 비유창성(AD)으로 분류함\",\"q\":\"[그림 1]에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"정상적 비유창성이 전체 비유창성의 절반을 넘는다\",\"비정상적 비유창성 중 가장 많은 유형은 막힘이다\",\"반복 유형(낱말부분·구 반복)이 전체의 절반을 넘는다\",\"비정상적 비유창성이 70%로 말더듬을 시사하는 분포이다\",\"비운율적 발성(연장·막힘)은 전체의 4분의 1 미만이다\"],\"answer\":4,\"explain\":\"그림에서 낱말부분 반복 35%, 막힘 20%, 연장 15%를 더하면 비정상적 비유창성은 70%, 간투사 15%, 수정 10%, 구 반복 5%를 더한 정상적 비유창성은 30%이다. 비유창성의 대부분이 비정상적 유형이므로 말더듬을 시사한다. ① 정상적 비유창성은 30%, ② 가장 많은 유형은 낱말부분 반복(35%), ③ 반복 유형은 40%, ⑤ 비운율적 발성은 35%이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"비유창성 유형 비율 해석\",\"p\":\"파이차트의 유형별 비율을 합산해 정상·비정상 비유창성 비중과 말더듬 시사 여부 판단\",\"n\":\"비유창성 중 비정상적(진성) 유형의 비중이 절반을 크게 넘으면 말더듬을 시사\"},\"image\":\"data:image/svg+xml;base64,\"},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\",\"q\":\"SSI-4에서 '신체적 부수행동'으로 평정하는 범주에 해당하는 것은?\",\"choices\":[\"말속도의 변화\",\"회피한 낱말의 수\",\"말더듬 예기 빈도\",\"의사소통 태도\",\"머리 움직임\"],\"answer\":5,\"explain\":\"SSI-4의 신체적 부수행동은 산만한 소리, 얼굴 찡그림, 머리 움직임, 사지 움직임의 4범주를 각각 0~5점으로 평정한다. ①~④는 SSI-4의 신체적 부수행동 범주에 포함되지 않으며, ④ 의사소통 태도는 CAT·S-24 같은 태도 검사로 평가한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"SSI-4 신체적 부수행동 범주\",\"p\":\"SSI-4 신체적 부수행동 평정 범주 식별\",\"n\":\"SSI-4 신체적 부수행동: 산만한 소리·얼굴 찡그림·머리 움직임·사지 움직임(각 0~5점)\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 아동, 막힐 때 눈을 깜빡이는 행동이 관찰됨\\n• 아동이 자기 말에 대해 어떤 태도를 갖고 있는지 알아보려 함\\n• 아동에게 짧은 질문을 하고 예/아니오로 답하게 함\",\"q\":\"가장 적절한 검사는?\",\"choices\":[\"말더듬 전반적 경험 평가(OASES-A)\",\"Erickson 의사소통 태도 척도(S-24)\",\"의사소통 태도 검사(KiddyCAT)\",\"말더듬 지각 검사(PSI)\",\"말더듬 중증도 검사(SSI-4)\"],\"answer\":3,\"explain\":\"KiddyCAT은 3~6세 학령전 아동에게 짧은 질문을 하고 예/아니오로 답하게 하여 말에 대한 태도를 평가하는 도구이다. ① OASES-A, ② S-24, ④ PSI는 성인용 자기보고 도구이고, ⑤ SSI-4는 말더듬 행동의 중증도를 측정한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"KiddyCAT 선택\",\"p\":\"학령전 아동의 말 태도를 평가할 도구 선택\",\"n\":\"KiddyCAT: 학령전 아동용 의사소통 태도 검사(예/아니오 응답)\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\",\"q\":\"말더듬 평가를 위한 발화 표본 수집에 대한 설명으로 가장 적절한 것은?\",\"choices\":[\"상황 변동이 크므로 여러 상황의 표본을 모은다\",\"치료실 표본 하나로 일상의 말더듬 정도를 대표한다\",\"학령전 아동은 읽기 과제만으로 %SS를 산출한다\",\"표본은 50음절 이하로 짧게 모아야 정확하다\",\"보호자가 녹음한 가정 표본은 분석에 쓰지 않는다\"],\"answer\":1,\"explain\":\"말더듬은 상대·장소·과제에 따라 빈도가 크게 달라지므로 치료실 대화, 읽기, 가정 녹음 등 여러 상황의 표본을 모아야 실제 정도를 반영할 수 있다. ② 치료실 표본 하나는 대표성이 부족하고, ③ 학령전 아동은 읽기 과제를 쓸 수 없다. ④ 표본은 충분한 길이가 필요하며, ⑤ 가정 녹음 표본은 일상 말더듬을 보여 주는 유용한 자료이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"발화 표본 수집 원칙\",\"p\":\"말더듬 평가 시 표본 수집 방법의 적절성 판단\",\"n\":\"말더듬은 상황 변동성이 크므로 여러 상황(가정 녹음 포함)의 충분한 표본 필요\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\",\"q\":\"말더듬 평가도구에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"S-24 – 성인의 의사소통 태도를 24개 참/거짓 문항으로 평가\",\"CAT – 학령기 아동이 말에 대한 태도를 직접 답하는 자기보고 검사\",\"P-FA-II – 정상적 비유창성과 비정상적 비유창성을 구분하여 분석\",\"SSI-4 – 빈도·지속시간·신체적 부수행동 점수로 중증도를 산출\",\"OASES – 학령전 아동의 비유창성 빈도를 부모가 기록하는 관찰 척도\"],\"answer\":5,\"explain\":\"OASES는 말을 더듬는 당사자(학령기·청소년·성인용)가 말더듬에 대한 일반 정보, 반응, 일상 의사소통, 삶의 질을 자기보고하는 도구로, 부모가 비유창성 빈도를 기록하는 척도가 아니다. ①, ②는 태도 자기보고 검사, ③은 비유창성을 정상적·비정상적으로 나누어 분석하는 국내 검사, ④는 말더듬 행동의 중증도 검사로 옳은 설명이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"말더듬 평가도구 특성\",\"p\":\"여러 말더듬 평가도구의 대상과 평가 내용 정오 판단\",\"n\":\"OASES: 당사자 자기보고(일반 정보·반응·일상 의사소통·삶의 질), SSI-4: 빈도·지속시간·신체적 부수행동\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 10세 아동, 막힘이 주된 핵심행동임\\n• 막힐 때 눈을 깜빡이고 고개를 뒤로 젖힘\\n• 특정 낱말을 말해야 할 때 미리 두려워하며 다른 낱말로 바꿔 말함\\n• 수업 중 발표 상황을 피하려 함\",\"q\":\"Guitar의 말더듬 발달 단계 중 가장 적절한 것은?\",\"choices\":[\"정상적 비유창성\",\"경계선급 말더듬\",\"초급 말더듬\",\"중급 말더듬\",\"고급 말더듬\"],\"answer\":4,\"explain\":\"막힘과 탈출행동에 더해 말더듬을 예기하고 두려워하며 낱말·상황을 회피하는 것은 중급 말더듬의 특징이며, 주로 학령기에 나타난다. ③ 초급 말더듬은 긴장된 반복·막힘과 탈출행동은 있으나 두려움과 회피가 뚜렷하지 않고, ⑤ 고급 말더듬은 청소년 후기·성인에게서 오래 굳어진 패턴과 강한 부정적 감정·자아개념을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"발달 단계·감별\",\"k\":\"Guitar 중급 말더듬\",\"p\":\"핵심행동·부수행동·회피 양상으로 말더듬 발달 단계 판단\",\"n\":\"중급 말더듬: 막힘+탈출행동+예기·두려움에 따른 낱말·상황 회피(주로 학령기)\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 35세 성인, 심한 정서적 충격을 겪은 직후 갑자기 말더듬이 시작됨\\n• 아동기 말더듬 병력이 없고 신경학적 검사에서 이상 소견이 없음\\n• 낱말의 첫 음절뿐 아니라 중간·끝 음절에서도 반복이 나타남\\n• 같은 글을 반복해 읽거나 함께 읽어도 말더듬이 줄지 않음\",\"q\":\"가장 가능성이 높은 유형은?\",\"choices\":[\"발달성 말더듬\",\"심인성 말더듬\",\"신경인성 말더듬\",\"속화\",\"말실행증\"],\"answer\":2,\"explain\":\"심리적 사건 직후 갑자기 시작되고, 신경학적 이상이 없으며, 첫 음절 외 위치에서도 반복되고 적응효과·함께 읽기 효과가 없는 양상은 심인성 말더듬을 시사한다. ③ 신경인성 말더듬도 위치가 다양하고 적응효과가 적지만 뇌졸중·뇌손상 등 신경학적 원인이 확인되어야 한다. ① 발달성 말더듬은 아동기에 시작하고 주로 첫 음절에서 나타나며, ④ 속화는 빠르고 불규칙한 말속도가 중심이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"발달 단계·감별\",\"k\":\"심인성 말더듬 감별\",\"p\":\"발병 경위·신경학적 소견·비유창성 위치로 말더듬 유형 감별\",\"n\":\"심인성 말더듬: 정서적 사건 후 급성 발병, 신경학적 이상 없음, 다양한 위치의 반복, 적응효과 없음\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\",\"q\":\"학령전 아동의 비유창성 중 정상적 비유창성보다 말더듬을 더 시사하는 소견은?\",\"choices\":[\"구 단위를 1회, 긴장 없이 반복한다\",\"문장 사이에 '음', '어' 같은 간투사를 넣는다\",\"낱말부분 반복에서 모음이 '으'처럼 약화된다\",\"말하던 문장을 멈추고 다른 문장으로 고친다\",\"피곤하거나 흥분했을 때 비유창성이 잠시 는다\"],\"answer\":3,\"explain\":\"낱말부분 반복에서 원래 모음 대신 중성모음('으' 등)으로 약화되는 것(예: '브브버스')은 말더듬을 시사하는 경고 신호이다. ① 긴장 없는 구 반복, ② 간투사, ④ 수정은 정상적 비유창성에 해당하고, ⑤ 피로·흥분에 따른 일시적 증가는 정상 아동에게도 나타난다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"발달 단계·감별\",\"k\":\"말더듬 경고 신호\",\"p\":\"정상적 비유창성과 말더듬을 구분하는 질적 특징 판별\",\"n\":\"낱말부분 반복 시 모음 중성화(슈와 대치)는 말더듬 경고 신호\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• ㄱ. 남아임\\n• ㄴ. 성인까지 말더듬이 지속된 가족이 있음\\n• ㄷ. 발병 후 12개월이 지나도 비유창성이 줄지 않음\\n• ㄹ. 왼손잡이임\\n• ㅁ. 형제 중 첫째임\",\"q\":\"학령전 아동의 말더듬 지속(비회복) 위험 요인으로 옳은 것을 모두 고른 것은?\",\"choices\":[\"ㄱ, ㄴ\",\"ㄱ, ㄴ, ㄷ\",\"ㄱ, ㄷ, ㅁ\",\"ㄴ, ㄹ, ㅁ\",\"ㄱ, ㄴ, ㄷ, ㄹ\"],\"answer\":2,\"explain\":\"남아, 말더듬이 지속된 가족력, 발병 후 오랜 기간(약 12개월 이상) 비유창성이 줄지 않는 경과는 말더듬 지속 위험을 높이는 요인이다. ㄹ 손잡이와 ㅁ 출생 순위는 말더듬 지속을 예측하는 요인으로 인정되지 않으므로 이를 포함한 ③~⑤는 틀리고, ①은 ㄷ이 빠져 있다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"발달 단계·감별\",\"k\":\"말더듬 지속 위험 요인\",\"p\":\"학령전 아동의 말더듬 지속 위험 요인 판별\",\"n\":\"지속 위험 요인: 남아, 지속된 가족력, 발병 후 12개월 이상 경과에도 감소 없음\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"리드콤 프로그램 1단계 가정 연습 장면\\n• 아동: \\\"나나나는 공룡 좋아.\\\"\\n• 부모: \\\"다시 한번 말해 볼래?\\\"\\n• 아동: \\\"나는 공룡 좋아.\\\"\",\"q\":\"부모가 사용한 구어 수반 자극은?\",\"choices\":[\"유창한 말 칭찬하기\",\"유창한 말 인정하기\",\"자기 평가 요청하기\",\"더듬은 말 인정하기\",\"자기 수정 요청하기\"],\"answer\":5,\"explain\":\"더듬은 말 뒤에 다시 말해 보게 하는 것은 리드콤의 '자기 수정 요청하기'이다. ④ 더듬은 말 인정하기는 '조금 울퉁불퉁했네'처럼 더듬었음을 중립적으로 알려 주는 것이고, ③ 자기 평가 요청하기는 유창하게 말한 뒤 '부드럽게 말했니?'처럼 스스로 판단하게 하는 것이다. ①, ②는 유창한 말 뒤에 주는 자극이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"리드콤 구어 수반 자극\",\"p\":\"부모-아동 대화에서 사용된 리드콤 구어 수반 자극 유형 식별\",\"n\":\"리드콤: 유창한 말-칭찬·인정·자기 평가 요청, 더듬은 말-인정·자기 수정 요청\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\",\"q\":\"학령전 말더듬 아동의 부모 상담 내용으로 적절하지 않은 것은?\",\"choices\":[\"아이가 더듬어도 끝까지 기다리며 말의 내용에 반응한다\",\"부모가 평소보다 조금 느리고 여유 있게 말한다\",\"하루 중 아이와 일대일로 대화하는 시간을 정해 둔다\",\"아이가 더듬을 때마다 \\\"천천히 말해\\\"라고 알려 준다\",\"가족 대화에서 아이가 말할 차례를 충분히 갖게 한다\"],\"answer\":4,\"explain\":\"더듬을 때마다 말하는 방법을 지시하면 아동이 자기 말을 부정적으로 의식하고 말에 대한 부담이 커질 수 있으므로 권하지 않는다. ①은 의사소통 압박을 줄이고, ②는 느린 말 모델을 제공하며, ③, ⑤는 편안하게 말할 기회를 늘리는 적절한 상담 내용이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"부모 상담 부적절 내용\",\"p\":\"학령전 말더듬 아동 부모에게 줄 조언의 적절성 판단\",\"n\":\"부모는 말 방법을 지시하기보다 느린 말 모델, 기다려 주기, 말할 기회 보장으로 환경을 조정\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 말더듬 아동과 부모\\n• 치료사와 부모가 부모-아동 놀이 영상을 함께 보며 아동의 유창성에 도움이 되는 상호작용 전략을 찾음\\n• 부모는 가정에서 주 3~5회, 5분간 '특별한 시간'을 갖고 고른 전략을 연습함\",\"q\":\"이 아동에게 적용한 접근은?\",\"choices\":[\"팔린 PCI 치료\",\"리드콤 프로그램\",\"캠퍼다운 프로그램\",\"말더듬 수정법\",\"지연청각피드백 훈련\"],\"answer\":1,\"explain\":\"팔린 부모-아동 상호작용(PCI) 치료는 영상 피드백으로 부모가 스스로 도움이 되는 상호작용 전략을 고르고, 가정에서 짧은 '특별한 시간'에 연습하는 간접 중심 접근이다. ② 리드콤은 부모가 아동의 유창한 말과 더듬은 말에 구어 수반 자극을 주는 직접 행동치료이고, ③ 캠퍼다운은 청소년·성인 대상 연장 발화 프로그램이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"팔린 PCI 식별\",\"p\":\"부모-아동 상호작용 영상 피드백과 특별한 시간으로 치료 접근 식별\",\"n\":\"팔린 PCI: 영상 피드백으로 상호작용 전략 선택, 가정에서 주 3~5회 5분 특별한 시간\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 5세 아동, 말더듬 시작 후 1년 6개월 경과\\n• 막힘이 잦고 막힐 때 발을 구르는 행동이 있음\\n• \\\"나는 말을 못 해\\\"라며 좌절함\\n• 3개월간 부모 상담 중심의 간접치료 후에도 변화가 없음\",\"q\":\"다음 단계로 가장 적절한 접근은?\",\"choices\":[\"부모 상담만 이어 가며 아동의 말더듬은 언급하지 않는다\",\"자연회복을 기다리며 6개월 뒤에 다시 평가한다\",\"놀이 속에서 느리고 쉬운 말을 모델링하고 연습시킨다\",\"더듬을 때마다 멈추고 처음부터 다시 말하게 한다\",\"회피 상황 위계를 만들어 성인처럼 직면 훈련을 한다\"],\"answer\":3,\"explain\":\"발병 후 1년 이상 지나고 막힘·부수행동·부정적 인식이 있으며 간접치료에 반응이 없으므로, 놀이 맥락에서 느리고 쉬운 말을 직접 모델링하고 연습하는 직접치료로 넘어가는 것이 적절하다. ①, ② 간접치료 유지나 관찰은 지속 위험이 큰 아동에게 부적절하고, ④는 처벌적 반응이 되며, ⑤는 학령전 아동의 발달 수준에 맞지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"학령전 직접치료 전환\",\"p\":\"간접치료에 반응 없는 학령전 아동의 다음 중재 선택\",\"n\":\"인식·부수행동이 있고 간접치료에 반응 없는 학령전 아동은 놀이 속 쉬운 말 직접치료로 전환\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 유창성 형성법 프로그램을 진행 중인 성인\\n• /ㅂ/, /ㄷ/로 시작하는 낱말에서 입술과 혀를 세게 붙이며 막힘\\n• 치료사는 입술과 혀가 살짝 닿을 정도로 힘을 빼고 부드럽게 조음하도록 연습시킴\",\"q\":\"치료사가 사용한 기법은?\",\"choices\":[\"부드러운 발성 시작\",\"가벼운 조음 접촉\",\"연장 발화\",\"취소\",\"빠져나오기\"],\"answer\":2,\"explain\":\"파열음 등에서 조음기관의 접촉 압력을 줄여 가볍게 닿게 하는 것은 가벼운 조음 접촉이다. ① 부드러운 발성 시작은 모음 등에서 성대 진동을 서서히 시작하는 기법이고, ③ 연장 발화는 음절을 늘여 말속도를 낮추는 기법이다. ④ 취소와 ⑤ 빠져나오기는 말더듬 수정법의 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"가벼운 조음 접촉\",\"p\":\"조음기관 접촉 압력을 줄이는 유창성 형성 기법 식별\",\"n\":\"가벼운 조음 접촉: 입술·혀 등 조음기관을 가볍게 닿게 하여 막힘 감소\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 고등학생, 치료실에서는 연장 발화를 사용해 낭독과 대화를 거의 유창하게 함\\n• 이번 회기부터 매점에서 주문하기 → 교사에게 질문하기 → 전화로 문의하기 순으로 실제 상황 과제를 정해 연습함\",\"q\":\"유창성 형성법의 어느 단계에 해당하는가?\",\"choices\":[\"확인 단계\",\"확립 단계\",\"둔감 단계\",\"유지 단계\",\"전이 단계\"],\"answer\":5,\"explain\":\"치료실에서 확립한 유창한 말을 쉬운 상황부터 어려운 상황까지 위계에 따라 실제 생활로 넓히는 것은 전이 단계이다. ② 확립 단계는 치료실에서 유창한 말을 처음 익히는 단계이고, ④ 유지 단계는 치료 종결 후 유창성을 스스로 관리하는 단계이다. ①, ③은 말더듬 수정법의 단계이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"유창성 형성법 전이 단계\",\"p\":\"치료 장면 설명으로 유창성 형성법 단계 판단\",\"n\":\"유창성 형성법: 확립(치료실) → 전이(실생활 위계) → 유지(자기 관리)\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 수정법을 진행 중인 성인\\n• 치료사와 함께 거리에서 행인에게 길을 물으며 일부러 느슨하고 쉬운 반복으로 더듬음\\n• 행인의 반응을 관찰하고 그때의 느낌을 치료사와 이야기함\",\"q\":\"이 활동의 주된 목적은?\",\"choices\":[\"말더듬에 대한 두려움을 줄인다\",\"말속도를 늦춰 유창한 말을 확립한다\",\"막힘 순간에서 빠져나오는 법을 익힌다\",\"호흡과 발성의 협응을 향상시킨다\",\"핵심행동의 빈도를 정확히 측정한다\"],\"answer\":1,\"explain\":\"일부러 더듬는 자발적 말더듬과 청자 반응 관찰은 둔감 단계의 활동으로, 말더듬에 대한 두려움·수치심과 청자 반응에 대한 민감도를 낮추는 것이 목적이다. ② 유창한 말 확립은 유창성 형성법의 목표이고, ③ 빠져나오기는 수정 단계의 기법이며, ⑤ 빈도 측정은 평가 활동이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"자발적 말더듬 목적\",\"p\":\"자발적 말더듬 활동의 치료적 목적 판단\",\"n\":\"자발적 말더듬: 둔감 단계에서 두려움·수치심과 민감도를 낮추는 활동\"}},{\"grade\":2,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\",\"q\":\"말더듬 성인의 치료 후 재발을 줄이기 위한 유지 단계 전략으로 가장 적절한 것은?\",\"choices\":[\"유창해지면 곧바로 종결하고 추후 점검은 하지 않는다\",\"다시 더듬는 순간이 생기면 치료 실패로 안내한다\",\"치료실 안 유창성에 집중하고 일상 과제는 줄인다\",\"회기 간격을 점차 늘리며 스스로 말을 점검하게 한다\",\"감정과 태도는 다루지 않고 기법 연습만 반복한다\"],\"answer\":4,\"explain\":\"유지 단계에서는 회기 간격을 점차 늘리고 대상자가 스스로 말을 점검·연습하는 자기 관리 능력을 키워 재발을 줄인다. ① 추후 점검 없는 종결, ③ 일상 과제 축소는 재발 위험을 높이고, ② 일시적 말더듬을 실패로 여기게 하면 좌절과 회피가 커진다. ⑤ 부정적 감정과 태도가 남아 있으면 재발 가능성이 높다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"유지 단계 재발 방지\",\"p\":\"치료 후 재발을 줄이는 유지 단계 전략 선택\",\"n\":\"유지 단계: 회기 간격 점진 확대, 자기 점검·자기 관리, 감정·태도 함께 다룸\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"\",\"q\":\"안정 호흡과 비교한 말 호흡의 특징으로 옳은 것은?\",\"choices\":[\"흡기와 호기의 시간 비율이 거의 같아진다\",\"주로 코를 통해 천천히 숨을 들이마신다\",\"흡기 시간은 짧아지고 호기 시간은 길어진다\",\"호기는 근육 활동 없이 수동적으로만 일어난다\",\"안정 호흡보다 좁은 폐용적 범위를 사용한다\"],\"answer\":3,\"explain\":\"말 호흡은 입으로 빠르게 들이마시고 말하는 동안 길게 내쉬므로 흡기가 짧고 호기가 길어진다(안정 호흡보다 호기 비율이 크게 늘어남). ①안정 호흡도 호기가 흡기보다 약간 길며 말 호흡에서는 그 차이가 훨씬 커지고, ②코로 천천히 들이마시는 것은 안정 호흡의 특징이다. 말 호흡에서는 호기근이 능동적으로 작용하며(④ 오답), 안정 호흡보다 넓은 폐용적 범위를 쓴다(⑤ 오답).\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"말 호흡과 안정 호흡 비교\",\"p\":\"흡기·호기 시간 비율과 호흡 경로로 말 호흡의 특징 판별\",\"n\":\"말 호흡: 입으로 빠른 흡기, 긴 호기, 능동적 호기근 활동, 더 넓은 폐용적 사용\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• 말끝에서 음도가 매우 낮아지며 '드르륵' 끓는 듯한 소리가 남\\n• 성대가 짧고 두꺼운 상태로 이완되어 있고, 한 주기 중 닫혀 있는 시간이 매우 긺\\n• 호기류율이 낮음\",\"q\":\"해당하는 발성 유형(성구)은?\",\"choices\":[\"가성 성구\",\"모달(중간) 성구\",\"휘파람 성구\",\"펄스 성구\",\"속삭임 발성\"],\"answer\":4,\"explain\":\"가장 낮은 음도 영역에서 성대가 짧고 두껍게 이완되어 폐쇄기가 길고 기류가 적으며 끓는 듯한 소리가 나는 것은 펄스 성구(보컬 프라이)이다. ①가성은 성대가 길고 얇게 늘어나 높은 음도에서 가장자리만 진동하며 폐쇄가 불완전하고, ②모달 성구는 일상 대화의 중간 음도 영역이다. ⑤속삭임은 성대 진동이 없다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"펄스 성구 특징\",\"p\":\"음도·성대 형태·폐쇄기·기류율 특징으로 성구 식별\",\"n\":\"펄스 성구(보컬 프라이): 최저 음도, 짧고 두꺼운 이완된 성대, 긴 폐쇄기, 낮은 기류\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"\",\"q\":\"모음 /i/를 /a/와 비교했을 때 포먼트 특성으로 옳은 것은?\",\"choices\":[\"F1이 높고 F2가 낮다\",\"F1이 낮고 F2가 높다\",\"F1과 F2가 모두 높다\",\"F1과 F2가 모두 낮다\",\"F1·F2는 같고 F0만 다르다\"],\"answer\":2,\"explain\":\"F1은 혀의 높이와 반비례(고모음일수록 낮음)하고, F2는 혀의 전후 위치와 관련되어 전설모음일수록 높다. /i/는 고·전설모음이므로 저모음 /a/보다 F1은 낮고 F2는 높다. ①은 /a/의 상대적 특징이고, 포먼트는 성도 모양(여과기)에 따라 달라지므로 ⑤는 틀리다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"모음별 포먼트\",\"p\":\"혀 높이·전후 위치와 F1·F2의 관계로 /i/와 /a/의 포먼트 비교\",\"n\":\"F1은 혀 높이와 반비례, F2는 혀가 앞쪽일수록 높음(원천-여과 이론의 여과기 특성)\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"성인 화자의 모음 연장 발성 음향 분석\\n• 50 ms 구간 안에 같은 모양의 파형 주기가 10번 반복됨\",\"q\":\"기본주파수와 그 해석으로 옳은 것은?\",\"choices\":[\"20 Hz – 성인 남성보다 매우 낮다\",\"100 Hz – 성인 남성 범위에 해당\",\"200 Hz – 성인 남성 범위에 해당\",\"200 Hz – 성인 여성 범위에 해당\",\"500 Hz – 성인 여성보다 매우 높다\"],\"answer\":4,\"explain\":\"한 주기는 50 ms ÷ 10 = 5 ms(0.005초)이고, 기본주파수는 1 ÷ 0.005초 = 200 Hz이다. 200 Hz는 성인 여성의 일반적인 말 기본주파수 범위에 해당하고, 성인 남성(대략 100 Hz 전후~150 Hz)보다 높다(③ 오답). ①은 50 ms 전체를 한 주기로 본 값, ②는 주기를 10 ms로 잘못 계산한 값이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"해부·생리·음향 기초\",\"k\":\"주기로 기본주파수 계산\",\"p\":\"파형 주기 수와 시간으로 F0를 계산하고 성별 범위 판단\",\"n\":\"F0 = 1/주기, 1초 동안의 성대 진동 횟수(Hz)\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"\",\"q\":\"사춘기 이후 남성의 후두 변화로 옳은 것은?\",\"choices\":[\"성대가 길고 두꺼워져 기본주파수가 한 옥타브가량 낮아진다\",\"후두의 위치가 사춘기 이전보다 목에서 더 높게 올라간다\",\"갑상연골 좌우 판이 이루는 각도가 커져 둥글어진다\",\"성대 막양부의 비율이 줄고 연골부가 더 길어진다\",\"성대 길이는 그대로이고 성대 긴장도만 낮아진다\"],\"answer\":1,\"explain\":\"사춘기에 남성은 갑상연골이 앞뒤로 커지면서 성대가 길고 두꺼워져 기본주파수가 약 한 옥타브 낮아진다. 후두는 성장하며 아래로 내려가고(② 오답), 갑상연골 각도는 좁아져 앞으로 돌출한다(③ 오답). 성장할수록 성대에서 막양부 비율이 커지며(④ 오답), 음도 하강은 성대 길이·질량 증가 때문이다(⑤ 오답).\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"사춘기 남성 후두 변화\",\"p\":\"변성기 남성의 성대·갑상연골·후두 위치 변화 판별\",\"n\":\"사춘기 남성: 성대 길이·두께 증가, F0 약 한 옥타브 하강, 갑상연골 각도 감소\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"32세 남성\\n• 응원 경기에서 크게 소리친 다음 날부터 갑자기 쉰 목소리\\n• 후두내시경: 오른쪽 성대 앞 1/3과 중간 1/3 경계의 자유연에 붉고 둥근 혹이 줄기에 매달린 듯 돌출됨\\n• 왼쪽 성대는 정상\",\"q\":\"가장 가능성이 높은 병변은?\",\"choices\":[\"성대결절\",\"성대폴립\",\"성대낭종\",\"라인케부종\",\"성대구증\"],\"answer\":2,\"explain\":\"한 번의 급성 음성 남용 뒤 갑자기 생긴 편측성의 붉은(혈관성) 유경성 혹은 성대폴립의 전형적 소견이다. ①성대결절은 반복적 남용으로 양측 대칭적으로 생기고, ③성대낭종은 점막 아래에 싸여 있는 둥근 덩어리로 갑작스러운 발생과 거리가 멀다. ④라인케부종은 양측 성대 전체의 부종, ⑤성대구증은 성대 가장자리의 고랑이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"성대폴립 진단\",\"p\":\"급성 발생·편측성·붉은 유경성 혹 소견으로 병변 판별\",\"n\":\"성대폴립: 급성 음성 남용 후 편측성, 혈관성·유경성 혹이 흔함\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"52세 남성\\n• 잦은 헛기침, 낮은 음도로 힘주어 말하는 습관\\n• 가슴쓰림 등 위산 역류 증상\\n• 후두내시경: 성대 뒤쪽(피열연골 성대돌기 부위)에 궤양을 동반한 둥근 혹\",\"q\":\"가장 가능성이 높은 병변은?\",\"choices\":[\"성대결절\",\"재발성 후두유두종\",\"성대구증\",\"후두백반증\",\"접촉성 육아종\"],\"answer\":5,\"explain\":\"성대 뒤쪽 피열연골 성대돌기 부위에 생긴 궤양·육아 조직은 접촉성 궤양(육아종)이며, 헛기침·낮고 힘준 발성으로 인한 성대돌기 충돌과 위산 역류, 기관 삽관 등이 원인이다. ①성대결절은 막양부 앞쪽~중간 경계에 생기고, ②재발성 후두유두종은 HPV 관련 사마귀 모양 다발성 병변, ④백반증은 점막의 흰 각화 병변이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"접촉성 육아종 진단\",\"p\":\"병변 위치(성대돌기)와 헛기침·역류 병력으로 병변 판별\",\"n\":\"접촉성 궤양·육아종: 성대 후방 성대돌기 부위, 헛기침·저음 과긴장 발성·역류·삽관 관련\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"45세 여성\\n• 갑상선 절제술 후 높은 음을 내기 어렵고 음도 범위가 좁아짐\\n• 심한 기식음이나 사레는 없음\\n• 후두내시경: 양측 성대의 내전·외전 운동은 관찰됨\",\"q\":\"손상이 의심되는 신경과 그 신경이 지배하는 근육으로 옳은 것은?\",\"choices\":[\"상후두신경 외지 – 윤상갑상근\",\"상후두신경 내지 – 윤상갑상근\",\"되돌이후두신경 – 갑상피열근\",\"되돌이후두신경 – 후윤상피열근\",\"상후두신경 외지 – 외측윤상피열근\"],\"answer\":1,\"explain\":\"성대 내전·외전은 유지되지만 고음 산출과 음도 범위가 떨어지는 것은 성대를 늘여 음도를 높이는 윤상갑상근의 약화로, 이 근육을 지배하는 상후두신경 외지 손상을 시사한다. ②상후두신경 내지는 성문 상부 감각을 담당하고, ③④되돌이후두신경 손상이면 성대 운동 장애와 기식음·사레가 두드러진다. ⑤외측윤상피열근은 되돌이후두신경의 지배를 받는다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"상후두신경 외지 손상\",\"p\":\"고음 산출 저하와 정상 성대 운동으로 손상 신경·근육 추론\",\"n\":\"상후두신경 외지 → 윤상갑상근(음도 상승), 나머지 내근은 되돌이후두신경 지배\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"67세 남성\\n• 수년에 걸쳐 서서히 심해진 목소리 떨림\\n• 모음을 길게 낼 때 일정한 리듬의 음도·강도 흔들림이 뚜렷함\\n• 물컵을 들 때 손 떨림이 있고, 가족 중 비슷한 증상이 있음\\n• 후두내시경: 발성 시 후두와 인두벽이 율동적으로 움직임\",\"q\":\"가장 가능성이 높은 진단은?\",\"choices\":[\"내전형 경련성 발성장애\",\"근긴장성 발성장애\",\"노인성 음성(성대 휨)\",\"기능적 실성증\",\"본태성 음성떨림\"],\"answer\":5,\"explain\":\"모음 연장에서 두드러지는 규칙적·율동적 떨림, 손 떨림과 가족력, 후두와 인두 구조물 전체의 율동적 움직임은 본태성 음성떨림의 특징이다. ①내전형 경련성 발성장애는 연결 발화 중 불규칙하게 쥐어짜는 듯한 음성 끊김이 핵심이다. ③노인성 음성은 기식성·약한 음성이 주된 특징이며 율동적 떨림과는 다르고, ④기능적 실성증은 속삭이는 듯한 무성 발성이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"본태성 음성떨림 진단\",\"p\":\"규칙적 떨림·손 떨림·가족력으로 신경학적 음성장애 감별\",\"n\":\"본태성 음성떨림: 모음 연장에서 뚜렷한 규칙적 떨림, 사지 떨림·가족력 동반 흔함\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"\",\"q\":\"음성장애와 그 분류가 옳게 연결된 것은?\",\"choices\":[\"성대마비 – 기능적 음성장애\",\"후두유두종 – 신경학적 음성장애\",\"근긴장성 발성장애 – 기능적 음성장애\",\"성대구증 – 심인성 음성장애\",\"전환장애성 실성증 – 신경학적 음성장애\"],\"answer\":3,\"explain\":\"후두 구조와 신경에 이상 없이 후두 근육의 과도한 긴장으로 생기는 근긴장성 발성장애는 기능적 음성장애이다. ①성대마비는 신경학적, ②후두유두종은 바이러스 관련 기질적(구조적) 음성장애이다. ④성대구증은 성대 점막의 구조적 이상이고, ⑤전환장애성 실성증은 심인성(기능적) 음성장애이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"음성장애 분류\",\"p\":\"대표 음성장애를 기질적·기능적·신경학적·심인성으로 분류\",\"n\":\"근긴장성 발성장애는 기능적, 성대마비는 신경학적, 유두종·구증은 기질적, 전환 실성증은 심인성\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• [그림 1]은 같은 성인 화자가 서로 다른 방식으로 모음 /a/를 연장 발성할 때 측정한 전기성문파형(EGG)이다.\\n• 세 파형의 주기는 같다.\",\"q\":\"[그림 1]에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"(가)에서 파형이 위로 갈수록 성대 접촉 면적이 줄어든다\",\"(나)는 (가)보다 접촉률이 낮아 기식성 발성에 가깝다\",\"(다)는 (가)보다 접촉률이 높아 압축된 발성에 가깝다\",\"(나)는 폐쇄 구간 비율이 커 과기능적 발성에 가깝다\",\"(다)는 개방 구간이 짧아 성문이 대부분 닫혀 있다\"],\"answer\":4,\"explain\":\"EGG는 위로 갈수록 성대 접촉 면적이 커지며(① 오답), 가파르게 오르는 부분이 폐쇄기, 완만하게 내려오는 부분이 개방기이다. 그림에서 접촉률(CQ, 한 주기 중 접촉 구간의 비율)은 대략 (가) 0.5, (나) 0.7, (다) 0.25~0.3으로, (나)는 폐쇄 구간이 길어 과기능적(압축) 발성에, (다)는 접촉 구간이 짧고 진폭이 작아 기식성 발성에 가깝다(②③⑤ 오답).\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"EGG 접촉률 해석\",\"p\":\"EGG 파형의 폐쇄 구간 길이로 접촉률 변화와 발성 유형 해석\",\"n\":\"EGG 접촉률(CQ) 증가는 과기능·압축 발성, 감소는 기식성 발성을 시사\"},\"image\":\"data:image/svg+xml;base64,\"},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"\",\"q\":\"/pi/ 반복 발화에서 /p/ 폐쇄 구간의 구강내압으로 성문하압을 추정할 수 있는 이유로 옳은 것은?\",\"choices\":[\"/p/ 산출 중 성대가 닫혀 구강과 기관이 분리되기 때문이다\",\"/p/ 폐쇄 중 성문이 열려 두 압력이 같아지기 때문이다\",\"모음 /i/ 구간에서 구강내압이 가장 높아지기 때문이다\",\"/p/ 산출 시 연구개가 내려가 비강과 압력이 같아지기 때문이다\",\"입술이 열리는 순간의 기류량이 성문하압과 같기 때문이다\"],\"answer\":2,\"explain\":\"무성 파열음 /p/의 폐쇄 구간에는 입술이 닫히고 성문이 열려 있으므로 폐에서 입술까지 하나의 공간이 되어 구강내압이 성문하압과 거의 같아진다. ①성대가 닫혀 있으면 두 압력이 분리되어 추정할 수 없고, ③모음 구간은 입이 열려 구강내압이 거의 0이다. ④/p/는 연인두가 닫힌 상태에서 산출된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"성문하압 간접 측정\",\"p\":\"/p/ 폐쇄 구간 구강내압으로 성문하압을 추정하는 원리 이해\",\"n\":\"무성 파열음 폐쇄 시 성문 개방 + 입술 폐쇄 → 구강내압 ≈ 성문하압\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"45세 남성, 모음 /a/ 연장 발성 음향 분석\\n• 기본주파수: 118 Hz\\n• Jitter: 3.2%\\n• Shimmer: 9.5%\\n• NHR(소음 대 배음비): 0.42\",\"q\":\"결과 해석으로 가장 적절한 것은?\",\"choices\":[\"주기 간 주파수·진폭 변동이 크고 소음 성분이 많다\",\"기본주파수가 성인 남성 범위보다 비정상적으로 높다\",\"주파수 변동은 크지만 진폭 변동은 정상 범위이다\",\"소음 성분이 적어 배음 구조가 뚜렷하게 나타난다\",\"Jitter는 강도, Shimmer는 음도의 안정성을 나타낸다\"],\"answer\":1,\"explain\":\"Jitter(주기 간 주파수 변동), Shimmer(주기 간 진폭 변동), NHR(소음 대 배음비)이 모두 일반적인 정상 기준보다 확실히 높아 음성이 불안정하고 소음 성분이 많다(거칠거나 기식성인 음질 시사). ②118 Hz는 성인 남성 범위이고, ③Shimmer 9.5%는 높다. ④NHR이 높으면 배음 구조가 약해지며, ⑤Jitter는 음도(주파수), Shimmer는 강도(진폭)의 변동이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"Jitter·Shimmer·NHR 해석\",\"p\":\"주파수·진폭 변동률과 소음 지표 결과로 음질 상태 해석\",\"n\":\"Jitter=주파수 변동, Shimmer=진폭 변동, NHR 증가=소음 성분 증가\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"\",\"q\":\"최저음에서 최고음까지 음도별로 낼 수 있는 가장 작은 소리와 가장 큰 소리의 강도를 측정하여 그래프로 나타내는 평가는?\",\"choices\":[\"최대발성지속시간\",\"켑스트럼 분석\",\"음성범위프로파일\",\"비음측정\",\"s/z 비율\"],\"answer\":3,\"explain\":\"음성범위프로파일(VRP, 음역도·포네토그램)은 음도별 최소·최대 강도를 측정해 음도 범위와 강도 범위를 한 그래프로 보여 준다. ①최대발성지속시간과 ⑤s/z 비율은 발성 지속 능력·성문 효율을, ②켑스트럼 분석은 음성의 주기성(CPP)을, ④비음측정은 공명(비성치)을 평가한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"음성범위프로파일\",\"p\":\"음도별 최소·최대 강도를 그리는 평가 도구 식별\",\"n\":\"음성범위프로파일(VRP): 음도 범위 × 강도 범위를 그래프로 표시\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"음성장애지수(VHI) 응답 중 일부\\n• (가) 목소리 문제 때문에 속이 상하고 위축된다.\\n• (나) 시끄러운 곳에서는 상대방이 내 말을 잘 알아듣지 못한다.\\n• (다) 목소리를 내려면 목에 힘을 많이 주어야 한다.\",\"q\":\"(가)~(다)가 속하는 하위영역을 순서대로 옳게 나열한 것은?\",\"choices\":[\"신체적 – 기능적 – 정서적\",\"정서적 – 신체적 – 기능적\",\"기능적 – 정서적 – 신체적\",\"기능적 – 신체적 – 정서적\",\"정서적 – 기능적 – 신체적\"],\"answer\":5,\"explain\":\"VHI는 기능적(F)·신체적(P)·정서적(E) 3개 하위영역으로 구성된 자기보고식 검사이다. (가) 음성 문제에 대한 감정 반응은 정서적, (나) 일상 의사소통의 어려움은 기능적, (다) 발성 시 느끼는 신체 감각·노력은 신체적 영역에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"VHI 하위영역\",\"p\":\"VHI 문항 내용으로 기능적·신체적·정서적 영역 구분\",\"n\":\"VHI: 기능적(의사소통 제약)·신체적(발성 느낌)·정서적(감정 반응) 3영역\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"28세 여성, 성대결절\\n• 모음으로 시작하는 낱말에서 성대를 세게 부딪치며 소리를 시작함\\n• 발성 시작 때 '딱' 하는 급격한 소리가 들림\",\"q\":\"우선 적용할 치료 기법으로 가장 적절한 것은?\",\"choices\":[\"밀기 기법으로 성대 내전력을 강화한다\",\"/h/를 앞에 붙여 부드럽게 발성을 시작한다\",\"경성 성대 접촉을 반복해 성문 폐쇄를 높인다\",\"음도를 최대한 낮추어 성대 진동을 줄인다\",\"숨을 참았다가 성문하압을 높여 발성한다\"],\"answer\":2,\"explain\":\"경성 성대 접촉(급격한 발성 시작)은 성대 충돌을 키워 결절을 악화시키므로, /h/를 앞에 붙이거나 숨을 살짝 내쉬며 시작하는 부드러운 성대 접촉(easy onset)을 지도한다. ①밀기와 ③경성 성대 접촉은 성문 폐쇄부전에 쓰는 기법으로 과기능에는 부적절하다. ④지나친 음도 하강과 ⑤숨 참기는 후두 긴장을 높인다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"부드러운 성대 접촉\",\"p\":\"경성 성대 접촉을 보이는 과기능 사례에 맞는 발성 시작 기법 선택\",\"n\":\"부드러운 성대 접촉: /h/ 선행 등으로 성대 충돌을 줄이는 발성 시작\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"10세 아동, 성대결절\\n• 쉬는 시간마다 운동장에서 크게 소리침\\n• 자주 헛기침을 함\",\"q\":\"음성위생 지도로 옳지 않은 것은?\",\"choices\":[\"운동장에서 친구를 부를 때 손짓이나 호루라기 등 신호를 쓴다\",\"목에 무언가 걸린 느낌이 들면 헛기침 대신 물을 삼킨다\",\"목소리를 아끼도록 평소에는 속삭이는 소리로만 말한다\",\"실내가 건조하지 않도록 습도를 적절하게 유지한다\",\"시끄러운 곳에서는 상대에게 가까이 다가가서 말한다\"],\"answer\":3,\"explain\":\"속삭임은 성대를 긴장시킨 채 공기를 많이 내보내는 발성이 되기 쉬워 음성위생에서 피하도록 권고한다. 고함 대신 신호 사용(①), 헛기침 대신 물 삼키기(②), 적절한 습도 유지(④), 다가가서 말하기(⑤)는 모두 성대 충격을 줄이는 음성위생 지침이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"아동 음성위생 지도\",\"p\":\"성대결절 아동의 음성 남용 행동에 맞는 음성위생 지침 판별\",\"n\":\"음성위생: 고함·헛기침·속삭임을 피하고 수분·습도 유지\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"58세 남성\\n• 폐암 수술 후 왼쪽 성대가 부정중위에 고정됨\\n• 발성 시 성문 틈이 보이고 기식성 음성이 들림\",\"q\":\"발성 시 성문 폐쇄를 돕기 위한 자세 조정으로 가장 적절한 것은?\",\"choices\":[\"머리를 오른쪽(건측)으로 돌린 채로 발성한다\",\"고개를 뒤로 젖혀 목을 편 채 발성한다\",\"바르게 누운 자세에서 천천히 발성한다\",\"어깨를 위로 끌어 올린 채 발성한다\",\"머리를 왼쪽(마비 측)으로 돌린 채 발성한다\"],\"answer\":5,\"explain\":\"편측 성대마비에서는 머리를 마비된 쪽으로 돌리면 마비 측 후두 구조가 중앙 쪽으로 밀려 성문 틈이 줄고 폐쇄가 좋아진다(머리 위치 조정 기법). ①건측으로 돌리면 이 효과를 얻지 못하고, ②고개 젖히기나 ④어깨 올리기는 후두·목 주변 긴장을 높일 수 있으며, ③누운 자세는 성문 폐쇄를 돕는 방법이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"편측 성대마비 머리 돌리기\",\"p\":\"편측 성대마비 사례에서 성문 폐쇄를 돕는 머리 위치 판단\",\"n\":\"편측 성대마비: 머리를 마비 측으로 돌려 성문 폐쇄 촉진\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• 입을 크게 벌리고 음식을 씹듯 과장된 동작을 하며 소리를 냄\\n• 씹는 동작을 유지하며 숫자 세기, 낱말, 문장으로 확장함\\n• 점차 씹는 동작을 줄이며 자연스러운 말로 옮겨 감\",\"q\":\"해당 기법과 주된 적용 대상이 옳게 연결된 것은?\",\"choices\":[\"씹기 기법 – 과기능적 음성장애\",\"씹기 기법 – 성대 폐쇄부전\",\"하품-한숨 기법 – 성대 폐쇄부전\",\"밀기 기법 – 과기능적 음성장애\",\"공명음성치료 – 기능적 실성증\"],\"answer\":1,\"explain\":\"씹는 동작과 함께 발성하여 턱·혀·후두 주변의 긴장을 풀어 주는 씹기 기법으로, 후두 근육의 과도한 긴장이 있는 과기능적 음성장애에 주로 쓴다. 성대 폐쇄부전에는 폐쇄를 높이는 밀기 기법 등을 쓰므로 ②③은 틀리고, ④밀기 기법은 과기능에 오히려 해롭다. ⑤는 제시된 절차와 다른 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"씹기 기법\",\"p\":\"절차 설명으로 씹기 기법을 식별하고 적용 대상 연결\",\"n\":\"씹기 기법: 씹는 동작과 발성을 결합해 후두·구강 긴장을 이완, 과기능적 음성장애에 사용\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"7세 아동\\n• 만성 비염과 아데노이드 비대\\n• '엄마'가 [업바]처럼 들림\",\"q\":\"나조미터로 평가할 때 사용할 자료와 예상 결과로 가장 적절한 것은?\",\"choices\":[\"구강음 문장 – 비성치가 기대보다 높음\",\"구강음 문장 – 비성치가 기대보다 낮음\",\"비음 문장 – 비성치가 기대보다 높음\",\"비음 문장 – 비성치가 기대보다 낮음\",\"모음 연장 – 비성치가 기대보다 높음\"],\"answer\":4,\"explain\":\"비강 통로가 막혀 비음이 구강 파열음처럼 들리는 과소비성이다. 과소비성은 비강자음이 많은 비음 문장으로 평가해야 드러나며, 비성치가 그 문장의 기대치보다 낮게 나온다. ①은 과다비성의 소견이고, ②구강음 문장은 원래 비성치가 낮아 과소비성을 판별하기 어렵다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"공명장애\",\"k\":\"과소비성 나조미터 평가\",\"p\":\"과소비성 사례에서 나조미터 자료 선택과 비성치 결과 예측\",\"n\":\"과소비성은 비음 문장에서 낮은 비성치, 과다비성은 구강음 문장에서 높은 비성치로 확인\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"\",\"q\":\"연인두 폐쇄에 대한 설명으로 옳은 것은?\",\"choices\":[\"구개긴장근이 연구개를 들어 올리는 주된 근육이다\",\"비음 /m/을 산출할 때 연인두가 완전히 닫힌다\",\"구개설근이 수축하면 연구개가 위로 올라간다\",\"구개올림근이 수축하면 연구개가 위·뒤로 움직인다\",\"연구개만 움직이고 인두벽은 폐쇄에 관여하지 않는다\"],\"answer\":4,\"explain\":\"연구개를 위·뒤로 들어 올려 연인두를 닫는 주된 근육은 구개올림근이다. ①구개긴장근은 주로 귀인두관(이관)을 여는 데 관여하고, ③구개설근은 연구개를 아래로 끌어내린다. ②비음 산출 시에는 연인두가 열리며, ⑤연인두 폐쇄에는 인두 측벽·후벽의 움직임도 함께 관여한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"공명장애\",\"k\":\"연인두 폐쇄 근육\",\"p\":\"연인두 폐쇄에 관여하는 근육과 구조의 역할 판별\",\"n\":\"구개올림근: 연구개 거상의 주동근, 인두벽도 함께 폐쇄에 관여\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"8세 아동\\n• 구개열 병력이 없고 구강 구조와 연인두 기능은 정상\\n• /s/를 낼 때만 코로 공기가 새는 소리가 남\\n• /p, t, k/ 등 다른 압력자음과 모음의 공명은 정상\\n• /s/를 내는 중 코를 막으면 소리가 나지 않음\",\"q\":\"가장 적절한 중재는?\",\"choices\":[\"조음치료로 구강에서 내는 /s/를 새로 가르친다\",\"인두판 수술 등 연인두 수술을 의뢰한다\",\"구개올림 보철기의 제작을 치과에 의뢰한다\",\"연구개 근력 강화를 위해 불기 운동을 시킨다\",\"비강 공명을 줄이기 위해 음도를 높여 말하게 한다\"],\"answer\":1,\"explain\":\"연인두 기능이 정상인데 /s/에서만 비강 누출이 나타나는 것은 음소특정적 비강누출로, 구조 문제가 아니라 잘못 학습된 조음 방식이므로 조음치료로 구강 /s/를 새로 가르친다. ②③수술·보철은 연인두 기능 부전일 때 고려하고, ④불기 같은 비구어 운동은 말 산출 시 연인두 폐쇄를 개선한다는 근거가 부족하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"공명장애\",\"k\":\"음소특정적 비강누출\",\"p\":\"특정 음소에서만 비강 누출이 있는 사례의 중재 선택\",\"n\":\"음소특정적 비강누출: 학습된 오조음, 수술이 아닌 조음치료 대상\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"\",\"q\":\"남성에서 여성으로의 음성 여성화 행동치료에 대한 설명으로 옳은 것은?\",\"choices\":[\"기본주파수만 높이면 여성 음성으로 충분히 지각된다\",\"음도를 높이기 위해 가성 발성을 기본 발성으로 쓴다\",\"억양 변화를 줄이고 단조로운 억양을 유지하게 한다\",\"음도를 높이려고 후두를 최대한 낮춘 상태로 말한다\",\"공명을 앞쪽으로 옮겨 포먼트 주파수도 높이도록 한다\"],\"answer\":5,\"explain\":\"여성 음성으로 지각되려면 기본주파수 상승뿐 아니라 공명(포먼트) 상향, 억양 변화 등이 함께 필요하므로, 공명을 앞쪽으로 옮기는 훈련을 병행한다(① 오답). ②가성은 약하고 부자연스러워 목표 발성이 아니며, ③여성 화자는 억양 변화가 더 큰 편이다. ④후두를 낮추면 성도가 길어져 포먼트가 낮아지므로 반대 효과가 난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"음성 여성화 치료\",\"p\":\"음성 여성화에서 음도 외 공명·억양 목표 설정\",\"n\":\"음성 여성화: F0 상승 + 포먼트(공명) 상향 + 억양 변화 확대\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"25세 성인\\n• 선천성 고도 감각신경성 청각장애\\n• 주로 구어로 의사소통함\",\"q\":\"이 화자의 음성에서 흔히 나타나는 특성으로 가장 적절한 것은?\",\"choices\":[\"음도 범위가 넓고 억양 변화가 풍부하다\",\"음도가 높거나 불안정하고 강도 조절이 어렵다\",\"공명 문제가 없고 모음 산출이 정확하다\",\"말속도가 빠르고 음절 길이가 짧다\",\"자기 목소리를 들으며 강도를 정확히 조절한다\"],\"answer\":2,\"explain\":\"청각 피드백이 부족하면 음도가 높거나 부적절하게 변하고 강도 조절이 어려우며, 단조로운 억양, 과다비성 등 공명 이상, 모음 중립화가 흔하다. 말속도는 대체로 느리고 음절이 길어지는 경향이 있다(④ 오답). ①③⑤는 청각 피드백이 충분할 때의 특성이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"특수 대상\",\"k\":\"청각장애인 음성 특성\",\"p\":\"청각 피드백 부족이 음도·강도·공명에 미치는 영향 판별\",\"n\":\"고도 청각장애 음성: 높거나 불안정한 음도, 강도 조절 곤란, 단조로운 억양, 공명 이상\"}},{\"grade\":2,\"set\":2,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"\",\"q\":\"후두전적출술 후 나타나는 변화로 옳은 것은?\",\"choices\":[\"호흡은 수술 전처럼 코와 입을 통해 이루어진다\",\"기도와 식도가 연결되어 흡인 위험이 커진다\",\"영구 기관공으로 숨을 쉬게 되어 후각이 떨어진다\",\"성대가 남아 있어 속삭이는 발성은 할 수 있다\",\"성문을 닫을 필요가 없어 힘주기가 더 쉬워진다\"],\"answer\":3,\"explain\":\"후두전적출술 후에는 기관을 목 앞의 영구 기관공(stoma)에 연결해 그곳으로 숨을 쉬므로 코로 공기가 지나가지 않아 후각이 떨어진다(① 오답). 기도와 식도가 완전히 분리되어 음식물 흡인은 일반적으로 일어나지 않는다(② 오답). 후두 전체(성대 포함)가 제거되어 성대 발성은 불가능하고(④ 오답), 성문을 닫아 흉강 압력을 높이지 못해 힘주기가 어려워진다(⑤ 오답).\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"특수 대상\",\"k\":\"후두전적출술 후 변화\",\"p\":\"후두전적출술 후 호흡 경로·후각·흡인·힘주기 변화 판별\",\"n\":\"후두전적출술: 영구 기관공 호흡, 기도·식도 분리, 후각 저하, 성대 발성 불가\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"11개월 아동\\n• 손이 닿지 않는 곳에 좋아하는 장난감이 천 위에 놓여 있다.\\n• 아동은 천의 끝을 잡아당겨 장난감을 끌어온 뒤 집어 든다.\",\"q\":\"아동의 행동에 나타난 초기 인지 개념으로 가장 적절한 것은?\",\"choices\":[\"수단-목적 관계\",\"지연 모방\",\"대상영속성\",\"표상적 사고 능력\",\"보존 개념\"],\"answer\":1,\"explain\":\"원하는 목표(장난감)를 얻기 위해 다른 대상(천)을 도구로 사용하는 행동은 수단-목적 관계 개념을 보여 준다. ③대상영속성은 가려져 보이지 않는 대상을 찾는 행동으로 확인하며, 이 장면에서는 장난감이 계속 보이고 있다. ⑤보존 개념은 구체적 조작기에 획득된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"수단-목적 관계\",\"p\":\"천을 당겨 장난감을 얻는 행동으로 초기 인지 개념 판별\",\"n\":\"수단-목적: 목표를 얻기 위해 다른 대상·행동을 수단으로 사용하는 능력(감각운동기)\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"\",\"q\":\"다음 상징놀이 행동 중 발달적으로 가장 늦게 나타나는 것은?\",\"choices\":[\"빈 컵을 자기 입에 대고 마시는 척한다\",\"인형 입에 숟가락을 대며 먹이는 척한다\",\"인형에게 밥을 먹이고 이어서 눕혀 재운다\",\"숟가락으로 자신과 인형에게 차례로 먹인다\",\"'목욕시킬 거야' 말한 뒤 비누를 찾는다\"],\"answer\":5,\"explain\":\"놀이를 시작하기 전에 말로 계획을 밝히고 필요한 물건을 찾는 것은 계획된(위계적) 상징놀이로 가장 늦게 나타난다. ①은 자기 중심 상징행동, ②는 탈중심화(대상을 인형으로 확장), ④는 단일 도식 조합, ③은 여러 도식을 순서대로 잇는 다중 도식 조합으로 모두 ⑤보다 앞선다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"상징놀이 발달 순서\",\"p\":\"상징놀이 행동 예시 중 가장 늦게 출현하는 단계 고르기\",\"n\":\"상징놀이: 자기 중심 → 탈중심화 → 단일 도식 조합 → 다중 도식 조합 → 계획된 상징놀이\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"16개월 아동\\n• 그림책의 새를 보고 두 팔을 위아래로 퍼덕인다.\\n• 엄마가 '새는 어떻게 하지?'라고 묻자 같은 동작을 다시 한다.\",\"q\":\"아동이 사용한 몸짓의 유형으로 옳은 것은?\",\"choices\":[\"가리키기 몸짓\",\"표상적 몸짓\",\"손 끌기(접촉) 몸짓\",\"보여주기 몸짓\",\"상동 행동\"],\"answer\":2,\"explain\":\"팔을 퍼덕여 '새'라는 대상의 특징을 나타내는 것은 지시 대상의 의미를 몸짓 형태로 담는 표상적(상징적) 몸짓이다. ①가리키기와 ④보여주기는 대상에 주의를 돌리는 직시적 몸짓이고, ③손 끌기는 성인의 몸을 도구처럼 쓰는 접촉 몸짓이다. ⑤상동 행동은 의사소통 의도 없이 반복되는 행동이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"표상적 몸짓\",\"p\":\"대상의 특징을 흉내 내는 몸짓의 유형 판별\",\"n\":\"표상적 몸짓: 대상·행위의 의미를 형태로 나타냄, 직시적 몸짓(가리키기·보여주기)과 구분\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"18개월 아동\\n• 수건으로 자기 얼굴을 가렸다가 치우며 성인을 보고 웃는다.\\n• 성인이 반응하지 않자 다시 얼굴을 가렸다가 치우며 성인을 쳐다본다.\",\"q\":\"웨더비와 프리장(Wetherby & Prizant)의 의사소통 기능 범주 중 아동 행동이 해당하는 것은?\",\"choices\":[\"행동조절\",\"공동주의\",\"자기조절\",\"사회적 상호작용\",\"정보 제공 기능\"],\"answer\":4,\"explain\":\"까꿍 놀이처럼 사회적 게임을 시작하고 성인의 참여를 요구하는 것은 사회적 상호작용 기능이다. ①행동조절은 물건·행위를 요구하거나 거부하는 기능이고, ②공동주의는 대상이나 사건에 성인의 주의를 끌어 함께 보려는 기능이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"의사소통 기능 3범주\",\"p\":\"사회적 게임 요구 행동을 의사소통 기능 범주로 분류\",\"n\":\"웨더비와 프리장: 행동조절·사회적 상호작용·공동주의의 세 범주\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"30개월 아동\\n• 치료사가 처음 보는 과일을 보여 주며 '이건 망고야'라고 한 번 말해 주었다.\\n• 며칠 뒤 여러 장의 그림 중에서 망고를 골랐지만, 망고의 맛이나 먹는 방법은 설명하지 못한다.\",\"q\":\"이 현상을 설명하는 개념으로 가장 적절한 것은?\",\"choices\":[\"빠른 연결\",\"과잉 일반화\",\"과소 확장\",\"어휘 폭발\",\"지연 모방\"],\"answer\":1,\"explain\":\"한두 번의 노출만으로 새 낱말과 지시 대상을 연결해 부분적인 의미 표상을 형성하는 것을 빠른 연결(fast mapping)이라 하며, 의미는 이후 노출을 통해 점차 정교해진다. ③과소 확장은 낱말을 원래 범주보다 좁게 쓰는 오류이고, ④어휘 폭발은 어휘가 급격히 늘어나는 시기를 말한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"어휘·의미\",\"k\":\"빠른 연결\",\"p\":\"한 번 노출로 낱말-대상을 연결한 현상의 명칭\",\"n\":\"빠른 연결: 적은 노출로 부분적 의미 표상을 형성, 이후 느린 연결로 정교화\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"\",\"q\":\"아동의 낱말 사용과 의미 오류 유형이 옳게 연결된 것은?\",\"choices\":[\"둥근 것을 모두 '공'이라 부른다 – 과소확장\",\"자기 집 강아지만 '멍멍이'라 부른다 – 과대확장\",\"네 발 동물을 모두 '멍멍이'라 부른다 – 과소확장\",\"자기 컵만 '컵'이라 부른다 – 과소확장\",\"모든 성인 남자를 '아빠'라고 부른다 – 과소확장\"],\"answer\":4,\"explain\":\"자기 컵에만 '컵'을 쓰는 것은 낱말의 적용 범위를 성인보다 좁게 쓰는 과소확장이다. ①, ③, ⑤는 낱말을 성인 범주보다 넓게 적용한 과대확장이고, ②는 과대확장이 아니라 범위를 좁게 쓴 과소확장이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"어휘·의미\",\"k\":\"과대확장·과소확장\",\"p\":\"낱말 사용 예와 의미 오류 유형 연결\",\"n\":\"과대확장: 범주를 넓게 적용, 과소확장: 범주를 좁게 적용\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동 발화(5개)\\n• 엄마 차 타\\n• 차 빨리 가\\n• 아빠 차 타\\n• 엄마 빨리 와\\n• 나 차 좋아\\n※ 용언은 어간과 어미를 합쳐 한 낱말로 센다.\",\"q\":\"이 발화 표본의 어휘다양도(TTR)는?\",\"choices\":[\"0.45\",\"0.60\",\"0.67\",\"0.75\",\"1.67\"],\"answer\":2,\"explain\":\"총 낱말 수(NTW)는 발화당 3개씩 15개이다. 서로 다른 낱말 수(NDW)는 엄마·차·타·빨리·가·아빠·와·나·좋아의 9개이므로 TTR = 9/15 = 0.60이다. ⑤1.67은 총 낱말 수를 다른 낱말 수로 나눈 값이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"TTR 계산\",\"p\":\"아동 발화의 총 낱말 수와 다른 낱말 수로 TTR 산출\",\"n\":\"TTR = 서로 다른 낱말 수(NDW) ÷ 총 낱말 수(NTW)\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"8세 아동\\n• 수용 어휘 검사 결과는 또래 평균 범위이다.\\n• 그림 이름대기에서 '가위' 대신 \\\"그거… 종이 자르는 거, 뭐더라\\\"라고 말하고, 한참 뒤에 정확히 말하기도 한다.\\n• 이름대기 반응 시간이 또래보다 길다.\",\"q\":\"이 아동에게 우선 적용할 중재로 가장 적절한 것은?\",\"choices\":[\"그림을 보여 주며 수용 어휘 확인을 반복한다\",\"조사와 어미를 넣어 완전한 문장으로 말하게 한다\",\"청자의 관점을 고려하여 말하도록 지도한다\",\"목표 낱말의 말소리를 정확히 따라 말하게 한다\",\"범주·기능 같은 의미 단서를 연결해 의미망을 넓힌다\"],\"answer\":5,\"explain\":\"낱말을 알고 있으나(수용 어휘 정상) 에둘러 말하기와 반응 지연을 보이는 것은 낱말찾기(인출) 어려움이므로, 범주·기능·특징 등 의미 단서를 연결해 의미망을 넓히고 정교화하는 중재가 우선이다. ①은 이미 정상인 이해 영역이고, ②는 구문, ③은 화용, ④는 조음 목표이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"어휘·의미\",\"k\":\"낱말찾기 어려움 중재\",\"p\":\"에둘러 말하기·반응 지연을 보이는 아동의 우선 중재 선택\",\"n\":\"낱말찾기 어려움: 의미 자질·범주 등 의미망 정교화로 인출 경로 강화\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동 발화(5개)\\n• 엄마가 밥 먹어\\n• 공 줘\\n• 아기가 의자에 앉았어\\n• 나도 갈래\\n• 빨간 차\\n※ 낱말 산정 기준: 체언에 붙은 조사는 체언과 따로 한 낱말로 센다(예: '엄마가' = 2낱말). 용언은 어간과 어미를 합쳐 한 낱말로 센다(예: '앉았어' = 1낱말).\",\"q\":\"이 발화 표본의 평균낱말길이(MLU-w)는?\",\"choices\":[\"2.4\",\"3.0\",\"3.2\",\"3.4\",\"4.0\"],\"answer\":3,\"explain\":\"발화별 낱말 수는 엄마/가/밥/먹어 4, 공/줘 2, 아기/가/의자/에/앉았어 5, 나/도/갈래 3, 빨간/차 2로 합계 16이다. 16 ÷ 5 = 3.2이다. ①2.4는 조사를 체언과 합쳐 센 값(12 ÷ 5)이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"MLU-w 계산\",\"p\":\"조사 분리 기준을 적용해 평균낱말길이 산출\",\"n\":\"MLU-w = 총 낱말 수 ÷ 발화 수, 조사·용언 처리 기준을 먼저 정한다\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"\",\"q\":\"밑줄 친 문법형태소와 그 범주가 옳게 연결된 것은?\",\"choices\":[\"학교__에서__ 놀았어 – 공동격 조사\",\"밥 먹__었__어 – 미래 시제 선어말어미\",\"먹__던__ 과자 – 관형사형 전성어미\",\"친구__랑__ 갔어 – 도구격 조사\",\"손 씻__고__ 먹자 – 종결어미\"],\"answer\":3,\"explain\":\"'먹던'의 '-던'은 용언을 관형어로 바꾸어 '과자'를 꾸미게 하는 관형사형 전성어미이다. ①'에서'는 장소를 나타내는 처소격 조사, ②'-었-'은 과거 시제 선어말어미, ④'랑'은 공동격 조사, ⑤'-고'는 연결어미이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"문법·형태\",\"k\":\"문법형태소 범주\",\"p\":\"발화 속 조사·어미의 문법 범주 식별\",\"n\":\"전성어미(관형사형 -ㄴ/-는/-던), 선어말어미(-었-), 격조사 유형 구분\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"4세 아동에게 인형으로 문장 내용을 행동으로 보여 주게 함\\n• \\\"아기가 엄마를 업어요.\\\" → 엄마 인형이 아기 인형을 업게 함\\n• \\\"엄마가 아기를 업어요.\\\" → 엄마 인형이 아기 인형을 업게 함\",\"q\":\"아동이 사용한 문장 이해 전략으로 가장 적절한 것은?\",\"choices\":[\"어순 전략\",\"사건 개연성 전략\",\"격조사 이해 전략\",\"최소 거리 원리\",\"모방 전략\"],\"answer\":2,\"explain\":\"문장 구조와 관계없이 현실에서 더 일어날 법한 사건(엄마가 아기를 업음)으로 해석하는 것은 사건 개연성(확률적 사건) 전략이다. ①어순 전략을 썼다면 첫 문장에서 첫 명사인 아기를 행위자로 해석했을 것이고, ③격조사를 이해했다면 두 문장을 모두 바르게 수행했을 것이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"문장 이해 전략\",\"p\":\"비가역 해석 반응으로 사용한 이해 전략 판별\",\"n\":\"사건 개연성 전략: 구문 단서보다 일상적 사건 지식으로 문장을 해석\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"6세 아동 발화: \\\"선생님이 내일 소풍 간다고 하셨어.\\\"\",\"q\":\"이 문장의 구조로 옳은 것은?\",\"choices\":[\"홑문장\",\"관형절을 안은 문장\",\"대등하게 이어진 문장\",\"인용절을 안은 문장\",\"명사절을 안은 문장\"],\"answer\":4,\"explain\":\"'내일 소풍 간다고'는 인용격 조사 '-고'로 다른 사람의 말을 옮긴 절이 안겨 있으므로 인용절을 안은 문장이다. ②관형절은 '-ㄴ/-는/-ㄹ'로 체언을 꾸미고, ⑤명사절은 '-음/-기'로 명사 구실을 한다. 서술어가 둘이므로 ①홑문장이 아니다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"문법·형태\",\"k\":\"안은문장 유형\",\"p\":\"아동 발화의 안긴절 유형 판별\",\"n\":\"안은문장: 명사절·관형절·부사절·서술절·인용절\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"9세 아동의 이야기 전사\\n• 형은 축구를 하고 나는 그네를 탔어.\\n• 그런데 비가 와서 우리는 집에 갔어.\\n• 엄마가 수건을 주셨어.\\n• 나는 수건으로 머리를 닦고 동생은 우유를 마셨어.\\n※ 분석 기준: 대등 연결어미로 이어진 두 절은 각각 1개의 T-unit으로, 종속절은 주절과 함께 1개의 T-unit으로 센다.\",\"q\":\"이 전사의 T-unit 수는?\",\"choices\":[\"2개\",\"3개\",\"4개\",\"5개\",\"6개\"],\"answer\":5,\"explain\":\"첫째 줄은 대등 연결 '-고'로 이어져 2개, 둘째 줄은 종속절 '비가 와서'가 주절에 포함되어 1개, 셋째 줄 1개, 넷째 줄은 대등 연결로 2개이므로 모두 6개이다. ③4개는 문장 수를 그대로 센 값이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"T-unit 분할\",\"p\":\"대등·종속 연결 기준에 따라 T-unit 수 산정\",\"n\":\"T-unit: 주절과 거기에 딸린 종속절, 대등절은 각각 분리\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"5세 아동과 엄마의 대화\\n엄마: 오늘 유치원에서 뭐 하고 놀았어?\\n아동: 블록 놀이 했어.\\n엄마: 블록으로 뭐 만들었어?\\n아동: 공룡은 고기를 먹어. 티라노는 이빨이 커.\\n엄마: 블록으로 뭐 만들었는지 궁금하네.\\n아동: 브라키오사우루스는 목이 길어.\",\"q\":\"아동이 주로 어려움을 보이는 대화 기술은?\",\"choices\":[\"대화 시작하기\",\"주제 유지하기\",\"차례 주고받기\",\"명료화 요구하기\",\"발화 길이 늘리기\"],\"answer\":2,\"explain\":\"엄마가 블록 놀이 주제를 이어 가려 하는데 아동은 자신의 관심사인 공룡 이야기로 주제를 갑자기 바꾸고 다시 돌아오지 않으므로 주제 유지에 어려움이 있다. ③아동은 엄마 발화마다 차례를 지켜 반응하고 있으며, ⑤문장 길이는 연령에 비해 짧지 않다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"화용·대화\",\"k\":\"주제 유지\",\"p\":\"대화 전사에서 아동의 주된 대화 기술 결함 판별\",\"n\":\"주제 유지: 상대가 연 주제에 관련된 발화로 대화를 이어 가는 능력\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"방에 파란 가방과 노란 가방이 있다.\\n치료사: 가방 안에 있는 거 꺼내 줄래?\\n아동: 파란 가방 말하는 거예요?\\n치료사: 응, 파란 가방.\",\"q\":\"아동이 사용한 명료화 요구의 유형으로 옳은 것은?\",\"choices\":[\"일반적(비특정적) 요구\",\"특정 요구\",\"확인 요구\",\"첨가 전략\",\"반복 전략\"],\"answer\":3,\"explain\":\"자신이 추측한 내용(파란 가방)을 제시하고 맞는지 예/아니요로 확인받는 것은 확인 요구이다. ①일반적 요구는 '응?', '뭐라고?'처럼 어느 부분인지 밝히지 않는 요구이고, ②특정 요구는 '어느 가방이요?'처럼 특정 부분을 의문사로 묻는 것이다. ④, ⑤는 명료화 요구를 받은 화자의 수정 전략이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"화용·대화\",\"k\":\"명료화 요구 유형\",\"p\":\"아동 발화를 명료화 요구 유형으로 분류\",\"n\":\"명료화 요구: 일반적 요구, 특정 요구(의문사), 확인 요구(예/아니요)\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"• 아동과 치료사 사이에 칸막이를 세워 서로의 자료가 보이지 않게 한다.\\n• 아동은 비슷한 그림 여러 장 중 자기가 고른 그림을 치료사가 찾을 수 있도록 말로 설명한다.\\n• 치료사는 설명만 듣고 같은 그림을 고른다.\",\"q\":\"이 활동이 주로 목표로 하는 능력은?\",\"choices\":[\"문법형태소를 정확히 산출하는 능력\",\"청자가 지시 대상을 구별하도록 설명하는 능력\",\"이야기 속 사건들을 시간 순서대로 배열하는 능력\",\"낱말의 음절 수를 세는 음운인식 능력\",\"그림의 이름을 빠르게 인출하는 능력\"],\"answer\":2,\"explain\":\"장벽 게임(barrier game)은 청자가 볼 수 없는 대상을 다른 것과 구별되도록 충분하고 정확하게 설명하는 참조적 의사소통 능력을 목표로 한다. 비슷한 그림 중에서 고르게 하므로 이름(⑤)만으로는 부족하고 변별 특징을 말해야 한다. ③은 이야기 구성, ④는 음운인식 목표이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"화용·대화\",\"k\":\"장벽 게임\",\"p\":\"칸막이 설명 활동이 겨냥하는 화용 능력 판별\",\"n\":\"참조적 의사소통: 청자 관점에서 지시 대상을 구별되게 설명하는 능력\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"9세 아동\\n• 친구가 \\\"어제 본 영화 재밌었어?\\\"라고 묻자 영화의 장면과 대사를 처음부터 끝까지 10분 넘게 이야기한다.\\n• 친구가 다른 곳을 보며 자리를 떠나려 해도 계속 말한다.\",\"q\":\"그라이스(Grice)의 대화 격률 중 아동이 주로 위반한 것은?\",\"choices\":[\"질의 격률\",\"관계의 격률\",\"태도의 격률\",\"공손의 격률\",\"양의 격률\"],\"answer\":5,\"explain\":\"질문에 필요한 만큼보다 지나치게 많은 정보를 제공했으므로 양의 격률 위반이다. 말한 내용은 영화에 관한 것이어서 ②관계의 격률(주제 관련성)을 어긴 것은 아니며, ①질의 격률은 거짓이나 근거 없는 말, ③태도의 격률은 모호하거나 순서 없는 말과 관련된다. ④공손의 격률은 그라이스의 격률이 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"화용·대화\",\"k\":\"그라이스 대화 격률\",\"p\":\"과도한 정보 제공 사례로 위반한 대화 격률 판별\",\"n\":\"그라이스 협력 원리: 양·질·관계·태도의 네 격률\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"4세 아동에게 그림책을 보며 이야기를 해 보게 함\\n• \\\"강아지가 있어. 자동차도 있어. 엄마는 밥 먹어. 나무도 있어.\\\"\",\"q\":\"애플비(Applebee)의 이야기 발달 단계 중 해당하는 것은?\",\"choices\":[\"무더기(heaps)\",\"연속(sequences)\",\"원시 서사\",\"초점 연쇄\",\"진정한 이야기\"],\"answer\":1,\"explain\":\"중심 인물이나 주제, 시간·인과 연결 없이 눈에 띄는 것을 나열하는 것은 무더기 단계이다. ②연속 단계는 중심 인물이나 주제를 중심으로 사건을 나열하되 시간·인과 연결이 없고, ④초점 연쇄는 중심 인물을 따라 사건이 연결되지만 결말이 뚜렷하지 않다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"이야기·담화\",\"k\":\"애플비 이야기 발달 단계\",\"p\":\"아동 이야기 산출로 애플비 발달 단계 판별\",\"n\":\"애플비: 무더기 → 연속 → 원시 서사 → 단순 연쇄 → 초점 연쇄 → 진정한 이야기\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동의 이야기 산출\\n• 옛날에 숲속에 토끼가 살았어요.\\n• 어느 날 토끼가 아끼던 모자가 바람에 날아갔어요.\\n• 토끼는 너무 슬펐어요.\\n• 결국 토끼는 모자 없이 집에 돌아왔어요.\",\"q\":\"스타인과 글렌(Stein & Glenn)의 이야기 문법에서 완전한 에피소드가 되기 위해 보충해야 할 요소로 가장 적절한 것은?\",\"choices\":[\"배경\",\"계기 사건\",\"내적 반응\",\"시도\",\"결과\"],\"answer\":4,\"explain\":\"배경(숲속 토끼), 계기 사건(모자가 날아감), 내적 반응(슬픔), 결과(모자 없이 돌아옴)는 있으나 문제를 해결하려는 행동인 시도가 없다. 완전한 에피소드에는 계기 사건-시도-결과가 갖추어져야 하므로 시도를 보충해야 한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"이야기·담화\",\"k\":\"에피소드 구성 요소\",\"p\":\"아동 이야기에서 빠진 이야기 문법 요소 찾기\",\"n\":\"완전한 에피소드: 계기 사건·시도·결과를 갖추어야 함\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동이 읽은 설명하는 글\\n• 개구리와 두꺼비는 모두 양서류이다.\\n• 개구리는 피부가 매끄럽고 촉촉하지만, 두꺼비는 피부가 거칠고 울퉁불퉁하다.\\n• 개구리는 멀리 뛰어오르고, 두꺼비는 주로 걷거나 짧게 뛴다.\",\"q\":\"이 글의 설명담화 구조로 가장 적절한 것은?\",\"choices\":[\"나열(기술)\",\"시간 순서\",\"비교·대조\",\"원인·결과\",\"문제·해결\"],\"answer\":3,\"explain\":\"두 대상의 공통점(양서류)과 차이점(피부, 이동 방식)을 견주어 설명하므로 비교·대조 구조이다. ①나열은 한 대상의 특징을 차례로 늘어놓는 구조이고, ④원인·결과는 사건 사이의 인과를, ⑤문제·해결은 문제와 해결 방안을 제시하는 구조이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"이야기·담화\",\"k\":\"설명담화 구조\",\"p\":\"설명하는 글의 담화 구조 유형 판별\",\"n\":\"설명담화 구조: 나열·순서·비교대조·원인결과·문제해결\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"\",\"q\":\"이야기 산출 분석 지표와 그것이 주로 반영하는 영역이 옳게 연결된 것은?\",\"choices\":[\"이야기 문법 요소 수 – 구문 복잡성\",\"총 낱말 수 – 어휘 다양성\",\"서로 다른 낱말 수 – 이야기 구조\",\"결속 표지 사용의 적절성 – 구문 길이\",\"평균 T-unit 길이 – 구문 복잡성\"],\"answer\":5,\"explain\":\"평균 T-unit 길이(MLT, T-unit당 평균 낱말 수)는 구문 복잡성을 반영하는 대표적 지표이다. ①이야기 문법 요소 수는 이야기 구조(거시구조), ②총 낱말 수는 생산성, ③서로 다른 낱말 수는 어휘 다양성, ④결속 표지 사용은 담화의 결속(응집) 능력을 반영한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"이야기·담화\",\"k\":\"이야기 분석 지표\",\"p\":\"이야기 산출 분석 지표와 측정 영역 연결\",\"n\":\"생산성(총 낱말 수), 어휘 다양성(NDW), 구문(MLT), 구조(이야기 문법), 결속\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"5세 아동\\n• 과자 봉지의 로고를 보고 상표 이름을 정확히 말한다.\\n• 같은 상표 이름을 흰 종이에 일반 글씨로 써 주면 읽지 못한다.\\n• 글자와 소리의 대응은 아직 알지 못한다.\",\"q\":\"에리(Ehri)의 낱말 읽기 발달 단계 중 해당하는 것은?\",\"choices\":[\"자모 이전 단계\",\"부분적 자모 단계\",\"완전한 자모 단계\",\"통합된 자모 단계\",\"유창성 단계\"],\"answer\":1,\"explain\":\"글자-소리 대응 지식 없이 로고·색 등 시각적 단서로 낱말을 알아보는 것은 자모 이전 단계이다. ②부분적 자모 단계는 첫 글자 등 일부 자소-음소 단서를 활용하고, ③완전한 자모 단계는 모든 자소를 음소로 바꾸어 해독한다. ⑤유창성 단계는 찰(Chall)의 단계 용어이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"읽기·쓰기\",\"k\":\"에리 낱말 읽기 단계\",\"p\":\"로고 읽기 행동으로 낱말 읽기 발달 단계 판별\",\"n\":\"에리: 자모 이전 → 부분적 자모 → 완전한 자모 → 통합된 자모\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"초등학교 3학년 아동의 읽기 평가\\n• 무의미 낱말(예: '뭉탁', '깁노') 읽기 정확도는 또래 수준이다.\\n• 자소-음소가 일치하는 낱말은 정확히 읽는다.\\n• '해돋이'를 [해도디], '먹는'을 [먹는]처럼 글자 그대로 읽는 오류가 많다.\",\"q\":\"이 아동의 읽기 양상으로 가장 적절한 것은?\",\"choices\":[\"음운성 난독\",\"이해 부진\",\"심층성 난독\",\"표층성 난독\",\"혼합형 난독\"],\"answer\":4,\"explain\":\"자소-음소 대응 규칙을 적용하는 해독(무의미 낱말·규칙 낱말)은 정상인데 음운 변동이 일어나는 불일치 낱말을 글자대로 읽는 것은 표층성 난독의 양상이다. ①음운성 난독은 무의미 낱말 읽기가 특히 어렵고, ②이해 부진은 해독은 정상이나 읽기 이해가 낮은 경우이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"읽기·쓰기\",\"k\":\"표층성 난독\",\"p\":\"규칙·무의미 낱말과 불일치 낱말 읽기 차이로 유형 판별\",\"n\":\"표층성 난독: 규칙 해독은 가능, 자소-음소 불일치 낱말을 글자대로 읽음\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"초등학교 2학년 아동의 글 읽기 유창성 평가\\n• 2분 동안 소리 내어 읽은 어절 수: 130어절\\n• 오류(대치·생략·첨가 등)가 있었던 어절 수: 10어절\\n• 산출 기준: 1분당 바르게 읽은 어절 수(오류 어절 제외)\",\"q\":\"이 아동의 1분당 바르게 읽은 어절 수는?\",\"choices\":[\"60어절\",\"65어절\",\"70어절\",\"120어절\",\"130어절\"],\"answer\":1,\"explain\":\"바르게 읽은 어절 수는 130 − 10 = 120어절이고, 이를 읽은 시간 2분으로 나누면 120 ÷ 2 = 60어절이다. ②65는 오류를 빼지 않은 값(130 ÷ 2), ④120은 시간으로 나누지 않은 값이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"읽기·쓰기\",\"k\":\"읽기 유창성 계산\",\"p\":\"읽은 어절·오류·시간으로 분당 정확 어절 수 산출\",\"n\":\"분당 바르게 읽은 어절 수 = (읽은 어절 − 오류 어절) ÷ 읽은 시간(분)\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"• 소집단이 글을 한 단락씩 함께 읽는다.\\n• 읽기 전 다음 내용을 예측하고, 읽으면서 모르는 낱말이나 어려운 부분을 명료화한다.\\n• 내용에 대해 서로 질문을 만들고, 단락을 요약한다.\\n• 처음에는 교사가 시범을 보이다가 점차 학생이 교사 역할을 맡는다.\",\"q\":\"이 읽기 이해 중재 기법은?\",\"choices\":[\"반복 읽기\",\"파닉스 직접 교수\",\"상보적 교수\",\"그래픽 조직자\",\"음운 합성 훈련\"],\"answer\":3,\"explain\":\"예측하기·질문 만들기·명료화하기·요약하기의 네 전략을 교사 시범 후 학생이 번갈아 이끄는 방식은 상보적 교수(reciprocal teaching)이다. ①반복 읽기는 같은 글을 여러 번 읽어 유창성을 높이는 기법이고, ②파닉스 직접 교수와 ⑤음운 합성 훈련은 해독 중재이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"읽기·쓰기\",\"k\":\"상보적 교수\",\"p\":\"예측·질문·명료화·요약 절차로 읽기 이해 중재 기법 식별\",\"n\":\"상보적 교수: 예측·질문·명료화·요약, 점진적 역할 이양\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"[그림 1]은 DSM-5 진단 기준에 따른 자폐스펙트럼장애(ASD)와 사회적(화용적) 의사소통장애(SCD)의 특성을 벤다이어그램으로 나타낸 것이다.\",\"q\":\"특성과 그것이 들어갈 영역이 옳게 연결된 것은?\",\"choices\":[\"감각 자극에 대한 과잉 또는 과소 반응 – ㉡\",\"같은 일과를 고집하고 작은 변화에 크게 저항함 – ㉢\",\"비유적·암시적 의미를 이해하기 어려움 – ㉠\",\"특정 대상에 대한 강하고 제한된 관심 – ㉡\",\"상황·청자에 맞게 말하는 방식을 바꾸기 어려움 – ㉡\"],\"answer\":5,\"explain\":\"그림에서 ㉠은 ASD에만, ㉡은 두 진단 모두에, ㉢은 SCD에만 해당하는 영역이다. 상황·청자에 맞게 의사소통을 조절하기 어려운 것은 SCD의 진단 특성이면서 ASD의 사회적 의사소통 결함에도 포함되므로 ㉡이다. ①감각 반응 이상, ②동일성 고집, ④제한된 관심은 제한적·반복적 행동으로 ASD에만 해당하는 ㉠이며(SCD는 이것이 없어야 진단), ③비유적·암시적 의미 이해의 어려움은 SCD 진단 기준에 들어 있으므로 ASD에만 해당하는 ㉠이 될 수 없다.\",\"image\":\"data:image/svg+xml;base64,\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"대상군 특성\",\"k\":\"ASD와 SCD 감별\",\"p\":\"벤다이어그램에서 진단 특성이 들어갈 영역 고르기\",\"n\":\"SCD는 사회적 의사소통 결함만 있고 제한적·반복적 행동이 없을 때 진단, ASD는 둘 다 있음\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"8세 아동\\n• 지능검사에서 경도 지적장애 수준이며, 특히 블록 구성 등 시공간 과제 점수가 매우 낮다.\\n• 어휘가 풍부하고 표정과 억양을 살려 이야기를 생생하게 한다.\\n• 처음 보는 사람에게도 거리낌 없이 다가가 말을 건다.\\n• 영아기에 대동맥판 위 협착(심장 질환)을 진단받았다.\",\"q\":\"가장 가능성이 높은 증후군은?\",\"choices\":[\"다운증후군\",\"윌리엄스증후군\",\"취약X증후군\",\"프래더-윌리증후군\",\"레트증후군\"],\"answer\":2,\"explain\":\"시공간 능력의 뚜렷한 저하에 비해 상대적으로 양호한 표현 어휘·이야기 능력, 과도한 친화성, 대동맥판 위 협착은 윌리엄스증후군의 특징이다. ①다운증후군은 표현언어·구문이 특히 지연되고, ③취약X증후군은 시선 회피와 보속적 반복 발화가 흔하다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"윌리엄스증후군\",\"p\":\"인지·언어·사회성·의학적 특징으로 증후군 판별\",\"n\":\"윌리엄스증후군: 시공간 약점, 상대적 언어 강점, 과도한 사교성, 심혈관 이상\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"\",\"q\":\"24개월 말 늦은 아동(late talker) 중 이후 언어장애로 이어질 위험이 더 높은 경우는?\",\"choices\":[\"수용언어도 또래보다 지연되어 있는 경우\",\"가리키기 등 몸짓을 활발히 사용하는 경우\",\"상징놀이가 또래 수준으로 나타나는 경우\",\"새 낱말을 자발적으로 자주 모방하는 경우\",\"가족 중 언어 문제를 보인 사람이 없는 경우\"],\"answer\":1,\"explain\":\"표현언어뿐 아니라 수용언어도 지연된 경우는 표현언어만 늦은 경우보다 언어장애로 지속될 위험이 높다. ②몸짓 사용이 활발함, ③또래 수준의 상징놀이, ④자발적 모방, ⑤언어장애 가족력이 없음은 모두 예후가 좋은 쪽의 요인이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"대상군 특성\",\"k\":\"말 늦은 아동 예후 요인\",\"p\":\"말 늦은 아동의 언어장애 지속 위험 요인 고르기\",\"n\":\"수용언어 지연, 몸짓 부족, 가족력 등은 지속 위험을 높임\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"5세 다문화 가정 아동\\n• 가정에서는 어머니의 모국어로 또래 수준의 대화를 한다.\\n• 4개월 전부터 한국어를 쓰는 유치원에 다니기 시작했다.\\n• 유치원에서는 거의 말하지 않지만, 교사의 한국어 지시를 몸짓 단서와 함께 따르는 경우가 늘고 있다.\",\"q\":\"이 아동에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"두 언어 모두 지연되어 언어장애가 의심된다\",\"선택적 함묵증으로 보고 심리치료를 의뢰한다\",\"모국어 사용을 중단해야 한국어가 빨리 는다\",\"제2언어 습득 초기의 정상적인 침묵기로 볼 수 있다\",\"한국어 표준화 검사 점수로 장애를 진단한다\"],\"answer\":4,\"explain\":\"모국어는 또래 수준이고 한국어 노출 초기에 말은 거의 하지 않지만 이해가 늘고 있으므로 순차적 이중언어 습득 초기의 정상적인 침묵기로 볼 수 있다. ①모국어 발달이 정상이므로 맞지 않고, ②선택적 함묵증은 새 언어에 대한 지식 부족으로 설명되는 경우 진단하지 않는다. ⑤노출 기간이 짧은 언어의 표준화 검사 점수만으로 진단하면 과잉 판별의 위험이 있다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"제2언어 침묵기\",\"p\":\"순차적 이중언어 아동의 초기 무발화 해석\",\"n\":\"침묵기: 제2언어 노출 초기 듣기·이해 위주로 말을 거의 하지 않는 정상 단계\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"\",\"q\":\"단순언어장애(발달성 언어장애) 아동을 선별하는 데 민감한 임상적 표지로 보고되는 과제는?\",\"choices\":[\"수용 어휘 이해 과제\",\"낱말 수준 조음 검사\",\"비단어 따라말하기\",\"비언어성 지능 과제\",\"도형 재인 과제\"],\"answer\":3,\"explain\":\"비단어 따라말하기는 기존 어휘 지식의 영향을 줄이고 음운 작업기억을 반영하며, 단순언어장애 아동이 일관되게 낮은 수행을 보여 임상적 표지로 보고된다. ④비언어성 지능은 단순언어장애 아동에서 정상 범위이므로 판별 표지가 되지 못하고, ②조음 검사는 말소리 산출 능력을 본다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"비단어 따라말하기\",\"p\":\"단순언어장애의 임상적 표지 과제 고르기\",\"n\":\"비단어 따라말하기: 음운 작업기억 반영, 단순언어장애의 민감한 표지\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동: (자동차를 밀며) 차 가.\\n치료사: 응, 빨간 차가 빨리 가네.\",\"q\":\"치료사가 사용한 언어촉진 기법은?\",\"choices\":[\"확장(expansion)\",\"혼잣말(self-talk)\",\"재구성(recast)\",\"모방(imitation)\",\"확대(extension)\"],\"answer\":5,\"explain\":\"아동 발화의 의미를 유지하면서 '빨간', '빨리'처럼 새로운 의미 정보를 덧붙여 들려주었으므로 확대(extension)이다. ①확장은 새 정보 없이 문법적으로 완전한 형태로만 고쳐 주는 것(예: '차가 가')이고, ③재구성은 문장 유형이나 구조를 바꾸어 들려주는 것이며, ②혼잣말은 치료사 자신의 행동을 말로 표현하는 것이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"확대 기법\",\"p\":\"치료사 반응에 새 의미 정보가 더해진 기법 판별\",\"n\":\"확장: 문법적 완성, 확대: 새로운 의미 정보 추가\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"• 치료사는 아동이 좋아하는 비눗방울 통을 손이 닿지 않는 선반 위에 두었다.\\n• 아동이 선반을 가리키며 치료사를 쳐다보았다.\\n• 치료사: \\\"뭐 줄까?\\\"\\n• 아동: \\\"방울.\\\"\\n• 치료사: \\\"비눗방울 줘.\\\"\\n• 아동: \\\"비눗방울 줘.\\\" → 치료사가 비눗방울 통을 건넨다.\",\"q\":\"치료사가 사용한 환경중심 언어중재 절차로 가장 적절한 것은?\",\"choices\":[\"우발 교수\",\"요구-모델\",\"시간 지연\",\"비연속 시행 훈련\",\"공동 행동 일과\"],\"answer\":1,\"explain\":\"아동이 먼저 가리키기로 요구를 시작했고, 치료사가 그 시작을 계기로 더 정교한 표현을 유도·시범한 뒤 원하는 것을 주었으므로 우발 교수이다. ②요구-모델은 성인이 먼저 아동의 관심 대상에 대해 말하도록 요구하는 절차이고, ③시간 지연은 말 없이 기대하며 기다려 아동의 시작을 유도하는 절차이다. ④비연속 시행 훈련은 치료사 주도의 구조화된 행동주의 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"우발 교수\",\"p\":\"아동 시작 행동 후 정교화 유도 절차 식별\",\"n\":\"우발 교수: 아동의 요구 시작을 계기로 정교한 표현을 유도\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"그림교환의사소통체계(PECS) 훈련 중인 6세 자폐스펙트럼장애 아동\\n• 의사소통 책이 아동에게서 떨어진 탁자 위에 있다.\\n• 아동은 책으로 걸어가 과자 그림 한 장을 떼어 낸 뒤, 방 반대편에 있는 교사에게 다가가 그림을 건넨다.\\n• 여러 그림 중 원하는 그림을 골라내는 훈련은 아직 시작하지 않았다.\",\"q\":\"아동이 수행하고 있는 PECS 훈련 단계는?\",\"choices\":[\"1단계: 교환 방법 익히기\",\"2단계: 거리와 지속성 늘리기\",\"3단계: 그림 변별하기\",\"4단계: 문장 구성하기\",\"5단계: 질문에 반응하여 요구하기\"],\"answer\":2,\"explain\":\"의사소통 책과 의사소통 상대가 멀리 있어도 스스로 이동해 그림을 가져가 교환하는 것은 2단계(거리와 지속성)이다. ①1단계는 가까이에서 그림 한 장을 집어 건네는 교환 자체를 익히고, ③3단계에서 여러 그림 중 원하는 것을 변별하므로 아직 시작하지 않은 단계이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"PECS 단계\",\"p\":\"PECS 수행 행동으로 훈련 단계 판별\",\"n\":\"PECS: 교환 → 거리·지속성 → 변별 → 문장 → 질문 반응 → 언급\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"뇌성마비 10세 아동\\n• 손과 팔의 움직임이 매우 제한되어 화면이나 그림을 손으로 직접 가리킬 수 없다.\\n• 머리를 옆으로 돌려 머리 받침대의 스위치를 누르는 것은 안정적으로 할 수 있다.\\n• 상징을 이해하고 고르는 인지 능력에는 문제가 없다.\",\"q\":\"이 아동에게 적합한 보완대체의사소통(AAC) 선택 기법은?\",\"choices\":[\"손으로 그림을 가리키는 직접 선택\",\"수어·몸짓 등 비도구적 체계\",\"키보드를 이용한 철자 입력\",\"머리 스위치를 이용한 훑기(스캐닝) 선택\",\"그림카드를 집어 건네는 교환\"],\"answer\":4,\"explain\":\"손으로 직접 선택하기 어렵지만 머리로 스위치를 안정적으로 누를 수 있으므로, 항목이 차례로 강조될 때 스위치로 선택하는 훑기(스캐닝)가 적합하다. ①, ③, ⑤는 손의 정교한 운동이 필요하고, ②수어·몸짓도 손·팔 움직임에 의존한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"AAC 선택 기법\",\"p\":\"운동 능력에 맞는 AAC 선택 기법 결정\",\"n\":\"직접 선택이 어려우면 신뢰할 수 있는 신체 부위로 스위치를 눌러 훑기 선택\"}},{\"grade\":2,\"set\":2,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"부모가 아동과 그림책을 함께 보는 장면\\n부모: 이건 뭐야?\\n아동: 곰.\\n부모: 맞아, 갈색 곰이네. '갈색 곰' 말해 볼래?\\n아동: 갈색 곰.\\n부모: 곰이 어디에 가는 것 같아?\",\"q\":\"부모가 사용한 책 읽기 방법으로 가장 적절한 것은?\",\"choices\":[\"반복 읽기\",\"상보적 교수\",\"대화식 책 읽기\",\"음운 인식 훈련\",\"파닉스 직접 교수\"],\"answer\":3,\"explain\":\"아동에게 질문으로 반응을 유도하고(Prompt), 평가하고(Evaluate), 확장해 주고(Expand), 다시 말하게 하는(Repeat) 절차는 대화식 책 읽기(dialogic reading)이다. ①반복 읽기는 유창성 향상 기법이고, ②상보적 교수는 학령기 읽기 이해 전략 교수이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"대화식 책 읽기\",\"p\":\"그림책 상호작용 전사에서 책 읽기 중재 방법 식별\",\"n\":\"대화식 책 읽기: 유도-평가-확장-반복(PEER)으로 아동을 이야기 화자로 만듦\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"낱말의 표준 발음과 적용된 음운규칙이 옳게 연결된 것은?\",\"choices\":[\"신라 [실라] – 비음화\",\"밥물 [밤물] – 유음화\",\"굳이 [구지] – 구개음화\",\"좋고 [조코] – 구개음화\",\"입학 [이팍] – 비음화\"],\"answer\":3,\"explain\":\"'굳이'는 받침 ㄷ이 모음 ㅣ 앞에서 [ㅈ]으로 바뀌는 구개음화가 적용되어 [구지] [kudʑi]로 발음된다. ①은 유음화, ②는 비음화이며, ④·⑤는 ㅎ과 평음이 합쳐져 격음이 되는 격음화(유기음화)이므로 각각 구개음화·비음화와 연결한 것이 틀렸다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"음운규칙과 예 연결\",\"p\":\"표준 발음 예와 적용된 음운규칙의 대응 판단\",\"n\":\"구개음화: 받침 ㄷ·ㅌ이 ㅣ 앞에서 ㅈ·ㅊ으로 바뀜, 신라는 유음화·밥물은 비음화\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"'꽃잎'의 표준 발음을 한글과 IPA로 옳게 전사한 것은?\",\"choices\":[\"[꼬칩] – [k͈otɕʰip̚]\",\"[꼳닙] – [k͈otnip̚]\",\"[꼰닙] – [konnip̚]\",\"[꼬닙] – [k͈onip̚]\",\"[꼰닙] – [k͈onnip̚]\"],\"answer\":5,\"explain\":\"'꽃잎'은 합성어에서 ㄴ이 첨가되고(꽃닙), 받침 ㅊ이 [ㄷ]으로 바뀐 뒤(평파열음화) 비음 앞에서 [ㄴ]으로 바뀌어(비음화) [꼰닙] [k͈onnip̚]이 된다. ①은 ㄴ첨가 없이 연음만 했고, ②는 비음화가 빠졌으며, ③은 경음 ㄲ을 평음 [k]로 적었다. ④는 받침이 탈락해 음운규칙에 맞지 않는다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"ㄴ첨가·비음화 IPA 전사\",\"p\":\"합성어의 ㄴ첨가·평파열음화·비음화를 반영한 한글·IPA 전사 판단\",\"n\":\"꽃잎 → [꼰닙] [k͈onnip̚]: ㄴ첨가 → 평파열음화 → 비음화, 경음 ㄲ은 [k͈]\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"[+지속성] 자질을 가진 자음끼리만 묶인 것은?\",\"choices\":[\"ㅅ, ㅈ, ㅎ\",\"ㄷ, ㅅ, ㅆ\",\"ㅆ, ㅊ, ㅎ\",\"ㅅ, ㅆ, ㅎ\",\"ㅂ, ㅅ, ㅎ\"],\"answer\":4,\"explain\":\"[+지속성]은 구강 통로가 완전히 막히지 않아 기류가 계속 흐르는 소리로, 마찰음 ㅅ·ㅆ·ㅎ이 해당한다. 파찰음 ㅈ(①)·ㅊ(③), 파열음 ㄷ(②)·ㅂ(⑤)은 [-지속성]이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"지속성 자질\",\"p\":\"[+지속성] 자질을 공유하는 자음 묶음 판별\",\"n\":\"[+지속성] = 마찰음(ㅅ·ㅆ·ㅎ), 파열음·파찰음은 [-지속성]\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"한국어 단모음과 그 분류가 옳게 연결된 것은?\",\"choices\":[\"ㅡ – 후설 원순 고모음\",\"ㅓ – 후설 평순 중모음\",\"ㅐ – 전설 평순 고모음\",\"ㅗ – 전설 원순 중모음\",\"ㅏ – 후설 원순 저모음\"],\"answer\":2,\"explain\":\"ㅓ /ʌ/는 혀의 뒤쪽이 중간 높이로 올라가고 입술이 둥글지 않은 후설·평순·중모음이다. ①ㅡ는 평순 모음, ③ㅐ는 저모음, ④ㅗ는 후설 모음, ⑤ㅏ는 평순 모음이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"단모음 분류\",\"p\":\"혀 위치·높이·입술 모양에 따른 단모음 분류 판단\",\"n\":\"ㅓ: 후설·평순·중모음, ㅡ 평순 고모음, ㅐ 전설 저모음, ㅗ 후설 원순 중모음\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"표준 발음을 기준으로 할 때 음절구조가 'CVC-CV'인 것은? (C: 자음, V: 모음)\",\"choices\":[\"닭이\",\"옷이\",\"국어\",\"앉아\",\"밥솥\"],\"answer\":1,\"explain\":\"'닭이'는 겹받침 중 ㄱ이 연음되어 [달기] [talgi]로 발음되므로 CVC-CV이다. ②옷이[오시]는 V-CV, ③국어[구거]는 CV-CV, ④앉아[안자]는 VC-CV, ⑤밥솥[밥쏟]은 CVC-CVC이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"연음 후 음절구조\",\"p\":\"연음·겹받침 발음을 적용한 뒤 음절구조 판단\",\"n\":\"음절구조는 표준 발음 기준: 닭이[달기] CVC-CV, 초성 ㅇ은 자음으로 세지 않음\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 아동의 낱말 검사 결과\\n• 기차 /kitɕʰa/ → [기자] [kidʑa]\\n• 토끼 /tʰok͈i/ → [도끼] [tok͈i]\\n• 컵 /kʰʌp̚/ → [겁] [kʌp̚]\",\"q\":\"이 아동에게 공통으로 나타나는 오류패턴은?\",\"choices\":[\"긴장음화\",\"파열음화\",\"이완음화\",\"연구개음 전방화\",\"파찰음화\"],\"answer\":3,\"explain\":\"격음 ㅊ·ㅌ·ㅋ이 모두 같은 위치·방법의 평음 ㅈ·ㄷ·ㄱ으로 바뀌어 기식성이 없어졌으므로 이완음화(탈기식음화)이다. 조음방법·위치는 그대로이므로 ②파열음화, ④연구개음 전방화, ⑤파찰음화가 아니며, ①긴장음화는 평음이 경음으로 바뀌는 패턴이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"이완음화 판별\",\"p\":\"격음이 평음으로 바뀐 전사에서 오류패턴 판별\",\"n\":\"이완음화(탈기식음화): 격음 → 평음, 조음위치·방법은 유지\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"만 3세 아동에게서 관찰될 때 발달적 오류패턴으로 볼 수 있는 것은?\",\"choices\":[\"바다 /pada/ → [아다] [ada]\",\"다리 /taɾi/ → [가리] [kaɾi]\",\"우유 /uju/ → [오요] [ojo]\",\"가방 /kabaŋ/ → [하방] [habaŋ]\",\"사자 /sadʑa/ → [다자] [tadʑa]\"],\"answer\":5,\"explain\":\"마찰음 /ㅅ/를 [ㄷ]으로 바꾸는 마찰음의 파열음화는 3세 무렵 흔히 관찰되는 발달적 오류패턴이다. ①초성 생략, ②치조음의 후방화, ③모음 대치, ④/ㄱ/의 성문음 /ㅎ/ 대치는 일반적인 발달 과정에서 잘 나타나지 않는 비발달적 오류이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"3세 발달적 오류패턴\",\"p\":\"전사 예 중 3세에 나타날 수 있는 발달적 오류패턴 판별\",\"n\":\"마찰음의 파열음화는 발달적, 초성 생략·후방화·모음 오류·성문음 대치는 비발달적\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"아동이 보이는 오류패턴\\n• 마찰음의 파열음화\\n• 연구개음 전방화\\n• 어말 종성 생략\",\"q\":\"이 아동이 '소금' /sogɯm/을 산출할 때 예상되는 형태는?\",\"choices\":[\"[도드] [todɯ]\",\"[도그] [toɡɯ]\",\"[소드] [sodɯ]\",\"[도듬] [todɯm]\",\"[조드] [tɕodɯ]\"],\"answer\":1,\"explain\":\"'소금'에 세 패턴을 적용하면 /ㅅ/ → [ㄷ](파열음화), /ㄱ/ → [ㄷ](연구개음 전방화), 어말 종성 /ㅁ/ 생략으로 [도드]가 된다. ②는 전방화, ③은 파열음화, ④는 종성 생략이 빠졌고, ⑤는 파열음화 대신 파찰음화를 적용한 형태이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"복수 오류패턴 적용 예측\",\"p\":\"세 오류패턴을 동시에 적용한 산출 형태 예측\",\"n\":\"오류패턴 적용 예측: 각 음소에 해당 패턴을 차례로 적용(ㅅ→ㄷ, ㄱ→ㄷ, 어말 종성 생략)\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 아동(평소 '사과'를 [다과] [tagwa]로 산출함)과 어른의 대화\\n• 어른: (사과 그림을 가리키며) \\\"이거 [다과]야?\\\"\\n• 아동: \\\"아니야! [다과] 아니고 [다과]야!\\\"\",\"q\":\"이 현상이 시사하는 것으로 가장 적절한 것은?\",\"choices\":[\"아동은 /ㅅ/와 /ㄷ/를 지각적으로 구별하지 못한다\",\"말소리 지각이 산출보다 앞서 발달하고 있다\",\"아동의 기저 표상에 '사과'가 [다과]로 저장되어 있다\",\"청력 손실로 고주파수 마찰음을 듣지 못한다\",\"모방 능력이 부족하여 오류를 수정하지 못한다\"],\"answer\":2,\"explain\":\"아동은 자신도 [다과]로 말하면서 어른의 [다과]는 틀렸다고 판단하므로, /ㅅ/와 /ㄷ/를 지각적으로 구별하고 성인형에 가까운 표상을 갖고 있으나 산출이 아직 따라가지 못하는 것이다(이른바 'fis 현상'). 따라서 ①·③은 틀리며, 대조를 지각하는 것으로 보아 ④ 청력 손실로 설명하기 어렵다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"지각-산출 불일치(fis 현상)\",\"p\":\"자기 오류형은 산출하면서 성인의 오류형은 거부하는 현상의 의미 판단\",\"n\":\"말소리 지각은 산출보다 먼저 발달, 아동은 성인형 표상을 가질 수 있음(fis 현상)\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"첫 낱말 시기(약 12~18개월) 아동의 음운 특성으로 옳은 것은?\",\"choices\":[\"마찰음과 유음이 어두 초성에 다양하게 나타난다\",\"종성 자음의 종류가 초성 자음보다 더 다양하다\",\"같은 낱말을 매우 일관된 형태로 산출한다\",\"CV·CVCV 같은 단순·반복 음절이 많다\",\"대치 오류보다 왜곡 오류가 주로 나타난다\"],\"answer\":4,\"explain\":\"첫 낱말 시기에는 CV·CVCV 같은 단순 음절과 반복 음절이 많고, 비음·파열음 위주의 제한된 자음을 쓴다. 마찰음·유음은 늦게 습득되고(①), 종성은 초성보다 제한적이며(②), 같은 낱말도 산출 변이가 크고(③), 오류는 주로 생략·대치 형태이다(⑤).\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"첫 낱말 시기 음운 특성\",\"p\":\"첫 낱말 시기 음절구조·자음 목록·산출 변이성 특성 판단\",\"n\":\"첫 낱말 시기: 단순·반복 음절, 비음·파열음 위주, 산출 변이성 큼\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"아동의 발화(표준 발음 기준)\\n• 목표: 국물 마시고 놀자 → [궁물 마시고 놀자] [kuŋmul maɕigo noldʑa]\\n• 산출: [구무 마디고 노자] [kumu madigo nodʑa]\",\"q\":\"이 발화의 자음정확도(PCC)는?\",\"choices\":[\"5/10×100(%)\",\"6/10×100(%)\",\"7/10×100(%)\",\"6/11×100(%)\",\"7/11×100(%)\"],\"answer\":2,\"explain\":\"표준 발음 [궁물 마시고 놀자]의 자음은 ㄱ·ㅇ[ŋ]·ㅁ·ㄹ·ㅁ·ㅅ·ㄱ·ㄴ·ㄹ·ㅈ 10개이다. 아동은 '궁'의 종성 ㅇ, '물'의 종성 ㄹ, /ㅅ/(→[ㄷ]), '놀'의 종성 ㄹ 4개를 틀려 정조음은 6개이므로 PCC = 6/10×100 = 60%이다. 분모는 표기가 아니라 표준 발음의 자음 수로 정한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"연결발화 PCC 산출\",\"p\":\"표준 발음(비음화 적용) 기준으로 목표 자음 수와 정조음 수를 세어 PCC 계산\",\"n\":\"PCC = 정조음 자음 수 / 표준 발음의 목표 자음 수 × 100\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"아동의 낱말 산출\\n• 고기 /koɡi/ → [도디] [todi]\\n• 가위 /kawi/ → [다위] [tawi]\\n• 코 /kʰo/ → [코] [kʰo]\\n• 기차 /kitɕʰa/ → [기다] [kida]\\n• 토끼 /tʰok͈i/ → [토띠] [tʰot͈i]\\n※ 출현율은 낱말 수가 아니라 목표 연구개음이 나타나는 기회 수를 기준으로 계산한다.\",\"q\":\"연구개음 전방화의 출현율은?\",\"choices\":[\"3/5×100(%)\",\"4/5×100(%)\",\"4/6×100(%)\",\"5/6×100(%)\",\"4/7×100(%)\"],\"answer\":3,\"explain\":\"출현율은 오류패턴이 나타날 수 있는 기회(목표 연구개음) 수 대비 실제 출현 수로 구한다. 연구개음 기회는 고기 2, 가위 1, 코 1, 기차 1, 토끼(ㄲ) 1로 6번이고, 전방화는 고기 2, 가위 1, 토끼 1로 4번이므로 4/6×100 ≈ 66.7%이다. ①은 낱말 수(5개 중 3개)로 잘못 계산한 값이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"오류패턴 출현율 산출\",\"p\":\"목표 연구개음 기회 수 대비 전방화 출현 수로 출현율 계산\",\"n\":\"오류패턴 출현율 = 패턴 출현 수 / 패턴이 나타날 수 있는 기회 수 × 100\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"/ㅅ/ 낱말 검사 결과(표준 발음 기준)\\n• 세수 /sesu/ → [데수] [tesu]\\n• 우산 /usan/ → [우산] [usan]\\n• 빗 /pit̚/ → [빋] [pit̚]\\n• 사슴 /sasɯm/ → [다듬] [tadɯm]\\n• 다섯 /tasʌt̚/ → [다덛] [tadʌt̚]\",\"q\":\"/ㅅ/의 정확도는?\",\"choices\":[\"2/6×100(%)\",\"3/6×100(%)\",\"2/8×100(%)\",\"3/8×100(%)\",\"4/8×100(%)\"],\"answer\":1,\"explain\":\"표준 발음에서 받침 ㅅ은 [ㄷ]으로 발음되므로 '빗'[빋]과 '다섯'[다섣]의 받침은 /ㅅ/ 기회가 아니다. /ㅅ/ 기회는 세수 2, 우산 1, 사슴 2, 다섯(초성) 1로 6번이고, 정조음은 '세수'의 '수'와 '우산'의 '산' 2번이므로 2/6×100 ≈ 33.3%이다. ③은 받침 ㅅ 2개까지 분모에 넣은 값이고, ⑤는 받침을 분모에 넣은 뒤 [ㄷ]으로 바르게 발음한 받침까지 정조음으로 센 값이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"목표음 정확도 산출\",\"p\":\"받침 ㅅ의 평파열음화를 고려해 /ㅅ/ 기회 수와 정조음 수 계산\",\"n\":\"음소 정확도의 분모는 표준 발음에서 그 음소가 실현되는 기회 수(받침 ㅅ → [ㄷ] 제외)\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"낱말 검사와 비교할 때 연결발화(자발화) 표본 분석의 장점으로 옳은 것은?\",\"choices\":[\"모든 목표 음소를 위치별로 빠짐없이 유도할 수 있다\",\"아동이 회피하는 음소도 반드시 산출하게 할 수 있다\",\"목표 낱말을 미리 알아 전사 시간이 가장 적게 든다\",\"동시조음과 운율 등 실제 말 산출 특성을 반영한다\",\"연령 규준과 바로 비교할 수 있는 표준점수를 준다\"],\"answer\":4,\"explain\":\"연결발화 표본은 동시조음, 운율, 낱말 길이 효과 등이 반영된 실제 의사소통 수준의 말소리 산출을 보여 준다. ①·⑤는 표준화된 낱말 검사의 장점이며, 자발화에서는 아동이 어려운 음소를 회피할 수 있고(②) 목표 낱말을 알기 어려워 전사·분석에 시간이 많이 든다(③).\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"연결발화 표본 장점\",\"p\":\"낱말 검사 대비 연결발화 분석의 장단점 판단\",\"n\":\"연결발화: 동시조음·운율 등 실제 산출 반영, 낱말 검사: 음소·위치 통제와 규준 비교\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 아동의 /ㅅ/ 산출 정밀 전사\\n• 사자 /sadʑa/ → [s̪adʑa]\\n• 수박 /subak̚/ → [s̪ubak̚]\",\"q\":\"전사에 사용된 구별기호가 나타내는 오류는?\",\"choices\":[\"비음화되어 산출됨\",\"치음화되어 산출됨\",\"설측화되어 산출됨\",\"무성음화되어 산출됨\",\"기식화되어 산출됨\"],\"answer\":2,\"explain\":\"자음 아래의 [ ̪ ](다리 모양) 기호는 혀끝이 앞니에 닿거나 앞쪽으로 나와 산출되는 치음화를 뜻한다. ①비음화는 [ ̃ ], ③설측화는 [ɬ] 등, ④무성음화는 [ ̥ ], ⑤기식화는 [ʰ]로 표시한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"정밀전사 구별기호\",\"p\":\"구별기호 [ ̪ ]가 나타내는 조음 오류 판단\",\"n\":\"[ ̪ ] 치음화, [ ̃ ] 비음화, [ ̥ ] 무성음화, [ʰ] 기식, [ɬ] 설측 마찰\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 아동의 /ㅅ/ 문맥검사 결과는 [그림 1]과 같다.\",\"q\":\"[그림 1]을 근거로 /ㅅ/ 훈련 초기에 사용할 낱말로 가장 적절한 것은?\",\"choices\":[\"수건\",\"소금\",\"사탕\",\"시계\",\"선물\"],\"answer\":4,\"explain\":\"[그림 1]에서 /ㅅ/는 뒤따르는 모음이 /ㅣ/일 때 어두(시장)·어중(도시) 모두 정조음되었고, /ㅜ/는 어중(가수)에서만 정조음되었으며 나머지 모음 문맥은 모두 [ㄷ]으로 대치되었다. 따라서 /ㅣ/가 촉진 문맥이므로 어두 '시'로 시작하는 '시계'가 훈련 초기 낱말로 적절하다. ①수건은 어두 /ㅜ/ 문맥(수박 ×)이고 ②·③·⑤는 오조음 문맥이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"문맥검사로 촉진 문맥 선정\",\"p\":\"문맥검사 정오 결과에서 촉진 문맥을 찾아 훈련 낱말 선정\",\"n\":\"문맥검사: 정조음이 나타나는 모음·위치(촉진 문맥)를 찾아 훈련 초기 자극어로 활용\"},\"image\":\"data:image/svg+xml;base64,\"},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 아동의 산출\\n• 자두 /tɕadu/ → [다두] [tadu]\\n• 바지 /padʑi/ → [바디] [padi]\\n• 조개 /tɕoɡɛ/ → [도개] [toɡɛ]\",\"q\":\"최소대립쌍 접근법을 적용할 때 가장 적절한 낱말 쌍은?\",\"choices\":[\"잠 – 참\",\"잠 – 짐\",\"잠 – 감\",\"달 – 딸\",\"잠 – 담\"],\"answer\":5,\"explain\":\"아동은 /ㅈ/를 [ㄷ]으로 대치하므로, 오류를 보이는 두 음소 /ㅈ/–/ㄷ/만 다른 '잠 – 담'으로 의미 차이를 깨닫게 하는 것이 최소대립쌍 접근법이다. ①은 /ㅈ/–/ㅊ/, ③은 /ㅈ/–/ㄱ/로 아동의 오류와 무관한 대립이고, ②는 모음 대립, ④는 /ㄷ/–/ㄸ/ 대립이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"최소대립쌍 선정\",\"p\":\"아동의 대치 오류(ㅈ→ㄷ)에 맞는 최소대립쌍 선정\",\"n\":\"최소대립쌍 접근: 목표음과 아동의 대치음만 다른 낱말 쌍으로 의미 대조\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"복잡성 접근법(complexity approach)에 따른 목표음 선정으로 옳은 것은?\",\"choices\":[\"자극반응도가 높고 일찍 습득되는 음소를 선정한다\",\"자극반응도가 낮고 늦게 습득되는 음소를 선정한다\",\"아동이 이미 정조음하는 음소를 목표로 선정한다\",\"오류 빈도가 가장 낮은 음소부터 차례로 선정한다\",\"청지각 변별이 이미 가능한 음소만 목표로 선정한다\"],\"answer\":2,\"explain\":\"복잡성 접근법(Gierut)은 자극반응도가 낮고 늦게 습득되는 복잡한 음소를 훈련하면 훈련하지 않은 음소까지 더 넓게 일반화된다고 본다. ①은 전통적 목표 선정 기준이며, 이미 정조음하는 음소(③)나 오류 빈도가 낮은 음소(④)는 목표가 되지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"복잡성 접근법 목표 선정\",\"p\":\"복잡성 접근법의 목표음 선정 기준 판단\",\"n\":\"복잡성 접근: 비자극반응·후기 습득 음소를 목표로 하여 체계 전반의 일반화 유도\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"/ㅅ/를 산출하지 못하는 아동에게 다음 순서로 지도함\\n• 아동이 이미 정조음하는 /ㄷ/를 반복해 산출하게 함\\n• 혀끝을 윗잇몸에서 살짝 떼면서 바람을 길게 내보내게 함\\n• [s]에 점점 가까워지는 소리를 단계적으로 강화함\",\"q\":\"이 치료사가 사용한 소리 유도 기법은?\",\"choices\":[\"청각적 폭격\",\"조음점 지시법\",\"점진적 접근법\",\"짝자극 기법\",\"최소대립 훈련\"],\"answer\":3,\"explain\":\"아동이 이미 산출하는 소리(/ㄷ/)에서 출발해 목표음에 점점 가까운 소리를 단계적으로 강화하는 방법은 점진적 접근법(조성법, 소리 수정법)이다. ②조음점 지시법은 처음부터 혀·입술의 위치를 직접 지시해 목표음을 만드는 방법이고, ①청각적 폭격은 목표음을 반복해 들려주는 청각 자극 활동이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"점진적 접근법(조성법)\",\"p\":\"기존 소리에서 목표음으로 단계적 강화하는 유도 기법 식별\",\"n\":\"점진적 접근법: 아동이 가진 소리를 출발점으로 목표음에 가까운 반응을 차례로 강화\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"종성 생략을 보이는 아동에게 종성 /ㅂ/만 훈련함\\n• 치료 후 훈련하지 않은 종성 /ㄷ/, /ㄱ/의 산출도 함께 향상됨\",\"q\":\"이에 해당하는 일반화 유형은?\",\"choices\":[\"위치 일반화\",\"문맥 일반화\",\"상황 일반화\",\"언어단위 일반화\",\"자질 일반화\"],\"answer\":5,\"explain\":\"종성 /ㅂ/ 훈련 효과가 같은 종성 위치의 다른 파열음 /ㄷ/·/ㄱ/로 퍼진 것은 공통 자질을 가진 다른 음소로 확대된 자질(음소 간) 일반화이다. ①위치 일반화는 같은 음소가 다른 낱말 위치로, ②문맥 일반화는 다른 음성 문맥으로, ③상황 일반화는 치료실 밖 장소·대화 상대로 확대되는 것이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"자질 일반화\",\"p\":\"훈련하지 않은 음소로 확대된 치료 효과의 일반화 유형 판별\",\"n\":\"자질(음소 간) 일반화: 훈련 음소와 자질을 공유하는 다른 음소로 효과가 확대\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"치료사: \\\"선생님이 말하는 소리를 합쳐서 말해 보세요. /ㅂ/ … /ㅏ/ … /ㅁ/\\\"\\n아동: \\\"밤\\\"\",\"q\":\"이 과제의 유형은?\",\"choices\":[\"음소 합성\",\"음절 합성\",\"음소 분리\",\"음절체-말미 합성\",\"음소 대치\"],\"answer\":1,\"explain\":\"낱개 음소 /ㅂ/·/ㅏ/·/ㅁ/을 듣고 하나의 음절 [밤]으로 합치는 과제이므로 음소 합성이다. ②음절 합성은 '고'+'래'처럼 음절 단위를, ④음절체-말미 합성은 '바'+/ㅁ/처럼 합치는 과제이고, ③음소 분리는 반대로 낱말을 음소로 나누는 과제이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음운인식\",\"k\":\"음소 합성 과제\",\"p\":\"과제 지시와 반응을 보고 음운인식 과제 유형 판별\",\"n\":\"음소 합성: 낱개 음소를 듣고 음절·낱말로 합침, 음절체-말미는 CV+C 단위\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"음운인식 중재에 관한 설명으로 가장 적절한 것은?\",\"choices\":[\"글자를 함께 쓰면 소리 인식에 방해가 되므로 피한다\",\"음소 수준 과제부터 시작해 음절 수준으로 확장한다\",\"자소와 연결한 음운인식 훈련은 해독 향상에 효과적이다\",\"말소리장애 아동은 음운인식 문제를 거의 동반하지 않는다\",\"음운인식은 학령기 이후에야 지도할 수 있다\"],\"answer\":3,\"explain\":\"음운인식 훈련은 글자(자소)와 연결해 지도할 때 해독·철자 향상 효과가 더 크다(따라서 ①은 틀림). 음운인식은 음절 → 음소 수준 순으로 지도하며(②), 말소리장애 아동은 음운인식 어려움을 동반하기 쉽고(④), 학령전기부터 지도할 수 있다(⑤).\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음운인식\",\"k\":\"자소 연계 음운인식 중재\",\"p\":\"음운인식 중재의 단위 순서·대상·문자 연계 효과 판단\",\"n\":\"음운인식 중재: 음절 → 음소 순, 자소와 연계할 때 해독 효과 큼\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"한국어 사용 아동의 음운인식 발달 특성으로 옳은 것은?\",\"choices\":[\"음절보다 음소 단위를 먼저 인식한다\",\"초성+각운보다 음절체+말미로 더 쉽게 나눈다\",\"음소 탈락이 음절 탈락보다 먼저 가능해진다\",\"음절 수 세기가 음소 수 세기보다 더 어렵다\",\"음운인식 능력은 읽기 발달과 관련이 적다\"],\"answer\":2,\"explain\":\"한국어 아동은 '밤'을 'ㅂ+암'(초성+각운)보다 '바+ㅁ'(음절체+말미)로 더 쉽게 나누는 경향이 보고되었다. 음운인식은 음절 → 음절체·말미 → 음소 순으로 발달하므로 ①·③은 틀리고, ④ 음절 수 세기는 음소 수 세기보다 쉬우며, ⑤ 음운인식은 읽기 발달과 밀접하다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음운인식\",\"k\":\"음절체-말미 단위\",\"p\":\"한국어 아동의 음절 내 단위 분절 경향과 발달 순서 판단\",\"n\":\"한국어 아동은 음절을 음절체(CV)+말미(C)로 더 쉽게 분절, 음절 → 음소 순 발달\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"구개열 수술을 받은 6세 아동\\n• /ㅅ/ 산출 시 혀끝을 쓰지 않음\\n• 혀뿌리를 인두 뒷벽 쪽으로 당겨 좁힌 틈에서 마찰 소음을 냄\",\"q\":\"이 아동이 보이는 보상조음은?\",\"choices\":[\"성문파열음\",\"인두파열음\",\"중설구개파열음\",\"인두마찰음\",\"비강마찰음\"],\"answer\":4,\"explain\":\"혀뿌리를 인두후벽 쪽으로 당겨 좁힌 틈에서 마찰 소음을 내는 것은 인두마찰음으로, 주로 /ㅅ/ 같은 마찰음 대신 나타나는 보상조음이다. ①성문파열음은 성대에서, ②인두파열음은 혀뿌리와 인두벽의 폐쇄로 파열을 만들고, ③중설구개파열음은 혀 가운데를 구개에 붙여 산출하며, ⑤비강마찰음은 기류를 코로 내보내 마찰을 만든다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"인두마찰음 식별\",\"p\":\"조음 기술(혀뿌리-인두벽 마찰)로 보상조음 유형 판별\",\"n\":\"인두마찰음: 혀뿌리를 인두후벽에 접근시켜 마찰, 마찰음의 보상조음\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"구개열 수술 후 과다비성이 의심되어 나조미터로 비음치(nasalance)를 측정하려 함\",\"q\":\"과다비성 평가 자극으로 가장 적절한 문장은?\",\"choices\":[\"아빠 바지 사줘\",\"엄마 나무 많아\",\"냉면 먹고 싶어\",\"고양이 노래해\",\"미나리 무침 줘\"],\"answer\":1,\"explain\":\"과다비성은 비음이 없는 구강음 문장에서 비강 공명이 늘어나는지로 판단하므로, 비음(ㅁ·ㄴ·종성 ㅇ)이 전혀 없는 ① '아빠 바지 사줘'가 적절하다. ②~⑤는 비음이 많이 포함되어 과다비성 판단이 어렵고 오히려 과소비성 평가에 쓰인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"과다비성 평가 자극\",\"p\":\"비음 포함 여부로 과다비성 평가 문장 선정\",\"n\":\"과다비성 평가: 비음 없는 구강음 문장, 과소비성 평가: 비음 많은 문장\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"구개열 수술 후 5세 아동\\n• 연인두 기능 검사에서 폐쇄 부전이 확인되어 2차 수술이 예정됨\\n• /ㄱ, ㄷ/를 성대를 세게 닫았다 터뜨리는 소리로 대치함\\n• 구강음 문장에서 과다비성이 뚜렷함\",\"q\":\"이 아동의 중재에 대한 설명으로 가장 적절한 것은?\",\"choices\":[\"보상조음은 수술로 구조가 교정되면 저절로 사라진다\",\"과다비성은 조음치료만으로 대부분 해결할 수 있다\",\"연인두 폐쇄 부전이 있으면 조음치료는 효과가 전혀 없다\",\"불기 운동으로 연인두를 강화하는 것을 우선한다\",\"성문파열음은 수술 뒤에도 남기 쉬워 조음치료가 필요하다\"],\"answer\":5,\"explain\":\"성문파열음 같은 보상조음은 연인두 폐쇄 부전 때문에 생겼더라도 잘못 학습된 조음 위치이므로 수술로 구조가 교정된 뒤에도 남는 경우가 많아 조음치료로 구강 조음 위치를 지도해야 한다(①은 틀림). 반면 연인두 폐쇄 부전으로 인한 과다비성은 구조 문제라 수술·보철로 다루며 조음치료만으로는 해결되지 않는다(②). 보상조음 교정은 수술 전에도 시작할 수 있으므로 ③은 틀리고, ④불기 같은 비구어 운동은 말 산출 시 연인두 폐쇄를 개선한다는 근거가 약하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"구개열 보상조음 중재 원칙\",\"p\":\"연인두 폐쇄 부전과 보상조음이 함께 있는 구개열 아동의 중재 방향 판단\",\"n\":\"보상조음은 학습된 오류라 수술 후에도 남아 조음치료 필요, 과다비성(VPI)은 수술·보철 대상\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"구개열 아동에게 삼출성 중이염과 전음성 난청이 흔한 주된 이유는?\",\"choices\":[\"구개범장근 기능 이상으로 이관이 잘 열리지 않는다\",\"와우 유모세포가 선천적으로 손상되어 있다\",\"비누출된 공기가 고막을 직접 손상시킨다\",\"등골근 반사가 지나치게 강하게 일어난다\",\"청신경의 수초화가 늦게 이루어진다\"],\"answer\":1,\"explain\":\"구개열 아동은 이관을 여는 구개범장근의 부착·기능 이상으로 중이 환기가 잘 되지 않아 삼출성 중이염과 전음성 난청이 잦다. ②·⑤는 감각신경성·신경성 난청의 원인이고, ③ 비누출된 공기가 고막을 손상하지는 않으며, ④ 등골근 반사는 중이염의 원인이 아니다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"구개열과 중이염\",\"p\":\"구개열 아동에게 중이염·전음성 난청이 흔한 기전 판단\",\"n\":\"구개범장근 기능 이상 → 이관 개방 장애 → 삼출성 중이염·전음성 난청\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"아동기 말실행증보다 발달성 마비말장애를 더 시사하는 소견은?\",\"choices\":[\"같은 낱말을 반복할 때 오류 형태가 자주 달라진다\",\"낱말이 길어질수록 오류가 두드러지게 늘어난다\",\"말과 비구어 과제 모두에서 근력·근긴장 이상이 보인다\",\"조음 위치를 찾으려는 모색 행동이 자주 관찰된다\",\"자동적 발화보다 의도적 발화에서 오류가 많다\"],\"answer\":3,\"explain\":\"마비말장애는 신경근 손상으로 말과 비구어 운동 모두에서 근력 약화·근긴장 이상이 나타나고 오류가 비교적 일관적이다. ①비일관적 오류, ②낱말 길이 효과, ④모색 행동, ⑤의도적 발화에서의 오류 증가는 운동 계획·프로그래밍 문제인 아동기 말실행증을 시사한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동 말소리장애\",\"k\":\"발달성 마비말장애 감별\",\"p\":\"아동기 말실행증과 구별되는 마비말장애 소견 판단\",\"n\":\"마비말장애: 근력·근긴장 이상, 일관적 오류, 아동기 말실행증: 비일관성·길이 효과·모색\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"아동기 말실행증 아동의 치료 절차\\n• 치료사와 동시에 말하기 → 즉시 모방 → 지연 모방 → 자발 산출 순으로 진행함\\n• 아동의 수행에 따라 말 속도를 늦추거나 촉각 단서를 더해 단서 수준을 조절함\",\"q\":\"해당하는 치료 접근법은?\",\"choices\":[\"최소대립 접근법\",\"핵심어휘 접근법\",\"주기 접근법\",\"상위음운 접근법\",\"DTTC 접근법\"],\"answer\":5,\"explain\":\"동시 산출 → 즉시 모방 → 지연 모방 → 자발 산출로 단서를 줄여 가며 말 속도와 촉각 단서를 조절하는 방법은 통합적 자극법에 기반한 DTTC(역동적 시간·촉각 단서)로, 아동기 말실행증의 운동 계획 훈련에 쓰인다. ①최소대립, ③주기 접근법, ④상위음운 접근법은 음운장애를, ②핵심어휘 접근법은 비일관적 음운장애를 위한 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동 말소리장애\",\"k\":\"DTTC 식별\",\"p\":\"단서 위계 조절 절차로 아동기 말실행증 치료법 식별\",\"n\":\"DTTC: 동시 산출 → 모방 → 자발 산출로 단서를 줄이며 시간·촉각 단서를 역동적으로 조절\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"운동학습 원리를 적용한 아동기 말실행증 치료에 관한 설명으로 옳은 것은?\",\"choices\":[\"결과 피드백은 매 시도마다 줄 때 장기 유지에 유리하다\",\"분산 연습보다 집중 연습이 장기 유지에 유리하다\",\"회기당 적은 반복이 많은 반복보다 효과적이다\",\"무선 연습은 습득이 더디지만 유지와 전이에 유리하다\",\"처음부터 대화 수준으로만 연습해야 효과적이다\"],\"answer\":4,\"explain\":\"운동학습 원리에서 무선(무작위) 연습은 습득 단계의 수행은 느리지만 유지·전이에 유리하다. 결과 피드백은 빈도를 줄여 갈 때 장기 유지에 유리하고(①), 분산 연습이 유지에 더 효과적이며(②), 많은 반복 시도가 필요하고(③), 초기에는 음절·낱말 같은 단순한 단위에서 시작한다(⑤).\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동 말소리장애\",\"k\":\"운동학습 원리\",\"p\":\"연습 계획·피드백 원리를 말실행증 치료에 적용\",\"n\":\"운동학습: 무선·분산 연습, 많은 반복, 피드백 빈도 감소가 유지·전이에 유리\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"8세 아동의 순음청력검사 결과는 [그림 1]과 같다.\",\"q\":\"[그림 1]의 해석으로 옳은 것은?\",\"choices\":[\"우측 귀는 감각신경성 중등도 난청이다\",\"우측 귀는 혼합성 경도 난청이다\",\"좌측 귀는 전음성 중등도 난청이다\",\"좌측 귀는 감각신경성 경도 난청이다\",\"좌측 귀는 혼합성 경도 난청이다\"],\"answer\":4,\"explain\":\"우측 기도(○) 역치는 500·1000·2000Hz에서 모두 45dB HL이고 차폐 골도([)는 5~10dB HL로 기도-골도 차가 35~40dB이므로 우측은 전음성 중등도 난청이다(①·② 틀림). 좌측 기도(×) 역치는 25·30·35dB HL(3분법 평균 30dB HL)이고 차폐 골도(])와의 차가 10dB 이내이므로 감각신경성 경도 난청이다. 3분법·4분법·6분법 어느 평균으로도 우측 약 45dB HL(중등도), 좌측 약 30~33dB HL(경도)로 판정이 같다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"청각·청각장애\",\"k\":\"청력도 유형·정도 판정\",\"p\":\"차폐 골도와 기도 역치로 귀별 난청 유형·정도 판정\",\"n\":\"기도-골도 차 ≤10dB이면 감각신경성, 골도 정상·차 큼이면 전음성, 평균역치로 정도 판정\"},\"image\":\"data:image/svg+xml;base64,\"},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"어음청력검사에 관한 설명으로 옳은 것은?\",\"choices\":[\"어음청취역치는 단음절어를 100% 맞히는 최소 강도이다\",\"단어인지도는 어음청취역치와 같은 강도에서 측정한다\",\"어음청취역치는 이음절어를 50% 따라 말하는 최소 강도이다\",\"어음청취역치는 순음평균역치와 관련이 거의 없다\",\"피검자의 반응이 필요 없는 객관적 청력검사이다\"],\"answer\":3,\"explain\":\"어음청취역치(SRT)는 이음절어(강강격 낱말)를 50% 바르게 따라 말하는 최소 강도이다(①은 틀림). 단어인지도(WRS)는 역치보다 충분히 높은 쾌적 강도에서 단음절어로 측정하며(②), SRT는 순음평균역치와 대개 ±10dB 안에서 일치하고(④), 어음청력검사는 피검자의 반응이 필요한 주관적 검사이다(⑤).\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"청각·청각장애\",\"k\":\"어음청력검사\",\"p\":\"어음청취역치·단어인지도의 정의와 측정 조건 판단\",\"n\":\"SRT: 이음절어 50% 정반응 최소 강도, 순음평균과 ±10dB 내 일치, WRS는 역치상 강도\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 아동\\n• 삼출성 중이염 진단을 받음\\n• 외이도 용적은 정상 범위임\",\"q\":\"이 아동에게서 예상되는 고막운동도(tympanogram) 유형은?\",\"choices\":[\"A형\",\"As형\",\"Ad형\",\"C형\",\"B형\"],\"answer\":5,\"explain\":\"삼출성 중이염으로 중이강에 액체가 차면 고막 운동성이 거의 없어 정점이 없는 평탄한 B형이 나타난다(외이도 용적 정상). ①A형은 정상, ②As형은 이소골 고착, ③Ad형은 이소골 단절, ④C형은 이관 기능 이상으로 중이 음압이 낮을 때 나타난다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"청각·청각장애\",\"k\":\"고막운동도 유형\",\"p\":\"삼출성 중이염 사례에서 예상되는 고막운동도 유형 판단\",\"n\":\"고막운동도: A 정상, As 고착, Ad 단절, B 평탄(삼출액·천공), C 음압\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"이음향방사(OAE) 검사에 관한 설명으로 옳은 것은?\",\"choices\":[\"와우 외유모세포의 기능을 반영한다\",\"청신경과 뇌간의 신경 반응을 측정한다\",\"중이에 삼출액이 있어도 결과에 영향이 없다\",\"피검자가 소리를 듣고 버튼을 눌러야 한다\",\"청신경병증을 찾아내는 데 가장 적합하다\"],\"answer\":1,\"explain\":\"이음향방사는 와우 외유모세포가 만들어 외이도로 되돌아오는 소리를 측정하는 객관적 검사이다. ②는 청성뇌간반응(ABR)의 설명이며, 중이 삼출액이 있으면 반응이 잘 나오지 않고(③), 피검자의 행동 반응이 필요 없으며(④), 청신경병증은 OAE가 정상일 수 있어 ABR을 함께 해야 한다(⑤).\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"청각·청각장애\",\"k\":\"이음향방사 검사\",\"p\":\"OAE가 반영하는 청각 기관과 검사 특성 판단\",\"n\":\"OAE: 외유모세포 기능 반영, 객관적 검사, 중이 상태 영향, 청신경병증은 ABR 필요\"}},{\"grade\":2,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"\",\"q\":\"인공와우에 관한 설명으로 옳지 않은 것은?\",\"choices\":[\"손상된 유모세포를 대신해 청신경을 전기 자극한다\",\"청신경이 형성되지 않은 경우에도 효과가 크다\",\"보청기 효과가 적은 고도·심도 난청이 주 대상이다\",\"이식 후에도 체계적인 청능훈련이 필요하다\",\"언어습득 전 아동은 조기 이식이 말 발달에 유리하다\"],\"answer\":2,\"explain\":\"인공와우는 와우에 넣은 전극으로 청신경을 직접 전기 자극하므로, 청신경이 형성되지 않았거나 기능하지 않으면 효과를 기대하기 어렵다(이때는 청성뇌간이식 등을 고려). ①·③·④·⑤는 옳은 설명이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"청각·청각장애\",\"k\":\"인공와우 원리·대상\",\"p\":\"인공와우의 작동 원리와 적용 대상 판단\",\"n\":\"인공와우: 청신경 직접 전기 자극, 고도·심도 감각신경성 난청 대상, 청신경 결손 시 효과 제한\"}}];\n</script>\n<script>\nwindow.DETAILS = {\"2-1-1-1\":{\"p\":\"소뇌는 운동의 범위·방향·속도·타이밍을 조율하는 협응 중추이다. 지문의 근긴장 저하(hypotonia), 넓은 기저의 불안정한 보행(실조, ataxia), 손가락-코 검사에서 목표를 지나치는 측정이상(dysmetria)과 목표에 가까워질수록 커지는 흔들림(의도성 떨림, intention tremor)은 모두 소뇌 징후이다. 특히 '안정 시 떨림 없음'은 기저핵 질환(파킨슨병)의 안정 시 떨림과 감별하는 단서이다. 말 영역에서는 같은 소뇌 손상이 실조형 마비말장애(불규칙한 조음 붕괴, 과도·균등 강세)로 나타난다.\",\"w\":{\"1\":\"시상은 감각 정보의 중계와 피질-피질하 회로 조절을 담당하며, 손상 시 감각 이상·통증이나 시상 실어증이 나타날 수 있다. 측정이상·실조의 대표 부위는 아니다.\",\"3\":\"해마는 새로운 서술기억(일화기억) 형성에 관여하며, 손상 시 기억장애가 두드러진다. 운동 협응 장애와는 관련이 적다.\",\"4\":\"기저핵 손상은 안정 시 떨림, 경직(근긴장 항진), 운동완만(파킨슨증)이나 무도증 같은 불수의 운동을 보인다. 지문은 근긴장 저하와 안정 시 떨림 없음을 제시하므로 맞지 않는다.\",\"5\":\"측두엽은 청각 처리, 언어 이해(베르니케 영역), 기억에 관여한다. 측정이상·보행 실조 같은 협응 장애를 설명하지 못한다.\"}},\"2-1-1-2\":{\"p\":\"설하신경(12번 뇌신경)은 혀의 내재근·외재근(턱끝혀근 등)을 지배하는 운동신경이다. 혀를 내밀 때는 양쪽 턱끝혀근이 혀를 앞으로 밀어내는데, 한쪽이 약하면 건강한 쪽이 혀를 약한 쪽으로 밀어 손상된 쪽으로 치우친다. 여기에 같은 쪽 혀의 위축(필요하면 섬유속연축)까지 있으면 하부운동신경원(LMN) 손상이므로 '왼쪽 편위+왼쪽 위축' → 왼쪽 설하신경 손상이다. 상부운동신경원(피질연수로) 편측 손상은 위축 없이 대개 반대쪽으로 편위된다는 점과 구별한다.\",\"w\":{\"1\":\"안면신경(7번)은 입술·볼 등 얼굴 표정근을 지배한다. 손상 시 입꼬리 처짐, 입술 오므리기 어려움이 나타나며 혀 편위·위축과는 무관하다.\",\"2\":\"설하신경 하부운동신경원 손상에서 혀는 손상된 쪽으로 치우치고 그쪽이 위축된다. 왼쪽 편위·왼쪽 위축이므로 오른쪽 손상이 아니다.\",\"4\":\"삼차신경(5번)은 저작근의 운동과 얼굴 감각을 담당한다. 손상 시 턱 벌림 편위나 씹기 약화가 나타나며 혀 운동과는 관계가 없다.\",\"5\":\"미주신경(10번)은 연구개·인두·후두를 지배한다. 손상 시 연구개 비대칭 거상, 기식음성, 과비성 등이 나타나며 혀 편위·위축을 설명하지 못한다.\"}},\"2-1-1-3\":{\"p\":\"PK-WAB-R(Paradise Korean version-Western Aphasia Battery-Revised)은 Kertesz의 WAB를 한국어로 표준화한 실어증 진단검사이다. 스스로 말하기(내용전달·유창성), 알아듣기, 따라말하기, 이름대기 네 구어 하위검사 점수로 실어증지수(AQ)를 산출해 중증도를 나타내고, 하위검사 점수 조합(유창성·이해·따라말하기)으로 실어증 유형을 분류한다. 지문의 '유형 확인'과 'AQ 산출'이 결정적 단서이다. 선별검사는 실어증 유무만 빠르게 가린다는 점에서 진단검사와 목적이 다르다.\",\"w\":{\"1\":\"K-MMSE는 지남력·기억·주의·언어 등을 짧게 보는 인지 선별검사이다. 실어증 유형 분류나 AQ 산출을 하지 않는다.\",\"2\":\"K-MoCA는 경도인지장애 선별에 쓰이는 인지 선별검사로, 집행기능·시공간 항목이 포함된다. 실어증지수를 산출하지 않는다.\",\"3\":\"STAND는 실어증과 신경언어장애 여부를 짧게 가려내는 선별검사이다. 선별 후 유형·중증도 진단은 PK-WAB-R 같은 진단검사로 이어진다.\",\"5\":\"KTDDA는 실어증 감별을 위한 국내 검사이지만, 지문의 AQ(실어증지수) 산출과 네 하위영역 구성은 WAB 계열 검사의 특징이다.\"}},\"2-1-1-4\":{\"p\":\"에두르기(circumlocution)는 목표 낱말을 떠올리지 못해 그 대상의 기능('먹는 거')·속성('빨갛고 둥근')을 돌려서 설명하는 이름대기 반응이다. 환자는 대상의 의미는 알고 있으나 어휘(음운 형태) 인출에 실패하고 있다는 점을 보여 주며, 명칭실어증 등 여러 실어증에서 흔하다. 착어는 다른 낱말이나 소리로 '대치'된 산출이 나와야 하므로, 대치 없이 설명만 하는 이 반응과 구별한다.\",\"w\":{\"1\":\"보속증(perseveration)은 이전 자극에서 했던 반응을 다음 자극에도 되풀이하는 것이다. 지문은 이전 반응의 반복이 아니다.\",\"2\":\"음소착어는 목표 낱말의 일부 음소를 대치·첨가·생략하는 오류이다('사과'→'다과'). 지문에는 음소 대치가 없다.\",\"4\":\"신조착어(신조어)는 목표 낱말과 관련을 알 수 없는 새로운 비단어를 산출하는 것으로, 베르니케실어증에서 흔하다. 지문은 실제 낱말로 특징을 설명하고 있다.\",\"5\":\"의미착어는 목표와 의미적으로 관련된 다른 낱말로 대치하는 것이다('사과'→'배'). 지문은 다른 낱말을 대신 말하지 않고 특징을 설명한다.\"}},\"2-1-1-5\":{\"p\":\"이중경로 읽기 모형에서 심층실독증(deep dyslexia)은 자소-음소 변환(비어휘·음운) 경로가 심하게 손상되고 의미 경로도 불완전해, 남은 의미 체계에 기대어 읽는 상태이다. 그래서 의미 오류('버스'→'기차')가 나타나고, 의미가 없는 비단어는 거의 읽지 못하며, 심상성(imageability)이 높은 구체어를 추상어보다 잘 읽는다. 세 단서 중 '의미 오류'가 음운실독증과 가르는 핵심이다. 음운실독증도 비단어 읽기가 나쁘지만 의미 오류는 보이지 않는다.\",\"w\":{\"1\":\"표층실독증은 어휘(전체 단어) 경로 손상으로 음운 규칙에 의존해 읽어 불규칙어를 규칙화하는 오류가 특징이다. 비단어 읽기는 비교적 보존된다.\",\"2\":\"음운실독증은 실제 낱말은 잘 읽고 비단어 읽기가 선택적으로 손상된다. 의미적 대치 오류가 핵심이라는 점에서 지문과 맞지 않는다.\",\"3\":\"무시실독증은 편측 무시로 단어의 한쪽(대개 왼쪽) 부분을 빠뜨리거나 바꿔 읽는 것이다. 의미 대치나 구체성 효과로 설명되지 않는다.\",\"4\":\"순수실독증(실서증 없는 실독증)은 쓰기는 보존되나 읽기가 손상되어 글자를 하나씩 읽는 낱자 읽기(letter-by-letter reading)가 특징이다. 의미 오류가 핵심이 아니다.\"}},\"2-1-1-6\":{\"p\":\"베르니케실어증은 좌측 상측두회 뒤쪽(베르니케 영역) 손상과 관련된 유창성 실어증이다. 발화 속도·운율은 비교적 유지되지만 의미착어·음소착어·신조어가 섞여 내용 전달이 떨어지고, 청각적 이해와 따라말하기가 모두 손상되며, 자신의 오류를 잘 깨닫지 못한다(병식 부족). 유창성 실어증끼리는 '이해'와 '따라말하기' 두 축으로 감별한다: 이해 손상+따라말하기 손상=베르니케, 이해 손상+따라말하기 보존=연결피질감각, 이해 양호+따라말하기 손상=전도, 둘 다 양호=명칭.\",\"w\":{\"1\":\"브로카실어증은 비유창·노력성·전보식 발화가 특징이며 이해는 비교적 양호하다. 지문의 유창한 발화, 심한 이해 손상과 맞지 않는다.\",\"2\":\"연결피질감각실어증도 유창하고 이해가 손상되지만 따라말하기가 보존된다(반향어 경향). 지문은 따라말하기가 손상되어 있다.\",\"3\":\"전도실어증은 유창하고 음소착어가 많지만 청각적 이해가 비교적 양호하고 병식이 있어 자기수정(접근행동)을 시도한다. 심한 이해 손상과 맞지 않는다.\",\"5\":\"명칭실어증은 유창하고 이해·따라말하기가 양호하며 이름대기 어려움이 주된 증상이다. 이해·따라말하기 손상이 있는 지문과 맞지 않는다.\"}},\"2-1-1-7\":{\"p\":\"브로카실어증은 좌측 하전두회 뒤쪽(브로카 영역)과 주변 영역 손상과 관련된 비유창성 실어증이다. 발화가 느리고 노력성이며, 조사·어미 같은 문법형태소를 빼고 내용어 위주로 말하는 전보식 발화(실문법증, agrammatism)가 대표적이다. 따라말하기도 손상되지만 일상적 단순 지시 이해는 비교적 양호하다(복잡한 통사 이해는 어려울 수 있음). 비유창 실어증끼리는 이해·따라말하기로 감별한다: 이해 양호+따라말하기 손상=브로카, 따라말하기 보존=연결피질운동, 이해까지 심한 손상=전반실어증.\",\"w\":{\"1\":\"명칭실어증은 유창한 발화에 이름대기 어려움이 주 증상이며 따라말하기·이해가 양호하다. 비유창·전보식 발화와 맞지 않는다.\",\"2\":\"베르니케실어증은 유창하지만 착어가 많고 청각적 이해가 심하게 손상된다. 비유창·전보식 발화, 양호한 이해와 맞지 않는다.\",\"3\":\"전도실어증은 유창한 발화에 음소착어가 많고 따라말하기가 선택적으로 손상된다. 비유창한 전보식 발화가 핵심인 지문과 다르다.\",\"4\":\"전반실어증은 발화·이해·따라말하기·이름대기가 모두 심하게 손상된다. 단순 지시 이해가 비교적 양호하다는 점에서 맞지 않는다.\"}},\"2-1-1-8\":{\"p\":\"전도실어증(conduction aphasia)은 유창한 발화, 비교적 양호한 청각적 이해에 비해 따라말하기가 두드러지게 손상되는 유형이다. 고전적으로 베르니케 영역과 브로카 영역을 잇는 궁상다발(arcuate fasciculus) 또는 연상회 주변 손상으로 설명하며, 들은 말을 산출 체계로 옮기는 연결이 끊긴 것으로 본다. 음소착어가 잦고 병식이 있어 목표에 가까워지려 반복 수정하는 접근행동(conduite d'approche)을 보이는 것도 단서이다. 최근에는 피질 손상의 역할도 함께 거론되므로 '관련 구조'로 이해하면 된다.\",\"w\":{\"1\":\"베르니케실어증은 상측두회 뒤쪽 손상과 관련되며 유창하지만 청각적 이해가 심하게 손상된다. 지문의 이해 양호와 맞지 않는다.\",\"3\":\"브로카실어증은 하전두회 손상과 관련되며 비유창·전보식 발화가 특징이다. 지문의 유창한 발화와 맞지 않는다.\",\"4\":\"명칭실어증은 각회 등 다양한 부위와 관련될 수 있으며 따라말하기가 보존된다. 따라말하기의 선택적 손상과 맞지 않는다.\",\"5\":\"전반실어증은 광범위한 좌반구 손상과 관련되며 이해·발화를 포함한 모든 영역이 심하게 손상된다. 유창한 발화, 양호한 이해와 맞지 않는다.\"}},\"2-1-1-9\":{\"p\":\"뇌졸중은 혈관이 막히는 허혈성과 혈관이 터지는 출혈성으로 나뉜다. 허혈성 중 혈전증(thrombosis)은 동맥경화 등으로 그 자리에서 혈전이 자라 혈관이 서서히 좁아지다 막히는 것이고, 색전증(embolism)은 심장(심방세동 등)이나 큰 동맥에서 생긴 혈전 조각(색전)이 혈류를 따라 이동해 먼 곳의 혈관을 갑자기 막는 것이다. 그래서 색전성 뇌졸중은 증상이 갑자기 최대로 나타나는 경향이 있다. 빈도는 허혈성이 출혈성보다 훨씬 높다(일반적으로 약 80~85 % 대 15~20 %로 제시되며 자료마다 차이가 있다).\",\"w\":{\"2\":\"혈관 파열은 출혈성 뇌졸중의 기전이다. 허혈성 뇌졸중은 혈전·색전에 의한 혈관 폐색이 주된 원인이다.\",\"3\":\"혈관벽이 풍선처럼 약하게 부푸는 것은 동맥류(aneurysm)이다. 혈전증은 혈관 안에 혈전이 생겨 혈관이 좁아지고 막히는 것이다.\",\"4\":\"뇌졸중 가운데 허혈성이 대부분을 차지하고 출혈성은 적다. 발생 빈도 관계가 반대로 서술되었다.\",\"5\":\"지주막하출혈은 주로 뇌동맥류 파열로 지주막하 공간에 출혈이 생기는 출혈성 뇌졸중이다. 혈관이 서서히 좁아져 막히는 것은 혈전성 허혈의 설명이다.\"}},\"2-1-1-10\":{\"p\":\"시력·시야가 정상인데 실제 낱말·비단어를 모두 읽지 못하고 받아쓰기·자발 쓰기까지 함께 손상되었으므로 '실서증을 동반한 실독증(alexia with agraphia)'이다. 이는 문자의 시각 형태와 소리·의미를 연결하는 좌측 각회(angular gyrus, 두정엽 아래쪽) 손상과 관련되며, 각회는 중대뇌동맥(MCA) 뒤쪽 가지가 혈액을 공급한다. 판단 단서는 '쓰기도 손상됨'이다. 쓰기가 보존되면 순수실독증(실서증 없는 실독증)으로, 좌측 후두엽·뇌량 팽대부 손상과 후대뇌동맥(PCA)을 떠올린다.\",\"w\":{\"1\":\"전대뇌동맥은 전두엽 안쪽면과 보조운동영역 등을 공급하며, 손상 시 하지 우세 마비·무언증·연결피질운동실어증 등과 관련된다. 각회 손상의 읽기·쓰기 장애와는 거리가 멀다.\",\"2\":\"후대뇌동맥 영역(좌측 후두엽·뇌량 팽대부) 손상은 쓰기가 보존되는 순수실독증과 관련된다. 지문은 쓰기도 손상되어 맞지 않는다.\",\"3\":\"척추기저동맥은 뇌간·소뇌 등을 공급하며 손상 시 마비말장애·삼킴장애·어지럼 등이 나타난다. 읽기·쓰기를 함께 잃는 언어 증상의 대표 원인이 아니다.\",\"4\":\"내경동맥의 안동맥 가지는 눈과 망막을 공급하므로 손상 시 시력 문제가 생긴다. 지문은 시력·시야가 정상이므로 맞지 않는다.\"}},\"2-1-1-11\":{\"p\":\"연결피질운동실어증(transcortical motor aphasia)은 비유창하고 자발 발화 시작이 어렵지만 청각적 이해가 양호하고, 따라말하기가 자발 발화에 비해 뚜렷하게 보존되는 유형이다. 지문은 스스로 말하기 점수가 낮은 비유창(6/20), 알아듣기 양호, 따라말하기 비교적 보존이므로 이 프로파일에 해당한다. 비유창+이해 양호라는 공통점이 있는 브로카실어증과는 따라말하기 보존 여부로 감별한다. 일반적으로 좌측 전두엽 내측(보조운동영역)이나 브로카 영역 앞·위쪽 손상과 관련된다.\",\"w\":{\"2\":\"전도실어증은 유창한 발화에 따라말하기가 선택적으로 손상된다. 지문은 비유창하고 따라말하기가 보존되어 정반대이다.\",\"3\":\"베르니케실어증은 유창하지만 알아듣기와 따라말하기가 모두 손상된다. 비유창·이해 양호 프로파일과 맞지 않는다.\",\"4\":\"명칭실어증은 유창하고 이해·따라말하기가 양호하며 이름대기만 어렵다. 스스로 말하기가 비유창(6/20)이라는 점에서 맞지 않는다.\",\"5\":\"연결피질감각실어증은 따라말하기는 보존되지만 유창한 발화와 이해 손상이 특징이다. 지문은 비유창하고 이해가 양호하다.\"}},\"2-1-1-12\":{\"p\":\"실조형 마비말장애는 소뇌(또는 소뇌 경로) 손상으로 말운동의 타이밍·힘·범위 협응이 깨진 유형이다. 그래서 조음 붕괴가 불규칙하게 나타나고, 모든 음절에 강세를 고르게 주는 과도·균등 강세(excess and equal stress)나 불규칙한 강세·속도로 '술 취한 듯한' 말이 된다. 마비말장애 유형은 손상 부위와 대표 특징을 짝지어 외우는 것이 핵심이다: 이완형(하부운동신경원)-기식음·과비성, 경직형(양측 상부운동신경원)-쥐어짜는 음성, 과소운동형(기저핵·파킨슨)-단음도·감소된 강도·짧은 말 돌진, 과다운동형(기저핵·무도증 등)-불수의 운동에 따른 예측 불가능한 변동.\",\"w\":{\"2\":\"기식음과 가청 흡기음은 성대 내전 약화가 있는 이완형 마비말장애의 특징이다. 경직형은 쥐어짜는 듯한 노력성 음성이 두드러진다.\",\"3\":\"쥐어짜는 듯한 노력성 음성은 근긴장 항진이 있는 경직형 마비말장애의 특징이다. 이완형은 근력 약화로 기식음성·과비성이 나타난다.\",\"4\":\"불수의적 과다 운동으로 인한 변동은 과다운동형 마비말장애의 특징이다. 과소운동형은 운동 범위 감소로 단조로운 음도와 강도 저하를 보인다.\",\"5\":\"감소된 강도와 짧은 말 돌진(short rushes of speech)은 파킨슨병의 과소운동형 마비말장애 특징이다. 과다운동형은 불수의 운동으로 말이 불규칙하게 변동된다.\"}},\"2-1-1-13\":{\"p\":\"말실행증(apraxia of speech, AOS)은 근육 약화·마비 없이 말소리 산출을 위한 운동 계획·프로그래밍이 손상된 운동구어장애이다. 같은 낱말을 여러 번 말해도 오류 양상이 매번 달라지는 비일관성(교재에 따라 비교적 일관된 오류 위치가 보고되기도 함), 올바른 조음 위치를 찾으려는 입술·혀의 모색행동(groping), 근력 약화가 뚜렷하지 않음이 핵심 단서이다. 일반적으로 좌측 브로카 영역·섬엽 주변 손상과 관련되며, 낱말이 길고 복잡해질수록 오류가 늘어난다.\",\"w\":{\"1\":\"이완형 마비말장애는 하부운동신경원 손상으로 근력 약화가 뚜렷하고 기식음·과비성 등 비교적 일관된 문제가 나타난다. 근력 약화가 뚜렷하지 않은 지문과 맞지 않는다.\",\"2\":\"경직형 마비말장애는 근긴장 항진으로 느리고 힘든 말, 쥐어짜는 음성을 보이며 오류가 비교적 일관적이다. 비일관적 오류와 모색행동은 설명되지 않는다.\",\"4\":\"실조형 마비말장애도 불규칙한 조음 붕괴를 보이지만 모색행동은 특징이 아니며, 과도·균등 강세 같은 운율 이상과 협응 문제가 핵심이다.\",\"5\":\"과소운동형 마비말장애는 기저핵 손상으로 단조로운 음도, 감소된 강도, 짧은 말 돌진이 특징이다. 모색행동과 비일관적 조음 오류와는 다르다.\"}},\"2-1-1-14\":{\"p\":\"감별의 핵심은 '운동 실행(계획) 문제인가, 신경근 실행(근력·근긴장·협응) 문제인가'이다. 말실행증은 근육 자체는 비교적 정상이므로 같은 말을 해도 오류가 매번 달라지는 비일관성과 조음 위치를 찾는 모색행동, 시작의 어려움이 나타난다. 반면 마비말장애는 근력 약화·근긴장 이상이 말 산출 전 하위체계(호흡·발성·공명·조음·운율)에 영향을 주어 비교적 일관되고 예측 가능한 오류와 음성·공명 이상이 나타난다. 따라서 보기 중 말실행증에 부합하는 것은 비일관적 오류+모색행동이다.\",\"w\":{\"1\":\"일관되고 예측 가능한 조음 오류는 근육 약화로 같은 소리가 매번 같은 방식으로 왜곡되는 마비말장애의 특징이다.\",\"2\":\"근긴장 항진에 따른 느리고 힘든 말은 경직형 마비말장애의 특징이다. 말실행증은 근긴장 이상이 핵심이 아니다.\",\"3\":\"지속적인 과비성과 비강 누출은 연구개 근력 약화(이완형 마비말장애 등)로 인한 공명 이상이다. 말실행증의 핵심 특징이 아니다.\",\"5\":\"호흡·발성 기능의 지속적 약화는 하위체계 근력 저하를 보이는 마비말장애에서 나타난다. 말실행증은 이런 근력 약화가 뚜렷하지 않다.\"}},\"2-1-1-15\":{\"p\":\"삼킴은 일반적으로 구강 준비-구강(운반)-인두-식도 단계로 나눈다. 인두 단계는 삼킴반사가 촉발되어 연구개 상승, 후두 거상, 후두개 하강, 성대 폐쇄, 인두 수축, 상부식도괄약근 이완이 연속으로 일어나는 단계이다. 지문의 삼킴반사(인두 삼킴) 시작 지연과, 인두 수축·혀 기저부 후방 운동이 약할 때 생기는 후두계곡·조롱박오목 잔여물은 모두 인두 단계 이상을 가리킨다. 다른 단계가 정상으로 제시되었으므로 문제 단계는 인두 단계 하나이다. 잔여물은 삼킨 뒤 흡인 위험이 되므로 인두 단계 평가가 중요하다.\",\"w\":{\"1\":\"구강 준비 단계는 음식물을 씹고 침과 섞어 덩이(bolus)로 만드는 단계로, 지문에서 정상으로 제시되었다.\",\"2\":\"구강 운반 단계는 혀가 덩이를 뒤로 밀어 인두로 보내는 단계로, 지문에서 정상이었다. 삼킴반사 지연과 인두 잔여물은 그다음 단계의 문제이다.\",\"3\":\"삼킴반사 지연과 후두계곡·조롱박오목 잔여물은 비정상 소견이므로 정상 소견으로 볼 수 없다.\",\"4\":\"식도 단계는 연동운동으로 덩이를 위로 보내는 단계로, 지문에서 정상이었다. 후두계곡·조롱박오목은 인두 구조이다.\"}},\"2-1-1-16\":{\"p\":\"흡인(aspiration)은 음식물·액체가 성대(성문) 아래 기도로 들어가는 것이다. 정상이라면 기침·사레 같은 방어 반응이 나타나지만, 인두·후두의 감각이나 기침 반사가 떨어지면 아무 징후 없이 흡인이 일어나는데 이를 무증상 흡인(silent aspiration)이라 한다. 지문은 기침·음성 변화가 없는데도 흉부 영상에서 흡인 소견이 있으므로 이에 해당한다. 침상 선별검사에서 놓치기 쉬워 흡인성 폐렴 위험이 크므로, 의심되면 비디오투시조영검사(VFSS)나 내시경검사(FEES) 같은 기기 평가가 필요하다.\",\"w\":{\"1\":\"기침 반사가 유지된 방어 반응이라면 흡인 시 기침이 나타나야 한다. 기침 없이 흡인이 확인되었으므로 정상 방어 반응이 아니다.\",\"3\":\"구강 준비 단계의 저작 문제는 덩이 형성 곤란, 구강 잔여물로 나타난다. 기침 없는 흡인이라는 기도 방어 실패를 설명하지 못한다.\",\"4\":\"식도 이완불능증(achalasia)은 하부식도괄약근이 잘 이완되지 않아 식도에 음식이 정체되는 식도 단계 질환이다. 무증상 흡인의 전형적 설명이 아니다.\",\"5\":\"미각 저하는 삼킴 감각 단서를 줄일 수 있지만, 기침 없는 흡인의 핵심은 기도 감각·방어 반사 저하이다. 일시적 삼킴 지연으로 축소할 수 없다.\"}},\"2-1-1-17\":{\"p\":\"인두 단계에서는 삼킴반사가 촉발되면서 기도 보호와 덩이 이동이 동시에 일어난다. 설골·후두가 위·앞으로 올라가고(후두 거상), 후두개가 내려가 후두 입구를 덮으며, 진성대·가성대가 닫혀 기도가 보호된다. 동시에 연구개가 올라가 비인두를 막고, 인두 수축근이 덩이를 밀어 내리며, 후두 거상에 맞춰 상부식도괄약근이 열린다. 단계별로 수의(구강 준비·구강)와 불수의(인두·식도) 조절을 구분하는 것도 함께 정리해 둔다.\",\"w\":{\"1\":\"삼킴반사는 구강 운반 단계 끝무렵 덩이가 구협궁·인두에 이를 때 촉발되며 인두 단계를 시작시킨다. 구강 준비 단계는 씹기와 덩이 형성 단계이다.\",\"2\":\"인두 단계에서 연구개는 하강이 아니라 상승하여 비인두를 막는다. 그래야 음식물이 코로 역류하지 않는다.\",\"4\":\"식도 단계는 연동운동에 의한 불수의적 과정이다. 수의 조절이 가능한 단계는 구강 준비·구강 운반 단계이다.\",\"5\":\"상부식도괄약근은 인두 단계에서 후두 거상과 함께 열린다. 구강 운반 단계는 혀가 덩이를 인두 쪽으로 보내는 단계이다.\"}},\"2-1-1-18\":{\"p\":\"DSM-5의 신경인지장애(NCD)는 일상생활 독립성으로 경도와 주요(major)를 나눈다. 경도 신경인지장애는 하나 이상의 인지영역(복합주의, 집행기능, 학습·기억, 언어, 지각-운동, 사회인지)에서 이전 수준보다 경미한 저하가 있고, 계산서 관리처럼 복잡한 일상활동에 더 많은 노력·보상 전략이 필요할 수 있으나 독립성은 유지된다. 독립성이 상실되면 주요 신경인지장애이다. 섬망으로만 생기지 않아야 하고 다른 정신질환으로 더 잘 설명되지 않아야 하며, 알츠하이머병을 원인으로 붙이려면 서서히 시작되어 점진적으로 진행하는 경과 등이 필요하다.\",\"w\":{\"1\":\"인지 저하로 일상활동의 독립성이 상실된 경우는 주요 신경인지장애(치매에 해당)의 기준이다. 경도에서는 독립성이 유지된다.\",\"2\":\"삼킴능력 저하는 질병 진행 후기에 나타날 수 있는 동반 문제일 뿐 경도 신경인지장애의 진단 기준이 아니다.\",\"4\":\"시각·청각 등 말초 감각 저하는 인지 저하가 아니다. 오히려 인지검사 수행을 낮춰 보일 수 있어 감별해야 할 요인이다.\",\"5\":\"편측 운동마비와 보행장애는 뇌졸중 등 국소 신경학적 징후로, 혈관성 원인을 시사할 수 있다. 알츠하이머병으로 인한 경도 신경인지장애의 필수 조건이 아니다.\"}},\"2-1-1-19\":{\"p\":\"전두측두엽 치매(frontotemporal dementia, FTD)는 전두엽·측두엽이 비교적 이른 나이부터 선택적으로 위축되는 퇴행성 치매이다. 행동변이형(bvFTD)은 탈억제, 무관심, 공감 상실, 강박적 행동, 식습관 변화 같은 성격·행동 변화가 기억장애보다 먼저 두드러지고, 언어변이형은 원발진행실어증(PPA) 형태로 나타난다. 알츠하이머 치매가 일화기억 저하로 시작하는 것과 비교해 '초기 증상이 무엇인가'로 감별하는 것이 핵심이다.\",\"w\":{\"1\":\"알츠하이머 치매는 초기에 최근 기억 저하와 이름대기 어려움이 두드러지며, 발화는 대체로 유창하나 내용이 빈약해진다. 초기 비유창 발화는 비유창형 PPA의 특징이다.\",\"2\":\"베타 아밀로이드 축적(노인반)은 알츠하이머병의 병리이다. 혈관성 치매는 뇌경색·소혈관 질환 등 뇌혈관 손상이 원인이다.\",\"3\":\"원발진행실어증은 신경퇴행성 질환으로 언어 능력이 서서히 진행적으로 저하되는 것이다. 뇌혈관 질환에 의한 급성 발병은 뇌졸중 후 실어증의 특징이다.\",\"4\":\"파킨슨병 치매는 운동 증상이 먼저 나타난 뒤 수년 후 주의·집행기능·시공간 기능 저하, 사고 속도 저하가 나타나는 것이 일반적이다. 초기부터 심한 실어증은 전형적이지 않다.\"}},\"2-1-1-20\":{\"p\":\"작업기억(working memory)은 정보를 짧은 시간 동안 의식적으로 유지하면서 동시에 조작·처리하는 능력이다. 숫자 바로 따라말하기(forward span)는 주로 단기 유지 용량을, 거꾸로 따라말하기(backward span)는 유지한 숫자의 순서를 뒤집는 조작이 더해지므로 작업기억(Baddeley 모형의 음운 고리와 중앙집행기)을 더 강하게 반영한다. 지문은 들은 숫자를 '거꾸로' 말하게 하므로 작업기억 과제이다. 작업기억 저하는 문장 이해, 담화 따라가기 등 의사소통에도 영향을 준다.\",\"w\":{\"1\":\"절차기억은 자전거 타기처럼 반복으로 익힌 기술·습관에 대한 비서술 기억이다. 숫자를 잠시 유지하며 조작하는 과제와 다르다.\",\"2\":\"암묵기억은 의식적 회상 없이 수행에 영향을 미치는 기억(절차기억, 점화 등)의 총칭이다. 의식적으로 숫자를 유지·조작하는 과제와 맞지 않는다.\",\"4\":\"서술적 장기기억은 사실(의미기억)이나 경험(일화기억)을 오래 저장했다가 의식적으로 떠올리는 기억이다. 방금 들은 숫자를 바로 조작하는 과제는 장기기억 평가가 아니다.\",\"5\":\"점화(priming)는 앞서 노출된 자극이 이후 같거나 관련된 자극의 처리를 무의식적으로 촉진하는 암묵기억 현상이다. 역순 말하기 과제와 관계가 없다.\"}},\"2-1-1-21\":{\"p\":\"장기기억은 의식적으로 떠올려 말로 설명할 수 있는 서술(외현)기억과, 수행으로 드러나는 비서술(암묵)기억으로 나뉜다. 서술기억에는 일반 지식인 의미기억과 '언제·어디서' 정보가 있는 개인 경험인 일화기억이 있고, 비서술기억에는 절차기억(기술·습관), 점화, 고전적 조건형성 등이 있다. 절차기억은 반복 연습으로 자동화된 운동·인지 기술이므로 비서술 기억이라는 설명이 옳다. 알츠하이머 초기에는 일화기억이 먼저 손상되고 절차기억은 비교적 보존되어, 치료에 절차기억을 활용하는 근거가 된다.\",\"w\":{\"1\":\"사건·사실에 대한 의식적 기억은 서술기억(일화·의미기억)의 정의이다. 절차기억은 의식적 회상 없이 수행으로 드러난다.\",\"2\":\"자전거 타기 같은 기술의 기억은 절차기억(비서술기억)이다. 서술기억은 말로 설명할 수 있는 사실·사건의 기억이다.\",\"3\":\"개인적 사건의 시간·장소 정보를 포함하는 기억은 일화기억이다. 의미기억은 맥락과 분리된 일반 지식·낱말 의미의 기억이다.\",\"5\":\"일반적인 사실과 지식에 대한 기억은 의미기억이다. 일화기억은 개인이 직접 겪은 특정 사건에 대한 기억이다.\"}},\"2-1-1-22\":{\"p\":\"우반구 손상(right hemisphere damage, RHD) 환자는 기본적인 음운·문법·어휘 능력은 비교적 보존되지만, 맥락을 통합해 의미를 파악하는 능력이 떨어진다. 그래서 은유·관용어·농담·간접 표현 같은 비문자적 의미 이해가 어렵고, 감정 억양 산출·이해가 떨어져 운율이 단조로우며(실운율증, aprosodia), 장황하거나 주제를 벗어나는 담화 문제가 나타난다. 우반구가 공간 주의를 담당하므로 좌측 무시(left neglect)도 흔하고, 병식 저하(질병인식불능증)가 동반될 수 있다. 나머지 보기는 좌반구 실어증·실독증의 특징이므로 반구 편재화로 감별한다.\",\"w\":{\"1\":\"문법형태소를 생략한 전보식 발화는 좌반구 브로카실어증의 실문법증 특징이다. 우반구 손상은 문법 능력이 대체로 보존된다.\",\"2\":\"따라말하기만 선택적으로 심하게 손상되는 것은 좌반구 전도실어증의 특징이다.\",\"3\":\"심한 청각적 이해 손상과 착어는 좌반구 베르니케실어증의 핵심 특징이다. 우반구 손상은 낱말·문장 수준 이해가 비교적 유지된다.\",\"5\":\"비단어 읽기만 선택적으로 손상되는 것은 좌반구 손상과 관련된 음운실독증의 특징이다.\"}},\"2-1-1-23\":{\"p\":\"fMRI(기능적 자기공명영상)는 과제 수행으로 특정 뇌 영역이 활성화되면 그 부위의 혈류와 혈중 산소 수준이 변하는 것을 이용해, 산화·탈산화 헤모글로빈의 자기적 성질 차이에서 생기는 BOLD(blood oxygen level dependent) 신호로 뇌 기능을 간접 측정한다. 방사선을 쓰지 않고 공간 해상도가 높지만, 혈류 반응이 수 초 늦어 시간 해상도는 EEG·MEG보다 낮다. 영상 기법은 구조 영상(CT, 구조적 MRI)과 기능 영상(fMRI, PET, SPECT), 전기·자기 신호 측정(EEG, MEG)으로 나눠 정리하면 쉽다.\",\"w\":{\"1\":\"CT(컴퓨터단층촬영)는 X선을 이용하므로 방사선 노출이 있다. 촬영이 빠르고 급성 뇌출혈 확인에 유용하지만 반복 촬영 시 노출 누적을 고려해야 한다.\",\"3\":\"fMRI는 과제 관련 혈류 변화를 측정해 뇌 기능 활성을 반영하는 기능 영상이다. 구조만 보여 준다는 설명은 구조적 MRI에 해당한다.\",\"4\":\"구조적 MRI는 뇌 조직의 해부학적 구조를 보여 준다. 실시간 신경 활동의 전기 신호를 측정하는 것은 EEG(뇌파)이다.\",\"5\":\"EEG는 두피 전극으로 뇌의 전기적 활동을 측정한다. 포도당 대사 소비량을 측정하는 것은 FDG-PET(양전자방출단층촬영)이다.\"}},\"2-1-1-24\":{\"p\":\"동어반복증(palilalia)은 환자가 스스로 산출한 낱말·구·문장을 강박적으로 반복하는 현상으로, 반복할수록 말이 빨라지거나 작아지기도 한다. 지문에서 환자는 검사자의 말이 아니라 자기 발화('12시에', '먹어야')를 거듭 반복하고 있다. 선조체를 포함한 기저핵 병변(파킨슨병, 기저핵 경색 등)과 관련될 수 있다는 점도 단서이다. 상대의 말을 따라 하는 반향어와 '누구의 말을 반복하는가'로 구별한다.\",\"w\":{\"1\":\"반향어증(echolalia)은 상대방이 한 말을 그대로 따라 반복하는 것이다. 환자는 검사자의 질문이 아니라 자기 말을 반복하고 있다.\",\"3\":\"실구어증(aphemia)은 일반적으로 말 산출이 심하게 제한되는 반면 쓰기·이해는 보존되는 순수 말 산출 장애를 가리킨다. 자기 말을 되풀이하는 현상이 아니다.\",\"4\":\"감금증후군(locked-in syndrome)은 주로 뇌교(교뇌) 손상으로 의식은 있으나 눈 움직임 외의 수의 운동과 말을 거의 할 수 없는 상태이다. 지문의 환자는 문장을 산출하고 있다.\",\"5\":\"발성실행증(phonatory apraxia)은 근력 이상 없이 의도적으로 소리를 내는 운동 계획에 어려움이 있는 것이다. 산출한 구를 반복하는 현상과 다르다.\"}},\"2-1-1-25\":{\"p\":\"이름대기(naming) 어려움(낱말찾기 어려움, anomia)은 실어증의 거의 보편적인 증상으로, 브로카·베르니케·전도·명칭실어증 등 대부분의 유형에서 정도 차이만 있을 뿐 나타난다. 그래서 이름대기 손상 여부만으로는 유형을 가리기 어렵고, 유형 감별은 유창성·청각적 이해·따라말하기 조합으로 한다. 명칭실어증은 이름대기 어려움이 '주된 증상'으로 남는 유형일 뿐 이름대기 손상이 명칭실어증에만 있는 것은 아니라는 점을 구분해 둔다.\",\"w\":{\"1\":\"유창성은 스스로 말하기에서 발화 길이, 문법 구조, 운율, 노력성 등을 보고 판단한다. 청각적 이해 점수는 별도 하위영역이다.\",\"3\":\"따라말하기 손상 정도는 유형마다 다르며 감별의 핵심 지표이다. 전도·브로카·베르니케는 손상되고 연결피질 실어증·명칭실어증은 보존된다.\",\"4\":\"알아듣기 검사는 예/아니오 질문, 청각적 낱말 인지, 명령 이행 등으로 청각적 이해를 평가한다. 발화의 문법성은 스스로 말하기에서 본다.\",\"5\":\"스스로 말하기는 대화·그림 설명으로 구어 산출을 직접 평가하는 하위영역이다. 읽기는 별도 영역으로 평가하며 대체할 수 없다.\"}},\"2-1-1-26\":{\"p\":\"외상성 뇌손상(traumatic brain injury, TBI)은 외부 충격으로 생기는 뇌손상으로, 가속-감속에 따른 전두엽·측두엽 앞쪽 손상과 미만성 축삭손상이 흔하다. 그래서 국소 언어 영역 손상에 의한 고전적 실어증보다, 주의·기억·처리속도·집행기능 저하가 바탕이 되는 인지-의사소통장애가 두드러진다. 언어 구조(음운·문법)는 비교적 보존되는 경우가 많지만 주제 유지 어려움, 장황함·탈선, 순서 지키기 어려움, 상황·상대 파악 부족 같은 화용 문제가 나타난다. 평가·중재도 인지와 화용을 함께 다룬다.\",\"w\":{\"2\":\"언어의 음운·문법 손상이 핵심이고 인지가 보존되는 것은 좌반구 국소 손상에 의한 실어증의 특징이다. TBI는 인지 저하가 의사소통 문제의 바탕이 된다.\",\"3\":\"심한 청각적 이해 손상이 핵심인 것은 베르니케실어증 같은 좌반구 실어증이다. TBI의 이해 문제는 주로 주의·기억 저하로 긴 담화나 복잡한 정보를 따라가기 어려운 형태이다.\",\"4\":\"편측 무시가 주된 특징으로 나타나는 것은 우반구 뇌졸중 환자의 전형이다. TBI에서도 나타날 수 있으나 핵심 의사소통 특징은 아니다.\",\"5\":\"TBI에서 실어증이 동반될 수도 있으나 전형적이지 않다. 대체로 발화 자체는 유창하고 인지·화용 문제가 두드러진다.\"}},\"2-1-1-27\":{\"p\":\"이중경로 읽기 모형에서 글자는 어휘 경로(익숙한 단어를 통째로 인식)와 비어휘 경로(자소-음소 변환 규칙으로 소리를 조합) 두 길로 읽힌다. 실제 낱말은 어휘 경로로 읽을 수 있으나 처음 보는 비단어('두랍', '무핀')는 자소-음소 변환으로만 읽을 수 있다. 따라서 실제 낱말은 양호하고 비단어만 선택적으로 손상되었다면 자소-음소 변환(음운) 경로가 손상된 음운실독증이다. 의미 오류가 함께 있었다면 심층실독증을 생각했겠지만 지문에는 그런 오류가 없다.\",\"w\":{\"1\":\"표층실독증은 어휘(전체 단어) 경로 손상으로 불규칙어를 규칙대로 읽는 규칙화 오류가 특징이며, 비단어 읽기는 비교적 보존된다. 지문과 반대 양상이다.\",\"2\":\"심층실독증은 비단어 읽기 손상에 더해 의미 오류('버스'→'기차')와 구체어 우위 효과를 보인다. 지문에는 의미 오류가 제시되지 않았다.\",\"3\":\"순수실독증은 시각 단어 형태 입력 손상으로 실제 낱말 읽기도 느려지고 낱자 읽기를 한다. 실제 낱말 읽기가 양호하다는 점과 맞지 않는다.\",\"5\":\"무시실독증은 공간 주의 손상(편측 무시)으로 단어 한쪽을 빠뜨려 읽는 것이다. 실제 낱말 읽기가 양호하고 비단어만 손상되는 양상과 다르다.\"}},\"2-1-1-28\":{\"p\":\"대부분의 오른손잡이(일반적으로 90 % 이상)에서는 좌반구가 언어 우세 반구로 음운·통사·어휘 처리를 주로 담당한다. 우반구는 감정이 담긴 운율(정서적 운율)의 산출·이해, 비유·함축·유머 같은 화용, 담화 맥락 통합, 얼굴 인식, 시공간 주의 등에 더 많이 관여한다. 그래서 우반구 손상 후에는 단조로운 운율, 비문자적 의미 이해 어려움, 좌측 무시가 나타난다. 편재화는 '전담'이 아니라 상대적 우세라는 점도 기억해 둔다.\",\"w\":{\"2\":\"언어의 음운·통사 처리는 대부분의 오른손잡이에서 좌반구가 우세하게 담당한다. 우반구라는 설명은 반대이다.\",\"3\":\"좌측 무시는 공간 주의를 담당하는 우반구(특히 두정엽) 손상에서 더 흔하고 심하다. 좌반구 손상 후 우측 무시는 상대적으로 드물고 가볍다.\",\"4\":\"얼굴 정서 인식은 우반구가 상대적으로 더 관여하며, 좌반구의 주 기능은 언어이다. '만을 전담'이라는 단정도 편재화 개념에 맞지 않는다.\",\"5\":\"전형적인 실문법증은 좌반구 브로카 영역 손상에서 나타난다. 우반구 손상은 문법보다 운율·화용 문제가 두드러진다.\"}},\"2-1-1-29\":{\"p\":\"알츠하이머병 초기에는 새로운 일화기억 형성은 떨어지지만 절차기억과 점화 같은 암묵기억은 비교적 보존된다. 무오류 학습(errorless learning)은 처음부터 정답을 제시하거나 단서를 충분히 주어 틀린 반응을 하지 않도록 하는 방법으로, 오류를 스스로 기억하고 고치기 어려운 환자가 틀린 반응을 굳히지 않게 한다. 간격 회상(spaced retrieval)은 정보를 성공적으로 떠올리는 간격을 점차 늘려 가며 학습을 굳히는 방법이다. 두 방법 모두 보존된 암묵기억을 활용하며, 기억책·환경 단서 같은 외부 보조와 함께 쓰인다.\",\"w\":{\"2\":\"오류를 경험하고 스스로 교정하는 시행착오 학습은 오류를 기억해 수정할 수 있는 외현기억이 필요하다. 기억이 손상된 치매 환자에게는 오류가 오히려 굳어질 수 있다.\",\"3\":\"복잡한 통사 이해 과제는 인지 부담이 크고 이름대기 저하라는 목표와도 직접 관련이 적다. 초기 치매 중재는 기능적이고 보존된 능력을 활용하는 방향이 우선이다.\",\"4\":\"구강 근력 강화 훈련은 마비말장애나 삼킴장애의 근력 약화에 쓰인다. 알츠하이머병의 이름대기 저하는 근력 문제가 아니다.\",\"5\":\"제약유발 언어치료(CIAT)는 뇌졸중 후 실어증에서 구어 사용을 강제해 회복을 촉진하는 방법이다. 진행성 기억 저하가 있는 치매 환자에게 오류 부담을 키울 수 있어 적절하지 않다.\"}},\"2-1-1-30\":{\"p\":\"전반실어증(global aphasia)은 스스로 말하기, 청각적 이해, 따라말하기, 이름대기 등 모든 언어 영역이 심하게 손상된 가장 중증의 실어증 유형이다. 지문처럼 인사말·숫자 세기 같은 자동구어나 상동적 발화 일부, 표정·제스처·억양 같은 비언어적 의사소통만 비교적 남는 경우가 많다. 일반적으로 좌측 중대뇌동맥 영역의 광범위한 손상(브로카·베르니케 영역 모두 포함)과 관련된다. 브로카실어증과는 이해 손상 정도로, 베르니케실어증과는 유창성으로 구별한다.\",\"w\":{\"1\":\"브로카실어증은 비유창하지만 일상적 청각적 이해가 비교적 양호하다. 이해까지 심하게 손상된 지문과 맞지 않는다.\",\"2\":\"베르니케실어증은 이해와 따라말하기가 손상되지만 발화가 유창하다. 발화 자체가 심하게 손상되어 자동구어만 남은 지문과 맞지 않는다.\",\"3\":\"전도실어증은 유창한 발화와 비교적 양호한 이해를 보이며 따라말하기가 선택적으로 손상된다. 모든 영역의 심한 손상과 다르다.\",\"4\":\"명칭실어증은 이름대기 어려움이 주된 증상이고 이해·따라말하기·유창성은 양호하다. 가장 경한 유형 중 하나로 지문과 정반대이다.\"}},\"2-1-1-31\":{\"p\":\"핵심행동(core behavior)은 반복·연장·막힘처럼 말더듬 그 자체이고, 부수행동(secondary behavior)은 핵심행동에 대한 반응으로 학습된 행동이다. 부수행동은 다시 시점으로 나뉘는데, 이미 시작된 말더듬에서 빠져나오려는 것은 탈출행동, 말더듬을 예상하고 아예 일어나지 않게 미리 피하는 것은 회피행동이다. 어려운 낱말을 다른 낱말로 바꿔 말하는 것(대치)은 막힘이 일어나기 전, 예상 단계에서 하는 행동이므로 회피행동이다. 분류할 때는 '말더듬이 이미 일어났는가(탈출) 아직 일어나기 전인가(회피)'를 먼저 따지면 헷갈리지 않는다.\",\"w\":{\"1\":\"입술이 붙은 채 소리가 막히는 것은 막힘(block)으로, 말더듬 자체인 핵심행동이다. 막힘에서 벗어나려고 하는 추가 행동이 있어야 탈출행동이 된다.\",\"2\":\"막힌 순간 눈을 세게 깜박이는 것은 이미 시작된 말더듬에서 빠져나오려는 탈출행동(부수행동)이다. 말더듬 자체가 아니므로 핵심행동이 아니다.\",\"3\":\"소리 연장은 반복·막힘과 함께 대표적인 핵심행동이다. 말더듬을 미리 피하려는 행동이 아니므로 회피행동으로 분류하지 않는다.\",\"5\":\"고개를 갑자기 젖혀 막힘에서 벗어나는 것은 진행 중인 말더듬을 끝내려는 탈출행동이다. 말더듬에 대한 반응으로 학습된 부수행동이지 핵심행동이 아니다.\"}},\"2-1-1-32\":{\"p\":\"Yairi와 Ambrose의 분류에서 진성 비유창성(SLD, stuttering-like disfluency)은 낱말부분(음소·음절) 반복, 1음절 낱말 반복, 비운율적 발성(연장·막힘)으로 말더듬 아동에게 특징적으로 많다. 기타 비유창성(OD, other disfluency)은 간투사, 수정, 미완성 발화, 다음절 낱말 반복, 구 반복처럼 일반 아동에게도 흔히 나타난다. '나는 나는 갈래'는 2음절 이상의 단위(구)를 통째로 되풀이한 것이므로 OD이다. 반복 문항은 반복 단위가 낱말의 일부인지, 1음절 낱말인지, 다음절 낱말·구인지를 먼저 확인해야 하며, 1음절 낱말 반복은 OD가 아니라 SLD로 분류된다는 점이 자주 출제된다.\",\"w\":{\"1\":\"'나 나 나'처럼 1음절 낱말을 반복하는 것은 Yairi와 Ambrose 분류에서 진성 비유창성(SLD)에 속한다. 다음절 낱말 반복이나 구 반복만 기타 비유창성이다.\",\"3\":\"간투사('음, 어')는 일반 아동·성인에게도 흔한 기타 비유창성(OD)이다. 진성 비유창성에는 낱말부분 반복, 1음절 낱말 반복, 연장·막힘만 들어간다.\",\"4\":\"'나는, 아니 우리는'처럼 이미 말한 내용을 고쳐 말하는 수정(revision)은 언어 형성 과정에서 생기는 기타 비유창성(OD)이다.\",\"5\":\"소리 연장은 비운율적 발성에 해당하므로 진성 비유창성(SLD)이다. 기타 비유창성으로 연결한 것은 틀렸다.\"}},\"2-1-1-33\":{\"p\":\"요구-용량 모델(Demands and Capacities Model, Starkweather)은 아동이 가진 말운동·언어·정서·인지 용량보다 환경과 아동 스스로가 만드는 요구(빠른 말속도, 복잡한 문장, 시간 압박, 흥분 등)가 클 때 비유창성이 생긴다고 본다. 원인을 아동 내부나 환경 한쪽에만 두지 않고 둘의 불균형으로 설명한다는 점이 핵심이며, 그래서 학령전 아동 간접치료에서 부모의 말속도를 늦추고 질문을 줄여 요구를 낮추는 근거가 된다. 나머지 보기는 각 이론의 이름과 내용이 서로 뒤섞여 있으므로, 이론 이름과 핵심 키워드(낙인, 반구 경쟁, 예기·투쟁, 내적 수정)를 짝지어 기억해야 한다.\",\"w\":{\"1\":\"양쪽 대뇌반구의 우세 경쟁으로 말운동 협응이 실패한다는 것은 대뇌반구 우세이론(Orton과 Travis)의 내용이다. 진단착오이론(Johnson)은 부모의 낙인을 원인으로 본다.\",\"3\":\"부모가 정상적 비유창성을 말더듬으로 낙인찍어 말더듬이 생긴다는 것은 Johnson의 진단착오이론(의미론적 이론)이다. 대뇌반구 우세이론은 반구 간 우세 경쟁을 원인으로 본다.\",\"4\":\"예기투쟁가설은 말더듬을 예상하고 이를 피하거나 이겨내려는 긴장·투쟁 반응이 말더듬을 만든다는 학습·심리적 설명이다. 유전적 말운동 조절 장애로 학습 영향이 적다는 설명과는 반대된다.\",\"5\":\"청자의 부정적 반응에 의해 강화되어 유지된다는 것은 조작적 조건화 등 학습이론의 설명이다. 내적수정가설(Postma와 Kolk)은 음운 계획 오류를 말하기 전에 내적으로 감지·수정하는 과정에서 비유창성이 생긴다고 본다.\"}},\"2-1-1-34\":{\"p\":\"Guitar는 말더듬 발달을 정상적 비유창성 → 경계선급 → 초기(초급) → 중간급 → 심화(진전된) 말더듬 순으로 설명한다. 경계선급 말더듬은 비유창성 빈도가 정상보다 높고(교재에 따라 대략 100낱말당 10회 이상) 반복 단위 수가 2회 이상으로 많아지며, 반복·연장이 늘지만 아직 긴장·막힘·탈출행동이 거의 없고 아동이 자신의 말을 거의 의식하지 않는다. 즉 '양적으로는 늘었지만 질적(긴장·반응)으로는 아직 정상에 가깝다'는 점이 이 단계를 판별하는 단서이다. 긴장과 탈출행동이 나타나면 초기 말더듬, 회피가 나타나면 중간급으로 넘어간 것으로 본다.\",\"w\":{\"2\":\"말더듬을 예상한 낱말 회피와 상황 회피가 나타나기 시작하는 것은 Guitar의 중간급 말더듬 특징이다. 경계선급 아동은 말더듬을 거의 의식하지 않으므로 회피행동이 없다.\",\"3\":\"두려움과 부정적 자아개념이 확고하게 자리 잡은 것은 주로 청소년·성인기의 심화된(진전된) 말더듬 특징이다.\",\"4\":\"막힘과 눈 깜박임 등 탈출행동이 뚜렷한 것은 초기(초급) 말더듬의 특징이다. 경계선급에서는 긴장과 탈출행동이 거의 없다.\",\"5\":\"비유창성이 주로 간투사·수정이고 빈도가 낮은 것은 정상적 비유창성의 특징이다. 경계선급은 반복·연장 등이 정상보다 많아진 단계이다.\"}},\"2-1-1-35\":{\"p\":\"지문의 단서는 ① 성인기(52세) 뇌경색 이후 발병, ② 아동기 말더듬 병력 없음, ③ 기능어·내용어를 가리지 않는 반복, ④ 반복 읽기에도 줄지 않음(적응효과 없음), ⑤ 부수행동·불안이 거의 없음이다. 이는 신경학적(신경인성) 말더듬(neurogenic stuttering)의 전형적인 특징이다. 발달성 말더듬은 주로 낱말 첫머리·내용어에서 더듬고 반복 읽기에서 줄어드는 적응효과가 있으며, 부수행동과 말 불안이 발달하는 것과 대비된다. 다만 신경학적 말더듬의 특징은 사례마다 차이가 있어 모든 항목이 항상 나타나는 것은 아니므로, 발병 시기와 신경학적 사건의 유무를 가장 중요한 판단 근거로 삼는다.\",\"w\":{\"1\":\"발달성 말더듬은 대부분 학령전기(2~5세)에 시작되고 적응효과와 부수행동을 보인다. 이 대상자는 아동기 병력 없이 뇌경색 후 성인기에 시작되었으므로 맞지 않는다.\",\"2\":\"속화는 빠르고 불규칙한 말속도, 음절 축약·생략으로 인한 명료도 저하가 핵심이다. 지문에는 말속도 이상이 없고 뇌경색 후 반복이 시작되었다는 단서뿐이다.\",\"3\":\"심인성 말더듬은 뇌손상 없이 심리적 외상이나 큰 스트레스 사건 이후 갑자기 시작된다. 이 대상자는 뇌경색이라는 신경학적 원인이 분명하다.\",\"5\":\"경계선급 말더듬은 Guitar의 발달 단계 중 학령전 아동의 초기 단계를 가리키는 용어이다. 성인의 후천적 말더듬 유형을 분류하는 용어가 아니다.\"}},\"2-1-1-36\":{\"p\":\"속화(cluttering)는 말속도가 빠르거나 불규칙해서 음절·낱말이 축약·생략되고, 간투사·수정·반복 같은 정상적 비유창성이 과도하게 나타나 명료도가 떨어지는 유창성장애이다. 말더듬과 가장 크게 다른 점은 자기 말에 대한 인식과 불안이 낮다는 것, 그리고 말에 주의를 기울이거나 천천히 말하면 오히려 좋아진다는 것이다(말더듬은 주의를 기울일수록 더 나빠지는 경향). 또한 언어 구성·화용 문제, 주의력 문제를 자주 동반한다. 실제로는 속화와 말더듬이 함께 나타나는 경우도 있으므로 두 장애의 특징을 대비해 기억하는 것이 좋다.\",\"w\":{\"1\":\"자신의 말 문제를 잘 인식하고 불안·회피가 높은 것은 말더듬의 특징이다. 속화인은 대체로 자기 말 문제에 대한 인식이 낮다.\",\"2\":\"소리·음절 반복, 막힘, 탈출행동은 말더듬의 핵심·부수행동이다. 속화는 빠르고 불규칙한 말속도와 정상적 비유창성 과다가 중심이다.\",\"3\":\"속화는 말에 주의를 기울여 천천히 말하면 명료도가 좋아지는 경향이 있다. 주의를 기울일수록 나빠지는 것은 말더듬에 더 가깝다.\",\"4\":\"속화는 언어 구성의 어려움, 화용 문제, 주의집중 문제를 자주 동반한다. 동반되지 않는다는 설명은 틀렸다.\"}},\"2-1-1-37\":{\"p\":\"유창성(fluency)은 말이 얼마나 막힘없이 흘러가는가에 관한 개념으로, 일반적으로 연속성(continuity), 말속도(rate), 리듬(rhythm), 노력(effort)이 구성요소로 제시된다(Starkweather 등). 연속성은 말이 불필요하게 끊기지 않는 것, 말속도는 정보를 적절한 속도로 전달하는 것, 리듬은 말소리의 강약·장단이 자연스러운 것, 노력은 신체적·정신적 힘을 적게 들이는 것이다. 정확성·명료도는 조음 영역, 강도·음도·공명은 음성 영역의 개념이므로, 이런 낱말이 하나라도 섞인 묶음은 유창성 구성요소가 될 수 없다.\",\"w\":{\"1\":\"명료도는 조음·말 산출의 결과이고 강도·음도·공명은 음성장애에서 다루는 음성 특성이다. 유창성의 구성요소는 하나도 없다.\",\"2\":\"연속성은 유창성 요소가 맞지만 정확성은 조음, 강도·음도는 음성 영역의 개념이다.\",\"3\":\"정확성·명료도는 조음 영역, 공명은 음성 영역의 개념이다. 억양은 운율에 속하지만 유창성 구성요소로 제시되는 리듬·말속도와는 다르다.\",\"5\":\"노력은 유창성 요소가 맞지만 정확성(조음), 공명(음성), 억양(운율)은 유창성 구성요소가 아니다.\"}},\"2-1-1-38\":{\"p\":\"학령전 말더듬 아동의 상당수(교재에 따라 대략 70~80 %)는 자연회복된다. 회복 쪽을 가리키는 요인은 여아, 이른 발병, 발병 후 초기 수개월 안에 비유창성이 줄어드는 추세, 자연회복된 가족력, 양호한 음운·언어 능력 등이다. 보기 ④는 '여아'와 '발병 후 수개월 사이 감소 추세'라는 두 가지 긍정적 예후 요인을 함께 갖고 있다. 반대로 남아, 지속된 가족력, 발병 후 12개월 이상 지속, 늦은 발병, 음운·언어 능력 저하, 부수행동 증가는 말더듬이 지속될 위험 요인이므로, 이런 아동은 기다리기보다 조기 직접 중재를 고려한다.\",\"w\":{\"1\":\"또래보다 뚜렷하게 낮은 음운·언어 능력과 남아라는 성별은 모두 말더듬 지속 위험 요인이다.\",\"2\":\"말더듬이 성인기까지 지속된 가족력과 남아는 지속 위험 요인이다. 회복된 가족력이어야 자연회복 쪽 요인이 된다.\",\"3\":\"발병 후 12개월 넘게 지속되고 부수행동이 늘어나는 것은 말더듬이 고착되고 있다는 신호로 지속 위험 요인이다.\",\"5\":\"늦은 발병(대략 3~4세 이후)과 비유창성 빈도가 줄지 않는 추세는 모두 자연회복 가능성을 낮추는 요인이다.\"}},\"2-1-1-39\":{\"p\":\"말을 더듬는 사람도 노래하기, 합창읽기(choral reading, 다른 사람과 함께 소리 내어 읽기), 리듬에 맞춰 말하기, 혼잣말, 속삭이기, 동물·아기에게 말하기 같은 조건에서는 말더듬이 크게 줄어든다. 이런 유창성 유도 조건의 공통점은 외부 리듬이나 다른 사람의 목소리가 말의 타이밍을 잡아 주거나, 의사소통 책임·청자 부담이 줄어든다는 것이다. 반대로 의사소통 압박이 크거나 피할 수 없는 상황(전화, 권위 있는 청자, 시간 압박, 대치할 수 없는 고유명사)에서는 말더듬이 늘어나므로, 문항을 풀 때 '부담이 줄어드는가, 커지는가'를 기준으로 판단하면 된다.\",\"w\":{\"1\":\"낯선 사람과의 전화 통화는 시각 단서가 없고 즉각 반응해야 하는 압박이 커서 말더듬이 증가하는 대표적 상황이다.\",\"3\":\"시간 압박 속에서 빠르게 대답해야 하는 상황은 의사소통 요구를 높여 말더듬을 증가시킨다.\",\"4\":\"이름·주소처럼 다른 낱말로 바꿀 수 없는 정보는 대치·에두르기 같은 회피 전략을 쓸 수 없어 말더듬이 늘어나는 경향이 있다.\",\"5\":\"권위 있는 청자 앞의 공식 발표는 평가 불안과 의사소통 책임이 커서 말더듬이 증가하는 상황이다.\"}},\"2-1-1-40\":{\"p\":\"같은 지문을 여러 번 읽게 했을 때 이전에 더듬었던 낱말에서 다시 더듬는 경향을 일관성 효과(consistency effect)라고 한다. 지문의 단서는 '1회에서 더듬은 낱말의 대부분을 5회에서도 같은 위치에서 더듬었다'는 부분으로, 빈도의 변화가 아니라 '어디서 더듬는가'의 일치를 묻고 있다. 반복 읽기 과제에서는 보통 두 효과가 함께 관찰되는데, 횟수가 거듭될수록 말더듬 빈도가 줄어드는 것은 적응효과(adaptation effect), 더듬는 위치가 유지되는 것은 일관성 효과이다. 일관성 효과는 말더듬이 특정 낱말에 대한 예기·학습과 관련된다는 근거로 해석되기도 한다.\",\"w\":{\"1\":\"적응효과는 같은 지문을 반복해서 읽을 때 말더듬 빈도가 점차 줄어드는 현상이다. 지문은 빈도가 아니라 더듬는 위치가 유지되는 현상을 묻고 있다.\",\"3\":\"인접효과는 이전에 더듬었던 낱말을 지문에서 없애면 그 주변 낱말에서 말더듬이 나타나는 현상이다. 같은 낱말에서 계속 더듬는 현상과는 다르다.\",\"4\":\"청자규모효과는 청자 수가 많아질수록 말더듬이 증가하는 현상으로, 반복 읽기와는 관계가 없다.\",\"5\":\"교환효과는 반복 읽기에서 같은 위치에서 계속 더듬는 현상을 가리키는 용어가 아니다. 이 현상의 명칭은 일관성 효과이다.\"}},\"2-1-1-41\":{\"p\":\"발생률(incidence)은 일생 중 한 번이라도 말더듬을 경험한 사람의 비율(일반적으로 약 5 % 내외), 출현율(prevalence)은 특정 시점에 말더듬을 가지고 있는 사람의 비율(약 1 % 내외)이다. 두 값의 차이가 큰 까닭은 학령전기에 말더듬이 시작된 아동 상당수가 자연회복되어, 특정 시점에서 세면 이미 회복된 사람이 빠지기 때문이다. 같은 이유로 여아가 더 많이 회복되므로 남녀 비율은 학령전기 약 2:1 정도에서 연령이 높아질수록 남성 쪽으로 더 벌어진다(성인기 약 4:1 수준). 수치는 연구·교재에 따라 차이가 있으므로 '발생률 > 출현율', '연령이 높을수록 남성 비율 증가'라는 방향을 확실히 기억하는 것이 중요하다.\",\"w\":{\"1\":\"일생 동안 한 번이라도 말더듬을 경험한 사람의 비율은 발생률의 정의이다. 출현율은 특정 시점에 말더듬이 있는 사람의 비율이다.\",\"2\":\"여아의 자연회복률이 더 높기 때문에 연령이 높아질수록 남녀 비율은 1:1에서 멀어져 남성 쪽으로 더 커진다.\",\"3\":\"말더듬은 대부분 2~5세 학령전기에 시작된다. 7세 이후 발병은 드물며, 늦은 발병은 지속 위험 요인으로 본다.\",\"5\":\"말더듬은 쌍생아·가계 연구에서 유전적 영향이 확인되었고, 가족력은 발생과 지속의 중요한 위험 요인이다.\"}},\"2-1-1-42\":{\"p\":\"연기(postponement)는 어려운 낱말 앞에서 '음…', 쉼, 불필요한 말 등을 넣어 시작 시점을 늦추는 회피행동이다. 회피행동은 말더듬을 예상하고 미리 피하는 행동으로, 대치(어려운 낱말을 다른 낱말로 바꾸기), 에두르기(낱말을 피해 돌려 설명하기), 시작기법(starter: '그러니까', '음' 같은 말이나 동작을 붙여 발화를 출발시키기), 연기, 상황회피(말하는 상황 자체를 피하기) 등이 있다. 연기와 시작기법은 비슷해 보이지만, 연기는 '시간을 끌어 미루는 것', 시작기법은 '특정 말이나 동작을 발판 삼아 출발하는 것'에 초점이 있다.\",\"w\":{\"1\":\"어려운 낱말을 쉬운 다른 낱말로 바꾸는 것은 대치(substitution)이다. 상황회피는 전화 받기나 발표처럼 말해야 하는 상황 자체를 피하는 것이다.\",\"2\":\"막힌 순간 눈을 깜박이며 빠져나오는 것은 이미 일어난 말더듬에서 벗어나려는 탈출행동이다. 대치는 어려운 낱말을 다른 낱말로 바꾸는 회피행동이다.\",\"3\":\"말해야 하는 상황 자체에 참여하지 않는 것은 상황회피이다. 에두르기는 어려운 낱말을 피해 다른 표현으로 돌려 설명하는 것이다.\",\"4\":\"시작기법은 '그러니까'와 같은 말이나 동작을 앞에 붙여 발화를 시작하는 회피행동이다. 더듬었던 낱말을 다시 말하는 것은 시작기법의 정의와 맞지 않는다.\"}},\"2-1-1-43\":{\"p\":\"학령기 말더듬 아동은 대부분 자신의 말더듬을 인식하고, 또래의 놀림·괴롭힘, 수업 중 말하기 부담 때문에 부정적 감정과 회피가 생기기 쉬운 시기에 있다. 따라서 이 시기 치료는 아동에게 유창성 기법이나 말더듬 수정 기법을 직접 가르치는 직접치료를 중심으로, 놀림에 대처하는 방법, 말더듬을 숨기지 않고 이야기할 수 있는 개방적 태도, 의사소통 태도 개선을 함께 다룬다. 또한 교사·부모와 협력하여 학교와 가정에서 지지적인 의사소통 환경을 만들고, 교실 활동에 참여하도록 돕는 것이 일반화에 중요하다.\",\"w\":{\"1\":\"학령기에는 교사의 반응과 또래의 놀림이 말더듬과 태도에 큰 영향을 주므로 학교 환경도 치료 범위에 포함해 교사와 협력한다.\",\"2\":\"학령기 아동은 대부분 말더듬을 이미 인식하고 있어 직접치료가 중심이 된다. 부모 중심 간접치료만 하는 것은 주로 인식이 없는 학령전 초기 아동에 해당한다.\",\"4\":\"학령기에도 부모는 가정에서 기법 연습과 일반화를 돕고 아동의 감정을 지지하는 중요한 역할을 하므로 치료에서 배제하지 않는다.\",\"5\":\"소리 내어 읽기 등 학급 활동을 면제받게 하면 말하기 상황 회피를 강화한다. 대신 교사와 상의해 부담을 조절하면서 참여하도록 돕는다.\"}},\"2-1-1-44\":{\"p\":\"파라다이스-유창성 검사-II(P-FA-II)는 대상을 취학전 아동, 초등학생, 중학생 이상의 세 연령 집단으로 나누고, 집단마다 필수과제와 선택과제를 다르게 구성한 검사이다. 구어 평가에서는 비유창성 유형(정상적 비유창성·비정상적 비유창성)을 분석해 핵심행동 점수를 구하고, 여기에 부수행동 평가를 더하며, 초등학생 이상은 의사소통태도 평가를 함께 실시한다. 결과는 연령 집단별 규준에 따른 백분위 점수로 중증도(약함~심함 등)를 해석한다. 따라서 '연령 집단별 과제 구성'이 이 검사를 설명하는 가장 기본적인 특징이다. 세부 과제명과 점수 산출 방식은 검사 지침서를 기준으로 확인한다.\",\"w\":{\"1\":\"의사소통태도 평가는 자기보고가 가능한 초등학생 이상에게 실시하며, 취학전 아동에게는 실시하지 않는다.\",\"2\":\"필수과제는 연령 집단마다 다르게 구성되며, 낱말그림·따라말하기·문장그림·읽기·이야기그림·말하기그림 등 여러 과제가 쓰인다. 읽기와 대화 두 가지로만 구성되지 않는다.\",\"4\":\"P-FA-II는 점수를 연령 집단별 규준에 비추어 백분위 점수로 제시하고 이를 바탕으로 중증도를 해석한다.\",\"5\":\"P-FA-II는 구어 평가(핵심행동)와 함께 부수행동도 평가하여 점수에 반영한다.\"}},\"2-1-1-45\":{\"p\":\"말더듬 음절 백분율(%SS, percent syllables stuttered)은 발화 표본의 전체 음절 수 중 말더듬이 나타난 음절이 차지하는 비율이다. 공식은 %SS = (말더듬 음절 수 ÷ 전체 음절 수) × 100이므로 15 ÷ 250 × 100 = 0.06 × 100 = 6 %SS이다. 검산하면 250음절의 6 %는 250 × 0.06 = 15음절로 지문의 말더듬 음절 수와 일치한다. 같은 음절에서 여러 번 반복되어도 한 음절로 한 번만 세며, 분모는 반드시 표본의 전체 음절 수를 쓴다는 점에 주의한다.\",\"w\":{\"1\":\"4 %SS는 말더듬 음절을 10음절로 잘못 세었을 때(10 ÷ 250 × 100) 나오는 값이다. 지문의 말더듬 음절 수는 15음절이다.\",\"2\":\"5 %SS는 분모를 300음절로 잘못 잡았을 때(15 ÷ 300 × 100) 나오는 값이다. 전체 음절 수는 250음절이다.\",\"3\":\"15 %SS는 말더듬 음절 수 15를 전체 음절 수로 나누지 않고 그대로 백분율로 쓴 값이다.\",\"4\":\"7.5 %SS는 분모를 200음절로 잘못 잡았을 때(15 ÷ 200 × 100) 나오는 값이다. 분모는 표본의 전체 음절 수 250이다.\"}},\"2-1-1-46\":{\"p\":\"SSI-4(Stuttering Severity Instrument-4, Riley)는 빈도, 지속시간, 신체적 부수행동의 세 영역 점수를 합해 말더듬 중증도를 구한다. 지속시간 영역은 발화 표본에서 가장 긴 말더듬 순간 3개를 골라 그 지속시간(초)을 평균한 뒤 척도 점수로 바꾼다. 모든 말더듬을 평균하면 짧은 반복이 많을수록 값이 낮아져 심한 막힘의 정도가 묻히므로, 가장 긴 3개를 쓰는 방식으로 말더듬의 심한 정도를 반영한다. 빈도는 %SS, 신체적 부수행동은 산만한 소리·얼굴 찡그림·머리 움직임·사지 움직임 등을 평정한다.\",\"w\":{\"2\":\"가장 짧은 말더듬 순간 하나만 쓰면 말더듬의 심한 정도를 반영하지 못한다. SSI-4는 가장 긴 3개의 평균을 사용한다.\",\"3\":\"전체 발화 시간 중 말더듬 시간 비율은 SSI-4의 지속시간 산출 방식이 아니다. SSI-4는 가장 긴 말더듬 순간 3개의 평균 지속시간을 쓴다.\",\"4\":\"모든 말더듬 순간을 평균하는 방식이 아니라, 가장 긴 3개만 골라 평균한다.\",\"5\":\"모든 말더듬 순간의 지속시간을 합산하면 표본 길이에 따라 값이 달라진다. SSI-4는 가장 긴 3개의 평균을 사용한다.\"}},\"2-1-1-47\":{\"p\":\"지문은 겉으로 드러나는 말더듬 행동이 아니라 화자가 느끼는 정서·행동적 반응, 일상 의사소통의 어려움, 삶의 질에 미치는 영향을 '자기보고'로 평가하려 한다는 점이 핵심 단서이다. OASES(Overall Assessment of the Speaker's Experience of Stuttering, Yaruss와 Quesal)는 일반 정보, 말더듬에 대한 반응, 일상 의사소통 상황, 삶의 질의 네 영역으로 구성된 자기보고식 질문지로, 말더듬이 화자의 삶 전반에 주는 영향을 측정한다. 이처럼 말더듬 평가는 외현적 행동(빈도·지속시간·부수행동)과 내면적 측면(감정·태도·삶의 질)을 모두 평가해야 하며, 문항이 어느 쪽을 묻는지 먼저 구분하면 된다.\",\"w\":{\"2\":\"P-FA-II 필수과제는 연령별 말하기 과제로 구어 비유창성을 관찰·분석하는 부분이다. 삶의 질 등 말더듬 경험 전반을 자기보고로 평가하는 도구가 아니다.\",\"3\":\"%SS는 발화 표본에서 말더듬 음절의 비율을 구하는 외현적 빈도 측정치이다. 정서 반응이나 삶의 질은 반영하지 못한다.\",\"4\":\"SSI-4는 빈도·지속시간·신체적 부수행동으로 외현적 말더듬 중증도를 측정하는 검사로, 자기보고식 도구가 아니다.\",\"5\":\"KOCS는 아동용 말더듬 검사로, 성인의 말더듬 경험과 삶의 질을 자기보고로 평가하는 도구가 아니다.\"}},\"2-1-1-48\":{\"p\":\"단위반복수(number of repetition units)는 목표 낱말을 끝내 산출하기 전에 반복된 단위가 몇 번 나왔는지를 센 값이다. '책책책상'에서 목표 낱말은 '책상'이고, 마지막 '책상'의 '책'은 목표 낱말을 정상적으로 산출한 부분이므로 반복 단위가 아니다. 그 앞에 덧붙은 '책'이 두 번이므로 단위반복수는 2이다. 검산하면 '책(반복1) 책(반복2) 책상(목표 낱말)'으로 나누어 반복 단위가 2개임을 확인할 수 있다. 단위반복수가 많을수록(일반적으로 2회 이상) 말더듬 가능성이 높아지는 지표로 쓰인다.\",\"w\":{\"2\":\"1은 반복된 '책' 두 개 중 하나만 센 값이다. 목표 낱말 앞에 덧붙은 '책'은 두 번이다.\",\"3\":\"3은 산출된 '책' 음절을 목표 낱말 속 '책'까지 모두 센 값이다. 목표 낱말 '책상'의 '책'은 반복 단위에 넣지 않는다.\",\"4\":\"4는 '책책책상'의 전체 음절 수이다. 단위반복수는 음절 수가 아니라 목표 낱말 앞에서 반복된 단위의 횟수이다.\",\"5\":\"5는 발화에서 근거를 찾을 수 없는 값이다. 목표 낱말 앞에 반복된 '책'은 두 번뿐이다.\"}},\"2-1-1-49\":{\"p\":\"말속도는 계산에 무엇을 포함하느냐에 따라 두 가지로 나뉜다. 전체 말속도(overall speech rate)는 쉼, 주저, 말더듬 시간까지 모두 포함한 전체 발화 시간으로 산출하고, 조음속도(articulation rate)는 쉼과 비유창성 시간을 빼고 실제로 유창하게 말소리를 산출한 시간만으로 산출한다. 분모가 되는 시간이 조음속도 쪽이 더 짧으므로, 같은 발화에서 조음속도는 전체 말속도보다 같거나 빠르게 나온다. 단위는 초당 음절 수(SPS), 분당 음절 수(SPM), 분당 낱말 수(WPM) 등을 쓸 수 있으며, 한국어에서는 음절 단위가 흔히 쓰인다.\",\"w\":{\"1\":\"쉼 시간을 제외하는 것은 조음속도이다. 전체 말속도는 쉼을 포함한 전체 발화 시간을 기준으로 산출한다.\",\"3\":\"말속도는 분당 낱말 수(WPM)뿐 아니라 초당 음절 수(SPS), 분당 음절 수(SPM) 등으로도 측정할 수 있다.\",\"4\":\"조음속도는 쉼과 비유창성 시간을 뺀 짧은 시간을 분모로 하므로 전체 말속도보다 같거나 빠르게 나온다.\",\"5\":\"조음속도는 말더듬 등 비유창성에 쓰인 시간을 제외하고 산출한다. 말더듬 시간을 포함하는 것은 전체 말속도이다.\"}},\"2-1-1-50\":{\"p\":\"Yairi와 Ambrose는 학령전 아동의 비유창성을 진성 비유창성(SLD: 낱말부분 반복, 1음절 낱말 반복, 비운율적 발성)과 기타 비유창성(OD)으로 나누고, 100음절당 SLD가 3회 이상이면 말더듬으로 판단하는 기준을 제시하였다. 이 기준은 전체 비유창성이 아니라 SLD만 센다는 점이 중요하다. 간투사·수정 등 OD는 일반 아동에게도 많기 때문에 이를 포함하면 정상 아동이 말더듬으로 잘못 판정될 수 있다. 판단 기준은 연구자와 검사마다 다르므로(예: Guitar의 경계선급 기준은 100낱말당 10회 이상), 문항이 어떤 학자·단위(음절/낱말)를 기준으로 하는지 확인해야 한다.\",\"w\":{\"2\":\"100음절당 2회는 Yairi와 Ambrose가 제시한 판단 기준(3회 이상)보다 낮은 값이다.\",\"3\":\"100음절당 1회는 일반 아동에게서도 흔히 나타나는 수준으로, 말더듬 판단 기준이 아니다.\",\"4\":\"100음절당 5회는 Yairi와 Ambrose의 판단 기준(3회 이상)보다 높은 값이다.\",\"5\":\"10회는 Guitar가 경계선급 말더듬의 특징으로 제시한 빈도(대략 100낱말당 10회 이상)와 혼동한 값으로, 단위와 학자가 다르다.\"}},\"2-1-1-51\":{\"p\":\"말더듬수정법(stuttering modification, Van Riper)은 말더듬을 없애기보다 말더듬 순간을 확인하고, 두려움에 둔감해지고, 막힘을 더 쉽고 짧게 더듬도록 수정하는 접근이다. 말더듬에 대한 두려움·회피·부정적 태도를 줄이는 것을 중요한 목표로 삼으며, 최종 목표로 자발 유창성이 어렵다면 조절 유창성 또는 수용 가능한 말더듬(acceptable stuttering)을 인정한다. 유창성완성법(fluency shaping)은 느린 말속도, 부드러운 발성 시작, 가벼운 조음접촉 등 새로운 말하기 방식을 학습해 유창한 말을 산출하도록 하며 감정·태도는 상대적으로 덜 다룬다. 실제 임상에서는 두 접근을 통합해 쓰는 경우가 많다.\",\"w\":{\"1\":\"수용 가능한 말더듬을 최종 목표에 포함하는 것은 말더듬수정법이다. 유창성완성법은 새 말하기 방식으로 유창한 말(자발 또는 조절 유창성)을 산출하는 것을 목표로 한다.\",\"2\":\"느린 말속도·부드러운 발성 등 새로운 말하기 방식을 모든 발화에 적용하는 것은 유창성완성법이다. 말더듬수정법은 말더듬이 일어나는 순간을 다룬다.\",\"4\":\"말더듬수정법은 부수행동과 두려움·회피 등 정서·태도를 핵심적으로 다루며, 유창성완성법도 부차적으로는 다룬다.\",\"5\":\"말더듬에 대한 감정·태도 변화를 우선 목표로 하는 것은 말더듬수정법이다. 유창성완성법은 말 산출 방식의 변화를 우선한다.\"}},\"2-1-1-52\":{\"p\":\"Van Riper의 말더듬수정법은 영문 머리글자를 따 MIDVAS로 기억하기도 한다(Motivation 동기 부여 후 Identification 확인 → Desensitization 둔감 → Variation 변형 → Approximation 접근·수정 → Stabilization 안정). 먼저 자신이 언제 어떻게 더듬는지 정확히 알아차리고(확인), 말더듬과 청자 반응에 대한 두려움을 줄인 뒤(둔감), 말더듬 형태를 일부러 바꾸어 보며 스스로 통제할 수 있음을 경험한다(변형). 그다음 취소·빠져나오기·준비하기로 더 쉽게 더듬는 법을 익히고(수정), 이를 일상에서 스스로 유지한다(안정). 앞 단계가 뒤 단계의 기반이 되므로 '인식 → 두려움 감소 → 변화 경험 → 수정 기법 → 유지'의 논리로 순서를 이해하면 된다.\",\"w\":{\"1\":\"둔감은 자신의 말더듬을 확인한 뒤에 진행한다. 무엇에 둔감해질지 알기 위해 확인 단계가 먼저 와야 한다.\",\"2\":\"변형은 두려움을 줄이는 둔감 단계 뒤에 온다. 두려움이 큰 상태에서는 말더듬을 의도적으로 바꾸어 보기 어렵다.\",\"3\":\"수정과 변형의 순서가 바뀌었다. 말더듬을 의도적으로 바꾸어 통제 가능성을 경험하는 변형 단계가 수정(접근) 단계보다 먼저이다.\",\"4\":\"변형이 맨 앞에 올 수 없다. 자신의 말더듬을 먼저 확인하고 두려움을 줄인 뒤에야 의도적으로 형태를 바꿀 수 있다.\"}},\"2-1-1-53\":{\"p\":\"빠져나오기(pull-out)는 말더듬이 진행되는 도중에 멈추거나 처음으로 되돌아가지 않고, 막힌 상태에서 긴장을 서서히 풀며 소리를 부드럽게 늘여 낱말을 끝까지 완성하는 기법이다. 지문의 단서는 '막힘이 나타나자', '멈추거나 되돌아가지 않고', '막힌 상태에서 긴장을 풀며'로, 말더듬 '도중'에 수정했다는 점이다. 말더듬수정법의 수정 기법은 시점으로 구분하면 쉽다. 말더듬이 끝난 '후'에 다시 말하는 것은 취소, 말더듬 '도중'에 수정하는 것은 빠져나오기, 말더듬이 일어나기 '전'에 미리 부드럽게 접근하는 것은 준비하기이다.\",\"w\":{\"1\":\"준비하기는 더듬을 것이 예상되는 낱말 앞에서 말더듬이 일어나기 전에 미리 긴장을 풀고 부드럽게 접근하는 기법이다. 지문은 막힘이 이미 시작된 도중에 수정했다.\",\"2\":\"취소는 더듬은 낱말을 끝낸 뒤 잠시 멈추고 그 낱말을 다시 편안하게 말하는 기법이다. 지문에서는 멈추거나 되돌아가지 않았다.\",\"4\":\"가벼운 조음접촉은 조음기관을 가볍게 맞닿게 하여 말하는 유창성완성법의 기법이다. 막힘 도중 빠져나오는 말더듬수정법 기법이 아니다.\",\"5\":\"지연청각피드백(DAF)은 자기 목소리를 약간 늦게 들려주어 말속도를 늦추는 기기 활용법이다. 지문처럼 화자가 막힘 도중 긴장을 풀어 수정하는 기법이 아니다.\"}},\"2-1-1-54\":{\"p\":\"리드콤 프로그램(Lidcombe Program)은 호주에서 개발된 학령전 말더듬 아동용 행동주의(조작적 조건화) 직접치료이다. 치료사에게 훈련받은 부모가 가정의 일상 대화에서 아동의 유창한 말에는 칭찬·인정·자기평가 요청을, 더듬은 말에는 가끔 부드럽게 인정하거나 다시 말해 보게 하는 구어 수반 자극(verbal contingencies)을 준다. 부모는 매일 말더듬 중증도를 평정(SR)하고 치료사는 %SS로 경과를 확인하며, 목표 기준에 도달하면 유지 단계로 넘어간다. 아동에게 새로운 말하기 방식을 가르치지 않고, 부모가 직접 아동의 말에 반응한다는 점에서 간접치료와도 구별된다.\",\"w\":{\"1\":\"느린 말속도·부드러운 발성 같은 새 말하기 방식을 직접 훈련하는 것은 유창성완성법이다. 리드콤은 말하기 방식을 가르치지 않고 부모의 구어 수반 자극을 사용한다.\",\"2\":\"리드콤에서는 더듬은 말에 대해서도 부드럽게 인정하거나 다시 말해 보게 하는 수반 자극을 가끔 준다. 말더듬을 전혀 언급하지 않는 것이 원칙이 아니다.\",\"3\":\"부모의 말속도와 가정 환경을 조정하는 것은 요구-용량 모델에 근거한 간접치료이다. 리드콤은 부모가 아동의 말 자체에 반응하는 직접치료이다.\",\"4\":\"리드콤은 주로 6세 미만 학령전 아동을 위해 개발된 프로그램이다. 학령기 이상 아동과 성인에게는 다른 접근이 주로 쓰인다.\"}},\"2-1-1-55\":{\"p\":\"지문 단서는 ① 3세 2개월의 학령전 아동, ② 발병 3개월로 초기, ③ 긴장 없는 낱말부분 반복, ④ 자신의 말을 의식하지 않음, ⑤ 부모의 빠른 말속도와 잦은 질문이다. 인식과 긴장이 없는 초기 아동에게는 말더듬을 의식하게 만들지 않으면서 환경적 요구를 줄이는 간접치료를 먼저 고려한다. 요구-용량 모델에 따르면 부모의 빠른 말속도와 많은 질문은 아동의 말 산출 용량에 부담을 주는 요구이므로, 부모 교육으로 말속도를 늦추고 질문을 줄이며 대화 차례를 여유 있게 주게 한다. 이후 경과를 관찰해 비유창성이 줄지 않거나 긴장·인식이 생기면 리드콤 같은 직접치료로 전환을 검토한다.\",\"w\":{\"1\":\"둔감화는 말더듬에 대한 두려움을 이미 가진 대상자에게 쓰는 말더듬수정법 단계이다. 말더듬을 의식하지 않는 3세 아동에게 직접 실시할 필요가 없다.\",\"2\":\"취소·빠져나오기는 말더듬을 인식하는 학령기 이상 대상자에게 쓰는 말더듬수정법 기법이다. 인식이 없는 초기 학령전 아동에게 우선 적용하기에는 적절하지 않다.\",\"4\":\"지연청각피드백은 주로 청소년·성인에게 말속도를 늦추기 위해 쓰는 기기이다. 발병 초기 학령전 아동의 우선 접근으로 적절하지 않다.\",\"5\":\"말더듬을 의도적으로 흉내 내게 하는 것은 인식이 있는 대상자의 둔감화·변형 활동이다. 인식이 없는 아동에게 말더듬을 의식시키는 것은 이 단계에서 피해야 한다.\"}},\"2-1-1-56\":{\"p\":\"윤상연골(cricoid cartilage)은 앞쪽은 좁은 활(arch), 뒤쪽은 넓은 판(lamina)으로 된 반지 모양이며, 후두 연골 가운데 기도 둘레를 360° 모두 감싸는 유일한 완전 고리이다. 기관 연골은 뒤쪽이 열린 C자형이라는 점과 비교하면 기억하기 쉽다. 윤상연골 판 위에는 피열연골이 얹혀 윤상피열관절을, 옆면에는 갑상연골 하각이 붙어 윤상갑상관절을 이루므로 후두 골격의 받침대 역할을 한다. 후두 연골은 단일 연골 3개(갑상·윤상·후두개)와 쌍 연골 3쌍(피열·소각·설상)으로 정리한다.\",\"w\":{\"1\":\"갑상연골은 좌우 두 판(lamina)이 앞쪽 정중선에서 융합해 후두융기(Adam's apple)를 이루는 단일 연골이다. 좌우 한 쌍으로 된 것은 피열연골·소각연골·설상연골이다.\",\"2\":\"피열연골은 윤상연골 판의 위쪽 뒷면에 얹혀 윤상피열관절을 이룬다. 갑상연골 앞쪽 내면에는 성대의 앞끝(전연합)이 붙을 뿐 피열연골과의 관절은 없다.\",\"4\":\"후두개는 탄력연골(elastic cartilage)이라 나이가 들어도 골화가 거의 일어나지 않는다. 나이 들며 골화가 진행되는 것은 유리연골인 갑상연골·윤상연골·피열연골(대부분)이다.\",\"5\":\"설골(hyoid bone)은 연골이 아닌 뼈로, 갑상설골막을 통해 후두를 위에서 매달아 주는 구조이며 후두 연골에 포함되지 않는다. 후두 골격에서 가장 위에 있는 연골은 후두개이다.\"}},\"2-1-1-57\":{\"p\":\"윤상갑상근(cricothyroid, CT)은 윤상연골 앞쪽과 갑상연골 사이를 잇는 근육으로, 수축하면 갑상연골이 앞아래로 기울어(또는 윤상연골 앞부분이 들려) 갑상연골과 피열연골 사이 거리가 멀어진다. 그 결과 성대가 길어지고 얇아지며 긴장이 높아져 기본주파수가 올라가므로 대표적인 음도 상승 근육이다. 후두 내근 중 유일하게 상후두신경 외지의 지배를 받는다는 점도 함께 기억한다. 외전근은 후윤상피열근 하나뿐이고, 나머지(측윤상피열근, 횡·사피열근, 갑상피열근)는 내전 또는 긴장 조절에 관여한다.\",\"w\":{\"2\":\"측윤상피열근(LCA)은 피열연골 근육돌기를 앞으로 당겨 성대돌기를 안쪽으로 돌리는 내전근이다. 외전 작용과 짝지은 것이 틀렸다.\",\"3\":\"후윤상피열근(PCA)은 근육돌기를 뒤로 당겨 성대돌기를 바깥으로 돌리는 후두 내근 중 유일한 외전근이다. 내전과 짝지은 것은 반대로 연결한 것이다.\",\"4\":\"갑상피열근(TA, 성대근)은 성대 몸체를 이루며 수축하면 성대를 짧고 두껍게 만들고 내전을 돕는다. 성문을 여는 근육은 후윤상피열근이다.\",\"5\":\"횡피열근은 좌우 피열연골을 서로 끌어당겨 성문 후방(연골성 성문)을 닫는 내전근이다. 성대를 늘이는(신장) 작용은 윤상갑상근의 몫이다.\"}},\"2-1-1-58\":{\"p\":\"상후두신경(superior laryngeal nerve)은 미주신경(10번)의 가지로 내지(internal branch)와 외지(external branch)로 나뉜다. 내지는 갑상설골막을 뚫고 들어가 성문 상부(후두개·가성대 등) 점막의 감각을 담당하며, 이 감각은 기침 반사 등 기도 보호에 중요하다. 외지는 운동신경으로 윤상갑상근만 지배한다. 되돌이후두신경은 윤상갑상근을 제외한 모든 후두 내근의 운동과 성문 하부의 감각을 담당한다는 점과 구분해야 한다.\",\"w\":{\"1\":\"상후두신경 외지가 지배하는 근육은 윤상갑상근 하나이다. 후윤상피열근은 되돌이후두신경의 지배를 받는다.\",\"2\":\"왼쪽 되돌이후두신경은 대동맥궁 아래를 돌아 올라오고 오른쪽은 쇄골하동맥을 돌아 올라오므로, 왼쪽의 주행 경로가 더 길다. 그래서 흉부 수술·종양 등으로 왼쪽이 더 잘 손상된다.\",\"3\":\"되돌이후두신경은 윤상갑상근을 제외한 모든 후두 내근을 지배한다. 윤상갑상근만 지배하는 것은 상후두신경 외지이므로 두 신경을 뒤바꾼 설명이다.\",\"5\":\"되돌이후두신경은 미주신경(10번 뇌신경)의 가지이다. 설인신경(9번)은 혀 뒤쪽 1/3의 미각·감각과 인두 감각 등에 관여하며 후두 내근을 지배하지 않는다.\"}},\"2-1-1-59\":{\"p\":\"Hirano의 몸체-덮개 모형(body-cover model)은 성대를 층 구조로 나누어, 덮개(cover)는 상피와 고유층 표층(라인케 공간), 이행부(transition)는 고유층 중간층·심층(=성대인대), 몸체(body)는 갑상피열근(성대근)으로 본다. 덮개는 느슨하고 유연해서 몸체 위를 미끄러지듯 움직이며 점막파동(mucosal wave)을 만든다. 따라서 상피와 고유층 표층이 덮개라는 설명이 옳다. 교재에 따라 이행부를 덮개 쪽에 묶어 상피+표층+중간층을 덮개로 설명하기도 하므로, 핵심은 상피와 표층이 덮개에 속한다는 점이다.\",\"w\":{\"1\":\"점막파동은 유연한 덮개(상피와 고유층 표층)가 몸체 위를 물결치듯 움직이며 생긴다. 성대근(몸체)은 긴장도를 조절할 뿐 점막파동의 주된 발생 부위가 아니다.\",\"2\":\"갑상피열근(성대근)은 몸체(body)에 해당한다. 덮개는 상피와 고유층 표층이다.\",\"3\":\"성대인대는 고유층 중간층과 심층으로 이루어진 이행부이다. 상피 바로 아래의 고유층 표층은 라인케 공간이다.\",\"4\":\"라인케 공간은 상피 바로 아래의 고유층 표층에 있다. 성대근과 맞닿은 고유층 심층은 콜라겐 섬유가 많은 성대인대의 일부이다.\"}},\"2-1-1-60\":{\"p\":\"음성 강도는 주로 성문하압(subglottal pressure)과 성문 저항(성대 내전의 세기)으로 조절된다. 성대를 더 단단히 붙이고 성문하압을 높이면 성대가 열릴 때 더 많은 공기가 빠르게 방출되고, 닫힐 때도 더 빠르고 강하게 닫히면서 한 주기 안에서 폐쇄기(closed phase)의 비율(폐쇄지수)이 길어진다. 이 급격한 기류 차단이 음향 에너지를 키워 강도가 올라간다. 음도 상승이 주로 성대 길이·긴장(윤상갑상근)으로 조절되는 것과 구분하여, 강도는 성문하압·내전·폐쇄기로 기억한다.\",\"w\":{\"1\":\"성문하압 감소와 성대 긴장 저하는 강도를 낮추는 쪽의 변화이다. 강도를 높이려면 성문하압이 증가해야 한다.\",\"2\":\"개방기가 길어지고 폐쇄기가 짧아지는 것은 작은 소리나 기식성 음성에서 보이는 양상이다. 강도가 커지면 반대로 폐쇄기가 길어진다.\",\"4\":\"강도가 커지면 성대 진동 진폭은 커지고 폐쇄는 더 단단해진다. 진폭 감소와 약한 폐쇄는 작은 소리에서의 변화이다.\",\"5\":\"성대 접촉이 느슨해지면 성문 저항이 줄어 공기가 새는 기식성 음성이 되며 강도는 오히려 떨어진다. 강도 증가에는 더 단단한 성대 접촉이 필요하다.\"}},\"2-1-1-61\":{\"p\":\"GRBAS는 Hirano가 제안한 청지각적 평정 척도로 G(Grade, 전반적 중증도), R(Rough, 거친소리), B(Breathy, 바람새는소리), A(Asthenic, 무력성), S(Strained, 쥐어짜는소리)를 각각 0=정상, 1=경도, 2=중등도, 3=심도로 평정한다. 이 결과에서 B2이므로 바람새는소리가 중등도로 지각된다는 해석이 옳다. 전반적 중증도 G2(중등도)는 가장 두드러진 B2와 일치하고, R1은 경도로 함께 있으나 B보다 약하며, A0·S0은 무력성과 쥐어짜는소리가 없음을 뜻한다. 이 프로파일은 성문 폐쇄부전(성대마비, 병변 등)으로 공기가 새는 음성을 떠올리게 한다.\",\"w\":{\"1\":\"G2는 전반적 중증도가 중등도라는 뜻이다. 경도는 G1이다.\",\"2\":\"R1(경도)보다 B2(중등도)의 점수가 높으므로 바람새는소리가 거친소리보다 더 두드러진다. 두 항목의 관계를 반대로 읽은 것이다.\",\"3\":\"S0이므로 쥐어짜는소리는 관찰되지 않는다. 중등도라면 S2로 기록되어야 한다.\",\"5\":\"A0이므로 무력성은 관찰되지 않는다. 경도의 무력성은 A1로 기록된다.\"}},\"2-1-1-62\":{\"p\":\"CAPE-V는 미국말언어청각협회(ASHA)가 중심이 되어 만든 표준화 청지각적 평가로, 평가자가 지속 모음(/a/, /i/), 6개의 표준 문장, 자발화를 듣고 6개 항목(전반적 중증도, 거친소리, 바람새는소리, 쥐어짜는소리, 음도, 강도)을 100mm 시각아날로그척도(VAS)에 표시하여 0~100점으로 점수화한다. 각 특성이 지속적(C)인지 간헐적(I)인지도 함께 표시하며, 공명 등 기타 특성을 추가로 기록할 수 있다. 연속 척도라 작은 변화도 민감하게 잡아낼 수 있다는 점이 4점 서열척도인 GRBAS와의 핵심 차이이다.\",\"w\":{\"1\":\"0~3점의 4점 척도로 평정하는 것은 GRBAS의 방식이다. CAPE-V는 100mm 시각아날로그척도(0~100)를 쓴다.\",\"3\":\"CAPE-V는 지속 모음뿐 아니라 표준 문장 읽기와 자발화까지 함께 듣고 평정한다. 지속 모음만으로는 연결발화에서 나타나는 음성 특성을 놓칠 수 있다.\",\"4\":\"환자가 스스로 음성 문제의 심각도와 영향을 보고하는 것은 VHI, V-RQOL 같은 자기보고 도구이다. CAPE-V는 평가자(임상가)가 듣고 평정하는 청지각적 평가이다.\",\"5\":\"CAPE-V 점수는 평가자가 듣고 척도 위에 직접 표시해 매기는 주관적 평정값이다. 소프트웨어가 자동 산출하는 것은 jitter, shimmer, HNR 같은 음향 분석 지표이다.\"}},\"2-1-1-63\":{\"p\":\"pVHI(Pediatric Voice Handicap Index)는 성인용 VHI를 아동용으로 수정한 도구로, 부모(보호자)가 아동의 음성 문제가 기능적·신체적·정서적 영역에서 일상생활에 미치는 영향을 대신 보고한다. 지문의 단서는 대상이 6세 아동이라는 점, 그리고 음성 문제의 일상·학교생활 영향을 보호자 보고로 파악하려 한다는 점이다. 6세 아동은 문항을 읽고 자기 음성의 영향을 스스로 평정하기 어려우므로 보호자 보고형 도구가 필요하다. 이처럼 도구 선택 문항은 누가 응답하는지(본인·보호자·평가자)와 무엇을 측정하는지(영향·삶의 질·피로·음질)를 함께 따져야 한다.\",\"w\":{\"1\":\"VHI-30은 성인 환자 본인이 기능·신체·정서 영역의 음성 장애 정도를 스스로 보고하는 도구이다. 6세 아동에 대한 보호자 보고 목적에는 맞지 않는다.\",\"3\":\"음성피로도 검사(VFI)는 성인이 음성 사용 후 느끼는 피로·신체 불편감과 휴식 후 회복을 스스로 보고하는 도구이다. 아동의 일상생활 영향을 보호자가 보고하는 도구가 아니다.\",\"4\":\"V-RQOL은 성인 본인이 음성과 관련된 삶의 질을 짧은 문항으로 스스로 평정하는 도구이다. 보호자 보고형 아동 도구가 아니다.\",\"5\":\"GRBAS는 평가자가 음성을 듣고 음질을 평정하는 청지각적 척도이다. 음성 문제가 일상생활에 미치는 영향이나 보호자의 보고를 담지 않는다.\"}},\"2-1-1-64\":{\"p\":\"기본주파수(F0, fundamental frequency)는 성대가 1초 동안 진동하는 횟수로 단위는 Hz이며, 청지각적으로는 음도(pitch)에 대응한다. 예를 들어 1초에 200번 진동하면 F0는 200 Hz이고 한 주기는 1/200초(5 ms)이다. 일반적으로 성인 남성은 약 100~150 Hz, 성인 여성은 약 200~250 Hz 범위로 알려져 있으나 교재와 측정 과제에 따라 수치는 다소 다르다. 함께 나오는 jitter(주기 변동)·shimmer(진폭 변동)·HNR(배음 대 잡음)은 음질을 나타내는 섭동·잡음 지표라는 점에서 F0와 구분된다.\",\"w\":{\"1\":\"jitter(주파수변동률)는 인접 주기 사이 주기(주파수)의 단기 변동이다. 인접 주기 간 진폭의 변동은 shimmer에 대한 설명이므로 서로 바꿔 놓았다.\",\"2\":\"shimmer(진폭변동률)는 인접 주기 사이 진폭의 단기 변동이다. 기본주파수의 변동은 jitter에 대한 설명이다.\",\"3\":\"HNR은 배음(규칙적 성분) 에너지를 잡음 에너지로 나눈 비율이라 값이 클수록 배음이 많고 잡음이 적어 음질이 좋다. 값이 클수록 잡음이 많다는 것은 반대로 해석한 것이다.\",\"4\":\"발화기본주파수(SFF, speaking fundamental frequency)는 읽기나 대화 같은 연결발화에서 측정한 평균 F0이다. 지속 모음에서 낼 수 있는 최고 음도는 음도 범위(최고음) 측정에 해당한다.\"}},\"2-1-1-65\":{\"p\":\"s/z 비율 = /s/ 최대지속시간 ÷ /z/ 최대지속시간 = 22초 ÷ 11초 = 2.0이다(검산: 11 × 2.0 = 22). 무성음 /s/는 성대 진동 없이 호흡 지지만으로 유지되고, 유성음 /z/는 호흡에 더해 성대 진동(성문 폐쇄)이 필요하다. /s/가 22초로 충분히 길다면 호흡 능력은 보존된 것이고, /z/만 절반으로 짧다면 발성 중 성문에서 공기가 새는 것이므로 결절·폴립 등 성대 병변에 의한 폐쇄부전을 의심할 수 있다. 일반적으로 정상은 1.0 전후이고 약 1.4 이상이면 성대 병리를 의심한다고 하나, 기준값은 교재에 따라 다르고 이 비율만으로 진단하지 않으므로 후두내시경 등으로 확인해야 한다. 음성을 많이 쓰는 교사라는 직업 정보도 성대 병변 가능성을 뒷받침한다.\",\"w\":{\"1\":\"비율 계산(2.0)은 맞지만 해석이 틀렸다. 호흡 지지가 부족하면 /s/와 /z/가 모두 짧아져 비율은 1.0 근처에 머물며, 이 사례는 /s/가 22초로 충분히 길어 호흡 문제로 보기 어렵다.\",\"2\":\"s/z 비율은 호흡과 성문 효율(성대 폐쇄)을 보는 지표이지 공명을 평가하는 지표가 아니다. 공명 문제는 비성도 측정이나 청지각적 공명 평가로 확인한다.\",\"3\":\"0.5는 분모와 분자를 바꿔 /z/ ÷ /s/(11 ÷ 22)로 계산한 값이다. 올바른 계산은 /s/ ÷ /z/ = 2.0이며 정상 범위를 벗어나므로 추가 평가가 필요하다.\",\"5\":\"/s/ 22초는 성인에서 짧지 않은 값이고 짧아진 것은 /z/뿐이다. 두 음이 모두 짧다는 전제가 지문 수치와 맞지 않으므로 폐활량 저하로 해석할 수 없다.\"}},\"2-1-1-66\":{\"p\":\"후두스트로보스코피(videostroboscopy)는 성대 진동 주파수(F0)와 약간 다른 주기로 섬광을 비추어, 연속된 여러 진동 주기에서 조금씩 다른 위상을 잘라 이어 붙인 느린 가상 움직임을 보여 준다. 이를 통해 점막파동, 진동 진폭, 성문폐쇄 양상, 좌우 대칭성, 주기성, 비진동 부위 등을 평가한다. 특히 점막파동의 감소·소실은 낭종·반흔·성대구증처럼 덮개층이 굳은 병변을 감별하는 중요한 단서이다. 진동이 비주기적일수록 영상이 왜곡된다는 한계가 있어, 이 경우 실제 주기를 그대로 찍는 고속 촬영(high-speed videoendoscopy)이나 kymography가 보완책이 된다.\",\"w\":{\"2\":\"스트로보스코피는 마이크나 EGG로 기본주파수를 추적해 섬광 주기를 맞춰야 한다. 임의의 빛 주기로 촬영하면 의미 있는 슬로모션 영상을 얻을 수 없다.\",\"3\":\"스트로보스코피 영상은 여러 주기의 조각을 합성한 가상 영상이다. 실제 진동 주기를 하나하나 그대로 보여 주는 것은 고속 촬영(high-speed videoendoscopy)이다.\",\"4\":\"주파수 추적과 동기화가 필요하므로 심하게 비주기적인 음성일수록 영상이 흔들리고 신뢰도가 떨어진다. 주기적인 음성에서 정확한 영상을 얻는다.\",\"5\":\"성대 접촉 면적의 변화를 전기 저항(임피던스) 신호로 기록하는 것은 전기성문파형검사(EGG, electroglottography)이다. 스트로보스코피는 시각적 관찰 검사이다.\"}},\"2-1-1-67\":{\"p\":\"성대결절(vocal nodules)은 음성 남용·오용으로 성대가 반복해서 부딪히는 충격이 가장 큰 지점, 즉 막성 성대의 앞쪽 1/3과 중간 1/3 경계에 양측 대칭으로 생기는 작은 융기이다. 지문의 핵심 단서는 양측·대칭·앞 1/3과 중간 1/3 경계라는 위치, 그리고 두 융기가 맞닿으며 그 앞뒤로 틈이 남는 모래시계형(hourglass) 폐쇄 양상이다. 초기의 부드러운 결절은 음성위생과 음성치료로 호전되는 경우가 많아 치료 계획에서도 다른 병변과 구별된다. 교사·아동 등 목을 많이 쓰는 집단에서 흔하다는 점도 판단에 도움이 된다.\",\"w\":{\"1\":\"성대폴립은 대개 한쪽 성대에 생기는 부드럽고 혈관이 많은 종괴로, 크기가 다양하고 갑작스러운 음성 남용 뒤에 생기기도 한다. 양측 대칭의 작은 융기라는 지문과 맞지 않는다.\",\"3\":\"성대낭종은 주로 한쪽 성대의 고유층 안에 생기는 주머니 모양 병변으로, 반대쪽에 반응성 병변이 생기기도 하지만 대칭적이지 않고 점막파동이 감소하는 것이 특징이다. 양측 대칭 융기와 모래시계형 폐쇄의 전형과는 다르다.\",\"4\":\"라인케부종은 양측 성대 전체가 미만성으로 물주머니처럼 붓는 병변으로, 국소적인 작은 융기가 아니다. 주로 장기 흡연과 관련되고 음도가 크게 낮아진다.\",\"5\":\"후두횡격막(laryngeal web)은 양측 성대 앞쪽이 막으로 붙어 있는 상태로, 성문 앞부분이 막혀 보인다. 성대 가장자리의 대칭적 융기와 모래시계형 폐쇄 소견과 다르다.\"}},\"2-1-1-68\":{\"p\":\"라인케부종(Reinke's edema, 폴립양 퇴행)은 고유층 표층인 라인케 공간에 부종액이 차서 양측 성대 전체가 미만성으로 물주머니처럼 부푸는 병변이다. 장기 흡연이 가장 중요한 위험 요인이며, 음성 남용과 역류도 관여할 수 있다. 성대 질량이 늘어 진동이 느려지므로 F0가 크게 낮아지고 거친 음질이 되어, 중년 여성이 전화에서 남성으로 오인되는 것이 전형적인 호소이다. 지문의 30년 이상 흡연, 낮고 굵은 목소리, 양측 성대 전체의 부종이라는 세 단서가 모두 일치한다. 치료는 금연이 우선이고 필요하면 수술을 하며, 음성치료는 보조적으로 쓴다.\",\"w\":{\"1\":\"성대결절은 앞쪽 1/3과 중간 1/3 경계의 양측 국소 융기로, 성대 전체가 붓지 않는다. 주로 음성 남용과 관련되며 음도가 이 정도로 크게 낮아지는 경우는 드물다.\",\"2\":\"접촉성 육아종은 성문 후방의 피열연골 성대돌기 부위에 생기는 병변으로, 역류·습관적 헛기침·강한 성문파열음·기관삽관 등과 관련된다. 성대 전체의 미만성 부종과 다르다.\",\"3\":\"후두유두종은 HPV 감염으로 생기는 사마귀(포도송이) 모양의 종양으로 재발이 잦다. 흡연에 의한 성대 전체의 물주머니 모양 부종과는 소견이 다르다.\",\"4\":\"성대구증(sulcus vocalis)은 성대 가장자리를 따라 생긴 홈(고랑)으로, 성문 폐쇄부전과 기식성 음성을 보인다. 부종이 아니며 흡연과의 관련도 뚜렷하지 않다.\"}},\"2-1-1-69\":{\"p\":\"재발성 호흡기 유두종증(recurrent respiratory papillomatosis, RRP)은 인유두종바이러스(HPV), 주로 저위험형인 6형과 11형의 감염으로 생기는 사마귀(포도송이) 모양의 양성 종양이다. 소아형은 출산 과정의 수직 감염과 관련된다고 알려져 있으며, 성인형도 있다. 수술(미세후두수술, 레이저 등)로 제거해도 바이러스가 남아 재발이 잦기 때문에 반복 수술이 흔하고, 항바이러스제 등 보조 치료가 쓰이기도 한다. 언어재활사는 쉰 목소리가 점점 심해지거나 호흡 시 협착음(stridor)이 있는 아동에게서 이 질환을 의심하고 신속히 이비인후과로 의뢰해야 한다.\",\"w\":{\"1\":\"후두유두종은 바이러스성 종양이라 음성치료로 병변을 없앨 수 없고 수술적 제거가 기본이다. 음성치료는 수술 후 음성 기능 회복을 돕는 보조 역할이다.\",\"2\":\"후두유두종은 소아(소아형)에서 흔하고 성인(성인형)에서도 생기며, 원인은 흡연이 아니라 HPV 감염이다. 장기 흡연 성인 남성에게만 발생한다는 설명은 틀렸다.\",\"4\":\"양성 종양이지만 빠르게 자라고 기도 여러 부위로 퍼질 수 있어, 특히 기도가 좁은 소아에서 기도 폐쇄의 위험이 있다. 그래서 반복 수술로 기도를 확보해야 한다.\",\"5\":\"후두유두종은 성대뿐 아니라 가성대·후두개·기관 등 기도 여러 곳에 다발성으로 생길 수 있다. 편측 성대 전방 1/3에 국한된다는 설명은 맞지 않는다.\"}},\"2-1-1-70\":{\"p\":\"내전형 경련성 발성장애(adductor spasmodic dysphonia)는 후두에 국한된 국소 근긴장이상증(focal dystonia)으로, 말하는 동안 성대 내전근이 불수의적으로 과도하게 수축한다. 그 결과 유성음인 모음 산출 중에 쥐어짜는 듯한 긴장된 음성과 갑작스러운 음성 끊김(voice break)이 나타나며, 성대 진동이 계속되는 유성음 문장에서 특히 두드러진다. 반대로 외전형은 무성 자음 직후 성대가 경련적으로 벌어져 기식성 끊김이 나타난다. 일차 치료는 갑상피열근(외전형은 후윤상피열근)에 보툴리눔 독소를 주입하는 것이고, 음성치료는 보조적이다.\",\"w\":{\"1\":\"무성 자음에서 성대가 경련적으로 벌어져 생기는 기식성 음성 끊김은 외전형 경련성 발성장애의 특징이다. 내전형은 모음(유성음)에서 쥐어짜는 끊김이 나타난다.\",\"2\":\"음성위생 교육은 음성 남용·오용에 의한 과기능성 음성장애의 기본 중재이다. 내전형 경련성 발성장애는 신경학적 질환이라 음성위생만으로 증상이 조절되지 않고, 보툴리눔 독소 주입이 일차 치료로 쓰인다.\",\"3\":\"경련성 발성장애는 속삭이기, 웃기, 노래하기, 높은 음도 발성처럼 일상 말과 다른 과제에서 오히려 증상이 줄어드는 과제 특이성(task specificity)을 보이는 경우가 많다. 이런 상황에서 더 심해진다는 설명은 반대이다.\",\"4\":\"과거에는 심인성으로 보기도 했으나 현재는 기저핵 등 중추신경계 이상과 관련된 국소 근긴장이상증, 즉 신경학적 음성장애로 분류한다. 심리적 갈등에서 비롯된 기능적 음성장애로는 전환 실성증 등이 있다.\"}},\"2-1-1-71\":{\"p\":\"변성발성장애(puberphonia, mutational falsetto)는 사춘기에 후두가 정상적으로 자라 성인 남성의 낮은 음도를 낼 수 있는 구조가 되었는데도, 소년기의 높은 음도(가성에 가까운 소리)를 습관적으로 계속 쓰는 기능적 음성장애이다. 지문에서 판단 단서는 세 가지이다. 변성기가 지났는데 음도가 높고, 기침이나 웃음 같은 반사적 발성에서는 낮은 음성이 나와 생리적으로 저음 산출이 가능함이 확인되며, 후두 구조와 성대 운동이 정상이라 기질적 원인이 없다. 기침이나 목 가다듬기로 낸 낮은 소리를 단서로 삼고, 후두를 손가락으로 눌러 내리는 조작(Kayser-Gutzmann법 등)을 쓰면 비교적 빨리 정상 음도로 바뀌는 경우가 많다.\",\"w\":{\"1\":\"편측 성대마비는 후두내시경에서 한쪽 성대의 움직임 저하나 고정이 보이고 기식성 음성이 주 증상이다. 성대 운동이 정상이라는 소견과 모순된다.\",\"2\":\"기능적 실성증은 후두가 정상인데 말할 때 소리가 거의 나지 않고 속삭임으로만 말하는 상태이다. 이 학생은 높기는 해도 유성음 발성이 되므로 실성증이 아니다.\",\"3\":\"내전형 경련성 발성장애는 모음에서 쥐어짜는 긴장된 음성 끊김이 특징인 신경학적 질환이다. 높고 가는 음도의 지속과 반사적 저음 산출이라는 지문과 맞지 않는다.\",\"4\":\"성대구증은 성대 가장자리의 홈으로 내시경에서 이상 소견이 보이고 성문 폐쇄부전과 기식성 음성이 나타난다. 후두 구조가 정상이라는 소견과 맞지 않는다.\"}},\"2-1-1-72\":{\"p\":\"인후두역류질환(laryngopharyngeal reflux, LPR)은 위 내용물(위산·펩신)이 식도를 지나 후두·인두까지 올라와 점막을 자극하는 질환이다. 역류물이 가장 먼저 닿는 곳이 후두 후방이므로 피열연골 부위의 발적·부종과 피열간 점막 비후(pachydermia)가 특징 소견이고, 밤사이 누운 자세에서 역류가 늘어 아침 쉰 목소리가 심한 경향이 있다. 잦은 헛기침과 목 이물감(globus)도 대표 증상이다. 가슴쓰림은 위식도역류(GERD)의 전형 증상으로, LPR 환자 중에는 가슴쓰림이 없는 경우도 많지만 이 사례처럼 있으면 역류를 뒷받침하는 단서가 된다. 관리는 약물치료와 함께 식이·생활습관 조절이며, 헛기침 줄이기 같은 음성위생도 병행한다.\",\"w\":{\"2\":\"후두유두종은 HPV 감염으로 생기는 사마귀(포도송이) 모양 종괴로, 점막 발적·부종이 아닌 종양 자체가 보인다. 아침에 심해지는 증상 양상이나 가슴쓰림과도 관련이 없다.\",\"3\":\"변성발성장애는 사춘기 이후에도 높은 음도를 유지하는 기능적 음성장애로 후두 소견이 정상이다. 48세 남성의 후두 후방 염증 소견과 맞지 않는다.\",\"4\":\"급성 바이러스성 후두염은 감기 등 상기도 감염에 뒤따라 성대 전반이 붓고 붉어지는 단기 질환으로 대개 1~2주 안에 좋아진다. 아침에 반복되는 증상, 가슴쓰림, 후두 후방에 국한된 소견은 역류를 더 시사한다.\",\"5\":\"성대낭종은 성대 고유층 안의 주머니 모양 종괴로 주로 편측 막성 성대에 생긴다. 피열연골·피열간 부위의 미만성 발적·부종과는 위치와 형태가 다르다.\"}},\"2-1-1-73\":{\"p\":\"맹관공명(cul-de-sac resonance)은 소리가 공명강 안으로 들어갔다가 출구가 막혀 밖으로 빠져나오지 못하고 갇힌 듯 들리는 공명 이상으로, 둔하고 먹먹하며 소리가 뒤로 먹힌 듯한 인상을 준다. 비강 앞쪽(콧구멍 쪽) 폐쇄가 있으면 소리가 비강에 들어가지만 나오지 못하는 비강형 맹관공명이 되고, 인두 협착이나 혀의 후방 위치가 있으면 인두형 맹관공명이 된다. 지문의 갇혀서 먹먹하게 들림, 비강 앞쪽 폐쇄 또는 후방 인두 협착이라는 원인 설명이 정의와 그대로 일치한다. 비음이 비강으로 들어가지 못해 생기는 과소비성과 달리, 맹관공명은 소리가 들어간 뒤 출구에서 막힌다는 점이 핵심 차이이다.\",\"w\":{\"1\":\"과다비성은 연인두 폐쇄부전 등으로 구강음(특히 모음) 산출 시 비강 공명이 지나치게 많아지는 것이다. 소리가 갇혀 먹먹하게 들리는 양상과 다르다.\",\"2\":\"과소비성은 아데노이드 비대·비강 폐쇄 등으로 비음 /m, n/ 산출 시 소리가 비강에 충분히 들어가지 못해 비강 공명이 부족한 상태이다. 비강 앞쪽에 출구가 막혀 소리가 갇힌다는 설명은 맹관공명에 더 가깝다.\",\"4\":\"혼합 공명(혼합비성)은 한 화자에게 과다비성과 과소비성이 함께 나타나는 것으로, 예컨대 연인두 폐쇄부전이 있으면서 비강 폐쇄도 있을 때 보인다. 지문은 갇힌 공명 하나만 기술한다.\",\"5\":\"비강 난류(nasal turbulence)는 압력자음 산출 시 좁은 연인두 틈으로 공기가 빠져나가며 나는 마찰성 소음으로, 공명 유형이 아니라 비강 기류 오류(조음 관련 증상)이다.\"}},\"2-1-1-74\":{\"p\":\"밀기 기법(pushing technique)은 발성과 동시에 팔로 벽이나 의자를 밀거나, 두 손을 맞잡고 당기거나, 주먹을 쥐고 아래로 내리치는 등 상체에 힘을 주어 반사적으로 성대 내전을 강화하는 방법이다. 상체에 힘을 줄 때 성문이 닫혀 흉곽을 고정하려는 생리적 반사(effort closure)를 이용하는 원리이다. 편측 성대마비처럼 성문이 다 닫히지 않는 저기능성 음성장애에서 건강한 쪽 성대가 정중선을 넘어 더 많이 움직이도록 도와 폐쇄를 개선한다. 과도하게 쓰면 가성대 발성이나 과긴장이 생길 수 있어, 성대 접촉이 좋아지면 힘을 점차 줄여 일반 발성으로 옮겨 간다.\",\"w\":{\"1\":\"하품-한숨법은 하품으로 후두를 낮추고 인두를 넓힌 뒤 한숨 쉬듯 부드럽게 발성하는 이완 기법으로, 근긴장성 발성장애 같은 과기능성 음성장애에 쓴다. 성대 내전을 강화하는 기법이 아니다.\",\"2\":\"저작하기(chewing)는 씹는 동작과 함께 발성해 후두와 구강 주변의 긴장을 풀어 주는 과기능성 음성장애용 이완 기법이다. 성문 폐쇄부전을 개선하는 목적과 맞지 않는다.\",\"3\":\"속삭이기는 성대를 거의 붙이지 않은 채 공기만 내보내는 방식이라 성대 접촉을 오히려 줄인다. 성문 폐쇄부전 환자의 내전 촉진과 정반대이다.\",\"5\":\"후두 마사지(circumlaryngeal massage)는 설골·갑상연골 주변 근육을 풀어 후두를 낮추고 긴장을 줄이는 이완 기법이다. 근긴장성 발성장애에 쓰며 성대 내전 강화와는 관계가 없다.\"}},\"2-1-1-75\":{\"p\":\"근긴장성 발성장애(muscle tension dysphonia, MTD)는 후두 외근·내근이 과도하게 긴장해 생기는 과기능성 음성장애이다. 1형(Morrison 분류)은 후두 근육 전반의 긴장으로 후방 성문 틈이 남는 유형이며, 교재에 따라 1형을 후두 등척성 긴장형으로 소개한다. 지문의 단서는 콜센터 상담원이라는 많은 음성 사용, 발성 시 목 앞쪽 근육이 단단하게 만져짐, 후두가 높게 위치함으로 모두 과긴장을 가리킨다. 따라서 먼저 후두 마사지로 설골·갑상연골 주변 긴장을 풀어 후두를 낮추고, 하품-한숨법으로 인두를 넓히고 부드러운 발성을 익히게 하는 이완 중심 접근이 적절하다.\",\"w\":{\"1\":\"밀기 기법은 성대 내전과 접촉을 강화하는 기법으로 성대마비 같은 저기능성 장애에 쓴다. 과긴장이 문제인 근긴장성 발성장애에서는 긴장을 더 키운다.\",\"2\":\"리실버만 음성치료(LSVT LOUD)는 파킨슨병처럼 강도가 낮고 발성 노력이 부족한 환자를 위한 큰 소리 훈련이다. 이미 과도하게 힘을 주는 환자에게 큰 소리 훈련은 맞지 않는다.\",\"4\":\"강한 성문파열음 시작(hard glottal attack)은 성대를 세게 부딪쳐 발성을 시작하는 방식으로, 과기능성 음성장애에서 오히려 줄여야 할 습관이다. 성대 충격과 후두 긴장을 높인다.\",\"5\":\"양측 갑상피열근 보툴리눔 독소 주입은 내전형 경련성 발성장애의 일차 치료이며, 언어재활사가 시행하는 중재도 아니다. 근긴장성 발성장애는 행동적 음성치료로 먼저 접근한다.\"}},\"2-1-1-76\":{\"p\":\"공명음성치료(resonant voice therapy, 대표적으로 Lessac-Madsen Resonant Voice Therapy, LMRVT)는 성대가 살짝 붙거나 살짝 벌어진 상태(barely abducted/adducted)에서 발성하여, 최소한의 성대 충격으로 최대의 음향 출력을 얻는 것을 목표로 한다. /m/ 허밍 같은 비음을 이용해 입술·코·안면 앞쪽에 진동감(forward focus)을 느끼게 하고, 이 감각을 단서로 음절·낱말·문장·대화로 넓혀 간다. 지문의 세 단서인 /m/ 허밍과 앞쪽 진동감, 살짝 벌어진 성대와 최소 노력·최대 공명, 성대 충격 스트레스 감소가 모두 공명음성치료의 원리와 일치한다. 성대결절 같은 과기능성 음성장애에 많이 쓰인다.\",\"w\":{\"1\":\"리실버만 음성치료(LSVT LOUD)는 파킨슨병 환자에게 ‘크게 생각하기’로 큰 소리 발성을 집중 훈련하는 방법이다. 허밍과 앞쪽 진동감으로 성대 충격을 줄이는 원리와 다르다.\",\"2\":\"액센트 기법(accent method)은 복식호흡을 바탕으로 리듬에 맞춰 강세를 넣은 모음·음절을 반복해 호흡과 발성의 협응을 기르는 방법이다. /m/ 허밍과 앞쪽 진동감을 핵심으로 하지 않는다.\",\"3\":\"성대기능훈련(VFE)은 /i/ 연장, 음도 상승·하강 활주, 여러 음도에서 /ol/ 연장의 4단계로 성대 근육의 힘과 협응을 기르는 생리적 운동 프로그램이다. 허밍으로 공명 감각을 찾는 방법이 아니다.\",\"5\":\"빨대발성은 빨대를 물고 발성하는 반폐쇄성도 운동(SOVTE)으로, 성도 안 역압을 높여 성대 충돌을 줄인다. 원리가 일부 겹치지만 지문의 /m/ 허밍과 안면 앞쪽 진동감은 공명음성치료의 핵심 절차이다.\"}},\"2-1-1-77\":{\"p\":\"성대기능훈련(Vocal Function Exercises, VFE)은 Stemple이 제안한 생리적 음성치료로, 성대 근육의 힘·지구력·협응을 운동처럼 기른다. 구성은 준비운동(warm-up): 편안한 음도에서 /i/를 최대한 길게 연장, 신장(stretching): 가장 낮은 음에서 가장 높은 음으로 활주, 수축(contracting): 가장 높은 음에서 가장 낮은 음으로 활주, 내전력 강화(power/adductory): 정해진 여러 음도에서 /ol/을 최대한 길게 연장하는 4가지이다. 모든 과제를 부드럽고 작은 소리로, 앞쪽 공명을 유지하며 하루 2회 각 2번씩 반복하는 것이 일반적이고, 최대발성지속시간 변화로 진전을 기록한다. 결절 등 과기능성 장애뿐 아니라 노인성 음성, 근력 저하 등 저기능성 장애에도 적용된다.\",\"w\":{\"2\":\"성대기능훈련은 부드럽고 작은 소리로, 최소한의 노력으로 수행한다. 큰 소리로 밀어내는 발성은 성대 충격을 키워 이 훈련의 원칙에 어긋난다.\",\"3\":\"속삭임으로 성대를 쉬게 하는 것은 음성 휴식 방법이다. 성대기능훈련은 성대를 실제로 진동시키며 근육을 단련하는 운동이다.\",\"4\":\"신장·수축 운동처럼 낮은 음에서 높은 음, 높은 음에서 낮은 음으로 활주하는 음도 변화가 핵심이다. 습관적 음도에서만 연장한다는 설명은 4단계 구성과 맞지 않는다.\",\"5\":\"후두 마사지로 근육 긴장을 낮추는 것은 근긴장성 발성장애용 이완 기법이다. 성대기능훈련은 근력과 협응을 기르는 발성 운동 프로그램이다.\"}},\"2-1-1-78\":{\"p\":\"리실버만 음성치료(Lee Silverman Voice Treatment, LSVT LOUD)는 파킨슨병의 운동저하형 마비말장애(hypokinetic dysarthria)에서 보이는 작은 강도, 단조로운 음도, 기식성 음성을 개선하기 위해 개발된 집중 치료이다. 일반적으로 주 4회, 4주(총 16회기) 동안 ‘크게 생각하기(Think LOUD)’라는 단일 목표로 높은 노력의 발성을 반복한다. 지문의 핵심 단서는 본인은 목소리가 충분히 크다고 느낀다는 점으로, 이는 파킨슨병 환자의 감각 처리 결함(자기 음성 크기를 과대평가)을 뜻하며, LSVT는 이 지각을 재조정(calibration)하는 것을 중요한 목표로 삼는다. 큰 소리 발성은 호흡 지지, 성대 내전, 조음 명료도까지 함께 끌어올리는 효과가 보고된다.\",\"w\":{\"1\":\"하품-한숨법은 과긴장을 풀어 후두를 낮추는 이완 기법으로, 근긴장성 발성장애 같은 과기능성 음성장애에 쓴다. 강도가 낮고 발성 노력이 부족한 파킨슨병 음성에는 맞지 않는다.\",\"3\":\"속삭이기는 성대 접촉을 줄여 소리를 더 작게 만들므로, 이미 작고 기식적인 파킨슨병 음성을 악화시킨다.\",\"4\":\"공명음성치료는 최소한의 성대 충격으로 편안한 공명 음성을 얻는 방법으로, 주로 결절 같은 과기능성 장애에 쓴다. 파킨슨병의 감각 재조정과 강도 증가를 겨냥한 방법이 아니다.\",\"5\":\"흡기발성은 숨을 들이마시며 소리를 내어 진성대 진동을 유도하는 기법으로, 가성대 발성이나 기능적 실성증에 쓴다. 파킨슨병의 낮은 강도를 개선하는 방법이 아니다.\"}},\"2-1-1-79\":{\"p\":\"가성대 발성(ventricular phonation, 실성대 발성)은 진성대 대신 그 위의 가성대(실성대)가 맞닿아 진동하는 것으로, 가성대는 질량이 크고 진동이 불규칙해 낮고 거친 음질과 좁은 음도 범위를 보인다. 흡기발성(inspiratory phonation)은 숨을 들이마시면서 소리를 내게 하는데, 흡기 중에는 가성대가 바깥으로 벌어지고 진성대만 진동하는 경향이 있다. 이렇게 진성대로 낸 소리를 확인한 뒤 곧바로 같은 음질로 호기발성을 이어 가게 하여(흡기-호기 전환) 진성대 발성을 습관화한다. 기능적 실성증에서 유성음을 찾을 때도 쓰인다.\",\"w\":{\"2\":\"밀기 기법은 상체에 힘을 주어 성문 폐쇄를 강화하는 기법으로, 성문 상부의 압축까지 높여 가성대가 더 붙게 만들 수 있다. 성대마비 같은 폐쇄부전에 쓰는 방법이다.\",\"3\":\"강한 성문파열음 시작은 성대와 그 위 구조를 세게 조이며 발성을 시작하는 방식으로, 성문 상부 압축을 키워 가성대 발성을 오히려 강화할 수 있다.\",\"4\":\"큰 소리로 소리 지르기는 후두 전체의 과긴장과 성문 상부 압축을 일으켜 가성대 접촉을 늘린다. 진성대 발성을 유도하는 방법이 아니라 피해야 할 음성 남용이다.\",\"5\":\"가성대 발성은 이미 비정상적으로 낮은 음도를 보이므로 저음을 유지하는 훈련은 목표와 반대이다. 오히려 음도를 약간 높이면 가성대가 떨어지고 진성대 진동이 쉬워지는 경우가 많다.\"}},\"2-1-1-80\":{\"p\":\"기관식도발성(tracheoesophageal puncture/prosthesis, TEP)은 후두전적출술 후 기관 뒷벽과 식도 앞벽 사이에 작은 천공(누공)을 만들고 일방향 밸브가 달린 음성 보철(voice prosthesis)을 끼우는 방법이다. 숨을 내쉴 때 손가락이나 밸브로 기관 기공(stoma)을 막으면 폐의 공기가 보철을 거쳐 식도로 들어가고, 이 공기가 인두식도분절(PE segment)을 진동시켜 새로운 음원이 된다. 폐활량 전체를 쓸 수 있어 식도발성보다 발화 길이가 길고 강도가 크며 유창성이 자연스럽다. 대신 보철 관리, 누공 주변 누출, 감염 등의 관리가 필요하다.\",\"w\":{\"1\":\"외부 진동원을 목이나 구강에 대어 소리를 내는 것은 전기후두(인공후두)의 원리이다. 기관식도발성은 폐 공기로 인두식도분절을 진동시키므로 외부 진동원이 필요 없다.\",\"3\":\"삼키거나 주입한 공기를 식도에서 다시 내보내며 발성하는 것은 식도발성이다. 한 번에 쓸 수 있는 공기량이 적어 발화 길이가 짧은 것도 식도발성의 특징이다.\",\"4\":\"기관식도발성은 후두를 전부 적출한 뒤 시행하는 음성 재활 방법이다. 후두를 보존한 채 하는 성대 재건술이 아니다.\",\"5\":\"기관식도발성은 날숨에 맞추어 폐 공기를 쓰므로 호흡과 밀접하게 연결되어 있고, 한 번의 날숨으로 여러 낱말이 이어지는 구 단위 발화가 가능하다. 단어 단위로만 말한다는 설명은 맞지 않는다.\"}},\"2-1-2-1\":{\"p\":\"조음방법은 기류를 어떤 방식으로 막고 내보내는지에 따른 분류이다. /ㅊ/은 혀를 경구개에 대어 완전히 막았다가 좁은 틈으로 마찰을 일으키며 개방하는 파찰음(경구개, 격음)이고, '참'의 종성 /ㅁ/은 두 입술을 닫고 비강으로 기류를 내보내는 양순 비음이며, '새'의 초성 /ㅅ/은 막지 않고 치조에서 좁힘을 유지하며 마찰 소음을 내는 치조 마찰음이다. 파찰음은 폐쇄 단계와 마찰 단계를 모두 가지므로 파열음이나 마찰음 하나로 분류하지 않는다. 조음위치(경구개–양순–치조)는 '어디서 막는가', 조음방법은 '어떻게 막는가'로 구분해 두면 두 축을 섞은 오답을 거르기 쉽다.\",\"w\":{\"1\":\"/ㅊ/을 파열음으로 분류한 것이 틀렸다. 파열음은 /ㅂ, ㄷ, ㄱ/ 계열처럼 폐쇄 후 순간적으로 개방되는 소리이고, /ㅊ/은 폐쇄 뒤 마찰 개방이 이어지는 파찰음이다.\",\"2\":\"/ㅊ/과 /ㅅ/의 분류를 서로 뒤바꿨다. 폐쇄 구간이 있는 /ㅊ/이 파찰음이고, 폐쇄 없이 마찰을 지속하는 /ㅅ/이 마찰음이다.\",\"3\":\"/ㅁ/을 유음으로 분류한 것이 틀렸다. 우리말 유음은 /ㄹ/ 하나뿐이며, /ㅁ/은 비강으로 기류를 내보내는 비음이다.\",\"5\":\"/ㅅ/을 파열음으로 분류한 것이 틀렸다. /ㅅ/은 완전 폐쇄 없이 치조의 좁은 틈으로 기류를 지속시키는 마찰음이다.\"}},\"2-1-2-2\":{\"p\":\"[설정성(coronal)]은 혀끝이나 혓날이 중립 위치보다 올라가 조음되는 소리에 + 값을 주는 자질이다. 치조음(/ㄷ, ㅌ, ㄸ, ㄴ, ㄹ, ㅅ, ㅆ/)과 경구개음(/ㅈ, ㅉ, ㅊ/)은 모두 혀의 앞부분으로 조음하므로 [+설정성]을 공유하고, 양순음과 연구개음은 [-설정성]이다. 함께 출제되는 [전방성(anterior)]은 치조 및 그보다 앞(양순·치조)에서 조음되는 소리가 +이므로, 양순음 [-설정성, +전방성], 치조음 [+설정성, +전방성], 경구개음 [+설정성, -전방성], 연구개음 [-설정성, -전방성]으로 네 조음위치가 갈린다. 이 2×2 조합을 정리해 두면 조음위치 자질 문항에 바로 대응할 수 있다.\",\"w\":{\"1\":\"비음은 성도 안에서 자연스러운 유성 공명이 일어나는 공명음이므로 [+공명성]이다. [-공명성]은 파열음·마찰음·파찰음 같은 장애음(obstruent)의 값이다.\",\"3\":\"[+전방성]은 치조 및 그보다 앞에서 조음되는 양순음·치조음의 값이다. 연구개음은 치조보다 뒤에서 조음되므로 [-전방성]이다.\",\"4\":\"[+지속성]은 조음 중 구강 기류가 막히지 않고 계속 흐르는 소리의 값이다. 파찰음은 처음에 완전 폐쇄 구간이 있으므로 [-지속성]이다.\",\"5\":\"마찰음은 좁힘을 유지한 채 기류가 계속 흐르므로 [+지속성]이다. [-지속성]은 파열음·파찰음처럼 구강을 완전히 막는 소리의 값이다.\"}},\"2-1-2-3\":{\"p\":\"국어의 음절 끝(종성)에서는 대표음 7개 /ㄱ, ㄴ, ㄷ, ㄹ, ㅁ, ㅂ, ㅇ/만 소리 나며, 이를 음절말 끝소리 규칙(음절말 중화·평파열음화)이라 한다. /ㅋ, ㄲ/은 [ㄱ], /ㅅ, ㅆ, ㅈ, ㅊ, ㅌ, ㅎ/은 [ㄷ], /ㅍ/은 [ㅂ]으로 바뀐다('밖'→[박], '낮'→[낟], '잎'→[입]). 이렇게 되는 까닭은 종성 장애음이 개방되지 않는 불파음(미파음)으로 실현되어 평음·격음·경음, 파열·마찰·파찰의 차이가 드러날 단계가 없기 때문이다. 겹받침도 음절 말에서는 자음군 단순화로 하나만 발음되므로 종성은 결국 7개 중 하나로 실현된다.\",\"w\":{\"2\":\"종성 /ㄹ/은 혀끝을 치조에 댄 채 혀 옆으로 기류를 흘리는 설측음 [l]로 실현된다. 탄설음 [ɾ]은 어두나 모음 사이 초성 /ㄹ/의 변이음이다.\",\"3\":\"한국어 종성 파열음은 폐쇄만 하고 개방하지 않는 불파음(미파음, unreleased)으로 산출된다. 파열 단계까지 개방되는 것은 초성 파열음이다.\",\"4\":\"종성 /ㅈ/은 음절말 끝소리 규칙에 따라 대표음 [ㄷ]으로 중화된다('낮'→[낟]). 파찰음은 종성 위치에서 그대로 실현될 수 없다.\",\"5\":\"한국어 음절 구조는 종성에 자음 하나만 허용하므로 겹받침은 자음군 단순화로 하나만 발음된다('닭'→[닥], '넋'→[넉]). 두 자음이 모두 실현된다는 설명은 틀렸다.\"}},\"2-1-2-4\":{\"p\":\"/ㄹ/은 위치에 따라 두 변이음으로 실현된다. 초성(어두 또는 모음과 모음 사이)에서는 혀끝이 치조를 한 번 가볍게 치는 탄설음 [ɾ], 종성과 종성 /ㄹ/ 바로 뒤의 초성(/ㄹ/+/ㄹ/ 연쇄)에서는 혀끝을 치조에 댄 채 혀 옆으로 기류를 흘리는 설측음 [l]이다. '달'의 /ㄹ/은 음절 말 종성이므로 설측음 [l]이 옳다. '빨래'는 첫 /ㄹ/이 종성, 둘째 /ㄹ/이 그 뒤 초성이어서 [ll]로 둘 다 설측음이 된다. 판단할 때는 /ㄹ/이 종성인지, 바로 앞에 종성 /ㄹ/이 있는지를 먼저 확인하면 된다.\",\"w\":{\"1\":\"'라면'의 /ㄹ/은 어두 초성이므로 탄설음 [ɾ]로 실현된다. 설측음 [l]은 종성이나 종성 /ㄹ/ 뒤 초성에서 나타난다.\",\"2\":\"'노래'의 /ㄹ/은 모음 사이 초성이므로 탄설음 [ɾ]이다. 앞 음절에 종성 /ㄹ/이 없어 설측음이 될 조건이 아니다.\",\"4\":\"'빨래'의 첫 번째 /ㄹ/은 첫 음절의 종성이므로 설측음 [l]이다. 뒤따르는 둘째 /ㄹ/도 종성 /ㄹ/ 뒤 초성이라 설측음이 되어 [ll]로 실현된다.\",\"5\":\"'달'의 /ㄹ/은 종성이므로 탄설음이 아니라 설측음 [l]이다. 탄설음은 초성 위치에서 나타나는 변이음이다.\"}},\"2-1-2-5\":{\"p\":\"한국어 평음 /ㄱ, ㄷ, ㅂ, ㅈ/은 어두에서는 무성음으로, 유성음(모음·비음·유음) 사이에서는 성대 진동이 이어져 유성음으로 실현된다(유성음화). '고기'의 첫 /ㄱ/은 어두이므로 무성 파열음 [k], 둘째 /ㄱ/은 모음 /ㅗ/와 /ㅣ/ 사이이므로 유성 파열음 [g]로 전사해 [kogi]가 된다. 한국어에서 [k]와 [g]는 뜻을 구별하지 않는 한 음소 /ㄱ/의 변이음이어서, 정밀 전사에서 위치에 따라 구분해 적는 것이다. 격음 /ㅋ/은 [kʰ], 경음 /ㄲ/은 [k*]로 표기하며 이들은 평음과 별개의 음소이다.\",\"w\":{\"1\":\"[koki]는 어중 /ㄱ/을 무성음 [k]로 전사했다. 모음 사이 평음은 유성음화되어 [g]로 실현되므로 어중 전사가 틀렸다.\",\"2\":\"[gogi]는 어두 /ㄱ/까지 유성음 [g]로 전사했다. 한국어 평음은 어두에서 무성음으로 실현되므로 어두는 [k]여야 한다.\",\"3\":\"[kʰ]는 격음 /ㅋ/의 전사 기호이다. '고기'의 첫소리는 평음 /ㄱ/이므로 기식 표시를 붙이면 '코기'를 전사한 것이 된다.\",\"5\":\"[k*]는 경음 /ㄲ/의 전사 기호이다. 평음 /ㄱ/을 경음으로 적었으므로 '꼬기'에 해당하는 표기이다.\"}},\"2-1-2-6\":{\"p\":\"우리말 자음은 조음방법별로 보면 일반적으로 비음·파열음이 가장 먼저, 이어서 파찰음, 그리고 유음 /ㄹ/과 치조 마찰음 /ㅅ, ㅆ/이 가장 늦게 완성되는 경향을 보인다. 비음·파열음은 완전히 막았다 여는 비교적 단순한 운동인 반면, 마찰음은 혀와 치조 사이의 좁은 틈을 정밀하게 유지해야 하고 /ㄹ/은 위치별 변이음(탄설음·설측음)까지 익혀야 해 늦다. 위치별로는 양순음이 이른 편이다. 구체적인 습득 연령은 연구·교재와 습득 기준(숙달·완전습득 등)에 따라 차이가 있으므로 순서 위주로 기억하는 것이 안전하다.\",\"w\":{\"1\":\"치조 마찰음 /ㅅ, ㅆ/은 /ㄹ/과 함께 가장 늦게 습득되는 소리이다. 가장 이른 시기에 습득되는 것은 비음·파열음, 특히 양순음이다.\",\"2\":\"유음 /ㄹ/은 늦게 완성되는 자음이고, 양순 파열음 /ㅂ, ㅃ, ㅍ/은 가장 이른 시기에 습득되는 편이다. 순서가 반대로 되어 있다.\",\"3\":\"종성 /ㅁ, ㅇ/ 같은 종성 비음은 비교적 이른 시기에 습득된다. 종성 전체가 초성보다 늦다고 일반화할 수 없다.\",\"4\":\"치조 마찰음은 일반적으로 학령기 무렵(대략 만 5~7세)에야 완전 습득되는 것으로 보고된다. 만 3세 이전 완전 습득은 지나치게 이르다.\"}},\"2-1-2-7\":{\"p\":\"음운인식은 일반적으로 단어 → 음절 → 음절체·각운 → 음소 순으로 더 작은 단위를 다루는 방향으로 발달한다. 같은 단위 안에서도 과제 유형에 따라 난이도가 달라, 대략 수 세기·합성이 쉽고 탈락·대치가 더 어렵다. '밤'에서 /ㅁ/을 빼고 [바]라고 말하려면 음절 안의 음소를 분리해 기억에 유지한 채 하나를 제거하고 남은 소리를 다시 조합해야 하므로 작업기억 부담이 가장 크다. 따라서 보기 중 '음소 단위 + 탈락 과제'인 이 보기가 가장 늦게 발달한다. 단위(음절/음소)와 과제 유형(세기·합성/탈락)을 두 축으로 놓고 비교하면 판단이 빠르다.\",\"w\":{\"1\":\"음절 수 세기는 가장 큰 단위인 음절을 다루는 과제이고 손뼉치기 같은 리듬 단서도 있어 비교적 이른 시기에 가능하다.\",\"3\":\"'바' 빼기는 음절 탈락 과제이다. 탈락 과제이지만 음절 단위라서 음소 탈락보다 먼저 발달한다.\",\"4\":\"음소 합성은 음소 단위 과제이지만 들려준 소리를 이어 붙이기만 하면 되므로, 음소를 분리해 제거해야 하는 음소 탈락보다 쉽다.\",\"5\":\"음절 합성은 음절 단위의 합성 과제로 보기 중 가장 쉬운 축에 속하며 이른 시기에 발달한다.\"}},\"2-1-2-8\":{\"p\":\"김영태의 우리말 자음 습득 연구는 같은 연령대 아동 중 몇 %가 해당 음소를 정조음하는지에 따라 네 단계를 나눈다. 25~49%면 출현연령, 50~74%면 관습적 연령, 75~94%면 숙달연령, 95~100%면 완전습득연령이다. 정조음 비율이 높을수록 늦은 단계이므로 발달 순서는 출현 → 관습적 → 숙달 → 완전습득이며, 완전습득연령은 그 연령대 아동의 95% 이상이 정조음하는 시점이다. 구간이 25% 간격으로 올라가다가 마지막만 95%에서 끊긴다는 점을 기억하면 기준을 뒤섞은 보기를 쉽게 거를 수 있다.\",\"w\":{\"1\":\"95% 이상이 정조음하는 연령은 완전습득연령의 기준이다. 출현연령은 25~49%가 정조음하는 가장 이른 단계이다.\",\"2\":\"출현연령은 네 단계 중 가장 먼저 나타나는 단계이고 완전습득연령이 가장 늦다. 순서가 반대로 서술되었다.\",\"3\":\"75~94%는 숙달연령의 기준이다. 관습적 연령은 50~74%가 정조음하는 연령이다.\",\"4\":\"25~49%는 출현연령의 기준이다. 숙달연령은 75~94%가 정조음하는 연령이다.\"}},\"2-1-2-9\":{\"p\":\"자연음운론(Natural Phonology, Stampe)은 아동이 인간에게 보편적인 음운변동(phonological processes), 예컨대 종성생략·전방화·파열음화 같은 단순화 과정을 타고난다고 가정한다. 아동은 성인 형태를 지각적으로는 알고 있지만 산출할 때 이 변동을 적용해 단순화하며, 모국어에 필요 없는 변동을 억제(suppression)하고 제한·순서화하면서 성인 체계에 이른다. 지문의 '자연스러운 단순화 과정', '억제되면서 성인 체계에 도달'이 이론을 특정하는 단서이다. 임상에서 쓰는 음운변동(오류패턴) 분석이 이 이론에 바탕을 두고 있다.\",\"w\":{\"1\":\"행동주의 학습이론은 말소리가 모방·강화·조건화로 학습된다고 보는 이론으로, 타고난 단순화 과정을 억제한다는 개념이 없다.\",\"2\":\"생성음운론은 기저형이 음운규칙을 거쳐 표면형이 된다고 보고 변별자질과 규칙 체계로 음운을 설명한다. 보편적 단순화 과정의 억제가 핵심 개념이 아니다.\",\"4\":\"최적성이론은 보편적 제약들의 서열(순위)이 재조정되며 발달한다고 설명한다. 음운변동의 억제는 자연음운론의 설명이다.\",\"5\":\"운율음운론은 음절·음보·음운구 같은 운율 단위의 위계 구조를 다루는 이론으로, 아동의 오류를 단순화 과정의 억제로 설명하지 않는다.\"}},\"2-1-2-10\":{\"p\":\"조음 오류는 전통적으로 대치(substitution), 생략(omission), 왜곡(distortion), 첨가(addition)의 네 가지로 분류한다. 왜곡은 목표음과 비슷하지만 우리말 음소 목록에 없는 비표준 소리로 산출되는 것으로, 다른 음소로 바뀌는 대치와 달리 한글 자모로 정확히 받아 적기 어렵다는 점이 판별 단서이다. /ㅅ/을 낼 때 혀 옆으로 공기가 새는 설측음화(lateral lisp)는 /ㅅ/도 /ㄹ/도 아닌 소리가 되므로 대표적인 왜곡이다. 혀끝이 이 사이로 나오는 치간음화도 같은 범주에 속한다.\",\"w\":{\"2\":\"[고애]는 /ㄹ/이 다른 소리로 바뀌지 않고 빠진 것이므로 생략 오류이다.\",\"3\":\"[모리]는 어두에 원래 없던 /ㅁ/을 덧붙인 것이므로 첨가 오류이다.\",\"4\":\"[타탕]은 /ㅅ/이 우리말에 있는 다른 음소 /ㅌ/으로 바뀐 것이므로 대치 오류이며, 패턴으로는 마찰음의 파열음화이다.\",\"5\":\"[바]는 종성 /ㅂ/이 빠진 것이므로 생략 오류이며, 패턴으로는 종성생략에 해당한다.\"}},\"2-1-2-11\":{\"p\":\"바뀐 소리를 정리하면 /ㄱ/→[ㄷ](가방, 공), /ㅋ/→[ㅌ](코)이다. 목표음은 모두 연구개음이고 산출음은 모두 그보다 앞쪽인 치조음이므로, 조음위치가 앞으로 이동한 연구개음 전방화(velar fronting)이다. 조음방법은 파열음 그대로이고, 발성유형도 평음→평음, 격음→격음으로 유지되었다는 점을 함께 확인하면 다른 패턴을 배제할 수 있다. 연구개음 전방화는 어린 아동에게 흔한 발달적 패턴이지만, 또래가 대부분 극복하는 연령 이후에도 지속되면 중재 대상으로 본다.\",\"w\":{\"1\":\"파열음화는 마찰음·파찰음 등이 파열음으로 바뀌는 패턴이다. 목표음 /ㄱ, ㅋ/은 이미 파열음이어서 조음방법의 변화가 없다.\",\"2\":\"치조음 후방화는 /ㄷ, ㅌ/ 같은 치조음이 /ㄱ, ㅋ/처럼 뒤쪽 소리로 바뀌는 것으로, 이 아동과 방향이 정반대이다.\",\"4\":\"양순음화는 다른 위치의 자음이 /ㅂ, ㅍ, ㅁ/ 같은 양순음으로 바뀌는 패턴이다. 산출음 [ㄷ, ㅌ]은 치조음이다.\",\"5\":\"탈기식음화는 격음이 평음으로 바뀌는 패턴(예: /ㅋ/→[ㄱ])이다. '코'→[토]에서 격음성은 그대로 유지되었다.\"}},\"2-1-2-12\":{\"p\":\"비발달적(비전형적) 오류패턴은 정상 발달 아동에게서는 거의 관찰되지 않는 패턴으로, 단순한 지연이 아니라 음운 체계 자체의 이상을 시사하므로 중재 우선순위가 높다. '나비'→[아비]는 단어 첫 초성 /ㄴ/을 빠뜨린 어두 초성 생략으로, 우리말 아동 연구에서 비발달적 패턴으로 분류된다. 게다가 /ㄴ/은 가장 이르게 습득되는 비음이므로 4세 아동이 이를 생략하는 것은 더욱 이례적이다. 반면 연구개음 전방화, 유음의 활음화, 마찰음의 파열음화, 종성생략은 어린 연령에 흔히 나타났다가 사라지는 발달적 패턴이다.\",\"w\":{\"2\":\"[딸디]는 연구개음 /ㄱ/이 치조음 [ㄷ]로 바뀐 연구개음 전방화로, 어린 아동에게 흔한 발달적 패턴이다.\",\"3\":\"[야면]은 유음 /ㄹ/이 활음 /j/로 바뀐 유음의 활음화로, /ㄹ/을 습득하기 전 아동에게 흔한 발달적 패턴이다.\",\"4\":\"[다자]는 마찰음 /ㅅ/이 파열음 [ㄷ]로 바뀐 마찰음의 파열음화로, /ㅅ/이 늦게 습득되는 만큼 4세 무렵에도 흔히 보이는 발달적 패턴이다.\",\"5\":\"[채]는 종성 /ㄱ/을 빠뜨린 종성생략으로, 어린 아동에게 흔히 관찰되는 발달적 패턴이다.\"}},\"2-1-2-13\":{\"p\":\"동화(assimilation)는 한 소리가 같은 단어 안의 다른 소리 영향을 받아 비슷하거나 같아지는 현상이며, 영향을 준 소리가 어느 쪽에 있는지로 방향을 구분한다. '사과'→[가과]는 첫 자음 /ㅅ/이 뒤 음절의 /ㄱ/과 같아졌고, '두부'→[부부]는 첫 자음 /ㄷ/이 뒤 음절의 /ㅂ/과 같아졌다. 두 예 모두 뒤에 오는 소리가 앞 소리를 바꾸었으므로 역행동화(regressive assimilation)이다. 판단 단서는 '바뀐 소리가 단어 안 어느 쪽 소리를 닮았는가'로, 앞 소리를 닮으면 순행, 뒤 소리를 닮으면 역행이다.\",\"w\":{\"1\":\"순행동화는 앞 소리가 뒤 소리에 영향을 주는 것(예: '두부'→[두두])이다. 이 예들은 앞 자음이 뒤 자음을 닮았으므로 방향이 반대이다.\",\"2\":\"전방화는 문맥과 관계없이 조음위치가 앞쪽으로 이동하는 대치이다. /ㅅ/→[ㄱ]은 오히려 뒤쪽으로 간 변화이며, 두 예 모두 단어 안 뒤 자음을 닮았다는 점에서 동화로 설명해야 한다.\",\"3\":\"음절 반복은 '사과'→[과과]처럼 음절 전체를 되풀이하는 것이다. 이 예들은 모음은 그대로 두고 자음만 바뀌었다.\",\"4\":\"후방화는 문맥과 무관하게 조음위치가 뒤로 이동하는 대치이다. '두부'→[부부]는 앞쪽 양순음으로 바뀌어 후방화로 설명되지 않으며, 두 예의 공통점은 뒤 자음을 닮았다는 것이다.\"}},\"2-1-2-14\":{\"p\":\"세 단어 모두에서 치조 마찰음 /ㅅ/이 일관되게 [ㅈ]으로 바뀌었다. 조음위치도 약간 뒤로 이동했지만, 핵심 변화는 폐쇄 없이 마찰만 하던 소리에 폐쇄 구간이 생긴 조음방법의 변화이므로 마찰음의 파찰음화(affrication)라고 한다. 산출음 [ㅈ]은 경음(/ㅉ/)이 아니므로 발성유형 변화인 경음화와도 구분된다. 마찰음은 늦게 습득되는 소리여서 습득 과정에서 파열음이나 파찰음으로 대치되는 경우가 흔하며, '어떤 방법의 소리가 어떤 방법의 소리로 바뀌었는가'를 화살표 방향까지 정확히 읽는 것이 중요하다.\",\"w\":{\"1\":\"마찰음의 파열음화는 /ㅅ/이 [ㄷ, ㅌ] 같은 파열음으로 바뀌는 것이다. 이 아동의 산출음 [ㅈ]은 폐쇄 뒤 마찰이 이어지는 파찰음이다.\",\"2\":\"파찰음의 마찰음화는 /ㅈ/→[ㅅ]처럼 파찰음이 마찰음으로 바뀌는 것으로, 이 아동과 방향이 정반대이다.\",\"3\":\"구개음화는 대개 /ㄷ, ㅌ/이 /ㅣ/ 앞에서 [ㅈ, ㅊ]이 되는 음운현상('굳이'→[구지])이나 경구개 쪽으로의 위치 이동을 가리킨다. 이 아동은 /ㅏ, ㅐ, ㅜ/ 앞에서도 일관되게 오류를 보이며 핵심은 마찰→파찰의 방법 변화이다.\",\"5\":\"경음화는 평음이 /ㄲ, ㄸ, ㅆ, ㅉ/ 같은 경음으로 바뀌는 발성유형 변화이다. 산출음 [ㅈ]은 경음이 아니다.\"}},\"2-1-2-15\":{\"p\":\"자극반응도(stimulability)는 청각 모델, 입 모양 같은 시각 단서, 조음위치 지시 같은 촉각·조음 단서를 주었을 때 아동이 오조음하던 소리를 정확하게(또는 더 가깝게) 산출할 수 있는 정도이다. 일반적으로 오류가 나타난 음소마다 독립음·음절·단어 수준에서 모방을 시켜 평가한다. 자극반응도가 높으면 해당 음소가 자연적으로 개선되거나 치료에 빠르게 반응할 가능성이 크다고 보고, 낮으면 자연 회복을 기대하기 어려워 치료 목표로 우선 고려하는 경우가 많다. 다만 자극반응도가 높은 음소를 먼저 다뤄 성공 경험을 주자는 관점도 있어 목표 선정 기준은 접근법에 따라 다르다.\",\"w\":{\"1\":\"자극반응도는 독립음뿐 아니라 음절·단어 수준 등 여러 단위에서 평가한다. 독립음 수준만 본다는 제한은 틀렸다.\",\"2\":\"자발화에서 목표 음소의 오조음 빈도를 백분율로 나타낸 것은 오류율이나 정확도 지표이다. 자극반응도는 단서를 준 뒤의 산출 변화를 보는 개념이다.\",\"3\":\"자극반응도가 높은 음소는 오히려 자연 회복 가능성과 예후가 좋다고 본다. 자연 회복 가능성이 낮은 것은 자극반응도가 낮은 음소이다.\",\"5\":\"말명료도는 청자가 화자의 말을 알아듣는 정도로, 아동이 단서에 반응해 정조음할 수 있는 능력인 자극반응도와 다른 개념이다.\"}},\"2-1-2-16\":{\"p\":\"자음정확도(PCC)는 '바르게 조음한 자음 수 ÷ 목표 낱말의 전체 자음 수 × 100'으로 구하며, 분모는 아동 산출이 아니라 목표형을 기준으로 센다. '토끼'에는 /ㅌ/, /ㄲ/ 2개, '신발'에는 초성 /ㅅ/, 종성 /ㄴ/, 초성 /ㅂ/, 종성 /ㄹ/ 4개가 있어 목표 자음은 모두 6개이다. 아동은 [토띠 신발]로 /ㄲ/만 [ㄸ]으로 바꾸었으므로 정조음 자음은 6−1=5개이고, PCC=5/6×100(약 83.3%)이다. 검산: 오류 1개 + 정조음 5개 = 목표 6개로 일치한다. 음가 없는 초성 'ㅇ'과 모음은 세지 않고, 종성은 자음 수에 넣는다는 점, 경음 /ㄲ/은 자음 하나로 센다는 점을 놓치지 않아야 한다.\",\"w\":{\"2\":\"4/6은 분모는 맞지만 정조음 자음을 4개로 센 값으로, /ㄲ/ 외에 오류가 하나 더 있다고 잘못 판단했을 때 나온다. 실제 오류는 /ㄲ/→[ㄸ] 하나뿐이다.\",\"3\":\"4/7은 분자와 분모를 모두 잘못 센 값이다. 목표 자음은 6개이고 정조음은 5개이다.\",\"4\":\"5/7은 분자는 맞지만 목표 자음을 하나 더 센 값으로, 예컨대 경음 /ㄲ/을 자음 두 개로 나누어 세는 실수에서 나온다.\",\"5\":\"5/8은 목표 자음을 8개로 과다하게 센 값으로, 모음이나 경음 등을 잘못 계산했을 때 나온다. 목표 자음은 6개이다.\"}},\"2-1-2-17\":{\"p\":\"평균음운길이(PMLU)는 단어마다 '아동이 산출한 분절음(자음·모음) 수 + 바르게 산출한 자음 수'로 점수를 매긴 뒤 단어 수로 나눈다. [모다]는 분절음 /ㅁ, ㅗ, ㄷ, ㅏ/로 4점, 정조음 자음은 /ㅁ/ 1개(/ㅈ/→[ㄷ]은 오류라 추가점 없음)라 1점을 더해 5점이다. [김]은 분절음 /ㄱ, ㅣ, ㅁ/로 3점, 정조음 자음 /ㄱ, ㅁ/ 2점을 더해 5점이다. 합계 10점 ÷ 2단어 = 10/2(=5)이다. 검산: 목표형 기준 최대점은 (4+2)+(3+2)=11점이고 오류 자음이 /ㅈ/ 하나뿐이므로 1점이 빠진 10점이 맞다. 모음은 분절음 점수에만 들어가고 정확도 추가점은 자음에만 준다는 점이 핵심이다(세부 채점 규칙은 교재에 따라 조금씩 다르게 소개될 수 있다).\",\"w\":{\"1\":\"8/2는 분절음 점수 7점에 정조음 자음 추가점을 1점만 더한 값으로, 자음 추가점을 빠뜨렸을 때 나온다. 정조음 자음은 /ㅁ/, /ㄱ/, /ㅁ/ 3개이므로 추가점은 3점이다.\",\"2\":\"9/2는 오류 자음 [ㄷ]을 분절음 점수에서도 빼서 [모다]를 4점으로 계산했을 때 나온다. 오류로 산출된 소리도 산출된 분절음이므로 분절음 점수에는 포함한다.\",\"3\":\"11/2는 /ㅈ/→[ㄷ] 오류를 정조음으로 처리해 [모다]에 추가점 2점을 준 값으로, 목표형 기준 최대점이다.\",\"5\":\"12/2는 목표형 기준 최대점 11점보다도 큰 값으로, 모음에도 정확도 추가점을 주는 등 규칙에 없는 점수를 더했을 때 나온다.\"}},\"2-1-2-18\":{\"p\":\"말명료도(intelligibility)는 청자가 화자의 말을 얼마나 알아듣는가를 나타내는 기능적 지표이다. 측정 방법은 크게 청자가 전반적 인상을 등간척도(예: 5점·7점 척도)로 매기는 평정척도법과, 청자가 알아들은 단어를 받아 적어 그 비율을 구하는 단어 확인(받아쓰기)법이 있다. 자음정확도가 화자의 산출을 목표형과 비교한 지표라면 명료도는 청자 쪽 결과이므로, 오류 유형·일관성·문맥·말속도·운율뿐 아니라 청자의 친숙도와 경험에 따라서도 달라진다. 그래서 PCC가 같아도 명료도는 다를 수 있다.\",\"w\":{\"1\":\"자음정확도가 같아도 오류 유형(생략·대치·왜곡), 오류의 일관성, 운율 등이 다르면 말명료도는 달라질 수 있다. 두 지표는 관련되지만 일치하지는 않는다.\",\"2\":\"말용인도(acceptability)는 말이 얼마나 자연스럽고 정상적으로 들리는가를 뜻한다. 다 알아들을 수 있어도 어색하게 들리면 용인도는 낮을 수 있으므로 명료도와 다른 개념이다.\",\"4\":\"일반적으로 생략이 대치·왜곡보다 명료도를 더 크게 떨어뜨린다. 왜곡은 목표음과 비슷한 소리가 남아 있어 청자가 단어를 추측하기 쉽다.\",\"5\":\"아동의 말에 익숙한 부모·교사는 낯선 청자보다 더 많이 알아듣는 경향이 있다. 청자 친숙도는 명료도 평가에 영향을 주는 대표적 변인이다.\"}},\"2-1-2-19\":{\"p\":\"명료도에 미치는 영향은 오류의 유형과 범위로 판단한다. 유형별로는 일반적으로 소리 자체가 사라지는 생략이 가장 크고, 다른 음소로 바뀌는 대치, 비슷한 소리가 남는 왜곡 순으로 영향이 작아진다. 범위 면에서는 한 음소·한 위치에 국한된 오류보다 여러 음소·여러 위치에 걸친 오류가 단어 형태를 크게 무너뜨린다. '여러 위치에서 나타나는 초성 생략'은 영향이 가장 큰 유형(생략)이면서 범위도 넓고, 초성은 단어를 알아보는 데 중요한 정보를 담고 있어 명료도를 가장 크게 떨어뜨린다.\",\"w\":{\"1\":\"/ㅅ/의 치간음화는 한 음소의 왜곡으로, 목표음과 비슷한 소리가 남아 청자가 단어를 알아듣는 데 큰 지장이 없는 경우가 많다.\",\"2\":\"어말 종성 /ㄹ/의 가벼운 왜곡은 범위가 좁고 정도도 가벼운 왜곡이어서 명료도 저하가 작은 편이다.\",\"4\":\"/ㅈ/의 일관된 파열음화는 대치 오류이지만 한 음소에 국한되어 있어, 여러 위치에 걸친 생략보다 명료도에 미치는 영향이 작다.\",\"5\":\"어말 종성 /ㅇ/의 약화는 한 음소·한 위치의 경미한 변화이므로 명료도에 미치는 영향이 작다.\"}},\"2-1-2-20\":{\"p\":\"아동용 발음평가(APAC)는 그림을 보고 이름을 말하는 37개 단어 검사와 연결발화 검사로 구성되어, 낱말 수준과 연결된 말 수준의 산출을 함께 본다. 결과로 자음정확도와 음운오류패턴 분석을 제공해 또래 기준과 비교할 수 있다. 지문의 '37개 단어'와 '연결발화'가 APAC을 특정하는 단서이다. 비교하여 U-TAP2는 단어 수준·문장 수준 검사로 구성되고, KS-PAPT는 선별검사와 정밀검사로 나뉜다는 점을 묶어서 기억해 두면 검사 구성 문항을 구분하기 쉽다.\",\"w\":{\"2\":\"U-TAP2는 단어 수준 검사와 문장 수준 검사로 구성된 조음음운검사이다. 37개 단어와 연결발화 구성은 APAC의 특징이다.\",\"3\":\"KS-PAPT는 선별검사와 정밀검사로 나뉘어 구성된 그림 조음음운검사로, 37개 단어·연결발화 구성과 맞지 않는다.\",\"4\":\"KOLRA는 해독·읽기유창성·읽기이해 등 읽기 능력과 관련 인지처리를 평가하는 읽기 검사로, 말소리 산출 검사가 아니다.\",\"5\":\"PRES는 취학 전 아동의 수용·표현 언어 발달 수준을 평가하는 언어발달 척도로, 자음정확도나 음운오류패턴을 분석하지 않는다.\"}},\"2-1-2-21\":{\"p\":\"독립분석(independent analysis)은 아동의 산출을 성인 목표형과 비교하지 않고, 아동 나름의 체계로 보고 그 자체를 기술하는 분석이다. 아동이 산출하는 자음·모음 목록(음소 목록), 위치별로 나타나는 자음, 음절구조(V, CV, CVC 등) 목록, 단어 형태 등을 정리한다. 목표형을 정하기 어려운 어린 아동이나 어휘가 적고 명료도가 매우 낮은 아동에게 특히 유용하다. 반대로 관계분석(relational analysis)은 성인 목표형과 비교해 정오를 판단하는 분석으로, 오류 유형 분류, PCC, 오류패턴 출현율이 여기에 속한다.\",\"w\":{\"1\":\"성인 목표형과 비교해 대치·생략·왜곡을 분류하는 것은 관계분석이다. 독립분석은 목표형과의 비교를 하지 않는다.\",\"3\":\"자음정확도는 목표형 자음 중 바르게 산출한 비율로, 목표형과의 비교를 전제로 하는 관계분석 지표이다.\",\"4\":\"학령기 잔존오류 아동은 대개 명료도가 높고 소수 음소의 왜곡을 보이므로 목표형과 비교하는 관계분석과 정밀 음성 전사가 적합하다. 독립분석은 어리거나 명료도가 매우 낮은 아동에게 유용하다.\",\"5\":\"음운오류패턴별 출현율은 목표형과 산출형을 비교해 패턴을 찾아내는 관계분석에 해당한다.\"}},\"2-1-2-22\":{\"p\":\"Shriberg & Kwiatkowski는 PCC로 말소리장애 심각도를 네 단계로 나누었다. 일반적으로 85% 초과는 경도(mild), 65~85%는 경도-중등도(mild-moderate), 50~65%는 중등도-중도(moderate-severe), 50% 미만은 중도(severe)이다. 이 아동의 PCC 48%는 50%보다 낮으므로 중도에 해당한다. 경계값 85·65·50만 외워 두고 위에서부터 차례로 비교하면 바로 판정할 수 있으며, 경계값을 어느 쪽 구간에 넣는지(이상/초과)는 교재에 따라 표기가 조금씩 다를 수 있다.\",\"w\":{\"2\":\"경도-중등도는 PCC 65~85% 구간이다. 48%는 이 구간보다 훨씬 낮다.\",\"3\":\"중등도-중도는 PCC 50~65% 구간이다. 48%는 하한인 50%에 못 미치므로 한 단계 더 심한 중도이다.\",\"4\":\"경도는 PCC 85% 초과 구간이다. 48%와는 거리가 멀다.\",\"5\":\"PCC 48%는 이 기준에서 가장 심한 단계에 해당하므로 정상 범위로 볼 수 없다.\"}},\"2-1-2-23\":{\"p\":\"Dodd는 기능적 말소리장애를 조음장애, 음운지연, 일관적 음운장애, 비일관적 음운장애로 나누고, 운동 계획 문제인 아동기 말실행증과 구분한다. 비일관적 음운장애는 같은 단어를 여러 번 산출하게 하는 비일관성 검사에서 일반적으로 40% 이상 다르게 산출하는 것이 기준이며, 말운동이 아니라 단어의 음운 형태를 계획·조합하는 단계의 결함으로 본다. 이 아동은 40% 이상의 비일관성을 보이면서도 구강운동 기능이 정상이고 모색행동이 없으며 운율이 자연스러워 아동기 말실행증을 배제할 수 있다. 즉 '비일관성 + 운동·운율 징후 없음' 조합이 판단 단서이다.\",\"w\":{\"1\":\"음운지연은 더 어린 아동의 발달적 오류패턴이 또래보다 오래 남는 유형으로 오류가 일관되게 나타난다. 40% 이상의 비일관성과 맞지 않는다.\",\"3\":\"일관적 음운장애는 비발달적 오류패턴을 일관되게 보이는 유형이다. 이 아동은 같은 단어를 매번 다르게 산출하므로 일관성 조건부터 맞지 않는다.\",\"4\":\"아동기 말실행증도 비일관적 오류를 보이지만 모색행동, 음절 간 전이 어려움, 운율 이상이 동반된다. 이 아동은 모색행동이 없고 운율이 자연스러워 해당하지 않는다.\",\"5\":\"조음장애는 /ㅅ/ 등 소수 음소의 일관된 왜곡처럼 말소리를 만드는 운동적 산출 문제가 특징이다. 단어 전체가 매번 달라지는 비일관성과는 다르다.\"}},\"2-1-2-24\":{\"p\":\"아동기 말실행증(CAS)은 근육 약화나 마비 없이 말소리 산출을 위한 운동 계획·프로그래밍에 결함이 있는 신경학적 말소리장애이다. ASHA 기술 보고서 등에서 합의된 핵심 특징으로 같은 단어를 반복할 때 나타나는 자음·모음의 비일관적 오류, 음소·음절 사이 동시조음 전이의 연장·단절, 부적절한 운율(특히 어휘·구 강세) 세 가지가 제시된다. 이 밖에 모음 오류, 모색행동, 발화가 길수록 오류가 늘어나는 현상도 흔히 관찰된다. 마비말장애처럼 근력·근긴장의 문제가 아니고, 음운장애처럼 말소리 규칙만의 문제도 아니라는 점을 구분하는 것이 핵심이다.\",\"w\":{\"1\":\"발달적 오류패턴과 양호한 명료도는 음운지연 쪽 특징이다. CAS는 모음 오류가 흔하고 명료도가 낮은 경우가 많아 정확한 모음 산출과도 맞지 않는다.\",\"2\":\"과다비성, 말 근육의 근력 약화, 느린 말속도는 신경근 손상에 따른 마비말장애(dysarthria)의 특징이다. CAS는 근력 약화 없이 운동 계획에 문제가 있다.\",\"3\":\"일관된 대치, 높은 자극반응도, 정상 운율은 음운지연처럼 언어적 음운 문제를 시사하는 특징이다. CAS는 오류가 비일관적이고 운율이 부적절하다.\",\"4\":\"한 음소의 일관된 왜곡은 조음장애, 청력 손실은 청각장애, 구조적 이상은 구개열 등 기질적 말소리장애와 관련된 특징으로 CAS의 핵심 특징이 아니다.\"}},\"2-1-2-25\":{\"p\":\"구개열 아동은 수술 후에도 연인두 폐쇄부전(VPI)이 남을 수 있어 말할 때 구강과 비강이 충분히 분리되지 않는다. 그 결과 구강 안에 높은 압력을 모아야 하는 고압력 자음(파열음·마찰음·파찰음)이 약하게 산출되고, 기류가 코로 새는 비누출(nasal emission)과 모음의 과다비성이 동반될 수 있다. 이를 보상하려고 연인두보다 뒤쪽인 성문·인두에서 압력을 만드는 보상조음(성문파열음, 인두마찰음 등)이 나타나기도 한다. 반면 비음은 원래 비강 공명을 쓰는 소리라 상대적으로 영향을 적게 받는다.\",\"w\":{\"1\":\"비음 /ㅁ, ㄴ, ㅇ/은 원래 비강으로 기류를 내보내는 소리라 연인두 폐쇄부전의 영향을 덜 받는다. 영향을 크게 받는 것은 구강 압력이 필요한 고압력 자음이다.\",\"3\":\"구개열 아동의 보상조음은 성문파열음·인두마찰음처럼 조음위치가 구강 뒤쪽(후방)으로 이동한 것이다. 앞쪽으로의 전방화가 아니다.\",\"4\":\"구개열 아동의 말 문제는 압력 자음의 약화와 비누출 등 자음에서 두드러지고, 모음은 주로 과다비성이라는 공명 문제로 나타난다. 모음이 자음보다 더 큰 영향을 받는다는 설명은 맞지 않다.\",\"5\":\"연인두 폐쇄부전이 있으면 비강 공명이 지나친 과다비성이 주된 공명 문제이다. 과소비성은 아데노이드 비대나 비염처럼 비강이 막힐 때 나타난다.\"}},\"2-1-2-26\":{\"p\":\"선천성 심도 감각신경성 난청 아동은 말소리를 듣고 자기 말을 점검하는 청각 피드백이 매우 제한된다. 일반적으로 고주파수 대역의 청력 손실이 더 크고, /ㅅ, ㅆ/ 같은 마찰음은 음향 에너지가 주로 고주파수에 있어 가장 듣기 어려우므로 생략·왜곡이 흔하다. 모음은 혀 위치를 정밀하게 구분하지 못해 중설 모음 쪽으로 모이는 중립화(중앙화)가 나타난다. 이 밖에 종성 생략, 음도 이상(지나치게 높거나 단조로운 음도), 운율 이상, 과다비성, 느린 말속도가 동반되어 말명료도가 낮은 경우가 많다.\",\"w\":{\"1\":\"비음 /ㅁ, ㄴ/은 에너지가 저주파수에 몰려 있어 잔존 청력으로 비교적 잘 듣고 산출할 수 있다. 먼저, 더 크게 손상되는 것은 고주파수 마찰음이다.\",\"2\":\"심도 난청 아동은 모음도 중립화되거나 길이·음도가 비정상적으로 산출되는 등 오류가 나타난다. 자음에서만 오류가 있다는 설명은 틀렸다.\",\"3\":\"청각 피드백이 부족해 음도가 지나치게 높거나 단조롭고, 강세·억양 같은 운율에도 이상이 나타나는 경우가 많다.\",\"4\":\"심도 난청 아동은 음절을 늘이거나 쉼이 잦아 말속도가 느린 경향이 있고, 여러 오류가 겹쳐 말명료도가 낮다.\"}},\"2-1-2-27\":{\"p\":\"조음장애(articulation disorder)는 특정 말소리를 만들어 내는 운동적·음성적 산출의 문제로, 아동은 말소리 대조 체계는 갖추고 있지만 한두 음소를 정확히 만들지 못한다. 그래서 '/ㅅ/의 일관된 설측음화 외 다른 음소는 정확함'처럼 소수 음소의 일관된 왜곡이 전형적이며, 명료도 저하나 읽기·쓰기 문제 동반 위험이 상대적으로 적다. 반면 음운장애(phonological disorder)는 말소리 체계와 규칙을 조직하는 언어적 문제로, 여러 음소에 걸친 대치·생략 패턴, 음소 붕괴, 낮은 명료도가 나타나고 음운인식·읽기·쓰기 어려움을 동반할 위험이 크다. '오류가 몇 개 음소에 국한되는가, 패턴처럼 퍼져 있는가'가 핵심 구분 단서이다.\",\"w\":{\"1\":\"여러 음소에 걸쳐 일관되게 나타나는 대치 패턴은 말소리 체계 수준의 문제로, 음운장애의 특징이다.\",\"2\":\"종성생략은 음절구조를 단순화하는 음운오류패턴이며, 이로 인한 명료도 저하도 음운장애에서 두드러진다.\",\"3\":\"음운인식 결함과 읽기·쓰기 어려움은 말소리 표상의 언어적 문제와 관련되어 음운장애 아동에게 더 흔히 동반된다.\",\"5\":\"음소 붕괴(phoneme collapse)는 여러 목표음이 하나의 음소로 합쳐져 대조가 사라지는 현상으로, 음운 체계의 문제인 음운장애의 특징이다.\"}},\"2-1-2-28\":{\"p\":\"Van Riper의 전통적 조음치료는 음소를 하나씩 운동적으로 가르치는 접근이다. 먼저 감각-지각 훈련(청지각·변별 훈련, ear training)으로 목표음과 오류음의 차이를 듣고 구별하게 한다. 다음 독립음 확립 단계에서 모방, 조음위치 지시, 점진적 접근 등으로 목표음을 처음 만들게 한다. 이어 안정화 단계에서 음절 → 단어 → 구 → 문장 → 대화로 단위를 넓히고, 전이(일반화) 단계에서 치료실 밖 상황과 다른 사람에게로 옮기며, 마지막 유지 단계에서 정조음을 지속시킨다. '듣기 → 만들기 → 단위 넓히기 → 다른 상황으로 옮기기 → 지속하기'의 흐름으로 기억하면 순서를 뒤섞은 보기를 쉽게 거를 수 있다.\",\"w\":{\"1\":\"단어 훈련이 독립음 확립보다 앞서고 감각-지각 훈련이 중간에 있으며, 유지가 전이보다 앞서 있다. 전통적 접근은 감각-지각 훈련으로 시작해 유지로 끝난다.\",\"3\":\"독립음 확립이 감각-지각 훈련보다 앞서 있다. 전통적 접근은 목표음을 먼저 듣고 변별하게 한 뒤 산출을 확립한다.\",\"4\":\"전이가 첫 단계로 와 있다. 전이는 목표음이 확립·안정화된 뒤 치료실 밖으로 옮기는 후반 단계이다.\",\"5\":\"문장 훈련이 독립음 확립보다 앞서고 유지와 전이의 순서도 뒤바뀌었다. 산출은 독립음에서 문장으로 넓혀 가며, 전이 다음에 유지가 온다.\"}},\"2-1-2-29\":{\"p\":\"짝자극 기법(paired-stimuli approach, Weston & Irwin)은 아동이 이미 목표음을 바르게 내는 단어를 발판 삼아 정조음을 다른 단어로 넓히는 단어 수준의 행동주의적 기법이다. 먼저 목표음을 일관되게 정조음하는 핵심단어(key word, 일반적으로 10회 중 9회 이상 정조음)를 찾고, 목표음을 오조음하는 훈련단어(training word) 여러 개를 핵심단어와 번갈아 짝지어 산출하게 한다(핵심단어–훈련단어1–핵심단어–훈련단어2…). 이후 구·문장 수준으로 넓혀 간다. 독립음에서 시작하는 전통적 접근과 달리 처음부터 단어에서 시작한다는 점이 차이이다.\",\"w\":{\"1\":\"핵심단어는 목표음을 일관되게 정조음하는 단어로, 일반적으로 10회 중 9회 이상 정조음해야 한다. 10회 중 3회 이하라면 훈련단어에 가깝다.\",\"3\":\"최소대립쌍으로 단어 간 의미 대조를 가르치는 것은 음운론적 대조 접근법(최소대립쌍 접근법)이다. 짝자극 기법은 의미 대조가 아니라 정조음 단어와의 짝짓기를 이용한다.\",\"4\":\"독립음 수준에서 목표음을 확립하며 시작하는 것은 전통적 조음치료(Van Riper)의 특징이다. 짝자극 기법은 단어 수준에서 시작한다.\",\"5\":\"회기마다 청각적 자극(auditory bombardment, 집중 듣기)을 넣는 것은 주기법(Hodson & Paden)의 특징이다.\"}},\"2-1-2-30\":{\"p\":\"이 아동은 /ㅅ, ㅈ, ㄱ, ㅋ/ 네 음소를 모두 /ㄷ/ 하나로 대치하고 있어, 여러 목표음이 한 음소로 합쳐진 음소 붕괴(phoneme collapse)를 보인다. 다중대립 접근법(multiple oppositions, Williams)은 이처럼 하나의 대치음과 여러 목표음을 한 번에 대조하는 방식으로, 예컨대 '달–살–잘–갈–칼'처럼 [ㄷ]와 각 목표음이 대립하는 단어 묶음을 사용한다. 여러 의미를 한 가지 형태로 말하면 의사소통이 실패한다는 것을 아동이 깨닫게 해 붕괴된 음운 체계를 한꺼번에 재조직하도록 돕는다. 한 쌍씩 대조하는 방법보다 붕괴 범위가 넓은 체계를 효율적으로 다룰 수 있다는 점이 선택 근거이다.\",\"w\":{\"1\":\"최소대립쌍 접근법은 한 자질만 다른 두 음소(예: /ㄷ/–/ㄱ/)를 한 쌍씩 대조한다. 네 음소가 한꺼번에 붕괴된 경우에는 한 쌍씩 다루는 것이 효율적이지 않다.\",\"2\":\"최대대립 접근법은 자질 차이가 큰 두 음소를 한 쌍으로 대조하는 방법이다. 여러 목표음이 하나로 합쳐진 구조를 한꺼번에 다루지는 않는다.\",\"3\":\"짝자극 기법은 정조음 핵심단어와 오조음 훈련단어를 짝짓는 행동주의적 조음 기법으로, 음소 간 대조를 이용하는 대조 접근법이 아니다.\",\"5\":\"핵심어휘 접근법은 비일관적 음운장애 아동에게 기능적 단어를 일관되게 산출시키는 방법이다. 이 아동은 일관되게 /ㄷ/으로 대치하므로 대상이 맞지 않고, 대조 접근법도 아니다.\"}},\"2-1-2-31\":{\"p\":\"주기법(cycles approach, Hodson & Paden)은 여러 오류패턴으로 말명료도가 매우 낮은 아동을 위해 고안되었다. 오류패턴마다 목표음을 정해 일정 시간 다룬 뒤 숙달 여부와 관계없이 다음 패턴으로 넘어가고, 목표 패턴을 한 번씩 모두 다룬 것을 한 주기로 하여 아직 남은 패턴을 다음 주기에 다시 순환한다. 음운 발달이 한 소리씩 완성되는 것이 아니라 여러 패턴이 점진적으로 함께 발달한다는 관점에 근거한다. 회기는 일반적으로 복습, 청각적 자극(집중 듣기), 목표 단어 산출 활동, 자극반응도 확인 등으로 구성되며, 세부 구성은 교재에 따라 조금씩 다르게 소개된다.\",\"w\":{\"1\":\"주기법의 주 대상은 여러 오류패턴으로 명료도가 매우 낮은 아동이다. 소수 음소의 잔존오류를 보이는 학령기 아동에게는 전통적 조음치료 등이 더 적합하다.\",\"2\":\"말소리 자질에 대한 상위언어적 인식 지도를 1단계로 하는 것은 상위음운 접근법(Metaphon)이다.\",\"3\":\"한 패턴을 숙달 기준에 도달할 때까지 훈련한 뒤 넘어가는 것은 수직적 접근법이다. 주기법은 숙달 기준 없이 정해진 시간이 지나면 넘어간다.\",\"4\":\"독립음 수준의 반복 산출 훈련은 전통적 조음치료의 특징이다. 주기법은 청각적 자극과 단어 수준 산출 활동이 중심이다.\"}},\"2-1-2-32\":{\"p\":\"상위음운 접근법(Metaphon)은 아동이 말소리의 특성을 의식하고 생각할 수 있는 상위음운 인식을 길러 음운 체계의 변화를 이끄는 방법이다. 1단계(인식 단계)에서는 먼저 '긴/짧은', '앞/뒤', '시끄러운/조용한' 같은 비언어적 대조 개념을 익히고, 이를 일반 소리 → 말소리 → 단어 수준으로 옮겨 가며 오류와 관련된 자질을 인식하게 한다(예: 마찰음은 '긴 소리', 파열음은 '짧은 소리'). 2단계(의사소통 단계)에서는 최소대립쌍을 활용한 의사소통 상황에서 청자가 못 알아들을 때 아동이 스스로 산출을 고치게 한다. 따라서 대조 개념을 인식시키는 활동이 1단계에 해당한다.\",\"w\":{\"1\":\"최대대립쌍 단어를 반복 산출하며 정확도를 높이는 것은 산출 중심의 대조 접근법 활동이다. Metaphon 1단계는 산출보다 인식에 초점을 둔다.\",\"2\":\"구강 근육 강화 운동은 비구어 구강운동 활동으로, 말소리 자질의 상위음운 인식을 다루는 Metaphon과 관련이 없다.\",\"4\":\"의사소통 상황에서 산출을 수정하게 하는 것은 Metaphon의 2단계(의사소통 단계)에 가까운 활동이다. 1단계는 개념·인식을 형성하는 단계이다.\",\"5\":\"비단어 따라말하기로 음운 작업기억을 훈련하는 것은 음운처리 훈련 활동으로, Metaphon 1단계의 대조 개념 인식과 다르다.\"}},\"2-1-2-33\":{\"p\":\"핵심어휘 접근법(core vocabulary approach, Dodd)은 비일관적 음운장애 아동을 위한 방법이다. 이 아동들의 문제를 단어마다 일관된 음운 형태를 계획하지 못하는 결함으로 보기 때문에, 특정 음소가 아니라 단어 전체를 일관되게 산출하는 것을 목표로 한다. 가족·교사와 함께 아동 생활에서 자주 쓰는 기능적 단어를 수십 개(교재에 따라 50~70개 정도로 소개) 고르고, 회기마다 일부를 골라 음소 단위로 나누어 가르친 뒤 아동이 할 수 있는 최선의 형태를 반복해 일관되게 산출하게 한다. 완벽한 성인형이 아니어도 일관성을 우선한다는 점이 다른 접근과의 차이이다.\",\"w\":{\"1\":\"최소대립쌍의 의미 대조로 음운 체계를 재구조화하는 것은 최소대립쌍·최대대립·다중대립 같은 대조 접근법의 원리이다.\",\"2\":\"잔존오류 아동의 /ㅅ/ 왜곡 교정에는 전통적 조음치료 같은 운동적 접근이 주로 쓰인다. 핵심어휘 접근법은 오류가 비일관적인 아동이 대상이다.\",\"3\":\"한 음소를 독립음에서 확립한 뒤 넓혀 가는 것은 전통적 조음치료(Van Riper)의 방식이다. 핵심어휘 접근법은 단어 전체를 단위로 한다.\",\"4\":\"운율과 강세 개선을 1차 목표로 삼는 것은 말실행증 중재에서 다루는 내용이다. 핵심어휘 접근법의 1차 목표는 기능적 단어의 일관된 산출이다.\"}},\"2-1-2-34\":{\"p\":\"일반화(generalization)는 훈련한 행동이 훈련하지 않은 조건으로 확대되는 것이며, 무엇이 달라졌는지에 따라 유형을 나눈다. 이 아동은 /ㅅ/를 어두 초성에서만 훈련했는데, '가수'와 '버섯'의 둘째 음절 초성처럼 훈련하지 않은 단어 내 위치(어중 초성)에서도 정조음하게 되었다. 같은 음소, 같은 단어 단위에서 '단어 속 위치'가 바뀐 것이므로 위치 일반화(position generalization)이다. 음성 문맥(앞뒤 모음 등)이 바뀌면 문맥 일반화, 단위가 단어 → 문장으로 커지면 언어단위 일반화, 다른 음소로 넓어지면 음소 간 일반화, 장소·사람이 바뀌면 상황 일반화로 구분한다.\",\"w\":{\"2\":\"언어단위 일반화는 음절 → 단어 → 구 → 문장처럼 더 큰 언어 단위로 정조음이 확대되는 것이다. 이 사례는 단위가 아니라 단어 안 위치가 달라졌다.\",\"3\":\"상황 일반화는 치료실에서 가정·학교 등 다른 장소나 다른 대화 상대로 정조음이 확대되는 것이다. 이 사례에는 장소나 사람의 변화가 언급되지 않았다.\",\"4\":\"음소 간 일반화는 훈련한 음소에서 /ㅆ/ 같은 훈련하지 않은 다른 음소로 정조음이 확대되는 것이다. 이 사례는 같은 /ㅅ/에서 나타난 변화이다.\",\"5\":\"문맥 일반화는 인접 모음·자음 같은 음성 문맥이 달라져도 정조음하는 것이다. 이 사례의 핵심 변화는 단어 내 위치(어두→어중)이다.\"}},\"2-1-2-35\":{\"p\":\"목표 접근 전략은 일정 기간 동안 목표를 몇 개, 어떤 방식으로 다루는지에 따라 수직적·수평적·주기적 접근으로 나누는 것이 일반적이다(Fey의 구분이 널리 소개된다). 수평적 접근법(horizontal approach)은 여러 목표를 같은 회기 안에서 동시에 다루는 방식으로, /ㅅ/, /ㄹ/, 종성 /ㄱ/ 세 가지를 한 회기에 15분씩 나누어 훈련한 이 사례가 여기에 해당한다. 여러 목표를 함께 다뤄 실제 대화 맥락에 가깝다는 장점이 있지만 목표별 집중 연습량은 적어진다. 판단 단서는 '한 회기 안에서 여러 목표를 동시에'라는 표현이다.\",\"w\":{\"1\":\"수직적 접근법은 한두 개 목표를 정해진 준거에 도달할 때까지 집중 훈련한 뒤 다음 목표로 넘어가는 방식으로, 한 회기에 세 목표를 함께 다루는 것과 다르다.\",\"2\":\"주기적 접근법은 일정 기간마다 목표를 바꾸어 순환하는 방식이다. 한 회기 안에서 세 목표를 동시에 다루는 이 사례는 순환이 아니다.\",\"4\":\"절충적 접근법은 수직적·수평적 접근의 요소를 섞어 쓰는 방식을 가리킨다. 여러 목표를 한 회기에 동시에 다루는 방식 자체의 명칭은 수평적 접근법이다.\",\"5\":\"위계적 접근법은 쉬운 단위에서 어려운 단위로 단계적으로 진행하는 구성을 가리키는 표현으로, 목표를 몇 개씩 다루는지에 따른 목표 접근 전략의 명칭이 아니다.\"}},\"2-1-2-36\":{\"p\":\"지문의 핵심 단서는 '혼자서는 못 하지만 도움을 받으면 할 수 있는 수준'과 '지원(비계)을 제공하고 점차 줄여 나간다'이다. 앞의 것은 비고츠키(Vygotsky)의 근접발달영역(ZPD), 뒤의 것은 브루너(Bruner)가 발전시킨 비계 설정(scaffolding) 개념으로, 둘 다 언어 발달의 동력을 '성인과의 사회적 상호작용'에 두는 사회적 상호작용주의의 대표 개념이다. 이 관점에서는 아동의 타고난 능력이나 인지 발달만으로는 부족하고, 성인이 아동 수준에 맞추어 말을 조절하고 도움을 주는 과정이 필수적이라고 본다. 언어치료의 확장·평행발화·부모 교육 같은 상호작용 중심 중재가 이 이론에 근거한다.\",\"w\":{\"1\":\"행동주의(Skinner)는 언어를 모방과 강화(보상)를 통해 형성되는 행동으로 본다. 지문은 강화가 아니라 수준에 맞춘 도움과 그 도움의 점진적 철회(비계)를 설명하고 있다.\",\"2\":\"생득주의(Chomsky)는 인간이 타고난 언어습득장치(LAD)·보편문법으로 언어를 습득하며 환경 입력은 촉발 역할만 한다고 본다. 성인의 지원을 습득의 핵심 동력으로 보는 지문과 맞지 않는다.\",\"3\":\"인지적 구성주의(Piaget)는 대상영속성 같은 인지 발달이 언어 발달에 선행한다고 보며, 아동이 스스로 환경을 탐색하며 지식을 구성하는 것을 강조한다. 성인의 도움 수준 조절이라는 사회적 요소는 이 이론의 중심이 아니다.\",\"4\":\"연결주의는 신경망처럼 반복되는 언어 입력의 통계적 규칙성을 학습해 연결 강도가 바뀐다는 설명이다. 근접발달영역이나 비계 같은 상호작용 개념은 사용하지 않는다.\"}},\"2-1-2-37\":{\"p\":\"반복적 옹알이(reduplicated/canonical babbling)는 '바바바', '마마마'처럼 같은 자음+모음(CV) 음절을 되풀이하는 단계로, 일반적으로 6~9개월경(교재에 따라 6~10개월) 나타난다. 처음으로 성인 말과 비슷한 음절 구조(자음과 모음의 빠른 전이)가 나타난다는 점에서 말 발달의 중요한 이정표이며, 청각장애 아동은 이 단계의 출현이 늦거나 약해 조기 선별 지표로도 쓰인다. 같은 음절의 반복(반복적)인지, 서로 다른 음절의 연쇄(변형적)인지를 구분하는 것이 판단 포인트이다.\",\"w\":{\"1\":\"자곤(jargon)은 실제 낱말은 없지만 문장 같은 억양과 리듬을 지닌 발성으로, 일반적으로 10개월 이후 첫 낱말 시기 전후에 두드러진다. 반복적 옹알이보다 뒤의 단계이다.\",\"2\":\"목 뒤쪽에서 나는 '구구' 같은 연구개음·모음 위주 소리는 쿠잉(cooing, 목울림) 단계의 특징으로 2~3개월경이다. 아직 자음-모음 음절 구조가 갖춰지기 전이다.\",\"4\":\"관습적 의미를 지닌 첫 낱말은 일반적으로 12개월 전후에 나타나는 첫 낱말기의 특징이다. 반복적 옹알이는 의미 없이 소리를 놀이처럼 반복하는 단계이다.\",\"5\":\"'바다구'처럼 서로 다른 자음과 모음이 섞인 음절 연쇄는 변형적(variegated) 옹알이로, 일반적으로 반복적 옹알이 이후(약 9~12개월경)에 나타난다.\"}},\"2-1-2-38\":{\"p\":\"베이츠(Bates)는 의사소통 의도 발달을 언향적(약 0~8개월) → 언표내적(약 8~12개월) → 언표적(약 12개월 이후) 단계로 나눈다. 지문의 아동은 장난감을 향해 손을 뻗고(몸짓), '어어'라고 발성하며, 엄마 얼굴과 대상을 번갈아 보는 시선 교대를 보인다. 시선 교대는 '상대가 내 신호를 받아 주기를 기대한다'는 의도적 의사소통의 핵심 증거이므로 의도가 있는 단계이고, 아직 관습적 낱말이 없으므로 언표적 단계 이전, 즉 언표내적 단계에 해당한다. 판단 순서는 '의도가 있는가 → 낱말로 표현하는가'이다.\",\"w\":{\"1\":\"언향적(perlocutionary) 단계는 아동의 울음·웃음 같은 행동에 의도가 없고 성인이 의미를 부여해 해석해 주는 시기이다. 시선 교대를 하며 의도적으로 신호를 보내는 지문의 아동보다 앞선 단계이다.\",\"2\":\"언표적(locutionary) 단계는 관습적 낱말을 사용해 의도를 표현하는 시기이다. 지문에서 아동은 아직 관습적인 낱말을 산출하지 않는다고 명시되어 있다.\",\"4\":\"자곤은 문장 같은 억양을 지닌 발성 형태를 가리키는 옹알이 발달 용어로, 베이츠의 의사소통 의도 발달 단계에 포함되는 단계가 아니다.\",\"5\":\"낱말조합은 두 낱말을 이어 말하는 표현언어 발달 단계(대략 18~24개월 이후)로, 베이츠의 의도 발달 단계 명칭이 아니며 낱말이 없는 지문의 아동에게 맞지 않는다.\"}},\"2-1-2-39\":{\"p\":\"가리키기(pointing)가 어떤 기능인지는 '아동이 무엇을 얻으려 하는가'로 판단한다. 지문에서 아동은 새를 가리키며 엄마 얼굴을 쳐다보고(시선 교대), 엄마가 '새가 있네'라고 말해 주는 것으로 상호작용이 끝난다. 즉 아동은 사물이나 도움이 아니라 엄마와 '새에 대한 관심을 함께 나누는 것' 자체를 원한 것이므로 원시서술(protodeclarative), 곧 서술(언급·주의끌기) 기능이다. 반면 원하는 물건을 가리키고 성인이 그것을 건네줘야 끝나는 경우는 원시명령(protoimperative), 즉 요구 기능이다. 원시서술 가리키기의 결여는 자폐스펙트럼장애의 초기 지표로도 중요하다.\",\"w\":{\"1\":\"사물 요구하기는 원하는 물건을 얻기 위해 가리키거나 손을 뻗는 원시명령 기능이다. 창밖의 새는 아동이 가질 수 있는 대상이 아니고, 엄마가 말로 반응해 주는 것으로 충족되었다.\",\"2\":\"행동 요구하기는 성인에게 어떤 동작(열어 달라, 안아 달라 등)을 하도록 시키는 기능이다. 지문의 아동은 엄마에게 행동을 요구하지 않고 관심 대상을 보여 주고 있다.\",\"3\":\"거부하기는 원하지 않는 사물·활동을 밀어내거나 고개를 젓는 등 싫다는 의사를 나타내는 기능이다. 지문에는 거부 상황이 없다.\",\"4\":\"인사하기는 만나거나 헤어질 때 손 흔들기·'안녕' 등으로 사회적 의례를 수행하는 기능이다. 대상을 가리키며 주의를 공유하는 지문의 행동과 다르다.\"}},\"2-1-2-40\":{\"p\":\"두 낱말 의미관계는 각 낱말이 문장에서 하는 의미 역할로 분석한다. '또 줘'의 '또'는 이미 일어난 일이나 사물이 다시 나타나기를 바라는 재현(recurrence)을, '줘'는 동작을 나타내므로 재현-행위 관계이다. 재현은 '또', '더', '하나 더' 같은 표현으로 나타나며 초기 두 낱말 시기에 흔하다. 다른 보기를 분석할 때는 앞 낱말이 행위자(동작을 하는 주체)인지, 소유자인지, 장소인지, 부정인지를 먼저 따지고 뒤 낱말이 대상(사물)인지 행위(동작)인지, 상태(서술)인지를 구분하면 된다.\",\"w\":{\"1\":\"'엄마 가방'은 '엄마의 가방'이라는 뜻으로 소유자-소유물(소유자-대상) 관계이다. 행위자-대상은 '엄마 밥'(엄마가 밥을 [먹는다])처럼 동작을 하는 주체와 그 대상이 연결된 경우이다.\",\"2\":\"'공 커'의 '커'는 동작이 아니라 공의 상태·속성을 나타내므로 실체-서술(실체-수식) 관계이다. 대상-행위는 '공 던져'처럼 동작의 대상과 동작이 연결된 경우이다.\",\"4\":\"'안 먹어'에서 부정어 '안'이 결합한 '먹어'는 사물이 아니라 동작이므로 부정-행위 관계이다. 부정-대상은 '사탕 없어', '안 사탕'처럼 사물이 부정의 대상이 되는 경우이다.\",\"5\":\"'여기'는 동작이 일어나는 곳을 나타내므로 '여기 앉아'는 장소-행위 관계이다. '여기'는 동작이 가해지는 사물(대상)이 아니다.\"}},\"2-1-2-41\":{\"p\":\"평균형태소길이(MLU-m)는 '전체 형태소 수 ÷ 발화 수'로 구한다. 문제 조건에 따라 용언은 어간과 어미를 나누고, 조사·선어말어미도 각각 1개로 센다. ① 엄마/물/주-/-어 = 4, ② 공/던지-/-어 = 3, ③ 아빠/-가/오-/-았-/-어 = 5('왔어'는 '오-+-았-+-어'의 축약), ④ 안/먹-/-어 = 3. 총 4+3+5+3 = 15개이고 15 ÷ 4 = 3.75이다. 검산: 3.75 × 4 = 15로 형태소 합과 일치한다. 축약된 형태(왔어, 줘)는 겉으로 한 덩어리처럼 보여도 원래 형태로 되돌려 나누어 세는 것이 핵심이다.\",\"w\":{\"2\":\"총 14개(14 ÷ 4 = 3.50)로 센 값이다. ③ '왔어'에서 선어말어미 '-았-'을 따로 세지 않았거나 조사 '-가' 하나를 빠뜨리면 이 값이 나온다.\",\"3\":\"총 13개(13 ÷ 4 = 3.25)로 센 값이다. ③의 조사 '-가'와 선어말어미 '-았-'을 모두 빼고 '아빠/왔-/-어'처럼 세면 이 값이 나온다.\",\"4\":\"총 16개(16 ÷ 4 = 4.00)로 센 값이다. 발화에 실제로 없는 형태소를 더한 실수로, 예를 들어 ① '엄마 물 줘'에서 생략된 목적격 조사 '-을'을 복원해 '물/-을'로 세면 이 값이 나온다. 형태소는 아동이 실제로 말한 것만 센다.\",\"5\":\"총 17개(17 ÷ 4 = 4.25)로 센 값이다. ①의 '물(을)'과 ②의 '공(을)'처럼 생략된 조사 두 개를 복원해 세면 이 값이 나오며, 실제로 산출하지 않은 형태소는 세지 않아야 한다.\"}},\"2-1-2-42\":{\"p\":\"자발화 분석의 목적은 아동이 평소에 보이는 '대표적인' 언어 수행을 파악하는 것이다. 한 상황(예: 놀이)에서만 수집하면 그 상황의 특성(장난감 이름 위주, 짧은 요구 위주 등)에 따라 결과가 치우칠 수 있으므로, 놀이·대화·이야기 등 두 가지 이상의 상황과 대화 상대(부모, 치료사)에서 수집하는 것이 원칙이다. 또한 개방형 질문과 아동 주도를 따르는 방식으로 유도하고, 충분한 양(일반적으로 50~100발화 이상, 교재에 따라 다름)을 확보한 뒤 분석 가능한 발화만 골라 분석한다.\",\"w\":{\"1\":\"'네/아니오' 질문(폐쇄형 질문)은 아동이 한 낱말이나 고개 끄덕임으로만 답하게 만들어 발화 길이와 다양성을 인위적으로 줄인다. 자발화 유도에는 개방형 질문, 평행발화, 기다리기가 권장된다.\",\"2\":\"직전 발화를 그대로 따라 한 즉각 모방·반복 발화는 아동 스스로 만든 발화가 아니므로 MLU 등 분석에서는 일반적으로 제외한다. 포함하면 아동의 능력이 과대평가될 수 있다.\",\"3\":\"발화 10개 정도는 표본이 너무 작아 우연한 변동이 크게 반영되므로 신뢰로운 분석이 어렵다. 일반적으로 최소 50발화 이상, 가능하면 100발화 정도를 수집한다.\",\"4\":\"알아들을 수 없는(불명료) 발화는 형태소 경계를 정확히 나눌 수 없으므로 MLU 계산에서 제외한다. 다만 불명료 발화의 비율은 따로 기록해 명료도 판단에 참고할 수 있다.\"}},\"2-1-2-43\":{\"p\":\"대화 수정(conversational repair) 전략은 청자가 '응? 뭐라고?' 같은 명료화 요구를 했을 때 화자가 메시지를 다시 전달하는 방식이다. 판단 단서는 원래 발화와 수정 발화를 비교하는 것이다. 원래 발화 '잼 줘'의 핵심(잼, 줘)은 그대로 유지되었고, 여기에 '딸기'라는 수식어와 '빵에 발라 먹게'라는 목적 정보가 덧붙었으므로 첨가(addition) 전략이다. 원래 발화의 구조를 버리고 다른 표현으로 바꿨다면 수정(revision), 그대로 되풀이했다면 반복이다. 첨가·수정 전략은 반복보다 발달적으로 더 성숙한 수정 방식으로 본다.\",\"w\":{\"1\":\"반복(repetition)은 원래 발화를 그대로 다시 말하는 전략으로, 여기서는 '잼 줘'를 한 번 더 말하는 경우이다. 지문의 아동은 새로운 낱말과 정보를 덧붙였다.\",\"3\":\"단서 제공(cue)은 청자가 이해할 수 있도록 배경·맥락을 설명하는 전략으로, 예를 들어 '아까 냉장고에 있던 거'처럼 지시 대상을 찾도록 돕는 경우이다. 지문은 원래 문장에 정보가 바로 덧붙은 형태이다.\",\"4\":\"수정(revision)은 원래 발화의 낱말이나 문장 구조를 바꾸어 다르게 말하는 전략이다. 지문은 '잼 줘'의 구조를 그대로 유지하고 그 위에 정보를 더했으므로 첨가에 더 가깝다.\",\"5\":\"무반응은 명료화 요구를 받고도 아무런 수정 시도를 하지 않는 것이다. 지문의 아동은 적극적으로 발화를 다시 산출했다.\"}},\"2-1-2-44\":{\"p\":\"이야기 문법(story grammar, Stein & Glenn)은 이야기를 배경 → 계기 사건 → 내적 반응 → 시도 → 결과 → 반응(결말)의 구성 요소로 나눈다. 판단 단서는 그 문장이 '사건(일어난 일)'인지, '주인공 마음속(감정·생각·계획)'인지, '주인공의 행동'인지이다. 세 번째 문장 '속상해서 울고 싶었어요'는 계기 사건(연이 나무에 걸림)을 겪은 주인공의 감정을 나타내므로 내적 반응이다. 내적 반응은 이후의 시도(막대기로 내리려 함)를 일으키는 동기가 되며, 학령기 언어장애 아동은 이야기 다시 말하기에서 이 내적 반응 요소를 자주 빠뜨린다.\",\"w\":{\"2\":\"계기 사건은 주인공이 문제에 부딪히게 만드는 사건으로, 이 이야기에서는 두 번째 문장 '연줄이 끊어져 연이 나무에 걸렸어요'이다. 세 번째 문장은 그 사건에 대한 감정이다.\",\"3\":\"배경은 인물·시간·장소를 소개하는 부분으로, 첫 문장 '어느 날 지우는 공원에서 연을 날렸어요'에 해당한다.\",\"4\":\"시도는 문제를 해결하려는 주인공의 행동으로, 네 번째 문장 '긴 막대기로 연을 내리려고 했어요'이다. 세 번째 문장에는 행동이 아니라 감정만 있다.\",\"5\":\"결과는 시도로 인해 문제가 해결되었는지를 나타내는 부분으로, 다섯 번째 문장 '결국 연을 다시 찾았어요'이다. 마지막 문장 '기분이 좋아졌어요'는 결과에 대한 반응(결말)이다.\"}},\"2-1-2-45\":{\"p\":\"결속표지(cohesive device, Halliday & Hasan)는 문장과 문장을 의미적으로 이어 주는 언어 장치로, 지시(대용)·대치·생략·접속·어휘적 결속으로 나뉜다. ②의 '그것은'은 앞 문장의 '공'을 다시 가리키는 대명사이므로 지시(대용) 결속이다. 지시 결속은 청자가 앞 문맥에서 지시 대상을 찾아야 의미가 완성되는데, 이야기 산출에서 지시 대상이 불분명한 '그거', '걔'를 남발하는 것은 학령기 언어장애 아동의 흔한 담화 특성이다. 유형을 가를 때는 '대명사로 가리킴(지시)', '연결어로 이음(접속)', '말을 빼 버림(생략)', '같은·관련된 낱말로 이음(어휘)'을 기준으로 삼는다.\",\"w\":{\"1\":\"'그래서'는 앞 문장과 뒤 문장의 인과관계를 나타내는 접속어이므로 접속 결속이다. 생략은 앞에 나온 성분을 뒤에서 빼고 말하는 것이다.\",\"3\":\"'강아지'를 '그 개'로 받은 것은 같은 대상을 상위어로 다시 표현한 어휘적 결속이다. 접속은 '그리고, 그래서, 그런데'처럼 연결어로 문장 관계를 나타내는 것이다.\",\"4\":\"'나는 빵을 (먹었고), 동생은 우유를 먹었어'에서 앞 절의 서술어가 빠져 있으므로 생략 결속이다. 대명사로 앞말을 가리키는 표현은 나타나지 않는다.\",\"5\":\"'먼저', '그다음에'는 사건의 시간 순서를 나타내는 연결 표현이므로 접속(시간적 접속) 결속이다. 어휘적 결속은 반복·동의어·상위어 등 낱말 선택으로 이어지는 것이다.\"}},\"2-1-2-46\":{\"p\":\"상위언어(metalinguistic) 능력은 언어를 의사소통 수단으로 '사용'하는 것을 넘어, 언어 자체를 하나의 대상으로 떼어 놓고 생각·분석·조작하는 능력이다. '나무에서 나를 빼면?'은 낱말의 뜻과 상관없이 낱말을 음절이라는 소리 단위로 쪼개고 그중 하나를 지워 보는 음절 탈락 과제로, 음운인식이라는 대표적 상위언어 능력을 평가한다. 상위언어 능력에는 음운인식 외에도 문법성 판단(이 문장이 맞나?), 중의성·비유·말장난 이해, 낱말 정의하기 등이 포함되며 학령기 읽기·쓰기 발달과 밀접하다.\",\"w\":{\"1\":\"문장 따라 말하기는 들은 문장을 기억해 다시 산출하는 과제로, 구문 능력과 언어성 작업기억·청각 기억을 평가한다. 언어를 분석 대상으로 삼지는 않는다.\",\"2\":\"그림 보고 이름 말하기는 표현 어휘와 낱말 인출(이름대기) 능력을 보는 과제로, 낱말을 의사소통 목적으로 사용하는 것이다.\",\"3\":\"지시 따르기는 '위' 같은 공간 개념어와 문장 구조를 이해하는지 보는 수용언어 과제이다. 언어 형태 자체를 분석하는 과제가 아니다.\",\"5\":\"그림 속 사물의 색깔·모양 말하기는 속성 개념어(어휘)와 기술하기 능력을 보는 표현언어 과제이다. 언어 자체에 대해 판단하는 상위언어 과제와 구분된다.\"}},\"2-1-2-47\":{\"p\":\"아동이 새 낱말의 뜻을 빠르게 좁혀 가는 데 쓰는 어휘 습득 제약(가정)에는 전체대상·분류(유목)·상호배타성 가정이 있다. 상호배타성 가정(mutual exclusivity)은 '한 사물에는 하나의 이름만 있다'고 여기는 것으로, 이미 이름을 아는 사물(컵)과 처음 보는 사물이 함께 있을 때 새 낱말을 들으면 이름을 모르는 낯선 사물에 연결한다. 이 원리 덕분에 아동은 성인이 일일이 가르쳐 주지 않아도 새 낱말의 지시 대상을 추론할 수 있다. 과잉확장·과소확장은 낱말이 가리키는 범위를 너무 넓히거나 좁히는 '오류' 현상이므로 습득 가정과는 성격이 다르다.\",\"w\":{\"1\":\"'공'을 자기 공에만 쓰는 것은 낱말의 지시 범위를 실제보다 좁게 쓰는 과소확장(underextension)의 예이다. 과잉확장은 범위를 지나치게 넓혀 쓰는 것이다.\",\"2\":\"'아빠'를 모든 성인 남자에게 쓰는 것은 낱말의 범위를 지나치게 넓혀 쓰는 과잉확장(overextension)의 예이다. 과소확장은 ①처럼 범위를 좁게 쓰는 것이다.\",\"3\":\"전체대상 가정(whole object)은 새 낱말을 사물의 부분이나 색깔이 아닌 사물 전체의 이름으로 해석하는 경향이다. 보기는 이 가정과 정반대로 설명하고 있다.\",\"5\":\"빠른 연결(fast mapping)은 한두 번의 짧은 노출만으로 낱말과 의미를 잠정적으로 연결하는 능력이다. 수십 번의 노출 후 습득하는 것은 이후의 느린 연결(slow mapping, 의미 정교화) 과정에 가깝다.\"}},\"2-1-2-48\":{\"p\":\"읽기의 단순관점(Gough & Tunmer)은 읽기이해(RC)를 해독(D)과 언어이해(LC)의 곱(RC = D × LC)으로 본다. 곱셈 관계이므로 둘 중 하나라도 0에 가까우면 읽기이해가 무너진다. 이 두 축을 조합하면 네 유형이 나오는데, 난독증(dyslexia)은 말로 들려주면 잘 이해하지만(언어이해 정상) 글자를 소리로 바꾸는 낱말 해독이 선택적으로 손상된 유형이다. 따라서 난독증 아동은 같은 지문을 읽어 주면 이해가 크게 좋아진다는 점이 감별 단서가 된다. 해독 저하의 바탕에는 음운인식·음운처리 결함이 흔히 있다.\",\"w\":{\"1\":\"해독은 정상인데 듣기이해가 저하된 유형은 글은 소리 내어 잘 읽지만 뜻을 이해하지 못하는 특정 읽기이해 결함(poor comprehender, 이해부진) 프로파일이다.\",\"2\":\"해독과 듣기이해가 모두 저하된 유형은 혼합형(일반 읽기부진, garden-variety poor reader)으로, 언어발달장애가 함께 있는 경우가 많다. 난독증은 언어이해가 보존된다는 점에서 다르다.\",\"3\":\"단순관점에서 읽기이해는 해독과 듣기이해의 곱이므로, 두 요소가 모두 정상이면 읽기이해도 정상이어야 한다. 이 조합은 모델로 설명되지 않으며 주의·동기 등 다른 요인을 검토해야 한다.\",\"5\":\"해독과 듣기이해가 모두 우수하면 읽기이해도 우수한 일반(유능한) 독자 프로파일로, 읽기장애에 해당하지 않는다.\"}},\"2-1-2-49\":{\"p\":\"음운인식은 두 축으로 난이도를 판단한다. 첫째, 단위의 크기는 큰 단위에서 작은 단위로(낱말 → 음절 → 음절체·종성 → 음소) 갈수록 어렵다. 둘째, 같은 단위에서도 과제 유형은 변별(같다/다르다 판단) → 합성(합치기) → 분절(나누기) → 탈락·대치(조작) 순으로 어려워진다. '산'에서 /ㅅ/를 빼고 말하기는 가장 작은 단위인 음소를, 가장 어려운 조작인 탈락으로 다루는 과제이므로 다섯 보기 중 가장 늦게 발달한다. 이 과제는 /ㅅ/를 뺀 뒤 남은 '안'을 만들어 내야 하므로 음소를 마음속에서 떼어 냈다 다시 합치는 작업기억 부담도 크다.\",\"w\":{\"1\":\"음절 수 세기(손뼉 치기)는 가장 큰 소리 단위인 음절을 나누는 과제로, 학령전기 초기에 가장 먼저 발달하는 음운인식 과제 중 하나이다.\",\"2\":\"음절 합성('사'+'자'→'사자')은 음절 수준의 합치기 과제로, 음소 수준의 탈락보다 훨씬 이른 시기에 가능해진다.\",\"3\":\"첫음절이 같은지 판단하는 것은 음절 수준의 변별 과제로, 소리를 직접 조작하지 않고 같다/다르다만 판단하므로 쉬운 편이다.\",\"4\":\"끝음절 같음 판단은 음절 수준의 변별(각운 인식과 유사) 과제로, 음소를 떼어 내는 조작이 필요한 탈락 과제보다 일찍 발달한다.\"}},\"2-1-2-50\":{\"p\":\"세 오류는 모두 실제 발음([꼬치], [머거서], [노피])과 정확히 일치하므로 소리를 듣고 구별하는 능력(음운처리)에는 문제가 없다. 문제는 '꽃+이', '먹-+-어서', '높-+-이'처럼 낱말을 이루는 형태소(체언+조사, 어간+어미)의 원래 모양을 지키지 못하고 연음된 소리대로 적었다는 점이다. 한글 맞춤법은 소리대로 적되 어법(형태소 원형)에 맞도록 적는 원칙을 따르므로, 이런 오류는 형태처리 오류이다. 따라서 '꽃-꽃이-꽃을'처럼 같은 어간에 여러 조사·어미를 붙여 보며 원형이 유지됨을 인식하게 하는 형태소 인식 지도가 우선이다.\",\"w\":{\"1\":\"음운처리 오류는 소리 자체를 잘못 지각·표상해 발음과 다르게 쓰는 오류(예: '꽃'을 '꼭'으로 씀)이다. 이 아동은 발음을 정확히 반영했으므로 자소-음소 대응 지도가 우선 과제가 아니다.\",\"3\":\"표기처리 오류는 형태소나 소리 규칙으로 설명되지 않는 관습적 표기를 틀리는 것(예: '며칠'을 '몇일'로 씀)이다. 지문의 오류는 형태소 경계를 지키지 못한 것이라 규칙으로 설명된다.\",\"4\":\"의미처리 오류는 뜻에 따라 구별해야 하는 낱말을 혼동하는 것(예: '반드시/반듯이', '맞히다/맞추다')이다. 지문의 아동은 낱말 뜻을 헷갈린 것이 아니다.\",\"5\":\"시각기억 오류는 일반적인 철자 오류 분류(음운·형태·표기처리)의 주요 유형이 아니며, 지문처럼 체계적인 연음 표기 오류는 시각적 기억 문제가 아닌 형태 규칙의 문제로 설명된다.\"}},\"2-1-2-51\":{\"p\":\"REVT(수용·표현 어휘력 검사)는 수용 어휘(들은 낱말에 맞는 그림 고르기)와 표현 어휘(그림 보고 이름 말하기)를 따로 평가해 각각의 등가연령과 백분위수를 제공하므로, 수용과 표현 어휘 수준의 차이를 비교할 수 있다. 대상 연령은 학령전기부터 성인까지로 넓다. 표준화 검사 문항에서는 '검사명–대상 연령–평가 영역–실시 방식(직접 실시/부모 보고)'의 네 가지를 함께 기억해 두면 대부분의 연결 문제를 풀 수 있다.\",\"w\":{\"2\":\"PRES는 일반적으로 2~6세 학령전기 아동의 수용·표현 언어 발달을 평가하는 척도이다. 초등학생의 담화·읽기 능력 평가는 이 검사의 대상과 영역이 아니다.\",\"3\":\"LSSC(학령기 아동 언어 검사)는 초등학생을 대상으로 의미·문법·화용 등 학령기 언어 능력을 평가한다. 영유아 의사소통 선별용 검사가 아니다.\",\"4\":\"KOLRA(한국어 읽기 검사)는 초등학생 등을 대상으로 해독·읽기유창성·읽기이해·음운처리 등 읽기 능력을 평가한다. 학령전기 아동의 어휘 평가 도구가 아니다.\",\"5\":\"K M-B CDI는 부모가 아동이 이해하거나 말하는 낱말·몸짓 목록에 표시하는 부모 보고형 검사이다. 검사자가 아동에게 직접 그림 이름대기를 실시하는 방식이 아니다.\"}},\"2-1-2-52\":{\"p\":\"백분위수(percentile rank)는 규준집단에서 해당 점수 이하(또는 미만)를 받은 사람의 비율을 나타낸다. 백분위수 5는 같은 연령 또래 100명 중 이 아동보다 낮은 점수를 받은 사람이 약 5명이라는 뜻으로, 하위 5%에 해당한다. 정규분포에서 -1 SD는 약 16백분위, -1.5 SD는 약 7백분위, -2 SD는 약 2백분위이므로, 백분위수 5는 대략 -1.6 SD 부근(-1.5 SD와 -2 SD 사이)으로 일반적으로 언어 지연·장애를 의심하는 범위이다. 백분위수는 상대적 위치이므로 '몇 문제를 맞혔는가'나 '몇 점 차이인가'와는 다른 정보이다.\",\"w\":{\"1\":\"전체 문항 중 맞힌 비율은 정답률(백분율 점수)이다. 백분위수는 문항 정답률이 아니라 규준집단 안에서의 상대적 위치를 나타낸다.\",\"3\":\"평균보다 원점수가 몇 점 낮은지는 원점수 차이로, 백분위수와 관계없다. 같은 5점 차이라도 검사의 표준편차에 따라 백분위수는 크게 달라진다.\",\"4\":\"정규분포에서 -1 표준편차는 약 16백분위에 해당한다. 백분위수 5는 그보다 더 낮은 위치(대략 -1.6 SD 부근)이다.\",\"5\":\"등가연령은 아동의 원점수가 어느 연령 집단의 평균에 해당하는지를 나타내는 별도의 점수이다. 백분위수 5의 '5'는 연령과 관계없는 비율 값이다.\"}},\"2-1-2-53\":{\"p\":\"역동적 평가(dynamic assessment)는 한 시점의 수행 결과만 보는 정적 평가와 달리, 검사(사전) → 교수(중재, 예: 매개학습경험) → 재검사(사후)의 형식으로 아동이 도움을 받았을 때 얼마나 빨리, 얼마나 많이 배우는지(수정 가능성, 학습 잠재력)를 평가한다. 비고츠키의 근접발달영역 개념에 바탕을 둔다. 한국어 노출이 부족한 이중언어·다문화 아동은 표준화 검사 점수가 낮아도 짧은 교수 후 빠르게 향상하면 '언어 차이', 향상이 미미하면 '언어장애'를 시사하므로, 둘을 감별하는 데 특히 유용하다.\",\"w\":{\"1\":\"규준집단과 비교해 표준점수를 산출하는 것은 규준참조 표준화 검사(정적 평가)의 목적이다. 역동적 평가는 규준 비교보다 개인의 학습 과정과 반응 변화를 본다.\",\"2\":\"등가연령으로 결과를 보고하는 것은 표준화 검사의 방식이다. 역동적 평가는 사전-사후 변화량, 필요한 도움의 양, 학습 속도 등을 기술적으로 보고한다.\",\"3\":\"부모 보고만으로 능력을 추정하는 것은 K M-B CDI 같은 부모 보고형 평가 방식이다. 역동적 평가는 평가자가 직접 교수와 재검사를 실시해야 한다.\",\"4\":\"역동적 평가는 한 시점이 아니라 교수 전후 여러 시점의 수행을 비교하며, 오히려 이중언어 아동의 언어 차이와 장애를 감별하는 데 적합한 방법이다.\"}},\"2-1-2-54\":{\"p\":\"단순언어장애(SLI)는 언어 능력에만 뚜렷한 결함이 있고 그것을 설명할 다른 원인이 없는 경우로, 포함 준거와 배제 준거로 판별한다. 레너드(Leonard)의 준거에 따르면 포함 준거는 표준화 언어검사 점수 -1.25 SD 이하, 비언어성 지능 85 이상(정상 범위)이고, 배제 준거는 청력 손실, 최근의 중이염 문제, 신경학적 손상(뇌손상·뇌전증 등), 구강 구조·기능 이상, 사회적 상호작용 장애(자폐)가 없는 것이다. 문제의 보기 중 ②~⑤는 모두 '이것이 있으면 SLI가 아니다'에 해당하는 배제 준거를 반대로 서술한 것이다. 최근에는 비언어성 지능 기준을 완화한 발달적 언어장애(DLD)라는 용어도 쓰이며, 구체적 기준은 연구·교재에 따라 다를 수 있다.\",\"w\":{\"2\":\"양측 감각신경성 난청이 있으면 언어 지연이 청력 손실로 설명되므로 SLI의 배제 준거에 해당한다. 이 경우 청각장애로 인한 언어장애로 본다.\",\"3\":\"자폐스펙트럼장애는 사회적 상호작용 장애로, 언어 문제의 원인이 될 수 있으므로 SLI의 배제 준거이다. 자폐 진단이 있으면 SLI로 진단하지 않는다.\",\"4\":\"비언어성 지능 70 이하는 지적장애 범위로, 언어 지연이 인지 결함으로 설명되므로 SLI에서 배제된다. SLI는 비언어성 지능이 85 이상이어야 한다.\",\"5\":\"언어 지연을 설명할 수 있는 뇌손상 등 신경학적 손상이 있으면 SLI의 배제 준거에 해당한다. 이 경우 후천적 또는 신경학적 원인의 언어장애로 분류한다.\"}},\"2-1-2-55\":{\"p\":\"단순언어장애 아동은 언어 영역 중에서도 형태·구문, 특히 조사·어미 같은 문법형태소 습득이 두드러지게 늦고 오류가 오래 지속되는 것이 대표적 특징이다(영어권에서는 시제 표지 -ed, 3인칭 -s 생략이 지표로 쓰인다). 문법형태소는 짧고 강세가 약해 지각적으로 두드러지지 않으며, 처리 속도·음운 작업기억의 제한이 있는 아동에게 특히 어렵다는 설명(표면가설, 제한된 처리용량 가설 등)이 있다. 그 밖에 늦은 첫 낱말, 낱말 찾기 어려움, 수용언어 결함, 이야기·대화의 이차적 화용 문제가 동반될 수 있다.\",\"w\":{\"1\":\"SLI 진단에서는 비언어성 인지가 정상 범위(일반적으로 85 이상)여야 한다. 비언어성 인지 저하가 언어 지연의 원인이면 지적장애에 따른 언어장애로 본다.\",\"2\":\"SLI 아동은 표현언어만 손상된 유형도 있지만 수용언어가 함께 손상되는 경우도 많다. 수용언어가 손상되지 않는다고 단정할 수 없다.\",\"3\":\"SLI 아동은 일차적 화용장애는 아니지만, 언어 형식의 제한 때문에 대화 주제 유지·이야기 구성·명료화 등에서 이차적 화용 어려움이 흔히 나타난다.\",\"4\":\"SLI 아동은 첫 낱말 출현이 또래보다 늦은 경우가 많으며, 어린 시기에 말 늦은 아동(late talker)으로 판별되었던 이력이 흔하다.\"}},\"2-1-2-56\":{\"p\":\"말 늦은 아동(late talker)은 인지·청력·신경학적·사회정서적 문제가 없는데도 표현 어휘 발달이 늦은 걸음마기 아동을 말한다. 대표적 판별 기준(Rescorla 등)은 일반적으로 24개월 무렵 표현 어휘가 50개 미만이거나 두 낱말 조합이 나타나지 않는 경우이다. 24개월 기준인 이유는 이 시기에 대부분의 아동이 어휘 폭발을 거쳐 50개 이상의 낱말과 낱말 조합을 보이기 때문이다. 말 늦은 아동의 상당수는 이후 또래를 따라잡지만 일부는 언어장애로 이어지므로, 수용언어 저하·몸짓 부족·가족력 등 위험 요인을 함께 살피며 추적 관찰한다. 세부 연령·어휘 기준은 연구에 따라 다소 차이가 있다.\",\"w\":{\"1\":\"18개월에는 아직 두 낱말 조합이 나타나지 않는 것이 정상 범위이다. 낱말 조합은 일반적으로 18~24개월 사이에 출현하므로 이것만으로는 말 늦은 아동으로 판별하지 않는다.\",\"3\":\"36개월에 완전한 문장을 못 하는 것은 말 늦은 아동의 판별 기준이 아니다. 말 늦은 아동은 24개월 전후 걸음마기 아동의 표현 어휘·낱말 조합을 기준으로 정의한다.\",\"4\":\"말 늦은 아동은 주로 표현 어휘가 늦은 아동이며, 수용언어는 대체로 정상 범위이거나 경미한 지연을 보인다. 수용언어 -2 SD 이하는 더 심한 언어장애를 시사한다.\",\"5\":\"청력 손실이 있으면 언어 지연의 원인이 설명되므로 말 늦은 아동이 아니라 청각장애로 인한 언어 지연으로 본다. 말 늦은 아동은 청력 등 다른 원인을 배제한 개념이다.\"}},\"2-1-2-57\":{\"p\":\"반향어는 시간 간격에 따라 즉각 반향어(상대 말을 바로 직후에 따라 함)와 지연 반향어(시간이 지난 뒤 이전에 들은 말을 다시 사용)로 나뉜다. 지문의 아동은 '며칠 전에 본 광고 문구'를 억양까지 그대로 쓰므로 지연 반향어이다. 기능은 사용 맥락으로 판단하는데, '과자가 먹고 싶을 때마다' 일관되게 쓰므로 과자를 얻으려는 요청 기능이다. 프리전트(Prizant) 등의 연구 이후 반향어는 무의미한 행동이 아니라 의사소통 기능을 가질 수 있는 것으로 보며, 중재에서는 반향어의 기능을 파악해 '과자 주세요'처럼 그 기능에 맞는 관습적 표현으로 바꿔 주는 것이 권장된다.\",\"w\":{\"2\":\"즉각 반향어는 상대가 말한 직후 그 말을 따라 하는 것이다. 지문의 문구는 며칠 전에 들은 것이고, 질문에 대한 대답 상황도 아니다.\",\"3\":\"발화 유형(지연 반향어)은 맞지만, 아동은 과자를 원할 때 이 문구를 쓰므로 거부가 아니라 요청 기능이다. 거부 기능이라면 싫은 상황에서 문구를 사용해야 한다.\",\"4\":\"자곤은 문장 같은 억양을 지녔으나 실제 낱말이 없는 영아기 발성이다. 지문의 아동은 광고 문구를 정확한 낱말로 그대로 재생하고 있으며, 기능도 서술이 아니라 요청이다.\",\"5\":\"기능(요청)은 맞지만, 즉각 반향어는 들은 직후 따라 하는 것이다. 며칠 전에 들은 말을 다시 쓰는 지문의 발화는 지연 반향어이다.\"}},\"2-1-2-58\":{\"p\":\"공동주의(joint attention)는 아동과 성인이 같은 대상에 함께 주의를 기울이는 것으로, '누가 먼저 시작하는가'에 따라 공동주의 시작하기(IJA)와 공동주의 반응하기(RJA)로 나뉜다. 장난감을 들어 성인에게 보여 주며 쳐다보는 것(showing + 시선 교대)은 아동이 먼저 성인의 주의를 자신이 관심 있는 대상으로 끌어오는 행동이므로 공동주의 시작하기이다. 핵심은 목적이 사물을 얻는 것이 아니라 '관심을 나누는 것'이라는 점이며, 자폐스펙트럼장애 아동은 특히 공동주의 시작하기에 어려움이 커 초기 진단과 중재의 핵심 목표가 된다.\",\"w\":{\"1\":\"성인이 가리키는 곳을 따라 쳐다보는 것은 성인이 시작한 공동주의에 아동이 따라가는 공동주의 반응하기(RJA)이다.\",\"2\":\"이름을 부를 때 고개를 돌리는 것은 이름 반응(호명 반응)으로, 사회적 자극에 대한 반응이지 아동이 대상에 대한 주의 공유를 먼저 시작한 것이 아니다.\",\"4\":\"과자를 얻으려고 성인의 손을 끌어당기는 것은 성인을 도구처럼 사용하는 요구 행동이다. 시선 교대 없이 사물 획득이 목적이어서 공동주의 시작하기와 다르며, 자폐 아동에게 흔히 관찰된다.\",\"5\":\"성인의 박수 동작을 따라 하는 것은 동작 모방이다. 모방은 사회적 학습의 중요한 기술이지만 대상에 대한 주의를 공유하는 공동주의 시작하기와는 구분된다.\"}},\"2-1-2-59\":{\"p\":\"다운증후군(21번 삼염색체)은 표현언어와 구문(형태·통사)이 비언어성 인지 수준보다 더 지연되고, 수용언어가 표현언어보다 상대적으로 양호한 비대칭 프로파일을 보인다. 짧은 조사·어미 생략, 짧은 문장, 그리고 저긴장·상대적으로 큰 혀·구강 구조 특성으로 인한 낮은 말명료도가 흔하며, 중이염에 따른 전음성 난청 위험도 높아 청력 관리가 중요하다. 증후군 문항은 '어느 영역이 상대적 강점이고 어느 영역이 약점인가'를 비교해 정리해 두면 혼동을 줄일 수 있다.\",\"w\":{\"1\":\"윌리엄스증후군은 인지 수준에 비해 어휘와 표현언어가 상대적 강점으로, 수다스럽고 풍부한 어휘를 쓰는 경향이 있다. 보기는 반대로 서술했다.\",\"2\":\"윌리엄스증후군은 시공간 인지(그림 그리기, 블록 구성 등)가 두드러진 약점이고 언어가 상대적 강점이다. 보기는 강점과 약점을 뒤바꿔 서술했다.\",\"3\":\"낯선 사람에게도 친근하게 다가가는 과잉 사회성은 윌리엄스증후군의 특징이다. 취약X증후군은 사회적 불안, 시선 회피, 반복적·보속적 말과 빠른 말속도가 특징이다.\",\"4\":\"다운증후군은 수용언어가 표현언어보다 상대적으로 양호한 편이다. 보기는 수용과 표현의 관계를 반대로 서술했다.\"}},\"2-1-2-60\":{\"p\":\"청각장애 아동은 청각 입력이 제한되어, 말소리 중 강세가 약하고 짧으며 음향 에너지가 작은 요소(조사·어미 같은 문법형태소)를 특히 놓치기 쉽다. 그 결과 문법형태소 생략·대치가 흔하고, 내용어 위주의 짧고 단순한 문장 구조를 사용하는 경향을 보인다. 또한 우연 학습(일상에서 흘려듣는 말로 배우는 것)의 기회가 줄어 추상어·다의어·비유 및 관용 표현 이해가 어렵고, 말명료도는 청력 손실 정도·조기 증폭(보청기·인공와우) 시기·중재 여부와 관련된다. 이러한 특성의 정도는 청력 손실 정도와 중재 시기에 따라 개인차가 크다.\",\"w\":{\"1\":\"청각장애 아동은 의미가 뚜렷하고 시각적으로 지시할 수 있는 내용어보다, 강세가 약하고 짧은 조사·어미 같은 기능어 습득이 더 어렵다. 보기는 관계를 반대로 서술했다.\",\"3\":\"비유·관용 표현은 낱말의 문자적 의미를 넘어선 해석이 필요하고 일상 대화에서 반복적으로 들으며 익히는 경우가 많아, 청각장애 아동은 이해에 어려움을 겪는 경우가 많다.\",\"4\":\"다의어는 여러 맥락에서 반복적으로 들으며 다양한 의미를 익혀야 하므로, 청각 입력이 제한된 청각장애 아동은 다의적 의미 이해가 또래보다 낮은 편이다.\",\"5\":\"말명료도는 청력 손실 정도와 밀접하게 관련되며, 일반적으로 손실이 클수록 조음·공명·운율 문제가 커져 명료도가 낮아진다. 조기 증폭과 중재 여부도 영향을 준다.\"}},\"2-1-2-61\":{\"p\":\"언어장애는 특정 언어의 지식 부족이 아니라 언어를 배우는 능력 자체의 결함이므로, 진짜 언어장애라면 아동이 노출된 모든 언어에서 어려움이 나타난다. 반대로 한국어에서만 지연이 있고 모국어는 또래 수준이라면 한국어 노출 기간·양이 부족한 '언어 차이'일 가능성이 크다. 따라서 이중언어 아동은 두 언어 모두의 발달을 평가하고(통역자·모국어 정보 활용), 부모 면담으로 언어 노출 이력을 확인하며, 역동적 평가로 학습 능력을 보는 것이 권장된다. 한국어 표준화 검사의 규준은 단일언어 아동을 기준으로 만들어진 경우가 많아 그대로 적용하면 과잉 진단 위험이 있다.\",\"w\":{\"1\":\"한국어 표준화 검사의 규준은 대개 한국어 단일언어 아동으로 만들어졌으므로, 이중언어 아동에게 그대로 적용하면 언어 차이를 장애로 잘못 판정할 위험이 크다. 규준만으로 판정해서는 안 된다.\",\"2\":\"제2언어인 한국어에서만 지연이 있으면 노출 부족에 따른 언어 차이일 수 있다. 모국어도 함께 평가해 두 언어 모두에서 지연이 확인되어야 언어장애를 의심할 수 있다.\",\"4\":\"새 언어에 노출된 초기에 말을 거의 하지 않는 침묵기(silent period)는 순차적 이중언어 습득에서 흔히 나타나는 정상 과정으로, 그 자체로 언어장애의 징후가 아니다.\",\"5\":\"모국어를 중단시키면 부모와의 상호작용 질이 떨어지고 개념 발달 기반이 약해질 수 있다. 모국어 능력은 제2언어 발달에도 긍정적으로 전이되므로 유지하는 것이 권장된다.\"}},\"2-1-2-62\":{\"p\":\"평행발화(parallel talk)는 성인이 아동이 지금 하고 있는 행동이나 보고 있는 대상을 아동의 입장에서 대신 말로 묘사해 주는 기법이다. 지문에서 치료사는 아동이 블록을 쌓는 행동을 보며 '높이 쌓네, 또 올리네, 무너졌다'라고 아동의 행동을 실시간으로 중계하고 있다. 판단 단서는 두 가지이다. 첫째, 묘사하는 행동의 주인이 아동인지 치료사인지(아동 → 평행발화, 치료사 → 혼잣말). 둘째, 아동의 발화가 먼저 있었는지(없으면 평행발화·혼잣말, 있으면 확장·확대·개작). 지문에는 아동의 발화가 없고 아동의 행동만 있으므로 평행발화이다.\",\"w\":{\"1\":\"혼잣말 기법(self-talk)은 치료사가 자기 자신의 행동을 말로 표현하는 것(예: '선생님이 블록 올려')이다. 지문에서 치료사는 아동의 행동을 묘사하고 있다.\",\"2\":\"확장(expansion)은 아동의 발화를 받아 빠진 문법 요소를 채워 성인 문장으로 되돌려 주는 기법(아동: '블록 쌓아' → '블록을 쌓아')이다. 지문에는 아동의 발화가 없다.\",\"3\":\"확대(extension)는 아동의 발화에 새로운 의미 정보를 덧붙여 주는 기법(아동: '블록' → '빨간 블록이 높네')이다. 아동의 발화를 전제로 하므로 지문과 맞지 않는다.\",\"5\":\"개작(recast)은 아동 발화의 의미는 유지하면서 문장 형태(평서문→의문문 등)를 바꾸어 들려주는 기법이다. 역시 아동의 선행 발화가 있어야 사용할 수 있다.\"}},\"2-1-2-63\":{\"p\":\"시간지연(time delay)은 환경중심 언어중재(milieu teaching) 절차 중 하나로, 아동이 무언가를 필요로 할 상황에서 성인이 바로 도와주지 않고 기대하는 표정으로 아동을 바라보며 일정 시간(일반적으로 약 5초 전후) 기다려 아동이 먼저 말하도록 유도하는 방법이다. 지문의 단서는 '간식 시간마다 반복되어 온 익숙한 일과', '주스병을 들고 바라보며 기다림', '치료사가 질문이나 시범을 하지 않음'이다. 성인이 아무 말도 하지 않는다는 점이 요구-모델이나 아동중심 시범과 구분되는 핵심이며, 아동이 반응하지 않으면 요구-모델이나 시범으로 넘어가 단계적으로 도움을 늘린다.\",\"w\":{\"2\":\"요구-모델(mand-model)은 성인이 먼저 '뭐 줄까?', '말해 봐'처럼 언어적 요구(질문·지시)를 제시한 뒤 반응이 없으면 시범을 보이는 절차이다. 지문의 치료사는 말없이 기다리기만 했다.\",\"3\":\"아동중심 시범(child-cued modeling)은 아동이 관심을 보이는 대상에 대해 성인이 먼저 목표 언어를 시범 보이는 절차이다. 지문에서 치료사는 시범 없이 기다렸다.\",\"4\":\"우발교수(incidental teaching)는 아동이 먼저 요구를 시작했을 때 그 기회를 이용해 더 정교한 언어를 가르치는 절차이다. 지문은 치료사가 기다림으로 아동의 시작을 유도한 상황이다.\",\"5\":\"스크립트 중재는 친숙한 활동의 순서(스크립트)를 확립하고 각 단계에 목표 언어를 배치하는 접근으로, 환경중심 언어중재의 4가지 절차(시범·요구-모델·시간지연·우발교수)에 속하지 않는다.\"}},\"2-1-2-64\":{\"p\":\"스크립트 중재(script-based intervention)는 사건 표상(event representation) 이론에 근거한다. 아동이 활동 순서를 이미 알고 있으면 '다음에 무슨 일이 일어나는지'를 생각하는 인지적 부담이 줄어, 남는 처리 자원을 언어 학습에 쓸 수 있다는 원리이다. 따라서 생일잔치·가게놀이처럼 친숙한 일상 활동의 순서를 먼저 반복해 확립하고, 각 하위 행동에 목표 언어를 연결한 뒤, 아동이 스크립트를 충분히 익힌 다음에야 순서를 빠뜨리거나 필요한 물건을 숨기는 '계획된 위반(planned violation)'을 도입해 아동이 자발적으로 말하도록 유도한다.\",\"w\":{\"2\":\"계획된 위반은 아동이 스크립트를 충분히 익힌 뒤에 도입해야 아동이 '이상하다'는 것을 알아차리고 말할 수 있다. 첫 회기부터 예고 없이 순서를 바꾸면 아동은 혼란만 느낀다.\",\"3\":\"낯선 활동은 순서를 기억하는 데 인지적 부담이 커서 언어 학습에 쓸 자원이 줄어든다. 스크립트 중재는 아동에게 친숙한 일상 활동을 선택하는 것이 원칙이다.\",\"4\":\"스크립트 중재에서는 목표 언어를 각 하위 행동(예: 케이크 꺼내기 → '케이크 주세요')과 의미적으로 연결해 배치해야 맥락 속에서 학습·일반화된다. 하위 행동과 관계없이 삽입하면 원리에 어긋난다.\",\"5\":\"스크립트는 여러 하위 행동(단계)이 순서대로 이어진 구조여야 하며, 각 하위 행동이 목표 언어를 산출할 기회가 된다. 하위 행동을 하나로 제한하면 스크립트의 장점이 사라진다.\"}},\"2-1-2-65\":{\"p\":\"목표 달성 전략은 여러 목표를 어떤 순서로 다룰지에 대한 전략으로 수직적·수평적·주기적 전략이 있다. 수직적(vertical) 전략은 한 번에 하나의 목표만 집중적으로 지도해, 미리 정한 준거(예: 3회기 연속 80% 이상 정반응)에 도달하면 다음 목표로 넘어가는 방식이다. 목표가 하나씩 위로 쌓이는 모양이라 '수직적'이라고 부른다. 집중 연습이 가능해 주의력이 짧거나 심한 장애가 있는 아동에게 적합하지만, 한 목표에 오래 머물 수 있고 실제 의사소통처럼 여러 형태를 함께 쓰는 경험이 적다는 단점이 있다.\",\"w\":{\"1\":\"여러 목표를 한 회기 안에서 동시에 지도하는 것은 수평적(horizontal) 전략이다. 다양한 형태를 함께 다뤄 자연스러운 의사소통에 가깝지만 각 목표의 연습량은 적어진다.\",\"2\":\"일정 기간마다 준거 도달과 관계없이 여러 목표를 순환하며 지도하는 것은 주기적(cyclical) 전략이다. 음운 접근법의 주기법이 대표적인 예이다.\",\"4\":\"목표 도달 여부와 관계없이 매 회기 목표를 바꾸면 체계적인 습득과 진전 평가가 불가능하다. 이것은 어떤 목표 달성 전략에도 해당하지 않는다.\",\"5\":\"아동이 선택한 목표만 지도하는 것은 아동의 흥미를 반영할 수는 있지만, 평가 결과에 근거한 목표 선정과 순서 결정이라는 목표 달성 전략의 개념과 관계없다.\"}},\"2-1-2-66\":{\"p\":\"단기목표는 장기목표를 달성하기 위해 비교적 짧은 기간에 도달할 구체적 단계로, 일반적으로 '누가(아동) – 어떤 조건에서 – 무엇을(관찰·측정 가능한 행동) – 어느 정도(준거)'를 포함해 진술한다. ④는 조건(그림카드 10장을 보고), 관찰 가능한 행동(연결어미 '-고'가 포함된 문장 말하기), 준거(10회 중 8회 이상, 80%)가 모두 드러나 측정 가능하다. 또한 장기목표인 '연결어미 복문 사용'의 첫 단계로 습득이 이른 '-고'(나열)를 선택해 장기목표와의 위계도 맞다.\",\"w\":{\"1\":\"'전반적으로 향상된다'는 무엇을 얼마나 해야 달성인지 측정할 수 없는 포괄적 진술이다. 조건·행동·준거가 모두 빠져 있다.\",\"2\":\"'일상 대화에서 복문을 이해하고 사용한다'는 장기목표 수준의 넓은 진술이며, 조건과 달성 준거가 없어 단기목표로 측정할 수 없다.\",\"3\":\"단기목표는 아동이 수행할 행동을 기술해야 한다. 치료사가 시범을 보이는 것은 중재 절차(치료사의 행동)이지 아동의 목표가 아니다.\",\"5\":\"'여러 상황에서 잘 사용할 수 있다'는 '잘'과 '여러 상황'이 모호해 준거로 측정할 수 없다. 일반화를 다루는 장기목표에 가까운 진술이다.\"}},\"2-1-2-67\":{\"p\":\"언어 이전기·초기 언어기 아동의 첫 목표 어휘는 기능성(functionality)을 가장 중요한 기준으로 선정한다. 일상생활에서 자주 접하고(빈도), 말하는 즉시 원하는 결과를 얻을 수 있어(요구·거부·주의끌기 등 의사소통 기능), 아동에게 강력한 자연적 강화가 되는 낱말이 습득과 일반화가 빠르다. 예를 들어 '더', '줘', '아니', '엄마', 아동이 좋아하는 간식·장난감 이름 등이다. 이 밖에 아동의 관심, 구체성(눈에 보이고 만질 수 있는 것), 산출 가능한 음운 구조, 다양한 의미관계로 확장할 수 있는지도 함께 고려한다.\",\"w\":{\"1\":\"아동이 이미 자발적으로 산출하는 낱말은 습득이 끝난 것이므로 새로운 목표가 될 수 없다. 목표는 이해는 하지만 아직 표현하지 않는 낱말 등 다음 단계의 낱말에서 고른다.\",\"2\":\"초기 언어기 아동은 눈에 보이고 만질 수 있는 구체어를 먼저 습득한다. 추상적 개념어는 인지 발달이 더 진행된 뒤에 목표로 삼는다.\",\"4\":\"초기 어휘는 아동이 산출 가능한 음운 구조(쉬운 자음·단순한 음절)의 낱말을 고르는 것이 원칙이다. 발음이 어려운 낱말은 실패 경험을 늘려 의사소통 동기를 떨어뜨린다.\",\"5\":\"아동이 관심 없는 사물의 이름은 말해도 얻는 것이 없어 자연적 강화가 일어나지 않는다. 초기 어휘는 아동이 좋아하고 원하는 대상에서 고른다.\"}},\"2-1-2-68\":{\"p\":\"도상성(iconicity)은 상징이 가리키는 대상과 얼마나 닮았는지(투명성, 추측 가능성)를 뜻한다. AAC 상징의 도상성은 일반적으로 실물 > 축소 모형 > 컬러 사진 > 흑백 사진 > 컬러 선화 > 흑백 선화 > 블리스 상징 > 문자 순으로 낮아진다. 실물 사진은 대상의 색·질감·모양을 그대로 담고 있어 단순화된 선화보다 대상과 더 닮았으므로 도상성이 높다. 도상성이 높을수록 초기 학습이 쉬워 인지 수준이 낮거나 AAC를 처음 시작하는 사용자에게 적합하며, 사용자가 익숙해지면 표현 범위가 넓은 추상적 상징으로 확장해 간다.\",\"w\":{\"1\":\"블리스 상징(Blissymbols)은 의미 요소를 조합하는 표의 문자 체계로 추상적인 형태가 많아 도상성이 낮고 학습이 어렵다. 대신 조합으로 다양한 의미를 표현할 수 있다는 장점이 있다.\",\"2\":\"수어와 몸짓은 신체만으로 표현하고 외부 도구가 필요 없으므로 비도구적(unaided) 상징체계이다. 도구적(aided) 상징은 그림·사진·의사소통판·음성출력기기 등이다.\",\"3\":\"도상성이 낮은 상징은 대상과 닮지 않아 의미를 추측하기 어렵기 때문에 초기 학습이 더 어렵다. 보기는 관계를 반대로 서술했다.\",\"5\":\"스캐닝(scanning)은 직접 선택이 어려운 사용자를 위해 항목을 차례로 강조하면 원하는 항목에서 스위치를 눌러 고르는 선택(접근) 기법이다. 상징의 도상성과는 관계없다.\"}},\"2-1-2-69\":{\"p\":\"사회적 상황 이야기(Social Stories, Gray)는 자폐스펙트럼장애 아동이 어려워하는 특정 사회적 상황을 아동의 관점에서 짧고 구체적인 글로 설명하는 중재 기법이다. 지문의 단서는 '특정 상황을 서술', '다른 사람의 느낌과 기대(관점)', '아동이 할 수 있는 적절한 행동', '개별화된 글과 그림'으로, 상황 이야기의 문장 유형인 설명문(상황 묘사), 조망문(타인의 생각·감정), 지시문(기대 행동)과 그대로 대응한다. 일반적으로 설명·조망 문장을 지시 문장보다 더 많이 포함하도록 구성하며, 상황 직전에 반복해 읽혀 예측 가능성과 적절한 행동을 높인다.\",\"w\":{\"1\":\"비디오 모델링은 목표 행동을 수행하는 사람(또래·성인·아동 자신)의 영상을 보여 주고 관찰·모방하게 하는 기법이다. 지문은 영상이 아니라 개별화된 글로 상황을 설명한다.\",\"3\":\"사회적 기술 훈련 집단은 여러 아동이 소집단으로 모여 인사하기·차례 지키기 등의 사회적 기술을 교수·역할극·피드백으로 연습하는 형식이다. 지문의 개별화된 글 형태와 다르다.\",\"4\":\"또래 매개 중재는 훈련받은 또래가 자폐 아동과의 상호작용을 시작·유지하도록 이끄는 접근이다. 지문에는 또래의 역할이 나타나지 않는다.\",\"5\":\"상호적 모방 훈련(RIT)은 성인이 아동의 놀이 행동을 모방해 주고 아동이 성인을 모방하도록 이끌어 자발적 모방 능력을 기르는 기법이다. 사회적 상황을 글로 설명하는 지문과 맞지 않는다.\"}},\"2-1-2-70\":{\"p\":\"해넌(Hanen) 프로그램 같은 부모 교육은 부모가 아동의 가장 중요한 의사소통 상대라는 전제 아래, 일상 상호작용 방식을 반응적으로 바꾸도록 돕는다. 핵심 전략은 OWL(Observe 관찰하기, Wait 기다리기, Listen 듣기)로 요약되는데, 아동이 무엇에 관심을 보이는지 관찰하고, 아동이 먼저 의사소통을 시작할 시간을 충분히 기다려 주며, 아동의 신호에 귀 기울여 반응하는 것이다. 즉 성인이 대화를 끌고 가지 않고 아동의 주도를 따르며 마주 보는 위치에서 차례를 주고받는 것이 출발점이다. 이렇게 하면 아동의 자발적 의사소통 시도가 늘고, 그 시도에 부모가 시범·확장을 덧붙일 기회가 많아진다.\",\"w\":{\"1\":\"질문을 많이 하는 것은 아동을 '대답하는 역할'로만 만들고 압박감을 주어 자발적 의사소통 시도를 줄일 수 있다. 반응적 상호작용에서는 질문보다 언급(코멘트)하고 기다리기를 권한다.\",\"2\":\"오류를 즉시 교정하면 아동의 의사소통 의욕이 꺾일 수 있다. 반응적 상호작용에서는 교정하는 대신 아동의 말을 올바른 형태로 다시 들려주는 시범(확장·개작)을 사용한다.\",\"3\":\"성인이 주제를 정하고 이끄는 것은 지시적(directive) 상호작용 방식이다. 반응적 접근은 아동이 관심 있는 주제를 따라가는 것이 핵심이다.\",\"5\":\"더 긴 문장으로 말하도록 요구하는 것은 아동에게 압박을 주는 지시적 전략이다. 반응적 접근에서는 요구 대신 아동 발화보다 조금 더 긴 문장을 성인이 자연스럽게 시범 보인다.\"}},\"2-2-1-1\":{\"p\":\"대뇌 백질의 섬유는 연결 방향에 따라 투사섬유(피질↔뇌간·척수·시상), 교련섬유(좌반구↔우반구), 연합섬유(같은 반구 안 피질↔피질)로 나뉜다. 속섬유막(내포, internal capsule)은 시상·꼬리핵과 렌즈핵 사이를 지나는 좁은 통로로, 피질척수로·피질연수로·시상피질 섬유 같은 투사섬유가 촘촘히 모여 있다. 그래서 작은 열공경색만으로도 반대쪽 얼굴·팔·다리에 고루 편마비가 생길 수 있다. 문제의 '위아래로 잇는', '투사섬유'가 판단 단서이다.\",\"w\":{\"1\":\"뇌들보(뇌량, corpus callosum)는 좌우 대뇌반구를 가로로 잇는 가장 큰 교련섬유로, 피질과 뇌간·척수를 위아래로 잇지 않는다.\",\"2\":\"궁상다발(arcuate fasciculus)은 같은 반구 안에서 베르니케 영역과 브로카 영역을 잇는 연합섬유로, 손상 시 전도실어증과 관련된다.\",\"3\":\"앞맞교차(전교련, anterior commissure)는 좌우 측두엽 등을 잇는 작은 교련섬유로, 투사섬유의 통로가 아니다.\",\"5\":\"갈고리다발(uncinate fasciculus)은 같은 반구의 전두엽 아래면과 측두엽 앞부분을 잇는 연합섬유이다.\"}},\"2-2-1-2\":{\"p\":\"세 소견은 모두 삼차신경(5번) 기능이다. 하악분지의 운동섬유가 깨물근·관자근·날개근을 지배하고, 세 감각가지(눈·위턱·아래턱)가 얼굴 촉각을 담당한다. 입을 벌릴 때는 양쪽 가쪽날개근이 턱을 앞으로 당기는데, 한쪽이 약하면 건강한 쪽 날개근이 턱을 밀어 턱이 약한 쪽(손상 쪽)으로 치우친다. 턱이 오른쪽으로 치우치고, 오른쪽 깨물근 수축이 약하며, 오른쪽 얼굴 감각이 떨어지므로 오른쪽 삼차신경 손상이다. 혀 내밀기 때 혀가 손상 쪽으로 치우치는 설하신경 소견과 헷갈리지 않도록 '어떤 동작에서 무엇이 치우치는가'를 구분해 둔다.\",\"w\":{\"1\":\"왼쪽 삼차신경이 손상되면 왼쪽 깨물근이 약해지고 턱은 왼쪽으로 치우치며 왼쪽 얼굴 감각이 떨어지므로, 오른쪽 소견과 맞지 않는다.\",\"3\":\"안면신경(7번)은 얼굴 표정근(입꼬리·눈감기 등)과 혀 앞 2/3의 미각을 담당하며, 씹기근육과 얼굴 촉각은 담당하지 않는다.\",\"4\":\"설하신경(12번)은 혀 운동을 담당하며, 손상 시 혀를 내밀면 손상 쪽으로 치우친다. 턱 운동·깨물근·얼굴 감각과는 관련이 없다.\",\"5\":\"미주신경(10번)은 연구개·인두·후두 근육을 지배해 손상 시 과대비성·삼킴장애·기식성 음성 등이 나타나며, 턱 치우침과 얼굴 촉각 저하는 설명하지 못한다.\"}},\"2-2-1-3\":{\"p\":\"척추동맥이 합쳐져 뇌바닥동맥(기저동맥)이 되는 척추-뇌바닥동맥(추골-기저동맥, vertebrobasilar) 계통은 뇌간·소뇌·후두엽을 공급한다. 소뇌·전정 경로가 손상되면 갑작스러운 어지럼과 걸음 실조가, 뇌간의 뇌신경핵·피질연수로가 손상되면 마비말장애와 삼킴장애가 생긴다. 반면 이해·이름대기·따라말하기·읽기가 정상이므로 언어 피질(중대뇌동맥 영역)은 보존된 것으로 본다. 즉 '말 운동·삼킴 문제는 있으나 언어는 정상'이라는 대비가 피질이 아닌 후순환계 병변을 가리키는 핵심 단서이다.\",\"w\":{\"1\":\"왼쪽 중대뇌동맥 위분지는 전두엽 가쪽(브로카 영역 포함)을 공급해 폐색 시 비유창 실어증과 오른쪽 얼굴·팔 마비가 나타나며, 언어 기능이 정상인 지문과 맞지 않는다.\",\"2\":\"왼쪽 중대뇌동맥 아래분지는 측두·두정엽(베르니케 영역 포함)을 공급해 폐색 시 이해가 떨어지는 유창성 실어증이 나타나므로, 낱말 이해가 정상인 지문과 맞지 않는다.\",\"3\":\"오른쪽 전대뇌동맥은 오른쪽 전두엽 안쪽을 공급해 폐색 시 왼쪽 다리 중심의 마비와 발동성 저하가 나타나며, 어지럼·실조는 주 증상이 아니다.\",\"4\":\"왼쪽 전대뇌동맥 폐색은 오른쪽 다리 중심의 마비, 발동성 저하, 연결피질운동실어증 등을 일으킬 수 있으나 어지럼·걸음 실조와 같은 소뇌 증상은 설명하지 못한다.\"}},\"2-2-1-4\":{\"p\":\"일과성 허혈발작(TIA)은 뇌혈류가 잠시 막혀 국소 신경 증상(편마비, 구음 곤란, 실어 등)이 갑자기 나타났다가 보통 1시간 이내, 대부분 수십 분 안에 완전히 사라지고, 영상(특히 MRI 확산강조영상)에서 새로운 경색이 확인되지 않는 상태이다. 지문의 '갑자기 시작', '30분 뒤 완전 소실', 'MRI상 새 경색 없음' 세 단서가 모두 정의에 들어맞는다. 과거에는 24시간 이내 회복을 기준으로 삼았으나 현재는 영상 소견 중심으로 정의하는 추세이며, TIA 직후 수일~수주 안에 뇌경색 위험이 높아 원인 평가와 예방 치료가 시급하다.\",\"w\":{\"2\":\"소혈관 열공경색은 뇌 깊은 곳의 작은 관통동맥이 막혀 생기는 작은 경색으로, 증상이 지속되는 경우가 많고 MRI에서 작은 경색 병변이 확인된다.\",\"3\":\"거미막밑 출혈은 주로 뇌동맥류 파열로 생기며 '평생 가장 심한' 갑작스러운 두통, 구토, 목 경직이 특징이고 CT 등 영상에서 출혈이 보인다.\",\"4\":\"뇌실질 내 출혈은 뇌 조직 안으로 혈관이 터진 것으로 증상이 대개 지속·악화되고 영상에서 출혈 병변이 뚜렷이 보인다.\",\"5\":\"만성 경막하 혈종은 주로 고령자의 가벼운 머리 외상 후 수주에 걸쳐 서서히 두통·인지 저하·편마비가 진행되는 것으로, 갑자기 생겼다 30분 만에 사라지는 양상과 다르고 영상에서 혈종이 보인다.\"}},\"2-2-1-5\":{\"p\":\"각회(angular gyrus)는 위관자고랑(상측두구) 뒤끝을 감싸는 두정엽 아래쪽 이랑으로, 시각 정보(글자)와 청각·언어 정보를 통합하는 연합 영역이다. 이곳이 손상되면 읽기와 쓰기가 함께 무너지는 '실서증 동반 실독증'이 나타나고, 손가락 실인증·좌우 혼동·계산 장애·실서증으로 이루어진 게르스트만 증후군이 동반되기 쉽다. 발화가 유창하고 이해·따라말하기가 비교적 양호하다는 점은 베르니케 영역이나 궁상다발 주변이 상대적으로 보존되었음을 뜻한다. 그림 정보는 해설에 적힌 각 기호의 위치를 근거로 판단한다.\",\"w\":{\"1\":\"㉠은 하전두회 뒷부분(브로카 영역)으로, 손상 시 비유창한 발화와 실문법증이 나타나므로 발화가 유창한 지문과 맞지 않는다.\",\"2\":\"㉡은 중심앞이랑(일차운동피질)으로, 손상 시 반대쪽 운동마비가 주로 나타나며 읽기·쓰기·계산 장애의 조합을 설명하지 못한다.\",\"3\":\"㉢은 외측고랑 끝을 감싸는 모서리위이랑(연상회)으로, 궁상다발 주변 손상 시 따라말하기가 두드러지게 손상되는 전도실어증과 관련되므로 따라말하기가 양호한 지문과 맞지 않는다.\",\"5\":\"㉤은 상측두회 뒷부분(베르니케 영역)으로, 손상 시 청각적 이해와 따라말하기가 크게 떨어지므로 이해·따라말하기가 비교적 양호한 지문과 맞지 않는다.\"}},\"2-2-1-6\":{\"p\":\"PK-WAB-R의 실어증지수(AQ)는 스스로 말하기(내용 전달 10점 + 유창성 10점) + 알아듣기(10점) + 따라말하기(10점) + 이름대기(10점), 합계 50점 만점을 2배 하여 100점 만점으로 환산한다. 계산하면 6 + 8 + 3.5 + 9.0 + 4.0 = 30.5이고, 30.5 × 2 = 61.0이다(검산: 61.0 ÷ 2 = 30.5, 각 항목 합과 일치). 유형 분류는 유창성(높음), 알아듣기(낮음), 따라말하기(보존) 세 축으로 판단하는데, 유창하고 이해가 떨어지면서 따라말하기만 좋은 조합은 연결피질감각실어증이다. 질문과 무관한 유창한 발화와 반향어도 이 유형의 전형적 특징이다. 분류 기준 점수 구간은 교재·검사 지침에 따라 약간 다를 수 있다.\",\"w\":{\"1\":\"유형은 맞지만 30.5는 다섯 항목을 더한 합계에 2를 곱하지 않은 값이므로 AQ로 옳지 않다.\",\"2\":\"AQ는 맞지만 베르니케실어증은 이해와 함께 따라말하기도 손상된다. 따라말하기 9.0점으로 보존된 지문과 맞지 않는다.\",\"4\":\"AQ는 맞지만 명칭실어증은 이해와 따라말하기가 모두 양호하고 이름대기만 두드러지게 저하된다. 알아듣기 3.5점은 명칭실어증으로 보기에 지나치게 낮다.\",\"5\":\"30.5는 2를 곱하지 않은 값이고, 전도실어증은 따라말하기가 두드러지게 손상되는 유형이므로 따라말하기 9.0점과 맞지 않는다.\"}},\"2-2-1-7\":{\"p\":\"착어(paraphasia)는 산출 과정에서 목표어가 다른 형태로 바뀌어 나오는 오류로, 크게 음소착어(문자착어)와 의미착어(언어착어)로 나뉜다. 의미착어(semantic paraphasia)는 목표어와 같은 범주이거나 의미적으로 연관된 다른 실제 낱말로 대치하는 것으로, '의자'와 '책상'은 둘 다 가구 범주에 속하는 실제 낱말이다. 판단할 때는 ① 산출된 말이 실제 낱말인지, ② 목표어와 의미로 연결되는지, 소리로 연결되는지를 차례로 확인하면 구분하기 쉽다.\",\"w\":{\"1\":\"'연필→연빌'은 목표어의 음소 하나(ㅍ→ㅂ)가 바뀐 음소착어로, 산출된 말도 실제 낱말이 아니다.\",\"2\":\"'가방→가반'은 끝소리(ㅇ→ㄴ)가 바뀐 음소착어이며, 목표어와 의미적으로 관련된 다른 낱말이 아니다.\",\"4\":\"'가위→모두리'는 목표어와 소리·의미 모두 관련이 없는, 실재하지 않는 낱말을 만들어 낸 신조어(neologism)이다.\",\"5\":\"'칫솔→이 닦는 거'는 목표 낱말 대신 용도를 풀어 설명하는 에두르기(우회적 표현, circumlocution)로, 다른 낱말로 대치한 착어가 아니다.\"}},\"2-2-1-8\":{\"p\":\"의미자질분석(Semantic Feature Analysis, SFA)은 목표 그림을 가운데 두고 범주(무엇의 한 종류인가), 용도(무엇에 쓰는가), 속성(어떻게 생겼는가), 장소(어디서 볼 수 있는가), 연상(무엇이 떠오르는가), 동작 등의 칸을 환자가 스스로 채우게 한다. 이렇게 목표어 주변의 의미망을 넓게 활성화하면 목표 낱말의 인출이 쉬워지고, 훈련하지 않은 낱말로 일반화되는 효과도 기대한다. 지문의 '둘레 칸 채우기'와 '범주·용도·생김새·장소·연상'이 SFA의 정형화된 절차이다. 같은 틀에 음운 정보를 넣는 음운성분분석(PCA)과 구분해야 한다.\",\"w\":{\"1\":\"멜로디 억양 치료(MIT)는 억양을 붙인 노래하듯 말하기와 손 두드리기로 비유창 실어증 환자의 구어 산출을 이끄는 기법으로, 의미 자질을 산출하게 하지 않는다.\",\"2\":\"음운성분분석(PCA)은 SFA와 비슷한 칸 채우기 형식이지만 첫소리, 음절 수, 끝소리, 운(라임)이 같은 낱말 등 음운 자질을 산출하게 한다는 점에서 다르다.\",\"3\":\"의사소통 효과 증진법(PACE)은 치료사와 환자가 번갈아 정보를 전달하며 제스처·그림·쓰기 등 모든 수단을 허용하는 화용 중심 기법이다.\",\"4\":\"시각 동작 치료(VAT)는 구어 산출이 거의 불가능한 중증 전반실어증 환자에게 사물을 나타내는 제스처를 훈련하는 기법이다.\"}},\"2-2-1-9\":{\"p\":\"제약유도 실어증 치료(Constraint-Induced Aphasia Therapy, CIAT)는 편마비 팔에 쓰는 제약유도 운동치료의 원리를 실어증에 적용한 것으로, ① 구어 이외의 보상 수단(제스처·가리키기·쓰기)을 제한하는 '제약', ② 하루 약 3시간·약 10일의 '집중 강도', ③ 카드 게임처럼 요청이 필요한 '의사소통 상황'이 핵심 요소이다. 환자가 습관적으로 쓰던 비구어 수단을 막아 학습된 불사용(learned non-use)을 극복하고 구어 사용을 강제로 늘리는 것이 목적이다. 지문의 세 조건이 이 세 요소와 정확히 대응한다. 세부 시간·기간은 연구·교재마다 다소 다르게 제시된다.\",\"w\":{\"1\":\"의사소통 효과 증진법(PACE)은 제스처·그림·쓰기 등 모든 의사소통 수단을 자유롭게 허용하므로, 보상 수단을 제한하는 지문의 절차와 정반대이다.\",\"3\":\"멜로디 억양 치료(MIT)는 억양과 손 두드리기를 이용해 짧은 구절을 산출하게 하는 기법으로, 카드 게임이나 보상 수단 제한을 핵심으로 하지 않는다.\",\"4\":\"반응 정교화 훈련(RET)은 환자의 짧은 발화를 치료사가 확장해 주고 환자가 그 정교화된 발화를 다시 산출하게 하여 발화 길이와 정보량을 늘리는 기법이다.\",\"5\":\"시각 동작 치료(VAT)는 말 대신 제스처 산출을 훈련하는 중증 환자용 기법으로, 오히려 비구어 수단을 강화한다.\"}},\"2-2-1-10\":{\"p\":\"원발진행실어증(PPA)은 신경퇴행성 질환으로 언어 기능이 먼저, 그리고 가장 두드러지게 서서히 나빠지는 증후군으로, 비유창형·의미변이형·로고페닉형의 세 변이형으로 나뉜다. 의미변이형(semantic variant)은 측두엽 앞부분 위축과 관련되며, 낱말 뜻 자체를 잃어 '처음 들어 보는 말'처럼 반응하고(단일 낱말 이해 저하), 사물 이름대기가 심하게 떨어지는 것이 핵심이다. 문법·조음과 따라말하기는 보존되고, 일화기억과 시공간 능력도 초기에 비교적 유지된다. 지문의 '서서히 진행', '낱말 뜻 상실', '따라말하기 보존', '일상 기억 유지'가 모두 이를 가리킨다.\",\"w\":{\"2\":\"비유창형 원발진행실어증은 실문법증과 말실행증(노력성·비일관적 말소리 오류)이 핵심이므로, 문법·조음이 정확하고 유창한 지문과 맞지 않는다.\",\"3\":\"로고페닉형 원발진행실어증은 낱말 찾기 휴지와 문장 따라말하기 저하가 특징이고 단일 낱말 이해는 비교적 유지되므로, 낱말 뜻을 잃고 따라말하기는 보존된 지문과 맞지 않는다.\",\"4\":\"베르니케실어증은 뇌졸중으로 갑자기 생기며 따라말하기도 손상되므로, 2년에 걸쳐 서서히 진행하고 따라말하기가 보존된 지문과 맞지 않는다.\",\"5\":\"피질하 혈관성 치매는 처리 속도 저하, 집행기능 장애, 보행 장애 등이 두드러지며, 낱말 의미의 선택적 상실이 주 증상이 아니다.\"}},\"2-2-1-11\":{\"p\":\"착문법증(paragrammatism)은 문법형태소를 빼먹지는 않지만 엉뚱한 조사·어미를 쓰거나 문장 구조가 뒤엉키는 오류로, 주로 베르니케실어증 같은 유창성 실어증에서 나타난다. 지문의 '물에게 넘쳐서'(조사 '이'가 와야 할 자리에 '에게'), '과자로 꺼내다가'('를' 대신 '로'), '넘어지고 있었는데요'처럼 어미·시제가 어색하게 뒤섞인 구조가 단서이다. 발화 길이·속도가 정상이고 조사·어미가 빠지지 않는다는 설명은 생략 중심의 실문법증을 배제하는 결정적 정보이다. 실문법증(생략)과 착문법증(오용)을 '빠지는가, 잘못 쓰는가'로 구분해 두면 된다.\",\"w\":{\"1\":\"실문법증(agrammatism)은 브로카실어증 같은 비유창 실어증에서 조사·어미 등 문법형태소를 생략해 내용어 위주의 전보식 발화가 나타나는 것으로, 조사·어미가 빠지지 않는 지문과 맞지 않는다.\",\"2\":\"반향어(echolalia)는 상대의 말을 그대로 따라 하는 현상으로, 지문의 발화는 스스로 그림을 설명한 것이다.\",\"3\":\"보속증(perseveration)은 이전에 한 반응을 부적절하게 되풀이하는 것으로, 지문에는 같은 말이나 반응이 반복되는 모습이 없다.\",\"4\":\"에두르기(circumlocution)는 목표 낱말이 떠오르지 않을 때 설명으로 돌려 말하는 낱말 인출 전략으로, 문법 오류 특성이 아니다.\"}},\"2-2-1-12\":{\"p\":\"멜로디 억양 치료(Melodic Intonation Therapy, MIT)는 손상되지 않은 우반구의 운율·음악 처리 능력을 활용해 억양을 붙인 노래하듯 말하기와 왼손 두드리기로 짧은 구절 산출을 이끄는 기법이다. 일반적인 대상자는 좌반구 손상 후 구어 산출이 극히 제한된 비유창 실어증(심한 브로카실어증 등)이면서, 따라말하기가 불량하고, 청각적 이해는 비교적 양호해 절차를 이해·수행할 수 있으며, 동기와 주의 집중이 유지되는 환자이다. 보기 중 '발화는 극히 제한, 이해는 양호' 조합만 이 조건을 충족한다.\",\"w\":{\"1\":\"유창하지만 청각적 이해가 심하게 떨어지는 환자는 베르니케실어증 양상으로, 발화가 유창해 MIT의 목표(구어 산출 촉진)가 맞지 않고 절차 이해도 어렵다.\",\"2\":\"따라말하기만 선택적으로 손상되고 발화가 유창한 것은 전도실어증 양상으로, 발화 산출 자체를 끌어낼 필요가 없어 MIT 대상이 아니다.\",\"4\":\"우반구 손상 환자는 MIT가 활용하는 우반구의 운율 처리 기능이 손상되어 있고 실어증도 주 문제가 아니므로 MIT 대상으로 적절하지 않다.\",\"5\":\"전반실어증처럼 청각적 이해까지 심하게 손상된 환자는 치료사의 시범과 단계 절차를 따르기 어려워 일반적으로 MIT의 좋은 대상이 아니다.\"}},\"2-2-1-13\":{\"p\":\"무시실독증(neglect dyslexia)은 편측무시(주로 우반구 손상 후 왼쪽 공간 무시)가 읽기에 나타나는 말초성 실독증이다. 낱말 수준에서는 왼쪽 글자를 빼거나('자동차→동차') 바꿔 읽고, 문장·문단 수준에서는 각 줄의 왼쪽 앞부분을 건너뛴다. 오른쪽 부분은 정확히 읽고 시력이 정상이라는 점은 시각 자체나 언어 처리의 문제가 아니라 공간 주의의 문제임을 보여 준다. 오른쪽 대뇌반구 손상이라는 정보와 '항상 왼쪽만' 틀린다는 규칙성이 핵심 단서이다.\",\"w\":{\"1\":\"순수실독증(실서증 없는 실독증)은 주로 좌측 후두엽·뇌량팽대 손상으로 생기며, 글자를 하나씩 읽어 나가는 낱자 읽기(letter-by-letter reading)와 낱말 길이에 비례한 읽기 시간 증가가 특징이다.\",\"3\":\"주의실독증(attentional dyslexia)은 낱자나 낱말 하나는 읽을 수 있지만 여러 개가 함께 제시되면 글자가 서로 섞여 들어가는 오류를 보이는 것으로, 왼쪽에 한정된 오류가 아니다.\",\"4\":\"표면실독증(surface dyslexia)은 어휘 경로가 손상되어 표기와 발음이 다른 낱말을 글자 그대로 소리 내어 읽는 규칙화 오류가 특징이다.\",\"5\":\"심층실독증(deep dyslexia)은 '바다→강'처럼 의미적으로 관련된 낱말로 읽는 의미 오류와 비단어 읽기 불능이 특징이다.\"}},\"2-2-1-14\":{\"p\":\"이중경로 모형에서 쓰기는 낱말의 철자 형태를 통째로 꺼내는 어휘(철자) 경로와, 소리를 글자로 하나씩 바꾸는 음운(소리-글자 변환) 경로를 이용한다. 표면실서증(surface agraphia)은 어휘 경로가 손상되어 음운 경로에 의존하므로, 소리와 표기가 같은 낱말과 비단어는 정확하게 쓰지만, 구개음화('같이→가치'), 비음화('국물→궁물'), 경음화·자음군 단순화('맑다→막따')처럼 발음과 표기가 다른 낱말은 소리 나는 대로 쓴다. 비단어가 정확하다는 점이 음운 경로 보존, 불규칙 표기 낱말 오류가 어휘 경로 손상의 증거이다.\",\"w\":{\"1\":\"음운실서증은 음운 경로가 손상되어 비단어 받아쓰기가 크게 떨어지고 친숙한 실제 낱말은 비교적 잘 쓰므로, 비단어가 정확한 지문과 반대이다.\",\"2\":\"심층실서증은 비단어 받아쓰기 손상에 더해 '바다'를 '강'으로 쓰는 식의 의미 오류가 나타나는 것으로, 지문에는 의미 오류가 없고 비단어도 정확하다.\",\"3\":\"실행성 실서증은 철자 지식은 있으나 글자의 획을 만드는 운동 계획에 문제가 있어 글자 모양이 일그러지는 것으로, 지문처럼 소리 나는 대로 쓰는 철자 오류와 다르다.\",\"5\":\"공간성 실서증은 주로 우반구 손상 후 글줄이 기울거나 종이 한쪽(주로 왼쪽)을 비우고 획을 중복하는 등 공간 배치가 무너지는 것으로, 철자 선택의 문제가 아니다.\"}},\"2-2-1-15\":{\"p\":\"친숙한 낱말은 읽지만 비단어를 거의 읽지 못하고 비슷한 실제 낱말로 바꿔 읽는(어휘화 오류) 양상은 음운실독증(phonological dyslexia)이다. 어휘 경로는 보존되었으나 글자를 소리로 바꾸는 자소-음소 변환 경로가 손상된 것이므로, 중재는 손상된 변환 규칙을 다시 세우는 데 둔다. 대표적으로 환자가 이미 읽을 수 있는 단서 낱말(예: 'ㄱ'은 '기차'의 첫소리)과 글자-소리를 연결해 익힌 뒤, 그 소리를 분리·합성해 새 낱말과 비단어로 확장하는 방식이 쓰인다. 보존된 어휘 경로를 다리로 삼아 손상된 음운 경로를 재훈련한다는 점이 핵심이다.\",\"w\":{\"2\":\"낱말 전체 모양을 통째로 기억하게 하는 것은 어휘 경로를 강화하는 방법으로, 어휘 경로가 손상된 표면실독증에 적합하다. 이 환자는 어휘 경로가 이미 보존되어 있다.\",\"3\":\"줄 왼쪽 끝에 색 선(앵커)을 그어 시작점을 표시하는 것은 왼쪽을 놓치는 무시실독증의 보상 전략이다.\",\"4\":\"손가락으로 글자 윤곽을 따라 그리며 읽는 촉각·운동감각 단서는 시각적 낱자 인식이 어려운 순수실독증에 쓰는 전략이다.\",\"5\":\"목표 낱말의 의미 자질을 말하게 하는 것은 이름대기 장애에 쓰는 의미자질분석(SFA)으로, 글자-소리 변환 문제를 직접 다루지 못한다.\"}},\"2-2-1-16\":{\"p\":\"혼합형 마비말장애는 두 가지 이상의 순수 유형이 함께 나타나는 것으로, 경직형+이완형 조합은 상위운동신경세포(UMN)와 하위운동신경세포(LMN)가 함께 변성되는 근위축성 측삭경화증(ALS)이 대표적이다. 지문에서 혀 위축과 섬유속연축(fasciculation)은 LMN 징후(이완형), 쥐어짜는 듯한 거친 음성·느린 말속도·턱반사 항진·가성연수 정동(병적 웃음·울음)은 양측 UMN 징후(경직형)이다. 과대비성은 두 유형 모두에서 나타날 수 있다. 1년에 걸쳐 진행하는 경과도 퇴행성 질환을 뒷받침하며, 한 유형으로는 소견 전체를 설명할 수 없다는 점이 정답의 근거이다.\",\"w\":{\"1\":\"이완형은 하위운동신경세포 손상으로 위축·섬유속연축·기식성 음성·과대비성이 나타나지만, 반사가 저하되므로 턱반사 항진과 가성연수 정동을 설명하지 못한다.\",\"2\":\"경직형은 양측 상위운동신경세포 손상으로 쥐어짜는 음성·느린 말속도·반사 항진·가성연수 정동을 보이지만, 혀 위축과 섬유속연축 같은 하위운동신경세포 징후는 설명하지 못한다.\",\"3\":\"실조형은 소뇌 손상으로 불규칙한 조음 붕괴, 과도하고 균일한 강세, 측정이상 등이 특징이며, 위축·섬유속연축이나 반사 항진과 관련이 없다.\",\"4\":\"과소운동형은 파킨슨병 같은 기저핵 손상으로 단조로운 음도·작은 음량·말 돌진이 특징이며, 혀 위축과 섬유속연축은 나타나지 않는다.\"}},\"2-2-1-17\":{\"p\":\"파킨슨병의 과소운동형 마비말장애는 단조로운 음도·강세, 작은 음량, 짧은 말 뭉치(short rushes of speech), 말속도 가속 등을 보인다. 이 환자는 음량은 유지되고 명료도를 떨어뜨리는 주된 원인이 말 돌진(가속)이므로, 말속도를 외부에서 끊어 늦추는 중재가 우선이다. 속도 조절판(pacing board)은 여러 칸이 나뉜 판으로, 칸 하나를 짚을 때마다 한 음절(또는 낱말)씩 말하게 해 속도를 강제로 늦추고 음절 경계를 분명히 한다. 만약 음량 저하가 주 문제였다면 LSVT LOUD 같은 음량 중심 중재를 먼저 고려했을 것이라는 점과 비교해 둔다.\",\"w\":{\"1\":\"성대 내전 밀기(pushing) 운동은 성대가 충분히 닫히지 않는 이완형(예: 미주신경 손상)의 기식성 음성에 쓰는 기법으로, 말 돌진 문제를 다루지 못한다.\",\"3\":\"근전도 바이오피드백 이완은 근긴장이 과도한 경우(예: 경직형, 과긴장성 발성)에 근육 이완을 돕는 방법으로, 말속도 가속을 직접 조절하지 못한다.\",\"4\":\"구개거상 보철기는 연인두 폐쇄 부전으로 과대비성이 심할 때 연구개를 들어 올려 주는 장치로, 과대비성 소견이 없는 지문과 맞지 않는다.\",\"5\":\"코를 막고 압력자음을 훈련하는 것은 연인두 기능과 구강 내압 형성을 다루는 방법으로, 말속도 가속과 관련이 없다.\"}},\"2-2-1-18\":{\"p\":\"8단계 연속 통합자극법(Rosenbek의 8-step continuum)은 말실행증 치료의 대표적 위계 절차로, '보고 들으며 동시에 말하기'(통합 자극, integral stimulation)에서 시작한다. 이후 치료사의 입 모양만 보며 함께 말하기, 듣고 따라 말하기, 지연 따라 말하기, 글자 보고 읽기 등으로 단서를 점차 줄이고, 마지막에는 질문 응답·역할극 같은 자발적 상황에서 목표 발화를 산출하게 한다. 운동 프로그래밍이 손상된 말실행증 환자에게 시각·청각 단서를 최대로 준 상태에서 정확한 운동 패턴을 반복하게 한 뒤 단서를 체계적으로 철회하는 원리이다.\",\"w\":{\"2\":\"멜로디 억양 치료(MIT)는 억양을 붙인 말하기와 손 두드리기를 이용하는 기법으로, 입 모양·듣기·읽기 단서를 단계적으로 줄이는 지문의 절차와 다르다.\",\"3\":\"PROMPT(촉각 단서 기법)는 치료사가 환자의 턱·입술·얼굴에 직접 촉각·운동감각 단서를 주어 조음 운동을 유도하는 기법이다.\",\"4\":\"리 실버만 음성치료(LSVT LOUD)는 파킨슨병 환자의 음량을 높이는 집중 음성치료로, 말실행증의 운동 프로그래밍 위계 훈련이 아니다.\",\"5\":\"대조 강세 훈련은 질문에 따라 문장 내 다른 낱말에 강세를 주게 해 운율과 강세 조절을 훈련하는 기법으로, 통합 자극에서 출발하는 단계 절차가 아니다.\"}},\"2-2-1-19\":{\"p\":\"단어 명료도는 낯선 청자가 바르게 받아 적은 낱말 수를 전체 낱말 수로 나누어 100을 곱한다. 34 ÷ 50 = 0.68이므로 68%이다(검산: 50 × 0.68 = 34). 말속도는 산출한 음절 수를 시간으로 나눈다. 108음절 ÷ 30초 = 초당 3.6음절이고, 1분으로 환산하면 3.6 × 60 = 분당 216음절이다(검산: 3.6 × 30 = 108). 명료도는 '맞은 수 ÷ 전체 수', 말속도는 '단위 시간당 음절 수'이며 단위(초당/분당)를 반드시 확인해야 한다.\",\"w\":{\"1\":\"34%는 바르게 적은 낱말 수(34개)를 그대로 백분율로 착각한 값이다. 낱말 50개 중 34개이므로 50으로 나누어야 한다.\",\"2\":\"72%는 34 ÷ 50 계산과 맞지 않는 값이다(72%라면 36개를 바르게 적어야 한다). 말속도는 맞다.\",\"4\":\"명료도는 맞지만, 108음절은 30초 동안 산출한 값이므로 분당으로는 216음절이다. 30초 값을 1분 값으로 잘못 본 것이다.\",\"5\":\"명료도는 맞지만, 초당 2.8음절이라면 30초 동안 84음절이어야 한다. 108 ÷ 30 = 3.6이므로 계산이 틀렸다.\"}},\"2-2-1-20\":{\"p\":\"과소운동형 마비말장애는 중뇌 흑질의 도파민 신경세포가 소실되어 흑질-선조체 경로(기저핵 조절회로)가 손상될 때 생기며, 파킨슨병이 대표 원인이다. 도파민이 부족하면 운동 개시가 어렵고 운동 범위가 줄어들어 단조로운 음도·강세, 작은 음량, 부정확한 자음, 짧은 말 뭉치가 나타난다. 같은 기저핵 회로라도 운동이 '줄어들면' 과소운동형, 불수의 운동이 '넘치면' 과다운동형이라는 대비로 기억해 두면 유형-병변 연결 문제를 쉽게 풀 수 있다.\",\"w\":{\"1\":\"이완형은 하위운동신경세포(뇌신경·척수신경, 신경근 접합부, 근육) 손상으로 생긴다. 양측 상위운동신경세포 손상은 경직형의 병변이다.\",\"2\":\"실조형은 소뇌 조절회로 손상으로 생긴다. 기저핵 조절회로는 과소운동형·과다운동형과 관련된다.\",\"3\":\"경직형은 양측 상위운동신경세포(피질연수로 등) 손상으로 생긴다. 말초 뇌신경 손상은 이완형의 병변이다.\",\"5\":\"과다운동형은 기저핵 조절회로 손상과 관련된다. 소뇌 조절회로는 실조형의 병변이다.\"}},\"2-2-1-21\":{\"p\":\"연속운동속도(Sequential Motion Rate, SMR) 과제는 /퍼터커/처럼 입술-혀끝-혀뒤로 조음 위치가 다른 음절을 빠르게 이어 반복하게 하는 것으로, 조음기관 사이를 빠르게 전환하며 운동을 순서대로 계획·실행하는 능력을 본다. 말실행증에서는 순서가 뒤바뀌거나 모색행동·음절 분리가 나타나 감별에 특히 유용하다. 이에 비해 /퍼퍼퍼/처럼 같은 음절을 반복하는 교대운동속도(Alternate Motion Rate, AMR) 과제는 한 조음기관의 반복 속도와 규칙성을 보며, 실조형에서 불규칙성이 두드러진다. 각 과제가 '무엇을 측정하는가'를 짝지어 기억해 두는 것이 핵심이다.\",\"w\":{\"1\":\"모음 연장(/아/ 길게 내기)은 호흡 지지, 발성 지속 시간, 음질·음도 안정성을 보는 과제이며, 조음기관 사이의 전환은 SMR로 본다.\",\"2\":\"/퍼퍼퍼/ 반복은 교대운동속도(AMR) 과제로 한 조음기관(입술)의 반복 속도와 규칙성을 본다. 호흡과 발성의 지속 능력은 모음 연장으로 본다.\",\"4\":\"문단 읽기는 연결 발화에서의 말속도, 명료도, 운율, 호흡-발성 협응을 종합적으로 보는 과제이며, 단일 조음기관의 반복 속도는 AMR로 본다.\",\"5\":\"음도를 올리며 /아/를 내는 과제는 후두의 음도 조절 범위를 보는 것이다. 연인두 폐쇄 기능은 /아/ 발성 시 연구개 움직임 관찰, 비강 공명 평가 등으로 본다.\"}},\"2-2-1-22\":{\"p\":\"과다운동형 마비말장애는 기저핵 조절회로 손상으로 불수의 운동이 말 산출을 방해해 생긴다. 지문의 유전성 퇴행성 질환, 얼굴·어깨·손가락의 빠르고 예측할 수 없는 움찔거림(무도증, chorea)은 헌팅턴병을 시사한다. 무도증이 호흡·발성·조음에 끼어들면 갑작스러운 음도·음량 변화, 강제적 흡기·호기로 인한 말 끊김, 불규칙한 말속도가 나타난다. 측정이상(dysmetria)이 뚜렷하지 않다는 정보는 실조형과의 감별 단서로, 불규칙성의 원인이 소뇌의 협응 장애가 아니라 불수의 운동임을 보여 준다.\",\"w\":{\"1\":\"이완형은 하위운동신경세포 손상으로 근약화·위축이 나타나며, 기식성 음성·과대비성·부정확한 자음이 특징이다. 불수의 운동은 동반되지 않는다.\",\"3\":\"경직형은 양측 상위운동신경세포 손상으로 쥐어짜는 음성, 느린 말속도, 반사 항진이 특징이며, 무도증 같은 불수의 운동과는 관련이 없다.\",\"4\":\"실조형도 불규칙한 조음 붕괴와 음량·강세 변화를 보이지만 측정이상·보행 실조 같은 소뇌 징후가 동반되고 불수의 운동은 없다. 지문은 측정이상이 뚜렷하지 않다고 했다.\",\"5\":\"과소운동형은 파킨슨병 같은 질환에서 단조로운 음도, 작은 음량, 말 돌진이 특징이며, 운동이 줄어드는 양상이지 빠른 불수의 운동이 나타나지 않는다.\"}},\"2-2-1-23\":{\"p\":\"VFSS 판독에서 음식물이 기도로 들어간 깊이는 성대를 기준으로 나눈다. 후두 침투(laryngeal penetration)는 음식물이 후두 입구(후두 전정)까지 들어갔으나 성대 아래로는 내려가지 않은 상태이고, 흡인(aspiration)은 성대 아래 기관까지 들어간 상태이다. 지문은 조영제가 후두 입구로 들어갔지만 성대 아래로 내려가지 않았고 삼킨 직후 밖으로 배출되었으므로 후두 침투이다. 침투-흡인 척도(PAS)에서도 침투 깊이와 배출 여부로 단계를 나누며, 배출되는 얕은 침투는 정상인에게도 가끔 관찰될 수 있다.\",\"w\":{\"2\":\"흡인은 음식물이 성대 아래(기관)까지 들어간 경우로, 조영제가 성대 아래로 내려가지 않은 지문과 맞지 않는다.\",\"3\":\"무증상 흡인(silent aspiration)은 흡인이 일어났는데도 기침·목 가다듬기 같은 반응이 없는 경우로, 이 지문에서는 흡인 자체가 일어나지 않았다.\",\"4\":\"비강 역류는 연인두 폐쇄가 불충분해 음식물이 코 쪽(비인두)으로 넘어가는 것으로, 후두 입구로 들어간 지문의 소견과 위치가 다르다.\",\"5\":\"인두 잔여물은 삼킨 뒤에도 후두개곡이나 조롱박오목 등 인두에 음식물이 남는 것으로, 기도 입구로 들어간 소견을 가리키는 용어가 아니다.\"}},\"2-2-1-24\":{\"p\":\"상부식도괄약근(UES)이 열리려면 설골·후두가 앞위쪽으로 충분히 올라가 괄약근을 당겨 주어야 한다. 후두 상승의 높이와 유지 시간이 부족하면 UES 개방이 좁고 짧아 조롱박오목(이상와)에 잔여물이 남는다. 멘델슨 기법(Mendelsohn maneuver)은 삼키다가 후두가 가장 높이 올라간 순간을 몇 초간 의도적으로 유지하게 하여 후두 상승의 범위·지속 시간을 늘리고 UES를 더 넓고 길게 열리게 한다. 동작을 이해하고 새로 익혀야 하는 기법이므로 지시 따르기와 학습이 가능하다는 정보가 적용 조건을 충족함을 보여 준다.\",\"w\":{\"1\":\"성문위 삼킴법은 숨을 참아 성대를 닫은 채 삼키고 바로 기침하게 하는 기도 보호 기법으로, 삼킴 전·중 흡인을 줄이는 데 쓰이며 후두 상승 부족을 직접 개선하지 않는다.\",\"2\":\"최대 성문위 삼킴법은 숨을 참고 힘을 주어 피열연골을 앞으로 기울여 후두 입구까지 닫는 기도 보호 기법으로, 후두 상승·UES 개방 부족이 주 문제인 지문에는 맞지 않는다.\",\"3\":\"노력 삼킴법은 힘껏 삼키게 해 혀뿌리 후퇴와 인두 압력을 높이는 기법으로, 주로 후두개곡 잔여물 감소에 쓰이며 후두 상승 유지 시간을 늘리는 것이 핵심 목적은 아니다.\",\"4\":\"혀 내밀고 삼키기(마사코 기법)는 혀를 앞니로 물고 삼켜 인두 후벽의 앞쪽 움직임을 강화하는 운동으로, 혀뿌리-인두 후벽 접촉 부족에 적용한다.\"}},\"2-2-1-25\":{\"p\":\"섬유내시경 삼킴검사(FEES)는 코로 내시경을 넣어 위에서 인두·후두를 내려다보는 검사이다. 삼키는 순간에는 인두가 수축하고 연구개·혀뿌리가 내시경 끝에 닿아 화면이 하얗게 되는 화이트아웃(white-out)이 생기므로 그 순간의 인두 내부를 직접 볼 수 없다. 따라서 삼킴 중 흡인은 삼킨 뒤 기도에 남은 음식물로 간접 추정하며, 삼키는 순간과 구강·식도 단계는 VFSS가 더 잘 본다. '옳지 않은 것'을 고르는 문항이므로 FEES의 한계를 장점처럼 서술한 보기를 찾으면 된다.\",\"w\":{\"1\":\"FEES는 방사선을 쓰지 않아 노출 걱정 없이 반복 검사할 수 있으며, 이는 VFSS와 비교한 FEES의 실제 장점이다.\",\"2\":\"FEES는 휴대용 장비로 병실 침상이나 중환자실에서도 시행할 수 있으며, 이는 투시 장비가 필요한 VFSS와 비교한 FEES의 실제 장점이다.\",\"3\":\"FEES는 조영제 없이 환자가 실제로 먹는 음식(필요 시 식용 색소로 착색)을 그대로 쓸 수 있으며, 이는 FEES의 실제 장점이다.\",\"5\":\"FEES는 인두·후두 점막의 상태, 분비물 고임, 성대 움직임 등을 컬러 영상으로 직접 볼 수 있으며, 이는 VFSS가 보여 주지 못하는 FEES의 장점이다.\"}},\"2-2-1-26\":{\"p\":\"루이소체 치매(Dementia with Lewy Bodies, DLB)의 핵심 임상 특징은 ① 주의력·각성 수준의 뚜렷한 변동, ② 반복적이고 구체적인 환시(사람·동물 등), ③ 파킨슨증(떨림·서동·경직), ④ 렘수면 행동장애이다. 지문에 네 가지 핵심 특징이 모두 제시되어 있다. 같은 알파-시누클레인 질환인 파킨슨병 치매와는 일반적으로 '치매가 파킨슨증보다 먼저 또는 1년 이내에 나타나는가'로 구분한다. 진단 기준의 세부 항목은 개정판·교재에 따라 표현이 다를 수 있다.\",\"w\":{\"2\":\"알츠하이머 치매는 초기부터 최근 일화기억 저하가 두드러지고 서서히 진행하며, 하루 단위의 큰 인지 변동, 생생한 환시, 초기 파킨슨증은 전형적이지 않다.\",\"3\":\"혈관성 치매는 뇌졸중 병력과 함께 계단식 악화, 국소 신경 징후, 처리 속도·집행기능 저하가 두드러지며, 반복적 환시와 렘수면 행동장애가 핵심 특징이 아니다.\",\"4\":\"행동변이 전두측두엽 치매는 초기에 탈억제, 무감동, 공감 상실, 식습관 변화 같은 성격·행동 변화가 두드러지며, 환시와 파킨슨증이 핵심이 아니다.\",\"5\":\"크로이츠펠트-야콥병은 프리온 질환으로 수개월 안에 급속히 진행하는 치매와 근간대경련(myoclonus)이 특징이며, 지문의 특징 조합과 다르다.\"}},\"2-2-1-27\":{\"p\":\"란초 로스 아미고스 인지기능척도(RLA)는 외상성 뇌손상 후 회복 과정을 인지·행동 수준에 따라 단계로 나눈 척도이다(원판 8단계, 개정판 10단계). Ⅳ단계(혼돈·초조, confused-agitated)는 깨어 있지만 내적 혼란이 커서 과활동, 소리 지르기, 침대에서 내려오려는 행동, 공격성 같은 초조 행동이 두드러지고, 주의 지속 시간이 매우 짧으며 자신과 주변 상황을 이해하지 못하는 시기이다. 지문의 '흥분·소리 지름', '주의 매우 짧음', '상황 이해 불가', '밀치며 협조 거부'가 Ⅳ단계의 특징과 일치한다. 이 단계에서는 자극을 줄인 안정된 환경을 제공하는 것이 우선이다.\",\"w\":{\"1\":\"Ⅱ단계(전반적 반응)는 자극에 대해 일관되지 않고 비특정적인 전신 반응(예: 몸 전체 움직임, 생리적 변화)만 보이는 단계로, 깨어서 흥분해 행동하는 지문의 환자보다 훨씬 낮은 수준이다.\",\"2\":\"Ⅲ단계(국소적 반응)는 자극의 종류에 따라 특정한 반응(예: 소리 쪽으로 고개 돌리기)을 보이지만 일관되지 않는 단계로, 두드러진 초조·공격 행동은 Ⅳ단계의 특징이다.\",\"4\":\"Ⅴ단계(혼돈·부적절)는 초조 행동이 줄어들고 간단한 지시는 따를 수 있으나 혼돈과 부적절한 반응이 남는 단계로, 심한 흥분과 협조 거부를 보이는 지문보다 높은 수준이다.\",\"5\":\"Ⅶ단계(자동적·적절)는 익숙한 일상 활동을 자동적으로 적절히 수행하지만 판단력·통찰이 부족한 단계로, 상황을 전혀 이해하지 못하는 지문과 맞지 않는다.\"}},\"2-2-1-28\":{\"p\":\"'창문 좀 열어 줄 수 있으세요?'는 형식상 능력을 묻는 의문문이지만, 부채질이라는 상황 맥락과 함께 실제로는 '창문을 열어 달라'는 간접 요청(간접화행)이다. 환자는 문장 자체는 정확히 이해하고 '열 수 있다'고 답했지만, 말한 사람의 의도를 추론하지 못해 행동하지 않았다. 우반구 손상 환자는 낱말·문법 같은 언어 형식은 보존되면서도 맥락을 통합해 함축·간접 요청·비유·유머를 이해하는 화용 능력이 떨어지는 경우가 많다. 오른팔 사용 제한 없음, 언어검사 정상이라는 정보는 운동 문제나 언어 이해 문제를 배제하는 단서이다.\",\"w\":{\"1\":\"청각적 낱말 이해가 손상되었다면 질문 자체에 엉뚱하게 반응했을 것이다. 환자는 질문에 문법적으로 맞게 답했고 낱말 이해 검사도 정상이다.\",\"3\":\"작업기억 용량이 감소하면 긴 문장이나 여러 단계 지시를 놓치기 쉽지만, 지문의 요청은 짧은 한 문장이고 환자는 내용을 정확히 기억해 대답했다.\",\"4\":\"편측무시는 왼쪽 공간의 자극을 알아차리지 못하는 주의 문제로, 말의 숨은 의도를 이해하지 못하는 반응을 설명하지 못한다.\",\"5\":\"정서적 운율 산출 저하는 환자 자신의 말에 감정 억양을 싣지 못하는 문제로, 상대 말의 의도 이해와는 다른 영역이다.\"}},\"2-2-1-29\":{\"p\":\"임상치매척도(Clinical Dementia Rating, CDR)는 기억, 지남력, 판단력과 문제해결, 사회활동, 집안생활과 취미, 위생과 몸치장의 6개 영역을 환자와 보호자 면담으로 평정한 뒤, 기억 영역을 중심으로 종합해 0(정상), 0.5(최경도·의심), 1(경도), 2(중등도), 3(중증)으로 전반적 중증도를 판정한다. 6개 영역 점수를 모두 더한 CDR-SB(Sum of Boxes)도 함께 쓰인다. 직접 수행 검사가 아니라 '면담 정보 종합 평정'이고 0.5 단계가 있다는 점이 다른 도구와 구별되는 단서이다. 확장판에서는 4, 5단계를 추가하기도 한다.\",\"w\":{\"1\":\"한국판 간이정신상태검사(K-MMSE)는 지남력·기억·주의·언어 등을 환자가 직접 수행하는 30점 만점의 인지 선별검사로, 면담 기반의 6개 영역 평정이 아니다.\",\"2\":\"서울신경심리검사(SNSB)는 주의, 언어, 시공간, 기억, 전두엽 집행기능 등을 여러 하위 검사로 자세히 평가하는 종합 신경심리검사로, 전반적 중증도 단계 판정 도구가 아니다.\",\"3\":\"한국판 보스턴 이름대기 검사(K-BNT)는 그림을 보고 이름을 대게 하는 이름대기 검사로, 치매의 전반적 중증도를 평정하지 않는다.\",\"4\":\"전반적 퇴화 척도(GDS)는 정상(1단계)부터 최중증(7단계)까지 인지 퇴화 정도를 7단계로 구분하는 척도로, 6개 영역을 평정해 0~3으로 판정하는 방식이 아니다.\"}},\"2-2-1-30\":{\"p\":\"Sohlberg와 Mateer의 임상 모델에서는 주의를 초점·지속·선택·교대·분할 주의로 위계화한다. 교대 주의(alternating attention)는 서로 다른 인지 요구를 가진 과제 사이를 오가며 주의 초점을 유연하게 전환하는 능력으로, 집행기능의 인지적 유연성과 관련된다. 지문에서는 신호음이 날 때마다 '홀수에 반응'과 '짝수에 반응'이라는 두 규칙을 번갈아 적용해야 하므로, 앞 규칙을 억제하고 새 규칙으로 전환하는 능력이 핵심이다. 두 과제를 '동시에' 하는 분할 주의와 '번갈아' 하는 교대 주의를 구분하는 것이 판단 포인트이다.\",\"w\":{\"1\":\"지속적 주의는 한 과제에 오랫동안 꾸준히 주의를 유지하는 능력으로, 홀수에만 계속 반응하는 과제라면 해당하지만 규칙 전환은 요구하지 않는다.\",\"2\":\"선택적 주의는 방해 자극(소음, 시각 방해물 등)을 무시하고 목표 자극에 집중하는 능력으로, 지문의 핵심은 방해 자극 배제가 아니라 규칙 전환이다.\",\"3\":\"분할 주의는 두 과제를 동시에 처리하는 능력(예: 숫자 반응하면서 동시에 단어 듣기)으로, 지문처럼 한 번에 한 규칙만 적용하며 번갈아 바꾸는 과제와 다르다.\",\"5\":\"초점 주의는 특정 자극에 기본적으로 반응하는 가장 낮은 수준의 주의로, 주로 혼수에서 회복되는 초기 단계에서 평가하며 규칙 전환 능력을 요구하지 않는다.\"}},\"2-2-1-31\":{\"p\":\"PET·fMRI 같은 뇌영상 연구에서 말더듬 성인은 말할 때 우반구의 운동·전운동 영역(보조운동영역, 섬엽 주변 등)이 정상 화자보다 지나치게 활성화되고, 자기 말소리를 처리해야 할 좌반구 청각 영역(측두엽)의 활성은 오히려 낮아지는 양상이 반복 보고된다. 이는 말 산출을 담당하는 좌반구 네트워크가 효율적으로 작동하지 못해 우반구가 보상적으로 동원된다는 해석, 그리고 청각 피드백 처리의 이상이 말더듬과 관련된다는 해석의 근거가 된다. 따라서 '우반구 과활성 + 좌반구 청각 영역 저활성'을 한 쌍으로 기억해 두면 비슷한 보기를 가려내기 쉽다. 소뇌 과활성도 함께 보고되며, 유창하게 말하는 조건(합창 읽기 등)에서는 이런 이상 패턴이 줄어드는 경향이 있다.\",\"w\":{\"1\":\"좌반구 청각 영역은 말더듬 성인이 말할 때 정상 화자보다 활성이 감소하는 영역이다. 증가한다고 한 방향이 반대이다.\",\"3\":\"말더듬 성인은 언어 기능의 좌반구 편재화(반구 분화)가 정상 화자보다 덜 뚜렷한 것으로 보고된다. 이것이 Orton-Travis의 대뇌 반구 우세 이론 이후 이어진 관점이다.\",\"4\":\"소뇌는 말더듬 성인이 말할 때 오히려 과활성화가 보고되는 영역이다. 일관되게 감소한다는 서술은 연구 결과와 맞지 않는다.\",\"5\":\"지연청각피드백(DAF)은 많은 말더듬 화자에게서 말속도를 늦추고 말더듬을 줄이는 조건으로 알려져 있다. 정상 화자에게 DAF를 주면 비유창성이 생길 수 있지만, 말더듬이 일관되게 증가한다는 것은 틀린 설명이다.\"}},\"2-2-1-32\":{\"p\":\"진단착오 이론(diagnosogenic theory)은 Johnson이 제안한 것으로, 말더듬은 아동의 입이 아니라 부모의 귀에서 시작된다고 본다. 지문의 단서는 세 단계로 읽는다. 첫째, 아동의 반복이 '또래 수준의 긴장 없는' 정상적 비유창성이었다. 둘째, 부모가 이를 '말더듬'이라 이름 붙이고(진단 착오) 말할 때마다 지적했다. 셋째, 그 결과 아동이 반복하지 않으려 애쓰고 말하기 전에 긴장하면서 비유창성이 심해졌다. 즉 정상 비유창성 → 청자의 부정적 평가 → 아동의 예기·회피·긴장 → 말더듬 발생이라는 순서가 이 이론의 핵심이다. 오늘날에는 말더듬의 원인을 부모 반응만으로 설명하지 않지만, 부모 상담에서 지적·교정을 피하도록 안내하는 근거로 여전히 다루어진다.\",\"w\":{\"1\":\"요구-용량 모델은 환경과 아동 자신의 요구(빠른 말, 복잡한 언어 등)가 아동의 운동·언어·정서·인지 용량을 넘어설 때 비유창성이 생긴다고 본다. 지문은 용량과 요구의 불균형이 아니라 정상 비유창성을 잘못 낙인찍은 과정을 보여 준다.\",\"2\":\"대뇌 반구 우세 이론(Orton-Travis)은 언어에 대한 한쪽 반구의 우세가 불충분해 양 반구의 말 운동 명령이 어긋난다고 보는 신경학적 설명이다. 부모의 반응으로 말더듬이 생기는 지문 과정과 관련이 없다.\",\"3\":\"이중 접근-회피 갈등 이론은 Sheehan이 제안한 것으로, 말하려는 욕구와 말하지 않으려는(침묵하려는) 욕구가 팽팽할 때 막힘이 생긴다고 본다. 부모의 진단 착오라는 지문의 핵심 단서를 설명하지 못한다.\",\"5\":\"내적 수정 가설(Postma와 Kolk)은 음운 부호화 과정의 오류를 말하기 전에 스스로 감지해 고치려는 과정이 비유창성으로 드러난다고 보는 심리언어학적 설명이다. 환경 반응이 아닌 내부 언어 처리 과정에 초점을 둔다.\"}},\"2-2-1-33\":{\"p\":\"Brown은 성인 말더듬이 무작위로 생기지 않고 특정 언어적 위치에 몰린다는 것을 보고하였다(Brown의 요인). 일반적으로 정리되는 요인은 (1) 자음으로 시작하는 낱말, (2) 문장의 첫 낱말(앞부분), (3) 내용어(명사·동사·형용사·부사), (4) 긴 낱말로, 낱말 안에서는 첫 음절에서 대부분 나타난다. 문장 첫머리는 발화 계획과 운동 실행의 부담이 가장 큰 지점이고 말하기 직전 예기 불안도 집중되므로 말더듬이 잦다. 반면 학령전 아동은 문장 첫머리의 대명사·접속사 같은 기능어에서 더 자주 더듬는다는 차이가 있어 대상 연령별로 구분해 기억해야 한다.\",\"w\":{\"2\":\"문장 끝은 발화 계획 부담이 줄어드는 위치이고, Brown의 요인에서는 문장 앞부분일수록 말더듬이 많다. 문장 끝의 서술어에서 더 자주 나타난다는 근거가 없다.\",\"3\":\"성인 말더듬은 기능어보다 내용어에서 더 많이 나타난다. 기능어에서 더 더듬는 경향은 학령전 아동의 특성이다.\",\"4\":\"낱말 안에서 말더듬은 대부분 첫 음절(첫소리)에서 나타난다. 낱말 중간·끝 음절에서도 자주 나타나는 것은 발달성 말더듬보다 신경인성·심인성 말더듬처럼 위치가 다양한 유형의 특징이다.\",\"5\":\"사용 빈도가 낮고 덜 친숙한 낱말일수록 말더듬이 더 많이 나타난다. 자주 쓰는 친숙한 낱말은 오히려 비교적 유창하게 산출된다.\"}},\"2-2-1-34\":{\"p\":\"쌍생아 연구는 유전과 환경의 영향을 가르는 대표적 방법이다. 일란성 쌍생아는 유전자를 거의 100% 공유하고 이란성 쌍생아는 약 50% 공유하므로, 같은 가정환경에서 자란 두 집단을 비교했을 때 일란성의 일치율(한 명이 말을 더듬으면 다른 한 명도 더듬는 비율)이 더 높다면 유전 요인이 작용한다고 해석한다. 말더듬 연구에서는 일란성의 일치율이 이란성보다 뚜렷하게 높게 나타난다. 다만 일란성도 일치율이 100%가 아니므로 환경 요인 역시 관여하며, 현재는 여러 유전자(GNPTAB 등 일부 후보 유전자 포함)와 환경이 함께 작용하는 다요인 모델로 이해한다.\",\"w\":{\"1\":\"말더듬은 단일 유전자로 발생 여부가 결정되는 멘델식 유전 질환이 아니라 여러 유전자와 환경이 함께 작용하는 다요인 유전으로 본다. 일부 가계에서 관련 유전자가 보고되었지만 전체 말더듬을 설명하지 못한다.\",\"2\":\"말더듬 가족력이 있으면 발생 위험이 높아지며, 특히 성인까지 지속된 가족력은 지속 위험과도 관련된다. 가족력이 무관하다는 것은 가족 연구 결과와 반대이다.\",\"4\":\"입양 연구에서 말더듬은 양부모보다 친부모의 말더듬 여부와 더 관련되는 것으로 보고되어 유전 요인을 지지한다. 양부모와 가장 관련된다는 것은 환경 요인만 강조한 틀린 설명이다.\",\"5\":\"발병 초기 남녀 비율은 일반적으로 약 2:1 안팎이지만, 여아의 자연회복률이 더 높아 연령이 높아질수록 남성 비율이 커진다(성인은 교재에 따라 약 4:1 이상). 1:1에 가까워진다는 것은 방향이 반대이다.\"}},\"2-2-1-35\":{\"p\":\"'ㅅ――사탕'은 첫소리 /ㅅ/를 길게 늘인 연장(prolongation)으로, 소리의 흐름이 한 음에 멈춰 이어지지 않는 비운율적 발성(disrhythmic phonation)에 속한다. 연장은 낱말 단위보다 작은 소리·음절 수준에서 일어나는 비유창성이어서 P-FA-II에서는 비정상적 비유창성(AD), Yairi와 Ambrose 체계에서는 진성 비유창성(SLD, stuttering-like disfluency)으로 분류된다. 판단 기준은 '비유창성이 일어난 단위의 크기'와 '긴장·리듬 깨짐'이다. 간투사·수정·미완성·다음절 낱말이나 구 반복처럼 낱말 이상 단위에서 생기는 것은 정상 화자에게도 흔한 정상적 비유창성으로 본다. 다만 다음절 낱말 반복도 횟수가 많거나 긴장이 동반되면 해석이 달라질 수 있어, 검사별 분류 기준을 함께 확인해야 한다.\",\"w\":{\"1\":\"'음'은 의미 없는 소리를 끼워 넣은 간투사로, 정상 화자에게도 흔한 정상적 비유창성이다. P-FA-II와 Yairi와 Ambrose 체계 모두 말더듬 특유의 비유창성으로 보지 않는다.\",\"2\":\"'엄마가'를 '아빠가'로 바꿔 말한 것은 내용을 고친 수정(revision)으로 정상적 비유창성(기타 비유창성)에 해당한다.\",\"3\":\"다음절 낱말 '그래서'를 긴장 없이 1회 반복한 것은 낱말 이상 단위의 반복이다. P-FA-II에서는 정상적 비유창성(반복1), Yairi와 Ambrose 체계에서는 기타 비유창성으로 분류한다.\",\"4\":\"'그거'를 말하다 멈추고 '그 장난감'으로 바꾼 것은 미완성·수정으로 정상적 비유창성이다. 소리·음절 수준의 반복이나 연장이 없다.\"}},\"2-2-1-36\":{\"p\":\"먼저 Yairi와 Ambrose 체계의 분류를 적용한다. 진성 비유창성(SLD)은 낱말부분 반복, 단음절 낱말 반복, 비운율적 발성(연장·막힘·깨진 낱말)이므로 지문에서는 낱말부분 반복 7 + 막힘 3 + 연장 2 = 12회이다. 간투사 9, 수정 4, 구 반복 3은 기타 비유창성(OD)으로 16회이다. 100음절당 빈도 = 해당 비유창성 수 ÷ 전체 음절 수 × 100이므로 12 ÷ 300 × 100 = 4.0회이다. 검산: 300음절은 100음절 단위가 3개이므로 12 ÷ 3 = 4.0으로 같다. 참고로 Yairi와 Ambrose 연구에서는 일반적으로 100음절당 SLD 약 3회 이상을 말더듬 판정의 기준점으로 쓰는데, 기준 수치는 교재·연구마다 다를 수 있다.\",\"w\":{\"1\":\"2.0회는 SLD 12회를 600음절로 나눈 것처럼 분모를 잘못 잡았을 때 나오는 값으로, 정확한 빈도의 절반에 그친다. 지문의 표본은 300음절이다.\",\"3\":\"5.3회는 간투사 9 + 수정 4 + 구 반복 3 = 16회, 즉 기타 비유창성(OD)을 300음절로 환산한 값이다(16 ÷ 300 × 100 ≒ 5.3). 문항이 묻는 SLD가 아니다.\",\"4\":\"9.3회는 SLD 12회와 OD 16회를 합한 전체 비유창성 28회의 빈도이다(28 ÷ 300 × 100 ≒ 9.3). 진성 비유창성만 골라 세지 않은 실수이다.\",\"5\":\"12.0회는 SLD 횟수 자체로, 300음절 표본을 100음절당 빈도로 환산하지 않은 값이다.\"}},\"2-2-1-37\":{\"p\":\"단위반복수(number of repetition units)는 목표 낱말을 정상적으로 말하기 전까지 반복 단위가 '추가로' 되풀이된 횟수이다. '자자자동차'는 '자-자-자동차'로, 마지막 '자'는 목표 낱말 '자동차'의 일부이므로 반복 단위는 2회이다. 같은 방식으로 '바바바나나' 2회, '토토토토끼'는 '토-토-토-토끼'로 3회, '기기기기차' 3회이다. 합계 2 + 2 + 3 + 3 = 10이고, 반복 사례 4개로 나누면 평균 10 ÷ 4 = 2.5이다. 검산: 각 사례의 '반복 음절 개수 − 1'을 구해도 (3−1)+(3−1)+(4−1)+(4−1) = 10으로 같다. 단위반복수가 많을수록(일반적으로 2회 이상) 정상 비유창성보다 말더듬을 더 시사하는 지표로 본다.\",\"w\":{\"2\":\"3은 '토토토토끼', '기기기기차'의 단위반복수로, 네 사례 중 최댓값이다. 평균이 아니라 가장 큰 값만 본 실수이다.\",\"3\":\"3.5는 목표 낱말에 포함된 마지막 음절까지 반복 단위로 세어(3, 3, 4, 4) 평균을 낸 값이다(14 ÷ 4). 목표 낱말의 첫 음절은 반복 단위에서 빼야 한다.\",\"4\":\"4는 낱말부분 반복이 나타난 사례 수이다. 평균 단위반복수가 아니라 나눗셈의 분모에 해당한다.\",\"5\":\"10은 네 사례의 단위반복수 합계로, 사례 수 4로 나누지 않은 값이다.\"}},\"2-2-1-38\":{\"p\":\"전체 말속도(overall speech rate)는 쉼과 비유창성을 모두 포함한 전체 발화 시간 동안 산출된 전체 음절 수로 구하며, 실제 대화에서 청자가 느끼는 말의 빠르기를 반영한다. 1분 30초 = 1.5분이므로 270음절 ÷ 1.5분 = 180음절/분이다. 검산: 90초 동안 270음절이면 초당 3음절이고, 3 × 60 = 180음절/분이다. 이와 구별해야 할 조음속도(articulation rate)는 일반적으로 250ms 이상의 쉼(과 교재에 따라 비유창 구간)을 뺀 순수 발화 시간으로 나누어 말 운동 자체의 빠르기를 본다. 문항은 '전체' 말속도를 물었으므로 쉼 18초를 빼지 않는 것이 핵심이다.\",\"w\":{\"1\":\"120음절/분은 주어진 수치를 바르게 적용한 어떤 공식에서도 나오지 않는 값으로, 발화 시간을 실제보다 길게 잡아(예: 2분 15초) 말속도를 과소 추정한 결과이다.\",\"2\":\"150음절/분은 이미 쉼이 포함된 발화 시간 90초에 쉼 18초를 한 번 더 더해 108초(1.8분)로 나눈 값이다(270 ÷ 1.8). 쉼을 이중으로 계산한 실수이다.\",\"4\":\"225음절/분은 쉼 18초를 뺀 72초(1.2분)로 나눈 값(270 ÷ 1.2)으로, 조음속도를 구하는 방식에 가깝다. 전체 말속도는 쉼을 빼지 않는다.\",\"5\":\"270음절/분은 발화 시간을 1분으로 잘못 보고 전체 음절 수를 그대로 쓴 값이다. 1분 30초는 1.5분으로 환산해야 한다.\"}},\"2-2-1-39\":{\"p\":\"그림의 유형별 비율을 지문의 분석 기준에 따라 두 묶음으로 나눈다. 비정상적 비유창성(AD) = 낱말부분 반복 35% + 막힘 20% + 연장 15% = 70%, 정상적 비유창성(ND) = 간투사 15% + 수정 10% + 구 반복 5% = 30%이다. 검산: 70 + 30 = 100%이다. 정상 발달 아동의 비유창성은 주로 간투사·수정·구 반복 같은 ND가 차지하는데, 이 아동은 비유창성의 대부분이 소리·음절 수준의 AD이므로 말더듬을 시사하는 분포로 해석한다. 다만 비율 그림만으로는 빈도(100음절당 횟수)와 긴장·부수행동을 알 수 없으므로, 실제 진단에서는 빈도·지속시간·부수행동 정보를 함께 확인해야 한다.\",\"w\":{\"1\":\"정상적 비유창성은 간투사 15% + 수정 10% + 구 반복 5% = 30%로 절반에 미치지 못한다. 절반을 넘는 것은 비정상적 비유창성(70%)이다.\",\"2\":\"비정상적 비유창성 중 가장 많은 유형은 낱말부분 반복(35%)이고, 막힘은 20%로 두 번째이다.\",\"3\":\"반복 유형은 낱말부분 반복 35% + 구 반복 5% = 40%로 전체의 절반을 넘지 않는다.\",\"5\":\"비운율적 발성은 연장 15% + 막힘 20% = 35%로 4분의 1(25%)을 넘는다.\"}},\"2-2-1-40\":{\"p\":\"SSI-4(Stuttering Severity Instrument-4, Riley)는 (1) 빈도(%SS), (2) 지속시간(가장 긴 말더듬 사건 3개의 평균), (3) 신체적 부수행동 점수를 합해 중증도를 산출한다. 신체적 부수행동은 산만한 소리(코로 내쉬는 소리·휘파람 소리 등), 얼굴 찡그림(입술 오므리기·눈 깜빡임 등), 머리 움직임(고개 돌리기·시선 피하기 등), 사지 움직임(팔·다리·몸통 움직임)의 4범주를 각각 0~5점으로 평정한다. 따라서 '머리 움직임'이 정답이다. 말의 자연스러움 평정이나 자기보고(CUSR) 같은 보조 항목이 있더라도 이는 신체적 부수행동 점수에 들어가지 않는다는 점을 구분해야 한다.\",\"w\":{\"1\":\"말속도의 변화는 SSI-4의 신체적 부수행동 4범주(산만한 소리, 얼굴 찡그림, 머리 움직임, 사지 움직임)에 포함되지 않는다. 말속도는 별도의 말속도 측정으로 평가한다.\",\"2\":\"회피한 낱말의 수는 말더듬에 대한 인지·정서적 반응(회피 행동)에 해당하며, 관찰로 평정하는 신체적 부수행동 범주가 아니다.\",\"3\":\"말더듬 예기 빈도는 대상자의 내적 경험으로 자기보고나 면담으로 파악한다. 관찰 가능한 신체 움직임을 평정하는 신체적 부수행동 범주에 속하지 않는다.\",\"4\":\"의사소통 태도는 CAT, S-24 같은 태도 검사로 평가하는 영역이다. SSI-4는 말더듬 행동의 중증도를 측정하며 태도를 신체적 부수행동으로 평정하지 않는다.\"}},\"2-2-1-41\":{\"p\":\"KiddyCAT(Communication Attitude Test for Preschool and Kindergarten Children Who Stutter, Vanryckeghem과 Brutten)은 일반적으로 3~6세 학령전 아동을 대상으로, 검사자가 짧은 질문을 읽어 주고 아동이 예/아니오로 답하게 하여 자기 말에 대한 태도(말이 어렵다고 느끼는지 등)를 평가한다. 지문의 단서는 '4세', '아동 자신의 태도', '짧은 질문에 예/아니오 응답' 세 가지이며 모두 KiddyCAT과 맞는다. 눈 깜빡임 같은 부수행동은 아동이 말더듬을 이미 의식하고 있을 가능성을 보여 주므로 태도 평가의 필요성을 뒷받침한다. 학령기 아동은 같은 계열의 CAT, 성인은 S-24·OASES-A 등으로 연령에 맞는 도구를 고른다.\",\"w\":{\"1\":\"OASES-A는 성인(일반적으로 18세 이상)용 자기보고 도구로, 말더듬이 일상생활과 삶의 질에 미치는 영향을 평가한다. 4세 아동에게는 맞지 않는다.\",\"2\":\"S-24는 성인의 의사소통 태도를 24개 참/거짓 문항으로 스스로 답하는 척도이다. 학령전 아동에게 적용하는 도구가 아니다.\",\"4\":\"말더듬 지각 검사(PSI)는 성인이 자신의 투쟁·회피·예기 행동을 스스로 표시하는 자기보고 도구이다. 4세 아동이 답하기에는 내용과 형식이 맞지 않는다.\",\"5\":\"SSI-4는 빈도·지속시간·신체적 부수행동으로 말더듬 행동의 중증도를 측정하는 관찰 검사이다. 아동의 태도는 평가하지 않는다.\"}},\"2-2-1-42\":{\"p\":\"말더듬은 같은 사람이라도 대화 상대, 장소, 과제(대화·읽기·전화 등), 의사소통 압박에 따라 빈도와 심한 정도가 크게 달라지는 상황 변동성(situational variability)이 특징이다. 치료실에서는 긴장하거나 반대로 편안해서 일상과 다른 모습이 나타날 수 있으므로, 치료실 대화와 독백(읽기가 가능한 연령이면 읽기), 가정 녹음 등 여러 상황의 표본을 모아야 실제 말더듬 정도를 대표할 수 있다. 표본 길이도 일반적으로 상황별로 수백 음절 이상을 확보해야 %SS가 안정적이다. 보호자 녹음 표본은 치료실에서 관찰하기 어려운 일상 말더듬을 보여 주어 평가와 치료 효과 확인에 모두 유용하다.\",\"w\":{\"2\":\"말더듬은 상황 변동이 커서 치료실 표본 하나만으로는 일상의 말더듬 정도를 대표하기 어렵다. 치료실에서 실제보다 적거나 많게 나타날 수 있다.\",\"3\":\"학령전 아동은 대부분 글을 읽지 못하므로 읽기 과제를 쓸 수 없다. 대화나 그림 설명 같은 자발화 표본으로 %SS를 산출한다.\",\"4\":\"50음절 이하의 짧은 표본은 우연한 변동의 영향을 크게 받아 %SS가 불안정하다. 정확한 평가를 위해서는 충분한 길이(일반적으로 수백 음절 이상)가 필요하다.\",\"5\":\"가정에서 보호자가 녹음한 표본은 일상 상황의 말더듬을 보여 주는 중요한 자료이다. 치료실 표본과 비교해 상황 변동을 파악하는 데에도 쓰인다.\"}},\"2-2-1-43\":{\"p\":\"OASES(Overall Assessment of the Speaker's Experience of Stuttering, Yaruss와 Quesal)는 말을 더듬는 당사자가 스스로 답하는 자기보고 도구로, 연령에 따라 학령기용(OASES-S), 청소년용(OASES-T), 성인용(OASES-A)이 있다. 일반 정보(말더듬에 대한 지식·인식), 말더듬에 대한 반응(정서·행동·인지), 일상 의사소통 상황의 어려움, 삶의 질의 네 영역으로 말더듬의 영향을 넓게 평가한다. 즉 '당사자의 경험'을 보는 도구이지, 학령전 아동의 비유창성 '빈도'를 부모가 관찰·기록하는 척도가 아니므로 ⑤가 옳지 않은 설명이다. 이처럼 평가도구 문항은 대상 연령, 응답자(당사자/부모/검사자), 측정 영역(행동/태도/영향) 세 가지를 확인하면 판단이 쉽다.\",\"w\":{\"1\":\"S-24(Erickson 의사소통 태도 척도 개정판)는 성인이 의사소통 태도를 24개 참/거짓 문항으로 스스로 답하는 검사로, 옳은 설명이다.\",\"2\":\"CAT(Communication Attitude Test, Brutten)는 학령기 아동이 자기 말에 대한 태도를 직접 답하는 자기보고 검사로, 옳은 설명이다.\",\"3\":\"P-FA-II(파라다이스 유창성 검사)는 비유창성을 정상적 비유창성과 비정상적 비유창성으로 나누어 분석하는 국내 검사로, 옳은 설명이다.\",\"4\":\"SSI-4는 빈도, 지속시간, 신체적 부수행동 점수를 합해 말더듬 중증도를 산출하므로 옳은 설명이다.\"}},\"2-2-1-44\":{\"p\":\"Guitar는 말더듬 발달을 정상적 비유창성 → 경계선급 → 초급 → 중급 → 고급 말더듬으로 나누며, 단계를 가르는 핵심은 핵심행동의 형태와 함께 '이차행동(탈출·회피)과 감정(두려움)'이다. 지문의 10세 아동은 막힘이 주된 핵심행동이고, 막힐 때 눈 깜빡임·고개 젖히기 같은 탈출행동을 보인다. 여기에 특정 낱말을 미리 두려워하며 다른 낱말로 바꾸고(낱말 대치·회피), 발표 상황을 피하는(상황 회피) 모습이 더해졌다. 막힘 + 탈출행동 + 예기·두려움 + 회피의 조합은 중급 말더듬의 특징이며, 일반적으로 학령기(대략 6~13세)에 많이 나타난다. 초급과 중급을 가르는 기준이 '두려움과 회피의 유무'라는 점이 가장 자주 출제되는 비교 포인트이다.\",\"w\":{\"1\":\"정상적 비유창성은 긴장 없는 반복·간투사·수정이 대부분이고 부수행동이나 두려움이 없다. 막힘과 탈출·회피 행동이 있는 지문 아동과 맞지 않는다.\",\"2\":\"경계선급 말더듬은 학령전기에 주로 나타나며 긴장 없는 반복·연장이 늘어나지만 막힘, 탈출행동, 회피는 거의 없다.\",\"3\":\"초급 말더듬은 긴장된 반복·막힘과 눈 깜빡임 같은 탈출행동은 있으나, 말더듬을 미리 두려워하거나 낱말·상황을 회피하는 행동은 아직 뚜렷하지 않다. 지문 아동은 예기·두려움과 회피가 분명하다.\",\"5\":\"고급 말더듬은 일반적으로 청소년 후기~성인에게서 나타나며, 오랜 기간 굳어진 막힘·회피 패턴과 강한 부정적 감정·자아개념이 특징이다. 10세 아동의 양상으로는 중급이 더 적절하다.\"}},\"2-2-1-45\":{\"p\":\"심인성 말더듬(psychogenic stuttering)은 신경학적 원인 없이 심리적 충격·스트레스 뒤에 성인기에 갑자기 시작되는 후천성 말더듬이다. 지문의 단서는 네 가지이다. (1) 35세 성인, 정서적 충격 직후 급성 발병 (2) 아동기 말더듬 병력 없음(발달성 배제) (3) 신경학적 이상 없음(신경인성 배제) (4) 첫 음절뿐 아니라 중간·끝 음절에서도 반복, 반복 읽기(적응효과)·함께 읽기(합창효과)로도 줄지 않음. 발달성 말더듬은 같은 글을 반복해 읽으면 말더듬이 줄어드는 적응효과와 합창 읽기 효과가 뚜렷한 것과 대비된다. 신경인성 말더듬도 위치가 다양하고 적응효과가 적어 비슷해 보이지만, 뇌졸중·외상성 뇌손상 등 신경학적 원인이 확인되어야 한다는 점으로 구분한다.\",\"w\":{\"1\":\"발달성 말더듬은 대개 2~5세 무렵 아동기에 시작하고, 주로 낱말 첫 음절에서 나타나며 적응효과·합창 읽기 효과가 뚜렷하다. 35세에 처음 시작했고 이런 효과가 없는 지문과 맞지 않는다.\",\"3\":\"신경인성 말더듬도 성인기에 갑자기 시작하고 위치가 다양하며 적응효과가 적지만, 뇌졸중·뇌손상·퇴행성 질환 같은 신경학적 원인이 있어야 한다. 지문에서는 신경학적 검사에 이상이 없다.\",\"4\":\"속화(cluttering)는 빠르고 불규칙한 말속도, 음절 생략·축약, 낮은 명료도가 중심이며 대개 발달 초기부터 나타나고 본인의 인식이 낮은 편이다. 정서적 충격 후 급성 발병한 반복과 관련이 없다.\",\"5\":\"말실행증은 말 운동 계획·프로그래밍의 장애로 비일관적 조음 오류, 모색 행동(groping), 운율 이상이 특징이며 대개 좌반구 손상 같은 신경학적 원인이 있다. 지문의 양상과 맞지 않는다.\"}},\"2-2-1-46\":{\"p\":\"낱말부분 반복에서 원래 모음 대신 중성모음(schwa, 한국어에서는 '으'와 비슷한 소리)이 나오는 것(예: '버스'를 '브브버스')을 모음 중성화라 하며, 정상적 비유창성과 말더듬을 구별하는 대표적 경고 신호이다. 정상 아동의 반복은 '버버스'처럼 원래 모음을 유지하고 긴장 없이 느긋하게 일어나는 반면, 말더듬 아동은 다음 소리로 넘어가는 이행이 어려워 모음이 약화된 채 빠르고 불규칙하게 반복하는 경향이 있다. 이 밖에 일반적으로 거론되는 경고 신호로는 단위반복수 증가(2회 이상), 반복 속도가 빠르거나 불규칙함, 연장·막힘의 출현, 긴장과 부수행동, 말에 대한 부정적 반응 등이 있다.\",\"w\":{\"1\":\"구 단위를 1회, 긴장 없이 반복하는 것은 낱말 이상 단위의 반복으로 정상적 비유창성에 해당한다. 말더듬의 경고 신호가 아니다.\",\"2\":\"'음', '어' 같은 간투사는 발화를 계획하는 동안 정상 화자에게도 흔히 나타나는 정상적 비유창성이다.\",\"4\":\"말하던 문장을 멈추고 다른 문장으로 고치는 것은 수정(revision)으로, 언어 발달 과정에서 흔한 정상적 비유창성이다.\",\"5\":\"피곤하거나 흥분했을 때 비유창성이 잠시 느는 것은 정상 아동에게도 나타나는 일시적 변동이다. 이것만으로 말더듬을 시사한다고 보기 어렵다.\"}},\"2-2-1-47\":{\"p\":\"학령전 아동의 말더듬은 상당수가 자연회복되므로 지속(비회복) 위험 요인을 파악해 치료 시작 시기를 정하는 것이 중요하다. ㄱ 남아는 여아보다 자연회복률이 낮아 지속 위험이 크다. ㄴ 가족 중 성인까지 말더듬이 지속된 사람이 있으면 지속 위험이 높고, 반대로 가족 중 회복한 사람이 있으면 회복 가능성이 높은 편이다. ㄷ 발병 후 시간이 지나도 비유창성이 줄지 않는 경과는 중요한 지속 신호로, 교재에 따라 6~12개월 이상 또는 12개월 이상을 기준으로 든다. 이 밖에 늦은 발병 연령, 동반된 말·언어 문제 등도 지속 요인으로 거론된다. 손잡이와 출생 순위는 말더듬 지속을 예측하는 요인으로 인정되지 않는다. 따라서 ㄱ, ㄴ, ㄷ이 정답이다.\",\"w\":{\"1\":\"ㄱ(남아)과 ㄴ(지속된 가족력)은 맞지만, 발병 후 오래 비유창성이 줄지 않는 경과(ㄷ)도 대표적인 지속 위험 요인이므로 빠져서는 안 된다.\",\"3\":\"ㄱ, ㄷ은 지속 위험 요인이지만 ㅁ 출생 순위(첫째)는 말더듬 지속을 예측하는 요인으로 인정되지 않는다. 또한 중요한 요인인 ㄴ 가족력이 빠져 있다.\",\"4\":\"ㄴ은 맞지만 ㄹ 왼손잡이와 ㅁ 출생 순위는 지속 위험 요인이 아니다. 손잡이를 말더듬과 연결하는 관점은 과거 대뇌 반구 우세 이론에서 비롯된 것으로 현재 지속 예측 요인으로 쓰지 않는다.\",\"5\":\"ㄱ, ㄴ, ㄷ은 맞지만 ㄹ 왼손잡이는 말더듬 지속을 예측하는 요인으로 인정되지 않으므로 포함하면 틀린다.\"}},\"2-2-1-48\":{\"p\":\"리드콤 프로그램(Lidcombe Program)은 부모가 아동의 말에 구어 수반 자극(verbal contingencies)을 주는 학령전 아동 대상 직접 행동치료이다. 수반 자극은 유창한 말 뒤에 주는 것(칭찬하기, 인정하기, 자기 평가 요청하기)과 분명한 말더듬 뒤에 주는 것(인정하기, 자기 수정 요청하기)으로 나뉜다. 지문에서 부모는 아동이 '나나나는'으로 더듬은 직후 '다시 한번 말해 볼래?'라고 요청했고, 아동이 유창하게 다시 말했다. 이는 더듬은 말 뒤에 아동이 스스로 고쳐 말하도록 하는 '자기 수정 요청하기'이다. 리드콤에서는 일반적으로 유창한 말에 대한 자극을 더듬은 말에 대한 자극보다 훨씬 많이 주도록 하며, 1단계는 %SS와 중증도 평정(SR)이 일정 기준 이하로 내려갈 때까지 진행한다.\",\"w\":{\"1\":\"유창한 말 칭찬하기는 아동이 유창하게 말한 뒤 '부드럽게 잘 말했네'처럼 칭찬하는 자극이다. 지문의 부모 반응은 더듬은 말 직후에 나왔다.\",\"2\":\"유창한 말 인정하기는 유창한 말 뒤에 '울퉁불퉁한 말이 없었어'처럼 유창했음을 알려 주는 자극이다. 더듬은 말 뒤에 다시 말하게 한 지문과 다르다.\",\"3\":\"자기 평가 요청하기는 유창하게 말한 뒤 '방금 부드럽게 말했니?'처럼 아동이 스스로 판단하게 하는 자극이다. 더듬은 말을 다시 말하게 하는 것이 아니다.\",\"4\":\"더듬은 말 인정하기는 '조금 울퉁불퉁했네'처럼 더듬었음을 중립적으로 알려 주는 데서 그친다. 지문처럼 다시 말해 보도록 요청하면 자기 수정 요청하기가 된다.\"}},\"2-2-1-49\":{\"p\":\"학령전 말더듬 아동의 부모 상담은 아동이 말할 때 느끼는 시간 압박과 의사소통 부담을 줄이고, 유창하게 말하기 쉬운 환경을 만드는 데 초점을 둔다. 아동이 더듬을 때마다 '천천히 말해', '숨 쉬고 다시 해' 같은 지시를 하면, 부모의 의도와 달리 아동은 자기 말이 잘못되었다는 신호로 받아들여 말을 의식하고 긴장·회피하게 될 수 있다(진단착오 이론에서 강조한 부모 반응의 영향과도 연결된다). 대신 부모가 직접 느리고 여유 있는 말을 들려주는 모델링, 끝까지 기다리기, 말의 내용에 반응하기, 일대일 대화 시간 확보, 말할 차례 보장 같은 간접적 환경 조정을 권한다. 리드콤처럼 치료사의 훈련 아래 정해진 방식으로 수반 자극을 주는 것과 부모가 임의로 매번 지적하는 것은 다르다는 점도 구분해야 한다.\",\"w\":{\"1\":\"아이가 더듬어도 끝까지 기다리며 말의 내용에 반응하는 것은 시간 압박과 의사소통 부담을 줄이는 적절한 상담 내용이다.\",\"2\":\"부모가 조금 느리고 여유 있게 말하는 것은 아동에게 느린 말 모델을 제공하고 대화 속도의 압박을 줄이는 적절한 전략이다.\",\"3\":\"하루 중 일대일 대화 시간을 정해 두는 것은 아동이 방해 없이 편안하게 말할 기회를 늘리는 적절한 상담 내용으로, 팔린 PCI의 '특별한 시간'과도 같은 취지이다.\",\"5\":\"가족 대화에서 아이가 말할 차례를 충분히 갖게 하는 것은 말 끊기·경쟁적 말하기로 인한 압박을 줄이는 적절한 전략이다.\"}},\"2-2-1-50\":{\"p\":\"팔린 PCI(Palin Parent-Child Interaction) 치료는 영국 Michael Palin 센터에서 개발한 학령전 말더듬 아동 대상 접근으로, 부모-아동 상호작용을 바꾸어 아동의 유창성을 돕는 간접 중심 치료에서 출발한다(필요하면 직접 전략을 더한다). 핵심 절차는 (1) 부모-아동 놀이를 녹화하고, (2) 치료사와 부모가 영상을 함께 보며 부모가 이미 잘하고 있는 도움 되는 상호작용(말속도 늦추기, 아동 주도 따르기, 쉼 주기 등)을 스스로 찾아 목표로 고르고, (3) 가정에서 일반적으로 주 3~5회, 5분 정도의 '특별한 시간'에 연습하는 것이다. 지문의 영상 피드백, 부모의 전략 선택, 짧은 '특별한 시간'이 모두 팔린 PCI의 특징과 일치한다.\",\"w\":{\"2\":\"리드콤 프로그램은 부모가 아동의 유창한 말과 더듬은 말에 칭찬·인정·자기 수정 요청 같은 구어 수반 자극을 주는 직접 행동치료이다. 상호작용 전략을 영상으로 찾는 지문 절차와 다르다.\",\"3\":\"캠퍼다운 프로그램은 청소년·성인을 대상으로 연장 발화(prolonged speech) 모델을 익혀 유창성을 형성하는 프로그램이다. 4세 아동과 부모의 상호작용 중재가 아니다.\",\"4\":\"말더듬 수정법(Van Riper 등)은 주로 학령기 이상 대상자가 말더듬 순간을 확인하고 두려움을 줄이며 더 쉽게 더듬도록 수정하는 직접치료이다. 부모-아동 상호작용 영상을 활용하는 접근이 아니다.\",\"5\":\"지연청각피드백 훈련은 자기 목소리를 약간 늦게 들려주어 말속도를 늦추고 유창성을 높이는 기기 활용 방법으로, 주로 청소년·성인에게 쓰인다. 지문의 부모 중심 상호작용 접근과 관련이 없다.\"}},\"2-2-1-51\":{\"p\":\"이 아동은 지속 위험 신호가 여럿 겹친다. 발병 후 1년 6개월이 지났고, 핵심행동으로 막힘이 잦으며, 발 구르기 같은 신체적 부수행동과 '나는 말을 못 해'라는 부정적 인식·좌절이 나타난다. 게다가 3개월간의 부모 상담 중심 간접치료에도 변화가 없었다. 이처럼 간접치료에 반응하지 않고 말더듬이 진행된 학령전 아동은 아동의 말 자체를 다루는 직접치료로 넘어가는 것이 일반적이다. 학령전 아동의 직접치료는 놀이 맥락에서 치료사가 느리고 쉬운 말(easy speech)을 모델링하고 아동이 따라 하며 점차 길고 복잡한 발화로 넓혀 가는 방식처럼, 발달 수준에 맞고 부담이 적은 형태로 진행한다. 부정적 인식이 이미 있으므로 말더듬을 처벌하거나 숨기는 방식이 아니라 성공 경험을 쌓는 방식이어야 한다.\",\"w\":{\"1\":\"간접치료 3개월에도 변화가 없고 막힘·부수행동·부정적 인식까지 있으므로, 부모 상담만 이어 가는 것은 부족하다. 아동이 이미 자기 말더듬을 의식하고 있어 말더듬을 언급하지 않는 방식도 맞지 않는다.\",\"2\":\"발병 후 1년 6개월이 지났고 지속 위험 신호가 뚜렷하므로 자연회복을 기대하며 기다리기에는 늦다. 관찰 후 재평가는 발병 초기이고 위험 요인이 적은 아동에게 고려하는 방법이다.\",\"4\":\"더듬을 때마다 멈추고 처음부터 다시 말하게 하는 것은 처벌적 반응이 되어 말에 대한 두려움과 회피를 키울 수 있다. 이미 좌절과 부정적 인식을 보이는 아동에게 특히 부적절하다.\",\"5\":\"회피 상황 위계를 만들어 직면하게 하는 것은 성인 말더듬 수정법의 둔감화에 가까운 방법으로, 5세 아동의 인지·정서 발달 수준에 맞지 않는다.\"}},\"2-2-1-52\":{\"p\":\"가벼운 조음 접촉(light articulatory contact)은 유창성 형성법의 대표 기법으로, 입술·혀·연구개 같은 조음기관이 서로 닿을 때 압력을 줄여 살짝만 닿게 하는 방법이다. 말더듬 화자는 파열음(/ㅂ, ㄷ, ㄱ/ 등)처럼 조음기관이 완전히 막히는 소리에서 접촉을 과도하게 세게 해 막힘이 생기기 쉽다. 지문의 단서는 '/ㅂ/, /ㄷ/로 시작하는 낱말', '입술과 혀를 세게 붙이며 막힘', '살짝 닿을 정도로 힘을 빼고 부드럽게 조음'이다. 비슷한 기법인 부드러운 발성 시작은 성대(후두) 수준의 긴장을 다루고, 가벼운 조음 접촉은 성도 위쪽의 조음기관 수준을 다룬다는 점으로 구분한다.\",\"w\":{\"1\":\"부드러운 발성 시작(easy onset, gentle onset)은 모음 등으로 시작하는 낱말에서 숨을 약간 내쉬며 성대 진동을 서서히 시작하게 하는 후두 수준의 기법이다. 입술·혀의 접촉 압력을 줄이는 지문과 다르다.\",\"3\":\"연장 발화(prolonged speech)는 음절, 특히 모음을 늘여 말속도를 크게 낮추는 기법이다. 조음기관의 접촉 강도를 조절하는 것이 핵심이 아니다.\",\"4\":\"취소(cancellation)는 말더듬 수정법의 기법으로, 더듬은 낱말을 끝까지 말한 뒤 잠시 멈추고 같은 낱말을 더 쉽게 더듬는 방식으로 다시 말하는 것이다. 유창성 형성법의 조음 기법이 아니다.\",\"5\":\"빠져나오기(pull-out)는 말더듬 수정법의 기법으로, 막힘이 일어나는 도중에 긴장을 풀며 천천히 빠져나와 낱말을 마무리하는 것이다. 미리 접촉 압력을 줄여 말하게 하는 지문과 다르다.\"}},\"2-2-1-53\":{\"p\":\"유창성 형성법(fluency shaping)은 일반적으로 확립(establishment) → 전이(transfer, 일반화) → 유지(maintenance)의 단계로 진행한다. 확립 단계에서는 치료실에서 연장 발화 같은 목표 말하기 방식을 익혀 낭독·대화에서 유창성을 만든다. 전이 단계에서는 그 유창성을 치료실 밖 실제 생활로 넓히며, 쉬운 상황에서 어려운 상황으로 위계를 세워 연습한다. 지문은 '치료실에서는 거의 유창'(확립 완료)한 고등학생이 '이번 회기부터 매점 주문 → 교사에게 질문 → 전화 문의'처럼 실제 상황 과제를 난이도 순으로 연습하기 시작했으므로 전이 단계에 해당한다. 전화하기는 일반적으로 말더듬 화자에게 부담이 큰 상황이어서 위계의 뒤쪽에 놓인다.\",\"w\":{\"1\":\"확인(identification) 단계는 Van Riper 말더듬 수정법의 단계로, 자신의 핵심행동·이차행동·감정을 찾아 인식하는 단계이다. 유창성 형성법의 단계가 아니다.\",\"2\":\"확립 단계는 치료실에서 목표 말하기 방식(연장 발화 등)을 처음 익혀 유창한 말을 만드는 단계이다. 지문 학생은 이미 치료실에서 거의 유창하며 실제 상황으로 넓히는 중이다.\",\"3\":\"둔감(desensitization) 단계는 말더듬 수정법의 단계로, 자발적 말더듬 등으로 말더듬과 청자 반응에 대한 두려움을 줄이는 단계이다. 유창성 형성법의 단계가 아니다.\",\"4\":\"유지 단계는 치료를 마무리하거나 회기 간격을 늘리면서 대상자가 스스로 유창성을 점검·관리해 재발을 막는 단계이다. 실제 상황 과제를 처음 시작한 지문은 그 전 단계인 전이에 해당한다.\"}},\"2-2-1-54\":{\"p\":\"지문의 활동은 자발적 말더듬(voluntary stuttering, 의도적 말더듬)으로, 대상자가 일부러 느슨하고 쉬운 반복으로 더듬으며 실제 청자의 반응을 관찰하고 그때의 감정을 치료사와 이야기하는 것이다. Van Riper의 말더듬 수정법(MIDVAS: 동기 → 확인 → 둔감 → 변형 → 접근 → 안정)에서 둔감(desensitization) 단계의 대표 활동이다. 스스로 말더듬을 통제된 방식으로 드러내 보면 청자 반응이 생각보다 부정적이지 않다는 것을 경험하게 되고, 말더듬 순간에 대한 두려움·수치심과 청자 반응에 대한 민감도가 줄어든다. 두려움이 줄어야 이후 말더듬을 더 쉽게 수정하는 단계(취소·빠져나오기·준비하기)로 나아갈 수 있다는 점이 이 단계의 의미이다.\",\"w\":{\"2\":\"말속도를 늦춰 유창한 말을 확립하는 것은 유창성 형성법의 확립 단계 목표이다. 지문은 유창하게 말하는 연습이 아니라 일부러 더듬는 활동이다.\",\"3\":\"막힘 순간에서 빠져나오는 법(빠져나오기)은 말더듬 수정법의 접근(수정) 단계에서 익히는 기법이다. 지문의 활동은 청자 반응을 관찰하며 두려움을 줄이는 둔감 활동이다.\",\"4\":\"호흡과 발성의 협응 향상은 유창성 형성법의 호흡 조절·부드러운 발성 시작 같은 기법의 목표이다. 행인에게 일부러 더듬는 활동과 관련이 없다.\",\"5\":\"핵심행동의 빈도를 정확히 측정하는 것은 평가 활동이다. 일부러 더듬은 말은 실제 말더듬 빈도를 측정하는 자료가 되지 않는다.\"}},\"2-2-1-55\":{\"p\":\"말더듬 성인은 치료 후 재발(relapse)이 흔하므로 유지 단계에서는 치료사 의존을 줄이고 대상자의 자기 관리 능력을 키우는 것이 핵심이다. 회기 간격을 주 1회 → 격주 → 월 1회처럼 점차 늘리면서(fading), 대상자가 스스로 말을 녹음해 점검하고, 기법을 매일 연습하며, 말더듬이 다시 늘 때 대처하는 계획을 세우게 한다. 또한 일시적인 말더듬 증가를 실패가 아닌 자연스러운 변동으로 받아들이도록 안내하고, 남아 있는 부정적 감정·태도와 회피를 함께 다루어야 재발 위험이 줄어든다. 이처럼 '점진적 종결 + 자기 점검 + 태도 관리'를 묶어 기억하면 비슷한 보기를 가려내기 쉽다.\",\"w\":{\"1\":\"유창해지자마자 곧바로 종결하고 추후 점검을 하지 않으면 재발을 조기에 발견하고 대처할 수 없다. 유지 단계는 회기 간격을 점차 늘리며 점검하는 과정이다.\",\"2\":\"다시 더듬는 순간을 치료 실패로 안내하면 좌절감과 말더듬에 대한 두려움·회피가 커져 오히려 재발을 부추긴다. 일시적 증가는 예상 가능한 변동으로 받아들이고 대처하도록 안내해야 한다.\",\"3\":\"치료실 안의 유창성만 다루고 일상 과제를 줄이면 일상 상황으로의 일반화가 약해져 재발 위험이 높아진다. 유지 단계일수록 실제 생활 속 자기 연습이 중요하다.\",\"5\":\"기법 연습만 반복하고 부정적 감정과 태도를 다루지 않으면, 남아 있는 두려움과 회피가 재발의 원인이 될 수 있다. 감정·태도 관리도 유지 전략에 포함해야 한다.\"}},\"2-2-1-56\":{\"p\":\"안정 호흡은 흡기와 호기의 시간 비율이 대략 40:60 정도로 호기가 조금 더 길 뿐이지만, 말 호흡에서는 발화 사이에 입으로 짧고 빠르게 들이마신 뒤 말하는 동안 길게 내쉬므로 흡기 대 호기 비율이 일반적으로 10:90 정도까지 벌어진다(수치는 교재에 따라 조금씩 다르다). 말을 이어 가려면 호기를 오래 끌어야 하므로 흡기는 짧아지고 호기는 길어진다. 이와 함께 말 호흡은 입 호흡이 주가 되고, 호기근을 능동적으로 써서 성문하압을 일정하게 유지하며, 더 큰 폐용적 범위를 사용한다는 점까지 묶어서 기억해 두면 다른 보기도 함께 판별할 수 있다.\",\"w\":{\"1\":\"흡기·호기 시간 비율이 비슷한 쪽은 오히려 안정 호흡에 가깝다. 말 호흡에서는 호기가 흡기보다 훨씬 길어져 비율 차이가 크게 벌어진다.\",\"2\":\"코로 천천히 숨을 들이마시는 것은 안정 호흡의 특징이다. 말 호흡에서는 발화가 끊기는 시간을 줄이기 위해 입으로 빠르게 들이마신다.\",\"4\":\"근육 활동 없이 폐·흉곽의 탄성 복원력만으로 내쉬는 수동적 호기는 안정 호흡의 특징이다. 말 호흡에서는 내늑간근·복근 등 호기근이 능동적으로 작용해 호기를 조절한다.\",\"5\":\"말 호흡은 안정 호흡(일회호흡량 범위)보다 더 많이 들이마시고 더 깊이 내쉬므로 더 넓은 폐용적 범위를 사용한다. 큰 소리나 긴 발화일수록 사용 범위는 더 넓어진다.\"}},\"2-2-1-57\":{\"p\":\"펄스 성구(pulse register, 보컬 프라이 vocal fry)는 음도 범위의 가장 아래쪽에 있는 성구로, 성대가 짧고 두껍게 이완된 상태에서 한 주기 중 닫혀 있는 시간(폐쇄기)이 매우 길고 성문하압과 호기류율이 낮다. 그 결과 개별 성문 펄스가 하나하나 들리는 듯한 '드르륵' 끓는 소리가 나며, 말끝에서 음도가 떨어질 때 정상 화자에게도 흔히 나타난다. 지문의 단서는 '매우 낮은 음도', '짧고 두꺼운 이완된 성대', '긴 폐쇄기', '낮은 기류'이다. 반대 극단인 가성 성구는 성대가 길고 얇게 늘어나고 폐쇄기가 짧거나 없다는 점을 대비해 두면 좋다.\",\"w\":{\"1\":\"가성 성구(falsetto)는 성대가 길고 얇게 늘어난 상태에서 가장자리만 진동하는 높은 음도 영역의 성구이다. 폐쇄기가 짧거나 불완전해 지문의 낮은 음도·긴 폐쇄기와 정반대이다.\",\"2\":\"모달(중간) 성구는 일상 대화에서 주로 쓰는 중간 음도 영역의 성구이다. 성대가 정상적인 두께로 규칙적으로 진동하며 '끓는 듯한' 음질이 나타나지 않는다.\",\"3\":\"휘파람 성구(whistle register)는 가성보다도 높은 최고음 영역으로, 성대 일부만 아주 작게 진동하거나 성문 틈으로 휘파람 같은 소리가 난다. 매우 낮은 음도라는 지문 내용과 맞지 않는다.\",\"5\":\"속삭임 발성은 성대가 진동하지 않고 성문 틈(주로 연골부)으로 공기를 내보내 내는 무성 발성이다. 지문처럼 성대가 닫혀 있는 시간이 긴 진동이 있을 수 없다.\"}},\"2-2-1-58\":{\"p\":\"포먼트는 성도(여과기)의 공명 주파수로, 일반적으로 F1은 혀의 높이·입 벌림 정도와 관련되어 고모음(입을 적게 벌림)일수록 낮고 저모음일수록 높다. F2는 혀의 전후 위치와 관련되어 전설모음일수록 높고 후설모음일수록 낮으며, 원순성이 더해지면 더 낮아진다. /i/는 고모음이면서 전설모음이므로 저모음 /a/에 비해 F1은 낮고 F2는 높다. 모음 사각도에서 /i/는 'F1 최저·F2 최고' 꼭짓점, /a/는 'F1 최고' 꼭짓점, /u/는 'F1·F2 모두 낮음' 꼭짓점이라고 정리해 두면 비교 문항을 빠르게 풀 수 있다.\",\"w\":{\"1\":\"F1이 높고 F2가 상대적으로 낮은 것은 저모음 /a/의 특징이다. /i/와 /a/의 관계를 거꾸로 적은 보기이다.\",\"3\":\"/i/는 고모음이라 F1이 낮으므로 F1과 F2가 모두 높을 수 없다. F2만 높다.\",\"4\":\"F1과 F2가 모두 낮은 것은 고·후설·원순모음 /u/의 특징이다. /i/는 전설모음이라 F2가 높다.\",\"5\":\"F0는 성대 진동(음원)으로 결정되고 포먼트는 성도 모양(여과기)으로 결정되는 서로 독립적인 값이다. 모음이 다르면 성도 모양이 달라 포먼트가 달라지므로 F1·F2가 같다는 것은 틀리다.\"}},\"2-2-1-59\":{\"p\":\"기본주파수(F0)는 1초 동안 반복되는 주기 수이며, 한 주기의 길이(T)의 역수(F0 = 1/T)이다. 50 ms 동안 10주기가 반복되므로 한 주기는 50 ÷ 10 = 5 ms = 0.005초이고, F0 = 1 ÷ 0.005 = 200 Hz이다. 검산하면 200 Hz는 1초에 200주기이므로 50 ms(0.05초)에는 200 × 0.05 = 10주기가 들어가 지문과 일치한다. 성인 말 기본주파수는 일반적으로 남성 약 100~150 Hz, 여성 약 180~250 Hz 정도로 소개되므로(교재에 따라 범위가 조금 다름) 200 Hz는 성인 여성 범위에 해당한다.\",\"w\":{\"1\":\"20 Hz는 50 ms(0.05초) 전체를 한 주기로 보고 1 ÷ 0.05로 계산할 때 나오는 값이다. 50 ms 안에 10주기가 있다는 조건을 빠뜨린 실수이다.\",\"2\":\"100 Hz는 한 주기를 10 ms로 잘못 잡았을 때(예: 50 ms를 5로 나눔) 나오는 값이다. 실제 한 주기는 5 ms이므로 200 Hz이다.\",\"3\":\"200 Hz라는 계산은 맞지만, 성인 남성의 일반적인 말 기본주파수(대략 100~150 Hz)보다 높아 남성 범위라는 해석이 틀리다.\",\"5\":\"500 Hz는 한 주기가 2 ms일 때의 값으로, 주기 계산이나 ms·초 단위 환산을 잘못했을 때 나오는 값이다. 지문 조건으로는 200 Hz이다.\"}},\"2-2-1-60\":{\"p\":\"사춘기에 남성은 테스토스테론의 영향으로 갑상연골이 특히 앞뒤 방향으로 크게 자라고, 그에 따라 갑상연골 안쪽에서 피열연골까지 이어지는 성대가 길어지고 질량(두께)이 늘어난다. 진동체의 길이와 질량이 커지면 진동 속도가 느려지므로 기본주파수가 대략 한 옥타브(약 절반) 낮아진다. 이 과정에서 갑상연골 좌우 판의 각도가 좁아져 후두 융기(울대뼈)가 앞으로 튀어나오고, 후두 위치는 성장과 함께 아래로 내려간다. 여성도 변성이 있지만 음도 하강 폭이 일반적으로 3~4반음 정도로 훨씬 작다는 점과 비교해 두면 좋다.\",\"w\":{\"2\":\"후두는 출생 후 성장하면서 목에서 점차 아래로 내려가며, 사춘기에도 하강이 이어진다. 더 높게 올라간다는 것은 발달 방향과 반대이다.\",\"3\":\"남성은 사춘기에 갑상연골 판 사이 각도가 좁아져(대략 90° 안팎) 앞으로 돌출한다. 각도가 커져 둥글어지는 것은 상대적으로 여성 후두의 모양에 가깝다.\",\"4\":\"성장할수록 성대 전체 길이 중 막양부(진동하는 부분)의 비율이 커진다. 연골부가 상대적으로 큰 것은 영유아 후두의 특징이다.\",\"5\":\"사춘기 남성의 음도 하강은 성대 길이와 질량 증가가 핵심 원인이다. 성대 길이가 그대로라는 전제가 틀리다.\"}},\"2-2-1-61\":{\"p\":\"성대폴립은 일반적으로 한 번의 심한 음성 남용(고함 등)으로 성대 점막 아래 모세혈관이 터지거나 부종이 생겨 형성되며, 주로 편측성이고 붉은(혈관성) 또는 반투명한 둥근 혹으로 보인다. 줄기(경)에 매달린 유경성(pedunculated)이거나 넓게 붙은 광기저성(sessile) 형태가 있다. 지문의 판단 단서는 ① 응원 중 크게 소리친 뒤 '다음 날부터 갑자기' 생긴 급성 발병, ② 한쪽 성대만 이상, ③ 앞 1/3과 중간 1/3 경계(진동 충격이 가장 큰 부위)의 붉고 유경성인 혹이다. 같은 부위에 생기더라도 결절은 만성·반복 남용, 양측 대칭이라는 점이 감별 포인트이다.\",\"w\":{\"1\":\"성대결절은 오랜 기간 반복된 음성 남용으로 양측 성대의 앞 1/3과 중간 1/3 경계에 대칭적으로 생기는 굳은살 같은 병변이다. 급성 발병, 편측, 붉은 유경성 혹이라는 지문과 맞지 않는다.\",\"3\":\"성대낭종은 점막 아래에 막으로 싸인 주머니(점액·각질 등)가 생긴 병변으로, 주로 편측이지만 서서히 진행하며 점막 아래 둥근 덩어리로 보인다. 하루 만에 생긴 붉은 유경성 혹과는 거리가 멀다.\",\"4\":\"라인케부종은 흡연 등과 관련해 양측 성대 막양부 전체의 라인케 공간에 액체가 고여 부풀어 오른 상태이며, 음도가 낮아지는 것이 특징이다. 한쪽 성대의 국소적 혹과는 다르다.\",\"5\":\"성대구증은 성대 자유연을 따라 길게 파인 고랑(sulcus)으로, 성문 폐쇄부전과 기식성 음성을 일으킨다. 튀어나온 혹이 아니라 오목하게 들어간 구조적 이상이다.\"}},\"2-2-1-62\":{\"p\":\"접촉성 육아종(접촉성 궤양, contact granuloma/ulcer)은 성대 뒤쪽 연골부, 즉 피열연골 성대돌기 부위에 궤양이나 육아 조직이 생기는 병변이다. 낮은 음도로 힘주어 말하기, 잦은 헛기침처럼 좌우 성대돌기가 세게 부딪치는 습관, 위식도(후두인두) 역류로 인한 점막 자극, 기관 삽관에 의한 손상이 대표 원인이다. 지문의 단서는 '병변 위치가 성대 뒤쪽 성대돌기'라는 점과 '헛기침·힘준 저음 발성+위산 역류'라는 원인 조합이다. 치료는 역류 관리, 헛기침 줄이기, 음도·강도 조절 등 음성치료를 함께 하는 경우가 많다.\",\"w\":{\"1\":\"성대결절은 진동 충격이 가장 큰 막양부 앞 1/3과 중간 1/3 경계에 양측성으로 생긴다. 성대 뒤쪽 성대돌기 부위의 궤양성 병변과는 위치가 다르다.\",\"2\":\"재발성 후두유두종은 인유두종바이러스(HPV)와 관련된 사마귀 모양의 다발성 양성 종양으로, 소아에게도 흔하고 제거해도 자주 재발한다. 음성 습관이나 역류로 성대돌기에 생기는 단일 궤양성 혹과는 다르다.\",\"3\":\"성대구증은 성대 자유연을 따라 생긴 고랑 모양의 구조적 이상이다. 혹이나 궤양을 형성하지 않으며 위치도 막양부 가장자리이다.\",\"4\":\"후두백반증은 흡연 등으로 성대 점막에 흰 판 모양의 각화 병변이 생기는 것으로, 전암성 병변일 수 있어 추적이 필요하다. 성대돌기의 궤양을 동반한 혹이라는 소견과 맞지 않는다.\"}},\"2-2-1-63\":{\"p\":\"윤상갑상근은 윤상연골과 갑상연골 사이를 앞쪽에서 좁혀 성대를 앞뒤로 늘이고 긴장시켜 음도를 높이는 근육이며, 미주신경의 가지인 상후두신경 외지(external branch)의 지배를 받는다. 나머지 내후두근(갑상피열근, 후윤상피열근, 외측윤상피열근, 피열간근)은 되돌이후두신경이 지배한다. 지문에서 양측 성대의 내전·외전 운동은 유지되고 심한 기식음·사레가 없다는 것은 되돌이후두신경 기능이 보존되었다는 뜻이고, 고음 산출 곤란과 음도 범위 축소만 있다는 것은 윤상갑상근 약화를 가리킨다. 갑상선 수술은 상후두신경 외지와 되돌이후두신경 모두에 손상 위험이 있으므로 증상으로 둘을 구별하는 것이 핵심이다.\",\"w\":{\"2\":\"상후두신경 내지(internal branch)는 성문 상부 후두 점막의 감각을 담당하는 감각 신경이며, 근육을 지배하지 않는다. 윤상갑상근은 외지가 지배한다.\",\"3\":\"갑상피열근은 되돌이후두신경이 지배하는 성대 본체 근육이다. 되돌이후두신경이 손상되면 성대 운동 장애로 기식음·사레가 두드러지므로, 내전·외전이 정상이고 고음만 어려운 지문과 맞지 않는다.\",\"4\":\"후윤상피열근은 성대를 벌리는 유일한 외전근으로 되돌이후두신경이 지배한다. 이 근육이 마비되면 성대 외전이 안 되어 호흡 문제가 생길 수 있으나, 지문에서는 외전이 관찰된다.\",\"5\":\"외측윤상피열근은 성대를 모으는 내전근으로 상후두신경이 아니라 되돌이후두신경의 지배를 받는다. 신경과 근육의 연결이 틀렸다.\"}},\"2-2-1-64\":{\"p\":\"본태성 음성떨림(essential voice tremor)은 본태성 떨림이 후두와 발성 관련 구조에 나타난 것으로, 대략 4~7 Hz 정도의 규칙적이고 율동적인 음도·강도 흔들림이 특징이다(수치는 교재에 따라 다름). 떨림은 모음 연장처럼 발성을 일정하게 유지하려 할 때 가장 잘 드러나고, 후두뿐 아니라 인두벽·연구개·턱·머리 등이 함께 율동적으로 움직이는 경우가 많다. 지문의 단서는 ① 수년에 걸친 서서히 진행, ② 모음 연장 시 일정한 리듬의 흔들림, ③ 동작 시 손 떨림, ④ 가족력, ⑤ 후두·인두벽의 율동적 움직임이다. 경련성 발성장애와 함께 나타나는 경우도 있어 '규칙적 리듬인가, 불규칙한 끊김인가'로 구별하는 것이 핵심이다.\",\"w\":{\"1\":\"내전형 경련성 발성장애는 국소 근긴장이상증으로 발성 중 성대가 불규칙하게 과내전되어 쥐어짜는 듯한 음성과 음성 끊김이 나타나며, 연결 발화에서 두드러진다. 일정한 리듬의 떨림, 손 떨림, 가족력과는 맞지 않는다.\",\"2\":\"근긴장성 발성장애는 구조·신경 이상 없이 후두 주변 근육의 과도한 긴장으로 생기는 기능적 음성장애로, 쥐어짜거나 거친 음성이 주된 특징이다. 율동적 떨림이나 손 떨림·가족력으로 설명되지 않는다.\",\"3\":\"노인성 음성(성대 휨, presbylaryngis)은 노화로 성대 근육이 위축되어 성대가 활 모양으로 휘고 성문 틈이 생기는 것으로, 기식성·약한 음성이 주된 특징이다. 규칙적인 떨림이나 후두·인두벽의 율동적 움직임과는 다르다.\",\"4\":\"기능적 실성증은 심리적 요인 등으로 기질적 이상 없이 속삭이는 듯한 무성 발성만 나오는 상태이다. 성대 진동은 있되 리듬 있게 흔들리는 지문의 양상과 다르다.\"}},\"2-2-1-65\":{\"p\":\"음성장애는 일반적으로 원인에 따라 기질적(구조적) 음성장애, 신경학적 음성장애, 기능적 음성장애(심인성 포함)로 나눈다(분류 체계와 용어는 교재에 따라 조금씩 다름). 근긴장성 발성장애(muscle tension dysphonia)는 후두 구조와 신경에 이상이 없는데 후두 내·외근의 과도하거나 불균형한 긴장으로 음성 문제가 생기는 것이므로 기능적 음성장애에 속한다. 분류 문항에서는 '원인이 구조(조직 변화)인가, 신경(운동 조절)인가, 사용 방식·심리인가'를 먼저 따지면 된다. 다만 근긴장성 발성장애가 오래 지속되면 결절 같은 2차적 조직 변화로 이어질 수 있다는 점도 함께 알아 두면 좋다.\",\"w\":{\"1\":\"성대마비는 되돌이후두신경 등 후두 신경 손상으로 성대 운동이 제한되는 신경학적 음성장애이다. 신경 손상이 원인이므로 기능적 음성장애가 아니다.\",\"2\":\"후두유두종은 인유두종바이러스(HPV)와 관련되어 후두 점막에 사마귀 모양 종양이 생기는 기질적(구조적) 음성장애이다. 신경계 이상과는 관련이 없다.\",\"4\":\"성대구증은 성대 점막에 고랑이 생긴 구조적 이상이므로 기질적 음성장애이다. 심리적 원인과는 관계가 없다.\",\"5\":\"전환장애성 실성증은 심리적 갈등이 신체 증상(실성)으로 나타나는 것으로 심인성(기능적) 음성장애이다. 신경계 손상이 없으므로 신경학적 음성장애가 아니다.\"}},\"2-2-1-66\":{\"p\":\"전기성문파형(EGG)은 목 양쪽에 붙인 전극 사이의 전기 저항 변화로 성대 접촉 면적의 변화를 기록하며, 일반적으로 파형이 위로 갈수록 접촉 면적이 크다. 한 주기 중 성대가 접촉해 있는 구간의 비율을 접촉률(CQ, contact quotient)이라 하고, CQ가 크면 성대를 세게·오래 붙이는 압축된(과기능적) 발성, 작으면 접촉이 짧은 기식성(저기능적) 발성 쪽으로 해석한다. 해설에 제시된 그림 값을 보면 CQ는 (가) 약 0.5, (나) 약 0.7, (다) 약 0.25~0.3이다. 세 파형의 주기가 같으므로 CQ를 바로 비교할 수 있고, 가장 큰 (나)가 폐쇄 구간이 길어 과기능적 발성에 가깝다.\",\"w\":{\"1\":\"EGG는 성대 접촉 면적이 커질수록 파형이 위로 올라가도록 표시한다. 위로 갈수록 접촉 면적이 줄어든다는 것은 반대로 해석한 것이다.\",\"2\":\"(나)는 접촉률이 약 0.7로 (가)(약 0.5)보다 높다. 접촉률이 높으면 압축·과기능적 발성 쪽이며 기식성 발성과는 반대이다.\",\"3\":\"(다)는 접촉률이 약 0.25~0.3으로 (가)보다 낮다. 접촉 구간이 짧고 진폭이 작아 압축된 발성이 아니라 기식성 발성에 가깝다.\",\"5\":\"(다)는 접촉 구간이 짧고 개방 구간이 길어 한 주기 중 성문이 열려 있는 시간이 더 길다. 개방 구간이 짧아 대부분 닫혀 있다는 설명은 (나)에 가까운 내용이다.\"}},\"2-2-1-67\":{\"p\":\"성문하압은 기관 내 압력이라 직접 재려면 침습적 측정이 필요하므로, 임상에서는 /pi/ 반복 발화의 /p/ 폐쇄 구간 구강내압 최고치로 간접 추정한다. 무성 양순 파열음 /p/의 폐쇄 구간에는 입술이 닫혀 있고, 연인두도 닫혀 비강으로 압력이 빠지지 않으며, 무성음이므로 성문은 열려 있다. 따라서 폐-기관-성문-구강이 하나로 이어진 닫힌 공간이 되고, 공기 흐름이 거의 멈춘 상태에서 압력이 평형을 이루어 구강내압이 성문하압과 거의 같아진다. 이어지는 모음 /i/ 구간에서는 입이 열려 구강내압이 거의 0으로 떨어지므로, 측정에는 /p/ 구간의 최고 압력을 쓴다.\",\"w\":{\"1\":\"성대가 닫혀 있으면 성문을 경계로 기관과 구강이 분리되어 두 압력이 달라지므로 구강내압으로 성문하압을 추정할 수 없다. 추정이 가능한 이유는 오히려 무성음 /p/에서 성문이 열려 있기 때문이다.\",\"3\":\"모음 /i/ 구간에는 입이 열려 공기가 빠져나가므로 구강내압이 거의 0에 가깝다. 구강내압이 가장 높은 구간은 /p/ 폐쇄 구간이다.\",\"4\":\"/p/는 구강 압력자음이라 연인두가 닫힌 상태에서 산출된다. 연구개가 내려가 비강과 통하면 압력이 새어 나가 구강내압이 제대로 형성되지 않는다.\",\"5\":\"기류량(L/s)과 압력(cmH2O)은 서로 다른 물리량이므로 같을 수 없다. 입술이 열리는 순간에는 압력이 급히 떨어지며, 추정에 쓰는 것은 폐쇄 구간의 압력이다.\"}},\"2-2-1-68\":{\"p\":\"Jitter는 주기 간 기본주파수(음도) 변동률, Shimmer는 주기 간 진폭(강도) 변동률, NHR은 배음 성분에 대한 소음 성분의 비율로, 세 값 모두 클수록 음성이 불안정하고 비주기적이다. 정상 기준은 장비·분석 프로그램·교재에 따라 다르지만, 흔히 소개되는 MDVP 기준으로 보면 Jitter 약 1 % 안팎, Shimmer 약 3~4 % 안팎, NHR 약 0.19 안팎이 상한으로 제시된다. 지문의 Jitter 3.2 %, Shimmer 9.5 %, NHR 0.42는 모두 이 기준을 뚜렷하게 넘으므로 주파수·진폭 변동이 크고 소음 성분이 많다고 해석한다. 청지각적으로는 거친 음성(rough)이나 기식성 음성(breathy)과 관련될 수 있으며, 기본주파수 118 Hz는 성인 남성 정상 범위이다.\",\"w\":{\"2\":\"118 Hz는 성인 남성의 일반적인 말 기본주파수 범위(대략 100~150 Hz) 안에 있다. 비정상적으로 높다고 볼 수 없다.\",\"3\":\"Shimmer 9.5 %는 흔히 쓰이는 정상 상한(약 3~4 %)을 크게 넘으므로 진폭 변동도 비정상적으로 크다. 주파수 변동만 크다는 해석은 틀리다.\",\"4\":\"NHR 0.42는 일반적인 정상 기준보다 높아 소음 성분이 많다는 뜻이며, 이때는 배음 구조가 약해진다. 소음이 적고 배음이 뚜렷하다는 것은 반대 해석이다.\",\"5\":\"Jitter는 주기 간 주파수(음도)의 변동, Shimmer는 주기 간 진폭(강도)의 변동을 나타낸다. 두 지표의 의미를 서로 바꿔 적은 보기이다.\"}},\"2-2-1-69\":{\"p\":\"음성범위프로파일(VRP, voice range profile)은 음역도 또는 포네토그램(phonetogram)이라고도 하며, 화자가 낼 수 있는 최저음부터 최고음까지 여러 음도에서 가장 작게(최소 강도)와 가장 크게(최대 강도) 낸 소리를 측정해 가로축 음도, 세로축 강도의 그래프로 나타낸다. 그래프의 위 곡선은 최대 강도, 아래 곡선은 최소 강도이며, 두 곡선이 둘러싼 면적이 그 화자의 음도·강도 조절 범위를 한눈에 보여 준다. 문항의 단서는 '음도별로', '가장 작은 소리와 가장 큰 소리', '그래프'이다. 성악가·교사 등 직업적 음성 사용자의 평가나 치료 전후 비교에 자주 쓰인다.\",\"w\":{\"1\":\"최대발성지속시간(MPT)은 깊게 숨을 들이쉰 뒤 모음을 최대한 길게 내는 시간을 재는 검사로, 호흡·발성의 효율을 본다. 음도별 강도 범위를 그래프로 나타내지 않는다.\",\"2\":\"켑스트럼 분석은 음성 신호의 주기성(배음 구조의 뚜렷함)을 CPP(켑스트럼 최고점 돌출도) 같은 지표로 나타내는 음향 분석이다. 연결 발화에도 적용할 수 있으나 음도별 최소·최대 강도를 재는 검사가 아니다.\",\"4\":\"비음측정(나조미터 등)은 구강과 비강의 음향 에너지 비율(비성치)로 공명을 평가하는 검사이다. 발성의 음도·강도 범위와는 관련이 없다.\",\"5\":\"s/z 비율은 /s/와 /z/의 최대 지속시간을 비교해 성문 효율(성대 병변 등으로 인한 공기 누출 여부)을 간접적으로 보는 지표이다. 그래프로 음도별 강도를 표시하지 않는다.\"}},\"2-2-1-70\":{\"p\":\"음성장애지수(VHI, Voice Handicap Index)는 음성 문제가 생활에 미치는 영향을 환자가 스스로 평가하는 자기보고식 검사로, 기능적(Functional), 신체적(Physical), 정서적(Emotional) 3개 하위영역으로 이루어진다(원판은 영역별 10문항씩 30문항). 기능적 영역은 일상 의사소통·사회생활에서 겪는 어려움, 신체적 영역은 발성할 때 스스로 느끼는 음성 특성·감각·노력, 정서적 영역은 음성 문제에 대한 감정 반응을 묻는다. (가) '속이 상하고 위축된다'는 감정 반응이므로 정서적, (나) '시끄러운 곳에서 상대가 내 말을 못 알아듣는다'는 의사소통 상황의 어려움이므로 기능적, (다) '목에 힘을 많이 주어야 한다'는 발성 노력·감각이므로 신체적 영역이다. 문항 속 핵심 동사가 '느낀다(감정)', '상대가 ~한다(상황)', '목소리를 내려면 ~해야 한다(몸)' 중 무엇인지 보면 구별하기 쉽다.\",\"w\":{\"1\":\"(가)를 신체적, (다)를 정서적으로 보았는데, 위축감은 감정 반응이라 정서적이고 목에 힘을 주는 것은 발성 노력이라 신체적이다. (가)와 (다)를 서로 바꾼 배열이다.\",\"2\":\"(가) 정서적은 맞지만 (나)는 의사소통 상황의 어려움이라 기능적, (다)는 발성 노력이라 신체적이다. (나)와 (다)를 바꾼 배열이다.\",\"3\":\"(다) 신체적은 맞지만, (가)는 감정 반응이므로 기능적이 아니라 정서적이고, (나)는 의사소통 상황의 어려움이므로 정서적이 아니라 기능적이다. (가)와 (나)를 바꾼 배열이다.\",\"4\":\"(가)는 정서적, (나)는 기능적, (다)는 신체적 영역인데 이 배열은 어느 것도 맞지 않는다. 의사소통 상황(기능적)과 감정(정서적)을 혼동한 결과이다.\"}},\"2-2-1-71\":{\"p\":\"경성 성대 접촉(hard glottal attack)은 발성 직전에 성대를 강하게 닫아 성문하압을 높였다가 한꺼번에 터뜨리듯 소리를 시작하는 것으로, 모음으로 시작하는 낱말에서 '딱' 하는 급격한 시작음으로 들린다. 이 습관은 성대 막양부의 충돌 충격을 키워 결절을 만들거나 악화시키므로, 과기능적 음성장애에는 부드러운 성대 접촉(easy onset, 쉬운 발성 시작)을 먼저 지도한다. /h/를 앞에 붙여 '(h)아', '(h)엄마'처럼 숨이 살짝 먼저 흐른 뒤 성대가 부드럽게 닫히게 하고, 점차 /h/를 줄여 자연스러운 모음 시작으로 옮긴다. 지문에서 '성대결절'과 '세게 부딪치며 시작'이라는 두 단서가 과기능 → 충격 감소 방향의 기법을 고르게 한다.\",\"w\":{\"1\":\"밀기 기법(pushing)은 팔이나 몸에 힘을 주며 성대 내전을 강화하는 기법으로, 성대마비 등 성문 폐쇄부전(저기능)에 쓴다. 이미 성대를 세게 부딪치는 과기능 화자에게는 충격을 더 키운다.\",\"3\":\"경성 성대 접촉을 의도적으로 반복하는 것은 성문 폐쇄를 높이려는 저기능 음성장애용 접근이다. 결절의 원인 행동을 강화하므로 이 화자에게는 금기에 가깝다.\",\"4\":\"음도를 지나치게 낮추면 후두를 누르는 긴장이 생기고 오히려 발성 효율이 떨어질 수 있다. 문제의 핵심은 발성 시작 방식이지 음도가 아니며, 음도는 화자에게 맞는 적정 음도로 조절해야 한다.\",\"5\":\"숨을 참았다가 성문하압을 높여 발성하면 성대가 꽉 닫힌 상태에서 터지듯 시작하게 되어 경성 성대 접촉이 더 심해진다. 후두 긴장을 높이는 방향이라 부적절하다.\"}},\"2-2-1-72\":{\"p\":\"음성위생은 성대에 가해지는 충격과 자극을 줄이고 성대 점막을 건강하게 유지하기 위한 생활 지침이다. 속삭임은 성대를 진동시키지 않을 뿐 성대 주변 근육을 긴장시킨 채 공기를 많이 내보내는 방식이 되기 쉬워, 성대를 쉬게 하는 방법으로 권하지 않는다. 목소리를 아껴야 할 때는 속삭임 대신 부드럽고 편안한 작은 목소리(가벼운 발성)로 말하거나 말하는 양 자체를 줄이도록 지도하는 것이 일반적이다. 아동의 경우 고함을 대신할 신호 정하기, 헛기침 대신 물 삼키기처럼 구체적인 대체 행동을 함께 알려 주는 것이 실천에 도움이 된다.\",\"w\":{\"1\":\"고함 대신 손짓·호루라기 같은 비음성 신호를 쓰면 성대 충격을 줄일 수 있으므로 올바른 음성위생 지도이다. 운동장에서 자주 소리치는 이 아동에게 특히 필요한 내용이다.\",\"2\":\"헛기침은 성대를 세게 부딪치게 하므로, 목이 불편할 때 물을 삼키거나 침을 삼키는 행동으로 바꾸게 하는 것은 올바른 지도이다.\",\"4\":\"건조한 환경은 성대 점막을 마르게 해 진동 효율을 떨어뜨리므로 적절한 습도를 유지하는 것은 올바른 음성위생 지침이다. 수분 섭취와 함께 흔히 권장된다.\",\"5\":\"시끄러운 곳에서 목소리를 키우는 대신 상대에게 가까이 가서 말하면 음성 남용을 줄일 수 있다. 올바른 음성위생 지도이다.\"}},\"2-2-1-73\":{\"p\":\"폐암 수술 등 흉부 수술에서는 대동맥궁을 돌아 올라가는 왼쪽 되돌이후두신경이 손상되기 쉬워 왼쪽 성대마비가 흔하다. 성대가 부정중위(paramedian, 정중선에서 조금 벗어난 위치)에 고정되면 건측 성대가 다가와도 성문 틈이 남아 기식성 음성이 생긴다. 머리 위치 조정(head turning) 기법은 머리를 마비 측(여기서는 왼쪽)으로 돌려 발성하는 것으로, 이렇게 하면 마비 측 후두 구조가 중앙 쪽으로 눌려 성문 틈이 줄고 폐쇄가 좋아진다. 치료실에서는 여러 머리 위치를 시도해 음질이 가장 좋아지는 자세를 찾고, 이를 밀기·성대 내전 강화 기법 등과 함께 쓰기도 한다.\",\"w\":{\"1\":\"머리를 건측(오른쪽)으로 돌리면 마비 측 구조를 중앙으로 밀어 주는 효과를 얻지 못해 성문 틈이 줄지 않는다. 머리 돌리기 방향은 마비 측이어야 한다.\",\"2\":\"고개를 뒤로 젖혀 목을 펴면 후두 주변 근육과 조직이 당겨져 긴장이 높아질 수 있으며, 성문 폐쇄를 돕는 자세로 알려져 있지 않다. 고개 숙이기(턱 당기기)가 함께 시도되기는 하지만 젖히기는 해당하지 않는다.\",\"3\":\"바르게 누운 자세는 호흡 지지에 영향을 줄 뿐 마비된 성대를 중앙으로 옮겨 주지 않는다. 성문 폐쇄를 돕는 자세 조정 기법이 아니다.\",\"4\":\"어깨를 끌어 올리면 목과 어깨 주변 근육의 긴장이 커지고 쇄골 호흡처럼 비효율적인 호흡 패턴이 생기기 쉽다. 성문 폐쇄를 돕는 방법이 아니다.\"}},\"2-2-1-74\":{\"p\":\"씹기 기법(chewing method)은 음식을 씹듯 턱과 혀를 크게, 과장되게 움직이면서 소리를 내게 하여 턱·혀·인두·후두 주변의 과도한 긴장을 풀고 더 이완된 발성을 유도하는 이완 계열 기법이다. 지문은 ① 과장된 씹기 동작과 함께 발성, ② 숫자 세기 → 낱말 → 문장으로 확장, ③ 씹는 동작을 점차 줄여 자연스러운 말로 이행하는 전형적 절차를 보여 준다. 이완을 목표로 하므로 주된 적용 대상은 후두 근육을 지나치게 긴장시키는 과기능적 음성장애(근긴장성 발성장애, 과기능에 의한 결절 등)이다. 같은 이완 계열로 하품-한숨 기법이 있고, 반대로 폐쇄를 높이는 기법으로 밀기 기법이 있다는 대비를 기억해 두면 좋다.\",\"w\":{\"2\":\"씹기 기법은 긴장을 풀어 주는 이완 기법이라, 성대가 충분히 닫히지 않는 성대 폐쇄부전에는 맞지 않는다. 폐쇄부전에는 밀기 기법처럼 내전을 강화하는 기법을 쓴다.\",\"3\":\"하품-한숨 기법은 하품으로 후두를 낮추고 인두를 넓힌 뒤 한숨처럼 부드럽게 발성하는 이완 기법으로, 과기능에 쓴다. 지문의 씹는 동작 절차와도 다르고 적용 대상도 폐쇄부전이 아니다.\",\"4\":\"밀기 기법은 팔이나 몸에 힘을 주며 성대 내전을 강화하는 기법으로 성대 폐쇄부전에 쓴다. 과기능적 음성장애에 쓰면 긴장을 더 높여 해롭고, 지문의 절차와도 다르다.\",\"5\":\"공명음성치료(resonant voice therapy)는 입술·코 주변 앞쪽 울림을 느끼며 편안하게 발성하는 기법으로 주로 과기능·결절 등에 쓴다. 기능적 실성증에는 기침·헛기침 소리에서 모음으로 이어 가는 방법 등을 주로 쓰며, 지문의 씹기 절차와도 다르다.\"}},\"2-2-1-75\":{\"p\":\"만성 비염과 아데노이드 비대로 비강·비인두 통로가 막히면 비음을 낼 때도 공기와 소리 에너지가 코로 충분히 나가지 못해 과소비성(hyponasality)이 된다. 그래서 비음 /ㅁ/이 같은 조음 위치의 구강 파열음 /ㅂ/처럼 들려 '엄마'가 [업바]처럼 들린다. 나조미터는 비성치(nasalance = 비강 에너지 ÷ (비강+구강 에너지) × 100)를 구하는데, 과소비성은 원래 비성치가 높게 나와야 하는 비음 문장(비강자음이 많은 문장)에서 기대치보다 낮게 나오는 것으로 드러난다. 반대로 과다비성은 비음이 없는 구강음 문장에서 비성치가 기대보다 높게 나오는 것으로 평가하므로, '과소비성 → 비음 문장, 과다비성 → 구강음 문장'으로 짝지어 기억한다.\",\"w\":{\"1\":\"구강음 문장에서 비성치가 기대보다 높게 나오는 것은 과다비성(연인두 폐쇄부전 등)의 소견이다. 비강이 막힌 이 아동의 과소비성과는 반대이다.\",\"2\":\"구강음 문장은 정상 화자도 비성치가 낮게 나오는 자료라서 과소비성이 있어도 정상과 차이가 잘 드러나지 않는다. 과소비성 판별에는 비음 문장을 써야 한다.\",\"3\":\"비음 문장에서 비성치가 기대보다 높게 나오는 것은 비강 공명이 지나친 경우(과다비성 쪽)의 해석이다. 비강 통로가 막힌 과소비성에서는 낮게 나온다.\",\"5\":\"모음 연장에서 비성치가 기대보다 높은 것은 모음이 비음화되는 과다비성의 소견이다. 과소비성을 평가하는 자료와 결과로 맞지 않는다.\"}},\"2-2-1-76\":{\"p\":\"연인두 폐쇄는 연구개가 위·뒤로 올라가 인두 후벽에 닿고, 인두 측벽이 안쪽으로, 후벽이 앞쪽으로 움직이며 함께 비인두를 막는 과정이다. 연구개를 들어 올리는 주된 근육은 구개올림근(levator veli palatini)으로, 좌우 근육이 연구개 안에서 고리(근육 걸이)를 이루어 수축하면 연구개가 위·뒤로 당겨진다. 연인두 관련 근육은 역할로 묶어 정리하면 쉽다. 올림은 구개올림근, 이관 열기는 구개긴장근, 내림은 구개설근·구개인두근, 연구개 두께(구개수 부위)는 구개수근, 인두벽 조이기는 상인두수축근이 맡는다(근육 기능 설명은 교재에 따라 세부 표현이 다를 수 있다).\",\"w\":{\"1\":\"구개긴장근은 주로 귀인두관(이관)을 여는 데 관여하는 근육이며, 연구개를 들어 올리는 주된 근육은 구개올림근이다.\",\"2\":\"비음 /m/은 소리 에너지가 비강으로 나가야 하므로 연인두가 열린 상태에서 산출된다. 연인두가 완전히 닫히는 것은 구강 압력자음을 낼 때이다.\",\"3\":\"구개설근은 연구개와 혀를 잇는 근육으로, 수축하면 연구개를 아래로 끌어내리거나 혀 뒷부분을 올린다. 연구개를 위로 올리는 것은 구개올림근이다.\",\"5\":\"연인두 폐쇄에는 연구개뿐 아니라 인두 측벽의 안쪽 이동과 인두 후벽의 앞쪽 이동도 함께 관여한다. 이 움직임의 조합에 따라 관상형·시상형·원형 등 폐쇄 유형을 나눈다.\"}},\"2-2-1-77\":{\"p\":\"음소특정적 비강누출(phoneme-specific nasal emission)은 연인두 구조와 기능이 정상인데 특정 음소(흔히 /s/ 같은 마찰음·파찰음)를 낼 때만 연인두를 열고 공기를 코로 내보내는 잘못된 조음 습관이다. 지문의 단서는 ① 구개열 병력이 없고 연인두 기능이 정상, ② /s/에서만 비강 누출, ③ 다른 압력자음과 모음 공명은 정상, ④ /s/ 산출 중 코를 막으면 소리가 나지 않음(공기가 입이 아니라 코로만 나가고 있다는 뜻)이다. 구조 문제가 아니라 학습된 조음 오류이므로, 코로 새는 /s/를 고치는 것이 아니라 혀끝과 치조 사이로 공기를 내보내는 구강 /s/를 새로 가르치는 조음치료가 적절하다. 예를 들어 /t/를 길게 끌어 [tsss]로 이어 가는 식으로 구강 기류를 먼저 확립하는 방법을 쓸 수 있다.\",\"w\":{\"2\":\"인두판 수술 등 연인두 수술은 구조적 연인두 폐쇄부전이 확인될 때 고려한다. 이 아동은 다른 압력자음에서 연인두 폐쇄가 정상이므로 수술 대상이 아니다.\",\"3\":\"구개올림 보철기는 연구개가 충분히 올라가지 못하는 연인두 기능부전(마비 등)에 쓴다. 기능이 정상인 음소특정적 비강누출에는 필요하지 않다.\",\"4\":\"불기 같은 비구어 구강운동은 말을 할 때의 연인두 폐쇄를 개선한다는 근거가 부족하다. 게다가 이 아동은 근력 문제가 아니라 조음 방식의 문제이다.\",\"5\":\"음도를 높인다고 특정 음소의 비강 누출이 해결되지 않는다. 이 문제는 공명 문제가 아니라 /s/의 기류 방향을 잘못 학습한 조음 문제이다.\"}},\"2-2-1-78\":{\"p\":\"음성 여성화 행동치료에서는 청자가 화자의 성별을 지각할 때 기본주파수(음도) 하나만이 아니라 공명(포먼트), 억양, 음질, 조음 등 여러 단서를 함께 쓴다는 점을 전제로 한다. 같은 음도라도 성도가 길고 넓으면 포먼트가 낮아 남성적으로 들리므로, 혀를 앞쪽에 두고 입술 퍼짐을 늘리는 등 공명을 앞쪽(밝은 쪽)으로 옮겨 포먼트 주파수를 높이는 훈련을 음도 상향과 함께 한다. 목표 음도는 일반적으로 남녀 지각이 갈리는 경계(대략 150~180 Hz 이상, 교재에 따라 다름)로 무리 없이 올리되 가성이 아닌 편안한 발성을 유지한다. 여기에 억양 변화를 넓히고 부드러운 발성 시작 같은 음질 요소까지 다루는 것이 일반적이다.\",\"w\":{\"1\":\"기본주파수만 높여도 공명(포먼트)이 남성적이면 여성 음성으로 충분히 지각되지 않는 경우가 많다. 음도·공명·억양을 함께 다뤄야 한다.\",\"2\":\"가성은 성대 가장자리만 진동하는 발성이라 약하고 기식성이 섞이며 오래 쓰면 부자연스럽고 피로하다. 목표는 가성이 아닌 편안한 진성(모달) 발성으로 음도를 올리는 것이다.\",\"3\":\"일반적으로 여성 화자는 억양 변화 폭이 더 큰 편이므로, 여성화 치료에서는 오히려 억양 변화를 넓히도록 지도한다. 단조로운 억양은 반대 방향이다.\",\"4\":\"후두를 낮추면 성도가 길어져 포먼트가 낮아지므로 더 남성적인 공명이 된다. 여성화에서는 후두를 무리하게 낮추지 않고 공명을 앞쪽으로 옮긴다.\"}},\"2-2-1-79\":{\"p\":\"선천성 고도 감각신경성 청각장애 화자는 말을 배우는 시기에 자기 목소리를 듣는 청각 피드백이 부족해 음도·강도·공명을 귀로 조절하기 어렵다. 그 결과 일반적으로 음도가 지나치게 높거나 발화 중 불안정하게 변하고, 강도가 너무 크거나 작게 들쭉날쭉하며, 억양 변화가 적어 단조롭게 들리는 경향이 있다. 공명 면에서는 과다비성·과소비성이나 혀가 뒤로 물러난 듯한 공명이 나타날 수 있고, 모음이 중앙 쪽으로 모이는 모음 중립화도 흔하다. 말속도는 대체로 느리고 음절과 휴지가 길어지는데, 이런 특성은 청력 정도, 보장구 착용 시기, 교육 이력에 따라 개인차가 크다.\",\"w\":{\"1\":\"청각 피드백이 부족하면 음도 변화를 듣고 조절하기 어려워 억양이 단조로워지는 경향이 있다. 넓은 음도 범위와 풍부한 억양은 건청 화자의 특성에 가깝다.\",\"3\":\"고도 청각장애 화자는 과다비성 등 공명 이상과 모음 중립화가 흔하다. 공명 문제가 없고 모음이 정확하다는 것은 청각 피드백이 충분할 때의 모습이다.\",\"4\":\"청각장애 화자는 대체로 말속도가 느리고 음절과 휴지가 길어지는 경향이 있다. 빠른 말속도와 짧은 음절은 반대 특성이다.\",\"5\":\"자기 목소리를 듣고 강도를 정확히 조절하려면 충분한 청각 피드백이 필요하다. 고도 청각장애에서는 오히려 강도 조절이 어렵다.\"}},\"2-2-1-80\":{\"p\":\"후두전적출술은 후두암 등으로 성대를 포함한 후두 전체를 제거하는 수술로, 수술 후 기관 끝을 목 앞쪽 피부에 연결해 영구 기관공(stoma)을 만들고 이곳으로만 숨을 쉰다. 공기가 더 이상 코와 입을 지나지 않으므로 냄새 분자가 후각 수용체에 닿기 어려워 후각과 그에 따른 미각이 떨어진다. 동시에 기도와 식도가 완전히 분리되어 음식물이 기도로 들어가는 흡인은 일반적으로 일어나지 않는다. 의사소통은 성대 대신 식도발성, 기관식도발성(TEP, 발성 보장구), 전기후두 등 대체 발성법으로 하며, 숨을 참고 힘주는 동작이 어려워지는 점도 대표적인 변화이다.\",\"w\":{\"1\":\"후두전적출술 후에는 기관이 목 앞의 영구 기관공에 직접 연결되므로 코와 입으로는 숨을 쉬지 않는다. 호흡 경로가 수술 전과 완전히 달라진다.\",\"2\":\"후두전적출술에서는 기도(기관)와 식도를 완전히 분리하므로 음식물이 기도로 들어가는 흡인 위험은 일반적으로 없다. 오히려 흡인 위험이 커지는 것은 부분후두절제술 등에서 나타날 수 있는 문제이다.\",\"4\":\"후두전적출술은 성대를 포함한 후두 전체를 제거하므로 성대 발성은 물론 성문을 통한 속삭임 발성도 할 수 없다. 대신 식도발성·기관식도발성·전기후두 같은 대체 발성법을 익힌다.\",\"5\":\"힘주기(배변, 무거운 물건 들기 등)는 성문을 닫아 흉강 압력을 높여야 쉬운데, 성문이 없어지고 기관공으로 공기가 빠져나가 오히려 힘주기가 어려워진다.\"}},\"2-2-2-1\":{\"p\":\"수단-목적 관계(means-end)는 목표를 이루기 위해 중간 수단을 의도적으로 쓰는 능력으로, 피아제(Piaget) 감각운동기 4~5단계(대략 8~18개월)에 걸쳐 발달한다. 지문의 단서는 장난감이 손에 닿지 않는데 아동이 장난감 자체가 아니라 '천'을 먼저 잡아당긴다는 점이다. 즉 목표(장난감)와 수단(천)을 구분하고 수단을 먼저 조작하는 순서가 나타난다. 이 개념은 이후 성인을 '수단'으로 써서 원하는 것을 얻는 의도적 의사소통(원시명령)의 인지적 기반으로도 설명된다.\",\"w\":{\"2\":\"지연 모방은 본 행동을 시간이 지난 뒤 모델 없이 재현하는 것으로 표상 능력의 지표이다. 지문에는 이전에 본 행동을 재현하는 장면이 없다.\",\"3\":\"대상영속성은 대상이 가려져 보이지 않아도 존재한다는 것을 아는 개념으로, 숨긴 물건을 찾는 행동으로 확인한다. 이 장면에서 장난감은 천 위에 계속 보이고 있다.\",\"4\":\"표상적 사고는 눈앞에 없는 대상·사건을 머릿속 상징으로 떠올리는 능력으로 대략 18~24개월 감각운동기 말에 나타난다. 지문은 보이는 대상을 직접 조작하는 문제 해결이다.\",\"5\":\"보존 개념은 모양이 바뀌어도 양·수가 같다는 것을 아는 개념으로 구체적 조작기(대략 7세 이후)에 획득되어 11개월 아동과 맞지 않는다.\"}},\"2-2-2-2\":{\"p\":\"상징놀이는 일반적으로 자기 중심 상징행동 → 탈중심화(타인·인형으로 확장) → 단일 도식 조합(한 도식을 여러 대상에 적용) → 다중 도식 조합(여러 도식을 순서대로 연결) → 계획된(위계적) 상징놀이 순으로 발달한다(McCune 등의 단계). ⑤는 행동 전에 '목욕시킬 거야'라고 말로 계획을 밝히고 필요한 물건을 찾아 나서므로, 놀이가 머릿속 계획에 의해 조직되는 가장 높은 단계이다. 판단의 핵심은 행동 수가 아니라 '실행 전에 계획이 드러나는가'이다. 각 단계의 출현 시기는 교재에 따라 조금씩 다르게 제시된다.\",\"w\":{\"1\":\"자기 몸을 대상으로 한 자기 중심 상징행동으로, 상징놀이 중 가장 먼저(대략 12개월 전후) 나타난다.\",\"2\":\"놀이 대상을 자신에서 인형으로 넓힌 탈중심화 단계로, 자기 중심 상징행동 다음에 나타나는 비교적 초기 단계이다.\",\"3\":\"먹이기와 재우기라는 서로 다른 도식을 순서대로 잇는 다중 도식 조합이다. 계획이 말로 먼저 드러나지 않으므로 계획된 상징놀이보다 앞선 단계이다.\",\"4\":\"'먹이기'라는 한 도식을 자신과 인형에게 반복 적용하는 단일 도식 조합으로, 다중 도식 조합이나 계획된 놀이보다 앞선다.\"}},\"2-2-2-3\":{\"p\":\"표상적(상징적, representational) 몸짓은 지시 대상의 모양·움직임·기능 같은 특징을 몸짓 형태 자체에 담아 의미를 전달하는 몸짓이다. 지문에서 팔을 퍼덕이는 동작은 '새'라는 대상 없이도 새를 뜻하며, '새는 어떻게 하지?'라는 질문에 같은 동작으로 답해 일관된 의미를 가진 상징으로 쓰이고 있다. 반면 직시적(deictic) 몸짓인 가리키기·보여주기·주기는 맥락 속 대상에 주의를 돌릴 뿐 몸짓 자체에 의미가 없다. 표상적 몸짓은 일반적으로 첫 낱말 시기 전후에 늘어나며 이후 낱말 습득과 관련이 깊다.\",\"w\":{\"1\":\"가리키기는 손가락으로 대상의 위치를 지시해 주의를 돌리는 직시적 몸짓이다. 지문의 동작은 대상을 가리키지 않고 새의 특징을 흉내 낸다.\",\"3\":\"손 끌기(접촉) 몸짓은 성인의 손을 잡아 원하는 곳으로 끌고 가는 등 성인의 몸을 도구처럼 쓰는 원시적 몸짓이다. 지문에서 아동은 성인을 접촉하지 않는다.\",\"4\":\"보여주기는 물건을 들어 상대에게 내밀어 보이는 직시적 몸짓으로, 대상 자체에 주의를 끄는 기능을 한다. 팔 퍼덕이기처럼 대상의 특징을 표현하지 않는다.\",\"5\":\"상동 행동은 의사소통 의도 없이 같은 동작을 반복하는 행동이다. 지문의 동작은 그림책의 새와 엄마의 질문에 맞추어 의미 있게 산출되었다.\"}},\"2-2-2-4\":{\"p\":\"웨더비와 프리장(Wetherby & Prizant)은 초기 의사소통 기능을 행동조절, 사회적 상호작용, 공동주의의 세 범주로 나눈다. 사회적 상호작용은 성인의 관심을 자신에게 끌고 상호작용 자체를 유지하려는 기능으로, 사회적 게임 요구, 인사, 부르기, 과시하기, 위로 요구 등이 포함된다. 지문의 단서는 까꿍 놀이를 스스로 시작하고 성인이 반응하지 않자 다시 시도하며 성인을 쳐다본다는 점으로, 아동이 원하는 것은 물건이 아니라 놀이에 대한 성인의 참여이다. 목표가 '물건·행위'이면 행동조절, '대상에 함께 주의'이면 공동주의, '사람과의 상호작용 자체'이면 사회적 상호작용으로 구분한다.\",\"w\":{\"1\":\"행동조절은 물건이나 행위를 요구하거나 거부해 성인의 행동을 조절하는 기능이다. 아동은 물건이나 특정 행동을 요구하지 않고 놀이 참여를 바란다.\",\"2\":\"공동주의는 대상이나 사건에 성인의 주의를 끌어 함께 보려는 기능(언급하기, 정보 요구 등)이다. 지문에는 함께 주의를 기울일 외부 대상이 없다.\",\"3\":\"자기조절은 웨더비와 프리장의 세 가지 의사소통 기능 범주에 들지 않으며, 지문의 행동은 타인을 향한 의사소통이다.\",\"5\":\"정보 제공 기능은 할리데이(Halliday) 등의 기능 분류에 나오는 개념으로 이 범주 체계에 해당하지 않으며, 아동은 정보를 전달하지 않는다.\"}},\"2-2-2-5\":{\"p\":\"빠른 연결(fast mapping)은 새 낱말을 한두 번 들은 것만으로 그 낱말과 지시 대상을 연결해 초기의 부분적 의미 표상을 만드는 과정이다. 지문의 단서는 '한 번' 들려준 이름으로 며칠 뒤 그림 중에서 망고를 골라냈다는 점(형태-지시 대상 연결 성공)과, 맛·먹는 방법은 설명하지 못한다는 점(의미가 아직 얕음)이다. 의미의 세부는 이후 반복 노출을 통해 점진적으로 채워지는데, 이를 느린 연결(slow mapping) 또는 확장된 연결이라 구분한다. 빠른 연결은 일반적으로 2세 전후부터 관찰되며 어휘 급증을 설명하는 기제로도 언급된다.\",\"w\":{\"2\":\"과잉 일반화는 규칙을 예외에까지 적용하는 오류(예: 문법 규칙의 과잉 적용)이거나, 낱말 의미에서는 범주를 넓게 쓰는 오류를 말한다. 지문의 아동은 낱말을 잘못 쓴 것이 아니라 정확히 연결했다.\",\"3\":\"과소 확장은 낱말을 성인 범주보다 좁게 적용하는 오류(예: 자기 컵만 '컵')이다. 지문은 새 낱말을 처음 연결하는 과정이지 적용 범위 오류가 아니다.\",\"4\":\"어휘 폭발은 대략 50낱말 전후, 18~24개월 무렵 어휘가 급격히 늘어나는 시기를 가리키는 말로, 한 낱말을 한 번 듣고 연결하는 현상 자체를 설명하지 않는다.\",\"5\":\"지연 모방은 본 행동을 시간이 지난 뒤 재현하는 것이다. 아동은 낱말을 따라 말한 것이 아니라 들은 이름에 맞는 그림을 골랐다.\"}},\"2-2-2-6\":{\"p\":\"과소확장(underextension)은 낱말을 성인 범주보다 좁게, 과대확장(overextension)은 넓게 적용하는 의미 오류이다. 판단은 '아동이 그 낱말을 붙인 대상 범위'를 성인의 범주와 비교해 하는데, 자기 컵에만 '컵'을 쓰면 다른 컵들이 빠져 범위가 좁으므로 과소확장이 맞다. 과대확장은 일반적으로 모양·크기·움직임 같은 지각적 특징의 공통성에 근거해 일어나며 초기 어휘기(대략 1~2.5세)에 흔하다. 보기마다 '정의의 방향(넓다/좁다)'과 '붙인 이름'이 서로 맞는지를 확인하면 된다.\",\"w\":{\"1\":\"둥근 것 모두를 '공'이라 부르는 것은 모양이라는 지각적 특징으로 범주를 넓힌 과대확장이므로 과소확장과의 연결이 틀렸다.\",\"2\":\"자기 집 강아지에게만 '멍멍이'를 쓰는 것은 범위를 좁게 쓴 과소확장이므로 과대확장과의 연결이 틀렸다.\",\"3\":\"네 발 동물을 모두 '멍멍이'라 하는 것은 개 범주를 넘어 넓게 적용한 과대확장이므로 과소확장과의 연결이 틀렸다.\",\"5\":\"모든 성인 남자를 '아빠'라 부르는 것은 특정 인물을 가리키는 말을 넓은 범주로 쓴 과대확장이므로 과소확장과의 연결이 틀렸다.\"}},\"2-2-2-7\":{\"p\":\"어휘다양도(TTR, type-token ratio) = 서로 다른 낱말 수(NDW, type) ÷ 총 낱말 수(NTW, token)이다. 총 낱말 수는 '엄마/차/타, 차/빨리/가, 아빠/차/타, 엄마/빨리/와, 나/차/좋아'로 3×5 = 15개이다. 서로 다른 낱말은 엄마·차·타·빨리·가·아빠·와·나·좋아의 9개로, 차(4회)·엄마(2회)·타(2회)·빨리(2회)는 한 번만 센다. 따라서 TTR = 9 ÷ 15 = 0.60이며, 검산하면 중복 출현 횟수(차 3 + 엄마 1 + 타 1 + 빨리 1 = 6)를 15에서 뺀 값도 9로 일치한다. TTR은 표본 크기에 민감하므로 일반적으로 같은 길이의 표본끼리 비교해야 한다.\",\"w\":{\"1\":\"0.45는 9를 20으로 나눈 값처럼 총 낱말 수를 실제(15)보다 많이 잡을 때 나오는 값으로, 이 표본의 계산과 맞지 않는다.\",\"3\":\"0.67은 서로 다른 낱말을 10개로 잘못 세어(10 ÷ 15) 나오는 값으로, 반복된 낱말 하나를 중복 계산한 실수에 해당한다.\",\"4\":\"0.75는 9 ÷ 12처럼 총 낱말 수를 줄여 세거나 서로 다른 낱말을 과다 계산할 때 나오는 값으로, 정확한 총 낱말 수 15를 쓰지 않았다.\",\"5\":\"1.67은 총 낱말 수를 서로 다른 낱말 수로 나눈 값(15 ÷ 9)으로, 분자와 분모를 뒤바꾼 실수이다. TTR은 1을 넘을 수 없다.\"}},\"2-2-2-8\":{\"p\":\"수용 어휘가 또래 범위인데 이름대기에서 에둘러 말하기(우회 표현, circumlocution)와 긴 반응 시간, 시간이 지나면 정확히 말하는 양상은 낱말을 '모르는' 것이 아니라 저장된 낱말을 '꺼내지 못하는' 낱말찾기(인출) 어려움을 시사한다. 인출 어려움은 의미 표상이 성기거나 낱말 간 연결이 약할 때 두드러지므로, 범주·기능·특징·위치 등 의미 단서로 목표 낱말을 정교화하고 의미망을 넓히는 의미 중심 중재가 우선이다. '종이 자르는 거'처럼 기능은 알고 있으므로 이 지식을 범주(문구류)·특징과 연결해 인출 경로를 늘리는 것이 목표가 된다. 교재에 따라 첫소리 단서 등 음운 단서 중재를 함께 제시하기도 하지만, 보기 중에서는 ⑤가 아동의 문제와 가장 직접적으로 맞는다.\",\"w\":{\"1\":\"수용 어휘 확인 반복은 이해 영역 중재인데, 이 아동은 수용 어휘가 이미 또래 범위이므로 인출 문제를 해결하지 못한다.\",\"2\":\"조사와 어미를 넣어 완전한 문장을 말하게 하는 것은 구문·형태 중재로, 낱말 인출 지연과 에둘러 말하기라는 지문의 문제와 맞지 않는다.\",\"3\":\"청자 관점을 고려해 말하기는 화용 중재 목표이다. 지문에는 대화 상대에 맞추지 못하는 문제가 나타나지 않는다.\",\"4\":\"목표 낱말의 말소리를 정확히 따라 말하게 하는 것은 조음·음운 산출 목표이다. 아동은 결국 정확히 말하므로 말소리 산출 문제가 아니다.\"}},\"2-2-2-9\":{\"p\":\"평균낱말길이(MLU-w) = 총 낱말 수 ÷ 발화 수이며, 이 문항은 조사를 따로 한 낱말로, 용언은 어간+어미를 한 낱말로 세는 기준을 준다. 발화별로 '엄마/가/밥/먹어' 4, '공/줘' 2, '아기/가/의자/에/앉았어' 5, '나/도/갈래' 3, '빨간/차' 2이다. 합계는 4+2+5+3+2 = 16, 16 ÷ 5 = 3.2이다. 검산으로 조사 개수(가·가·에·도 = 4)를 빼면 12가 되어 어절 기준 값(12 ÷ 5 = 2.4)과 맞는다. '빨간'은 용언 '빨갛다'의 활용형이므로 어간과 어미를 나누지 않고 1낱말로 센다.\",\"w\":{\"1\":\"2.4는 조사를 체언과 합쳐 어절 단위로 센 값(12 ÷ 5)으로, 조사를 따로 세라는 문항 기준을 적용하지 않은 실수이다.\",\"2\":\"3.0은 총 낱말 수를 15로 센 값으로, 네 개의 조사 중 하나를 빠뜨리는 등 낱말을 하나 덜 셌을 때 나온다.\",\"4\":\"3.4는 총 낱말 수를 17로 센 값으로, '빨간'을 어간과 어미로 나누는 등 낱말을 하나 더 셌을 때 나온다.\",\"5\":\"4.0은 총 낱말 수를 20으로 센 값으로, 문항의 산정 기준과 달리 낱말을 실제(16)보다 많이 나누어 센 결과이다.\"}},\"2-2-2-10\":{\"p\":\"전성어미는 용언이 다른 품사처럼 기능하도록 성격을 바꾸는 어미로, 명사형(-음, -기)과 관형사형(-(으)ㄴ, -는, -(으)ㄹ, -던)이 있다. '먹던 과자'에서 '-던'은 동사 '먹다'를 관형어로 바꾸어 뒤의 체언 '과자'를 꾸미게 하며, 과거 회상의 의미를 함께 담는다. 밑줄 친 형태소가 놓인 위치(체언 뒤 = 조사, 어간 뒤 = 어미)와 뒤에 오는 말(체언 수식이면 관형사형)을 단서로 범주를 판별한다. 문법형태소 범주 구분은 아동의 형태소 발달 분석(조사·어미 습득 순서)에 그대로 쓰이므로 정확히 익혀 두어야 한다.\",\"w\":{\"1\":\"'에서'는 행동이 일어나는 장소를 나타내는 처소격(부사격) 조사이다. 공동격 조사는 '와/과, 하고, (이)랑'처럼 함께하는 대상을 나타낸다.\",\"2\":\"'-었-'은 과거 시제 선어말어미이다. 미래·추측은 '-겠-'이나 '-(으)ㄹ 것'으로 나타낸다.\",\"4\":\"'랑'은 함께하는 대상을 나타내는 공동격 조사이다. 도구격 조사는 '(으)로'처럼 수단·도구를 나타낸다.\",\"5\":\"'-고'는 앞 절과 뒤 절을 잇는 연결어미이다. 종결어미는 '먹자'의 '-자'처럼 문장을 끝맺는 어미이다.\"}},\"2-2-2-11\":{\"p\":\"사건 개연성(확률적 사건) 전략은 문장의 구조(어순·격조사)를 처리하지 않고, 등장하는 낱말로 현실에서 더 일어날 법한 사건을 떠올려 해석하는 초기 이해 전략이다. 판단의 핵심은 두 문장의 반응이 '똑같다'는 점이다. 구조가 반대인 두 문장에 모두 '엄마가 아기를 업는' 행동을 했으므로 아동은 문장 구조가 아니라 상식적 개연성에 기대고 있다. 한국어는 어순이 비교적 자유로워 격조사 이해가 핵심이며, 일반적으로 아동은 개연성 전략 → 어순 전략 → 격조사 이해의 흐름으로 발달한다고 설명된다.\",\"w\":{\"1\":\"어순 전략은 첫 명사를 행위자로 해석하는 전략이다. 이 전략을 썼다면 첫 문장에서 '아기'를 행위자로 해석해 아기 인형이 엄마 인형을 업게 했을 것이다.\",\"3\":\"격조사를 이해했다면 '-가'가 붙은 명사를 행위자로 보고 두 문장을 모두 바르게 수행했을 것이다. 첫 문장을 틀렸으므로 격조사 이해로 볼 수 없다.\",\"4\":\"최소 거리 원리(minimal distance principle)는 보문의 주어를 가장 가까운 명사로 해석하는 전략으로, '약속하다'류 복문 이해에서 논의된다. 지문의 단순 타동사 문장과 관련이 없다.\",\"5\":\"모방 전략은 들은 말을 따라 하는 반응으로, 지문의 아동은 따라 말하지 않고 인형으로 행동을 보였다.\"}},\"2-2-2-12\":{\"p\":\"안은 문장은 한 문장이 다른 문장 속에 절(안긴 문장)로 들어간 겹문장으로, 안긴 절의 종류에 따라 명사절·관형절·부사절·서술절·인용절로 나눈다. 이 문장에서 '내일 소풍 간다'는 선생님이 한 말이며, 간접 인용의 조사 '-고'가 붙어 '하셨어'의 목적어처럼 안겨 있다(직접 인용은 '라고'). 서술어가 '간다'와 '하셨어' 둘이므로 겹문장이고, 두 절이 나란히 이어진 것이 아니라 한 절이 다른 절 속에 들어 있으므로 안은 문장이다. 인용절 사용은 일반적으로 학령전기 후반부터 늘어나는 복문 구조이다.\",\"w\":{\"1\":\"홑문장은 주어와 서술어가 한 번만 나타나는 문장이다. 이 문장에는 '간다'와 '하셨어' 두 서술어가 있어 겹문장이다.\",\"2\":\"관형절은 '-(으)ㄴ, -는, -(으)ㄹ'로 끝나 뒤의 체언을 꾸미는 절이다. '간다고'는 체언을 꾸미지 않고 남의 말을 옮긴다.\",\"3\":\"대등하게 이어진 문장은 '-고, -지만'처럼 대등 연결어미로 두 절을 나란히 잇는 문장이다. 이 문장은 한 절이 다른 절 안에 들어간 구조이다.\",\"5\":\"명사절은 '-(으)ㅁ, -기'가 붙어 문장 안에서 명사 구실을 하는 절이다. 이 문장에는 명사형 전성어미가 없다.\"}},\"2-2-2-13\":{\"p\":\"T-unit(최소 종결 단위)은 하나의 주절과 그에 딸린 종속절·내포절을 묶은 단위로, 대등하게 이어진 절은 각각 독립된 T-unit으로 나눈다. 첫째 줄 '형은 축구를 하고 / 나는 그네를 탔어'는 대등 연결 '-고'로 2개, 둘째 줄 '비가 와서 우리는 집에 갔어'는 원인의 종속 연결 '-아서'로 주절에 포함되어 1개, 셋째 줄 1개, 넷째 줄 '나는 … 닦고 / 동생은 … 마셨어'는 주어가 다른 대등 연결로 2개이다. 합계는 2+1+1+2 = 6개이다. 같은 '-고'라도 대등 연결인지 확인하고, '-아서/-어서'처럼 원인·순서를 나타내는 종속 연결은 나누지 않는다는 점이 핵심이다.\",\"w\":{\"1\":\"2개는 대등 연결이 있는 줄만 세거나 전사를 크게 두 덩어리로 묶은 값으로, 각 줄의 T-unit을 분석하지 않은 결과이다.\",\"2\":\"3개는 대등 연결 하나만 나누고 다른 하나를 나누지 않는 등 기준을 일부만 적용한 값이다.\",\"3\":\"4개는 줄(문장) 수를 그대로 센 값으로, 대등 연결어미로 이어진 절을 각각 T-unit으로 나누라는 기준을 적용하지 않았다.\",\"4\":\"5개는 대등 연결된 두 줄 중 한 줄만 나누었거나, 반대로 종속절 '비가 와서'를 따로 세고 다른 곳을 빠뜨린 값이다.\"}},\"2-2-2-14\":{\"p\":\"주제 유지(topic maintenance)는 대화 상대가 연 주제에 관련된 새 정보를 덧붙이며 여러 차례 주제를 이어 가는 능력이다. 지문에서 엄마는 '블록으로 뭐 만들었어?', '뭐 만들었는지 궁금하네'로 블록 주제를 두 번이나 다시 열지만, 아동은 공룡 이야기로 갑자기 주제를 바꾸고(부적절한 주제 전환) 끝까지 돌아오지 않는다. 아동은 매번 차례에 맞추어 대답하고 문장도 완전하므로 문제는 형식이 아니라 '관련성 있는 내용으로 주제를 잇는 것'에 있다. 자기 관심사로 주제를 반복 전환하는 양상은 화용 평가에서 특히 주의 깊게 살펴야 하는 단서이다.\",\"w\":{\"1\":\"대화 시작하기는 먼저 말을 걸어 대화를 여는 능력이다. 이 대화는 엄마가 시작했고, 아동의 문제는 시작이 아니라 열린 주제를 이어 가지 못하는 데 있다.\",\"3\":\"차례 주고받기는 화자와 청자 역할을 번갈아 맡는 능력이다. 아동은 엄마 발화마다 빠짐없이 순서를 지켜 반응하고 있다.\",\"4\":\"명료화 요구하기는 상대의 말을 이해하지 못했을 때 다시 묻는 기술이다. 지문에는 아동이 이해하지 못해 되묻는 상황이 없다.\",\"5\":\"발화 길이 늘리기는 구문 산출 목표이다. 아동의 문장은 '공룡은 고기를 먹어'처럼 5세에 맞게 완전하므로 길이가 주된 문제가 아니다.\"}},\"2-2-2-15\":{\"p\":\"명료화 요구는 상대의 말을 이해하지 못했을 때 다시 말해 달라고 요청하는 것으로, 일반적(비특정적) 요구, 특정 요구, 확인 요구로 나뉜다. 확인 요구는 청자가 자신이 이해한 내용(추측)을 제시하고 맞는지 예/아니요로 확인받는 형태이다. 지문에서 '가방'이 두 개라 지시가 모호하자 아동은 '파란 가방 말하는 거예요?'라고 후보를 직접 제시하므로 확인 요구이다. 일반적으로 일반적 요구가 가장 먼저 발달하고, 특정 요구와 확인 요구는 메시지의 어느 부분이 문제인지 파악해야 하므로 더 늦게 발달한다고 설명된다.\",\"w\":{\"1\":\"일반적(비특정적) 요구는 '응?', '뭐라고?'처럼 어느 부분을 이해하지 못했는지 밝히지 않는 요구이다. 아동은 구체적인 후보(파란 가방)를 밝혔다.\",\"2\":\"특정 요구는 '어느 가방이요?'처럼 문제 부분을 의문사로 묻는 요구이다. 아동은 의문사로 묻지 않고 자기 추측을 예/아니요로 확인받았다.\",\"4\":\"첨가 전략은 명료화 요구를 받은 화자가 정보를 덧붙여 수정하는 전략이다. 치료사의 '응, 파란 가방'이 수정에 가깝고, 아동의 발화는 요구 쪽이다.\",\"5\":\"반복 전략은 명료화 요구를 받은 화자가 자기 말을 그대로 되풀이하는 수정 전략으로, 요구하는 사람의 발화 유형이 아니다.\"}},\"2-2-2-16\":{\"p\":\"장벽 게임(barrier game)은 칸막이로 청자가 화자의 자료를 볼 수 없게 하여, 화자가 말만으로 지시 대상을 전달하게 만드는 참조적 의사소통(referential communication) 활동이다. 비슷한 그림 여러 장 중에서 하나를 고르게 하므로, 그림 이름만으로는 안 되고 다른 그림과 구별되는 변별 특징(색·크기·위치 등)을 충분하고 정확하게 말해야 한다. 이는 청자가 무엇을 알고 무엇을 모르는지 고려하는 전제(presupposition) 능력과 연결된 화용 목표이다. 치료사가 잘못 고르면 아동은 자기 설명의 부족한 부분을 확인하고 수정하는 연습도 하게 된다.\",\"w\":{\"1\":\"문법형태소를 정확히 산출하는 것은 형태·구문 목표이다. 이 활동의 성공 여부는 형태소의 정확성이 아니라 청자가 같은 그림을 고르는지에 달려 있다.\",\"3\":\"사건을 시간 순서대로 배열하는 것은 이야기 구성(서사) 목표이다. 지문의 활동은 이야기가 아니라 그림 한 장을 구별되게 설명하는 과제이다.\",\"4\":\"낱말의 음절 수를 세는 것은 음운인식 목표로, 그림의 의미적 특징을 설명하는 이 활동과 관련이 없다.\",\"5\":\"이름을 빠르게 인출하는 것은 낱말찾기(이름대기) 목표이다. 비슷한 그림 중에서 고르게 하므로 이름만 말해서는 청자가 그림을 구별할 수 없다.\"}},\"2-2-2-17\":{\"p\":\"그라이스(Grice)는 협력의 원리 아래 질(quality), 양(quantity), 관계(relation), 태도(manner)의 네 격률을 제시했다. 양의 격률은 대화의 목적에 필요한 만큼만, 그 이상도 이하도 아니게 정보를 주라는 원칙이다. '재밌었어?'는 짧은 평가를 요구하는 질문인데 아동은 장면과 대사를 10분 넘게 늘어놓아 필요한 양을 크게 넘겼고, 친구가 자리를 뜨려는 비언어 신호도 알아채지 못했다. 내용이 영화에 관한 것이므로 주제 관련성(관계)은 지켜졌다는 점이 다른 격률과 구분하는 단서이다.\",\"w\":{\"1\":\"질의 격률은 거짓이거나 근거 없는 말을 하지 말라는 원칙이다. 지문에는 아동의 말이 사실과 다르다는 단서가 없다.\",\"2\":\"관계의 격률은 대화 주제와 관련된 말을 하라는 원칙이다. 아동은 질문받은 영화에 대해 말하고 있으므로 주제 관련성은 지켰다.\",\"3\":\"태도의 격률은 모호하거나 순서 없이 말하지 말고 명료하게 말하라는 원칙이다. 아동은 영화를 처음부터 끝까지 순서대로 이야기했다.\",\"4\":\"공손의 격률은 리치(Leech)의 공손 원리에 속하는 개념으로 그라이스의 네 격률에 포함되지 않는다.\"}},\"2-2-2-18\":{\"p\":\"애플비(Applebee)는 아동 이야기 발달을 무더기 → 연속 → 원시 서사 → 초점 없는 연쇄 → 초점 연쇄 → 진정한 이야기의 6단계로 설명했다. 무더기(heaps)는 중심 인물·주제도, 사건 간 시간·인과 연결도 없이 눈에 띄는 것을 늘어놓는 가장 초기 단계이다. 지문의 '강아지가 있어. 자동차도 있어. … 나무도 있어.'는 그림 속 대상을 나열할 뿐 공통 인물이나 주제로 묶이지 않으므로 무더기에 해당한다. 단계 판단은 '중심 인물/주제가 있는가', '사건이 시간·인과로 이어지는가', '결말이 있는가'를 차례로 확인하면 된다.\",\"w\":{\"2\":\"연속 단계는 중심 인물이나 주제(예: 강아지의 하루)를 중심으로 사건을 나열하지만 시간·인과 연결은 없는 단계이다. 지문은 공통 인물이나 주제조차 없다.\",\"3\":\"원시 서사는 중심 인물·사건을 중심으로 이야기가 조직되고 인물의 감정·동기가 일부 드러나는 단계로, 지문의 단순 나열보다 발달한 형태이다.\",\"4\":\"초점 연쇄는 중심 인물을 따라 사건이 시간·인과로 연결되지만 결말이 뚜렷하지 않은 단계이다. 지문에는 사건 간 연결이 전혀 없다.\",\"5\":\"진정한 이야기는 중심 인물, 사건의 인과적 연결, 문제와 해결(결말)을 모두 갖춘 가장 높은 단계로, 지문의 나열과 거리가 멀다.\"}},\"2-2-2-19\":{\"p\":\"스타인과 글렌(Stein & Glenn)의 이야기 문법은 배경과 에피소드로 구성되며, 에피소드 요소는 계기 사건, 내적 반응, 시도, 직접 결과, 반응 등으로 나뉜다. 일반적으로 완전한 에피소드의 필수 요소는 계기 사건-시도-결과로 설명되며, 이 중 시도는 문제를 해결하려는 인물의 행동이다. 지문을 요소별로 대응하면 숲속 토끼(배경), 모자가 날아감(계기 사건), 슬픔(내적 반응), 모자 없이 돌아옴(결과)이 있으나, 모자를 쫓아가거나 찾는 등의 행동이 없다. 따라서 시도를 보충해야 결과가 인물의 행동에서 비롯된 완전한 에피소드가 된다. 에피소드의 세부 구분과 명칭은 교재에 따라 약간씩 다르다.\",\"w\":{\"1\":\"배경은 '옛날에 숲속에 토끼가 살았어요'로 이미 제시되어 있어 보충할 요소가 아니다.\",\"2\":\"계기 사건은 이야기를 움직이는 문제 사건으로, '아끼던 모자가 바람에 날아갔어요'가 이에 해당해 이미 있다.\",\"3\":\"내적 반응은 사건에 대한 인물의 감정·생각으로, '토끼는 너무 슬펐어요'가 이에 해당해 이미 있다.\",\"5\":\"결과는 이야기의 결말로, '결국 토끼는 모자 없이 집에 돌아왔어요'가 이에 해당해 이미 있다.\"}},\"2-2-2-20\":{\"p\":\"설명담화(expository discourse)는 정보를 전달하는 글로, 일반적으로 나열(기술), 시간 순서, 비교·대조, 원인·결과, 문제·해결 등의 구조로 나눈다. 비교·대조 구조는 둘 이상의 대상을 같은 기준으로 견주어 공통점과 차이점을 밝히는 구조이다. 지문은 첫 문장에서 공통점(둘 다 양서류)을 제시하고, 이어서 피부와 이동 방식이라는 같은 기준으로 개구리와 두꺼비의 차이를 대응시킨다. '모두', '-지만', '-고'로 두 대상을 짝지어 대비하는 표현이 구조를 알려 주는 신호어이며, 이런 신호어 지도는 학령기 읽기 이해 중재에 자주 쓰인다.\",\"w\":{\"1\":\"나열(기술) 구조는 한 대상의 특징을 차례로 늘어놓는 구조이다. 지문은 한 대상의 특징 나열이 아니라 두 대상을 같은 기준으로 견준다.\",\"2\":\"시간 순서 구조는 절차나 사건을 일어난 순서대로 제시하는 구조로, '먼저, 다음에' 같은 신호어가 쓰인다. 지문에는 시간 흐름이 없다.\",\"4\":\"원인·결과 구조는 사건 사이의 인과 관계를 설명하는 구조로, '때문에, 그래서' 같은 신호어가 쓰인다. 지문은 인과를 다루지 않는다.\",\"5\":\"문제·해결 구조는 문제 상황과 해결 방안을 제시하는 구조이다. 지문에는 해결할 문제가 제시되지 않는다.\"}},\"2-2-2-21\":{\"p\":\"평균 T-unit 길이(MLT)는 총 낱말 수를 T-unit 수로 나눈 값으로, 한 T-unit 안에 종속절·내포절·수식어가 많을수록 길어지므로 학령기 구문 복잡성의 대표 지표이다. 이야기 분석 지표는 흔히 미시구조(낱말·문장 수준: 생산성, 어휘 다양성, 구문 복잡성)와 거시구조(이야기 문법, 결속·응집)로 나누어 정리한다. 총 낱말 수는 생산성, 서로 다른 낱말 수는 어휘 다양성, 이야기 문법 요소는 거시구조, 결속 표지는 담화 결속을 반영한다. 지표가 '무엇을 세는가'를 떠올리면 반영 영역을 쉽게 짝지을 수 있다.\",\"w\":{\"1\":\"이야기 문법 요소 수는 배경·계기 사건·시도·결과 등 이야기의 거시구조(조직)를 반영하는 지표로, 구문 복잡성 지표가 아니다.\",\"2\":\"총 낱말 수(NTW)는 얼마나 많이 말했는지를 보는 생산성 지표이다. 어휘 다양성은 서로 다른 낱말 수(NDW)나 TTR로 본다.\",\"3\":\"서로 다른 낱말 수(NDW)는 어휘 다양성 지표이다. 이야기 구조는 이야기 문법 요소나 애플비 단계 등으로 평가한다.\",\"4\":\"결속 표지(접속어, 지시어 등) 사용의 적절성은 담화의 결속(응집) 능력을 반영하는 지표로, 구문 길이와 관련이 없다.\"}},\"2-2-2-22\":{\"p\":\"에리(Ehri)는 낱말 읽기 발달을 자모 이전(pre-alphabetic) → 부분적 자모 → 완전한 자모 → 통합된(굳어진) 자모 단계로 설명하며, 교재에 따라 자동화 단계를 더하기도 한다. 자모 이전 단계는 글자-소리 대응 지식 없이 로고 모양, 색, 글자 테두리 같은 시각적 단서로 낱말을 '알아보는' 단계이다. 지문의 결정적 단서는 같은 이름도 로고가 아닌 일반 글씨로 쓰면 읽지 못한다는 점으로, 아동이 글자 자체가 아니라 시각적 맥락을 읽고 있음을 보여 준다. 여기에 글자-소리 대응을 아직 모른다는 정보가 더해져 자모 이전 단계로 판단된다.\",\"w\":{\"2\":\"부분적 자모 단계는 첫 글자나 받침 등 일부 자소-음소 단서를 활용해 낱말을 읽는 단계이다. 이 아동은 글자-소리 대응을 아직 알지 못한다.\",\"3\":\"완전한 자모 단계는 낱말의 모든 자소를 음소로 바꾸어 해독하는 단계로, 처음 보는 낱말도 소리 내어 읽을 수 있다. 지문의 아동과 맞지 않는다.\",\"4\":\"통합된 자모 단계는 자주 나오는 글자 덩이(음절, 형태소)를 하나의 단위로 처리해 빠르게 읽는 단계로, 해독 능력이 이미 갖추어진 뒤에 온다.\",\"5\":\"유창성 단계는 찰(Chall)의 읽기 발달 단계에서 쓰는 용어로, 에리의 낱말 읽기 단계에 속하지 않으며 해독이 자동화된 이후의 단계이다.\"}},\"2-2-2-23\":{\"p\":\"이중경로 모형에서 낱말 읽기는 자소-음소 대응 규칙을 적용하는 음운(비어휘) 경로와 낱말 전체를 시각 어휘로 인식하는 어휘 경로로 이루어진다. 표층성 난독은 음운 경로는 비교적 유지되지만 어휘 경로가 약해, 규칙대로 읽으면 틀리는 낱말을 글자 그대로 읽는 '규칙화 오류'가 나타나는 양상이다. 한국어에서는 연음·구개음화·비음화 등 음운 변동이 일어나는 자소-음소 불일치 낱말이 이에 해당하며, '해돋이'[해도지], '먹는'[멍는]을 [해도디], [먹는]으로 읽는 것이 그 예이다. 무의미 낱말과 규칙 낱말 읽기는 정상이라는 점이 음운 경로가 유지된다는 단서이다.\",\"w\":{\"1\":\"음운성 난독은 음운 경로 손상으로 무의미 낱말 읽기가 특히 어려운 유형이다. 이 아동은 무의미 낱말 읽기 정확도가 또래 수준이다.\",\"2\":\"이해 부진은 해독은 정상이나 읽은 내용을 이해하지 못하는 유형으로, 평가 정보가 낱말 해독 오류에 관한 것이어서 맞지 않는다.\",\"3\":\"심층성 난독은 무의미 낱말을 거의 읽지 못하고 '바다'를 '강'으로 읽는 것 같은 의미 착오가 나타나는 유형으로, 지문의 양상과 다르다.\",\"5\":\"혼합형 난독은 음운 경로와 어휘 경로가 모두 손상된 유형이다. 이 아동은 무의미 낱말과 규칙 낱말을 정확히 읽어 음운 경로가 유지된다.\"}},\"2-2-2-24\":{\"p\":\"산출 기준이 '1분당 바르게 읽은 어절 수(WCPM에 해당)'이므로 오류 어절을 먼저 빼고 시간으로 나눈다. 바르게 읽은 어절 수는 130 − 10 = 120어절이고, 읽은 시간 2분으로 나누면 120 ÷ 2 = 60어절이다. 검산으로 1분당 읽은 어절 65(130 ÷ 2)에서 1분당 오류 5(10 ÷ 2)를 빼도 60으로 같다. 이 지표는 정확도와 속도를 함께 반영하므로, 빠르게 읽어도 오류가 많으면 값이 낮아진다.\",\"w\":{\"2\":\"65어절은 오류를 빼지 않고 전체 어절 수를 시간으로만 나눈 값(130 ÷ 2)으로, 바르게 읽은 어절만 세라는 기준을 놓쳤다.\",\"3\":\"70어절은 오류 어절을 빼지 않고 오히려 더한 값((130 + 10) ÷ 2)으로, 계산 방향을 잘못 잡은 실수이다.\",\"4\":\"120어절은 바르게 읽은 어절 수만 구하고 2분으로 나누지 않은 값으로, '1분당'이라는 기준을 적용하지 않았다.\",\"5\":\"130어절은 오류를 빼지도, 시간으로 나누지도 않은 2분 동안의 전체 어절 수 그대로이다.\"}},\"2-2-2-25\":{\"p\":\"상보적 교수(reciprocal teaching)는 팰린사와 브라운(Palincsar & Brown)이 제안한 읽기 이해 전략 교수로, 예측하기·질문 만들기·명료화하기·요약하기의 네 전략을 대화를 통해 익히게 한다. 지문의 단서는 네 전략이 모두 나타난다는 점과, 처음에는 교사가 시범을 보이다가 점차 학생이 교사 역할을 넘겨받는 점(비계 설정 후 책임 이양)이다. 이 기법은 해독은 되지만 이해가 부족한 학령기 아동에게 특히 쓰이며, 소집단에서 서로 역할을 바꾸어 진행한다. 해독·유창성 중재(파닉스, 반복 읽기)와는 목표 수준이 다르다는 점을 구분해 두어야 한다.\",\"w\":{\"1\":\"반복 읽기는 같은 글을 여러 번 소리 내어 읽어 읽기 유창성(속도·정확도·운율)을 높이는 기법으로, 예측·질문·명료화·요약 전략을 쓰지 않는다.\",\"2\":\"파닉스 직접 교수는 자소-음소 대응 규칙을 명시적으로 가르치는 해독 중재로, 글의 내용 이해 전략을 다루지 않는다.\",\"4\":\"그래픽 조직자는 글의 구조나 개념 관계를 도표·지도로 시각화하는 이해 지원 도구로, 네 가지 전략과 역할 교대라는 지문의 절차와 다르다.\",\"5\":\"음운 합성 훈련은 음소·음절을 합쳐 낱말을 만드는 음운인식(해독 기초) 중재로, 글 이해 전략과 관련이 없다.\"}},\"2-2-2-26\":{\"p\":\"DSM-5에서 ASD는 사회적 의사소통·상호작용 결함(A)과 제한적·반복적 행동·관심·활동(B)을 모두 갖추어야 하고, SCD는 사회적(화용적) 의사소통 결함만 있고 제한적·반복적 행동이 없어야 진단한다. 따라서 화용 결함은 두 진단에 공통(㉡)이고, 제한적·반복적 행동(감각 반응 이상, 동일성 고집, 제한된 관심 등)은 ASD에만(㉠) 해당한다. '상황·청자에 맞게 말하는 방식을 바꾸기 어려움'은 SCD 진단 기준의 화용 결함 항목이면서 ASD의 사회적 의사소통 결함에도 포함되므로 ㉡이다. 보기마다 그 특성이 '사회적 의사소통 결함'인지 '제한적·반복적 행동'인지 먼저 분류하면 영역이 정해진다.\",\"w\":{\"1\":\"감각 자극에 대한 과잉·과소 반응은 DSM-5에서 제한적·반복적 행동(B 기준)에 포함되며, SCD에는 이것이 없어야 하므로 ASD에만 해당하는 ㉠이다.\",\"2\":\"같은 일과 고집과 변화에 대한 저항은 동일성 고집으로 제한적·반복적 행동에 속하므로 SCD에만 해당하는 ㉢이 아니라 ASD에만 해당하는 ㉠이다.\",\"3\":\"비유적·암시적 의미 이해의 어려움은 SCD 진단 기준의 화용 결함에 들어 있으므로 ASD에만 해당하는 ㉠이 될 수 없고, 두 진단 공통 영역에 가깝다.\",\"4\":\"특정 대상에 대한 강하고 제한된 관심은 제한적·반복적 행동에 속해 SCD에는 나타나지 않아야 하므로 공통 영역 ㉡이 아니라 ASD에만 해당하는 ㉠이다.\"}},\"2-2-2-27\":{\"p\":\"윌리엄스증후군은 7번 염색체(7q11.23) 미세결실로 생기며, 경도~중등도 지적장애가 있지만 인지 프로파일이 고르지 않은 것이 특징이다. 지문의 네 단서가 모두 이 증후군을 가리킨다: 시공간 구성 능력의 두드러진 저하, 상대적으로 풍부한 어휘와 표정·억양을 살린 생생한 이야기, 낯선 사람에게도 거리낌 없이 다가가는 과도한 친화성, 대동맥판 위 협착(SVAS)이라는 특징적 심장 질환. 다만 언어가 '상대적으로' 양호할 뿐 화용(대화 맥락 이해, 주제 유지)에는 어려움이 흔하다는 점도 함께 알아 둔다.\",\"w\":{\"1\":\"다운증후군(21번 삼염색체)은 수용언어보다 표현언어와 구문이 특히 지연되고 조음 명료도가 낮은 것이 특징이어서, 풍부한 어휘·생생한 이야기라는 지문과 맞지 않는다.\",\"3\":\"취약X증후군은 남아에서 흔하며 시선 회피, 사회적 불안, 보속적·반복적 발화가 특징이어서, 과도한 친화성을 보이는 지문의 아동과 다르다.\",\"4\":\"프래더-윌리증후군(15번 염색체 이상)은 영아기 근긴장 저하, 이후 과식·비만, 강박적 행동이 특징이며, 대동맥판 위 협착이나 과도한 친화성과 관련이 없다.\",\"5\":\"레트증후군은 주로 여아에게 나타나며 초기 정상 발달 후 언어·손 기능이 퇴행하고 손 비틀기 같은 상동 행동이 나타나므로 지문과 맞지 않는다.\"}},\"2-2-2-28\":{\"p\":\"말 늦은 아동(late talker)은 일반적으로 24개월 무렵 표현 어휘가 적거나(예: 50낱말 미만) 낱말 조합이 나타나지 않는 아동을 가리키며, 상당수는 이후 또래 수준을 따라잡는다. 그러나 표현언어뿐 아니라 수용언어도 지연된 경우는 언어 체계 전반의 어려움을 시사해 언어장애로 지속될 위험이 더 높다고 보고된다. 그 밖의 위험 요인으로는 몸짓 사용이 적음, 상징놀이 지연, 모방이 드묾, 언어장애 가족력 등이 흔히 제시된다. 따라서 보기 중 위험을 높이는 요인은 ①뿐이고 나머지는 모두 예후가 좋은 쪽의 요인이다. 위험 요인 목록과 기준은 연구·교재에 따라 조금씩 다르다.\",\"w\":{\"2\":\"가리키기 등 몸짓을 활발히 쓰는 것은 의사소통 의도와 상징 능력이 있다는 뜻으로, 따라잡을 가능성이 높은 좋은 예후 요인이다.\",\"3\":\"상징놀이가 또래 수준인 것은 표상 능력이 정상적으로 발달하고 있다는 단서로, 예후가 좋은 쪽의 요인이다.\",\"4\":\"새 낱말을 자발적으로 자주 모방하는 것은 낱말 학습 시도가 활발하다는 뜻으로, 예후가 좋은 쪽의 요인이다.\",\"5\":\"언어장애 가족력은 위험 요인이므로, 가족력이 없다는 것은 오히려 예후가 좋은 쪽의 요인이다.\"}},\"2-2-2-29\":{\"p\":\"순차적 이중언어 아동은 제1언어가 확립된 뒤 제2언어를 배우며, 일반적으로 모국어 사용 → 침묵기(비언어 시기) → 전보식·공식화된 표현 → 생산적 사용의 단계를 거친다고 설명된다. 침묵기에는 새 언어로 거의 말하지 않지만 듣고 이해하는 능력이 쌓이며, 기간은 아동에 따라 몇 주에서 수개월까지 다양하다. 지문의 단서는 모국어가 또래 수준이라는 점(언어 학습 능력 자체는 정상), 한국어 노출이 4개월로 짧다는 점, 말은 거의 없지만 몸짓 단서와 함께 지시 따르기가 늘고 있다는 점(이해 발달)이다. 이중언어 아동의 언어장애는 두 언어 모두에서 어려움이 있는지로 판단해야 한다.\",\"w\":{\"1\":\"모국어로 또래 수준의 대화를 하므로 두 언어 모두 지연되었다는 전제가 틀렸으며, 한국어만의 제한은 노출 부족으로 설명된다.\",\"2\":\"선택적 함묵증은 말하기가 요구되는 상황의 침묵이 새 언어에 대한 지식 부족으로 설명될 때는 진단하지 않으므로, 제2언어 노출 초기의 침묵을 곧바로 함묵증으로 볼 수 없다.\",\"3\":\"모국어 사용을 중단하면 오히려 가정 내 의사소통과 개념 발달이 위축될 수 있으며, 탄탄한 모국어는 제2언어 습득의 기반이 된다고 본다.\",\"5\":\"노출 기간이 짧은 언어의 표준화 검사는 대개 단일언어 아동을 기준으로 만들어져, 그 점수만으로 진단하면 장애로 과잉 판별할 위험이 크다.\"}},\"2-2-2-30\":{\"p\":\"임상적 표지(clinical marker)는 장애가 있는 아동과 정상 아동을 민감하게 구별해 주는 과제나 특징을 말한다. 비단어 따라말하기는 처음 듣는 무의미 낱말을 따라 말하게 하므로 기존 어휘 지식의 영향을 줄이고 음운 작업기억(음운 단기기억)과 음운 처리 능력을 반영한다. 단순언어장애 아동은 다양한 언어에서 이 과제를 일관되게 낮게 수행해 대표적 임상적 표지로 보고되며, 영어권에서는 시제 표지 산출 등도 함께 거론된다. 최근 발달성 언어장애(DLD) 개념에서는 비언어성 지능 기준을 엄격히 요구하지 않는 등 정의가 교재에 따라 다르게 제시되기도 한다.\",\"w\":{\"1\":\"수용 어휘 이해 과제는 누적된 어휘 지식과 언어 경험의 영향을 크게 받아, 단순언어장애를 민감하게 가려내는 임상적 표지로 보고되지 않는다.\",\"2\":\"낱말 수준 조음 검사는 말소리 산출(조음·음운) 능력을 평가하는 도구로, 언어 능력의 결함을 판별하는 표지가 아니다.\",\"4\":\"단순언어장애는 전통적으로 비언어성 지능이 정상 범위인 것을 전제로 정의하므로, 이 과제로는 정상 아동과 구별되지 않는다.\",\"5\":\"도형 재인 과제는 비언어적 시지각·기억 과제로, 언어 처리 결함을 반영하지 않아 단순언어장애의 판별 표지가 되지 못한다.\"}},\"2-2-2-31\":{\"p\":\"확대(extension)는 아동 발화의 의미를 유지하면서 새로운 의미 정보(속성, 방법, 장소 등)를 덧붙여 들려주는 기법이다. 아동의 '차 가'에 치료사는 '빨간(속성)', '빨리(방법)'라는 새 의미 요소를 더해 '빨간 차가 빨리 가네'로 들려주었다. 문법적으로 '-가'도 함께 채워졌지만, 판별의 핵심은 아동이 말하지 않은 '새 정보가 추가되었는가'이며 추가되었으면 확대로 본다. 확장(expansion)은 새 정보 없이 문법만 완전하게 고쳐 주는 것(예: '차가 가')이다. 교재에 따라 expansion과 extension의 우리말 번역(확장/확대)을 반대로 쓰기도 하므로 영문 용어로 함께 기억해 두는 것이 안전하다.\",\"w\":{\"1\":\"확장(expansion)은 새 의미 정보 없이 아동 발화를 문법적으로 완전한 형태로만 고쳐 들려주는 것이다. 치료사는 '빨간', '빨리'라는 새 정보를 덧붙였다.\",\"2\":\"혼잣말(self-talk)은 치료사가 자기 행동을 말로 표현하는 기법이다. 치료사의 발화는 자기 행동이 아니라 아동의 발화와 행동에 대한 반응이다.\",\"3\":\"재구성(recast)은 아동 발화의 의미를 살리되 문장 유형이나 구조를 바꾸어(예: 평서문을 의문문으로) 들려주는 기법으로, 새 의미를 덧붙이는 지문과 다르다.\",\"4\":\"모방은 아동의 발화나 행동을 그대로 따라 하는 기법이다. 치료사는 '차 가'를 그대로 따라 하지 않고 내용을 더했다.\"}},\"2-2-2-32\":{\"p\":\"환경중심 언어중재(milieu teaching)의 주요 절차는 아동 주도 시범, 요구-모델, 시간 지연, 우발 교수이다. 우발 교수(incidental teaching)는 아동이 먼저 요구를 시작한 순간을 계기로 삼아, 성인이 질문·시범 등으로 더 정교한 표현을 유도한 뒤 원하는 것을 주는 절차이다. 지문에서 치료사는 비눗방울을 손이 닿지 않는 곳에 두어 요구 상황을 만들었고, 아동이 가리키며 쳐다보는 것(아동의 시작) 이후에야 '뭐 줄까?'와 시범 '비눗방울 줘'가 이어진다. 절차를 구분하는 핵심은 '누가 먼저 시작했는가'로, 아동의 시작에 반응해 이루어지면 우발 교수이다.\",\"w\":{\"2\":\"요구-모델은 아동이 시작하기 전에 성인이 먼저 아동의 관심 대상을 보고 말하도록 요구하는 절차이다. 지문에서는 아동의 가리키기가 먼저 나왔다.\",\"3\":\"시간 지연은 성인이 말없이 기대하는 표정으로 기다려 아동의 시작을 유도하는 절차이다. 치료사는 기다리지 않고 바로 질문과 시범을 제시했다.\",\"4\":\"비연속 시행 훈련은 치료사가 자극-반응-강화를 정해진 순서로 반복하는 구조화된 행동주의 기법으로, 아동의 자연스러운 시작을 활용하는 지문과 다르다.\",\"5\":\"공동 행동 일과는 성인과 아동이 역할을 나누어 반복되는 일과(예: 간식 만들기)를 함께 수행하며 언어를 익히는 접근으로, 지문의 단일 요구 상황과 다르다.\"}},\"2-2-2-33\":{\"p\":\"PECS(Picture Exchange Communication System)는 일반적으로 1단계 교환 방법 익히기 → 2단계 거리와 지속성 늘리기 → 3단계 그림 변별 → 4단계 문장 구성 → 5단계 질문에 반응하여 요구하기 → 6단계 질문에 반응하여 언급하기의 순서로 진행된다. 2단계에서는 의사소통 책과 의사소통 상대 사이의 거리를 늘려, 아동이 스스로 책까지 가서 그림을 떼고 상대에게 다가가 건네는 자발성과 지속성을 키운다. 지문의 단서는 책이 떨어진 탁자 위에 있고 교사도 방 반대편에 있는데 아동이 혼자 이동해 교환한다는 점, 그리고 여러 그림 중 고르는 훈련(3단계)은 아직 시작하지 않았다는 점이다.\",\"w\":{\"1\":\"1단계는 가까이 있는 그림 한 장을 집어 상대 손에 건네는 교환 자체를 신체적 촉진으로 익히는 단계이다. 지문의 아동은 이미 먼 거리에서 스스로 교환한다.\",\"3\":\"3단계는 여러 그림 중 원하는 그림을 변별해 고르는 단계인데, 지문에서 이 훈련은 아직 시작하지 않았다고 밝혔다.\",\"4\":\"4단계는 '나는 원해요' 카드와 대상 그림을 문장 띠에 붙여 문장으로 요구하는 단계로, 지문에는 문장 띠가 나오지 않는다.\",\"5\":\"5단계는 '뭘 원하니?'라는 질문에 반응해 문장 띠로 요구하는 단계로, 그림 변별과 문장 구성을 거친 뒤에 진행된다.\"}},\"2-2-2-34\":{\"p\":\"AAC의 선택 기법은 크게 직접 선택(손가락, 헤드 포인터, 시선 등으로 원하는 항목을 직접 지시)과 훑기(scanning, 항목이 차례로 강조될 때 스위치 등으로 선택)로 나뉜다. 훑기는 직접 선택이 어렵지만 한두 가지 신뢰할 만한 동작(스위치 누르기)이 가능한 사용자에게 쓰이며, 속도는 느리지만 운동 요구가 적다. 지문의 단서는 손·팔로 직접 가리킬 수 없고, 머리로 스위치를 안정적으로 누를 수 있으며, 상징을 이해하고 고르는 인지 능력이 있다는 점이다. 훑기는 항목이 강조되는 순서를 기다렸다가 정확한 시점에 반응해야 하므로 이런 인지·주의 능력이 갖추어져 있다는 정보가 중요하다.\",\"w\":{\"1\":\"손으로 그림을 가리키는 직접 선택은 손·팔의 정확한 움직임이 필요한데, 이 아동은 손으로 직접 가리킬 수 없다.\",\"2\":\"수어·몸짓 같은 비도구적 체계는 손과 팔의 움직임에 크게 의존하므로, 손·팔 움직임이 매우 제한된 아동에게 적합하지 않다.\",\"3\":\"키보드 철자 입력은 손가락의 정교한 운동이 필요한 직접 선택이며, 철자 능력도 요구되어 지문의 아동에게 맞지 않는다.\",\"5\":\"그림카드를 집어 건네는 교환(PECS 방식)은 손으로 카드를 잡고 옮기는 동작이 필요해 손 움직임이 제한된 아동에게 어렵다.\"}},\"2-2-2-35\":{\"p\":\"대화식 책 읽기(dialogic reading)는 성인이 책을 읽어 주기만 하지 않고 질문으로 아동의 말을 끌어내어 아동을 이야기의 화자로 만드는 공동 책 읽기 방법이다. 핵심 절차 PEER는 반응 유도(Prompt) → 평가(Evaluate) → 확장(Expand) → 반복 유도(Repeat)이다. 지문에 대응하면 '이건 뭐야?'(유도), '맞아'(평가), '갈색 곰이네'(확장), '갈색 곰 말해 볼래?'(반복)이며, 이어지는 '곰이 어디에 가는 것 같아?'는 개방형 질문으로 대화를 이어 간다. 유도 질문은 흔히 CROWD(완성, 회상, 개방형, 의문사, 경험 연결)로 정리되며, 학령전기 어휘·표현언어 향상에 효과가 보고되어 있다.\",\"w\":{\"1\":\"반복 읽기는 같은 글을 여러 번 소리 내어 읽어 읽기 유창성을 높이는 기법으로, 질문-평가-확장-반복이 오가는 지문의 대화와 다르다.\",\"2\":\"상보적 교수는 학령기 학생이 예측·질문·명료화·요약 전략을 번갈아 이끄는 읽기 이해 전략 교수로, 어린 아동과 그림책을 보는 지문의 방식과 다르다.\",\"4\":\"음운 인식 훈련은 음절·음소를 세거나 합치고 나누는 활동이다. 지문의 부모는 말소리 단위가 아니라 그림의 의미와 표현을 다룬다.\",\"5\":\"파닉스 직접 교수는 자소-음소 대응 규칙을 명시적으로 가르치는 해독 중재로, 글자를 읽지 않는 지문의 그림책 대화와 관련이 없다.\"}},\"2-2-2-36\":{\"p\":\"구개음화는 받침 ㄷ·ㅌ이 형식형태소(조사·접사)의 모음 ㅣ나 반모음 j 앞에서 경구개음 [ㅈ]·[ㅊ]으로 바뀌는 현상이다. '굳이'는 어간 '굳-'에 접사 '-이'가 붙은 형태로, 받침 ㄷ이 ㅣ 앞에서 [ㅈ]이 된 뒤 연음되어 [구지]가 된다. 같은 ㅣ 앞이라도 '마디'처럼 한 형태소 안에 있거나 '밭이랑[반니랑]'처럼 실질형태소가 이어지는 경우에는 구개음화가 일어나지 않는다는 점이 판단 단서이다. 보기를 볼 때는 바뀐 소리의 방향(비음 → 유음인지, 장애음 → 비음인지, 평음+ㅎ → 격음인지)을 먼저 확인하면 규칙 이름을 쉽게 가를 수 있다.\",\"w\":{\"1\":\"'신라'는 비음 ㄴ이 뒤의 유음 ㄹ에 동화되어 [ㄹ]로 바뀌는 유음화이다. 비음화는 장애음이 비음 앞에서 비음으로 바뀌는 현상으로 방향이 반대이다.\",\"2\":\"'밥물'은 받침 ㅂ이 뒤의 비음 ㅁ 앞에서 [ㅁ]으로 바뀌는 비음화이다. 유음화는 ㄴ이 ㄹ 앞뒤에서 [ㄹ]로 바뀌는 현상이다.\",\"4\":\"'좋고'는 받침 ㅎ과 뒤의 평음 ㄱ이 합쳐져 격음 [ㅋ]이 되는 격음화(유기음화)이다. 모음 ㅣ 앞에서 ㄷ·ㅌ이 ㅈ·ㅊ으로 바뀌는 구개음화와는 관련이 없다.\",\"5\":\"'입학'은 받침 ㅂ과 ㅎ이 합쳐져 격음 [ㅍ]이 되는 격음화이다. 비음이 산출되지 않으므로 비음화로 볼 수 없다.\"}},\"2-2-2-37\":{\"p\":\"'꽃잎'은 '꽃'+'잎'의 합성어로, 앞말이 자음으로 끝나고 뒷말이 '이'로 시작해 ㄴ첨가 조건을 충족한다. 규칙 적용 순서를 따라가면 꽃잎 → (ㄴ첨가) 꽃닙 → (평파열음화: 받침 ㅊ이 [ㄷ]) 꼳닙 → (비음화: ㄷ이 비음 ㄴ 앞에서 [ㄴ]) [꼰닙]이 된다. IPA에서는 초성 경음 ㄲ을 [k͈]로 적고, 어말 받침 ㅂ은 터뜨리지 않는 불파음이므로 [p̚]로 적는다. 한글 전사와 IPA 전사가 모두 맞아야 하므로, 한글이 옳더라도 IPA의 경음 표시나 받침 처리가 틀리면 오답이 된다는 점에 주의한다.\",\"w\":{\"1\":\"'꽃이[꼬치]'처럼 조사가 붙을 때의 연음 방식을 적용한 형태이다. '잎'은 실질형태소이므로 연음되지 않고 ㄴ이 첨가되어야 한다.\",\"2\":\"ㄴ첨가와 평파열음화까지만 적용한 중간 단계이다. 받침 [ㄷ]이 뒤의 비음 ㄴ 앞에서 [ㄴ]으로 바뀌는 비음화가 빠졌다.\",\"3\":\"한글 전사 [꼰닙]은 맞지만 IPA에서 초성 경음 ㄲ을 평음 [k]로 적어, 경음 구별기호 [͈]가 빠졌다.\",\"4\":\"받침이 아예 사라진 형태로, 표준 발음에서 일어나는 어떤 음운규칙으로도 설명되지 않는다. 받침 ㅊ은 [ㄷ]을 거쳐 [ㄴ]으로 남아야 한다.\"}},\"2-2-2-38\":{\"p\":\"지속성(continuant) 자질은 조음할 때 구강 안의 통로가 완전히 막히는지로 가른다. 완전히 막지 않고 좁힌 틈으로 기류가 계속 흐르는 마찰음은 [+지속성], 한 번 완전히 막는 파열음·파찰음은 [-지속성]이다. 한국어 마찰음은 ㅅ, ㅆ, ㅎ 셋이므로 이들만 묶인 보기가 정답이다. 파찰음은 마찰 단계를 포함하지만 시작이 완전 폐쇄이므로 [-지속성]으로 분류한다는 점이 가장 헷갈리는 부분이며, 비음은 구강이 막히므로 일반적으로 [-지속성]으로 본다(유음 ㄹ의 분류는 교재에 따라 설명이 다를 수 있다).\",\"w\":{\"1\":\"ㅅ·ㅎ은 마찰음이지만 ㅈ은 완전 폐쇄 후 마찰로 개방되는 파찰음이므로 [-지속성]이다.\",\"2\":\"ㅅ·ㅆ은 마찰음이지만 ㄷ은 구강을 완전히 막았다 터뜨리는 파열음이므로 [-지속성]이다.\",\"3\":\"ㅆ·ㅎ은 마찰음이지만 ㅊ은 파찰음이라 폐쇄 단계가 있어 [-지속성]이다.\",\"5\":\"ㅅ·ㅎ은 마찰음이지만 ㅂ은 양순 파열음이므로 [-지속성]이다.\"}},\"2-2-2-39\":{\"p\":\"단모음은 혀의 앞뒤 위치(전설·후설), 입술 모양(평순·원순), 혀의 높이(고·중·저)의 세 기준으로 분류한다. ㅓ /ʌ/는 혀의 뒤쪽이 중간 높이로 올라가고 입술을 둥글게 하지 않으므로 후설·평순·중모음이다. 같은 후설 중모음인 ㅗ /o/와는 입술 모양(원순)만 다르고, 같은 후설 평순인 ㅡ /ɯ/와는 혀 높이(고모음)만 다르므로 세 기준을 하나씩 대조하며 확인하는 것이 좋다. 참고로 ㅏ는 교재에 따라 후설 또는 중설 저모음으로 분류하기도 한다.\",\"w\":{\"1\":\"ㅡ /ɯ/는 후설 고모음이지만 입술을 둥글게 하지 않는 평순 모음이다. 후설 원순 고모음은 ㅜ /u/이다.\",\"3\":\"ㅐ /ɛ/는 전설 평순 모음이지만 혀 높이가 낮은 저모음이다. 전설 평순 고모음은 ㅣ /i/이다.\",\"4\":\"ㅗ /o/는 원순 중모음이지만 혀의 뒤쪽이 올라가는 후설 모음이다. 전설 원순 중모음은 ㅚ /ø/(단모음으로 발음할 때)에 해당한다.\",\"5\":\"ㅏ /a/는 저모음이지만 입술을 둥글게 하지 않는 평순 모음이다. 한국어 단모음에는 원순 저모음이 없다.\"}},\"2-2-2-40\":{\"p\":\"음절구조는 표기가 아니라 실제 발음을 기준으로 따진다. '닭이'는 겹받침 ㄺ 뒤에 모음으로 시작하는 조사가 오므로 뒤 자음 ㄱ이 다음 음절 초성으로 연음되고, 앞 자음 ㄹ은 받침에 남아 [달기]가 된다. 따라서 첫 음절 [달]은 C(ㄷ)V(ㅏ)C(ㄹ), 둘째 음절 [기]는 C(ㄱ)V(ㅣ)로 CVC-CV이다. 초성 ㅇ은 소리값이 없어 자음으로 세지 않는다는 점, 겹받침은 연음 시 두 자음이 나뉘어 각 음절에 하나씩 놓인다는 점이 판단의 핵심이다.\",\"w\":{\"2\":\"'옷이'는 받침 ㅅ이 연음되어 [오시]가 되며, 첫 음절의 초성 ㅇ은 소리값이 없어 V-CV 구조이다.\",\"3\":\"'국어'는 받침 ㄱ이 연음되어 [구거]가 되므로 첫 음절에 종성이 남지 않는 CV-CV 구조이다.\",\"4\":\"'앉아'는 겹받침 ㄵ 중 ㅈ이 연음되어 [안자]가 되며, 첫 음절에 초성 자음이 없어 VC-CV 구조이다.\",\"5\":\"'밥솥'은 [밥쏟]으로 두 음절 모두 종성이 있는 CVC-CVC 구조이므로 둘째 음절이 CV가 아니다.\"}},\"2-2-2-41\":{\"p\":\"세 낱말에서 바뀐 소리는 ㅊ → [ㅈ], ㅌ → [ㄷ], ㅋ → [ㄱ]으로, 조음위치(경구개·치조·연구개)와 조음방법(파찰·파열)은 그대로 둔 채 기식성만 사라졌다. 이처럼 격음(기식음)이나 경음(긴장음)이 같은 계열의 평음으로 바뀌는 패턴을 이완음화라 하며, 특히 격음 → 평음은 탈기식음화로 부르기도 한다. 오류패턴을 판단할 때는 목표음과 산출음 사이에서 무엇이 달라졌는지(위치·방법·발성유형)를 자질별로 비교하면 되는데, 이 문항은 발성유형만 달라졌다는 점이 단서이다. '토끼'의 경음 ㄲ은 바르게 산출되어 경음 자체에는 문제가 없음도 확인할 수 있다.\",\"w\":{\"1\":\"긴장음화는 평음이 경음(ㄲ·ㄸ·ㅉ 등)으로 바뀌는 패턴이다. 이 아동은 격음이 평음으로 바뀌어 방향이 다르다.\",\"2\":\"파열음화는 마찰음·파찰음이 파열음으로 바뀌는 조음방법 오류이다. ㅊ은 파열음이 아닌 파찰음 [ㅈ]으로 산출되어 방법이 유지되었다.\",\"4\":\"연구개음 전방화는 ㄱ·ㅋ·ㄲ이 치조음 등 앞쪽 위치로 바뀌는 패턴이다. '컵'의 ㅋ은 같은 연구개음 [ㄱ]으로 산출되어 위치가 바뀌지 않았다.\",\"5\":\"파찰음화는 마찰음이나 파열음이 파찰음으로 바뀌는 패턴이다. ㅌ·ㅋ은 파열음 그대로 산출되었고, ㅊ도 원래 파찰음이다.\"}},\"2-2-2-42\":{\"p\":\"발달적 오류패턴은 또래 아동 상당수가 거쳐 가는 단순화 과정으로, 마찰음의 파열음화, 연구개음 전방화, 종성 생략, 유음 단순화 등이 대표적이다. 한국어 아동에게 /ㅅ/는 늦게 습득되는 음소이므로 3세 무렵 /ㅅ/를 같은 치조 위치의 파열음 [ㄷ]으로 바꾸는 것은 흔히 관찰된다. 반면 초성 생략, 후방화, 모음 오류, 성문음 대치처럼 정상 발달에서 드물게 나타나는 패턴은 비발달적(특이한) 오류로 보고 음운장애의 위험 신호로 해석한다. 다만 각 패턴이 사라지는 시기는 연구·교재에 따라 조금씩 다르게 제시된다.\",\"w\":{\"1\":\"어두 초성 /ㅂ/를 생략한 초성 생략이다. 종성 생략과 달리 초성 생략은 일반적인 발달 과정에서 드문 비발달적 오류로 본다.\",\"2\":\"치조음 /ㄷ/를 연구개음 [ㄱ]으로 바꾼 후방화이다. 발달적으로 흔한 것은 반대 방향인 연구개음 전방화이다.\",\"3\":\"모음 /ㅜ/를 [ㅗ]로 바꾼 모음 대치이다. 모음은 대체로 일찍 습득되므로 3세에 모음 오류가 보이면 비발달적 오류로 본다.\",\"4\":\"연구개음 /ㄱ/를 성문음 [ㅎ]으로 바꾼 성문음 대치이다. 이는 정상 발달에서 드물고, 구개열 등의 보상조음과 관련될 수 있는 비발달적 오류이다.\"}},\"2-2-2-43\":{\"p\":\"여러 오류패턴이 함께 있을 때는 목표 낱말의 각 음소에 해당 패턴을 하나씩 대입해 예측한다. '소금' /sogɯm/에서 어두 /ㅅ/는 마찰음이므로 파열음화가 적용되어 같은 치조 위치의 [ㄷ]이 되고, 둘째 음절 초성 /ㄱ/는 연구개음이므로 전방화로 [ㄷ]이 되며, 어말 종성 /ㅁ/는 생략된다. 모음 /ㅗ/·/ㅡ/는 어떤 패턴의 대상도 아니므로 그대로 남아 [도드] [todɯ]가 된다. 정답을 찾을 때는 세 패턴이 모두 적용되었는지와 함께, 제시되지 않은 다른 패턴이 끼어들지 않았는지도 확인해야 한다.\",\"w\":{\"2\":\"파열음화와 종성 생략은 적용되었지만 /ㄱ/가 그대로 [ㄱ]으로 남아 연구개음 전방화가 빠졌다.\",\"3\":\"연구개음 전방화와 종성 생략은 적용되었지만 /ㅅ/가 그대로 남아 마찰음의 파열음화가 빠졌다.\",\"4\":\"파열음화와 전방화는 적용되었지만 어말 종성 /ㅁ/가 남아 있어 종성 생략이 빠졌다.\",\"5\":\"/ㅅ/를 파열음 [ㄷ]이 아닌 파찰음 [ㅈ]으로 바꾼 형태로, 이 아동의 패턴에 없는 파찰음화를 적용한 것이다.\"}},\"2-2-2-44\":{\"p\":\"아동은 자신도 [다과]라고 말하면서 어른이 [다과]라고 하면 틀렸다고 거부한다. 이는 /ㅅ/와 /ㄷ/의 차이를 듣고 구별할 수 있고, 머릿속 기저 표상에는 성인형 /사과/가 저장되어 있으나 아직 운동적으로 /ㅅ/를 산출하지 못한다는 뜻이다. 이러한 현상은 아동이 'fish'를 'fis'로 말하면서 어른의 'fis'는 거부한 사례에서 이름이 붙은 'fis 현상'으로, 말소리 지각이 산출보다 앞서 발달함을 보여 주는 대표적 근거이다. 따라서 이런 아동은 지각 훈련보다 산출(조음 위치·방법) 지도에 초점을 두는 것이 효율적일 수 있다.\",\"w\":{\"1\":\"아동이 어른의 [다과]를 틀렸다고 판단하는 것은 /ㅅ/와 /ㄷ/를 지각적으로 구별한다는 증거이므로 반대 해석이다.\",\"3\":\"기저 표상이 [다과]라면 어른의 [다과]를 맞다고 받아들였을 것이다. 거부한다는 것은 표상이 성인형 /사과/에 가깝다는 뜻이다.\",\"4\":\"고주파 마찰음을 듣지 못한다면 [사과]와 [다과]의 차이를 알아챌 수 없다. 대조를 지각하므로 청력 손실로 설명하기 어렵다.\",\"5\":\"제시된 상황은 모방 과제가 아니라 지각 판단 장면이며, 오류의 원인은 산출 능력이 지각을 아직 따라가지 못한 데 있다.\"}},\"2-2-2-45\":{\"p\":\"첫 낱말 시기에는 옹알이 후기의 음성 목록이 그대로 이어져, 비음·파열음 위주의 소수 자음과 CV·CVCV 같은 단순 음절, '맘마', '빠빠'처럼 같은 음절을 되풀이하는 중첩(반복) 형태가 많이 나타난다. 이 시기 아동은 음소 단위보다 낱말 전체 형태로 말소리를 다루기 때문에 같은 낱말도 산출할 때마다 형태가 달라지는 변이성이 크다. 초성이 종성보다 먼저 다양해지고 마찰음·유음은 늦게 습득된다는 발달 순서와 함께 기억하면 나머지 보기를 쉽게 거를 수 있다.\",\"w\":{\"1\":\"마찰음과 유음은 조음이 정교해야 해 늦게 습득되는 음소이다. 첫 낱말 시기에는 비음·파열음이 주로 나타난다.\",\"2\":\"초성 자음이 종성 자음보다 먼저, 더 다양하게 나타난다. 이 시기 종성은 매우 제한적이거나 생략되는 경우가 많다.\",\"3\":\"첫 낱말 시기에는 같은 낱말도 산출할 때마다 형태가 달라지는 변이가 크다. 일관된 산출은 음운 체계가 안정된 이후의 특징이다.\",\"5\":\"이 시기 오류는 주로 생략과 대치 같은 단순화 형태이다. 왜곡은 음소를 거의 습득한 뒤 정밀도가 부족할 때 주로 나타난다.\"}},\"2-2-2-46\":{\"p\":\"자음정확도(PCC)는 '바르게 산출한 자음 수 ÷ 목표 자음 수 × 100'으로 구하며, 목표는 표준 발음 [궁물 마시고 놀자]이다. 목표 자음을 음절별로 세면 궁(ㄱ·ㅇ), 물(ㅁ·ㄹ), 마(ㅁ), 시(ㅅ), 고(ㄱ), 놀(ㄴ·ㄹ), 자(ㅈ)로 10개이다. 산출 [구무 마디고 노자]와 대조하면 '궁'의 종성 [ŋ] 생략, '물'의 종성 [l] 생략, /ㅅ/ → [ㄷ] 대치, '놀'의 종성 [l] 생략으로 오류가 4개이다. 따라서 정조음은 10 − 4 = 6개이고 PCC = 6/10×100 = 60 %이다. 검산하면 정조음 6개(ㄱ, ㅁ, ㅁ, ㄱ, ㄴ, ㅈ)와 오류 4개를 더해 분모 10과 일치한다. 생략·대치는 모두 오류로 세며, 왜곡을 정·오 어느 쪽으로 볼지는 채점 기준(교재)에 따라 다를 수 있다.\",\"w\":{\"1\":\"오류를 5개로 센 값으로, 바르게 산출한 자음(예: '구'의 초성 ㄱ이나 '노'의 초성 ㄴ)을 종성 생략과 함께 오류로 잘못 센 경우에 나온다.\",\"3\":\"오류를 3개로 센 값으로, 세 종성 생략과 /ㅅ/ → [ㄷ] 대치 가운데 하나를 놓친 경우이다.\",\"4\":\"분모를 11로 잘못 센 값이다. 표준 발음의 자음은 10개이며, 초성 ㅇ처럼 소리값이 없는 글자나 없는 자음을 더하면 분모가 틀어진다.\",\"5\":\"분모를 11로 늘리고 오류도 하나 적게 센 값으로, 분모와 분자 모두에서 실수가 겹친 경우이다.\"}},\"2-2-2-47\":{\"p\":\"오류패턴 출현율은 '패턴이 실제로 나타난 횟수 ÷ 패턴이 나타날 수 있는 기회 수 × 100'이다. 연구개음 전방화의 기회는 목표 낱말 속 연구개음(ㄱ·ㅋ·ㄲ)의 개수이므로 고기 2(ㄱ, ㄱ), 가위 1(ㄱ), 코 1(ㅋ), 기차 1(ㄱ), 토끼 1(ㄲ)로 6번이다. 이 가운데 치조음으로 바뀐 것은 고기 → [도디] 2번, 가위 → [다위] 1번, 토끼의 ㄲ → [ㄸ] 1번으로 4번이며, 코와 기차의 ㄱ은 바르게 산출되었다. 따라서 4/6×100 ≈ 66.7 %이다. '기차'의 ㅊ → [ㄷ]은 연구개음이 아닌 파찰음의 오류(파열음화·치조음화)이므로 전방화 기회에도 출현에도 넣지 않는다는 점이 함정이다.\",\"w\":{\"1\":\"낱말 수를 기준으로 계산한 값으로, 5개 낱말 중 전방화가 나타난 낱말(고기, 가위, 토끼) 3개를 센 것이다. 지시문은 기회(음소) 수를 기준으로 하라고 했다.\",\"2\":\"분자는 출현 횟수 4번으로 맞게 셌지만 분모를 기회 수 6이 아닌 낱말 수 5로 잡은 값이다.\",\"4\":\"'기차'의 ㅊ → [ㄷ] 오류까지 전방화로 잘못 센 값이다. ㅊ은 연구개음이 아니므로 전방화 출현에 포함되지 않는다.\",\"5\":\"'기차'의 ㅊ을 기회 수에 잘못 넣어 분모를 7로 잡은 값이다. 기회는 연구개음 6개뿐이다.\"}},\"2-2-2-48\":{\"p\":\"음소 정확도는 표준 발음에서 그 음소가 실제로 나타나는 위치만 기회로 센다. 한국어 받침 ㅅ은 음절말 평파열음화로 [ㄷ]으로 발음되므로 '빗'[빋]과 '다섯'[다섣]의 받침은 /ㅅ/ 기회가 아니며, 아동의 [빋]·[다덛] 받침은 정상 발음이다. /ㅅ/ 기회는 세수의 '세'·'수', 우산의 '산', 사슴의 '사'·'슴', 다섯의 '섯' 초성으로 6번이다. 정조음은 '수'와 '산' 2번뿐이고 나머지 4번은 모두 [ㄷ]으로 대치되었으므로 2/6×100 ≈ 33.3 %이다. 검산하면 정조음 2 + 오류 4 = 기회 6으로 맞는다.\",\"w\":{\"2\":\"정조음을 3번으로 센 값으로, 실제로는 '수'·'산' 2번만 정조음되었다. 아동이 바르게 발음한 받침 [ㄷ] 등을 정조음으로 하나 더한 실수에서 나온다.\",\"3\":\"표기상 받침 ㅅ 2개('빗', '다섯')까지 분모에 넣은 값이다. 받침 ㅅ은 표준 발음이 [ㄷ]이므로 /ㅅ/ 기회가 아니다.\",\"4\":\"받침 ㅅ 2개를 분모에 넣고 그중 하나를 정조음으로 센 값으로, 분모와 분자 모두 표기를 기준으로 한 실수이다.\",\"5\":\"받침 ㅅ 2개를 분모에 넣은 뒤, 아동이 [ㄷ]으로 바르게 발음한 받침 2개까지 /ㅅ/ 정조음으로 센 값이다.\"}},\"2-2-2-49\":{\"p\":\"낱말 검사는 정해진 목표음을 위치별로 빠짐없이 유도하고 규준과 비교하기 쉽지만, 낱말을 하나씩 따로 말하므로 실제 대화의 말소리와 차이가 난다. 연결발화(자발화) 표본에서는 앞뒤 소리가 서로 영향을 주는 동시조음, 억양·강세·속도 같은 운율, 낱말이 길어지고 문장이 복잡해질 때의 정확도 저하가 그대로 드러난다. 그래서 낱말 검사보다 정확도가 낮게 나오는 경우가 많고, 아동의 실제 명료도를 판단하는 데 더 타당한 자료가 된다. 두 방법은 장단점이 서로 보완적이므로 일반적으로 함께 사용하도록 권한다.\",\"w\":{\"1\":\"모든 목표 음소를 위치별로 체계적으로 유도하는 것은 낱말 검사의 장점이다. 자발화에서는 특정 음소가 나오지 않을 수 있다.\",\"2\":\"자발화에서는 아동이 어려운 음소가 든 낱말을 피해 말할 수 있다. 회피 음소를 반드시 산출하게 할 수 있는 것은 유도 과제의 특징이다.\",\"3\":\"자발화는 아동이 무슨 낱말을 말하려 했는지 미리 알기 어려워 전사·분석에 시간이 많이 든다. 목표 낱말을 미리 아는 것은 낱말 검사이다.\",\"5\":\"연령 규준과 비교하는 표준점수는 표준화된 낱말 검사가 제공한다. 자발화 분석은 일반적으로 표준점수를 바로 주지 않는다.\"}},\"2-2-2-50\":{\"p\":\"정밀 전사에서 자음 아래 붙는 다리 모양 기호 [ ̪ ]는 조음위치가 이(치아)로 옮겨 간 치음(dental) 산출을 뜻한다. 한국어 /ㅅ/는 혀끝이나 혓날을 윗잇몸(치조)에 가깝게 대고 내는 치조 마찰음인데, 이 아동은 혀끝이 앞니 뒤쪽에 닿거나 이 사이로 앞으로 나오면서 소리를 내 [s̪]로 전사된 것이다. 음소 자체는 /ㅅ/로 인식되는 왜곡 오류에 해당하며, 대치(다른 음소로 바뀜)와 구별된다. 구별기호는 같은 음소 안의 미세한 변이를 기록하기 위한 도구이므로 기호별 의미를 정확히 알아 두어야 한다.\",\"w\":{\"1\":\"비음화(비강 공명이 섞임)는 물결 모양 기호 [ ̃ ]를 위에 붙여 표시한다. 전사에 쓰인 아래쪽 다리 기호와 다르다.\",\"3\":\"설측화는 기류가 혀 옆으로 새는 왜곡으로, 무성 설측 마찰음 [ɬ]이나 설측 기류 표시로 적는다.\",\"4\":\"무성음화는 자음 아래에 작은 동그라미 [ ̥ ]를 붙여 표시한다. 다리 모양 기호는 조음위치를 나타낸다.\",\"5\":\"기식화는 위첨자 [ʰ]로 표시한다. 전사에 쓰인 기호는 위첨자가 아니라 아래에 붙은 치음 표시이다.\"}},\"2-2-2-51\":{\"p\":\"문맥검사는 목표음을 다양한 모음 문맥과 낱말 위치에서 산출하게 해, 아동이 이미 정조음할 수 있는 촉진 문맥을 찾는 검사이다. 해설에 제시된 [그림 1]의 값을 보면 /ㅅ/는 뒤 모음이 /ㅣ/일 때만 어두와 어중 모두에서 정조음되었고, /ㅜ/는 어중에서만 정조음되었으며 나머지 모음 문맥은 [ㄷ]으로 대치되었다. 훈련 초기에는 성공률이 가장 높은 문맥에서 출발해 성공 경험을 쌓고 점차 다른 문맥으로 넓히는 것이 일반적이므로, 어두 '시'로 시작하는 '시계'가 가장 적절하다. /ㅣ/ 문맥은 혀가 앞쪽·위쪽에 놓여 치조·경구개 부근의 좁은 틈을 만들기 쉬워 /ㅅ/를 촉진하는 경우가 많다.\",\"w\":{\"1\":\"'수건'은 어두에 /ㅜ/가 뒤따르는 문맥으로, [그림 1]에서 /ㅜ/는 어중에서만 정조음되고 어두(수박)에서는 오조음되었다.\",\"2\":\"'소금'은 /ㅗ/ 문맥으로, [그림 1]에서 /ㅗ/ 앞의 /ㅅ/는 [ㄷ]으로 대치되어 촉진 문맥이 아니다.\",\"3\":\"'사탕'은 /ㅏ/ 문맥으로, [그림 1]에서 /ㅏ/ 앞의 /ㅅ/는 오조음되어 훈련 초기 낱말로 부적절하다.\",\"5\":\"'선물'은 /ㅓ/ 문맥으로, [그림 1]에서 오조음된 문맥이므로 촉진 문맥에서 시작한다는 원칙에 맞지 않는다.\"}},\"2-2-2-52\":{\"p\":\"최소대립쌍 접근법(minimal pair)은 아동의 오류음과 목표음 한 쌍만 다르고 나머지는 같은 두 낱말을 사용해, 오류 때문에 의미가 혼동된다는 것을 아동이 직접 깨닫게 하는 음운론적 중재이다. 세 낱말에서 아동은 /ㅈ/를 일관되게 [ㄷ]으로 대치하므로(파찰음의 파열음화), 대립쌍은 목표음 /ㅈ/와 아동이 대신 쓰는 /ㄷ/로 만들어야 한다. '잠 – 담'은 첫 자음 /ㅈ/–/ㄷ/만 다르고 모음·종성이 같으며 두 낱말 모두 그림으로 나타낼 수 있어 조건을 충족한다. 아동이 '담'으로 말하면 치료사가 담 그림을 고르는 식으로 의사소통 실패를 경험하게 하는 것이 핵심이다.\",\"w\":{\"1\":\"'잠 – 참'은 /ㅈ/–/ㅊ/ 대립으로, 이 아동이 보이지 않는 기식성 차이를 다룬다. 아동의 실제 오류인 /ㅈ/ → [ㄷ]과 관련이 없다.\",\"2\":\"'잠 – 짐'은 자음이 같고 모음 /ㅏ/–/ㅣ/만 다른 모음 대립쌍이므로 자음 대치 오류를 다룰 수 없다.\",\"3\":\"'잠 – 감'은 /ㅈ/–/ㄱ/ 대립으로, 아동은 /ㅈ/를 [ㄱ]으로 대치하지 않으므로 오류와 무관한 대립이다.\",\"4\":\"'달 – 딸'은 /ㄷ/–/ㄸ/의 평음·경음 대립으로, 아동의 목표음 /ㅈ/가 포함되지 않는다.\"}},\"2-2-2-53\":{\"p\":\"복잡성 접근법은 Gierut 등이 제안한 목표음 선정 원리로, 더 복잡하고 어려운 목표(자극반응도가 낮은 음, 늦게 습득되는 음, 유표적인 음, 자음군 등)를 훈련하면 그보다 쉬운 음들까지 포함하는 체계 전반의 변화가 일어난다고 본다. 이는 '쉬운 것부터, 일찍 습득되는 것부터, 자극반응도가 높은 것부터' 고르는 전통적(발달적) 기준과 정반대이다. 근거는 함축 관계(implicational relationship)로, 복잡한 음을 알면 단순한 음의 존재가 함축되기 때문에 일반화 폭이 넓어진다는 것이다. 다만 진전 속도가 느리게 느껴질 수 있어 아동의 동기·가족 상황을 함께 고려해야 한다.\",\"w\":{\"1\":\"자극반응도가 높고 일찍 습득되는 음소를 고르는 것은 전통적·발달적 목표 선정 기준으로, 복잡성 접근법과 반대이다.\",\"3\":\"이미 정조음하는 음소는 치료 목표가 될 이유가 없다. 복잡성 접근법은 아동의 음운 체계에 없는 음을 목표로 한다.\",\"4\":\"오류 빈도가 낮은 음소부터 고르는 것은 복잡성 접근법의 기준이 아니다. 이 접근법은 복잡하고 어려운 음을 우선한다.\",\"5\":\"청지각 변별 가능 여부는 복잡성 접근법의 선정 기준이 아니며, 오히려 아동이 잘 모르는 복잡한 음을 목표로 할 수 있다.\"}},\"2-2-2-54\":{\"p\":\"점진적 접근법(조성법, shaping, 소리 수정법)은 아동이 이미 바르게 내는 소리를 출발점으로 삼아, 목표음에 조금씩 더 가까운 산출을 차례로 강화해 목표음을 만들어 내는 소리 유도 기법이다. 이 문항에서는 정조음하는 /ㄷ/(같은 치조 위치)를 반복하게 한 뒤, 혀끝을 살짝 떼며 바람을 길게 내보내 폐쇄를 좁은 틈(마찰)으로 바꾸고, [s]에 가까워지는 소리를 단계적으로 강화했다. '이미 가능한 소리에서 출발'과 '근사치의 단계적 강화'가 함께 나타난다는 점이 점진적 접근법의 판단 단서이다. 조음점 지시법도 혀 위치를 안내할 수 있지만, 출발점 소리 없이 처음부터 목표음의 위치·방법을 직접 지시한다는 점에서 다르다.\",\"w\":{\"1\":\"청각적 폭격(집중 자극)은 목표음이 많이 들어간 낱말을 반복해 들려주는 청각 자극 활동이다. 아동에게 산출을 단계적으로 요구하는 기법이 아니다.\",\"2\":\"조음점 지시법은 처음부터 혀·입술의 위치와 기류를 직접 지시해 목표음을 만드는 방법이다. 이미 산출 가능한 소리에서 출발해 점차 바꾸는 절차와 다르다.\",\"4\":\"짝자극 기법은 아동이 목표음을 정조음하는 핵심 낱말과 오조음하는 훈련 낱말을 짝지어 연습하게 하는 방법이다. 소리를 처음 유도하는 기법이 아니다.\",\"5\":\"최소대립 훈련은 한 음소만 다른 낱말 쌍으로 의미 대조를 깨닫게 하는 음운론적 접근이다. 산출하지 못하는 음을 만들어 내는 유도 기법이 아니다.\"}},\"2-2-2-55\":{\"p\":\"일반화는 훈련한 범위 밖으로 향상이 퍼지는 것으로, 무엇으로 퍼졌는지에 따라 유형을 나눈다. 이 문항은 종성 /ㅂ/만 훈련했는데 같은 종성 위치에서 훈련하지 않은 /ㄷ/·/ㄱ/가 함께 좋아졌다. 위치는 그대로이고 '음소'가 달라졌으며, 세 음은 [-지속성]의 파열음이라는 공통 자질을 공유하므로 자질(음소 간) 일반화에 해당한다. 판단할 때는 같은 음소가 다른 위치로 갔는지(위치), 다른 소리 환경으로 갔는지(문맥), 더 큰 단위로 갔는지(언어단위), 다른 장소·사람으로 갔는지(상황), 다른 음소로 갔는지(자질·음소)를 차례로 대조하면 된다.\",\"w\":{\"1\":\"위치 일반화는 같은 음소가 훈련한 위치(예: 어두)에서 다른 위치(어중·어말)로 확대되는 것이다. 이 문항은 위치가 아닌 음소가 달라졌다.\",\"2\":\"문맥 일반화는 같은 목표음이 훈련하지 않은 다른 모음·자음 환경에서도 정조음되는 것이다. 다른 음소로 퍼진 경우와 구별된다.\",\"3\":\"상황 일반화는 치료실에서 배운 산출이 가정·학교 등 다른 장소나 다른 대화 상대에게로 확대되는 것이다.\",\"4\":\"언어단위 일반화는 음절·낱말 수준에서 훈련한 것이 구·문장·대화처럼 더 큰 단위로 확대되는 것이다.\"}},\"2-2-2-56\":{\"p\":\"음운인식 과제는 다루는 단위(음절·음절체/말미·음소)와 조작 방식(합성·분리·탈락·대치·변별)의 두 축으로 분류한다. 이 문항에서 치료사는 /ㅂ/, /ㅏ/, /ㅁ/을 하나씩 끊어 들려주고 아동은 이를 이어 한 음절 '밤'으로 말했으므로, 단위는 음소이고 조작은 합성이다. 같은 낱말이라도 '바'+/ㅁ/으로 제시하면 음절체-말미 합성, /ㅂ/+'암'으로 제시하면 초성-각운 합성이 되므로 제시 단위를 정확히 보아야 한다. 일반적으로 합성은 분리보다 쉬운 과제로 보아 음소 수준 지도 초기에 많이 쓴다.\",\"w\":{\"2\":\"음절 합성은 '고'+'래' → '고래'처럼 음절 단위를 합치는 과제이다. 이 문항은 한 음절을 이루는 음소들을 합쳤다.\",\"3\":\"음소 분리는 '밤'을 듣고 /ㅂ/, /ㅏ/, /ㅁ/으로 나누어 말하는 과제로, 합성과 조작 방향이 반대이다.\",\"4\":\"음절체-말미 합성은 '바'(음절체)와 /ㅁ/(말미)처럼 두 덩이를 합치는 과제이다. 이 문항은 세 음소를 낱낱이 제시했다.\",\"5\":\"음소 대치는 '밤'의 /ㅂ/를 /ㄱ/로 바꾸어 '감'을 만드는 것처럼 한 음소를 다른 음소로 바꾸는 과제이다.\"}},\"2-2-2-57\":{\"p\":\"음운인식은 말소리 구조를 인식하고 조작하는 능력으로, 읽기 초기의 해독(decoding) 발달을 예측하는 핵심 요인이다. 소리만 다루는 훈련도 효과가 있지만, 소리 단위를 그에 해당하는 글자(자소)와 연결해 지도하면 아동이 '소리–글자 대응'을 직접 익혀 해독과 철자 향상으로 더 잘 이어진다는 것이 여러 연구의 공통 결론이다. 지도 순서는 일반적으로 큰 단위(음절)에서 작은 단위(음소)로, 쉬운 조작(합성·변별)에서 어려운 조작(탈락·대치)으로 진행한다. 말소리장애 아동, 특히 음운장애 아동은 음운인식 결함과 이후 읽기 어려움의 위험이 높아 학령전기부터 함께 다루는 것이 권장된다.\",\"w\":{\"1\":\"글자(자소)를 함께 제시하면 소리–글자 대응을 익혀 해독·철자 향상 효과가 커진다. 방해가 된다는 것은 연구 결과와 반대이다.\",\"2\":\"음운인식 지도는 일반적으로 쉬운 음절 수준에서 시작해 어려운 음소 수준으로 확장한다. 순서가 거꾸로 되었다.\",\"4\":\"말소리장애 아동, 특히 음운장애 아동은 음운인식 어려움을 동반하기 쉬워 읽기장애 위험군으로 본다.\",\"5\":\"음운인식은 학령전기부터 발달하며 그 시기부터 지도할 수 있고, 조기 지도가 이후 읽기 발달에 도움이 된다.\"}},\"2-2-2-58\":{\"p\":\"영어권 아동은 음절을 '초성(onset)+각운(rime)'으로 나누는 경향이 강하지만, 한국어 아동은 '음절체(body, 초성+모음)+말미(coda, 종성)'로 나누는 것을 더 쉽게 여긴다는 연구 결과가 보고되었다. 예컨대 '밤'을 'ㅂ+암'보다 '바+ㅁ'으로 나누기 쉬운데, 한국어는 CV 결합이 하나의 덩어리로 인식되기 쉽고 한글의 글자 구조와도 관련이 있는 것으로 설명된다. 발달 순서는 일반적으로 음절 → 음절체·말미 → 음소이며, 같은 단위라도 세기·합성은 탈락·대치보다 쉽다. 이 차이는 한국어 음운인식 검사·중재에서 음절체-말미 과제를 음소 과제보다 앞에 두는 근거가 된다.\",\"w\":{\"1\":\"음운인식은 큰 단위에서 작은 단위로 발달하므로 음절을 음소보다 먼저 인식한다. 순서가 반대이다.\",\"3\":\"음절 탈락이 음소 탈락보다 먼저 가능해진다. 음소는 가장 작은 단위라 조작이 가장 늦게 발달한다.\",\"4\":\"음절은 소리 덩어리가 분명해 세기 쉬우므로, 음절 수 세기가 음소 수 세기보다 쉽다.\",\"5\":\"음운인식은 해독·철자 등 읽기 발달과 밀접한 관련이 있어, 읽기 발달의 주요 예측 요인으로 꼽힌다.\"}},\"2-2-2-59\":{\"p\":\"보상조음은 연인두 폐쇄부전으로 구강 내 압력을 만들기 어려울 때, 연인두보다 아래쪽(인두·성문)에서 기류를 막거나 좁혀 소리를 대신 만드는 비정상적 조음이다. 이 아동은 /ㅅ/를 낼 때 혀끝을 쓰지 않고 혀뿌리(설근)를 인두후벽 쪽으로 당겨 좁은 틈을 만들고 그 사이로 마찰 소음을 낸다. '좁힌 틈'과 '마찰 소음'은 조음방법이 마찰음임을, '혀뿌리와 인두벽'은 조음위치가 인두임을 알려 주므로 인두마찰음이다. 보상조음은 위치(성문·인두·중설구개)와 방법(파열·마찰)을 함께 따져 구별하며, 인두마찰음은 주로 /ㅅ/·/ㅆ/ 같은 마찰음 대신 나타난다.\",\"w\":{\"1\":\"성문파열음은 성대를 세게 닫았다가 터뜨려 내는 소리로, 주로 파열음 대신 나타난다. 조음위치가 성문이고 방법이 파열이라 이 아동과 다르다.\",\"2\":\"인두파열음은 혀뿌리를 인두후벽에 완전히 붙여 막았다가 터뜨리는 소리이다. 이 아동은 완전히 막지 않고 틈을 좁혀 마찰을 만들었다.\",\"3\":\"중설구개파열음은 혀 가운데를 경구개에 붙였다가 터뜨려 내는 소리로, 주로 치조·연구개 파열음 대신 나타난다. 위치와 방법 모두 다르다.\",\"5\":\"비강마찰음은 기류를 코로 내보내면서 비강에서 마찰 소음을 만드는 것으로, 혀뿌리와 인두벽의 좁힘이 관여하지 않는다.\"}},\"2-2-2-60\":{\"p\":\"나조미터의 비음치(nasalance)는 '비강 음향 에너지 ÷ (비강 + 구강 음향 에너지) × 100'으로, 말소리 중 코로 나오는 소리의 비율을 수치로 보여 준다. 과다비성은 비음이 없어야 할 구강음 말소리에 비강 공명이 섞이는 것이므로, 비음이 전혀 없는 구강음 문장을 읽혔을 때 비음치가 높게 나오는지로 판단한다. ① '아빠 바지 사줘'에는 ㅁ·ㄴ·종성 ㅇ이 하나도 없어 정상이라면 비음치가 낮아야 하므로 과다비성 평가 자극으로 적절하다. 반대로 비음이 많은 문장은 정상인도 비음치가 높게 나와 과다비성을 가려내기 어렵고, 비음치가 기대보다 낮은지를 보는 과소비성 평가에 쓰인다.\",\"w\":{\"2\":\"'엄마 나무 많아'는 ㅁ·ㄴ 비음이 여러 개 들어 있어 정상 화자도 비음치가 높다. 과소비성 평가에 적합한 비음 문장이다.\",\"3\":\"'냉면 먹고 싶어'는 ㄴ·ㅇ·ㅁ 같은 비음이 포함되어 있어, 높은 비음치가 과다비성 때문인지 비음 때문인지 구별하기 어렵다.\",\"4\":\"'고양이 노래해'에는 종성 ㅇ[ŋ]과 ㄴ이 포함되어 있어 순수한 구강음 문장이 아니다.\",\"5\":\"'미나리 무침 줘'는 ㅁ·ㄴ이 많은 비음 문장으로, 과다비성보다 과소비성 평가에 쓰는 자극이다.\"}},\"2-2-2-61\":{\"p\":\"구개열 아동의 말 문제는 구조적 문제(연인두 폐쇄부전으로 인한 과다비성·비누출)와 기능적 문제(잘못 학습된 보상조음)로 나누어 다룬다. 이 아동의 /ㄱ, ㄷ/ 대치는 성대를 세게 닫았다 터뜨리는 성문파열음으로, 구강 압력을 만들지 못하던 시기에 학습된 습관적 조음 위치이다. 따라서 수술로 연인두 구조가 좋아져도 저절로 사라지지 않는 경우가 많아, 구강의 올바른 조음 위치를 가르치는 조음치료가 필요하다. 반면 과다비성은 구조 문제이므로 수술·보철 같은 물리적 처치가 우선이며, 조음치료는 보상조음 교정을 위해 수술 전부터 병행할 수 있다.\",\"w\":{\"1\":\"보상조음은 구조 문제가 있던 시기에 학습된 조음 습관이므로 수술로 구조가 교정되어도 남는 경우가 많다. 저절로 사라진다고 볼 수 없다.\",\"2\":\"연인두 폐쇄부전으로 인한 과다비성은 구조적 문제이므로 조음치료만으로는 해결되지 않고, 수술이나 보철 등의 처치가 필요하다.\",\"3\":\"연인두 폐쇄부전이 있어도 보상조음을 구강 조음으로 바꾸는 조음치료는 효과가 있으며, 수술 전부터 시작할 수 있다.\",\"4\":\"불기·빨기 같은 비구어 운동은 말할 때의 연인두 폐쇄를 개선한다는 근거가 약하다. 이 아동은 2차 수술이 예정되어 있어 구조적 처치가 우선이다.\"}},\"2-2-2-62\":{\"p\":\"이관(유스타키오관)은 중이와 비인두를 연결해 중이 압력을 대기압과 맞추고 분비물을 배출하는 통로이며, 삼킬 때 구개범장근(tensor veli palatini)이 수축하면서 열린다. 구개열 아동은 이 근육이 정상적으로 부착되지 않아 이관이 잘 열리지 않으므로 중이 환기가 되지 않고 음압이 생겨 삼출액이 고이기 쉽다. 그 결과 삼출성 중이염이 반복되고, 소리 전달 경로(중이)의 문제이므로 전음성 난청이 동반된다. 이러한 청력 저하는 말소리 지각과 조음 발달에도 영향을 줄 수 있어, 구개열 아동은 정기적인 청력 추적과 이비인후과 협진이 필요하다.\",\"w\":{\"2\":\"와우 유모세포 손상은 내이 문제로 감각신경성 난청의 원인이다. 구개열 아동에게 흔한 것은 중이 문제로 인한 전음성 난청이다.\",\"3\":\"비누출은 말할 때 공기가 코로 새는 현상으로, 새어 나간 공기가 고막을 직접 손상시키지는 않는다.\",\"4\":\"등골근 반사는 큰 소리에 대해 이소골 운동을 줄이는 보호 반사로, 중이염의 원인과 관계가 없다.\",\"5\":\"청신경 수초화 지연은 신경성 청각 문제와 관련된 것으로, 중이 환기 장애로 생기는 삼출성 중이염의 원인이 아니다.\"}},\"2-2-2-63\":{\"p\":\"아동기 말실행증(CAS)과 발달성 마비말장애는 둘 다 말운동장애이지만 문제가 생긴 단계가 다르다. 마비말장애는 말 근육을 움직이는 신경근 실행 단계의 손상이므로, 말뿐 아니라 씹기·삼키기·혀 내밀기 같은 비구어 과제에서도 근력 약화, 근긴장 이상, 운동 범위·속도 저하가 함께 나타나고 오류가 비교적 일관적이다. 반면 CAS는 근력은 정상이지만 말 동작을 계획·프로그래밍하는 단계의 문제라 비일관적 오류, 모색 행동, 길이·복잡성 효과, 자동적 발화와 의도적 발화의 수행 차이가 핵심 특징이다. 따라서 말과 비구어 과제 모두에서 근력·근긴장 이상이 보이는 소견이 마비말장애를 가장 잘 시사한다.\",\"w\":{\"1\":\"같은 낱말을 반복할 때 오류 형태가 달라지는 비일관성은 운동 계획 문제인 아동기 말실행증의 핵심 특징이다.\",\"2\":\"낱말이 길고 복잡해질수록 오류가 늘어나는 길이 효과는 운동 프로그래밍 부담과 관련되어 아동기 말실행증을 시사한다.\",\"4\":\"조음 위치를 찾아 입을 이리저리 움직이는 모색 행동(groping)은 아동기 말실행증의 대표 소견이다.\",\"5\":\"자동적 발화는 비교적 잘 되면서 의도적 발화에서 오류가 많아지는 차이는 아동기 말실행증의 특징이다. 마비말장애는 발화 종류와 관계없이 비교적 일관된 오류를 보인다.\"}},\"2-2-2-64\":{\"p\":\"DTTC(Dynamic Temporal and Tactile Cueing, 역동적 시간·촉각 단서법)는 Strand가 통합적 자극법을 바탕으로 발전시킨 아동기 말실행증 치료법이다. 치료사와 동시에 말하기 → 즉시 모방 → 지연 모방 → 자발 산출 순으로 단서를 점차 줄이고, 아동이 어려워하면 말 속도를 늦추거나 촉각·몸짓 단서를 더해 다시 성공하게 하는 '역동적' 단서 조절이 핵심이다. 이는 음운 규칙을 깨닫게 하는 접근이 아니라, 말 운동 계획을 반복 연습해 자동화하는 운동학습 기반 접근이라는 점에서 음운론적 접근들과 구별된다. 문항의 '동시 산출부터 시작하는 단계'와 '수행에 따른 속도·촉각 단서 조절'이 판단 단서이다.\",\"w\":{\"1\":\"최소대립 접근법은 한 음소만 다른 낱말 쌍으로 의미 대조를 깨닫게 하는 음운론적 접근으로, 음운장애 아동에게 주로 쓴다.\",\"2\":\"핵심어휘 접근법은 Dodd가 제안한 비일관적 음운장애 아동용 접근으로, 기능적인 핵심 낱말을 일관되게 산출하도록 훈련한다.\",\"3\":\"주기 접근법(Hodson)은 여러 오류패턴을 정해진 기간씩 돌아가며 다루는 음운론적 접근으로, 명료도가 매우 낮은 음운장애 아동에게 쓴다.\",\"4\":\"상위음운 접근법은 말소리의 특성(길다·짧다, 앞소리·뒷소리 등)을 의식적으로 생각하게 하는 음운론적 접근으로, 운동 계획 훈련 절차와 다르다.\"}},\"2-2-2-65\":{\"p\":\"운동학습 원리는 '연습할 때 잘하는 것(습득)'과 '연습 뒤에도 남는 것(유지·전이)'을 구별한다. 무선(무작위) 연습은 여러 목표를 섞어 순서 없이 연습하므로 매 시도마다 운동 계획을 새로 세워야 해 습득 단계에서는 정확도가 더디게 오르지만, 그 노력 덕분에 장기 유지와 새로운 낱말로의 전이에 유리하다. 반대로 같은 목표를 묶어 연습하는 구획 연습은 초기 수행은 빠르지만 유지 효과는 상대적으로 약하다. 아동기 말실행증 치료에서는 일반적으로 초기에는 구획 연습으로 정확한 산출을 만들고, 이후 무선 연습·분산 연습·낮은 빈도의 피드백으로 바꾸어 유지·전이를 노린다.\",\"w\":{\"1\":\"결과 피드백을 매 시도마다 주면 피드백에 의존하게 되어 장기 유지에 불리하다. 일반적으로 빈도를 점차 줄여 갈 때 유지가 좋다.\",\"2\":\"짧은 시간에 몰아서 하는 집중 연습보다, 여러 회기에 나누어 하는 분산 연습이 장기 유지에 더 유리하다고 본다.\",\"3\":\"운동학습에는 많은 반복 시도가 필요하므로, 아동기 말실행증 치료에서는 회기당 산출 횟수를 많이 확보하는 것이 권장된다.\",\"5\":\"초기에는 아동이 성공할 수 있는 음절·낱말 같은 단순한 단위에서 시작해 점차 구·문장·대화로 넓혀 간다.\"}},\"2-2-2-66\":{\"p\":\"난청 유형은 기도·골도 역치와 그 차이(기도-골도 차)로 판단한다. 기도만 나쁘고 골도가 정상이며 차이가 크면(일반적으로 10 dB 초과) 전음성, 기도·골도가 함께 나쁘고 차이가 10 dB 이내면 감각신경성, 둘 다 나쁘면서 차이도 크면 혼합성이다. 해설에 제시된 그림 값에서 좌측 기도 역치는 500·1000·2000 Hz에서 25·30·35 dB HL이고, 골도와의 차이가 10 dB 이내이므로 감각신경성이다. 3분법 평균은 (25 + 30 + 35) ÷ 3 = 30 dB HL, 4분법 평균은 (25 + 2×30 + 35) ÷ 4 = 30 dB HL로 일반적인 분류에서 경도(약 26~40 dB HL)에 해당한다. 우측은 기도 45 dB HL, 골도 5~10 dB HL로 기도-골도 차가 35~40 dB이므로 전음성 중등도 난청이며, 정도 분류 구간은 교재에 따라 조금씩 다르다.\",\"w\":{\"1\":\"우측은 정도(약 45 dB HL, 중등도)는 맞지만, 골도 역치가 5~10 dB HL로 정상이고 기도-골도 차가 35~40 dB로 커서 감각신경성이 아니라 전음성이다.\",\"2\":\"우측은 골도가 정상 범위라 혼합성이 아니라 전음성이며, 평균 역치 약 45 dB HL은 경도가 아니라 중등도에 해당한다.\",\"3\":\"좌측은 기도-골도 차가 10 dB 이내라 전음성이 아니라 감각신경성이며, 평균 역치 약 30 dB HL은 중등도가 아니라 경도이다.\",\"5\":\"좌측은 정도(경도)는 맞지만, 혼합성이 되려면 골도 역치도 떨어지면서 기도-골도 차가 커야 한다. 좌측은 차이가 10 dB 이내라 감각신경성이다.\"}},\"2-2-2-67\":{\"p\":\"어음청취역치(SRT)는 두 음절에 같은 강세를 두는 강강격(spondee) 이음절어를 들려주고, 피검자가 50 %를 바르게 따라 말하는 가장 작은 강도를 찾는 검사이다. SRT는 순음청력검사의 평균역치(PTA)와 대개 비슷한 값(일반적으로 ±10 dB 안팎)으로 나와 순음 결과의 신뢰도를 확인하는 교차검증 자료가 된다. 이와 달리 단어인지도(WRS)는 '얼마나 작게 들리는가'가 아니라 '충분히 크게 들렸을 때 얼마나 정확히 알아듣는가'를 보는 검사로, 단음절어를 SRT보다 충분히 높은 쾌적 강도에서 제시해 정답률(%)로 나타낸다. 두 검사는 자극(이음절어·단음절어)과 측정 내용(역치·정확도)이 다르다는 점을 함께 기억한다.\",\"w\":{\"1\":\"SRT는 단음절어가 아니라 이음절어로, 100 %가 아니라 50 %를 맞히는 최소 강도로 정의한다. 단음절어는 단어인지도 검사에 쓴다.\",\"2\":\"단어인지도는 역치 강도에서는 거의 들리지 않으므로, SRT보다 충분히 높은 쾌적 강도(일반적으로 SRT보다 30~40 dB 높게)에서 측정한다.\",\"4\":\"SRT는 순음평균역치와 대개 ±10 dB 안팎에서 일치하므로, 두 값의 관련성이 높고 결과 신뢰도 확인에 쓰인다.\",\"5\":\"어음청력검사는 피검자가 낱말을 듣고 따라 말하거나 그림을 가리키는 반응이 필요한 주관적(행동) 검사이다.\"}},\"2-2-2-68\":{\"p\":\"고막운동도(tympanogram)는 외이도 압력을 바꾸면서 고막·중이의 움직임(유순도)을 측정해 그래프로 나타낸 것이다. 삼출성 중이염으로 중이강이 액체로 차면 압력을 바꾸어도 고막이 거의 움직이지 않아 정점(peak)이 없는 평탄한 곡선, 즉 B형이 된다. 같은 B형이라도 외이도 용적이 정상이면 중이 삼출액, 크면 고막 천공이나 환기관 개통, 작으면 귀지 폐색이나 측정 오류를 시사하므로, 문항의 '외이도 용적 정상'은 삼출액에 의한 B형임을 확인해 주는 단서이다. 삼출액이 생기기 전후의 이관 기능 이상 단계에서는 정점이 음압 쪽으로 치우친 C형이 나타날 수 있다는 점도 함께 알아 둔다.\",\"w\":{\"1\":\"A형은 정점이 정상 압력 부근에 있고 높이도 정상인 정상 중이 기능의 유형이다. 중이에 삼출액이 차면 정점이 나타나지 않는다.\",\"2\":\"As형은 정점 위치는 정상이지만 높이가 낮은 유형으로, 이경화증 같은 이소골 고착 등 중이 경직성이 커졌을 때 나타난다.\",\"3\":\"Ad형은 정점이 매우 높은 유형으로, 이소골 단절이나 고막이 얇아져 지나치게 잘 움직일 때 나타난다.\",\"4\":\"C형은 정점이 뚜렷한 음압 쪽에 있는 유형으로, 이관 기능 이상으로 중이 압력이 낮을 때 나타난다. 삼출액이 가득 차면 정점이 사라져 B형이 된다.\"}},\"2-2-2-69\":{\"p\":\"이음향방사(OAE)는 소리 자극을 받은 와우의 외유모세포가 능동적으로 수축·이완하며 만들어 낸 미세한 소리가 중이를 거쳐 외이도로 되돌아오는 것을 마이크로 기록하는 검사이다. 피검자의 반응이 필요 없어 신생아 청각선별검사에 널리 쓰이며, 반응이 나오면 외유모세포까지의 경로가 대체로 정상임을 뜻한다. 다만 소리가 중이를 두 번 통과해야 하므로 중이 삼출액이 있으면 반응이 나오지 않을 수 있고, 외유모세포 이후의 내유모세포·청신경 문제는 확인할 수 없다. 그래서 OAE는 정상이면서 ABR이 비정상인 청신경병증(청신경병증 스펙트럼 장애)을 놓칠 수 있다는 점이 OAE와 ABR을 구별하는 핵심이다.\",\"w\":{\"2\":\"청신경과 뇌간의 전기적 신경 반응을 측정하는 것은 청성뇌간반응(ABR) 검사이다. OAE는 와우에서 되돌아오는 음향 신호를 측정한다.\",\"3\":\"OAE 신호는 중이를 거쳐 외이도로 나오므로, 중이 삼출액이 있으면 신호가 약해져 반응이 나오지 않을 수 있다.\",\"4\":\"OAE는 피검자의 행동 반응이 필요 없는 객관적 검사이다. 소리를 듣고 버튼을 누르는 것은 순음청력검사 같은 주관적 검사의 방식이다.\",\"5\":\"청신경병증은 외유모세포 기능이 정상이라 OAE가 정상으로 나올 수 있다. 따라서 ABR을 함께 시행해야 찾아낼 수 있다.\"}},\"2-2-2-70\":{\"p\":\"인공와우는 외부 어음처리기가 소리를 전기 신호로 바꾸고, 와우 안에 넣은 전극이 손상된 유모세포를 건너뛰어 청신경을 직접 전기 자극하는 장치이다. 따라서 자극을 받아 뇌로 전달할 청신경이 반드시 있어야 하며, 청신경이 형성되지 않았거나(무형성) 기능하지 않으면 효과를 기대하기 어렵다. 이런 경우에는 뇌간의 와우신경핵을 직접 자극하는 청성뇌간이식(ABI)을 고려한다. 이 문항은 '옳지 않은 것'을 고르는 문항이므로, 나머지 보기는 인공와우의 원리·대상·사후 관리에 관한 옳은 설명임을 확인하며 풀어야 한다.\",\"w\":{\"1\":\"인공와우의 기본 원리를 옳게 설명한 문장이다. 전극이 손상된 유모세포의 역할을 대신해 청신경을 전기 자극한다.\",\"3\":\"옳은 설명이다. 인공와우는 일반적으로 보청기를 충분히 사용해도 이득이 적은 양측 고도·심도 난청이 주 대상이다(세부 기준은 기관·시기에 따라 다르다).\",\"4\":\"옳은 설명이다. 인공와우의 전기 자극 소리는 자연 청각과 달라, 이식 후 체계적인 청능훈련과 매핑 조정을 통해 듣기 능력을 길러야 한다.\",\"5\":\"옳은 설명이다. 언어습득 전 아동은 청각 발달의 민감기 안에 일찍 이식할수록 말·언어 발달에 유리하다고 보고된다.\"}},\"1-1-1-1\":{\"p\":\"좌측 하전두엽(브로카 영역) 손상, 느리고 노력성인 비유창 발화, 조사·어미를 생략하는 전보식 발화(실문법증)가 핵심 단서이다. 단순 지시 이해는 비교적 양호하지만 통사적으로 복잡한 문장 이해에 어려움이 있고 따라말하기도 손상되어 있다. 비유창·이해 상대적 양호·따라말하기 손상의 조합은 브로카실어증에 해당한다.\",\"w\":{\"1\":\"베르니케실어증은 유창한 발화와 심한 청각적 이해력 손상을 보이므로 비유창 발화와 맞지 않는다.\",\"2\":\"연결피질운동실어증은 비유창하나 따라말하기가 보존되므로 따라말하기 손상 소견과 모순된다.\",\"4\":\"전도실어증은 유창한 발화에 따라말하기가 선택적으로 손상되는 유형으로 비유창·전보식 발화와 맞지 않는다.\",\"5\":\"명칭실어증은 유창하고 이해·따라말하기가 양호하며 이름대기 결함만 두드러지는 유형이다.\"}},\"1-1-1-2\":{\"p\":\"스스로 말하기 8/20점으로 비유창하고, 알아듣기 170/200(8.5/10)으로 청각적 이해가 양호하다. 따라말하기 88/100(8.8/10)은 유창성에 비해 뚜렷하게 보존되어 있다. 비유창·이해 양호·따라말하기 보존의 조합은 연결피질운동실어증의 전형적 프로파일이다.\",\"w\":{\"2\":\"전도실어증은 유창한 발화에 따라말하기가 선택적으로 손상되므로 비유창·따라말하기 88점 보존과 반대이다.\",\"3\":\"베르니케실어증은 유창하고 이해가 심하게 손상되므로 알아듣기 170점과 맞지 않는다.\",\"4\":\"브로카실어증은 비유창하지만 따라말하기도 손상되므로 88점의 보존된 따라말하기와 맞지 않는다.\",\"5\":\"연결피질감각실어증은 따라말하기는 보존되나 유창하고 이해가 저하되는 유형이다.\"}},\"1-1-1-3\":{\"p\":\"실제 낱말을 의미적으로 관련된 낱말로 대치하는 의미착어('버스'→'기차')가 결정적 단서이다. 비단어 읽기가 거의 불가능하여 음운(비어휘) 경로가 손상되었고, 추상어보다 구체어를 잘 읽는 심상성 효과가 나타난다. 의미 오류·비단어 읽기 불능·심상성 효과의 조합은 심층실독증의 특징이다.\",\"w\":{\"1\":\"표층실독증은 어휘 경로 손상으로 불규칙 낱말을 규칙화하여 읽는 오류를 보이며 비단어 읽기는 보존된다.\",\"2\":\"음운실독증도 비단어 읽기가 손상되지만 의미착어(의미적 대치 오류)는 나타나지 않는다.\",\"3\":\"순수실독증은 쓰기는 보존되면서 읽기만 손상되고 글자 하나씩 읽는(letter-by-letter) 양상을 보인다.\",\"5\":\"무시실독증은 편측 무시로 낱말의 한쪽(주로 왼쪽) 글자를 생략·대치하는 오류를 보인다.\"}},\"1-1-1-4\":{\"p\":\"기저핵 회로의 퇴행성 병변은 파킨슨병을 시사한다. 단조로운 음도·감소된 강도, 점점 빨라지는 말속도(가속)와 짧은 말 뭉침, 안정 시 떨림은 과소운동형 마비말장애의 전형적 특징이다.\",\"w\":{\"1\":\"이완형은 하위운동신경 손상으로 근약화·과다비성·기식 음성을 보인다.\",\"3\":\"경직형은 양측 상위운동신경 손상으로 느리고 노력성인 말과 쥐어짜는 음성을 보이며 말속도 가속과 맞지 않는다.\",\"4\":\"실조형은 소뇌 손상으로 불규칙한 조음 붕괴와 과도한 강세 변동을 보인다.\",\"5\":\"과다운동형도 기저핵 병변이지만 무도증·근긴장이상 등 불수의 운동으로 인한 예측 불가능한 변이를 보이며 단조로운 음도·가속과는 다르다.\"}},\"1-1-1-5\":{\"p\":\"근력 저하 없이 나타나는 모색행동, 같은 낱말에서의 비일관적 오류, 발화 길이에 따른 오류 증가, 자동구어의 상대적 보존은 말실행증의 특징이다. 말실행증은 말운동 계획·프로그래밍의 손상이므로 느린 속도에서 조음 동작 전환을 반복 연습하고 운동학습 원리(집중 연습, 점진적 난이도 상승)를 적용하는 것이 적절하다.\",\"w\":{\"1\":\"AAC는 중증에서 보완적으로 고려할 수 있으나 제시된 대상자는 자동구어가 가능한 수준이므로 즉시 도입할 근거가 없다.\",\"2\":\"근력 저하가 없는 운동 프로그래밍 장애이므로 비구어 구강 근력 강화 훈련은 적절하지 않다.\",\"3\":\"청각적 이해력 결함에 대한 단서가 없으므로 이해력 훈련을 우선할 이유가 없다.\",\"5\":\"호흡 지구력 훈련은 호흡 지지가 약한 마비말장애 등에 적용하는 것으로 말실행증의 핵심 문제와 무관하다.\"}},\"1-1-1-6\":{\"p\":\"삼킴 반사가 유발되기 전에 음식물이 인두로 조기 유입되었으므로 '삼킴 전' 단계의 문제이다. 음식물이 진성대 아래로 내려갔으므로 침습이 아니라 흡인이며, 기침 반응이 없으므로 무증상 흡인이다. 따라서 삼킴 전 무증상 흡인에 해당한다.\",\"w\":{\"1\":\"구강 잔여물은 삼킴 후 구강 내에 음식물이 남는 것으로 인두·기도 유입 소견과 무관하다.\",\"2\":\"침습은 음식물이 후두 전정에 들어가되 진성대 위에 머무는 경우로, 진성대 아래로 내려간 본 소견과 다르다.\",\"3\":\"음식물 유입은 삼킴 반사 유발 전에 일어났으므로 '삼킴 후' 흡인이 아니다.\",\"5\":\"비강 역류는 연인두 폐쇄 부전으로 음식물이 비강으로 넘어가는 것이다.\"}},\"1-1-1-7\":{\"p\":\"발화는 유창하고 문법적으로 완전하지만 사물의 이름뿐 아니라 용도(의미 지식)까지 상실되어 있고, 의미 과제의 어려움이 점진적으로 심화된다. 불규칙 낱말을 규칙화하여 읽는 표층실독증이 동반되고 일상 기억과 시공간 능력은 보존된다. 이는 의미치매(의미변이형 원발성 진행성 실어증)의 특징이다.\",\"w\":{\"1\":\"알츠하이머성 치매는 초기부터 일화 기억 저하가 두드러지므로 일상 기억 보존 소견과 맞지 않는다.\",\"3\":\"비유창형 원발성 진행성 실어증은 실문법증·노력성 발화·말실행증을 보이므로 유창하고 문법적으로 완전한 발화와 맞지 않는다.\",\"4\":\"혈관성 치매는 뇌혈관 질환에 따른 계단식 악화와 국소 신경학적 징후가 특징이며 선택적 의미 지식 상실과는 거리가 있다.\",\"5\":\"루이소체 치매는 인지 기능의 변동, 환시, 파킨슨증이 특징이다.\"}},\"1-1-1-8\":{\"p\":\"지속적 주의력은 일정 시간 동안 주의를 유지하는 능력이다. 일정 시간 동안 목표 소리가 들릴 때마다 버튼을 누르는 과제는 지속 수행 과제(CPT)로 지속적 주의력 평가에 적합하다.\",\"w\":{\"1\":\"선택적 주의력은 방해 자극 속에서 목표에 주의를 두는 능력이므로 조용한 방에서의 숫자 따라 외우기(작업기억·주의 폭 과제)와 맞지 않는다.\",\"3\":\"두 규칙을 번갈아 적용하는 과제는 교대적 주의력 과제이며 초점적 주의력은 특정 자극에 대한 기본 반응 능력이다.\",\"4\":\"분리적 주의력은 두 과제를 동시에 수행하는 능력이므로 하나만 골라 수행하는 과제와 맞지 않는다.\",\"5\":\"소음 속에서 이야기를 듣고 답하는 과제는 방해 자극을 억제하는 선택적 주의력 과제이다.\"}},\"1-1-1-9\":{\"p\":\"광범위한 좌반구 병소, 상동어에 제한된 구어 표현, 심한 청각적 이해력 손상은 전반실어증 양상이다. 몸짓 모방이 부분적으로 가능하므로 구어를 사용하지 않고 시각 자극과 몸짓 상징을 단계적으로 훈련하는 시각동작치료(VAT)를 우선 적용할 수 있다.\",\"w\":{\"1\":\"멜로디억양치료는 청각적 이해가 비교적 양호한 비유창 실어증에 적합하므로 이해력이 심하게 손상된 본 환자에게 부적절하다.\",\"2\":\"지연청각피드백은 말더듬·속화 등에서 말속도를 늦추는 기기로 실어증 치료법이 아니다.\",\"3\":\"문장산출프로그램(SPPA)은 일정 수준의 이해력과 구어 산출이 가능한 실문법증 환자를 위한 것이다.\",\"4\":\"의미자질분석은 이름대기 치료로, 상동어 수준의 산출과 심한 이해 손상을 보이는 환자에게는 적용이 어렵다.\"}},\"1-1-1-10\":{\"w\":{\"1\":\"스스로 말하기(내용 전달·유창성)는 AQ 산출 영역에 포함된다.\",\"2\":\"따라말하기는 AQ 산출 영역에 포함된다.\",\"4\":\"이름대기 및 낱말 찾기는 AQ 산출 영역에 포함된다.\",\"5\":\"알아듣기는 AQ 산출 영역에 포함된다.\"}},\"1-1-1-11\":{\"p\":\"보호자는 긴 설명을 하면 환자가 이해하지 못한다고 호소하고 있다. 중등도 실어증 환자에게는 짧고 단순한 문장, 느린 말속도, 충분한 반응 시간, 몸짓 등 다중 양식 활용이 권장되므로 짧고 단순하게 말하고 반응할 시간을 충분히 주도록 교육한다.\",\"w\":{\"2\":\"틀릴 때마다 즉시 교정하면 의사소통 의욕이 저하되고 대화 흐름이 끊긴다.\",\"3\":\"환자가 말하기 전에 대신 말해 주면 스스로 표현할 기회를 빼앗는다.\",\"4\":\"대화 기회를 줄이면 의사소통 참여와 회복 기회가 감소한다.\",\"5\":\"빠른 속도는 처리 부담을 늘리므로 느린 속도로 말해야 한다.\"}},\"1-1-1-12\":{\"p\":\"성문위삼킴법은 숨을 들이쉬고 참은 상태에서 삼킨 뒤 곧바로 기침하는 기법이다. 삼킴 전과 삼킴 중에 진성대 수준에서 기도를 자발적으로 폐쇄하여 흡인을 방지하는 것이 일차적 목적이다.\",\"w\":{\"1\":\"중력을 이용한 잔여물 처리는 자세 기법(머리 기울이기 등)에 해당한다.\",\"2\":\"후두 상승 연장과 상부식도괄약근 개방 시간 연장은 멘델슨기법의 목적이다.\",\"3\":\"혀 기저부 후방 운동 강화는 노력삼킴 등의 목적이다.\",\"4\":\"삼킴 반사 유발 촉진은 온도-촉각 자극 등 감각 자극 기법의 목적이다.\"}},\"1-1-1-13\":{\"p\":\"좌측 상측두회(베르니케 영역) 손상, 착어가 많은 유창한 발화, 심한 청각적 이해력 저하, 따라말하기 손상, 병식 부족이 모두 나타난다. 이 조합은 베르니케실어증의 전형적 특징이다.\",\"w\":{\"2\":\"전도실어증은 청각적 이해가 비교적 양호하고 병식이 있어 자기수정을 시도한다.\",\"3\":\"명칭실어증은 이해·따라말하기가 양호하고 이름대기 결함만 두드러진다.\",\"4\":\"연결피질감각실어증은 베르니케실어증과 유사하나 따라말하기가 보존된다.\",\"5\":\"브로카실어증은 비유창한 발화를 보이므로 유창한 발화와 맞지 않는다.\"}},\"1-1-1-14\":{\"p\":\"유창한 발화와 비교적 양호한 청각적 이해력에도 따라말하기가 선택적으로 심하게 손상되고 음소착어가 두드러지는 것은 전도실어증의 특징이다. 주로 활꼴다발(궁상속)이나 모서리위이랑 부위 손상과 관련되며, 목표어에 가까워지려는 접근행동(conduite d'approche)을 보인다.\",\"w\":{\"1\":\"연결피질운동실어증은 비유창하고 따라말하기가 보존된다.\",\"2\":\"베르니케실어증은 청각적 이해력이 심하게 손상된다.\",\"3\":\"브로카실어증은 비유창한 발화를 보인다.\",\"5\":\"전반실어증은 비유창하고 이해·따라말하기가 모두 심하게 손상된다.\"}},\"1-1-1-15\":{\"p\":\"소뇌 손상과 함께 불규칙한 조음 붕괴, 과도하고 불규칙한 강세, 술 취한 듯한 말이 나타난다. 이는 운동 협응(타이밍·범위) 결함에 의한 실조형 마비말장애의 특징이다.\",\"w\":{\"1\":\"이완형은 하위운동신경 손상으로 근약화·과다비성·기식 음성이 특징이다.\",\"2\":\"경직형은 양측 상위운동신경 손상으로 느리고 노력성인 말과 쥐어짜는 음성이 특징이다.\",\"4\":\"과소운동형은 기저핵(파킨슨병) 병변으로 단조로운 음도·감소된 강도·말속도 가속을 보인다.\",\"5\":\"과다운동형은 기저핵 병변으로 불수의 운동에 따른 말의 변이를 보이며 소뇌 손상과 관련이 없다.\"}},\"1-1-1-16\":{\"w\":{\"1\":\"이완형은 하위운동신경 손상에 의한 근약화·저긴장으로 기식 음성을 보이며 쥐어짜는 음성과 다르다.\",\"2\":\"과소운동형은 기저핵 병변으로 단조로운 음도와 말속도 가속을 보인다.\",\"3\":\"실조형은 소뇌 손상으로 불규칙한 조음 붕괴와 강세 이상을 보인다.\",\"4\":\"편측 상부운동신경형은 한쪽 상위운동신경 손상으로 증상이 대체로 경미하므로 '양측' 손상 소견과 맞지 않는다.\"}},\"1-1-1-17\":{\"p\":\"안면신경·설하신경 등 뇌신경의 하위운동신경 손상으로 침범 근육의 약화와 위축이 나타난다. 과다비성, 기식 음성, 부정확한 자음은 이완형 마비말장애의 특징이다.\",\"w\":{\"1\":\"과다운동형은 기저핵 병변에 의한 불수의 운동이 특징이다.\",\"2\":\"경직형은 상위운동신경 양측 손상으로 근긴장 증가와 쥐어짜는 음성을 보인다.\",\"3\":\"실조형은 소뇌 손상으로 불규칙한 조음 붕괴를 보인다.\",\"5\":\"과소운동형은 기저핵 병변(파킨슨병)으로 단조로운 음도와 강도 감소를 보이며 근위축과 관련이 없다.\"}},\"1-1-1-18\":{\"p\":\"우반구 손상 환자는 음운·구문 등 언어 구조 자체는 비교적 보존되지만 담화 조직, 추론, 비유·유머 이해 등 화용언어와 운율에서 결함을 보인다. 시공간 처리 결함으로 좌측 무시가 동반될 수 있다.\",\"w\":{\"1\":\"심한 실문법증은 좌반구 브로카 영역 손상(브로카실어증)의 특징이다.\",\"2\":\"따라말하기의 선택적 손상은 전도실어증의 특징이다.\",\"3\":\"빈번한 음소착어는 전도실어증 등 좌반구 손상 실어증의 특징이다.\",\"5\":\"심한 청각적 이해력 손상은 베르니케실어증·전반실어증 등 좌반구 손상의 특징이다.\"}},\"1-1-1-19\":{\"w\":{\"1\":\"청각적 이해력이 심하게 손상된 전반실어증 환자는 MIT의 적용 대상이 아니다.\",\"3\":\"베르니케실어증 환자는 유창하지만 이해력이 낮아 MIT 적용 대상이 아니다.\",\"4\":\"우반구 손상 환자의 화용 결함은 MIT의 목표가 아니며 우반구 기능 활용 원리와도 맞지 않는다.\",\"5\":\"과다비성은 마비말장애의 공명 문제로 MIT의 적용 대상이 아니다.\"}},\"1-1-1-20\":{\"w\":{\"1\":\"멜로디억양치료는 멜로디·리듬을 이용해 비유창 실어증의 발화 산출을 유도하는 치료이다.\",\"3\":\"시각동작치료는 구어 대신 몸짓 상징을 훈련하는 전반실어증 치료이다.\",\"4\":\"각본치료는 일상 대화 각본을 반복 연습하여 자동화하는 치료이다.\",\"5\":\"성문위삼킴법은 흡인을 방지하는 삼킴 기법으로 이름대기와 무관하다.\"}},\"1-1-1-21\":{\"p\":\"한국판 보스턴이름대기검사(K-BNT)는 흑백 선화 60개를 보고 이름을 말하게 하는 대면 이름대기(confrontation naming) 검사이다. 자발적으로 이름을 대지 못하면 의미 단서와 음소 단서를 제공한다.\",\"w\":{\"1\":\"K-BNT는 구어로 이름을 말하는 검사이며 쓰기 표현을 평가하지 않는다.\",\"2\":\"청각적 이해력은 PK-WAB-R의 알아듣기 등으로 평가한다.\",\"3\":\"문장 따라말하기는 PK-WAB-R의 따라말하기 영역에서 평가한다.\",\"5\":\"읽기 이해는 읽기 검사 영역으로 K-BNT의 평가 대상이 아니다.\"}},\"1-1-1-22\":{\"w\":{\"1\":\"성문위삼킴법은 숨을 참아 진성대 수준에서 기도를 폐쇄하여 흡인을 방지하는 기법이다.\",\"2\":\"최대성문위삼킴법은 숨을 참고 힘을 주어 가성대·피열연골 수준까지 기도 입구를 폐쇄하는 기법이다.\",\"3\":\"노력삼킴은 힘껏 삼켜 혀 기저부 후방 운동을 증가시키고 후두개곡 잔여물을 줄이는 기법이다.\",\"5\":\"머리 회전법은 약한 쪽으로 머리를 돌려 그쪽 인두 경로를 닫고 건강한 쪽으로 음식물을 통과시키는 자세 기법이다.\"}},\"1-1-1-23\":{\"w\":{\"1\":\"조음은 알츠하이머성 치매에서 말기까지 비교적 보존된다.\",\"2\":\"구문 구조는 초기에 비교적 보존되고 후기에야 단순화된다.\",\"3\":\"따라말하기는 초기에 비교적 보존된다.\",\"4\":\"함구증은 말기 단계에서 나타나는 특징이다.\"}},\"1-1-1-24\":{\"w\":{\"1\":\"fMRI는 과제 수행 중 혈류 변화를 측정하는 기능적 영상이므로 구조적 병변만 보여준다는 설명은 틀리다.\",\"3\":\"CT는 구조적 영상이며 과제 수행 중 뇌 활성화를 측정하지 않는다.\",\"4\":\"DTI는 물 분자의 확산 방향성을 이용해 백질 신경섬유로의 구조·연결성을 보여주며 혈류 속도를 측정하지 않는다.\",\"5\":\"CT·구조 MRI·DTI처럼 구조적 정보를 제공하는 영상도 있으므로 틀리다.\"}},\"1-1-1-25\":{\"w\":{\"1\":\"2.25는 총 9낱말(9 ÷ 4)로 계산한 값으로 낱말을 여럿 누락한 오답이다.\",\"2\":\"2.5는 총 10낱말(10 ÷ 4)로 계산한 값으로 낱말 두 개를 빠뜨린 경우이다.\",\"3\":\"2.75는 총 11낱말(11 ÷ 4)로, '나도'를 한 낱말로 세어 체언 뒤 조사 '도'를 따로 세지 않은 오답이다.\",\"5\":\"3.25는 총 13낱말(13 ÷ 4)로, 합성어 '곰인형'까지 '곰/인형'으로 나누어 과다 계산한 오답이다.\"}},\"1-1-1-26\":{\"p\":\"아동은 '가위', '시계', '칫솔'의 목표 낱말을 산출하지 못하고 '자르는 거'(기능), '똑딱똑딱'(소리 특징), '이 닦는 거'(기능)로 대신 설명하고 있다. 이는 에두르기(circumlocution)로, 의미 지식은 있으나 낱말 인출에 어려움이 있음을 시사한다.\",\"w\":{\"2\":\"음소착어는 목표 낱말의 음소를 대치·첨가·생략하는 오류(예: 가위→가비)로, 기능 설명 반응과 다르다.\",\"3\":\"보속은 이전 반응을 다음 자극에 반복하는 것이나 세 반응은 각각 다르다.\",\"4\":\"세 항목 모두 목표 낱말을 산출하지 못했으므로 정상 범위로 볼 수 없다.\",\"5\":\"반응은 모두 목표와 의미적으로 관련된 실제 표현이므로 의미 없는 신조어가 아니다.\"}},\"1-1-1-27\":{\"p\":\"이야기에는 '그리고'(나열·순서), '그런데'(대조), '왜냐하면'(인과)의 접속부사가 사용되어 문장과 사건을 논리적으로 연결하고 있다. 이러한 접속 표현은 담화의 결속표지로서 이 이야기에서 가장 두드러진 언어 특성이다.\",\"w\":{\"1\":\"이야기에 '그것'이라는 지시 대용어가 쓰였으므로 대용어를 전혀 사용하지 않았다고 볼 수 없다.\",\"2\":\"배경·계기사건(당근을 심음), 시도(물을 줌), 결과(자라지 않음)와 이유 설명 등 이야기 문법 요소가 나타난다.\",\"4\":\"'토끼가', '당근을', '-었어요' 등 조사와 어미가 모두 바르게 사용되었다.\",\"5\":\"'씨앗을 거꾸로 심었기 때문이에요'처럼 명사절이 안긴 복문이 포함되어 있다.\"}},\"1-1-1-28\":{\"p\":\"KOLRA(한국어 읽기 검사)는 해독, 읽기이해, 읽기 유창성, 음운처리 등 읽기 능력과 관련 인지 처리를 평가하는 검사이다. 자발화 산출 능력은 평가 영역이 아니므로 연결이 옳지 않다.\",\"w\":{\"1\":\"REVT는 수용·표현 어휘력을 평가하므로 올바른 연결이다.\",\"3\":\"언어문제해결력검사는 원인 이유, 해결 추론, 단서 추측 등 상위언어·추론 능력을 평가하므로 올바른 연결이다.\",\"4\":\"PRES는 취학 전 아동의 수용·표현 언어 발달을 평가하므로 올바른 연결이다.\",\"5\":\"KOSECT는 구문의미 이해력을 평가하므로 올바른 연결이다.\"}},\"1-1-1-29\":{\"p\":\"가정에서는 베트남어만 사용하고 만 3세 어린이집 입소 후 한국어에 처음 본격 노출되었으므로 순차적 이중언어 아동이다. 한국어 노출 기간이 약 2년으로 짧아 한국어 수행이 낮게 나타날 수 있으므로 노출 기간과 모국어 능력을 함께 고려해 해석해야 한다.\",\"w\":{\"1\":\"만 3세 이후 제2언어에 노출되었으므로 동시적 이중언어가 아니며, 단일언어 규준을 그대로 적용할 수도 없다.\",\"2\":\"한국어 검사만으로는 노출 부족과 언어장애를 구별할 수 없으므로 모국어 능력 평가가 함께 필요하다.\",\"3\":\"모국어 사용 중단은 부모-자녀 상호작용의 질을 떨어뜨리므로 권고하지 않는다.\",\"4\":\"이중언어 노출 자체는 언어지연의 원인이 아니다.\"}},\"1-1-1-30\":{\"p\":\"아동은 인지·언어 이해력은 연령 수준이나 사지 운동 조절이 어려워 손가락 직접선택이 불가능하다. 눈 움직임과 머리 움직임이 안정적이므로 시선 응시를 통한 선택이나 머리 스위치를 이용한 스캐닝(간접선택)이 가장 적절하다.\",\"w\":{\"1\":\"수어는 정교한 손 움직임이 필요하므로 사지 운동 조절이 어려운 아동에게 적절하지 않다.\",\"2\":\"필담은 손으로 글씨를 써야 하므로 사지 운동장애 아동에게 부적절하다.\",\"3\":\"구어 산출이 어려운 아동에게 구어 훈련만 하면 기능적 의사소통 수단이 마련되지 않는다.\",\"5\":\"손가락으로 상징을 짚는 것이 불가능하다고 제시되어 있으므로 직접선택은 부적절하다.\"}},\"1-1-1-31\":{\"p\":\"낱말·비단어 읽기의 속도와 정확도가 또래 수준이므로 해독 능력에는 문제가 없다. 읽은 글의 이해·요약에서만 크게 어려워하고, 들려주면 이해하는 등 듣기이해는 양호하다. 해독은 정상이면서 읽기이해만 저조한 양상은 읽기이해부진에 해당한다.\",\"w\":{\"1\":\"난독증(해독 부진)은 낱말·비단어 해독의 정확도·유창성 결함이 핵심인데 이 아동은 해독이 또래 수준이다.\",\"3\":\"말소리장애는 조음·음운 산출의 문제로 제시된 소견과 무관하다.\",\"4\":\"쓰기 능력에 대한 정보가 없으며 핵심 문제는 읽기이해이다.\",\"5\":\"유창성장애는 말의 흐름(말더듬 등) 문제로 읽기이해와 무관하다.\"}},\"1-1-1-32\":{\"p\":\"상대의 말이 끝나기 전에 끼어들고(차례 주고받기 실패), 자신의 관심사만 일방적으로 말하며(주제 유지·전환 실패), 질문에 맞지 않게 대답하는(대화 연결 실패) 것은 대화 규칙의 어려움이다. 따라서 대화 차례 주고받기와 주제 유지를 우선 화용 목표로 설정한다.\",\"w\":{\"1\":\"낱말 해독 정확도는 읽기 영역의 목표로 제시된 화용 문제와 무관하다.\",\"2\":\"조음 정확도는 말소리 영역 목표로 제시된 문제와 무관하다.\",\"3\":\"MLU는 구문 길이 지표로 화용 능력 목표가 아니다.\",\"5\":\"음절·음소 인식은 읽기 선행 기술로 화용 목표가 아니다.\"}},\"1-1-1-33\":{\"w\":{\"2\":\"서술하기는 사물·사건에 대한 정보를 공유하는 기능으로 첫 번째 행동(요구)과 맞지 않는다.\",\"3\":\"첫 번째 행동은 거부가 아니라 요구이며, 두 번째 행동은 인사하기가 아니다.\",\"4\":\"공동주의(공동관심)는 사물에 대한 관심을 공유하는 기능으로 사물 획득이 목적인 첫 번째 행동과 다르다.\",\"5\":\"두 번째 행동은 관심 공유가 아니라 거부이다.\"}},\"1-1-1-34\":{\"p\":\"REVT 백분위수 수용 8, 표현 6으로 모두 10%ile 미만이어서 또래 대비 유의한 어휘 지체에 해당한다. 비언어성 지능과 청력이 정상이므로 언어 영역에 특정된 어려움이며, 자발화에서 제한된 어휘와 조사 생략이 관찰되므로 어휘 중심 언어치료가 필요하다고 상담한다.\",\"w\":{\"2\":\"청력이 정상이므로 청력 손실을 원인으로 볼 수 없다.\",\"3\":\"비언어성 지능이 정상 범위이므로 지능 저하가 원인이라 할 수 없다.\",\"4\":\"평가 결과는 어휘·문법의 문제이며 발음 문제에 대한 단서가 없다.\",\"5\":\"백분위수 10 미만은 정상 범위가 아니므로 치료가 필요하다.\"}},\"1-1-1-35\":{\"p\":\"원하는 주스를 눈에 보이지만 손이 닿지 않는 곳에 두고, 뚜껑을 꼭 닫아 도움이 필요한 상황을 만든 뒤 반응을 기다리고 있다. 이는 환경중심 언어중재에서 환경을 조작하여 아동의 자발적 요구하기를 유도하는 환경 조성 전략이다.\",\"w\":{\"1\":\"청각적 집중 자극은 목표 언어 형태를 반복적으로 들려주는 기법으로 반응을 기다리는 본 장면과 다르다.\",\"2\":\"스크립트 문맥 활용은 익숙한 일상 사건의 순서를 활용하는 중재이다.\",\"3\":\"비연속 개별시도 교수는 치료사가 자극-반응-강화를 통제하는 구조화된 행동주의 방법이다.\",\"4\":\"반응대가는 오반응 시 이미 받은 강화물을 회수하는 행동 감소 기법이다.\"}},\"1-1-1-36\":{\"p\":\"복문 산출·문법형태소, 조음, 읽기 해독은 연령 수준이다. 그러나 상위개념 어휘 이해(하위 5%)와 동의어·반의어 표현(하위 3%)에서만 유의한 지체를 보이므로, 어휘의 의미 관계(상위어·동의어·반의어)를 확장하는 중재를 우선 목표로 설정한다.\",\"w\":{\"1\":\"문법형태소 사용이 연령 수준이므로 우선 목표가 아니다.\",\"2\":\"읽기 해독이 연령 수준이므로 우선 목표가 아니다.\",\"3\":\"복문 산출이 연령 수준이므로 우선 목표가 아니다.\",\"4\":\"조음이 연령 수준이므로 우선 목표가 아니다.\"}},\"1-1-1-37\":{\"p\":\"상대의 말을 그대로 따라 말하는 반향어, 너/나를 뒤바꾸는 대명사 전도, 특정 관심사의 반복적 언급(제한된 관심사), 부족한 눈맞춤은 사회적 의사소통 결함과 제한적·반복적 행동을 함께 보이는 자폐스펙트럼장애의 대표적 특징이다.\",\"w\":{\"1\":\"단순언어장애는 언어 발달 지체가 주된 문제이며 반향어·제한된 관심사·눈맞춤 부족을 핵심 특징으로 하지 않는다.\",\"2\":\"청각장애 아동은 반향어와 대명사 전도, 제한된 관심사를 핵심 특징으로 보이지 않는다.\",\"3\":\"지적장애는 전반적 인지 지체가 핵심이며 제시된 사회적 상호작용·반복 행동 특징을 설명하지 못한다.\",\"5\":\"조음음운장애는 말소리 산출의 문제로 제시된 특징과 무관하다.\"}},\"1-1-1-38\":{\"p\":\"T-unit은 하나의 주절과 그에 딸린 종속절(내포절)을 한 단위로 센다. '토끼랑 거북이가 달리기를 했어요'(1), '토끼는 빨리 뛰다가 낮잠을 잤어요'(종속적 연결어미 '-다가'로 이어진 1), '그래서 거북이가 먼저 도착했어요'(1)로 총 3개이다.\",\"w\":{\"1\":\"2는 세 문장 중 하나를 앞 문장에 합쳐 센 과소 계산이다.\",\"3\":\"4는 '뛰다가'의 종속절을 별도 T-unit으로 분리한 오답이다.\",\"4\":\"5는 종속절과 절 단위를 과도하게 분리해 센 오답이다.\",\"5\":\"6은 T-unit이 아닌 절 또는 어절 단위로 과다 계산한 오답이다.\"}},\"1-1-1-39\":{\"p\":\"'창문이 열려 있네'가 '창문을 닫아 달라'는 요청일 수 있음을 아는 것은 간접 화행의 이해이다. 딴짓하는 학생에게 '지금 뭐 하고 있니?'라고 묻는 것이 실제 질문이 아니라 주의를 주는 말임을 아는 것은 함축된 의도의 이해이다. 이는 문자적 의미 너머의 의도를 파악하는 상위화용 능력이다.\",\"w\":{\"1\":\"음운인식은 말소리 단위를 인식·조작하는 능력으로 제시된 질문과 무관하다.\",\"2\":\"구문 산출 능력은 문장 구조를 만드는 능력으로 의도 해석 과제와 무관하다.\",\"4\":\"낱말 해독은 글자를 소리로 바꾸어 읽는 능력으로 제시된 구어 질문과 무관하다.\",\"5\":\"조음 정확도는 말소리 산출 능력으로 제시된 과제와 무관하다.\"}},\"1-1-1-40\":{\"p\":\"아동의 '차 가'를 치료사가 의미는 그대로 유지한 채 조사 '-가'와 어미 '-네'를 보태 '차가 가네'로 문법적으로 완전하게 다시 들려주었다. 이는 확장(expansion)에 해당한다.\",\"w\":{\"2\":\"혼잣말기법은 치료사가 자신의 행동을 스스로 말로 표현하는 기법이다.\",\"3\":\"평행발화기법은 아동의 행동이나 관심을 아동 입장에서 대신 말해 주는 기법이다.\",\"4\":\"확대(extension)는 아동 발화에 새로운 의미 정보를 덧붙이는 기법(예: '빨간 차가 빨리 가네')이다.\",\"5\":\"분리 및 합성은 아동 발화를 요소로 나누었다가 다시 합쳐 들려주는 기법이다.\"}},\"1-1-1-41\":{\"p\":\"스크립트 중재는 생일잔치, 마트 놀이처럼 아동에게 친숙한 일상 사건의 순서(스크립트)를 활용한다. 사건 구조가 익숙해 인지적 부담이 줄어들므로 새로운 언어 형식의 학습과 사용이 촉진된다.\",\"w\":{\"1\":\"감각통합 치료는 감각 처리·조절 능력을 향상시키는 작업치료적 접근이다.\",\"2\":\"청지각 훈련은 소리 변별·기억 등 청지각 능력을 훈련하는 접근이다.\",\"4\":\"핵심어휘 접근법은 사용 빈도가 높은 핵심 어휘를 중심으로 지도하는 접근으로 사건 순서 활용과 다르다.\",\"5\":\"청각구어법은 청각장애 아동의 잔존 청력을 활용해 듣기·말하기를 발달시키는 접근이다.\"}},\"1-1-1-42\":{\"w\":{\"1\":\"치료사가 자극과 강화를 모두 통제하는 개별시도 형식은 비연속 개별시도 교수(DTT)의 특징이다.\",\"3\":\"구조화된 책상 과제와 인위적 강화물 사용은 DTT의 특징이며 PRT와 반대된다.\",\"4\":\"PRT는 의사소통·사회적 행동을 목표로 하며 구강운동 훈련에 초점을 두지 않는다.\",\"5\":\"PRT는 아동 주도를 활용하므로 성인 주도 지시 따르기 우선은 틀리다.\"}},\"1-1-1-43\":{\"w\":{\"1\":\"0.4는 공식에 맞지 않는 계산 오류 값이다(16 ÷ 40에 해당).\",\"3\":\"0.6은 공식에 맞지 않는 계산 오류 값이다(24 ÷ 40에 해당).\",\"4\":\"0.8은 공식에 맞지 않는 계산 오류 값이다(32 ÷ 40에 해당).\",\"5\":\"2.0은 분자와 분모를 뒤바꿔 40 ÷ 20으로 계산한 오답이며, TTR은 1을 넘을 수 없다.\"}},\"1-1-1-44\":{\"p\":\"PECS 1단계(교환)는 아동이 원하는 사물의 그림카드를 집어 의사소통 상대에게 건네고 그 사물을 받는 교환 행동을 지도한다. 요구하기의 기본 형태를 가장 먼저 확립한다.\",\"w\":{\"1\":\"여러 그림 중 목표 그림을 변별하는 것은 3단계(그림 변별)이다.\",\"2\":\"'나는 ~을 원해요' 문장판 구성은 4단계(문장 구성)이다.\",\"3\":\"그림으로 감정·경험을 설명하는 것은 이후 단계의 언급하기(설명하기)에 해당한다.\",\"4\":\"PECS는 그림 교환 체계이며 그림 없이 음성으로 요구하는 것은 1단계 목표가 아니다.\"}},\"1-1-1-45\":{\"w\":{\"1\":\"시도는 주인공이 목표를 이루기 위해 하는 행동으로 이야기 문법 요소이다.\",\"2\":\"계기사건은 이야기를 시작하게 하는 사건으로 이야기 문법 요소이다.\",\"3\":\"내적 반응은 계기사건에 대한 인물의 감정·생각으로 이야기 문법 요소이다.\",\"5\":\"배경은 인물·시간·장소를 소개하는 이야기 문법 요소이다.\"}},\"1-1-1-46\":{\"p\":\"K-CTONI-2 지능지수 96으로 인지는 정상이고, 눈맞춤이 짧으며 상황에 맞지 않는 말, 주제 이탈, 비유·간접표현의 문자적 이해 등 화용 결함이 두드러진다(KOPLAC 3%ile). 제한된 관심사·상동행동·감각 특이성이 관찰되지 않으므로 사회적(화용) 의사소통장애로 진단한다.\",\"w\":{\"1\":\"자폐스펙트럼장애는 제한적·반복적 행동이 함께 나타나야 하는데 관찰되지 않았다.\",\"2\":\"비언어성 지능지수 96은 정상 범위이므로 지적장애가 아니다.\",\"4\":\"단순언어장애는 어휘·문법 등 언어 구조 결함이 핵심이며 본 아동은 화용 결함이 두드러진다.\",\"5\":\"학습장애는 읽기·쓰기·수학 등 학업 기술의 결함으로 제시된 화용 문제와 맞지 않는다.\"}},\"1-1-1-47\":{\"p\":\"제시된 오류는 형태소 규칙으로 설명되지 않는 관습적 표기 낱말에서 나타난다. 이러한 낱말은 소리나 형태소 분석만으로는 올바른 표기를 도출하기 어려우므로, 낱말의 표기형(철자 패턴) 자체를 기억하고 인출하도록 돕는 표기처리 중심 중재가 적절하다.\",\"w\":{\"2\":\"형태소의 원형을 밝혀 적는 형태처리 중재는 형태소 규칙으로 설명되는 표기에 효과적이며, 관습적 표기 오류를 해결하기 어렵다.\",\"3\":\"소리 나는 대로 적도록 하면 '할께요', '몇일'과 같은 오류를 오히려 강화한다.\",\"4\":\"쓰기(철자) 오류이므로 조음 중재와 무관하다.\",\"5\":\"읽기 유창성 훈련은 철자 표기 오류를 직접 다루지 않는다.\"}},\"1-1-1-48\":{\"w\":{\"1\":\"모든 발화가 두 낱말 조합으로 절을 이어 붙인 복문은 나타나지 않는다.\",\"3\":\"한 낱말 시기는 하나의 낱말로 의사소통하는 단계로 두 낱말 조합이 나타난 본 자료와 맞지 않는다.\",\"4\":\"문법형태소 자체가 아직 나타나지 않으므로 형태소 오류가 빈번한 단계로 볼 수 없다.\",\"5\":\"이야기 문법을 갖춘 담화는 학령전기 이후에 나타난다.\"}},\"1-1-1-49\":{\"w\":{\"1\":\"예기투쟁가설은 말더듬을 예상하고 이를 피하려는 긴장·투쟁 반응이 말더듬이라고 보는 이론으로, 부모의 오진단을 핵심으로 하지 않는다.\",\"3\":\"요구용량모델은 환경의 요구가 아동의 유창성 용량을 초과할 때 말더듬이 나타난다고 본다.\",\"4\":\"내적수정가설은 음운 부호화 오류를 내적으로 탐지·수정하는 과정에서 비유창성이 생긴다고 본다.\",\"5\":\"대뇌반구우세이론은 한쪽 대뇌반구의 우세성이 확립되지 않아 말운동 조절에 문제가 생긴다고 본다.\"}},\"1-1-1-50\":{\"w\":{\"1\":\"2회는 반복 2회만 세고 막힘과 연장을 누락한 계산이다.\",\"2\":\"3회는 막힘 또는 연장 중 하나를 누락한 계산이다.\",\"4\":\"5회는 간투사 '어'를 SLD에 포함한 오답이다.\",\"5\":\"6회는 반복의 반복 횟수 등을 개별적으로 과다 계산한 오답이다.\"}},\"1-1-1-51\":{\"w\":{\"1\":\"6%는 9 ÷ 150에 해당하는 값으로 계산 오류이다.\",\"3\":\"10%는 15 ÷ 150에 해당하는 값으로 계산 오류이다.\",\"4\":\"12.5%는 분자와 분모를 뒤바꿔 150 ÷ 12로 계산한 오답이다.\",\"5\":\"15%는 계산 오류이다(말더듬 음절이 22.5개일 때의 값).\"}},\"1-1-1-52\":{\"p\":\"빙산 모델(Sheehan)에서 수면 위는 반복·연장·막힘과 부수행동처럼 겉으로 관찰되는 행동이다. 수면 아래는 말더듬에 대한 두려움, 수치심, 죄책감, 좌절, 회피 등 드러나지 않는 감정과 태도로, 빙산처럼 더 큰 부분을 차지한다.\",\"w\":{\"1\":\"반복·연장·막힘은 관찰 가능한 핵심행동으로 수면 위에 해당한다.\",\"2\":\"관찰 가능한 신체적 부수행동은 수면 위에 해당한다.\",\"3\":\"말속도와 조음 정확도는 관찰·측정 가능한 말 특성으로 수면 아래 요소가 아니다.\",\"5\":\"문법 오류는 언어적 요소로 빙산 모델의 구성 요소가 아니다.\"}},\"1-1-1-53\":{\"p\":\"아동기 병력 없이 가족을 잃은 심리적 외상 후 성인기에 갑자기 발생하였다. 낱말 유형·위치와 무관한 일관된 반복, 반복 읽기에도 빈도가 줄지 않음(적응효과 없음), 부수행동·불안 부재는 심인성 말더듬의 특징이다.\",\"w\":{\"1\":\"위장 말더듬은 이득을 얻기 위해 의도적으로 더듬는 것으로 제시된 정보에 그런 동기가 없다.\",\"2\":\"신경학적 말더듬은 뇌졸중·외상성 뇌손상 등 신경학적 손상 병력이 있어야 하는데 제시되지 않았다.\",\"4\":\"속화는 빠르고 불규칙한 말속도와 명료도 저하가 특징이며 외상 후 급성 발병과 맞지 않는다.\",\"5\":\"발달성 말더듬은 대부분 2~5세에 시작되므로 아동기 병력 없는 성인기 발병과 맞지 않는다.\"}},\"1-1-1-54\":{\"w\":{\"1\":\"필수과제는 약함이지만 의사소통태도 17점은 초등학생 기준 81~90%ile로 '심함'이다. 두 결과가 모두 약할 때 유창성 완성법에 비중을 둔다.\",\"3\":\"두 결과가 모두 심할 때 말더듬 수정법과 심리치료 의뢰를 고려한다. 이 아동은 필수과제가 1~10%ile로 말더듬 정도가 '약함'이다.\",\"4\":\"의사소통태도 평가는 말을 더듬는 사람이 할 법한 답에 1점을 주므로 점수가 높을수록 부정적이다. 채점 방향이 반대이다.\",\"5\":\"P-FA-II 백분위는 말더듬 정도를 나타내며 1~10%ile은 '약함'이다. 정상 범위라는 뜻이 아니고, 의사소통태도가 심하므로 치료가 필요하다.\"}},\"1-1-1-55\":{\"p\":\"부모가 훈련을 받아 가정의 일상 대화에서 중재하며, 유창한 발화에 언어적 칭찬을, 말더듬에 간헐적 자기수정 요청을 제공한다. 치료사는 매주 말더듬 심한 정도(SR) 기록을 확인한다. 이는 조작적 조건화에 기반한 학령전기 부모 주도 프로그램인 리드콤 프로그램이다.\",\"w\":{\"1\":\"스토커 프로브 테크닉은 질문-응답의 단계적 복잡성으로 유창성을 높이는 치료사 중심 기법이다.\",\"2\":\"말더듬수정법은 말더듬을 편안하게 더듬도록 수정하는 기법(취소·빠져나오기·예비책)으로 부모의 언어적 유관 제공과 다르다.\",\"4\":\"GILCU는 치료사가 발화 길이와 복잡성을 단계적으로 늘려 가는 프로그램이다.\",\"5\":\"페일린 부모-아동 상호작용치료는 부모의 상호작용 방식(말속도, 차례 주고받기 등)을 조정하는 간접치료로, 말더듬에 대한 직접 수정 요청을 사용하지 않는다.\"}},\"1-1-1-56\":{\"w\":{\"1\":\"가벼운 조음접촉은 조음기관을 가볍게 접촉하는 유창성완성법의 기법이다.\",\"2\":\"빠져나오기는 말더듬이 일어나는 도중에 긴장을 풀며 벗어나는 기법이다.\",\"3\":\"예비책은 말더듬이 예상되는 낱말을 산출하기 직전에 적용하는 기법이다.\",\"4\":\"둔감화는 말더듬과 관련된 두려움·부정적 감정을 줄이는 단계이다.\"}},\"1-1-1-57\":{\"p\":\"빠르고 불규칙한 말속도, 음절 생략·낱말 축약에 의한 명료도 저하, 주제 이탈과 발화 조직화 어려움, 문제 인식 부족은 속화의 특징이다. 따라서 말속도를 낮추고 쉼을 넣는 말속도 조절과 녹음 청취 등을 통한 자기 모니터링 훈련을 우선 적용한다.\",\"w\":{\"1\":\"가벼운 조음접촉은 말더듬의 막힘을 줄이는 유창성완성법 기법이다.\",\"2\":\"호흡-발성 협응 훈련은 속화의 핵심 문제(말속도, 자기 인식)를 다루지 않는다.\",\"4\":\"둔감화는 말더듬에 대한 두려움을 다루는 기법으로 문제 인식이 부족한 속화와 맞지 않는다.\",\"5\":\"회피행동 감소 훈련은 말더듬의 회피행동을 다루는 것으로, 속화 화자는 대개 회피행동을 보이지 않는다.\"}},\"1-1-1-58\":{\"w\":{\"1\":\"말속도와 조음정확도는 SSI-4 중증도 산출 요소가 아니다.\",\"2\":\"어휘다양도와 발화길이는 언어 분석 지표로 SSI-4 산출 요소가 아니다.\",\"3\":\"음도와 강도는 음성 지표로 SSI-4 산출 요소가 아니다.\",\"4\":\"의사소통태도·자아효능감·회피는 별도의 자기보고 척도로 측정하며 SSI-4 산출 요소가 아니다.\"}},\"1-1-1-59\":{\"w\":{\"1\":\"SESAS는 말더듬 빈도를 측정하지 않으며 점수 상승은 긍정적 변화를 의미한다.\",\"2\":\"점수 상승은 부정적 변화가 아니라 긍정적 변화이다.\",\"3\":\"점수 상승은 말에 대한 통제력(자신감)의 증가를 의미한다.\",\"4\":\"44점 상승은 치료 효과가 나타났음을 시사한다.\"}},\"1-1-1-60\":{\"p\":\"아버지는 더듬을 때마다 '천천히 말해', '다시 말해 봐'라고 지적하고 말을 대신 끝맺어 주고 있다. 지적·교정·대신 말하기는 아동의 긴장과 시간 압박을 높이므로, 지적을 줄이고 말을 끝까지 기다리며 느리고 편안한 대화 분위기를 만들도록 상담한다.\",\"w\":{\"1\":\"즉각적 교정은 아동의 말에 대한 의식과 긴장을 높인다.\",\"2\":\"말을 대신 끝맺는 것은 시간 압박을 주고 표현 기회를 빼앗는다.\",\"4\":\"빠른 말 시범은 아동의 말속도 압박을 높이므로 느린 말 시범이 권장된다.\",\"5\":\"더듬은 낱말을 반복시키는 것은 말더듬에 대한 부정적 주의를 높인다.\"}},\"1-1-1-61\":{\"w\":{\"1\":\"막힘은 핵심행동이다.\",\"2\":\"소리 연장은 핵심행동이다.\",\"3\":\"단어부분 반복은 핵심행동이다.\",\"4\":\"음절 반복은 핵심행동이다.\"}},\"1-1-1-62\":{\"w\":{\"2\":\"남아의 유병률이 여아보다 높다는 것은 옳은 설명이다.\",\"3\":\"상당수가 자연회복된다는 것은 옳은 설명이다.\",\"4\":\"유전적 요인이 관여한다는 것은 옳은 설명이다.\",\"5\":\"대부분 2~5세에 시작된다는 것은 옳은 설명이다.\"}},\"1-1-1-63\":{\"w\":{\"2\":\"완전히 유창한 말의 확립은 유창성완성법의 목표이다.\",\"3\":\"말더듬수정법은 말더듬의 완전 제거를 목표로 하지 않는다.\",\"4\":\"말더듬수정법은 회피행동을 줄이는 것을 목표로 한다.\",\"5\":\"느린 말의 영구적 사용은 말더듬수정법의 목표가 아니며, 느린 말은 유창성완성법의 초기 확립 수단이다.\"}},\"1-1-1-64\":{\"w\":{\"1\":\"긴장된 막힘은 진성 비유창성(SLD)에 해당한다.\",\"2\":\"소리 연장은 진성 비유창성에 해당한다.\",\"3\":\"긴장을 동반한 음절 반복은 진성 비유창성에 해당한다.\",\"5\":\"긴장을 동반한 일음절 낱말 반복은 진성 비유창성에 해당한다.\"}},\"1-1-1-65\":{\"w\":{\"1\":\"뇌졸중·외상성 뇌손상 이후 발생한다는 것은 옳은 설명이다.\",\"2\":\"적응효과가 잘 나타나지 않는다는 것은 옳은 설명이다.\",\"3\":\"낱말 유형·위치와 무관하게 나타난다는 것은 옳은 설명이다.\",\"4\":\"발달성 말더듬에 비해 부수행동·불안이 적다는 것은 옳은 설명이다.\"}},\"1-1-1-66\":{\"w\":{\"1\":\"대뇌우세이론은 대뇌반구 우세성의 불완전 확립을 말더듬 원인으로 보는 이론이다.\",\"2\":\"진단착오이론은 부모의 오진단과 부정적 반응이 말더듬을 만든다고 보는 이론이다.\",\"3\":\"요구용량모델은 환경의 요구가 아동의 용량을 초과할 때 말더듬이 나타난다고 보는 이론이다.\",\"5\":\"이원이론(Brutten & Shoemaker)은 고전적 조건화된 부정적 정서가 핵심 비유창을, 조작적 조건화가 부수행동을 만든다고 보는 이론이다.\"}},\"1-1-1-67\":{\"p\":\"적응효과는 같은 자료를 반복해서 읽을수록 말더듬 빈도가 점차 감소하는 현상이다. 발달성 말더듬에서 흔히 관찰되며 신경학적·심인성 말더듬과의 감별에 활용된다.\",\"w\":{\"1\":\"일관성효과는 반복 읽기에서 같은 낱말·위치에서 반복적으로 더듬는 경향이다.\",\"2\":\"자발회복(자연회복)은 치료 없이 말더듬이 사라지는 현상이다.\",\"3\":\"인접효과는 이전에 더듬은 위치에 인접한 곳에서 새로운 말더듬이 나타나는 경향이다.\",\"4\":\"후속효과는 반복 읽기에 따른 말더듬 빈도 감소를 가리키는 용어가 아니다.\"}},\"1-1-1-68\":{\"w\":{\"1\":\"에둘러 말하기는 어려운 낱말을 피하는 회피행동이다.\",\"3\":\"말할 순서를 미루는 것은 발화 시점을 피하는 회피행동이다.\",\"4\":\"전화 받기를 피하는 것은 상황 회피행동이다.\",\"5\":\"낱말을 다른 낱말로 바꾸는 것은 낱말 대치 회피행동이다.\"}},\"1-1-1-69\":{\"w\":{\"1\":\"느린 말·부드러운 발성 시작으로 유창한 말을 확립하는 것은 유창성완성법의 옳은 설명이다.\",\"2\":\"가벼운 조음접촉은 유창성완성법의 대표 기법이다.\",\"3\":\"확립된 유창성을 실제 상황으로 일반화하는 것은 유창성완성법의 옳은 설명이다.\",\"4\":\"말더듬 자체보다 유창한 말 패턴 형성에 초점을 두는 것은 유창성완성법의 옳은 설명이다.\"}},\"1-1-1-70\":{\"w\":{\"1\":\"차폐기는 소음으로 화자 자신의 말소리를 차단하는 기기로 지연 청취와 다르다.\",\"3\":\"비음측정기는 비음치(nasalance)를 측정하는 공명 평가 기기이다.\",\"4\":\"전기성문파형기는 성대 접촉 양상을 측정하는 음성 평가 기기이다.\",\"5\":\"스펙트로그램은 음향 신호의 주파수·시간·강도를 시각화하는 분석 도구이다.\"}},\"1-1-1-71\":{\"w\":{\"1\":\"말더듬 빈도는 %SS 등 발화 표본 분석으로 측정한다.\",\"2\":\"말더듬 지속시간은 SSI-4 등 관찰 측정으로 평가한다.\",\"4\":\"신체적 부수행동은 SSI-4 등 관찰 평가로 측정한다.\",\"5\":\"말속도는 발화 표본의 초당·분당 음절 수로 측정한다.\"}},\"1-1-1-72\":{\"w\":{\"2\":\"빠져나오기는 말더듬이 일어나는 도중에 적용하는 기법이다.\",\"3\":\"취소는 말더듬이 끝난 후 멈추었다가 다시 말하는 기법이다.\",\"4\":\"둔감화는 말더듬에 대한 두려움과 부정적 감정을 줄이는 단계이다.\",\"5\":\"고유수용감각 훈련은 조음 동작의 감각을 인식하도록 하는 확인 단계 활동으로, 말더듬 직전 긴장 완화 기법이 아니다.\"}},\"1-1-2-1\":{\"p\":\"음원-여과기 이론에서 성대 진동은 기본주파수(F0)와 그 배음을 포함한 음원 스펙트럼을 만들고, 성도(인두강·구강·비강)는 그 형태와 길이에 따라 특정 주파수 대역을 강조하거나 감쇠시키는 여과기로 작용한다. 성도의 공명 특성에 의해 강조된 주파수 대역이 포먼트이다. 따라서 음원(성대)과 여과기(성도)는 서로 독립적으로 작동하며, 포먼트는 음원이 아니라 여과기의 특성으로 결정된다.\",\"w\":{\"1\":\"포먼트는 성도의 형태·길이(공명 특성)에 의해 결정되며, 성대 진동수는 기본주파수와 배음 간격을 결정한다.\",\"2\":\"기본주파수는 성대의 길이·긴장도·질량과 성문하압에 의해 결정되며 성도 길이는 포먼트에 영향을 준다.\",\"4\":\"음원(후두의 성대)과 여과기(성문 위 성도)는 해부학적으로 분리된 구조이며 서로 독립적으로 작동한다는 것이 이 이론의 핵심이다.\",\"5\":\"폐의 공기압은 성대 진동을 일으키는 에너지원(동력원)이며 여과 기능은 성도가 담당한다.\"}},\"1-1-2-2\":{\"p\":\"음도는 성대의 진동수(기본주파수)에 의해 결정되며, 진동수는 성대의 길이·긴장도·질량의 영향을 받는다. 윤상갑상근(CT)이 수축하면 갑상연골이 앞아래로 기울어 성대가 길어지고 얇아지며 긴장되므로 단위 질량당 긴장도가 커져 진동수가 증가한다. 이것이 음도 상승의 대표적 생리 기전이다.\",\"w\":{\"1\":\"성대가 짧아지고 두꺼워지면 질량이 증가하고 긴장도가 감소하여 진동수가 낮아지므로 음도는 내려간다.\",\"3\":\"호기류량 증가만으로는 음도를 조절할 수 없으며, 음도는 주로 성대의 길이·긴장도 조절에 의해 결정된다.\",\"4\":\"성문하압을 높이면 진동수가 다소 증가하는 경향이 있으므로 성문하압을 낮추는 것은 음도 상승 기전이 아니다.\",\"5\":\"갑상피열근은 성대 몸체를 이루는 근육으로, 이 근육만 이완시키는 것은 음도 상승의 주된 기전이 아니며 음도 상승의 핵심은 윤상갑상근의 수축이다.\"}},\"1-1-2-3\":{\"p\":\"폐활량과 성문하압이 정상이므로 호흡 기능의 문제는 배제된다. MPT 5.2초는 성인 정상치(약 15~20초 이상)에 비해 현저히 짧고, 평균호기류율 260 mL/sec는 정상 범위(약 100~200 mL/sec)보다 증가하여 발성 중 성문에서 공기가 새는 성문폐쇄부전을 나타낸다. 여기에 기식적이고 약한 음성이 동반되므로 성대가 정중선으로 충분히 내전되지 못하는 편측 성대마비가 가장 적절하다.\",\"w\":{\"1\":\"근긴장성 발성장애는 후두 근육의 과긴장으로 쥐어짜는 음성을 보이며 대개 호기류율이 감소하는 경향이 있다.\",\"2\":\"라인케부종은 성대 전장의 부종으로 질량이 증가하여 낮고 거친 음성이 특징이며, 기식성·호기류율 증가가 핵심 소견이 아니다.\",\"4\":\"내전형 연축성발성장애는 과내전으로 인한 쥐어짜는 음성과 음성 끊김이 특징이며 호기류율은 감소한다.\",\"5\":\"변성발성장애는 변성기 이후에도 높은 음도가 유지되는 기능적 장애로, 성문폐쇄부전을 시사하는 공기역학적 소견과 관련이 없다.\"}},\"1-1-2-4\":{\"p\":\"음성장애지수(VHI)는 환자 스스로 음성 문제로 인해 겪는 불편감을 신체(Physical)·기능(Functional)·정서(Emotional) 세 영역으로 평정하는 자기보고식 설문이다. 문항에서 요구하는 '환자가 지각하는', '일상생활에 미치는 영향', '자기보고식'이라는 조건을 모두 충족한다.\",\"w\":{\"1\":\"CAPE-V는 평가자가 시각적 아날로그 척도로 음성 특성을 평정하는 청지각적 평가 도구이다.\",\"2\":\"MPT는 한 번의 흡기 후 최대로 발성을 지속하는 시간을 측정하는 공기역학적 지표이다.\",\"3\":\"GRBAS 척도는 평가자가 G·R·B·A·S 다섯 항목을 0~3점으로 평정하는 청지각적 평가 도구이다.\",\"5\":\"음성범위프로파일(VRP)은 음도별 최소·최대 강도를 측정하여 발성 가능 범위를 나타내는 음향학적 측정이다.\"}},\"1-1-2-5\":{\"w\":{\"1\":\"제시된 지표는 주기성·잡음 관련 측정치이며 음성 강도(dB)는 측정되지 않았다.\",\"3\":\"기본주파수(F0)가 성별·연령 규준 범위이므로 습관적 음도가 높다고 볼 수 없다.\",\"4\":\"MDVP의 jitter·shimmer·NHR은 발성(음원)의 규칙성을 반영하며 공명 문제는 비음치 등 별도 측정으로 확인한다.\",\"5\":\"jitter·shimmer·NHR이 모두 증가하였으므로 정상 음질이 아니며 거친 음성·기식성 등 음질 이상을 시사한다.\"}},\"1-1-2-6\":{\"p\":\"양측 성대 막성부 중간(전방 1/3과 중간 1/3 경계)의 대칭적 양성 병변과 모래시계형 성문폐쇄는 성대결절의 전형적 소견이며, 하루 6교시 수업과 잦은 큰 소리 사용은 음성 남용·오용 원인을 보여 준다. 성대결절은 음성 사용 습관 개선으로 호전 가능한 병변이므로 반폐쇄성도훈련(SOVT) 등 음성치료와 음성위생 교육을 우선 적용한다. 수술은 충분한 음성치료 후에도 호전이 없을 때 고려한다.\",\"w\":{\"2\":\"보툴리눔 독소 주입은 연축성발성장애 등 근육의 불수의적 과활동에 적용하는 치료이다.\",\"3\":\"성대 주입술은 성대마비·성대구증·위축 등 성문폐쇄부전을 보완하기 위한 수술적 처치이다.\",\"4\":\"제I형 갑상성형술은 성대를 내측으로 이동시키는 수술로 편측 성대마비 등 성문폐쇄부전에 적용한다.\",\"5\":\"후두미세수술은 음성치료에 반응하지 않는 결절이나 폴립·낭종 등에서 고려하며 결절의 일차 치료가 아니다.\"}},\"1-1-2-7\":{\"p\":\"후두내시경상 구조적 이상이 없는데도 발화 시에는 속삭임만 가능하고, 기침·웃음 같은 반사적(생리적) 발성에서는 정상 유성음이 산출되는 것은 기능적(심인성) 실성증의 특징이다. 성대가 발성 가능한 상태임이 확인되므로 기침·헛기침·허밍 등 보존된 반사적 발성에서 출발하여 모음·낱말·문장으로 확장하며 발성을 재확립한다.\",\"w\":{\"1\":\"후두내시경에서 구조적 이상이 없으므로 기질적 실성증이 아니다.\",\"2\":\"구조적 병변이 없는 기능적 장애이므로 수술이 아니라 음성치료가 우선이다.\",\"3\":\"사례에서 기침과 웃음 시 정상 유성음이 산출된다고 제시되어 있다.\",\"5\":\"성대마비라면 기침·웃음에서도 성문폐쇄부전이 나타나고 내시경에서 성대 운동 이상이 관찰되어야 한다.\"}},\"1-1-2-8\":{\"p\":\"변성기가 지난 남성이 후두 구조와 호르몬이 정상인데도 높은 음도를 지속하는 것은 변성발성장애(청년기 가성)이다. 갑상연골 전면을 손가락으로 부드럽게 후하방으로 누르면 성대가 짧아지고 이완되어 낮은 진성 발성이 유도되며(손가락 조작법), 이렇게 얻은 낮은 음도를 모음·낱말·대화 수준으로 안정화한다.\",\"w\":{\"1\":\"가성구 발성은 이미 문제가 되는 높은 음도를 강화하므로 목표와 반대이다.\",\"2\":\"큰 소리의 고음 발성 반복은 높은 음도 습관을 고착시키고 성대에 부담을 준다.\",\"3\":\"속삭이는 소리는 음도 조절 훈련이 되지 않으며 성대 긴장을 유발할 수 있다.\",\"4\":\"성대 과내전 유도는 성문폐쇄부전 환자에게 적용하는 접근이며 음도를 낮추는 기법이 아니다.\"}},\"1-1-2-9\":{\"p\":\"파킨슨병 환자는 음성 강도 저하(hypophonia), 단조로운 음도, 말끝 흐림을 보이며, 스스로 목소리가 작다고 느끼지 않는 감각 인식(자기 감시) 저하가 특징이다. 리실버만음성치료(LSVT LOUD)는 '크게 말하기'라는 단일 목표를 고강도·고빈도로 반복 훈련하고 새로운 강도 수준을 정상으로 느끼도록 감각을 재보정하는 근거 기반 치료로, 강도와 명료도 개선 효과가 보고되어 있다.\",\"w\":{\"1\":\"차폐 기법(롬바드 효과)은 일시적으로 강도를 높일 뿐 치료 효과의 유지·일반화가 어렵고 파킨슨병의 대표 치료가 아니다.\",\"2\":\"속삭임 발성은 강도를 더 낮추므로 약한 음성을 가진 환자의 목표와 반대이다.\",\"3\":\"가성대 발성은 진성대 발성이 불가능할 때 대안으로 고려하는 방법이며 파킨슨병의 음성 강도 문제에 적용하지 않는다.\",\"5\":\"저작하기 기법은 과긴장성 발성에서 후두 긴장을 이완시키는 기법으로 강도 저하 문제의 주된 치료가 아니다.\"}},\"1-1-2-10\":{\"w\":{\"1\":\"모음으로 시작하는 낱말에서 내전근 연축으로 쥐어짜는 듯한 음성 끊김이 나타나는 것은 내전형의 전형적 특징이다.\",\"3\":\"속삭임·노래·웃음 등에서 증상이 감소하는 과제 특이성은 연축성발성장애의 특징이다.\",\"4\":\"갑상피열근에 보툴리눔 독소를 주입하는 것이 내전형 연축성발성장애의 대표적 치료이다.\",\"5\":\"성대 내전근의 불수의적 연축에 의한 신경학적 장애라는 설명은 이 장애의 정의에 해당한다.\"}},\"1-1-2-11\":{\"p\":\"후두전적출술 후에는 기관이 목의 영구 기관공으로 분리되어 폐의 공기가 구강으로 올라오지 못한다. 식도발성은 공기를 주입(삼키기·흡입)하여 식도 상부에 넣었다가 역류시키면서 인두식도분절(PE segment)을 진동시켜 새로운 음원으로 삼는 무후두 음성 방법이며, 별도 보철 없이 훈련할 수 있다.\",\"w\":{\"1\":\"후두전적출 후에는 성대가 없고 폐의 공기가 기관공으로 배출되므로 폐의 공기를 성대로 보낼 수 없다.\",\"3\":\"보철(프로테제) 삽입이 필요한 것은 기관식도발성(TE 발성)이며 식도발성은 보철 없이 가능하다.\",\"4\":\"목에 전기 진동자를 대어 소리를 내는 것은 인공후두(전기후두) 발성이다.\",\"5\":\"후두전적출로 제거된 성대는 재생되지 않는다.\"}},\"1-1-2-12\":{\"p\":\"74세 고령, 성대 위축과 활모양(bowing) 성문틈, 병변과 신경학적 이상이 없다는 소견은 노인성 음성(presbyphonia)을 시사하며, 핵심 문제는 성문폐쇄부전으로 인한 약하고 쉽게 피로한 음성이다. 따라서 밀기 접근법, 강한 성대접촉 유도 등 성대내전을 강화하고 발성 효율을 높이는 음성치료가 적절하다.\",\"w\":{\"1\":\"음성 사용 제한은 급성 염증·수술 후 등에 적용하며, 위축된 성대는 오히려 적절한 발성 훈련이 필요하다.\",\"2\":\"속삭임은 성문을 열어 두고 발성하므로 성문폐쇄부전을 악화시키고 강도 증가에 도움이 되지 않는다.\",\"3\":\"보툴리눔 독소 주입은 과내전을 약화시키는 치료로 성문폐쇄부전 환자에게는 역효과이다.\",\"5\":\"음도를 낮추는 훈련은 이 환자의 핵심 문제인 성문폐쇄부전과 약한 강도를 개선하는 목표가 아니다.\"}},\"1-1-2-13\":{\"p\":\"GRBAS 척도는 G(Grade, 전반적 중증도), R(Roughness, 조조성·거친 소리), B(Breathiness, 기식성), A(Asthenia, 무력성), S(Strain, 긴장성)의 다섯 항목을 평정한다. 따라서 R은 조조성(거친 소리)을 의미한다.\",\"w\":{\"1\":\"전반적 중증도는 G(Grade)에 해당한다.\",\"3\":\"기식성은 B(Breathiness)에 해당한다.\",\"4\":\"무력성은 A(Asthenia)에 해당한다.\",\"5\":\"긴장성은 S(Strain)에 해당한다.\"}},\"1-1-2-14\":{\"p\":\"편측성의 유경성(줄기 달린) 병변, 갑작스러운 고함 등 급성 음성 남용 후 발생, 거칠고 낮은 음성은 성대폴립의 전형적 소견이다. 성대폴립은 대개 편측성이며 유경성 또는 무경성으로 나타나고, 병변으로 인한 질량 증가로 음도가 낮아지고 거친 음성이 나타난다.\",\"w\":{\"1\":\"성대결절은 만성적 음성 남용으로 발생하며 대개 양측성·대칭성의 무경성 병변이다.\",\"2\":\"성대구증은 성대 유리연을 따라 고랑이 패인 형태로, 줄기 달린 병변이 아니다.\",\"3\":\"라인케부종은 흡연 등과 관련된 성대 전장의 양측성 부종으로 유경성 병변이 아니다.\",\"4\":\"후두유두종은 HPV 감염과 관련된 사마귀 모양 병변으로 급성 음성 남용과 무관하다.\"}},\"1-1-2-15\":{\"p\":\"근긴장성 발성장애(MTD)는 후두에 기질적 병변이나 신경학적 원인 없이 후두 내·외근의 과도한 긴장으로 쥐어짜는 음성, 음성 피로 등이 나타나는 기능적 음성장애이다. 문항의 '기질적 병변 없음'과 '후두 주변 근육의 과도한 긴장'이 핵심 단서이다.\",\"w\":{\"1\":\"편측 성대마비는 신경 손상에 의한 장애로 기식적이고 약한 음성이 특징이다.\",\"2\":\"변성발성장애는 변성기 이후에도 높은 음도가 유지되는 장애로 근육 과긴장이 핵심 정의가 아니다.\",\"3\":\"연축성 발성장애는 불수의적 근육 연축에 의한 신경학적 장애로 단순한 근육 과긴장과 구별된다.\",\"5\":\"성대구증은 성대 유리연에 고랑이 있는 기질적 병변이다.\"}},\"1-1-2-16\":{\"p\":\"shimmer는 성대 진동의 주기 간 진폭(강도) 변동률을 나타내는 측정치로, 값이 클수록 진폭이 불규칙함을 의미한다. 주기 간 주파수 변동률인 jitter와 짝을 이루어 음성의 안정성을 평가한다.\",\"w\":{\"2\":\"F0(기본주파수)는 초당 성대 진동 횟수로, 변동률이 아니라 음도의 음향학적 대응치이다.\",\"3\":\"NHR은 소음 성분 대 배음 성분의 비율로 신호 내 잡음 정도를 나타낸다.\",\"4\":\"CPP(켑스트럼 최고점 돌출도)는 신호의 주기성(배음 구조의 뚜렷함)을 반영하는 지표로 기식성·중증도 평가에 활용된다.\",\"5\":\"jitter는 주기 간 기본주파수의 변동률이다.\"}},\"1-1-2-17\":{\"p\":\"/s/는 무성음이므로 연장 시간이 주로 호흡 기능을 반영하고, /z/는 유성음이므로 호흡과 성대 진동(발성) 기능을 함께 반영한다. 정상인은 두 시간이 비슷하여 비율이 약 1.0이며, 1.4 이상으로 증가하면 /z/ 연장이 상대적으로 짧다는 뜻이므로 성대 병변 등으로 인한 성문폐쇄부전(발성 시 공기 누출)을 우선 의심한다.\",\"w\":{\"1\":\"호흡 기능만 저하되었다면 /s/와 /z/가 함께 짧아져 비율은 1.0 근처로 유지된다.\",\"2\":\"s/z 비율은 성문 수준의 발성 효율을 반영하며 조음기관의 구조적 이상을 평가하는 지표가 아니다.\",\"3\":\"s/z 비율은 청력 손실과 직접 관련된 지표가 아니다.\",\"5\":\"공명강 협착은 공명 특성에 영향을 주며 s/z 비율 증가의 원인으로 해석하지 않는다.\"}},\"1-1-2-18\":{\"p\":\"속삭이는 소리는 성문을 부분적으로 열고 후두 근육을 긴장시킨 상태로 산출되어 오히려 성대에 과도한 긴장과 부담을 줄 수 있으므로 음성위생법으로 권장되지 않는다. 음성 휴식이 필요할 때는 속삭임 대신 발화량을 줄이거나 편안한 음성을 짧게 사용하도록 교육한다.\",\"w\":{\"1\":\"충분한 수분 섭취는 성대 점막의 윤활을 도와 음성위생에 해당한다.\",\"2\":\"소음 환경에서 큰 소리로 말하기를 줄이는 것은 음성 남용을 예방하는 음성위생 교육 내용이다.\",\"4\":\"습관적 헛기침은 성대에 충격을 주므로 줄이도록 하는 것이 적절한 음성위생 교육이다.\",\"5\":\"과도한 카페인은 이뇨 작용으로 성대 건조를 유발할 수 있어 줄이도록 권장한다.\"}},\"1-1-2-19\":{\"p\":\"되돌이후두신경(반회후두신경)은 미주신경의 분지로 윤상갑상근을 제외한 후두 내근을 지배하며, 갑상샘 뒤쪽 기관식도구를 따라 주행하므로 갑상샘 수술 시 손상되기 쉽다. 손상되면 편측 성대마비가 발생하여 기식적이고 약한 음성이 나타난다.\",\"w\":{\"2\":\"안면신경(제7뇌신경)은 얼굴 표정근을 지배하며 성대 운동과 무관하다.\",\"3\":\"설하신경(제12뇌신경)은 혀의 운동을 지배한다.\",\"4\":\"삼차신경(제5뇌신경)은 저작근 운동과 얼굴 감각을 담당한다.\",\"5\":\"부신경(제11뇌신경)은 흉쇄유돌근·승모근을 지배하며 후두 내근을 지배하지 않는다.\"}},\"1-1-2-20\":{\"p\":\"MPT는 최대 흡기 후 모음을 편안한 음도·강도로 최대한 지속하는 시간으로, 호흡 지지와 성문 폐쇄 효율을 함께 반영한다. 현저히 짧으면 발성 중 성문에서 공기가 새는 성문폐쇄부전이나 호흡 지지(폐활량·호기 조절)의 부족을 우선 시사한다.\",\"w\":{\"1\":\"MPT는 발성 지속 능력을 측정하며 청력과 직접 관련이 없다.\",\"3\":\"성대 과내전은 공기 누출이 적어 MPT가 현저히 짧아지는 주된 원인이 아니다.\",\"4\":\"MPT는 모음 연장 과제로 조음기관의 이상을 반영하지 않는다.\",\"5\":\"MPT는 공명강의 이상을 평가하는 지표가 아니다.\"}},\"1-1-2-21\":{\"p\":\"인유두종바이러스(HPV) 감염, 성대의 사마귀 모양 병변, 애성과 기도 폐쇄, 소아에서의 반복적 재발은 재발성 후두유두종(재발성 호흡기 유두종증)의 핵심 특징이다. 기도 폐쇄 위험이 있어 반복적인 수술적 제거가 필요한 경우가 많다.\",\"w\":{\"1\":\"성대결절은 음성 남용으로 인한 양측성 양성 병변으로 바이러스 감염이나 기도 폐쇄와 관련이 없다.\",\"2\":\"라인케부종은 주로 흡연 성인에게 나타나는 성대 부종이다.\",\"4\":\"성대구증은 성대 유리연의 고랑으로 바이러스성 사마귀 모양 병변이 아니다.\",\"5\":\"근긴장성 발성장애는 병변이 없는 기능적 장애이다.\"}},\"1-1-2-22\":{\"p\":\"전기성문파형검사(EGG)는 목의 갑상연골 양쪽에 전극을 대고 미세 전류를 흘려 성대 접촉 면적 변화에 따른 전기 저항의 변화를 기록한다. 이를 통해 성대의 개방·폐쇄 주기와 접촉 양상(접촉률 등)을 비침습적으로 간접 측정할 수 있다.\",\"w\":{\"2\":\"나조미터는 구강·비강 음향 에너지를 측정하여 비음치를 산출하는 공명 평가 도구이다.\",\"3\":\"스펙트로그램은 시간에 따른 주파수·강도 변화를 시각화하는 음향 분석 도구로 성대 접촉을 직접 측정하지 않는다.\",\"4\":\"순음청력검사는 주파수별 청력역치를 측정하는 청각 검사이다.\",\"5\":\"음성범위프로파일은 음도별 강도 범위를 측정하는 음향학적 도구이다.\"}},\"1-1-2-23\":{\"p\":\"빨대 발성(물컵 속 빨대 포함), 입술 트릴, 허밍은 모두 반폐쇄성도훈련(SOVT)이다. 성도의 출구를 부분적으로 좁히면 성문 상부(성도 내) 압력이 높아져 성문 위아래 압력 차가 줄어들고, 이로써 성대 접촉 충격은 감소하면서 적은 노력으로 효율적인 발성이 유도된다.\",\"w\":{\"1\":\"SOVT는 성대 접촉 충격을 줄이는 원리이며 성대를 강하게 접촉시키는 것은 밀기 접근법 등의 원리이다.\",\"2\":\"성문을 완전히 개방하면 발성이 이루어지지 않으며 기식성을 늘리는 것은 치료 목표가 아니다.\",\"3\":\"SOVT는 편안한 음도 범위에서 실시하며 가성구로만 발성하도록 하는 기법이 아니다.\",\"4\":\"호흡을 멈추면 발성이 불가능하며 SOVT는 지속적인 호기류를 이용한다.\"}},\"1-1-2-24\":{\"p\":\"성대구증은 성대 유리연(자유연)을 따라 점막층에 고랑이 패인 질환으로, 이 고랑 때문에 발성 시 성대가 완전히 닫히지 않아 성문폐쇄부전, 기식 음성, 음성 피로가 나타난다. 문항의 '유리연을 따라 고랑'이 결정적 단서이다.\",\"w\":{\"1\":\"후두유두종은 HPV 관련 사마귀 모양 증식성 병변이다.\",\"2\":\"성대결절은 막성부 중간의 양측성 결절 병변으로 고랑 형태가 아니다.\",\"3\":\"라인케부종은 성대 전장의 부종으로 질량 증가가 특징이다.\",\"4\":\"성대폴립은 편측성의 유경성 또는 무경성 돌출 병변이다.\"}},\"1-1-2-25\":{\"p\":\"Dodd의 분류에서 음운지연은 오류패턴 자체는 정상 발달에서 나타나는 음운변동이지만, 그 변동이 해당 연령이 지나서도 지속되는 경우이다. 아동1은 어린 정상 아동에게 나타나는 종성생략·연구개음 전방화가 4세에도 지속되므로 음운지연에 해당한다.\",\"w\":{\"2\":\"아동2는 혀 내밀기로 인한 /ㅅ/ 왜곡이 모든 문맥에서 일관되므로 운동적 산출 문제인 조음장애에 해당한다.\",\"3\":\"아동3은 발달과정에서 드문 비전형적 오류패턴이 일관되게 나타나므로 일관적 음운장애에 해당한다.\",\"4\":\"아동4는 같은 낱말을 40% 이상 다르게 산출하므로 비일관적 음운장애에 해당한다.\",\"5\":\"아동1이 음운지연에 해당하므로 해당 아동이 없다는 진술은 틀리다.\"}},\"1-1-2-26\":{\"w\":{\"1\":\"수박의 종성 /ㄱ/을 포함하여 모든 종성이 산출되었으므로 종성생략은 0회이다.\",\"2\":\"호랑이→[호앙이]는 /ㄹ/이 활음이 아닌 생략(탈락)으로 나타난 것이며 활음화는 나타나지 않았다.\",\"4\":\"연구개음 전방화는 코끼리의 첫 /ㅋ/→[ㅌ], 그네의 /ㄱ/→[ㄷ]의 2회이며 코끼리의 /ㄲ/은 정조음되었다.\",\"5\":\"비음이 아닌 음이 비음으로 대치된 예가 없으므로 비음화는 0회이다.\"}},\"1-1-2-27\":{\"p\":\"조음해야 할 자음은 가방 3개(ㄱ,ㅂ,ㅇ), 모자 2개(ㅁ,ㅈ), 나무 2개(ㄴ,ㅁ), 딸기 3개(ㄸ,ㄹ,ㄱ)로 총 10개이다. 오류는 가방→[가바]의 종성 /ㅇ/ 생략과 모자→[모다]의 /ㅈ/→[ㄷ] 대치로 2개이므로 정확하게 산출한 자음은 8개이다. 따라서 PCC = 8/10 × 100 = 80%이다.\",\"w\":{\"1\":\"오류를 4개로 계산한 것으로, 정확한 자음 수를 실제보다 2개 적게 센 결과이다.\",\"2\":\"오류를 3개로 계산한 것으로, 정조음된 딸기의 /ㄹ/ 등을 오류로 잘못 센 결과이다.\",\"4\":\"오류를 1개로 계산한 것으로, 종성 /ㅇ/ 생략 또는 /ㅈ/→[ㄷ] 대치 중 하나를 누락한 결과이다.\",\"5\":\"오류가 없는 경우이며 실제로는 생략 1개와 대치 1개의 오류가 있다.\"}},\"1-1-2-28\":{\"p\":\"무의미음절 /사/, /수/에서 단서를 주면 정조음이 가능하므로 다음 단계는 목표음을 의미 있는 낱말에서 확립하는 것이다. 현재 목표는 어두 /ㅅ/이므로 어두에 /ㅅ/가 오는 '사탕, 손, 시소'가 적절하며, 안정되면 어중·어말, 구·문장 수준으로 확장한다.\",\"w\":{\"1\":\"'단추, 다리, 도장'은 아동의 오류음인 /ㄷ/로 시작하는 낱말로 목표음 /ㅅ/가 없다.\",\"2\":\"'거울, 가위, 구두'는 연구개음 /ㄱ/ 낱말로 목표음 /ㅅ/가 없다.\",\"4\":\"'라면, 리본, 로봇'은 유음 /ㄹ/ 낱말로 목표음 /ㅅ/가 없다.\",\"5\":\"'모자, 무지개, 미소'는 어두가 /ㅁ/이며, 미소의 /ㅅ/는 어중 위치이므로 어두 /ㅅ/ 목표에 맞지 않다.\"}},\"1-1-2-29\":{\"p\":\"골도 역치가 10 dB HL로 정상이어서 내이·청신경 기능은 정상이고, 기도 역치가 45 dB HL로 상승하여 기도-골도 차가 35 dB로 크게 나타난다. 이는 소리 전달 경로(외이·중이)의 문제를 뜻하는 전음성 난청 소견이므로 중이염 등 중이 질환 여부를 확인해야 한다.\",\"w\":{\"1\":\"감각신경성 난청은 기도·골도 역치가 함께 상승하고 기도-골도 차가 거의 없다.\",\"3\":\"기도 역치 45 dB HL은 정상 범위(약 25 dB HL 이하)를 벗어나 경도~중도 난청에 해당한다.\",\"4\":\"혼합성 난청은 골도 역치도 상승해야 하는데 골도 역치가 10 dB HL로 정상이다.\",\"5\":\"청신경 종양은 후미로성(감각신경성) 병변으로 골도 역치 상승을 동반한다.\"}},\"1-1-2-30\":{\"p\":\"평음 /ㅂ, ㄷ, ㄱ/이 각각 경음 [ㅃ, ㄸ, ㄲ]으로 대치되는 경음화가 일관되게 나타났다. 평음과 경음은 조음 위치·방법이 같고 [긴장성] 자질에서만 대립하므로(평음 [−긴장성], 경음 [+긴장성]), 아동은 긴장성 자질의 대립을 아직 확립하지 못한 것이다.\",\"w\":{\"1\":\"지속성은 파열음·파찰음과 마찰음 등을 구분하는 자질이며, 제시된 대치는 파열음 간 대치로 지속성 값이 같다.\",\"3\":\"비음성은 비음과 구강음을 구분하는 자질이며 제시된 오류에 비음이 관여하지 않는다.\",\"4\":\"설측성은 유음 /ㄹ/의 설측음을 구분하는 자질로 제시된 오류와 무관하다.\",\"5\":\"공명성은 공명음(비음·유음·모음)과 장애음을 구분하는 자질이며 목표음과 대치음이 모두 장애음이다.\"}},\"1-1-2-31\":{\"w\":{\"1\":\"음운변동 분석은 목표 형태와 아동 산출을 비교하는 관계분석에 해당한다.\",\"2\":\"자음정확도(PCC)는 목표 자음 대비 정확한 자음 비율로 관계분석 지표이다.\",\"3\":\"목표 음소 대비 정확도 산출은 목표와 비교하는 관계분석이다.\",\"5\":\"자극반응도는 단서·모방 조건에서의 오류음 산출 가능성을 평가하는 것으로 독립분석의 정의가 아니다.\"}},\"1-1-2-32\":{\"p\":\"문맥검사에서 /ㅅ/가 /ㅣ/ 모음 앞에서만 정조음된다는 것은 /시/가 촉진 문맥임을 뜻한다. 촉진 문맥은 아동이 이미 성공할 수 있는 지점이므로 치료의 출발점으로 삼고, /시/에서 안정적으로 산출한 뒤 다른 모음 문맥, 음절·낱말 수준으로 점진적으로 확대한다.\",\"w\":{\"1\":\"비언어적 구강운동 훈련만으로는 말소리 산출 개선 효과의 근거가 부족하며 확인된 촉진 문맥을 활용하지 못한다.\",\"3\":\"오류가 가장 심한 문맥부터 시작하면 실패 경험이 많아지고 촉진 문맥의 이점을 활용하지 못한다.\",\"4\":\"정조음 가능한 문맥이 있어 자극반응도가 있는 음소이므로 훈련을 중단할 이유가 없다.\",\"5\":\"초기부터 모든 문맥을 무작위로 섞으면 성공 기반을 확보하기 어렵다. 무작위 연습은 산출이 안정된 뒤 일반화 단계에 적합하다.\"}},\"1-1-2-33\":{\"w\":{\"1\":\"음절 수 세기가 음소 분절보다 먼저 발달한다.\",\"2\":\"각운 인식이 음소 조작보다 먼저 발달하며 음소 조작은 가장 늦게 발달하는 과제에 속한다.\",\"3\":\"음운인식은 해독 능력의 핵심 예측 변인으로 읽기와 밀접하게 관련된다.\",\"4\":\"음절 탈락이 음소 탈락보다 먼저 발달한다.\"}},\"1-1-2-34\":{\"w\":{\"1\":\"목록에 없는 음소로만 구성된 낱말은 초기 성공 경험을 제공하기 어렵다.\",\"3\":\"초기에는 단순한 음절 구조의 짧은 낱말에서 시작하고 점차 복잡성을 높인다.\",\"4\":\"초기 낱말 선정에서는 발음 난이도보다 의사소통 기능과 의미가 우선한다.\",\"5\":\"사용 빈도가 낮은 낱말은 일상 의사소통에 활용되기 어려워 기능성이 낮다.\"}},\"1-1-2-35\":{\"p\":\"구개열 수술 후 아동이 압력자음(파열음·마찰음) 산출 시 코로 공기가 새는 것은 연인두폐쇄부전에 의한 비강누출을 시사한다. 차가운 거울(비경)을 콧구멍 아래 대고 압력자음을 산출하게 하여 김서림을 관찰하면 비강누출을 간편하게 선별할 수 있다.\",\"w\":{\"1\":\"교호운동속도(DDK)는 조음기관의 운동 속도·규칙성을 평가하며 비강누출을 선별하지 않는다.\",\"2\":\"청력역치 측정은 구개열 아동에게 필요한 검사이지만 비강누출·과다비성 선별 방법이 아니다.\",\"4\":\"최대연장발성시간은 호흡·발성 효율을 평가하며 공명을 선별하지 않는다.\",\"5\":\"수용어휘력 검사는 언어 이해 능력을 평가하며 공명과 무관하다.\"}},\"1-1-2-36\":{\"p\":\"청능훈련은 소리의 유무를 아는 탐지, 두 소리가 같은지 다른지 구별하는 변별, 들은 소리가 무엇인지 알아 지적·반복하는 확인, 말의 의미를 파악하는 이해의 순서로 진행한다(Erber의 위계). 따라서 탐지 → 변별 → 확인 → 이해가 바른 순서이다.\",\"w\":{\"2\":\"소리가 있는지 알아야 두 소리를 비교할 수 있으므로 탐지가 변별보다 먼저이다.\",\"3\":\"같고 다름을 구별하는 변별이 무슨 소리인지 지적하는 확인보다 먼저이다.\",\"4\":\"확인이 가장 먼저 올 수 없으며 탐지가 첫 단계이다.\",\"5\":\"발달 순서를 역순으로 나열한 것이다.\"}},\"1-1-2-37\":{\"p\":\"최소대립쌍 치료는 '불-풀'처럼 한 음소의 차이로 의미가 구별되는 낱말 쌍을 이용하여, 아동이 오류로 인해 두 낱말의 의미가 혼동됨을 인식하게 하고 음운 대조를 확립하도록 유도하는 음운론적 접근이다.\",\"w\":{\"1\":\"짝자극 기법은 목표음을 정조음하는 핵심 낱말과 훈련 낱말을 짝지어 전이를 유도하는 조음 접근이다.\",\"3\":\"주기법은 여러 오류 음운패턴을 주기마다 순환하며 목표로 하는 접근이다.\",\"4\":\"전통적 조음지시법은 조음 위치·방법을 직접 지시하여 개별 음소 산출을 훈련하는 운동적 접근이다.\",\"5\":\"구강운동 훈련은 말소리가 아닌 구강 움직임 연습으로 의미 대조를 이용하지 않는다.\"}},\"1-1-2-38\":{\"p\":\"주기법(cycles approach, Hodson)은 명료도가 매우 낮은 아동을 대상으로 여러 오류 음운패턴을 정해진 기간씩 주기(cycle)마다 순환하며 목표로 삼는 음운적 접근이다. 한 패턴의 완전한 습득을 기다리지 않고 순환하며 점진적 발달을 유도한다.\",\"w\":{\"1\":\"짝자극 기법은 핵심 낱말과 훈련 낱말을 짝지어 목표음을 일반화하는 기법이다.\",\"2\":\"감각운동 기법(McDonald)은 음성 문맥을 활용하여 음절 단위의 조음 운동을 훈련하는 방법이다.\",\"3\":\"조음점 지시법은 조음 위치·방법을 직접 지시하여 개별 음소를 유도하는 방법이다.\",\"5\":\"변별자질 접근법은 오류에 공통된 변별자질의 대립을 목표로 하는 방법으로 패턴을 순환하지 않는다.\"}},\"1-1-2-39\":{\"w\":{\"2\":\"말명료도는 청자가 화자의 말을 알아듣는 정도이다.\",\"3\":\"말소리목록은 아동이 산출할 수 있는 음소의 목록이다.\",\"4\":\"일관성은 같은 낱말을 반복 산출할 때 오류 형태가 동일한 정도이다.\",\"5\":\"음운인식은 말소리 단위를 인식하고 조작하는 상위언어 능력이다.\"}},\"1-1-2-40\":{\"w\":{\"1\":\"자음의 정확도는 PCC 등으로 측정되는 조음 정확도이며 명료도에 영향을 주는 요인 중 하나일 뿐이다.\",\"2\":\"음도·강도의 적절성은 음성 영역의 평가 요소이다.\",\"3\":\"문법적 정확성은 언어(구문) 영역의 평가 요소이다.\",\"4\":\"말속도는 명료도에 영향을 줄 수 있지만 명료도의 정의가 아니다.\"}},\"1-1-2-41\":{\"p\":\"/ㅂ/와 /ㅁ/는 모두 양순음으로 조음 위치가 같지만, /ㅁ/는 연구개를 내려 비강으로 공기를 보내는 [+비음성], /ㅂ/는 [−비음성]이다. 따라서 두 음은 비음성 자질에서 대립한다.\",\"w\":{\"2\":\"지속성은 마찰음 등 기류가 지속되는 음을 구분하며 /ㅂ/와 /ㅁ/의 핵심 대립이 아니다.\",\"3\":\"설정성은 혀끝·혓날이 관여하는 음을 구분하며 양순음인 두 음은 모두 [−설정성]이다.\",\"4\":\"긴장성은 평음·경음 등을 구분하는 자질로 /ㅂ/와 /ㅃ/의 대립에 해당한다.\",\"5\":\"고설성은 혀몸을 높이는 음(경구개·연구개음)을 구분하며 두 음 모두 [−고설성]이다.\"}},\"1-1-2-42\":{\"p\":\"한국어 자음 습득에서 양순음·비음·파열음은 이른 시기에 습득되는 반면, 치경마찰음 /ㅅ, ㅆ/은 유음 /ㄹ/과 함께 가장 늦게 완전 습득되는 말소리에 속한다. 제시된 선택지 중 가장 늦게 습득되는 음은 /ㅅ/이다.\",\"w\":{\"1\":\"/ㄷ/는 치경 파열음으로 이른 시기에 습득된다.\",\"2\":\"/ㅂ/는 양순 파열음으로 가장 이른 시기에 습득되는 음에 속한다.\",\"3\":\"/ㅁ/는 양순 비음으로 가장 이른 시기에 습득된다.\",\"5\":\"종성 /ㅇ/는 비음으로 이른 시기에 습득된다.\"}},\"1-1-2-43\":{\"p\":\"라면→[야면], 나라→[나야]에서 유음 /ㄹ/이 활음 /j/로 대치되었고, 리본→[이본]에서도 /ㄹ/이 활음화(또는 탈락)되어 나타났다. 이처럼 유음 /ㄹ/이 활음으로 대치되거나 생략되는 것은 유음의 단순화(활음화)이다.\",\"w\":{\"1\":\"유음의 비음화라면 /ㄹ/이 /ㄴ/ 등 비음으로 대치되어야 하지만(예: 라면→[나면]) 비음 대치는 없다.\",\"2\":\"파열음화는 마찰음·파찰음이 파열음으로 대치되는 변동으로 제시된 자료에 없다.\",\"3\":\"라면·리본의 종성 /ㄴ/이 모두 산출되어 종성생략은 없다.\",\"4\":\"전방화는 조음 위치가 앞으로 이동하는 대치(예: 연구개음→치경음)로 제시된 오류와 다르다.\"}},\"1-1-2-44\":{\"p\":\"코→[고], 토끼→[도끼], 파→[바]에서 격음(기식음) /ㅋ, ㅌ, ㅍ/이 같은 조음 위치의 평음 /ㄱ, ㄷ, ㅂ/으로 대치되었다. 조음 위치·방법은 유지되고 기식성만 사라졌으므로 탈기식음화(이완음화)이다.\",\"w\":{\"2\":\"조음 위치는 연구개·치경·양순 그대로 유지되어 전방화가 아니다.\",\"3\":\"경음화는 평음이 경음으로 대치되는 변동인데 대치음 /ㄱ, ㄷ, ㅂ/은 평음이다.\",\"4\":\"목표음이 이미 파열음이므로 마찰음·파찰음이 파열음이 되는 파열음화가 아니다.\",\"5\":\"기식음화는 평음·경음이 격음으로 대치되는 변동으로 제시된 오류와 반대 방향이다.\"}},\"1-1-2-45\":{\"p\":\"단어단위정확률(PWC)은 목표 형태와 완전히 동일하게 산출한 낱말 수를 전체 낱말 수로 나눈 값이다. 5개 중 3개를 정확히 산출하였으므로 PWC = 3 ÷ 5 = 0.6이다.\",\"w\":{\"1\":\"오류 낱말 수 2를 분자로 계산한 값(2 ÷ 5)이다.\",\"2\":\"전체 5개 중 절반 정도로 어림한 값이며 3 ÷ 5와 일치하지 않는다.\",\"4\":\"정확한 낱말 수를 실제보다 많게 계산한 값으로 3 ÷ 5와 일치하지 않는다.\",\"5\":\"정확 낱말을 4개로 계산한 값(4 ÷ 5)이다.\"}},\"1-1-2-46\":{\"w\":{\"1\":\"주기법은 여러 음운패턴을 주기적으로 순환하며 목표로 하는 음운적 접근이다.\",\"2\":\"최소대립쌍 치료는 의미 대조를 이용하는 음운적 접근으로 조음 위치를 직접 지시하지 않는다.\",\"4\":\"음운변동 접근법은 오류 패턴(음운변동) 단위로 목표를 선정하는 음운적 접근이다.\",\"5\":\"상위음운 접근법은 말소리 체계에 대한 상위 인식을 높이는 접근이다.\"}},\"1-1-2-47\":{\"w\":{\"2\":\"치경음 후방화라면 치경음이 연구개음 등으로 대치되어야 하는데 반대 방향의 오류가 나타났다.\",\"3\":\"우산의 /ㅅ/가 정조음되었고 마찰음이 파열음으로 대치된 예가 없다.\",\"4\":\"우산의 종성 /ㄴ/ 등 종성이 모두 산출되어 종성생략이 없다.\",\"5\":\"코끼리의 /ㄹ/이 정조음되어 유음의 단순화가 나타나지 않았다.\"}},\"1-1-2-48\":{\"p\":\"'할머니'가 [하머니]로 산출되어 첫 음절의 종성 /ㄹ/이 생략되었으므로 종성생략이 나타났다. 또한 '샀어요'가 [다떠요]로 산출되어 마찰음 /ㅅ, ㅆ/이 파열음 [ㄷ, ㄸ]으로 대치(파열음화)되었다.\",\"w\":{\"1\":\"종성 /ㄹ/ 생략과 마찰음 대치 오류가 있으므로 자음정확도는 100%가 아니다.\",\"3\":\"유음 /ㄹ/이 비음으로 대치된 예가 없으며 '랑'의 /ㄹ/은 정조음되었다.\",\"4\":\"'샀어요→[다떠요]'에서 마찰음이 파열음으로 대치되어 모든 마찰음을 정확히 조음하지 못하였다.\",\"5\":\"'가서'의 /ㄱ/ 등 연구개음이 정조음되어 연구개음 전방화가 나타나지 않았다.\"}},\"1-1-2-49\":{\"p\":\"언어재활사는 자신이 교육·훈련을 받아 역량을 갖춘 영역 내에서 서비스를 제공해야 하며, 새로운 영역은 교육과 슈퍼비전을 통해 역량을 갖춘 뒤 수행해야 한다. 훈련·슈퍼비전 없이 인터넷 정보에만 의존해 삼킴장애 환자를 단독 중재한 것은 전문성 유지의 의무 위반이다.\",\"w\":{\"1\":\"비밀유지의 의무는 내담자 정보를 동의 없이 공개한 경우에 해당하며 사례에 정보 유출이 없다.\",\"2\":\"차별금지는 내담자의 특성을 이유로 서비스를 차별한 경우에 해당한다.\",\"3\":\"연구 윤리는 연구 수행 과정의 윤리 문제로 사례는 임상 중재에 관한 것이다.\",\"5\":\"동료 간 협력 의무와도 관련될 수 있으나, 핵심 위반은 역량 범위를 벗어난 서비스 제공이다.\"}},\"1-1-2-50\":{\"p\":\"발달재활서비스는 만 18세 미만 등록 장애아동을 대상으로 언어·청능·미술·음악·행동·놀이 등 재활서비스를 바우처로 지원하며, 가구 소득 수준에 따라 본인부담금이 차등 부과된다. 만 7세 등록 장애아동이고 소득이 기준 이내이므로 대상에 해당하며 본인부담금을 내고 바우처로 서비스를 이용할 수 있다.\",\"w\":{\"2\":\"발달재활서비스는 등록 장애아동을 주 대상으로 하는 사업이다.\",\"3\":\"대상 연령은 만 18세 미만이다.\",\"4\":\"소득 수준에 따라 본인부담금이 차등 부과되며 전액 무료는 일부 계층(기초생활수급자 등)에 한정된다.\",\"5\":\"의료기관 입원 치료가 아니라 지정 제공기관의 재활서비스를 바우처로 지원한다.\"}},\"1-1-2-51\":{\"w\":{\"1\":\"혼란변인은 독립변인 외에 종속변인에 영향을 주어 결과 해석을 혼란스럽게 하는 통제되지 않은 변인이다.\",\"2\":\"매개변인은 독립변인과 종속변인 사이에서 영향을 전달하는 중간 변인이다.\",\"3\":\"통제변인은 결과에 영향을 주지 않도록 연구자가 일정하게 유지하는 변인이다.\",\"4\":\"종속변인은 처치의 결과로 측정되는 변인으로 이 연구에서는 자발적 의사소통 시도 횟수이다.\"}},\"1-1-2-52\":{\"p\":\"메타분석은 동일 주제의 여러 개별 연구 결과를 체계적으로 수집하고 효과크기로 변환하여 통계적으로 통합함으로써 전체 효과크기를 산출하는 연구 방법이다. 근거 기반 실제(EBP)에서 높은 수준의 근거로 활용된다.\",\"w\":{\"1\":\"횡단적 기술연구는 한 시점에서 여러 대상의 특성을 기술하는 연구이다.\",\"2\":\"단일대상연구는 한 명 또는 소수 대상에게 기초선-중재 설계를 적용하여 효과를 검증하는 연구이다.\",\"3\":\"질적 사례연구는 소수 사례를 심층적으로 기술·해석하는 연구로 통계적 통합을 하지 않는다.\",\"4\":\"델파이 조사는 전문가 집단의 의견을 반복 수렴하여 합의를 도출하는 방법이다.\"}},\"1-1-2-53\":{\"p\":\"잘 진술된 행동목표는 수행 조건(그림자극), 관찰 가능한 목표 행동(어두 /ㅅ/ 정조음), 도달 준거(10개 중 8개), 숙달 기준(3회기 연속)을 포함한다. 어떤 치료 기법으로 가르칠지는 중재 절차에 해당하며 행동목표 진술에 포함되는 요소가 아니다. 제시된 목표에도 치료 기법은 명시되어 있지 않다.\",\"w\":{\"1\":\"'그림자극 10개 중'은 목표 행동이 수행되는 조건으로 목표에 포함되어 있다.\",\"2\":\"'어두 /ㅅ/를 정조음한다'는 관찰·측정 가능한 목표 행동으로 포함되어 있다.\",\"4\":\"'10개 중 8개'는 도달 준거로 포함되어 있다.\",\"5\":\"'3회기 연속'은 숙달 기준으로 포함되어 있다.\"}},\"1-1-2-54\":{\"p\":\"「장애인복지법」상 1급 언어재활사 국가시험은 2급 언어재활사 자격 취득을 전제로 하며, 관련 대학원 석사·박사학위 취득 후 언어재활 경력 1년 이상, 또는 관련 학과 학사학위 취득자로서 경력 3년 이상의 요건을 갖추어야 한다. 2급 자격 없이 경력만으로는 응시할 수 없으므로 ①이 옳지 않다.\",\"w\":{\"2\":\"2급 취득 후 관련 대학원 석·박사학위와 경력 1년 이상은 법정 응시자격에 해당한다.\",\"3\":\"2급 취득 후 관련 학과 학사학위 취득자로서 경력 3년 이상은 법정 응시자격에 해당한다.\",\"4\":\"응시자격에서 요구하는 경력은 언어재활 분야의 경력이므로 옳은 설명이다.\",\"5\":\"1급 응시에는 2급 자격 취득이 전제되므로 옳은 설명이다.\"}},\"1-1-2-55\":{\"p\":\"산업재해보상보험은 업무상 재해에 대한 사용자의 보상 책임을 보험화한 제도이므로 보험료를 사업주가 전액 부담한다. 국민연금·국민건강보험(노인장기요양보험 포함)·고용보험의 실업급여 보험료는 근로자와 사업주가 분담한다.\",\"w\":{\"1\":\"국민연금 보험료는 근로자와 사업주가 각각 절반씩 부담한다.\",\"3\":\"국민건강보험료는 근로자와 사업주가 각각 절반씩 부담한다.\",\"4\":\"고용보험 중 실업급여 보험료는 근로자와 사업주가 절반씩 부담하며, 고용안정·직업능력개발사업분만 사업주가 부담한다.\",\"5\":\"노인장기요양보험료는 건강보험료에 연동되어 근로자와 사업주가 분담한다.\"}},\"1-1-2-56\":{\"p\":\"어머니의 빠른 말속도, 길고 복잡한 문장, 아동의 반응을 기다리지 않는 상호작용은 아동이 입력을 처리하고 반응할 기회를 줄인다. 따라서 말속도를 늦추고 아동의 언어 수준보다 약간 높은 짧고 단순한 문장을 사용하며, 아동이 반응할 시간을 충분히 기다려 주도록 지도하는 것이 적절하다.\",\"w\":{\"2\":\"더 빠른 속도와 많은 어휘는 아동의 처리 부담을 늘리며 문제 행동을 강화한다.\",\"3\":\"아동의 주의와 이해를 돕기 위해서는 낮고 단조로운 억양보다 풍부하고 과장된 억양이 권장된다.\",\"4\":\"아동이 말할 내용을 대신 말하면 아동의 표현 기회를 빼앗는다.\",\"5\":\"잦은 직접 교정은 의사소통 의욕을 떨어뜨리므로 확장·재구성 등 간접 모델링을 사용한다.\"}},\"1-1-2-57\":{\"p\":\"지능은 정상이고 들려주는 이야기의 이해(듣기 이해)도 또래 수준인데, 낱말을 소리 내어 읽는 해독의 정확성과 유창성에서만 두드러진 어려움을 보인다. 이는 단순관점 모델에서 해독 결함에 해당하는 난독증(읽기 특정학습장애)의 핵심 양상이다.\",\"w\":{\"1\":\"지능이 정상 범위이므로 지적장애가 아니다.\",\"2\":\"들려주는 이야기의 이해가 또래 수준이므로 청각장애로 인한 문제로 보기 어렵다.\",\"3\":\"단순언어장애는 구어 이해·표현 전반의 결함이 특징인데 듣기 이해가 정상이다.\",\"5\":\"말소리장애는 말소리 산출의 문제이며, 사례의 핵심은 문자 해독의 어려움이다.\"}},\"1-1-2-58\":{\"w\":{\"1\":\"무발화 영유아에게 표준화 검사 원점수만으로 언어 연령을 산출하면 능력이 제대로 반영되지 않는다.\",\"3\":\"말을 시작할 때까지 평가를 미루면 조기 발견과 조기 중재의 기회를 놓친다.\",\"4\":\"보호자 정보는 일상 의사소통을 파악하는 중요한 자료이므로 배제하지 않고 관찰 자료와 함께 활용한다.\",\"5\":\"단일 회기의 검사 점수만으로 장애를 확정하는 것은 신뢰성이 낮아 부적절하다.\"}},\"1-1-2-59\":{\"w\":{\"1\":\"연구 윤리는 연구 수행 과정의 윤리 문제이며 사례는 연구 상황이 아니다.\",\"3\":\"전문성 유지의 의무는 역량 범위 내 서비스 제공과 지속적 전문성 개발에 관한 것이다.\",\"4\":\"동료 간 협력은 전문가 간 관계에 관한 것으로 사례의 핵심이 아니다.\",\"5\":\"차별금지는 내담자를 특성에 따라 차별하는 경우에 해당한다.\"}},\"1-1-2-60\":{\"w\":{\"1\":\"보수교육은 1급뿐 아니라 2급을 포함한 모든 언어재활사에게 부과된다.\",\"2\":\"보수교육은 최초 취득 시 1회가 아니라 매년 이수해야 한다.\",\"3\":\"보수교육 이수는 자격 유지와 관련되며 미이수 시 제재를 받을 수 있다.\",\"4\":\"보수교육은 대학원 재학 여부와 무관하게 자격 보유자에게 부과된다.\"}},\"1-1-2-61\":{\"p\":\"중재 효과 연구에서 독립변인 외에 종속변인에 영향을 줄 수 있는 외생변인(혼란변인)을 통제하면, 관찰된 종속변인의 변화가 독립변인(중재) 때문이라고 확신할 수 있다. 즉 인과 추론의 정확성인 내적 타당도를 높이기 위해 변인을 통제한다.\",\"w\":{\"1\":\"변인 통제는 대상자 수를 줄이기 위한 것이 아니다.\",\"2\":\"종속변인은 중재 효과를 판단하기 위해 반드시 측정해야 한다.\",\"4\":\"변인 통제의 목적은 결과의 일반화를 제한하는 것이 아니라 인과관계를 명확히 하는 것이다.\",\"5\":\"독립변인은 연구자가 계획적으로 조작하는 변인이며 무작위로 바꾸는 대상이 아니다.\"}},\"1-1-2-62\":{\"w\":{\"1\":\"상관연구는 변인 간의 관련성 정도를 분석하며 중재를 조작하지 않는다.\",\"2\":\"집단비교연구는 다수의 대상을 실험집단과 통제집단으로 나누어 비교한다.\",\"4\":\"델파이 조사는 전문가 의견을 반복 수렴하여 합의를 도출하는 방법이다.\",\"5\":\"메타분석은 여러 연구 결과를 통계적으로 통합하는 방법이다.\"}},\"1-1-2-63\":{\"p\":\"타당도는 검사도구가 측정하고자 하는 개념이나 능력을 실제로 정확하게 측정하는 정도이다. 반면 신뢰도는 측정 결과의 일관성·안정성을 의미하므로 두 개념을 구별해야 한다.\",\"w\":{\"2\":\"실용도는 검사의 실시·채점·해석이 경제적이고 편리한 정도이다.\",\"3\":\"신뢰도는 반복 측정 시 결과가 일관되게 나타나는 정도이다.\",\"4\":\"객관도는 채점자 간 채점 결과가 일치하는 정도(채점자 신뢰도)이다.\",\"5\":\"난이도는 문항의 쉽고 어려운 정도로 문항 분석 지표이다.\"}},\"1-1-2-64\":{\"w\":{\"1\":\"청력역치 측정 결과에 근거한 의학적 진단은 의사의 업무이다.\",\"2\":\"수술적 처치는 의사의 업무이다.\",\"3\":\"약물 처방은 의사의 업무이다.\",\"4\":\"난청의 외과적 치료(예: 인공와우 수술)는 의사의 업무이다.\"}},\"1-1-2-65\":{\"w\":{\"2\":\"한국어 어휘 수만으로 판정하면 몽골어로만 아는 개념이 누락되어 과소평가된다.\",\"3\":\"이중언어 노출 자체는 언어 지체나 장애의 원인이 아니다.\",\"4\":\"가정 언어 사용 중단은 부모-자녀 상호작용의 질을 떨어뜨릴 수 있어 권고하지 않는다.\",\"5\":\"단일언어 규준을 그대로 적용하면 이중언어 아동을 과잉 판별할 위험이 있다.\"}},\"1-1-2-66\":{\"w\":{\"1\":\"사후 보고는 연구 종료 후 결과나 과정을 알리는 것으로 참여 전 동의 절차가 아니다.\",\"3\":\"디브리핑은 연구 종료 후 기만 등 연구의 실제 목적을 설명하는 절차이다.\",\"4\":\"무선 할당은 참여자를 실험·통제 집단에 무작위로 배정하는 연구 설계 절차이다.\",\"5\":\"이중 은폐는 참여자와 연구자 모두 집단 배정을 모르게 하여 편향을 줄이는 설계 방법이다.\"}},\"1-1-2-67\":{\"p\":\"첫 상담에서 상담의 목적과 진행 방식을 안내하고, 아동의 발달력과 가정 내 의사소통 정보를 수집하며, 보호자와 신뢰 관계(라포)를 형성하는 것은 부모상담의 초기(준비) 단계에 해당한다.\",\"w\":{\"1\":\"실행 단계는 공감적 관계를 바탕으로 구체적 문제해결 방안을 제시하고 실천하도록 돕는 단계이다.\",\"2\":\"종결 단계는 상담 목표 달성 여부를 확인하고 상담을 마무리하는 단계이다.\",\"3\":\"추후 단계는 종결 후 변화의 유지 여부를 점검하는 단계이다.\",\"5\":\"평가 단계는 상담의 진행 결과와 효과를 점검하는 단계로 첫 상담의 정보 수집·라포 형성과 다르다.\"}},\"1-1-2-68\":{\"w\":{\"1\":\"이 사업은 등록 장애아동에 한정되지 않으며 의료 서비스가 아니다.\",\"3\":\"아동을 대상으로 하는 언어발달 지원 사업이며 성인 직업재활 사업이 아니다.\",\"4\":\"언어재활사 등 자격을 갖춘 전문 인력이 평가와 중재를 제공한다.\",\"5\":\"언어평가 결과에 따라 개별 아동에게 맞는 언어촉진 교육을 제공한다.\"}},\"1-2-1-1\":{\"p\":\"K-WAB-R의 실어증지수(AQ)는 스스로 말하기 점수(20점 만점)에 알아듣기(200점)÷20, 따라말하기(100점)÷10, 이름대기(100점)÷10을 더해 각각 10점 척도로 환산한 뒤 합계에 2를 곱해 100점 만점으로 만든다. 14 + 160÷20(=8) + 80÷10(=8) + 70÷10(=7) = 37이고, 37 × 2 = 74.0이다. 환산 순서(하위검사별 10점·20점 척도화 → 합산 → ×2)를 지키는 것이 핵심이다.\",\"w\":{\"1\":\"68.0은 합계 34에 2를 곱한 값으로, 하위검사 환산점 중 일부(예: 따라말하기나 이름대기)를 3점가량 적게 환산한 계산 오류에 해당한다.\",\"2\":\"72.0은 합계 36에 해당하며 환산점 하나를 1점 적게 더한 오류로, 정확한 합계 37과 맞지 않는다.\",\"3\":\"82.0은 합계 41에 해당하는 값으로, 알아듣기 등 일부 점수를 과대 환산한 오류이다.\",\"5\":\"88.0은 합계 44에 해당하는 값으로, 환산 비율을 잘못 적용해 점수를 크게 부풀린 오류이다.\"}},\"1-2-1-2\":{\"p\":\"유창한 발화·착어·심한 청각적 이해 손상은 베르니케실어증과 공통되지만, 따라말하기가 88/100으로 보존된 점이 결정적 감별 단서이다. 이해는 손상되고 따라말하기는 보존되는 유창성 실어증은 연결피질감각실어증이며, 후방 분수계(측두-두정-후두 경계) 영역 손상으로 설명된다. 청각-음운 입력에서 구어 출력으로 가는 따라말하기 경로(상측두회-궁상다발-브로카)가 보존되고 의미 체계와의 연결이 끊긴 상태이다.\",\"w\":{\"1\":\"베르니케실어증은 이해와 함께 따라말하기도 심하게 손상되므로 따라말하기 88점과 모순된다.\",\"2\":\"명칭실어증은 청각적 이해가 비교적 양호하고 낱말 찾기 결함이 주 증상이므로 심한 이해 손상과 맞지 않는다.\",\"3\":\"전도실어증은 이해가 양호하고 따라말하기가 선택적으로 손상되는 유형으로 이 사례와 정반대 양상이다.\",\"5\":\"혼합연결피질실어증은 비유창하고 반향어를 보이며 표현·이해가 모두 심하게 손상되는데, 이 환자는 발화가 유창하다.\"}},\"1-2-1-3\":{\"p\":\"삼킴 전 후두계곡으로의 조기 흘러넘침과 삼킴반사 지연으로 얇은 액체가 기도로 들어가며, 기침이 없는 무증상 침습이 관찰된다. 점도를 높이면 침습이 소실되었으므로 점도 증가(식이 조정)가 1차 보상 전략이고, 턱 당기기(chin-tuck)는 후두계곡을 넓히고 기도 입구를 좁혀 삼킴 전 흡인을 줄인다. 여기에 온도-촉각 자극 등 삼킴반사 촉진을 병행하는 조합이 가장 적절하다.\",\"w\":{\"2\":\"얇은 액체는 침습을 유발한 원인 점도이므로 유지하는 것은 부적절하며, 성문상 삼킴만으로 반사 지연·조기 흘러넘침을 해결하지 못한다.\",\"3\":\"점도 조절로 침습이 소실되어 안전한 경구 섭취 조건이 확인되었으므로 전면 금식·비위관 유지는 과잉 조치이다.\",\"4\":\"멘델슨 기법과 혀 저항 운동은 후두 거상 부족·UES 개방 감소·혀 기저부 약화에 대한 기법으로 이 환자의 삼킴 전 단계 문제와 맞지 않는다.\",\"5\":\"고개 젖히기는 기도 입구를 열어 조기 흘러넘침 환자의 흡인 위험을 높이며, 얇은 액체를 반복 섭취하는 것도 침습을 악화시킨다.\"}},\"1-2-1-4\":{\"p\":\"소뇌 병변에 의한 실조형 마비말장애는 조음 운동의 협응(타이밍·범위·방향) 장애로 자음·모음이 불규칙하게 붕괴되는 것이 핵심이다. 또한 음절마다 강세가 과도하고 균등한 과도·균등 강세, 불규칙한 음도·강도 변동 등 운율 붕괴가 동반된다. 이러한 불규칙 조음 오류와 운율 붕괴는 근력 약화에 따른 일관된 부정확성·과비성을 보이는 이완형과 구별되는 소견이다.\",\"w\":{\"1\":\"과비성과 기식성 음성은 하부운동신경원 손상에 의한 이완형 마비말장애의 특징으로, 감별 대상 쪽 소견이다.\",\"2\":\"쥐어짜는 듯한 노력성 음성은 양측 상부운동신경원 손상에 의한 경직형의 특징이다.\",\"3\":\"단조로운 음도와 감소된 강도는 기저핵 손상에 의한 과소운동형(파킨슨병)의 특징이다.\",\"5\":\"말속도가 점점 빨라지고 뭉개지는 가속 현상은 과소운동형의 특징이며, 실조형은 오히려 말속도가 느리다.\"}},\"1-2-1-5\":{\"p\":\"규칙어와 비단어는 정확히 읽는데 불규칙어에서만 규칙화 오류가 나타나면, 자소-음소 변환 규칙에 의존하는 음운(비어휘) 경로는 보존되고 낱말 전체를 인식해 읽는 어휘 경로가 손상된 표층실독증이다. 비단어 '무핀' 읽기가 양호한 것이 음운 경로 보존의 근거이다. 불규칙어의 발음은 어휘 경로를 통해서만 올바르게 인출되므로 규칙화 오류가 핵심 증상이 된다.\",\"w\":{\"1\":\"심층실독증은 의미착어(예: '바다'→'강')와 비단어 읽기의 심한 손상을 보이는데, 이 환자는 비단어를 잘 읽는다.\",\"3\":\"음운실독증은 음운 경로 손상으로 비단어 읽기가 선택적으로 손상되므로 양호한 비단어 읽기와 모순된다.\",\"4\":\"순수실독증은 시각 입력 단계 손상으로 낱자 하나씩 읽기(letter-by-letter)와 낱말 길이 효과를 보이며 규칙화 오류가 특징이 아니다.\",\"5\":\"무시실독증은 편측 공간 무시로 낱말의 한쪽(주로 왼쪽) 부분을 빠뜨리거나 대치하는 오류를 보인다.\"}},\"1-2-1-6\":{\"p\":\"서서히 진행되는 언어 저하는 원발진행실어증(PPA)을 시사하며, 낱말 인출 손상과 문장 따라말하기 손상이 핵심 진단 기준인 유형은 로고페닉형이다. 음소착어와 발화 중 낱말 찾기 휴지가 잦은 반면 낱말 의미·대상 지식과 문법은 상대적으로 보존된다는 점이 이 유형의 전형적 프로파일이다. 음운 작업기억(음운 루프) 결함이 핵심 기제로 설명된다.\",\"w\":{\"1\":\"의미형 PPA는 이름대기와 단일 낱말 이해 손상, 대상 지식 소실이 핵심인데 이 환자는 의미 지식이 보존되어 있다.\",\"3\":\"비유창/실문법형 PPA는 실문법증과 노력성·비유창 발화, 말실행증이 핵심으로 유창하고 문법이 보존된 이 사례와 맞지 않는다.\",\"4\":\"혼합형 PPA는 두 가지 이상 유형의 핵심 특징이 함께 나타날 때 쓰는 분류로, 이 사례는 로고페닉형 기준을 명확히 충족한다.\",\"5\":\"점진적으로 진행하는 언어 중심 저하이며 일상 기능 손상의 주된 원인이 언어 문제이므로 PPA에 해당한다.\"}},\"1-2-1-7\":{\"p\":\"의미자질분석(SFA)은 목표 그림을 중심에 두고 범주·용도·동작·특징·위치·연상 등 의미자질을 스스로 산출하게 하는 이름대기 중재이다. 목표 낱말 주변의 의미망을 활성화해 확산 활성화 원리로 목표 어휘 인출을 촉진하며, 훈련하지 않은 낱말로의 일반화도 기대할 수 있다. 따라서 치료 기전은 의미자질 활성화를 통한 낱말 인출 촉진이다.\",\"w\":{\"1\":\"조음 운동의 반복 학습·자동화는 말실행증의 운동학습 원리 중재에 해당한다.\",\"2\":\"억양과 리듬을 이용한 발화 유도는 멜로디 억양 치료(MIT)의 기전이다.\",\"4\":\"제스처 제한과 구어 산출 강제는 제약유발 언어치료(CILT)의 원리이다.\",\"5\":\"문법형태소 산출의 위계적 훈련은 실문법증 대상 문장 산출 중재의 원리이다.\"}},\"1-2-1-8\":{\"p\":\"우반구 손상 환자는 함축·은유·농담 등 비문자적 의미 이해의 어려움(화용 결함), 정서적 운율의 산출·이해 결함, 좌측 편측 무시를 보인다. 이 환자는 세 영역 모두에서 문제가 나타나므로 화용·운율·주의(훑어보기) 중재가 적절하다. 반면 문법형태소 산출 훈련은 좌반구 브로카실어증의 실문법증에 대한 중재로, 문법 능력이 보존된 우반구 손상 환자에게는 부적절하다.\",\"w\":{\"2\":\"은유·농담의 함축 파악 실패에 대응하는 중재로 적절하다.\",\"3\":\"단조로운 억양과 억양을 통한 감정 인식 실패(운율 결함)에 대응하는 중재로 적절하다.\",\"4\":\"그림 왼쪽 세부를 놓치는 좌측 무시에 대응하는 중재로 적절하다.\",\"5\":\"실제 대화 상황에서 화용 행동을 교정하고 일반화를 돕는 중재로 적절하다.\"}},\"1-2-1-9\":{\"p\":\"비유창성 실어증 환자가 스스로 말하기는 매우 제한적이나 익숙한 노래 가락에서는 구를 산출한다는 점은 멜로디 억양 치료(MIT)의 적응증을 보여 준다. MIT는 억양·리듬·노래 처리에 관여하는 비교적 보존된 우반구 기능을 활용하고, 억양 읊조리기와 손 두드리기로 발화를 유도한 뒤 점차 일반 운율로 이행한다. 따라서 치료법과 근거는 멜로디 억양 치료 – 우반구 활용이다.\",\"w\":{\"1\":\"의미자질분석은 낱말 인출을 위한 의미망 강화 기법으로 노래 가락에서 발화가 촉진되는 특성을 활용하지 않는다.\",\"3\":\"제약유발 언어치료는 비구어 수단을 제한하고 구어를 강제하는 기법으로 이 사례의 핵심 단서(노래)와 연결되지 않는다.\",\"4\":\"각본 훈련은 특정 상황 대화를 반복 연습해 자동화하는 기법이며, 노래를 통한 우반구 활용과는 기전이 다르다.\",\"5\":\"노래 맥락에서 구어 산출이 가능하므로 구어를 포기하고 AAC로 전환할 근거가 없다.\"}},\"1-2-1-10\":{\"p\":\"전도실어증은 유창한 발화와 양호한 청각적 이해 속에 음소착어와 선택적인 따라말하기 손상을 보이며, 자기 오류를 인식하고 반복 수정하는 접근 시도(conduite d'approche)가 특징이다. 이 환자의 결함은 음운 수준의 산출·따라말하기에 있으므로, 음소 단서를 활용한 따라말하기 반복 훈련으로 음운 부호화와 자기 수정을 강화하는 것이 가장 적절하다. 보존된 이해력과 오류 인식 능력이 중재의 강점으로 활용된다.\",\"w\":{\"1\":\"청각적 이해가 양호하므로 이해력 향상 훈련을 우선할 이유가 없다.\",\"2\":\"문법형태소 산출 훈련은 실문법증을 보이는 브로카실어증의 중재로, 발화가 유창한 전도실어증의 핵심 결함과 맞지 않는다.\",\"3\":\"구어가 유창하고 이해가 양호하므로 제스처만으로 의사소통하게 하는 것은 잔존 능력을 버리는 부적절한 접근이다.\",\"5\":\"유창한 발화가 있으므로 완전 무발화로 볼 수 없고 AAC를 즉시 도입할 근거가 없다.\"}},\"1-2-1-11\":{\"p\":\"전반실어증은 발화·이해·따라말하기·이름대기가 모두 심하게 손상된 유형으로, 초기 단계에서 구어 기능 회복을 겨냥한 고난도 과제는 성공 경험을 주기 어렵다. 남아 있는 자동구어·표정·제스처를 활용해 AAC(의사소통판·제스처 등)로 기능적 의사소통 통로를 확보하고, 가족 등 의사소통 파트너가 환자의 시도를 알아채고 지원하도록 훈련하는 것이 우선이다. 이는 참여 중심·기능 중심 중재 원칙에 부합한다.\",\"w\":{\"1\":\"복잡한 통사 구조 이해는 전반실어증 초기 환자의 수준을 크게 넘는 과제이다.\",\"2\":\"비단어 따라말하기는 기능적 가치가 낮고 따라말하기가 심하게 손상된 환자에게 부적절하다.\",\"3\":\"불규칙어 소리 내어 읽기는 표층실독증 등 읽기 경로 중재에 해당하며 초기 기능적 의사소통 확보와 거리가 멀다.\",\"4\":\"이름대기가 심하게 손상된 상태에서 속도 훈련은 부적절하며, 속도는 정확성 확보 이후의 목표이다.\"}},\"1-2-1-12\":{\"p\":\"이름대기 단서 위계는 환자의 자기 인출 노력을 최대한 요구하는 약한 단서에서 시작해 점차 목표 낱말의 형태 정보를 더 많이 주는 강한 단서로 진행한다. 의미 단서(범주·기능)는 형태 정보를 주지 않아 가장 약하고, 초성 음소 단서는 음운 형태 일부를, 문장 완성 단서는 문맥상 거의 유일한 답을 유도하며, 따라말하기는 목표어 전체를 제시하므로 가장 강하다. 따라서 의미 → 초성 음소 → 문장 완성 → 따라말하기 순이 옳다(교재에 따라 음소 단서와 문장 완성 순서가 바뀌기도 한다).\",\"w\":{\"1\":\"초성 음소 단서를 의미 단서보다 먼저 제시하여 음운 형태 정보를 담은 강한 단서가 앞에 온다.\",\"2\":\"가장 강한 따라말하기를 두 번째에 배치하여 이후 단서가 오히려 약해지는 역위계이다.\",\"3\":\"가장 강한 따라말하기로 시작해 약한 단서로 가는 역순(강→약)에 가깝다.\",\"4\":\"문장 완성과 따라말하기 같은 강한 단서가 앞에 오고 의미 단서가 뒤에 와 위계가 뒤섞여 있다.\"}},\"1-2-1-13\":{\"p\":\"근력 저하 없이 조음 위치를 찾는 모색행동, 같은 낱말에서도 일관되지 않은 조음 오류, 자동구어의 상대적 보존은 말운동 계획·프로그래밍 장애인 말실행증의 특징이다. 근육 자체가 아니라 운동 계획의 문제이므로 운동학습 원리(집중적 반복 연습, 무선 연습, 점진적 난이도 조절, 적절한 피드백 빈도)를 적용한 조음·조음 전환 연습이 치료의 핵심이다. 따라서 운동학습 원리의 집중 조음 연습이 가장 적절하다.\",\"w\":{\"2\":\"근력 저하가 없는 말실행증에 구강 근력 강화 저항 운동은 근거가 약하며, 이는 마비말장애 등 근력 약화에 대한 접근이다.\",\"3\":\"청각적 이해력 훈련은 실어증의 이해 결함에 대한 중재로 말실행증의 운동 계획 결함과 무관하다.\",\"4\":\"호흡 지구력 훈련은 호흡 지지가 약한 마비말장애 환자에게 고려되는 중재이다.\",\"5\":\"과비성 감소 공명 훈련은 구개인두 기능부전(이완형 등)에 대한 중재로 이 사례의 특징과 맞지 않는다.\"}},\"1-2-1-14\":{\"p\":\"양측 상부운동신경원(추체로) 병변에 의한 경직형 마비말장애는 근긴장 항진과 근약화로 느리고 노력성인 말, 쥐어짜는 듯한 거친 음성, 과비성을 보인다. 과도한 근긴장이 음성·조음 문제의 핵심이므로 이완 기법 등 근긴장 완화 중재와 함께 말속도·강세 조절을 통해 명료도와 자연스러움을 높이는 것이 적절하다. 성대 과내전을 줄이는 부드러운 발성 시작도 같은 맥락이다.\",\"w\":{\"1\":\"경직형은 말속도를 높이면 조음 정확도가 더 떨어지므로 말속도 증가는 부적절하다.\",\"2\":\"이미 성대가 과도하게 내전되어 쥐어짜는 음성이 나오므로 성대를 더 조이는 훈련은 증상을 악화시킨다.\",\"3\":\"불수의 운동 억제는 과다운동형 마비말장애의 문제이며, 경직형에는 불수의 운동이 핵심 증상이 아니다.\",\"4\":\"과비성이 이미 동반되어 있으므로 비강 공명을 늘리는 훈련은 역효과를 낸다.\"}},\"1-2-1-15\":{\"p\":\"하부운동신경원·뇌신경 병변으로 연구개 근약화가 생기면 구개인두 폐쇄부전이 나타나 과비성, 비누출, 약한 압력 자음이 발생한다. 근약화가 심해 행동 중재만으로 구개인두 폐쇄를 확보하기 어려울 때는 연구개를 물리적으로 들어 올려 주는 구개거상장치(palatal lift)를 우선 고려한다. 이는 공명과 구강 내압을 개선해 말명료도를 직접 높인다.\",\"w\":{\"1\":\"말속도 감소는 실조형·과소운동형 등에서 명료도를 높이는 전략으로, 구개인두 폐쇄부전의 직접 해결책이 아니다.\",\"2\":\"불수의 운동 억제는 과다운동형 마비말장애의 중재 목표이다.\",\"4\":\"좌측 훑어보기 훈련은 우반구 손상 환자의 좌측 무시에 대한 중재이다.\",\"5\":\"억양·리듬 치료(MIT)는 비유창성 실어증 중재로 이완형의 공명 문제와 무관하다.\"}},\"1-2-1-16\":{\"p\":\"파킨슨병에 의한 과소운동형 마비말장애는 단조로운 음도, 감소된 강도, 가속된 말속도가 특징이며, 환자가 자신의 목소리가 작다는 것을 인식하지 못하는 감각 인식(보정) 결함이 동반된다. LSVT LOUD는 '크게 말하기'라는 단일 목표를 고강도로 반복해 발성 강도를 높이고 강도 감각을 재보정하며, 파킨슨병 말장애에 대해 가장 근거가 확립된 치료법이다. 따라서 LSVT LOUD – 강도 증대가 옳다.\",\"w\":{\"1\":\"CILT는 만성 실어증 환자의 구어 사용을 늘리는 실어증 중재이다.\",\"2\":\"MIT는 비유창성 실어증의 발화 유도 기법으로 과소운동형 마비말장애의 표적과 맞지 않는다.\",\"4\":\"SFA는 실어증의 이름대기 중재 기법이다.\",\"5\":\"chin-tuck은 삼킴장애의 자세 보상 기법으로 말장애 치료법이 아니다.\"}},\"1-2-1-17\":{\"p\":\"숨 참기 → 삼키기 → 삼킨 직후 기침 → 다시 삼키기의 순서는 성문상 삼킴(supraglottic swallow)이다. 삼키기 전에 숨을 참아 성대를 자발적으로 내전시켜 삼킴 전·중 기도를 보호하고, 삼킨 직후 기침으로 성문 위에 남은 잔여물을 배출한다. 따라서 목적은 삼킴 전·중 성대를 닫아 기도를 보호하는 것이다.\",\"w\":{\"1\":\"상부식도괄약근 개방 시간 연장은 후두 거상을 유지하는 멘델슨 기법의 목적이다.\",\"2\":\"식도 연동 운동은 불수의적 식도 단계 기능으로 행동적 삼킴 기법으로 촉진하는 대상이 아니다.\",\"3\":\"혀 기저부 후방 이동 강화는 노력 삼킴이나 혀 기저부 운동의 목적이다.\",\"4\":\"저작 촉진은 구강 준비 단계 중재로, 기도 보호를 위한 성문상 삼킴의 목적과 무관하다.\"}},\"1-2-1-18\":{\"p\":\"후두 거상 불충분과 짧은 상부식도괄약근(UES) 개방으로 인두 잔여물이 남는 환자에게는 멘델슨 기법이 적절하다. 멘델슨 기법은 삼킴 중 후두가 최고로 올라간 상태를 수초간 의도적으로 유지하게 하여 후두 거상의 범위·지속 시간과 UES 개방 시간을 늘리고 인두 잔여물을 줄인다. 이 환자의 병태생리에 직접 대응하는 기법이다.\",\"w\":{\"1\":\"턱 당기기는 후두계곡을 넓히고 기도 입구를 좁혀 삼킴 전 흡인을 줄이는 자세로 UES 개방 연장 효과가 없다.\",\"2\":\"고개 돌리기는 편측 인두 약화 시 약한 쪽을 막아 식괴를 건강한 쪽으로 보내는 자세이다.\",\"3\":\"성문상 삼킴은 삼킴 전·중 기도 보호가 목적으로 후두 거상·UES 개방 문제를 직접 해결하지 않는다.\",\"5\":\"고개 젖히기는 구강 운반 장애 시 중력을 이용하는 자세로, 인두 단계 문제가 있으면 흡인 위험을 높인다.\"}},\"1-2-1-19\":{\"p\":\"제약유발 언어치료(CILT)는 제약유발 운동치료에서 유래한 기법으로, 제스처·그림·글 등 보상적 비구어 수단의 사용을 제한하고 카드 게임 등 상호작용 맥락에서 짧은 기간 고강도로 구어 산출을 요구한다. 이를 통해 구어를 쓰지 않게 되는 학습된 미사용(learned nonuse)을 극복하고 일상 구어 사용을 늘린다. 따라서 핵심 원리는 비구어 수단 제한과 구어 산출 강제이다.\",\"w\":{\"1\":\"비구어 수단을 적극 허용하는 것은 PACE 등 다중 양식 접근의 원리로 CILT와 정반대이다.\",\"2\":\"억양과 리듬을 이용한 발화 유도는 MIT의 원리이다.\",\"4\":\"목표 낱말 의미자질 분석은 SFA의 원리이다.\",\"5\":\"보호자가 대신 말하게 하는 것은 환자의 구어 사용 기회를 줄여 CILT의 목적에 어긋난다.\"}},\"1-2-1-20\":{\"p\":\"각본(스크립트) 훈련은 병원 접수·전화처럼 환자에게 필요한 특정 상황의 대화문을 함께 만들고 반복 연습하여 해당 발화를 유창하고 자동적으로 산출하게 하는 기능적 중재이다. 경도~중등도 실어증 환자가 특정 상황에서 필요한 발화의 자동화를 원한다는 목표와 정확히 일치한다. 연습된 각본이 실제 상황에서 쓰이도록 일반화 연습을 함께 계획한다.\",\"w\":{\"1\":\"비단어 따라말하기는 음운 처리 훈련으로 상황 특이적 기능적 발화의 자동화와 거리가 멀다.\",\"3\":\"불규칙어 읽기 훈련은 표층실독증 등 읽기 중재에 해당한다.\",\"4\":\"좌측 훑어보기는 우반구 손상 환자의 좌측 무시 중재이다.\",\"5\":\"구강 근력 강화는 마비말장애 등 말운동 약화에 대한 접근으로 실어증의 발화 자동화 목표와 무관하다.\"}},\"1-2-1-21\":{\"p\":\"환자 A의 문법형태소 생략·전보식·비유창 발화는 브로카실어증의 특징이므로 발화 산출과 문법 구조 중재가 우선된다. 환자 B의 유창하나 착어가 많고 공허한 발화는 베르니케실어증의 특징으로, 이해 손상과 자기 점검 부족이 근본 문제이므로 청각적 이해 중재가 우선된다. 진단과 우선 중재가 모두 올바르게 짝지어진 것은 A 브로카·산출, B 베르니케·이해이다.\",\"w\":{\"2\":\"A와 B의 진단이 서로 뒤바뀌었고 중재도 각 유형의 핵심 결함과 어긋난다.\",\"3\":\"진단은 맞으나 A(브로카)에 이해 중재, B(베르니케)에 문법 중재를 짝지어 우선순위가 뒤바뀌었다.\",\"4\":\"A는 비유창, B는 이해 손상이 두드러져 이해가 양호하고 유창한 전도실어증으로 볼 수 없다.\",\"5\":\"두 환자 모두 명칭실어증보다 광범위한 결함(비유창 문법 결함, 이해 손상)을 보인다.\"}},\"1-2-1-22\":{\"p\":\"새 정보를 즉시 회상하지 못하고 일정을 잊는 것은 일화기억·전향기억 결함, 장황하고 주제에서 벗어나는 대화는 집행기능 저하에 따른 화용 결함으로, TBI의 전형적인 인지-의사소통장애이다. 따라서 다이어리·스마트폰 알림 등 외부 기억 보조 수단 사용 훈련과 주제 유지·차례 지키기 등 화용 중재를 결합하는 것이 가장 적절하다. 이는 기능 회복과 보상 전략을 함께 활용하는 접근이다.\",\"w\":{\"1\":\"불규칙어 읽기 훈련은 후천성 실독증 중재로 기억·화용 결함을 다루지 못한다.\",\"2\":\"과비성 감소 공명 훈련은 마비말장애의 공명 문제에 대한 중재로 사례와 무관하다.\",\"4\":\"성문상 삼킴은 삼킴장애 기법으로 인지-의사소통 중재가 아니다.\",\"5\":\"좌측 공간 훑어보기는 우반구 손상 편측 무시에 대한 중재로 이 환자의 문제와 맞지 않는다.\"}},\"1-2-1-23\":{\"p\":\"초기 알츠하이머병은 일화기억(최근 기억) 저하가 두드러지지만 절차기억과 점화(암묵기억)는 비교적 보존된다. 간격 회상 기법(spaced retrieval)은 정보를 점차 늘어나는 시간 간격으로 반복 인출하게 하여 보존된 암묵기억을 활용하며, 무오류 학습 원리를 적용해 이름·일상 정보를 유지시키는 근거 기반 중재이다. 따라서 이 환자에게 가장 적절하다.\",\"w\":{\"1\":\"복잡한 통사 이해 훈련은 인지 부담이 크고 이름대기·일상 기억 유지라는 목표와 맞지 않는다.\",\"3\":\"비단어 따라말하기는 기능적 가치가 낮고 기억 유지 전략이 아니다.\",\"4\":\"제약유발 언어치료는 실어증 환자의 구어 사용 증대 기법으로 치매 기억 중재가 아니다.\",\"5\":\"구강 근력 강화는 말운동·삼킴 관련 중재로 기억·이름대기 목표와 무관하다.\"}},\"1-2-1-24\":{\"p\":\"의사소통효과증진법(PACE)은 실제 대화 원리를 치료에 옮긴 화용 중심 접근으로, 치료사와 환자가 동등한 참여자로서 순번을 교대하며 상대가 모르는 새 정보를 전달한다. 전달 수단은 구어·제스처·그림·글 등 환자가 자유롭게 선택하며, 피드백은 형식의 정확성보다 메시지 전달 성공 여부에 근거한다. 따라서 새 정보를 다양한 수단으로 주고받는 것이 원리이다.\",\"w\":{\"2\":\"PACE에서는 청자가 정보를 모르는 상태여야 하므로 치료사가 정답을 먼저 알려 주면 새 정보 원리에 어긋난다.\",\"3\":\"구어만 사용하도록 제한하는 것은 CILT의 원리로 PACE의 다중 양식 허용과 반대이다.\",\"4\":\"문법형태소의 정확한 산출은 형식 중심 목표로, 전달 성공을 중시하는 PACE의 원리가 아니다.\",\"5\":\"그림 이름 순서대로 따라 말하기는 전통적 자극-반응 훈련으로 새 정보 교환이 없다.\"}},\"1-2-1-25\":{\"p\":\"ND 점수 = 9 ÷ 300 × 100 = 3이고, AD 점수 = 12 ÷ 300 × 100 × 1.5 = 4 × 1.5 = 6이다. 따라서 비유창성 총점은 3 + 6 = 9이다. 비정상적 비유창성에만 가중치 1.5를 곱한다는 점이 계산의 핵심이다.\",\"w\":{\"1\":\"7은 AD에 가중치 1.5를 적용하지 않고 ND 3 + AD 4를 더한 값이다.\",\"2\":\"10.5는 ND에도 가중치 1.5를 잘못 곱해(3 × 1.5 = 4.5) AD 6과 더한 값이다.\",\"4\":\"12는 AD 횟수(12회)를 음절 수로 환산하지 않고 그대로 점수로 쓰는 등 산출식을 잘못 적용한 값이다.\",\"5\":\"15는 AD에 가중치를 과다 적용(4 × 3 = 12)한 뒤 ND 3을 더한 값 등 가중치 오류에 해당한다.\"}},\"1-2-1-26\":{\"w\":{\"2\":\"SLD 100음절당 5.2회는 학령전기 기준(3회)을 넘으므로 정상 범위라는 해석은 틀렸다.\",\"3\":\"SLD 비율이 72%로 높고 긴장이 동반되어 간투사·구 반복 중심의 정상적 비유창성으로 볼 수 없다.\",\"4\":\"반복 단위 수는 평균 2회 이상이면 이미 말더듬 지표에 해당하며, 3회 미만이라는 이유로 말더듬을 배제할 수 없다.\",\"5\":\"학령전기 아동에게 성인 %SS 기준을 적용하는 것은 부적절하고, 연장된 말 훈련은 3세 아동의 1차 선택이 아니다.\"}},\"1-2-1-27\":{\"p\":\"여아, 발병 후 12개월 미만(4개월), 자연회복한 친척(외삼촌) 가족력, SLD 8회→4회의 감소 추세, 정상 음운·언어발달, 말더듬 인식 없음은 모두 자연회복을 예측하는 요인이다. 반면 부모의 불안과 '천천히' 지시는 아동에게 압박이 될 수 있다. 따라서 부모 상담과 상호작용 조정 등 간접 중재를 제공하면서 정기적으로 재평가해 추이를 감시하는 것이 가장 적절하다.\",\"w\":{\"1\":\"자연회복 예후 요인이 많고 호전 추세이므로 리드콤을 즉시 시작하는 것은 시기상조이며, 관찰 후 호전이 없을 때 고려한다.\",\"2\":\"말더듬수정법의 확인 훈련은 자신의 말더듬을 인식하지 않는 2세 아동에게 부적절하고 오히려 인식을 유발할 수 있다.\",\"4\":\"자연회복 가능성이 높아도 지속 여부를 확인해야 하므로 추후 관리 없는 종결은 부적절하다.\",\"5\":\"성인용 유창성완성 프로그램은 2세 아동의 발달 수준에 맞지 않는다.\"}},\"1-2-1-28\":{\"w\":{\"1\":\"경계선 말더듬은 긴장·회피 없이 반복이 많은 초기 단계로, 부정적 태도와 회피가 뚜렷한 9세 아동과 맞지 않는다.\",\"2\":\"초기 말더듬은 긴장·탈출행동이 나타나기 시작하는 학령전기 단계이며 회피·공포는 두드러지지 않고, 리드콤도 주로 학령전기 대상이다.\",\"3\":\"진전된 말더듬은 청소년·성인의 고착된 단계이며, DAF 기기 단독 사용으로는 회피·태도 문제를 다룰 수 없다.\",\"5\":\"긴장된 막힘·부수행동·회피가 있으므로 정상적 비유창성이 아니다.\"}},\"1-2-1-29\":{\"p\":\"리드콤 프로그램 1단계의 목표는 클리닉 %SS 1.0 미만과 부모 SR 1~2 유지를 3주 연속 충족하는 것이다. 이 아동은 3주 연속 %SS 0.6, 0.4, 0.5이고 SR 1~2를 유지했으므로 1단계 준거에 도달하였다. 따라서 2단계(유지)로 진입하여 방문 간격을 점차 늘리고 수반자극을 단계적으로 줄이며 재발을 감시해야 한다.\",\"w\":{\"1\":\"이미 1단계 준거를 충족했으므로 1단계를 6개월 더 유지할 이유가 없다.\",\"2\":\"리드콤이 효과를 보이고 있는데 다른 접근(말더듬수정법)으로 전환할 근거가 없으며, 취소 기법은 5세 아동에게 적합하지 않다.\",\"3\":\"리드콤은 재발 감시를 위한 2단계를 거쳐야 하므로 즉시 종결은 부적절하다.\",\"4\":\"2단계에서도 수반자극과 SR 측정은 점진적으로 줄여 가며 재발을 감시하므로 일괄 중단은 원리에 어긋난다.\"}},\"1-2-1-30\":{\"p\":\"리드콤 프로그램의 언어적 수반자극은 유창한 발화에 대한 칭찬·인정이 중심이고, 말더듬에 대한 인정·수정 요구는 간헐적으로만 제공해야 한다. 이 어머니는 매번 수정을 요구하고 칭찬이 거의 없어 아동이 말하기를 꺼리고 짜증을 내는 부작용이 나타났다. 따라서 유창한 발화에 대한 칭찬 비율을 수정 요구보다 훨씬 높게(예: 5:1 이상) 조정하도록 지도하는 것이 가장 적절하다.\",\"w\":{\"2\":\"수정 요구를 더 강하게 하면 이미 나타난 회피·짜증 반응을 악화시키며 리드콤의 긍정적 수반자극 원리에 어긋난다.\",\"3\":\"수반자극을 모두 중단하면 리드콤의 핵심 기제를 버리는 것이며, 부모 말속도 늦추기는 간접 중재의 요소이다.\",\"4\":\"아동의 짜증은 과도한 수정 요구의 부작용이므로 타임아웃으로 처벌할 것이 아니라 수반자극 비율을 조정해야 한다.\",\"5\":\"말더듬 순간의 자기분석은 말더듬수정법의 요소로 학령전기 아동에게 부적합하다.\"}},\"1-2-1-31\":{\"p\":\"Palin PCI는 부모-아동 놀이를 녹화한 영상을 함께 보며 부모가 아동의 유창성에 도움이 되는 상호작용 전략(말속도 늦추기, 기다리기, 질문 줄이기 등)을 스스로 찾아 선택하게 하는 간접 중재이다. 부모는 매주 수차례 5분 정도의 특별시간에 선택한 전략을 실천하고, 불안·죄책감 등 가족 전략도 함께 다룬다. 빠른 부모 말속도와 끼어들기, 높은 부모 불안이 나타난 이 사례에 적합하다.\",\"w\":{\"1\":\"PCI는 부모 참여가 핵심인 프로그램으로 부모를 배제하고 치료사가 단독으로 치료하는 것은 정반대이다.\",\"2\":\"유창한 발화에 칭찬하고 말더듬에 수정 요구하며 SR을 기록하는 것은 리드콤 프로그램의 절차이다.\",\"3\":\"연장된 말 시범으로 유창한 말 패턴을 확립하는 것은 유창성완성법의 절차이다.\",\"4\":\"말더듬 순간 확인과 취소 기법은 말더듬수정법(Van Riper)의 절차이다.\"}},\"1-2-1-32\":{\"w\":{\"1\":\"복잡한 문장 산출 요구는 언어적 요구를 더 높여 요구-용량 불균형을 악화시킨다.\",\"2\":\"취소·빠져나오기는 말더듬수정법 기법으로 4세 아동의 용량을 높이는 방법이 아니며 모델의 중재 방향과 다르다.\",\"4\":\"발화 기회 제한은 비현실적이고 의사소통 발달을 저해하며 모델이 권장하는 방법이 아니다.\",\"5\":\"동생과의 상호작용 차단은 비현실적이고 정서적으로 해로우며, 정서적 요구는 차단이 아니라 지지와 예측 가능한 일과로 낮춘다.\"}},\"1-2-1-33\":{\"p\":\"Van Riper의 말더듬수정법은 동기-확인-둔감화-변형-접근-안정화(MIDVAS) 순서로 진행된다. 확인 단계를 마쳤으나 말더듬 순간의 강한 공포와 청자 시선 회피가 남아 있으므로, 다음 단계는 둔감화이다. 둔감화에서는 의도적(가짜) 말더듬, 말더듬 순간 얼어붙기(freezing), 청자 반응 직면 등을 통해 공포와 긴장을 줄인다.\",\"w\":{\"1\":\"변형은 둔감화 다음 단계로 습관화된 말더듬 패턴을 바꾸어 보는 단계이며, 취소 기법은 접근 단계의 기법이다.\",\"2\":\"빠져나오기와 예비책은 접근 단계의 기법으로 둔감화를 거치기 전에 적용하기에는 이르다.\",\"4\":\"안정화는 MIDVAS의 마지막 단계로 확인 직후에 진행할 단계가 아니다.\",\"5\":\"동기는 첫 단계로 이미 확인 단계까지 마친 대상자에게 다음 단계가 될 수 없다.\"}},\"1-2-1-34\":{\"p\":\"%SS 1.2로 겉으로는 거의 유창하나 낱말 대치와 전화·주문·자기소개 회피, 말더듬 은폐, OASES 총 영향 '심함'은 내재화(covert) 말더듬의 전형이다. 이 대상자의 핵심 문제는 핵심행동 빈도가 아니라 회피와 두려움, 부정적 삶의 영향이므로, 회피하던 낱말·상황에 대한 위계적 노출, 의도적 말더듬, 말더듬 자기공개로 회피를 줄이고 둔감화하는 것이 우선 목표이다.\",\"w\":{\"1\":\"이미 낮은 %SS를 0에 가깝게 낮추는 훈련은 회피·두려움이라는 핵심 문제를 다루지 못하고 '더듬으면 안 된다'는 신념을 강화할 수 있다.\",\"3\":\"부모 참여 언어적 수반자극 프로그램(리드콤)은 학령전기 아동 대상이다.\",\"4\":\"취소 기법으로 핵심행동 지속시간을 줄이는 것은 드러난 말더듬 행동을 겨냥한 것으로 회피가 주 문제인 이 사례의 우선 목표가 아니다.\",\"5\":\"DAF 기기는 말속도를 낮춰 일시적 유창성을 유도할 뿐 회피와 부정적 태도를 다루지 못한다.\"}},\"1-2-1-35\":{\"p\":\"전체 말속도는 총 음절 수를 소요 시간(분)으로 나누어 구하므로 375 ÷ 2.5분 = 150 SPM이다. %SS는 말더듬 음절 수를 총 음절 수로 나누어 100을 곱하므로 15 ÷ 375 × 100 = 4%이다. 2분 30초를 2.5분으로 정확히 환산하는 것이 핵심이다.\",\"w\":{\"1\":\"125 SPM은 375음절을 3분으로 나눈 오류이다(%SS 4%는 맞다).\",\"2\":\"150 SPM은 맞으나 2.5%는 %SS를 잘못 계산한 값(예: 15 ÷ 600 × 100)이다.\",\"3\":\"187.5 SPM은 375음절을 2분으로 나눈 오류로 30초를 누락했다(%SS 4%는 맞다).\",\"5\":\"150 SPM은 맞으나 6%는 %SS를 잘못 계산한 값(예: 15 ÷ 250 × 100)이다.\"}},\"1-2-1-36\":{\"w\":{\"1\":\"취소·빠져나오기·예비책은 말더듬수정법 기법으로 유창성완성법을 선택한 이 대상자의 접근과 맞지 않는다.\",\"3\":\"차폐 소음과 메트로놈 리듬 말하기는 일시적 유창성 유도 조건으로 특정 막힘 양상을 겨냥한 기법이 아니다.\",\"4\":\"의도적 말더듬과 자기공개는 말더듬수정법·회피 감소 기법으로 성대·조음기관 긴장에 직접 대응하지 않는다.\",\"5\":\"호흡 근력 강화와 큰 소리로 말하기는 말더듬의 긴장된 발성 개시·조음 접촉 문제와 무관하며 오히려 긴장을 높일 수 있다.\"}},\"1-2-1-37\":{\"w\":{\"2\":\"리드콤은 학령전기 아동 대상으로 부모가 언어적 수반자극을 제공하는 프로그램이다.\",\"3\":\"GILCU는 발화 길이와 복잡성을 단계적으로 늘리는 프로그램된 조작적 접근으로 정해진 위계가 있다.\",\"4\":\"페일린 PCI는 학령전기 아동의 부모-아동 상호작용을 조정하는 간접 중재이다.\",\"5\":\"스토커 프로브 테크닉은 질문-응답 형태의 발화 요구 수준을 위계적으로 조절하는 아동 대상 기법이다.\"}},\"1-2-1-38\":{\"p\":\"치료 종료 시 %SS 0.8이던 대상자가 6개월 후 %SS 6.2로 상승하고 전화 회피가 재개된 것은 재발이다. 기법 사용 시 어색함 때문에 기법을 쓰지 않게 된 것이 원인이므로, 추후 회기에서 기법을 재확립하되 자연스러움 훈련, 자기 모니터링, 인지-정서 요소, 자조모임 등 유지 전략을 보강해야 한다. 재발은 유창성완성법 후 흔한 현상으로 치료 실패가 아니라 관리 대상이다.\",\"w\":{\"1\":\"동일 프로그램을 처음부터 반복하면 재발 원인(어색함, 유지 전략 부족)을 다루지 못한다.\",\"2\":\"%SS 상승과 회피 재개가 뚜렷한 재발 상태를 방치하면 회피와 부정적 태도가 고착될 수 있다.\",\"3\":\"DAF 기기의 영구 착용은 자연스러움과 자기관리 문제를 해결하지 못하며 근거 있는 유지 전략이 아니다.\",\"4\":\"유창성 기법 사용을 금지하고 전면 교체할 근거가 없으며, 두 접근은 통합적으로 활용할 수 있다.\"}},\"1-2-1-39\":{\"w\":{\"1\":\"A와 B의 진단이 서로 뒤바뀌었다.\",\"3\":\"A에게 DAF 단독 사용은 회피·두려움을 다루지 못하고, B의 속화에는 둔감화가 아니라 말속도 조절·자기 모니터링이 필요하다.\",\"4\":\"A는 긴장·회피·두려움이 뚜렷해 속화로 볼 수 없다.\",\"5\":\"B는 말더듬 특징보다 속화 특징을 보이며, 리드콤은 학령전기 말더듬 아동 대상 프로그램이다.\"}},\"1-2-1-40\":{\"p\":\"뇌경색 후 성인기에 발생하고, 기능어·낱말 끝 등 문장 내 위치와 무관한 반복, 부수행동·공포가 거의 없음, 적응효과 미미는 신경학적(후천성 신경인성) 말더듬의 특징이다. 심리적 요소가 적으므로 pacing 보드·말속도 감소·DAF 등 보상 전략이 중재의 중심이 되며, 동반된 마비말장애 중재와 통합하는 것이 효율적이다. 원인 질환에 대한 의학적 협진도 병행한다.\",\"w\":{\"1\":\"의도적 말더듬과 얼어붙기는 공포·회피를 줄이는 둔감화 기법으로 공포가 거의 없는 신경학적 말더듬에 우선할 이유가 없다.\",\"3\":\"부모 수반자극 방식의 조작적 프로그램은 학령전기 아동 말더듬(리드콤) 중재이다.\",\"4\":\"심리치료 우선 의뢰는 심인성 말더듬의 접근으로 뇌경색 후 발생한 이 사례와 맞지 않는다.\",\"5\":\"회피 낱말 위계 노출은 회피 행동이 두드러진 발달성 말더듬에 대한 중재이다.\"}},\"1-2-1-41\":{\"w\":{\"2\":\"신경과 검사가 정상이고 뇌손상 병력이 없으므로 신경학적 말더듬으로 볼 근거가 없다.\",\"3\":\"빠르고 불규칙한 말속도나 음절 축약이 아니라 균일한 음절 반복이 주 증상이므로 속화가 아니다.\",\"4\":\"아동기 말더듬 병력 없이 성인기에 갑자기 발생했으므로 발달성 말더듬이 아니다.\",\"5\":\"의도적으로 말더듬을 꾸며 낸다는 근거가 없으며, 심인성 말더듬은 치료 대상이다.\"}},\"1-2-1-42\":{\"w\":{\"1\":\"이중언어가 말더듬의 원인이라는 전제는 근거가 없다.\",\"2\":\"영어 사용 중단은 말더듬 개선 근거가 없고 가족 의사소통과 언어발달에 해가 될 수 있다.\",\"3\":\"발화량 자체를 줄이는 것은 언어발달과 의사소통 기회를 박탈하는 해로운 조치이다.\",\"4\":\"말더듬이 두 언어 모두에서 관찰되므로 영어 유창성을 평가하지 않으면 아동의 말더듬을 온전히 파악할 수 없다.\"}},\"1-2-1-43\":{\"w\":{\"1\":\"활동에서 계속 제외하면 회피와 위축이 강화되어 이미 나타난 부작용이 심화된다.\",\"2\":\"'천천히, 숨 쉬고' 같은 즉각적 조언은 아동의 말에 주의를 집중시켜 긴장과 수치심을 높인다.\",\"3\":\"유창해질 때까지 다시 읽게 하는 것은 말더듬을 처벌하는 효과를 내어 불안과 회피를 키운다.\",\"5\":\"말더듬 공개는 아동의 준비와 동의가 있을 때 선택할 수 있는 것으로 교사가 강요할 사항이 아니다.\"}},\"1-2-1-44\":{\"w\":{\"1\":\"유창성 유도 조건은 말더듬의 원인을 제거하지 않으며, 조건을 벗어나면 효과가 사라져 완치 근거가 없다.\",\"3\":\"효과가 대부분의 말더듬 화자에게 일관되게 나타나며 치료 초기 촉진 도구로 유용하게 쓰인다.\",\"4\":\"유창성 유도 조건에서의 유창성은 말더듬 화자에게 공통적인 현상이므로 비말더듬의 증거가 아니다.\",\"5\":\"유창성 유도 조건에 대한 반응은 발달성 말더듬의 일반적 특징이며, 오히려 심인성 말더듬은 이 조건에 반응하지 않는 경우가 많다.\"}},\"1-2-1-45\":{\"p\":\"'한 번이라도 막히면 모두가 무능하다고 생각할 것'이라는 신념은 파국화·독심술 같은 인지 왜곡이며, 이로 인한 회피와 자책이 사회불안을 유지하는 악순환을 만든다. 인지행동치료 원리에 따라 왜곡된 신념의 근거를 검토해 재구조화하고, 실제 발언 후 청자 반응을 확인하는 행동 실험·점진적 노출로 신념을 검증하는 것이 가장 적절하다. 이는 말더듬 성인의 인지-정서적 문제에 대한 근거 기반 접근이다.\",\"w\":{\"1\":\"말더듬 빈도를 0으로 낮추려는 목표는 비현실적이고 '막히면 안 된다'는 왜곡된 신념을 강화한다.\",\"2\":\"발표 상황을 완전히 피하게 하면 회피가 강화되어 악순환이 심화된다.\",\"4\":\"취소 기법 반복은 말더듬 행동 수정에 초점을 둘 뿐 신념·불안이라는 인지-정서적 문제를 다루지 못한다.\",\"5\":\"DAF 기기 사용은 일시적 유창성만 유도하며 부정적 신념과 사회불안을 해결하지 못한다.\"}},\"1-2-1-46\":{\"w\":{\"1\":\"리드콤은 부모가 일상 대화에서 수반자극을 제공하는 프로그램으로 발화 길이 위계가 핵심이 아니다.\",\"2\":\"캠퍼다운은 프로그램된 발화 길이 위계 없이 연장된 말 시범과 자기평정으로 진행된다.\",\"3\":\"동기·확인·둔감화·변형·접근·안정화는 Van Riper 말더듬수정법(MIDVAS)의 단계로 조작적 접근이 아니다.\",\"5\":\"페일린 PCI는 부모-아동 상호작용 조정 중심의 간접 중재이다.\"}},\"1-2-1-47\":{\"p\":\"중등도 지적장애 아동은 추상적 설명 이해와 자기분석에 어려움이 있고 새 기술의 유지·일반화가 느리다. 따라서 느린 말·부드러운 시작 등 유창성 기법을 단순화해 시범과 반복, 그림·몸짓 같은 시각적 단서로 지도하고, 협조적인 부모·교사가 동일한 단서와 강화를 일상에서 제공해 일반화를 돕는 것이 가장 적절하다. 인식이 낮은 특성에 맞춰 구체적·행동적 접근을 택한다.\",\"w\":{\"2\":\"말더듬 순간 분석과 인지 재구조화는 높은 수준의 추상적 사고를 요구해 지적장애 아동에게 부담이 크다.\",\"3\":\"지적장애가 있어도 말더듬 중재 효과는 기대할 수 있으므로 말더듬 치료를 배제할 근거가 없다.\",\"4\":\"성인용 캠퍼다운 프로그램의 자기평정·문제해결 절차는 수정 없이 적용하기에 지적장애 아동의 수준과 맞지 않는다.\",\"5\":\"말더듬 인식 부족은 치료 제외 사유가 아니라 중재 설계 시 고려할 특성이며, 긴장된 막힘이 있어 중재가 필요하다.\"}},\"1-2-1-48\":{\"w\":{\"1\":\"클리닉 표본만을 가장 객관적인 자료로 보고 부모 보고를 배제하면 말더듬의 맥락별 변이를 놓친다.\",\"2\":\"부모 보고만으로 즉시 직접 치료를 시작하는 것은 객관적 자료 확인 없이 결정하는 것이다.\",\"3\":\"단일 클리닉 표본의 %SS만으로 말더듬을 배제하고 종결하는 것은 변이성을 고려하지 않은 결정이다.\",\"5\":\"표준화 언어검사는 동반 언어 문제를 평가할 뿐 말더듬 진단에 필요한 유창성 표본을 대신할 수 없다.\"}},\"1-2-1-49\":{\"p\":\"26개월에 표현어휘 30개(10%ile 미만)와 낱말 조합 없음은 표현언어 지체이지만, 수용언어가 연령 수준이고 가리키기·보여주기 몸짓과 상징놀이가 적절하며 가족력이 없다. 이는 예후가 좋은 저위험 늦게 말하는 아동(late talker) 프로파일이다. 따라서 부모 매개 언어촉진(반응적 상호작용·집중자극) 교육 후 3~6개월 간격으로 재평가하는 것이 가장 적절하다.\",\"w\":{\"1\":\"위험 요인이 적은 저위험 프로파일에 주 3회 개별 집중치료는 과잉 개입이며, 부모 매개 중재가 1차 선택이다.\",\"3\":\"DLD 진단은 보통 만 4세 전후에도 언어 문제가 지속될 때 내리므로 26개월에 진단을 확정하는 것은 부적절하다.\",\"4\":\"저위험이라도 일부는 언어 문제가 지속되므로 아무 조치 없이 만 4세까지 기다리는 것은 부적절하다.\",\"5\":\"몸짓, 상징놀이, 이해가 양호해 자폐스펙트럼장애를 의심할 근거가 없으며, 낱말 조합 부재는 자폐의 핵심 징후가 아니다.\"}},\"1-2-1-50\":{\"w\":{\"1\":\"z = −0.75는 차이 12를 표준편차 16(8의 2배)으로 나눈 계산 오류이며, 백분위 23도 z = −1.5와 맞지 않는다.\",\"2\":\"z = −2.0은 차이 12를 6으로 나눈 계산 오류로, 실제 표준편차 8을 적용하지 않았다.\",\"3\":\"z = −1.5는 맞지만 백분위 16은 z = −1에 해당하므로 z와 백분위가 서로 맞지 않는다.\",\"5\":\"z = +1.5는 원점수가 평균보다 낮은데 부호를 반대로 적용한 오류이다.\"}},\"1-2-1-51\":{\"p\":\"문제의 기준(조사·어미·선어말어미를 각각 하나의 형태소로 계산)에 따르면 ① 아빠/신문/읽-/-어 = 4, ② 나/우유/먹-/-었-/-어 = 5, ③ 동생/-이/울-/-어 = 4, ④ 엄마/-가/책/찾-/-아 = 5로 분석한다. 총 형태소 18개를 발화 수 4로 나누면 MLU-m = 4.5이다. MLU-m은 총 형태소 수를 총 발화 수로 나눈 값으로, 조사와 어미를 빠뜨리면 낮게, 어간을 더 쪼개면 높게 산출된다.\",\"w\":{\"2\":\"4.0은 총 16개로, 조사 '-이'와 '-가'를 형태소로 세지 않아 과소 계산한 값이다.\",\"3\":\"3.5는 총 14개로, 조사와 어미를 형태소로 세지 않고 낱말(어절) 단위에 가깝게 센 값이다.\",\"4\":\"5.0은 총 20개로, 어간을 더 분리하는 등 형태소를 과도하게 나눈 값이다.\",\"5\":\"5.5는 총 22개로, 정답 기준보다 형태소를 크게 과대 계산한 값이다.\"}},\"1-2-1-52\":{\"p\":\"청력과 비언어성 지능(98)이 정상이고 눈맞춤·상호작용·상징놀이가 양호한데, 수용·표현언어가 지체되고 표현어휘 9%ile, 비단어 따라말하기 저하, 주격조사 생략·시제 오류·연결어미 부재 등 문법형태소 결함이 두드러진다. 이는 발달성 언어장애(단순언어장애)의 전형적 프로파일이며 비단어 따라말하기 저하는 대표적 임상 표지이다. 따라서 진단은 발달성 언어장애, 우선 중재 목표는 격조사·시제 등 문법형태소 산출이다.\",\"w\":{\"2\":\"눈맞춤·상호작용·상징놀이가 양호하고 상동행동이 없어 자폐스펙트럼장애로 볼 근거가 없다.\",\"3\":\"사회적 상호작용이 양호하고 형식(문법) 결함이 핵심이므로 사회적(화용) 의사소통장애가 아니다.\",\"4\":\"비언어성 지능지수가 98로 정상이므로 지적장애가 아니다.\",\"5\":\"결함은 조음이 아니라 문법형태소·어휘 등 언어 영역이므로 말소리장애 중재는 핵심 결함과 맞지 않는다.\"}},\"1-2-1-53\":{\"p\":\"전체 지능지수 62와 적응행동 저하는 지적장애에 해당하며, 언어 발달연령(약 3;6)이 인지 수준과 대체로 일치한다. 요구하기를 손잡아끌기로 하고 배운 낱말을 치료실 밖에서 쓰지 못하는 것은 기능적 의사소통 부족과 일반화의 어려움을 보여 준다. 따라서 요구·거부·선택 등 일상 기능과 생활 어휘를 목표로 실제 일과 속에서 반복·분산 연습하며 일반화를 강조하는 것이 가장 적절하다.\",\"w\":{\"1\":\"인지와 언어는 병행 촉진 대상이며 인지를 정상 범위로 끌어올린 뒤 언어치료를 시작한다는 전제는 비현실적이다.\",\"2\":\"언어 수준이 인지 수준과 대체로 일치하므로 언어-인지 불일치를 전제로 한 단순언어장애 프로토콜은 부적절하다.\",\"4\":\"2~3어절 단문 수준 아동에게 연령 수준의 복문 산출은 발달 수준을 크게 넘는 목표이다.\",\"5\":\"몸짓·그림 등 비구어 수단은 기능적 의사소통을 지원하므로 제한하면 총체적 의사소통 원칙에 어긋난다.\"}},\"1-2-1-54\":{\"p\":\"아동이 원하는 물건에 관심을 보일 때 치료사가 언어적 촉진 없이 기대에 찬 표정으로 약 5초간 기다려 자발적 산출을 유도하고, 산출하자 즉시 원하는 물건으로 자연적 강화를 준 것은 시간지연(time delay) 절차이다. 시간지연은 비언어적 단서(기다림·기대 표정)만으로 아동의 의사소통 시작을 이끄는 것이 핵심이다. 따라서 정답은 시간지연이다.\",\"w\":{\"1\":\"요구-모델은 치료사가 '뭐 줄까?'처럼 먼저 언어적 요구(질문·지시)를 하는 절차로, 이 사례에서는 말없이 기다렸다.\",\"2\":\"우연교수는 아동이 먼저 요구를 시작한 뒤 치료사가 더 정교한 발화를 요청하는 절차이다.\",\"3\":\"아동중심 시범은 아동의 관심에 맞춰 목표 발화를 먼저 들려주는 절차로, 이 사례에서는 시범을 제공하지 않았다.\",\"4\":\"환경 조성은 물건을 닿지 않는 곳에 두는 등 의사소통 기회를 만드는 사전 설정으로, 기다림을 통한 촉진 절차 자체를 가리키지 않는다.\"}},\"1-2-1-55\":{\"p\":\"과거시제 '-었-'을 담은 문장을 놀이 맥락에서 한 회기에 수십 번 자연스럽게 들려주되 모방이나 산출을 요구하지 않는 것은 집중자극(focused stimulation) 기법이다. 목표 형태를 의미 있는 맥락에서 고빈도로 입력하여 아동이 스스로 규칙을 추출하도록 돕는 것이 원리이다. 따라서 집중자극 – 목표 형태의 고빈도 입력이 옳다.\",\"w\":{\"1\":\"확대는 아동이 먼저 한 발화에 새로운 의미 정보를 덧붙여 되돌려 주는 반응 기법으로, 치료사가 먼저 반복 입력하는 이 사례와 다르다.\",\"2\":\"유도모방은 모델 직후 아동이 즉시 따라 말하도록 요구하는데, 이 사례에서는 산출을 요구하지 않았다.\",\"3\":\"비연속 개별시도 교수는 자극-반응-강화의 구조화된 시행으로 아동의 반응을 직접 요구한다.\",\"5\":\"혼잣말 기법은 치료사가 자신의 행동을 말로 기술하는 것으로, 특정 문법형태소를 고밀도로 입력하는 것이 목적이 아니다.\"}},\"1-2-1-56\":{\"p\":\"매 회기마다 세 가지 목표를 모두 다루며 회기 시간을 나누어 배분하는 것은 수평적(horizontal) 목표 공략 전략이다. 수평적 전략은 여러 목표를 동시에 다루어 목표 간 연결과 다양한 경험을 제공하는 장점이 있다. 따라서 정답은 수평적 전략이다.\",\"w\":{\"2\":\"주기적 전략은 준거 도달과 무관하게 정해진 기간마다 목표를 교체하며 순환하는 방식으로, 매 회기 모든 목표를 다루지 않는다.\",\"3\":\"수직적 전략은 한 목표가 준거에 도달한 뒤 다음 목표로 넘어가는 순차적 방식이다.\",\"4\":\"위계적 전략은 목표 공략 전략의 공식적 분류(수직적·수평적·주기적)에 포함되지 않는다.\",\"5\":\"절충적 전략(치료사 목표·아동 활동 선택)은 목표 공략 전략의 공식적 분류가 아니다.\"}},\"1-2-1-57\":{\"p\":\"역동적 평가에서 짧은 교수 후 새 낱말을 대부분 습득하고 검사자 노력이 적으며 수정가능성이 높은 것은 언어 학습 능력 자체가 온전함을 보여 준다. 모국어(중국어) 발달이 또래 수준이라는 점도 이를 지지하므로, 낮은 한국어 표준화 점수는 짧은 노출 기간에 따른 언어 차이로 해석한다. 따라서 모국어를 유지하면서 한국어 입력을 늘리고 추적 관찰하는 것이 적절하다.\",\"w\":{\"1\":\"한국어 단일언어 규준의 표준화 검사 점수만으로 이중언어 아동을 발달성 언어장애로 진단하는 것은 과잉 진단 오류이다.\",\"2\":\"이중언어가 혼란이나 언어장애를 유발한다는 전제는 근거가 없으며, 모국어 사용 중단은 발달과 가족 관계에 해롭다.\",\"4\":\"이중언어 아동 평가에서는 역동적 평가가 규준 편향을 줄이는 핵심 자료이므로 참고자료로만 취급하는 것은 부적절하다.\",\"5\":\"한국어 노출 확대와 추적 관찰 등 지원 필요성이 있으므로 평가를 종료하고 무시하는 것은 부적절하다.\"}},\"1-2-1-58\":{\"w\":{\"1\":\"수어를 주 수단으로 먼저 확립하는 것은 청각구어법이 아니라 수어 중심 또는 이중언어-이중문화 접근이다.\",\"2\":\"그림 기반 AAC를 주 의사소통 수단으로 삼는 것은 청각을 통한 구어 습득을 최우선하는 원리와 맞지 않는다.\",\"3\":\"독순 중심의 시각 단서 제공은 청각구어법이 최소화하려는 방식으로, 오히려 청각 활용을 약화시킨다.\",\"5\":\"부모 참여 배제는 부모 코칭을 핵심으로 하는 청각구어법의 원리에 어긋난다.\"}},\"1-2-1-59\":{\"p\":\"현재 의사소통판은 명사 20개로만 구성되어 요구하기 기능에만 쓰이고, 상대도 주로 어머니로 제한되어 있다. '더, 아니야, 싫어, 다했어, 봐' 같은 핵심어휘를 추가하면 거부·언급·질문 등으로 기능이 넓어지고 상징 조합이 가능해지며, 상대가 상징을 짚으며 말하는 보조 언어 자극으로 입력 모델을 제공해야 한다. 이해가 연령 수준이므로 이러한 확장이 충분히 가능하다.\",\"w\":{\"2\":\"AAC는 구어 발달을 방해하지 않으며, 명료도가 매우 낮은 아동의 AAC 사용을 중단하면 의사소통 수단을 빼앗는 결과가 된다.\",\"3\":\"판을 구어 따라말하기 훈련 도구로 바꾸는 것은 AAC를 기능적 의사소통 수단이 아닌 조음 훈련으로 대체하는 잘못된 접근이다.\",\"4\":\"사용 상대와 상황을 어머니로 한정하면 의사소통 상대·환경의 확장을 오히려 막는다.\",\"5\":\"명사(부수어휘)만 늘리면 요구하기 이외의 기능이 확장되지 않는다.\"}},\"1-2-1-60\":{\"w\":{\"2\":\"사회적 의사소통의 기반(공동주의) 없이 낱말 따라말하기를 우선하면 기능적 의사소통으로 이어지기 어렵다.\",\"3\":\"반복 놀이는 즉시 소거할 대상이 아니라 아동의 관심을 활용해 놀이를 확장하는 출발점으로 삼는다.\",\"4\":\"'자폐 아동은 시각 학습자라 읽기가 빠르다'는 일반화는 근거가 약하며, 30개월 무발화 아동의 우선 목표로 문자 읽기는 부적절하다.\",\"5\":\"성인 지시 따르기(순응)는 언어 학습의 전제 조건이 아니며, 아동 주도의 사회적 상호작용 확립이 우선이다.\"}},\"1-2-1-61\":{\"w\":{\"1\":\"상황에 따라 일관되게 쓰이는 반향어는 의사소통 기능을 지니므로 무의미한 자기자극으로 보고 소거하는 것은 부적절하다.\",\"3\":\"반향어는 통째로 저장된 비생성적 발화이므로 이를 적절한 언어 수준의 증거로 볼 수 없다.\",\"4\":\"과거에 들은 말을 나중에 재현하므로 즉각 반향어가 아니며, 억제는 기능을 무시한 대처이다.\",\"5\":\"비생성적 문구를 더 암기시키는 것은 생성적 언어 발달이라는 중재 방향과 반대이다.\"}},\"1-2-1-62\":{\"p\":\"해독·유창성과 어휘는 정상이나, 단문을 '그리고'로만 잇고 원인-결과를 표현하지 못하며 관형절·종속 연결어미 사용이 거의 없는 것은 후기 구문과 설명담화 구조화의 결함이다. 교과 서술형 평가 점수가 낮은 것도 이를 반영한다. 따라서 교과 내용을 활용해 문장 결합(sentence combining)으로 복문 구문을 지도하고, 원인-결과 등 설명담화 구조를 도식 조직자로 지도하는 것이 가장 적절하다.\",\"w\":{\"1\":\"낱말 해독과 읽기 유창성은 학년 수준이므로 유창성 훈련은 핵심 결함을 겨냥하지 않는다.\",\"3\":\"어휘는 정상 범위이므로 어휘 목록 암기는 표적이 틀리다.\",\"4\":\"허구적 이야기(서사 담화) 다시 말하기는 교과 설명담화·복문 결함이라는 핵심 문제와 맞지 않는다.\",\"5\":\"음운인식 훈련은 해독 문제가 있을 때의 중재로, 해독이 정상인 이 아동에게는 불필요하다.\"}},\"1-2-1-63\":{\"w\":{\"1\":\"문장 수를 늘리는 것은 이야기 길이라는 양적 지표만 겨냥하며, 인과적 구조 결함을 해결하지 못한다.\",\"2\":\"새 낱말 추가는 어휘다양도라는 양적 지표에 초점을 두어 이야기 문법 구조 결함과 무관하다.\",\"3\":\"청각 기억 훈련은 이야기 구조 지식을 가르치지 않으며, 시각 지원을 제거해 오히려 과제를 어렵게 한다.\",\"5\":\"아동의 결함은 조음이 아니라 이야기 구조이므로 조음 훈련은 핵심 결함과 무관하다.\"}},\"1-2-1-64\":{\"p\":\"음절 수 세기·합성·분리는 90% 이상 정확하므로 음절 수준 음운인식은 완성되었으나, 초성 변별·분리가 20%로 음소 수준 인식이 부족하고 자모의 소리값을 모른다. 해독 습득에는 음소 인식과 자소-음소 대응 지식이 결정적이므로, 다음 단계인 음소 수준 인식을 글자-소리 대응과 통합하여 지도하는 것이 가장 효과적이다. 음운인식 훈련은 글자와 연계할 때 읽기 효과가 커진다.\",\"w\":{\"1\":\"음절 수준 인식은 이미 숙달되었으므로 계속 반복하는 것은 다음 발달 단계로의 진전을 막는다.\",\"2\":\"통문자 암기는 자소-음소 대응 원리를 우회하여 새로운 낱말을 해독하는 능력을 기르지 못한다.\",\"4\":\"음소 인식 지도를 초등 입학 후로 미루는 것은 읽기 준비 중재를 불필요하게 지연시키며, 자모 이름만으로는 해독이 되지 않는다.\",\"5\":\"어휘·구문은 연령 수준이므로 어휘 확장은 이 아동의 핵심 약점이 아니다.\"}},\"1-2-1-65\":{\"p\":\"빈칸 채우기(Completion), 회상(Recall), 개방형(Open-ended), wh-질문(Wh-), 경험 연결(Distancing)의 CROWD 질문으로 아동을 이야기의 능동적 화자로 만드는 것은 대화식 책읽기(dialogic reading)이다. 아동이 대답하면 칭찬(평가)하고, 문장으로 확장해 들려준 뒤 다시 말하게 하는 것은 PEER 절차(촉진-평가-확장-반복)에 해당한다. 따라서 대화식 책읽기 – 질문으로 아동이 이야기의 화자가 되게 한다가 옳다.\",\"w\":{\"1\":\"글을 정확히 끝까지 읽어 주는 것은 성인이 주도하는 수동적 읽어주기로, 아동의 참여를 핵심으로 하는 이 방법과 다르다.\",\"2\":\"질문을 최소화하는 반응적 상호작용은 CROWD 질문이 핵심인 이 접근과 반대이다.\",\"3\":\"스크립트 중재는 익숙한 일상 사건의 순서(각본)를 활용하는 방법으로 책읽기 질문 전략과 다르다.\",\"5\":\"청각적 집중 자극은 산출을 요구하지 않고 목표어를 반복 입력하는 기법으로, 질문과 따라 말하기로 산출을 유도하는 이 사례와 다르다.\"}},\"1-2-1-66\":{\"w\":{\"1\":\"과잉규칙화는 퇴행이 아니라 규칙 습득을 보여 주는 정상 발달 현상이므로 즉시 중재할 필요가 없다.\",\"3\":\"오류가 규칙 적용에 따른 체계적 형태이므로 청각 문제로 어미를 잘못 듣는 것으로 볼 근거가 없다.\",\"4\":\"'듣어요', '짓어요'는 성인 입력에 없는 형태이므로 모방으로 설명되지 않는다.\",\"5\":\"과잉규칙화는 처리 속도 저하의 징후가 아니며 작업기억 훈련이 필요한 근거가 없다.\"}},\"1-2-1-67\":{\"p\":\"비단어·문장 따라말하기 저조, 3단계 지시 중 첫 단계만 수행하나 한 단계씩 나누면 모두 수행, 빠른 말에서 이해 급락은 발달성 언어장애 아동의 제한된 처리 용량(음운 작업기억·처리 속도)을 반영한다. 정보처리 관점의 중재는 입력 속도를 늦추고, 정보를 작은 단위로 나누어 제시하며, 핵심어 강조와 시각 지원으로 처리 부담을 줄이면서 목표 언어 형식을 학습시키는 것이다. 한 단계씩 나누면 수행이 된다는 점이 이 원리의 직접적 근거이다.\",\"w\":{\"1\":\"언어와 분리된 숫자 거꾸로 외우기 등 기억 훈련은 언어 능력으로의 전이 효과가 제한적이다.\",\"3\":\"처리 부담을 고려하지 않고 긴 문장을 그대로 제시하면 아동의 처리 용량을 넘어서 학습이 일어나기 어렵다.\",\"4\":\"정보량·속도에 따라 이해가 달라지는 양상은 언어 처리 용량 문제를 시사하며, 주의력 문제로 단정할 근거가 없다.\",\"5\":\"같은 지시를 반복 연습시키는 것은 처리 용량 문제를 해결하지 못하며 순응 문제로 오해한 접근이다.\"}},\"1-2-1-68\":{\"p\":\"어휘·구문·조음은 정상이나 대화 시작, 주제 유지(자기 관심사 독점), 상대의 비언어적 반응 읽기에 어려움이 있고 치료실에서 배운 기술이 교실로 일반화되지 않는다. 화용 결함은 실제 상호작용 맥락에서 역할놀이·비디오 모델링으로 연습하고, 또래를 참여시켜 자연 환경(교실)으로의 일반화를 계획해야 효과가 있다. 따라서 역할놀이·비디오 모델링과 또래 참여로 교실 일반화를 계획하는 것이 가장 적절하다.\",\"w\":{\"1\":\"어휘·구문이 정상이므로 언어 형식 훈련은 화용 결함이라는 핵심 표적을 겨냥하지 않는다.\",\"2\":\"대화 규칙 설명과 문제집 정답 고르기는 지식 수준에 머물러 실제 대화로의 일반화가 어렵다.\",\"4\":\"조음이 정상이므로 조음 정확도 훈련은 표적이 틀리다.\",\"5\":\"관심사를 금지하기보다 상대 반응에 맞추어 주제를 조절하고 전환하도록 지도하는 것이 적절하다.\"}},\"1-2-1-69\":{\"w\":{\"1\":\"약점인 청각 기억에 긴 문장을 반복 제시하면 처리 부담만 커지고 강점인 시각 처리를 활용하지 못한다.\",\"2\":\"명료도가 낮아도 구어 가능성이 있으므로 구어를 중단하고 문자 소통으로 전환하는 것은 부적절하다.\",\"4\":\"표현(구문·문법형태소)이 가장 취약한 영역이므로 표현 중재를 생략하면 핵심 약점을 방치하게 된다.\",\"5\":\"시각 자료는 다운증후군 아동의 상대적 강점을 활용하는 수단으로 사용을 배제할 이유가 없다.\"}},\"1-2-1-70\":{\"p\":\"언어재활사가 담임교사와 매주 협의해 교과 핵심 어휘·개념을 목표로 삼고, 일부 회기는 교실 수업에 참여해 아동을 지원하며, 교사에게 언어 촉진 전략을 안내하는 것은 교실 중심(pull-in)·협력적 서비스 모델이다. 교육과정과 연계된 목표를 실제 교실 맥락에서 다루므로 학령기 아동의 실제 환경 일반화와 학업 성취를 촉진하는 것이 주요 장점이다. 직접 지원과 자문이 함께 이루어진다는 점이 핵심이다.\",\"w\":{\"1\":\"분리(pull-out) 모델은 아동을 교실 밖 치료실로 데려가 치료하는 방식으로, 교실 참여가 포함된 이 사례와 다르다.\",\"2\":\"의료 모델은 손상·원인 중심 접근으로 학교 서비스 전달 모델의 분류가 아니다.\",\"3\":\"언어재활사가 교실에서 아동을 직접 지원하는 서비스가 병행되므로 자문 모델만 적용한 것이 아니다.\",\"4\":\"비연속 개별시도는 교수 기법으로 서비스 전달 모델의 분류가 아니다.\"}},\"1-2-1-71\":{\"w\":{\"1\":\"말할 때까지 원하는 것을 주지 않는 것은 비윤리적이고 좌절만 유발하며 자연스러운 일반화 전략이 아니다.\",\"2\":\"치료실 정확도만으로 목표를 종결하면 실제 생활에서의 사용이 확보되지 않은 채 다음 목표로 넘어가게 된다.\",\"3\":\"치료실 과제의 정확도를 더 높여도 다른 환경으로의 일반화는 보장되지 않는다.\",\"4\":\"이미 치료실에서 습득된 기술이므로 목표를 재설정하고 같은 훈련을 반복하는 것은 불필요하다.\"}},\"1-2-1-72\":{\"p\":\"어머니 발화의 80%가 질문·지시이고, 아동의 놀이에 주목하지 않으며, 아동의 발성·몸짓 시작에 반응하는 비율이 낮고 놀이 주제가 자주 어긋나는 것은 성인 주도·저반응성 상호작용이다. 부모 매개 중재(Hanen 등)의 핵심은 아동 주도 따르기, 시작 행동에 즉각 반응하기, 행동·발성을 해석해 말로 들려주고 확장하기 같은 반응적 상호작용 전략이다. 따라서 이 전략들을 지도하는 것이 우선 목표이다.\",\"w\":{\"1\":\"소리·몸짓 같은 언어 이전 의사소통 시도를 무시하면 아동의 시작 행동이 오히려 줄어든다.\",\"2\":\"질문 횟수를 늘리는 것은 이미 과도한 성인 주도 상호작용을 강화한다.\",\"3\":\"그림카드 이름대기 훈련은 자연스러운 상호작용을 반복 훈련으로 대체하며 부모의 반응성 문제를 다루지 못한다.\",\"4\":\"어머니가 주제를 정해 이끄는 것은 성인 주도를 강화하여 아동의 관심과 어긋나는 문제를 악화시킨다.\"}},\"1-2-2-1\":{\"p\":\"명료도 향상과 빠른 성공을 최우선할 때는 발달적(전통적) 목표 선정 원칙에 따라 연령상 이미 습득되었어야 할 음, 사용 빈도가 높은 음, 자극반응도가 있는 음을 먼저 선택한다. /ㄱ, ㅋ/는 5세 2개월이면 습득되었어야 할 이른 발달음이고 모든 낱말 위치에서 대치되어 명료도 저하에 크게 기여하며 자극반응도도 있다. 따라서 세 조건을 모두 충족하는 /ㄱ/이 첫 목표음으로 가장 적절하다.\",\"w\":{\"1\":\"늦은 발달음을 먼저 훈련해 일반화를 노리는 것은 복잡성 접근의 논리로, 자극반응도가 없는 /ㅅ/은 명료도 향상과 빠른 성공이라는 이 사례의 목표와 맞지 않는다.\",\"2\":\"어중 /ㄹ/ 생략이 모든 위치에서 나타나는 연구개음 대치보다 명료도를 더 떨어뜨린다고 볼 근거가 없으며, 생략이 항상 대치보다 심각하다는 일반화도 성립하지 않는다.\",\"4\":\"여러 음소를 같은 비중으로 동시에 훈련하는 것은 우선순위 설정이라는 문항의 요구를 무시하며 치료 기간 단축의 근거도 없다.\",\"5\":\"비구어 구강운동 훈련은 말소리 산출 개선에 대한 근거가 부족하고 이 아동은 기질적 결함도 없다.\"}},\"1-2-2-2\":{\"p\":\"주기법(Hodson)은 명료도가 매우 낮은 아동에게 출현율 40% 이상의 음운패턴을 목표로 삼아 일정 기간씩 순환하는 방법이다. 각 패턴은 숙달이 아니라 출현(emergence)을 목표로 하며, 정해진 시간이 지나면 다음 패턴으로 넘어가고 다음 주기에서 다시 다룬다. 이 아동은 파열음화·종성생략·전방화·활음화가 40% 이상이므로 이 패턴들을 순환하는 것이 원리에 맞다.\",\"w\":{\"1\":\"주기법 회기는 청각 자극(auditory bombardment)과 산출 연습을 함께 포함하며, 산출 연습을 뒤로 미루지 않는다.\",\"2\":\"한 패턴을 90% 정확도까지 훈련하는 것은 숙달 기준(수직적) 접근으로, 시간 기준으로 순환하는 주기법의 원리와 반대이다.\",\"3\":\"어중초성 생략(15%)은 40% 기준에 미달해 목표 대상이 아니며, 우선순위 없이 균등 배분하는 것도 주기법의 목표 선정 원리가 아니다.\",\"5\":\"출현율이 가장 낮고 기준 미달인 패턴부터 시작하는 것은 주기법의 목표 선정 우선순위와 반대이다.\"}},\"1-2-2-3\":{\"w\":{\"1\":\"PCC 값은 맞으나 경도-중등도는 65~85% 구간이므로 58%의 중증도 판정이 틀렸다.\",\"2\":\"경도는 PCC 85% 초과에 해당하므로 58%를 경도로 본 것은 판정 오류이다.\",\"4\":\"42%는 대치·생략·왜곡을 합한 오류율(42/100)로, 정확률인 PCC와 혼동한 값이다.\",\"5\":\"61%는 왜곡 3개를 정조음으로 인정한 수정 자음정확도(PCC-R, 61/100)이며 원래 산출식의 값이 아니다.\"}},\"1-2-2-4\":{\"w\":{\"1\":\"최소대립쌍 치료는 일관된 오류패턴을 보이는 일관적 음운장애에 적합하며 비일관적 산출에는 효과가 제한적이다.\",\"2\":\"전통적 조음치료는 특정 음소의 운동적 산출 문제에 적합하나 이 아동은 대부분의 음소를 모방 산출할 수 있어 운동 확립이 핵심 문제가 아니다.\",\"3\":\"주기법은 일관된 음운패턴이 높은 출현율로 나타나는 아동에게 적용하며, 매번 형태가 달라지는 비일관적 산출에는 맞지 않는다.\",\"5\":\"DTTC는 모색행동·운율 이상·모음 오류를 보이는 아동기 말실행증의 접근인데 이 아동에게는 해당 징후가 없다.\"}},\"1-2-2-5\":{\"w\":{\"1\":\"음운지연은 발달적 음운패턴이 일관되게 나타나는 것으로 모색행동·모음 오류·운율 이상을 설명하지 못한다.\",\"3\":\"근력 저하·반사 이상이 없으므로 마비말장애가 아니며, 근력 강화 훈련은 근거도 부족하다.\",\"4\":\"조음장애는 특정 음소에 국한된 일관된 오류를 보이며, 모음 오류·비일관성·운율 이상을 동반하지 않는다.\",\"5\":\"비일관적 음운장애는 모색행동·운율 이상·모음 오류가 없고 모방 시 산출이 개선된다는 점에서 이 아동과 다르다.\"}},\"1-2-2-6\":{\"w\":{\"1\":\"자극반응도가 있는 음부터 빠른 성공을 노리는 것은 발달적(전통적) 목표 선정 원리로 복잡성 접근과 반대이다.\",\"2\":\"이른 발달음 우선은 전통적 발달 접근의 기준이며, 복잡성 접근은 오히려 늦은 발달음을 우선한다.\",\"3\":\"이 아동은 모음 문제가 보고되지 않았고, 모음 체계를 먼저 안정시키라는 원칙은 복잡성 접근에 없다.\",\"4\":\"오류 빈도가 가장 낮은 음소부터 훈련한다는 기준은 어떤 목표 선정 접근에서도 근거가 없다.\"}},\"1-2-2-7\":{\"p\":\"/ㅅ, ㅆ, ㅈ, ㅊ, ㄱ, ㅋ/ 여러 음소가 모두 [ㄷ] 하나로 붕괴(phoneme collapse)되어 살·잘·찰·갈이 모두 [달]이 되는 동음이의가 다수 발생하였다. 이처럼 하나의 대치음에 여러 목표음이 합쳐진 경우에는 대치음과 여러 목표음을 한 세트로 동시에 대조하는 다중대립 접근이 음운체계 재구조화에 가장 효율적이다.\",\"w\":{\"2\":\"최소대립쌍은 한 번에 한 쌍의 대조만 다루므로 여섯 음소가 한 음소로 붕괴된 광범위한 체계 문제에는 비효율적이다.\",\"3\":\"짝자극 기법은 이미 정조음하는 핵심낱말로 개별 음소의 정확한 산출을 전이시키는 운동적 접근으로 음소 붕괴 자체를 다루지 못한다.\",\"4\":\"전통적 조음치료는 한 음소의 조음 운동 확립에 초점을 두어 여러 음소의 대조 부재라는 음운적 문제를 직접 해결하지 못한다.\",\"5\":\"상위음운 접근은 소리 속성 인식을 기르는 방법이며, 길고 짧음 개념만 반복하는 것은 이 아동의 조음 위치·방법 대조 문제와 맞지 않는다.\"}},\"1-2-2-8\":{\"w\":{\"2\":\"빨기·불기 등 비구어 구강운동은 구강 내압이나 보상조음 교정에 효과가 입증되지 않았다.\",\"3\":\"성문파열음·인두마찰음은 정상 발달에서 나타나는 음운변동이 아니며, 6세까지 지속된 학습된 오류는 자연 소실을 기대하기 어렵다.\",\"4\":\"내시경과 나조미터에서 폐쇄 기능이 정상이므로 재수술을 의뢰할 근거가 없다.\",\"5\":\"비음치가 정상 범위이고 문제는 과비성이 아니라 조음 위치의 오류이므로 비음치 낮추기 훈련은 목표와 맞지 않는다.\"}},\"1-2-2-9\":{\"p\":\"구강문장 비음치 38%는 정상 기준(약 15% 이하)을 크게 초과하고, 대화 전반에서 일관된 과다비성과 압력자음 비강누출이 있으며, 단서를 주어도 변화가 없다. 보상조음 없이 조음 위치가 정확하다는 점도 기능적 문제보다 구조적 구개인두폐쇄부전(VPI)을 시사한다. 따라서 비인두내시경·비디오투시 등 기구 평가로 폐쇄 양상을 확인하고 인두피판술·구개거상장치 등 수술적·보철적 관리를 의뢰하는 것이 우선이다.\",\"w\":{\"1\":\"불기·빨기 훈련은 구개인두 폐쇄 기능 향상에 근거가 없으며 구조적 결함을 해결하지 못한다.\",\"2\":\"자극반응도가 없는 구조적 VPI에 청각 피드백 훈련을 장기간 실시하는 것은 효과가 없고 물리적 관리를 지연시킨다.\",\"3\":\"조음 위치가 정확한 아동의 과다비성은 조음 문제가 아니라 공명(구조) 문제이므로 조음치료로 교정할 수 없다.\",\"5\":\"구강문장 비음치 38%는 정상 기준을 크게 초과하므로 정상 범위라는 판단 자체가 틀렸다.\"}},\"1-2-2-10\":{\"w\":{\"1\":\"음소별 전통적 조음치료는 특정 음소의 오류에 적합하며 모든 음소에 걸친 신경운동성 왜곡에는 효율이 낮다.\",\"2\":\"최소대립쌍 치료는 음운 대조 결함을 다루는 음운적 접근으로, 운동 실행 문제인 마비말장애에는 맞지 않는다.\",\"4\":\"주기법은 기능적 음운장애 아동의 음운패턴을 다루는 방법으로 신경운동 결함에 기인한 오류를 해결하지 못한다.\",\"5\":\"비구어 근력강화 운동만으로는 말명료도 개선의 근거가 부족하며 호흡·말속도 등 핵심 요소를 다루지 못한다.\"}},\"1-2-2-11\":{\"w\":{\"1\":\"보청 상태가 양호하고 파열음·비음이 비교적 정확해 구어 발달 가능성이 있으므로 수어로 전면 전환할 근거가 없다.\",\"2\":\"보청 효과가 있는 아동에게 청각 단서를 배제하는 것은 인공와우 이식의 이점을 활용하지 못하는 계획이다.\",\"3\":\"이 아동의 오류는 청각적 입력 제한에 기인한 것이며, 비구어 구강운동은 말소리 개선에 근거가 부족하다.\",\"4\":\"청각장애로 인한 오류를 정상 발달 시기에 맞춰 보류하면 중재가 지연되며, 6세 아동의 마찰음 목표 보류는 근거가 없다.\"}},\"1-2-2-12\":{\"p\":\"혀를 내밀 때 혀끝이 하트 모양으로 패이고 치조에 닿지 않는 것은 설소대 단축증의 소견이다. 혀끝 접촉이 필요한 /ㄹ, ㄷ, ㄴ/에만 모든 문맥에서 일관된 왜곡이 나타나고 음운변동이 없으므로 구조적 원인에 따른 음성적(조음) 오류이다. 따라서 의학적 평가(설소대 절제술 여부)를 의뢰하면서 가능한 조음 위치를 확립하는 조음 훈련을 병행한다.\",\"w\":{\"1\":\"음운변동이 관찰되지 않고 특정 구조와 관련된 왜곡만 있으므로 음운체계의 문제가 아니다.\",\"3\":\"오류가 모든 문맥에서 일관되므로 비일관적 음운장애가 아니다.\",\"4\":\"/ㄹ, ㄷ, ㄴ/은 7세에 이미 습득되었어야 할 음소이고 구조적 원인이 있어 자연 개선을 기대하기 어렵다.\",\"5\":\"비구어 혀 스트레칭으로 설소대를 늘릴 수 있다는 근거가 없으며 의학적 평가 의뢰를 누락한 계획이다.\"}},\"1-2-2-13\":{\"w\":{\"1\":\"설압자로 조음 위치를 직접 지시하는 것은 전통적 조음치료의 운동 확립 기법으로 Metaphon의 1단계가 아니다.\",\"2\":\"1단계는 산출 정확도가 아니라 소리 속성에 대한 상위음운 인식을 기르는 단계이며, 90% 산출 준거 반복은 목적과 맞지 않는다.\",\"4\":\"핵심낱말과 훈련낱말을 번갈아 산출하는 것은 짝자극 기법의 절차이다.\",\"5\":\"구강운동으로 근력을 기르는 것은 Metaphon의 절차가 아니며 말소리 개선 근거도 부족하다.\"}},\"1-2-2-14\":{\"p\":\"낱말 92%, 구조화된 문장 85%로 구조화된 상황에서는 확립되었으나 자발 대화 40%, 가정에서도 오류가 대부분인 것은 전이(일반화) 단계의 문제이다. 아동이 자신의 오류를 알아채지 못하므로 자기 모니터링 훈련으로 스스로 오류를 탐지·수정하게 하고, 훈련 장면을 가정·학교 등 다양한 상대·장소·활동으로 확대하며 부모·교사를 통해 일상 속 단서와 강화를 제공해야 한다.\",\"w\":{\"1\":\"낱말 수준 92%로 조음 운동은 이미 확립되었으므로 무의미음절 수준으로 돌아갈 필요가 없다.\",\"2\":\"문제는 운동 능력이 아니라 일반화이며, 구강운동 훈련은 말소리 개선 근거도 부족하다.\",\"3\":\"자발 대화 정확도가 40%에 불과해 일상으로 전이되지 않았으므로 종결 기준을 충족하지 못한다.\",\"4\":\"/ㅅ/는 이미 구조화된 수준에서 확립되었으므로 목표를 보류하면 지금까지의 진전을 일반화로 연결하지 못한다.\"}},\"1-2-2-15\":{\"w\":{\"1\":\"'기' 문맥은 전설모음이 혀를 앞으로 끌어 전방화를 유도하는 가장 어려운 문맥이므로 확립 단계의 출발점으로 부적절하다.\",\"3\":\"확립 단계에서 문맥을 무작위로 제시하면 촉진 문맥의 이점을 잃고 성공률이 낮아진다.\",\"4\":\"아직 확립되지 않은 음을 문장 수준에서 바로 시작하면 오류가 많아 확립이 어렵다.\",\"5\":\"이 아동은 어두보다 어중에서 정조음 비율이 높으므로 어두 '가'가 촉진 문맥이 아니며, 지각적 두드러짐은 산출 촉진의 근거가 아니다.\"}},\"1-2-2-16\":{\"w\":{\"2\":\"핵심낱말은 오조음하는 낱말이 아니라 이미 정조음하는 낱말이어야 전이의 기준이 될 수 있다.\",\"3\":\"9회 이상 정조음 기준은 핵심낱말의 기준이며, 훈련낱말은 오조음하는 낱말로 선정한다.\",\"4\":\"짝자극 기법은 같은 목표음의 산출 전이를 이용하며 최소대립쌍과 같은 의미 대조를 요구하지 않는다.\",\"5\":\"핵심낱말과 훈련낱말은 같은 목표음을 포함해야 정확한 조음 운동이 전이된다.\"}},\"1-2-2-17\":{\"w\":{\"1\":\"'달-갈'은 치경과 연구개의 조음 위치 대조로 이 아동이 이미 확립한 자질이다.\",\"2\":\"'달-탈'은 평음과 격음의 기식성 대조로 이 아동의 결함 자질이 아니다.\",\"3\":\"'달-날'은 파열음과 비음의 비음성 대조로 이 아동의 오류와 관련이 없다.\",\"5\":\"'달-딸'은 평음과 경음의 긴장성 대조로 이 아동은 발성유형을 정확히 유지하고 있다.\"}},\"1-2-2-18\":{\"w\":{\"2\":\"주기법은 명료도가 낮고 여러 음운패턴이 높은 출현율로 나타나는 아동에게 적용하며 단일 음소군의 왜곡에는 맞지 않는다.\",\"3\":\"핵심어휘 접근은 비일관적 산출에 적용하나 이 아동의 오류는 모든 문맥·과제에서 일관된다.\",\"4\":\"최소대립쌍 치료는 음소 대조가 붕괴된 음운적 오류에 적용하며, 대조가 유지되는 왜곡에는 적합하지 않다.\",\"5\":\"이 아동은 청각 변별과 음운인식이 정상이어서 소리 속성 인식을 가르치는 상위음운 접근의 필요가 없다.\"}},\"1-2-2-19\":{\"p\":\"이중언어 아동의 말소리장애는 두 언어 모두에서 오류가 나타나고 모국어 음운체계로 설명되지 않을 때 판단한다. 이 아동은 통역사 평가에서 베트남어 산출이 또래 수준이고, 한국어 오류(경음·/ㅡ/·종성 /ㄹ/)가 모두 베트남어 음운체계에 없거나 다르게 실현되는 소리에 국한된다. 따라서 장애가 아니라 모국어 영향에 따른 언어 차이로 판단한다.\",\"w\":{\"1\":\"베트남어 산출이 정상이므로 두 언어 모두에서 치료가 필요한 장애라는 판단은 근거가 없다.\",\"3\":\"오류가 특정 소리에 일관되게 나타나고 모국어 체계로 설명되므로 비일관적 음운장애가 아니다.\",\"4\":\"모국어 사용 중단은 근거가 없으며 오히려 언어 발달과 가족 의사소통에 해롭다.\",\"5\":\"모색행동·운율 이상 등 말실행증 징후가 없고 모국어 산출이 정상이므로 말운동 평가를 추가할 근거가 없다.\"}},\"1-2-2-20\":{\"w\":{\"1\":\"명료도는 자음정확도와 관련은 있으나 청자·문맥 요인이 반영되는 별개의 지표이므로 따로 측정해야 한다.\",\"2\":\"어머니는 친숙한 청자로서 명료도를 과대평가하기 쉬우므로 가장 신뢰할 만한 지표로 볼 수 없다.\",\"3\":\"척도 평정(4점)과 낱말확인 백분율은 측정 방법이 다른 자료라 평균할 수 없으며, 약 70%라는 값은 두 결과를 혼합한 오류이다.\",\"4\":\"낱말확인 과제는 문맥 단서가 없어 오히려 순수한 말 신호의 명료도를 보여 주는 객관적 방법이다.\"}},\"1-2-2-21\":{\"p\":\"치료 효과를 성숙·자연 회복과 구분하려면 단일대상 연구의 논리에 따라 안정된 기초선을 확보하고, 훈련 음소(/ㄱ/)와 훈련하지 않은 통제 음소(/ㅅ/)를 탐침으로 반복 측정해야 한다. 훈련 음소의 급격한 향상과 통제 음소의 완만한 변화를 비교하면 변화가 중재 시작과 함께 훈련 대상에서만 나타났음을 보여 줄 수 있다.\",\"w\":{\"1\":\"회기 내 목표음 자료만으로는 비교 대상이 없어 성숙 효과와 치료 효과를 구분할 수 없다.\",\"3\":\"사후 표준화 검사 1회는 변화의 시점과 원인을 보여 주지 못해 인과 추론이 불가능하다.\",\"4\":\"기초선 1회 측정은 안정성을 확인할 수 없어 사전-사후 비교만으로는 성숙 효과를 배제하지 못한다.\",\"5\":\"부모 만족도와 가정 관찰 보고는 주관적 자료로 치료 효과를 실험적으로 입증하지 못한다.\"}},\"1-2-2-22\":{\"w\":{\"1\":\"이 아동은 초성이 대부분 정확하므로 초성 조음 위치 대조는 핵심 문제가 아니다.\",\"2\":\"4세 9개월에 종성 전면 생략은 이미 지연된 것이며 명료도 영향이 커서 목표 보류는 부적절하다.\",\"3\":\"종성 산출의 문제는 턱 근력이 아니라 음절구조 표상의 문제이며 비구어 구강운동은 근거가 부족하다.\",\"5\":\"종성 없는 낱말만 사용하면 가장 시급한 종성생략 문제를 다루지 못한다.\"}},\"1-2-2-23\":{\"p\":\"표준화 낱말 검사는 단일 낱말 정확도만 측정하므로 연결발화에서 나타나는 동시조음, 빠른 말속도, 발화 길이에 따른 붕괴를 놓칠 수 있다. 이 아동은 낱말 검사 88%(정상 범위)와 달리 대화 자음정확도 64%, 종성·어중초성 생략, 부모·교사의 명료도 문제 보고가 일치한다. 임상 결정은 여러 자료를 통합해 내려야 하므로 치료 대상으로 판정하고 연결발화 수준의 목표를 세운다.\",\"w\":{\"1\":\"표준화 점수 하나만으로 판정하면 자발화·명료도에서 드러난 실제 의사소통 문제를 놓친다.\",\"2\":\"부모·교사 보고는 일상 명료도를 반영하는 중요한 자료로, 자발화 분석 결과와도 일치하므로 배제할 이유가 없다.\",\"4\":\"다른 낱말 검사를 반복해도 단일 낱말 과제의 한계는 같아 연결발화 문제를 확인하지 못한다.\",\"5\":\"발화 길이에 따른 오류 증가는 말 산출 부담과 관련된 것으로 음운인식 결함이나 읽기 중재의 근거가 아니다.\"}},\"1-2-2-24\":{\"w\":{\"2\":\"0.625는 5 ÷ 8로, 정확히 산출한 종성 /ㅇ/의 자음 점수를 빠뜨린 값이다.\",\"3\":\"0.80은 목표 PMLU나 아동 PMLU 산출 규칙을 잘못 적용한 값으로, 정확한 산출식(6 ÷ 8)과 맞지 않는다.\",\"4\":\"0.875는 7 ÷ 8로, 아동의 [ㅌ](어두)을 목표 /ㅌ/과 같은 자음으로 잘못 인정하는 등 오류 자음 하나를 정확으로 계산한 값이다.\",\"5\":\"1.0은 분절음 수만 비교(5 ÷ 5)하고 자음 정확도 점수를 반영하지 않은 값이다.\"}},\"1-2-2-25\":{\"p\":\"요구하기는 한 번 습득되면 중재를 철회해도 사라지지 않는 비가역적 행동이고, 습득된 기술을 되돌리는 것은 윤리적으로 부적절하다. 대상자 간 중다기초선 설계는 여러 대상에게 시차를 두고 중재를 도입해 중재가 시작된 대상에서만 변화가 나타남을 보이므로, 철회 없이 실험적 통제를 입증할 수 있다. 대상 아동이 3명이라는 조건도 이 설계에 부합한다.\",\"w\":{\"2\":\"ABAB 설계는 중재를 철회해 기초선 수준으로의 복귀를 보여야 하므로 비가역적 행동과 윤리적 제약이 있는 이 상황에 부적합하다.\",\"3\":\"교대중재 설계는 둘 이상의 중재 효과를 비교할 때 사용하는데 이 사례는 한 가지 중재만 적용한다.\",\"4\":\"AB 설계는 반복 입증이 없어 실험적 통제를 확보하지 못하므로 효과를 입증하기에 부족하다.\",\"5\":\"기준변경 설계는 이미 레퍼토리에 있는 행동의 수준을 단계적으로 높일 때 사용하는 설계이다.\"}},\"1-2-2-26\":{\"w\":{\"1\":\"62.5%는 5/8로, 기초선 최고점을 초과하는 중재기 자료점 수를 잘못 센 값이다.\",\"2\":\"75.0%는 6/8로, 초과 자료점 7개 중 하나를 누락하는 등 비교 기준을 잘못 적용한 값이다.\",\"3\":\"100%는 기초선 최저점(20)이나 평균을 기준으로 삼아 중재기 모든 자료점을 비중복으로 계산한 값이다.\",\"5\":\"50.0%는 4/8로, 기초선 최고점 35가 아닌 더 높은 값을 기준으로 삼은 결과이다.\"}},\"1-2-2-27\":{\"w\":{\"1\":\"15%는 9 ÷ 60으로 불일치율을 계산한 값이며, 이를 근거로 재분석하는 판단도 틀렸다.\",\"2\":\"51%는 일치 발화 수(51개)를 백분율로 착각한 값이다.\",\"4\":\"일치율 계산은 맞으나 80% 이상이면 일반적으로 수용 가능하므로 90%에 못 미친다고 자료를 폐기하는 것은 과도한 조치이다.\",\"5\":\"567%는 51 ÷ 9로 일치 수를 불일치 수로 나눈 값이며 일치율 산출식이 아니다.\"}},\"1-2-2-28\":{\"w\":{\"2\":\"표현어휘 94가 수용어휘 76보다 높으므로 표현어휘가 더 낮다는 해석은 수치상 틀렸다.\",\"3\":\"76은 −1.6SD로 −1SD 이내가 아니며 지체 범위에 해당한다.\",\"4\":\"수용어휘 76은 정상 범위를 벗어나므로 두 영역 모두 정상이라는 판단은 틀렸다.\",\"5\":\"18점 차이는 1SD 이상으로 측정 오차 범위로 보기 어렵다.\"}},\"1-2-2-29\":{\"w\":{\"1\":\"치료 기회 확대라는 명분이 있어도 치료사 개인의 경제적 이익이 개입된 유인은 이해상충으로 윤리적 문제가 된다.\",\"2\":\"사후 보고로는 이미 발생한 이해상충과 환자 유인 행위가 해소되지 않는다.\",\"3\":\"이 사례의 핵심 쟁점은 비밀유지가 아니라 이해상충이므로 보호자 동의 여부로 허용되지 않는다.\",\"4\":\"자신의 센터로 유인하는 것은 전문성 유지 의무와 무관하며 이해상충에 해당한다.\"}},\"1-2-2-30\":{\"p\":\"반복되는 새로운 멍, 아동의 피해 진술, 보호자의 설명 불일치는 아동학대를 의심할 만한 정황이며, 아동학대는 의심만으로도 즉시 신고해야 한다. 언어재활사 등 재활·복지·의료기관 종사자는 신고의무자이므로 지체 없이 112에 신고하고, 관찰한 신체 소견과 아동의 말을 해석 없이 객관적으로 기록해 두어야 한다.\",\"w\":{\"1\":\"확증을 기다리며 신고를 미루면 아동이 추가 피해에 노출되며, 신고의무는 의심 단계에서 발생한다.\",\"2\":\"보호자에게 먼저 따져 물으면 증거 인멸이나 아동에 대한 보복 등 위험이 커지며, 인정 여부는 신고 요건이 아니다.\",\"3\":\"기관 내 보고는 수사기관 신고를 대신하지 못하므로 신고 의무를 다한 것이 아니다.\",\"5\":\"아동에게 반복 질문하면 2차 피해와 진술 오염을 초래하며, 진술 확보는 전문 조사기관의 역할이다.\"}},\"1-2-2-31\":{\"w\":{\"1\":\"보호자의 선호만 따르고 연구 근거와 임상 전문성을 배제한 대응으로 EBP에 어긋난다.\",\"2\":\"가족의 가치와 선호를 배제하는 것은 EBP의 세 요소 중 하나를 무시한 것이다.\",\"4\":\"근거 없는 요구가 있다는 이유만으로 종결하는 것은 설명과 공동 의사결정의 기회를 포기한 것이다.\",\"5\":\"개인 임상 경험만으로는 통제된 연구 근거를 대신할 수 없어 EBP의 기준을 충족하지 못한다.\"}},\"1-2-2-32\":{\"p\":\"SOAP에서 S(주관적)는 보호자·대상자의 보고, O(객관적)는 측정·관찰된 수행 자료, A(평가)는 자료에 대한 임상적 해석과 진전 판단, P(계획)는 이후 회기 계획이다. 어머니의 보고(㉠)는 S, 20개 중 14개(70%) 등 수치 자료(㉡)는 O, 지난 회기 대비 향상과 준거 미달 판단(㉢)은 A, 시간지연·놀이 상황 확장 계획(㉣)은 P에 해당한다.\",\"w\":{\"1\":\"어머니의 보고(㉠)는 관찰 자료가 아닌 주관적 정보이고, 수치 자료(㉡)는 객관적 자료이므로 ㉠ O, ㉡ S는 틀렸다.\",\"2\":\"수치 수행 자료(㉡)를 평가(A)로, 진전 판단(㉢)을 객관적 자료(O)로 분류하여 틀렸다.\",\"4\":\"보호자 보고(㉠)를 평가(A)로, 진전 판단(㉢)을 계획(P)으로, 다음 회기 계획(㉣)을 주관적 정보(S)로 잘못 분류하였다.\",\"5\":\"진전 판단(㉢)은 평가(A)이고 다음 회기 계획(㉣)은 계획(P)인데 둘을 서로 바꾸어 분류하였다.\"}},\"1-2-2-33\":{\"p\":\"모델 제공 조건에서 정반응률 95%로 반응은 습득되었으나 자발 산출이 거의 없는 것은 촉진 의존 상태이다. 시간지연 절차는 자극 제시 후 모델 제공까지의 대기 시간을 0초에서 2초, 4초로 점차 늘려 아동이 모델 전에 스스로 반응할 기회를 주며, 오류를 최소화하면서 자극 통제를 촉진에서 자연 자극으로 옮긴다.\",\"w\":{\"1\":\"완전 구어 모델을 계속 제공하면 촉진 의존이 유지되어 자발 산출로 이행하지 못한다.\",\"3\":\"신체적 촉진을 추가해 촉진 강도를 높이면 오히려 의존이 강화된다.\",\"4\":\"촉진을 한꺼번에 제거하면 오반응이 급증하고, 오반응을 무시하는 것은 체계적 촉진 소거가 아니다.\",\"5\":\"같은 자극을 반복 제시하는 것은 촉진 소거 원리에 해당하지 않으며 자발 산출을 유도하지 못한다.\"}},\"1-2-2-34\":{\"p\":\"각 목표를 정해진 기간(3회기) 동안 다루고 준거 도달 여부와 관계없이 다음 목표로 넘어가며 한 바퀴를 돈 뒤 첫 목표로 돌아오는 방식은 주기적(cyclical) 목표 공격 전략이다. 이는 여러 언어 형태가 한 번에 하나씩 완성되기보다 동시에 점진적으로 발달한다는 자연 습득 원리를 반영한다.\",\"w\":{\"2\":\"수직적 접근은 한 목표를 준거에 도달할 때까지 훈련한 뒤 다음으로 넘어가므로 준거와 무관하게 순환하는 이 계획과 다르다.\",\"3\":\"수평적 접근은 한 회기 안에서 여러 목표를 동시에 다루는 방식으로, 목표를 회기 단위로 번갈아 순환하는 이 계획과 다르다.\",\"4\":\"발달 순서대로 한 목표씩 준거까지 훈련하는 것은 수직적 성격의 계획으로 이 사례의 순환 방식과 맞지 않는다.\",\"5\":\"아동의 선호에 따라 목표를 고르는 선택적 접근은 표준적인 목표 공격 전략이 아니며 이 계획의 특징도 아니다.\"}},\"1-2-2-35\":{\"w\":{\"1\":\"낱말 수준 준거만 충족했고 일상 대화로 전이되지 않았으므로 즉시 종결은 시기상조이다.\",\"2\":\"낱말 수준은 이미 90% 이상 도달했으므로 처음부터 반복하는 것은 현재 문제인 일반화를 다루지 못한다.\",\"3\":\"일반화는 자연히 일어나지 않는 경우가 많아 계획적으로 프로그래밍해야 하며, 기다리기만 하면 오류가 고착될 수 있다.\",\"4\":\"/ㅅ/의 일반화가 완료되지 않은 상태에서 목표를 바꾸면 현재의 문제를 방치하게 된다.\"}},\"1-2-2-36\":{\"p\":\"또래에게 먼저 의사소통을 시작하는 행동은 시작과 끝이 분명한 이산 행동이며, 30분 동안 2~5회로 낮은 빈도로 나타난다. 이런 행동은 관찰 시간 중 발생 횟수를 세는 사건(빈도) 기록법이 가장 적합하며, 관찰 시간이 달라질 경우 분당 비율로 환산해 비교한다.\",\"w\":{\"1\":\"지속시간 기록법은 행동이 얼마나 오래 지속되는지가 목표일 때 사용하며, 시작하기의 횟수 변화를 반영하지 못한다.\",\"2\":\"영속적 산물 기록법은 활동 후 결과물이 남는 행동에 쓰며 의사소통 시작은 물리적 산물을 남기지 않는다.\",\"3\":\"부분간격 기록법은 고빈도이거나 시작과 끝이 불분명한 행동에 적합하며 저빈도 이산 행동의 실제 횟수를 왜곡할 수 있다.\",\"4\":\"지연시간 기록법은 지시 후 반응까지의 시간을 재는 방법인데 이 목표는 지시에 대한 반응이 아닌 자발적 시작이다.\"}},\"1-2-2-37\":{\"p\":\"치료실에서는 목표 문장을 잘 산출하지만 교실에서 사용하지 않는 일반화 문제와, 교사가 지원 방법을 모르는 상황이 핵심이다. 교실 기반 협력 모형은 실제 수업 맥락에서 목표를 다루고 교사를 코칭하여 교실에서의 의사소통 지원 역량을 높이므로 두 문제를 동시에 해결한다.\",\"w\":{\"1\":\"분리 치료 회기를 늘려도 치료실 밖으로의 일반화 문제는 해결되지 않는다.\",\"2\":\"보고서 전달만으로는 교사가 교실에서 구체적으로 지원하는 방법을 익히기 어렵다.\",\"3\":\"교과 학습지 풀이는 언어재활의 의사소통 목표가 아니며 교실 일반화에도 도움이 되지 않는다.\",\"5\":\"전일 특수학급 배치는 최소제한환경 원칙에 어긋나고 통합학급에서의 일반화 문제를 해결하지 못한다.\"}},\"1-2-2-38\":{\"p\":\"원격치료 전에는 대상자의 적합성(주의집중, 청각 환경, 기기 조작)을 평가하고(ㄱ), 보호자를 현장 보조자(e-helper)로 교육하며(ㄴ), 보안 플랫폼 사용과 녹화 사전 동의로 개인정보를 보호해야 한다(ㄷ). 원격치료에도 대면치료와 동일한 자격·윤리·서비스 질 기준이 적용되므로 ㄹ은 틀렸다. 따라서 ㄱ, ㄴ, ㄷ이 옳다.\",\"w\":{\"1\":\"ㄷ의 보안 플랫폼 사용과 녹화 동의는 원격치료의 필수 고려사항인데 누락되었다.\",\"3\":\"ㄹ은 틀린 진술이며 필수 사항인 ㄱ, ㄷ이 빠졌다.\",\"4\":\"원격치료에서 자격·윤리 기준이 완화된다는 ㄹ은 틀렸고 보조자 교육(ㄴ)이 빠졌다.\",\"5\":\"ㄹ은 틀린 진술이므로 모두 고른 조합은 옳지 않다.\"}},\"1-2-2-39\":{\"w\":{\"1\":\"감정이 고조된 상태에서 점수표로 논증하면 보호자의 방어가 더 강해진다.\",\"2\":\"진단 결과 설명을 생략하는 것은 보호자의 알 권리를 침해하고 이후 중재 결정을 어렵게 한다.\",\"3\":\"부정은 정상적인 반응이며 협조 거부로 보고 상담을 종료하면 라포 형성과 중재 기회를 잃는다.\",\"4\":\"경고성 발언은 죄책감과 방어를 자극하여 상담 관계를 악화시킨다.\"}},\"1-2-2-40\":{\"w\":{\"1\":\"진단 없이 음성치료를 시작하면 치료가 필요한 병변을 놓칠 수 있어 의뢰 원칙에 어긋난다.\",\"2\":\"3개월 이상 지속된 음성 문제를 경과 관찰만 하면 병변 발견이 늦어질 수 있다.\",\"3\":\"음성 문제를 조음치료로 대체하는 것은 문제의 성격과 맞지 않는 부적절한 중재이다.\",\"5\":\"약물 구입 안내는 언어재활사의 업무 범위를 벗어나며 원인 진단을 대신하지 못한다.\"}},\"1-2-2-41\":{\"p\":\"여러 전문가가 함께 관찰하는 아레나 평가, 한 명의 주 서비스 제공자가 다른 전문가에게서 훈련받은 전략을 대신 실행하는 역할방출(role release), 가정 일과 속 통합 중재는 초학문적 팀 모형의 핵심 특징이다. 이 모형은 가족이 만나는 전문가 수를 줄여 가족 부담을 낮춘다.\",\"w\":{\"1\":\"다학문적 팀은 각 전문가가 독립적으로 평가·중재하므로 공동 평가와 주 서비스 제공자 구조가 있는 이 사례와 다르다.\",\"3\":\"공동 평가와 역할방출은 다학문적 팀이 아니라 초학문적 팀의 특징이다.\",\"4\":\"간학문적 팀은 중재를 각 전문가가 따로 실행하는데 이 사례는 한 전문가가 통합적으로 실행한다.\",\"5\":\"이 사례에서 언어재활사는 평가에 함께 참여하고 전략을 훈련해 주므로 자문만 하는 구조가 아니다.\"}},\"1-2-2-42\":{\"w\":{\"2\":\"표준점수 등 수치 결과도 개인정보이므로 진단명만 뺀다고 동의 없이 제공할 수 있는 것은 아니다.\",\"3\":\"기관 공문은 정보주체의 동의를 대신하지 못한다.\",\"4\":\"사후 통보는 동의 없는 제3자 제공에 해당하여 비밀유지 의무 위반이다.\",\"5\":\"교육 목적이라도 보호자 동의 없는 제공은 허용되지 않으며, 전화로 제공하면 신원 확인도 어렵다.\"}},\"1-2-2-43\":{\"w\":{\"1\":\"자격증 대여는 보수교육 이수로 갈음되는 경미한 위반이 아니라 자격 취소 사유이다.\",\"2\":\"자격증 대여는 1회 위반이라도 경고로 그치지 않고 자격 취소 사유에 해당한다.\",\"4\":\"자격정지가 아니라 자격 취소 사유이므로 처분 범위를 잘못 제시하였다.\",\"5\":\"자격증을 대여한 원장 본인이 처분 대상이며 대여받은 직원도 함께 처벌 대상이 된다.\"}},\"1-2-2-44\":{\"w\":{\"1\":\"주 1회 방문도 어려운 가족에게 주 3회 방문은 실현 가능성이 낮고 가정 일과로의 일반화도 보장하지 못한다.\",\"3\":\"이해력이 정상이라도 표현 지연 아동을 무중재로 기다리면 모니터링과 촉진의 기회를 놓친다.\",\"4\":\"어린이집 등원만으로는 구조화된 언어촉진과 진전 점검이 이루어지지 않는다.\",\"5\":\"학습지 방식의 낱말 카드 학습은 영아의 자연스러운 상호작용 기반 언어 습득 원리에 맞지 않는다.\"}},\"1-2-2-45\":{\"w\":{\"1\":\"재신경화 징후가 있어 회복 가능성이 있으므로 비가역적인 영구 갑상성형술을 즉시 시행하는 것은 시기상조이다.\",\"2\":\"절대 음성휴식은 성문폐쇄부전 회복에 도움이 되지 않으며 보상적 발성을 학습할 기회를 잃게 한다.\",\"3\":\"보툴리눔 독소는 이미 마비된 성대의 내전을 더 약화시켜 성문틈과 흡인 위험을 악화시킨다.\",\"5\":\"재신경화 징후는 회복 가능성을 시사하는 예후 인자이며, 이를 무시하고 즉시 신경 재건술을 시행할 근거가 없다.\"}},\"1-2-2-46\":{\"w\":{\"2\":\"성대낭종은 대개 편측·국소적 점막하 병변으로 양측 전장의 광범위한 부종과 다르며, 원인 관리 없이 즉시 수술하는 것도 부적절하다.\",\"3\":\"진단은 맞으나 라인케부종은 점막 고유층의 액체 저류이므로 음도 훈련만으로 병변이 회복되지 않는다.\",\"4\":\"성대결절은 전1/3과 중1/3 경계의 국소적 대칭 병변으로, 전장에 걸친 광범위 부종과 다르다.\",\"5\":\"재발성 후두유두종은 사마귀 모양의 다발성 병변으로, 반투명 물주머니 모양 부종과 소견이 다르다.\"}},\"1-2-2-47\":{\"w\":{\"1\":\"스트로보스코피에서 명확한 구조적 병변이 확인되므로 심인성 음성장애로 볼 근거가 없다.\",\"2\":\"결절은 양측·대칭성이고 점막파동이 보존되며 음성치료에 반응하므로, 편측 병변이 치료에 반응하지 않는 이 사례와 다르다.\",\"3\":\"점막 아래 둥근 백색 병변과 점막파동 소실은 폴립보다 낭종의 소견이며, 약물 처방 안내는 언어재활사의 역할도 아니다.\",\"5\":\"우측은 반응성 부종으로 음성치료에 반응해 감소하고 있으므로 양측 동시 절제는 반흔·유착 위험만 높인다.\"}},\"1-2-2-48\":{\"w\":{\"1\":\"12반음은 주파수 비가 2배인 1옥타브에 해당하며, 이 대상자의 주파수 비는 4배이다.\",\"2\":\"18반음은 1.5옥타브로 주파수 비 약 2.83배에 해당하여 4배 비율과 맞지 않는다.\",\"3\":\"36반음은 3옥타브(주파수 비 8배)에 해당하는 값이다.\",\"4\":\"30반음은 2.5옥타브(주파수 비 약 5.66배)에 해당하는 값으로 계산이 틀렸다.\"}},\"1-2-2-49\":{\"w\":{\"1\":\"175 mL/s는 3,500 ÷ 20 s에 해당하는 값으로 MPT 7초로 계산하면 나올 수 없다.\",\"2\":\"250 mL/s는 3,500 ÷ 14 s의 값이며, 과내전은 호기류를 줄여 PQ를 낮추는 방향이다.\",\"3\":\"350 mL/s는 3,500 ÷ 10 s의 값으로 계산이 틀렸고 정상 범위(대략 120~200 mL/s)도 아니다.\",\"4\":\"수치는 맞으나 성대 과내전은 호기류가 줄어 PQ가 낮아지는 방향이므로 해석이 반대이다.\"}},\"1-2-2-50\":{\"w\":{\"1\":\"근긴장성 발성장애는 촉진 압통·후두 상승이 있고 음성치료에 반응하는데 이 사례는 둘 다 해당하지 않는다.\",\"2\":\"심인성 발성장애는 급성 발병과 정서적 사건 연관이 특징이며, 서서히 진행하고 음소 환경 특이적인 이 사례와 다르다.\",\"4\":\"본태성 음성진전은 규칙적인 율동성 떨림이 특징이며, 모음 시작 낱말에 국한된 불규칙 끊김과 다르다.\",\"5\":\"외전형은 무성자음 환경에서 기식성 끊김을 보이며 후윤상피열근이 표적인데, 이 사례는 모음 시작 낱말의 쥐어짜는 끊김이다.\"}},\"1-2-2-51\":{\"w\":{\"1\":\"내전형은 모음 시작 낱말에서 쥐어짜는 끊김을 보이며, 무성자음 환경의 기식성 끊김과 다르다.\",\"2\":\"외측윤상피열근은 내전근이며, 이 환자는 내전형이 아니라 외전형이다.\",\"4\":\"진단은 맞으나 갑상피열근은 내전근으로 내전형의 표적이며 외전형의 표적은 후윤상피열근이다.\",\"5\":\"근긴장성 발성장애는 특정 음소 환경에 국한된 끊김을 보이지 않으며, 윤상갑상근 이완 훈련은 보툴리눔 독소 표적이 아니다.\"}},\"1-2-2-52\":{\"w\":{\"1\":\"성대주입술은 성문을 더 좁혀 기도 폐쇄를 악화시키므로 금기이다.\",\"3\":\"밀기 접근법은 성대 내전을 강화해 이미 좁은 기도를 더 좁히므로 금기이다.\",\"4\":\"갑상성형술로 성대를 내측화하면 기도가 더 좁아져 호흡곤란이 악화된다.\",\"5\":\"보툴리눔 독소는 근긴장이상에 쓰는 것으로 마비된 성대의 위치를 바꾸어 성문을 넓히지 못한다.\"}},\"1-2-2-53\":{\"w\":{\"1\":\"발성이 되지 않고 공기가 저류되었으므로 검사를 통과한 것이 아니다.\",\"2\":\"공기주입검사는 PE분절의 진동 가능성을 보는 검사로 폐기능과 직접 관련이 없다.\",\"3\":\"TEP가 당장 어렵더라도 전기후두 등 대안 발성법은 여전히 사용할 수 있다.\",\"4\":\"저긴장 PE분절은 소리가 약하고 낮으며 젖은 음질로 나오는 양상으로, 조임감과 공기 저류를 보이는 이 결과와 반대이다.\"}},\"1-2-2-54\":{\"w\":{\"1\":\"원인 행동을 바꾸지 않은 수술은 재발 위험이 크고 아동 후두에 반흔을 남길 수 있어 일차 치료가 아니다.\",\"2\":\"절대 음성휴식은 아동에게 현실적으로 불가능하고 근본 원인인 발성 습관을 바꾸지 못한다.\",\"4\":\"속삭이기는 오히려 후두 긴장을 높여 성대 부담을 줄이지 못한다.\",\"5\":\"음성위생 교육만으로는 이미 형성된 습관적 발성 패턴을 바꾸기 어렵다.\"}},\"1-2-2-55\":{\"w\":{\"1\":\"근긴장성 발성장애의 촉진 소견은 제시되지 않았고, 역류를 시사하는 지표와 내시경 소견을 설명하지 못한다.\",\"3\":\"LPR은 속쓰림 없이 나타나는 경우가 많으므로 속쓰림이 없다는 이유로 역류를 배제할 수 없다.\",\"4\":\"내시경에서 결절 소견이 없으며 후두 후방의 발적·비후는 역류 소견이다.\",\"5\":\"알레르기를 시사하는 근거가 없고 RSI·RFS와 후두 후방 소견은 역류를 가리킨다.\"}},\"1-2-2-56\":{\"w\":{\"2\":\"워밍업은 편안한 음도에서 모음을 부드럽게 최대한 길게 연장하는 단계이며, 최고 음도의 강한 스타카토는 VFE 원리에 반한다.\",\"3\":\"VFE는 4단계를 각 2회씩 하루 2번 실시하는 프로토콜이다.\",\"4\":\"내전력 강화 단계도 부드러운 모음 연장으로 수행하며, 최대 강도로 고함치는 것은 성대에 충격을 준다.\",\"5\":\"스트레칭과 수축 단계는 부드러운 상행·하행 활음으로 구성되며 큰 소리 스타카토가 아니다.\"}},\"1-2-2-57\":{\"w\":{\"1\":\"악센트 기법은 복식호흡 리듬에 맞춘 강세 발성이 핵심이며 전방 공명 진동감을 중심으로 하지 않는다.\",\"2\":\"신뢰음성은 수술 직후 등 일시적 보호 목적의 작고 약간 기식적인 발성으로, 큰 소리를 요구하는 이 지시와 다르다.\",\"4\":\"밀기 접근법은 성문폐쇄부전 환자의 내전을 강화하는 기법으로, 성대결절 후 과기능 경향이 있는 환자에게 맞지 않는다.\",\"5\":\"챈트 말하기는 단조로운 연속 발성으로 긴장을 낮추는 기법이며 전방 진동감과 쉬운 큰 소리를 강조하지 않는다.\"}},\"1-2-2-58\":{\"w\":{\"1\":\"수술 직후 큰 소리 발성은 치유 중인 점막에 출혈과 반흔을 유발한다.\",\"2\":\"3개월간의 장기 절대 음성휴식은 근위축과 발성 회피를 초래한다.\",\"3\":\"속삭임은 후두 긴장을 높여 회복기 성대에 오히려 부담을 준다.\",\"5\":\"폴립의 원인인 음성 남용 습관이 남아 있으면 재발하므로 수술 후 음성치료가 필요하다.\"}},\"1-2-2-59\":{\"w\":{\"2\":\"접촉성 육아종은 원인을 교정하지 않고 재절제하면 다시 재발하므로 재절제는 최후 수단이다.\",\"3\":\"원인은 음성 남용만이 아니라 삽관 손상과 역류가 함께 작용하므로 음성휴식만으로는 부족하다.\",\"4\":\"유두종은 사마귀 모양의 다발성 병변으로, 성대돌기의 단일 육아종성 병변과 다르다.\",\"5\":\"병변 위치는 막성부가 아니라 연골부(성대돌기)이므로 성대결절이 아니다.\"}},\"1-2-2-60\":{\"w\":{\"1\":\"기관지확장제에 반응하지 않고 폐기능이 정상이므로 운동 유발 천식으로 보기 어렵다.\",\"3\":\"증상이 간헐적이고 휴식 시 소실되므로 성대가 고정된 양측 성대마비가 아니다.\",\"4\":\"문제는 흡기 시 기도의 역설적 내전이며 발성 시 연축이 아니므로 연축성발성장애가 아니다.\",\"5\":\"후두연화증은 흡기 시 성문상부 구조가 안으로 말려 들어가는 것으로 주로 영아에서 나타나며, 성대 자체의 내전 소견과 다르다.\"}},\"1-2-2-61\":{\"w\":{\"1\":\"가성대 발성은 낮고 거친 음질과 과긴장을 유발하는 비효율적 발성이므로 강화할 대상이 아니다.\",\"2\":\"기능적 문제에 침습적 처치를 첫 단계로 적용할 근거가 없으며 먼저 행동적 음성치료를 시행한다.\",\"3\":\"밀기 접근법은 내전을 강화해 성문상부 과기능을 더 악화시킨다.\",\"4\":\"가성대 자체에 구조적 이상이 없고 기능적 문제이므로 절제술을 의뢰할 근거가 없다.\"}},\"1-2-2-62\":{\"w\":{\"2\":\"점막파동을 판독할 수 없었던 것은 동기화 실패 때문이며, 관찰되지 않았다는 것을 반흔의 증거로 확진할 수 없다.\",\"3\":\"원인은 마이크 위치가 아니라 음성 신호 자체의 비주기성이므로 위치 조정으로 해결되지 않는다.\",\"4\":\"강도를 높여도 비주기성이 해소된다는 근거가 없고, 무리한 발성은 평가를 왜곡할 수 있다.\",\"5\":\"전기성문파형검사는 성대 접촉 면적 변화를 간접 측정할 뿐 점막파동을 직접 시각화하지 못한다.\"}},\"1-2-2-63\":{\"w\":{\"2\":\"F0 표준편차는 음도 변동을 반영할 뿐 기식성 음질의 중증도 지표가 아니며 역시 주기 검출에 의존한다.\",\"3\":\"NHR도 주기 검출을 전제로 하므로 비주기적 신호에서는 신뢰할 수 없다.\",\"4\":\"비주기 신호에서 jitter는 원리적으로 신뢰할 수 없으므로 반복 측정해 평균해도 타당한 값이 되지 않는다.\",\"5\":\"MPT는 공기역학적 지표로 음질의 음향적 중증도를 대체하지 못한다.\"}},\"1-2-2-64\":{\"w\":{\"1\":\"편측 성대마비는 호기류 증가와 성문하압 저하의 반대 양상을 보이며, 이 사례는 내시경상 병변이 없다.\",\"2\":\"연축성발성장애는 과제 특이적·불규칙 연축이 특징이며 촉진 소견이 정상인데 이 사례는 촉진 압통이 뚜렷하다.\",\"4\":\"심인성 실성증은 소리를 내지 못하는 상태로, 발성은 가능하나 과긴장을 보이는 이 사례와 다르다.\",\"5\":\"내시경에서 병변이 없으므로 라인케부종이 아니다.\"}},\"1-2-2-65\":{\"w\":{\"1\":\"천식 약을 환자 임의로 즉시 중단하게 하는 것은 천식 악화 위험이 있고 언어재활사의 권한 밖이다.\",\"2\":\"백색 반점은 감염성 병변이므로 음성 훈련으로 제거되지 않는다.\",\"3\":\"약물 사용력과 소견으로 칸디다증이 의심되는 상황에서 백반증으로 단정해 조직검사·절제부터 할 이유가 없다.\",\"5\":\"근병증에 의한 활모양은 약물 조정 후 회복되는 경우가 많아 밀기 접근법 집중 훈련은 우선순위가 아니다.\"}},\"1-2-2-66\":{\"w\":{\"1\":\"SOVT도 발성이므로 출혈 부위에 기계적 부하를 주어 급성기에는 금기이다.\",\"3\":\"밀기 접근법은 성대에 강한 충격을 주어 출혈을 악화시키므로 금기이다.\",\"4\":\"큰 소리 발성은 출혈을 확대시키며, 온찜질로 흡수를 촉진한다는 근거도 없다.\",\"5\":\"급성 출혈은 음성휴식으로 흡수되므로 즉시 수술하지 않으며, 수술은 재발성 출혈의 원인인 정맥류에 대해 고려한다.\"}},\"1-2-2-67\":{\"w\":{\"1\":\"내전형 연축성발성장애는 모음 시작 낱말 등 과제 특이적인 불규칙 끊김이 핵심이고 속삭임에서 감소하는데 이 사례는 그렇지 않다.\",\"3\":\"파킨슨병은 단조롭고 약한 음성과 안정 시 진전이 특징이며 규칙적인 음성 떨림이 핵심 증상이 아니다.\",\"4\":\"근긴장성 발성장애는 과긴장에 의한 음질 문제로, 규칙적 율동성 떨림과 손 떨림을 설명하지 못한다.\",\"5\":\"서서히 진행하는 규칙적 떨림과 손 떨림 동반은 신경학적 원인을 시사하므로 심인성으로 볼 근거가 없다.\"}},\"1-2-2-68\":{\"w\":{\"1\":\"커프가 팽창된 상태에서 밸브를 부착하면 호기가 빠져나가지 못해 공기가 갇히는 매우 위험한 상황이 된다.\",\"2\":\"상기도가 폐쇄되어 있으면 호기가 나갈 길이 없어 질식 위험이 있으므로 밸브 사용의 금기이다.\",\"3\":\"수면 중 착용은 일반적으로 금지되며, 처음부터 장시간 착용하지 않고 짧은 시간부터 점진적으로 늘린다.\",\"5\":\"과다한 분비물은 밸브 막힘과 흡인 위험을 높이므로 오히려 금기 요인이다.\"}},\"1-3-1-1\":{\"w\":{\"1\":\"괄호 안 합계의 변화량(29.5 − 22 = 7.5)만 구하고 마지막 ×2를 빠뜨렸을 때 나오는 값이다.\",\"2\":\"공식대로 계산한 치료 전 44.0점, 치료 후 59.0점의 차이인 15.0점과 맞지 않는다. 하위검사별 환산(÷20, ÷10)을 정확히 적용하면 이 값은 나오지 않는다.\",\"4\":\"실제 변화량 15.0점보다 크게 계산된 값으로, 하위검사 환산이나 합산 과정에서 오류가 생긴 결과이다.\",\"5\":\"올바른 변화량 15.0점에 ×2를 한 번 더 적용한 오류에서 나오는 값이다.\"}},\"1-3-1-2\":{\"w\":{\"1\":\"두 지표의 값을 서로 뒤바꾼 것이다. 60은 %CIU(90 ÷ 150 × 100), 45는 분당 CIU(90 ÷ 2)에 해당한다.\",\"3\":\"%CIU 60은 맞지만 분당 CIU 90개는 CIU 수를 발화 시간 2분으로 나누지 않은 값이다.\",\"4\":\"분당 CIU 45개는 맞지만 %CIU 75는 틀렸다. 75는 총 낱말 수를 발화 시간으로 나눈 분당 낱말 수(150 ÷ 2)이다.\",\"5\":\"분당 CIU 75개는 분당 낱말 수(WPM, 150 ÷ 2)와 혼동한 값이며, %CIU 40도 90 ÷ 150 × 100 = 60%와 맞지 않는다.\"}},\"1-3-1-3\":{\"w\":{\"2\":\"조사와 어미를 생략한 전보식 발화는 좌측 하전두회(브로카 영역) 손상에서 나타나는 특성으로, 우반구 후방 병소와 맞지 않는다.\",\"3\":\"음소착어와 선택적인 따라말하기 손상은 좌측 궁상다발 손상에 의한 전도실어증의 특성이다.\",\"4\":\"근력 저하 없는 조음 모색행동과 비교적 유창한 자동구어는 좌측 전운동영역·뇌섬엽 손상에 의한 말실행증의 특성이다.\",\"5\":\"글자를 하나씩 짚어 읽고 자신이 쓴 글을 다시 읽지 못하는 것은 좌측 후두엽·뇌량 팽대 손상에 의한 순수실독증의 특성이다.\"}},\"1-3-1-4\":{\"w\":{\"1\":\"전반실어증은 따라말하기도 심하게 손상되는데, 이 환자는 따라말하기가 82/100(8.2)으로 보존되어 있다.\",\"2\":\"브로카실어증은 비유창하지만 청각적 이해가 비교적 양호하고 따라말하기도 손상되는데, 이 환자는 알아듣기 3.2로 심하게 저하되고 따라말하기는 보존되어 있다.\",\"3\":\"베르니케실어증은 유창한 발화와 따라말하기 손상이 특징인데, 이 환자는 유창성 2점의 비유창 발화에 따라말하기가 보존되어 있다.\",\"4\":\"연결피질운동실어증도 따라말하기는 보존되지만 청각적 이해가 비교적 양호하다는 점에서, 알아듣기가 64/200으로 심하게 저하된 이 환자와 맞지 않는다.\"}},\"1-3-1-5\":{\"w\":{\"1\":\"멜로디억양치료는 비유창 실어증 환자의 구어 산출을 유도하는 방법으로, 문장 이해 결함을 표적으로 하지 않는다.\",\"2\":\"의미자질분석은 의미망을 활성화해 이름대기를 개선하는 방법으로, 행위자-대상 역할 할당의 문제를 다루지 못한다.\",\"3\":\"시각동작치료는 전반실어증 환자의 제스처를 통한 의사소통을 목적으로 하며, 가역 문장 이해의 결함과 무관하다.\",\"5\":\"의사소통효과증진법은 다양한 양식을 활용한 기능적 정보 교환 훈련으로, 통사 구조와 의미역의 대응을 직접 훈련하지 않는다.\"}},\"1-3-1-6\":{\"w\":{\"1\":\"쉬운 구조부터 훈련하는 전통적 난이도 위계 원리로, 복잡한 구조를 먼저 훈련한 지문의 계획과 정반대이다.\",\"3\":\"오류 없는 학습의 원리로, 복잡한 구조 훈련이 단순 구조로 일반화된 지문의 현상을 설명하지 못한다.\",\"4\":\"자동구어를 발판으로 명제적 발화를 이끌어 내는 원리로, 문장 구조 간 일반화와는 관계가 없다.\",\"5\":\"우반구의 운율 처리 능력을 활용하는 멜로디억양치료의 원리로, 통사 구조 훈련의 근거가 아니다.\"}},\"1-3-1-7\":{\"w\":{\"2\":\"A는 AMR이 정상이고 SMR에서 순서 오류·모색행동을 보여 실조형이 아니며, B의 느리고 규칙적인 AMR과 쥐어짜는 음성은 말실행증이 아닌 경직형의 특징이다.\",\"3\":\"A는 AMR 속도가 정상이어서 경직형이 아니고, B는 규칙적이어서 실조형이 아니며, C의 불규칙·폭발적 산출은 말실행증이 아닌 실조형의 특징이다.\",\"4\":\"A의 말실행증은 맞지만, B는 규칙적인 AMR·SMR을 보여 실조형이 아니고, C는 불규칙·폭발적 산출을 보여 느리고 약하며 기식 음성·과다비성을 보이는 이완형과 맞지 않는다.\",\"5\":\"A는 AMR이 정상이므로 AMR이 느리고 약한 이완형이 아니며, C의 불규칙하게 변동하는 AMR은 말실행증이 아닌 실조형의 특징이다.\"}},\"1-3-1-8\":{\"p\":\"회기 내 정확도는 90%까지 오르지만 다음 회기에 40%로 떨어지고 훈련하지 않은 낱말로의 전이가 거의 없다는 것은 습득은 되었으나 파지와 전이가 부족하다는 뜻이다. 운동학습 원리(Maas 등)에 따르면 현재 사용 중인 블록 연습과 매 시행 즉각 피드백은 회기 내 수행은 높이지만 파지·전이에는 불리하다. 무작위 연습, 분산 연습, 지연·저빈도의 결과지식(KR) 피드백은 학습자의 내적 오류 탐지와 문제 해결을 촉진하여 장기 파지와 일반화를 향상시킨다. 따라서 낱말을 무작위 순서로 연습하고 피드백을 지연·저빈도로 주도록 조정하는 것이 적절하다.\",\"w\":{\"1\":\"블록 연습을 유지하고 피드백을 더 늘리는 것은 회기 내 수행만 높이고 파지를 저해하는 현재 조건을 더 강화하는 것이다.\",\"2\":\"매 시행 즉각 피드백을 계속 제공하는 것은 지문에서 파지·전이 실패를 낳은 조건을 그대로 유지하는 것이다.\",\"3\":\"한 회기에 시행을 몰아서 하는 집중 연습은 습득 단계의 수행은 높여도 분산 연습에 비해 파지에 불리하다.\",\"4\":\"모든 시행에서 치료사의 모델에 의존하게 하면 회기 내 수행은 높아지지만 학습자가 스스로 오류를 탐지하고 수정할 기회가 줄어 파지에 불리하다.\"}},\"1-3-1-9\":{\"w\":{\"1\":\"리실버만음성치료로 음성 강도를 높이는 것은 파킨슨병에 의한 과소운동형 마비말장애의 중재로, 무도성 불수의 운동을 보이는 이 환자와 맞지 않는다.\",\"2\":\"실조형은 소뇌 손상에 의한 유형으로, 기저핵 퇴행으로 무도증을 보이는 헌팅턴병 환자의 유형이 아니다.\",\"4\":\"경직형은 양측 상부운동신경 손상에 의한 유형으로, 불수의 운동이 말에 침범된 이 환자의 양상과 맞지 않는다.\",\"5\":\"이완형은 근력 저하가 핵심인 유형인데, 이 환자는 근력 저하가 뚜렷하지 않아 저항 운동으로 근력을 강화할 근거가 없다.\"}},\"1-3-1-10\":{\"w\":{\"1\":\"경직형은 양측 상부운동신경 손상에 의한 유형으로, 말을 계속할수록 악화되고 휴식하면 회복되는 피로성 변동이 특징적이지 않다.\",\"2\":\"과소운동형은 기저핵 조절회로 이상에 의한 유형으로, 안검하수와 휴식 후 회복되는 피로성 약화를 설명하지 못한다.\",\"3\":\"실조형은 소뇌와 그 연결 경로 손상에 의한 유형으로, 지속 발화에 따른 과다비성·기식성의 점진적 악화와 회복 양상이 특징이 아니다.\",\"5\":\"편측 상부운동신경형은 일측 피질뇌간로 손상에 의한 유형으로, 피로성 변동이라는 이 환자의 핵심 소견과 맞지 않는다.\"}},\"1-3-1-11\":{\"w\":{\"2\":\"심층실독증은 의미착오 등 의미 경로를 통한 읽기 오류가 특징으로, 글자 하나씩 읽기와 낱말 길이 효과, 보존된 쓰기를 보이는 이 환자와 맞지 않는다.\",\"3\":\"표층실독증은 어휘 경로 손상으로 불규칙어를 소리 나는 대로 읽는 유형으로, 좌측 후대뇌동맥 경색과 우측 동측반맹을 동반한 이 환자의 양상과 다르다.\",\"4\":\"무시실독증은 우측 하두정소엽 손상으로 줄의 왼쪽을 빠뜨리는 읽기 오류로, 좌반구 후대뇌동맥 경색인 이 환자의 병소와 맞지 않는다.\",\"5\":\"각회 손상은 읽기와 쓰기가 모두 손상되는 실독·실서증을 일으키는데, 이 환자는 쓰기가 정상이다.\"}},\"1-3-1-12\":{\"p\":\"규칙어와 불규칙어('닭', '굳이', '넋')는 모두 정확하게 쓰지만 비단어('소딥', '가믄', '누텔')는 쓰지 못하거나 실제 낱말('소득')로 바꾸어 쓴다. 비단어는 음소-자소 변환, 곧 음운 경로를 거쳐야만 쓸 수 있으므로 이 경로가 선택적으로 손상된 것이다. 어휘 경로가 보존되어 불규칙어를 포함한 실제 낱말은 정확히 쓰고, 구체어-추상어 차이가 없으며 베껴 쓰기와 글자 형태도 정상이므로 음운실서증에 해당한다.\",\"w\":{\"1\":\"표층실서증은 어휘 경로가 손상되어 불규칙어를 소리 나는 대로('닭'→'닥') 쓰고 비단어는 잘 쓰는 유형으로, 이 환자와 반대 양상이다.\",\"2\":\"심층실서증은 비단어 쓰기 불가에 더해 의미착오('의자'→'책상')와 구체어-추상어 차이가 나타나는데, 이 환자는 구체어-추상어 차이가 뚜렷하지 않다.\",\"3\":\"실행실서증은 운동 프로그래밍의 문제로 글자 형태가 손상되는 유형인데, 이 환자는 글자 형태가 정상이다.\",\"4\":\"공간실서증은 시공간 처리의 문제로 글자 배열이 손상되는 유형인데, 이 환자는 베껴 쓰기와 글자 형태가 정상이다.\"}},\"1-3-1-13\":{\"p\":\"고혈압·당뇨라는 혈관 위험인자와 두 차례 소혈관 뇌졸중 병력이 있고, 인지 저하가 뇌졸중 시점마다 계단식으로 악화되었다. 처리속도와 실행기능이 초기부터 뚜렷하게 저하되었고, 지연회상은 낮으나 재인 단서를 주면 대부분 회상하므로 저장보다 인출의 결함이다. 보행 불안정과 배뇨 절박 같은 국소 신경학적 징후도 동반되어 혈관성 치매, 특히 피질하 소혈관성 치매의 전형적 특징을 보인다.\",\"w\":{\"1\":\"알츠하이머 치매는 서서히 진행하며 단서를 주어도 회상되지 않는 저장 결함이 특징으로, 계단식 악화와 단서 제공 시 회상 향상을 보이는 이 환자와 맞지 않는다.\",\"2\":\"루이소체 치매는 인지 변동, 시각환각, 파킨슨증이 두드러지는데, 지문에는 이러한 소견이 없다.\",\"4\":\"전두측두치매(특히 행동변이형)는 탈억제·무감동 등 행동 변화가 두드러지는데, 지문에는 행동 변화 대신 뇌졸중과 연관된 계단식 악화가 나타난다.\",\"5\":\"의미치매는 낱말 의미와 사물 지식의 상실이 두드러지는데, 이 환자의 핵심 문제는 처리속도·실행기능 저하와 인출 결함이다.\"}},\"1-3-1-14\":{\"w\":{\"1\":\"조사·어미를 생략하는 실문법증이 이 유형의 핵심 특징이므로 문법형태소 산출은 손상되는 영역이다.\",\"2\":\"모색행동과 비일관적 조음 오류는 말실행증을 시사하므로 조음의 순서화와 프로그래밍은 초기부터 손상되는 영역이다.\",\"3\":\"지문에서 피동문과 관계절이 포함된 문장의 이해가 이미 저하되어 있어 보존되는 능력이 아니다.\",\"5\":\"긴 문장 따라말하기는 통사 처리와 운동 프로그래밍의 부담이 커서 이 유형에서 손상된다.\"}},\"1-3-1-15\":{\"p\":\"수술 전 인지·언어 기능이 정상이었고 고관절 골절 수술 3일째에 급성으로 발병했으며, 밤에 심해지는 혼란과 대화 중 주의가 흐트러졌다 돌아오는 변동, 낮 동안의 졸림이 나타난다. '어제는 멀쩡했는데 오늘은 못 알아본다'는 보호자 보고도 하루 단위의 변동을 보여 준다. 이는 치매가 아닌 섬망의 핵심 특징으로, 감염·약물·대사 이상 등 급성 의학적 원인에 의한 가역적 상태이다. 따라서 언어재활사는 의료진에게 알리고 공식 평가는 원인 교정 후 안정된 상태에서 시행해야 한다.\",\"w\":{\"1\":\"알츠하이머 치매는 서서히 진행하는 질환으로, 수술 직후 급성 발병하고 하루 중 변동하는 이 환자의 양상과 맞지 않으며 기억 훈련을 시작할 시기도 아니다.\",\"3\":\"수술 전 언어 기능이 정상이었고 의식과 주의가 변동하는 상태이므로 베르니케실어증으로 판단할 근거가 없다.\",\"4\":\"주의력이 변동하는 상태에서 얻은 검사 결과는 실어증으로 잘못 해석될 수 있으므로 지금 공식 검사를 실시하는 것은 부적절하다.\",\"5\":\"우반구 손상을 시사하는 병력이 없고, 급성 의학적 원인에 의한 상태에서 대화 훈련을 시작하는 것은 순서가 맞지 않다.\"}},\"1-3-1-16\":{\"w\":{\"2\":\"복잡한 문제 해결 과제는 주의 지속이 수 분에 불과한 혼돈-초조 단계의 환자에게 과부하가 되어 초조를 악화시킨다.\",\"3\":\"긴 표준화 검사 배터리는 주의 지속이 짧고 자극에 과민한 이 시기의 환자에게 초조를 악화시킨다.\",\"4\":\"자극이 많은 그룹 활동은 소음과 낯선 사람에게 공격적으로 반응하는 이 환자의 초조를 악화시킨다.\",\"5\":\"공격 행동이 나타날 때 과제 난이도를 높이면 좌절과 공격성이 더 커진다.\"}},\"1-3-1-17\":{\"w\":{\"1\":\"반복적인 컴퓨터 자극 훈련은 이 환자의 핵심 문제인 계획 부족, 오류 인식 부재, 병식 결여를 직접 다루지 못한다.\",\"2\":\"기억은 비교적 보존되어 있어 외부 기억 보조 도구만 훈련하는 것은 주 표적에서 벗어난다.\",\"4\":\"이 환자에게는 오류를 경험하고 스스로 알아차리는 것 자체가 목표이므로 오류에 노출되지 않게 하는 오류 없는 학습은 적합하지 않다.\",\"5\":\"언어 능력은 비교적 보존되어 있어 통사 구조 훈련은 이 환자의 주 표적이 아니다.\"}},\"1-3-1-18\":{\"p\":\"감정적으로 중립인 문장을 다른 감정의 목소리로 들려주었을 때 감정 판별이 우연 수준이지만, 문장의 언어적 의미 이해는 정상이고 자신의 발화 억양과 감정 표현은 자연스럽다. 즉 감정 운율의 해석만 손상되고 산출은 보존된 수용성(감각성) 감정 운율장애이다. Ross의 모델에 따르면 수용성 감정 운율은 베르니케 영역의 우반구 상동 부위인 우측 측두두정이 담당한다.\",\"w\":{\"1\":\"표현성 감정 운율장애는 우반구 전방 손상으로 단조로운 억양 산출이 문제가 되는 유형인데, 이 환자는 운율 산출이 보존되어 있다.\",\"2\":\"좌측 하전두회 손상은 감정 운율보다 언어적 운율·문법적 강세와 관련되며, 이 환자는 우반구 뇌졸중 환자이다.\",\"3\":\"양측 기저핵 손상은 운율 산출의 단조로움을 일으키는데, 이 환자는 억양이 다양하고 감정 표현이 자연스럽다.\",\"4\":\"좌측 측두두정엽 손상은 감정 운율보다 언어적 운율과 관련되며, 이 환자는 언어적 의미 이해가 정상이다.\"}},\"1-3-1-19\":{\"w\":{\"1\":\"2점은 성대 위에 머문 침습이 배출된 경우로, 조영제가 진성대 아래까지 들어가고 배출 시도도 없는 이 소견과 맞지 않다.\",\"2\":\"3점은 성대 위에 머문 침습이 배출되지 않은 경우로, 진성대 아래로 들어간 흡인인 이 소견보다 낮은 단계이다.\",\"3\":\"5점은 성대에 닿았으나 성대 아래로 들어가지 않은 침습으로, 진성대 아래 기관으로 들어간 이 소견은 흡인 단계에 해당한다.\",\"4\":\"6점은 흡인 후 기도 밖으로 배출된 경우인데, 이 환자는 기침 등 배출 시도가 전혀 없었다.\"}},\"1-3-1-20\":{\"w\":{\"2\":\"마사코 기법은 혀 기저부-인두벽 접촉 문제에 적용하는 방법으로, 후두 거상과 상부식도괄약근 개방 부족을 직접 겨냥하지 않는다.\",\"3\":\"온도촉각자극법은 삼킴 반사 지연이 주된 문제일 때 적용하는 방법으로, 이 환자의 핵심 문제와 맞지 않는다.\",\"4\":\"노력삼킴은 혀 기저부-인두벽 접촉 문제에 적용하는 방법으로, 설골상근 강화를 통한 상부식도괄약근 개방 개선이 목적이 아니다.\",\"5\":\"턱 당기기는 자세 보상 기법으로, 근본적 기능 개선을 원하는 언어재활사의 목적에 맞지 않는다.\"}},\"1-3-1-21\":{\"w\":{\"1\":\"저작 곤란과 음식덩이 형성 실패는 구강기(피질, 하위 뇌신경 V·XII) 문제로, 구강기가 상대적으로 보존되는 외측 연수 경색의 양상과 맞지 않는다.\",\"3\":\"혀의 운동 저하로 구강 측면 고랑에 잔여물이 남는 것은 구강기 문제로, 이 환자에게 예상되는 핵심 소견이 아니다.\",\"4\":\"외측 연수 경색의 핵심은 인두기 삼킴장애이므로 인두기 문제 없이 식도기 정체만 관찰된다는 진술은 옳지 않다.\",\"5\":\"미주신경 손상 시 연구개 약화가 동반되므로 연구개 기능이 정상이라는 진술은 옳지 않다.\"}},\"1-3-1-22\":{\"w\":{\"1\":\"구강 준비기와 식도기를 관찰할 수 있는 것은 VFSS의 장점이며, FEES는 내시경으로 인두·후두를 위에서 내려다보므로 이 단계들을 직접 보지 못한다.\",\"2\":\"FEES는 삼킴 순간 인두 수축으로 화면이 하얗게 가려지는 백색 소실(white-out) 때문에 흡인의 순간을 직접 보지 못한다.\",\"4\":\"조영제를 이용해 음식물 이동 경로를 정량화하는 것은 VFSS의 장점이다.\",\"5\":\"후두 거상과 상부식도괄약근 개방 등 생리적 측정은 VFSS의 장점이다.\"}},\"1-3-1-23\":{\"w\":{\"1\":\"즉시 교정은 지문에서 배우자가 이미 하고 있는 행동으로, 환자의 대화 참여를 위축시키는 원인이 된다.\",\"2\":\"그림과 몸짓 사용을 삼가면 다중 양식 지원이 제한되어 SCA의 능력 드러내기 원리에 어긋나고 환자의 참여를 위축시킨다.\",\"3\":\"글자 쓰기를 막고 구어만 요구하는 것은 다중 양식 사용을 제한하여 환자의 표현 기회를 줄인다.\",\"5\":\"배우자가 대화를 주도하는 것은 지문에서 환자가 대화를 피하게 된 원인과 같으며, 환자의 참여를 더 위축시킨다.\"}},\"1-3-1-24\":{\"w\":{\"1\":\"에두르기 후 스스로 인출한 A를 음소 접근 행동으로, 음소를 바꾸며 접근한 B를 인출 지연으로 보아 오류 특성이 뒤바뀌었고, 의미 단서에 반응한 C에게 따라말하기는 맞지 않는다.\",\"3\":\"A는 스스로 목표 낱말을 인출했으므로 인출 실패가 아니고, B는 에두르기가 아닌 음소 접근 행동을 보였으며, C는 무반응 후 의미 단서에 반응했으므로 음소 접근 행동이 아니다.\",\"4\":\"지문에서 의미착어, 신조어, 반향어는 관찰되지 않았으며 A의 '쓰는 거'는 의미착어가 아닌 에두르기이다.\",\"5\":\"멜로디억양치료, 제약유발 언어치료, 시각동작치료는 각 환자의 이름대기 오류 유형에 맞춘 중재가 아니다.\"}},\"1-3-1-25\":{\"w\":{\"1\":\"㉠ '엄마 신발'은 현관에 놓인 엄마의 구두를 가리키며 한 말로, 엄마의 신발이라는 소유자–대상(소유) 관계이다.\",\"2\":\"㉡ '아빠 가'는 아빠가 문을 열고 나가는 것을 보며 한 말로, 행위하는 사람(아빠)과 행위(가)를 결합한 행위자–행위 관계이다.\",\"3\":\"㉢ '안 먹어'는 숟가락을 밀어내며 한 말로, 부정어(안)와 행위(먹어)를 결합한 부정–행위 관계이다.\",\"5\":\"㉤ '여기 앉아'는 의자를 두드리며 엄마를 부르는 맥락에서 장소(여기)와 행위(앉아)를 결합한 장소–행위 관계이다.\"}},\"1-3-1-26\":{\"w\":{\"1\":\"조사를 따로 세면 6 + 4 + 7 + 5 = 22낱말이고 발화 수가 4이므로 MLU-w는 22 ÷ 4 = 5.5이다. 조사를 앞말에 붙여 어절로 세더라도 평균어절길이(MLU-c)는 17 ÷ 4 = 4.25이므로 4.0이 아니다.\",\"2\":\"'친구랑', '형아랑'에는 공동의 부사격 조사, '블록으로'에는 도구의 부사격 조사가 사용되었다.\",\"4\":\"'만들었어'의 과거시제 선어말어미 '-었-'은 정확하게 산출되었으며 오류가 나타나지 않았다.\",\"5\":\"'못 만들었어'에서 부정 부사 '못'을 사용하였다.\"}},\"1-3-1-27\":{\"w\":{\"1\":\"셋째 문장의 대등절('울었고'/'토끼가 … 주었어요')을 분리하지 않아 T-unit을 4개로 세고, 24 ÷ 4 = 6.0으로 계산한 값이다.\",\"3\":\"T-unit 4개는 대등절을 분리하지 않은 잘못된 개수이며, 4.8은 5개로 나눈 값이므로 두 수치가 서로 맞지도 않는다.\",\"4\":\"T-unit 5개는 맞지만 6.0은 총 어절 수 24를 4로 나눈 값으로, 24 ÷ 5 = 4.8과 맞지 않는다.\",\"5\":\"종속절이나 인용절까지 별도 T-unit으로 분리하여 6개로 센 것으로, 종속절·인용절은 주절에 포함해야 한다는 조건에 어긋난다.\"}},\"1-3-1-28\":{\"w\":{\"2\":\"−1SD에 해당하는 표준점수는 85이므로 84는 −1SD보다 낮은 경계선 수준이며, 문제가 없다고 단정할 수 없다.\",\"3\":\"등가연령은 원점수가 해당 연령 평균과 같다는 뜻일 뿐, 아동의 언어 특성이 3세 2개월 아동과 동일하다는 의미가 아니다.\",\"4\":\"16점 차이는 약 1SD 이상의 차이로, 우연 범위로 무시할 수 없다.\",\"5\":\"백분위 2는 또래의 2%만이 이 아동보다 낮은 점수를 받는다는 뜻으로, 또래 98%보다 낮은 수행 수준이다.\"}},\"1-3-1-29\":{\"w\":{\"2\":\"주격 조사는 '동생이', '내가', '아빠가'처럼 모두 정확하게 산출되었다.\",\"3\":\"목적격 조사는 '우유를'처럼 정확하게 산출되었다.\",\"4\":\"과거시제 어미는 '놀았어요', '앉았어요', '왔어요'처럼 모두 정확하게 산출되었다.\",\"5\":\"종결어미 '-어요'는 모든 발화에서 정확하게 산출되었다.\"}},\"1-3-1-30\":{\"w\":{\"1\":\"주격 조사는 정확률 92%로 이미 숙달에 가까워 중재 목표로 부적절하다.\",\"3\":\"과거시제 선어말어미는 정확률 88%로 이미 90% 가까이 숙달되어 목표로 부적절하다.\",\"4\":\"연결어미 '-어서'는 정확률 5%로 아직 거의 출현하지 않은 형태여서 이후 단계에서 다룬다.\",\"5\":\"관형사형 어미는 정확률 0%로 아직 출현하지 않은 형태여서 이후 단계에서 다룬다.\"}},\"1-3-1-31\":{\"w\":{\"1\":\"교실 밖 타임아웃은 아동을 과제에서 벗어나게 하므로 회피 기능의 문제행동을 오히려 강화한다.\",\"2\":\"대체행동 없이 소거만 하면 문제행동이 일시적으로 증가(소거 폭발)할 수 있고 아동에게 의사소통 수단을 주지 못한다.\",\"3\":\"과제 완료 후 간식 강화는 문제행동의 회피 기능과 무관하여 행동의 원인을 다루지 못한다.\",\"4\":\"쓰기 과제를 완전히 제외하면 학습 기회를 박탈하고 문제행동의 기능도 다루지 못한다.\"}},\"1-3-1-32\":{\"p\":\"아동은 4회기에 걸쳐 햄버거 가게 스크립트(주문하기 → 돈 내기 → 햄버거 받기 → 먹기)의 사건 순서를 익혔다. 5회기에 치료사는 예상되는 단계인 햄버거 건네기를 빠뜨리고 빈 쟁반을 주었으며, 아동은 '햄버거 없어요. 햄버거 주세요.'라고 문제를 지적하고 요구하였다. 이처럼 익숙한 사건 순서를 의도적으로 어기는 스크립트 위반(사건 방해)은 아동이 맥락 지식을 바탕으로 자발적 요구 발화를 산출하도록 유도한다.\",\"w\":{\"2\":\"시간지연은 발화 유도 시 반응을 기다려 주는 환경중심 기법으로, 사건 순서를 어긴 이 장면의 절차와 다르다.\",\"3\":\"우발교수는 아동이 먼저 시작한 상호작용에 성인이 반응하는 절차인데, 이 장면은 치료사가 의도적으로 사건을 방해한 것이다.\",\"4\":\"역할 교대는 스크립트 중재의 다른 단계로, 이 장면에서 치료사는 여전히 점원 역할을 맡고 있다.\",\"5\":\"스크립트 소거는 단서를 점차 줄이는 다른 단계로, 예상 단계를 빠뜨려 요구를 유도한 이 장면의 절차가 아니다.\"}},\"1-3-1-33\":{\"w\":{\"1\":\"구어가 나올 때까지 기다리는 것은 의사소통 의도가 있으나 수단이 부족한 아동에게 AAC 도입 시기를 부당하게 늦추는 것이다.\",\"3\":\"AAC는 구어 자극과 병행하는 것이므로 그림판 도입과 함께 구어 중재를 중단하는 것은 옳지 않다.\",\"4\":\"AAC는 구어가 전혀 불가능한 아동에게만 적용하는 것이 아니며, 이 아동처럼 표현 수단이 부족한 아동에게 조기 도입이 권장된다.\",\"5\":\"지적장애 아동도 실물·사진 등 투명도 높은 상징부터 단계적으로 사용할 수 있으므로 상징 이해가 어렵다는 이유로 AAC를 미룰 근거가 없다.\"}},\"1-3-1-34\":{\"w\":{\"1\":\"아동의 수용·표현 어휘는 이미 또래 범위이므로 어휘 확장은 문법형태소 생략이라는 핵심 문제에서 초점이 어긋난다.\",\"2\":\"독화 훈련은 청각 활용을 우선하는 인공와우 착용 아동에게 시각 양식을 앞세우는 것이다.\",\"3\":\"내용어는 비교적 정확하게 산출하므로 조음이 아닌 형태소 사용의 문제이며, 조음 훈련은 부적절하다.\",\"5\":\"착용 역치가 어음역을 충분히 포함하고 청각 활용이 가능한 아동에게 수어로 전환하는 것은 시각 양식을 앞세우는 것이다.\"}},\"1-3-1-35\":{\"w\":{\"2\":\"어휘·구문이 또래 범위이고 조용한 환경에서 청각 활용이 양호하므로 수어 병행으로 전환할 근거가 없다.\",\"3\":\"중등도 난청은 보청기 적용 대상이며 인공와우 이식의 적응증이 아니다.\",\"4\":\"어휘·구문 등 언어 능력은 정상 범위이므로 언어치료 빈도를 늘리는 것은 소음 속 듣기 문제의 핵심 해결책이 아니다.\",\"5\":\"통합학급 수업을 보류하는 것은 교육 기회를 박탈하는 부적절한 조치이다.\"}},\"1-3-1-36\":{\"w\":{\"1\":\"언어연령에 맞춘 그림책 어휘 확장은 발달적 목표로, 17세의 생활연령과 직장 환경의 요구에 맞지 않는다.\",\"2\":\"복문 산출과 문법형태소 정확도는 언어연령 중심의 발달적 목표로, 도움 요청과 지시 확인이라는 기능적 요구를 다루지 못한다.\",\"4\":\"음운인식과 해독 훈련은 언어연령 중심의 학업적 목표로, 졸업 후 작업 환경에서 필요한 기술과 거리가 멀다.\",\"5\":\"표준화 언어검사의 반복은 평가일 뿐 중재 목표가 아니다.\"}},\"1-3-1-37\":{\"w\":{\"1\":\"한국어 한 언어의 점수만 단일언어 규준으로 판정한 오류로, 개념적 어휘가 정상 범위이므로 지체로 진단할 근거가 없다.\",\"2\":\"코드 혼용(부호 혼용)은 이중언어 아동의 정상적이고 규칙적인 현상으로, 언어 혼란의 징후가 아니다.\",\"3\":\"이중언어 아동에게 단일언어 규준을 각 언어에 그대로 적용하면 어휘가 분산된 특성 때문에 지체로 오판하게 된다.\",\"5\":\"언어장애라면 두 언어 모두에서 개념적 어휘를 포함한 전반적 결함이 나타나야 하는데, 이 아동은 개념적 어휘와 이해가 정상 범위이다.\"}},\"1-3-1-38\":{\"w\":{\"1\":\"자소–음소 대응과 비단어 읽기가 이미 확립된 상태여서 음운인식 훈련은 기초 기술의 중복 훈련이다.\",\"2\":\"총체적 언어 접근의 통독은 해독 자동화에 결함이 있는 아동에게 근거가 약하다.\",\"4\":\"읽기이해 저하는 느린 해독의 결과이므로 이해 전략 교수는 유창성이 확보된 뒤 병행할 목표이다.\",\"5\":\"자소–음소 대응 지식이 95%로 이미 확립되어 있어 체계적 재교수는 중복 훈련이다.\"}},\"1-3-1-39\":{\"p\":\"문장 수준 쓰기에서는 문법·철자 오류가 거의 없고 어휘도 또래 범위이며 읽기 이해도 정상이다. 반면 글쓰기에서는 계획 없이 바로 쓰기 시작해 떠오르는 문장을 나열하고, 문단 구분과 주제문이 없으며, 다 쓴 뒤 다시 읽지 않는다. 즉 글 수준의 계획·조직·점검이 부재하므로 쓰기 과정(계획–작성–수정) 전략과 그래픽 조직자(생각 그물, 개요표)를 활용한 담화 구조 지도가 적절하다.\",\"w\":{\"1\":\"받아쓰기를 통한 문장 정확도 향상은 이미 또래 수준인 문장 단위 기술을 반복하는 것으로, 텍스트 조직 결함을 다루지 못한다.\",\"2\":\"이 아동은 철자 오류가 거의 없으므로 철자 규칙 지도는 핵심 결함과 무관하다.\",\"3\":\"문장 결합 훈련은 문장 단위 기술로, 글 전체의 계획·조직·자기 점검 부재라는 핵심 문제를 다루지 못한다.\",\"4\":\"어휘가 이미 또래 범위이므로 어휘 확장은 텍스트 조직과 자기 점검의 결함을 다루지 못한다.\"}},\"1-3-1-40\":{\"w\":{\"2\":\"누가·언제·어디서를 묻는 사실적 이해는 이미 양호하므로 추론 결함을 다루지 못한다.\",\"3\":\"읽기 해독과 유창성이 또래 범위이므로 반복 읽기로 속도를 높이는 것은 초점이 어긋난다.\",\"4\":\"어휘가 또래 범위이므로 사전적 정의 찾기는 추론적 이해의 결함을 다루지 못한다.\",\"5\":\"순서대로 다시 말하기는 글에 나온 내용의 회상에 머물러 단서와 배경지식을 연결하는 추론 결함을 직접 다루지 못한다.\"}},\"1-3-1-41\":{\"w\":{\"1\":\"아동은 아직 상징놀이가 관찰되지 않는 감각운동적 놀이 수준이므로 역할놀이 대본을 이용한 대화 지도는 현재 수준을 크게 넘어선다.\",\"3\":\"상징놀이는 표상 능력을 반영해 초기 낱말 발달과 밀접히 관련되므로 놀이와 언어가 무관하다는 전제는 옳지 않다.\",\"4\":\"규칙이 있는 보드게임은 감각운동적 놀이 수준의 아동에게 현재 수준을 크게 넘어서는 목표이다.\",\"5\":\"또래와의 협동 놀이는 아직 상징놀이도 나타나지 않은 아동의 현재 놀이 수준을 크게 넘어서는 목표이다.\"}},\"1-3-1-42\":{\"w\":{\"1\":\"의사소통 빈도는 분당 5회로 이 연령대 기대 수준에 해당하므로 낮지 않다.\",\"2\":\"요구하기는 이미 85%를 차지하는 우세한 기능이므로 이를 정교화하는 것은 기능 편중이라는 핵심 문제를 해결하지 못한다.\",\"3\":\"거부하기는 12회로 이미 나타나고 있는 기능이므로 우선 목표가 아니다.\",\"4\":\"의문사 질문은 언급·공동주의 기능이 확립된 이후에 기대되는 발달 순서상 뒤의 목표이다.\"}},\"1-3-1-43\":{\"p\":\"아동은 언어성 지능이 정상이고 어휘·구문도 또래 범위이지만, 틀린 믿음 과제(위치 바꾸기)에서 실제 위치를 말하고, 넘어진 친구의 '진짜 좋다'는 반어를 문자 그대로 이해하며, 인물이 화난 이유를 설명하지 못한다. 이는 타인의 마음 상태를 표상하는 마음이론의 결함을 반영한다. 따라서 생각 풍선, 만화 대화 등 시각적 지원을 활용해 인물의 생각·믿음·감정과 화자의 의도를 명시적으로 추론하게 하는 중재가 적절하다.\",\"w\":{\"1\":\"어휘·구문은 이미 또래 범위이므로 복문 산출 훈련은 마음 상태 추론의 결함을 다루지 못한다.\",\"2\":\"비디오 자기모델링은 인사하기 같은 특정 행동 습득에는 유용하지만 타인의 생각과 감정을 추론하는 능력을 다루지 못한다.\",\"4\":\"음운인식 훈련은 이 아동의 문제와 무관한 영역으로, 마음이론 결함을 다루지 못한다.\",\"5\":\"감정 어휘를 정의와 함께 암기하는 것만으로는 맥락 속에서 상대의 마음을 추론하는 능력이 길러지지 않는다.\"}},\"1-3-1-44\":{\"w\":{\"1\":\"단순히 늦게 말하는 아동으로 보고 추적 관찰만 하는 것은 가리키기·보여주기 부재 등 사회적 의사소통 위험 신호를 간과한 것이다.\",\"2\":\"24개월까지 기다리라는 안내는 사회적 의사소통 위험 신호를 간과하고 조기 평가와 중재의 시기를 놓치게 한다.\",\"3\":\"공동주의와 모방 같은 전제 기술이 없는 상태에서 낱말 모방 훈련을 앞세우는 것은 순서가 맞지 않다.\",\"4\":\"청력 정상은 원인 하나를 배제할 뿐이며 언어·사회적 의사소통에 문제가 없음을 의미하지 않는다.\"}},\"1-3-1-45\":{\"w\":{\"1\":\"간식 시간이라는 상황은 제시되었으나 '잘하게 된다'는 관찰·측정할 수 없는 모호한 표현이고 준거도 없다.\",\"3\":\"'향상시킨다'는 관찰·측정할 수 없는 포괄적 진술로, 조건·행동·준거가 모두 불명확하다.\",\"4\":\"아동이 아닌 치료사의 행동을 진술한 것으로, 아동의 행동 목표가 아니다.\",\"5\":\"'이해한다'는 직접 관찰할 수 있는 행동이 아니어서 측정이 불가능하다.\"}},\"1-3-1-46\":{\"w\":{\"1\":\"밥·집·사람은 1층위 기본 어휘로, 초등학교 4학년 아동은 대부분 이미 습득하였다.\",\"2\":\"맷돌·다듬잇돌·절구는 특정 단원에만 국한된 저빈도 3층위 전문 어휘로, 교과 수업에서 다루는 것이 효율적이다.\",\"4\":\"이미 아는 낱말의 반복은 새로운 학습이 없어 제한된 회기에서 교과 학습 전반에 대한 효과가 작다.\",\"5\":\"관용어와 속담은 지문에 제시된 낱말군이 아니므로 근거가 없다.\"}},\"1-3-1-47\":{\"w\":{\"1\":\"가정 녹음에서 연령에 적절한 언어가 확인되므로 무반응으로 얻은 원점수 0을 표현언어 지체로 해석하는 것은 가정 자료와 모순된다.\",\"2\":\"가정에서 복문과 연령 적절한 어휘를 사용하므로 언어 능력의 결함인 발달성 언어장애로 판단할 근거가 없다.\",\"3\":\"발화를 강하게 요구하는 압박은 불안을 높여 증상을 악화시킨다.\",\"5\":\"상동행동·제한된 관심사가 없고 가정에서 상호작용이 활발하므로 자폐스펙트럼장애 평가를 우선할 근거가 부족하다.\"}},\"1-3-1-48\":{\"w\":{\"1\":\"이야기 문법 요소 회상률(z ≈ +0.3)과 완전한 일화 수(z = +0.1)가 평균 범위이므로 일화 구성은 우선 목표가 아니다.\",\"2\":\"문법형태소 오류율은 1.2%로 또래 평균 1.6%보다 낮아(z = −0.2) 양호하므로 우선 목표가 아니다.\",\"3\":\"T-unit당 비유창성률은 4%로 또래 평균과 같아(z = 0.0) 중재가 필요하지 않다.\",\"5\":\"T-unit 길이는 표에 제시되지 않은 지표이며, 구문이 또래 범위이므로 문장 확장은 우선 목표가 아니다.\"}},\"1-3-1-49\":{\"w\":{\"1\":\"a '저는 저는'(낱말전체 반복), b '음 (쉼)'(간투사·쉼), d '거기서 거기서'(구 반복)는 앞선 단위를 되풀이하거나 시간을 버는 지연(stalling) 유형만 모은 것이다.\",\"2\":\"c(음소 반복)와 e(연장)는 진행 유형이지만 a '저는 저는'은 낱말전체 반복으로 지연 유형에 해당한다.\",\"4\":\"f(막힘)는 진행 유형이지만 b(간투사·쉼)와 d(구 반복)는 계획이 준비될 때까지 시간을 버는 지연 유형이다.\",\"5\":\"c와 e는 진행 유형이지만 d '거기서 거기서'는 구 반복으로 지연 유형이며, 진행 유형인 f(막힘)가 빠져 있다.\"}},\"1-3-1-50\":{\"p\":\"제시된 결과는 뇌영상(우반구 운동·전운동 영역 과활성과 좌반구 청각 영역 활성 저하), 백질 구조(궁상다발 완전성 저하), 약물 반응(도파민 D2 길항제로 감소, 작용제로 악화), 유전(일란성 쌍생아 일치율이 더 높음)에 걸친 신경생리학적 근거이다. 이를 통합하면 좌반구 언어-운동 신경망의 취약성, 기저핵-시상-피질 회로의 도파민 과활성으로 인한 말운동 타이밍 문제, 유전적 소인이 함께 작용한다고 설명할 수 있다. 따라서 네 가지 결과를 모두 포괄하는 진술은 2번 보기이다.\",\"w\":{\"1\":\"진단착오이론의 설명으로, 뇌영상·백질·약물·쌍생아 자료처럼 생물학적 근거를 보여 주는 지문의 결과를 설명하지 못한다.\",\"3\":\"우반구 과활성은 좌반구 결함에 대한 보상적 활성으로 해석되므로, 이를 일차 원인으로 보고 억제 훈련을 근본 치료로 제시한 것은 틀렸다.\",\"4\":\"지문에서 도파민 작용제는 말더듬을 악화시켰고 감소 효과는 길항제에서 보고되었으므로, 도파민 결핍을 원인으로 보고 작용제를 권하는 것은 결과와 정반대이다.\",\"5\":\"내적수정가설의 설명으로, 운동 영역 과활성·백질 이상·도파민 반응처럼 말운동 신경망과 관련된 결과를 설명하지 못한다.\"}},\"1-3-1-51\":{\"p\":\"아동은 큰 개에게 쫓겨 크게 놀란 사건 직후 말더듬이 갑자기 시작되었고, 그 이전 말·언어발달은 정상이며 가족력도 없다. 처음부터 긴장된 막힘, 후두 긴장, 숨 참기가 나타나고, 말하기를 두려워하며 '말이 안 나와'라고 우는 것은 말더듬을 뚜렷이 인식하고 공포를 느끼고 있음을 보여 준다. 이는 놀람·외상 사건 후 갑작스럽게 시작되어 긴장된 막힘과 높은 인식, 공포·회피가 빠르게 발달하는 Van Riper의 경로 III에 해당한다.\",\"w\":{\"1\":\"경로 I은 가장 흔한 형태로 점진적 시작과 쉬운 반복이 특징이어서, 갑작스럽게 시작해 긴장된 막힘과 높은 인식을 보이는 이 아동과 맞지 않는다.\",\"2\":\"경로 II는 언어발달 지연과 속화 유사 양상이 특징인데, 이 아동은 이전 말·언어발달이 정상이었다.\",\"3\":\"경로 IV는 늦은 시작, 의도적·상동적 반복, 회피 결여가 특징이어서, 외상 직후 긴장된 막힘으로 시작해 말하기를 두려워하는 이 아동과 다르다.\",\"5\":\"경로 II의 특징을 잘못 기술한 보기이며, 이 아동은 긴장 없는 연장이 아니라 긴장된 막힘을 보이고 말더듬에 대한 인식도 뚜렷하다.\"}},\"1-3-1-52\":{\"w\":{\"1\":\"목표 음절 수는 비유창 부분을 뺀 의도 발화 기준 2+2+4+5+3+3+3+3+2+2+3 = 32음절이며, 41은 '---' 칸을 뺀 전체 칸 수와 혼동한 값이다.\",\"2\":\"단어부분 반복은 우우우리, 금금요일, 거거거거기서, ㅋㅋ커다란, 봤봤어요로 5회이고, 음소 반복 'ㅋㅋ커'를 따로 분류하더라도 4회이므로 3회가 될 수 없다.\",\"4\":\"비운율적 발성은 연장 1회(미---)와 막힘 2회(견, 공)를 합해 3회이므로 2회는 틀렸다.\",\"5\":\"진성 비유창성은 반복 5회와 비운율적 발성 3회를 합한 8회이므로 100음절당 8 ÷ 32 × 100 = 25회이다.\"}},\"1-3-1-53\":{\"w\":{\"2\":\"연기책(postponement)은 어려운 낱말 앞에서 시간을 끄는 행동으로, '(3초 쉼)진행하세요'의 1회만 해당한다.\",\"3\":\"도피(탈출)행동은 막힘에서 빠져나오기 위한 행동으로, 고개를 옆으로 홱 돌리기와 손으로 책상 치기의 2회이다.\",\"4\":\"대용어 사용은 '프레젠테이션'을 '발표 자료'로 바꾼 1회뿐이다.\",\"5\":\"상황 회피는 발표를 동료에게 부탁하는 1회로, 가장 많이 나타난 행동이 아니다.\"}},\"1-3-1-54\":{\"w\":{\"1\":\"진성 비유창성 3회는 맞지만, 기타 비유창성은 간투사 '어'와 구 반복 '갔다가 갔다가'의 2회이므로 3회는 틀렸다.\",\"2\":\"진성 비유창성은 막힘·음소 반복·연장의 3회이므로 4회는 틀렸다.\",\"3\":\"말속도 140 SPM은 맞지만 %SS 약 7.1은 말더듬 음절을 2개로 보고 2 ÷ 28 × 100으로 잘못 계산한 값이다.\",\"4\":\"%SS 약 10.7은 맞지만 말속도는 28음절 ÷ 12초 × 60 = 140 SPM이므로 120 SPM은 틀렸다.\"}},\"1-3-1-55\":{\"w\":{\"1\":\"a와 b는 기타 비유창성이지만 c '시---장'은 연장으로 비운율적 발성(진성 비유창성)에 해당한다.\",\"3\":\"b와 d는 기타 비유창성이지만 e '사 사 사'는 일음절 낱말 전체 반복으로 Yairi와 Ambrose의 분류 및 P-FA-II의 R2(비정상적 반복)에서 모두 진성 비유창성으로 분류된다.\",\"4\":\"a와 d는 기타 비유창성이지만 f '(막힘)너무'는 막힘으로 비운율적 발성(진성 비유창성)이다.\",\"5\":\"b만 기타 비유창성이고, c(연장)와 e(일음절 낱말 전체 반복)는 모두 진성 비유창성이다.\"}},\"1-3-1-56\":{\"w\":{\"1\":\"여아이고 가족력이 없으며 진성 비유창성이 감소 추세이고 음운발달도 정상이어서 자연회복 가능성이 높다.\",\"2\":\"삼촌의 말더듬은 자연회복된 회복형 가족력이고, 긴장 없는 음절 반복 위주에 인식이 없으므로 지속 위험이 낮다.\",\"3\":\"여아이고 가족력이 없으며 언어발달이 또래보다 앞서고 비유창성 빈도도 증가하지 않아 회복 가능성이 높다.\",\"5\":\"발병 2개월로 발병 직후이고 다음절 낱말 전체 반복 위주로 정상적 비유창성에 가까워, 직접치료보다 관찰이 우선이다.\"}},\"1-3-1-57\":{\"w\":{\"1\":\"ㄱ '부드럽게 잘 말했네!'는 유창한 발화를 칭찬하는 말로, 인정이 아니라 칭찬에 해당한다.\",\"2\":\"ㄴ '방금 말 부드러웠어?'는 유창한 발화 후 아동에게 스스로 평가하게 하는 말로 유창한 발화에 대한 자기평가 요청이며, 말더듬에는 자기평가 요청을 하지 않는다.\",\"4\":\"ㄹ은 말더듬 후 다시 말해 보게 하는 자기수정 요청이며, 말더듬에 대해서는 칭찬을 하지 않는다.\",\"5\":\"ㅁ '그렇지, 부드러운 말이야.'는 유창한 발화에 대한 인정이며, 유창한 발화에는 자기수정을 요청하지 않는다.\"}},\"1-3-1-58\":{\"w\":{\"1\":\"같은 4수준 질문을 반복하면 요구 수준이 그대로 유지되어 말더듬이 지속될 수 있다.\",\"2\":\"더듬은 상태에서 5수준으로 올리면 의사소통 요구가 더 높아져 조절 원리와 반대 방향이 된다.\",\"3\":\"사물만 바꾸고 같은 수준의 질문을 계속하면 요구 수준이 낮아지지 않아 말더듬이 지속될 수 있다.\",\"4\":\"말더듬 뒤 강화물을 주고 활동을 끝내는 것은 요구 수준을 조절해 유창성을 회복시키는 이 기법의 원리에 맞지 않는다.\"}},\"1-3-1-59\":{\"w\":{\"2\":\"이야기그림(ㄴ)은 초등학생의 필수과제이므로 중학생에게는 해당하지 않으며, 대화(ㄹ)는 중학생의 필수과제이다.\",\"3\":\"의사소통태도 평가는 초등학생 이상에게 실시하므로 중학생도 대상에 포함된다.\",\"4\":\"낱말그림과 따라말하기는 선택과제이므로 필수과제로 추가한다는 설명은 틀렸다.\",\"5\":\"읽기는 초등학생 이상 모두의 필수과제이므로 중학생에게도 실시해야 한다.\"}},\"1-3-1-60\":{\"p\":\"행동통제소 검사(LCB)는 점수가 높을수록 결과가 운이나 타인에 의해 결정된다고 믿는 외적 통제소재를 뜻한다. 대상자의 LCB가 42에서 24로 감소한 것은 말의 통제가 자신에게 있다고 느끼는 내적 통제감이 커진 긍정적 변화이다. 함께 제시된 %SS, OASES, PSI 기대 점수, S-24도 모두 감소하여 빈도·영향·예기·태도 전반에서 긍정적 변화가 나타났다.\",\"w\":{\"1\":\"OASES는 점수가 낮을수록 말더듬의 부정적 영향이 적으므로, 3.6에서 2.1로 감소한 것은 영향이 줄어든 것이다.\",\"3\":\"PSI 기대 점수가 15에서 5로 감소한 것은 말을 더듬을 것이라고 예상하는 상황이 줄었음을 뜻한다.\",\"4\":\"S-24 점수가 22에서 8로 감소한 것은 의사소통 태도가 긍정적으로 변했음을 뜻한다.\",\"5\":\"%SS가 14에서 3으로 크게 감소하였으므로 말더듬 빈도에 뚜렷한 변화가 있었다.\"}},\"1-3-1-61\":{\"p\":\"치료사는 대상자가 습관적으로 보이던 입술을 꽉 다문 막힘을 의도적으로 '바바바' 같은 가벼운 반복으로, 이어서 첫소리를 길게 늘이는 형태로 바꾸어 더듬어 보게 하고 있다. 이처럼 굳어진 말더듬 형태를 다른 형태로 바꾸어 보게 하여 말더듬이 고정된 반응이 아니라 스스로 변화시킬 수 있는 행동임을 경험하게 하는 것이 변형(variation) 단계이다. 지난주 녹화로 확인한 막힘 형태를 출발점으로 삼아 그 형태를 바꾸는 활동으로 나아간 점도 단서이다.\",\"w\":{\"1\":\"확인 단계는 자신의 말더듬 행동을 분석·기술하는 단계로, 막힘 형태를 의도적으로 바꾸어 보는 대화 속 활동과는 다르다.\",\"2\":\"둔감화 단계는 말더듬과 청자 반응에 대한 두려움을 줄이는 단계로, 말더듬 형태를 여러 가지로 바꾸어 보는 연습이 중심이 아니다.\",\"3\":\"접근 단계는 취소·빠져나오기·예비책으로 더 쉬운 말더듬을 배우는 단계로, 형태를 여러 가지로 바꾸어 보는 변형 단계와 구분된다.\",\"5\":\"안정화 단계는 자기치료와 재발 대비를 다루는 단계로, 말더듬 형태를 바꾸어 보는 연습과는 거리가 있다.\"}},\"1-3-1-62\":{\"p\":\"대상자는 파킨슨병 진단 8년째로, '먹었어요'처럼 낱말·구를 여러 번 반복하면서 반복할수록 속도가 빨라지고 목소리가 작아진다. 반복이 발화 끝부분에서도 나타나고 긴장·막힘·연장이 없으며, 불안이나 부수행동도 없다. 이는 기저핵 병변과 관련되어 낱말·구를 강박적으로 반복하며 가속과 음량 감소를 보이는 동어반복증(palilalia)의 특징이다.\",\"w\":{\"1\":\"발달성 말더듬은 아동기에 발병하고 긴장·부수행동을 동반하는데, 이 대상자는 파킨슨병 이후의 양상이며 긴장·부수행동이 없다.\",\"2\":\"신경인성 말더듬은 음소·음절 반복, 연장, 막힘이 낱말 위치와 무관하게 나타나는 것으로, 낱말·구 전체가 점점 빨라지고 작아지며 반복되는 이 양상과 구분된다.\",\"4\":\"심인성 말더듬은 심리적 외상 후 발생하고 기이한 양상을 보이는데, 지문에는 심리적 사건이 없고 파킨슨병이라는 신경학적 배경이 있다.\",\"5\":\"속화는 빠르고 불규칙한 말속도와 명료도 저하가 특징으로, 같은 낱말·구가 가속·감음되며 반복되는 현상을 설명하지 못한다.\"}},\"1-3-1-63\":{\"w\":{\"1\":\"학교 발표 상황의 높은 %SS와 회피가 남아 있어 전이가 완료되지 않았으므로 종결은 이르며, 추후 관리를 생략하는 것도 부적절하다.\",\"2\":\"치료실과 가정에서 이미 유창성이 확립되었으므로 프로그램을 처음부터 다시 실시하는 것은 불필요한 반복이다.\",\"3\":\"리드콤 프로그램은 학령전기 아동용 프로그램이므로 10세 아동에게 적절하지 않다.\",\"4\":\"발표 면제를 요청하면 이미 나타난 회피(자리 비움)를 오히려 강화하게 된다.\"}},\"1-3-1-64\":{\"w\":{\"2\":\"말더듬이 줄면 놀림이 해결된다는 잘못된 전제에 기반하며, 아동에게 유창성 압박을 높인다.\",\"3\":\"부모가 상대 부모에게 직접 항의하면 갈등이 커지고 아동이 스스로 문제를 해결해 보는 경험을 빼앗는다.\",\"4\":\"등교 중단은 회피를 강화하여 이미 나타난 위축과 등교 거부를 더 굳힐 수 있다.\",\"5\":\"어려운 낱말을 바꾸어 말하게 하는 것은 낱말 회피를 가르쳐 말더듬을 숨기게 만드는 부적절한 접근이다.\"}},\"1-3-1-65\":{\"p\":\"15세 대상자는 '엄마가 오라고 해서 왔어요'라며 스스로 원해 온 것이 아님을 밝히지만, 대화 %SS 9와 전화·발표 회피, 눈맞춤 회피가 관찰된다. 청소년 말더듬 치료는 본인의 동기와 참여가 성과를 좌우하므로, 첫 회기에는 본인이 말더듬의 영향을 인식하고 원하는 변화를 찾아 목표 설정에 참여하도록 돕는 동기 단계가 우선이다. 이때 비밀보장과 자율성 존중이 신뢰 관계의 기초가 된다.\",\"w\":{\"1\":\"어머니가 정한 목표로 곧바로 훈련을 시작하면 본인의 동기를 배제한 부모 중심 진행이 되어 참여를 이끌어 내기 어렵다.\",\"3\":\"동기 형성 자체를 치료의 일부로 보지 않은 잘못된 판단으로, 회피가 뚜렷한 대상자를 그대로 두게 된다.\",\"4\":\"리드콤 프로그램은 학령전기 아동용이며, 청소년 본인을 배제하고 부모 중심으로 진행하는 접근이다.\",\"5\":\"첫 회기에 준비 없이 낯선 사람에게 전화하게 하는 급격한 노출은 회피와 불안을 오히려 강화할 수 있다.\"}},\"1-3-1-66\":{\"p\":\"학생은 음절 축약('할머니가'→'함니가'), 잦은 낱말·구 반복과 수정을 보여 빠른 말속도에 따른 명료도 저하와 과도한 정상적 비유창성이 나타난다. 천천히 말하라고 하면 잠시 명료해지고, '다들 잘 알아듣는데요?'라며 자신의 말 문제를 잘 인식하지 못한다. 주의를 기울이면 나아지고 문제 인식이 낮은 것은 속화의 특징으로, 주의를 기울이거나 긴장할수록 심해지고 자신의 말더듬을 뚜렷이 인식하는 말더듬과 구별되는 근거이다.\",\"w\":{\"1\":\"막힘과 후두·입술 긴장은 말더듬의 특징이며, 이 학생에게서 보고되지 않았다.\",\"2\":\"어려운 낱말과 상황을 예상하고 피하는 회피는 말더듬을 인식하면서 발달하는 특징으로, 자신의 문제를 잘 인식하지 못하는 이 학생과 맞지 않는다.\",\"3\":\"눈 깜박임 같은 부수행동은 말더듬의 특징으로, 이 학생에게서 관찰되지 않았다.\",\"5\":\"예기 불안과 두려움은 말더듬을 뚜렷이 인식하는 화자에게 나타나는 특징으로, '다들 잘 알아듣는데요?'라고 말하는 이 학생과 반대된다.\"}},\"1-3-1-67\":{\"w\":{\"1\":\"250 ms 지연을 일상에서도 계속 사용하면 기기 의존이 고착되고 매우 느린 말이 그대로 유지된다.\",\"2\":\"지연을 더 늘리면 이미 매우 느린 말이 더 느려져 말의 자연스러움을 해친다.\",\"4\":\"단계적 전이 없이 기기를 즉시 제거하고 정상 속도로 말하게 하면 재발을 초래하기 쉽다.\",\"5\":\"차폐 소음 기기를 영구적으로 병행하는 것도 기기 의존을 고착시켜 기기 없는 말로 전이한다는 목표에 맞지 않는다.\"}},\"1-3-1-68\":{\"w\":{\"1\":\"유창성완성법만 적용하면 S-24 20점의 부정적 태도와 낱말·상황 회피를 다루지 못한다.\",\"2\":\"말더듬수정법만 적용하면 %SS 11의 빈번한 긴장된 막힘을 줄일 유창성 촉진 요소가 빠진다.\",\"3\":\"지연청각피드백 기기 단독 사용은 부정적 태도와 회피를 다루지 못한다.\",\"4\":\"리드콤 프로그램은 부모의 언어적 수반자극에 기반한 학령전기 프로그램으로 성인에게 적합하지 않다.\"}},\"1-3-1-69\":{\"w\":{\"2\":\"기타 비유창성 8회(간투사 5 + 구 반복 2 + 수정 1)는 원 빈도이며, 100음절당으로 환산하면 8 ÷ 300 × 100 ≈ 2.67회이다.\",\"3\":\"가중 SLD는 [(단어부분 반복 + 일음절 낱말 반복) × 평균 단위반복수 + 2 × 비운율적 발성] ÷ 총 음절 × 100 = [(12 × 1.75) + 12] ÷ 300 × 100 = 11이므로 6이 아니다.\",\"4\":\"평균 단위반복수는 총 단위반복수 18+3 = 21회를 반복 횟수 9+3 = 12회로 나눈 1.75회이다.\",\"5\":\"전체 비유창성 26회(진성 18 + 기타 8) 중 진성 비유창성의 비율은 18 ÷ 26 ≈ 69%로, 약 40%가 아니다.\"}},\"1-3-1-70\":{\"w\":{\"1\":\"ㄱ, ㄷ은 내적수정가설로 설명되지만 ㄴ은 부모의 부정적 반응에 대한 학습을 강조하는 진단착오이론·학습이론의 설명이다.\",\"2\":\"ㄷ은 내적수정가설에 해당하지만 ㄴ은 진단착오이론·학습이론, ㅁ은 예기투쟁가설의 설명이다.\",\"3\":\"ㄱ, ㄹ은 내적수정가설에 해당하지만 ㅁ '예상되는 말더듬을 피하려는 투쟁 반응'은 예기투쟁가설의 설명이다.\",\"5\":\"ㄷ, ㄹ은 내적수정가설에 해당하지만 ㅁ은 예기투쟁가설의 설명이며, 이 가설의 예측인 ㄱ이 빠져 있다.\"}},\"1-3-1-71\":{\"w\":{\"1\":\"발병 후 10개월이 지난 아동의 말더듬을 언어치료가 끝날 때까지 방치하게 된다.\",\"3\":\"복문 산출을 집중 훈련하면 언어적 요구가 급격히 높아져 비유창성을 악화시킨다.\",\"4\":\"부모의 언어 자극을 최소화하면 이미 낮은 언어발달을 더 저해한다.\",\"5\":\"리드콤 수반자극은 말더듬 여부에만 적용하는 것이 원칙이므로 언어 오류에 동일하게 적용하는 것은 틀렸다.\"}},\"1-3-1-72\":{\"w\":{\"2\":\"심인성 말더듬으로 보면 관찰되지 않는 상황에서 유창한 점과 소송이라는 이득 동기를 설명하지 못하며, 곧바로 종결하는 것도 부적절하다.\",\"3\":\"신경학적 검사가 정상이므로 신경인성 말더듬으로 판단할 근거가 없다.\",\"4\":\"아동기 말더듬 병력이 없으므로 발달성 말더듬으로 볼 수 없다.\",\"5\":\"빠른 말속도나 명료도 저하 같은 속화의 특징이 지문에 나타나지 않는다.\"}},\"1-3-2-1\":{\"w\":{\"1\":\"연장모음 지표만으로 정상 판정하면 연결발화에서 드러나는 음성 문제를 놓치는 위음성이 되며, 심리 상담을 의뢰할 근거도 없다.\",\"2\":\"CPPS는 연결발화에서도 산출할 수 있는 안정적 지표이고 문장의 청지각 중증도(62 mm)도 함께 높으므로, 이를 측정 오류로 보고 버릴 근거가 없다.\",\"4\":\"VHI-10은 통상 11점을 넘으면 비정상으로 보므로 26점은 정상 범위가 아니다.\",\"5\":\"서로 다른 과제의 값을 평균하여 판정하는 것은 근거가 없으며, 연결발화에서 두드러지는 문제를 희석하게 된다.\"}},\"1-3-2-2\":{\"w\":{\"2\":\"120 cmH₂O/(L/sec)라는 값은 맞지만 정상보다 높은 값이므로, '낮다'는 판단과 성문폐쇄부전이라는 해석은 방향이 반대이다.\",\"3\":\"기류율을 L/sec로 환산하지 않고 mL/sec 수치 그대로 나눈 값(12.0 ÷ 100)으로, 단위 환산이 틀렸다.\",\"4\":\"성문하압과 기류율을 곱한 값(12.0 × 100)으로 저항을 구하는 공식이 아니며, 높은 저항은 호흡 지지 부족이 아니라 성대 과내전을 시사한다.\",\"5\":\"분수 방향을 뒤집어 기류율을 성문하압으로 나눈 값(100 ÷ 12.0 ≈ 8.3)으로, 저항이 아니라 그 역수에 해당한다.\"}},\"1-3-2-3\":{\"w\":{\"1\":\"A는 기류율이 크게 증가하여 과내전이 아니라 성문폐쇄부전이고, B는 기류율이 낮고 성문하압이 높아 성문폐쇄부전이 아니라 과기능적 과내전이다.\",\"2\":\"폐활량이 정상인 A를 호흡 지지 부족으로, 기류율이 낮은 B를 성문폐쇄부전으로, 폐활량이 저하된 C를 과내전으로 연결하여 모두 틀렸다.\",\"3\":\"A의 성문폐쇄부전은 맞지만, 폐활량이 정상이고 성문하압이 높은 B는 호흡 지지 부족이 아니며, 성문하압이 낮고 폐활량이 저하된 C는 과내전이 아니라 호흡 지지 부족이다.\",\"5\":\"B의 과내전은 맞지만, 폐활량이 정상이고 기류율이 크게 증가한 A를 호흡 지지 부족으로, 기류율이 정상 범위이고 폐활량이 저하된 C를 성문폐쇄부전으로 잘못 연결하였다.\"}},\"1-3-2-4\":{\"w\":{\"1\":\"VHI-30은 일상 말하기 음성의 영향을 반영할 뿐이므로, SVHI 92점이 보여 주는 가창 핸디캡을 무시하고 치료를 종결하는 것은 잘못이다.\",\"3\":\"직업적 요구가 높은 가수에게는 청지각적으로 경미한 변화도 큰 기능 손실이 되므로 자기보고 결과를 과장으로 보아서는 안 된다.\",\"4\":\"SVHI는 청지각적 평가 도구가 아니라 자기보고 도구이므로, GRBAS와의 일치 여부로 타당성을 판단하는 것은 틀렸다.\",\"5\":\"VHI-30과 SVHI는 측정 영역(일상 말하기와 노래)이 달라 점수 불일치가 신뢰도 문제를 뜻하지 않는다.\"}},\"1-3-2-5\":{\"w\":{\"1\":\"밀기 기법은 이미 목·어깨에 힘을 주어 발성하는 과기능을 더 강화한다.\",\"2\":\"장기 절대 음성휴식은 근거가 없으며, 고유층 결손인 성대구증 병변을 회복시키지도 못한다.\",\"3\":\"보툴리눔 독소 주입은 연축성발성장애의 치료로, 성대구증 환자에게 적응증이 아니다.\",\"4\":\"제II형 갑상성형술은 성문을 넓히는 수술이므로 이미 성문틈이 있는 환자에게는 반대 방향의 처치이다.\"}},\"1-3-2-6\":{\"w\":{\"2\":\"제II형 갑상성형술은 성문을 넓히는 수술(연축성발성장애 등)이므로, 성문 폐쇄 부전이 문제인 이 환자에게는 반대 방향의 처치이다.\",\"3\":\"건측 성대의 보상적 과내전은 성문 폐쇄를 돕고 있으므로, 보툴리눔 독소로 이를 없애면 음성이 더 악화된다.\",\"4\":\"흡수성 주입은 회복이 기대되는 시기의 임시 처치인데, 이 환자는 14개월 경과와 재신경화 징후 부재로 자연 회복을 기대하기 어렵다.\",\"5\":\"양측 후윤상피열근 절제술은 존재하지 않는 표준 술식이며, 편측 마비의 성문 폐쇄 부전을 해결하는 방법도 아니다.\"}},\"1-3-2-7\":{\"w\":{\"1\":\"기능적 음성장애로는 혀 위축, 섬유속연축, 손의 미세운동 저하를 설명할 수 없다.\",\"2\":\"음성 과사용에 의한 근피로로는 혀 위축·섬유속연축·사지 근력 저하를 설명하지 못하며, 지문에서 휴식 후에도 증상 변화가 없다.\",\"4\":\"내전형 연축성발성장애는 과제 특이적인 긴장성 음성 단절이 특징으로, 진행성 기식 음성과 혀·사지 증상을 보이는 이 사례와 다르다.\",\"5\":\"후두내시경에서 마비 소견이 없으며, 진행성 신경근 질환에서 밀기 기법 같은 근력 강화 훈련은 피로를 가중시킬 수 있다.\"}},\"1-3-2-8\":{\"p\":\"상기도 감염 후 고음이 나오지 않고 음성범위프로파일의 최고 주파수가 1옥타브 이상 감소했지만, 양측 성대의 내·외전 운동은 정상 범위이다. 음도 활주 시 좌측 성대가 짧고 처지며 후방 성문이 좌측으로 회전하는 비대칭은 한쪽 윤상갑상근이 약해졌을 때의 특징적 소견이다. 윤상갑상근은 상후두신경 외지의 지배를 받아 성대를 늘여 음도를 높이므로, 좌측 상후두신경 외지 마비로 판단한다. 성대 내전 기능은 유지되므로 내측화 수술보다 회복을 기다리며 음도 확장 훈련·건측 보상 등 음성치료를 하는 것이 중심이다.\",\"w\":{\"1\":\"되돌이후두신경 마비는 성대 내전이 안 되는 것인데 이 환자는 내·외전 운동이 정상이므로, 제I형 갑상성형술 같은 내측화 수술의 적응증이 아니다.\",\"3\":\"변성발성장애는 음도 활주 시 좌측 성대가 짧고 처지는 신경학적 비대칭 소견을 설명하지 못한다.\",\"4\":\"근긴장성발성장애는 상기도 감염 후 나타난 한쪽 성대의 길이 비대칭 같은 신경학적 소견을 설명하지 못한다.\",\"5\":\"양측 성대마비는 내·외전 운동 자체가 소실되는데, 이 환자는 양측 성대의 내·외전 운동이 정상 범위이다.\"}},\"1-3-2-9\":{\"w\":{\"1\":\"식도발성은 습득에 오랜 시간이 걸려 당장의 의사소통 대안이 되지 못한다.\",\"2\":\"진동 강도를 최대로 높여 목에 세게 누르면 조직 손상과 통증을 유발할 수 있다.\",\"3\":\"모든 무후두 발성 훈련을 1년 뒤로 미루면 의사소통 단절 기간이 길어진다.\",\"5\":\"기관식도천공 발성은 공기주입검사 등 별도의 적응 평가가 필요하므로 이 시점의 즉각적 해결책이 아니다.\"}},\"1-3-2-10\":{\"w\":{\"1\":\"천공 확대는 보철 둘레 누출의 원인인데, 이 사례는 주변 누출이 없고 가운데 구멍으로 새고 있다. 또한 둘레 누출이라도 더 큰 지름이 아니라 작은 지름·조직 수축 조치가 필요하다.\",\"2\":\"발성이 이전과 같이 잘 되므로 인두식도분절 경직은 원인이 아니다.\",\"3\":\"2년간 잘 작동해 온 TEP를 폐쇄할 이유가 없으며, 문제는 보철 교체로 해결할 수 있다.\",\"4\":\"보철 위치 이상을 시사하는 소견이 없고, 기공 폐쇄나 발성 연습은 밸브를 통한 흡인 위험을 해결하지 못한다.\"}},\"1-3-2-11\":{\"w\":{\"1\":\"비음 문장 비성치가 낮고 비음 공명도 약해 전형적 과다비성이 아니며, 비강 폐쇄로 과다비성이 과소평가될 수 있으므로 평가 없이 즉시 수술을 의뢰하는 것은 이르다.\",\"3\":\"구강음 문장의 높은 비성치(36 %), 모음 과다비성, 비강 난기류는 과소비성 단독으로 설명되지 않는다.\",\"4\":\"구강음 문장 비성치는 정상 상한을 크게 넘고 비음 문장 비성치는 정상보다 낮으므로 두 값 모두 정상 범위가 아니다.\",\"5\":\"과다비성과 비강 난기류는 연인두 폐쇄부전을 시사하므로 연인두 폐쇄가 정상이라는 전제가 틀렸고, 부는 연습은 연인두 폐쇄부전을 개선하지 못한다.\"}},\"1-3-2-12\":{\"w\":{\"2\":\"근긴장성발성장애는 음성치료에 반응하는 경우가 많고 이처럼 과제 특이적인 단절 양상을 보이지 않으므로, 6개월간 변화가 없던 치료를 그대로 이어가는 것은 부적절하다.\",\"3\":\"외전형 연축성발성장애는 무성자음이 많은 문장에서 숨이 새는 단절이 특징으로, 유성음 문장에서 쥐어짜는 단절을 보이는 이 환자와 반대 양상이다.\",\"4\":\"심인성 실성증은 대개 갑자기 시작되어 속삭임 음성이 지속되는 양상으로, 말하기에서만 쥐어짜는 단절이 나타나는 이 환자와 맞지 않는다.\",\"5\":\"이 환자의 문제는 성대 운동 저하가 아니라 과내전이므로 내측화 수술인 제I형 갑상성형술은 적응증이 아니다.\"}},\"1-3-2-13\":{\"p\":\"유치원 교사는 소음이 큰 교실에서 하루 6시간 이상 발화하며, 오후마다 쉰 목소리와 목 통증이 있고 주말이면 회복된다. 후두내시경의 경미한 발적·부종과 결절이 없는 소견은 직업적 음성 과사용의 초기 단계로, 음성 부하량을 낮추는 환경·행동 조정이 핵심이다. 확성기는 소음 환경에서 강도를 높이지 않고도 전달을 가능하게 해 부하를 실질적으로 줄이며, 짧고 잦은 휴식·소음 감소·수분 섭취와 함께 쓰면 음성 사용을 줄이기 어려운 현실에도 적용할 수 있다.\",\"w\":{\"1\":\"속삭임은 성대 접촉을 줄이는 듯 보이나 성대에 오히려 긴장을 주어 해롭다.\",\"2\":\"멘톨과 카페인은 점막을 건조하게 하므로 목을 푸는 방법으로 적절하지 않다.\",\"4\":\"장기 절대 음성휴식은 근거가 없고, 음성 사용을 줄이기 어려운 직업적 상황에서 비현실적이다.\",\"5\":\"큰 소리 훈련은 음성 부하를 더 늘려 초기 부종을 병변으로 진행시킬 위험이 있다.\"}},\"1-3-2-14\":{\"p\":\"대상자는 말할 때 어깨가 들리는 얕은 쇄골호흡과 짧은 구절 단위의 잦은 호흡, MPT 8초를 보여 호흡 지지가 부족하다. 그 결과 음성이 약하고 기식적이며, 리듬과 억양 변화가 거의 없는 단조로운 말이 나타난다. 악센트 기법은 복식(횡격막)호흡을 기반으로 느린 템포부터 빠른 템포까지 리듬적 강세를 주며 발성하여 호흡-발성-조음의 협응을 개선하고 음성의 역동성을 높이므로, 이 대상자의 문제에 가장 잘 맞는다.\",\"w\":{\"1\":\"리실버만음성치료(LSVT)는 파킨슨병의 감소된 강도에 특화된 방법으로, 쇄골호흡과 단조로운 리듬 문제를 겨냥하지 않는다.\",\"2\":\"손가락 조작법은 변성발성장애에서 습관적 음도를 낮추는 기법으로, 이 대상자의 호흡·리듬 문제와 무관하다.\",\"3\":\"흡기발성은 가성대 발성이나 기능적 실성증에 쓰는 기법으로, 호흡 지지 부족과 단조로운 억양을 다루지 못한다.\",\"5\":\"차폐 기법은 롬바르드 효과로 강도만 올리는 방법이어서 쇄골호흡 양상과 리듬 문제를 다루지 못한다.\"}},\"1-3-2-15\":{\"w\":{\"1\":\"후두 하강법은 과기능성 음성장애의 이완 기법으로, 마비 성대의 성문 폐쇄를 돕는 이 절차와 목적이 다르다.\",\"2\":\"갑상연골을 앞에서 뒤로 눌러 성대를 느슨하게 해 음도를 낮추는 것은 변성발성장애의 손가락 조작법으로, 측면에서 안쪽으로 누르는 이 절차와 방향과 목적이 다르다.\",\"3\":\"후두 마사지는 과기능성 음성장애의 이완 기법으로, 마비 성대를 내측화하는 절차가 아니다.\",\"4\":\"지문의 절차는 성대를 늘여 음도 범위를 넓히는 것이 아니라 갑상연골 판을 측면에서 눌러 성대를 정중선 쪽으로 미는 것이다.\"}},\"1-3-2-16\":{\"w\":{\"1\":\"활동성 유두종 병변은 수술(필요 시 보조 약물)로 관리하는 것으로, 음성치료로 소실시키거나 재발을 막을 수 없다.\",\"3\":\"밀기 기법과 강한 성문파열음은 이미 있는 과기능을 강화하고 반흔 조직에 부담을 준다.\",\"4\":\"유두종은 일상적 대면 치료로 전염되는 것이 아니므로 대면 치료를 중단할 이유가 없다.\",\"5\":\"전교련 웹과 반흔 같은 구조적 손상이 있어 완전한 정상 음성 회복은 비현실적인 목표이다.\"}},\"1-3-2-17\":{\"w\":{\"2\":\"속삭임은 성대를 강하게 벌리고 후두 긴장을 높여 오히려 해로우며, 비밀스러운 음성은 유성음을 유지한다는 점에서 속삭임과 다르다.\",\"3\":\"장기간 사용하면 기식성 발성이 습관화될 수 있으므로 수술 직후 단기간만 쓰는 과도기적 방법이다.\",\"4\":\"목을 조여 작은 소리를 내면 과기능을 유발하므로, 편안하게 강도만 낮춘 음성이어야 한다.\",\"5\":\"비밀스러운 음성은 음성휴식을 완전히 대체하지 않으므로 말하는 양도 함께 조절해야 한다.\"}},\"1-3-2-18\":{\"w\":{\"1\":\"속삭임은 후두 긴장을 높여 회복에 해로우므로 리허설 방식으로 적절하다고 확인해 주어서는 안 된다.\",\"2\":\"밀기 기법은 염증이 있는 성대의 부하를 더 늘려 손상 위험을 높인다.\",\"3\":\"출혈·종괴가 없는 급성 염증은 수술 대상이 아니다.\",\"5\":\"고음 발성 연습을 늘리면 부종이 있는 성대에 부하가 더해져 손상 위험이 커진다.\"}},\"1-3-2-19\":{\"w\":{\"1\":\"성대결절은 양측 대칭 병변인데, 이 환자는 편측의 불규칙한 백색 병변이므로 결절로 판단할 수 없다.\",\"2\":\"라인케부종은 양측 전장의 반투명 부종으로, 편측 국소의 백색 융기 병변과 다르며 진단 없이 3개월을 기다리는 것은 위험하다.\",\"4\":\"접촉성 육아종은 성대돌기(후방) 부위의 병변으로, 성대 중간부의 백색 병변과 위치가 다르다.\",\"5\":\"구조적 병변이 뚜렷하므로 기능적 음성장애로 볼 수 없다.\"}},\"1-3-2-20\":{\"w\":{\"1\":\"역류 치료에 이미 반응하지 않았으므로 양성자펌프억제제 용량을 늘리는 것은 근거가 없다.\",\"2\":\"기침을 반복하면 후두 자극이 강화되어 기침이 다시 유발되는 악순환이 된다.\",\"3\":\"후두내시경에서 구조적 이상이 없으므로 성대결절이나 음성휴식과는 무관하다.\",\"4\":\"심인성으로 단정해 정신건강의학과에만 의뢰하는 것은 근거 있는 행동적 기침 억제 치료의 기회를 놓치는 부적절한 대응이다.\"}},\"1-3-2-21\":{\"w\":{\"2\":\"0.52는 성문폐쇄부전을 뜻하는 낮은 값이 아니라 정상 범위의 값이며, 과도했던 접촉이 줄어든 것이다.\",\"3\":\"EGG는 목에 댄 전극으로 성대 접촉 면적 변화를 기록하는 검사로, 성문하압을 측정하지 않는다.\",\"4\":\"접촉률은 한 주기 중 성대가 접촉된 시간의 비율이며, 점막파동의 진폭을 나타내지 않는다.\",\"5\":\"과기능 환자에게 접촉률 증가는 치료 목표가 아니며, 밀기 기법은 금기에 가깝다.\"}},\"1-3-2-22\":{\"w\":{\"1\":\"이중음성은 기본주파수 자체의 상승이 아니라 서로 다른 두 진동이 겹쳐서 생긴다.\",\"2\":\"지문에서 연인두 기능이 정상이므로 비강 공명으로 이 현상을 설명할 수 없다.\",\"3\":\"가성대 발성도 이중음성을 만들 수 있으나, 이 환자는 스트로보스코피에서 가성대 접근이 없다.\",\"5\":\"불완전한 성문 폐쇄에 의한 기류 소음은 기식성(B1)을 설명할 뿐, 두 음이 동시에 들리는 현상을 설명하지 못한다.\"}},\"1-3-2-23\":{\"p\":\"테스토스테론 치료 10개월 만에 습관적 F0가 210 Hz에서 125 Hz로 낮아져 이미 성인 남성 범위에 들어왔으므로, 음도 자체를 바꾸는 수술은 필요하지 않다. 문제는 갈라짐과 갑작스러운 고음 같은 음도 불안정, 그리고 목 피로·조임과 내시경의 전후 압축·가성대 접근으로 나타나는 과기능이다. 이는 변화한 후두에 맞는 발성 조절을 아직 익히지 못해 생기는 것이므로, 새 음도의 안정화와 과기능 감소를 목표로 하는 음성치료가 적절하다.\",\"w\":{\"1\":\"125 Hz는 이미 성인 남성 범위이며, 제III형 갑상성형술은 음도를 더 낮추는 수술로 이 사례의 적응증이 아니다.\",\"3\":\"밀기 기법은 이미 나타난 전후 압축·가성대 접근 같은 과기능을 악화시킨다.\",\"4\":\"호르몬 중단 권고는 언어재활사의 역할을 벗어나며, 증상은 음성치료로 다룰 발성 조절 문제이다.\",\"5\":\"가성구 발성 훈련은 낮아진 음도를 안정화하는 목표와 반대 방향이다.\"}},\"1-3-2-24\":{\"w\":{\"1\":\"갑상성형술은 성장 중인 영아의 후두에 시행하지 않으며, 회복 가능성이 있는 시기에는 영구 수술을 보류한다.\",\"2\":\"밀기 기법은 영아에게 적용할 수 없으며, 시급한 문제인 흡인과 수유 곤란을 해결하지도 못한다.\",\"3\":\"편측 마비는 기도 폐쇄를 일으키지 않으므로 기관절개술의 적응증이 아니다.\",\"4\":\"수유 중 기침·사레와 체중 증가 지연이 있는데 흡인 위험을 방치한 채 퇴원시키는 것은 위험하다.\"}},\"1-3-2-25\":{\"w\":{\"1\":\"왼쪽 3분법 기도역치는 (15+20+40)/3=25 dB HL로 경도 수준이다. 40 dB HL도, 중등도 판정도 그림의 왼쪽 기도역치(X)와 맞지 않는다.\",\"3\":\"오른쪽은 차폐 기도 60·65·70 dB HL과 차폐 골도 35·40·45 dB HL 사이에 25 dB의 기도-골도 차가 있다. 기골도차가 없다는 전제부터 틀렸으며, 골도도 상승해 있으므로 혼합성으로 본다.\",\"4\":\"헤드폰 기도검사에서 검사 귀 기도역치와 반대 귀 골도역치의 차가 이간감쇠(약 40 dB) 이상이면 교차청취가 일어날 수 있다. 오른쪽 500 Hz 기도 60 − 왼쪽 골도 15 = 45 dB이므로 차폐가 필요했고, 그래서 오른쪽은 차폐한 역치로 기록되었다.\",\"5\":\"오른쪽 3분법 기도역치는 (60+65+70)/3=65 dB HL로 중등고도에 해당한다. 55 dB HL은 250 Hz 한 주파수의 값일 뿐 3분법 평균이 아니다.\"}},\"1-3-2-26\":{\"w\":{\"1\":\"[kiba]에서는 /m/과 /p̚/ 두 종성이 모두 생략되었는데 이를 1회로 센 계산이다. 이중 생략을 각각 세면 분자는 6이 된다.\",\"2\":\"분자는 [kiba]의 이중 생략을 1회로 줄여 셌고, 분모는 종성이 없는 '바지'까지 기회로 넣어 12로 잡았다. 분자와 분모가 모두 틀렸다.\",\"4\":\"분자 6은 맞지만 분모 12는 종성이 없는 '바지'까지 2자리의 기회가 있는 것처럼 계산한 값이다. 출현 기회는 실제 종성 자리 10개이다.\",\"5\":\"자료에서 종성이 생략된 횟수는 6회이므로 분자 7은 과다 집계이다. 분모 12 역시 종성이 없는 '바지'를 기회에 포함한 오류이다.\"}},\"1-3-2-27\":{\"w\":{\"2\":\"4는 연구개음 중 치조음으로 전방화된 오류 개수이다. 정확도의 분자는 바르게 산출한 개수 3이어야 한다.\",\"3\":\"분모 8은 연구개음이 아닌 음까지 기회로 넣은 값이다. /kat̚t*aga/의 /t*/는 치조음, /tɕabas*ʌjo/의 /s*/는 치조 마찰음이므로 연구개 파열음 기회는 7개이다.\",\"4\":\"분자로 오류 수 4를, 분모로 연구개음이 아닌 음까지 포함한 8을 써서 둘 다 틀렸다. 정확히 산출한 연구개음 3개를 기회 7개로 나누어야 한다.\",\"5\":\"캐[kʰ]·가[g]·개[k] 세 개가 모두 연구개음으로 정확히 산출되었으므로 정반응은 2개가 아니라 3개이다.\"}},\"1-3-2-28\":{\"w\":{\"1\":\"연구개음은 [−전방성]이므로 아동 B만 [+전방성]을 잃었다. 아동 A가 산출한 양순음은 [+전방성]이어서 두 아동의 공통 상실 자질이 되지 못한다.\",\"2\":\"두 아동 모두 /ㄴ/을 [m] 또는 [ŋ]이라는 비음으로 바꾸었으므로 비음성은 유지되었다. /ㄷ/도 비음이 아닌 파열음으로 산출되어 비음성 변화가 없다.\",\"3\":\"목표 파열음은 파열음으로, 비음은 비음으로 산출되어 조음방법이 바뀌지 않았다. 따라서 지속성 자질에는 변화가 없다.\",\"5\":\"/ㄷ/이 평음 [ㅂ]이나 [ㄱ]으로 대치되어 평음이 그대로 유지되었다. 긴장성은 경음과 관련된 자질로 이 자료의 오류와 관계없다.\"}},\"1-3-2-29\":{\"p\":\"아동 A는 같은 낱말의 자음·모음 오류가 매번 다르고, 낱말이 길어질수록 오류가 급증하며, 모색행동과 균등한 강세를 보이고 근력·반사는 정상이다. 이는 신경근육 결함 없이 말운동의 계획·프로그래밍이 손상된 아동기 말실행증의 핵심 특징이다. 아동 B는 모든 음소의 일관된 약화·왜곡, 과다비성, 침 흘림, 혀·입술 근력 저하, 느린 말속도를 보여 신경근육 실행의 문제인 마비말장애에 해당한다. 따라서 비일관성·모색행동과 근력 저하·일관된 왜곡이라는 대비가 두 장애를 감별하는 근거가 된다.\",\"w\":{\"1\":\"두 아동의 소견을 서로 바꾸어 기술하였다. 근력 저하와 침 흘림은 아동 B의 소견이고, 아동 A는 근력이 정상이며 오류가 비일관적이다.\",\"2\":\"비일관적 오류는 아동 A에게만 있고 아동 B의 오류는 일관된 왜곡이다. 근력 저하 여부, 오류 일관성, 모색행동에서 두 아동이 뚜렷이 달라 감별이 가능하다.\",\"3\":\"/퍼터커/ 순서 오류는 있으나 /퍼퍼퍼/ 같은 단일 음절 반복이 정상인 양상은 순서화 결함인 말실행증에 가깝다. 마비말장애는 단일 음절 반복도 느리고 약하게 나타난다.\",\"4\":\"운동적 조음장애는 소수 음소에 국한된 일관된 오류가 특징이다. 아동 A는 오류가 비일관적이고 길이 효과·모색행동·운율 이상이 있어 말실행증의 양상에 맞다.\"}},\"1-3-2-30\":{\"w\":{\"1\":\"소리의 유무를 알아차리는 탐지 단계 활동이다. 아동은 이미 Ling 6음 탐지·변별이 가능하므로 위계상 지나치게 낮은 과제이다.\",\"2\":\"그림 두 장 중에서 고르는 폐쇄형 확인 과제이다. 아동은 그림 4장 폐쇄형 확인에서 이미 90%를 보였으므로 이미 통과한 수준이다.\",\"4\":\"긴 이야기를 듣고 다시 말하기는 이해 단계의 과제이다. 개방형 확인이 30%로 아직 미완성인 상태에서는 지나치게 어렵다.\",\"5\":\"독화 중심 연습은 시각 정보에 의존하게 하므로 청각 정보 처리를 훈련하는 청능훈련의 방향과 맞지 않는다. 인공와우로 탐지·변별·폐쇄형 확인이 가능한 아동에게 청각 경로를 포기할 이유가 없다.\"}},\"1-3-2-31\":{\"w\":{\"2\":\"오류 양상이 고주파수 청력 손실과 정확히 맞물리는데 이 원인을 무시한 해석이다. 마찰음을 충분히 듣지 못하는 상태에서 청각 변별 훈련만으로는 효과를 기대하기 어렵다.\",\"3\":\"구강 구조·운동 기능이 정상이고, 같은 조음 기관을 쓰는 /ㄷ/ 등은 정확하므로 혀 근력 부족의 근거가 없다. 비구어 구강운동을 먼저 하는 것은 오류 원인과 맞지 않는다.\",\"4\":\"/ㅁ, ㄴ, ㅂ, ㄷ/와 모음은 이미 정확하므로 비음을 다시 훈련할 필요가 없다. 문제는 고주파수 마찰음에 대한 청각 접근이다.\",\"5\":\"청각 모델을 반복해도 /ㅅ/ 산출이 개선되지 않았으므로 청각 단서를 더 크게 반복하는 것만으로는 충분하지 않다. 고주파수 청각 접근이 제한된 상황이므로 보청기 점검이 필요하다.\"}},\"1-3-2-32\":{\"w\":{\"1\":\"다른 압력자음과 모음에서 비강누출이 없고 비음치도 정상이므로 연인두폐쇄부전이 확실하다는 판단은 근거가 없다. 학습된 오조음은 인두피판술 같은 수술 대상이 아니다.\",\"3\":\"비음치가 정상이고 비음 산출 문제가 보고되지 않았으므로 과소비성이 아니다. 문제는 /ㅅ, ㅆ/에 국한된 비강누출이다.\",\"4\":\"구개거상기는 연인두 기능 문제를 보완하는 보철인데, 이 아동은 기질적 연인두 문제가 아니라 학습된 오조음이다. 보철 없이 구강 기류 유도 조음치료로 바로 접근할 수 있다.\",\"5\":\"다른 음소가 정상이고 코를 막으면 /ㅅ/를 정조음할 수 있어 소견이 학습된 오류에 부합한다. 청력 손실을 이유로 치료를 보류할 근거가 없다.\"}},\"1-3-2-33\":{\"w\":{\"1\":\"이 연령에서는 협조가 어려워 연인두 기능 평가는 발화 표본이 충분히 쌓인 뒤(대개 3세 전후) 실시한다. 평가 시점까지 중재를 보류할 이유가 없다.\",\"2\":\"/ㅅ, ㅈ/는 후기 발달음이고 독립음 반복 훈련은 14개월 영아에게 발달적으로 부적절하다. 이 시기에는 초기 발달음인 앞쪽 파열음을 놀이 속에서 촉진해야 한다.\",\"3\":\"성문파열음은 구개열 아동에게 생기기 쉬운 보상조음이다. 이를 강화하면 보상조음이 습관화되어 이후 교정이 어려워진다.\",\"5\":\"과다비성이 확인되지 않았고 영아에게는 구개거상기를 적용하지 않는다. 이 시기의 과제는 보철이 아니라 구강 압력자음 출현 촉진이다.\"}},\"1-3-2-34\":{\"w\":{\"1\":\"같은 목록 반복과 매 시행 즉각 피드백은 이미 시행해 온 습득기 조건이다. 이를 유지하면 낱말 수준 수행은 높아도 문장·대화로의 전이는 촉진되지 않는다.\",\"2\":\"낱말 수준에서 이미 95% 이상 확립되었으므로 독립음으로 되돌아가는 것은 불필요한 퇴행이다. 문제는 확립이 아니라 일반화이다.\",\"3\":\"시각·촉각 단서를 늘리면 단서 의존이 커져 일반화가 늦어진다. 낱말 정확도는 이미 충분하므로 더 높이는 것은 핵심 과제가 아니다.\",\"4\":\"치료사가 매 시행 혀끝 위치를 설명하는 수행 지식(KP) 피드백은 습득기 조건을 강화하는 것이다. 전이 단계에서는 피드백 빈도를 줄이고 결과 지식 위주로 바꾸어야 한다.\"}},\"1-3-2-35\":{\"w\":{\"1\":\"/ㄷ/는 이미 습득한 음소이고, 자질 차이를 최소로 하는 것은 최소대립쌍 접근의 논리이다. 최대대립·빈 집합 원리와 반대이다.\",\"2\":\"/ㅅ/와 /ㅆ/는 둘 다 미습득이지만 긴장성 자질 하나만 다르다. 자질 차이를 최대로 하라는 최대대립 원리에 맞지 않는다.\",\"4\":\"/ㅂ/와 /ㅁ/는 아동의 산출 목록에 이미 있는 음소이다. 습득된 음소끼리의 쌍은 치료 목표가 되지 않는다.\",\"5\":\"/ㅌ/와 /ㅋ/는 둘 다 미습득이지만 조음위치 자질 하나만 다르다. 빈 집합 조건은 만족해도 최대대립 조건은 만족하지 못한다.\"}},\"1-3-2-36\":{\"w\":{\"1\":\"음운지연은 정상 발달 과정의 패턴이 또래보다 늦게까지 남는 유형이다. 어두 초성 생략과 후방화는 비발달적 패턴이므로 음운지연으로 볼 수 없다.\",\"3\":\"비일관적 음운장애는 같은 낱말 반복 산출의 변이율이 40% 이상일 때 해당한다. 이 아동의 변이율은 8%로 일관적이다.\",\"4\":\"조음장애는 소수 음소의 일관된 왜곡이 특징이다. 이 아동은 생략·후방화라는 규칙적 오류패턴을 보이므로 개별 음소 운동의 문제가 아니다.\",\"5\":\"말실행증은 비일관성·모색행동·운율 이상을 동반하는데, 이 아동은 세 가지가 모두 없고 교대운동속도도 정상이다.\"}},\"1-3-2-37\":{\"w\":{\"2\":\"음운변동별 목표를 주기마다 순환하는 것은 주기법의 절차이다. 음운 체계 문제에 쓰는 방법으로, 운동 계획·프로그래밍 결함인 말실행증의 DTTC 원리와 다르다.\",\"3\":\"최소대립쌍의 의미 대조로 음운 체계를 재구조화하는 것은 음운장애 중재이다. 말실행증 아동의 운동 계획 문제를 직접 다루지 못한다.\",\"4\":\"말실행증은 근력 결함이 없으므로 근력을 키우는 비구어 구강운동은 근거가 없다. DTTC는 실제 말소리 산출을 반복하는 방식이다.\",\"5\":\"말소리 자질 개념을 상위언어적으로 인식시키는 것은 상위음운 접근으로, 음운 체계 문제에 쓰는 방법이다. 동시 산출과 단서 소거라는 DTTC 절차와 관련이 없다.\"}},\"1-3-2-38\":{\"w\":{\"1\":\"/ㅏ/ 모음 앞 어두라는 한 문맥만 반복하므로 문맥 간 비교가 불가능하다. 촉진 문맥을 찾으려면 모음과 위치를 체계적으로 바꾸어야 한다.\",\"2\":\"듣고 같은지 다른지 판단하는 변별 과제는 산출이 아닌 지각 검사이다. 어떤 문맥에서 정조음이 되는지 알려 주지 못한다.\",\"3\":\"긴 문장 따라말하기는 인접 모음이나 낱말 내 위치가 통제되지 않는다. 오류가 나타나도 어떤 문맥이 영향을 주었는지 분석하기 어렵다.\",\"5\":\"독립음 지속시간 측정은 음성 문맥이 없는 조건에서 이루어지므로 문맥 효과와 무관하다. 촉진 문맥 탐색이라는 목적에 맞지 않는다.\"}},\"1-3-2-39\":{\"w\":{\"1\":\"종성생략은 목표 낱말의 종성과 아동 산출을 비교해야 알 수 있는 관계분석 항목이다. 독립분석은 목표형과 비교하지 않으므로 이런 결론을 낼 수 없다.\",\"2\":\"자음정확도(PCC)는 목표 자음 대비 정확히 산출한 자음의 비율로, 목표형과의 비교가 필요한 관계분석 지표이다.\",\"3\":\"연구개음 전방화는 목표 연구개음이 앞쪽 음으로 바뀐 관계를 기술하는 것이므로 관계분석 항목이다. 독립분석으로는 판단할 수 없다.\",\"4\":\"표본에 치경음 /ㄷ, ㄴ/은 전혀 나타나지 않는다. 산출된 초성은 [ㅁ, ㅂ, ㅃ]뿐이다.\"}},\"1-3-2-40\":{\"w\":{\"2\":\"토끼에서 격음 /tʰ/가 평음 [t]로 바뀐 탈기식음화이다. 낱말 안에 /tʰ/를 평음으로 끌어당길 소리가 없어 문맥과 무관한 대치이다.\",\"3\":\"시소에서 마찰음 /ɕ, s/가 [t, d]로 바뀐 마찰음의 파열음화이다. 낱말 안에 영향을 줄 파열음이 없으므로 동화로 볼 수 없다.\",\"4\":\"라면에서 유음 /ɾ/가 활음 [j]로 바뀐 유음의 활음화이다. 문맥과 무관한 대치 변동이다.\",\"5\":\"책의 종성 /k̚/가 사라진 종성생략이다. 다른 소리에 닮아 간 것이 아니라 음이 탈락한 생략 변동이다.\"}},\"1-3-2-41\":{\"w\":{\"1\":\"인공와우는 고도~심도 난청이면서 보청기 이득이 제한적일 때 고려한다. 이 아동은 중등고도이고 보청기 이득이 충분하므로 적응증을 충족하지 않는다.\",\"3\":\"보청기 이득이 확인되었더라도 청능훈련은 청각 기술 발달을 위해 계속해야 한다. 청능훈련을 종결하고 조음치료만 하는 것은 부적절하다.\",\"4\":\"골도 보청기는 전음성·편측 난청 등에 쓰인다. 감각신경성 난청도 기도 보청기 효과가 있으며, 이 아동은 실제로 보청기 이득이 확인되었다.\",\"5\":\"보청기로 충분한 이득을 얻고 있어 인공와우 적응증을 충족하지 않는다. 한쪽 이식과 반대쪽 보청기 제거를 권할 근거가 없다.\"}},\"1-3-2-42\":{\"w\":{\"1\":\"매 시행 입 모양 시범을 먼저 보여 주면 이미 문제인 시각 의존이 더 강해진다. 청각 활용 원리와 반대 방향이다.\",\"2\":\"청각 단서를 배제하면 개방형 문장 지각 80%까지 발달한 청각 경로를 버리는 셈이다. 촉각 단서는 보조적으로만 쓰는 것이 원칙이다.\",\"3\":\"독화 훈련은 시각 정보 의존을 강화하여 청각 피드백 기반의 자기 모니터링 발달을 막는다. 청각 활용 원리와 맞지 않는다.\",\"5\":\"/ㅅ/ 왜곡도 청각 피드백을 활용해 수정할 수 있는 목표이다. 왜곡을 치료 대상에서 빼야 할 근거가 없다.\"}},\"1-3-2-43\":{\"w\":{\"1\":\"'잘 낼 수 있다'는 관찰·측정이 불가능한 표현이고, 조건과 준거도 없다. 목표 달성 여부를 판정할 수 없다.\",\"2\":\"'이해한다'는 내적 상태를 나타낼 뿐 관찰 가능한 행동이 아니다. 측정 기준도 제시되지 않았다.\",\"4\":\"치료사가 무엇을 할지를 적은 중재 절차이지 아동의 행동목표가 아니다. 행동목표의 주체는 아동이어야 한다.\",\"5\":\"몇 회, 몇 %라는 측정 기준이 없어 판정이 불분명하다. 대화 상황의 오류 소거는 확립 단계가 아닌 일반화 단계의 장기목표 수준이다.\"}},\"1-3-2-44\":{\"w\":{\"1\":\"모음의 제1·제2 포먼트는 모음·유음 왜곡의 피드백 지표이다. 마찰음의 치간음화 왜곡을 직접 보여 주지 못한다.\",\"2\":\"기본주파수(F0)는 음도를 반영하는 지표로 음성 치료에 쓰인다. 혀끝 위치와 관련된 마찰음 왜곡과 무관하다.\",\"3\":\"VOT는 파열음의 발성유형(평음·경음·격음)을 구분하는 지표이다. 마찰음 /ㅅ, ㅆ/의 조음 위치 문제를 반영하지 않는다.\",\"4\":\"음절 지속시간은 말속도·운율 피드백에 쓰는 지표이다. 치간음화 여부는 길이보다 마찰 소음의 주파수 분포로 드러난다.\"}},\"1-3-2-45\":{\"w\":{\"2\":\"자극반응도와 자연 회복의 관계를 반대로 기술하였다. 자극반응도가 없는 음소는 자연 회복 가능성이 낮아 오히려 치료가 필요하다.\",\"3\":\"자극반응도는 낱말 수준에만 한정하지 않고 독립음·음절 수준에서도 평가한다. /ㅋ/는 독립음·음절 수준에서 산출이 가능하므로 자극반응도가 있다.\",\"4\":\"낱말 수준에서 산출하지 못하더라도 독립음·음절 수준에서 가능하면 자극반응도가 있다고 본다. 평가 수준을 낱말로 잘못 제한한 판단이다.\",\"5\":\"자극반응도가 있으면 예후가 좋다는 뜻일 뿐 반드시 저절로 습득되는 것은 아니다. /ㅋ/도 음절 수준부터 확립하는 치료 목표로 삼아야 한다.\"}},\"1-3-2-46\":{\"w\":{\"1\":\"조음과 음운인식은 서로 관련되므로 순차적으로 분리하면 통합 중재의 이점을 잃는다. 입학 전이라는 시기를 고려하면 함께 다루는 것이 효율적이다.\",\"3\":\"음절 수 세기는 아동이 이미 통과한 수준이다. 실패한 음소 수준 과제로 나아가야 한다.\",\"4\":\"음소 탈락은 음운인식 중 가장 어려운 과제로, 첫소리 변별도 안 되는 아동에게 먼저 시키는 것은 발달 순서를 무시한 것이다.\",\"5\":\"자모 이름 암기는 음소 인식이나 말소리 산출과 직접 관련이 없다. 이를 조음치료보다 우선할 근거가 없다.\"}},\"1-3-2-47\":{\"w\":{\"1\":\"치료를 보류하면 혀 밀기 습관과 치간음화가 굳어지고 교정 효과도 해칠 수 있다. 자극반응도가 있어 지금 치료를 시작할 수 있다.\",\"2\":\"혀 밀기 삼킴은 교정 후 재발 요인이자 치간음화 지속과 관련된 요인이다. 이를 무관하다고 보고 방치하면 안 된다.\",\"4\":\"지문에 혀 근력 저하를 보여 주는 소견이 없다. 문제는 혀의 위치와 습관이며, 근력 운동만으로는 조음 오류를 다루지 못한다.\",\"5\":\"청소년·성인도 잔존오류 치료가 가능하며, 이 학생은 거울 단서로 정조음이 가능해 예후 근거도 있다. 치료 불가 안내는 부적절하다.\"}},\"1-3-2-48\":{\"w\":{\"1\":\"종성만 생략된 것이 아니라 음절이 통째로 사라진 오류이다. [nɛŋgo]에서는 종성 /ŋ/도 정확히 산출되었다.\",\"2\":\"[kʰok*i], [nɛŋgo], [tɕagʌ]에서 연구개음이 정확히 산출되어 전방화의 근거가 없다.\",\"3\":\"각 음소는 단독으로 산출 가능하므로 개별 음소 오류가 주된 문제가 아니다. 음소별 전통적 접근은 낱말 길이에 따른 음절 생략이라는 본질을 다루지 못한다.\",\"5\":\"같은 낱말을 매번 다르게 산출한다는 비일관성의 근거가 자료에 없다. 오류는 다음절 낱말의 음절 생략으로 일정한 양상을 보인다.\"}},\"1-3-2-49\":{\"w\":{\"1\":\"기초선은 20~30의 10%p 범위에서 변동하고 상승 추세도 없어 비교적 안정적이다. 중재를 시작하기에 부적절한 시점이라고 볼 근거가 없다.\",\"2\":\"6회기 값은 30으로 기초선 최고점 30과 같을 뿐 초과하지 않았다. 따라서 중재 첫 회기부터 최고점을 초과했다는 기술은 그래프와 맞지 않는다.\",\"4\":\"6회기 값 30은 최고점과 같아 PND 계산에서 제외되므로 PND는 100%가 아니라 90%이다. 또한 A-B 설계로는 실험적 통제를 입증할 수 없다.\",\"5\":\"평균 차이가 커도 A-B 설계에는 효과의 반복 입증이 없어 성숙·외부 사건 등의 대안 설명을 배제할 수 없다. 반전 구간 없이 기능적 관계가 실험적으로 입증되었다고 볼 수 없다.\"}},\"1-3-2-50\":{\"w\":{\"1\":\"A2에서 수행이 유지된 것은 반전이 일어나지 않았다는 뜻으로, ABAB 설계의 논리에서는 기능적 관계를 입증하지 못한 결과이다. 이를 강력한 효과의 증거로 본 것은 반대로 해석한 것이다.\",\"3\":\"기능적 관계가 입증되지 않았다는 것이 곧 중재 효과가 없었다는 뜻은 아니다. B1의 상승을 우연으로 단정하고 중재를 종료할 근거가 없다.\",\"4\":\"행동이 떨어질 때까지 중재를 무기한 철회하는 것은 아동에게 필요한 중재를 보류하는 것이어서 윤리적으로 문제가 된다. 비가역적 기술이라면 설계 자체를 바꾸는 것이 적절하다.\",\"5\":\"기대와 다른 자료를 근거 없이 기록 오류로 간주해 제외하는 것은 자료의 임의 조작이다. A2 자료는 설계 해석에 필수적인 구간이다.\"}},\"1-3-2-51\":{\"w\":{\"1\":\"같은 목표 음소에 두 중재를 적용하면 한 중재의 효과가 다른 중재의 결과에 섞여 어느 중재 때문에 향상되었는지 구분할 수 없다.\",\"2\":\"실시 순서를 매 회기 고정하면 먼저 실시한 중재가 유리하거나 불리해지는 순서 효과가 결과에 혼입된다.\",\"3\":\"단일대상연구는 기초선과 반복 측정 자료의 시각적 분석을 기본으로 한다. 기초선을 생략하고 최종 정반응률만 t검정으로 비교하는 것은 설계 논리에 맞지 않는다.\",\"5\":\"아동이 선호하는 중재를 항상 먼저 실시하면 순서가 고정되어 순서 효과가 혼입된다. 선호도라는 변수까지 결과에 섞이게 된다.\"}},\"1-3-2-52\":{\"p\":\"지문에서 새 선별검사와 이미 표준화된 기존 어휘검사를 아동 120명에게 '같은 날' 실시하고 두 점수의 상관(r = .82)을 구하였다. 이처럼 새 검사와 타당성이 확립된 준거 검사를 같은 시점에 실시해 상관을 구하는 것은 준거관련 타당도 중 공인(동시)타당도이다. 상관이 높을수록 새 검사가 기존 검사와 같은 능력을 측정한다는 근거가 된다.\",\"w\":{\"2\":\"예측타당도는 일정 기간 뒤의 준거(예: 1년 후 언어장애 진단 여부)를 예측하는 정도이다. 지문은 같은 날 두 검사를 실시했으므로 예측타당도가 아니다.\",\"3\":\"내용타당도는 문항이 측정하려는 영역을 잘 대표하는지에 대한 전문가 판단이다. 다른 검사와의 상관을 구하는 절차가 아니다.\",\"4\":\"검사-재검사 신뢰도는 같은 검사를 시간 간격을 두고 두 번 실시한 결과의 일관성이다. 지문은 서로 다른 두 검사를 같은 날 실시하였다.\",\"5\":\"반분 신뢰도는 한 검사를 두 부분으로 나누어 얻는 내적 일관성이다. 외부 준거 검사와의 상관과는 관계가 없다.\"}},\"1-3-2-53\":{\"w\":{\"1\":\"유의하지 않다는 것은 효과가 없다는 증명이 아니다. 작은 표본에서 d = 0.92의 큰 효과가 관찰되었으므로 '효과 없음'으로 단정할 수 없다.\",\"2\":\"효과크기는 통계적 유의성과 함께 보고해야 하는 정보이다. 특히 표본이 작을 때는 효과의 실제 크기를 판단하는 데 중요하다.\",\"3\":\"1종 오류는 효과가 없는데 있다고 판단하는 오류이다. 이 연구는 유의하지 않은 결과이므로 상황에 맞지 않으며, 우려되는 것은 오히려 2종 오류이다.\",\"4\":\"결과를 본 뒤 유의수준을 .10으로 올려 유의하다고 보고하는 것은 통계 원칙과 연구 윤리에 어긋난다. 유의수준은 분석 전에 정해야 한다.\"}},\"1-3-2-54\":{\"p\":\"자료를 2×2 표로 정리하면, 언어장애 16명 중 양성 14명(진양성)·음성 2명(위음성), 비장애 64명 중 양성 16명(위양성)·음성 48명(진음성)이다. 민감도는 실제 장애 아동 중 선별 양성의 비율로 14/16 × 100 = 87.5%이다. 특이도는 실제 비장애 아동 중 선별 음성의 비율로 (64 − 16)/64 × 100 = 48/64 × 100 = 75%이다. 따라서 민감도 87.5%, 특이도 75%가 옳다.\",\"w\":{\"1\":\"민감도와 특이도의 값을 서로 바꾸어 적었다. 민감도는 14/16 = 87.5%, 특이도는 48/64 = 75%이다.\",\"3\":\"30명은 선별 양성 전체(14 + 16)이므로 14/30 = 46.7%는 양성예측도이다. 민감도는 실제 장애 아동 16명을 분모로 한다.\",\"4\":\"16/64 = 25%는 비장애 아동 중 양성으로 잘못 분류된 비율, 곧 위양성률이다. 특이도는 비장애 아동 중 음성 비율인 48/64 = 75%이다.\",\"5\":\"2/16 = 12.5%는 장애 아동을 놓친 위음성률이다. 위양성률은 16/64 = 25%이다.\"}},\"1-3-2-55\":{\"w\":{\"1\":\"자폐스펙트럼장애의 확정 진단은 의사의 영역이다. 언어재활사가 '진단됨'이라고 쓰는 것은 업무 범위를 벗어난다.\",\"2\":\"어머니의 양육 시간이 적다는 보고만으로 언어지연의 원인을 단정하는 것은 근거 없는 인과 귀인이다. 보고서에는 확인된 사실만 기술해야 한다.\",\"3\":\"'게으르고 비협조적'은 가치 판단이 담긴 표현으로 보고서에 부적절하다. 관찰된 행동을 객관적으로 기술해야 한다.\",\"5\":\"원점수만으로는 또래 대비 수준을 알 수 없다. 표준점수·백분위·등가연령 등 규준 참조 없이 지체 정도를 판정한 해석 오류이다.\"}},\"1-3-2-56\":{\"p\":\"보호자에게 받은 동의서에는 녹화 목적이 '임상 슈퍼비전'으로 명시되어 있다. 개인정보인 영상은 동의받은 목적 범위 안에서만 이용할 수 있으며, 목적이 학부 강의 자료로 달라지면 활용 목적·범위·대상을 명시한 별도 동의를 보호자에게 새로 받아야 한다. 따라서 강의에 사용하기 전에 새 동의를 받는 것이 적절하다.\",\"w\":{\"2\":\"기존 동의는 슈퍼비전 목적에 한정된 것이다. 녹화 자체에 동의했더라도 다른 목적의 이용까지 동의한 것은 아니다.\",\"3\":\"얼굴을 모자이크해도 음성·발화 내용 등으로 개인을 식별할 가능성이 남는다. 모자이크가 동의를 대신하지 못한다.\",\"4\":\"교육 목적이라는 이유만으로 개인정보 이용 동의가 면제되지 않는다. 목적이 바뀌면 새로 동의를 받아야 한다.\",\"5\":\"치료 종결이나 기관 보관 여부는 이용 목적 제한을 해제하지 않는다. 기관이 보관하는 자료라도 동의받은 목적 밖으로 자유롭게 쓸 수 없다.\"}},\"1-3-2-57\":{\"w\":{\"1\":\"슈퍼바이저가 회기 계획을 대신 작성하는 지시적 방식은 초기의 평가-피드백 단계에 맞는다. 스스로 계획을 세우는 학생의 수준보다 낮다.\",\"3\":\"학생이 아직 독립적으로 문제를 해결하지 못하므로 자기 슈퍼비전 단계로 볼 수 없다. 관찰과 피드백을 모두 중단하는 것은 내담자 보호 책무에도 어긋난다.\",\"4\":\"모든 임상 결정을 슈퍼바이저가 내리는 것은 지시적 방식으로 초기 단계에 해당한다. 학생의 성장 수준을 반영하지 못한다.\",\"5\":\"요청할 때만 개입하는 자문 방식은 자기 슈퍼비전 단계에 해당한다. 회기 관찰을 하지 않으면 내담자 보호 책무도 다하지 못한다.\"}},\"1-3-2-58\":{\"p\":\"뇌전증 병력 아동이 전신 경직-간대 발작을 보일 때는 억제하거나 입에 물건을 넣지 않는다. 주변 위험물을 치우고 머리를 보호하여 부상을 막고, 옆으로 눕혀 회복 자세로 기도를 확보한다. 발작 시작 시각을 확인하여 5분 이상 지속되거나 반복되거나 호흡 곤란이 있으면 119에 신고한다. 따라서 3번 보기가 가장 적절한 대처이다.\",\"w\":{\"1\":\"발작 중 입에 설압자나 손수건을 넣으면 치아 손상과 기도 폐쇄 위험이 있다. 기도 확보는 옆으로 눕히는 방법으로 한다.\",\"2\":\"경련하는 팔다리를 붙잡아 억제하면 골절 등 부상 위험이 있다. 움직임을 막지 말고 주변 위험물을 치워야 한다.\",\"4\":\"의식이 불분명한 상태에서 물을 마시게 하면 흡인 위험이 있다. 의식이 회복될 때까지 입으로 아무것도 주지 않는다.\",\"5\":\"발작 후에는 회기를 중단하고 보호자에게 즉시 알리며 기록을 남겨야 한다. 회기를 바로 재개하고 회기 후에 알리는 것은 부적절하다.\"}},\"1-3-2-59\":{\"p\":\"표준주의 원칙에 따라 회기 전후와 구강 접촉 도구를 다룬 뒤의 손위생(ㄱ), 아동이 입에 넣는 장난감의 회기별 세척·소독 후 재사용(ㄴ), 수족구병 등 전염성 질환의 전염 가능 기간 동안 회기 연기(ㄹ)는 옳은 지침이다. 반면 설압자 같은 구강 접촉 일회용품은 소독하더라도 다른 아동에게 재사용해서는 안 되므로 ㄷ은 틀렸다. 따라서 옳은 것은 ㄱ, ㄴ, ㄹ이다.\",\"w\":{\"1\":\"ㄱ, ㄴ은 옳지만 전염성 질환 아동의 회기 연기(ㄹ)도 옳은 지침인데 빠졌다.\",\"2\":\"일회용품을 소독 후 재사용할 수 있다는 ㄷ은 틀린 지침이다. 또한 옳은 지침인 ㄴ과 ㄹ이 빠졌다.\",\"3\":\"틀린 지침인 ㄷ을 포함했고, 가장 기본적인 손위생 지침인 ㄱ이 빠졌다.\",\"5\":\"설압자 등 일회용품은 소독하더라도 재사용해서는 안 되므로 ㄷ을 포함한 이 조합은 틀렸다.\"}},\"1-3-2-60\":{\"w\":{\"2\":\"특수교육대상자 선정은 장애인 등록 여부와 별개이다. 등록하지 않은 아동도 진단·평가를 거쳐 선정될 수 있다.\",\"3\":\"치료지원은 배치 형태와 관계없이 특수교육대상자에게 제공되는 관련서비스이다. 일반학급이나 특수학급에 배치되어도 받을 수 있다.\",\"4\":\"특수교육대상자 선정에는 특수교육지원센터의 진단·평가와 특수교육운영위원회 심사라는 절차가 필요하다. 담임교사 단독 판단으로 치료지원이 제공되지 않는다.\",\"5\":\"발달재활서비스는 특수교육법상 학교 치료지원과 별개의 제도이다. 이를 이용 중이라고 해서 선정 절차 없이 학교 치료지원이 자동 연계되지 않는다.\"}},\"1-3-2-61\":{\"w\":{\"1\":\"후천적 원인은 장애가 고착된 뒤, 원칙적으로 발병 후 6개월 이상 치료한 뒤에 판정한다. 발병 즉시 언어검사 결과만으로 판정할 수 없다.\",\"2\":\"장애진단서는 의료기관의 전문의가 작성한다. 언어재활사는 검사 결과와 소견을 제공할 수 있으나 진단서를 작성할 수 없다.\",\"3\":\"장애 심사는 국민건강보험공단이 아니라 국민연금공단이 담당한다.\",\"4\":\"실어증은 언어장애 판정 대상에 포함된다. 등록할 수 없다는 안내는 틀렸다.\"}},\"1-3-2-62\":{\"w\":{\"2\":\"목표 A는 이미 준거를 충족했으므로 5회기 더 반복하는 것은 회기 낭비이다. 6회기째 정체된 목표 B를 그대로 유지하는 것도 자료에 반한다.\",\"3\":\"목표 A를 종결만 하고 상위 수준으로 나아가지 않는 것은 다음 목표를 놓친다. 목표 B를 삭제하면 아동에게 필요한 요구하기 기술을 방치하게 된다.\",\"4\":\"목표 B는 2어절 수준에서도 30~40%에 정체되어 있으므로 3어절로 상향하면 더 어려워진다. 절차를 세분화해야 할 상황에서 반대로 결정한 것이다.\",\"5\":\"목표 A는 준거를 충족했고 목표 B는 6회기 동안 정체되었으므로 이미 결정에 필요한 자료가 있다. 현재 절차를 그대로 유지하는 것은 자료에 반한다.\"}},\"1-3-2-63\":{\"p\":\"환자는 '어차피 병은 진행하는데 해봤자 소용없다'며 거부하지만, 손주와 전화 통화가 어려워진 것을 속상해한다는 점에서 변화에 대한 양가감정이 드러난다. 치료 동기가 낮은 성인에게는 공감·반영적 경청, 양가감정 탐색, 개인이 중요하게 여기는 목표와의 연결, 허락 후 정보 제공, 자율성 존중이라는 동기강화상담 원리가 적합하다. 따라서 손주와의 통화라는 목표와 치료를 연결하되 최종 결정은 환자에게 맡기는 접근이 가장 적절하다.\",\"w\":{\"1\":\"보호자를 통해 매일 강하게 권하는 것은 압박이 되어 저항을 키운다. 환자의 자기결정권도 침해한다.\",\"2\":\"거부 의사를 존중하는 것은 필요하지만 즉시 종결하면 양가감정을 다룰 기회를 놓친다. 환자가 중요하게 여기는 목표가 있으므로 탐색할 여지가 있다.\",\"3\":\"겁을 주어 동기를 높이려는 방식은 저항을 키우고 신뢰 관계를 해친다. 동기강화상담의 원리와 반대이다.\",\"5\":\"환자 모르게 보호자와 일정을 정하는 것은 환자를 의사결정에서 배제하여 자기결정권을 침해한다. 저항도 오히려 커진다.\"}},\"1-3-2-64\":{\"p\":\"임상 기록은 법적 문서이므로 수정할 때 원 기록의 흔적을 남겨야 한다. 오류 부분에 한 줄을 긋고 바른 내용, 수정 일자, 서명(필요하면 사유)을 적으면 누가 언제 무엇을 고쳤는지 추적할 수 있다. 이틀 뒤에 발견한 오류라도 같은 방식으로 수정하며, 전자기록도 수정 이력이 남도록 처리한다.\",\"w\":{\"1\":\"수정액으로 원 기록을 완전히 지우면 무엇이 바뀌었는지 추적할 수 없어 기록 위·변조 의혹을 낳는다.\",\"3\":\"페이지를 새로 작성하고 원본을 파기하면 원 기록이 사라져 위·변조 의혹을 낳는다. 원본은 흔적을 남긴 채 보존해야 한다.\",\"4\":\"구두 보고만으로는 기록 자체의 오류가 그대로 남는다. 기록의 정확성을 확보하려면 원 기록을 정해진 방식으로 수정해야 한다.\",\"5\":\"이전 기록의 오류를 그대로 두면 해당 회기 기록이 계속 틀린 채로 남는다. 다음 회기 기록에 적는 것으로는 정확성을 확보하지 못한다.\"}},\"1-3-2-65\":{\"p\":\"치료자가 자신의 내담자를 연구 대상으로 삼으면 치료 관계에서 오는 강압 가능성이 크다. 따라서 IRB 심의를 받고, 보호자 동의와 함께 아동 연령에 맞는 승낙을 받아야 한다. 또한 참여하지 않거나 중간에 철회해도 치료에 불이익이 없음을 보장해야 자발적 참여가 확보된다.\",\"w\":{\"1\":\"치료와 연구는 구별되므로 자신의 내담자라도 연구 참여에는 별도 동의가 필요하다. 동의를 생략하면 자발성을 침해한다.\",\"2\":\"미성년자라도 연령에 맞는 방식으로 아동 본인의 참여 의사(승낙)를 확인해야 한다. 보호자 동의만으로 아동의 의사를 무시해서는 안 된다.\",\"4\":\"참여 거부 시 치료 종결을 언급하는 것은 위협으로 작용하여 자발성을 침해한다. 불참해도 불이익이 없음을 알려야 한다.\",\"5\":\"참여 아동에게만 무료 추가 회기를 주는 것은 부당한 유인에 해당한다. 참여 결정이 자발적 판단이 아닌 이익에 좌우될 수 있다.\"}},\"1-3-2-66\":{\"w\":{\"1\":\"영업의 자유가 있더라도 허위·과장 광고까지 정당화되지는 않는다. 전문가로서 지켜야 할 정직성 윤리가 우선한다.\",\"2\":\"치료 결과는 대상자마다 다르므로 결과를 보장하는 것은 자신감의 표현이 아니라 소비자를 오인하게 하는 약속이다.\",\"3\":\"완치 사례가 1건 있더라도 모든 내담자에게 완치를 보장할 근거가 되지 않는다. 단일 사례로 일반화한 과장이다.\",\"4\":\"실명 후기를 게시하면 광고의 문제가 해결되지 않을 뿐 아니라 내담자 비밀유지 문제가 추가로 생긴다.\"}},\"1-3-2-67\":{\"w\":{\"1\":\"한국어에 능숙하더라도 8세 아동에게 통역을 맡기면 정보 왜곡과 정서적 부담, 가족 역할 혼란이 생긴다. 훈련된 통역사를 이용해야 한다.\",\"2\":\"번역 앱으로 결과지만 전달하고 질문을 받지 않으면 어머니가 결과를 정확히 이해하고 의견을 나눌 기회가 없다. 정보 접근권에 어긋난다.\",\"3\":\"크게 말한다고 언어 장벽이 해결되지 않는다. 한국어가 서툰 어머니는 평가 결과를 정확히 이해하기 어렵다.\",\"4\":\"어머니를 설명과 의사결정에서 배제하는 것은 정보 접근권과 가족중심 원칙에 어긋난다. 통역을 통해 어머니에게 직접 설명해야 한다.\"}},\"1-3-2-68\":{\"p\":\"ICF에서 문장 수준 말명료도 55%(㉠)는 음성·말 기능의 손상이므로 신체기능에 해당한다. 모둠 토론에서 발표를 전혀 하지 않는 것(㉡)은 학교라는 생활 상황에 관여하는 데의 제한이므로 참여에 해당한다. 소음이 큰 교실과 또래의 놀림(㉢)은 물리적 환경과 타인의 태도이므로 환경요인이고, 실패를 걱정해 말하기를 피하는 성향(㉣)은 성격·대처 방식 같은 개인의 특성이므로 개인요인이다.\",\"w\":{\"1\":\"말명료도(㉠)는 활동이 아니라 신체기능이고, 발표 회피(㉡)는 신체기능이 아니라 참여이다. 개인의 성향(㉣)도 참여가 아니라 개인요인이다.\",\"2\":\"㉠과 ㉡의 분류는 맞지만 환경요인과 개인요인을 서로 바꾸었다. 교실 소음과 또래의 놀림(㉢)은 환경요인, 말하기 회피 성향(㉣)은 개인요인이다.\",\"4\":\"말명료도 저하는 신체구조가 아니라 기능의 손상이다. 또래 놀림과 소음(㉢)은 환경요인, 회피 성향(㉣)은 개인요인이어서 두 분류도 틀렸다.\",\"5\":\"말명료도(㉠)를 참여로, 모둠 토론 발표 회피(㉡)를 활동으로, 개인의 성향(㉣)을 신체기능으로 분류하여 신체기능·활동·참여를 뒤섞었다.\"}}};\n</script>\n<script>\n// ═════════ 상태 ═════════\nlet Q = [];                  // 이번 시험 문항\nlet answers = [], checks = [], memos = [], strikes = [];\nlet page = 0, perPage = 1, filter = 'all', fontScale = 1;\nlet limitSec = 0, remainSec = 0, timerId = null, warned = false, warned10 = false;\nlet paused = false, pauseCount = 0, accPauses = 0;\nlet awaitEnd = false, submitRemain = null;   // 제출 완료 창이 떠 있는지 · 마지막으로 제출할 때 남은 시간   // 일시정지 중인지 · 이번 교시 횟수 · 앞 교시까지 합계\nlet memoTarget = -1, submitted = false, startedAt = null;\nlet hlStore = {}, penMode = 'off';   // 형광펜: 하이라이트 저장소 + 모드(off/on)\n\nconst $ = id => document.getElementById(id);\nconst show = id => $(id).classList.remove('hidden');\nconst hide = id => $(id).classList.add('hidden');\n// 문항 이미지 크게 보기(팝업)\n// 떠 있는 창(메모·계산기·그림판·이미지): 누른 창을 맨 위로\nfunction raiseWin(win){ document.querySelectorAll('.float-win').forEach(w => w.style.zIndex = ''); win.style.zIndex = 75; }\ndocument.addEventListener('mousedown', e => { const w = e.target.closest && e.target.closest('.float-win'); if(w) raiseWin(w); }, true);\nfunction fitImgWin(){\n  const win = $('imgWin'), img = $('lbImg'), vw = innerWidth, vh = innerHeight;\n  if(vw < 700){ Object.assign(win.style, {left:'0px', top:'0px', width:vw+'px', height:vh+'px'}); return; }\n  const head = win.querySelector('.fw-head').offsetHeight || 40, pad = 16;\n  const nw = img.naturalWidth || 800, nh = img.naturalHeight || 500;\n  let bw = Math.min(nw, vw*0.8 - pad), bh = bw * nh / nw;\n  const maxBh = vh*0.8 - head - pad;\n  if(bh > maxBh){ bh = maxBh; bw = bh * nw / nh; }\n  const w = Math.max(320, bw + pad), h = Math.max(200, bh + head + pad);\n  Object.assign(win.style, {width:w+'px', height:h+'px', left:Math.round((vw-w)/2)+'px', top:Math.round((vh-h)/2)+'px', right:'auto', bottom:'auto'});\n}\nfunction openImg(src){\n  const win = $('imgWin'), img = $('lbImg'), wasOpen = !win.classList.contains('hidden');\n  img.onload = () => { if(!wasOpen) fitImgWin(); };\n  img.src = src;\n  show('imgWin'); raiseWin(win);\n  if(!wasOpen && img.complete && img.naturalWidth) fitImgWin();\n}\nfunction closeImg(){ hide('imgWin'); $('lbImg').removeAttribute('src'); }\ndocument.addEventListener('keydown', e => { if(e.key==='Escape' && !$('imgWin').classList.contains('hidden')) closeImg(); });\naddEventListener('resize', () => { if(!$('imgWin').classList.contains('hidden') && innerWidth < 700) fitImgWin(); });\nconst circled = i => ['①','②','③','④','⑤'][i];\n// 해설 + 상세해설. 상세해설(details.js, 키 = 급수-회차-교시-번호)이 있는 문항에만 버튼이 붙는다.\n// 정답 근거가 해설과 거의 겹치는 문항은 details.js에 p가 없어서 오답 점검만 보인다.\n// 펼침 상태는 이 기기에 기억해서 다음 문항·다음 접속에도 그대로 둔다.\ntry{ if(localStorage.getItem('kcbt_show_detail')==='1') document.documentElement.classList.add('show-detail'); }catch(e){}\nfunction toggleDetail(){\n  const on = document.documentElement.classList.toggle('show-detail');\n  try{ localStorage.setItem('kcbt_show_detail', on ? '1' : '0'); }catch(e){}\n}\nfunction explainHTML(q, k){\n  const base = q.explain ? `<div class=\"rv-explain\"><b>해설</b> · ${esc(q.explain)}</div>` : '';\n  const d = k && (window.DETAILS || {})[k];\n  if(!d) return base;\n  const wr = Object.keys(d.w).sort().map(n => `<li>${circled(n - 1)} ${esc(d.w[n])}</li>`).join('');\n  return base + `<div class=\"rv-dbtn-row\"><button type=\"button\" class=\"wbtn rv-dbtn\" onclick=\"toggleDetail()\"><span class=\"d-open\">상세해설 보기 ▾</span><span class=\"d-close\">상세해설 접기 ▴</span></button></div>`\n    + `<div class=\"rv-detail\">${d.p ? `<div class=\"rv-dt\"><b>정답 근거</b> · ${esc(d.p)}</div>` : ''}<div><b>오답 점검</b><ul>${wr}</ul></div></div>`;\n}\n\n// ═════════ 시작 화면 ═════════\n// 급수(1급/2급)별 시험 구조. 급수 → 회차(set) → 교시(session) 순으로 선택한다.\n// 문항 데이터에 존재하는 급수·회차만 버튼으로 노출하고, 1개뿐이면 그 선택 UI는 숨긴다.\n// 2급 실제 구조: 1교시 신경언어30·유창성25·음성25(80) / 2교시 언어발달35·조음음운35(70) = 150문항(현장실무 없음).\nconst GRADE_META = {\n  1: { title: '1급 언어재활사 모의 CBT',\n       sess: { 1: { label: '1교시 (신경언어·언어발달·유창성)', min: 75 },\n               2: { label: '2교시 (음성·조음음운·현장실무)', min: 70 } } },\n  2: { title: '2급 언어재활사 모의 CBT',\n       sess: { 1: { label: '1교시 (신경언어·유창성·음성)', min: 75 },\n               2: { label: '2교시 (언어발달·조음음운)', min: 65 } } },\n};\nlet chosenGrade = 1, chosenSet = 1, chosenSess = 1;\n\nconst qGrade = q => q.grade || 1;\nconst qSet   = q => q.set   || 1;\n// HIDDEN_SETS(questions.js)에 적힌 급수/회차는 앱에서 보이지 않게 한다(비공개 세트).\nconst isHidden = q => (window.HIDDEN_SETS || []).some(h => h.grade === qGrade(q) && h.set === qSet(q));\nconst VIS = () => QUESTIONS.filter(q => !isHidden(q));\nfunction availableGrades(){ return Array.from(new Set(VIS().map(qGrade))).sort((a,b)=>a-b); }\nfunction availableSets(g){ return Array.from(new Set(VIS().filter(q=>qGrade(q)===g).map(qSet))).sort((a,b)=>a-b); }\nfunction availableSessions(){ return [1,2].filter(s => VIS().some(q=>qGrade(q)===chosenGrade && qSet(q)===chosenSet && q.session===s)); }\nfunction gradeMeta(){ return GRADE_META[chosenGrade] || GRADE_META[1]; }\nfunction sessMeta(s){ return gradeMeta().sess[s] || { label: s+'교시', min: 70 }; }\n\nfunction poolFor(s){ return VIS().filter(q => q.session===s && qGrade(q)===chosenGrade && qSet(q)===chosenSet); }\nfunction minutesFor(s){ return sessMeta(s).min; }\n// 선택한 교시부터 진행, 끝나면 나머지 교시 이어풀기 — 존재하는 교시 기준으로 큐 구성.\nfunction sessionQueueFrom(s){ const av = availableSessions(); return s===av[0] ? av.slice() : av.slice().reverse(); }\nfunction setLabel(){ return availableSets(chosenGrade).length > 1 ? ` ${chosenSet}회차` : ''; }\nfunction examTitle(){ return gradeMeta().title; }\n\n// 급수·회차·교시 버튼을 데이터에 맞춰 다시 그린다.\nfunction renderStartSelectors(){\n  const grades = availableGrades();\n  if(!grades.includes(chosenGrade)) chosenGrade = grades[0] || 1;\n  const gRow=$('gradeRow'), gBox=$('gradeBtns');\n  if(grades.length <= 1){ if(gRow) gRow.style.display='none'; }\n  else if(gRow && gBox){\n    gRow.style.display='';\n    gBox.innerHTML = grades.map(g=>`<button class=\"sess-btn${g===chosenGrade?' active':''}\" data-grade=\"${g}\">${g}급</button>`).join(' ');\n    gBox.querySelectorAll('button').forEach(b=>b.onclick=()=>{\n      chosenGrade=+b.dataset.grade; chosenSet=availableSets(chosenGrade)[0]||1; renderStartSelectors();\n    });\n  }\n  const sets = availableSets(chosenGrade);\n  if(!sets.includes(chosenSet)) chosenSet = sets[0] || 1;\n  const sRow=$('setRow'), sBox=$('setBtns');\n  if(sets.length <= 1){ if(sRow) sRow.style.display='none'; }\n  else if(sRow && sBox){\n    sRow.style.display='';\n    sBox.innerHTML = sets.map(s=>`<button class=\"sess-btn${s===chosenSet?' active':''}\" data-set=\"${s}\">${s}회차</button>`).join(' ');\n    sBox.querySelectorAll('button').forEach(b=>b.onclick=()=>{ chosenSet=+b.dataset.set; renderStartSelectors(); });\n  }\n  const av = availableSessions();\n  if(!av.includes(chosenSess)) chosenSess = av[0] || 1;\n  const seBox=$('sessBtns');\n  if(seBox){\n    seBox.innerHTML = av.map(s=>`<button class=\"sess-btn${s===chosenSess?' active':''}\" data-sess=\"${s}\">${sessMeta(s).label}</button>`).join(' ');\n    seBox.querySelectorAll('button').forEach(b=>b.onclick=()=>{ chosenSess=+b.dataset.sess; renderStartSelectors(); });\n  }\n  updateStartInfo();\n}\nfunction updateStartInfo(){\n  const other = availableSessions().find(x=>x!==chosenSess);\n  $('stTitle').textContent = examTitle() + setLabel() + ` ${chosenSess}교시`;\n  const tail = other ? ` · 제출 후 ${other}교시 이어풀기 선택` : '';\n  $('stTime').textContent = `${poolFor(chosenSess).length}문항 / ${minutesFor(chosenSess)}분${tail}`;\n}\nfunction tickClock(){\n  const d = new Date();\n  const nd = $('nowDate'), nt = $('nowTime');\n  if(nd) nd.textContent = d.toLocaleDateString('ko-KR');\n  if(nt) nt.textContent = d.toLocaleTimeString('ko-KR', {hour12:false});\n}\nsetInterval(tickClock, 1000); tickClock();\n$('stDate').textContent = new Date().toLocaleDateString('ko-KR');\nrenderStartSelectors();\n\n// ═════════ 로그인 · 기기 바인딩 (베타) ═════════\n// 각 계정(slp01~)은 최초 로그인한 기기 1대에서만 사용 가능.\n// deviceId: 이 브라우저에 저장되는 임의 식별자. Firestore users/{uid}.device 와 일치해야 입장.\nconst EMAIL_DOMAIN = '@kcbt.test';           // slp01 → slp01@kcbt.test (실제로 발송되지 않는 가짜 도메인)\nlet fbAuth = null, fbDb = null, CURRENT_ID = null, loginInProgress = false;\n\n// 체험 계정 제한 — users/{uid}.plan 이 'set1'이면 체험판 사이트에서만 쓸 수 있고,\n// users/{uid}.trialGrade(1 또는 2) 에 적힌 급수의 체험판 사이트에서만 입장된다.\n// 체험판 사이트는 자기 Firebase 설정 파일에서 IS_TRIAL_SITE=true, TRIAL_GRADE=급수 를 켠다.\nconst TRIAL_SITE = !!window.IS_TRIAL_SITE;\nconst TRIAL_GRADE = +(window.TRIAL_GRADE || 1);\nconst TRIAL_URLS = { 1: 'cbt1.sososoop.com', 2: 'cbt2.sososoop.com' };\nfunction trialGradeOf(data){ return +((data && data.trialGrade) || 1); }   // 없으면 1급(기존 계정 호환)\n// users/{uid}.trialEnd('YYYY-MM-DD')가 있으면 그날 밤 12시(한국 시간)까지만 입장된다.\n// 값이 있는데 형식이 이상하면 끝난 것으로 본다(잘못 적힌 값 때문에 기한 없이 열리지 않게).\nfunction trialEnded(data){\n  const raw = (data && data.trialEnd) || '';\n  if(!raw) return false;\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(raw));\n  if(!m) return true;\n  const end = Date.parse(m[1] + '-' + m[2] + '-' + m[3] + 'T23:59:59+09:00');\n  return !(end > 0) || Date.now() > end;\n}\n// 들어갈 수 있는 계정을 허용 목록으로 판단한다(2026-09-30). 모르는 값이면 막는다.\n//  - 체험 사이트(cbt1·cbt2): 체험 계정(plan 'set1')이면서 끝나는 날이 적혀 있고 급수가 맞아야 한다. 베타(slp) 계정은 못 들어온다.\n//  - 그 밖(베타 앱): plan이 없는 베타 계정만. 체험 계정이나 모르는 plan 값은 막는다.\n// ⚠️ 날짜는 이용자 기기 시계로 비교한다. 서버 없는 정적 사이트라 시계를 돌리면 우회할 수 있다(알려진 한계).\nfunction planBlocked(data){\n  if(!data) return true;                                    // 계정 정보가 없으면 막는다\n  if(trialEnded(data)) return true;                         // 끝나는 날이 지남(체험·베타 계정 모두)\n  if(TRIAL_SITE) return data.plan !== 'set1' || !data.trialEnd || trialGradeOf(data) !== TRIAL_GRADE;\n  return data.plan != null;                                 // 베타 앱: plan 없는 베타 계정만\n}\nfunction planBlockMsg(data){\n  if(!data) return '계정 정보를 찾을 수 없어요.\\n소소숲 카카오톡 채널로 문의해 주세요.';\n  if(TRIAL_SITE && data.plan !== 'set1') return '이 사이트는 체험 계정(cbt로 시작하는 아이디) 전용이에요.';\n  if(TRIAL_SITE && !data.trialEnd) return '체험 기간이 아직 정해지지 않은 계정이에요.\\n소소숲 카카오톡 채널로 문의해 주세요.';\n  if(!TRIAL_SITE && data.plan != null && data.plan !== 'set1') return '이 사이트에서 쓸 수 없는 계정이에요.';\n  if(data.trialEnd && !/^\\d{4}-\\d{2}-\\d{2}$/.test(String(data.trialEnd))) return '이용 기간 정보가 잘못 적힌 계정이에요.\\n소소숲 카카오톡 채널로 문의해 주세요.';\n  if(trialEnded(data)){\n    return formatExtendDate(data.trialEnd) + '로 ' + (data.plan === 'set1' ? '체험' : '베타 이용') + ' 기간이 끝났어요.\\n이용해 주셔서 감사합니다. 🌿';\n  }\n  const g = trialGradeOf(data);\n  return '이 계정은 ' + g + '급 1회차 체험판 전용입니다.\\n' + (TRIAL_URLS[g] || TRIAL_URLS[1]) + ' 으로 접속해 주세요.';\n}\nif(TRIAL_SITE){\n  const _s = $('agSub'), _i = $('agId');\n  if(_s) _s.textContent = TRIAL_GRADE + '급 1회차 체험판 · 발급받은 계정으로 로그인해 주세요';\n  if(_i) _i.placeholder = '예: cbt01';\n}\n\nfunction getDeviceId(){\n  let d = localStorage.getItem('kcbt_device_id');\n  if(!d){\n    d = (window.crypto && crypto.randomUUID) ? crypto.randomUUID()\n        : 'dev-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2);\n    localStorage.setItem('kcbt_device_id', d);\n  }\n  return d;\n}\nfunction agShowErr(msg){ $('agErr').textContent = msg || ''; }\nfunction enterApp(id, extendedUntil){\n  CURRENT_ID = id;\n  hide('authGate');\n  if(SHOW_HOME){ renderHome(); show('homeScreen'); show('homeBackBtn'); } else show('startScreen');\n  setTimeout(checkResume, 0);   // 풀던 시험이 있으면 이어 풀기 안내(정식판·베타). 스크립트를 다 읽은 뒤에 확인\n  // 설문 참여로 연장된 계정 → 접속 시 안내 팝업(브라우저 세션당 1회)\n  if(extendedUntil && !sessionStorage.getItem('kcbt_extend_notice_shown')){\n    const el = $('extendUntilText');\n    if(el) el.textContent = formatExtendDate(extendedUntil);\n    show('extendOverlay');\n    try{ sessionStorage.setItem('kcbt_extend_notice_shown', '1'); }catch(e){}\n  }\n}\n// ═════════ 대문(첫 화면) ═════════\n// 소소숲 번들 빌드가 window.SHOW_HOME=true 를 넣는다. 베타·체험판은 대문 없이 바로 응시 정보 입력.\nconst SHOW_HOME = !!window.SHOW_HOME;\n// 제15회(2026) 국시원 공고 기준. 다음 회차 공고가 나오면 이 블록만 고친다.\nconst EXAM_INFO = {\n  round: '2026년도 제15회',\n  exam: '2026-12-05',\n  result: '2026-12-23',\n  schedule: [\n    ['응시원서 접수', '2026-09-02', '2026-09-09', '9. 2.(수) ~ 9. 9.(수)', '국시원 홈페이지 인터넷 접수'],\n    ['시험장 공고 · 선택', '2026-11-04', '2026-11-08', '11. 4.(수) ~ 11. 8.(일)', '본인이 시험장을 직접 선택'],\n    ['응시표 출력', '2026-11-11', '2026-12-05', '11. 11.(수)부터', '시험 당일 아침까지 출력 가능'],\n    ['시험 시행', '2026-12-05', '2026-12-05', '12. 5.(토)', '1급·2급 컴퓨터시험(CBT)'],\n    ['최종합격자 발표', '2026-12-23', '2026-12-23', '12. 23.(수)', '국시원 홈페이지 [합격자조회]'],\n  ],\n  timetable: {\n    1: [['1교시', '신경언어장애 24 · 언어발달장애 24 · 유창성장애 24', 72, '13:30까지', '14:00 ~ 15:15 (75분)'],\n        ['2교시', '음성장애 24 · 조음음운장애 24 · 언어재활현장실무 20', 68, '15:40까지', '15:50 ~ 17:00 (70분)']],\n    2: [['1교시', '신경언어장애 30 · 유창성장애 25 · 음성장애 25', 80, '08:30까지', '09:00 ~ 10:15 (75분)'],\n        ['2교시', '언어발달장애 35 · 조음음운장애 35', 70, '10:40까지', '10:50 ~ 11:55 (65분)']],\n  },\n};\n// 한국 시간 기준 오늘 날짜(YYYY-MM-DD)\nfunction kstToday(){\n  const d = new Date(Date.now() + 9*3600*1000);\n  return d.toISOString().slice(0,10);\n}\nfunction dayDiff(a, b){ return Math.round((Date.parse(b) - Date.parse(a)) / 86400000); }\nfunction renderHome(){\n  const today = kstToday();\n  const toExam = dayDiff(today, EXAM_INFO.exam);\n  const toResult = dayDiff(today, EXAM_INFO.result);\n  const [, tm, td] = today.split('-');\n  $('hmToday').textContent = `오늘 ${parseInt(tm,10)}월 ${parseInt(td,10)}일 기준`;\n  if(toExam > 0){\n    $('hmDday').textContent = 'D-' + toExam;\n  } else if(toExam === 0){\n    $('hmDday').textContent = 'D-DAY';\n    $('hmHeadline').innerHTML = '오늘이 시험일이에요<br>차분하게, 연습한 대로!';\n  } else if(toResult >= 0){\n    $('hmDday').parentNode.querySelector('small').textContent = '합격자 발표까지';\n    $('hmDday').textContent = toResult === 0 ? 'D-DAY' : 'D-' + toResult;\n    $('hmHeadline').innerHTML = '시험 수고 많으셨어요<br>합격자 발표는 12월 23일(수)입니다';\n  } else {\n    // 발표까지 끝나면 다음 회차 공고 전까지 일정 대신 안내만 띄운다\n    $('hmDdayBox').classList.add('hidden');\n    $('hmScheduleCard').classList.add('hidden');\n    $('hmKicker').textContent = '언어재활사 국가시험';\n    $('hmHeadline').innerHTML = '다음 시험 일정은<br>국시원 공고 후 안내해 드릴게요';\n  }\n  let nextMarked = false;\n  $('hmSchedule').innerHTML =\n    '<tr><th>구분</th><th>일정</th><th>비고</th><th style=\"text-align:center;\">상태</th></tr>' +\n    EXAM_INFO.schedule.map(([name, from, to, label, note]) => {\n      let cls = '', tag;\n      if(today > to){ cls = 'is-done'; tag = '<span class=\"home-tag done\">완료</span>'; }\n      else if(today >= from){ cls = 'is-next'; nextMarked = true; tag = '<span class=\"home-tag now\">진행 중</span>'; }\n      else if(!nextMarked){ cls = 'is-next'; nextMarked = true; tag = '<span class=\"home-tag next\">다음 일정</span>'; }\n      else tag = '<span class=\"home-tag plan\">예정</span>';\n      return `<tr class=\"${cls}\"><th>${name}</th><td>${label}</td><td>${note}</td><td class=\"num\">${tag}</td></tr>`;\n    }).join('');\n  homeGrade(1);\n  renderStudyCard();\n}\nfunction homeGrade(g){\n  document.querySelectorAll('.home-grade-tabs button').forEach(b => b.classList.toggle('active', b.dataset.hg == g));\n  const rows = EXAM_INFO.timetable[g];\n  $('hmTimetable').innerHTML =\n    '<tr><th>교시</th><th>시험과목(문항 수)</th><th style=\"text-align:center;\">문항</th><th style=\"text-align:center;\">입장 마감</th><th style=\"text-align:center;\">시험시간</th></tr>' +\n    rows.map(([s, subj, n, enter, time]) =>\n      `<tr><th>${s}</th><td>${subj}</td><td class=\"num\">${n}</td><td class=\"num\">${enter}</td><td class=\"num\">${time}</td></tr>`).join('');\n  const total = rows.reduce((a, r) => a + r[2], 0);\n  $('hmTimeNote').textContent = `※ ${g}급 총 ${total}문항 · ${g === 1 ? '1교시 오후 2시' : '1교시 오전 9시'} 시작. 이 연습앱의 제한시간도 위 시간표와 같아요.`;\n}\nfunction goStart(){ hide('homeScreen'); show('startScreen'); }\nfunction backToHome(){ hide('startScreen'); renderHome(); show('homeScreen'); }\n\n// ═════════ 내 학습 기록(오답노트·응시 기록) — 소소숲 정식판 전용 ═════════\n// 대문과 같은 플래그(SHOW_HOME)로 켠다. 베타·체험판은 꺼진 채로 지금과 똑같이 동작한다.\n// 이 기기의 localStorage에만 계정별로 저장한다. 소소숲 app 라우트가 window.STUDY_USER(회원 id)를 넣어 준다.\n// 문항 키 = 급수-회차-교시-번호(\"1-2-1-37\"). 검수 때 쓰는 \"N교시 N번\"과 같은 기준이라\n// 회차 안에서 문항 순서를 바꾸거나 중간에 끼워 넣으면 기록이 다른 문항을 가리키게 된다.\nconst STUDY_ON = SHOW_HOME;\nconst STUDY_MAX_ATTEMPTS = 50;\nlet drillMode = false, studyRecorded = false;\nlet studyTab = 'wrong', studyGrade = 0, studySubj = '', studyOpenKey = {};\nlet studyArea = '', studyCat = '';   // 약점 그래프에서 누른 세부 영역·분류(오답 목록 거르기)\nconst Q_KEY = new Map(), KEY_Q = new Map();\n(function(){\n  const cnt = {};\n  QUESTIONS.forEach(q => {\n    const base = `${qGrade(q)}-${qSet(q)}-${q.session}`;\n    cnt[base] = (cnt[base] || 0) + 1;\n    const k = base + '-' + cnt[base];\n    Q_KEY.set(q, k);\n    if(!isHidden(q)) KEY_Q.set(k, q);\n  });\n})();\nconst keyParts = k => String(k).split('-').map(Number);          // [급수, 회차, 교시, 번호]\nfunction keyLabel(k){\n  if(!k) return '';\n  const [g, s, se, n] = keyParts(k);\n  return `${g}급 ${s}회차 ${se}교시 ${n}번`;\n}\nfunction keyCmp(a, b){ const x = keyParts(a), y = keyParts(b); for(let i = 0; i < 4; i++) if(x[i] !== y[i]) return x[i] - y[i]; return 0; }\nfunction escAttr(s){ return esc(String(s)).replace(/\"/g, '&quot;'); }\n// 한국 시간으로 'MM-DD' / 'MM-DD HH:mm'\nfunction kstStamp(ts, withTime){\n  const iso = new Date(ts + 9*3600*1000).toISOString();\n  return iso.slice(5, 10) + (withTime ? ' ' + iso.slice(11, 16) : '');\n}\nconst pctOf = (ok, n) => n ? Math.round(ok / n * 100) : 0;\n\nfunction studyStoreKey(){ return 'kcbt_study_v1_' + (window.STUDY_USER || CURRENT_ID || 'local'); }\nfunction loadStudy(){\n  try{\n    const d = JSON.parse(localStorage.getItem(studyStoreKey()) || 'null');\n    if(d && Array.isArray(d.attempts) && d.wrong && typeof d.wrong === 'object') return d;\n  }catch(e){}\n  return { v: 1, attempts: [], wrong: {} };\n}\nfunction saveStudy(d){\n  try{ localStorage.setItem(studyStoreKey(), JSON.stringify(d)); return true; }\n  catch(e){ console.warn('[kcbt] 학습 기록 저장 실패', e); return false; }\n}\n\n// 채점 직후 1회 호출. 틀리거나 비운 문항은 오답노트에 담고, 맞힌 문항은 오답노트에서 뺀다.\n// 오답 다시 풀기(drillMode)는 응시 기록에 남기지 않는다(과목별 추이가 흐려지지 않게).\nfunction recordStudy(bySub, totalN, totalOk, pass, usedSec){\n  const d = loadStudy(), now = Date.now();\n  let wrongNow = 0, removed = 0;\n  Q.forEach((q, i) => {\n    if(!(q.answer >= 1 && q.answer <= 5)) return;\n    const k = Q_KEY.get(q); if(!k) return;\n    if(answers[i] === q.answer){\n      if(d.wrong[k]){ delete d.wrong[k]; removed++; }\n    } else {\n      const w = d.wrong[k] || { n: 0 };\n      w.n++; w.last = now; d.wrong[k] = w; wrongNow++;\n    }\n  });\n  let diffs = [];\n  if(!drillMode){\n    // 문항별 [푼 횟수, 틀린 횟수] — 오답노트 약점 그래프에 쓴다(오답 다시 풀기는 세지 않음)\n    d.items = d.items || {};\n    Q.forEach((q, i) => {\n      if(!(q.answer >= 1 && q.answer <= 5)) return;\n      const k = Q_KEY.get(q); if(!k) return;\n      const it = d.items[k] || [0, 0];\n      it[0]++; if(answers[i] !== q.answer) it[1]++;\n      d.items[k] = it;\n    });\n    const grade = qGrade(Q[0]);\n    const sub = {};\n    Object.entries(bySub).forEach(([s, v]) => { sub[s] = [v.ok, v.n]; });\n    diffs = Object.entries(sub).map(([s, [ok, n]]) => {\n      const prev = d.attempts.slice().reverse().find(a => a.grade === grade && a.sub && a.sub[s]);\n      return prev ? [s, pctOf(ok, n) - pctOf(prev.sub[s][0], prev.sub[s][1])] : null;\n    }).filter(Boolean);\n    d.attempts.push({\n      at: now, grade,\n      set: Array.from(new Set(Q.map(qSet))).join(','),\n      sess: Array.from(new Set(Q.map(q => q.session))),\n      n: totalN, ok: totalOk, pass, sec: usedSec, sub,\n    });\n    if(d.attempts.length > STUDY_MAX_ATTEMPTS) d.attempts = d.attempts.slice(-STUDY_MAX_ATTEMPTS);\n  }\n  const saved = saveStudy(d);\n  return { wrongNow, removed, remain: Object.keys(d.wrong).length, diffs, saved };\n}\n\n// 교시 일부만 푼 기록(합격 판정 없음). 09-30 이전 기록은 pass가 true/false로 남아 있어 푼 교시 수로도 가린다.\nfunction attemptPartial(a){\n  if(a.pass == null) return true;\n  const all = new Set(VIS().filter(q => qGrade(q) === a.grade).map(q => q.session)).size;\n  return (a.sess || []).length < all;\n}\nfunction attemptLabel(a){ return `${a.grade}급 ${a.set}회차 ${(a.sess || []).join('+')}교시`; }\n// 급수별 과목 순서(문항 데이터 순서 그대로)\nfunction subjectsOf(g){ return Array.from(new Set(VIS().filter(q => qGrade(q) === g).map(q => q.subject))); }\n// 과목별 최근 기록(오래된 → 최근, 최대 5회)과 최근 3회 평균\nfunction subjectTrend(d, g){\n  return subjectsOf(g).map(s => {\n    const pts = d.attempts.filter(a => a.grade === g && a.sub && a.sub[s])\n      .map(a => ({ at: a.at, set: a.set, ok: a.sub[s][0], n: a.sub[s][1], pct: pctOf(a.sub[s][0], a.sub[s][1]) }))\n      .slice(-5);\n    const last3 = pts.slice(-3);\n    const avg = last3.length ? Math.round(last3.reduce((t, p) => t + p.pct, 0) / last3.length) : null;\n    return { s, pts, avg, risk: avg === null ? '' : avg < 40 ? 'fail' : avg < 60 ? 'warn' : 'ok' };\n  });\n}\nconst RISK_TXT = { fail: '과락 위험', warn: '주의', ok: '안정' };\n\n// 대문 \"내 학습 기록\" 카드\nfunction renderStudyCard(){\n  if(!STUDY_ON) return;\n  const d = loadStudy(), card = $('hmStudyCard'), body = $('hmStudyBody');\n  card.classList.remove('hidden');\n  const nWrong = Object.keys(d.wrong).filter(k => KEY_Q.has(k)).length;\n  const btns = `<div class=\"hs-btns\">\n      <button class=\"wbtn\" onclick=\"openStudy('wrong')\">&#128213; 오답노트 <b>${nWrong}</b>문항</button>\n      <button class=\"wbtn\" onclick=\"openStudy('hist')\">&#128202; 응시 기록 보기</button></div>`;\n  if(!d.attempts.length){\n    body.innerHTML = `<div class=\"hs-empty\">아직 응시 기록이 없어요. 모의 CBT를 한 교시 이상 풀고 제출하면 <b>과목별 정답률</b>과 <b>틀린 문제</b>가 여기에 쌓여요.</div>` + btns;\n    return;\n  }\n  const last = d.attempts[d.attempts.length - 1];\n  const trend = subjectTrend(d, last.grade).filter(t => t.avg !== null);\n  const fails = trend.filter(t => t.risk === 'fail'), warns = trend.filter(t => t.risk === 'warn');\n  const riskLine = fails.length\n    ? `<span class=\"risk-tag fail\">과락 위험</span>` + fails.map(t => `${esc(t.s)} (최근 평균 ${t.avg}%)`).join(' · ')\n    : warns.length\n      ? `<span class=\"risk-tag warn\">주의</span>` + warns.map(t => `${esc(t.s)} (최근 평균 ${t.avg}%)`).join(' · ')\n      : `<span class=\"risk-tag ok\">안정</span>${last.grade}급 응시한 과목 모두 최근 평균 60% 이상이에요 👏`;\n  body.innerHTML =\n    `<div class=\"hs-line\">최근 응시 <b>${d.attempts.length}회</b> · 마지막 ${kstStamp(last.at)} (${attemptLabel(last)} <b>${pctOf(last.ok, last.n)}%</b>)</div>\n     <div class=\"hs-line\">${riskLine}</div>` + btns;\n}\n\nfunction openStudy(tab){\n  if(!STUDY_ON) return;\n  if(tab) studyTab = tab;\n  ['homeScreen', 'startScreen', 'resultScreen', 'examScreen'].forEach(hide);\n  show('studyScreen');\n  renderStudy();\n  $('studyScreen').scrollTop = 0; window.scrollTo(0, 0);\n}\nfunction closeStudy(){\n  hide('studyScreen');\n  if(SHOW_HOME){ renderHome(); show('homeScreen'); } else show('startScreen');\n}\nfunction renderStudy(){\n  document.querySelectorAll('.st-tabs button').forEach(b => b.classList.toggle('active', b.dataset.st === studyTab));\n  const d = loadStudy();\n  $('studyBody').innerHTML = studyTab === 'hist' ? histHTML(d) : wrongHTML(d);\n}\nfunction setStudyGrade(g){ studyGrade = g; studySubj = ''; studyArea = ''; studyCat = ''; renderStudy(); }\nfunction setStudySubj(s){ studySubj = s; studyArea = ''; studyCat = ''; renderStudy(); }\nfunction setStudyArea(a){ studyArea = studyArea === a ? '' : a; studyCat = ''; renderStudy(); }\nfunction setStudyCat(c){ studyCat = studyCat === c ? '' : c; studyArea = ''; renderStudy(); }\nfunction gradeFilterHTML(grades){\n  if(grades.length < 2) return '';\n  return `<div class=\"st-filter\"><span class=\"lbl\">급수</span>` +\n    grades.map(g => `<button class=\"${g === studyGrade ? 'active' : ''}\" onclick=\"setStudyGrade(${g})\">${g}급</button>`).join('') + `</div>`;\n}\nfunction pickStudyGrade(grades, d){\n  if(grades.includes(studyGrade)) return;\n  const last = d.attempts[d.attempts.length - 1];\n  studyGrade = last && grades.includes(last.grade) ? last.grade : (grades[0] || 1);\n}\n\n// ── 오답노트 ──\nfunction wrongEntries(d){\n  return Object.entries(d.wrong).map(([k, w]) => ({ k, w, q: KEY_Q.get(k) })).filter(x => x.q)\n    .sort((a, b) => keyCmp(a.k, b.k));\n}\nfunction filteredWrong(d){\n  return wrongEntries(d).filter(x => qGrade(x.q) === studyGrade && (!studySubj || x.q.subject === studySubj)\n    && (!studyArea || (x.q.tag && x.q.tag.a === studyArea)) && (!studyCat || (x.q.tag && x.q.tag.c === studyCat)));\n}\n// ── 약점 그래프 ── 문항별 풀이 기록(d.items)을 과목 → 분류·세부 영역으로 모은다.\nconst WK_MIN = 3;   // 푼 문항이 이보다 적으면 '아직 적음'(순위에서 뺌)\nfunction weakStats(d, g){\n  const out = {};\n  Object.entries(d.items || {}).forEach(([k, [seen, wrong]]) => {\n    const q = KEY_Q.get(k);\n    if(!q || qGrade(q) !== g || !q.tag) return;\n    const s = out[q.subject] = out[q.subject] || { area: {}, cat: {}, seen: 0 };\n    s.seen += seen;\n    [['area', q.tag.a], ['cat', q.tag.c]].forEach(([kind, name]) => {\n      const v = s[kind][name] = s[kind][name] || { seen: 0, wrong: 0 };\n      v.seen += seen; v.wrong += wrong;\n    });\n  });\n  return out;\n}\nfunction wkRows(names, bucket, onclick, active, countFew){\n  const rows = names.map(name => {\n    const v = bucket[name] || { seen: 0, wrong: 0 };\n    return { name, ...v, rate: v.seen ? v.wrong / v.seen : 0 };\n  });\n  const ranked = rows.filter(r => r.seen >= WK_MIN).sort((a, b) => b.rate - a.rate || b.wrong - a.wrong);\n  const hot = new Set(ranked.filter(r => r.wrong > 0).slice(0, 2).map(r => r.name));\n  const ordered = ranked.concat(rows.filter(r => r.seen < WK_MIN));\n  return ordered.map(r => {\n    const few = r.seen < WK_MIN;\n    const cls = ['wk-row', few ? 'few' : '', hot.has(r.name) ? 'hot' : '', onclick ? 'click' : '', active === r.name ? 'on' : ''].join(' ');\n    const val = few ? (countFew ? `${r.wrong}/${r.seen}` : r.seen ? `아직 적음 (${r.seen})` : '아직 없음') : `${r.wrong}/${r.seen} · ${Math.round(r.rate * 100)}%`;\n    const click = onclick ? ` onclick=\"${onclick}('${escAttr(r.name)}')\"` : '';\n    return `<div class=\"${cls}\"${click} title=\"${escAttr(r.name)}\"><span class=\"wk-lbl\">${esc(r.name)}</span><span class=\"wk-bar\"><i style=\"width:${few ? 0 : Math.round(r.rate * 100)}%\"></i></span><span class=\"wk-val\">${val}</span></div>`;\n  }).join('');\n}\nfunction weakHTML(d){\n  const st = weakStats(d, studyGrade);\n  const subs = subjectsOf(studyGrade).filter(s => TAG_AREAS[s]);\n  const any = subs.some(s => st[s] && st[s].seen);\n  const head = `<div class=\"home-card\"><div class=\"home-card-body\"><h2 style=\"margin:0 0 4px;font-size:16px;\">어디가 약한지 보기</h2>`;\n  if(!any){\n    return head + `<div class=\"hs-empty\">모의 CBT를 풀고 제출하면 과목마다 세부 영역별 오답률이 여기에 그래프로 쌓여요. (이 기능이 생긴 뒤에 푼 시험부터 셉니다)</div></div></div>`;\n  }\n  if(!studySubj){\n    const cards = subs.map(s => {\n      const v = st[s] || { area: {}, cat: {}, seen: 0 };\n      const cats = TAG_CATS.map(c => {\n        const x = v.cat[c];\n        return `${c.split('·')[0]} ${x && x.seen >= WK_MIN ? Math.round(x.wrong / x.seen * 100) + '%' : '–'}`;\n      }).join(' · ');\n      return `<div class=\"wk-card\"><h3><span>${esc(s)}</span><button onclick=\"setStudySubj('${escAttr(s)}')\">크게 보기</button></h3>\n        <div class=\"wk-cats\">오답률 · ${cats}</div>${wkRows(TAG_AREAS[s], v.area, '', '')}</div>`;\n    }).join('');\n    return head + `<div class=\"wk-note\" style=\"margin:0 0 10px;\">막대는 세부 영역별 오답률이에요. 가장 약한 영역은 빨간색, 푼 문항이 ${WK_MIN}개보다 적으면 회색으로 보여요.</div>\n      <div class=\"wk-grid\">${cards}</div></div></div>`;\n  }\n  const v = st[studySubj] || { area: {}, cat: {}, seen: 0 };\n  return head + `<div class=\"wk-big\">\n      <div class=\"wk-sub\">${esc(studySubj)} · 분류별 오답률</div>${wkRows(TAG_CATS, v.cat, 'setStudyCat', studyCat)}\n      <div class=\"wk-sub\">세부 영역별 오답률</div>${wkRows(TAG_AREAS[studySubj], v.area, 'setStudyArea', studyArea)}\n      <div class=\"wk-note\">막대를 누르면 아래 오답 목록이 그 영역 문항만 보이게 걸러져요. 다시 누르면 풀려요.</div>\n    </div></div></div>`;\n}\nfunction wrongHTML(d){\n  const all = wrongEntries(d);\n  if(!all.length){\n    return `<div class=\"home-card\"><div class=\"home-card-body\"><div class=\"hs-empty\" style=\"text-align:center;padding:18px 0;\">\n      &#127881; 오답노트가 비어 있어요.<br>모의 CBT를 풀고 제출하면 틀리거나 비워 둔 문제가 여기에 모여요.</div></div></div>`;\n  }\n  const grades = Array.from(new Set(all.map(x => qGrade(x.q)))).sort();\n  pickStudyGrade(grades, d);\n  const inGrade = all.filter(x => qGrade(x.q) === studyGrade);\n  const subjCnt = {};\n  inGrade.forEach(x => { subjCnt[x.q.subject] = (subjCnt[x.q.subject] || 0) + 1; });\n  if(studySubj && !subjCnt[studySubj]) studySubj = '';\n  const list = filteredWrong(d);\n  const subjBtns = `<div class=\"st-filter\"><span class=\"lbl\">과목</span>` +\n    `<button class=\"${!studySubj ? 'active' : ''}\" onclick=\"setStudySubj('')\">전체 ${inGrade.length}</button>` +\n    subjectsOf(studyGrade).filter(s => subjCnt[s]).map(s =>\n      `<button class=\"${studySubj === s ? 'active' : ''}\" onclick=\"setStudySubj('${escAttr(s)}')\">${esc(s)} ${subjCnt[s]}</button>`).join('') +\n    `</div>`;\n  const items = list.map(({ k, w, q }) => {\n    const open = !!studyOpenKey[k];\n    const detail = open ? `<div class=\"sw-detail\">\n        ${q.stem ? `<div class=\"rv-stem\">${fmt(q.stem)}</div>` : ''}\n        ${q.image ? `<div class=\"qimg-wrap\"><img class=\"qimg\" src=\"${esc(q.image)}\" alt=\"문항 자료 이미지\" onclick=\"openImg(this.src)\"></div>` : ''}\n        <ul class=\"rv-choices\">${q.choices.map((c, ci) =>\n          `<li class=\"${ci + 1 === q.answer ? 'correct' : ''}\">${circled(ci)} ${esc(c)}${ci + 1 === q.answer ? ' ✔' : ''}</li>`).join('')}</ul>\n        ${tagHTML(q)}\n        ${explainHTML(q, k)}\n      </div>` : '';\n    return `<div class=\"sw-item${open ? ' open' : ''}\">\n      <div class=\"sw-meta\"><b>${keyLabel(k)}</b><span>${esc(q.subject)}</span>${swTagsHTML(q)}<span class=\"sw-n\">${w.n}회 틀림</span><span>마지막 ${kstStamp(w.last)}</span></div>\n      <div class=\"sw-q\">${fmt(q.q)}</div>\n      <div class=\"sw-actions\">\n        <button class=\"wbtn\" onclick=\"toggleWrongOpen('${k}')\">${open ? '해설 닫기' : '해설 보기'}</button>\n        <button class=\"wbtn\" onclick=\"removeWrong('${k}')\">빼기 &#10005;</button>\n      </div>${detail}</div>`;\n  }).join('');\n  const chip = studyArea || studyCat ? `<span class=\"wk-chip\">${esc(studyArea || studyCat)} <button onclick=\"${studyArea ? `setStudyArea('${escAttr(studyArea)}')` : `setStudyCat('${escAttr(studyCat)}')`}\" title=\"거르기 풀기\">&#10005;</button></span>` : '';\n  return `<div class=\"home-card\"><div class=\"home-card-body\">\n      ${gradeFilterHTML(grades)}${subjBtns}\n    </div></div>\n    ${weakHTML(d)}\n    <div class=\"home-card\"><div class=\"home-card-body\">\n      <div class=\"st-drill\" style=\"margin-top:0;padding-top:0;border-top:none;\"><span><b>오답 목록</b>${chip}<br>다시 풀어서 맞히면 오답노트에서 저절로 빠져요. 정규 모의 CBT에서 맞혀도 빠집니다.</span>\n        <button class=\"submit-btn\" onclick=\"startDrill()\">&#9654; 오답만 다시 풀기 (${list.length}문항)</button></div>\n    </div></div>\n    <div>${items}</div>\n    <div style=\"text-align:right;\"><button class=\"st-clear\" onclick=\"clearWrong()\">오답노트 모두 비우기</button></div>`;\n}\n// 오답 목록 접힌 줄에 세부 영역·유형 키워드를 붙인다(출제 포인트·핵심개념은 펼쳤을 때만)\nfunction swTagsHTML(q){\n  const t = tagsOn() && q.tag;\n  if(!t) return '';\n  return (t.a ? `<span class=\"sw-tag\">${esc(t.a)}</span>` : '') + (t.k ? `<span class=\"sw-tag kw\">${esc(t.k)}</span>` : '');\n}\nfunction toggleWrongOpen(k){ studyOpenKey[k] = !studyOpenKey[k]; renderStudy(); }\nfunction removeWrong(k){\n  const d = loadStudy();\n  delete d.wrong[k]; saveStudy(d); renderStudy();\n}\nfunction clearWrong(){\n  if(!confirm('오답노트를 모두 비울까요?\\n지운 문항은 되돌릴 수 없어요. (응시 기록은 그대로 남아요)')) return;\n  const d = loadStudy(); d.wrong = {}; saveStudy(d); renderStudy();\n}\n// 오답만 다시 풀기 — 시험 화면을 그대로 쓴다. 제한시간은 문항 수에 비례(실제 시험 약 1분/문항).\nfunction startDrill(){\n  const list = filteredWrong(loadStudy());\n  if(!list.length){ alert('다시 풀 문항이 없어요.'); return; }\n  drillMode = true;\n  sessQueue = [0]; sessPos = 0; accQ = []; accAns = []; accUsedSec = 0; accLimitSec = 0; accPauses = 0;\n  hide('studyScreen');\n  const title = `오답 다시 풀기 · ${studyGrade}급${studySubj ? ' ' + studySubj : ''}${studyArea || studyCat ? ' · ' + (studyArea || studyCat) : ''} ${list.length}문항`;\n  if(!_launch(list.map(x => x.q), Math.ceil(list.length * 1.05), title)){ drillMode = false; show('studyScreen'); }\n}\n\n// ── 응시 기록 ──\nfunction histHTML(d){\n  if(!d.attempts.length){\n    return `<div class=\"home-card\"><div class=\"home-card-body\"><div class=\"hs-empty\" style=\"text-align:center;padding:18px 0;\">\n      아직 응시 기록이 없어요.<br>모의 CBT를 한 교시 이상 풀고 제출하면 여기에 쌓여요.</div></div></div>`;\n  }\n  const grades = Array.from(new Set(d.attempts.map(a => a.grade))).sort();\n  pickStudyGrade(grades, d);\n  const trend = subjectTrend(d, studyGrade).filter(t => t.pts.length);\n  const trendRows = trend.map(t => {\n    const bars = t.pts.map(p =>\n      `<div class=\"st-bar\" style=\"height:${Math.max(p.pct, 2)}%\" title=\"${escAttr(`${kstStamp(p.at)} · ${p.set}회차 · ${p.pct}% (${p.ok}/${p.n})`)}\"></div>`).join('');\n    const last = t.pts[t.pts.length - 1];\n    return `<tr><th>${esc(t.s)}</th>\n      <td class=\"bars\"><div class=\"st-bars\">${bars}</div><div class=\"st-axis\">최근 ${t.pts.length}회 · 마지막 ${last.pct}%</div></td>\n      <td class=\"num\">${t.avg}%</td>\n      <td class=\"num\"><span class=\"risk-tag ${t.risk}\">${RISK_TXT[t.risk]}</span></td></tr>`;\n  }).join('');\n  const rows = d.attempts.filter(a => a.grade === studyGrade).slice().reverse().map(a => {\n    const failed = Object.entries(a.sub || {}).filter(([, [ok, n]]) => ok / n < 0.4).map(([s]) => s);\n    return `<tr><td class=\"num\">${kstStamp(a.at, true)}</td><td>${attemptLabel(a)}</td>\n      <td class=\"num\"><b>${pctOf(a.ok, a.n)}%</b> <small style=\"color:var(--gray)\">(${a.ok}/${a.n})</small></td>\n      <td class=\"num\">${attemptPartial(a) ? '<span class=\"risk-tag\" style=\"color:var(--gray)\">교시 참고</span>' : a.pass ? '<span class=\"risk-tag ok\">합격권</span>' : '<span class=\"risk-tag fail\">불합격권</span>'}</td>\n      <td>${failed.length ? '과락: ' + failed.map(esc).join(', ') : '-'}</td></tr>`;\n  }).join('');\n  return `${gradeFilterHTML(grades)}\n    <div class=\"home-card\"><h2>과목별 정답률 추이 <small>막대 1개 = 1회 응시 · 점선은 40%·60%</small></h2>\n      <div class=\"home-card-body\"><div class=\"home-tbl-wrap\"><table class=\"home-tbl st-tbl\">\n        <tr><th>과목</th><th>최근 5회</th><th style=\"text-align:center;\">최근 3회 평균</th><th style=\"text-align:center;\">상태</th></tr>${trendRows}\n      </table></div>\n      <div class=\"home-note\">※ 최근 3회 평균이 40% 미만이면 과락 위험, 60% 미만이면 주의로 표시해요. 막대에 마우스를 올리면 날짜와 점수가 보여요.</div></div></div>\n    <div class=\"home-card\"><h2>응시 목록 <small>최근 ${STUDY_MAX_ATTEMPTS}회까지 보관</small></h2>\n      <div class=\"home-card-body\"><div class=\"home-tbl-wrap\"><table class=\"home-tbl\">\n        <tr><th style=\"text-align:center;\">날짜</th><th>시험</th><th style=\"text-align:center;\">총점</th><th style=\"text-align:center;\">판정</th><th>과락 과목</th></tr>${rows}\n      </table></div></div></div>\n    <div style=\"text-align:right;\"><button class=\"st-clear\" onclick=\"clearHist()\">응시 기록 모두 지우기</button></div>`;\n}\nfunction clearHist(){\n  if(!confirm('응시 기록을 모두 지울까요?\\n지운 기록은 되돌릴 수 없어요. (오답노트는 그대로 남아요)')) return;\n  const d = loadStudy(); d.attempts = []; saveStudy(d); renderStudy();\n}\nfunction formatExtendDate(s){\n  // '2026-09-30' → '2026년 9월 30일'\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(s).trim());\n  return m ? `${m[1]}년 ${parseInt(m[2],10)}월 ${parseInt(m[3],10)}일` : String(s);\n}\nfunction showGate(){\n  hide('startScreen'); hide('homeScreen');\n  const g = $('authGate'); g.classList.remove('hidden');\n}\n\n// 로그인 없이 들어가는 건 두 경우뿐이다(2026-09-30):\n//  ① 소소숲 정식판 번들(SHOW_HOME) — 로그인·결제·기기 확인을 소소숲 서버가 이미 했다\n//  ② 내 컴퓨터에서 미리 보기(localhost·파일로 열기)\n// 체험 사이트에서 Firebase 설정 파일만 막아 로그인을 건너뛰던 틈을 닫는다.\nconst _cfg = window.FIREBASE_CONFIG;\nconst DEV_HOST = location.protocol === 'file:' || /^(localhost|127\\.0\\.0\\.1|\\[::1\\])$/.test(location.hostname);\nconst NO_LOGIN_OK = SHOW_HOME || DEV_HOST;\nconst CFG_ERR = '로그인 설정을 불러오지 못했어요.\\n새로고침해 주세요. 계속 안 되면 소소숲 카카오톡 채널로 문의해 주세요.';\nif(!_cfg || !_cfg.apiKey || String(_cfg.apiKey).indexOf('PASTE') === 0){\n  if(NO_LOGIN_OK){\n    console.warn('[kcbt] Firebase 설정 없음 — 로그인 없이 실행(소소숲 정식판·로컬 미리 보기).');\n    enterApp('local');\n  } else {\n    showGate(); agShowErr(CFG_ERR);\n  }\n} else {\n  firebase.initializeApp(_cfg);\n  fbAuth = firebase.auth();\n  fbDb = firebase.firestore();\n\n  // 새로고침해도 로그인 유지 — 단, 기기 일치 재확인 후 입장\n  fbAuth.onAuthStateChanged(async (user) => {\n    if(loginInProgress) return;   // 대화형 로그인 진행 중엔 doLogin이 처리하므로 개입 안 함(레이스 방지)\n    if(!user){ showGate(); return; }\n    try{\n      const snap = await fbDb.collection('users').doc(user.uid).get();\n      const data = snap.exists ? snap.data() : null;\n      if(planBlocked(data)){\n        await fbAuth.signOut(); showGate(); agShowErr(planBlockMsg(data));\n      } else if(data && data.device && data.device === getDeviceId()){\n        enterApp(data.name || (user.email || '').split('@')[0], data.extendedUntil);\n      } else {\n        await fbAuth.signOut();   // 기기 불일치/미등록 → 로그아웃 후 게이트\n        showGate();\n      }\n    }catch(e){ console.error(e); await fbAuth.signOut(); showGate(); }\n  });\n}\n\nasync function doLogin(){\n  if(!fbAuth){ if(NO_LOGIN_OK) enterApp('local'); else agShowErr(CFG_ERR); return; }   // 소소숲 정식판·로컬 미리 보기만 로그인 없이\n  const id = ($('agId').value || '').trim().toLowerCase();\n  const pw = $('agPw').value || '';\n  if(!id || !pw){ agShowErr('아이디와 비밀번호를 입력해 주세요.'); return; }\n  const btn = $('agBtn'); btn.disabled = true; agShowErr('');\n  loginInProgress = true;   // onAuthStateChanged가 로그인 중 개입해 로그아웃시키는 레이스 방지\n  try{\n    const cred = await fbAuth.signInWithEmailAndPassword(id + EMAIL_DOMAIN, pw);\n    const uid = cred.user.uid;\n    const dev = getDeviceId();\n    const ref = fbDb.collection('users').doc(uid);\n    const snap = await ref.get();\n    if(!snap.exists){\n      await fbAuth.signOut();\n      agShowErr('등록되지 않은 계정입니다. 관리자에게 문의해 주세요.');\n      return;\n    }\n    const data = snap.data();\n    if(planBlocked(data)){\n      await fbAuth.signOut();\n      agShowErr(planBlockMsg(data));\n      return;\n    }\n    if(!data.device){\n      // 최초 로그인 → 이 기기를 등록(바인딩)\n      await ref.update({ device: dev, boundAt: firebase.firestore.FieldValue.serverTimestamp() });\n    } else if(data.device !== dev){\n      // 다른 기기에서 로그인 시도 → 차단\n      await fbAuth.signOut();\n      agShowErr('이미 다른 기기에 등록된 계정입니다.\\n기기 변경은 관리자에게 문의해 주세요.');\n      return;\n    }\n    enterApp(data.name || id, data.extendedUntil);\n  }catch(e){\n    console.error(e);\n    const code = e && e.code || '';\n    if(code === 'permission-denied'){\n      agShowErr('기기 등록에 실패했습니다. 관리자에게 문의해 주세요.');\n    } else if(code.indexOf('auth/user-disabled') >= 0){\n      agShowErr((TRIAL_SITE ? '체험' : '베타 이용') + ' 기간이 종료되었습니다.\\n이용해 주셔서 감사합니다. 🌿');\n    } else if(code.indexOf('auth/too-many-requests') >= 0){\n      agShowErr('로그인 시도가 많습니다. 잠시 후 다시 시도해 주세요.');\n    } else {\n      agShowErr('아이디 또는 비밀번호가 올바르지 않습니다.');\n    }\n  }finally{\n    btn.disabled = false;\n    loginInProgress = false;\n  }\n}\n\nasync function doLogout(){\n  // 소소숲 정식판은 Firebase 로그인이 없다 → 소소숲 계정에서 로그아웃하고 바깥(부모) 창을 홈으로 보낸다\n  if(window.SHOW_HOME && !fbAuth){\n    if(!confirm('소소숲에서 로그아웃할까요?')) return;\n    const f = document.createElement('form');\n    f.method = 'post'; f.action = '/auth/signout'; f.target = '_top';\n    document.body.appendChild(f); f.submit();\n    return;\n  }\n  try{ if(fbAuth) await fbAuth.signOut(); }catch(e){}\n  $('agId').value = ''; $('agPw').value = ''; agShowErr('');\n  showGate();\n}\n\n// ═════════ 일시정지 ═════════\n// 실제 시험에는 없는 연습용 기능. 멈춘 동안 타이머를 세우고 문제를 가린다. 쓴 횟수는 결과 화면 풀이 시간 옆에 적는다.\nfunction pauseExam(){\n  if(paused || submitted || $('examScreen').classList.contains('hidden')) return;\n  paused = true; pauseCount++;\n  syncRemain(); clearInterval(timerId);\n  const r = Math.max(0, remainSec);\n  $('pauseRemain').textContent = `${Math.floor(r/60)}분 ${String(r%60).padStart(2,'0')}초`;\n  show('pauseOverlay');\n  saveResume();\n}\nfunction resumeExam(){\n  if(!paused) return;\n  paused = false; hide('pauseOverlay');\n  startTimer();\n}\n\n// ═════════ 풀던 답 저장 · 이어 풀기 (정식판·베타) ═════════\n// 체험 사이트(cbt1·cbt2 = IS_TRIAL_SITE)는 끈다. 이 기기 localStorage에 계정별로 한 건만 둔다.\n// 문항은 급수-회차-교시-번호 키 + 발문·보기 지문(qFp)으로 저장해서, 그사이 문항이 바뀌었으면 이어 풀지 않는다.\n// 창을 닫아 둔 동안에는 시간이 흐르지 않는다(남은 시간을 그대로 되살린다). 오답 다시 풀기는 저장하지 않는다.\nvar resumeSaveT = 0, pendingResume = null, resumeFromStart = false;\nfunction resumeOn(){ return !window.IS_TRIAL_SITE; }\nfunction resumeKey(){ return 'kcbt_resume_v1_' + (window.STUDY_USER || CURRENT_ID || 'local'); }\nfunction qFp(q){\n  const s = (q.q || '') + '|' + (q.choices || []).join('|');\n  let h = 0;\n  for(let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;\n  return (h >>> 0).toString(36);\n}\nfunction saveResumeSoon(){ if(!resumeOn()) return; clearTimeout(resumeSaveT); resumeSaveT = setTimeout(saveResume, 400); }\nfunction saveResume(phase){\n  if(!resumeOn() || drillMode) return;\n  const between = phase === 'between';\n  if(!between && (submitted || !Q.length || $('examScreen').classList.contains('hidden'))) return;\n  const st = {\n    v: 1, at: Date.now(), phase: between ? 'between' : 'exam',\n    grade: chosenGrade, set: chosenSet, queue: sessQueue, pos: sessPos,\n    label: examTitle() + setLabel(), name: $('exName').textContent,\n    acc: { keys: accQ.map(q => Q_KEY.get(q)), fp: accQ.map(qFp), ans: accAns, used: accUsedSec, limit: accLimitSec, pauses: accPauses },\n  };\n  if(!between) Object.assign(st, {\n    title: $('exTitle').textContent, keys: Q.map(q => Q_KEY.get(q)), fp: Q.map(qFp),\n    answers, checks, memos, strikes, hl: hlStore, page, perPage, fontScale,\n    limit: limitSec, remain: Math.max(0, remainSec), warned, warned10, pauses: pauseCount,\n  });\n  try{ localStorage.setItem(resumeKey(), JSON.stringify(st)); }\n  catch(e){ console.warn('[kcbt] 풀던 답 저장 실패', e); }\n}\nfunction clearResume(){\n  clearTimeout(resumeSaveT);\n  try{ localStorage.removeItem(resumeKey()); }catch(e){}\n}\n// 저장본을 읽어 문항 객체까지 되살린다. 없으면 null, 문항이 바뀌어 쓸 수 없으면 'stale'.\nfunction loadResume(){\n  if(!resumeOn()) return null;\n  let st = null;\n  try{ st = JSON.parse(localStorage.getItem(resumeKey()) || 'null'); }catch(e){}\n  if(!st || st.v !== 1 || !st.acc) return null;\n  const toQ = (keys, fps) => {\n    if(!Array.isArray(keys) || !Array.isArray(fps) || keys.length !== fps.length) return null;\n    const out = [];\n    for(let i = 0; i < keys.length; i++){\n      const q = KEY_Q.get(keys[i]);\n      if(!q || qFp(q) !== fps[i]) return null;\n      out.push(q);\n    }\n    return out;\n  };\n  st.accQs = toQ(st.acc.keys, st.acc.fp);\n  if(!st.accQs || !Array.isArray(st.acc.ans) || st.acc.ans.length !== st.accQs.length) return 'stale';\n  if(st.phase === 'exam'){\n    st.qs = toQ(st.keys, st.fp);\n    if(!st.qs || !st.qs.length) return 'stale';\n  } else if(st.phase !== 'between' || !Array.isArray(st.queue) || st.pos >= st.queue.length - 1) return 'stale';\n  return st;\n}\n// 앱에 들어올 때(enterApp) 한 번 확인한다.\nfunction checkResume(){\n  const st = loadResume();\n  if(st === 'stale'){ clearResume(); alert('풀던 시험의 문항이 그사이 바뀌어서 이어 풀 수 없어요.\\n새로 시작해 주세요.'); return; }\n  if(st) openResume(st, false);\n}\nfunction openResume(st, fromStart){\n  pendingResume = st; resumeFromStart = fromStart;\n  let body;\n  if(st.phase === 'between'){\n    const done = st.queue[st.pos], next = st.queue[st.pos + 1];\n    body = `<b>${esc(st.label)} ${done}교시</b>까지 제출했어요.<br>이어서 ${next}교시를 풀거나 결과를 볼 수 있어요.`;\n  } else {\n    const n = st.qs.length, done = st.answers.filter(a => a > 0).length, r = st.remain;\n    body = `<b>${esc(st.title)}</b><br>${done} / ${n}문항 풀이 · 남은 시간 ${Math.floor(r/60)}분 ${String(r%60).padStart(2,'0')}초`;\n  }\n  $('resumeMsg').innerHTML = body + `<br><small style=\"color:#68738a\">${kstStamp(st.at, true)}에 멈춘 시험이에요. 멈춘 동안에는 시간이 흐르지 않았어요.</small>`;\n  show('resumeOverlay');\n}\nfunction resumeDiscard(){\n  hide('resumeOverlay'); pendingResume = null; clearResume();\n  if(resumeFromStart) startExam();\n}\nfunction resumeContinue(){\n  const st = pendingResume; pendingResume = null; hide('resumeOverlay');\n  if(!st) return;\n  drillMode = false;\n  chosenGrade = st.grade; chosenSet = st.set; renderStartSelectors();\n  sessQueue = st.queue.slice(); sessPos = st.pos;\n  accQ = st.accQs; accAns = st.acc.ans.slice(); accUsedSec = st.acc.used || 0; accLimitSec = st.acc.limit || 0; accPauses = st.acc.pauses || 0;\n  hide('homeScreen'); hide('startScreen');\n  if(st.phase === 'between'){\n    // 여기서 [결과 보기]를 누르면 결과 화면이 accQ 기준으로 다시 그려지므로 배열 길이를 맞춰 둔다\n    Q = accQ; answers = accAns.slice(); page = 0; hlStore = {};\n    checks = accQ.map(() => false); memos = accQ.map(() => ''); strikes = accQ.map(() => [false,false,false,false,false]);\n    submitted = true; showNextSessPrompt(); return;\n  }\n  _launch(st.qs, Math.ceil(st.limit / 60), st.title, st);\n}\naddEventListener('pagehide', () => saveResume());\ndocument.addEventListener('visibilitychange', () => { if(document.visibilityState === 'hidden') saveResume(); });\n\n// ═════════ 시험 시작 ═════════\n// 실제 시험 실행부(샘플·커스텀 공용). qArr: 문항배열, minutes: 제한시간, title: 헤더 표기\n// rs: 풀던 시험을 이어 풀 때 저장해 둔 상태(saveResume). 없으면 새 시험.\nfunction _launch(qArr, minutes, title, rs){\n  Q = qArr;\n  if(!Q.length){ alert('시작할 문항이 없습니다.'); return false; }\n  answers = Array(Q.length).fill(0);\n  checks  = Array(Q.length).fill(false);\n  memos   = Array(Q.length).fill('');\n  strikes = Q.map(() => [false,false,false,false,false]);\n  page = 0; filter = 'all'; warned = false; warned10 = false; submitted = false; studyRecorded = false;\n  paused = false; pauseCount = 0; hide('pauseOverlay');\n  awaitEnd = false; submitRemain = null; hide('submittedOverlay');\n  hlStore = {}; penMode = 'off'; $('paper').classList.remove('pen-on');\n  limitSec = remainSec = Math.max(1, minutes) * 60;\n  if(rs){\n    const same = a => Array.isArray(a) && a.length === Q.length;\n    if(same(rs.answers)) answers = rs.answers.slice();\n    if(same(rs.checks))  checks  = rs.checks.slice();\n    if(same(rs.memos))   memos   = rs.memos.slice();\n    if(same(rs.strikes)) strikes = rs.strikes.map(x => x.slice());\n    hlStore = rs.hl || {};\n    limitSec = rs.limit; remainSec = rs.remain;\n    warned = !!rs.warned; warned10 = !!rs.warned10; pauseCount = rs.pauses || 0; page = rs.page || 0;\n    // 저장할 때의 1면/2면 배치·글자 크기로 되돌린다(page는 그 배치 기준 번호라 배치가 다르면 다른 문제로 간다)\n    if(rs.perPage === 1 || rs.perPage === 2){ perPage = rs.perPage; $('lay1').classList.toggle('active', perPage===1); $('lay2').classList.toggle('active', perPage===2); }\n    if(rs.fontScale){\n      fontScale = rs.fontScale;\n      document.querySelectorAll('.fbtn').forEach(x => x.classList.toggle('active', +x.dataset.fs === fontScale));\n    }\n  }\n  startedAt = new Date();\n  $('exName').textContent = (rs && rs.name) || $('inName').value || '소소숲';\n  $('exTitle').textContent = title;\n  $('limitMin').textContent = Math.round(limitSec/60);\n  hide('startScreen'); show('examScreen');\n  buildOMR(); render();\n  startTimer();\n  return true;\n}\nlet sessQueue = [1], sessPos = 0, accQ = [], accAns = [], accUsedSec = 0, accLimitSec = 0;\nfunction startExam(){\n  const st = loadResume();                    // 풀던 시험이 있으면 새로 시작하기 전에 먼저 묻는다\n  if(st === 'stale') clearResume();\n  else if(st){ openResume(st, true); return; }\n  drillMode = false;\n  sessQueue = sessionQueueFrom(chosenSess);\n  sessPos = 0; accQ = []; accAns = []; accUsedSec = 0; accLimitSec = 0; accPauses = 0;\n  launchCurrentSession();\n}\nfunction launchCurrentSession(){\n  const s = sessQueue[sessPos];\n  const p = poolFor(s);\n  if(!p.length){ alert('선택한 교시에 문항이 없습니다.'); return; }\n  _launch(p, minutesFor(s), examTitle() + setLabel() + ` ${s}교시`);\n}\nfunction startNextSession(){ hide('nextSessOverlay'); sessPos++; launchCurrentSession(); }   // 다음 교시로 진행\nfunction resultNow(){ hide('nextSessOverlay'); finishAll(); }                                 // 여기서 멈추고 결과\nfunction finishAll(){\n  Q = accQ; answers = accAns;\n  limitSec = accLimitSec; remainSec = accLimitSec - accUsedSec;   // 지금까지 합산 풀이시간\n  showResult();\n}\n// 한 교시 제출/종료 → 누적 후, 다음 교시가 있으면 [다음 교시 시작 / 결과 보기] 선택\n// choice: 제출 완료 창에서 고른 것('next' 다음 교시 · 'result' 결과 보기). 없으면(시간 종료) 교시 전환 창을 띄운다.\nfunction finishSession(choice){\n  clearInterval(timerId);\n  accQ = accQ.concat(Q);\n  accAns = accAns.concat(answers);\n  accUsedSec += (limitSec - Math.max(0, remainSec));\n  accLimitSec += limitSec;\n  accPauses += pauseCount; pauseCount = 0;\n  if(choice === 'result' || sessPos >= sessQueue.length - 1){ finishAll(); return; }\n  if(choice === 'next'){ sessPos++; launchCurrentSession(); return; }\n  showNextSessPrompt();\n  saveResume('between');   // 교시 사이에 창을 닫아도 앞 교시 답이 남게\n}\nfunction showNextSessPrompt(){\n  const done = sessQueue[sessPos], next = sessQueue[sessPos+1];\n  $('nextSessMsg').innerHTML = `<b>${done}교시</b>가 종료되었습니다.<br>이어서 <b>${next}교시</b>(${minutesFor(next)}분)를 풀거나,<br>여기서 <b>${done}교시 결과</b>만 볼 수 있어요.`;\n  show('nextSessOverlay');\n}\n// 남은 시간은 끝나는 시각(deadline)과 지금 시각의 차이로 센다.\n// setInterval 횟수로 세면 백그라운드 탭·절전 때 콜백이 늦게 와서 시계가 실제보다 느리게 간다.\nlet deadline = 0, lastShownSec = null, lastSaveAt = 0;\nfunction startTimer(){\n  deadline = Date.now() + Math.max(0, remainSec) * 1000; lastShownSec = null;\n  clearInterval(timerId); timerId = setInterval(tickTimer, 250); tickTimer();\n}\nfunction syncRemain(){ if(deadline) remainSec = Math.ceil((deadline - Date.now()) / 1000); }\nfunction tickTimer(){\n  syncRemain();\n  if(remainSec <= 0){\n    remainSec = 0; clearInterval(timerId);\n    $('remainTxt').textContent = '0분 00초';\n    if(awaitEnd){ endSession(); return; }   // 제출해 둔 채로 교시 시간이 끝남\n    autoSubmit(); return;\n  }\n  if(remainSec === lastShownSec) return;   // 0.25초마다 확인하고, 초가 바뀔 때만 화면을 고친다\n  lastShownSec = remainSec;\n  const m = Math.floor(remainSec/60), s = remainSec%60;\n  $('remainTxt').textContent = `${m}분 ${String(s).padStart(2,'0')}초`;\n  if(awaitEnd){ updateSubmittedClock(); }   // 제출 완료 창에서는 남은 시간만 갱신(알림은 문제로 돌아왔을 때)\n  else {\n    // 국시원 CBT처럼 종료 10분 전·5분 전에 알림창\n    if(!warned10 && remainSec <= 600 && limitSec > 600){ warned10 = true; if(remainSec > 300) showWarn(10); }\n    if(!warned && remainSec <= 300 && limitSec > 300){ warned = true; warned10 = true; showWarn(5); }\n  }\n  if(Date.now() - lastSaveAt >= 5000){ lastSaveAt = Date.now(); saveResume(); }\n}\nfunction showWarn(min){ $('warnMin').textContent = min + '분'; show('warnOverlay'); }\n\n// ═════════ 페이지 (시험지는 항상 전체 문제) ═════════\nfunction totalPages(){ return Math.max(1, Math.ceil(Q.length / perPage)); }\nfunction movePage(d){\n  const t = totalPages();\n  page = Math.min(t-1, Math.max(0, page+d));\n  render();\n}\nfunction jumpTo(qi){\n  page = Math.floor(qi / perPage);\n  render();\n}\n\n// ═════════ 렌더링 ═════════\nfunction render(){\n  const t = totalPages();\n  if(page >= t) page = t-1;\n  if(page < 0) page = 0;\n  const start = page*perPage;\n  const slice = Q.map((_,i)=>i).slice(start, start + perPage);\n  const grid = $('paperGrid');\n  grid.className = 'paper-grid' + (perPage===1 ? ' one' : '');\n  grid.style.fontSize = fontScale + 'em';\n  grid.innerHTML = slice.map(i => qcardHTML(i)).join('');\n  $('pageInfo').textContent = `${page+1}/${t}`;\n  // 첫 문제에선 [이전], 마지막 문제에선 [다음]을 숨긴다(자리는 남겨 배치가 밀리지 않게)\n  $('pgPrev').style.visibility = page > 0 ? '' : 'hidden';\n  $('pgNext').style.visibility = page < t-1 ? '' : 'hidden';\n  updateCounts(); updateOMR(slice);\n  $('paper').scrollTop = 0;\n}\n\n// ═════════ 문제 보기 모달 (전체/체크/안푼) ═════════\nlet viewerMode = 'all';\nfunction viewerIdx(mode){\n  if(mode==='chk') return Q.map((_,i)=>i).filter(i=>checks[i]);\n  if(mode==='un')  return Q.map((_,i)=>i).filter(i=>!answers[i]);\n  return Q.map((_,i)=>i);\n}\nfunction openProblemViewer(mode){\n  viewerMode = mode;\n  renderViewer();\n  show('viewerOverlay');\n}\nfunction switchViewerTab(mode){ viewerMode = mode; renderViewer(); }\nfunction renderViewer(){\n  $('vtAll').textContent = `전체문제 (${Q.length})`;\n  $('vtChk').textContent = `체크문제 (${checks.filter(Boolean).length})`;\n  $('vtUn').textContent  = `안푼문제 (${answers.filter(a=>!a).length})`;\n  ['vtAll','vtChk','vtUn'].forEach(id=>$(id).classList.remove('active'));\n  $(viewerMode==='all'?'vtAll':viewerMode==='chk'?'vtChk':'vtUn').classList.add('active');\n  const idxs = viewerIdx(viewerMode);\n  const body = $('viewerBody');\n  body.innerHTML = idxs.length\n    ? idxs.map(i => viewerCard(i)).join('')\n    : '<div style=\"padding:60px;text-align:center;color:#68738a;grid-column:1/-1;\">해당하는 문제가 없습니다.</div>';\n  body.scrollTop = 0;\n}\nfunction viewerCard(i){\n  const q = Q[i];\n  return `<div class=\"v-card\" ondblclick=\"viewerJump(${i})\" title=\"더블클릭하면 이 문제로 이동합니다\">\n    <div class=\"v-head\"><span class=\"v-no\">${i+1}</span><span style=\"flex:1\">${esc(q.q)}</span></div>\n    ${q.stem ? `<div class=\"v-stem\">${fmt(q.stem)}</div>` : ''}\n    <ul class=\"v-choices\">\n      ${q.choices.map((c,ci)=>`<li class=\"${answers[i]===ci+1?'sel':''}\">${circled(ci)} ${esc(c)}</li>`).join('')}\n    </ul>\n  </div>`;\n}\nfunction viewerJump(i){ hide('viewerOverlay'); jumpTo(i); }\nfunction esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\n// 문항 텍스트 서식: __구간__ → 밑줄(발화 전사의 비유창 구간 표시 등)\nfunction fmt(s){ return esc(s).replace(/__(.+?)__/g, '<u class=\"ul\">$1</u>'); }\nfunction qcardHTML(i){\n  const q = Q[i];\n  return `<div class=\"qcol\"><div class=\"qcard\" data-qi=\"${i}\">\n    <div class=\"qtools\">\n      <div class=\"qtools-row\">\n        <button class=\"tool-btn ${checks[i]?'on':''}\" onclick=\"toggleCheck(${i})\">&#10003; 체크문제</button>\n        <button class=\"tool-btn ${memos[i]?'memo-on':''}\" onclick=\"openMemo(${i})\">&#9998; 메모</button>\n      </div>\n      <div class=\"qtools-row\">\n        <button class=\"tool-btn ${penMode==='on'?'pen-on':''}\" onclick=\"togglePen()\">&#128396; 형광펜 ${penMode==='on'?'켜짐':'꺼짐'}</button>\n        <button class=\"tool-btn\" onclick=\"clearHighlights(${i})\">&#9003; 형광펜 지우기</button>\n      </div>\n    </div>\n    <div class=\"qhead\"><span>${i+1}.</span><span style=\"flex:1\" data-hl=\"${i}-q\">${hlHTML(i,'q',q.q)}</span><span class=\"subj\">${esc(q.subject)}</span></div>\n    ${q.stem ? `<div class=\"stem\" data-hl=\"${i}-s\">${hlHTML(i,'s',q.stem)}</div>` : ''}\n    ${q.image ? `<div class=\"qimg-wrap\"><img class=\"qimg\" src=\"${esc(q.image)}\" alt=\"문항 자료 이미지\" title=\"클릭하면 크게 볼 수 있습니다\" onclick=\"openImg(this.src)\"><div class=\"qimg-hint\"><button type=\"button\" class=\"qimg-btn\" onclick=\"openImg(this.closest('.qimg-wrap').querySelector('img').src)\">&#128269; 크게 보기</button></div></div>` : ''}\n    <ul class=\"choices\">\n      ${q.choices.map((c,ci)=>`\n        <li class=\"${answers[i]===ci+1?'sel':''} ${strikes[i][ci]?'strike':''}\">\n          <span class=\"num\">${ci+1}</span>\n          <span class=\"ctext\" data-hl=\"${i}-c${ci}\">${hlHTML(i,'c'+ci,c)}</span>\n          <button class=\"strike-btn ${strikes[i][ci]?'on':''}\" onclick=\"toggleStrike(${i},${ci})\">오답</button>\n        </li>`).join('')}\n    </ul>\n  </div></div>`;\n}\nfunction updateCounts(){\n  $('cntAll').textContent = Q.length;\n  $('cntChk').textContent = checks.filter(Boolean).length;\n  $('cntUn').textContent = answers.filter(a=>!a).length;\n}\n\n// ═════════ OMR ═════════\nfunction buildOMR(){\n  // OMR 패널 제거됨 — 남아있는 경우에만 렌더(호환용)\n  const list = $('omrList'); if(!list) return;\n  list.innerHTML = Q.map((_,i)=>`\n    <div class=\"omr-row ${(i+1)%5===0?'sep':''}\" id=\"omr${i}\">\n      <span class=\"flags\" id=\"flag${i}\"></span>\n      <span class=\"no\" onclick=\"jumpTo(${i})\">${String(i+1).padStart(2,'0')}</span>\n      <span class=\"bubbles\">${[1,2,3,4,5].map(n=>`<button class=\"bub\" onclick=\"pick(${i},${n})\">${circled(n-1)}</button>`).join('')}</span>\n    </div>`).join('');\n}\nfunction updateOMR(visible){\n  // 진행바 갱신(푼 문항 수 기준)\n  const total = Q.length, done = answers.filter(a=>a>0).length;\n  const pb = $('progBar'), pt = $('progText');\n  if(pb) pb.style.width = (total ? done/total*100 : 0) + '%';\n  if(pt) pt.textContent = `${done} / ${total} 문항 풀이`;\n  // OMR 패널이 남아있으면 함께 갱신(호환용)\n  if(!$('omrList')) return;\n  Q.forEach((_,i)=>{\n    const row = $('omr'+i); if(!row) return;\n    row.classList.toggle('cur', visible.includes(i));\n    row.querySelectorAll('.bub').forEach((b,bi)=>b.classList.toggle('mark', answers[i]===bi+1));\n    $('flag'+i).innerHTML = (checks[i]?'<span class=\"chk\">&#10003;</span>':'') + (memos[i]?'<span>&#9998;</span>':'');\n  });\n}\nfunction goHome(){\n  const keep = resumeOn() && !drillMode;   // 정식판·베타는 푼 답을 남겨 두고 다음에 이어 풀게 한다\n  if(!confirm(keep ? '처음(입장) 화면으로 돌아갈까요?\\n푼 답은 저장돼서 다음에 이어서 풀 수 있어요.'\n                   : '처음(입장) 화면으로 돌아갈까요?\\n지금까지 푼 답안은 저장되지 않습니다.')) return;\n  clearInterval(timerId);\n  if(keep) saveResume();\n  hide('examScreen'); hide('resultScreen');\n  if(drillMode){ drillMode = false; openStudy('wrong'); } else show('startScreen');\n}\n\n// ═════════ 상호작용 ═════════\nfunction pick(i,n){\n  answers[i] = (answers[i]===n) ? 0 : n;\n  render(); saveResumeSoon();\n}\nfunction toggleStrike(i,ci){ strikes[i][ci] = !strikes[i][ci]; render(); saveResumeSoon(); }\nfunction toggleCheck(i){ checks[i] = !checks[i]; render(); saveResumeSoon(); }\n\n// 글자 크기 / 화면 배치\ndocument.querySelectorAll('.fbtn').forEach(b=>b.onclick=()=>{\n  document.querySelectorAll('.fbtn').forEach(x=>x.classList.remove('active'));\n  b.classList.add('active'); fontScale = +b.dataset.fs; render(); saveResumeSoon();\n});\n// 배치를 바꿔도 보던 문제에 머문다(2면→1면은 보던 쌍의 앞 문제, 1면→2면은 그 문제가 든 쌍)\nfunction setLayout(n){\n  if(perPage === n) return;\n  const qi = page * perPage;\n  perPage = n;\n  $('lay1').classList.toggle('active', n===1); $('lay2').classList.toggle('active', n===2);\n  page = Math.floor(qi / perPage);\n  render(); saveResumeSoon();\n}\n$('lay1').onclick = ()=> setLayout(1);\n$('lay2').onclick = ()=> setLayout(2);\n\n// ═════════ 형광펜 ═════════\n// 하이라이트는 문항별(data-hl 키)로 innerHTML을 저장해 페이지 이동·재렌더 후에도 유지된다.\nfunction hlHTML(i, part, text){\n  const k = i + '-' + part;\n  return hlStore[k] !== undefined ? hlStore[k] : fmt(text);\n}\nfunction togglePen(){\n  penMode = penMode==='on' ? 'off' : 'on';\n  $('paper').classList.toggle('pen-on', penMode==='on');\n  const sel = window.getSelection && window.getSelection();\n  if(sel) sel.removeAllRanges();\n  render();   // 문제 카드의 형광펜 버튼 상태(켜짐/꺼짐) 갱신\n}\nfunction hlContainerOf(node){\n  while(node){\n    if(node.nodeType===1 && node.dataset && node.dataset.hl!==undefined) return node;\n    node = node.parentNode;\n  }\n  return null;\n}\nfunction saveHl(c){ if(c) hlStore[c.dataset.hl] = c.innerHTML; saveResumeSoon(); }\nfunction clearHighlights(i){   // 해당 문항의 모든 형광펜 하이라이트 제거\n  ['q','s','c0','c1','c2','c3','c4'].forEach(p => delete hlStore[i+'-'+p]);\n  render(); saveResumeSoon();\n}\nfunction onPaperMouseUp(){\n  if(penMode!=='on') return;\n  const sel = window.getSelection();\n  if(!sel || sel.isCollapsed || !String(sel).trim()) return;\n  const range = sel.getRangeAt(0);\n  const startC = hlContainerOf(range.startContainer);\n  const endC = hlContainerOf(range.endContainer);\n  if(!startC || startC !== endC){ sel.removeAllRanges(); return; }   // 한 영역 안에서만 허용\n  const mark = document.createElement('mark');\n  mark.className = 'hl';\n  try{ range.surroundContents(mark); }\n  catch(_){ try{ mark.appendChild(range.extractContents()); range.insertNode(mark); }\n            catch(e){ sel.removeAllRanges(); return; } }\n  saveHl(startC);\n  sel.removeAllRanges();\n}\nfunction onPaperClick(e){\n  const mark = e.target.closest ? e.target.closest('mark.hl') : null;\n  if(penMode==='on' && mark){                       // 형광펜 모드에서 하이라이트 클릭 → 지우기\n    const cont = hlContainerOf(mark), parent = mark.parentNode;\n    while(mark.firstChild) parent.insertBefore(mark.firstChild, mark);\n    parent.removeChild(mark); parent.normalize();\n    saveHl(cont);\n    return;\n  }\n  if(window.getSelection && String(window.getSelection()).trim()) return;  // 드래그 선택 중이면 클릭 무시\n  const ct = e.target.closest ? e.target.closest('.ctext') : null;         // 보기 텍스트 클릭 → 답 선택\n  if(ct){\n    const li = ct.closest('li');\n    const ci = [...li.parentNode.children].indexOf(li);\n    const qi = +li.closest('.qcard').dataset.qi;\n    pick(qi, ci+1);\n  }\n}\n$('paper').addEventListener('mouseup', onPaperMouseUp);\n$('paper').addEventListener('click', onPaperClick);\n\n// ═════════ 메모 ═════════\nfunction openMemo(i){\n  memoTarget = i;\n  $('memoTitle').textContent = `${i+1}번 문제 메모`;\n  $('memoText').value = memos[i];\n  show('memoWin'); $('memoText').focus();\n}\n// 메모는 닫기 전에도 입력할 때마다 반영해 둔다(창을 닫지 않고 탭을 닫아도 이어 풀기에 남게)\n$('memoText').addEventListener('input', () => {\n  if(memoTarget < 0) return;\n  memos[memoTarget] = $('memoText').value.trim(); saveResumeSoon();\n});\nfunction closeMemo(){\n  if(memoTarget>=0) memos[memoTarget] = $('memoText').value.trim();\n  memoTarget = -1; hide('memoWin'); render(); saveResumeSoon();\n}\n\n// ═════════ 계산기 ═════════\nfunction toggleCalc(){ $('calcWin').classList.toggle('hidden'); }\nfunction calcIn(v){ const d=$('calcDisp'); d.value = d.value==='0'&&!'+-*/.'.includes(v) ? v : d.value+v; }\nfunction calcClear(){ $('calcDisp').value='0'; }\nfunction calcBack(){ const d=$('calcDisp'); d.value=d.value.slice(0,-1)||'0'; }\nfunction calcEq(){\n  const d=$('calcDisp');\n  if(!/^[\\d+\\-*/.() ]+$/.test(d.value)) return;\n  try{ d.value = String(Function('\"use strict\";return ('+d.value+')')()); }catch(e){ d.value='오류'; }\n}\n\n// ═════════ 그림판 ═════════\nconst pc = $('padCanvas'), pctx = pc.getContext('2d');\nlet padMode='pen', drawing=false;\nfunction togglePad(){ $('padWin').classList.toggle('hidden'); }\nfunction setPadMode(m){ padMode=m; $('penBtn').classList.toggle('on',m==='pen'); $('eraserBtn').classList.toggle('on',m==='eraser'); }\nfunction clearPad(){ pctx.clearRect(0,0,pc.width,pc.height); }\npc.addEventListener('mousedown',e=>{ drawing=true; pctx.beginPath(); pctx.moveTo(e.offsetX,e.offsetY); });\npc.addEventListener('mousemove',e=>{\n  if(!drawing) return;\n  pctx.lineWidth = padMode==='pen'?2:18;\n  pctx.strokeStyle='#1f3358';\n  pctx.globalCompositeOperation = padMode==='pen'?'source-over':'destination-out';\n  pctx.lineTo(e.offsetX,e.offsetY); pctx.stroke();\n});\n['mouseup','mouseleave'].forEach(ev=>pc.addEventListener(ev,()=>drawing=false));\n\n// 플로팅 창 드래그\ndocument.querySelectorAll('[data-drag]').forEach(h=>{\n  h.addEventListener('mousedown',e=>{\n    if(e.target.tagName==='BUTTON') return;\n    e.preventDefault();\n    const win=$(h.dataset.drag), r=win.getBoundingClientRect();\n    const ox=e.clientX-r.left, oy=e.clientY-r.top;\n    win.style.left=r.left+'px'; win.style.top=r.top+'px'; win.style.right='auto'; win.style.bottom='auto';\n    const mv=ev=>{   // 제목줄 일부는 항상 화면 안에 남도록 제한\n      const x=Math.min(innerWidth-80, Math.max(80-r.width, ev.clientX-ox));\n      const y=Math.min(innerHeight-40, Math.max(0, ev.clientY-oy));\n      win.style.left=x+'px'; win.style.top=y+'px';\n    };\n    const up=()=>{ document.removeEventListener('mousemove',mv); document.removeEventListener('mouseup',up); };\n    document.addEventListener('mousemove',mv); document.addEventListener('mouseup',up);\n  });\n});\n$('imgGrip').addEventListener('mousedown', e => {\n  e.preventDefault(); e.stopPropagation();\n  const win=$('imgWin'), r=win.getBoundingClientRect(), sx=e.clientX, sy=e.clientY;\n  win.style.left=r.left+'px'; win.style.top=r.top+'px';\n  const mv=ev=>{\n    win.style.width = Math.max(260, Math.min(innerWidth - r.left, r.width + ev.clientX - sx)) + 'px';\n    win.style.height = Math.max(180, Math.min(innerHeight - r.top, r.height + ev.clientY - sy)) + 'px';\n  };\n  const up=()=>{ document.removeEventListener('mousemove',mv); document.removeEventListener('mouseup',up); };\n  document.addEventListener('mousemove',mv); document.addEventListener('mouseup',up);\n});\n\n// ═════════ 제출 ═════════\nfunction askSubmit(){\n  const un = answers.filter(a=>!a).length;\n  const isLast = sessPos >= sessQueue.length - 1;\n  const tail = isLast ? '답안을 제출하시겠습니까?'\n                      : `${sessQueue[sessPos]}교시 답안을 제출할까요?`;\n  $('submitMsg').innerHTML = (un ? `안 푼 문제가 <b style=\"color:var(--red)\">${un}개</b> 있습니다.` : '모든 문제에 답하였습니다.')\n    + `<br>${tail}<br><small style=\"color:#68738a\">시간이 남아 있으면 제출한 뒤에도 문제로 돌아가 고칠 수 있어요.</small>`;\n  show('submitOverlay');\n}\nfunction autoSubmit(){\n  if(submitted) return; saveResume(); submitted=true; clearInterval(timerId); hide('warnOverlay');\n  const isLast = sessPos >= sessQueue.length - 1;\n  const btn = $('timeoverBtn'); if(btn) btn.textContent = isLast ? '결과 확인' : '확인';\n  const msg = $('timeoverMsg'); if(msg) msg.innerHTML = isLast\n    ? '시험 시간이 종료되어<br>답안이 자동 제출되었습니다.'\n    : `${sessQueue[sessPos]}교시 시간이 종료되어<br>답안이 자동 제출되었습니다.`;\n  show('timeoverOverlay');\n}\n// 제출해도 이 교시 시간이 남아 있으면 [문제로 돌아가기]로 고칠 수 있다. 타이머는 계속 흐르고,\n// 교시를 끝내는 건 [다음 교시 시작]·[결과 보기]를 누르거나 시간이 다 됐을 때다. 풀이 시간은 마지막으로 제출한 때까지로 센다.\nfunction doSubmit(){\n  hide('submitOverlay');\n  submitRemain = Math.max(0, remainSec);\n  awaitEnd = true;\n  const cur = sessQueue[sessPos], next = sessQueue[sessPos + 1];\n  $('subdTitle').textContent = cur ? `${cur}교시 답안을 제출했어요` : '답안을 제출했어요';\n  $('subdNext').classList.toggle('hidden', sessPos >= sessQueue.length - 1);\n  $('subdNext').textContent = `${next}교시 시작`;\n  updateSubmittedClock();\n  show('submittedOverlay');\n}\nfunction updateSubmittedClock(){\n  const r = Math.max(0, remainSec);\n  $('subdRemain').textContent = `${Math.floor(r/60)}분 ${String(r%60).padStart(2,'0')}초`;\n}\nfunction backToQuestions(){ hide('submittedOverlay'); awaitEnd = false; submitRemain = null; }\n// choice: 'next'(다음 교시) · 'result'(결과 보기) · 없음(제출해 둔 채 시간이 끝남 → 교시 전환 창)\nfunction endSession(choice){\n  hide('submittedOverlay'); awaitEnd = false;\n  submitted = true; clearInterval(timerId);\n  if(submitRemain != null){ remainSec = submitRemain; submitRemain = null; }\n  finishSession(choice);\n}\n\n// ═════════ 결과 ═════════\nfunction showResult(){\n  clearInterval(timerId);\n  if(!drillMode) clearResume();   // 끝까지 푼 시험은 이어 풀기 저장본을 지운다\n  hide('examScreen'); closeMemo(); hide('calcWin'); hide('padWin'); show('resultScreen');\n  const graded = q => q.answer>=1 && q.answer<=5;   // 정답이 지정된 채점 가능 문항\n  const bySub = {};\n  Q.forEach((q,i)=>{\n    if(!graded(q)) return;                            // 정답 미설정 → 채점 제외\n    if(!bySub[q.subject]) bySub[q.subject]={n:0,ok:0};\n    bySub[q.subject].n++;\n    if(answers[i]===q.answer) bySub[q.subject].ok++;\n  });\n  const totalN = Q.filter(graded).length;\n  const totalOk = Q.reduce((s,q,i)=>s+((graded(q)&&answers[i]===q.answer)?1:0),0);\n  const usedSec = limitSec - Math.max(0, remainSec);\n  const timeLine = `풀이 시간: ${Math.floor(usedSec/60)}분 ${usedSec%60}초 / 제한 ${Math.round(limitSec/60)}분` + (accPauses ? ` · 일시정지 ${accPauses}회` : '');\n\n  $('studyNote').classList.add('hidden');\n  $('resArea').classList.add('hidden');\n  $('resStudyBtn').classList.toggle('hidden', !STUDY_ON);\n  if(totalN === 0){   // 방어용: 채점 가능한 문항이 없을 때\n    $('scoreTable').innerHTML =\n      `<tr><th>과목</th><th>문항 수</th><th>정답 수</th><th>정답률</th></tr>\n       <tr class=\"total\"><td>총계</td><td>${Q.length}</td><td>-</td><td>채점 제외</td></tr>`;\n    $('verdict').textContent = '풀이를 마쳤어요 ✅';\n    $('verdict').className = 'verdict pass';\n    document.querySelector('.verdict-sub').innerHTML =\n      `이 세트는 정답이 지정된 문항이 없어 채점을 생략했어요. 아래에서 내가 고른 답을 확인해 보세요.<br>${timeLine}`;\n    setReviewFilter('all');\n    return;\n  }\n\n  let anyFail = false;\n  let rows = Object.entries(bySub).map(([s,v])=>{\n    const pct = Math.round(v.ok/v.n*100);\n    const bad = v.ok / v.n < 0.4; if(bad) anyFail = true;   // 반올림한 %로 비교하면 경계에서 틀린다\n    if(drillMode) return `<tr><td>${s}</td><td>${v.n}</td><td>${v.ok}</td><td>${pct}%</td></tr>`;   // 오답 다시 풀기엔 과락 판정 없음\n    return `<tr><td>${s}</td><td>${v.n}</td><td>${v.ok}</td><td class=\"${bad?'bad':''}\">${pct}%${bad?' (과락)':''}</td></tr>`;\n  }).join('');\n  const totalPct = Math.round(totalOk/totalN*100);\n  // 교시를 다 풀기 전에 [결과 보기]를 누르면 푼 교시만의 참고 점수다 → 합격 판정도, 응시 기록의 합격권 표시도 하지 않는다\n  const partial = !drillMode && sessPos < sessQueue.length - 1;\n  const pass = !partial && totalOk / totalN >= 0.6 && !anyFail;   // 예: 72문항 중 43개(59.7%)는 불합격\n  $('scoreTable').innerHTML =\n    `<tr><th>과목</th><th>문항 수</th><th>정답 수</th><th>정답률</th></tr>${rows}\n     <tr class=\"total\"><td>총계</td><td>${totalN}</td><td>${totalOk}</td><td class=\"${totalPct<60?'bad':''}\">${totalPct}%</td></tr>`;\n  if(resAreaOn()) renderResArea();\n  const st = (STUDY_ON && !studyRecorded) ? recordStudy(bySub, totalN, totalOk, partial ? null : pass, usedSec) : null;\n  studyRecorded = true;\n  if(drillMode){\n    $('scoreTable').querySelector('tr.total td:last-child').className = '';\n    $('verdict').textContent = `${totalN}문항 중 ${totalOk}개 맞혔어요`;\n    $('verdict').className = 'verdict ' + (totalOk === totalN ? 'pass' : 'fail');\n    document.querySelector('.verdict-sub').innerHTML = `오답 다시 풀기는 합격 판정 없이 채점만 해요.<br>${timeLine}`;\n  } else if(partial){\n    $('verdict').textContent = `${sessQueue.slice(0, sessPos + 1).join('·')}교시 참고 점수예요`;\n    $('verdict').className = 'verdict';\n    document.querySelector('.verdict-sub').innerHTML =\n      `${sessQueue.slice(sessPos + 1).join('·')}교시를 풀지 않아 합격 판정은 하지 않아요. 과목별 40% 기준만 참고로 표시했어요.<br>${timeLine}`;\n  } else {\n    $('verdict').textContent = pass ? '합격권입니다! 🎉' : '아쉽지만 불합격권입니다';\n    $('verdict').className = 'verdict ' + (pass?'pass':'fail');\n    document.querySelector('.verdict-sub').innerHTML =\n      `합격 기준: 전 과목 총점의 60% 이상 &amp; 매 과목 40% 이상 (실제 필기시험 기준)<br>${timeLine}`;\n  }\n  if(st){\n    let msg;\n    if(!st.saved) msg = '이 브라우저에서는 기록을 저장하지 못했어요. (저장 공간이 꺼져 있거나 가득 찼을 수 있어요)';\n    else if(drillMode) msg = `맞힌 <b>${st.removed}문항</b>은 오답노트에서 뺐어요 · 남은 오답 <b>${st.remain}문항</b>`;\n    else {\n      msg = st.wrongNow ? `틀리거나 비운 <b>${st.wrongNow}문항</b>을 오답노트에 담았어요` : '틀린 문제가 없어 오답노트에 담을 게 없어요 👏';\n      if(st.removed) msg += ` · 예전에 틀렸다가 이번에 맞힌 ${st.removed}문항은 뺐어요`;\n      if(st.diffs.length) msg += '<br>지난번 대비: ' + st.diffs.map(([s, v]) => `${esc(s)} ${v > 0 ? '+' + v : v < 0 ? '−' + (-v) : '±0'}%p`).join(' · ');\n    }\n    $('studyNote').innerHTML = msg;\n    $('studyNote').classList.remove('hidden');\n  }\n  setReviewFilter('wrong');\n}\n// ═════════ 문항·해설 보호 ═════════\n// 해설은 화면에서만 본다. 인쇄(Ctrl·⌘+P)·페이지 저장(Ctrl·⌘+S) 단축키를 막고, 인쇄 화면엔 안내 문구만 나오게 했다(@media print).\n// 복사·잘라내기·끌어 옮기기는 메모·입력칸 말고는 막는다. 시험 화면의 글자 선택(형광펜)은 그대로 둔다.\n// 우클릭은 결과·오답노트 화면과 그림에서 막는다. 화면 캡처는 웹에서 막을 수 없어 약관·결과 화면 안내로 보완한다.\nfunction editableTarget(t){ return !!(t && t.closest && t.closest('input, textarea, [contenteditable=\"true\"]')); }\ndocument.addEventListener('keydown', e => {\n  const k = (e.key || '').toLowerCase();\n  if((e.ctrlKey || e.metaKey) && (k === 'p' || k === 's')){\n    e.preventDefault();\n    alert('문항과 해설은 화면에서만 볼 수 있어요.\\n인쇄·PDF 저장·페이지 저장은 지원하지 않아요.');\n  }\n});\n['copy', 'cut'].forEach(ev => document.addEventListener(ev, e => { if(!editableTarget(e.target)) e.preventDefault(); }));\ndocument.addEventListener('dragstart', e => { if(!editableTarget(e.target)) e.preventDefault(); });\ndocument.addEventListener('contextmenu', e => {\n  const t = e.target;\n  if(t && t.closest && (t.closest('#resultScreen, #studyScreen') || t.tagName === 'IMG')) e.preventDefault();\n});\n\n// ═════════ 문항 태그 ═════════\n// questions.js 끝의 QTAGS가 문항마다 q.tag = {c:분류, a:세부 영역, k:유형 키워드, p:출제 포인트, n:핵심개념}을 붙인다.\n// 해설 칸 태그는 모든 버전에서 보인다(2026-09-29 체험 사이트 cbt1·cbt2도 켬).\nconst TAG_CATS = ['이론·개념', '평가·해석', '중재·상담'];\nconst TAG_AREAS = {\n  '신경언어장애': ['신경해부·뇌혈관', '실어증', '실독증·실서증', '말운동장애', '삼킴장애', '인지의사소통장애'],\n  '언어발달장애': ['초기 의사소통·상징행동', '어휘·의미', '문법·형태', '화용·대화', '이야기·담화', '읽기·쓰기', '대상군 특성', '중재 방법·AAC'],\n  '유창성장애': ['말더듬 이론·특성', '비유창성 분석', '평가도구', '발달 단계·감별', '학령전 아동 치료·부모 상담', '학령기·성인 치료'],\n  '음성장애': ['해부·생리·음향 기초', '음성장애 유형', '음성 평가', '음성치료 기법·음성위생', '공명장애', '특수 대상'],\n  '조음음운장애': ['음성학·음운론 기초', '말소리 발달·오류패턴', '평가·분석 지표', '치료 접근·목표 선정', '음운인식', '구개열·기질적 말소리장애', '말운동 말소리장애', '청각·청각장애'],\n  '언어재활현장실무': ['법·제도', '윤리·역할', '상담', '연구·통계', '다문화·이중언어', '통합 사례'],\n};\nfunction tagsOn(){ return true; }\n// 결과 화면 '세부 영역별 오답률'은 체험 사이트(cbt1·cbt2)만 — 이번 시험분만 세고 저장하지 않는다.\n// 정식판은 여러 번 푼 기록을 모으는 오답노트 약점 그래프(weakHTML)로 본다.\nfunction resAreaOn(){ return !!window.IS_TRIAL_SITE && !drillMode; }\nfunction renderResArea(){\n  const st = {};\n  Q.forEach((q, i) => {\n    if(!(q.answer >= 1 && q.answer <= 5) || !q.tag || !TAG_AREAS[q.subject]) return;\n    const s = st[q.subject] = st[q.subject] || { area: {}, cat: {} };\n    const wrong = answers[i] === q.answer ? 0 : 1;   // 비운 문항도 틀린 것으로 센다\n    [['area', q.tag.a], ['cat', q.tag.c]].forEach(([kind, name]) => {\n      const v = s[kind][name] = s[kind][name] || { seen: 0, wrong: 0 };\n      v.seen++; v.wrong += wrong;\n    });\n  });\n  const subs = Object.keys(st);\n  if(!subs.length) return;\n  const cards = subs.map(s => {\n    const v = st[s];\n    const cats = TAG_CATS.filter(c => v.cat[c]).map(c => {\n      const x = v.cat[c];\n      return `${c.split('·')[0]} ${x.seen >= WK_MIN ? Math.round(x.wrong / x.seen * 100) + '%' : x.wrong + '/' + x.seen}`;\n    }).join(' · ');\n    return `<div class=\"wk-card\"><h3><span>${esc(s)}</span></h3>\n      <div class=\"wk-cats\">오답률 · ${cats}</div>${wkRows(TAG_AREAS[s].filter(a => v.area[a]), v.area, '', '', true)}</div>`;\n  }).join('');\n  $('resArea').innerHTML = `<h3 class=\"ra-h\">세부 영역별 오답률 (이번 시험)</h3>\n    <div class=\"wk-note\" style=\"margin:0 0 10px;\">막대는 영역마다 틀리거나 비운 문항의 비율이에요. 가장 약한 영역은 빨간색, 문항이 ${WK_MIN}개보다 적은 영역은 회색으로 보여요.</div>\n    <div class=\"wk-grid\">${cards}</div>`;\n  $('resArea').classList.remove('hidden');\n}\nfunction tagHTML(q){\n  const t = tagsOn() && q && q.tag;\n  if(!t) return '';\n  return `<div class=\"rv-tags\"><span class=\"tg-cat\">${esc(t.c)}</span><span class=\"tg-area\">${esc(t.a)}</span>${t.k ? `<span class=\"tg-kw\">${esc(t.k)}</span>` : ''}</div>\n    <div class=\"rv-meta\">${t.p ? `<div><b>출제 포인트</b>${esc(t.p)}</div>` : ''}${t.n ? `<div><b>핵심개념</b>${esc(t.n)}</div>` : ''}</div>`;\n}\n\nfunction setReviewFilter(mode){\n  const area = $('reviewArea');\n  const graded = q => q.answer>=1 && q.answer<=5;\n  const items = Q.map((q,i)=>({q,i})).filter(({q,i}) => mode==='all' || (graded(q) && answers[i]!==q.answer));\n  if(!items.length){\n    area.innerHTML = '<div class=\"rv-card\" style=\"text-align:center;color:#1a7f37;font-weight:700;\">틀린 문제가 없습니다! 완벽해요 👏</div>';\n    return;\n  }\n  area.innerHTML = `<div style=\"text-align:center;color:#68738a;margin-bottom:12px;font-size:14px;\">${mode==='all'?'전체':'틀린'} 문제 해설 (${items.length}문항)</div>` +\n    items.map(({q,i})=>{\n      const my = answers[i], g = graded(q);\n      const badge = !g ? '<span class=\"rv-badge skip\">정답 미설정</span>'\n                  : !my ? '<span class=\"rv-badge skip\">안 품</span>'\n                  : my===q.answer ? '<span class=\"rv-badge ok\">정답</span>'\n                  : '<span class=\"rv-badge no\">오답</span>';\n      return `<div class=\"rv-card\">\n        <div class=\"rv-head\">${badge}${drillMode?`<span class=\"rv-origin\">${keyLabel(Q_KEY.get(q))}</span>`:''}<b>${i+1}.</b> ${esc(q.q)} <span class=\"subj\" style=\"font-size:12px;color:#33518e;\">[${esc(q.subject)}]</span></div>\n        ${q.stem?`<div class=\"rv-stem\">${fmt(q.stem)}</div>`:''}\n        ${q.image?`<div class=\"qimg-wrap\"><img class=\"qimg\" src=\"${esc(q.image)}\" alt=\"문항 자료 이미지\" title=\"클릭하면 크게 볼 수 있습니다\" onclick=\"openImg(this.src)\"><div class=\"qimg-hint\"><button type=\"button\" class=\"qimg-btn\" onclick=\"openImg(this.closest('.qimg-wrap').querySelector('img').src)\">&#128269; 크게 보기</button></div></div>`:''}\n        <ul class=\"rv-choices\">\n          ${q.choices.map((c,ci)=>{\n            const cls = [g&&ci+1===q.answer?'correct':'', my===ci+1?('mine'+(g&&my!==q.answer?' wrong':'')):''].join(' ');\n            return `<li class=\"${cls}\">${circled(ci)} ${esc(c)}${g&&ci+1===q.answer?' ✔':''}${g&&my===ci+1&&my!==q.answer?' ← 내 답':''}${!g&&my===ci+1?' ← 내 답':''}</li>`;\n          }).join('')}\n        </ul>\n        ${tagHTML(q)}\n        ${explainHTML(q, Q_KEY.get(q))}\n      </div>`;\n    }).join('');\n  window.scrollTo(0,0);\n}\n\n</script>\n<script>\n// PC 안내에 지금 접속한 주소를 그대로 표시(소소숲·Vercel 등 배포처가 여럿이라 고정하지 않음)\n(function(){var e=document.getElementById('pcOnlyUrl');\n if(e) e.textContent = location.host + location.pathname.replace(/\\/index\\.html$/,'');})();\n</script>\n</body>\n</html>\n"