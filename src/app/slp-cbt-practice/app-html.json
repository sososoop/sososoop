"<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>언어재활사 CBT 연습</title>\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css\">\n<style>\n:root{\n  /* 새 팔레트 · 민트 + 코발트 · 소프트 뉴브루탈리즘(얇은 검정 테두리 · 각진 모서리 · 그림자 없음) */\n  --mint:#12B5A5; --mint-soft:#e1f6f2; --mint-d:#0e9488;\n  --pop:#3B5BDB;  --pop-soft:#e5e9fb; --pop-d:#2f49b0;\n  --ink:#1a1a1a;  --gray:#6b7280;\n  --red:#e0342a;  --amber:#e8931c;\n  --bg:#e9e9e4;   --paper:#fff;\n  --bd:1.5px solid var(--ink);\n  /* ── 레거시 변수명 호환(인라인 스타일 대비) ── */\n  --navy:#1a1a1a; --navy-d:#000; --navy-btn:#3B5BDB;\n  --blue:#3B5BDB; --blue-l:#e5e9fb; --teal:#12B5A5;\n  --line:#1a1a1a; --omr:#12B5A5; --canvas:#fff; --pearl:#f4f4ef;\n  --ink-muted:#6b7280;\n}\n*{margin:0;padding:0;box-sizing:border-box;}\nhtml,body{height:100%;}\nbody{font-family:\"Pretendard Variable\",Pretendard,\"Apple SD Gothic Neo\",\"Malgun Gothic\",sans-serif;background:var(--paper);color:var(--ink);overflow:hidden;}\nbutton{font-family:inherit;cursor:pointer;}\n.hidden{display:none!important;}\n\n/* ───── 시작(로그인) 화면 ───── */\n#startScreen{height:100vh;display:flex;flex-direction:column;overflow:auto;background:var(--bg);}\n.start-top{background:#fff;color:var(--ink);display:flex;align-items:center;justify-content:space-between;padding:12px 22px;min-height:64px;border-bottom:var(--bd);flex-shrink:0;}\n.start-top .clockbox{text-align:right;font-size:13px;line-height:1.5;font-weight:600;}\n.login-wrap{max-width:900px;margin:26px auto;background:#fff;border:var(--bd);overflow:hidden;width:94%;flex-shrink:0;}\n.login-title{background:var(--mint);color:#fff;text-align:center;font-size:24px;font-weight:900;padding:15px;border-bottom:var(--bd);}\n.login-body{padding:24px 30px;}\n.login-notice{background:var(--mint-soft);border:var(--bd);text-align:center;padding:15px;font-weight:800;margin-bottom:20px;color:var(--ink);}\n.login-table{display:flex;gap:0;border:var(--bd);}\n.photo-col{width:170px;border-right:var(--bd);display:flex;flex-direction:column;}\n.photo{flex:1;display:flex;align-items:center;justify-content:center;background:#f4f4ef;font-size:60px;color:#b6c0ae;min-height:160px;}\n.seat{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px;border-top:var(--bd);}\n.seat-circle{width:82px;height:82px;background:var(--mint);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:900;border:var(--bd);}\n.seat-circle small{font-size:11px;font-weight:700;}\n.seat-circle span{font-size:28px;line-height:1;}\n.info-col{flex:1;}\n.info-row{display:flex;border-bottom:var(--bd);min-height:50px;}\n.info-row:last-child{border-bottom:none;}\n.info-row .th{width:150px;background:#f4f4ef;color:var(--ink);font-weight:800;display:flex;align-items:center;padding-left:16px;border-right:var(--bd);}\n.info-row .td{flex:1;display:flex;align-items:center;padding-left:14px;gap:8px;flex-wrap:wrap;}\n.info-row input[type=text]{border:var(--bd);padding:8px 10px;font-size:15px;width:220px;background:#fff;}\n.info-row input[type=text]::placeholder{color:var(--gray);opacity:.55;}\n.info-row-name{min-height:78px;}\n.info-row-name .td{flex-direction:column;align-items:flex-start;justify-content:center;gap:6px;padding-top:10px;padding-bottom:10px;}\n.name-hint{font-size:12px;color:var(--gray);width:100%;}\n.sess-btn{border:var(--bd);background:#fff;padding:9px 15px;font-size:13.5px;font-weight:700;color:var(--ink);}\n.sess-btn.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.login-foot{background:#f4f4ef;padding:18px;text-align:center;border-top:var(--bd);}\n.login-btn{background:var(--pop);color:#fff;border:var(--bd);border-color:var(--pop);font-size:19px;font-weight:900;padding:13px 64px;}\n.login-btn:hover{background:var(--pop-d);}\n.start-hint{font-size:12.5px;color:var(--gray);margin-top:10px;line-height:1.6;}\n.disclaimer{font-size:11.5px;color:#9aa08f;margin-top:14px;padding-top:12px;border-top:1px dashed #c9c9bf;line-height:1.6;}\n\n/* ───── 시험 화면 레이아웃 ───── */\n#examScreen{height:100vh;display:flex;flex-direction:column;}\n.exam-header{background:#fff;color:var(--ink);display:flex;align-items:center;justify-content:space-between;padding:0 16px;height:62px;flex:0 0 62px;border-bottom:var(--bd);}\n.eh-left{display:flex;align-items:center;gap:10px;}\n.seat-mini{width:40px;height:40px;background:var(--mint);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:900;border:var(--bd);}\n.eh-left .who{font-size:12.5px;line-height:1.5;}\n.eh-title{font-size:18px;font-weight:900;position:absolute;left:50%;transform:translateX(-50%);white-space:nowrap;}\n.eh-right{display:flex;align-items:center;gap:12px;}\n.util-label{font-size:11px;text-align:center;line-height:1.2;color:var(--gray);font-weight:700;}\n.font-btns,.layout-btns{display:flex;gap:5px;align-items:flex-end;}\n.fbtn{width:42px;border:var(--bd);background:#fff;color:var(--ink);padding:6px 0 3px;display:flex;flex-direction:column;align-items:center;font-weight:800;}\n.fbtn small{font-size:9px;color:var(--gray);}\n.fbtn.f80{font-size:13px;} .fbtn.f100{font-size:16px;} .fbtn.f125{font-size:19px;}\n.fbtn.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.fbtn.active small{color:#fff;}\n.lbtn{width:38px;height:38px;border:var(--bd);background:#fff;padding:5px;display:flex;gap:3px;}\n.lbtn div{flex:1;background:var(--mint);}\n.lbtn.active{background:var(--pop);border-color:var(--pop);} .lbtn.active div{background:#fff;}\n.divider{width:1.5px;height:36px;background:var(--ink);}\n.timerbox{display:flex;align-items:center;gap:8px;}\n.clock-ic{width:36px;height:36px;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;border:var(--bd);}\n.timerbox .txt{font-size:12.5px;line-height:1.5;font-weight:600;}\n.timerbox .remain{color:var(--ink);font-weight:800;}\n.timerbox .remain b{background:var(--red);color:#fff;padding:0 5px;font-size:14px;}\n\n.exam-main{flex:1;display:flex;min-height:0;}\n/* 왼쪽 세로 툴바 */\n.leftbar{flex:0 0 auto;width:158px;background:#fafafa;border-right:var(--bd);display:flex;flex-direction:column;gap:12px;padding:12px 8px;overflow-y:auto;}\n.toolv{border:var(--bd);background:#fff;color:var(--ink);font-weight:800;font-size:13px;padding:10px 4px;display:flex;flex-direction:column;align-items:center;gap:4px;}\n.toolv .tv-ic{font-size:18px;line-height:1;}\n.toolv:hover{background:var(--mint-soft);}\n.toolgroup{border:var(--bd);background:#fff;padding:8px;display:flex;flex-direction:column;gap:6px;align-items:center;}\n.toollabel{font-size:11px;font-weight:800;color:var(--gray);}\n.leftbar .font-btns{gap:4px;} .leftbar .fbtn{width:38px;}\n/* 문제 컬럼 + 상단 진행바 */\n.paper-col{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0;}\n.progline{flex:0 0 auto;display:flex;align-items:center;gap:12px;padding:10px 18px;border-bottom:var(--bd);background:#fff;}\n.prognum{font-weight:800;font-size:13px;white-space:nowrap;color:var(--ink);}\n.progwrap{flex:1;height:12px;border:var(--bd);background:#fff;overflow:hidden;}\n.progbar{height:100%;width:0%;background:var(--pop);transition:width .2s;}\n.paper{flex:1;background:#fff;overflow-y:auto;padding:18px 20px;min-width:0;}\n.paper-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 24px;}\n.paper-grid.one{grid-template-columns:1fr;max-width:820px;margin:0 auto;}\n.qcol{border-right:none;padding-right:0;}\n.paper-grid.one .qcol,.qcol:last-child{border-right:none;padding-right:0;}\n\n.qcard{background:#fff;border:var(--bd);padding:16px 18px 20px;margin-bottom:16px;}\n.qtools{display:flex;flex-direction:column;align-items:flex-end;gap:4px;margin-bottom:6px;}\n.qtools-row{display:flex;gap:6px;}\n.tool-btn{border:var(--bd);background:#fff;color:var(--ink);font-size:12px;padding:4px 10px;font-weight:700;display:flex;align-items:center;gap:4px;}\n.tool-btn.on{background:var(--pop);color:#fff;border-color:var(--pop);}\n.tool-btn.memo-on{background:var(--amber);color:#fff;border-color:var(--amber);}\n.tool-btn.pen-on{background:#e8a400;color:#fff;border-color:#e8a400;}\n.qhead{font-weight:800;font-size:1.05em;display:flex;gap:8px;margin-bottom:10px;line-height:1.55;}\n.qhead .subj{color:#fff;font-size:.78em;font-weight:800;background:var(--mint);padding:3px 10px;align-self:flex-start;margin-top:2px;white-space:nowrap;}\n.stem{border:var(--bd);padding:12px 14px;margin:0 0 12px;line-height:1.7;background:var(--mint-soft);white-space:pre-wrap;}\n.qimg-wrap{margin:0 0 12px;}\n.qimg{max-width:100%;max-height:220px;width:auto;height:auto;border:var(--bd);display:block;cursor:zoom-in;background:#fff;}  /* 문제 화면은 작게, 크게 보기는 팝업 창에서 */\n.qimg-hint{margin-top:6px;}\n.qimg-btn{border:var(--bd);background:#fff;padding:4px 10px;font-size:12.5px;font-weight:700;color:var(--ink);cursor:pointer;}\n.qimg-btn:hover{background:var(--mint-soft);}\n/* 문항 이미지 크게 보기(팝업) */\nu.ul{text-decoration:underline;text-decoration-thickness:1.5px;text-underline-offset:4px;}\n/* 문항 이미지 창 — 제목줄 끌어 이동, 오른쪽 아래 모서리 끌어 크기조절(모바일은 전체화면) */\n#imgWin{z-index:70;display:flex;flex-direction:column;min-width:260px;min-height:180px;box-shadow:0 10px 30px rgba(0,0,0,.3);}\n#imgWin .iw-tip{font-weight:500;font-size:12px;opacity:.85;margin-left:10px;}\n#imgWin .iw-body{flex:1;min-height:0;background:#fff;padding:8px;display:flex;align-items:center;justify-content:center;}\n#imgWin .iw-body img{width:100%;height:100%;object-fit:contain;display:block;}\n#imgWin .iw-grip{position:absolute;right:0;bottom:0;width:22px;height:22px;cursor:nwse-resize;background:linear-gradient(135deg,transparent 0 50%,#555 50% 58%,transparent 58% 68%,#555 68% 76%,transparent 76%);}\n@media (max-width:699px){ #imgWin .iw-grip,#imgWin .iw-tip{display:none;} }\n.choices{list-style:none;}\n.choices li{display:flex;align-items:flex-start;gap:9px;padding:9px 11px;line-height:1.6;border:var(--bd);margin-bottom:7px;background:#fff;}\n.choices li .num{flex:0 0 auto;width:1.6em;height:1.6em;border:var(--bd);display:flex;align-items:center;justify-content:center;font-size:.85em;font-weight:800;margin-top:.05em;}\n.choices li .ctext{flex:1;cursor:pointer;}\n.choices li:hover{background:#f7f7f2;}\n.choices li.sel{background:var(--pop-soft);border-color:var(--pop);}\n.choices li.sel .num{background:var(--pop);color:#fff;border-color:var(--pop);}\n.choices li.sel .ctext{font-weight:800;}\n.choices li.strike .ctext{color:#b0b0b0;text-decoration:line-through;}\n.choices li.strike .num{border-color:#b0b0b0;color:#b0b0b0;}\n.strike-btn{flex:0 0 auto;border:var(--bd);background:#fff;color:var(--gray);font-size:11px;padding:2px 7px;margin-top:2px;}\n.strike-btn.on{background:var(--ink);color:#fff;border-color:var(--ink);}\n\n/* OMR */\n.omr{flex:0 0 208px;background:#fafafa;border-right:var(--bd);display:flex;flex-direction:column;}\n.omr-tools{display:flex;gap:6px;padding:8px 8px 0;}\n.omr-tools button{flex:1;border:var(--bd);background:#fff;padding:6px 0;font-size:12px;font-weight:800;color:var(--ink);}\n.omr-tools button:hover{background:var(--mint-soft);}\n.omr-title{background:var(--mint);color:#fff;text-align:center;font-weight:900;padding:10px;font-size:15px;flex:0 0 auto;border-bottom:var(--bd);}\n.omr-list{flex:1;overflow-y:auto;padding-bottom:10px;}\n.omr-row{display:flex;align-items:center;padding:4px 6px 4px 4px;}\n.omr-row.sep{border-bottom:1px dashed var(--mint);}\n.omr-row .flags{width:26px;display:flex;flex-direction:column;font-size:10px;line-height:1;gap:1px;align-items:center;color:var(--amber);}\n.omr-row .flags .chk{color:var(--red);}\n.omr-row .no{width:26px;text-align:center;color:var(--ink);font-weight:800;font-size:13px;background:#fff;border:var(--bd);padding:3px 0;margin-right:5px;cursor:pointer;}\n.omr-row.cur .no{background:var(--pop);color:#fff;border-color:var(--pop);}\n.omr-row .bubbles{display:flex;gap:4px;}\n.bub{width:22px;height:22px;border:var(--bd);color:var(--ink);background:#fff;font-size:11px;display:flex;align-items:center;justify-content:center;padding:0;}\n.bub.mark{background:var(--pop);border-color:var(--pop);color:#fff;}\n\n/* 하단바 */\n.exam-footer{background:#f4f4ef;border-top:var(--bd);display:flex;align-items:center;justify-content:space-between;padding:0 12px;height:60px;flex:0 0 60px;gap:8px;}\n.ef-group{display:flex;align-items:center;gap:8px;}\n.wbtn{background:#fff;border:var(--bd);padding:9px 15px;font-size:13.5px;font-weight:700;color:var(--ink);}\n.wbtn:hover{background:var(--mint-soft);}\n.wbtn.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.pager{display:flex;align-items:center;gap:10px;font-size:16px;font-weight:800;}\n.pager .pbtn{background:#fff;border:var(--bd);padding:9px 16px;font-size:14px;font-weight:800;color:var(--ink);}\n.pager .pbtn:hover{background:var(--mint-soft);}\n.submit-btn{background:var(--pop);color:#fff;border:var(--bd);border-color:var(--pop);padding:11px 20px;font-size:14px;font-weight:800;}\n.submit-btn:hover{background:var(--pop-d);}\n\n/* 모달 */\n.overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;z-index:90;}\n.modal{background:#fff;border:var(--bd);min-width:340px;max-width:560px;overflow:hidden;}\n.modal-head{background:var(--red);color:#fff;font-weight:900;text-align:center;padding:12px;position:relative;font-size:16px;border-bottom:var(--bd);}\n.modal-head.blue{background:var(--pop);}\n.modal-head .x{position:absolute;right:10px;top:8px;background:none;border:none;color:#fff;font-size:20px;}\n.modal-body{padding:24px 28px;text-align:center;font-size:15.5px;line-height:1.7;}\n.modal-body .big-clock{width:54px;height:54px;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 14px;border:var(--bd);}\n.modal-foot{padding:0 0 20px;text-align:center;display:flex;gap:10px;justify-content:center;}\n.m-btn{border:var(--bd);padding:10px 24px;font-size:14px;font-weight:800;color:#fff;background:var(--red);border-color:var(--red);}\n.m-btn.gray{background:var(--gray);border-color:var(--gray);}\n.m-btn.blue{background:var(--pop);border-color:var(--pop);}\n/* 일시정지: 문제를 가리도록 불투명 배경, 떠 있는 창·모달보다 위 */\n.pause-overlay{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:95;}\n.pause-overlay .modal-body .big-clock{background:var(--pop);}\n/* 제출 완료 창은 버튼이 셋이라 조금 넓게 */\n#submittedOverlay .modal{min-width:480px;}\n#submittedOverlay .modal-foot{padding:0 24px 22px;}\n#submittedOverlay .m-btn{padding:10px 18px;}\n\n/* 메모/계산기/그림판 */\n.float-win{position:fixed;z-index:60;background:#fff;border:var(--bd);overflow:hidden;}\n.fw-head{background:var(--mint);color:#fff;padding:9px 12px;font-weight:800;cursor:move;display:flex;justify-content:space-between;align-items:center;font-size:14px;border-bottom:var(--bd);}\n.fw-head button{background:none;border:none;color:#fff;font-size:17px;}\n#memoText{width:320px;height:180px;border:none;outline:none;padding:12px;font-size:14px;resize:none;font-family:inherit;}\n.calc-body{padding:10px;width:230px;}\n#calcDisp{width:100%;border:var(--bd);text-align:right;font-size:22px;padding:8px;margin-bottom:8px;font-family:inherit;}\n.calc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;}\n.calc-grid button{padding:11px 0;font-size:16px;border:var(--bd);background:#fff;font-weight:700;}\n.calc-grid button.op{background:var(--mint-soft);font-weight:800;}\n.calc-grid button.eq{background:var(--pop);color:#fff;border-color:var(--pop);grid-column:span 2;}\n#padCanvas{display:block;background:#fff;cursor:crosshair;}\n.pad-tools{display:flex;gap:6px;padding:8px;background:var(--mint-soft);border-bottom:var(--bd);}\n.pad-tools button{border:var(--bd);background:#fff;padding:5px 12px;font-size:13px;font-weight:700;}\n.pad-tools button.on{background:var(--pop);color:#fff;border-color:var(--pop);}\n\n/* 결과 화면 */\n#resultScreen{height:100vh;overflow-y:auto;background:var(--bg);}\n.res-wrap{max-width:860px;margin:26px auto 60px;width:94%;}\n.res-card{background:#fff;border:var(--bd);overflow:hidden;margin-bottom:20px;}\n.res-title{background:var(--mint);color:#fff;font-size:21px;font-weight:900;text-align:center;padding:15px;border-bottom:var(--bd);}\n.res-body{padding:26px 30px;}\n.verdict{text-align:center;font-size:30px;font-weight:900;margin-bottom:6px;}\n.verdict.pass{color:var(--mint-d);} .verdict.fail{color:var(--red);}\n.verdict-sub{text-align:center;color:var(--gray);margin-bottom:20px;font-size:13.5px;line-height:1.6;}\ntable.score{width:100%;border-collapse:collapse;font-size:14.5px;}\ntable.score th,table.score td{border:var(--bd);padding:10px;text-align:center;}\ntable.score th{background:var(--mint-soft);color:var(--ink);font-weight:800;}\ntable.score td.bad{color:var(--red);font-weight:800;}\ntable.score tr.total td{font-weight:900;background:#f4f4ef;}\n.res-actions{display:flex;gap:10px;justify-content:center;margin-top:24px;flex-wrap:wrap;}\n.review-filter{display:flex;gap:8px;justify-content:center;margin-bottom:18px;}\n.rv-card{background:#fff;border:var(--bd);padding:20px 22px;margin-bottom:14px;}\n.rv-card .rv-head{font-weight:800;margin-bottom:8px;line-height:1.6;}\n.rv-badge{display:inline-block;font-size:12px;font-weight:800;padding:2px 8px;margin-right:6px;color:#fff;border:var(--bd);}\n.rv-badge.ok{background:var(--mint-d);border-color:var(--mint-d);} .rv-badge.no{background:var(--red);border-color:var(--red);} .rv-badge.skip{background:var(--gray);border-color:var(--gray);}\n.rv-stem{border:var(--bd);padding:10px 12px;margin-bottom:10px;line-height:1.6;font-size:14px;background:var(--mint-soft);white-space:pre-wrap;}\n.rv-choices{list-style:none;font-size:14.5px;line-height:1.8;margin-bottom:10px;}\n.rv-choices li.correct{color:var(--mint-d);font-weight:800;}\n.rv-choices li.mine{text-decoration:underline;}\n.rv-choices li.mine.wrong{color:var(--red);font-weight:800;}\n.rv-explain{background:var(--mint-soft);border:var(--bd);border-left:5px solid var(--mint);padding:10px 14px;font-size:14px;line-height:1.7;}\n/* 상세해설(정답 근거·오답 점검) — 버튼 하나로 모든 문항이 함께 펼쳐지고 접힌다 */\n.rv-dbtn-row{margin:8px 0 0;}\n.rv-dbtn{padding:6px 12px;font-size:12.5px;}\n.rv-dbtn .d-close{display:none;}\nhtml.show-detail .rv-dbtn .d-open{display:none;} html.show-detail .rv-dbtn .d-close{display:inline;}\n.rv-detail{display:none;margin-top:8px;background:#fff;border:var(--bd);border-left:5px solid var(--mint);padding:10px 14px;font-size:14px;line-height:1.7;}\nhtml.show-detail .rv-detail{display:block;}\n.rv-detail ul{list-style:none;margin:4px 0 0;padding:0;}\n.rv-detail li{margin:4px 0;padding-left:1.4em;text-indent:-1.4em;}\n.rv-detail .rv-dt{margin-bottom:8px;}\n/* 문항 태그(분류·세부 영역·유형 키워드·출제 포인트·핵심개념) — 정식판·베타 */\n.rv-tags{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 6px;}\n.rv-tags span{font-size:12px;font-weight:800;padding:2px 9px;border:1px solid currentColor;line-height:1.6;}\n.rv-tags .tg-cat{color:var(--pop);} .rv-tags .tg-area{color:var(--mint-d);} .rv-tags .tg-kw{color:var(--ink);border-color:#c9c9bf;font-weight:700;}\n.rv-meta{font-size:13.5px;line-height:1.7;margin-bottom:8px;padding:8px 12px;background:#fff;border:1px dashed #c9c9bf;}\n.rv-meta div + div{margin-top:2px;}\n.rv-meta b{color:var(--pop);margin-right:4px;}\n/* 오답노트 약점 그래프 */\n.wk-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;}\n.wk-card{background:#fff;border:var(--bd);padding:12px 14px;}\n.wk-card h3{font-size:15px;margin:0 0 4px;display:flex;justify-content:space-between;align-items:baseline;gap:8px;}\n.wk-card h3 button{border:none;background:none;color:var(--pop);font-size:12.5px;font-weight:700;padding:0;text-decoration:underline;}\n.wk-cats{font-size:12.5px;color:var(--gray);margin-bottom:8px;}\n.wk-row{display:grid;grid-template-columns:128px 1fr 92px;gap:8px;align-items:center;font-size:12.5px;padding:3px 0;}\n.wk-row.click{cursor:pointer;} .wk-row.click:hover .wk-lbl{text-decoration:underline;}\n.wk-row.on .wk-lbl{color:var(--pop);font-weight:800;}\n.wk-lbl{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n.wk-bar{height:12px;background:#ecece6;position:relative;}\n.wk-bar i{position:absolute;left:0;top:0;bottom:0;background:var(--mint);}\n.wk-row.hot .wk-bar i{background:var(--red);} .wk-row.hot .wk-lbl{font-weight:800;}\n.wk-row.few{color:#a3a39a;} .wk-row.few .wk-bar i{background:#d6d6cc;}\n.wk-val{text-align:right;white-space:nowrap;}\n.wk-big .wk-row{grid-template-columns:170px 1fr 110px;font-size:13.5px;padding:4px 0;}\n.wk-big .wk-bar{height:16px;}\n.wk-sub{font-size:13px;font-weight:800;margin:12px 0 4px;color:var(--ink);}\n.wk-note{font-size:12.5px;color:var(--gray);margin-top:6px;line-height:1.6;}\n.wk-chip{display:inline-flex;gap:6px;align-items:center;font-size:12.5px;font-weight:700;border:1px solid var(--pop);color:var(--pop);padding:2px 8px;margin-left:6px;}\n.res-area{margin-top:18px;}\n.res-area h3.ra-h{font-size:15px;margin:0 0 4px;}\n.res-area .wk-grid{grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr));}\n.wk-chip button{border:none;background:none;color:inherit;padding:0;font-weight:800;}\n\n/* 문제 보기 모달 */\n.viewer{background:#fff;border:var(--bd);width:95vw;max-width:1120px;height:92vh;display:flex;flex-direction:column;overflow:hidden;}\n.viewer-head{background:var(--mint);color:#fff;font-size:19px;font-weight:900;text-align:center;padding:14px;position:relative;flex:0 0 auto;border-bottom:var(--bd);}\n.viewer-head .x{position:absolute;right:14px;top:10px;background:rgba(255,255,255,.25);border:1.5px solid #fff;color:#fff;font-size:18px;width:30px;height:30px;line-height:1;}\n.viewer-guide{padding:9px 20px;font-size:12.5px;color:var(--ink);background:var(--mint-soft);line-height:1.6;flex:0 0 auto;border-bottom:var(--bd);}\n.viewer-tabs{display:flex;flex:0 0 auto;}\n.v-tab{flex:1;padding:12px;font-size:15px;font-weight:800;border:var(--bd);border-top:none;background:#fff;color:var(--ink);}\n.v-tab.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.viewer-body{flex:1;overflow-y:auto;padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:14px;align-content:start;background:var(--bg);}\n.v-card{border:var(--bd);padding:13px 15px;cursor:pointer;background:#fff;}\n.v-card:hover{outline:2px solid var(--pop);border-color:var(--pop);}\n.v-head{display:flex;gap:8px;font-weight:800;margin-bottom:8px;line-height:1.55;font-size:14.5px;}\n.v-no{flex:0 0 auto;background:var(--pop);color:#fff;min-width:1.7em;height:1.7em;padding:0 .3em;display:flex;align-items:center;justify-content:center;font-size:.9em;border:var(--bd);}\n.v-stem{border:var(--bd);padding:8px 10px;margin-bottom:8px;font-size:12.5px;line-height:1.6;white-space:pre-wrap;background:var(--mint-soft);}\n.v-choices{list-style:none;font-size:13.5px;line-height:1.7;}\n.v-choices li.sel{font-weight:800;color:var(--pop);}\n\n/* 형광펜 */\nmark.hl{background:#ffe94d;color:inherit;padding:0;}\n.wbtn.pen-active{background:#e8a400;color:#fff;border-color:#e8a400;}\n.paper.pen-on .stem,.paper.pen-on .ctext,.paper.pen-on .qhead>span{cursor:text;}\n.paper.pen-on mark.hl{cursor:pointer;}\n@media (max-width:900px){ .eh-title{display:none;} .omr{flex-basis:190px;} }\n@media (max-width:760px){ .viewer-body{grid-template-columns:1fr;} }\n\n/* 인쇄(PDF 저장)용 — 결과 화면의 점수표 + 오답풀이만 출력 */\n/* 인쇄·PDF 저장 막기 — 문항과 해설은 화면에서만 본다. 인쇄하면 안내 문구만 나온다 */\n@media print{\n  html,body{ height:auto!important; overflow:visible!important; background:#fff!important; }\n  body > *{ display:none!important; }\n  body::after{ content:'이 화면은 인쇄하거나 PDF로 저장할 수 없어요. 문항과 해설은 앱 화면에서만 볼 수 있어요.'; display:block; padding:60px 20px; text-align:center; font-size:15px; color:#333; }\n}\n/* 결과·오답노트는 글자 선택·복사를 막는다 */\n#resultScreen, #studyScreen{ -webkit-user-select:none; user-select:none; }\n.copy-note{margin-top:14px;font-size:12.5px;color:#68738a;text-align:center;line-height:1.6;}\n.copy-note a{color:inherit;text-decoration:underline;}\n/* ── 로그인 게이트 ── */\n#authGate{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;background:var(--bg);padding:20px;}\n#authGate.hidden{display:none;}\n.ag-card{width:100%;max-width:380px;background:#fff;border:var(--bd);padding:34px 28px 24px;text-align:center;}\n.ag-logo{font-size:38px;line-height:1;}\n.ag-title{font-size:21px;font-weight:900;color:var(--ink);margin-top:10px;}\n.ag-sub{font-size:13px;color:var(--gray);margin-top:6px;line-height:1.5;}\n.ag-form{margin-top:22px;text-align:left;}\n.ag-label{display:block;font-size:12.5px;font-weight:800;color:var(--ink);margin:14px 2px 6px;}\n.ag-form input{width:100%;box-sizing:border-box;padding:12px 13px;border:var(--bd);font-size:15px;background:#fff;outline:none;}\n.ag-form input:focus{border-color:var(--pop);}\n.ag-err{min-height:18px;font-size:12.5px;color:var(--red);margin:10px 2px 0;line-height:1.4;}\n.ag-btn{width:100%;margin-top:8px;padding:13px;border:var(--bd);border-color:var(--mint);background:var(--mint);color:#fff;font-size:16px;font-weight:900;cursor:pointer;}\n.ag-btn:hover{background:var(--mint-d);}\n.ag-btn:disabled{opacity:.6;cursor:default;}\n.ag-note{margin-top:20px;font-size:11.5px;color:var(--gray);line-height:1.6;border-top:var(--bd);padding-top:15px;}\n.logout-btn{border:var(--bd);background:#fff;color:var(--ink);padding:7px 14px;font-size:12.5px;font-weight:700;cursor:pointer;white-space:nowrap;}\n.logout-btn:hover{background:var(--mint-soft);}\n\n/* ───── 대문(첫 화면) — 소소숲 정식판에서만 켠다(window.SHOW_HOME) ───── */\n#homeScreen{height:100vh;display:flex;flex-direction:column;overflow:auto;background:var(--bg);}\n.home-wrap{max-width:900px;width:94%;margin:26px auto 40px;display:flex;flex-direction:column;gap:18px;flex-shrink:0;}\n.home-hero{background:#fff;border:var(--bd);display:flex;align-items:stretch;}\n.home-hero-main{flex:1;padding:24px 28px;}\n.home-kicker{font-size:13px;font-weight:800;color:var(--mint-d);letter-spacing:.02em;}\n.home-hero h1{font-size:25px;font-weight:900;margin:6px 0 8px;line-height:1.35;}\n.home-hero-sub{font-size:14px;color:var(--gray);line-height:1.6;}\n.home-hero-sub b{color:var(--ink);}\n.home-dday{width:210px;flex-shrink:0;background:var(--mint);color:#fff;border-left:var(--bd);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:18px;text-align:center;}\n.home-dday small{font-size:13px;font-weight:700;opacity:.92;}\n.home-dday b{font-size:46px;font-weight:900;line-height:1.1;margin:4px 0;letter-spacing:-.01em;}\n.home-dday span{font-size:12.5px;font-weight:700;opacity:.92;}\n.home-cta{display:flex;justify-content:center;}\n.home-start{background:var(--pop);color:#fff;border:var(--bd);border-color:var(--pop);font-size:20px;font-weight:900;padding:15px 70px;}\n.home-start:hover{background:var(--pop-d);}\n.home-card{background:#fff;border:var(--bd);}\n.home-card h2{font-size:17px;font-weight:900;padding:13px 20px;border-bottom:var(--bd);background:#f4f4ef;display:flex;align-items:center;justify-content:space-between;gap:10px;}\n.home-card h2 small{font-size:12px;font-weight:600;color:var(--gray);}\n.home-card-body{padding:16px 20px;}\n.home-tbl{width:100%;border-collapse:collapse;font-size:14px;}\n.home-tbl th,.home-tbl td{border:1px solid #c9c9bf;padding:9px 12px;text-align:left;vertical-align:middle;line-height:1.5;}\n.home-tbl th{background:#f4f4ef;font-weight:800;white-space:nowrap;}\n.home-tbl td.num{text-align:center;white-space:nowrap;}\n.home-tbl tr.is-next td{background:var(--mint-soft);font-weight:700;}\n.home-tbl tr.is-done td{color:#9aa08f;}\n.home-tag{display:inline-block;font-size:11.5px;font-weight:800;padding:2px 8px;border:1px solid currentColor;white-space:nowrap;}\n.home-tag.done{color:#9aa08f;}\n.home-tag.now{color:var(--red);}\n.home-tag.next{color:var(--mint-d);}\n.home-tag.plan{color:var(--gray);}\n.home-grade-tabs{display:flex;gap:6px;margin-bottom:12px;}\n.home-grade-tabs button{border:var(--bd);background:#fff;padding:7px 18px;font-size:13.5px;font-weight:800;}\n.home-grade-tabs button.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.home-list{list-style:none;display:flex;flex-direction:column;gap:9px;font-size:14px;line-height:1.6;}\n.home-list li{padding-left:16px;position:relative;}\n.home-list li::before{content:'';position:absolute;left:2px;top:.62em;width:6px;height:6px;background:var(--mint);}\n.home-list li b{font-weight:800;}\n.home-video{display:flex;align-items:center;gap:14px;margin-top:16px;padding:13px 16px;border:var(--bd);background:var(--pop-soft);color:var(--ink);text-decoration:none;}\n.home-video:hover{background:#d6ddf8;}\n.home-video-ic{width:44px;height:44px;flex-shrink:0;background:var(--pop);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;border:var(--bd);border-color:var(--pop);}\n.home-video b{display:block;font-size:14.5px;font-weight:900;}\n.home-video small{font-size:12.5px;color:var(--gray);}\n.home-links{display:flex;flex-wrap:wrap;gap:8px;}\n.home-links a{border:var(--bd);background:#fff;color:var(--ink);text-decoration:none;font-size:13px;font-weight:700;padding:8px 13px;}\n.home-links a:hover{background:var(--mint-soft);}\n.home-note{font-size:12.5px;color:var(--gray);margin-top:10px;line-height:1.6;}\n.home-back{border:var(--bd);background:#fff;color:var(--ink);padding:7px 14px;font-size:12.5px;font-weight:700;white-space:nowrap;}\n.home-back:hover{background:var(--mint-soft);}\n.home-tbl-wrap{overflow-x:auto;}\n\n/* ───── 내 학습 기록(오답노트·응시 기록) — 정식판 전용 ───── */\n#studyScreen{height:100vh;display:flex;flex-direction:column;overflow:auto;background:var(--bg);}\n.hs-line{font-size:14px;line-height:1.7;}\n.hs-line + .hs-line{margin-top:4px;}\n.hs-empty{font-size:14px;color:var(--gray);line-height:1.7;}\n.hs-btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;}\n.hs-btns .wbtn b{color:var(--pop);}\n.risk-tag{display:inline-block;font-size:11.5px;font-weight:800;padding:1px 7px;border:1px solid currentColor;white-space:nowrap;margin-right:4px;}\n.risk-tag.fail{color:var(--red);} .risk-tag.warn{color:#b86a00;} .risk-tag.ok{color:var(--mint-d);}\n.st-tabs{display:flex;gap:6px;}\n.st-tabs button{border:var(--bd);background:#fff;padding:10px 22px;font-size:15px;font-weight:900;}\n.st-tabs button.active{background:var(--ink);color:#fff;}\n.st-filter{display:flex;flex-wrap:wrap;gap:6px;align-items:center;}\n.st-filter .lbl{font-size:12.5px;font-weight:800;color:var(--gray);margin-right:4px;min-width:30px;}\n.st-filter button{border:var(--bd);background:#fff;padding:6px 12px;font-size:13px;font-weight:700;}\n.st-filter button.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.st-filter + .st-filter{margin-top:8px;}\n.st-drill{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:14px;padding-top:14px;border-top:1px solid #d6d6cc;font-size:13px;color:var(--gray);}\n.sw-item{background:#fff;border:var(--bd);padding:14px 18px;}\n.sw-item + .sw-item{margin-top:10px;}\n.sw-meta{font-size:12.5px;color:var(--gray);display:flex;flex-wrap:wrap;gap:4px 10px;align-items:center;}\n.sw-meta b{color:var(--ink);font-size:13px;}\n.sw-n{color:var(--red);font-weight:800;}\n.sw-tag{font-size:11.5px;font-weight:700;padding:0 7px;border:1px solid currentColor;line-height:1.6;color:var(--mint-d);}\n.sw-tag.kw{color:var(--ink);border-color:#c9c9bf;}\n.sw-q{margin-top:6px;font-size:14.5px;font-weight:700;line-height:1.55;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}\n.sw-item.open .sw-q{display:block;-webkit-line-clamp:unset;}\n.sw-actions{display:flex;gap:6px;margin-top:10px;}\n.sw-actions .wbtn{padding:6px 12px;font-size:12.5px;}\n.sw-detail{margin-top:12px;}\n.st-clear{border:none;background:none;color:var(--gray);font-size:12.5px;text-decoration:underline;padding:4px;}\n.st-tbl td.bars{min-width:190px;}\n.st-bars{display:flex;align-items:flex-end;gap:3px;height:56px;position:relative;border-bottom:1px solid #9aa08f;}\n.st-bars::before,.st-bars::after{content:'';position:absolute;left:0;right:0;border-top:1px dashed #c9c9bf;}\n.st-bars::before{bottom:40%;} .st-bars::after{bottom:60%;}\n.st-bar{flex:0 0 22px;background:var(--mint);border-radius:4px 4px 0 0;position:relative;z-index:1;min-height:2px;}\n.st-bar:hover{background:var(--mint-d);}\n.st-bar.empty{background:transparent;}\n.st-axis{font-size:11px;color:var(--gray);margin-top:3px;}\n.study-note{margin:-6px 0 18px;padding:10px 14px;border:var(--bd);background:var(--pop-soft);font-size:13.5px;line-height:1.7;text-align:center;}\n.rv-origin{display:inline-block;font-size:12px;font-weight:700;color:var(--gray);margin-right:6px;}\n@media (max-width:720px){\n  .home-hero{flex-direction:column;}\n  .home-dday{width:auto;border-left:none;border-top:var(--bd);flex-direction:row;gap:12px;padding:12px;}\n  .home-dday b{font-size:34px;margin:0;}\n  .home-start{padding:14px 30px;width:100%;}\n  .home-tbl{font-size:13px;}\n  .home-tbl th,.home-tbl td{padding:8px;}\n}\n\n\n/* ── PC 전용 안내 (모바일·세로 태블릿 차단) ────────────────────────\n   터치 기기이면서 화면 폭이 900px 미만일 때만 뜬다.\n   마우스를 쓰는 노트북은 창을 좁혀도 막히지 않고,\n   아이패드는 가로(1024px)로 돌리면 통과한다.\n   화면을 돌리면 미디어쿼리가 다시 판정하므로 별도 스크립트가 없다. */\n#pcOnly{display:none;}\n@media (max-width:899px) and (pointer:coarse){\n  #pcOnly{\n    display:flex;position:fixed;inset:0;z-index:99999;\n    align-items:center;justify-content:center;\n    background:var(--bg,#eeeeea);padding:22px;\n    -webkit-text-size-adjust:100%;\n  }\n  html,body{overflow:hidden!important;}\n}\n.pc-card{width:100%;max-width:340px;background:#fff;border:2px solid #111;padding:32px 22px 24px;text-align:center;}\n.pc-icon{font-size:44px;line-height:1;}\n.pc-title{font-size:20px;font-weight:900;color:#1c1c1a;margin-top:12px;line-height:1.35;}\n.pc-desc{font-size:14px;color:#444;margin-top:14px;line-height:1.7;}\n.pc-url{margin-top:18px;border:1px dashed #999;background:#f7f7f3;padding:12px 10px;font-size:14px;font-weight:800;color:#1c1c1a;word-break:break-all;line-height:1.5;}\n.pc-note{margin-top:18px;border-top:1px solid #ddd;padding-top:14px;font-size:12px;color:#777;line-height:1.7;}\n</style>\n<script>window.SHOW_HOME = true;</script>\n</head>\n<body>\n\n<!-- ═════════ PC 전용 안내 (모바일에서만 표시) ═════════ -->\n<div id=\"pcOnly\">\n  <div class=\"pc-card\">\n    <div class=\"pc-icon\">💻</div>\n    <div class=\"pc-title\">PC에서 이용해 주세요</div>\n    <div class=\"pc-desc\">\n      실제 국가시험은 컴퓨터로 치릅니다.<br>\n      화면 구성과 조작을 그대로 연습하려면<br>\n      PC나 노트북으로 접속해 주세요.\n    </div>\n    <div class=\"pc-url\" id=\"pcOnlyUrl\"></div>\n    <div class=\"pc-note\">※ 위 주소를 PC 브라우저에 입력하시면<br>바로 시작할 수 있어요.</div>\n  </div>\n</div>\n\n\n<!-- ═════════ 시작(로그인) 화면 ═════════ -->\n<!-- ═════════ 로그인 게이트 (베타) ═════════ -->\n<div id=\"authGate\">\n  <div class=\"ag-card\">\n    <div class=\"ag-title\">언어재활사 CBT 연습</div>\n    <div class=\"ag-sub\" id=\"agSub\">베타 테스트 · 발급받은 계정으로 로그인해 주세요</div>\n    <div class=\"ag-form\">\n      <label class=\"ag-label\">아이디</label>\n      <input type=\"text\" id=\"agId\" autocomplete=\"username\" placeholder=\"예: slp01\" spellcheck=\"false\" autocapitalize=\"off\">\n      <label class=\"ag-label\">비밀번호</label>\n      <input type=\"password\" id=\"agPw\" autocomplete=\"current-password\" placeholder=\"비밀번호\" onkeydown=\"if(event.key==='Enter')doLogin()\">\n      <div id=\"agErr\" class=\"ag-err\"></div>\n      <button class=\"ag-btn\" id=\"agBtn\" onclick=\"doLogin()\">로그인</button>\n    </div>\n    <div class=\"ag-note\">※ 계정은 <b>최초 로그인한 기기 1대</b>에서만 사용할 수 있습니다.<br>기기 변경·문의는 관리자에게 연락해 주세요.</div>\n  </div>\n</div>\n\n<!-- ═════════ 대문(첫 화면) · 소소숲 정식판 전용 ═════════ -->\n<div id=\"homeScreen\" class=\"hidden\">\n  <div class=\"start-top\">\n    <div style=\"width:140px;\"></div>\n    <div style=\"font-weight:700;font-size:20px;\">언어재활사 CBT 연습</div>\n    <div style=\"width:140px;\"></div>\n  </div>\n  <div class=\"home-wrap\">\n    <div class=\"home-hero\">\n      <div class=\"home-hero-main\">\n        <div class=\"home-kicker\" id=\"hmKicker\">2026년도 제15회 언어재활사 국가시험</div>\n        <h1 id=\"hmHeadline\">시험일 12월 5일(토)<br>1급·2급 모두 컴퓨터시험(CBT)으로 봅니다</h1>\n        <div class=\"home-hero-sub\" id=\"hmSub\">실제 시험과 같은 교시 구성·제한시간으로 연습해 보세요.<br>시험 전날까지 <b>화면 조작과 시간 배분</b>에 익숙해지는 것이 목표예요.</div>\n      </div>\n      <div class=\"home-dday\" id=\"hmDdayBox\">\n        <small>시험까지</small>\n        <b id=\"hmDday\">D-00</b>\n        <span id=\"hmToday\"></span>\n      </div>\n    </div>\n\n    <div class=\"home-cta\"><button class=\"home-start\" onclick=\"goStart()\">모의 CBT 연습 &rarr;</button></div>\n\n    <div class=\"home-card hidden\" id=\"hmStudyCard\">\n      <h2>내 학습 기록 <small>이 기기에만 저장돼요</small></h2>\n      <div class=\"home-card-body\" id=\"hmStudyBody\"></div>\n    </div>\n\n    <div class=\"home-card\" id=\"hmScheduleCard\">\n      <h2>시험일정 <small>국시원 공고 기준 · 2026년 제15회</small></h2>\n      <div class=\"home-card-body\">\n        <div class=\"home-tbl-wrap\"><table class=\"home-tbl\" id=\"hmSchedule\"></table></div>\n        <div class=\"home-note\">※ 시험장은 11월 4일 공고 후 선택 기간에 직접 고릅니다. 일정은 바뀔 수 있으니 국시원 공지를 꼭 확인하세요.</div>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>교시별 시간표 <small>입장 마감 이후에는 들어갈 수 없어요</small></h2>\n      <div class=\"home-card-body\">\n        <div class=\"home-grade-tabs\">\n          <button class=\"active\" data-hg=\"1\" onclick=\"homeGrade(1)\">1급</button>\n          <button data-hg=\"2\" onclick=\"homeGrade(2)\">2급</button>\n        </div>\n        <div class=\"home-tbl-wrap\"><table class=\"home-tbl\" id=\"hmTimetable\"></table></div>\n        <div class=\"home-note\" id=\"hmTimeNote\"></div>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>합격 기준</h2>\n      <div class=\"home-card-body\">\n        <ul class=\"home-list\">\n          <li><b>전 과목 총점의 60% 이상</b>, 그리고 <b>각 과목 40% 이상</b>을 받아야 합격이에요.</li>\n          <li>한 과목이라도 40% 미만이면 총점이 높아도 불합격(과락)입니다. 약한 과목부터 챙기세요.</li>\n          <li>1급 140문항(140점) · 2급 150문항(150점), 모두 5지선다 객관식이며 문항당 1점이에요.</li>\n          <li><b>문항 수로 보면 (1급)</b> · 24문항 과목은 <b>10문항 이상</b>(현장실무 20문항은 <b>8문항 이상</b>) 맞혀야 과락을 면하고, 총점은 140문항 중 <b>84문항 이상</b>이어야 해요. 24문항 과목으로 치면 과목당 평균 <b>약 15문항</b>(14.4문항)씩이에요.</li>\n          <li><b>문항 수로 보면 (2급)</b> · 신경언어(30) <b>12문항</b> · 유창성·음성(25) <b>10문항</b> · 언어발달·조음음운(35) <b>14문항</b> 이상이면 과락을 면하고, 총점은 150문항 중 <b>90문항 이상</b>이어야 해요. 과목마다 60%씩(30문항 18 · 25문항 15 · 35문항 21문항) 맞히는 셈이에요.</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>시험 당일 주의사항</h2>\n      <div class=\"home-card-body\">\n        <ul class=\"home-list\">\n          <li><b>응시표와 신분증</b>을 꼭 챙기세요. 학생증은 신분증으로 인정되지 않아요. 응시표는 11월 11일부터 국시원 홈페이지에서 출력할 수 있어요.</li>\n          <li><b>식수(생수)는 제공하지 않아요.</b> 필요하면 직접 준비하세요.</li>\n          <li><b>입장 마감 시간</b>까지 도착해야 합니다. 시험이 시작된 뒤에는 입실할 수 없어요.</li>\n          <li>휴대전화·스마트워치·이어폰·전자계산기 같은 <b>전자기기는 전원을 끄고 제출</b>합니다. 시험 중 갖고 있다가 적발되면 시험이 무효 처리될 수 있어요.</li>\n          <li><b>컴퓨터시험(CBT)</b>이라 화면에서 문제를 읽고 답을 고릅니다. 시험장은 본인이 직접 선택하므로 선택 기간(11. 4.~11. 8.)을 놓치지 마세요.</li>\n        </ul>\n        <a class=\"home-video\" href=\"https://youtu.be/KlSQ9l0bcYQ\" target=\"_blank\" rel=\"noopener\">\n          <span class=\"home-video-ic\">&#9654;</span>\n          <span><b>컴퓨터시험(CBT) 응시자 유의사항 안내 영상</b><small>한국보건의료인국가시험원 공식 유튜브 · 새 창으로 열려요</small></span>\n        </a>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>이 연습앱 이용 안내</h2>\n      <div class=\"home-card-body\">\n        <ul class=\"home-list\">\n          <li><b>PC·노트북</b>에서 이용해 주세요. 실제 시험과 같은 넓은 화면을 기준으로 만들었어요.</li>\n          <li>교시마다 <b>실제와 같은 제한시간</b>이 적용되고, 시간이 다 되면 <b>자동으로 제출</b>됩니다.</li>\n          <li>채점도 실제 합격 기준(과목 40% · 평균 60%)으로 해서 과락 과목을 바로 알려드려요.</li>\n          <li>문항은 실제 시험의 과목 구성·유형을 따른 <b>창작 연습 문항</b>이며, 기출문제가 아니에요.</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"home-card\">\n      <h2>국시원 바로가기</h2>\n      <div class=\"home-card-body\">\n        <div class=\"home-links\">\n          <a href=\"https://www.kuksiwon.or.kr/subcnt/c_2024/1/view.do?seq=7&amp;itm_seq=37\" target=\"_blank\" rel=\"noopener\">언어재활사 시험정보</a>\n          <a href=\"https://www.kuksiwon.or.kr/notice/brd/m_51/view.do?seq=3990&amp;itm_seq_1=1&amp;etc1=37\" target=\"_blank\" rel=\"noopener\">CBT 종합안내서</a>\n          <a href=\"https://www.kuksiwon.or.kr/main/indexNew.do?seq=2\" target=\"_blank\" rel=\"noopener\">국시원 홈페이지</a>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"home-cta\"><button class=\"home-start\" onclick=\"goStart()\">모의 CBT 연습 &rarr;</button></div>\n    <div class=\"disclaimer\" style=\"text-align:center;border-top:none;margin-top:0;\">본 서비스는 한국보건의료인국가시험원(국시원)과 무관한 개인 학습용 연습 도구이며, 실제 기출문제가 아닌 창작 문항으로 구성되어 있습니다. 시험 정보는 국시원 공고를 요약한 것이므로 최종 확인은 국시원 홈페이지에서 해 주세요.</div>\n  </div>\n</div>\n\n<div id=\"startScreen\" class=\"hidden\">\n  <div class=\"start-top\">\n    <div style=\"width:140px;\"><button id=\"homeBackBtn\" class=\"home-back hidden\" onclick=\"backToHome()\">&larr; 처음 화면</button></div>\n    <div style=\"font-weight:700;font-size:20px;\">언어재활사 CBT 연습</div>\n    <div style=\"display:flex;align-items:center;gap:12px;\">\n      <button id=\"logoutBtn\" class=\"logout-btn\" onclick=\"doLogout()\" title=\"로그아웃\">로그아웃</button>\n    </div>\n  </div>\n  <div class=\"login-wrap\">\n    <div class=\"login-title\">응시 정보 입력</div>\n    <div class=\"login-body\">\n      <div class=\"login-notice\">오늘도 차분하게, 실전처럼 연습해 봐요!</div>\n      <div class=\"login-table\">\n        <div class=\"info-col\">\n          <div class=\"info-row\"><div class=\"th\">시험명</div><div class=\"td\" id=\"stTitle\"></div></div>\n          <div class=\"info-row\"><div class=\"th\">시험일</div><div class=\"td\" id=\"stDate\"></div></div>\n          <div class=\"info-row\" id=\"gradeRow\" style=\"display:none;\"><div class=\"th\">급수</div>\n            <div class=\"td\" id=\"gradeBtns\"></div>\n          </div>\n          <div class=\"info-row\" id=\"setRow\" style=\"display:none;\"><div class=\"th\">회차</div>\n            <div class=\"td\" id=\"setBtns\"></div>\n          </div>\n          <div class=\"info-row\"><div class=\"th\">교시</div>\n            <div class=\"td\" id=\"sessBtns\"></div>\n          </div>\n          <div class=\"info-row info-row-name\"><div class=\"th\">성명</div><div class=\"td\"><input type=\"text\" id=\"inName\" placeholder=\"소소숲\"><div class=\"name-hint\">※ 본인의 성명을 입력해 주세요.</div></div></div>\n          <div class=\"info-row\"><div class=\"th\">시험시간</div><div class=\"td\" id=\"stTime\"></div></div>\n        </div>\n      </div>\n      <div class=\"start-hint\">※ 교시를 선택하고 입장하기를 눌러 연습을 시작하세요.<br>※ 14회(2025) 1급 시험의 과목 구성·문항 유형을 따른 창작 연습 문항입니다(실제 기출 아님). 시험시간도 실제와 동일합니다.</div>\n      <div class=\"disclaimer\">본 서비스는 한국보건의료인국가시험원(국시원)과 무관한 개인 학습용 연습 도구이며, 실제 기출문제가 아닌 창작 문항으로 구성되어 있습니다.</div>\n    </div>\n    <div class=\"login-foot\">\n      <button class=\"login-btn\" onclick=\"startExam()\">입장하기</button>\n    </div>\n  </div>\n</div>\n\n<!-- ═════════ 내 학습 기록(오답노트·응시 기록) · 소소숲 정식판 전용 ═════════ -->\n<div id=\"studyScreen\" class=\"hidden\">\n  <div class=\"start-top\">\n    <div style=\"width:140px;\"><button class=\"home-back\" onclick=\"closeStudy()\">&larr; 처음 화면</button></div>\n    <div style=\"font-weight:700;font-size:20px;\">내 학습 기록</div>\n    <div style=\"width:140px;\"></div>\n  </div>\n  <div class=\"home-wrap\">\n    <div class=\"st-tabs\">\n      <button data-st=\"wrong\" onclick=\"openStudy('wrong')\">&#128213; 오답노트</button>\n      <button data-st=\"hist\" onclick=\"openStudy('hist')\">&#128202; 응시 기록</button>\n    </div>\n    <div id=\"studyBody\" style=\"display:flex;flex-direction:column;gap:18px;\"></div>\n    <div class=\"disclaimer\" style=\"text-align:center;border-top:none;margin-top:0;\">기록은 지금 쓰는 기기의 브라우저에만 저장돼요. 브라우저 데이터를 지우거나 기기를 바꾸면 기록이 초기화됩니다.</div>\n  </div>\n</div>\n\n<!-- ═════════ 시험 화면 ═════════ -->\n<div id=\"examScreen\" class=\"hidden\">\n  <div class=\"exam-header\" style=\"position:relative;\">\n    <div class=\"eh-left\">\n      <div class=\"eh-title\" id=\"exTitle\" style=\"position:static;transform:none;font-size:18px;\"></div>\n    </div>\n    <div class=\"timerbox\" style=\"position:absolute;left:50%;transform:translateX(-50%);\">\n      <div class=\"clock-ic\">&#128337;</div>\n      <div class=\"txt\">제한시간 : <span id=\"limitMin\"></span>분<br><span class=\"remain\">남은시간 : <b id=\"remainTxt\">--:--</b></span></div>\n    </div>\n    <div class=\"eh-right\">\n      <div class=\"who\" style=\"text-align:right;\">성명 : <span id=\"exName\"></span></div>\n    </div>\n  </div>\n\n  <div class=\"exam-main\">\n    <div class=\"leftbar\">\n      <button class=\"toolv\" onclick=\"toggleCalc()\"><span class=\"tv-ic\">&#128425;</span>계산기</button>\n      <button class=\"toolv\" onclick=\"togglePad()\"><span class=\"tv-ic\">&#9998;</span>그림판</button>\n      <div class=\"toolgroup\">\n        <div class=\"toollabel\">글자 크기</div>\n        <div class=\"font-btns\">\n          <button class=\"fbtn f80\" data-fs=\"0.85\">가<small>80%</small></button>\n          <button class=\"fbtn f100 active\" data-fs=\"1\">가<small>100%</small></button>\n          <button class=\"fbtn f125\" data-fs=\"1.22\">가<small>125%</small></button>\n        </div>\n      </div>\n      <div class=\"toolgroup\">\n        <div class=\"toollabel\">화면 배치</div>\n        <div class=\"layout-btns\">\n          <button class=\"lbtn active\" id=\"lay1\" title=\"1단 보기\"><div></div></button>\n          <button class=\"lbtn\" id=\"lay2\" title=\"2단 보기\"><div></div><div></div></button>\n        </div>\n      </div>\n    </div>\n    <div class=\"paper-col\">\n      <div class=\"progline\">\n        <span class=\"prognum\" id=\"progText\">0 / 0 문항 풀이</span>\n        <div class=\"progwrap\"><div class=\"progbar\" id=\"progBar\"></div></div>\n      </div>\n      <div class=\"paper\" id=\"paper\">\n        <div class=\"paper-grid\" id=\"paperGrid\"></div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"exam-footer\">\n    <div class=\"ef-group\">\n      <button class=\"wbtn\" onclick=\"goHome()\">&#8617; 처음으로</button>\n      <button class=\"wbtn\" onclick=\"pauseExam()\">&#9208; 일시정지</button>\n    </div>\n    <div class=\"pager\">\n      <button class=\"pbtn\" id=\"pgPrev\" onclick=\"movePage(-1)\">&#9664; 이전</button>\n      <span id=\"pageInfo\">1/1</span>\n      <button class=\"pbtn\" id=\"pgNext\" onclick=\"movePage(1)\">다음 &#9654;</button>\n    </div>\n    <div class=\"ef-group\">\n      <button class=\"wbtn\" id=\"fAll\" onclick=\"openProblemViewer('all')\">전체 문제 (<span id=\"cntAll\">0</span>)</button>\n      <button class=\"wbtn\" id=\"fChk\" onclick=\"openProblemViewer('chk')\">체크 문제 (<span id=\"cntChk\">0</span>)</button>\n      <button class=\"wbtn\" id=\"fUn\" onclick=\"openProblemViewer('un')\">안푼 문제 (<span id=\"cntUn\">0</span>)</button>\n      <button class=\"submit-btn\" onclick=\"askSubmit()\">&#128229; 제출하기</button>\n    </div>\n  </div>\n</div>\n\n<!-- ═════════ 결과 화면 ═════════ -->\n<div id=\"resultScreen\" class=\"hidden\">\n  <div class=\"res-wrap\">\n    <div class=\"res-card\">\n      <div class=\"res-title\">시험 결과</div>\n      <div class=\"res-body\">\n        <div class=\"verdict\" id=\"verdict\"></div>\n        <div class=\"verdict-sub\">합격 기준: 전 과목 총점의 60% 이상 &amp; 매 과목 40% 이상 (실제 필기시험 기준)</div>\n        <table class=\"score\" id=\"scoreTable\"></table>\n        <div class=\"res-area hidden\" id=\"resArea\"></div>\n        <div class=\"study-note hidden\" id=\"studyNote\"></div>\n        <div class=\"res-actions\">\n          <button class=\"wbtn hidden\" id=\"resStudyBtn\" onclick=\"openStudy('wrong')\">&#128213; 오답노트</button>\n          <button class=\"wbtn\" onclick=\"setReviewFilter('wrong')\">틀린 문제만 보기</button>\n          <button class=\"wbtn\" onclick=\"setReviewFilter('all')\">전체 해설 보기</button>\n          <button class=\"submit-btn\" onclick=\"location.reload()\">처음으로 (다시 풀기)</button>\n        </div>\n        <div class=\"copy-note\">ⓒ 소소숲 · 문항·해설의 무단 복제·배포(캡처·공유 포함)는 금지되며, 위반 시 이용 제한과 법적 책임이 따를 수 있습니다. <a href=\"https://sososoop.com/terms\" target=\"_blank\" rel=\"noopener\">이용약관</a></div>\n      </div>\n    </div>\n    <div id=\"reviewArea\"></div>\n    <div class=\"disclaimer\" style=\"text-align:center;border-top:none;\">본 서비스는 한국보건의료인국가시험원(국시원)과 무관한 개인 학습용 연습 도구이며, 실제 기출문제가 아닌 창작 문항으로 구성되어 있습니다.</div>\n  </div>\n</div>\n\n<!-- ═════════ 모달들 ═════════ -->\n<!-- 일시정지 — 연습용(실제 시험에는 없음). 문제를 가리고 타이머를 멈춘다 -->\n<div class=\"pause-overlay hidden\" id=\"pauseOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">&#9208; 일시정지</div>\n    <div class=\"modal-body\"><div class=\"big-clock\">&#9208;</div>타이머를 멈췄어요. 문제는 잠시 가려 둘게요.<br>남은 시간 <b id=\"pauseRemain\">--</b><br><small style=\"color:#68738a\">실제 시험에는 일시정지가 없어요. 쓴 횟수는 결과 화면에 적어 둡니다.</small></div>\n    <div class=\"modal-foot\"><button class=\"m-btn blue\" onclick=\"resumeExam()\">&#9654; 계속 풀기</button></div>\n  </div>\n</div>\n<!-- 풀던 시험 이어 풀기 (정식판·베타) -->\n<div class=\"overlay hidden\" id=\"resumeOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">풀던 시험이 있어요</div>\n    <div class=\"modal-body\" id=\"resumeMsg\"></div>\n    <div class=\"modal-foot\">\n      <button class=\"m-btn gray\" onclick=\"resumeDiscard()\">새로 시작</button>\n      <button class=\"m-btn blue\" onclick=\"resumeContinue()\">이어서 풀기</button>\n    </div>\n  </div>\n</div>\n<div class=\"overlay hidden\" id=\"warnOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head\">&#9888; 시험종료 알림 <button class=\"x\" onclick=\"hide('warnOverlay')\">&times;</button></div>\n    <div class=\"modal-body\"><div class=\"big-clock\">&#128337;</div>시험 종료 전<br><b style=\"color:var(--red)\" id=\"warnMin\">5분</b> 남았습니다.</div>\n    <div class=\"modal-foot\"><button class=\"m-btn\" onclick=\"hide('warnOverlay')\">확인</button></div>\n  </div>\n</div>\n\n<div class=\"overlay hidden\" id=\"submitOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">답안 제출 <button class=\"x\" onclick=\"hide('submitOverlay')\">&times;</button></div>\n    <div class=\"modal-body\" id=\"submitMsg\"></div>\n    <div class=\"modal-foot\">\n      <button class=\"m-btn gray\" onclick=\"hide('submitOverlay')\">돌아가기</button>\n      <button class=\"m-btn blue\" onclick=\"doSubmit()\">제출하기</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"overlay hidden\" id=\"timeoverOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head\">&#9888; 시험종료</div>\n    <div class=\"modal-body\"><div class=\"big-clock\">&#128337;</div><span id=\"timeoverMsg\">시험 시간이 종료되어<br>답안이 자동 제출되었습니다.</span></div>\n    <div class=\"modal-foot\"><button class=\"m-btn\" id=\"timeoverBtn\" onclick=\"hide('timeoverOverlay');finishSession();\">결과 확인</button></div>\n  </div>\n</div>\n\n<!-- 제출 완료 — 이 교시 시간이 남아 있으면 문제로 돌아가 고칠 수 있다. 이 창이 떠 있는 동안에도 시간은 흐른다 -->\n<div class=\"overlay hidden\" id=\"submittedOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">제출 완료</div>\n    <div class=\"modal-body\"><b id=\"subdTitle\">답안을 제출했어요</b><br>이 교시 남은 시간 <b id=\"subdRemain\">--</b><br><small style=\"color:#68738a\">시간이 남아 있는 동안에는 문제로 돌아가 답을 고칠 수 있어요.<br>이 창이 떠 있는 동안에도 시간은 흘러요.</small></div>\n    <div class=\"modal-foot\">\n      <button class=\"m-btn gray\" onclick=\"backToQuestions()\">문제로 돌아가기</button>\n      <button class=\"m-btn blue\" id=\"subdNext\" onclick=\"endSession('next')\">다음 교시 시작</button>\n      <button class=\"m-btn blue\" onclick=\"endSession('result')\">결과 보기</button>\n    </div>\n  </div>\n</div>\n\n<!-- 교시 전환 안내 -->\n<div class=\"overlay hidden\" id=\"nextSessOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">교시 전환</div>\n    <div class=\"modal-body\" id=\"nextSessMsg\"></div>\n    <div class=\"modal-foot\">\n      <button class=\"m-btn gray\" onclick=\"resultNow()\">결과 보기</button>\n      <button class=\"m-btn blue\" onclick=\"startNextSession()\">다음 교시 시작</button>\n    </div>\n  </div>\n</div>\n\n<!-- 이용 기간 연장 안내 -->\n<div class=\"overlay hidden\" id=\"extendOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">&#127807; 이용 기간 연장 안내 <button class=\"x\" onclick=\"hide('extendOverlay')\">&times;</button></div>\n    <div class=\"modal-body\">\n      베타 피드백 설문에 참여해 주셔서 감사합니다.<br>\n      감사의 마음을 담아 이용 기간을<br>\n      <b style=\"color:var(--pop)\"><span id=\"extendUntilText\"></span>까지</b> 연장해 드렸어요.<br>\n      남은 기간 실전처럼 활용해 보세요! &#127807;\n    </div>\n    <div class=\"modal-foot\"><button class=\"m-btn blue\" onclick=\"hide('extendOverlay')\">확인</button></div>\n  </div>\n</div>\n\n<!-- 문항 이미지 크게 보기(팝업) — 국시원 CBT처럼 클릭 시 확대 -->\n<div class=\"float-win hidden\" id=\"imgWin\">\n  <div class=\"fw-head\" data-drag=\"imgWin\"><span>자료 크게 보기<span class=\"iw-tip\">제목줄을 끌어 이동 · 모서리를 끌어 크기 조절</span></span><button onclick=\"closeImg()\" title=\"닫기 (ESC)\">&times;</button></div>\n  <div class=\"iw-body\"><img id=\"lbImg\" alt=\"문항 자료 이미지 확대\"></div>\n  <div class=\"iw-grip\" id=\"imgGrip\" title=\"끌어서 크기 조절\"></div>\n</div>\n\n<!-- 문제 보기 (전체/체크/안푼) -->\n<div class=\"overlay hidden\" id=\"viewerOverlay\">\n  <div class=\"viewer\">\n    <div class=\"viewer-head\">문제 모아보기 <button class=\"x\" onclick=\"hide('viewerOverlay')\">&times;</button></div>\n    <div class=\"viewer-guide\">※ 전체 / 체크 / 안 푼 문제 탭을 클릭하여 해당 문제를 확인할 수 있습니다.<br>※ 문제를 더블클릭하면 해당 문제로 이동하여 답안을 수정할 수 있습니다.</div>\n    <div class=\"viewer-tabs\">\n      <button class=\"v-tab active\" id=\"vtAll\" onclick=\"switchViewerTab('all')\">전체문제 (0)</button>\n      <button class=\"v-tab\" id=\"vtChk\" onclick=\"switchViewerTab('chk')\">체크문제 (0)</button>\n      <button class=\"v-tab\" id=\"vtUn\" onclick=\"switchViewerTab('un')\">안푼문제 (0)</button>\n    </div>\n    <div class=\"viewer-body\" id=\"viewerBody\"></div>\n  </div>\n</div>\n\n<!-- 메모 -->\n<div class=\"float-win hidden\" id=\"memoWin\" style=\"top:120px;right:250px;\">\n  <div class=\"fw-head\" data-drag=\"memoWin\"><span id=\"memoTitle\">메모</span><button onclick=\"closeMemo()\">&times;</button></div>\n  <textarea id=\"memoText\" placeholder=\"이 문제에 대한 메모를 입력하세요.\"></textarea>\n</div>\n\n<!-- 계산기 -->\n<div class=\"float-win hidden\" id=\"calcWin\" style=\"bottom:90px;left:20px;\">\n  <div class=\"fw-head\" data-drag=\"calcWin\"><span>계산기</span><button onclick=\"hide('calcWin')\">&times;</button></div>\n  <div class=\"calc-body\">\n    <input id=\"calcDisp\" readonly value=\"0\">\n    <div class=\"calc-grid\">\n      <button onclick=\"calcClear()\">C</button><button onclick=\"calcBack()\">&larr;</button><button class=\"op\" onclick=\"calcIn('/')\">&divide;</button><button class=\"op\" onclick=\"calcIn('*')\">&times;</button>\n      <button onclick=\"calcIn('7')\">7</button><button onclick=\"calcIn('8')\">8</button><button onclick=\"calcIn('9')\">9</button><button class=\"op\" onclick=\"calcIn('-')\">&minus;</button>\n      <button onclick=\"calcIn('4')\">4</button><button onclick=\"calcIn('5')\">5</button><button onclick=\"calcIn('6')\">6</button><button class=\"op\" onclick=\"calcIn('+')\">+</button>\n      <button onclick=\"calcIn('1')\">1</button><button onclick=\"calcIn('2')\">2</button><button onclick=\"calcIn('3')\">3</button><button onclick=\"calcIn('.')\">.</button>\n      <button onclick=\"calcIn('0')\">0</button><button class=\"eq\" onclick=\"calcEq()\">=</button><button onclick=\"calcIn('00')\">00</button>\n    </div>\n  </div>\n</div>\n\n<!-- 그림판 -->\n<div class=\"float-win hidden\" id=\"padWin\" style=\"bottom:90px;left:280px;\">\n  <div class=\"fw-head\" data-drag=\"padWin\"><span>그림판</span><button onclick=\"hide('padWin')\">&times;</button></div>\n  <div class=\"pad-tools\">\n    <button id=\"penBtn\" class=\"on\" onclick=\"setPadMode('pen')\">펜</button>\n    <button id=\"eraserBtn\" onclick=\"setPadMode('eraser')\">지우개</button>\n    <button onclick=\"clearPad()\">전체 지우기</button>\n  </div>\n  <canvas id=\"padCanvas\" width=\"420\" height=\"280\"></canvas>\n</div>\n\n<script>\nwindow.EXAM_TITLE = \"1급 언어재활사 모의 CBT\";\nwindow.HIDDEN_SETS = [];\nwindow.QUESTIONS = [{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 좌측 전두엽 하부 손상\\n• 느리고 노력이 많이 드는 비유창한 발화\\n• 조사·어미 등 문법형태소를 자주 생략하는 전보식 발화\\n• 단순한 지시의 청각적 이해는 비교적 양호하나 통사적으로 복잡한 문장의 이해에는 어려움을 보임\\n• 따라말하기도 손상됨\",\"q\":\"위 양상을 보이는 실어증 유형은?\",\"choices\":[\"베르니케실어증\",\"연결피질운동실어증\",\"브로카실어증\",\"전도실어증\",\"명칭실어증\"],\"answer\":3,\"explain\":\"느리고 노력성인 비유창 발화, 실문법증(문법형태소 생략)의 전보식 발화, 손상된 따라말하기, 단순 지시 이해는 비교적 양호하나 통사적으로 복잡한 문장 이해에는 어려움을 보이는 것은 브로카실어증이다. 따라말하기가 유창성에 비해 보존되면 연결피질운동실어증으로 감별한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형 감별\",\"p\":\"비유창·실문법·따라말하기 손상 조합으로 실어증 유형 판단\",\"n\":\"브로카실어증: 비유창·전보식 발화·단순 이해 양호·따라말하기 손상\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R) 결과\\n• 스스로 말하기: 8/20점 (비유창)\\n• 알아듣기: 170/200점\\n• 따라말하기: 88/100점\\n• 이름대기 및 낱말 찾기: 40/100점\",\"q\":\"다음 결과를 보이는 환자의 실어증 유형은?\",\"choices\":[\"연결피질운동실어증\",\"전도실어증\",\"베르니케실어증\",\"브로카실어증\",\"연결피질감각실어증\"],\"answer\":1,\"explain\":\"발화는 비유창하지만 청각적 이해력이 양호하고 따라말하기가 유창성에 비해 뚜렷하게 보존된 양상은 연결피질운동실어증의 특징이다. 브로카실어증은 따라말하기도 손상되고, 전도실어증은 따라말하기가 선택적으로 손상된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"PK-WAB-R 결과 해석\",\"p\":\"PK-WAB-R 하위점수의 유창성·이해·따라말하기 비교로 유형 판단\",\"n\":\"연결피질운동실어증: 비유창·이해 양호·따라말하기 뚜렷한 보존\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"좌뇌 손상 환자의 낱말 읽기 검사 결과\\n• 실제 낱말을 의미적으로 관련된 다른 낱말로 대치함(예: '버스'→'기차', '사과'→'포도')\\n• 비단어('무핀', '두랍') 읽기가 거의 불가능함\\n• 추상어보다 구체어를 더 잘 읽음\",\"q\":\"위 환자의 실독증 유형으로 가장 적절한 것은?\",\"choices\":[\"표층실독증\",\"음운실독증\",\"순수실독증\",\"심층실독증\",\"무시실독증\"],\"answer\":4,\"explain\":\"실제 낱말을 의미적으로 관련된 낱말로 대치하는 의미착어(예: '버스'→'기차'), 비단어 읽기의 심한 손상, 추상어보다 구체어를 잘 읽는 심상성(imageability) 효과는 심층실독증의 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실독증·실서증\",\"k\":\"실독증 유형 감별\",\"p\":\"의미착어·비단어 읽기 불능·구체어 우세로 실독증 유형 판단\",\"n\":\"심층실독증: 의미착어, 비단어 읽기 심한 손상, 심상성 효과\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 기저핵 회로의 퇴행성 병변\\n• 단조로운 음도와 감소된 강도\\n• 말속도가 점점 빨라지며 음절이 뭉개짐\\n• 안정 시 떨림 동반\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"이완형\",\"과소운동형\",\"경직형\",\"실조형\",\"과다운동형\"],\"answer\":2,\"explain\":\"기저핵 병변(파킨슨병)과 단조로운 음도·강도, 말속도 가속, 안정 떨림은 과소운동형 마비말장애의 전형적인 특징이다. 실조형은 소뇌 손상으로 불규칙한 조음 붕괴와 과도한 강세 변동을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"마비말장애 유형 감별\",\"p\":\"기저핵 병변과 단조로운 음도·말속도 가속·안정 떨림으로 유형 판단\",\"n\":\"과소운동형: 기저핵(파킨슨병), 단음도·단강도, 가속 말속도, 안정 떨림\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 근력 저하 없이 말소리를 탐색하는 듯한 입술·혀의 모색행동\\n• 같은 낱말에서도 매번 다른 조음 오류\\n• 발화 길이가 길어질수록 오류 증가\\n• 자동구어(숫자세기)는 비교적 유창함\",\"q\":\"다음 특징을 보이는 환자에게 적절한 치료 활동은?\",\"choices\":[\"보완대체의사소통 도구를 즉시 도입한다\",\"빨대 불기 등 구강 근력 강화 훈련을 실시한다\",\"청각적 이해력 훈련을 우선 실시한다\",\"느린 속도로 조음점 전환을 반복 연습한다\",\"호흡 지구력 훈련으로 발화 길이를 늘린다\"],\"answer\":4,\"explain\":\"비일관적 오류, 모색행동, 자동구어의 상대적 보존은 말실행증의 특징이다. 말실행증은 근력의 문제가 아니라 말운동 프로그래밍의 손상이므로 집중적·반복적인 말산출 연습과 운동학습 원리(느린 속도, 점진적 난이도)를 적용한 치료가 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"말실행증 치료 활동\",\"p\":\"모색행동·비일관 오류·자동구어 보존으로 말실행증 치료 활동 선택\",\"n\":\"말실행증: 운동 프로그래밍 손상, 느린 속도·반복 연습의 운동학습 원리 적용\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"비디오투시조영삼킴검사(VFSS) 소견\\n• 삼킴 반사가 유발되기 전에 음식물이 조기에 인두로 흘러내림\\n• 음식물이 후두 전정을 지나 진성대 아래로 내려감\\n• 이때 기침 반응이 나타나지 않음\",\"q\":\"다음 소견에 해당하는 삼킴장애 증상은?\",\"choices\":[\"구강 내 잔여물\",\"삼킴 중 후두 침습\",\"삼킴 후 지연성 흡인\",\"삼킴 전의 무증상 흡인\",\"비강으로의 역류\"],\"answer\":4,\"explain\":\"삼킴 반사가 유발되기 전(삼킴 전)에 음식물이 진성대 아래로 내려갔으므로 흡인이며, 기침 등 방어 반응이 없으므로 무증상(silent) 흡인이다. 침습은 진성대 위까지만 들어간 경우를 말한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"삼킴장애\",\"k\":\"VFSS 소견 해석\",\"p\":\"진성대 하방 진입 시점과 기침 유무로 흡인 유형 판단\",\"n\":\"삼킴 전 무증상 흡인: 반사 전 진성대 아래 진입, 방어 기침 부재\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 65세 남성, 발화는 유창하고 문법적으로 완전함\\n• '가위'를 보여주면 이름을 대지 못하고 용도도 설명하지 못함\\n• 단어의 의미를 묻는 과제에서 점진적인 어려움 심화\\n• 불규칙 낱말을 규칙적으로 읽는 오류 동반\\n• 일상생활 기억력과 시공간 능력은 비교적 보존됨\",\"q\":\"다음 양상을 보이는 환자에게 의심되는 진단명은?\",\"choices\":[\"알츠하이머성 치매\",\"의미치매\",\"원발성 진행성 실어증 비유창형\",\"혈관성 치매\",\"루이소체 치매\"],\"answer\":2,\"explain\":\"유창한 발화가 유지되면서 단어 의미 지식이 점진적으로 상실되고(이름대기·의미 이해 저하) 표층실독증 양상이 동반되며 일상 기억이 비교적 보존되는 것은 의미치매(의미변이형 원발성 진행성 실어증)의 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"진행성 언어장애 감별\",\"p\":\"유창 발화 속 의미 지식 상실과 표층실독 양상으로 진단명 판단\",\"n\":\"의미치매: 유창 발화 유지, 이름대기·의미 이해 점진 저하, 일상 기억 보존\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"외상성 뇌손상 환자의 주의력 유형과 평가 과제가 적절하게 연결된 것은?\",\"choices\":[\"선택적 주의력 – 조용한 방에서 숫자 따라 외우기\",\"지속적 주의력 – 목표 소리가 들릴 때마다 버튼 누르기\",\"초점적 주의력 – 두 가지 규칙을 번갈아 적용하기\",\"분리적 주의력 – 두 과제 중 하나만 골라 수행하기\",\"교대적 주의력 – 소음 속에서 이야기 듣고 질문에 답하기\"],\"answer\":2,\"explain\":\"지속적 주의력은 일정 시간 동안 주의를 유지하는 능력으로, 지속 수행 과제(목표 자극에 반응하기)로 평가한다. 소음 속 과제는 선택적 주의력, 규칙 전환 과제는 교대적 주의력, 이중과제는 분리(배분)적 주의력 평가에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"주의력 유형별 평가 과제\",\"p\":\"주의력 하위 유형의 정의에 맞는 평가 과제 연결 식별\",\"n\":\"지속적 주의력: 일정 시간 주의 유지, 목표 자극 반응 과제로 평가\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 광범위한 좌반구 병소\\n• 구어 표현이 몇 개의 상동어에 제한됨\\n• 청각적 이해력도 심하게 손상됨\\n• 몸짓 모방은 부분적으로 가능함\",\"q\":\"다음 환자에게 우선적으로 적용할 수 있는 치료법은?\",\"choices\":[\"멜로디억양치료\",\"지연청각피드백\",\"문장산출프로그램\",\"의미자질분석\",\"시각동작치료\"],\"answer\":5,\"explain\":\"시각동작치료(VAT)는 구어를 사용하지 않고 몸짓 상징을 훈련하는 접근으로, 표현과 이해가 모두 심하게 손상된 전반실어증 환자에게 적용할 수 있다. 멜로디억양치료는 이해력이 양호한 비유창 실어증 환자에게 적합하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"전반실어증 치료법\",\"p\":\"표현·이해 모두 심한 손상과 몸짓 모방 가능성으로 치료법 선택\",\"n\":\"시각동작치료(VAT): 구어 없이 몸짓 상징 훈련, 전반실어증에 적용\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R)에서 실어증지수(AQ) 산출에 포함되지 않는 영역은?\",\"choices\":[\"스스로 말하기\",\"따라말하기\",\"읽기\",\"이름대기 및 낱말 찾기\",\"알아듣기\"],\"answer\":3,\"explain\":\"실어증지수(AQ)는 스스로 말하기, 알아듣기, 따라말하기, 이름대기의 구어 영역 점수로 산출한다. 읽기와 쓰기는 언어지수(LQ) 산출에 포함된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"PK-WAB-R AQ 구성\",\"p\":\"AQ와 LQ의 산출 영역 구분으로 AQ 비포함 영역 식별\",\"n\":\"AQ: 스스로 말하기·알아듣기·따라말하기·이름대기, 읽기·쓰기는 LQ\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"아 내: \\\"남편이 말을 잘 못 알아들어서 답답해요. 제가 길게 설명하면 멍하니 있어요.\\\"\\n환자: 중등도 실어증으로 외래 언어치료 중\",\"q\":\"다음 보호자에게 제공할 의사소통 교육 내용으로 옳은 것은?\",\"choices\":[\"짧고 단순한 문장으로 말하고 충분히 기다려 준다\",\"환자가 틀리게 말할 때마다 즉시 교정해 준다\",\"환자가 말하기 전에 미리 대신 말해 준다\",\"의사소통 실패를 줄이기 위해 대화 기회를 최소화한다\",\"빠른 속도로 여러 번 반복해서 말해 준다\"],\"answer\":1,\"explain\":\"실어증 환자와의 의사소통에서는 짧고 단순한 문장, 느린 말속도, 충분한 반응 시간 제공, 제스처 등 다중 양식 활용이 권장된다. 잦은 교정이나 대신 말하기는 의사소통 의욕을 저하시킨다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"실어증 보호자 교육\",\"p\":\"이해 저하 환자와의 대화 곤란 호소에 맞는 의사소통 교육 선택\",\"n\":\"실어증 대화 전략: 짧고 단순한 문장, 느린 속도, 충분한 반응 시간\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"성문위삼킴법(supraglottic swallow)의 일차적인 목적은?\",\"choices\":[\"인두 잔여물을 중력으로 제거한다\",\"후두 상승을 연장하여 상부식도괄약근의 개방 시간을 늘린다\",\"혀 기저부의 후방 운동을 강화한다\",\"삼킴 반사의 유발 속도를 높인다\",\"성대를 닫아 삼킴 중 기도를 보호한다\"],\"answer\":5,\"explain\":\"성문위삼킴법은 숨을 참은 상태로 삼킨 뒤 기침을 하는 기법으로, 삼킴 전·중에 진성대 수준에서 기도를 닫아 흡인을 예방한다. 후두 상승 연장과 상부식도괄약근 개방 연장은 멘델슨기법의 목적이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"삼킴장애\",\"k\":\"성문위삼킴법 목적\",\"p\":\"삼킴 기법별 작용 기전 구분으로 성문위삼킴법 목적 식별\",\"n\":\"성문위삼킴법: 숨 참고 삼킨 뒤 기침, 진성대 폐쇄로 기도 보호\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 좌측 상측두회 손상\\n• 유창하지만 착어가 많은 발화\\n• 청각적 이해력이 심하게 저하됨\\n• 따라말하기가 손상되고 병식이 부족함\",\"q\":\"다음 양상을 보이는 실어증 유형은?\",\"choices\":[\"베르니케실어증\",\"전도실어증\",\"명칭실어증\",\"연결피질감각실어증\",\"브로카실어증\"],\"answer\":1,\"explain\":\"유창한 발화, 심한 청각적 이해력 손상, 착어, 병식 부족은 베르니케실어증의 특징이다. 연결피질감각실어증은 유사하나 따라말하기가 상대적으로 보존된다는 점에서 구별된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형 감별\",\"p\":\"유창·착어·심한 이해 저하·따라말하기 손상 조합으로 유형 판단\",\"n\":\"베르니케실어증: 유창·착어·이해 심한 손상·따라말하기 손상·병식 부족\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"유창한 발화와 비교적 양호한 청각적 이해력을 보이나 따라말하기가 선택적으로 심하게 손상되고 음소착어가 두드러지는 실어증 유형은?\",\"choices\":[\"연결피질운동실어증\",\"베르니케실어증\",\"브로카실어증\",\"전도실어증\",\"전반실어증\"],\"answer\":4,\"explain\":\"전도실어증은 활꼴다발(궁상속)의 손상으로 유창성과 이해력은 보존되나 따라말하기가 선택적으로 손상되고, 음소착어와 스스로 고치려는 접근행동(conduite d'approche)을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"전도실어증 특징\",\"p\":\"유창성·이해 보존과 따라말하기 선택적 손상으로 유형 판단\",\"n\":\"전도실어증: 궁상속 손상, 따라말하기 선택 손상, 음소착어·접근행동\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 소뇌 손상\\n• 불규칙하게 조음이 붕괴됨\\n• 과도하고 불규칙한 강세\\n• 술 취한 듯한 말\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"이완형\",\"경직형\",\"실조형\",\"과소운동형\",\"과다운동형\"],\"answer\":3,\"explain\":\"실조형 마비말장애는 소뇌 손상으로 발생하며, 불규칙한 조음 붕괴, 과도하고 불규칙한 강세, 운율 이상('술 취한 듯한 말')이 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"마비말장애 유형 감별\",\"p\":\"소뇌 손상과 불규칙 조음 붕괴·과도한 강세로 유형 판단\",\"n\":\"실조형: 소뇌 손상, 불규칙 조음 붕괴, 과도·불규칙 강세, 취한 듯한 말\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 상위운동신경의 양측 손상\\n• 느리고 힘이 많이 드는 말\\n• 쥐어짜는 듯한 거친 음성\\n• 과다비성\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"이완형\",\"과소운동형\",\"실조형\",\"편측 상부운동신경형\",\"경직형\"],\"answer\":5,\"explain\":\"경직형 마비말장애는 상위운동신경의 양측 손상으로 발생하며, 느리고 노력성인 말, 쥐어짜는 거친 음성, 과다비성이 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"마비말장애 유형 감별\",\"p\":\"양측 상위운동신경 손상과 쥐어짜는 음성·과다비성으로 유형 판단\",\"n\":\"경직형: 양측 상위운동신경 손상, 느리고 노력성 말, 쥐어짜는 음성\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 뇌신경(안면신경·설하신경 등)의 하위운동신경 손상\\n• 침범된 근육의 약화와 위축\\n• 과다비성과 기식 음성\\n• 부정확한 자음\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"과다운동형\",\"경직형\",\"실조형\",\"이완형\",\"과소운동형\"],\"answer\":4,\"explain\":\"이완형 마비말장애는 하위운동신경(뇌신경·척수신경) 손상으로 근육의 약화·저긴장·위축이 나타나며, 과다비성과 기식 음성이 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"마비말장애 유형 감별\",\"p\":\"하위운동신경 손상과 근약화·위축·기식 음성으로 유형 판단\",\"n\":\"이완형: 하위운동신경 손상, 근약화·저긴장·위축, 과다비성·기식 음성\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"우반구 손상 환자의 의사소통 특징으로 가장 적절한 것은?\",\"choices\":[\"심한 실문법증을 보인다\",\"따라말하기가 선택적으로 손상된다\",\"음소착어가 빈번하게 나타난다\",\"화용언어와 운율에서 결함을 보인다\",\"청각적 이해력이 심하게 손상된다\"],\"answer\":4,\"explain\":\"우반구 손상 환자는 언어 구조 자체보다 화용(담화 조직, 추론, 유머·비유 이해), 운율, 시공간 처리(좌측 무시)에서 결함을 보인다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"인지의사소통장애\",\"k\":\"우반구 손상 의사소통 특징\",\"p\":\"언어 구조와 화용·운율 결함 구분으로 우반구 손상 특징 식별\",\"n\":\"우반구 손상: 담화 조직·추론·비유 이해 등 화용과 운율 결함\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"멜로디억양치료(MIT)를 적용하기에 가장 적절한 환자는?\",\"choices\":[\"청각적 이해력이 심하게 손상된 전반실어증 환자\",\"발화 산출이 제한된 비유창 실어증 환자\",\"착어가 많은 베르니케실어증 환자\",\"화용 결함을 보이는 우반구 손상 환자\",\"과다비성을 보이는 마비말장애 환자\"],\"answer\":2,\"explain\":\"멜로디억양치료는 보존된 우반구의 멜로디 기능을 활용하는 치료로, 청각적 이해력이 비교적 양호하고 발화 산출이 제한된 비유창(브로카) 실어증 환자에게 적합하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"MIT 적용 대상\",\"p\":\"이해력 보존 여부와 발화 산출 제한으로 MIT 적합 대상 선택\",\"n\":\"멜로디억양치료: 우반구 멜로디 기능 활용, 이해 양호한 비유창 실어증\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"이름대기 장애 치료법으로, 목표 낱말의 범주·기능·특징 등 의미 정보를 활성화하여 낱말 인출을 돕는 접근법은?\",\"choices\":[\"멜로디억양치료\",\"의미자질분석\",\"시각동작치료\",\"각본치료\",\"성문위삼킴법\"],\"answer\":2,\"explain\":\"의미자질분석(SFA)은 목표 낱말과 관련된 의미자질(상위범주, 기능, 특징, 위치 등)을 체계적으로 인출하게 하여 이름대기 능력을 향상시키는 치료법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"이름대기 치료법\",\"p\":\"범주·기능·특징 등 의미 정보 활성화 설명으로 치료법 식별\",\"n\":\"의미자질분석(SFA): 목표어 의미자질 체계적 인출로 이름대기 향상\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"한국판 보스턴이름대기검사(K-BNT)가 평가하는 능력은?\",\"choices\":[\"쓰기 표현\",\"청각적 이해력\",\"문장 따라말하기\",\"대면 이름대기\",\"읽기 이해\"],\"answer\":4,\"explain\":\"K-BNT는 흑백 선화를 보고 이름을 말하는 대면 이름대기(confrontation naming) 능력을 평가하는 검사이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"K-BNT 평가 영역\",\"p\":\"검사 과제 형식으로 K-BNT가 평가하는 능력 식별\",\"n\":\"K-BNT: 흑백 선화 보고 이름 말하기, 대면 이름대기 평가\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"삼킴 시 후두 상승을 인위적으로 연장·유지하여 상부식도괄약근의 개방 시간을 늘리는 삼킴 기법은?\",\"choices\":[\"성문위삼킴법\",\"최대성문위삼킴법\",\"노력삼킴\",\"멘델슨기법\",\"머리 회전법\"],\"answer\":4,\"explain\":\"멘델슨기법은 삼킴 시 후두가 최고로 올라간 지점에서 인위적으로 상승을 유지하여 상부식도괄약근의 개방 시간과 폭을 늘리는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"삼킴장애\",\"k\":\"멘델슨기법 정의\",\"p\":\"후두 상승 유지와 상부식도괄약근 개방 연장 설명으로 기법 식별\",\"n\":\"멘델슨기법: 후두 최고 상승 지점 유지, 상부식도괄약근 개방 시간·폭 증가\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"알츠하이머성 치매 초기 단계에서 가장 두드러지는 언어 특징은?\",\"choices\":[\"조음의 붕괴\",\"구문 구조의 상실\",\"따라말하기 불능\",\"완전한 함구증\",\"이름대기 어려움\"],\"answer\":5,\"explain\":\"알츠하이머성 치매 초기에는 조음·구문·따라말하기는 비교적 보존되고, 이름대기 어려움과 에두르기 등 의미론적 단어 인출 결함이 먼저 나타난다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"인지의사소통장애\",\"k\":\"알츠하이머 초기 언어 특징\",\"p\":\"초기에 보존되는 영역과 먼저 저하되는 영역 구분으로 특징 식별\",\"n\":\"알츠하이머 초기: 조음·구문 보존, 이름대기 어려움·에두르기 선행\"}},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"뇌영상 기법에 대한 설명으로 옳은 것은?\",\"choices\":[\"기능자기공명영상(fMRI)은 뇌의 구조적 병변만을 보여준다\",\"fMRI와 PET는 뇌 기능의 활성화를 보여준다\",\"컴퓨터단층촬영(CT)은 과제 수행 중 뇌 활성화를 직접 측정한다\",\"확산텐서영상(DTI)은 뇌혈류 속도를 측정한다\",\"모든 뇌영상은 기능적 정보만 제공한다\"],\"answer\":2,\"explain\":\"CT와 구조 MRI는 뇌의 해부학적 구조·병변을 보여주는 구조적 영상이고, fMRI·PET는 과제 수행 중 신경 활동에 따른 혈류·대사 변화를 측정하는 기능적 영상이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"신경해부·뇌혈관\",\"k\":\"뇌영상 기법 구분\",\"p\":\"구조적 영상과 기능적 영상의 측정 대상 구분으로 옳은 설명 식별\",\"n\":\"구조 영상: CT·MRI, 기능 영상: fMRI·PET(혈류·대사 변화 측정)\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동 발화\\n① \\\"엄마 물 줘\\\"\\n② \\\"이거 안 먹어\\\"\\n③ \\\"곰인형 어디 있어\\\"\\n④ \\\"나도 갈래\\\"\",\"q\":\"다음 아동 발화의 평균낱말길이(MLU-w)는?\",\"choices\":[\"2.25\",\"2.5\",\"2.75\",\"3.0\",\"3.25\"],\"answer\":4,\"explain\":\"낱말 수를 셀 때 체언에 붙은 조사는 따로 한 낱말로 센다. ① 엄마/물/줘 3개, ② 이거/안/먹어 3개, ③ 곰인형/어디/있어 3개, ④ 나/도/갈래 3개('나도'는 체언 '나'와 조사 '도'로 2낱말)로 총 12개이다. MLU-w = 총 낱말 수 ÷ 발화 수 = 12 ÷ 4 = 3.0.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"MLU-w 산출\",\"p\":\"발화별 낱말 수 합계를 발화 수로 나누어 MLU-w 산출\",\"n\":\"MLU-w: 총 낱말 수 ÷ 발화 수 (체언에 붙은 조사는 한 낱말로 셈)\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"낱말 이름대기 과제에서 아동이 다음과 같이 반응하였다.\\n가위 → \\\"자르는 거\\\"\\n시계 → \\\"똑딱똑딱\\\"\\n칫솔 → \\\"이 닦는 거\\\"\",\"q\":\"위 아동의 이름대기 반응에 대한 설명으로 옳은 것은?\",\"choices\":[\"기능·특징으로 에둘러 표현하고 있다\",\"음소착어를 반복적으로 보이고 있다\",\"동일한 보속 반응을 보이고 있다\",\"이름대기 능력이 정상 범위이다\",\"의미와 무관한 신조어를 산출하고 있다\"],\"answer\":1,\"explain\":\"낱말 이름대기에서 목표어를 인출하지 못해 그 기능·특징으로 대신 설명하는 것을 에두르기(circumlocution)라 하며, 낱말찾기(인출)의 어려움을 시사한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"이름대기 반응 분석\",\"p\":\"목표어 대신 기능·특징 설명 반응으로 이름대기 오류 유형 판단\",\"n\":\"에두르기: 목표어 인출 실패 시 기능·특징으로 대신 설명, 낱말찾기 어려움\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동이 산출한 이야기\\n\\\"토끼가 당근을 심었어요. 그리고 매일 물을 주었어요. 그런데 그것이 자라지 않았어요. 왜냐하면 씨앗을 거꾸로 심었기 때문이에요.\\\"\",\"q\":\"위 이야기에서 두드러지게 나타난 언어 특성은?\",\"choices\":[\"대용어를 전혀 사용하지 않았다\",\"이야기 문법 요소가 전혀 나타나지 않았다\",\"접속부사를 사용해 문장을 연결하고 있다\",\"문법형태소 오류가 매우 빈번하다\",\"단문만 반복해서 산출하였다\"],\"answer\":3,\"explain\":\"'그리고, 그런데, 왜냐하면' 등 접속부사는 문장·명제를 이어 주는 결속표지로, 위 이야기에서 이를 활용해 사건을 순서·대조·인과로 연결하고 있다. 이야기에는 '그것'이라는 지시 대용어도 쓰였으므로 ①은 틀리다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"이야기·담화\",\"k\":\"이야기 결속표지 분석\",\"p\":\"문장 간 연결 표현 사용 양상으로 이야기의 언어 특성 판단\",\"n\":\"접속부사: 순서·대조·인과로 문장을 잇는 결속표지\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"표준화 언어검사와 평가 영역의 연결이 옳지 않은 것은?\",\"choices\":[\"수용·표현 어휘력 검사(REVT) – 수용·표현 어휘력\",\"한국어 읽기 검사(KOLRA) – 자발화 산출 능력\",\"언어문제해결력검사 – 상위언어 및 추론 능력\",\"취학전 아동의 수용언어 및 표현언어 발달 척도(PRES) – 취학전 수용·표현 언어\",\"구문의미이해력검사(KOSECT) – 구문의미 이해력\"],\"answer\":2,\"explain\":\"KOLRA(한국어 읽기 검사)는 해독·읽기이해 등 읽기 능력을 평가하며 자발화 산출 능력을 평가하지 않는다. 나머지는 검사와 평가 영역이 올바르게 연결되어 있다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"읽기·쓰기\",\"k\":\"표준화 검사 평가 영역\",\"p\":\"각 표준화 언어검사의 측정 영역 비교로 잘못된 연결 식별\",\"n\":\"KOLRA: 해독·읽기이해 등 읽기 능력 평가, 자발화 평가 아님\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 5세 아동\\n• 가정에서는 아버지·어머니 모두 베트남어만 사용\\n• 만 3세에 어린이집에 입소하면서 한국어에 처음 본격적으로 노출됨\\n• 현재 한국어 발화가 제한적임\",\"q\":\"위 아동의 이중언어 유형과 평가 시 고려사항으로 옳은 것은?\",\"choices\":[\"동시적 이중언어 아동의 규준을 그대로 적용한다\",\"한국어 검사 결과만으로 언어장애를 진단한다\",\"베트남어 사용을 중단하도록 권고한다\",\"이중언어 노출이 언어지연의 원인이라고 설명한다\",\"노출 기간이 짧은 순차적 이중언어 아동으로 해석한다\"],\"answer\":5,\"explain\":\"만 3세 이후 제2언어(한국어)에 노출된 순차적 이중언어 아동이다. 노출 기간이 짧으면 제2언어 수행이 낮게 나타날 수 있으므로 노출 기간을 고려해 해석해야 하며, 이중언어 노출 자체는 언어지연의 원인이 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"이중언어 유형과 평가\",\"p\":\"제2언어 노출 시기·기간으로 이중언어 유형과 해석 방향 판단\",\"n\":\"순차적 이중언어: 3세 이후 제2언어 노출, 노출 기간 고려해 해석\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 뇌성마비로 사지의 운동 조절이 어려움\\n• 인지 능력과 언어 이해력은 연령 수준\\n• 손가락으로 상징을 직접 짚는 것이 불가능함\\n• 눈 움직임과 머리 움직임은 비교적 안정적임\",\"q\":\"다음 아동의 보완대체의사소통(AAC) 도구 선택 기법으로 가장 적절한 것은?\",\"choices\":[\"수어를 이용한 표현\",\"필담을 이용한 의사 표현\",\"구어 산출 훈련만 집중해 실시\",\"시선이나 스캐닝을 이용한 선택\",\"손가락을 이용한 직접선택\"],\"answer\":4,\"explain\":\"직접선택이 어려운 사지 운동장애 아동에게는 안정적으로 조절 가능한 움직임(시선, 머리)을 활용한 시선 응시 선택이나 스위치를 이용한 스캐닝(간접선택)이 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"AAC 선택 기법\",\"p\":\"직접선택 불가와 안정적 시선·머리 움직임으로 선택 기법 결정\",\"n\":\"간접선택: 직접 지적 불가 시 시선 응시·스위치 스캐닝 활용\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 초등학교 3학년 아동, 난독 의심으로 의뢰\\n• 낱말·비단어를 소리 내어 읽는 속도와 정확도는 또래 수준\\n• 읽은 글의 내용을 이해하고 요약하는 데 또래보다 크게 어려움\\n• 들려주면 이해하고 일상 대화에는 어려움이 없음\",\"q\":\"위 아동의 읽기 문제 유형으로 가장 적절한 것은?\",\"choices\":[\"난독증(해독 부진)\",\"읽기이해부진\",\"말소리장애\",\"쓰기장애\",\"유창성장애\"],\"answer\":2,\"explain\":\"해독(낱말·비단어 읽기의 속도·정확도)은 또래 수준이나 읽기이해가 저조하고 듣기이해는 양호한 양상은, 해독 결함의 난독증이 아니라 읽기이해부진에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"읽기·쓰기\",\"k\":\"읽기 문제 유형 감별\",\"p\":\"해독 정상·읽기이해 저하·듣기이해 양호 조합으로 유형 판단\",\"n\":\"읽기이해부진: 해독은 또래 수준, 읽기이해만 저조, 듣기이해 양호\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"대화 중 아동이 상대의 말이 끝나기 전에 끼어들어 말하고, 자신의 관심사만 일방적으로 이야기하며, 상대의 질문에 맞지 않는 대답을 자주 한다.\",\"q\":\"위 아동에게 우선 목표로 설정할 화용 능력은?\",\"choices\":[\"낱말 해독과 읽기 정확도\",\"말소리 산출의 정확도\",\"평균발화길이(MLU) 늘리기\",\"차례 주고받기와 주제 유지\",\"음절·음소 인식 능력\"],\"answer\":4,\"explain\":\"상대의 말을 끊고 자기 관심사만 말하며 부적절하게 반응하는 것은 대화 규칙(차례 주고받기·주제 유지)의 어려움이므로, 이를 우선 화용 목표로 설정한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"화용·대화\",\"k\":\"화용 중재 목표 설정\",\"p\":\"끼어들기·일방적 주제·부적절 응답으로 우선 화용 목표 선택\",\"n\":\"대화 규칙 결함 목표: 차례 주고받기와 주제 유지\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"언어 이전기 아동의 의사소통 행동을 관찰하였다.\\n• 손이 닿지 않는 과자를 향해 소리를 내며 성인의 손을 끌어당긴다.\\n• 싫어하는 음식을 밀어내며 고개를 돌린다.\",\"q\":\"위 두 행동에 해당하는 의사소통 기능을 순서대로 바르게 짝지은 것은?\",\"choices\":[\"요구하기 - 거부하기\",\"서술하기 - 요구하기\",\"거부하기 - 인사하기\",\"공동주의 - 서술하기\",\"요구하기 - 공동주의\"],\"answer\":1,\"explain\":\"손이 닿지 않는 사물을 향해 성인의 손을 끌며 소리 내는 것은 요구하기, 싫어하는 것을 밀어내고 고개를 돌리는 것은 거부하기 기능이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"의사소통 기능 분류\",\"p\":\"언어 이전기 비구어 행동의 의도로 의사소통 기능 판단\",\"n\":\"요구하기: 원하는 사물 획득 시도, 거부하기: 싫은 것 밀어내기·외면\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 1학년 아동 평가 결과\\n• 수용·표현 어휘력 검사(REVT) 백분위수: 수용 8, 표현 6\\n• 비언어성 지능: 정상 범위\\n• 청력: 정상\\n• 자발화: 조사 생략과 제한된 어휘 사용 관찰\",\"q\":\"다음 결과에 근거한 부모 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"\\\"어휘력이 또래보다 유의하게 낮아 언어치료가 필요해요.\\\"\",\"\\\"청력 손실이 원인이므로 보청기 착용이 필요해요.\\\"\",\"\\\"지능이 낮아서 나타나는 현상이므로 인지치료가 우선이에요.\\\"\",\"\\\"발음 문제가 핵심이므로 조음치료를 시작해야 해요.\\\"\",\"\\\"정상 범위이므로 치료 없이 지켜봐도 돼요.\\\"\"],\"answer\":1,\"explain\":\"REVT 백분위수 10 미만은 또래 대비 유의한 어휘 지체를 의미한다. 비언어성 지능과 청력이 정상이므로 언어 영역에 특정된 어려움이며, 어휘·문법을 목표로 한 언어치료가 권고된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"어휘·의미\",\"k\":\"어휘 지체 부모 상담\",\"p\":\"REVT 백분위와 지능·청력 정상 결과로 부모 상담 내용 선택\",\"n\":\"REVT 백분위 10 미만: 유의한 어휘 지체, 언어 특정 어려움으로 치료 권고\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"간식 시간에 치료사가 아동이 좋아하는 주스를 아동 눈에 보이지만 손이 닿지 않는 선반에 올려 두고, 뚜껑을 꼭 닫은 채 건네준 뒤 아동의 반응을 기다린다.\",\"q\":\"위 장면에서 사용된 중재 전략은?\",\"choices\":[\"청각적 집중 자극\",\"스크립트 문맥 활용\",\"비연속 개별시도 교수\",\"반응대가 기법\",\"환경 조성 전략\"],\"answer\":5,\"explain\":\"환경중심 언어중재의 환경 조성 전략은 원하는 물건을 보이지만 닿지 않게 두거나 도움이 필요한 상황(닫힌 뚜껑)을 만들어 아동이 자발적으로 요구하기를 산출하도록 유도하는 방법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"환경중심 중재 전략\",\"p\":\"보이지만 닿지 않는 배치와 닫힌 뚜껑 상황으로 중재 전략 식별\",\"n\":\"환경 조성 전략: 도움이 필요한 상황을 만들어 자발적 요구 유도\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 4학년 아동 언어평가 결과\\n• 상위개념 어휘 이해: 또래 하위 5%\\n• 동의어·반의어 표현: 또래 하위 3%\\n• 복문 산출과 문법형태소 사용: 연령 수준\\n• 조음 및 읽기 해독: 연령 수준\",\"q\":\"다음 아동에게 우선적으로 설정할 중재 목표는?\",\"choices\":[\"문법형태소 오류 수정\",\"낱말 해독 정확도 향상\",\"복문 산출 능력 향상\",\"조음 정확도 향상\",\"의미 관계 어휘 확장\"],\"answer\":5,\"explain\":\"구문·조음·해독은 연령 수준이나 어휘의 의미 관계 영역(상위개념, 동의어·반의어)에서만 유의한 지체를 보이므로, 의미론적 어휘 조직화를 확장하는 중재가 우선 목표가 된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"어휘·의미\",\"k\":\"의미 관계 어휘 목표\",\"p\":\"구문·조음 정상과 상위개념·동의어 지체로 우선 중재 목표 선택\",\"n\":\"의미 관계 어휘 지체: 상위개념·동의어·반의어 중심 어휘 조직화 확장\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 5세 남아\\n• 상대방의 말을 그대로 따라 말함\\n• 대명사를 뒤바꿔 사용함(너/나 혼동)\\n• 특정 관심사를 반복적으로 언급하고 눈맞춤이 부족함\",\"q\":\"다음 아동에게 의심되는 장애는?\",\"choices\":[\"단순언어장애\",\"고도 청각장애\",\"경도 지적장애\",\"자폐스펙트럼장애\",\"조음음운장애\"],\"answer\":4,\"explain\":\"반향어, 대명사 전도, 제한된 관심사의 반복, 눈맞춤 부족, 상호작용의 어려움은 자폐스펙트럼장애의 대표적 언어·의사소통 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"자폐스펙트럼장애 특성\",\"p\":\"반향어·대명사 전도·제한된 관심사·눈맞춤 부족으로 장애 판단\",\"n\":\"자폐스펙트럼장애: 반향어, 대명사 전도, 반복 관심사, 상호작용 결함\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"(아동 이야기 전사 자료)\\n토끼랑 거북이가 달리기를 했어요. 토끼는 빨리 뛰다가 낮잠을 잤어요. 그래서 거북이가 먼저 도착했어요.\",\"q\":\"위 아동 발화의 최소종결단위(T-unit) 수는?\",\"choices\":[\"2\",\"3\",\"4\",\"5\",\"6\"],\"answer\":2,\"explain\":\"T-unit은 하나의 주절과 그에 딸린 종속절을 한 단위로 센다. 세 문장이 각각 하나의 T-unit이므로 T-unit 수는 3이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"T-unit 수 산출\",\"p\":\"주절과 딸린 종속절 단위로 이야기 전사의 T-unit 수 산출\",\"n\":\"T-unit: 하나의 주절과 그에 딸린 종속절을 한 단위로 계산\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"언어재활사가 아동에게 다음과 같이 질문하였다.\\n• \\\"친구가 '창문이 열려 있네'라고 말하면 무슨 뜻일까요?\\\"\\n• \\\"수업 시간에 딴짓하는 친구에게 선생님이 '지금 뭐 하고 있니?'라고 하면 진짜 궁금해서 물어보는 걸까요?\\\"\",\"q\":\"위 질문으로 평가하려는 능력은?\",\"choices\":[\"음운인식 능력\",\"구문 산출 능력\",\"상위화용 능력\",\"낱말 해독 능력\",\"조음 정확도\"],\"answer\":3,\"explain\":\"'창문이 열려 있네'의 함축(닫아 달라)이나 반어적 발화의 진짜 의도를 파악하는 것은 간접표현·함축 이해로, 상위화용 능력에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"화용·대화\",\"k\":\"상위화용 평가 과제\",\"p\":\"함축·반어적 발화의 의도 파악 질문으로 평가 능력 식별\",\"n\":\"상위화용: 간접표현·함축·반어의 진짜 의도 이해\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동: 차 가.\\n치료사: 차가 가네.\",\"q\":\"위 장면에서 치료사가 사용한 기법은?\",\"choices\":[\"확장(expansion)\",\"치료사 혼잣말기법\",\"아동 평행발화기법\",\"확대(extension)\",\"낱말 분리 및 합성\"],\"answer\":1,\"explain\":\"확장(expansion)은 아동 발화의 의미는 유지하면서 문법적으로 완전한 형태로 다시 들려주는 기법이다. 확대는 새로운 의미 정보를 덧붙이는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"확장 기법 식별\",\"p\":\"아동 발화 의미 유지와 문법적 완성 여부로 치료사 기법 식별\",\"n\":\"확장: 의미 유지하며 문법적으로 완전하게 재진술, 확대는 새 정보 추가\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"생일잔치, 마트 놀이 등 친숙한 일상 활동의 익숙한 순서를 활용하여 언어를 촉진하는 중재 접근은?\",\"choices\":[\"감각통합 치료\",\"청지각 훈련\",\"스크립트 중재\",\"핵심어휘 접근법\",\"청각구어법\"],\"answer\":3,\"explain\":\"스크립트 중재는 아동에게 친숙한 일상 사건의 구조(스크립트)를 활용하여 인지적 부담을 줄이고 새로운 언어 형식의 학습을 촉진한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"스크립트 중재 정의\",\"p\":\"친숙한 일상 활동의 순서 구조 활용 설명으로 중재 접근 식별\",\"n\":\"스크립트 중재: 익숙한 사건 구조로 인지 부담 감소, 새 언어 형식 촉진\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"중심축 반응중재(PRT)의 핵심 특징으로 옳은 것은?\",\"choices\":[\"치료사가 모든 자극과 강화를 통제하는 개별시도 형식으로 진행한다\",\"아동의 주도를 활용하고 자연적 강화를 사용한다\",\"구조화된 책상 과제에서 인위적 강화물로 반복 시행한다\",\"언어보다 구강운동 훈련에 초점을 둔다\",\"성인 주도의 지시 따르기를 우선한다\"],\"answer\":2,\"explain\":\"중심축 반응중재(PRT)는 아동의 선택·주도를 활용하고 동기·복합단서 반응 등 중심축(pivotal) 영역을 목표로 하며, 자연적 강화(원하는 것 제공)를 사용하는 자연주의적 중재이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"PRT 핵심 특징\",\"p\":\"아동 주도와 강화 유형 구분으로 PRT의 특징 식별\",\"n\":\"중심축 반응중재: 아동 선택·주도 활용, 자연적 강화의 자연주의 중재\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동의 자발화를 분석한 결과, 전체 낱말 수(NTW)는 40개, 서로 다른 낱말 수(NDW)는 20개였다.\",\"q\":\"이 아동의 어휘다양도(TTR)는?\",\"choices\":[\"0.4\",\"0.5\",\"0.6\",\"0.8\",\"2.0\"],\"answer\":2,\"explain\":\"어휘다양도(TTR) = 서로 다른 낱말 수 ÷ 전체 낱말 수 = 20 ÷ 40 = 0.5이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"TTR 산출\",\"p\":\"서로 다른 낱말 수를 전체 낱말 수로 나누어 TTR 산출\",\"n\":\"TTR: NDW ÷ NTW\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"그림교환의사소통체계(PECS) 훈련에서 가장 먼저 지도하는 것은?\",\"choices\":[\"여러 그림 중에서 목표 그림을 골라 변별하기\",\"'나는 ~을 원해요' 문장판을 구성하기\",\"여러 그림을 보고 감정을 설명하기\",\"그림 없이 음성으로 원하는 것 요구하기\",\"원하는 사물의 그림카드를 상대에게 건네기\"],\"answer\":5,\"explain\":\"PECS는 1단계에서 원하는 사물의 그림카드를 의사소통 상대에게 건네는 '교환(요구하기)'을 먼저 지도하고, 변별·문장 구성 등은 이후 단계에서 다룬다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"PECS 훈련 단계\",\"p\":\"PECS 단계 순서 지식으로 가장 먼저 지도할 내용 식별\",\"n\":\"PECS 1단계: 원하는 사물 그림카드를 상대에게 건네는 교환\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"이야기 문법(story grammar)의 구성 요소에 해당하지 않는 것은?\",\"choices\":[\"시도\",\"계기사건\",\"내적 반응\",\"어휘다양도\",\"배경\"],\"answer\":4,\"explain\":\"이야기 문법은 배경, 계기사건, 내적 반응, 시도, 결과, 결말 등으로 구성된다. 어휘다양도(TTR)는 어휘 사용의 다양성을 나타내는 지표로 이야기 문법 요소가 아니다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"이야기·담화\",\"k\":\"이야기 문법 구성 요소\",\"p\":\"이야기 문법 요소와 어휘 지표 구분으로 비해당 요소 식별\",\"n\":\"이야기 문법: 배경·계기사건·내적 반응·시도·결과·결말\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 초등 1학년 아동, 한국 비언어성 지능검사(K-CTONI-2) 지능지수 96(정상)\\n• 또래와 대화 시 눈맞춤이 짧고 상황에 맞지 않는 말과 주제 이탈이 잦음\\n• 농담·비유·간접표현을 문자 그대로 받아들임\\n• 제한된 관심사·상동행동·감각 특이성은 관찰되지 않음\\n• 한국 아동 메타-화용언어 검사(KOPLAC) 상위언어 인식 3%ile\",\"q\":\"위 아동에게 가장 의심되는 진단은?\",\"choices\":[\"고기능 자폐스펙트럼장애\",\"경계선 지적장애\",\"사회적 의사소통장애\",\"단순언어장애\",\"읽기 학습장애\"],\"answer\":3,\"explain\":\"지능이 정상이고 제한된 관심사·상동행동이 없으면서 화용(대화 규칙·간접표현) 결함이 두드러지면 자폐스펙트럼장애가 아니라 사회적(화용) 의사소통장애로 감별한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"화용·대화\",\"k\":\"사회적 의사소통장애 감별\",\"p\":\"지능 정상·제한된 관심사 부재·화용 결함 조합으로 진단 판단\",\"n\":\"사회적 의사소통장애: 화용 결함 중심, 제한·반복 행동 없음으로 ASD와 감별\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등 3학년 아동이 형태소 규칙으로 설명되지 않는 관습적 표기 낱말에서 오류를 보인다.\\n• 할게요 → '할께요'\\n• 왠지 → '웬지'\\n• 며칠 → '몇일'\",\"q\":\"위 아동에게 필요한 쓰기 중재로 가장 적절한 것은?\",\"choices\":[\"표기형을 기억하고 인출하도록 돕는 표기처리 중심 중재\",\"형태소 원형을 밝혀 적도록 하는 형태처리 중재\",\"소리 나는 대로 적도록 하는 음운처리 중심 중재\",\"조음 정확도를 높이는 조음 중재\",\"읽기 유창성 훈련\"],\"answer\":1,\"explain\":\"형태소 규칙으로 설명되지 않고 관습적으로 굳어진 표기(할게요, 왠지, 며칠 등)의 오류는, 낱말의 표기형(철자 패턴) 자체를 기억·인출하도록 돕는 표기처리 중심 중재가 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"읽기·쓰기\",\"k\":\"철자 오류 쓰기 중재\",\"p\":\"형태소 규칙으로 설명 안 되는 관습 표기 오류로 중재 유형 선택\",\"n\":\"표기처리 중심 중재: 관습적 표기형 자체를 기억·인출하도록 지도\"}},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"(아동 발화를 전사한 자료)\\n24개월 아동의 발화\\n\\\"엄마 밥\\\", \\\"아빠 어디\\\", \\\"이거 줘\\\", \\\"물 먹어\\\"\",\"q\":\"위 발화 단계에 대한 설명으로 옳은 것은?\",\"choices\":[\"복문을 산출하는 단계이다\",\"두 낱말을 조합하는 초기 문법 단계이다\",\"한 낱말 시기(일어문)에 해당한다\",\"문법형태소 오류가 빈번한 단계이다\",\"이야기 문법을 갖춘 담화를 산출하는 단계이다\"],\"answer\":2,\"explain\":\"'엄마 밥', '이거 줘'처럼 두 낱말을 조합하지만 조사·어미 등 문법형태소가 아직 나타나지 않는 것은 초기 문법 단계(두 낱말 시기)의 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"초기 문법 발달 단계\",\"p\":\"두 낱말 조합과 문법형태소 부재로 발화 발달 단계 판단\",\"n\":\"두 낱말 시기: 낱말 조합 시작, 조사·어미 등 문법형태소 미출현\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"정상적인 비유창성을 보이는 아동의 말을 부모가 '말더듬'으로 잘못 진단하고 부정적으로 반응함으로써, 아동이 자신의 말을 의식하고 긴장·회피하게 되어 말더듬으로 발전한다고 보는 이론이다.\",\"q\":\"위 설명에 해당하는 말더듬 발생 이론은?\",\"choices\":[\"예기투쟁가설\",\"진단착오이론\",\"요구용량모델\",\"내적수정가설\",\"대뇌반구우세이론\"],\"answer\":2,\"explain\":\"진단착오이론(Johnson)은 정상적 비유창성을 부모가 말더듬으로 잘못 진단·반응하면서 아동이 말을 의식·긴장·회피하게 되어 말더듬으로 발전한다고 보는 이론이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"말더듬 발생 이론\",\"p\":\"부모의 잘못된 진단·반응이 원인이라는 설명으로 이론 식별\",\"n\":\"진단착오이론(Johnson): 정상 비유창을 말더듬으로 오진·반응해 발전\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\\\"저저저는 어 (막힘)토요일에 ㅅㅅㅅ수영장에 가서 수---영을 배워요.\\\"\",\"q\":\"다음 발화에서 나타난 진성 비유창성(SLD)의 횟수는?\",\"choices\":[\"2회\",\"3회\",\"4회\",\"5회\",\"6회\"],\"answer\":3,\"explain\":\"진성 비유창성은 단어부분반복('저저저', 'ㅅㅅㅅ수'), 막힘 1회, 연장('수---') 1회로 총 4회이다. 간투사 '어'는 기타(정상적) 비유창성으로 분류한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"SLD 횟수 산출\",\"p\":\"반복·막힘·연장과 간투사 구분으로 진성 비유창성 횟수 산출\",\"n\":\"SLD: 단어부분반복·연장·막힘, 간투사는 기타 비유창성\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 발화 표본: 총 150음절\\n• 말더듬이 나타난 음절: 12음절\",\"q\":\"위 대상자의 말더듬 음절 백분율(%SS)은?\",\"choices\":[\"6%\",\"8%\",\"10%\",\"12.5%\",\"15%\"],\"answer\":2,\"explain\":\"%SS = (말더듬 음절 수 ÷ 전체 음절 수) × 100 = 12 ÷ 150 × 100 = 8%.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"%SS 산출\",\"p\":\"말더듬 음절 수를 전체 음절 수로 나누어 %SS 산출\",\"n\":\"%SS: 말더듬 음절 수 ÷ 전체 음절 수 × 100\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 '빙산 모델(iceberg model)'에서 수면 아래에 해당하는 요소로 가장 적절한 것은?\",\"choices\":[\"겉으로 드러나는 반복·연장·막힘\",\"관찰 가능한 신체적 부수행동\",\"말속도와 조음의 정확도\",\"말더듬에 대한 두려움과 수치심\",\"발화에서 나타난 문법 오류\"],\"answer\":4,\"explain\":\"빙산 모델에서 수면 위는 반복·연장·막힘 등 겉으로 드러나는 행동이고, 수면 아래는 말더듬에 대한 두려움·수치심·좌절 등 겉으로 드러나지 않는 감정과 태도이다. 치료에서는 수면 아래 요소도 함께 다루어야 한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"빙산 모델 구성\",\"p\":\"관찰 가능한 행동과 내면 감정·태도 구분으로 수면 아래 요소 식별\",\"n\":\"빙산 모델: 수면 위 핵심행동, 수면 아래 두려움·수치심·좌절\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 38세 여성, 6개월 전 교통사고로 가족을 잃은 후 말더듬 시작\\n• 아동기 말더듬 병력 없음\\n• 모든 낱말과 문법적 위치에서 유사한 형태의 반복이 일관되게 나타남\\n• 반복해서 읽어도 말더듬 빈도가 줄지 않음\\n• 부수행동이나 말에 대한 불안이 거의 관찰되지 않음\",\"q\":\"다음 대상자에게 의심되는 유창성장애 유형은?\",\"choices\":[\"위장 말더듬\",\"신경학적 말더듬\",\"심인성 말더듬\",\"속화\",\"발달성 말더듬\"],\"answer\":3,\"explain\":\"심리적 외상 후 성인기에 갑자기 발생하고, 낱말 유형·위치와 무관하게 일관된 형태를 보이며, 적응효과가 없고 이차행동·불안이 거의 없는 양상은 심인성 말더듬의 특징이다. 신경학적 말더듬은 뇌손상 병력이 확인되어야 한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"발달 단계·감별\",\"k\":\"후천성 말더듬 감별\",\"p\":\"외상 후 성인기 발병·적응효과 부재·불안 없음으로 유형 판단\",\"n\":\"심인성 말더듬: 심리적 외상 후 발병, 일관된 형태, 적응효과 없음\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 초등학교 4학년 남아\\n• 파라다이스-유창성 검사-II(P-FA-II) 필수과제 백분위: 1~10%ile\\n• 의사소통태도 평가 점수: 17점\",\"q\":\"이 아동의 평가 결과에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"말더듬 정도와 의사소통태도가 모두 약하므로 유창성 완성법에 비중을 둔다\",\"말더듬에 비해 의사소통태도가 부정적이어서 핸디캡을 줄이는 상담·치료가 필요하다\",\"말더듬 정도와 의사소통태도가 모두 심하므로 말더듬 수정법과 심리치료 의뢰를 고려한다\",\"의사소통태도 점수가 높을수록 긍정적이므로 말하기에 자신감이 있는 상태이다\",\"필수과제가 1~10%ile이므로 정상 범위로 보고 치료가 필요하지 않다\"],\"answer\":2,\"explain\":\"P-FA-II 필수과제 1~10%ile은 말더듬 정도 '약함'에 해당한다. 의사소통태도 평가는 말을 더듬는 사람이 할 법한 답에 1점을 주므로 점수가 높을수록 부정적이며, 초등학생 17점은 81~90%ile로 '심함'에 해당한다(초등학생 평균 12.0점). 구어평가 결과보다 의사소통태도 평가 결과가 더 심하게 나타나면 말더듬으로 인한 심리적 문제와 핸디캡이 심각하므로 이를 줄이는 상담과 치료가 필요하다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"P-FA-II 구어·태도 불일치 해석\",\"p\":\"말더듬 정도와 의사소통태도 결과를 비교해 임상적 의미 판단\",\"n\":\"P-FA-II 의사소통태도: 점수 높을수록 부정적, 구어보다 태도가 심하면 핸디캡 줄이는 상담·치료\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 남아, 말더듬 시작 10개월 경과\\n• 부모가 훈련을 받고 가정의 일상 대화에서 중재를 실시함\\n• 아동의 유창한 발화에 \\\"부드럽게 잘 말했네!\\\"라고 칭찬함\\n• 말더듬이 나타나면 가끔씩 \\\"방금 좀 울퉁불퉁했네, 다시 말해 볼까?\\\"라고 요청함\\n• 치료사는 매주 말더듬 심한 정도(SR) 기록을 확인함\",\"q\":\"위 중재에 해당하는 프로그램은?\",\"choices\":[\"스토커 프로브 테크닉\",\"말더듬수정법\",\"리드콤 프로그램\",\"점진적 발화길이 및 복잡성 증가 프로그램(GILCU)\",\"페일린 부모-아동 상호작용치료\"],\"answer\":3,\"explain\":\"부모가 일상 대화에서 유창한 발화에 언어적 칭찬을, 말더듬에 간헐적인 수정 요청을 제공하고 말더듬 심한 정도(SR) 척도로 진전을 관리하는 것은 조작적 조건화 기반의 리드콤 프로그램이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"리드콤 프로그램 식별\",\"p\":\"부모 실시 언어적 수반자극과 SR 기록으로 치료 프로그램 식별\",\"n\":\"리드콤: 부모가 유창 발화 칭찬·말더듬 수정 요청, SR로 진전 관리\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대상자가 낱말에서 말을 더듬은 직후 잠시 멈추고, 긴장을 풀고 나서 방금 더듬었던 낱말을 편안한 방식으로 다시 산출하였다.\",\"q\":\"위 장면에서 사용된 말더듬수정법의 기법은?\",\"choices\":[\"가벼운 조음접촉\",\"빠져나오기\",\"예비책\",\"둔감화\",\"취소\"],\"answer\":5,\"explain\":\"취소(cancellation)는 말더듬이 끝난 후 잠시 멈추었다가 더듬은 낱말을 긴장을 줄인 방식으로 다시 말하는 기법이다. 빠져나오기는 말더듬 도중에, 예비책은 말더듬이 예상되는 낱말 이전에 적용한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬 수정법 단계\",\"p\":\"더듬은 뒤 멈추고 다시 말하는 시점으로 수정 기법 식별\",\"n\":\"취소: 말더듬 종료 후 멈추고 더듬은 낱말을 편안하게 재산출\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 말속도가 빠르고 불규칙함\\n• 음절 생략과 낱말 축약이 잦아 명료도가 낮음\\n• 주제에서 자주 벗어나며 발화 조직화가 어려움\\n• 자신의 말 문제를 잘 인식하지 못함\",\"q\":\"다음 특성을 보이는 대상자에게 우선적으로 적용할 중재 방법은?\",\"choices\":[\"가벼운 조음접촉 확립 훈련\",\"호흡과 발성의 협응 훈련\",\"말속도 조절과 자기 인식 훈련\",\"단계적 둔감화 훈련\",\"회피행동 감소 훈련\"],\"answer\":3,\"explain\":\"속화(말빠름증)의 핵심 중재는 말속도를 조절하고(속도 낮추기, 쉼 넣기) 자신의 말을 인식하는 자기 모니터링 능력을 기르는 것이다. 속화 화자는 문제 인식이 부족하므로 녹음 청취 등 인식 훈련이 중요하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"발달 단계·감별\",\"k\":\"속화 중재 방법\",\"p\":\"빠르고 불규칙한 말속도와 문제 인식 부족으로 중재 방법 선택\",\"n\":\"속화 중재: 말속도 조절과 녹음 청취 등 자기 모니터링 훈련\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬 정도 측정 검사(SSI-4)에서 말더듬 중증도 산출에 포함되는 요소로 옳게 묶인 것은?\",\"choices\":[\"말더듬 빈도, 말속도, 조음정확도\",\"말더듬 빈도, 어휘다양도, 발화길이\",\"지속시간, 음도, 강도\",\"의사소통태도, 자아효능감, 회피 정도\",\"말더듬 빈도, 지속시간, 신체적 부수행동\"],\"answer\":5,\"explain\":\"SSI-4는 말더듬 빈도(%SS), 지속시간(가장 긴 말더듬 3개의 평균), 신체적 부수행동의 세 요소 점수를 합산하여 중증도를 산출한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"SSI-4 산출 요소\",\"p\":\"SSI-4 하위 점수 구성 지식으로 중증도 산출 요소 식별\",\"n\":\"SSI-4: 말더듬 빈도·지속시간·신체적 부수행동 점수 합산\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인의 치료 전후 자아효능감 척도(SESAS) 수행 점수가 30점에서 74점으로 상승하였다.\",\"q\":\"위 변화에 대한 해석으로 옳은 것은?\",\"choices\":[\"말더듬 빈도가 증가하였다\",\"의사소통 태도가 부정적으로 변하였다\",\"말에 대한 통제력이 감소하였다\",\"치료 효과가 나타나지 않았다\",\"말에 대한 자아효능감이 향상되었다\"],\"answer\":5,\"explain\":\"자아효능감 척도(SESAS)는 점수가 높을수록 유창하게 말할 수 있다는 자신감이 크다는 의미이므로, 30→74점의 상승은 자아효능감(자신감)의 향상을 나타낸다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"SESAS 점수 해석\",\"p\":\"척도 점수 방향과 전후 변화로 치료 효과 해석 판단\",\"n\":\"SESAS: 점수가 높을수록 유창하게 말할 수 있다는 자아효능감 큼\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 아동의 아버지가 아이가 말을 더듬을 때마다 \\\"천천히 말해\\\", \\\"다시 말해 봐\\\"라고 지적하고, 아이의 말을 대신 끝맺어 준다.\",\"q\":\"위 아버지에게 제공할 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"말을 더듬을 때마다 즉시 교정해 주세요\",\"아이의 말을 대신 끝맺어 시간을 줄여 주세요\",\"아이의 말을 끝까지 기다리며 들어 주세요\",\"더 빠르게 말하는 시범을 보여 주세요\",\"말더듬는 낱말을 여러 번 반복시켜 주세요\"],\"answer\":3,\"explain\":\"말더듬 아동에게는 지적·교정·대신 말하기·시간 압박이 유창성을 방해한다. 지적을 줄이고 아이의 말을 끝까지 기다리며 느리고 편안한 대화 분위기를 만드는 것이 권장된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"말더듬 아동 부모 상담\",\"p\":\"지적·대신 말하기 등 부모 반응으로 적절한 상담 내용 선택\",\"n\":\"부모 상담: 지적·교정·대신 말하기 지양, 끝까지 기다리며 듣기\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 핵심행동(core behavior)에 해당하지 않는 것은?\",\"choices\":[\"막힘\",\"소리 연장\",\"단어부분 반복\",\"음절 반복\",\"눈 깜빡임\"],\"answer\":5,\"explain\":\"핵심행동은 반복, 연장, 막힘이다. 눈 깜빡임, 고개 젖히기 등은 핵심행동에서 벗어나거나 피하려는 부수행동(이차행동)이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"핵심행동과 부수행동\",\"p\":\"핵심행동과 부수행동의 구분으로 핵심행동 비해당 요소 식별\",\"n\":\"핵심행동: 반복·연장·막힘, 눈 깜빡임 등은 부수행동\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"발달성 말더듬에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"대부분 성인기에 처음 발생한다\",\"남아가 여아보다 유병률이 높다\",\"상당수는 자연회복된다\",\"발생에 유전적 요인이 관여한다\",\"대부분 학령전기(2~5세)에 시작된다\"],\"answer\":1,\"explain\":\"발달성 말더듬은 대부분 2~5세 학령전기에 시작되며 남아에게 더 흔하고 유전적 요인이 관여하며 상당수 자연회복된다. 성인기 최초 발병이 흔하다는 설명은 옳지 않다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"발달성 말더듬 역학\",\"p\":\"발생 시기·성비·자연회복·유전 요인 지식으로 틀린 설명 식별\",\"n\":\"발달성 말더듬: 2~5세 시작, 남아 우세, 유전 관여, 상당수 자연회복\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬수정법(Van Riper)의 궁극적인 목표로 가장 적절한 것은?\",\"choices\":[\"말더듬을 편안하고 쉽게 더듬는 것\",\"완전히 유창한 말을 확립하는 것\",\"말더듬을 완전히 제거하는 것\",\"회피행동을 강화하는 것\",\"느린 말을 영구적으로 사용하는 것\"],\"answer\":1,\"explain\":\"말더듬수정법은 말더듬을 완전히 없애기보다, 두려움과 긴장을 줄여 편안하고 쉽게 더듬으면서 자유롭게 의사소통하도록 하는 것을 목표로 한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬 수정법 목표\",\"p\":\"유창성 확립과 편하게 더듬기 목표 구분으로 수정법 목표 식별\",\"n\":\"말더듬수정법: 두려움·긴장 감소, 편안하고 쉽게 더듬기가 목표\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"정상적 비유창성(기타 비유창성)에 가장 가까운 것은?\",\"choices\":[\"긴장된 막힘\",\"소리 연장\",\"긴장을 동반한 음절 반복\",\"간투사·구 반복·수정\",\"긴장을 동반한 일음절 낱말 반복\"],\"answer\":4,\"explain\":\"간투사, 구 반복, 수정, 미완성 등은 정상적 비유창성(기타 비유창성)에 해당한다. 긴장을 동반한 음절 반복·연장·막힘은 진성 비유창성(SLD)에 가깝다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"비유창성 분석\",\"k\":\"정상적 비유창성 유형\",\"p\":\"긴장 동반 여부와 비유창성 유형으로 정상적 비유창성 식별\",\"n\":\"기타 비유창성: 간투사·구 반복·수정·미완성\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"신경학적 말더듬(neurogenic stuttering)에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"뇌졸중·외상성 뇌손상 등 이후에 발생할 수 있다\",\"반복해 읽어도 적응효과가 잘 나타나지 않는다\",\"낱말 유형·위치와 무관하게 비유창이 나타나는 경향이 있다\",\"발달성 말더듬에 비해 부수행동과 불안이 적은 편이다\",\"심리적 외상이나 정서적 갈등이 주된 원인이다\"],\"answer\":5,\"explain\":\"신경학적 말더듬은 신경학적 손상 이후 발생하고 적응효과가 미약하며 낱말 위치와 무관하게 나타난다. 심리적 외상이 주된 원인인 것은 심인성 말더듬의 특징이므로 옳지 않다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"발달 단계·감별\",\"k\":\"신경학적 말더듬 특징\",\"p\":\"발생 원인과 적응효과·부수행동 특성으로 틀린 설명 식별\",\"n\":\"신경학적 말더듬: 뇌손상 후 발생, 적응효과 미약, 위치 무관 비유창\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬을 '말더듬을 예상하고 이를 피하려는 투쟁 반응'으로 설명하는 이론은?\",\"choices\":[\"대뇌우세이론\",\"진단착오이론\",\"요구용량모델\",\"예기투쟁가설\",\"이원이론\"],\"answer\":4,\"explain\":\"예기투쟁가설은 화자가 말더듬을 예상하고 이에 대해 긴장·투쟁·회피하는 반응이 말더듬을 유발·악화시킨다고 보는 이론이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"말더듬 발생 이론\",\"p\":\"말더듬 예상과 투쟁·회피 반응 설명으로 이론 식별\",\"n\":\"예기투쟁가설: 말더듬 예상에 따른 긴장·투쟁·회피가 말더듬 유발\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"같은 문장을 여러 번 반복해서 읽을 때 말더듬 빈도가 점차 감소하는 현상은?\",\"choices\":[\"일관성효과\",\"자발회복\",\"인접효과\",\"후속효과\",\"적응효과\"],\"answer\":5,\"explain\":\"적응효과는 동일한 자료를 반복해서 읽을수록 말더듬 빈도가 감소하는 현상이다. 일관성효과는 같은 낱말·위치에서 반복적으로 더듬는 경향을 말한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"적응효과 정의\",\"p\":\"동일 자료 반복 읽기 시 빈도 감소 현상으로 용어 식별\",\"n\":\"적응효과: 반복 읽기로 말더듬 빈도 감소, 일관성효과와 구분\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬 화자의 회피행동(회피)에 해당하지 않는 것은?\",\"choices\":[\"돌려서 에둘러 말하기\",\"막힘 중 고개를 젖히기\",\"말할 순서를 뒤로 미루기\",\"전화 받는 상황을 피하기\",\"다른 낱말로 바꾸어 말하기\"],\"answer\":2,\"explain\":\"낱말 대치, 에두르기, 상황·순서 회피는 말더듬을 예상하고 미리 피하는 회피행동이다. 막힘 도중 벗어나려고 고개를 젖히는 것은 이미 시작된 말더듬에서 빠져나오려는 탈출행동이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"회피행동과 탈출행동\",\"p\":\"말더듬 발생 전후 시점으로 회피행동과 탈출행동 구분 식별\",\"n\":\"회피행동: 낱말 대치·에두르기·상황 회피, 탈출행동: 막힘 중 벗어나기\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"유창성완성법(fluency shaping)에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"느린 말·부드러운 발성 시작으로 유창한 말을 확립한다\",\"느린 속도에서 가벼운 조음접촉을 활용한다\",\"확립된 유창성을 점차 실제 상황으로 일반화한다\",\"말더듬 자체보다 유창한 말 패턴 형성에 초점을 둔다\",\"취소·빠져나오기로 말더듬 순간을 수정한다\"],\"answer\":5,\"explain\":\"취소·빠져나오기는 말더듬수정법의 기법이다. 유창성완성법은 느린 말·부드러운 시작·가벼운 조음접촉으로 유창한 말을 확립하여 일반화하는 접근이므로 '말더듬 순간 수정에 초점'은 옳지 않다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"유창성완성법 특징\",\"p\":\"두 치료 접근의 기법 구분으로 유창성완성법의 틀린 설명 식별\",\"n\":\"유창성완성법: 느린 말·부드러운 시작·가벼운 접촉, 취소·빠져나오기는 수정법\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"자신의 말을 짧은 지연 후에 듣게 하여 말속도를 늦추고 유창성을 유도하는 기기는?\",\"choices\":[\"청각 차폐기(MAF)\",\"지연청각피드백(DAF)\",\"비음측정기(나조미터)\",\"전기성문파형기(EGG)\",\"음향 스펙트로그램\"],\"answer\":2,\"explain\":\"지연청각피드백(DAF)은 화자의 말을 짧게 지연시켜 다시 들려줌으로써 말속도를 늦추고 유창성을 촉진하는 기기이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"유창성 보조 기기\",\"p\":\"자기 말을 지연시켜 들려주는 원리로 해당 기기 식별\",\"n\":\"지연청각피드백(DAF): 지연 청취로 말속도 저하·유창성 촉진\"}},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"에릭슨 의사소통태도 검사(S-24)가 측정하는 것은?\",\"choices\":[\"말더듬의 빈도\",\"말더듬 지속시간\",\"의사소통에 대한 태도\",\"신체적 부수행동\",\"말속도와 조음속도\"],\"answer\":3,\"explain\":\"S-24는 말더듬 화자가 의사소통에 대해 갖는 부정적 태도(신념)를 측정하는 자기보고식 척도이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"S-24 측정 영역\",\"p\":\"자기보고 척도의 측정 대상 지식으로 S-24 평가 영역 식별\",\"n\":\"S-24: 의사소통에 대한 부정적 태도를 측정하는 자기보고식 척도\"}},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대상자가 말을 더듬을 것으로 예상되는 낱말 직전에, 미리 긴장을 줄이고 부드럽게 첫소리에 접근하여 산출하였다.\",\"q\":\"위 장면에서 사용된 말더듬수정법의 기법은?\",\"choices\":[\"예비책\",\"빠져나오기\",\"취소\",\"둔감화\",\"고유수용감각 훈련\"],\"answer\":1,\"explain\":\"예비책(preparatory set)은 말더듬이 예상되는 낱말을 산출하기 직전에 미리 긴장을 줄이고 부드럽게 접근하여 말더듬을 예방하는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬 수정법 단계\",\"p\":\"말더듬 예상 낱말 직전 적용 시점으로 수정 기법 식별\",\"n\":\"예비책: 더듬을 것이 예상되는 낱말 직전 긴장 줄이고 부드럽게 접근\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"음성 산출의 음원-여과기 이론(source-filter theory)에 대한 설명으로 옳은 것은?\",\"choices\":[\"포먼트는 성대 진동수에 의해 직접 결정된다\",\"기본주파수는 성도 길이로만 결정된다\",\"성대 진동이 음원, 성도가 여과기로 작용한다\",\"음원과 여과기는 물리적으로 동일한 구조이다\",\"여과기 기능은 폐의 공기압이 담당한다\"],\"answer\":3,\"explain\":\"음원-여과기 이론에서는 성대 진동이 음원(source)이 되어 기본주파수와 배음을 만들고, 성도(공명강)가 여과기(filter)로 작용하여 특정 주파수를 강조·감쇠함으로써 포먼트가 형성된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"음원-여과기 이론\",\"p\":\"성대와 성도의 역할 구분으로 음원-여과기 이론 설명 식별\",\"n\":\"음원-여과기 이론: 성대 진동이 음원, 성도가 여과기로 포먼트 형성\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"발성 시 음도(pitch)를 높이는 생리적 기전으로 옳은 것은?\",\"choices\":[\"성대가 짧아지고 두꺼워지면서 진동수가 증가한다\",\"윤상갑상근이 수축해 성대가 길어지고 긴장된다\",\"호기류량만 증가시키면 음도가 높아진다\",\"성문하압을 낮추면 음도가 높아진다\",\"갑상피열근만 이완시키면 음도가 높아진다\"],\"answer\":2,\"explain\":\"음도는 성대의 진동수에 의해 결정된다. 윤상갑상근(CT)이 수축하면 성대가 길어지고 긴장되어 진동수가 증가하므로 음도가 높아진다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"음도 상승 생리 기전\",\"p\":\"성대 길이·긴장 변화 근거로 음도 상승 기전 식별\",\"n\":\"윤상갑상근 수축: 성대 신장·긴장 증가로 진동수·음도 상승\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"공기역학적 검사 결과\\n• 폐활량: 정상 범위\\n• 최대연장발성시간(MPT): 5.2초\\n• 평균호기류율: 260 mL/sec (증가)\\n• 성문하압: 정상 범위\\n• 청지각적으로 기식적이고 약한 음성\",\"q\":\"다음 결과에서 추정되는 음성장애는?\",\"choices\":[\"근긴장성 발성장애\",\"라인케부종\",\"편측 성대마비\",\"내전형 연축성발성장애\",\"변성발성장애\"],\"answer\":3,\"explain\":\"짧은 MPT와 증가된 평균호기류율은 성문폐쇄부전으로 공기가 새고 있음을 의미하며, 기식적이고 약한 음성과 함께 편측 성대마비를 시사한다. 근긴장성 발성장애나 내전형 연축성발성장애는 과내전 양상으로 호기류율이 감소하는 경향을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"공기역학 검사 결과 해석\",\"p\":\"짧은 MPT와 평균호기류율 증가 조합으로 음성장애 판단\",\"n\":\"성문폐쇄부전: MPT 단축·호기류율 증가·기식 음성, 편측 성대마비 시사\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"환자가 지각하는 음성 문제가 일상생활에 미치는 신체적·기능적·정서적 영향을 평가하는 자기보고식 도구는?\",\"choices\":[\"CAPE-V\",\"최대연장발성시간(MPT)\",\"GRBAS 척도\",\"음성장애지수(VHI)\",\"음성범위프로파일(VRP)\"],\"answer\":4,\"explain\":\"음성장애지수(VHI)는 환자 스스로 음성 문제로 인한 신체·기능·정서 영역의 불편감을 평정하는 자기보고식 설문이다. GRBAS와 CAPE-V는 평가자의 청지각적 평가 도구이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"자기보고식 음성 평가도구\",\"p\":\"환자 자기평정 여부로 음성 평가도구 식별\",\"n\":\"VHI: 신체·기능·정서 영역 자기보고식 설문, GRBAS·CAPE-V는 청지각 평가\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음향학적 검사(MDVP) 결과\\n• 기본주파수(F0): 성별·연령 규준 범위\\n• 주파수변동률(jitter): 3.85 % (증가)\\n• 진폭변동률(shimmer): 7.9 % (증가)\\n• 소음대배음비(NHR): 0.28 (증가)\",\"q\":\"위 결과에 대한 설명으로 옳은 것은?\",\"choices\":[\"음성 강도가 과도하게 크다\",\"음성 신호의 주기성이 낮다\",\"습관적 음도가 비정상적으로 높다\",\"공명 문제가 확인된다\",\"정상 음질에 해당한다\"],\"answer\":2,\"explain\":\"jitter(주파수 변동률), shimmer(진폭 변동률), NHR(소음대배음비)의 증가는 성대 진동의 규칙성이 떨어지고 신호 내 소음 성분이 많다는 것, 즉 음성 신호의 주기성이 낮음을 의미한다. F0 자체는 정상 범위이므로 음도 문제로 볼 수 없다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"MDVP 음향 지표 해석\",\"p\":\"jitter·shimmer·NHR 증가로 음성 신호 특성 판단\",\"n\":\"jitter·shimmer·NHR 증가: 성대 진동 불규칙·소음 증가로 주기성 저하\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 32세 초등교사\\n• 후두내시경: 양측 성대 막성부 중간 지점의 대칭적인 양성 병변, 모래시계 모양의 성문폐쇄\\n• 음성 남용력: 하루 6교시 수업, 큰 소리 사용 빈번\",\"q\":\"위 환자에게 우선적으로 적용할 치료는?\",\"choices\":[\"음성치료와 음성위생 교육\",\"보툴리눔 독소 주입\",\"성대 내 주입술\",\"제I형 갑상성형술\",\"후두미세수술\"],\"answer\":1,\"explain\":\"양측성·대칭성 병변과 모래시계형 성문폐쇄는 성대결절의 전형적 소견이며, 음성 남용이 원인이므로 일차적 치료는 음성치료(반폐쇄성도훈련 등)와 음성위생 교육이다. 수술은 충분한 음성치료 후에도 호전이 없을 때 고려한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성대결절 일차 치료 선택\",\"p\":\"양측 대칭 병변과 음성 남용력으로 우선 치료 선택\",\"n\":\"성대결절: 양측 대칭·모래시계형 폐쇄, 일차 치료는 음성치료·음성위생\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"20대 여성이 특별한 신체 질환 없이 갑자기 목소리가 나오지 않아 속삭이는 소리로만 말한다. 그러나 기침과 웃음에서는 정상적인 유성음이 산출되고, 후두내시경에서 구조적 이상이 없다.\",\"q\":\"위 사례에 대한 설명으로 옳은 것은?\",\"choices\":[\"성대의 구조적 병변에 의한 기질적 실성증이다\",\"반드시 수술적 치료가 필요하다\",\"기침·웃음에서도 발성이 전혀 불가능하다\",\"기능적(심인성) 실성증에 해당한다\",\"신경 손상에 의한 성대마비가 원인이다\"],\"answer\":4,\"explain\":\"구조적 이상 없이 기침·웃음 등 반사적(생리적) 발성에서 정상 유성음이 가능한 것은 기능적(심인성) 실성증의 특징이다. 보존된 생리적 발성(기침·헛기침·허밍)에서 모음·낱말로 확장하며 발성을 재확립한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"기능적 실성증 식별\",\"p\":\"구조 정상과 반사적 발성 보존으로 실성증 유형 판단\",\"n\":\"기능적(심인성) 실성증: 구조 이상 없음, 기침·웃음 시 정상 유성음\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 17세 남학생, 변성기가 지났으나 지속적으로 높은 음도로 말함\\n• 후두 구조와 호르몬 검사: 정상\",\"q\":\"위 대상자에게 적용할 수 있는 음성치료 기법은?\",\"choices\":[\"음도를 더 높여 가성구 발성을 훈련한다\",\"큰 소리로 고음 발성을 반복시킨다\",\"속삭이는 소리로 말하게 한다\",\"성대 과내전을 유도한다\",\"갑상연골을 눌러 낮은 음도를 유도한다\"],\"answer\":5,\"explain\":\"변성발성장애는 변성기 이후에도 높은 음도가 유지되는 기능적 장애로, 손가락 조작법(갑상연골을 후하방으로 눌러 성대를 이완)으로 낮은 진성 발성을 유도한 뒤 이를 안정화하는 치료가 효과적이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"변성발성장애 치료 기법\",\"p\":\"변성기 후 고음도 지속 사례에 맞는 치료 기법 선택\",\"n\":\"변성발성장애: 갑상연골 후하방 압박 손가락 조작법으로 낮은 진성 유도\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 68세 남성, 파킨슨병 진단\\n• 약한 음성 강도, 단조로운 음도\\n• 말끝이 흐려지며 가족들이 잘 알아듣지 못함\\n• 스스로는 목소리가 작다고 느끼지 않음\",\"q\":\"위 환자에게 가장 적절한 음성치료는?\",\"choices\":[\"차폐를 이용한 강도 증가\",\"속삭임 발성 중심 훈련\",\"가성대 발성 유도 훈련\",\"리실버만음성치료(LSVT)\",\"저작하기 기법으로 이완 유도\"],\"answer\":4,\"explain\":\"리실버만음성치료(LSVT LOUD)는 파킨슨병 환자를 대상으로 '크게 말하기'에 집중하여 고강도로 반복 훈련하는 근거 기반 치료로, 강도 증가와 함께 명료도 개선 효과가 보고된다. 감각 인식 저하(스스로 작다고 느끼지 않음)에 대한 보정 훈련도 포함한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"파킨슨병 음성치료 선택\",\"p\":\"약한 강도·단조 음도·자기인식 저하로 음성치료 선택\",\"n\":\"LSVT LOUD: 파킨슨병 대상 크게 말하기 중심 고강도 반복 훈련\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"내전형 연축성발성장애에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"모음으로 시작하는 낱말에서 쥐어짜는 듯한 음성 끊김이 나타난다\",\"성대의 구조적 병변이 주된 원인이다\",\"속삭임·노래·웃음에서는 증상이 감소한다\",\"보툴리눔 독소 주입이 대표적 치료이다\",\"성대 내전근의 불수의적 연축에 의한 신경학적 장애이다\"],\"answer\":2,\"explain\":\"내전형 연축성발성장애는 구조적 병변 없이 성대 내전근의 불수의적 연축으로 발생하는 신경학적 장애이다. 모음 시작 낱말에서 음성 끊김이 두드러지고 속삭임·노래에서 감소하며 보툴리눔 독소로 치료하므로 '구조적 성대 병변이 원인'은 옳지 않다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"연축성발성장애 특성\",\"p\":\"원인·증상·치료 특성으로 내전형 연축성발성장애 오류 진술 식별\",\"n\":\"내전형 연축성발성장애: 내전근 불수의 연축의 신경학적 장애, 보툴리눔 치료\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"후두전적출 환자의 식도발성(esophageal speech)에 대한 설명으로 옳은 것은?\",\"choices\":[\"폐의 공기를 성대로 보내어 소리를 낸다\",\"삼킨 공기를 역류시켜 인두식도분절을 진동시킨다\",\"반드시 보철(프로테제) 삽입이 있어야 발성할 수 있다\",\"전기 진동자를 목에 대어 소리를 낸다\",\"성대가 재생되어 발성이 가능해진다\"],\"answer\":2,\"explain\":\"식도발성은 공기를 삼켜 식도에 넣었다가 역류시키면서 인두식도분절(PE segment)을 진동시켜 소리를 내는 무후두 음성 방법으로, 별도의 보철 없이도 훈련할 수 있다. 성대는 재생되지 않는다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"특수 대상\",\"k\":\"식도발성 원리\",\"p\":\"공기 공급원과 진동체 근거로 식도발성 원리 식별\",\"n\":\"식도발성: 삼킨 공기 역류로 인두식도분절 진동, 보철 없이 훈련 가능\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 74세 남성, 목소리가 약하고 쉽게 피로하다고 호소\\n• 후두내시경: 성대 위축과 활모양의 성문틈, 병변 없음\\n• 신경학적 이상 없음\",\"q\":\"위 환자에게 적절한 음성치료 접근은?\",\"choices\":[\"음성 사용을 최대한 제한한다\",\"속삭임으로 말하도록 한다\",\"보툴리눔 독소 주입을 의뢰한다\",\"성대내전을 강화하는 훈련을 실시한다\",\"음도를 낮추는 훈련을 실시한다\"],\"answer\":4,\"explain\":\"노인성 음성(성대 위축, 활모양 성문틈)은 성문폐쇄부전이 핵심이므로 밀기 접근법, 강한 성대접촉 유도, 반폐쇄성도훈련 등 성대내전과 발성 효율을 강화하는 음성치료가 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"노인성 음성 치료 접근\",\"p\":\"성대 위축과 활모양 성문틈 소견으로 치료 방향 선택\",\"n\":\"노인성 음성: 성문폐쇄부전 핵심, 밀기 접근 등 성대내전 강화 훈련\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"GRBAS 척도에서 'R'이 의미하는 음성 특성은?\",\"choices\":[\"전반적 중증도\",\"조조성\",\"기식성\",\"무력성\",\"긴장성\"],\"answer\":2,\"explain\":\"GRBAS에서 G는 전반적 중증도, R은 조조성(거친 소리), B는 기식성, A는 무력성, S는 긴장성을 의미한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"GRBAS 척도 항목\",\"p\":\"GRBAS 약자별 의미로 R 항목 식별\",\"n\":\"GRBAS: 전반적 중증도·조조성·기식성·무력성·긴장성\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 후두내시경: 편측 성대의 유경성(줄기 달린) 병변\\n• 갑작스러운 고함·큰 소리 이후 발생\\n• 거칠고 낮은 음성\",\"q\":\"위 소견에서 의심되는 질환은?\",\"choices\":[\"성대결절\",\"성대구증\",\"라인케부종\",\"후두유두종\",\"성대폴립\"],\"answer\":5,\"explain\":\"성대폴립은 흔히 편측성이며 유경성 또는 무경성으로 나타나고, 갑작스러운 음성 남용(고함) 후 발생하는 경우가 많다. 성대결절은 대개 양측성·대칭성이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"성대 병변 감별\",\"p\":\"편측 유경성 병변과 고함 후 발병으로 질환 판단\",\"n\":\"성대폴립: 편측·유경성 또는 무경성, 급성 음성 남용 후 발생, 결절은 양측성\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"후두에 기질적 병변이 없으나 후두 주변 근육의 과도한 긴장으로 쥐어짜는 음성을 보이는 장애는?\",\"choices\":[\"편측 성대마비\",\"사춘기 변성발성장애\",\"연축성 발성장애\",\"근긴장성 발성장애\",\"양측 성대구증\"],\"answer\":4,\"explain\":\"근긴장성 발성장애(MTD)는 구조적 병변 없이 후두 내·외근의 과도한 긴장으로 발생하는 기능적 음성장애이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"근긴장성 발성장애 정의\",\"p\":\"구조 병변 부재와 후두근 과긴장 특성으로 장애 식별\",\"n\":\"근긴장성 발성장애: 병변 없이 후두 내·외근 과긴장에 의한 기능적 장애\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"음향학적 분석에서 진폭(강도)의 주기 간 변동률을 나타내는 측정치는?\",\"choices\":[\"shimmer\",\"F0 표준편차\",\"NHR\",\"CPP\",\"jitter\"],\"answer\":1,\"explain\":\"shimmer는 주기 간 진폭(강도)의 변동률, jitter는 주기 간 기본주파수의 변동률, NHR은 소음 대 배음 비율이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"음향 측정치 정의\",\"p\":\"주기 간 진폭 변동 개념으로 음향 측정치 식별\",\"n\":\"shimmer: 주기 간 진폭 변동률, jitter: 주기 간 주파수 변동률\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"s/z 비율이 1.4 이상으로 증가했을 때 가장 우선적으로 의심할 수 있는 것은?\",\"choices\":[\"호흡 기능의 단독 저하\",\"조음기관의 구조적 이상\",\"경도의 청력 손실\",\"성대 병변과 성문폐쇄부전\",\"공명강의 구조적 협착\"],\"answer\":4,\"explain\":\"/s/는 호흡 기능, /z/는 호흡과 발성 기능을 함께 반영한다. s/z 비율이 1.4 이상이면 /z/ 연장이 상대적으로 짧다는 의미로, 성대 병변에 의한 성문폐쇄부전을 시사한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"s/z 비율 해석\",\"p\":\"s/z 비율 1.4 이상 증가로 의심 소견 판단\",\"n\":\"s/z 비율 1.4 이상: /z/ 상대적 단축, 성대 병변·성문폐쇄부전 시사\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"음성위생 교육 내용으로 적절하지 않은 것은?\",\"choices\":[\"충분한 수분을 섭취한다\",\"소음 환경에서 큰 소리로 말하는 것을 줄인다\",\"음성 휴식이 필요하면 속삭여 말한다\",\"습관적인 헛기침을 줄인다\",\"과도한 카페인 섭취를 줄인다\"],\"answer\":3,\"explain\":\"속삭이기는 성대에 오히려 과도한 긴장을 주므로 음성위생법으로 권장되지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"음성위생 교육 내용\",\"p\":\"성대 부담 여부로 부적절한 음성위생 지침 식별\",\"n\":\"음성위생: 속삭이기는 성대 긴장을 유발하므로 권장하지 않음\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"갑상샘 수술 후 편측 성대마비를 유발하기 쉬운 신경은?\",\"choices\":[\"되돌이후두신경\",\"미주신경 본간\",\"설하신경\",\"삼차신경\",\"상후두신경\"],\"answer\":1,\"explain\":\"미주신경의 분지인 되돌이후두신경(반회후두신경)은 갑상샘 수술 시 손상되기 쉬우며, 손상되면 편측 성대마비로 기식적이고 약한 음성이 나타난다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"성대마비 관련 신경\",\"p\":\"갑상샘 수술 시 손상 위험 근거로 원인 신경 식별\",\"n\":\"되돌이후두신경: 미주신경 분지, 갑상샘 수술 시 손상되어 편측 성대마비\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"최대연장발성시간(MPT)이 정상보다 현저히 짧게 나타날 때 가장 우선적으로 시사되는 것은?\",\"choices\":[\"경도의 청력 손실\",\"성문폐쇄부전과 호흡 부족\",\"성대의 과도한 내전\",\"조음기관의 구조적 이상\",\"공명강의 구조 이상\"],\"answer\":2,\"explain\":\"MPT는 한 번의 흡기 후 낼 수 있는 최대 발성 시간으로, 현저히 짧으면 성문폐쇄부전으로 공기가 새거나 호흡 지지가 부족함을 시사한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"MPT 단축 해석\",\"p\":\"MPT의 현저한 단축으로 시사되는 기능 문제 판단\",\"n\":\"MPT 단축: 성문폐쇄부전에 따른 공기 누출 또는 호흡 지지 부족\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"소아에게서 반복적으로 재발하며, 인유두종바이러스(HPV) 감염과 관련되어 성대에 사마귀 모양의 병변이 자라 애성과 기도 폐쇄를 유발하는 질환이 있다.\",\"q\":\"위 설명에 해당하는 질환으로 가장 적절한 것은?\",\"choices\":[\"성대결절\",\"라인케부종\",\"재발성 후두유두종\",\"성대구증\",\"근긴장성 발성장애\"],\"answer\":3,\"explain\":\"재발성 후두유두종(재발성 호흡기 유두종증)은 인유두종바이러스(HPV) 감염과 관련되어 성대에 사마귀 모양 병변이 자라 애성·기도폐쇄를 유발하며, 소아에서 반복 재발하는 경향이 있다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"재발성 후두유두종 특성\",\"p\":\"HPV 관련성과 소아 재발 특성으로 질환 식별\",\"n\":\"재발성 후두유두종: HPV 관련 사마귀 모양 병변, 애성·기도폐쇄, 소아 재발\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"성대의 접촉 양상(개방·폐쇄 주기)을 비침습적으로 간접 측정하는 데 가장 적절한 도구는?\",\"choices\":[\"전기성문파형검사(EGG)\",\"나조미터(비음도)\",\"음향 스펙트로그램\",\"순음청력검사(PTA)\",\"음성범위프로파일\"],\"answer\":1,\"explain\":\"전기성문파형검사(EGG)는 성대 접촉 면적의 변화를 통해 성대의 개방·폐쇄 주기(접촉 양상)를 비침습적으로 간접 측정하는 도구이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"EGG 측정 목적\",\"p\":\"성대 접촉 양상 측정 목적으로 검사도구 선택\",\"n\":\"EGG: 성대 접촉 면적 변화로 개방·폐쇄 주기를 비침습 간접 측정\"}},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음성치료에서 대상자에게 빨대를 물컵에 담그고 그 안으로 소리를 내게 하거나, 입술 트릴·허밍을 하며 발성하도록 하였다.\",\"q\":\"위 기법들의 공통된 원리로 옳은 것은?\",\"choices\":[\"성대를 강하게 접촉시켜 강도를 높인다\",\"성문을 완전히 개방하여 기식성을 늘린다\",\"음도를 최대한 높여 가성구로만 발성한다\",\"호흡을 멈추고 발성한다\",\"성도를 좁혀 성대 접촉 부담을 줄인다\"],\"answer\":5,\"explain\":\"빨대 발성, 입술 트릴, 허밍 등은 반폐쇄성도훈련(SOVT)으로, 성도를 부분적으로 좁혀 성문 상부 압력을 높임으로써 성대 접촉 부담을 줄이고 효율적인 발성을 유도한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"반폐쇄성도훈련 원리\",\"p\":\"빨대·입술 트릴·허밍의 공통점으로 치료 원리 식별\",\"n\":\"SOVT: 성도 부분 폐쇄로 성문상압 상승, 성대 접촉 부담 감소\"}},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"성대의 유리연을 따라 고랑(구)이 패여 성문폐쇄부전과 기식 음성을 보이는 질환은?\",\"choices\":[\"후두유두종\",\"성대결절\",\"라인케부종\",\"성대폴립\",\"성대구증\"],\"answer\":5,\"explain\":\"성대구증은 성대 유리연을 따라 고랑이 패이는 질환으로, 성문폐쇄부전으로 인한 기식 음성과 음성 피로가 나타난다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"성대구증 특성\",\"p\":\"유리연 고랑과 성문폐쇄부전 특성으로 질환 식별\",\"n\":\"성대구증: 성대 유리연 고랑, 성문폐쇄부전·기식 음성·음성 피로\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"아동1: 4세, 어리고 정상적인 아동에게 나타나는 음운변동(종성생략, 연구개음 전방화)이 지속됨\\n아동2: 혀 내밀기로 인한 /ㅅ/ 왜곡이 모든 문맥에서 일관됨\\n아동3: 어중초성 생략과 어두 자음 첨가 등 발달과정에서 드문 오류패턴이 일관되게 나타남\\n아동4: 같은 낱말을 말할 때마다 40% 이상 서로 다른 형태로 산출함\",\"q\":\"Dodd의 분류에 따라 '음운지연'에 해당하는 아동은?\",\"choices\":[\"아동1\",\"아동2\",\"아동3\",\"아동4\",\"해당 아동 없음\"],\"answer\":1,\"explain\":\"음운지연은 정상 발달과정에서 나타나는 음운변동이 해당 연령이 지나서도 지속되는 경우이다. 아동2는 조음장애(일관된 왜곡), 아동3은 비전형적 패턴이 일관된 일관적 음운장애, 아동4는 비일관적 음운장애에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"Dodd 말소리장애 분류\",\"p\":\"오류 양상의 발달성·일관성으로 음운지연 아동 식별\",\"n\":\"음운지연: 정상 발달 음운변동이 해당 연령 이후에도 지속되는 유형\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n사자 → [타다]\\n수박 → [투박]\\n코끼리 → [토끼리]\\n그네 → [드네]\\n호랑이 → [호앙이]\",\"q\":\"다음 조음음운장애 아동의 발화에서 나타난 음운오류패턴에 대한 설명으로 적절한 것은?\",\"choices\":[\"종성 생략이 2회 나타났다\",\"유음의 활음화가 모두 2회 나타났다\",\"마찰음·파찰음의 파열음화가 3회 나타났다\",\"연구개음의 전방화가 모두 3회 나타났다\",\"유음의 비음화가 1회 나타났다\"],\"answer\":3,\"explain\":\"파열음화는 사자→[타다]에서 /ㅅ/→[ㅌ], /ㅈ/→[ㄷ] 2회, 수박→[투박]에서 /ㅅ/→[ㅌ] 1회로 총 3회이다. 연구개음 전방화는 코끼리→[토끼리], 그네→[드네]의 2회, 호랑이→[호앙이]는 유음 탈락이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"음운오류패턴 빈도 분석\",\"p\":\"발화 전사의 대치 양상 집계로 음운변동 출현 횟수 판단\",\"n\":\"파열음화: 마찰음·파찰음의 파열음 대치, 사자·수박에서 총 3회\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어(자음) → 아동 발화\\n가방 (ㄱ,ㅂ,ㅇ) → [가바]\\n모자 (ㅁ,ㅈ) → [모다]\\n나무 (ㄴ,ㅁ) → [나무]\\n딸기 (ㄸ,ㄹ,ㄱ) → [딸기]\",\"q\":\"위 낱말 검사에서 아동의 자음정확도(PCC)는?\",\"choices\":[\"6/10 × 100\",\"7/10 × 100\",\"8/10 × 100\",\"9/10 × 100\",\"10/10 × 100\"],\"answer\":3,\"explain\":\"조음해야 할 자음은 총 10개이며, 오류는 '가방'의 종성 /ㅇ/ 생략과 '모자'의 /ㅈ/→[ㄷ] 대치 2개이다. 따라서 자음정확도 = 8/10 × 100 = 80%.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PCC 산출\",\"p\":\"목표 자음 수와 오류 자음 수로 자음정확도 산출\",\"n\":\"PCC: 바르게 조음한 자음 수 ÷ 조음해야 할 자음 수 × 100\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 아동이 어두 /ㅅ/를 [ㄷ]로 대치하는 오류를 보인다. 무의미음절 /사/, /수/에서는 청각·시각 단서를 주면 정조음이 가능하여, 낱말 수준으로 확장하려 한다.\",\"q\":\"어두 /ㅅ/ 확립을 위한 낱말 수준 훈련 목록으로 가장 적절한 것은?\",\"choices\":[\"단추, 다리, 도장\",\"거울, 가위, 구두\",\"사탕, 손, 시소\",\"라면, 리본, 로봇\",\"모자, 무지개, 미소\"],\"answer\":3,\"explain\":\"확립 단계에서는 목표음이 포함된 낱말로 연습해야 하므로 어두에 /ㅅ/가 오는 '사탕, 손, 시소'가 적절하다. 목표음이 안정되면 어중·어말, 문장 수준으로 점차 일반화한다. 나머지는 목표음 /ㅅ/가 포함되지 않은 낱말들이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"훈련 낱말 목록 선정\",\"p\":\"목표음 위치 조건 충족 여부로 확립 단계 낱말 선택\",\"n\":\"확립 단계: 목표음이 어두에 포함된 낱말로 연습 후 위치·문장으로 확장\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"순음청력검사 결과\\n• 양측 기도 청력역치: 45 dB HL\\n• 양측 골도 청력역치: 10 dB HL\\n• 기도-골도 차(air-bone gap): 35 dB\",\"q\":\"위 결과에 대한 해석으로 적절한 것은?\",\"choices\":[\"감각신경성 난청이 의심된다\",\"전음성 난청이 의심된다\",\"정상 청력 범위이다\",\"혼합성 난청이며 내이 손상이 확실하다\",\"청신경 종양이 의심된다\"],\"answer\":2,\"explain\":\"골도 역치는 정상이나 기도 역치가 상승하여 기도-골도 차가 존재하는 것은 전음성 난청의 소견으로, 중이염 등 외이·중이의 병변을 확인해야 한다. 감각신경성 난청은 기도·골도가 함께 상승하고 기도-골도 차가 없다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"청각·청각장애\",\"k\":\"순음청력검사 해석\",\"p\":\"기도·골도 역치와 기도-골도 차로 난청 유형 판단\",\"n\":\"전음성 난청: 골도 정상·기도 상승으로 기도-골도 차 존재\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n바지 → [빠지]\\n도로 → [또로]\\n가방 → [까방]\",\"q\":\"위 오류에서 아동이 아직 확립하지 못한 변별자질의 대립은?\",\"choices\":[\"지속성\",\"긴장성\",\"비음성\",\"설측성\",\"공명성\"],\"answer\":2,\"explain\":\"평음 /ㅂ, ㄷ, ㄱ/이 경음 /ㅃ, ㄸ, ㄲ/으로 대치되는 경음화로, [−긴장성]과 [+긴장성]의 대립을 아직 확립하지 못한 것이다. 따라서 긴장성 자질의 대조를 목표로 중재한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성학·음운론 기초\",\"k\":\"오류의 변별자질 분석\",\"p\":\"평음의 경음 대치 양상으로 미확립 변별자질 판단\",\"n\":\"긴장성 자질: 평음 [-긴장성]과 경음 [+긴장성]의 대립\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말소리 목록이 매우 제한된 어린 아동에게 실시하는 독립분석(independent analysis)에 대한 설명으로 옳은 것은?\",\"choices\":[\"음운변동의 출현 빈도와 유형을 분석한다\",\"자음정확도(PCC)를 백분율로 산출한다\",\"목표 음소 대비 정확도를 산출한다\",\"산출한 말소리 목록과 음절 구조를 분석한다\",\"오류음의 자극반응도를 함께 측정한다\"],\"answer\":4,\"explain\":\"독립분석은 성인(목표) 형태와 대조하지 않고 아동이 실제로 산출한 말소리 목록·음절 구조 등을 그 자체로 기술하는 방법으로, 말소리 목록이 제한적인 어린 아동에게 유용하다. 목표와 비교하여 정확도·음운변동을 분석하는 것은 관계분석에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"독립분석과 관계분석\",\"p\":\"목표 형태 대조 여부로 독립분석 특성 식별\",\"n\":\"독립분석: 목표와 비교 없이 산출 말소리 목록·음절구조 기술\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"문맥검사 결과: 아동은 /ㅅ/를 /ㅣ/ 모음 앞에서만 정조음하고('시소'의 '시'), 다른 모음 문맥에서는 [ㄷ]로 대치한다.\",\"q\":\"위 결과를 활용한 중재 방법으로 적절한 것은?\",\"choices\":[\"비언어적 구강운동 훈련만 실시한다\",\"/시/ 문맥에서 시작해 다른 문맥으로 확대한다\",\"오류가 가장 심한 문맥부터 훈련한다\",\"/ㅅ/ 훈련을 중단하고 다른 음소를 목표로 한다\",\"모든 모음 문맥을 무작위로 섞어 훈련한다\"],\"answer\":2,\"explain\":\"문맥검사에서 발견된 촉진 문맥(정조음 가능한 문맥)은 치료의 출발점이 된다. /시/에서 안정적으로 산출한 뒤 다른 모음 문맥, 음절·낱말 수준으로 점진적으로 일반화시키는 것이 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"촉진 문맥 활용 중재\",\"p\":\"문맥검사의 정조음 문맥 근거로 중재 출발점 선택\",\"n\":\"촉진 문맥: 정조음 가능한 문맥에서 시작해 다른 문맥으로 일반화\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"음운인식 능력의 발달에 대한 설명으로 옳은 것은?\",\"choices\":[\"음소 분절 능력이 음절 수 세기보다 먼저 발달한다\",\"음소 조작이 각운(rhyme) 인식보다 먼저 발달한다\",\"음운인식은 읽기(해독) 능력과 전혀 관련이 없다\",\"음소 탈락이 음절 탈락보다 이른 시기에 발달한다\",\"음절 수준 인식이 음소 수준 인식보다 먼저 발달한다\"],\"answer\":5,\"explain\":\"음운인식은 대체로 음절 → 초성-각운(음절체-종성) → 음소 순으로, 큰 단위에서 작은 단위로 발달한다. 따라서 음절 수준 인식이 음소 수준 인식보다 먼저 발달하며, 음운인식은 낱말 해독의 중요한 기초가 된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음운인식\",\"k\":\"음운인식 발달 순서\",\"p\":\"음운 단위 크기에 따른 발달 순서로 옳은 진술 식별\",\"n\":\"음운인식 발달: 음절 → 초성-각운 → 음소, 큰 단위에서 작은 단위로\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"• 3세 남아, 기질적 결함 없음\\n• 산출 가능한 자음이 /ㅁ, ㅂ, ㅃ/로 제한됨\\n• 모음은 대부분 정확하게 산출함\",\"q\":\"위 아동의 초기 목표 낱말 선정 원칙으로 가장 적절한 것은?\",\"choices\":[\"아동의 목록에 없는 음소들로만 구성된 낱말을 선정한다\",\"이미 산출 가능한 음소로 된 기능적 낱말을 선정한다\",\"음절 수가 많고 구조가 복잡한 낱말부터 선정한다\",\"의미보다 발음 난이도가 높은 낱말을 우선 선정한다\",\"사용 빈도가 낮은 낱말을 선정한다\"],\"answer\":2,\"explain\":\"초기 목표 낱말은 아동이 이미 산출 가능한 음소(여기서는 양순음)와 단순한 음절 구조로 이루어지고, 일상에서 의사소통 기능이 높은 낱말이 적절하다. 성공 경험을 통해 의사소통 동기를 높이는 것이 목적이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"초기 목표 낱말 선정\",\"p\":\"제한된 자음 목록 아동에 맞는 초기 목표 낱말 원칙 선택\",\"n\":\"초기 목표 낱말: 산출 가능 음소·단순 음절구조·높은 의사소통 기능\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"구개열 수술을 받은 5세 아동이 파열음·마찰음을 산출할 때 코로 공기가 새고 과다비성이 동반되어 말명료도가 낮다.\",\"q\":\"위 아동의 비강누출·과다비성을 간편하게 선별하는 방법으로 적절한 것은?\",\"choices\":[\"교호운동속도(DDK)를 반복해서 측정한다\",\"순음 청력역치를 측정한다\",\"콧구멍 아래 거울을 대고 김서림을 관찰한다\",\"최대연장발성시간(MPT)을 측정한다\",\"수용어휘력 검사를 함께 실시한다\"],\"answer\":3,\"explain\":\"구강 압력이 필요한 압력자음(파열음·마찰음)을 산출할 때 콧구멍 아래 댄 거울(비경)에 김이 서리는지 관찰하면 비강누출과 과다비성을 간편하게 선별할 수 있다. 나머지는 공명·비강누출을 직접 선별하는 방법이 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"비강누출 선별 방법\",\"p\":\"압력자음 산출 시 비강 기류 관찰 근거로 선별법 선택\",\"n\":\"거울 김서림 관찰: 압력자음 산출 시 비강누출·과다비성 간편 선별\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"청능훈련의 단계를 발달 순서대로 바르게 나열한 것은?\",\"choices\":[\"탐지 → 변별 → 확인 → 이해\",\"변별 → 탐지 → 확인 → 이해\",\"탐지 → 확인 → 변별 → 이해\",\"확인 → 변별 → 탐지 → 이해\",\"이해 → 확인 → 변별 → 탐지\"],\"answer\":1,\"explain\":\"청능훈련은 소리의 유무를 아는 탐지, 두 소리가 같은지 다른지 아는 변별, 무슨 소리인지 알아 반응하는 확인, 말의 의미를 이해하는 이해의 순서로 진행한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"청각·청각장애\",\"k\":\"청능훈련 단계 순서\",\"p\":\"청각 처리 수준의 위계로 청능훈련 순서 선택\",\"n\":\"청능훈련 순서: 탐지 → 변별 → 확인 → 이해\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"'불-풀'처럼 하나의 음소 차이로 의미가 달라지는 낱말 쌍을 이용하는 음운론적 치료 접근은?\",\"choices\":[\"짝자극 기법\",\"최소대립쌍 치료\",\"주기법\",\"전통적 조음지시법\",\"구강운동 훈련\"],\"answer\":2,\"explain\":\"최소대립쌍 치료는 한 음소의 차이로 의미가 구별되는 낱말 쌍을 이용하여 음운 대조를 인식시키고 목표음 산출을 유도하는 음운론적 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"최소대립쌍 치료\",\"p\":\"한 음소 차이 낱말쌍 활용 특징으로 치료 접근 식별\",\"n\":\"최소대립쌍 치료: 한 음소 차이 낱말쌍으로 음운 대조 인식·산출 유도\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"명료도가 매우 낮은 아동을 대상으로 여러 오류 음운패턴을 주기마다 순환하며 목표로 삼는 접근법은?\",\"choices\":[\"짝자극 기법\",\"감각운동 기법\",\"조음점 지시법\",\"주기적 접근법\",\"변별자질 접근법\"],\"answer\":4,\"explain\":\"주기법은 명료도가 매우 낮은 아동을 대상으로 오류 음운 패턴들을 주기(cycle)마다 순환하며 목표로 하는 음운적 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"주기적 접근법\",\"p\":\"낮은 명료도 대상과 패턴 순환 특징으로 접근법 식별\",\"n\":\"주기법: 여러 오류 음운패턴을 주기마다 순환하며 목표화\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"오류음을 청각·시각적 단서나 모방 조건에서 정확히 산출할 수 있는 정도로, 목표음 선정과 예후 판단에 활용되는 것은?\",\"choices\":[\"자극반응도\",\"말명료도\",\"말소리목록\",\"일관성\",\"음운인식\"],\"answer\":1,\"explain\":\"자극반응도(stimulability)는 단서나 모방 조건에서 오류음을 바르게 산출할 수 있는 정도로, 치료 목표음 선정과 예후 판단에 활용된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"자극반응도 개념\",\"p\":\"단서·모방 조건의 정조음 정도 개념으로 용어 식별\",\"n\":\"자극반응도: 단서·모방 시 오류음 정조음 정도, 목표음 선정·예후 판단 활용\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말명료도(speech intelligibility)에 대한 설명으로 가장 적절한 것은?\",\"choices\":[\"화자가 산출한 자음의 정확도만을 의미한다\",\"음도와 강도의 적절성을 의미한다\",\"발화의 문법적 정확성을 의미한다\",\"말속도의 적절성을 의미한다\",\"청자가 알아듣는 정도를 의미한다\"],\"answer\":5,\"explain\":\"말명료도는 화자가 전달한 말을 청자가 얼마나 알아듣는가의 정도로, 오류 말소리의 수·유형·일관성, 운율 등 여러 요인의 영향을 받는다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"말명료도 정의\",\"p\":\"청자 이해 기준 여부로 말명료도 정의 식별\",\"n\":\"말명료도: 청자가 화자의 말을 알아듣는 정도, 오류 수·유형·운율 영향\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"/ㅂ/와 /ㅁ/를 구별하는 변별자질은?\",\"choices\":[\"비음성\",\"지속성\",\"설정성\",\"긴장성\",\"고설성\"],\"answer\":1,\"explain\":\"/ㅂ/와 /ㅁ/는 모두 양순음이지만 /ㅁ/는 [+비음성], /ㅂ/는 [-비음성]으로 비음성 자질에서 대립한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"변별자질 대립\",\"p\":\"같은 조음 위치 자음쌍의 차이로 변별자질 식별\",\"n\":\"/ㅂ/와 /ㅁ/: 양순음 공통, 비음성 자질에서 대립\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 자음 중 일반적으로 가장 늦게 습득되는 말소리는?\",\"choices\":[\"/ㄷ/\",\"/ㅂ/\",\"/ㅁ/\",\"/ㅅ/\",\"/ㅇ/\"],\"answer\":4,\"explain\":\"비음·파열음은 조기에 습득되는 반면, 치경마찰음 /ㅅ, ㅆ/은 가장 늦게 완전 습득되는 말소리에 속한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"자음 습득 순서\",\"p\":\"조음방법별 습득 시기로 가장 늦은 자음 식별\",\"n\":\"치경마찰음 /ㅅ, ㅆ/: 가장 늦게 완전 습득, 비음·파열음은 조기 습득\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n라면 → [야면]\\n리본 → [이본]\\n나라 → [나야]\",\"q\":\"위 발화에서 공통적으로 나타난 음운변동은?\",\"choices\":[\"유음의 비음화\",\"파열음화\",\"종성 생략\",\"전방화\",\"유음의 단순화\"],\"answer\":5,\"explain\":\"유음 /ㄹ/이 활음 /j/ 또는 생략으로 나타나는 유음의 단순화(활음화)이다. 유음의 비음화라면 /ㄹ/이 /ㄴ/으로 대치된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"유음 단순화 식별\",\"p\":\"/ㄹ/의 활음 대치·생략 양상으로 음운변동 판단\",\"n\":\"유음의 단순화: /ㄹ/이 활음 /j/로 대치되거나 생략, 비음화와 구별\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n코 → [고]\\n토끼 → [도끼]\\n파 → [바]\",\"q\":\"위 발화에서 공통적으로 나타난 음운변동은?\",\"choices\":[\"탈기식음화\",\"전방화\",\"경음화\",\"연구개음화\",\"기식음화\"],\"answer\":1,\"explain\":\"격음(기식음) /ㅋ, ㅌ, ㅍ/이 평음 /ㄱ, ㄷ, ㅂ/으로 대치되는 탈기식음화(이완음화)이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"탈기식음화 식별\",\"p\":\"격음의 평음 대치 양상으로 음운변동 판단\",\"n\":\"탈기식음화: 격음 /ㅋ, ㅌ, ㅍ/이 평음 /ㄱ, ㄷ, ㅂ/으로 대치\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"아동이 산출한 5개의 낱말 중 3개를 목표 형태와 완전히 동일하게 산출하였다.\",\"q\":\"이 아동의 단어단위정확률(PWC)은?\",\"choices\":[\"0.4\",\"0.5\",\"0.6\",\"0.7\",\"0.8\"],\"answer\":3,\"explain\":\"단어단위정확률(PWC) = 완전히 정확하게 산출한 낱말 수 ÷ 전체 낱말 수 = 3 ÷ 5 = 0.6이다. 낱말 전체를 단위로 조음 능력을 평가하는 지표이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PWC 산출\",\"p\":\"정확 산출 낱말 수와 전체 낱말 수로 단어단위정확률 산출\",\"n\":\"PWC: 완전히 정확하게 산출한 낱말 수 ÷ 전체 낱말 수\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"거울·설압자 등을 이용하여 조음 위치와 방법을 직접 지시하고 시범을 통해 목표음을 유도하는 접근법은?\",\"choices\":[\"주기적 접근법\",\"최소대립쌍 치료\",\"조음점 지시법\",\"음운변동 접근법\",\"상위음운 접근법\"],\"answer\":3,\"explain\":\"조음점 지시법(전통적 접근법)은 조음 위치와 방법을 직접 알려주고 청각·시각·촉각 단서와 시범으로 목표음을 유도하는 운동 중심의 조음치료 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"조음점 지시법\",\"p\":\"조음 위치·방법 직접 지시 특징으로 치료 접근 식별\",\"n\":\"조음점 지시법: 위치·방법 지시와 다감각 단서·시범의 운동 중심 접근\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"(아동 발화를 전사한 자료)\\n목표 → 아동 발화\\n코끼리 → [토끼리]\\n가위 → [다위]\\n그네 → [드네]\\n나무 → [나무]\\n우산 → [우산]\",\"q\":\"위 발화에서 공통적으로 나타난 음운변동은?\",\"choices\":[\"연구개음의 전방화\",\"치경음의 후방화\",\"마찰음의 파열음화\",\"종성생략\",\"유음의 단순화\"],\"answer\":1,\"explain\":\"연구개음 /ㄱ, ㅋ, ㄲ/이 치경음 /ㄷ, ㅌ/으로 조음 위치가 앞으로 이동하여 대치되는 연구개음의 전방화이다(코끼리→[토끼리], 가위→[다위], 그네→[드네]).\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"연구개음 전방화 식별\",\"p\":\"연구개음의 치경음 대치 양상으로 음운변동 판단\",\"n\":\"연구개음 전방화: /ㄱ, ㅋ, ㄲ/이 /ㄷ, ㅌ/으로 앞쪽 위치 대치\"}},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"(아동 발화를 전사한 자료)\\n목표: 할머니랑 시장 가서 사탕 샀어요\\n아동: [하머니랑 시장 가서 사탕 다떠요]\",\"q\":\"위 발화에 대한 분석으로 옳은 것은?\",\"choices\":[\"자음정확도는 100%이다\",\"종성생략이 나타났다\",\"유음의 비음화가 나타났다\",\"모든 마찰음을 정확하게 조음하였다\",\"연구개음 전방화가 나타났다\"],\"answer\":2,\"explain\":\"'할머니→[하머니]'에서 종성 /ㄹ/이 생략되었다. 또한 '샀어요→[다떠요]'에서 마찰음 /ㅅ/이 파열음으로 대치되어 마찰음을 정확히 조음하지 못했고, 자음정확도는 100%가 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"문장 발화 오류 분석\",\"p\":\"문장 전사의 생략·대치 양상으로 옳은 분석 판단\",\"n\":\"종성생략: 할머니→[하머니]의 종성 /ㄹ/ 생략, 마찰음 파열음화 동반\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사 B는 자신이 훈련받거나 슈퍼비전을 받은 적이 없는 삼킴장애 환자를, 관련 교육 없이 인터넷 정보에만 의존하여 단독으로 중재하였다.\",\"q\":\"위 사례에서 위반된 언어재활사 윤리강령의 내용으로 가장 적절한 것은?\",\"choices\":[\"비밀유지의 의무\",\"차별금지의 의무\",\"연구 윤리의 준수\",\"전문성 유지의 의무\",\"동료 간 협력의 의무\"],\"answer\":4,\"explain\":\"언어재활사는 자신이 훈련받고 역량을 갖춘 전문 영역 내에서 서비스를 제공해야 한다. 준비되지 않은 영역을 교육·슈퍼비전 없이 단독으로 수행하는 것은 전문성 유지 의무 위반이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"윤리강령 위반 판단\",\"p\":\"훈련받지 않은 영역 단독 중재 사례로 위반 조항 식별\",\"n\":\"전문성 유지 의무: 훈련·역량을 갖춘 영역 내에서만 서비스 제공\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"만 7세 등록 장애아동의 보호자가 발달재활서비스 이용을 문의하였다. 가구 소득은 기준 중위소득 이내이다.\",\"q\":\"위 사례에 대한 안내로 옳은 것은?\",\"choices\":[\"본인부담금을 내고 바우처로 이용할 수 있다\",\"등록 장애아동은 이 서비스를 이용할 수 없다\",\"만 18세 이상만 이용할 수 있다\",\"소득과 무관하게 전액 무료로 지원된다\",\"의료기관 입원 치료만 지원한다\"],\"answer\":1,\"explain\":\"발달재활서비스는 만 18세 미만 등록 장애아동에게 소득 수준별 본인부담금과 함께 언어·청능 등 재활 바우처를 지원한다. 따라서 이 아동은 대상에 해당하며 바우처로 서비스를 이용할 수 있다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"법·제도\",\"k\":\"발달재활서비스 이용 안내\",\"p\":\"연령·장애 등록·소득 조건으로 서비스 이용 가능 여부 판단\",\"n\":\"발달재활서비스: 만 18세 미만 등록 장애아동, 소득별 본인부담금 바우처\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"연구 주제: \\\"태블릿 기반 AAC 앱 훈련이 뇌성마비 아동의 자발적 의사소통 시도 횟수에 미치는 효과\\\"\",\"q\":\"위 연구에서 '태블릿 기반 AAC 앱 훈련'에 해당하는 변인은?\",\"choices\":[\"혼란변인\",\"매개변인\",\"통제변인\",\"종속변인\",\"독립변인\"],\"answer\":5,\"explain\":\"독립변인은 연구자가 조작하여 그 효과를 알아보려는 처치이다. 이 연구에서 처치인 'AAC 앱 훈련'이 독립변인이고, 그 결과로 측정되는 '자발적 의사소통 시도 횟수'가 종속변인이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"연구 변인 구분\",\"p\":\"연구자가 조작하는 처치 여부로 변인 유형 식별\",\"n\":\"독립변인: 연구자가 조작하는 처치, 종속변인: 결과로 측정되는 변인\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"언어치료 효과에 관한 여러 개별 연구의 결과를 통계적으로 통합하여 전체 효과크기를 분석하는 연구 방법은?\",\"choices\":[\"횡단적 기술연구\",\"단일대상연구\",\"질적 사례연구\",\"델파이 조사\",\"메타분석\"],\"answer\":5,\"explain\":\"메타분석은 동일 주제의 개별 연구 결과들을 수집하여 통계적으로 통합·분석함으로써 전체적인 효과크기를 산출하는 연구 방법이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"메타분석 개념\",\"p\":\"개별 연구 결과의 통계적 통합 특징으로 연구 방법 식별\",\"n\":\"메타분석: 동일 주제 개별 연구를 통계적으로 통합해 효과크기 산출\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 회기 목표를 \\\"그림자극 10개 중 8개에서 목표 낱말의 어두 /ㅅ/를 3회기 연속 정조음한다.\\\"로 진술하였다.\",\"q\":\"위 행동목표 진술에 포함된 요소로 볼 수 없는 것은?\",\"choices\":[\"수행 조건(그림자극)\",\"관찰 가능한 목표 행동\",\"사용할 치료 기법\",\"도달 준거(10개 중 8개)\",\"숙달 기준(3회기 연속)\"],\"answer\":3,\"explain\":\"잘 진술된 행동목표는 수행 조건, 관찰 가능한 행동, 도달 준거와 숙달 기준을 포함한다. 그러나 '어떤 기법으로 가르칠지'(치료 기법)는 목표 진술 자체에 포함되는 요소가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"통합 사례\",\"k\":\"행동목표 진술 요소\",\"p\":\"조건·행동·준거 요소 구분으로 목표 진술에 없는 요소 식별\",\"n\":\"행동목표: 수행 조건·관찰 가능 행동·도달 준거·숙달 기준 포함, 기법 제외\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"「장애인복지법」상 1급 언어재활사 국가시험 응시자격으로 옳지 않은 것은?\",\"choices\":[\"2급 자격 없이 언어재활 경력이 5년 이상이면 응시할 수 있다\",\"2급 취득 후 관련 대학원에서 석사·박사학위를 받고 언어재활 경력이 1년 이상이면 응시할 수 있다\",\"2급 취득 후 관련 학과 학사학위 취득자로서 언어재활 경력이 3년 이상이면 응시할 수 있다\",\"응시자격에서 요구하는 경력은 언어재활 분야의 경력을 의미한다\",\"2급 언어재활사 자격 취득이 전제되어야 한다\"],\"answer\":1,\"explain\":\"1급은 2급 자격 취득을 전제로, 관련 대학원 석·박사학위+경력 1년 또는 관련 학과 학사학위+경력 3년의 요건을 갖춰야 한다. 2급 자격 없이 경력만으로는 응시할 수 없다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"법·제도\",\"k\":\"1급 응시자격\",\"p\":\"2급 전제와 학위·경력 요건으로 1급 응시자격 오류 식별\",\"n\":\"1급 응시: 2급 취득 전제, 석·박사+경력 1년 또는 학사+경력 3년\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"개인 언어재활센터에 정규직으로 채용된 언어재활사가 4대 사회보험 가입에 대해 문의하였다.\",\"q\":\"다음 중 보험료를 전액 사업주(사용자)가 부담하는 것은?\",\"choices\":[\"국민연금\",\"산업재해보상보험\",\"국민건강보험\",\"고용보험(실업급여)\",\"노인장기요양보험\"],\"answer\":2,\"explain\":\"산업재해보상보험료는 사업주가 전액 부담한다. 국민연금·국민건강보험·고용보험(실업급여)은 근로자와 사업주가 분담한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"법·제도\",\"k\":\"사회보험 부담 주체\",\"p\":\"보험별 보험료 분담 구조로 사업주 전액 부담 보험 식별\",\"n\":\"산재보험: 사업주 전액 부담, 국민연금·건강보험·고용보험은 노사 분담\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어발달지연 아동의 어머니가 평소 아동에게 빠른 속도로 길고 복잡한 문장을 사용하고, 아동이 반응하기 전에 다음 말을 이어간다.\",\"q\":\"위 어머니에게 제공할 상호작용 지도 내용으로 가장 적절한 것은?\",\"choices\":[\"말속도를 늦추고 짧은 문장으로 말해 주세요\",\"더 빠른 속도로 많은 어휘를 들려주세요\",\"낮고 단조로운 억양으로 말해 주세요\",\"아동이 말할 내용을 대신 말해 주세요\",\"아동의 발화를 자주 교정해 주세요\"],\"answer\":1,\"explain\":\"언어발달을 촉진하려면 느린 말속도, 짧고 단순한 문장, 풍부한 억양과 함께 아동이 반응할 시간을 충분히 기다려 주는 것이 중요하다. 빠르고 복잡한 발화나 대신 말하기, 잦은 교정은 바람직하지 않다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"상담\",\"k\":\"부모 상호작용 지도\",\"p\":\"어머니의 빠르고 복잡한 발화 양상에 맞는 지도 내용 선택\",\"n\":\"언어 촉진 상호작용: 느린 말속도·짧은 문장·풍부한 억양·반응 기다리기\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"초등학교 3학년 아동이 지능은 정상 범위이나 낱말을 소리 내어 읽을 때 매우 느리고 자주 틀린다. 반면 들려주는 이야기의 이해력은 또래 수준이다.\",\"q\":\"위 아동에게 우선적으로 고려할 수 있는 진단은?\",\"choices\":[\"경계선 지적장애\",\"고도 감각신경성 난청\",\"단순언어장애\",\"난독증(읽기장애)\",\"말소리장애\"],\"answer\":4,\"explain\":\"지능과 듣기 이해는 정상이나 낱말 해독(정확성·유창성)에서 두드러진 어려움을 보이는 것은 신경생물학적 원인의 난독증(읽기 특정학습장애)의 핵심 양상이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"통합 사례\",\"k\":\"난독증 감별\",\"p\":\"정상 지능·듣기 이해와 해독 곤란 조합으로 진단 판단\",\"n\":\"난독증: 지능·듣기 이해 정상, 낱말 해독의 정확성·유창성 저하\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"표준화 검사 적용이 어려운 무발화 영유아의 의사소통 능력을 평가하는 방법으로 가장 적절한 것은?\",\"choices\":[\"표준화 언어검사의 원점수만으로 언어 연령을 산출한다\",\"놀이 상황에서 비구어 의사소통을 관찰한다\",\"아동이 말을 시작할 때까지 평가를 미룬다\",\"보호자 정보는 주관적이므로 배제한다\",\"단일 회기의 검사 점수만으로 장애를 확정한다\"],\"answer\":2,\"explain\":\"무발화 영유아는 표준화 검사 적용이 제한되므로, 자연스러운 놀이·일상 맥락에서 발성의 양과 질, 몸짓, 공동주의, 모방 등 비구어 의사소통을 반복 관찰하고 보호자 면담으로 정보를 보완한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"통합 사례\",\"k\":\"무발화 영유아 평가\",\"p\":\"표준화 검사 적용 제한 조건에 맞는 평가 방법 선택\",\"n\":\"무발화 영유아 평가: 놀이 맥락 비구어 의사소통 반복 관찰·보호자 면담\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 SNS에 내담자의 실명과 평가 결과를 본인·보호자의 동의 없이 게시하였다.\",\"q\":\"위 사례에서 위반된 언어재활사 윤리강령의 내용은?\",\"choices\":[\"연구 윤리\",\"비밀유지의 의무\",\"전문성 유지의 의무\",\"동료 간 협력\",\"차별금지\"],\"answer\":2,\"explain\":\"내담자의 개인정보·평가결과를 동의 없이 외부에 공개하는 것은 윤리강령의 비밀유지(비밀보장) 의무 위반이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"비밀유지 의무 위반\",\"p\":\"동의 없는 개인정보 공개 사례로 위반 조항 식별\",\"n\":\"비밀유지 의무: 내담자 개인정보·평가 결과의 동의 없는 공개 금지\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"언어재활사의 보수교육에 대한 설명으로 옳은 것은?\",\"choices\":[\"1급 언어재활사에게만 부과된다\",\"최초 자격 취득 시 한 번만 받으면 된다\",\"이수 여부는 자격 유지와 무관하다\",\"대학원 재학생만 이수 대상이다\",\"자격 유지를 위해 매년 이수해야 한다\"],\"answer\":5,\"explain\":\"언어재활사는 자격 유지를 위해 매년 정해진 시간의 보수교육을 이수해야 하며, 정당한 사유 없이 연속하여 이수하지 않으면 제재 대상이 될 수 있다. 급수와 무관하게 자격을 가진 언어재활사에게 적용된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"보수교육 의무\",\"p\":\"이수 주기와 대상 범위로 보수교육 옳은 진술 식별\",\"n\":\"보수교육: 급수 무관 자격 유지를 위해 매년 이수, 미이수 시 제재\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"중재 효과 연구에서 독립변인 외에 종속변인에 영향을 줄 수 있는 변인들을 일정하게 통제하는 주된 이유는?\",\"choices\":[\"연구 대상자 수를 줄이기 위해\",\"종속변인의 측정을 생략하기 위해\",\"내적 타당도를 높이기 위해\",\"연구 결과의 일반화를 제한하기 위해\",\"독립변인을 무작위로 바꾸기 위해\"],\"answer\":3,\"explain\":\"외생변인(혼란변인)을 통제하면 종속변인의 변화가 독립변인(중재) 때문임을 더 확신할 수 있어 연구의 내적 타당도가 높아진다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"외생변인 통제 목적\",\"p\":\"외생변인 통제의 효과로 관련 타당도 개념 식별\",\"n\":\"외생변인 통제: 종속변인 변화를 독립변인에 귀속, 내적 타당도 향상\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"한 명 또는 소수의 대상에게 기초선-중재 등의 설계를 적용하여 중재 효과를 검증하는 연구 방법은?\",\"choices\":[\"상관연구\",\"집단비교연구\",\"단일대상연구\",\"델파이 조사\",\"메타분석\"],\"answer\":3,\"explain\":\"단일대상연구는 개별 대상에게 기초선-중재-반전(또는 중다기초선) 등의 설계를 적용하여 중재의 효과를 실험적으로 검증하는 방법으로, 언어재활 임상연구에서 널리 사용된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"단일대상연구 설계\",\"p\":\"소수 대상과 기초선-중재 설계 특징으로 연구 방법 식별\",\"n\":\"단일대상연구: 개별 대상에 기초선-중재-반전 등 설계로 효과 검증\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"검사도구가 측정하고자 하는 바를 정확하게 측정하는 정도를 의미하는 것은?\",\"choices\":[\"타당도\",\"실용도\",\"신뢰도\",\"객관도\",\"난이도\"],\"answer\":1,\"explain\":\"타당도는 검사가 측정하려는 개념을 실제로 측정하고 있는가의 정도이고, 신뢰도는 측정의 일관성·안정성을 의미한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"타당도·신뢰도 구분\",\"p\":\"측정 목적 부합 여부로 검사도구 특성 개념 식별\",\"n\":\"타당도: 측정하려는 것을 측정하는 정도, 신뢰도: 측정의 일관성\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"언어재활사의 업무로 가장 적절한 것은?\",\"choices\":[\"청력역치 측정과 의학적 진단\",\"후두의 수술적 처치\",\"의약품의 처방\",\"난청의 외과적 치료\",\"의사소통장애의 평가와 중재\"],\"answer\":5,\"explain\":\"언어재활사는 의사소통장애(언어·조음·유창성·음성·삼킴 등)의 평가와 중재, 대상자·보호자 상담 및 교육을 수행한다. 의학적 진단·처방·수술은 의사의 업무이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"언어재활사 업무 범위\",\"p\":\"의료 행위와의 구분으로 언어재활사 업무 식별\",\"n\":\"언어재활사 업무: 의사소통장애 평가·중재·상담, 진단·처방·수술 제외\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"아버지는 한국어, 어머니는 몽골어를 사용하는 가정의 4세 아동이 두 언어에 모두 노출되어 있다. 평가 결과 한국어 어휘 수가 또래보다 적었다.\",\"q\":\"위 아동의 어휘 능력 평가·해석으로 가장 적절한 것은?\",\"choices\":[\"두 언어에서 아는 개념을 합산하여 판단한다\",\"한국어 어휘 수만으로 어휘 지체를 판정한다\",\"두 언어 노출이 어휘 지체의 원인이라고 설명한다\",\"몽골어 사용을 즉시 중단하도록 권고한다\",\"이중언어 아동에게 단일언어 규준을 그대로 적용한다\"],\"answer\":1,\"explain\":\"이중언어 아동의 어휘를 한 언어의 낱말 수만으로 판단하면 과소평가되므로, 두 언어에 걸쳐 아는 개념을 합산한 개념 어휘(conceptual vocabulary)로 평가해야 한다. 이중언어 노출 자체는 언어장애의 원인이 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"다문화·이중언어\",\"k\":\"이중언어 아동 어휘 평가\",\"p\":\"두 언어 노출 아동의 어휘 평가·해석 방식 선택\",\"n\":\"개념 어휘: 두 언어의 아는 개념 합산, 이중언어 노출은 장애 원인 아님\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"연구 참여자에게 연구의 목적·절차·위험을 설명하고 자발적 참여 동의를 받는 절차는?\",\"choices\":[\"사후 결과 보고\",\"고지된 사전 동의\",\"사후 디브리핑\",\"무선 할당 배치\",\"이중 은폐법 적용\"],\"answer\":2,\"explain\":\"사전 동의(고지된 동의, informed consent)는 연구 참여 전에 목적·절차·이익·위험 등을 충분히 설명하고 자발적 동의를 받는 연구윤리의 기본 절차이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"연구 참여 사전 동의\",\"p\":\"연구 전 설명과 자발적 동의 절차 특징으로 용어 식별\",\"n\":\"고지된 사전 동의: 목적·절차·위험 설명 후 자발적 참여 동의 획득\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"첫 상담에서 언어재활사가 보호자에게 상담의 목적과 진행 방식을 설명하고, 아동의 발달력과 가정에서의 의사소통 모습에 대한 정보를 수집하며 신뢰 관계를 형성하였다.\",\"q\":\"위 상담에 해당하는 부모상담 단계는?\",\"choices\":[\"실행 단계\",\"종결 단계\",\"추후 단계\",\"초기 단계\",\"평가 단계\"],\"answer\":4,\"explain\":\"상담의 목적·절차 안내, 라포 형성, 기초 정보 수집은 상담의 초기(준비) 단계에서 이루어진다. 공감적 반응을 바탕으로 구체적 문제해결 방안을 제시·실행하는 것은 실행 단계이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"상담\",\"k\":\"부모상담 단계\",\"p\":\"목적 안내·라포 형성·정보 수집 활동으로 상담 단계 판단\",\"n\":\"상담 초기 단계: 목적·절차 안내, 라포 형성, 기초 정보 수집\"}},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"다문화가족·한부모가족 등의 자녀 중 언어발달이 지연된 아동에게 언어평가와 언어촉진 교육을 제공하는 지원사업이 있다.\",\"q\":\"위 사업에 대한 설명으로 옳은 것은?\",\"choices\":[\"등록 장애아동만을 대상으로 하는 의료 서비스이다\",\"언어를 평가하고 언어촉진 교육을 제공한다\",\"성인을 대상으로 하는 직업재활 사업이다\",\"자격 없이 누구나 중재를 제공할 수 있다\",\"평가 없이 모든 아동에게 동일한 프로그램을 제공한다\"],\"answer\":2,\"explain\":\"다문화가족 자녀 등을 위한 언어발달지원사업은 언어발달이 지연된 아동을 평가하고, 부모교육을 포함한 언어촉진 교육을 제공한다. 등록 장애아동을 주 대상으로 하는 발달재활서비스와는 대상·성격이 다르다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"다문화·이중언어\",\"k\":\"언어발달지원사업 특성\",\"p\":\"대상과 제공 내용으로 언어발달지원사업 특성 식별\",\"n\":\"언어발달지원사업: 다문화가족 자녀 등 대상 언어평가·언어촉진 교육\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"PK-WAB-R 하위검사 원점수\\n• 스스로 말하기: 14/20\\n• 알아듣기: 160/200\\n• 따라말하기: 80/100\\n• 이름대기: 70/100\",\"q\":\"이 환자의 실어증지수(AQ)로 옳은 것은? (AQ = [스스로말하기 + 알아듣기÷20 + 따라말하기÷10 + 이름대기÷10] × 2)\",\"choices\":[\"68.0\",\"72.0\",\"82.0\",\"74.0\",\"88.0\"],\"answer\":4,\"explain\":\"(14 + 160÷20[=8] + 80÷10[=8] + 70÷10[=7]) × 2 = (14+8+8+7)×2 = 74.0. ※AQ 산출식·중증도 절단점은 사용하는 교재 기준으로 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"PK-WAB-R AQ 산출\",\"p\":\"하위검사 원점수를 환산식에 대입해 실어증지수 산출\",\"n\":\"AQ: (스스로말하기+알아듣기÷20+따라말하기÷10+이름대기÷10)×2\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 발화는 유창하나 착어가 섞임\\n• 청각적 이해가 심하게 손상됨\\n• 따라말하기는 비교적 보존됨(88/100)\\n• 병식이 부족함\",\"q\":\"이 환자의 실어증 유형과 손상 추정 부위로 옳은 것은?\",\"choices\":[\"베르니케실어증 – 상측두회 후방\",\"명칭실어증 – 각회·측두엽 하부\",\"전도실어증 – 궁상다발·연상회\",\"연결피질감각실어증 – 후방 분수계\",\"혼합연결피질실어증 – 광범위 분수계\"],\"answer\":4,\"explain\":\"이해 손상+유창 착어는 베르니케와 유사하나 따라말하기가 보존되면 연결피질감각실어증(분수계 영역)으로 감별한다. 혼합연결피질은 따라말하기만 남고 이해·표현이 모두 심하게 손상되며 반향어를 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형·병변 감별\",\"p\":\"유창·이해 저하에 따라말하기 보존 조합으로 유형과 병변 판단\",\"n\":\"연결피질감각실어증: 유창·이해 저하·따라말하기 보존, 후방 분수계 병변\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"VFSS 소견\\n• 얇은 액체에서 삼킴 전 후두계곡으로 조기 흘러넘침, 삼킴반사 지연\\n• 후두 침습이 관찰되나 반사적 기침이 없음(무증상 침습)\\n• 점도를 높이면 침습이 소실됨\",\"q\":\"이 환자에게 가장 적절한 중재 조합은?\",\"choices\":[\"점도 증가 + 턱 당기기 + 삼킴반사 촉진\",\"얇은 액체 유지 + 성문상 삼킴 교육\",\"전면 금식 후 즉시 비위관 삽입 유지\",\"멘델슨 기법 + 혀 저항 운동 적용\",\"고개 젖히기 + 얇은 액체 여러 번 삼키기\"],\"answer\":1,\"explain\":\"조기 흘러넘침·반사 지연으로 인한 무증상 침습은 점도 증가로 흐름을 늦추고 chin-tuck으로 기도 입구를 보호하며 삼킴반사 촉진을 병행하는 것이 적절하다. 고개 젖히기는 흡인 위험을 높여 금기이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"삼킴장애\",\"k\":\"VFSS 소견별 중재 선택\",\"p\":\"조기 흘러넘침·무증상 침습 소견으로 삼킴 중재 조합 선택\",\"n\":\"조기 흘러넘침 침습: 점도 증가+턱 당기기+삼킴반사 촉진, 고개 젖히기 금기\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 소뇌 병변\\n• 자음·모음이 불규칙하게 붕괴됨\\n• 음절 강세가 불규칙하고 과도함\\n• 말속도가 느리고 음도·강도가 불규칙하게 변동함\",\"q\":\"이완형 마비말장애와 감별되는 이 유형(실조형)의 핵심 소견은?\",\"choices\":[\"과비성과 기식성 음성 동반\",\"쥐어짜는 듯한 노력성 음성\",\"단조로운 음도와 감소된 발성 강도\",\"불규칙적 조음 오류와 운율 붕괴\",\"말속도가 점점 빨라지고 뭉개짐\"],\"answer\":4,\"explain\":\"실조형(소뇌)은 불규칙한 조음 붕괴와 과도·불규칙한 강세가 특징이다. 이완형은 과비성·기식성(하부운동신경), 경직형은 쥐어짜는 노력성 음성, 과소운동형은 단조·약한 강도와 말속도 가속을 보인다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말운동장애\",\"k\":\"실조형 마비말장애 특징\",\"p\":\"소뇌 병변 말 특성으로 이완형과 구별되는 실조형 소견 식별\",\"n\":\"실조형: 불규칙 조음 붕괴·과도한 강세, 이완형은 과비성·기식성\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"낱말 읽기 검사\\n• 규칙어('바다','구름')는 정확히 읽음\\n• 불규칙어('굳이'→'구디')를 규칙화하여 잘못 읽음\\n• 비단어('무핀') 읽기는 양호함\",\"q\":\"이 환자의 실독증 유형과 손상된 읽기 경로는?\",\"choices\":[\"심층실독증 – 의미 경로\",\"표층실독증 – 어휘 경로\",\"음운실독증 – 음운 경로\",\"순수실독증 – 시각 입력\",\"무시실독증 – 주의\"],\"answer\":2,\"explain\":\"규칙어·비단어는 잘 읽으나 불규칙어에서 규칙화 오류가 나타나면 어휘(자소-의미) 경로가 손상되고 음운 경로에 의존하는 표층실독증이다. 심층실독증은 의미착어와 비단어 읽기의 심한 손상, 음운실독증은 비단어 읽기의 선택적 손상을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실독증·실서증\",\"k\":\"실독증 유형 감별\",\"p\":\"규칙어·비단어 보존과 불규칙어 규칙화 오류로 실독증 유형 판단\",\"n\":\"표층실독증: 어휘 경로 손상, 음운 경로 의존으로 불규칙어 규칙화\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 서서히 진행되는 언어 저하\\n• 발화는 유창하나 따라말하기와 낱말 인출이 손상됨\\n• 음소착어가 관찰되고 발화 중 낱말 찾기 지연이 잦음\\n• 낱말·대상 의미 지식과 문법은 상대적으로 보존됨\",\"q\":\"이 환자의 원발진행실어증(PPA) 유형은?\",\"choices\":[\"의미형 PPA\",\"로고페닉형 PPA\",\"비유창/실문법형 PPA\",\"혼합형 PPA\",\"PPA에 해당하지 않음\"],\"answer\":2,\"explain\":\"따라말하기·낱말인출 손상, 음소착어, 의미·문법의 상대적 보존은 로고페닉형 PPA이다. 의미형은 낱말 의미·대상지식 소실, 비유창/실문법형은 문법 붕괴와 말산출의 노력성이 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"PPA 하위유형 감별\",\"p\":\"낱말인출·따라말하기 손상과 의미·문법 보존으로 PPA 유형 판단\",\"n\":\"로고페닉형 PPA: 낱말인출·따라말하기 손상, 음소착어, 의미·문법 보존\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"브로카실어증 환자의 이름대기 중재로 의미자질분석(SFA)을 적용하려 한다.\",\"q\":\"SFA의 치료 기전으로 옳은 것은?\",\"choices\":[\"조음 운동을 반복 학습시켜 산출을 자동화한다\",\"억양과 리듬을 이용해 발화를 유도한다\",\"의미자질을 활성화하여 낱말 인출을 촉진한다\",\"제스처를 제한하고 구어 산출을 강제한다\",\"문법형태소 산출을 위계적으로 훈련한다\"],\"answer\":3,\"explain\":\"SFA는 목표 낱말의 범주·기능·특성 등 의미자질을 체계적으로 활성화해 어휘-의미망을 강화하고 낱말 인출을 촉진하는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"SFA 치료 기전\",\"p\":\"이름대기 중재 기법인 SFA의 작용 원리 식별\",\"n\":\"SFA: 범주·기능·특성 등 의미자질 활성화로 어휘-의미망 강화·인출 촉진\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"우반구 손상 환자\\n• 은유·농담의 함축을 파악하지 못함\\n• 말의 억양이 단조롭고 상대의 감정을 억양으로 읽지 못함\\n• 그림 왼쪽 세부를 자주 놓침\",\"q\":\"이 환자의 중재로 적절하지 않은 것은?\",\"choices\":[\"문법형태소 산출 반복 훈련\",\"함축·화용 추론 훈련\",\"운율 산출·해석 훈련\",\"좌측 훑어보기 훈련\",\"대화 상황에서의 화용 피드백\"],\"answer\":1,\"explain\":\"우반구 손상은 화용·운율·좌측 무시가 특징이므로 그에 맞는 중재가 필요하다. 문법형태소 산출 훈련은 좌반구 실문법증(브로카)에 해당하는 중재로 이 환자에게 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"인지의사소통장애\",\"k\":\"우반구 손상 중재 선택\",\"p\":\"화용·운율·좌측 무시 특성에 맞지 않는 중재 식별\",\"n\":\"우반구 손상: 화용·운율·좌측 무시 중재, 문법형태소 훈련은 브로카 대상\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 비유창성 실어증\\n• 스스로 말하기는 매우 제한적이나 익숙한 노래의 가락에 맞추면 몇몇 구를 산출함\",\"q\":\"이 환자에게 적용할 치료법과 그 근거로 옳은 것은?\",\"choices\":[\"의미자질분석 – 의미망 강화\",\"멜로디 억양 치료 – 우반구 활용\",\"제약유발 언어치료 – 구어 강제\",\"각본 훈련 – 자동구어 활용\",\"보완대체의사소통 – 구어 포기\"],\"answer\":2,\"explain\":\"멜로디 억양 치료(MIT)는 억양·리듬 처리에 관여하는 우반구 기능을 활용하여 비유창성 실어증 환자의 발화 산출을 촉진하는 기법으로, 노래 가락에서 발화가 촉진되는 이 사례에 적합하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"MIT 적용 근거\",\"p\":\"노래 가락에서 발화가 촉진되는 비유창 실어증에 치료법과 근거 선택\",\"n\":\"MIT: 억양·리듬 담당 우반구 기능 활용으로 비유창 실어증 발화 촉진\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"전도실어증 환자\\n• 유창한 발화, 양호한 청각적 이해\\n• 음소착어가 잦고 따라말하기가 선택적으로 손상됨\\n• 자신의 오류를 알아채고 반복 수정(접근 시도)함\",\"q\":\"이 환자의 중재로 가장 적절한 것은?\",\"choices\":[\"청각적 이해력 향상 훈련을 우선한다\",\"문법형태소 산출 훈련을 집중한다\",\"제스처만으로 의사소통하도록 유도한다\",\"음소 단서로 따라말하기를 반복 훈련한다\",\"완전 무발화로 보고 AAC를 즉시 도입한다\"],\"answer\":4,\"explain\":\"전도실어증은 이해가 양호하고 음소착어·따라말하기 손상이 핵심이므로, 따라말하기 과제와 음소 수준의 자기 수정(접근 시도)을 활용한 반복 훈련이 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"전도실어증 중재 선택\",\"p\":\"이해 양호·따라말하기 선택 손상 특성으로 중재 선택\",\"n\":\"전도실어증 중재: 음소 단서 활용 따라말하기 반복과 자기 수정 훈련\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"전반실어증 환자\\n• 발화·이해·따라말하기·이름대기가 모두 심하게 손상됨\\n• 몇몇 자동구어와 상황에 맞는 표정·제스처는 남아 있음\",\"q\":\"초기 단계에 우선적으로 고려할 중재로 가장 적절한 것은?\",\"choices\":[\"복잡한 통사 구조의 문장 이해 훈련\",\"비단어 따라말하기 훈련\",\"불규칙어 소리 내어 읽기 훈련\",\"빠른 이름대기 속도 훈련\",\"AAC와 의사소통 파트너 훈련\"],\"answer\":5,\"explain\":\"전반실어증 초기에는 잔존 능력(제스처·표정·자동구어)을 활용한 보완대체의사소통(AAC)과 보호자·파트너 훈련으로 기능적 의사소통을 확보하는 것이 우선이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"전반실어증 초기 중재\",\"p\":\"전 영역 중증 손상과 잔존 제스처·표정으로 초기 우선 중재 선택\",\"n\":\"전반실어증 초기: 잔존 능력 활용 AAC와 의사소통 파트너 훈련 우선\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"명칭실어증 환자에게 이름대기 단서를 위계적으로 제공하려 한다.\",\"q\":\"단서(cueing hierarchy)를 강도가 약한 것부터 강한 것 순으로 옳게 배열한 것은?\",\"choices\":[\"초성 음소 단서 → 의미 단서 → 문장 완성 단서 → 따라말하기\",\"의미 단서 → 따라말하기 → 초성 음소 단서 → 문장 완성 단서\",\"따라말하기 → 초성 음소 단서 → 의미 단서 → 문장 완성 단서\",\"문장 완성 단서 → 따라말하기 → 의미 단서 → 초성 음소 단서\",\"의미 단서 → 초성 음소 단서 → 문장 완성 단서 → 따라말하기\"],\"answer\":5,\"explain\":\"단서는 약한(의미) 것에서 강한(따라말하기) 것으로 위계적으로 제공하는 것이 일반적이다. 의미 단서 → 음소(초성) 단서 → 문장 완성 → 따라말하기 순으로 갈수록 인출 지원 강도가 커진다. ※단서 위계 순서는 교재별 차이가 있어 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"이름대기 단서 위계\",\"p\":\"단서의 인출 지원 강도 기준으로 약한 것부터 제공 순서 판단\",\"n\":\"단서 위계: 의미→초성 음소→문장 완성→따라말하기 순으로 강도 증가\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 근력 저하 없이 말소리를 탐색하는 입술·혀의 모색행동\\n• 같은 낱말에서도 매번 다른 조음 오류\\n• 자동구어는 비교적 유창함\",\"q\":\"이 환자(말실행증)에게 적용할 치료 원리로 가장 적절한 것은?\",\"choices\":[\"운동학습 원리의 집중 조음 연습\",\"구강 근력 강화를 위한 저항 운동\",\"청각적 이해력 향상 훈련\",\"호흡 지구력 강화 반복 훈련\",\"과비성 감소를 위한 공명 훈련\"],\"answer\":1,\"explain\":\"말실행증은 근력 문제가 아니라 말운동 프로그래밍의 손상이므로, 운동학습 원리(반복·점진적 난이도·피드백)를 적용해 조음점 전환을 집중적으로 반복 연습하는 것이 핵심이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"말실행증 치료 원리\",\"p\":\"근력 저하 없는 모색행동·비일관 오류로 치료 원리 선택\",\"n\":\"말실행증: 말운동 프로그래밍 손상, 운동학습 원리의 집중 반복 연습\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 양측 상부운동신경(추체로) 병변\\n• 느리고 노력성인 말, 쥐어짜는 듯한 거친 음성\\n• 과비성 동반, 말속도 저하\",\"q\":\"이 유형(경직형)의 마비말장애 환자에게 적절한 중재는?\",\"choices\":[\"말속도를 더 높여 자연스러움을 늘린다\",\"성대를 더 강하게 조이는 발성 훈련\",\"불수의 운동 억제 약물만 적용한다\",\"비강 공명을 늘리는 비음 강화 훈련\",\"근긴장 완화와 말속도·강세 조절 중재\"],\"answer\":5,\"explain\":\"경직형은 근긴장 항진으로 노력성·쥐어짜는 음성을 보이므로, 과도한 근긴장을 완화하는 이완 중재와 말속도·강세 등 운율 조절 중재가 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"경직형 마비말장애 중재\",\"p\":\"양측 상부운동신경 병변의 노력성 음성 특성으로 중재 선택\",\"n\":\"경직형: 근긴장 항진, 근긴장 완화 중재와 말속도·강세 조절\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 하부운동신경/뇌신경 병변\\n• 과비성이 두드러지고 기식성 음성\\n• 압력 자음 산출이 약하고 콧길로 공기가 새어 나옴\",\"q\":\"이 환자(이완형 마비말장애, 구개인두 기능부전)에게 우선 고려할 중재는?\",\"choices\":[\"말속도 감소 훈련\",\"불수의 운동 억제\",\"구개거상장치 적용\",\"좌측 훑어보기 훈련\",\"억양·리듬 치료\"],\"answer\":3,\"explain\":\"이완형에서 과비성·비누출은 구개인두 폐쇄부전 때문이므로, 구개인두 폐쇄 강화 중재와 필요 시 구개거상장치(palatal lift) 적용이 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"이완형 과비성 중재\",\"p\":\"과비성·비누출의 구개인두 폐쇄부전 원인으로 우선 중재 선택\",\"n\":\"이완형 구개인두 기능부전: 폐쇄 강화 중재와 필요 시 구개거상장치\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 파킨슨병(기저핵 회로 퇴행)\\n• 단조로운 음도, 감소된 강도, 말속도 가속으로 음절이 뭉개짐\\n• 환자는 자신의 목소리가 작다는 것을 잘 인식하지 못함\",\"q\":\"이 환자에게 근거가 확립된 치료법과 표적으로 옳은 것은?\",\"choices\":[\"CILT – 구어 산출 강제\",\"MIT – 억양·리듬 활용\",\"LSVT LOUD – 강도 증대\",\"SFA – 의미자질 분석\",\"chin-tuck – 삼킴 자세\"],\"answer\":3,\"explain\":\"과소운동형(파킨슨) 마비말장애에는 발성 강도(loudness) 증대에 초점을 둔 LSVT LOUD의 근거가 확립되어 있다. 강도 감각의 재보정(calibration)을 통해 말명료도를 높인다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동장애\",\"k\":\"LSVT LOUD 적용\",\"p\":\"과소운동형 말 특성으로 근거 확립 치료법과 표적 선택\",\"n\":\"LSVT LOUD: 과소운동형 대상 발성 강도 증대, 강도 감각 재보정\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"삼킴장애 환자에게 다음 순서의 기법을 교육하였다.\\n① 음식을 입에 넣고 숨을 참는다 → ② 삼킨다 → ③ 삼킨 직후 기침을 한다 → ④ 다시 삼킨다\",\"q\":\"이 기법의 목적으로 옳은 것은?\",\"choices\":[\"상부식도괄약근의 개방 시간을 늘린다\",\"식도의 연동 운동을 빠르게 촉진한다\",\"혀 기저부의 후방 이동을 강화한다\",\"구강 준비 단계의 저작을 촉진한다\",\"삼킴 전·중 성대를 닫아 기도를 보호한다\"],\"answer\":5,\"explain\":\"성문상 삼킴(supraglottic swallow)은 삼킴 전·중 성대를 닫아 기도를 보호하고, 삼킴 후 기침으로 성문 위 잔여물을 배출하는 기법이다. 상부식도괄약근 개방 연장은 멘델슨 기법의 목적이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"삼킴장애\",\"k\":\"성문상 삼킴 목적\",\"p\":\"숨 참기·삼킴·기침 절차로 해당 삼킴 기법의 목적 식별\",\"n\":\"성문상 삼킴: 삼킴 전·중 성대 폐쇄로 기도 보호, 삼킴 후 기침으로 배출\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"삼킴 시 후두 거상이 불충분하고 상부식도괄약근(UES) 개방이 짧아 인두에 잔여물이 남는 환자.\",\"q\":\"가장 적절한 삼킴 기법은?\",\"choices\":[\"턱 당기기\",\"고개 돌리기\",\"성문상 삼킴\",\"멘델슨 기법\",\"고개 젖히기\"],\"answer\":4,\"explain\":\"멘델슨 기법(Mendelsohn maneuver)은 삼킴 시 후두 거상을 의도적으로 유지하여 상부식도괄약근 개방 시간을 늘리고 인두 잔여물을 줄인다. 턱 당기기(chin-tuck)는 기도 입구 보호, 고개 돌리기(head rotation)는 편측 인두 약화 시 건강한 쪽으로 식괴를 유도하는 자세이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"삼킴장애\",\"k\":\"멘델슨 기법 선택\",\"p\":\"후두 거상 부족·UES 개방 단축 소견으로 삼킴 기법 선택\",\"n\":\"멘델슨 기법: 후두 거상 유지로 UES 개방 연장, 인두 잔여물 감소\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"만성 실어증 환자에게 일상에서 구어 사용을 늘리기 위한 강도 높은 치료를 계획한다.\",\"q\":\"제약유발 언어치료(CILT)의 핵심 원리로 옳은 것은?\",\"choices\":[\"제스처·그림 등 비구어 수단을 적극 허용한다\",\"억양과 리듬을 이용해 발화를 유도한다\",\"비구어 수단을 제한하고 구어 산출을 강제한다\",\"목표 낱말의 의미자질을 분석하게 한다\",\"보호자가 환자 대신 말하도록 연습한다\"],\"answer\":3,\"explain\":\"CILT는 보상적 비구어 수단 사용을 제한하고, 강도 높은 구어 산출을 반복적으로 유도하여 학습된 미사용(learned nonuse)을 극복하는 원리를 따른다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"CILT 핵심 원리\",\"p\":\"만성 실어증 구어 사용 증대를 위한 CILT 원리 식별\",\"n\":\"CILT: 비구어 수단 제한·집중 구어 산출로 학습된 미사용 극복\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"경도~중등도 실어증 환자가 병원 접수·전화 등 특정 상황에서 필요한 발화를 자동화하고자 한다.\",\"q\":\"이 목표에 가장 적합한 중재는?\",\"choices\":[\"비단어 따라말하기 훈련\",\"각본(스크립트) 훈련\",\"불규칙어 읽기 훈련\",\"좌측 훑어보기 훈련\",\"구강 근력 강화 훈련\"],\"answer\":2,\"explain\":\"각본 훈련은 특정 상황에 필요한 대화를 반복 연습해 유창하고 자동화된 발화를 산출하도록 돕는 기능적 중재로, 상황 특이적 목표에 적합하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"각본 훈련 적용\",\"p\":\"상황 특이적 발화 자동화 목표에 맞는 중재 선택\",\"n\":\"각본 훈련: 특정 상황 대화 반복 연습으로 자동화된 발화 산출\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사자: \\\"이 그림(복잡한 장면)을 설명해 보세요.\\\"\\n환자A: 문법형태소를 생략한 전보식·비유창 발화\\n환자B: 유창하나 착어가 많고 상황과 무관한 공허한 발화\",\"q\":\"두 환자에 대한 감별과 중재로 옳은 것은?\",\"choices\":[\"A는 브로카·산출 중재, B는 베르니케·이해 중재\",\"A는 베르니케·이해 중재, B는 브로카·문법 중재\",\"A는 브로카·이해 중재, B는 베르니케·문법 중재\",\"A·B 모두 전도실어증으로 따라말하기 중재 우선\",\"A·B 모두 명칭실어증으로 이름대기 중재 우선\"],\"answer\":1,\"explain\":\"전보식·비유창(A)은 브로카로 발화 산출·문법 중재가, 유창하나 공허·착어(B)는 베르니케로 청각적 이해 중재가 우선된다. 진단을 서로 바꾸거나 진단에 맞지 않는 중재를 짝지은 선택지는 틀리다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"브로카·베르니케 감별 중재\",\"p\":\"전보식 발화와 공허한 유창 발화로 유형 감별 후 중재 선택\",\"n\":\"브로카는 산출·문법 중재, 베르니케는 청각적 이해 중재 우선\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"외상성 뇌손상(TBI) 환자\\n• 새로 들은 정보를 즉시 회상하지 못하고, 약속·일정을 자주 잊음\\n• 대화가 장황하고 주제에서 벗어남\",\"q\":\"이 환자의 인지-의사소통 중재로 가장 적절한 것은?\",\"choices\":[\"불규칙어 소리 내어 읽기 훈련\",\"과비성 감소를 위한 공명 훈련\",\"외부 기억 보조와 화용 훈련\",\"성문상 삼킴 기법 반복 훈련\",\"좌측 공간 훑어보기 훈련\"],\"answer\":3,\"explain\":\"TBI의 기억·집행기능·화용 저하에는 다이어리·알림 등 외부 기억 보조 전략 활용과 주제 유지를 포함한 화용 중재가 효과적이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"인지의사소통장애\",\"k\":\"TBI 인지-의사소통 중재\",\"p\":\"기억 저하와 장황·주제 이탈 양상으로 TBI 중재 선택\",\"n\":\"TBI 중재: 다이어리·알림 등 외부 기억 보조와 주제 유지 화용 훈련\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"초기 알츠하이머병 치매 환자. 최근 기억 저하가 있으나 절차기억은 비교적 보존됨.\",\"q\":\"이 환자의 이름대기·일상 기억 유지를 위한 중재로 가장 적절한 것은?\",\"choices\":[\"복잡한 통사 이해 훈련\",\"간격 회상 기법 적용\",\"비단어 따라말하기\",\"제약유발 언어치료\",\"구강 근력 강화 훈련\"],\"answer\":2,\"explain\":\"치매에서는 보존된 절차기억·점화를 활용한 간격 회상(spaced retrieval)과 환경 단서·일과표 등 환경 수정이 효과적이며, 무오류 학습 원리를 함께 적용한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"인지의사소통장애\",\"k\":\"치매 간격 회상 기법\",\"p\":\"절차기억 보존 특성으로 치매 기억·이름대기 중재 선택\",\"n\":\"간격 회상: 보존된 절차기억·점화 활용, 무오류 학습 원리 병행\"}},{\"grade\":1,\"set\":2,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"여러 실어증 환자를 대상으로 그룹치료를 운영하며, 실제 대화처럼 새 정보를 주고받는 능력을 기르고자 한다.\",\"q\":\"의사소통효과증진법(PACE)의 원리로 옳은 것은?\",\"choices\":[\"새 정보를 다양한 수단으로 주고받는다\",\"치료사가 정답을 먼저 알려 주고 시작한다\",\"환자가 구어만 사용하도록 제한한다\",\"문법형태소를 정확히 산출하게 한다\",\"그림 이름을 순서대로 따라 말하게 한다\"],\"answer\":1,\"explain\":\"PACE는 치료사와 환자가 순번을 교대하며 상대가 모르는 새 정보를 전달하고, 구어·제스처·그림 등 다양한 수단을 자유롭게 활용해 의사소통 효율을 높이는 화용 중심 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"실어증\",\"k\":\"PACE 원리\",\"p\":\"실제 대화형 정보 교환 목표에 맞는 PACE 운영 원리 식별\",\"n\":\"PACE: 순번 교대로 새 정보 전달, 구어·제스처·그림 등 수단 자유 선택\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌손상 환자\\n• 근긴장 저하, 안정 시 떨림 없음\\n• 보행이 불안정함\\n• 손가락-코 검사에서 목표를 지나치고 흔들림(측정이상)\",\"q\":\"손상 부위로 가장 적절한 것은?\",\"choices\":[\"시상\",\"소뇌\",\"해마\",\"기저핵\",\"측두엽\"],\"answer\":2,\"explain\":\"근긴장 저하·측정이상(dysmetria)·보행 실조·의도성 떨림은 소뇌 손상의 특징이다. 기저핵 손상은 안정 시 떨림·경직·운동완만을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"신경해부·뇌혈관\",\"k\":\"소뇌 손상 부위 추론\",\"p\":\"근긴장 저하·측정이상·보행 실조 소견으로 손상 부위 판단\",\"n\":\"소뇌 손상: 근긴장 저하·측정이상·보행 실조·의도성 떨림, 기저핵은 안정 시 떨림\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"혀를 내밀게 하니 혀끝이 왼쪽으로 치우치고, 왼쪽 혀의 위축이 관찰됨.\",\"q\":\"손상된 뇌신경으로 옳은 것은?\",\"choices\":[\"왼쪽 안면신경(7번)\",\"오른쪽 설하신경(12번)\",\"왼쪽 설하신경(12번)\",\"왼쪽 삼차신경(5번)\",\"오른쪽 미주신경(10번)\"],\"answer\":3,\"explain\":\"혀 운동은 설하신경(12번)이 지배하며, 손상 시 혀를 내밀면 손상된 쪽으로 편위되고 그쪽 혀가 위축된다. 왼쪽으로 편위+왼쪽 위축이면 왼쪽 설하신경 손상이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"신경해부·뇌혈관\",\"k\":\"설하신경 손상 측 판별\",\"p\":\"혀 내밀기 편위 방향과 위축 측으로 손상 뇌신경 식별\",\"n\":\"설하신경(12번) 손상: 혀가 손상된 쪽으로 편위되고 같은 쪽 혀 위축\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사 설명\\n• 실어증 유무와 유형을 확인함\\n• 스스로 말하기·알아듣기·따라말하기·이름대기를 평가함\\n• 실어증지수(AQ)를 산출함\",\"q\":\"해당하는 검사는?\",\"choices\":[\"한국판 간이정신상태검사(K-MMSE)\",\"한국판 몬트리올 인지평가(K-MoCA)\",\"실어증-신경언어장애 선별검사(STAND)\",\"파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R)\",\"한국 실어증 감별진단 검사(KTDDA)\"],\"answer\":4,\"explain\":\"AQ 산출과 4개 언어영역 평가로 실어증 유형을 진단하는 검사는 PK-WAB-R이다. STAND는 선별검사, K-MMSE·K-MoCA는 인지선별검사이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 검사도구 식별\",\"p\":\"4개 언어영역 평가와 AQ 산출 특징으로 해당 검사 식별\",\"n\":\"PK-WAB-R: 말하기·알아듣기·따라말하기·이름대기 평가, AQ로 유형 진단\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사자: (사과 그림) \\\"이름이 무엇입니까?\\\"\\n환자: \\\"그… 먹는 거… 빨갛고 둥근… 그거요.\\\"\",\"q\":\"이 환자가 보이는 이름대기 오류 유형은?\",\"choices\":[\"보속증\",\"음소착어\",\"에두르기\",\"신조착어\",\"의미착어\"],\"answer\":3,\"explain\":\"목표 낱말을 산출하지 못하고 그 특징이나 기능을 우회적으로 설명하는 것은 에두르기(circumlocution)이다. 의미착어는 관련 낱말로 대치('사과'→'포도'), 음소착어는 음소 대치('사과'→'다과')이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"이름대기 오류 유형\",\"p\":\"목표어 대신 특징·기능을 설명하는 반응으로 오류 유형 판단\",\"n\":\"에두르기: 목표 낱말 대신 특징·기능을 돌려 설명, 의미착어·음소착어와 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"낱말 읽기\\n• 실제 낱말을 의미적으로 관련된 낱말로 대치함('버스'→'기차')\\n• 비단어('무핀') 읽기가 거의 불가능함\\n• 추상어보다 구체어를 더 잘 읽음\",\"q\":\"이 실독증 유형은?\",\"choices\":[\"표층실독증\",\"음운실독증\",\"무시실독증\",\"순수실독증\",\"심층실독증\"],\"answer\":5,\"explain\":\"의미착어(의미 대치), 비단어 읽기의 심한 손상, 구체어>추상어의 심상성 효과는 심층실독증의 특징이다. 표층은 불규칙어 규칙화 오류, 음운실독증은 비단어의 선택적 손상을 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실독증·실서증\",\"k\":\"실독증 유형 감별\",\"p\":\"의미 대치·비단어 읽기 불가·구체어 우위로 실독증 유형 판단\",\"n\":\"심층실독증: 의미착어, 비단어 읽기 심한 손상, 구체어>추상어 심상성 효과\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 발화는 유창하나 착어가 섞임\\n• 청각적 이해가 심하게 손상됨\\n• 따라말하기도 손상됨\\n• 병식이 부족함\",\"q\":\"이 환자의 실어증 유형은?\",\"choices\":[\"브로카실어증\",\"연결피질감각실어증\",\"전도실어증\",\"베르니케실어증\",\"명칭실어증\"],\"answer\":4,\"explain\":\"유창한 착어 발화+이해 손상+따라말하기 손상+병식 부족은 베르니케실어증이다. 따라말하기가 보존되면 연결피질감각실어증으로 감별한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형 감별\",\"p\":\"유창·이해 손상·따라말하기 손상·병식 부족 조합으로 유형 판단\",\"n\":\"베르니케실어증: 유창한 착어 발화·이해 손상·따라말하기 손상·병식 부족\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 느리고 노력성인 비유창 발화\\n• 조사·어미 등 문법형태소를 생략하는 전보식 발화\\n• 따라말하기 손상, 단순 지시 이해는 비교적 양호\",\"q\":\"이 환자의 실어증 유형은?\",\"choices\":[\"명칭실어증\",\"베르니케실어증\",\"전도실어증\",\"전반실어증\",\"브로카실어증\"],\"answer\":5,\"explain\":\"비유창·노력성·전보식(실문법) 발화, 손상된 따라말하기, 비교적 양호한 이해는 브로카실어증의 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형 감별\",\"p\":\"비유창·전보식 발화와 비교적 양호한 이해로 실어증 유형 판단\",\"n\":\"브로카실어증: 노력성 비유창·실문법 발화, 따라말하기 손상, 이해 비교적 양호\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 유창한 발화에 음소착어가 잦음\\n• 청각적 이해는 양호함\\n• 따라말하기가 선택적으로 뚜렷하게 손상됨\",\"q\":\"이 환자의 실어증 유형과 관련 손상 구조로 옳은 것은?\",\"choices\":[\"베르니케실어증 – 상측두회\",\"전도실어증 – 궁상다발\",\"브로카실어증 – 하전두회\",\"명칭실어증 – 각회\",\"전반실어증 – 광범위\"],\"answer\":2,\"explain\":\"유창+이해 양호+따라말하기의 선택적 손상+음소착어는 전도실어증이며, 브로카·베르니케 영역을 잇는 궁상다발 손상과 관련된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형·병변 연결\",\"p\":\"따라말하기의 선택적 손상과 음소착어로 유형과 손상 구조 판단\",\"n\":\"전도실어증: 유창·이해 양호·따라말하기 선택적 손상, 궁상다발 손상\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌졸중에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"색전증은 다른 부위의 혈전 조각이 혈관을 막아 발생한다\",\"허혈성 뇌졸중의 가장 대표적인 원인은 혈관 파열이다\",\"혈전증은 혈관벽이 풍선처럼 약하게 부풀어 발생한다\",\"출혈성 뇌졸중은 허혈성 뇌졸중보다 발생 빈도가 높다\",\"지주막하출혈은 혈관이 서서히 좁아지며 막혀 발생한다\"],\"answer\":1,\"explain\":\"색전증은 다른 부위(심장 등)에서 형성된 색전이 이동해 혈관을 막아 갑작스럽게 발생한다. 허혈성이 출혈성보다 흔하며, 허혈성의 주 기전은 혈전·색전에 의한 혈관 폐색이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"신경해부·뇌혈관\",\"k\":\"뇌졸중 유형·기전\",\"p\":\"허혈성·출혈성 뇌졸중의 발생 기전과 빈도 구분으로 옳은 설명 식별\",\"n\":\"색전증: 다른 부위 색전이 이동해 혈관 폐색, 허혈성이 출혈성보다 흔함\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌경색 환자\\n• 시력·시야 검사 결과 이상 없음\\n• 실제 낱말과 무의미 낱말을 모두 소리 내어 읽지 못함\\n• 받아쓰기와 자발적 글쓰기도 함께 저하됨\",\"q\":\"손상 가능성이 가장 높은 동맥은?\",\"choices\":[\"전대뇌동맥\",\"후대뇌동맥\",\"척추기저동맥\",\"내경동맥 안분지\",\"중대뇌동맥\"],\"answer\":5,\"explain\":\"읽기와 쓰기가 함께 손상된 실서증 동반 실독증은 좌측 각회 손상으로 생기며, 각회는 중대뇌동맥 관류 영역이다. 쓰기가 보존되는 순수 실독증(실서증 없는 실독증)은 좌측 후두엽과 뇌량 팽대부 손상으로 생기고 후대뇌동맥과 관련된다. 두 유형은 쓰기 손상 여부로 구별한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"신경해부·뇌혈관\",\"k\":\"실독증 관련 동맥 추론\",\"p\":\"읽기·쓰기 동반 손상 양상으로 병변과 관류 동맥 판단\",\"n\":\"실서증 동반 실독증: 좌측 각회 손상, 중대뇌동맥 영역, 순수 실독증은 후대뇌동맥\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"실어증 환자의 PK-WAB-R 결과\\n• AQ 37점, 스스로 말하기 6/20(비유창)\\n• 알아듣기 양호, 따라말하기 비교적 보존\",\"q\":\"이 프로파일에 가장 부합하는 실어증 유형은?\",\"choices\":[\"연결피질운동실어증\",\"전도실어증\",\"베르니케실어증\",\"명칭실어증\",\"연결피질감각실어증\"],\"answer\":1,\"explain\":\"비유창하나 이해가 양호하고 따라말하기가 유창성에 비해 뚜렷하게 보존되면 연결피질운동실어증이다. 브로카는 따라말하기도 손상된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"PK-WAB-R 프로파일 해석\",\"p\":\"비유창·이해 양호·따라말하기 보존 프로파일로 실어증 유형 판단\",\"n\":\"연결피질운동실어증: 비유창·이해 양호·따라말하기 보존, 브로카와 따라말하기로 감별\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"마비말장애 유형에 대한 설명이다.\",\"q\":\"유형과 특징이 옳게 연결된 것은?\",\"choices\":[\"실조형 – 불규칙한 조음 오류와 과도·불규칙한 강세\",\"경직형 – 기식음과 가청 흡기음이 두드러짐\",\"이완형 – 쥐어짜는 듯한 노력성 음성이 두드러짐\",\"과소운동형 – 불수의적 과다 운동으로 인한 변동\",\"과다운동형 – 감소된 강도와 짧은 말 돌진이 두드러짐\"],\"answer\":1,\"explain\":\"실조형(소뇌)은 불규칙 조음·과도 강세가 특징이다. 이완형(하부운동신경)은 기식음·가청 흡기음·과비성, 경직형은 쥐어짜는 노력성 음성, 과소운동형은 단조로운 음도·감소된 강도·짧은 말 돌진, 과다운동형은 불수의 운동에 따른 변동을 보인다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말운동장애\",\"k\":\"마비말장애 유형별 특징\",\"p\":\"손상 부위별 마비말장애 말 특성 연결로 옳은 짝 식별\",\"n\":\"실조형: 불규칙 조음·과도 강세, 이완형 기식음, 경직형 노력성, 과소운동형 짧은 말 돌진\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 같은 낱말에서도 매번 다른 조음 오류를 보임\\n• 말소리를 찾는 듯한 입술·혀의 모색행동\\n• 근력 약화는 뚜렷하지 않음\",\"q\":\"이 환자의 말장애로 가장 적절한 것은?\",\"choices\":[\"이완형 마비말장애\",\"경직형 마비말장애\",\"말실행증(AOS)\",\"실조형 마비말장애\",\"과소운동형 마비말장애\"],\"answer\":3,\"explain\":\"비일관적 조음 오류와 모색행동, 뚜렷하지 않은 근력 약화는 말운동 프로그래밍의 손상인 말실행증의 특징이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"말실행증 식별\",\"p\":\"비일관적 오류·모색행동·근력 약화 없음으로 말장애 유형 판단\",\"n\":\"말실행증: 말운동 프로그래밍 손상, 비일관적 조음 오류와 모색행동, 근력 약화 없음\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"말실행증과 마비말장애를 감별하려 한다.\",\"q\":\"말실행증에 더 부합하는 특징은?\",\"choices\":[\"일관되고 예측 가능한 조음 오류\",\"근긴장 항진에 따른 느리고 힘든 말\",\"지속적인 과비성과 비강 누출\",\"비일관적 조음 오류와 모색행동\",\"호흡·발성 기능의 지속적 약화\"],\"answer\":4,\"explain\":\"말실행증은 비일관적 오류와 모색행동이 특징인 반면, 마비말장애는 근육 약화·마비에 따른 비교적 일관된 오류와 음성·공명 이상을 보인다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말운동장애\",\"k\":\"말실행증·마비말장애 감별\",\"p\":\"오류 일관성과 근력·음성 이상 유무로 말실행증 특징 식별\",\"n\":\"말실행증은 비일관적 오류·모색행동, 마비말장애는 일관된 오류와 음성·공명 이상\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"수정바륨삼킴검사 단계별 결과\\n• 구강 준비·구강 운반 단계: 정상\\n• 인두 단계: 삼킴반사 지연, 후두계곡·조롱박오목에 잔여물\\n• 식도 단계: 정상\",\"q\":\"문제가 있는 단계는?\",\"choices\":[\"구강 준비 단계\",\"구강 운반 단계\",\"정상 소견\",\"식도 단계\",\"인두 단계\"],\"answer\":5,\"explain\":\"삼킴반사 지연과 인두 잔여물은 인두 단계의 문제이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"삼킴장애\",\"k\":\"VFSS 소견 해석\",\"p\":\"삼킴반사 지연과 후두계곡·조롱박오목 잔여물로 문제 단계 판단\",\"n\":\"인두 단계 문제: 삼킴반사 지연, 후두계곡·조롱박오목 잔여물\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"삼킴장애 환자에게서 다음 소견이 관찰됨.\\n• 삼킨 뒤에도 기침·목소리 변화가 없으나 흉부 영상에서 흡인 소견이 확인됨\",\"q\":\"이 현상에 대한 설명으로 옳은 것은?\",\"choices\":[\"기침 반사가 유지된 정상적인 방어 반응이다\",\"기도 방어 반사 저하를 시사하는 무증상 흡인\",\"구강 준비 단계의 저작 문제로 인한 것이다\",\"식도 이완불능증에서 보이는 전형적 특징이다\",\"미각 저하로 인한 일시적인 삼킴 지연이다\"],\"answer\":2,\"explain\":\"기침 등 외현적 징후 없이 성문 아래로 이물이 넘어가는 것을 무증상 흡인(silent aspiration)이라 하며, 감각·기도 방어 반사 저하와 관련되어 위험이 크다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"삼킴장애\",\"k\":\"무증상 흡인 해석\",\"p\":\"기침 없이 영상에서 확인된 흡인 소견의 의미 판단\",\"n\":\"무증상 흡인: 외현 징후 없이 성문 아래로 흡인, 감각·기도 방어 반사 저하\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"정상 삼킴 생리의 단계에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"구강 준비 단계에서 삼킴반사가 유발된다\",\"인두 단계에서 연구개가 하강하여 비강이 열린다\",\"인두 단계에서 후두가 상승하고 성대가 닫힌다\",\"식도 단계는 주로 수의적으로 조절된다\",\"구강 운반 단계에서 상부식도괄약근이 열린다\"],\"answer\":3,\"explain\":\"인두 단계에서 후두 거상·성대 폐쇄·후두개 하강으로 기도가 보호되고 상부식도괄약근이 열려 음식이 식도로 이동한다. 연구개는 상승하여 비인두를 막는다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"삼킴장애\",\"k\":\"정상 삼킴 단계 생리\",\"p\":\"단계별 기도 보호 기전과 구조 움직임으로 옳은 설명 식별\",\"n\":\"인두 단계: 후두 거상·성대 폐쇄·후두개 하강, 연구개 상승, 상부식도괄약근 개방\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"DSM-5에서 알츠하이머병으로 인한 경도 신경인지장애를 진단하려 한다.\",\"q\":\"필수적인 조건으로 옳은 것은?\",\"choices\":[\"인지 저하로 일상활동의 독립성이 상실됨\",\"삼킴능력의 뚜렷한 저하가 동반됨\",\"경미한 인지 저하가 있으나 독립성 유지\",\"시각·청각 등 말초 지각능력의 저하\",\"편측 운동마비와 보행장애의 동반\"],\"answer\":3,\"explain\":\"경도 신경인지장애는 인지영역의 경미한 저하가 있으나 일상생활의 독립성은 유지된다. 독립성이 상실되면 주요(major) 신경인지장애로 진단한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"경도 신경인지장애 진단 기준\",\"p\":\"일상생활 독립성 유지 여부로 경도·주요 신경인지장애 구분 판단\",\"n\":\"경도 신경인지장애: 경미한 인지 저하와 독립성 유지, 독립성 상실 시 주요 신경인지장애\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"인지의사소통장애·치매 유형에 대한 설명이다.\",\"q\":\"옳게 연결된 것은?\",\"choices\":[\"알츠하이머 치매 – 발병 초기부터 비유창 발화가 두드러짐\",\"혈관성 치매 – 베타 아밀로이드 축적이 주된 원인\",\"원발진행실어증 – 뇌혈관 질환에 의한 급성 발병\",\"파킨슨병 치매 – 발병 초기부터 심한 실어증이 나타남\",\"전두측두엽 치매 – 초기부터 성격·행동 변화가 두드러짐\"],\"answer\":5,\"explain\":\"전두측두엽 치매는 초기부터 성격·행동 변화 또는 언어 변화가 두드러진다. 알츠하이머는 초기 기억·이름대기 저하(발화는 유창), 베타 아밀로이드는 알츠하이머, PPA는 서서히 진행되는 퇴행성 언어장애이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"인지의사소통장애\",\"k\":\"치매 유형별 특징\",\"p\":\"치매 유형별 원인과 초기 증상 연결로 옳은 짝 식별\",\"n\":\"전두측두엽 치매: 초기부터 성격·행동 변화, 알츠하이머는 초기 기억·이름대기 저하\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사자: \\\"방금 불러드린 숫자 5-2-8-1을 거꾸로 말해 보세요.\\\"\\n환자: 수행에 어려움을 보임\",\"q\":\"이 과제가 주로 평가하는 기억 유형은?\",\"choices\":[\"절차기억\",\"암묵기억\",\"작업기억\",\"서술적 장기기억\",\"점화\"],\"answer\":3,\"explain\":\"정보를 잠시 유지하면서 조작(역순 말하기)하는 능력은 작업기억이다. 절차·암묵기억은 기술·습관에 관한 비서술 기억이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"인지의사소통장애\",\"k\":\"숫자 거꾸로 따라하기 해석\",\"p\":\"정보 유지와 조작을 요구하는 과제 특성으로 평가 기억 유형 판단\",\"n\":\"작업기억: 정보를 잠시 유지하며 조작하는 능력, 숫자 역순 따라하기로 평가\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"기억 유형에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"절차기억은 사건·사실에 대한 의식적 기억이다\",\"서술기억은 자전거 타기 같은 기술에 대한 기억이다\",\"의미기억은 개인적 사건의 시공간 정보를 포함한다\",\"절차기억은 기술·습관에 대한 비서술 기억이다\",\"일화기억은 일반적인 사실과 지식에 대한 기억이다\"],\"answer\":4,\"explain\":\"절차기억은 반복 학습된 운동·기술 습관에 대한 비서술(암묵) 기억이다. 서술기억은 의미기억(일반 지식)과 일화기억(개인적 사건)으로 나뉜다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"인지의사소통장애\",\"k\":\"기억 유형 분류\",\"p\":\"서술·비서술 기억과 하위 유형의 정의 구분으로 옳은 설명 식별\",\"n\":\"절차기억: 기술·습관의 비서술 기억, 서술기억은 의미기억과 일화기억으로 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"우반구 손상 환자의 의사소통 특징이다.\",\"q\":\"가장 적절한 설명은?\",\"choices\":[\"문법형태소를 생략한 전보식 발화가 핵심이다\",\"따라말하기만 선택적으로 심하게 손상된다\",\"심한 청각적 이해 손상과 착어가 핵심이다\",\"은유 이해 어려움, 단조로운 운율, 좌측 무시\",\"비단어 읽기만 선택적으로 심하게 손상된다\"],\"answer\":4,\"explain\":\"우반구 손상은 화용·비유·함축 이해의 어려움, 운율(감정 억양) 저하, 좌측 무시가 특징이다. 나머지는 좌반구 실어증 유형의 특징이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"인지의사소통장애\",\"k\":\"우반구 손상 의사소통 특징\",\"p\":\"화용·운율·주의 문제와 좌반구 실어증 특징 구분으로 설명 선택\",\"n\":\"우반구 손상: 비유·함축 이해 어려움, 정서 운율 저하, 좌측 무시\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌 영상 기법에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"CT는 방사선을 쓰지 않아 반복 촬영이 안전하다\",\"fMRI는 과제 수행 시 혈류 변화로 뇌 활성을 반영한다\",\"fMRI는 뇌의 구조만 보여주고 기능은 반영하지 못한다\",\"구조적 MRI는 실시간 신경 활동의 전기 신호를 측정한다\",\"EEG는 뇌의 포도당 대사 소비량을 측정한다\"],\"answer\":2,\"explain\":\"fMRI는 과제 중 혈중 산소 수준(BOLD) 변화를 통해 뇌 기능 활성을 간접 측정한다. 구조적 MRI·CT는 구조 영상, EEG는 전기활동, PET는 대사를 측정한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"신경해부·뇌혈관\",\"k\":\"뇌 영상 기법 원리\",\"p\":\"영상 기법별 측정 대상(구조·혈류·전기·대사) 구분으로 옳은 설명 식별\",\"n\":\"fMRI: 과제 중 BOLD 혈류 변화로 기능 측정, EEG 전기활동, PET 대사\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌자기공명영상(B-MRI)에서 양측 선조체에 저음영을 보이는 환자의 말 특성\\n검사자: \\\"몇 시에 약을 드세요?\\\"\\n환자: \\\"나는 약을 12시에, 12시에 먹어야, 12시에 먹어야, 먹어야 해\\\"\",\"q\":\"이 환자가 보이는 증상은?\",\"choices\":[\"반향어증\",\"동어반복증\",\"실구어증\",\"감금증후군\",\"발성실행증\"],\"answer\":2,\"explain\":\"자신의 낱말·구를 반복하는 것은 동어반복증(palilalia)으로, 기저핵(선조체) 병변과 관련될 수 있다. 반향어는 상대의 말을 따라 반복하는 것이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말운동장애\",\"k\":\"동어반복증 식별\",\"p\":\"기저핵 병변과 자기 말의 반복 양상으로 증상 명칭 판단\",\"n\":\"동어반복증: 자신의 낱말·구를 반복, 기저핵 병변 관련, 반향어는 상대 말 반복\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"실어증 평가의 하위 영역에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"유창성은 청각적 이해 점수로만 판단한다\",\"이름대기 손상은 대부분의 실어증에서 관찰된다\",\"따라말하기 손상 정도는 모든 유형에서 동일하다\",\"알아듣기 검사는 발화의 문법성만 평가한다\",\"스스로 말하기는 읽기 능력으로 대체 평가한다\"],\"answer\":2,\"explain\":\"이름대기 손상은 유형과 무관하게 대부분의 실어증에서 흔히 관찰된다. 따라말하기 손상 여부는 유형 감별의 핵심 지표로 유형마다 다르다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 평가 하위 영역\",\"p\":\"하위 영역별 평가 의미와 유형 간 차이로 옳은 설명 식별\",\"n\":\"이름대기 손상은 대부분 실어증에서 관찰, 따라말하기는 유형 감별 핵심 지표\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"외상성 뇌손상(TBI) 환자의 인지-의사소통 특징이다.\",\"q\":\"가장 적절한 설명은?\",\"choices\":[\"주의·기억·집행기능 저하와 화용 문제가 두드러진다\",\"언어의 음운·문법 손상이 핵심이며 인지는 보존된다\",\"심한 청각적 이해 손상이 가장 핵심적인 특징이다\",\"편측 무시가 주된 의사소통 특징으로 나타난다\",\"전형적으로 비유창 실어증의 형태로 나타난다\"],\"answer\":1,\"explain\":\"TBI는 주의·기억·집행기능 등 인지 저하와 함께 화용(주제 유지, 장황함, 상황 파악)의 어려움이 두드러지는 인지-의사소통장애 양상을 보인다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"인지의사소통장애\",\"k\":\"TBI 인지-의사소통 특징\",\"p\":\"인지 저하와 화용 문제 중심 양상으로 TBI 특징 식별\",\"n\":\"외상성 뇌손상: 주의·기억·집행기능 저하와 주제 유지·장황함 등 화용 문제\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"낱말 읽기\\n• 실제 낱말('학교','사람') 읽기는 양호함\\n• 비단어('두랍','무핀') 읽기가 선택적으로 손상됨\",\"q\":\"이 실독증 유형과 손상된 경로는?\",\"choices\":[\"표층실독증 – 전체 단어 어휘 경로\",\"심층실독증 – 의미 처리 경로\",\"순수실독증 – 시각 단어형태 입력 경로\",\"음운실독증 – 자소-음소 변환 경로\",\"무시실독증 – 공간 주의 경로\"],\"answer\":4,\"explain\":\"실제 낱말은 잘 읽으나 비단어 읽기가 선택적으로 손상되면 자소-음소 변환(음운 경로) 손상인 음운실독증이다. 표층은 불규칙어 규칙화 오류가 핵심이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실독증·실서증\",\"k\":\"실독증 유형·손상 경로\",\"p\":\"실제 낱말 보존과 비단어 선택적 손상으로 유형과 경로 판단\",\"n\":\"음운실독증: 자소-음소 변환 경로 손상, 비단어 읽기 선택적 손상\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"대뇌 반구의 기능 편재화에 대한 설명이다.\",\"q\":\"일반적인 오른손잡이 성인에서 옳은 것은?\",\"choices\":[\"정서적 운율과 화용은 주로 우반구가 관여한다\",\"언어의 음운·통사 처리는 주로 우반구가 담당한다\",\"좌측 무시는 좌반구 손상에서 더 흔하다\",\"좌반구는 얼굴 정서 인식만을 전담한다\",\"우반구 손상은 전형적인 실문법증을 유발한다\"],\"answer\":1,\"explain\":\"대부분의 오른손잡이에서 언어의 음운·통사는 좌반구가 우세하고, 정서적 운율·화용·시공간 주의는 우반구가 관여한다. 좌측 무시는 우반구 손상에서 흔하다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"신경해부·뇌혈관\",\"k\":\"대뇌 반구 편재화\",\"p\":\"좌우 반구의 언어·운율·주의 기능 분담으로 옳은 설명 식별\",\"n\":\"오른손잡이: 음운·통사는 좌반구, 정서 운율·화용·시공간 주의는 우반구\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"초기 알츠하이머병 환자의 이름대기 저하를 다루는 치료 원리이다.\",\"q\":\"가장 적절한 것은?\",\"choices\":[\"무오류 학습과 간격 회상을 활용한다\",\"오류를 경험하게 하여 스스로 교정하게 한다\",\"복잡한 통사 이해 과제를 우선 훈련한다\",\"구강 근력 강화 훈련을 우선한다\",\"제약유발 언어치료로 구어를 강제한다\"],\"answer\":1,\"explain\":\"치매에서는 무오류 학습과 간격 회상, 환경 단서 등 보존된 절차·점화 기억을 활용하는 것이 효과적이며, 오류 경험을 최소화하는 것이 원칙이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"인지의사소통장애\",\"k\":\"치매 이름대기 중재 원리\",\"p\":\"보존된 기억 체계 활용 원리로 치매 이름대기 치료 방법 선택\",\"n\":\"치매 중재: 무오류 학습·간격 회상·환경 단서, 오류 경험 최소화\"}},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 발화·청각적 이해·따라말하기·이름대기가 모두 심하게 손상됨\\n• 몇몇 자동구어(인사말 등)와 상황에 맞는 표정·제스처만 남아 있음\",\"q\":\"이 환자의 실어증 유형은?\",\"choices\":[\"브로카실어증\",\"베르니케실어증\",\"전도실어증\",\"명칭실어증\",\"전반실어증\"],\"answer\":5,\"explain\":\"네 가지 언어 영역이 모두 심하게 손상되고 자동구어·비언어 수단만 남으면 전반실어증이다. 광범위한 좌반구(중대뇌동맥 영역) 손상과 관련된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"실어증\",\"k\":\"실어증 유형 감별\",\"p\":\"모든 언어 영역의 심한 손상과 자동구어 잔존으로 유형 판단\",\"n\":\"전반실어증: 4개 언어 영역 모두 심한 손상, 자동구어·비언어 수단만 잔존\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 2개월 남아, 기질적 결함 없음. 낱말검사·자발화 분석 결과\\n• /ㄱ, ㅋ/ → [ㄷ, ㅌ]: 모든 낱말 위치에서 대치, 자극반응도 있음\\n• 어두 /ㅅ/ → [ㄷ]: 자극반응도 없음\\n• 어중 /ㄹ/ 생략: 자극반응도 있음\\n• 부모 보고: 또래·교사가 말을 잘 알아듣지 못해 아동이 위축됨\",\"q\":\"발달 기준·오류 빈도·자극반응도를 고려하여 말명료도 향상을 최우선 목표로 할 때, 첫 목표음과 그 근거로 가장 적절한 것은?\",\"choices\":[\"/ㅅ/ – 가장 늦게 발달하는 음소라 먼저 훈련하면 다른 음소로 일반화된다\",\"/ㄹ/ – 생략 오류는 대치 오류보다 말명료도를 더 크게 떨어뜨린다\",\"/ㄱ/ – 연령상 습득되었어야 할 고빈도 음소이며 자극반응도가 있다\",\"세 음소를 같은 비중으로 동시에 훈련하여 전체 치료 기간을 단축한다\",\"비구어 구강운동 훈련으로 혀의 힘을 먼저 기른 뒤 목표음을 정한다\"],\"answer\":3,\"explain\":\"발달적(전통적) 목표 선정 원칙에서는 ①해당 연령에 이미 습득되어야 할 이른 발달음 ②사용 빈도가 높아 명료도에 영향이 큰 음 ③자극반응도가 있어 빠른 성공이 기대되는 음을 우선한다. /ㄱ/은 세 조건을 모두 충족한다. ①은 복잡성 접근의 논리이나 이 사례처럼 명료도 향상과 빠른 성공을 최우선할 때는 자극반응도가 없는 늦은 발달음을 첫 목표로 삼지 않는다. ②는 어중 /ㄹ/ 생략이 연구개음 전반의 대치보다 명료도 저하가 크다고 볼 근거가 없다. ⑤ 비구어 구강운동 훈련은 말소리 산출 개선의 근거가 부족하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"발달적 첫 목표음 선정\",\"p\":\"발달 시기·빈도·자극반응도로 명료도 우선 첫 목표음 선택\",\"n\":\"전통적 목표 선정: 연령상 습득 기대음·고빈도음·자극반응도 있는 음 우선\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 남아, 자음정확도 42%, 말명료도 매우 낮음. 음운변동 출현율\\n• 마찰음의 파열음화 90%\\n• 종성생략 78%\\n• 연구개음 전방화 65%\\n• 유음의 활음화 40%\\n• 어중초성 생략 15%\",\"q\":\"이 아동에게 주기법(cycles approach)을 적용할 때 목표 선정과 진행 원칙으로 옳은 것은?\",\"choices\":[\"최소대립쌍의 청각 변별만 반복 실시하고 산출 연습은 주기 후반으로 미룬다\",\"출현율이 가장 높은 파열음화를 90% 정확도에 도달할 때까지 훈련한 뒤 넘어간다\",\"어중초성 생략을 포함한 다섯 패턴 모두를 한 주기 안에 같은 시간으로 배분한다\",\"출현율 40% 이상인 패턴을 순환하되, 각 패턴은 숙달이 아닌 출현을 목표로 한다\",\"출현율이 가장 낮은 어중초성 생략부터 시작하여 점차 높은 패턴으로 이동한다\"],\"answer\":4,\"explain\":\"주기법은 명료도가 매우 낮은 아동을 대상으로 출현율 40% 이상의 음운패턴을 목표로 하며, 음절구조(종성)·초기 자음·연구개음·유음 등의 우선순위에 따라 패턴을 순환(cycle)한다. 정상 음운습득이 점진적으로 이루어지듯 각 패턴은 숙달이 아니라 출현을 목표로 하고, 다음 주기에서 다시 다룬다. ②는 숙달 기준 접근으로 주기법의 원리와 반대이며, ③ 15%인 어중초성 생략은 목표 기준 미달, ⑤는 우선순위와 반대이다. 주기법의 회기는 청각 자극(auditory bombardment)과 산출 연습을 모두 포함한다. ※출현율 절단 기준(40%)은 교재에 따라 표기가 다를 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"주기법 목표·진행 원칙\",\"p\":\"음운변동 출현율과 주기법 원리로 목표 패턴과 진행 방식 선택\",\"n\":\"주기법: 출현율 40% 이상 패턴 순환, 숙달이 아닌 출현 목표, 청각자극·산출 병행\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아의 자발화 표본에서 목표 자음 100개를 분석한 결과\\n• 정확 산출: 58개\\n• 대치: 24개\\n• 생략: 15개\\n• 왜곡: 3개\",\"q\":\"Shriberg와 Kwiatkowski의 원래 산출식에 따른 자음정확도(PCC)와 그에 따른 중증도로 옳은 것은?\",\"choices\":[\"58%, 경도-중등도\",\"58%, 경도\",\"58%, 중등도-심도\",\"42%, 심도\",\"61%, 중등도-심도\"],\"answer\":3,\"explain\":\"원래의 PCC는 대치·생략·왜곡을 모두 오류로 계산하므로 58/100 = 58%이다. Shriberg와 Kwiatkowski의 중증도 기준(85% 초과 경도, 65~85% 경도-중등도, 50~65% 중등도-심도, 50% 미만 심도)에 따르면 58%는 중등도-심도에 해당한다. ⑤ 61%는 왜곡을 정확으로 간주하는 수정 자음정확도(PCC-R)의 값이고, ④ 42%는 오류율이다. ※중증도 절단점은 교재별 표기가 다를 수 있어 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PCC 산출·중증도\",\"p\":\"대치·생략·왜곡을 모두 오류로 계산해 PCC와 중증도 산출\",\"n\":\"원래 PCC는 왜곡도 오류 처리, 50~65%는 중등도-심도, PCC-R은 왜곡을 정확 처리\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 8개월 남아\\n• 25개 낱말을 3회 반복 산출하는 비일관성 검사에서 15개 낱말(60%)이 매번 다른 형태로 산출됨\\n• 모색행동, 운율 이상, 모음 오류는 관찰되지 않음\\n• 구강 구조·기능 정상, 청력 정상\\n• 자극반응도 검사에서 대부분의 음소를 모방 산출할 수 있음\",\"q\":\"이 아동에게 가장 적절한 중재 접근은?\",\"choices\":[\"최소대립쌍 치료 – 음소 대조를 인식하도록 의미가 다른 낱말 쌍으로 훈련한다\",\"전통적 조음치료 – 음소별로 조음 위치를 지시하고 음절부터 반복 연습한다\",\"주기법 – 출현율이 높은 음운패턴을 순환하며 청각 자극과 산출을 훈련한다\",\"핵심어휘 접근 – 기능적 낱말을 최선 산출 형태로 일관되게 산출하도록 훈련한다\",\"DTTC(동적 시간·촉각 단서법) – 말운동 계획을 위해 집중 반복 연습을 한다\"],\"answer\":4,\"explain\":\"Dodd의 비일관성 검사에서 40% 이상의 낱말이 비일관적으로 산출되면 비일관적 음운장애로 분류되며, 이는 음운 계획(phonological planning)의 결함으로 본다. 여기에는 아동이 자주 쓰는 기능적 핵심어휘를 선정해 매 낱말의 최선 산출 형태를 일관되게 산출하도록 하는 핵심어휘 접근이 적합하다. 최소대립쌍·주기법은 일관된 오류패턴을 보이는 일관적 음운장애·음운지연에 적합하고, DTTC는 모색행동·운율 이상·모음 오류가 특징인 아동기 말실행증의 접근인데 이 아동은 해당 징후가 없고 자극반응도도 높다. ※비일관성 절단 기준(40%)은 교재 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"비일관적 음운장애 중재\",\"p\":\"비일관성 검사 결과와 CAS 징후 부재로 중재 접근 선택\",\"n\":\"비일관적 음운장애(음운 계획 결함)에는 기능 낱말 최선 형태를 일관되게 하는 핵심어휘 접근\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 4개월 남아\\n• 같은 낱말의 자음·모음 오류가 매번 달라짐, 모음 왜곡이 두드러짐\\n• 낱말·구가 길어질수록 오류가 급격히 증가함\\n• 산출 전 입술·혀를 움직이며 조음 위치를 더듬는 모색행동 관찰\\n• 음절 강세가 균등하여 단조롭고 운율이 부적절함\\n• 근력 저하·반사 이상 없음, 구강 구조 정상\\n• 자극반응도 낮고 모방 시에도 오류가 지속됨\",\"q\":\"이 아동의 진단과 그에 따른 중재 원리로 가장 적절한 조합은?\",\"choices\":[\"음운지연 – 주기법으로 발달적 음운패턴을 순환하며 훈련\",\"아동기 말실행증 – 운동학습 원리 기반 DTTC 등 말운동 접근\",\"마비말장애 – 구강 근력 강화 훈련을 우선하고 이후 조음 훈련\",\"조음장애 – 조음점 지시법으로 오류 음소를 하나씩 확립\",\"비일관적 음운장애 – 핵심어휘 접근으로 일관된 산출 유도\"],\"answer\":2,\"explain\":\"비일관적 오류, 모음 오류, 발화 길이에 따른 오류 증가, 모색행동, 부적절한 운율은 아동기 말실행증(CAS)의 핵심 징후이며 근력 이상이 없어 마비말장애와 구별된다. CAS는 말운동 계획·프로그래밍의 결함이므로 운동학습 원리를 적용한 DTTC(동적 시간·촉각 단서법) 등 집중적 산출 연습이 적합하다. 비일관적 음운장애도 비일관적이지만 모색행동·운율 이상·모음 오류가 없고 모방 시 산출이 가능하다는 점에서 구별된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동 말소리장애\",\"k\":\"아동기 말실행증 감별\",\"p\":\"모음 오류·모색행동·운율 이상 조합으로 진단과 중재 원리 판단\",\"n\":\"CAS: 비일관 오류·모음 오류·모색행동·운율 이상, 운동학습 원리 기반 DTTC 적용\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 6개월 여아, 인지·언어 정상. 오류음소와 자극반응도\\n• /ㅅ, ㅆ/ → [ㄷ, ㄸ] (자극반응도 없음)\\n• /ㄹ/ → 생략 또는 [ㅇ] (자극반응도 없음)\\n• /ㅈ, ㅊ/ → [ㄷ, ㅌ] (자극반응도 있음)\\n• /ㄱ/ → [ㄷ] (어두에서만, 자극반응도 있음)\",\"q\":\"복잡성 접근(complexity approach)의 원리에 따라 목표음을 선정할 때 가장 적절한 것은?\",\"choices\":[\"자극반응도가 있는 /ㄱ/부터 훈련하여 빠른 성공 경험을 제공한다\",\"가장 이른 시기에 발달하는 음소부터 먼저 훈련하여 성공 경험을 쌓는다\",\"모음 체계를 먼저 안정시키고 자음 목표는 그 이후에 다룬다\",\"오류 빈도가 가장 낮은 음소부터 훈련하여 오류 목록을 줄여 나간다\",\"늦게 발달하고 자극반응도가 없는 /ㅅ/ 또는 /ㄹ/을 먼저 훈련한다\"],\"answer\":5,\"explain\":\"Gierut 등의 복잡성 접근은 늦게 발달하고, 자극반응도가 없으며, 음운적으로 더 복잡한(유표적인) 음소를 먼저 목표로 하면 더 단순한 음소로 일반화가 일어나 체계 전반의 변화가 크다고 본다. 따라서 이 접근에서는 /ㅅ/, /ㄹ/이 우선 목표가 된다. ①②는 발달적(전통적) 목표 선정 원리로 복잡성 접근과 반대이며, ③④는 어느 접근에서도 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"복잡성 접근 목표음\",\"p\":\"복잡성 접근 원리에 따라 늦게 발달하고 자극반응도 없는 목표음 선택\",\"n\":\"복잡성 접근: 늦은 발달·자극반응도 없음·유표적 음소 우선, 단순 음소로 일반화 기대\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아의 어두 초성 오류\\n• /ㅅ/, /ㅆ/, /ㅈ/, /ㅊ/, /ㄱ/, /ㅋ/ → 모두 [ㄷ]로 대치\\n• 예: 살→[달], 잘→[달], 찰→[달], 갈→[달]\\n• 음소 대치로 인해 낱말 간 의미 구별이 되지 않아 동음이의 형태가 다수 발생\",\"q\":\"이 아동에게 가장 적절한 치료 접근과 자극 세트는?\",\"choices\":[\"다중대립 접근 – 대치음 [ㄷ]과 여러 목표음을 한 세트로 대조\",\"최소대립쌍 접근 – 한 번에 한 쌍(달-살)만 대조하여 순차적으로 훈련\",\"짝자극 기법 – 핵심낱말 '달'과 훈련낱말을 번갈아 짝지어 산출\",\"전통적 조음치료 – /ㅅ/의 조음점을 지시하여 무의미음절부터 확립\",\"상위음운 접근 – 소리의 길고 짧음 개념만 반복하여 가르친다\"],\"answer\":1,\"explain\":\"여러 목표 음소가 하나의 음소로 붕괴(phoneme collapse)되어 동음이의어가 다수 발생한 경우, 대치음과 붕괴된 여러 목표음을 한 세트로 대조하는 다중대립(multiple oppositions) 접근이 음운체계의 재구조화에 효율적이다. 최소대립쌍은 한 번에 한 대조만 다루므로 광범위한 붕괴에는 비효율적이며, 짝자극·전통적 접근은 개별 음소의 운동 확립에 초점을 두어 음운체계 문제를 직접 다루지 못한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"다중대립 접근 선택\",\"p\":\"여러 음소가 한 음으로 붕괴된 양상으로 치료 접근과 자극 세트 선택\",\"n\":\"음소 붕괴·동음이의어 다수 시 대치음과 여러 목표음을 한 세트로 대조하는 다중대립 접근\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아, 구개열로 1세에 구개성형술을 받음\\n• 최근 비인두내시경: 구개인두 폐쇄 양호\\n• 나조미터 구강문장 비음치 정상 범위\\n• 그러나 /ㅂ, ㄷ, ㄱ, ㅍ, ㅌ, ㅋ/를 성문파열음 [ʔ]으로 대치하는 오류가 일관되게 지속됨\\n• 마찰음은 인두마찰음으로 산출\",\"q\":\"이 아동의 오류 성격과 가장 적절한 중재는?\",\"choices\":[\"학습된 보상조음으로 보고 속삭임·/h/ 단서로 조음치료한다\",\"빨기·불기 등 비구어 구강운동으로 구강 내 압력을 높인다\",\"발달적 음운변동이므로 자연 소실을 기다리며 6개월 경과를 본다\",\"구개인두폐쇄부전이 남아 있으므로 재수술을 먼저 의뢰한다\",\"과비성 감소를 위해 청각 피드백으로 비음치를 낮추는 훈련을 한다\"],\"answer\":1,\"explain\":\"폐쇄 기능이 정상인데도 성문파열음·인두마찰음이 지속되는 것은 폐쇄부전 시기에 학습된 보상조음이 습관화된 것이므로 조음치료로 교정한다. 성문 폐쇄를 배제하기 위해 속삭임이나 /h/를 앞에 붙여 성문을 열어 둔 채 구강 조음점에서 산출을 유도하는 것이 핵심이다. 구개인두 기능이 정상이므로 재수술이나 과비성 훈련은 근거가 없고, 비구어 구강운동은 보상조음 교정에 효과가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"구개열 보상조음 중재\",\"p\":\"폐쇄 기능 정상인데 지속되는 성문파열음으로 오류 성격과 중재 선택\",\"n\":\"학습된 보상조음은 조음치료 대상, 속삭임·/h/ 단서로 성문 폐쇄 없이 구강 조음 유도\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 남아, 2세에 구개성형술을 받음\\n• 대화 전반에 걸쳐 일관된 과다비성과 압력자음에서의 비강누출\\n• 나조미터: 구강문장 비음치 38%(정상 기준 약 15% 이하), 비음문장 62%\\n• 보상조음은 관찰되지 않고 조음 위치는 정확함\\n• 자극반응도 검사에서 단서를 주어도 과다비성이 감소하지 않음\",\"q\":\"이 아동에 대한 가장 적절한 판단과 조치는?\",\"choices\":[\"불기·빨기 훈련으로 구개인두 폐쇄 근력을 먼저 강화한 뒤 재평가한다\",\"청각 피드백을 통한 비음치 낮추기 훈련을 6개월간 집중 실시한 뒤 재평가한다\",\"조음 위치가 정확하므로 조음치료로 과다비성을 직접 교정한다\",\"기구 평가로 구개인두폐쇄부전을 확인하고 수술적·보철적 관리를 의뢰한다\",\"구강문장 비음치가 정상 범위에 있으므로 6개월 경과를 관찰한다\"],\"answer\":4,\"explain\":\"구강문장 비음치가 정상 기준을 크게 초과하고 비강누출이 일관되며 단서에도 변화가 없는 것은 구조적 구개인두폐쇄부전(VPI)의 소견이다. 이 경우 기구적 평가(비인두내시경·비디오투시)로 폐쇄 양상을 확인한 뒤 인두피판술·보철(구개거상장치 등) 등 물리적 관리를 우선 의뢰해야 하며, 말치료는 구조 교정 후 잔존 오류를 다룬다. 불기·빨기는 구개인두 폐쇄 향상에 근거가 없고, 조음 위치가 정확한 아동에게 조음치료로 과다비성을 교정할 수는 없다. ※나조미터 정상 기준치는 검사 문장·교재별로 다를 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"구개인두폐쇄부전 판단\",\"p\":\"높은 비음치·비강누출·단서 무반응으로 구조적 VPI 판단\",\"n\":\"구조적 VPI는 기구 평가 후 수술·보철 관리 우선, 말치료는 구조 교정 후 잔존 오류 대상\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"8세 경직형 뇌성마비 남아\\n• 호흡 지지가 약해 한 번의 호흡으로 2~3음절만 산출, 강도가 작음\\n• 자음이 전반적으로 약하고 부정확(왜곡)하며 경도의 과비성\\n• 말속도가 느리고 낱말 명료도 50%\\n• 오류가 특정 음소에 국한되지 않고 모든 음소에 걸쳐 나타남\",\"q\":\"이 아동의 말명료도 향상을 위한 중재로 가장 적절한 것은?\",\"choices\":[\"오류 음소를 하나씩 선정하여 전통적 조음치료로 정확도를 높인다\",\"최소대립쌍 치료로 음운 대조를 확립하여 명료도를 높인다\",\"호흡 지지, 구 단위 끊어 말하기, 말속도 조절 등 보상 전략을 쓴다\",\"주기법으로 여러 음운패턴을 순환하며 출현을 목표로 훈련한다\",\"혀·입술의 비구어 근력강화 운동만 매 회기 집중적으로 반복 실시한다\"],\"answer\":3,\"explain\":\"뇌성마비의 마비말장애는 호흡·발성·공명·조음 하위체계의 신경운동 결함이 전반적으로 나타나므로, 특정 음소의 조음 정확도보다 호흡 지지, 구 단위 끊어 말하기, 과잉조음, 말속도 조절 등 명료도 중심의 보상 전략이 우선되고 필요 시 AAC를 병행한다. 음소별 전통적 접근·최소대립쌍·주기법은 기능적 조음음운장애에 적합하며, 비구어 근력강화만으로는 말명료도 개선 근거가 부족하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"말운동 말소리장애\",\"k\":\"뇌성마비 명료도 중재\",\"p\":\"전반적 하위체계 결함 양상으로 명료도 향상 보상 전략 선택\",\"n\":\"마비말장애 아동은 음소별 훈련보다 호흡 지지·구 단위 끊어 말하기·속도 조절 등 보상 전략\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 남아, 양측 고도 감각신경성 난청, 3세에 인공와우 이식(보청 상태 역치 30 dB HL)\\n• /ㅅ, ㅆ, ㅈ, ㅊ/ 생략·왜곡, 종성 생략\\n• 모음 길이 연장과 중성화, 단조로운 억양\\n• 파열음·비음은 비교적 정확\",\"q\":\"이 아동의 조음 특성과 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"구어 산출은 어려우므로 수어 중심 의사소통으로 전면 전환한다\",\"청각 단서는 배제하고 거울·촉각 등 시각·촉각 단서로 조음점을 지시한다\",\"비구어 구강운동으로 혀의 민첩성을 높인 뒤 말소리를 훈련한다\",\"마찰음은 정상 발달에서도 늦게 습득되므로 7세 이후로 목표를 보류한다\",\"보청 상태에서 청각 단서를 우선하고 시각·촉각 단서는 보조로 활용한다\"],\"answer\":5,\"explain\":\"청각장애 아동은 고주파수 에너지를 가진 마찰·파찰음, 청각적으로 약한 종성, 모음 연장·중성화, 억양 단조로움 등의 특성을 보인다. 인공와우로 보청된 상태에서는 청각 경로를 최대한 활용하는 것이 원칙이며, 시각·촉각 단서는 보조로 사용하고 청능훈련·초분절 요소 훈련을 통합한다. 청각 단서를 배제하거나 목표를 보류하는 것은 보청 효과를 활용하지 못하는 부적절한 계획이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"청각·청각장애\",\"k\":\"인공와우 아동 조음 중재\",\"p\":\"인공와우 보청 아동의 조음 특성으로 단서 활용 우선순위 선택\",\"n\":\"보청 상태 청각장애 아동은 청각 경로 최대 활용, 시각·촉각 단서는 보조로 사용\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"7세 여아\\n• 혀를 내밀면 혀끝이 하트 모양으로 패이고 치조에 닿지 않음\\n• /ㄹ/(탄설음)·/ㄷ, ㄴ/ 왜곡이 모든 문맥에서 일관됨, 자극반응도 없음\\n• 그 외 음소는 정상이고 음운변동은 관찰되지 않음\\n• 언어·청력·인지 정상\",\"q\":\"이 아동에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"음운체계의 문제이므로 최소대립쌍으로 음소 대조를 확립한다\",\"설소대 단축에 따른 조음 오류로, 평가 의뢰와 조음 훈련을 병행한다\",\"비일관적 음운장애로 보고 핵심어휘 접근을 우선 적용한다\",\"발달 과정에서 자연히 개선되므로 1년 후 재평가를 권고한다\",\"비구어 혀 스트레칭 운동만으로 설소대를 늘린 뒤 재평가한다\"],\"answer\":2,\"explain\":\"혀끝의 하트 모양 함몰과 치조 접촉 불가는 설소대 단축증의 소견이며, 혀끝 접촉이 필요한 /ㄹ, ㄷ, ㄴ/에 국한된 일관된 왜곡은 구조적 원인의 음성적(조음) 오류이다. 음운변동이 없으므로 음운적 접근은 부적절하고, 의학적 평가 의뢰와 함께 현재 구조에서 가능한 보상 조음 위치를 확립하는 조음치료를 계획한다. 7세에 이미 습득되어야 할 음소이므로 자연 개선을 기다리는 것도 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"설소대 단축 조음 오류\",\"p\":\"하트 모양 혀끝과 혀끝 음소 국한 왜곡으로 구조적 원인 판단\",\"n\":\"설소대 단축: 혀끝 접촉음(/ㄹ,ㄷ,ㄴ/) 일관된 왜곡, 의학적 평가 의뢰와 조음치료 병행\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 6개월 여아\\n• 연구개음 전방화(ㄱ→ㄷ)와 마찰음의 파열음화(ㅅ→ㄷ)가 일관되게 나타남\\n• 최소대립쌍 낱말('공-동')을 들려주면 그림 변별은 가능하나 자신의 산출이 다르다는 것을 인식하지 못함\\n• 소리의 속성(앞소리·뒷소리, 긴 소리·짧은 소리)을 이야기하는 활동에 흥미를 보임\",\"q\":\"이 아동에게 상위음운 접근(Metaphon)을 적용할 때의 절차로 옳은 것은?\",\"choices\":[\"1단계에서 목표음의 조음 위치를 설압자로 직접 지시하고 2단계에서 문장으로 확장한다\",\"1단계부터 최소대립쌍 낱말의 산출을 90% 정확도에 이를 때까지 반복 훈련한다\",\"1단계에서 소리 속성 개념을 익히고, 2단계에서 최소대립쌍을 의사소통에 쓴다\",\"1단계에서 핵심낱말과 훈련낱말을 번갈아 산출하며 자질 개념을 학습한다\",\"1단계에서 구강운동으로 혀 뒤쪽 근력을 기르고 2단계에서 연구개음을 확립한다\"],\"answer\":3,\"explain\":\"상위음운 접근은 음운장애 아동이 소리의 대조 속성을 인식하지 못한다는 전제에서 1단계(개념 수준→소리 수준→음소 수준→낱말 수준)에서 '앞소리/뒷소리', '긴 소리/짧은 소리' 등의 활동으로 상위음운 인식을 기르고, 2단계에서 최소대립쌍을 실제 의사소통 상황에서 사용하며 청자의 피드백으로 메시지 수정을 유도한다. 조음점 직접 지시(①)와 핵심낱말-훈련낱말(④, 짝자극)은 운동 중심 접근이며, ②는 1단계의 목적과 맞지 않고, ⑤ 구강운동 훈련은 상위음운 접근의 절차가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"상위음운 접근 절차\",\"p\":\"소리 속성 인식 부족 특성으로 Metaphon 단계별 절차 선택\",\"n\":\"Metaphon: 1단계 소리 속성 개념·상위음운 인식, 2단계 최소대립쌍의 의사소통적 사용\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 남아, 어두·어중 /ㅅ/를 목표로 8개월간 치료 중\\n• 낱말 수준 정확도 92%, 구조화된 문장 수준 85%\\n• 그러나 놀이 상황의 자발적 대화에서는 정확도 40%\\n• 가정에서도 대화 중 오류가 대부분이라는 부모 보고\\n• 아동은 자신의 오류를 스스로 알아채지 못함\",\"q\":\"이 단계에서 가장 적절한 중재 방향은?\",\"choices\":[\"무의미음절 수준으로 돌아가 /ㅅ/의 조음 운동을 다시 확립한다\",\"구강운동 훈련을 추가하여 혀끝의 안정성과 근력을 높인다\",\"낱말 수준에서 목표 정확도에 도달했으므로 치료를 종결한다\",\"/ㅅ/는 보류하고 발달상 더 이른 새 음소로 목표를 변경한다\",\"자기 모니터링 훈련과 함께 훈련 장면을 가정·학교로 확대한다\"],\"answer\":5,\"explain\":\"구조화된 상황에서는 정확하나 자발적 대화·가정으로 전이되지 않은 것은 상황·문맥 일반화(전이) 단계의 문제이다. 이 단계의 핵심은 자기 모니터링 능력을 길러 오류를 스스로 탐지·수정하게 하고, 훈련 장면을 다양한 상대·장소·활동으로 확대하며 부모·교사를 통해 일상에서 단서·강화를 제공하는 것이다. 이미 확립된 운동을 다시 훈련하거나 종결·목표 변경을 하는 것은 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"조음치료 전이 단계 중재\",\"p\":\"구조화 상황 정확·대화 전이 실패로 다음 중재 방향 선택\",\"n\":\"전이 단계 핵심: 자기 모니터링 훈련과 훈련 장면·상대의 가정·학교 확대\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아, 연구개음 전방화(ㄱ→ㄷ). 문맥검사 결과\\n• '구', '고' 문맥에서 간헐적으로 정조음\\n• '기', '게' 문맥에서는 항상 [ㄷ]로 대치\\n• 어두보다 모음 사이(어중) 위치에서 정조음 비율이 높음\",\"q\":\"확립 단계의 시작 문맥과 그 근거로 가장 적절한 것은?\",\"choices\":[\"오류가 가장 심한 '기' 문맥부터 시작하여 어려운 것을 먼저 극복한다\",\"'아구', '오고'처럼 후설모음이 결합된 어중 문맥에서 시작한다\",\"문맥 구분 없이 모든 모음 문맥을 무작위로 제시하여 일반화를 유도한다\",\"무의미음절 단계 없이 문장 수준에서 바로 시작하여 전이를 앞당긴다\",\"어두 '가'부터 시작한다 – 첫소리가 지각적으로 가장 두드러지기 때문이다\"],\"answer\":2,\"explain\":\"문맥검사의 목적은 촉진 문맥을 찾아 치료의 출발점으로 삼는 것이다. 후설모음 /ㅜ, ㅗ/는 혀 뒤쪽이 연구개 방향으로 올라가 있어 동시조음(coarticulation)에 의해 연구개 파열음 산출이 촉진되고, 전설모음 /ㅣ, ㅔ/는 혀가 앞으로 이동해 전방화를 오히려 유도한다. 또한 이 아동은 어중 위치에서 성공률이 높으므로 '아구, 오고'와 같은 후설모음·어중 문맥에서 시작해 점차 전설모음·어두 위치로 확장한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"촉진 문맥 선정\",\"p\":\"문맥검사 결과로 연구개음 확립의 시작 문맥 선택\",\"n\":\"후설모음은 동시조음으로 연구개음 산출 촉진, 성공률 높은 어중 문맥에서 시작\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아, 어두 /ㅈ/→[ㄷ] 대치. 낱말 조사 결과 '자'가 포함된 '모자'는 10회 중 10회 정조음하지만 '자동차', '잠', '주스' 등 대부분의 낱말에서는 오조음한다.\",\"q\":\"이 아동에게 짝자극 기법을 적용할 때 낱말 선정 기준과 절차로 옳은 것은?\",\"choices\":[\"핵심낱말 '모자'와 오조음하는 훈련낱말 10개를 번갈아 짝지어 산출한다\",\"핵심낱말은 아동이 가장 자주 오조음하는 낱말로 선정하여 집중 훈련한다\",\"훈련낱말은 10회 중 9회 이상 정조음하는 낱말로 선정해야 한다\",\"핵심낱말과 훈련낱말은 한 음소 차이로 의미가 달라지는 최소대립쌍이어야 한다\",\"핵심낱말과 훈련낱말은 서로 다른 목표음을 포함해야 일반화가 촉진된다\"],\"answer\":1,\"explain\":\"짝자극 기법은 아동이 이미 정조음하는 핵심낱말(목표음 10회 중 9회 이상 정확)을 이용하여, 같은 위치에 목표음이 있으나 오조음하는 훈련낱말(3회 중 2회 이상 오류)로 정확한 산출을 전이시키는 방법이다. 핵심낱말 하나에 훈련낱말 10개를 짝지어 번갈아 산출하고, 낱말→문장→대화로 확장한다. 핵심낱말과 훈련낱말은 같은 목표음을 같은 위치에 가져야 하며, 최소대립쌍과 같은 의미 대조는 요구되지 않는다. ※핵심낱말·훈련낱말 선정 기준 수치는 교재 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"짝자극 기법 절차\",\"p\":\"정조음 핵심낱말과 오조음 훈련낱말 조건으로 짝자극 절차 선택\",\"n\":\"짝자극: 정조음 핵심낱말 1개와 같은 목표음 위치의 오조음 훈련낱말 10개를 번갈아 산출\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아, /ㅅ/→[ㄷ], /ㅆ/→[ㄸ]의 파열음화가 일관됨. 조음 위치(치경)와 발성유형(평음·경음)은 정확하게 유지됨. 변별자질 접근으로 치료하려 한다.\",\"q\":\"이 아동이 확립하지 못한 자질만을 대조하는 최소대립쌍으로 가장 적절한 것은?\",\"choices\":[\"달 – 갈\",\"달 – 탈\",\"달 – 날\",\"달 – 살\",\"달 – 딸\"],\"answer\":4,\"explain\":\"파열음화는 [+지속성]인 마찰음이 [−지속성]인 파열음으로 대치되는 것으로, 결함 자질은 지속성이다. '달-살'은 /ㄷ/와 /ㅅ/가 조음 위치(치경)·발성유형(평음)이 같고 지속성만 다른 쌍이므로 목표 자질을 정확히 대조한다. '달-갈'은 조음 위치, '달-탈'은 기식성, '달-날'은 비음성, '달-딸'은 긴장성 대조로 이 아동이 이미 확립한 자질이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"변별자질 최소대립쌍 선정\",\"p\":\"파열음화의 결함 자질을 찾아 그 자질만 대조하는 낱말쌍 선택\",\"n\":\"마찰음의 파열음화 결함 자질은 지속성, 위치·발성유형이 같은 /ㄷ/-/ㅅ/ 쌍이 목표 대조\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"10세 남아\\n• /ㅅ, ㅆ, ㅈ, ㅊ/ 산출 시 혀 옆으로 공기가 새는 측음화 왜곡이 모든 문맥·과제에서 일관됨\\n• 다른 음소는 정상, 음운변동 없음, 음운인식·읽기 정상\\n• 청각 변별 과제에서 정조음과 왜곡음을 잘 구별함\\n• 구강 구조 정상, 자극반응도 낮음\",\"q\":\"이 아동에게 가장 적절한 접근과 절차는?\",\"choices\":[\"전통적 조음치료 – 촉각 단서로 조음 운동을 확립한 뒤 전이한다\",\"주기법 – 마찰음·파찰음 패턴을 다른 음운패턴과 순환하며 훈련한다\",\"핵심어휘 접근 – 기능적 낱말에서 최선 형태의 일관된 산출을 유도한다\",\"최소대립쌍 치료 – 의미 대조를 통해 음운체계를 재구조화한다\",\"상위음운 접근 – 소리 속성 개념을 먼저 가르쳐 음소 대조를 인식시킨다\"],\"answer\":1,\"explain\":\"음운변동이 없고 하나의 소리군에서 일관된 왜곡만 보이며 청각 변별은 정상인 경우 음운적 문제가 아니라 운동적(음성적) 조음장애이다. 왜곡은 음소 대조 자체는 유지되므로 최소대립쌍·상위음운·주기법 등 음운적 접근의 대상이 아니며, 조음점 지시와 촉각 단서로 올바른 조음 운동을 확립하고 위계적으로 안정·전이·유지 단계를 밟는 전통적 접근이 적합하다. 핵심어휘는 비일관적 산출에 적용된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"측음화 왜곡 치료 접근\",\"p\":\"음운변동 없는 일관된 왜곡과 정상 변별로 운동적 접근 선택\",\"n\":\"음소 대조가 유지되는 왜곡은 음성적 오류, 조음점 지시·촉각 단서의 전통적 접근 적합\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 여아, 어머니가 베트남어 화자이고 가정에서 두 언어를 사용함. 한국어 조음 평가 결과\\n• 경음 /ㄲ, ㄸ, ㅃ/ → 평음으로 대치, /ㅡ/ → [ㅜ]로 대치\\n• 종성 /ㄹ/ → [ㄴ]\\n• 베트남어 화자인 어머니와 통역사의 평가: 베트남어 말소리 산출은 또래 수준으로 정확\\n• 오류가 나타나는 소리는 모두 베트남어 음운체계에 없거나 다르게 실현되는 소리임\",\"q\":\"이 결과에 대한 가장 적절한 판단은?\",\"choices\":[\"두 언어 모두에서 치료가 필요한 조음음운장애로 판단한다\",\"모국어 음운체계의 영향으로 나타난 언어 차이로 판단한다\",\"비일관적 음운장애이므로 한국어 핵심어휘 접근을 적용한다\",\"한국어 조음 오류가 있으므로 베트남어 사용을 중단시켜야 한다\",\"아동기 말실행증이 의심되므로 말운동 평가를 추가 실시한다\"],\"answer\":2,\"explain\":\"이중언어 아동에서 장애(disorder)는 두 언어 모두에서 오류가 나타나고 모국어 음운체계로 설명되지 않는 경우에 판단한다. 이 아동은 모국어 산출이 정상이고 오류가 모두 모국어에 없는 소리(경음·/ㅡ/·종성 /ㄹ/)에 국한되므로 언어 차이로 보는 것이 타당하다. 차이를 장애로 진단하는 것은 과잉 진단이며, 모국어 사용 중단 권고는 근거가 없고 언어 발달에도 해롭다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"이중언어 아동 차이 판별\",\"p\":\"모국어 산출 정상과 모국어에 없는 소리 국한 오류로 차이 여부 판단\",\"n\":\"이중언어 아동 장애는 두 언어 모두 오류이고 모국어 음운체계로 설명 안 될 때 판단\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아의 말명료도 평가\\n• 어머니의 5점 척도 평정: 4점(대부분 알아들을 수 있음)\\n• 아동을 처음 본 청자 3명이 녹음된 낱말 50개를 받아쓴 낱말확인 과제: 평균 55% 정확\\n• 문장 수준에서 낯선 청자의 이해율은 낱말보다 다소 높음\",\"q\":\"이 결과의 해석과 임상적 활용으로 가장 적절한 것은?\",\"choices\":[\"명료도는 자음정확도와 동일하므로 별도로 측정할 필요가 없다\",\"어머니의 평정이 가장 신뢰할 만하므로 명료도는 양호하다고 결론짓는다\",\"두 결과를 평균한 약 70%를 아동의 대표 명료도 수치로 보고한다\",\"낱말확인 과제는 문맥이 없어 타당하지 않으므로 척도 평정만 사용한다\",\"낯선 청자의 낱말확인 결과를 명료도 기준 지표로 삼아 활용한다\"],\"answer\":5,\"explain\":\"말명료도는 청자 요인(친숙도), 자료 요인(낱말·문장, 문맥 유무), 측정 방법(척도 평정·낱말확인)에 따라 달라진다. 익숙한 청자와 척도 평정은 명료도를 과대평가하는 경향이 있어, 낯선 청자가 실제로 무엇을 알아들었는지를 객관적으로 보여 주는 낱말확인 과제가 기준 지표로 적합하다. 두 값을 평균하는 것은 방법이 다른 결과를 혼합하는 오류이며, 명료도는 자음정확도와 관련은 있으나 동일한 지표가 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"말명료도 측정 해석\",\"p\":\"청자 친숙도·측정 방법 차이로 명료도 기준 지표 선택\",\"n\":\"낯선 청자 낱말확인 과제가 객관적 명료도 기준, 친숙 청자·척도 평정은 과대평가 경향\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 3개월 남아, /ㄱ/ 전방화와 /ㅅ/ 파열음화를 보여 /ㄱ/을 목표로 12주 치료함. 치료 후 /ㄱ/ 정확도가 20%→85%로 향상되었고, 훈련하지 않은 /ㅅ/도 10%→30%로 향상되었다. 부모는 '아이가 크면서 저절로 좋아진 것 아니냐'고 묻는다.\",\"q\":\"치료 효과를 성숙 효과와 구분하여 입증하기 위한 자료 수집 방법으로 가장 적절한 것은?\",\"choices\":[\"치료 회기 내 목표음 /ㄱ/ 정확도만 매 회기 기록하여 비교한다\",\"안정된 기초선과 함께 훈련·통제 음소를 탐침으로 반복 측정한다\",\"치료 종료 후 표준화 조음검사만 한 번 실시하여 규준과 비교한다\",\"치료 전 기초선을 1회만 측정하고 사후 정확도와 비교한다\",\"부모의 만족도 설문과 가정 내 관찰 보고로 효과를 판단한다\"],\"answer\":2,\"explain\":\"단일대상 연구의 논리에 따라 안정된 다중 기초선과 훈련하지 않은 통제 행동(음소)의 탐침 자료를 병행 측정하면, 훈련 음소의 급격한 향상과 통제 음소의 완만한 변화를 비교해 성숙·자연 회복과 치료 효과를 구분할 수 있다. 회기 내 자료나 사후 검사 1회, 부모 설문만으로는 인과를 추정할 수 없다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"치료 효과 입증 자료\",\"p\":\"성숙 효과와 치료 효과를 구분할 수 있는 자료 수집 방법 선택\",\"n\":\"안정된 기초선과 훈련·통제 음소 탐침 반복 측정으로 치료 효과와 성숙 효과 구분\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 9개월 남아\\n• 초성은 대부분 정확하나 모든 종성을 일관되게 생략함(곰→[고], 손→[소], 발→[바])\\n• 종성이 생략되어 '손'과 '소', '곰'과 '고'가 동음이의어로 산출됨\\n• 종성을 모방하라고 하면 종성 자리에서 입을 벌린 채 소리를 끝냄\",\"q\":\"이 아동에게 가장 적절한 중재 계획은?\",\"choices\":[\"어두 초성 대조쌍(공-동)으로 조음 위치 대조를 먼저 훈련한다\",\"종성은 늦게 발달하므로 5세 이후로 종성 목표를 보류한다\",\"비구어 구강운동으로 턱 닫기 근력을 먼저 강화한 뒤 종성을 훈련한다\",\"종성 유무 최소대립쌍과 '곰이' 같은 재음절화 문맥을 활용한다\",\"종성 없는 낱말만 사용하여 초성 정확도를 먼저 더 높여 간다\"],\"answer\":4,\"explain\":\"종성생략은 음절구조 변동으로 낱말 형태 자체를 바꾸어 명료도에 큰 영향을 주므로 우선 목표가 된다. 종성 유무 최소대립쌍은 종성이 의미를 구별한다는 것을 인식시키며, 한국어 종성은 불파음으로 청각적으로 두드러지지 않으므로 시각·촉각 단서를 보강하고 '곰이'처럼 다음 음절 초성으로 연음되어 파열이 드러나는 문맥에서 시작해 어말 위치로 확장한다. 4세 9개월에 종성 전면 생략은 발달적으로 지연된 것이므로 보류는 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"종성생략 중재 계획\",\"p\":\"전면적 종성생략과 동음이의어 발생으로 종성 목표 중재 선택\",\"n\":\"종성생략은 명료도 영향 큰 우선 목표, 종성 유무 최소대립쌍과 연음 재음절화 문맥 활용\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 3개월 여아\\n• 낱말 수준 표준화 조음음운검사: 자음정확도 88%, 백분위 20(정상 범위)\\n• 부모·교사 보고: 대화에서 알아듣기 어려운 경우가 많음\\n• 대화 자발화 분석: 자음정확도 64%, 종성생략·어중초성 생략이 다수, 말속도 빠르고 발화 길이가 길어질수록 오류 증가\",\"q\":\"이 결과에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"표준화 검사가 정상 범위이므로 치료 대상이 아니라고 판정하고 종결한다\",\"부모·교사의 보고는 주관적이므로 판정 근거에서 제외한다\",\"자발화·명료도 자료로 치료 대상으로 판정하고 연결발화 목표를 세운다\",\"낱말 검사를 다른 표준화 도구로 다시 실시하여 정상 범위 여부를 재확인한다\",\"오류가 발화 길이에 따라 늘므로 음운인식 결함으로 보고 읽기 중재를 한다\"],\"answer\":3,\"explain\":\"표준화 낱말 검사는 단일 낱말의 정확도를 측정하므로 연결발화에서 나타나는 오류(동시조음, 빠른 속도, 발화 길이에 따른 붕괴)를 놓칠 수 있다. 임상 결정은 표준화 점수 하나가 아니라 자발화 분석, 명료도, 보호자·교사 보고 등 다각적 자료를 통합하여 내려야 하며, 이 아동은 연결발화 수준의 중재가 필요하다. 발화 길이에 따른 오류 증가는 음운인식이 아니라 말 산출 부담과 관련된다. ※정상 범위 절단점(백분위·표준편차 기준)은 검사 도구·교재별 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"평가·분석 지표\",\"k\":\"표준화·자발화 결과 통합\",\"p\":\"낱말검사 정상과 대화 PCC 저하 불일치로 치료 대상 여부 판단\",\"n\":\"낱말 검사는 연결발화 오류를 놓칠 수 있어 자발화·명료도·보고를 통합해 판정\"}},{\"grade\":1,\"set\":2,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 낱말 '사탕' /s a tʰ a ŋ/ 을 아동이 [타당]으로 산출하였다.\\n• PMLU 산출: 목표·아동 산출의 각 분절음(자음·모음)마다 1점, 정확히 산출한 자음마다 1점 추가\\n• PWP(단어단위근접률) = 아동 산출 PMLU ÷ 목표 PMLU\",\"q\":\"이 낱말에 대한 아동의 단어단위근접률(PWP)은?\",\"choices\":[\"0.75\",\"0.625\",\"0.80\",\"0.875\",\"1.0\"],\"answer\":1,\"explain\":\"목표 '사탕'의 PMLU = 분절음 5개(ㅅ, ㅏ, ㅌ, ㅏ, ㅇ) 5점 + 자음 3개 정확 3점 = 8. 아동의 [타당]은 분절음 5개로 5점이며, 자음 중 /ㅅ/→[ㅌ], /ㅌ/→[ㄷ]은 오류이고 종성 /ㅇ/만 정확하므로 1점을 더해 PMLU = 6. 따라서 PWP = 6 ÷ 8 = 0.75이다. ※PMLU 채점 규칙(모음 오류 처리 등)은 교재별 차이가 있어 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PWP(단어단위근접률) 산출\",\"p\":\"목표·산출 PMLU를 채점 규칙대로 계산해 PWP 산출\",\"n\":\"PWP는 아동 PMLU÷목표 PMLU, PMLU는 분절음 수에 정확 자음 수를 더한 값\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"파라다이스-유창성검사-II(P-FA-II) '말하기그림' 과제 분석\\n• 총 발화 음절 수: 300음절\\n• 정상적 비유창성(ND): 9회\\n• 비정상적 비유창성(AD): 12회\\n(ND 점수 = ND 횟수 ÷ 음절 수 × 100, AD 점수 = AD 횟수 ÷ 음절 수 × 100 × 1.5)\",\"q\":\"이 과제의 비유창성 총점(ND 점수 + AD 점수)은?\",\"choices\":[\"7\",\"10.5\",\"9\",\"12\",\"15\"],\"answer\":3,\"explain\":\"ND 점수 = 9 ÷ 300 × 100 = 3, AD 점수 = 12 ÷ 300 × 100 × 1.5 = 4 × 1.5 = 6이므로 총점은 3 + 6 = 9이다. 10.5는 ND에도 1.5 가중치를 잘못 적용한 값, 7은 AD에 가중치를 적용하지 않은 값이다. ※P-FA-II 점수 산출식·가중치는 검사 요강 기준으로 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"P-FA-II 비유창성 점수 산출\",\"p\":\"ND·AD 횟수와 음절 수에 가중치 적용해 비유창성 총점 산출\",\"n\":\"P-FA-II 총점: ND 점수+AD 점수, 1.5 가중치는 AD에만 적용\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 3세 6개월 남아, 어머니가 '말이 자꾸 걸린다'며 의뢰\\n• 놀이 상황 대화 표본(400음절) 분석\\n  - 100음절당 진성 비유창성(SLD): 5.2회\\n  - 전체 비유창성 중 SLD 비율: 72%\\n  - 반복 시 반복 단위 수 평균 2.3회\\n  - 음절 반복 시 긴장과 눈 감기 동반\",\"q\":\"위 결과의 해석과 그에 따른 임상적 결정으로 가장 적절한 것은?\",\"choices\":[\"말더듬으로 판정하고, 지속 위험요인을 평가해 치료 착수 여부를 결정한다\",\"SLD 5.2회는 학령전기 정상 범위이므로 6개월 후 재평가만 권고한다\",\"간투사와 구 반복이 적으므로 정상적 비유창성으로 보고 상담 후 종결한다\",\"반복 단위 수 평균이 3회 미만이므로 말더듬으로 볼 수 없어 관찰만 한다\",\"성인 %SS 기준 3%를 넘으므로 즉시 연장된 말 훈련을 시작한다\"],\"answer\":1,\"explain\":\"학령전기 말더듬 판별에서는 100음절당 SLD 3회 이상, 전체 비유창성 중 SLD 비율이 높음(약 2/3 이상), 반복 단위 수 증가, 긴장·부수행동 동반이 말더듬을 시사한다. 이 아동은 모든 지표가 기준을 넘으므로 말더듬으로 판정하되, 발병 경과·가족력·SLD 추이 등 지속 위험요인을 평가해 직접 치료 여부를 결정한다. 정상 범위(②), 반복 단위 3회 미만이면 정상(④)이라는 해석은 틀렸고, 연장된 말 훈련(⑤)은 3세 아동의 1차 선택이 아니다. ※SLD 절단점·비율 기준은 교재(Yairi & Ambrose 등)별로 차이 가능.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"학령전 말더듬 판별\",\"p\":\"SLD 빈도·비율·반복 단위 수·긴장 동반으로 말더듬 여부 판단\",\"n\":\"학령전 말더듬 지표: SLD 3회 이상/100음절, 높은 SLD 비율, 긴장 동반\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 2세 11개월 여아, 말더듬 시작 4개월 경과\\n• 외삼촌이 어린 시절 말을 더듬었으나 자연회복됨\\n• 3개월 간 SLD가 100음절당 8회 → 4회로 감소 추세\\n• 음운·언어발달 정상, 아동은 자신의 말을 의식하지 않음\\n• 부모는 아이가 더듬을 때 불안해하며 \\\"천천히\\\"라고 자주 지시함\",\"q\":\"이 아동에게 현재 가장 적절한 임상적 결정은?\",\"choices\":[\"리드콤 프로그램을 즉시 시작해 부모 수반자극을 훈련한다\",\"말더듬수정법으로 말더듬 순간 확인 훈련을 시작한다\",\"부모 상담과 간접 중재를 시행하며 정기적으로 재평가한다\",\"자연회복 가능성이 높으므로 추후 관리 없이 종결한다\",\"성인용 유창성완성 프로그램을 축약해 아동에게 적용한다\"],\"answer\":3,\"explain\":\"여아, 발병 후 12개월 미만, 자연회복 가족력, SLD 감소 추세, 언어발달 정상, 인식 없음은 모두 자연회복을 예측하는 요인이다. 따라서 직접 치료보다 부모의 부정적 반응(지시·불안)을 줄이는 상담과 간접 중재(상호작용·말속도 조정)를 제공하며 정기 재평가로 추이를 모니터링하는 것이 적절하다. 다만 추후 관리 없이 종결(④)하면 지속 여부를 확인할 수 없어 부적절하고, 리드콤(①)은 위험요인이 뚜렷하거나 관찰 후 호전이 없을 때 고려한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"자연회복 예측과 치료 결정\",\"p\":\"자연회복 예측 요인 조합으로 간접 중재와 재평가 선택\",\"n\":\"자연회복 예측: 여아·발병 12개월 미만·가족 회복력·SLD 감소·인식 없음\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 9세 남아, 5세경 말더듬 시작\\n• 긴장된 막힘과 연장, 막힘 중 발 구르기\\n• 발표·전화 상황을 피하고 어려운 낱말을 다른 낱말로 바꿈\\n• \\\"애들이 놀릴까 봐 말 안 해요\\\"라고 보고함\\n• 의사소통태도 검사에서 부정적 태도 뚜렷\",\"q\":\"이 아동의 말더듬 발달 수준과 그에 맞는 중재 접근으로 가장 적절한 것은?\",\"choices\":[\"경계선 말더듬 – 부모 상호작용 조정 중심의 간접 중재\",\"초기 말더듬 – 부모의 언어적 수반자극 중심 리드콤 프로그램\",\"진전된 말더듬 – 지연청각피드백 기기를 단독으로 사용하는 중재\",\"중간 말더듬 – 유창성 촉진과 말더듬 수정의 통합적 접근\",\"정상적 비유창성 – 추가 중재 없이 부모 교육 후 관찰\"],\"answer\":4,\"explain\":\"학령기에 긴장된 막힘, 탈출행동, 낱말·상황 회피, 두려움과 부정적 태도가 나타나는 것은 Guitar의 발달 수준 중 '중간 말더듬'에 해당한다. 이 단계에서는 유창한 말을 만드는 기법(느린 말·부드러운 시작)과 말더듬 순간을 편하게 수정하는 기법에 회피와 부정적 감정·태도를 줄이는 요소를 결합한 통합적 접근이 권장된다. 리드콤(②)은 학령전기가 주 대상이며, 기기 단독(③)으로는 회피·태도를 다룰 수 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"발달 단계·감별\",\"k\":\"중간 말더듬 단계와 중재\",\"p\":\"막힘·탈출행동·회피·부정적 태도로 발달 수준과 중재 접근 판단\",\"n\":\"중간 말더듬: 막힘·탈출·회피·두려움, 유창성 형성과 말더듬 수정 통합\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 5세 남아, 리드콤 프로그램 1단계 진행 중\\n• 최근 3주 연속 클리닉 내 %SS 0.6, 0.4, 0.5\\n• 부모의 일일 말더듬 심한 정도(SR) 평정: 매일 1~2점 유지\",\"q\":\"이 시점에서 치료사가 취할 조치로 가장 적절한 것은?\",\"choices\":[\"1단계를 6개월 더 유지하며 수반자극 빈도를 늘린다\",\"말더듬수정법으로 전환하여 취소 기법을 지도한다\",\"치료를 즉시 종결하고 추후 방문을 모두 없앤다\",\"언어적 수반자극과 부모 SR 기록을 모두 중단한다\",\"2단계(유지)로 진입하여 방문 간격을 점차 늘린다\"],\"answer\":5,\"explain\":\"리드콤 프로그램에서 3주 연속 클리닉 %SS 1.0 미만과 부모 SR 1~2 유지는 1단계 목표 달성 기준으로, 이때 2단계(유지 단계)로 진입해 방문 간격을 점차 늘리고(예: 2주→4주→8주…) 부모의 언어적 수반자극을 단계적으로 줄이며 재발 여부를 감시한다. 즉시 종결(③)이나 수반자극·기록의 일괄 중단(④)은 재발 감시 원리에 어긋난다. ※2단계 진입 기준 수치(%SS·SR 척도 범위)는 프로그램 지침 판본에 따라 차이 가능.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"리드콤 2단계 진입 기준\",\"p\":\"3주 연속 클리닉 %SS와 부모 SR 평정으로 단계 진행 판단\",\"n\":\"리드콤 2단계 진입: 3주 연속 %SS 1.0 미만·SR 1~2, 방문 간격 점진 확대\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"리드콤 프로그램 3주차 가정 실습 관찰\\n• 어머니가 아동이 더듬을 때마다 빠짐없이 \\\"울퉁불퉁했어, 다시\\\"라고 요구함\\n• 유창한 발화에 대한 칭찬은 거의 없음\\n• 아동이 말하기를 꺼리고 짜증을 내기 시작함\",\"q\":\"치료사가 어머니에게 제공할 지도로 가장 적절한 것은?\",\"choices\":[\"유창한 발화에 대한 칭찬의 비율을 수정 요구보다 훨씬 높게 한다\",\"말더듬에 대한 수정 요구를 더 강하게 하여 빠르게 효과를 얻도록 한다\",\"수반자극을 모두 중단하고 부모 말속도만 늦추게 한다\",\"아동이 짜증을 낼 때는 타임아웃을 적용해 지도한다\",\"수정 요구 대신 아동에게 말더듬 순간을 스스로 분석하게 한다\"],\"answer\":1,\"explain\":\"리드콤 프로그램의 언어적 수반자극은 유창한 발화에 대한 긍정적 반응이 중심이며, 말더듬에 대한 수정 요구는 간헐적으로만 제공하고 아동이 불편해하면 즉시 줄이거나 중단해야 한다(일반적으로 칭찬 대 수정요구 비율을 5:1 이상으로 권장). 수정 요구가 과도하면 아동이 말하기를 회피하는 부작용이 생긴다. 수반자극 전면 중단(③)은 프로그램 원리를 버리는 것이고, 자기분석(⑤)은 학령전기 아동에게 부적합하다. ※권장 비율 수치는 지침별 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"리드콤 수반자극 지도\",\"p\":\"수정 요구 과다와 아동 회피 반응으로 부모 지도 내용 선택\",\"n\":\"리드콤 수반자극: 유창 발화 칭찬 중심, 수정 요구는 간헐적으로만 제공\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 3세 9개월 여아, 말더듬 시작 8개월\\n• 가정 놀이 영상: 부모의 말속도가 매우 빠르고 질문이 연이어 이어지며, 아동이 말을 마치기 전에 부모가 끼어듦\\n• 부모 모두 아동의 말더듬에 대해 높은 불안과 죄책감을 보고함\\n• 치료사는 페일린 부모-아동 상호작용치료(Palin PCI)를 계획함\",\"q\":\"이 프로그램의 핵심 절차로 옳은 것은?\",\"choices\":[\"부모의 개입을 배제하고 치료사가 단독으로 아동을 주 2회 직접 치료한다\",\"부모가 유창한 발화마다 칭찬하고 말더듬에 수정을 요구하며 SR을 기록한다\",\"아동에게 연장된 말을 시범 보여 클리닉에서 유창한 말 패턴을 확립한다\",\"아동이 자신의 말더듬 순간을 확인하고 취소 기법으로 수정하게 한다\",\"부모가 놀이 영상을 보며 상호작용 전략을 스스로 찾아 특별시간에 실천한다\"],\"answer\":5,\"explain\":\"Palin PCI는 부모-아동 상호작용 영상 피드백을 통해 부모가 아동의 유창성에 도움이 되는 상호작용 전략(속도 늦추기·기다리기·질문 줄이기 등)을 스스로 발견·선택하게 하고, 매주 정해진 '특별시간'(짧은 놀이 시간)에 이를 적용하게 하며, 부모의 불안·죄책감 등을 다루는 가족 전략을 병행하는 간접 중재이다. ②는 리드콤 프로그램, ③은 유창성완성법, ④는 말더듬수정법의 절차이며, ①은 부모 참여를 핵심으로 하는 PCI와 정반대이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"Palin PCI 핵심 절차\",\"p\":\"부모 상호작용 양상과 불안·죄책감 보고로 PCI 절차 식별\",\"n\":\"Palin PCI: 영상 피드백으로 부모가 상호작용 전략 발견, 특별시간 실천\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 2개월 남아, 최근 이사와 동생 출생 이후 말더듬이 급격히 증가\\n• 어휘·구문은 또래보다 앞서 있으나 말운동 협응(조음 정확도·교대운동)은 다소 느림\\n• 부모는 아동에게 빠른 말로 많은 질문을 하고 즉각적인 대답을 요구함\",\"q\":\"요구-용량 모델(Demands and Capacities Model)에 근거한 중재 방향으로 가장 적절한 것은?\",\"choices\":[\"언어 용량을 키우기 위해 복잡한 문장 산출을 요구하는 언어치료를 강화한다\",\"아동에게 취소·빠져나오기 기법을 직접 가르쳐 용량을 높인다\",\"부모 말속도와 질문·시간 압박을 줄여 요구를 낮춘다\",\"말운동 용량이 회복될 때까지 아동의 발화 기회를 제한한다\",\"동생과의 상호작용을 당분간 차단하여 정서적 요구를 제거한다\"],\"answer\":3,\"explain\":\"요구-용량 모델은 아동의 말운동·언어·정서·인지 용량을 환경적·내적 요구가 초과할 때 비유창성이 나타난다고 본다. 이 아동은 언어 요구(앞선 언어, 빠른 질문)와 정서 요구(이사·동생)가 말운동 용량을 넘어선 상황이므로, 부모 말속도 늦추기·질문과 시간 압박 줄이기·예측 가능한 일과 만들기 등으로 요구를 낮추면서 아동의 말운동·정서 용량을 지지하는 것이 중재 방향이다. 언어 요구를 더 높이는 것(①)은 모델과 정반대이고, 발화 제한(④)이나 상호작용 차단(⑤)은 비현실적이며 해롭다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"요구-용량 모델 적용 중재\",\"p\":\"언어·정서 요구가 말운동 용량을 넘는 사례로 중재 방향 선택\",\"n\":\"요구-용량 모델: 요구가 용량 초과 시 비유창, 부모 말속도·시간 압박 감소\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인이 Van Riper 말더듬수정법의 '확인(identification)' 단계를 마쳤다. 대상자는 자신의 핵심행동·부수행동·회피 패턴을 정확히 기술할 수 있으나, 여전히 말더듬 순간에 강한 공포를 느끼고 청자의 시선을 피한다.\",\"q\":\"다음으로 진행할 단계와 그 활동으로 옳은 것은?\",\"choices\":[\"변형(variation) – 말더듬 순간 직후 취소 기법 적용\",\"접근(approximation) – 빠져나오기와 예비책 훈련\",\"둔감화(desensitization) – 의도적 말더듬과 얼어붙기\",\"안정화(stabilization) – 자기치료 계획 수립과 재발 대비\",\"동기(motivation) – 치료 필요성 인식과 구체적 목표 설정\"],\"answer\":3,\"explain\":\"MIDVAS 순서(동기→확인→둔감화→변형→접근→안정화)에서 확인 단계 다음은 둔감화이다. 둔감화에서는 의도적(가짜) 말더듬, 말더듬 순간 얼어붙기·유지하기, 청자 반응 직면 등을 통해 공포와 긴장을 줄여야 이후 변형·접근 단계의 수정 기법을 배울 수 있다. 취소·빠져나오기·예비책(①②)은 접근 단계의 기법이며, 안정화(④)는 마지막 단계이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"MIDVAS 단계 순서\",\"p\":\"확인 단계 완료 후 공포 잔존 상태로 다음 단계와 활동 선택\",\"n\":\"MIDVAS: 동기→확인→둔감화→변형→접근→안정화, 둔감화는 의도적 말더듬\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 25세 남성, 대화 표본 %SS 1.2로 겉으로는 거의 유창해 보임\\n• 어려운 낱말을 예측하면 항상 다른 낱말로 바꾸고, 전화·주문·자기소개를 철저히 피함\\n• 취업 면접에서 이름을 말하지 못한 경험 후 의뢰됨\\n• OASES 총 영향 점수 '심함', 말더듬 사실을 주변에 숨겨 옴\",\"q\":\"이 대상자의 우선 중재 목표와 기법으로 가장 적절한 것은?\",\"choices\":[\"%SS를 0에 가깝게 낮추기 위한 연장된 말 집중 훈련\",\"회피 감소 – 위계적 노출과 의도적 말더듬, 자기공개\",\"부모가 참여하는 언어적 수반자극 프로그램 적용\",\"취소 기법 반복 연습으로 핵심행동 지속시간 단축\",\"지연청각피드백 기기 착용으로 전체 말속도 저하\"],\"answer\":2,\"explain\":\"겉으로는 유창하나 낱말 대치·상황 회피로 말더듬을 숨기는 내재화(covert) 말더듬은 핵심행동 빈도보다 회피와 두려움이 핵심 문제이다. 따라서 회피하던 낱말·상황의 위계에 따른 점진적 노출, 의도적 말더듬, 말더듬 자기공개(advertising) 등으로 회피를 줄이고 둔감화하는 것이 우선 목표다. 이미 낮은 %SS를 더 낮추는 훈련(①④)이나 기기(⑤)는 문제의 본질(회피·태도)을 다루지 못하고 오히려 '더듬으면 안 된다'는 신념을 강화할 수 있다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"내재화 말더듬 중재 목표\",\"p\":\"낮은 %SS와 심한 회피·높은 영향 점수로 우선 중재 목표 선택\",\"n\":\"내재화 말더듬: 회피·두려움이 핵심, 위계적 노출·의도적 말더듬·자기공개\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"성인 말더듬 대상자의 읽기 표본\\n• 읽기 소요 시간: 2분 30초\\n• 산출한 총 음절 수(비유창 음절 포함): 375음절\\n• 말더듬이 나타난 음절 수: 15음절\",\"q\":\"이 표본의 전체 말속도(분당 음절 수, SPM)와 말더듬 음절 백분율(%SS)로 옳은 것은?\",\"choices\":[\"125 SPM, 4%\",\"150 SPM, 2.5%\",\"187.5 SPM, 4%\",\"150 SPM, 4%\",\"150 SPM, 6%\"],\"answer\":4,\"explain\":\"전체 말속도 = 375음절 ÷ 2.5분 = 150 SPM, %SS = 15 ÷ 375 × 100 = 4%이다. 125 SPM은 3분으로 나눈 오류, 187.5 SPM은 2분으로 나눈 오류이며, 2.5%와 6%는 %SS 산출 오류이다. ※전체 말속도(쉼·비유창 포함)와 조음속도(유창 구간만 측정)의 정의는 교재별로 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"말속도·%SS 산출\",\"p\":\"읽기 시간과 총·말더듬 음절 수로 SPM과 %SS 산출\",\"n\":\"SPM=총 음절 수÷분, %SS=말더듬 음절 수÷총 음절 수×100\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 31세 여성 말더듬 성인\\n• 모음으로 시작하는 낱말('아버지', '오늘')에서 성대를 강하게 부딪히는 긴장된 막힘이 빈번함\\n• /ㅂ, ㄷ, ㄱ/ 초성에서 입술·혀를 세게 붙인 채 압력이 쌓여 막힘\\n• 유창성완성법 접근을 선택함\",\"q\":\"이 대상자의 말더듬 양상에 가장 직접적으로 대응하는 기법 조합은?\",\"choices\":[\"취소 + 빠져나오기 + 예비책\",\"부드러운 시작 + 가벼운 조음 접촉\",\"차폐 소음 + 메트로놈 리듬 말하기\",\"의도적 말더듬 + 말더듬 자기공개\",\"호흡 근력 강화 + 큰 소리로 말하기\"],\"answer\":2,\"explain\":\"모음 초성에서의 강한 성대 접촉에는 발성을 기류와 함께 부드럽게 시작하는 부드러운 시작(easy onset)이, 파열음에서 조음기관을 세게 붙여 생기는 막힘에는 조음 접촉을 가볍게 하는 가벼운 조음 접촉(light articulatory contact)이 직접 대응한다. 취소·빠져나오기·예비책(①)과 의도적 말더듬·자기공개(④)는 말더듬수정법의 기법이며, 차폐·리듬(③)은 일시적 유창성 유도 조건이지 이 양상을 겨냥한 기법이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"유창성완성 기법 선택\",\"p\":\"모음 초성 성대 충돌과 파열음 조음 압력 막힘에 대응 기법 선택\",\"n\":\"부드러운 시작은 강한 성대 접촉, 가벼운 조음 접촉은 조음기관 막힘 대응\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 22세 남성 말더듬 성인\\n• 치료사가 연장된 말(prolonged speech) 시범 영상을 보여주고 대상자가 이를 모방하도록 함\\n• 대상자는 매 발화 후 말더듬 정도와 말의 자연스러움을 스스로 척도로 평정함\\n• 정해진 말속도 단계나 프로그램된 위계 없이 문제해결식으로 진행\",\"q\":\"이 프로그램에 해당하는 것은?\",\"choices\":[\"캠퍼다운 프로그램\",\"리드콤 프로그램\",\"GILCU 프로그램\",\"페일린 PCI 프로그램\",\"스토커 프로브 테크닉\"],\"answer\":1,\"explain\":\"캠퍼다운 프로그램(Camperdown Program)은 청소년·성인을 대상으로, 프로그램된 단계별 말속도 지시 없이 연장된 말 시범 영상을 모방하여 유창한 말을 배우고, 대상자가 말더듬 정도(SR)와 자연스러움을 스스로 평정하며 문제해결식으로 자연스러운 유창성을 확립·일반화하는 유창성완성 계열 프로그램이다. 리드콤(②)은 학령전기 부모 수반자극 프로그램, GILCU(③, 점진적 발화길이 및 복잡성 증가)는 발화 길이를 단계적으로 늘리는 프로그램된 조작적 접근이다. ※평정 척도 범위 등 세부 절차는 프로그램 판본 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"캠퍼다운 프로그램 식별\",\"p\":\"시범 영상 모방·자기 평정·비프로그램 진행 특징으로 프로그램 식별\",\"n\":\"캠퍼다운: 청소년·성인 대상 연장된 말 영상 모방, SR·자연스러움 자기 평정\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 38세 남성, 유창성완성법 집중치료 종료 시 %SS 0.8, 말의 자연스러움 양호\\n• 치료 종료 6개월 후 %SS 6.2로 상승, 전화를 다시 피하기 시작\\n• \\\"기법을 쓰면 말이 어색해서 점점 안 쓰게 됐다\\\"고 보고\",\"q\":\"이 상황에 대한 판단과 대처로 가장 적절한 것은?\",\"choices\":[\"치료 실패로 판단하고 프로그램을 처음부터 동일하게 반복한다\",\"일시적 변동이므로 별도 조치 없이 1년 뒤 재평가한다\",\"지연청각피드백 기기를 영구적으로 착용하게 한다\",\"말더듬수정법으로 전면 교체하고 유창성 기법 사용을 금지한다\",\"재발로 보고 추후 회기에서 기법을 재확립하며 유지 전략을 보강한다\"],\"answer\":5,\"explain\":\"유창성완성법 이후 재발은 흔하며, 기법 사용 시 어색함·자기관리 부족·회피와 부정적 태도의 잔존이 주요 원인이다. 따라서 추후 회기로 기법을 재확립하되 자연스러움 훈련, 자기 모니터링, 인지-정서적 요소, 자조모임 등 유지·재발방지 전략을 통합해야 한다. 동일 프로그램 반복(①)은 재발 원인을 다루지 못하고, 방치(②)나 전면 교체·금지(④)는 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"치료 후 재발 대처\",\"p\":\"종료 후 %SS 상승과 기법 미사용 보고로 재발 대처 방안 선택\",\"n\":\"재발 대처: 추후 회기로 기법 재확립, 자연스러움·자기 모니터링 등 유지 보강\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"아동 A(6세): 긴장된 막힘·연장, 막힘 시 눈 깜빡임, 특정 낱말 회피, \\\"말이 안 나와서 무서워요\\\"라고 보고, 말속도는 정상\\n아동 B(12세): 말속도가 빠르고 불규칙, 음절 축약('선생님'→'샘님')으로 명료도 저하, 이야기 순서가 뒤섞임, 본인은 문제를 잘 인식하지 못하나 집중해서 말하면 뚜렷이 개선됨\",\"q\":\"두 아동의 감별과 각각의 중재 방향으로 옳은 것은?\",\"choices\":[\"A 속화 – 말속도 조절 / B 말더듬 – 취소 기법\",\"A 말더듬 – 긴장 감소 / B 속화 – 말속도 조절 훈련\",\"A 말더듬 – DAF 단독 사용 / B 속화 – 둔감화 훈련\",\"A와 B 모두 속화 – 말속도 조절·자기 모니터링\",\"A와 B 모두 말더듬 – 둘 다 리드콤 프로그램\"],\"answer\":2,\"explain\":\"A는 긴장된 핵심행동, 부수행동, 회피, 두려움이 뚜렷한 말더듬으로 긴장 감소와 유창성 촉진, 두려움을 다루는 직접 중재가 필요하다. B는 빠르고 불규칙한 말속도, 음절 축약, 발화 조직화 문제, 낮은 자기 인식, 주의 집중 시 개선이라는 속화의 전형적 특징을 보이므로 말속도 조절·자기 모니터링·발화 조직화 훈련이 적절하다. 12세 속화 아동에게 리드콤(⑤)이나 둔감화(③)는 목표가 어긋난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"발달 단계·감별\",\"k\":\"말더듬·속화 감별과 중재\",\"p\":\"긴장·회피 양상과 빠른 말속도·낮은 인식으로 감별 후 중재 선택\",\"n\":\"속화: 빠르고 불규칙한 말속도·음절 축약·낮은 인식, 집중 시 개선\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 58세 남성, 좌측 기저핵 뇌경색 후 2개월째 비유창성 발생\\n• 조사·어미 등 기능어와 낱말 끝에서도 반복이 나타나며 문장 내 위치와 무관함\\n• 부수행동과 말에 대한 공포는 거의 없음\\n• 반복 읽기에서 적응효과 미미, 경도의 마비말장애 동반\",\"q\":\"이 대상자에게 가장 적절한 중재 계획은?\",\"choices\":[\"의도적 말더듬과 얼어붙기로 둔감화를 집중적으로 시행한다\",\"pacing 등 보상 전략을 마비말장애 중재와 통합한다\",\"부모 수반자극 방식의 조작적 프로그램을 적용한다\",\"심리치료를 우선 의뢰하고 말 치료는 당분간 보류한다\",\"회피 낱말 목록을 작성해 위계적 노출을 실시한다\"],\"answer\":2,\"explain\":\"뇌손상 후 발생하고 기능어·낱말 끝 등 위치와 무관하게 나타나며 적응효과와 공포가 적은 양상은 신경학적 말더듬이다. 심리적 요소가 작으므로 둔감화·회피 노출(①⑤)의 비중은 낮고, 말속도 감소·pacing·DAF 등 보상 전략, 원인 질환과 약물에 대한 의학적 협진, 동반 마비말장애 중재의 통합이 핵심이다. 심리치료 우선(④)은 심인성 말더듬에 해당하는 접근이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"발달 단계·감별\",\"k\":\"신경학적 말더듬 중재\",\"p\":\"뇌손상 후 발생·위치 무관 반복·적응효과 미미로 중재 계획 선택\",\"n\":\"신경학적 말더듬: 기능어·낱말 끝 반복, 적응효과·공포 적음, pacing 등 보상\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 42세 여성, 직장 내 심한 갈등 직후 갑자기 말더듬 시작(2주 전)\\n• 아동기 말더듬 병력·신경학적 이상 없음(신경과 검사 정상)\\n• 모든 낱말 첫 음절을 3~4회 일정하게 반복하는 기이하고 균일한 양상\\n• 노래·제창 등 유창성 유도 조건에서도 변화 없음\\n• 자신의 증상에 대해 무관심한 태도\",\"q\":\"이 대상자에 대한 감별과 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"심인성 말더듬 – 시험적 치료와 전문가 의뢰\",\"신경학적 말더듬 – pacing 보드와 DAF\",\"속화 – 말속도 조절과 자기 모니터링 훈련\",\"발달성 말더듬 – 말더듬수정법 전 단계 적용\",\"위장 말더듬 – 치료 대상이 아니므로 종결\"],\"answer\":1,\"explain\":\"심리적 스트레스 직후 성인기에 갑자기 발생, 신경학적 이상 없음, 기이하고 균일한 반복 양상, 유창성 유도 조건에서의 무반응, 증상에 대한 무관심은 심인성 말더듬을 시사한다. 심인성 말더듬은 짧은 시험적 치료(속도·발성 조절 지시 등)에 빠르게 반응하는 경우가 많아 진단적 가치가 있으며, 정신건강 전문가 의뢰와 상담을 병행한다. 신경학적 이상이 없으므로 ②는 배제되고, 의도적 위장(⑤)으로 단정할 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"발달 단계·감별\",\"k\":\"심인성 말더듬 감별과 중재\",\"p\":\"스트레스 후 급발·균일 반복·유도조건 무반응으로 감별과 중재 선택\",\"n\":\"심인성 말더듬: 스트레스 후 급발, 균일 반복·무관심, 시험적 치료와 의뢰\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 5세 남아, 가정에서 한국어와 영어를 함께 사용하는 이중언어 환경\\n• 두 언어 모두에서 말더듬이 관찰되며 영어에서 다소 더 심함\\n• 부모: \\\"말더듬을 없애려면 영어를 완전히 끊고 한국어만 써야 할까요?\\\"\",\"q\":\"부모에게 제공할 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"이중언어 자체가 말더듬의 원인이므로 단일언어 환경으로 바꾼다\",\"말더듬이 더 심한 영어 사용을 가정에서 즉시 중단시킨다\",\"영어를 끊고 한국어 사용도 줄여 발화량 자체를 낮춘다\",\"말더듬이 덜한 한국어로만 치료하고 영어 유창성은 평가하지 않는다\",\"두 언어를 유지하되 각 언어의 요구와 압박을 줄이도록 안내한다\"],\"answer\":5,\"explain\":\"이중언어 노출 자체가 말더듬을 유발하거나, 한 언어를 없애면 말더듬이 개선된다는 근거는 확립되어 있지 않다. 가족의 의사소통 필요를 고려해 두 언어를 유지하면서 두 언어 모두에서 유창성을 평가하고, 급한 언어 전환 강요나 교정 등 언어별 요구·압박을 줄이는 상호작용 조정을 안내하는 것이 적절하다. 언어 제거(①②④)나 발화량 축소(③)는 언어발달과 가족 관계에 해가 될 수 있다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"이중언어 말더듬 부모 상담\",\"p\":\"두 언어 모두 더듬는 아동 부모의 언어 단절 질문에 상담 내용 선택\",\"n\":\"이중언어는 말더듬 원인 아님, 두 언어 유지하며 언어별 요구·압박 감소\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 초등 3학년 여아, 말더듬 치료 중\\n• 담임교사: 소리 내어 읽기 시간에 아동이 심하게 더듬자 미안한 마음에 아동 순서를 건너뛰고 있음\\n• 아동은 \\\"선생님이 나만 빼요\\\"라며 위축됨\",\"q\":\"치료사가 담임교사에게 제안할 교실 전략으로 가장 적절한 것은?\",\"choices\":[\"읽기와 발표 활동에서 계속 제외하여 부담을 없앤다\",\"아동이 더듬을 때 \\\"천천히, 숨 쉬고\\\"라고 즉시 조언한다\",\"아동이 더듬은 문장을 유창해질 때까지 다시 읽게 한다\",\"순서를 미리 알려 주거나 짝과 함께 읽기를 활용해 참여를 유지한다\",\"말더듬을 학급 앞에서 공개적으로 설명하도록 아동에게 요구한다\"],\"answer\":4,\"explain\":\"학령기 아동을 활동에서 제외하면 회피와 위축을 강화하고 '나만 다르다'는 인식을 키운다. 읽기 순서 예고로 예기 불안을 줄이고 짝과 함께 읽기(제창)라는 유창성 유도 조건을 활용해 참여를 유지하며, 끼어들지 않기·끝까지 듣기 규칙을 학급 전체에 동일하게 적용해 아동만 특별 취급하지 않는 것이 권장된다. \\\"천천히\\\" 조언(②)이나 다시 읽기 요구(③)는 유창성을 방해하고, 공개 설명 요구(⑤)는 아동의 준비와 동의 없이 강요할 사항이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"교실 말더듬 지원 전략\",\"p\":\"읽기 활동 제외로 위축된 학령기 아동에게 교실 전략 선택\",\"n\":\"교실 지원: 읽기 순서 예고·짝과 함께 읽기로 참여 유지, 제외는 회피 강화\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인 대상자가 \\\"노래할 때, 여럿이 함께 읽을 때, 메트로놈에 맞춰 말할 때는 전혀 안 더듬는데 왜 치료에서 이걸 그냥 쓰지 않느냐\\\"고 질문하였다.\",\"q\":\"치료사의 설명으로 가장 적절한 것은?\",\"choices\":[\"이 조건들은 말더듬의 원인을 제거하므로 충분히 오래 사용하면 완치된다\",\"이 조건들은 촉진 도구로 활용하되 점차 제거하며 전이를 계획한다\",\"이 조건들은 효과가 일관되지 않으므로 치료에 사용하지 않는다\",\"이 조건들에서 유창하면 말더듬이 아니므로 치료 대상이 아니다\",\"이 조건들에서 유창한 것은 말더듬이 심인성임을 증명한다\"],\"answer\":2,\"explain\":\"노래·제창·리듬 말하기·DAF 등은 말산출의 타이밍과 청각 피드백을 외부적으로 변화시켜 일시적으로 유창성을 유도하는 '유창성 유도 조건'으로, 대부분의 말더듬 화자에게 공통적으로 나타나므로 심인성의 증거(⑤)나 비말더듬의 증거(④)가 아니다. 임상적으로는 초기 확립 단계의 촉진 도구로 유용하지만 효과가 조건 의존적이고 자연스러움이 떨어지므로 점진적 제거(fading)와 자연스러운 말·실제 상황으로의 전이·유지 계획이 필수이며, 원인 제거·완치(①)는 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"유창성 유도 조건 활용\",\"p\":\"노래·제창·리듬 조건의 일시적 유창성을 치료에 쓰는 방식 판단\",\"n\":\"유창성 유도 조건: 일시적 유창성, 촉진 도구로 쓰되 점진적 제거·전이 계획\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 29세 여성 말더듬 성인, 사회불안 동반\\n• \\\"발표 중 한 번이라도 막히면 모두가 나를 무능하다고 생각할 것이다\\\"라는 신념이 강함\\n• 이 때문에 회의 발언을 포기하고, 이후 자책과 회피가 심해지는 악순환\",\"q\":\"이 대상자의 인지-정서적 문제를 다루기 위한 중재로 가장 적절한 것은?\",\"choices\":[\"말더듬 빈도를 0으로 낮추도록 유창성 기법만 집중 훈련한다\",\"발표 상황을 완전히 피하도록 직장에 조치를 요청한다\",\"왜곡된 신념을 재구조화하고 행동 실험을 수행한다\",\"말더듬 순간마다 취소 기법만 반복해서 연습한다\",\"지연청각피드백 기기를 발표 때마다 착용하게 한다\"],\"answer\":3,\"explain\":\"말더듬 성인의 부정적 신념·사회불안에는 인지행동치료 원리에 따른 인지 재구조화(파국화·독심 등 사고 오류 확인과 근거 검토)와, 실제 발언 후 청자 반응을 확인하는 등 신념을 검증하는 행동 실험·점진적 노출을 결합한 접근이 효과적이다. 유창성 기법이나 기기만으로는(①④⑤) 신념이 유지되고, 상황 회피 조치(②)는 회피를 강화하여 악순환을 심화시킨다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬 인지행동 중재\",\"p\":\"막힘에 대한 파국적 신념과 회피 악순환으로 인지-정서 중재 선택\",\"n\":\"인지 재구조화와 행동 실험·점진적 노출 결합으로 부정적 신념 수정\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 7세 남아에게 프로그램된 조작적 접근을 적용함\\n• 1낱말 읽기 → 2낱말 → 구 → 문장 → 1분·2분·…·5분 독백·대화 순으로 발화 길이와 복잡성을 단계적으로 늘림\\n• 각 단계에서 정해진 준거(연속 시행에서 말더듬 없음)를 충족해야 다음 단계로 진행\\n• 유창한 반응에는 \\\"잘했어\\\"와 토큰, 말더듬 시 \\\"멈추고 부드럽게 다시\\\" 지시\",\"q\":\"이 프로그램의 명칭과 전체 구조로 옳은 것은?\",\"choices\":[\"리드콤 프로그램 – 1단계(감소)와 2단계(유지)\",\"캠퍼다운 프로그램 – 시범·확립·일반화·유지\",\"말더듬수정법 – 동기·확인·둔감화·변형·접근·안정화\",\"GILCU 프로그램 – 확립·전이·유지 3단계\",\"페일린 PCI – 상호작용 전략·가족 전략·아동 전략\"],\"answer\":4,\"explain\":\"발화 길이와 복잡성을 낱말→구→문장→장시간 대화로 단계적으로 늘리고 각 단계 준거를 통과해야 진행하며, 유창한 반응에 강화를 주는 프로그램은 Ryan의 GILCU이며, 확립(establishment)·전이(transfer)·유지(maintenance)의 3단계로 구성된다. 리드콤(①)은 부모의 일상 대화 수반자극이 중심이고, 캠퍼다운(②)은 프로그램된 위계가 없다. ※단계별 준거(연속 시행 수)와 세부 단계 수는 교재별 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"GILCU 프로그램 구조\",\"p\":\"발화 길이·복잡성 단계 증가와 준거 진행 특징으로 프로그램 식별\",\"n\":\"GILCU: 발화 길이·복잡성 점진 증가, 확립·전이·유지 3단계\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 9세 남아, 중등도 지적장애(IQ 52)와 말더듬 동반\\n• 긴장된 음절 반복과 막힘, 자신의 말더듬 인식은 낮음\\n• 추상적 설명의 이해가 어렵고 새 기술의 유지·일반화가 느림\\n• 특수학급 교사와 부모가 협조적임\",\"q\":\"이 아동의 말더듬 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"단순화한 유창성 기법을 시각적 단서로 지도하고 부모·교사가 강화한다\",\"말더듬 순간을 분석하는 확인 단계와 인지 재구조화를 집중 시행한다\",\"지적장애가 있으면 말더듬 치료 효과가 없으므로 언어치료만 진행한다\",\"성인용 캠퍼다운 프로그램을 수정 없이 그대로 적용한다\",\"말더듬을 스스로 인식하지 못하므로 현재는 중재 대상이 아니다\"],\"answer\":1,\"explain\":\"지적장애 아동은 추상적 자기분석과 인지적 접근(②)의 부담이 크므로, 구체적·단순화된 유창성 촉진 기법을 시범과 반복, 시각적 단서로 지도하고 부모·교사가 동일한 단서와 강화를 제공하는 환경 조정으로 일반화를 돕는 것이 적절하다. 지적장애가 있어도 말더듬 중재는 효과가 있으며(③), 인식 부족은 치료 제외 사유가 아니라(⑤) 중재 설계 시 고려할 특성이다. 성인용 프로그램의 그대로 적용(④)은 부적합하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"지적장애 동반 말더듬 중재\",\"p\":\"추상적 이해 제한과 일반화 지연 특성으로 중재 계획 선택\",\"n\":\"지적장애 동반 말더듬: 단순화한 유창성 기법·시각 단서, 부모·교사 강화\"}},{\"grade\":1,\"set\":2,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 여아, 클리닉 초기 평가에서 치료사와 그림 설명 시 %SS 1.5로 거의 유창함\\n• 그러나 부모는 \\\"집에서는 훨씬 심하고, 특히 저녁에 형제와 다툴 때 심하다\\\"고 보고\\n• 치료사는 진단을 보류하고 추가 자료를 수집하기로 함\",\"q\":\"이 결정의 근거와 추가로 수집할 자료로 가장 적절한 것은?\",\"choices\":[\"클리닉 표본이 가장 객관적이므로 부모 보고는 배제하고 재측정한다\",\"부모 보고가 더 정확하므로 이를 근거로 즉시 직접 치료를 시작한다\",\"%SS 1.5는 정상 범위이므로 말더듬이 아니라고 보고 종결한다\",\"말더듬은 맥락별 변이가 크므로 가정 녹화와 부모 평정을 추가한다\",\"아동의 표준화 언어검사만 추가하면 말더듬 진단이 가능하다\"],\"answer\":4,\"explain\":\"말더듬은 상황·과제·시간대·상대·정서 상태에 따라 변이가 매우 커서, 낯선 클리닉의 단일 표본은 대표성이 부족할 수 있다(특히 학령전기). 따라서 가정 녹화, 놀이·대화 등 다양한 과제의 표본, 부모의 일일 말더듬 정도(SR) 평정 등을 종합해 대표성 있는 판단을 해야 한다. 클리닉 표본만 신뢰하거나(①) 부모 보고만으로 치료를 시작하는 것(②), 단일 표본으로 종결하는 것(③) 모두 변이성을 고려하지 않은 결정이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"말더듬 표본 대표성 확보\",\"p\":\"클리닉 표본과 부모 보고 불일치로 추가 수집할 자료 선택\",\"n\":\"말더듬 맥락별 변이: 가정 녹화·다양한 과제 표본·부모 SR 평정 종합\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 26개월 남아, 청력 정상, 출생·발달력 특이사항 없음\\n• K M-B CDI 표현어휘 30개(10%ile 미만), 낱말 조합 없음\\n• 언어 이해(SELSI 수용언어)는 생활연령 수준\\n• 가리키기·보여주기 등 몸짓 사용과 상징놀이가 연령에 적절\\n• 언어장애 가족력 없음, 부모는 걱정이 커서 '지금 당장 주 3회 치료'를 요청함\",\"q\":\"이 아동에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"표현어휘 지체가 뚜렷하므로 즉시 주 3회 개별 집중치료를 시작한다\",\"저위험 늦게 말하는 아동으로 보고 부모 언어촉진 교육 후 3~6개월 뒤 재평가한다\",\"24개월 이후 낱말 조합이 없으므로 발달성 언어장애(DLD)로 진단을 확정한다\",\"표현어휘 지체는 대부분 자연 회복되므로 아무 조치 없이 만 4세까지 기다린다\",\"낱말 조합이 없는 것은 자폐스펙트럼장애의 핵심 징후이므로 자폐 진단평가를 의뢰한다\"],\"answer\":2,\"explain\":\"이해력, 몸짓(특히 가리키기), 상징놀이가 정상이고 가족력이 없는 표현어휘 지체는 예후가 좋은 저위험 late talker(늦게 말하는 아동) 프로파일이다. 이 경우 부모 매개 언어촉진(반응적 상호작용·집중자극) 교육과 3~6개월 간격의 추적 재평가가 권장된다. ①은 위험도 대비 과잉 개입, ③은 DLD 진단은 보통 만 4세 전후 언어 문제가 지속될 때 내리므로 조기 확정이 부적절, ④는 추적 없이 방치하는 것으로 부적절, ⑤는 몸짓·놀이·상호작용이 양호하여 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"늦게 말하는 아동 위험도 판단\",\"p\":\"이해·몸짓·상징놀이 정상과 표현어휘 지체로 위험도와 조치 판단\",\"n\":\"저위험 late talker: 이해·몸짓·놀이 정상, 부모 언어촉진 교육과 추적 재평가\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 아동의 수용어휘 검사 결과\\n• 원점수: 34\\n• 해당 연령 규준: 평균 46, 표준편차 8\",\"q\":\"이 아동의 z점수와 그에 대한 해석으로 옳은 것은?\",\"choices\":[\"z = -0.75, 백분위 약 23으로 정상 범위이다\",\"z = -2.0, 백분위 약 2로 심한 지체이다\",\"z = -1.5, 백분위 약 16으로 경계선 수준이다\",\"z = -1.5, 백분위 약 7로 유의한 지체이다\",\"z = +1.5, 백분위 약 93으로 우수하다\"],\"answer\":4,\"explain\":\"z = (원점수 − 평균) ÷ 표준편차 = (34 − 46) ÷ 8 = −1.5. 정규분포에서 z = −1.5는 백분위 약 7(6.7)에 해당하며 −1SD(백분위 16) 미만이므로 유의한 어휘 지체로 해석한다. ③은 z와 백분위가 서로 맞지 않고(백분위 16은 z = −1), ①·②·⑤는 계산이 틀렸다. ※ 백분위 환산값과 '유의한 지체' 절단점(−1SD, −1.25SD, −1.5SD 등)은 검사·교재별로 다를 수 있다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"z점수 산출과 해석\",\"p\":\"원점수·평균·표준편차로 z점수와 백분위 수준 산출\",\"n\":\"z=(원점수−평균)÷SD, z −1.5는 백분위 약 7로 −1SD 미만 지체\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"3세 아동의 자발화(4개 발화)\\n① \\\"아빠 신문 읽어\\\"\\n② \\\"나 우유 먹었어\\\"\\n③ \\\"동생이 울어\\\"\\n④ \\\"엄마가 책 찾아\\\"\",\"q\":\"위 발화의 평균형태소길이(MLU-m)는? (조사·어미·선어말어미는 각각 하나의 형태소로 계산)\",\"choices\":[\"4.5\",\"4.0\",\"3.5\",\"5.0\",\"5.5\"],\"answer\":1,\"explain\":\"① 아빠/신문/읽-/-어 = 4, ② 나/우유/먹-/-었-/-어 = 5, ③ 동생/-이/울-/-어 = 4, ④ 엄마/-가/책/찾-/-아 = 5. 총 18개 형태소 ÷ 4발화 = 4.5. 조사(-이, -가)나 선어말어미(-었-)를 빠뜨리면 값이 낮게, 어간을 더 쪼개면 높게 산출된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"MLU-m 산출\",\"p\":\"조사·어미·선어말어미 분리 규칙으로 평균형태소길이 산출\",\"n\":\"MLU-m=총 형태소 수÷발화 수, 조사·어미·선어말어미 각 1개로 계산\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 6개월 여아 평가 결과\\n• 청력 정상, K-CTONI-2 비언어성 지능지수 98\\n• PRES 수용언어 발달연령 4;6, 표현언어 발달연령 3;10\\n• REVT 표현어휘 9%ile\\n• 비단어 따라말하기 3음절 이상에서 급격히 저하\\n• 자발화: 주격조사 생략(\\\"토끼 뛰어\\\"), 시제 오류(\\\"어제 유치원 가요\\\"), 연결어미 없이 단문 나열\\n• 눈맞춤·상호작용·상징놀이 양호, 상동행동 없음\",\"q\":\"이 아동의 진단과 우선 중재 목표로 가장 적절한 조합은?\",\"choices\":[\"발달성 언어장애 – 격조사·시제 등 문법형태소 산출\",\"자폐스펙트럼장애 – 공동주의와 상호작용 시작하기\",\"사회적(화용) 의사소통장애 – 대화 차례 주고받기\",\"지적장애 – 기능적 일상 어휘와 생활 기술 습득\",\"말소리장애 – 종성 산출 정확도와 말 명료도 향상\"],\"answer\":1,\"explain\":\"비언어성 지능·청력이 정상이고 사회적 상호작용에 문제가 없는데 언어(특히 표현·문법형태소)만 지체되고 비단어 따라말하기가 저조한 것은 발달성 언어장애(단순언어장애)의 전형적 프로파일이다. 문법형태소 오류가 두드러지므로 자연스러운 놀이 맥락에서 조사·시제를 목표로 한 집중자극·고쳐말하기 중재가 우선된다. 지능 정상이므로 ④, 사회성 양호하므로 ②·③, 조음 문제가 아니므로 ⑤는 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"DLD 감별과 중재 목표\",\"p\":\"지능·사회성 정상과 문법형태소 오류 프로파일로 진단과 목표 선택\",\"n\":\"DLD: 지능·청력·사회성 정상, 문법형태소 결함·비단어 따라말하기 저조\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"6세 남아\\n• K-WPPSI-IV 전체 지능지수 62, 적응행동 점수도 유의하게 낮음\\n• PRES 수용·표현언어 발달연령 모두 약 3;6 수준\\n• 자발화: 2~3어절 단문, 어휘 제한, 요구하기는 주로 손잡아끌기로 함\\n• 배운 낱말을 치료실 밖에서 잘 쓰지 못함\",\"q\":\"이 아동의 중재 방향으로 가장 적절한 것은?\",\"choices\":[\"인지 수준을 먼저 정상 범위로 끌어올린 뒤 언어치료를 시작한다\",\"언어가 인지보다 유의하게 낮으므로 단순언어장애 중재 프로토콜을 적용한다\",\"요구·거부·선택 등 일상 기능과 생활 어휘를 목표로 일과 속 일반화를 강조한다\",\"연령 수준의 복문 산출을 1차 목표로 설정하여 집중 훈련한다\",\"구어 산출이 가능하므로 몸짓·그림 등 비구어 수단은 모두 제한한다\"],\"answer\":3,\"explain\":\"지적장애 아동은 언어가 인지 수준과 대체로 일치하며 학습 속도가 느리고 일반화가 어렵다. 따라서 발달적으로 적절한 기능적 목표(요구·거부·선택하기, 생활 어휘)를 실제 일과에서 반복·분산 연습하고 여러 사람·환경에서 일반화하는 것이 핵심이다. ②는 언어–인지 불일치가 없으므로 틀리고, ①은 언어와 인지는 병행 촉진 대상이며, ④는 발달 수준보다 지나치게 높은 목표, ⑤는 잔존 수단을 제한하는 것으로 총체적 의사소통 원칙에 어긋난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"지적장애 아동 중재 방향\",\"p\":\"인지·언어 수준 일치와 일반화 곤란 특성으로 중재 방향 선택\",\"n\":\"지적장애: 언어가 인지 수준과 일치, 기능적 생활 어휘와 일과 속 일반화\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"놀이 상황에서 아동이 치료사가 들고 있는 블록을 향해 손을 뻗는다. 치료사는 블록을 아동 눈높이에 들고 기대에 찬 표정으로 바라보며 약 5초간 말없이 기다린다. 아동이 \\\"블록\\\"이라고 말하자 즉시 블록을 건네준다.\",\"q\":\"치료사가 사용한 환경중심 언어중재(milieu teaching) 절차는?\",\"choices\":[\"요구-모델(mand-model)\",\"우연교수(incidental teaching)\",\"아동중심 시범(modeling)\",\"환경 조성(arrangement)\",\"시간지연 기법(time delay)\"],\"answer\":5,\"explain\":\"아동이 원하는 것에 관심을 보일 때 즉시 촉진하지 않고 기대하는 표정으로 일정 시간 기다려 자발적 산출을 유도한 뒤 원하는 물건으로 자연적 강화를 주는 것은 시간지연 절차이다. 요구-모델은 치료사가 '뭐 줄까?'처럼 언어적 요구를 먼저 하고, 시범은 목표 발화를 먼저 들려주며, 우연교수는 아동의 요구 시작 후 정교화를 요청하는 절차이다. 환경 조성은 물건을 닿지 않게 두는 등 사전 상황 설정에 해당한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"환경중심 시간지연 기법\",\"p\":\"기대 표정으로 말없이 기다리는 절차로 환경중심 중재 기법 식별\",\"n\":\"시간지연: 즉시 촉진 없이 기다려 자발 산출 유도 후 자연적 강화\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"4세 발달성 언어장애 아동의 목표는 과거시제 '-었-'의 산출이다. 치료사는 소꿉놀이를 하며 \\\"아기가 밥을 다 먹었어\\\", \\\"곰이 잠을 잤어\\\", \\\"컵이 떨어졌어\\\"처럼 목표 형태를 담은 문장을 한 회기에 수십 번 자연스럽게 들려주되, 아동에게 따라 말하거나 산출하도록 요구하지 않는다.\",\"q\":\"위 중재 기법과 그 원리로 옳은 것은?\",\"choices\":[\"확대(extension) – 아동 발화에 새로운 의미 정보를 덧붙여 되돌려 준다\",\"유도모방(elicited imitation) – 모델 직후 아동이 즉시 따라 말하게 한다\",\"비연속 개별시도 교수 – 자극·반응·강화의 시행을 구조화하여 반복한다\",\"집중자극(focused stimulation) – 목표 형태를 고빈도로 입력한다\",\"혼잣말 기법(self-talk) – 치료사가 자신의 행동을 말로 표현한다\"],\"answer\":4,\"explain\":\"특정 목표 형태를 의미 있는 맥락에서 고빈도로 반복 입력하되 산출을 강요하지 않는 것은 집중자극 기법으로, 아동이 고빈도 입력에서 목표 규칙을 스스로 추출하도록 하는 원리이다. 유도모방·개별시도는 산출을 직접 요구하고, 확대는 아동 발화에 대한 반응 기법이며, 혼잣말은 치료사 자신의 행동을 기술하는 기법으로 특정 문법형태소를 목표로 한 고밀도 입력과는 다르다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"집중자극 기법 원리\",\"p\":\"목표 형태 고빈도 입력·산출 비요구 특징으로 기법과 원리 식별\",\"n\":\"집중자극: 목표 형태를 의미 맥락에서 고빈도 입력, 산출 강요 없음\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 아동에게 ㉠ 주격조사 '이/가', ㉡ 연결어미 '-고', ㉢ 대화에서 차례 기다리기의 세 목표를 설정하였다. 치료사는 매 회기마다 세 목표를 모두 다루며, 각 목표에 회기 시간을 나누어 배분한다.\",\"q\":\"이 치료사가 사용한 목표 공략(goal attack) 전략은?\",\"choices\":[\"수평적 전략 – 여러 목표를 같은 회기에서 동시에 다룬다\",\"주기적 전략 – 정해진 기간마다 목표를 교체하며 순환한다\",\"수직적 전략 – 한 목표가 준거에 도달한 뒤 다음 목표로 넘어간다\",\"위계적 전략 – 쉬운 목표부터 어려운 목표로 순서대로 다룬다\",\"절충적 전략 – 치료사가 목표를, 아동이 활동을 선택한다\"],\"answer\":1,\"explain\":\"매 회기 여러 목표를 동시에 다루는 것은 수평적(horizontal) 목표 공략 전략이다. 수직적 전략은 한 목표씩 준거 도달 후 순차적으로, 주기적 전략은 준거 도달과 무관하게 정해진 기간 단위로 목표를 순환한다. ④·⑤는 목표 공략 전략의 공식적 분류가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"목표 공략 전략 유형\",\"p\":\"매 회기 여러 목표를 나눠 다루는 방식으로 목표 공략 전략 식별\",\"n\":\"수평적 전략: 한 회기에 여러 목표 동시, 수직적은 준거 도달 후 순차\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 4세 8개월 아동, 가정에서는 중국어, 어린이집(입소 1년)에서는 한국어 사용\\n• 한국어 표준화 어휘검사: 10%ile 미만\\n• 역동적 평가(검사–교수–재검사): 20분의 짧은 어휘 교수 후 재검사에서 새 낱말 대부분을 습득·사용함\\n• 교수 과정에서 검사자의 촉진 필요량(examiner effort)이 적고 반응 수정 능력(modifiability)이 높음\\n• 부모 보고상 중국어 발달은 또래 수준\",\"q\":\"이 결과에 대한 해석과 조치로 가장 적절한 것은?\",\"choices\":[\"표준화 검사 결과가 낮으므로 발달성 언어장애로 진단하고 주 2회 언어치료를 시작한다\",\"두 언어 모두 사용해 혼란이 생겼으므로 가정에서도 한국어만 쓰도록 권고한다\",\"언어 차이로 판단하고 모국어를 유지하며 한국어 입력을 늘리고 추적 관찰한다\",\"역동적 평가 결과는 참고자료일 뿐이므로 한국어 표준화 검사 점수로 진단한다\",\"중국어가 또래 수준이므로 한국어 문제는 무시하고 평가를 종료한다\"],\"answer\":3,\"explain\":\"역동적 평가에서 짧은 교수 후 높은 학습 반응성(높은 수정가능성, 낮은 검사자 노력)을 보이면 학습 잠재력, 즉 언어 학습 능력 자체는 온전한 것으로 보고, 낮은 표준화 점수는 한국어 노출 부족에 의한 '언어 차이'로 해석한다. 모국어 발달이 정상이라는 점도 이를 지지한다. 따라서 모국어 유지와 한국어 노출·풍부한 입력 확대, 추적 관찰이 적절하다. ①·④는 규준이 맞지 않는 표준화 검사로 진단하는 오류이고, ②는 이중언어가 언어장애를 유발한다는 잘못된 전제이며, ⑤는 한국어 지원 필요성을 무시한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"역동적 평가와 언어 차이\",\"p\":\"짧은 교수 후 높은 수정가능성으로 언어 차이 판단과 조치 선택\",\"n\":\"역동적 평가: 높은 수정가능성·낮은 검사자 노력은 장애 아닌 언어 차이\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 3세 0개월, 양측 중등고도 감각신경성 난청(70dB HL)\\n• 생후 30개월에 진단, 보청기 착용 1개월째(보청 후 어음역 20~30dB HL)\\n• 표현어휘 15개, 대부분 모음 위주 발성\\n• 부모는 구어(듣기·말하기)를 통한 의사소통을 희망함\",\"q\":\"이 아동에게 청각구어법(auditory-verbal approach)을 적용할 때의 원리로 옳은 것은?\",\"choices\":[\"보청기 효과가 제한적이므로 수어를 주 수단으로 먼저 확립한 뒤 구어를 도입한다\",\"구어 습득이 어려우므로 그림 기반 AAC를 주 의사소통 수단으로 설정한다\",\"독순(입모양 읽기) 훈련을 중심으로 시각적 단서를 최대한 제공한다\",\"시각 단서를 최소화하고 청각을 통한 언어 습득과 부모 코칭을 강조한다\",\"치료사 주도의 낱말 따라말하기 훈련을 주 3회 집중 실시하고 부모 참여는 배제한다\"],\"answer\":4,\"explain\":\"청각구어법은 적절한 보청(보청기·인공와우)과 지속적인 보청 상태 점검을 전제로, 청각을 통한 언어 습득을 최우선으로 하고 입모양 등 시각 단서 의존을 줄이며 부모를 일상의 일차적 언어 촉진자로 코칭하는 접근이다. 보청 후 어음역 청력이 확보된 이 아동은 적용 대상이 된다. ①·②·③은 수어·AAC·시각 중심으로 청각구어법의 원리와 반대이며, ⑤는 부모 참여를 배제하여 핵심 원리에 어긋난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"청각구어법 원리\",\"p\":\"보청 후 어음역 확보된 난청 아동에게 청각구어법 원리 식별\",\"n\":\"청각구어법: 청각 통한 언어 습득 우선, 시각 단서 최소화, 부모 코칭\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 4세 뇌성마비 아동, 구어 명료도가 매우 낮아 그림상징 의사소통판 사용 중\\n• 현재 판에는 '과자, 물, 자동차, 블록…' 등 명사 20개만 있음\\n• 사용 양상: 원하는 것 요구하기에만 사용, 판을 사용하는 상대는 대부분 어머니\\n• 언어 이해는 연령 수준\",\"q\":\"이 아동의 AAC 중재를 확장하기 위한 계획으로 가장 적절한 것은?\",\"choices\":[\"핵심어휘를 추가해 의사소통 기능을 넓히고 보조 언어 자극으로 모델을 제공한다\",\"구어 명료도 향상을 위해 조음치료를 우선하고 AAC 사용은 잠시 중단한다\",\"판에 있는 낱말을 짚으며 따라 말하게 하는 구어 산출 훈련으로 전환한다\",\"요구하기가 안정되었으므로 판 사용을 어머니와의 상황으로 한정하여 숙달시킨다\",\"명사 상징을 100개로 늘려 요구할 수 있는 어휘량을 충분히 확보한다\"],\"answer\":1,\"explain\":\"AAC 어휘는 '더, 아니야, 싫어, 다했어, 봐'처럼 다양한 상황·기능에 두루 쓰이는 핵심어휘(core vocabulary)를 포함해야 요구하기 이외의 의사소통 기능(거부·언급·질문 등)과 상징 조합으로 확장될 수 있다. 또한 상대가 상징을 짚으며 말하는 보조 언어 자극(aided language stimulation)은 AAC 사용자에게 필수적인 입력 모델이다. ⑤는 부수어휘만 늘려 기능 확장이 안 되고, ②·③은 AAC 사용을 구어 훈련으로 대체하는 잘못된 접근이며, ④는 의사소통 상대·환경을 오히려 제한한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"AAC 어휘 확장 계획\",\"p\":\"명사 위주 판과 요구 기능 한정 사용으로 AAC 확장 계획 선택\",\"n\":\"AAC 확장: 핵심어휘로 기능 확대, 보조 언어 자극으로 상징 사용 모델\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 30개월 남아, 자폐스펙트럼장애 진단\\n• 무발화, 원하는 물건은 성인의 손을 물건 쪽으로 끌어당김\\n• 흥미로운 것을 보고 가리키거나 성인과 사물을 번갈아 보는 행동이 없음\\n• 성인이 가리키는 곳을 따라 보는 반응(공동주의 반응하기)은 간헐적으로 나타남\\n• 장난감을 줄 세우거나 돌리며 놀고 상징놀이는 없음\",\"q\":\"이 아동의 초기 중재 목표와 근거로 가장 적절한 것은?\",\"choices\":[\"공동주의 시작하기와 상징놀이를 목표로 한다 – 이후 언어 발달의 예측 요인이다\",\"낱말 따라말하기를 우선 목표로 한다 – 무발화이므로 구어 산출이 가장 시급하다\",\"장난감 줄 세우기를 즉시 소거한다 – 상동행동이 언어 습득을 방해한다\",\"글자 카드로 문자 읽기를 가르친다 – 자폐 아동은 시각 학습자여서 읽기가 더 빠르다\",\"성인 지시 따르기를 우선 목표로 한다 – 순응이 있어야 언어 학습이 가능하다\"],\"answer\":1,\"explain\":\"자폐스펙트럼장애 영유아에서 공동주의(특히 시작하기, IJA)와 상징(가장)놀이는 이후 언어 습득을 예측하는 핵심 영역으로, JASPER 등 근거 기반 중재의 우선 목표이다. 무발화 아동에게 사회적 기반 없이 따라말하기(②)나 문자(④)를 우선하는 것은 부적절하고, 반복 놀이는 소거 대상이 아니라 확장의 출발점으로 활용하며(③), 순응 훈련(⑤)은 의사소통 발달의 전제가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"자폐 영유아 초기 중재 목표\",\"p\":\"공동주의 시작 부재와 상징놀이 부재로 초기 중재 목표 선택\",\"n\":\"공동주의 시작하기·상징놀이: 자폐 영유아 이후 언어 발달의 예측 요인\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 자폐스펙트럼장애 아동\\n• 넘어져 아플 때마다 예전에 엄마가 하던 말을 그대로 \\\"괜찮아, 호 해줄게\\\"라고 말함\\n• 원하는 과자를 보면 광고 문구를 그대로 \\\"바삭바삭 새로 나왔어요\\\"라고 말함\\n• 두 발화 모두 억양·형태가 매번 동일함\",\"q\":\"이 반향어에 대한 해석과 중재로 가장 적절한 것은?\",\"choices\":[\"의미 없는 자기자극 행동이므로 무시하여 점차 소거한다\",\"기능을 지닌 지연 반향어로 보고 짧고 관습적인 발화로 대치해 간다\",\"발화가 있으므로 언어 수준이 적절하다고 보고 화용 중재는 생략한다\",\"즉각 반향어이므로 발화 직후 '조용히'라고 지시하여 억제한다\",\"반향어를 늘리기 위해 광고·대화 문구를 더 많이 암기시킨다\"],\"answer\":2,\"explain\":\"과거에 들은 말을 나중에 그대로 재현하는 것은 지연 반향어이며, 사례처럼 특정 상황에서 일관되게 나타나면 자기위로·요구 등 의사소통 기능을 지닌 것으로 본다. 중재는 기능을 인정하고 그 상황에서 '아파, 호', '과자 주세요'처럼 더 짧고 관습적·생성적인 발화를 모델링하여 점진적으로 대치(형성)하는 것이 원칙이다. ①·④는 기능을 무시한 억제, ③은 반향어를 생성적 언어로 오판한 것, ⑤는 비생성적 발화를 늘리는 잘못된 방향이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"지연 반향어 해석과 중재\",\"p\":\"상황별로 일관되게 재현되는 발화로 반향어 기능 판단 후 중재 선택\",\"n\":\"지연 반향어: 의사소통 기능 인정, 짧고 관습적인 발화로 점진적 대치\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 4학년 아동\\n• 낱말 해독·읽기 유창성: 학년 수준\\n• REVT 수용·표현 어휘: 정상 범위\\n• '물의 순환' 단원을 설명하게 하자 \\\"물이… 그리고 비가… 그래서…\\\"처럼 단문을 '그리고'로만 이어 붙이고 원인–결과 관계를 표현하지 못함\\n• 자발화에서 관형절('-는/-ㄴ')과 '-기 때문에', '-면' 등 종속 연결어미 사용이 거의 없음\\n• 사회·과학 교과 서술형 평가 점수가 낮음\",\"q\":\"이 아동에게 가장 적절한 중재는?\",\"choices\":[\"낱말 해독 정확도와 읽기 속도를 높이는 유창성 훈련\",\"교과 내용을 활용한 문장 결합과 설명담화 구조 지도\",\"일상 어휘의 양을 늘리기 위한 어휘 목록 암기 훈련\",\"이야기 문법 요소를 갖춘 허구적 이야기 다시 말하기\",\"음소 분리·합성 등 음운인식 과제 반복 훈련\"],\"answer\":2,\"explain\":\"해독·어휘는 정상이나 복문 구문과 설명담화(expository discourse) 구조화가 취약한 학령기 언어장애 프로파일이다. 학령기 중재는 교과 내용과 연계하여 관형절·종속 연결어미가 포함된 후기 구문을 문장 결합(sentence combining) 기법으로 지도하고, 원인–결과·비교–대조 등 설명담화 구조를 도식 조직자로 시각화하는 것이 적절하다. ①·⑤는 정상인 해독 영역, ③은 정상인 어휘량, ④는 이야기(서사) 담화로 이 아동의 핵심 결함(설명담화·복문)과 맞지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"이야기·담화\",\"k\":\"설명담화·복문 중재\",\"p\":\"해독·어휘 정상과 복문·인과 표현 결함으로 학령기 중재 선택\",\"n\":\"학령기 설명담화 중재: 교과 연계 문장 결합과 담화 구조 도식화\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"6세 아동의 그림책 이야기 다시 말하기\\n\\\"개구리가 있었어요. 아이가 잤어요. 개구리가 나갔어요. 아이가 일어났어요. 아이가 밖에 갔어요. 개구리를 찾았어요.\\\"\\n• 등장인물과 사건은 대체로 순서대로 나열함\\n• 개구리가 사라졌다는 계기사건에 대한 인물의 반응(놀람·걱정), 찾으려는 목표·시도의 이유가 전혀 표현되지 않음\\n• '그래서, 왜냐하면' 등 인과 표지 없음\",\"q\":\"이 아동의 이야기 중재로 가장 적절한 것은?\",\"choices\":[\"이야기 길이를 늘리기 위해 문장 수를 세어 목표 개수를 채우게 한다\",\"어휘다양도를 높이기 위해 새 낱말을 이야기에 넣게 한다\",\"그림 없이 듣기만으로 이야기를 기억해 말하는 청각 기억 훈련을 한다\",\"이야기 문법 요소를 시각 아이콘으로 제시하여 다시 말하기를 지도한다\",\"발화 명료도를 높이기 위해 조음 정확도를 먼저 훈련한다\"],\"answer\":4,\"explain\":\"사건을 나열만 하고 계기사건–내적 반응–시도의 인과적 연결이 빠진 것은 이야기 문법 구조의 결함이다. 이야기 문법 요소(계기사건·내적 반응·시도·결과)를 시각 아이콘으로 외현화하여 다시 말하기를 지도하고, 인물의 감정·의도 어휘와 '그래서·왜냐하면' 같은 인과 결속표지를 함께 목표로 하는 것이 근거 기반 이야기 중재이다. ①·②는 구조가 아닌 양적 지표만 겨냥하고, ③·⑤는 핵심 결함과 무관하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"이야기·담화\",\"k\":\"이야기 문법 중재\",\"p\":\"사건 나열과 내적 반응·시도 누락으로 이야기 중재 선택\",\"n\":\"이야기 문법 요소(계기사건·내적 반응·시도·결과) 시각화 다시 말하기\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 10개월 아동(초등 입학 예정) 평가\\n• 음절 수 세기, 음절 합성·분리: 90% 이상 정확\\n• 첫소리(초성) 변별·분리('공'의 첫소리?): 20%\\n• 자모 이름: 일부만 알고 소리값은 모름\\n• 낱말 읽기: 자기 이름 등 통문자 몇 개만 읽음\\n• 어휘·구문: 연령 수준\",\"q\":\"이 아동의 읽기 준비 중재로 가장 적절한 것은?\",\"choices\":[\"이미 습득한 음절 수준 인식 과제를 계속 반복하여 자동화한다\",\"통문자 카드로 자주 보는 낱말 100개를 암기시킨다\",\"음소 수준 인식을 글자–소리 대응과 통합하여 지도한다\",\"자모 이름만 완전히 외운 뒤 음소 인식은 초등 입학 후로 미룬다\",\"어휘 확장을 우선하여 읽기 이해의 기초를 다진다\"],\"answer\":3,\"explain\":\"음절 인식은 완성되었으나 음소 인식과 자소–음소 대응 지식이 부족한 상태이므로, 다음 단계인 음소 수준 인식(초성 변별·분리·합성)을 글자–소리(자소–음소) 대응과 통합하여 지도하는 것이 해독 습득에 가장 효과적이다. ①은 이미 숙달된 수준의 반복, ②는 알파벳 원리를 우회하는 방법, ⑤는 정상인 어휘를 목표로 삼음, ④는 음소 인식 지도를 불필요하게 지연시킨다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"읽기·쓰기\",\"k\":\"음소 인식 읽기 준비 중재\",\"p\":\"음절 인식 완성과 음소 인식·자모 소리값 부족으로 중재 선택\",\"n\":\"음소 수준 인식과 자소-음소 대응 통합 지도로 해독 습득 촉진\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"표현어휘가 지체된 3세 아동의 어머니에게 그림책 읽기 방법을 교육하였다.\\n• \\\"토끼가 먹는 건 뭐지?\\\"(빈칸 채우기), \\\"아까 토끼가 어디 갔었지?\\\"(회상)\\n• \\\"이 그림에서 무슨 일이 일어나고 있어?\\\"(개방형), \\\"이건 무슨 색이야?\\\"(wh-질문)\\n• \\\"우리 어제 공원에서 본 토끼 기억나?\\\"(경험과 연결)\\n• 아동이 대답하면 칭찬하고 그 말을 문장으로 다시 들려준 뒤 따라 말하게 함\",\"q\":\"이 부모교육에서 지도한 접근과 원리로 옳은 것은?\",\"choices\":[\"공유책읽기에서 어머니가 글을 정확히 끝까지 읽어 주는 것이 핵심이다\",\"반응적 상호작용 – 성인은 질문을 최소화하고 아동의 주도를 따라간다\",\"스크립트 중재 – 익숙한 일상 사건의 순서를 이용해 말하게 한다\",\"대화식 책읽기 – 질문으로 아동이 이야기의 화자가 되게 한다\",\"청각적 집중 자극 – 목표 낱말을 반복해서 들려주기만 한다\"],\"answer\":4,\"explain\":\"빈칸 채우기·회상·개방형·wh-·경험 연결(CROWD) 질문으로 아동을 이야기의 능동적 화자로 만들고, 아동의 반응을 촉진–평가–확장–반복(PEER)하여 어휘·표현을 촉진하는 것은 대화식 책읽기(dialogic reading)이다. ①은 수동적 읽어주기, ③은 사건 스크립트 활용, ②는 질문을 줄이는 접근으로 질문이 핵심인 이 방법과 반대이며, ⑤는 산출 유도 없이 입력만 주는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"대화식 책읽기 원리\",\"p\":\"질문 유형과 칭찬·확장 반응 절차로 부모교육 접근 식별\",\"n\":\"대화식 책읽기: CROWD 질문과 PEER 반응으로 아동을 이야기 화자로 만듦\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"3세 아동이 얼마 전까지 \\\"들어\\\", \\\"지어\\\"로 바르게 말하다가 최근 \\\"듣어요\\\", \\\"짓어요\\\", \\\"굽어요(구워요)\\\"처럼 말하기 시작했다. 부모는 '말이 퇴보한 것 같다'며 걱정한다.\",\"q\":\"이 현상에 대한 설명과 부모 상담 내용으로 옳은 것은?\",\"choices\":[\"문법형태소 습득이 퇴행한 것이므로 즉시 조음·문법 중재를 시작해야 한다\",\"과잉규칙화로 정상 발달 과정이며, 바른 형태를 모델링하도록 안내한다\",\"청각 문제로 어미를 잘못 듣는 것이므로 청력검사를 우선 의뢰한다\",\"성인의 잘못된 발음을 모방한 결과이므로 가족의 말을 교정해야 한다\",\"언어 처리 속도 저하의 징후이므로 작업기억 훈련이 필요하다\"],\"answer\":2,\"explain\":\"정확히 쓰던 불규칙 형태가 규칙형으로 바뀌는 것(과잉규칙화)은 아동이 단순 모방이 아니라 활용 규칙을 능동적으로 추출해 불규칙 용언에까지 적용한다는 증거로, U자형 발달의 정상 과정이다. 이는 행동주의(모방·강화)만으로 언어 습득을 설명하기 어렵다는 근거이기도 하다. 상담 시에는 병리가 아님을 설명하고 직접 교정보다 바른 형태를 자연스럽게 모델링(고쳐 말하기)하도록 안내한다. ①·③·⑤는 정상 현상을 병리로 오해한 것이며, ④는 성인 입력에는 없는 형태이므로 모방으로 설명되지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"문법·형태\",\"k\":\"과잉규칙화 부모 상담\",\"p\":\"바른 불규칙형에서 규칙형으로 바뀐 발화로 정상 발달 여부 판단\",\"n\":\"과잉규칙화: 활용 규칙 능동 추출의 증거, U자형 정상 발달·모델링 안내\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 발달성 언어장애 아동\\n• 비단어 따라말하기와 문장 따라말하기가 또래보다 현저히 낮음\\n• \\\"공을 집어서 상자에 넣고 문 옆에 두세요\\\" 같은 3단계 지시는 첫 단계만 수행\\n• 같은 지시를 한 단계씩 나누어 주면 모두 수행\\n• 빠른 속도로 말하면 이해가 급격히 떨어짐\",\"q\":\"이 아동의 정보처리 특성을 고려한 중재 원리로 가장 적절한 것은?\",\"choices\":[\"숫자 거꾸로 외우기 등 기억 훈련을 언어치료의 주 내용으로 한다\",\"입력 속도를 늦추고 정보를 나누어 제시하며 시각 지원으로 처리 부담을 줄인다\",\"처리 부담과 무관하게 연령 수준의 긴 문장을 그대로 제시하여 익숙해지게 한다\",\"이해가 어려운 것은 주의력 문제이므로 언어 중재 대신 주의력 훈련만 실시한다\",\"지시 따르기가 안 되면 같은 지시를 반복 연습시켜 순응을 높인다\"],\"answer\":2,\"explain\":\"비단어·문장 따라말하기 저조, 정보량·속도에 따른 이해 저하는 발달성 언어장애의 제한된 처리 용량(음운 작업기억·처리 속도)을 반영한다. 정보처리 관점의 중재는 입력 속도 감소, 단위 분할, 핵심어 강조·반복, 시각 지원 등으로 처리 부담을 조절하면서 목표 언어 형식의 학습을 촉진하는 것이다. ①은 언어와 분리된 기억 훈련의 전이 효과가 제한적이고, ③·⑤는 처리 특성을 무시하며, ④는 주의력 문제로 단정할 근거가 없다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"DLD 정보처리 고려 중재\",\"p\":\"따라말하기 저조와 정보량·속도 따른 이해 저하로 중재 원리 선택\",\"n\":\"DLD 처리 용량 제한: 입력 속도 감소·단위 분할·시각 지원으로 부담 조절\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 2학년, 사회적(화용) 의사소통장애 아동\\n• 어휘·구문·조음은 연령 수준\\n• 친구에게 다가가 대화를 시작하지 못하고, 시작하더라도 자기 관심사인 공룡 이야기만 계속함\\n• 친구가 지루해하는 표정을 알아채지 못함\\n• 치료실에서 배운 '인사하고 질문하기'를 교실에서는 사용하지 않음\",\"q\":\"이 아동의 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"어휘·문법형태소와 복문 산출 훈련을 우선하여 실시한다\",\"치료실에서 대화 규칙을 설명하고 문제집으로 정답을 고르게 한다\",\"역할놀이·비디오 모델링과 또래 참여로 교실 일반화를 계획한다\",\"조음 정확도 훈련으로 말의 명료도를 높여 친구가 더 잘 반응하도록 한다\",\"관심사(공룡) 이야기를 금지하여 대화 주제 독점을 줄인다\"],\"answer\":3,\"explain\":\"대화 시작·주제 유지·상대 반응 읽기 등 화용 결함은 실제 상호작용 맥락에서 역할놀이·비디오 모델링·또래 매개 중재(소집단)로 연습하고 자연 환경(교실)으로 일반화를 계획해야 효과가 있다. 언어 형식이 정상이므로 ①·④는 표적이 틀리고, ②는 지식 수준에 그쳐 일반화가 어려우며, ⑤는 관심사를 금지하기보다 상대 반응에 맞춰 주제를 조절하도록 지도하는 것이 적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"화용·대화\",\"k\":\"화용 결함 일반화 중재\",\"p\":\"대화 시작·주제 유지 결함과 교실 미사용으로 중재 계획 선택\",\"n\":\"화용 중재: 역할놀이·비디오 모델링·또래 매개로 자연 환경 일반화\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"7세 다운증후군 아동\\n• 언어 이해가 표현보다 상대적으로 양호함\\n• 자발화 MLU가 짧고 조사·어미 생략이 잦음\\n• 숫자·낱말 따라말하기 등 청각적 단기기억이 매우 낮음\\n• 시각적 기억·그림 짝짓기 과제는 상대적 강점\\n• 저긴장으로 명료도가 낮음\",\"q\":\"이 아동의 강·약점 프로파일을 반영한 중재로 가장 적절한 것은?\",\"choices\":[\"청각 기억이 약하므로 긴 문장을 반복해서 들려주는 청각 훈련에 집중한다\",\"명료도가 낮으므로 구어를 중단하고 문자 소통으로 전환한다\",\"시각 지원을 병행하며 짧고 명확한 모델로 구문 산출을 목표로 한다\",\"이해가 양호하므로 표현 중재는 생략하고 이해 중심으로 진행한다\",\"시각 자료는 말에 집중하는 것을 방해하므로 사용하지 않는다\"],\"answer\":3,\"explain\":\"다운증후군은 이해 > 표현, 구문·문법형태소 취약, 청각적 단기기억 약점, 시각 처리 상대 강점이라는 전형적 프로파일을 보인다. 따라서 그림·글자·간단한 손짓 등 시각 지원을 병행해 구문·문법형태소 산출을 목표로 하고, 청각 기억 부담을 줄인 짧고 명확한 모델을 주는 것이 적절하다. ①·⑤는 약점에 부담을 주고 강점을 버리는 접근, ②는 구어 가능성을 포기하는 것, ④는 가장 취약한 표현 영역을 방치하는 것이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"대상군 특성\",\"k\":\"다운증후군 강약점 중재\",\"p\":\"이해 우위·청각 기억 약점·시각 강점 프로파일로 중재 선택\",\"n\":\"다운증후군: 이해>표현, 청각 단기기억 약점, 시각 강점 활용 구문 중재\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 3학년 언어장애 아동을 담당하는 언어재활사가 담임교사와 매주 협의하여 다음 주 교과 수업의 핵심 어휘·개념을 미리 파악하고, 일부 회기는 교실에서 수업 활동에 참여하며 아동을 지원한다. 교사에게는 수업 중 아동에게 사용할 언어 촉진 전략을 안내한다.\",\"q\":\"이 서비스 전달 모델의 명칭과 주요 장점으로 옳은 것은?\",\"choices\":[\"분리(pull-out) 모델 – 조용한 환경에서 집중 훈련이 가능하다\",\"의료 모델 – 손상 부위와 원인에 따른 개별 치료가 가능하다\",\"자문 모델만 적용 – 언어재활사가 아동을 직접 보지 않아 효율적이다\",\"비연속 개별시도 모델 – 반응 정확도를 정밀하게 측정한다\",\"교실 중심·협력적 모델 – 교육과정 연계로 실제 환경 일반화를 촉진한다\"],\"answer\":5,\"explain\":\"교사와 협력해 교육과정 어휘를 목표로 삼고 교실에서 직접 지원하며 교사에게 전략을 자문하는 것은 교실 중심(pull-in)·협력적 서비스 모델로, 교육과정과 연계된 목표를 통해 학령기 아동의 실제 환경 일반화와 학업 성취를 촉진하는 것이 장점이다. ①은 치료실 분리 방식, ③은 직접 서비스가 병행되므로 틀리며, ②·④는 서비스 전달 모델의 분류가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"교실 중심 협력 모델\",\"p\":\"교사 협의·교실 참여·전략 자문 방식으로 서비스 전달 모델 식별\",\"n\":\"교실 중심·협력적 모델: 교육과정 연계로 실제 환경 일반화 촉진\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"4세 아동의 목표 '두 낱말 요구하기(예: 물 주세요)'가 치료실에서 치료사와의 간식 활동에서는 3회기 연속 90% 이상 산출된다. 그러나 어머니 보고에 따르면 가정에서는 여전히 손으로 가리키거나 울며, 어린이집에서도 요구 발화가 관찰되지 않는다.\",\"q\":\"다음 단계의 계획으로 가장 적절한 것은?\",\"choices\":[\"어린이집에서 말할 때까지 가정에서 원하는 것을 주지 말도록 지도한다\",\"치료실 정확도가 높으므로 목표를 종결하고 세 낱말 조합으로 넘어간다\",\"치료실에서 같은 과제의 정확도를 100%까지 더 높인 뒤 기다린다\",\"가정에서 산출이 없으므로 목표를 재설정하고 치료실 훈련을 반복한다\",\"부모·교사를 훈련해 가정·어린이집 일과에서 일반화를 촉진한다\"],\"answer\":5,\"explain\":\"치료실 준거는 도달했으나 다른 환경에서 나타나지 않는 것은 자극·환경 일반화 실패이므로, 다음 단계는 가정·어린이집으로 중재 환경을 옮기고 부모·교사가 일과 속에서 요구 기회를 만들고 자연적 강화로 반응하도록 훈련하며 사람·장소·사물을 다양화하는 것이다. ②·③은 일반화 없이 종결하거나 치료실에 머무는 것이고, ④는 이미 습득된 기술을 불필요하게 재훈련하며, ①은 비윤리적이고 좌절만 유발한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"환경 일반화 촉진 계획\",\"p\":\"치료실 준거 도달과 가정·기관 미산출로 다음 단계 계획 선택\",\"n\":\"환경 일반화 실패 시 부모·교사 훈련으로 일과 속 요구 기회 제공\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"언어 지체가 있는 28개월 아동과 어머니의 10분 놀이 상호작용 관찰\\n• 어머니 발화의 약 80%가 \\\"이건 뭐야?\\\", \\\"이거 해 봐\\\" 같은 질문·지시\\n• 아동이 자동차를 굴리며 소리를 내면 어머니는 그 행동을 보지 않고 그림책을 읽어 주려 함\\n• 아동이 발성·몸짓으로 시작한 행동에 어머니가 반응하는 비율이 낮음\\n• 아동의 놀이 주제와 어머니의 놀이 주제가 자주 어긋남\",\"q\":\"이 관찰에 근거한 부모 코칭의 우선 목표로 가장 적절한 것은?\",\"choices\":[\"소리만 내면 반응하지 말고 낱말을 말할 때만 반응하게 한다\",\"아동이 말할 때까지 질문 횟수를 더 늘려 산출 기회를 확보하게 한다\",\"놀이보다는 그림카드로 낱말 이름대기를 매일 30분 훈련하게 한다\",\"어머니가 정한 주제로 놀이를 이끌어 아동이 따라오게 한다\",\"아동 주도 따르기·즉각 반응·확장 등 반응적 전략을 지도한다\"],\"answer\":5,\"explain\":\"지시·질문 위주의 성인 주도 상호작용과 아동의 시작 행동에 대한 낮은 반응성은 초기 언어 발달을 저해한다. 부모 매개 중재(Hanen 등)의 핵심은 관찰–기다리기–경청, 아동의 관심·주도 따라가기, 시작 행동에 즉시 반응하기, 행동·발성을 모방·해석해 말로 들려주고 확장하기 같은 반응적 상호작용 전략이다. ②·④는 성인 주도를 강화하고, ③은 자연스러운 상호작용을 훈련으로 대체하며, ①은 언어 이전 의사소통 시도를 무시해 시작 행동을 오히려 줄인다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"반응적 상호작용 부모 코칭\",\"p\":\"질문·지시 위주와 낮은 반응성 관찰로 부모 코칭 목표 선택\",\"n\":\"반응적 전략: 아동 주도 따르기·즉각 반응·모방·확장\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"자폐스펙트럼장애 아동 3명에게 그림교환 기반 '요구하기' 중재를 적용하려 한다.\\n• 목표행동: 자발적 요구하기 횟수\\n• 한 번 습득된 요구하기는 중재를 철회해도 쉽게 사라지지 않을 것으로 예상됨\\n• 중재 효과를 실험적으로 입증하고 싶으나, 습득된 기술을 일부러 되돌리는 것은 윤리적으로 부적절하다고 판단함\",\"q\":\"이 상황에 가장 적합한 단일대상연구 설계는?\",\"choices\":[\"대상자 간 중다기초선 설계\",\"ABAB(반전) 설계\",\"교대중재(중재교대) 설계\",\"단일 AB 설계\",\"기준변경(준거변경) 설계\"],\"answer\":1,\"explain\":\"대상자 간 중다기초선 설계는 여러 대상에게 시차를 두고 중재를 도입하여, 중재를 철회(반전)하지 않고도 중재가 시작된 대상에서만 변화가 나타남을 보여 실험적 통제를 입증한다. 비가역적 행동·윤리적 이유로 반전이 어려운 상황에 적합하다. ABAB는 중재 철회가 필요하므로 부적합하고, AB 설계는 실험적 통제가 없으며, 교대중재는 둘 이상의 중재를 비교할 때, 기준변경 설계는 이미 레퍼토리에 있는 행동의 수준을 단계적으로 높일 때 사용한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"연구·통계\",\"k\":\"단일대상연구 설계 선택\",\"p\":\"비가역적 행동과 반전 불가 조건으로 적합한 연구 설계 선택\",\"n\":\"대상자 간 중다기초선 설계: 시차 도입으로 반전 없이 실험적 통제 입증\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"단일대상연구 자료(정반응률 %)\\n• 기초선(A) 5회기: 20, 30, 25, 35, 30\\n• 중재(B) 8회기: 40, 30, 55, 60, 70, 65, 80, 85\",\"q\":\"비중복 자료 비율(PND)로 옳은 것은?\",\"choices\":[\"62.5%\",\"75.0%\",\"100%\",\"87.5%\",\"50.0%\"],\"answer\":4,\"explain\":\"PND는 기초선의 최고점(35)을 초과하는 중재기 자료점의 비율이다. 중재기 8개 중 35를 초과하는 값은 40, 55, 60, 70, 65, 80, 85의 7개이므로 7/8 = 87.5%이다. 두 번째 자료점(30)은 기초선 최고점과 중복되어 제외된다. ※PND 해석 기준(예: 90% 이상 매우 효과적, 70~90% 효과적 등)은 교재별로 확인 권장.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"연구·통계\",\"k\":\"PND 산출\",\"p\":\"기초선 최고점 초과 중재기 자료점 비율로 PND 산출\",\"n\":\"PND는 기초선 최고점을 초과하는 중재기 자료점 수를 전체 중재기 자료점 수로 나눈 비율\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"두 명의 언어재활사가 5세 아동의 자발화 60개 발화에 대해 형태소 분석을 독립적으로 수행하고, 발화별 형태소 수의 일치 여부를 비교하였다.\\n• 일치: 51개 발화\\n• 불일치: 9개 발화\",\"q\":\"발화별(point-by-point) 평가자 간 일치율과 그에 따른 판단으로 옳은 것은?\",\"choices\":[\"15%로, 분석 기준을 재정비한 뒤 전체 자료를 재분석한다\",\"51%로, 분석 기준을 재정비한 뒤 전체 자료를 재분석한다\",\"85%로, 수용 가능한 수준이며 분석 자료로 사용할 수 있다\",\"85%이나 90%에 못 미쳐 자료를 폐기하고 새로 수집한다\",\"567%로, 일치 수를 불일치 수로 나누어 산출한 값이다\"],\"answer\":3,\"explain\":\"발화별 일치율 = 일치 ÷ (일치 + 불일치) × 100 = 51 ÷ 60 × 100 = 85%이다. 일반적으로 80% 이상이면 수용 가능한 신뢰도로 본다. 51%·15%는 산출 오류이고, 90% 미만이라고 자료를 폐기하는 것은 과도한 조치이다. ※수용 기준(80% 또는 90%)은 교재·연구 설계에 따라 다를 수 있음.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"연구·통계\",\"k\":\"평가자 간 일치율 산출\",\"p\":\"일치·불일치 발화 수로 발화별 일치율을 계산해 수용 여부 판단\",\"n\":\"발화별 일치율=일치÷(일치+불일치)×100, 일반적으로 80% 이상 수용 가능\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"만 4세 6개월 아동의 표준화 언어검사 결과(평균 100, 표준편차 15)\\n• 수용어휘 표준점수 76\\n• 표현어휘 표준점수 94\\n• 검사 시 협조 양호, 청력 정상\",\"q\":\"이 결과의 해석과 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"수용어휘 지체로 보고 이해 중재를 우선하며 표현어휘는 모니터링한다\",\"표현어휘가 수용어휘보다 낮으므로 표현어휘 중재를 우선 실시한다\",\"수용어휘 76은 −1SD 이내의 경계선 수준이므로 관찰만 한다\",\"두 영역 모두 정상범위이므로 중재 없이 6개월 후 재평가한다\",\"표준점수 18점 차이는 측정 오차 범위로 두 영역을 동일 수준으로 본다\"],\"answer\":1,\"explain\":\"표준점수 76은 z = (76−100)/15 = −1.6SD로 백분위 약 5에 해당하여 지체 범위이고, 94는 −0.4SD로 정상범위이다. 따라서 수용어휘(이해)가 우선 중재 목표가 된다. 표현어휘가 더 낮다는 해석(2)과 −1SD 이내라는 해석(3)은 수치상 틀렸으며, 18점 차이는 1SD 이상으로 오차 범위로 보기 어렵다. ※지체 판정 절단점(−1SD, −1.25SD, −1.5SD, −2SD)은 검사·교재별로 확인 권장.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"통합 사례\",\"k\":\"표준점수 해석과 중재 우선순위\",\"p\":\"수용·표현어휘 표준점수의 SD 위치로 지체 영역과 중재 우선순위 판단\",\"n\":\"표준점수 76은 약 -1.6SD로 지체 범위, 94는 정상범위이므로 수용어휘 중재 우선\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"종합병원에 근무하는 언어재활사가 퇴근 후 개인 언어재활센터를 운영하고 있다. 병원에서 치료 중인 실어증 환자의 보호자에게 \\\"병원보다 제 센터에 오시면 더 자주 볼 수 있다\\\"며 자신의 센터 명함을 건네고 병원 치료 종결을 권유하였다.\",\"q\":\"이 행동에 대한 윤리적 판단과 바람직한 대처로 가장 적절한 것은?\",\"choices\":[\"환자에게 더 많은 치료 기회를 주는 것이므로 윤리적 문제가 없다\",\"병원장에게 사후 보고를 하면 윤리적 문제가 모두 해소된다\",\"보호자가 동의했다면 비밀유지 의무 위반이 아니어서 허용된다\",\"치료 강도를 높이려는 시도로 전문성 유지 의무에 부합한다\",\"이해상충 행위이며, 기관 의뢰 절차와 환자 선택권을 지켜야 한다\"],\"answer\":5,\"explain\":\"언어재활사는 내담자의 이익을 최우선으로 해야 하며, 자신의 경제적 이익을 위해 내담자를 유인하는 것은 이해상충(이중관계) 위반이다. 기관 간 의뢰가 임상적으로 필요하면 소속 기관의 절차를 따르고 환자의 자기결정권(기관 선택권)을 보장해야 한다. 이 사례의 핵심 쟁점은 비밀유지나 전문성 유지가 아니라 이해상충이며, 사후 보고만으로는 위반이 해소되지 않는다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"내담자 유인 이해상충\",\"p\":\"소속 기관 환자를 개인 센터로 유인한 행위의 윤리 쟁점 판단\",\"n\":\"경제적 이익을 위한 내담자 유인은 이해상충, 기관 의뢰 절차와 환자 선택권 보장\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"5세 아동이 치료실에 올 때마다 팔과 등에 새로운 멍이 있고, 놀이 중 \\\"아빠가 밤에 때려서 아파\\\"라고 말하였다. 보호자는 \\\"애가 잘 넘어진다\\\"고 하였다.\",\"q\":\"언어재활사의 대처로 가장 적절한 것은?\",\"choices\":[\"학대 증거가 확실해질 때까지 몇 주 더 관찰한 뒤 신고 여부를 결정한다\",\"보호자에게 사실 여부를 먼저 따져 물은 뒤, 인정하면 신고한다\",\"기관장에게 구두로 보고하는 것으로 신고 의무를 다한 것으로 본다\",\"즉시 112에 신고하고, 관찰한 내용을 객관적으로 기록해 둔다\",\"아동에게 반복 질문하여 피해 진술을 상세히 확보한 뒤 신고한다\"],\"answer\":4,\"explain\":\"아동학대는 '의심'만으로도 즉시 신고해야 하며, 확증을 기다리거나 보호자에게 먼저 확인하는 것은 아동을 더 위험하게 할 수 있다. 재활·복지·의료기관 종사자는 아동학대 신고의무자에 해당하므로 정당한 사유 없이 신고하지 않으면 과태료 대상이 된다. 기관 내 보고는 신고를 대신하지 못하고, 아동에게 반복 질문하는 것은 2차 피해와 진술 오염을 초래할 수 있다. ※신고의무자 범위·과태료 등 법 조항은 최신 「아동학대처벌법」 기준으로 확인 권장.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"법·제도\",\"k\":\"아동학대 신고의무\",\"p\":\"학대 의심 정황에서 신고의무자의 적절한 대처 선택\",\"n\":\"아동학대는 의심만으로 즉시 신고, 기관 내 보고는 신고를 대신하지 못함\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"36개월 말늦은 아동의 어머니가 인터넷에서 본 '구강 감각 브러싱 프로그램'을 언어치료 대신 해 달라고 강하게 요청하였다. 언어재활사가 문헌을 검토한 결과, 해당 프로그램이 언어 산출을 향상시킨다는 통제된 연구 근거는 확인되지 않았다.\",\"q\":\"근거기반실제(EBP)에 따른 가장 적절한 대응은?\",\"choices\":[\"보호자의 요구가 우선이므로 요청한 브러싱 프로그램만 시행한다\",\"보호자 의견은 배제하고 치료사가 정한 프로그램만 시행한다\",\"근거를 설명하고, 입증된 대안을 제안해 가족과 함께 결정한다\",\"근거가 없는 중재를 요구하므로 치료를 종결하고 타 기관을 안내한다\",\"임상 경험상 효과를 본 사례가 있다면 근거로 충분하므로 시행한다\"],\"answer\":3,\"explain\":\"EBP는 ①최선의 연구 근거 ②임상 전문성 ③내담자·가족의 가치와 선호를 통합하여 의사결정하는 것이다. 근거 검토 결과를 이해하기 쉽게 설명하고 효과가 입증된 대안(예: 부모 실행 언어촉진)을 제시하면서 가족의 우선순위·가치를 반영해 공동으로 결정하는 것이 세 요소를 모두 반영한다. 보호자 요구만 따르거나(1), 가족 가치를 배제하거나(2), 종결하거나(4), 개인 경험만을 근거로 삼는 것(5)은 EBP의 어느 한 요소만 취하거나 모두 무시한 대응이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"상담\",\"k\":\"근거기반실제 보호자 대응\",\"p\":\"근거 없는 중재 요구 상황에서 EBP 3요소를 통합한 대응 선택\",\"n\":\"EBP는 연구 근거·임상 전문성·내담자 가치의 통합, 근거 설명 후 대안 제시와 공동 결정\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"회기 기록 내용\\n㉠ 어머니: \\\"주말에 집에서 '물 주세요'를 스스로 두 번 말했어요.\\\"\\n㉡ 그림 자극 20개 중 14개(70%)에서 2어 조합을 자발 산출, 구어 촉진 시 18개(90%)\\n㉢ 지난 회기(55%) 대비 향상되었으나 준거(80%, 3회기 연속)에는 아직 미달\\n㉣ 다음 회기부터 촉진을 시간지연으로 점차 줄이고 놀이 상황으로 확장\",\"q\":\"SOAP 기록 형식에서 각 항목이 해당하는 영역으로 옳은 것은?\",\"choices\":[\"㉠ O, ㉡ S, ㉢ A, ㉣ P\",\"㉠ S, ㉡ A, ㉢ O, ㉣ P\",\"㉠ S, ㉡ O, ㉢ A, ㉣ P\",\"㉠ A, ㉡ O, ㉢ P, ㉣ S\",\"㉠ S, ㉡ O, ㉢ P, ㉣ A\"],\"answer\":3,\"explain\":\"S(주관적)는 보호자·대상자의 보고(㉠), O(객관적)는 측정·관찰된 수행 자료(㉡), A(평가)는 자료에 대한 임상적 해석과 진전 판단(㉢), P(계획)는 다음 회기 계획(㉣)이다. 수치 자료(㉡)를 주관적 정보로, 진전 판단(㉢)을 객관적 자료로 분류한 보기는 틀렸다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"SOAP 기록 구분\",\"p\":\"회기 기록 각 내용의 성격에 따라 SOAP 영역 식별\",\"n\":\"SOAP: S 보호자 보고, O 측정 자료, A 임상적 해석·진전 판단, P 다음 회기 계획\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"지적장애 6세 아동은 언어재활사가 \\\"이거 뭐야? 사과\\\"라고 완전한 구어 모델을 제시할 때만 '사과'를 산출하며, 모델 없이 자발적으로 명명하는 경우는 거의 없다. 모델 제공 조건에서의 정반응률은 95%에 이르렀다.\",\"q\":\"촉진 의존을 줄이고 자발 산출을 늘리기 위한 절차로 가장 적절한 것은?\",\"choices\":[\"매 시행마다 완전 구어 모델을 계속 제공하여 정확도를 유지한다\",\"모델 제시 전 대기 시간을 점차 늘리는 시간지연을 적용한다\",\"촉진 강도를 더 높여 모델과 함께 신체적 촉진을 추가한다\",\"촉진을 한 번에 모두 제거하고 오반응이 나오면 무시한다\",\"정반응이 나올 때까지 같은 자극을 연속 10회 반복 제시한다\"],\"answer\":2,\"explain\":\"습득이 완료된 반응이 촉진에 의존할 때는 자극 제시 후 모델 제공까지의 대기 시간을 0초에서 2초, 4초로 점진적으로 늘리는 시간지연 절차로 촉진을 체계적으로 소거하여 자극 통제를 촉진에서 자연 자극으로 옮긴다. 촉진을 계속 주면 의존이 유지되고, 한 번에 제거하면 오류가 급증하며, 촉진 강도를 높이는 것은 오히려 의존을 강화한다. 단순 반복 제시는 촉진 소거 원리에 해당하지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"통합 사례\",\"k\":\"시간지연 촉진 소거\",\"p\":\"모델 촉진 의존 양상으로 자발 산출 유도 절차 선택\",\"n\":\"시간지연: 모델 제공 전 대기 시간을 점진적으로 늘려 촉진을 체계적으로 소거\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"5세 언어발달지연 아동에게 세 가지 목표(과거시제 '-았/었-', 조사 '-에서', 접속어 '그래서')를 설정하였다. 언어재활사는 한 목표를 3회기씩 다루되, 아동이 준거에 도달하지 않더라도 정해진 회기가 끝나면 다음 목표로 넘어가고, 세 목표를 한 바퀴 돈 뒤 다시 첫 목표로 돌아오도록 계획하였다.\",\"q\":\"이 계획에 해당하는 목표 공격 전략과 그 근거로 옳은 것은?\",\"choices\":[\"주기적 접근 – 여러 형태가 동시에 점진적으로 발달함을 반영\",\"수직적 접근 – 한 목표를 준거까지 집중 훈련한 뒤 다음 목표로 이동\",\"수평적 접근 – 여러 목표를 한 회기 안에서 준거 도달까지 동시에 훈련\",\"위계적 접근 – 발달 순서대로 한 목표씩 준거까지 순차적으로 훈련\",\"선택적 접근 – 아동이 선호하고 흥미를 보이는 목표만 골라 훈련\"],\"answer\":1,\"explain\":\"정해진 기간 동안 각 목표를 다루고 준거 도달과 무관하게 순환하는 방식은 주기적(cyclical) 접근이며, 여러 형태가 점진적·동시적으로 발달한다는 자연 습득 원리를 반영한다. 수직적 접근은 준거 도달까지 한 목표만 훈련하고, 수평적 접근은 한 회기 안에 여러 목표를 동시에 준거까지 훈련하므로 이 계획과 다르다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"통합 사례\",\"k\":\"목표 공격 전략 구분\",\"p\":\"준거와 무관하게 목표를 순환하는 계획으로 목표 공격 전략 식별\",\"n\":\"주기적 접근: 정해진 기간씩 목표 순환, 여러 형태의 점진적·동시적 발달 반영\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"7세 말소리장애 아동이 치료실에서 /ㅅ/ 어두·어중·어말 낱말 수준에서 3회기 연속 90% 이상 정조음하여 준거에 도달하였다. 그러나 보호자는 집과 학교 대화에서는 여전히 /ㅅ/→[ㄷ] 오류가 많다고 보고하였다.\",\"q\":\"이 시점에서 가장 적절한 결정은?\",\"choices\":[\"치료실 준거를 충족하였으므로 즉시 종결하고 추후 점검만 한다\",\"낱말 수준을 처음부터 다시 반복하여 정확도를 더 높인다\",\"일반화는 자연히 일어나므로 회기를 늘리지 않고 기다린다\",\"목표음을 /ㅈ/으로 바꾸어 새로운 목표 훈련을 시작한다\",\"대화 수준·다양한 상황으로 확장하고 보호자 훈련을 병행한다\"],\"answer\":5,\"explain\":\"종결 결정은 치료실 준거뿐 아니라 일상 상황으로의 일반화 자료를 근거로 해야 한다. 이 아동은 낱말 수준에서만 준거에 도달했으므로 문장·대화 수준으로 확장하고 상황·대화 상대를 다양화하며 보호자를 훈련하여 일반화를 프로그래밍한 뒤, 회기 간격을 늘리는 점진적 종결과 추후 점검을 계획한다. 즉시 종결·자연 대기는 일반화 실패를 방치하고, 낱말 수준 반복이나 목표 변경은 현재 문제(일반화)를 다루지 못한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"통합 사례\",\"k\":\"일반화·종결 결정\",\"p\":\"치료실 준거 도달과 일상 전이 실패로 다음 결정 선택\",\"n\":\"종결은 일상 일반화 자료로 결정, 대화 수준·상황 확대와 보호자 훈련으로 일반화 프로그래밍\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"통합어린이집의 4세 아동에게 '또래에게 먼저 말이나 몸짓으로 의사소통을 시작하기'를 목표로 설정하였다. 자유놀이 30분 동안 이 행동은 하루 2~5회 정도 드물게 나타나며, 시작과 끝이 분명하다.\",\"q\":\"이 목표행동의 진전을 측정하기에 가장 적합한 자료수집 방법은?\",\"choices\":[\"지속시간 기록법(각 시도가 이어진 시간을 초 단위로 잰다)\",\"영속적 산물 기록법(활동 후 남은 결과물을 확인한다)\",\"부분간격 기록법(10초 간격 중 한 번이라도 발생하면 기록한다)\",\"지연시간 기록법(교사 지시 후 반응까지의 시간을 잰다)\",\"사건(빈도) 기록법(관찰 시간 중 발생 횟수를 센다)\"],\"answer\":5,\"explain\":\"시작과 끝이 분명한 이산 행동이 낮은 빈도로 나타날 때는 사건(빈도) 기록이 가장 적합하며, 관찰 시간이 달라질 수 있으므로 비율(회/분)로 환산한다. 지속시간·지연시간 기록은 '얼마나 오래·얼마나 빨리'가 목표일 때, 간격기록은 고빈도이거나 지속적인 행동에, 영속적 산물 기록은 결과물이 남는 행동에 적합하다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"연구·통계\",\"k\":\"행동 자료수집 방법\",\"p\":\"목표행동의 빈도와 시작·끝 명확성으로 기록법 선택\",\"n\":\"시작과 끝이 분명한 저빈도 이산 행동은 사건(빈도) 기록법, 필요 시 비율로 환산\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"초등 2학년 특수교육대상 아동(경도 지적장애)이 통합학급에서 교사의 지시 이해와 발표에 어려움을 보인다. 개별 치료실에서는 목표 문장을 잘 산출하지만 교실에서는 거의 사용하지 않는다. 담임교사는 교실에서 어떻게 도와야 할지 모르겠다고 한다.\",\"q\":\"이 아동에게 가장 적절한 서비스 전달 모형은?\",\"choices\":[\"분리(pull-out) 개별치료의 회기 수를 두 배로 늘린다\",\"교사에게 치료 보고서만 전달하고 교실 지원은 교사에게 맡긴다\",\"치료실에서 교과 학습지를 풀게 하여 학업 내용을 보충한다\",\"교실 기반 협력 모형으로 수업 중 목표를 다루고 교사를 코칭한다\",\"아동을 특수학급으로 전일 배치하여 집중 지도하도록 권고한다\"],\"answer\":4,\"explain\":\"치료실에서 습득한 기술이 교실로 일반화되지 않고 교사가 지원 방법을 모르는 상황에서는, 실제 교실 맥락에서 목표를 훈련하고 교사와 협력하는 교실 기반·협력 모형이 적합하다. 분리 치료를 늘리는 것은 일반화 문제를 해결하지 못하고, 보고서 전달만으로는 교사 역량이 강화되지 않으며, 학습지 풀이나 전일 특수학급 배치는 의사소통 목표와 최소제한환경 원칙에 맞지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"윤리·역할\",\"k\":\"서비스 전달 모형 선택\",\"p\":\"치료실 기술의 교실 일반화 실패와 교사 요구로 서비스 모형 선택\",\"n\":\"교실 기반 협력 모형: 실제 교실 맥락에서 목표를 다루고 교사를 코칭\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"도서 지역에 거주하는 5세 말소리장애 아동의 보호자가 화상 원격 언어치료를 요청하였다. 아동은 화면 주의집중이 짧은 편이고, 가정에는 태블릿과 인터넷이 있다.\\n\\nㄱ. 아동의 원격치료 적합성(주의집중·청각 환경·기기 조작 등)을 사전에 평가한다\\nㄴ. 보호자를 회기 보조자(e-helper)로 교육하여 자료 제시·촉진을 돕게 한다\\nㄷ. 개인정보 보호가 가능한 보안 플랫폼을 사용하고, 녹화 시 사전 동의를 받는다\\nㄹ. 원격치료에서는 대면치료와 달리 자격·윤리 기준이 완화되어 적용된다\",\"q\":\"원격치료 실시 전 고려사항으로 옳은 것을 모두 고른 것은?\",\"choices\":[\"ㄱ, ㄴ\",\"ㄱ, ㄴ, ㄷ\",\"ㄴ, ㄹ\",\"ㄱ, ㄷ, ㄹ\",\"ㄱ, ㄴ, ㄷ, ㄹ\"],\"answer\":2,\"explain\":\"원격치료는 대상자 적합성 평가, 현장 보조자(e-helper) 교육, 보안 플랫폼과 녹화 동의 등 개인정보 보호가 필수이다. 원격치료도 대면치료와 동일한 자격·윤리·서비스 질 기준이 적용되므로 ㄹ은 틀렸다. 주의집중이 짧은 아동일수록 보호자 보조자 역할이 중요하다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"원격치료 사전 고려사항\",\"p\":\"원격치료 실시 전 필요 조건과 적용 기준의 옳고 그름 판단\",\"n\":\"원격치료는 적합성 평가·e-helper 교육·보안과 동의가 필수, 자격·윤리 기준은 대면과 동일\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"자폐스펙트럼장애 평가 결과를 들은 아버지가 \\\"우리 애는 눈도 잘 맞추는데 검사가 잘못된 거 아닙니까? 선생님이 뭘 안다고요\\\"라며 언성을 높였다.\",\"q\":\"언어재활사의 반응으로 가장 적절한 것은?\",\"choices\":[\"검사 점수표를 다시 보여주며 결과가 객관적임을 조목조목 입증한다\",\"진단명을 언급하지 않기로 하고 결과 설명을 모두 생략한다\",\"부정하는 반응은 협조 거부이므로 상담을 종료하고 다른 기관을 안내한다\",\"\\\"아버님이 인정하지 않으면 아이가 더 나빠집니다\\\"라고 경고한다\",\"\\\"많이 놀라고 속상하셨겠어요\\\"라고 감정을 먼저 반영한다\"],\"answer\":5,\"explain\":\"진단 통보 후 부정·분노는 정상적인 애도 반응이다. 상담자는 먼저 반영적 경청과 공감으로 감정을 수용하고, 보호자가 정보를 받아들일 준비가 되었을 때 구체적 관찰 근거를 함께 살펴보며 단계적으로 공유해야 한다. 즉각적 논증(1)이나 경고(4)는 방어를 강화하고, 상담 종료(3)나 정보 생략(2)은 보호자의 알 권리와 라포 형성에 어긋난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"상담\",\"k\":\"진단 통보 후 부정 반응\",\"p\":\"진단 결과에 분노하는 보호자에게 적절한 상담 반응 선택\",\"n\":\"진단 후 부정·분노는 정상적 애도 반응, 감정 반영과 공감으로 먼저 수용\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"6세 남아. 3개월 이상 지속되는 쉰 목소리로 어린이집 교사가 언어재활센터에 의뢰하였다. 아동은 소리 지르기가 잦고, 최근 목소리가 자주 갈라지며 말할 때 숨이 찬다고 한다. 이비인후과 진료를 받은 적은 없다.\",\"q\":\"언어재활사의 대처로 가장 적절한 것은?\",\"choices\":[\"진단 의뢰 없이 음성위생 교육과 음성치료를 즉시 시작한다\",\"성장하면 저절로 좋아지므로 경과 관찰만 하도록 권한다\",\"쉰 목소리는 소리 지르기 때문이므로 조음치료로 대체해 진행한다\",\"이비인후과 후두 검진을 먼저 의뢰하고 진단에 따라 계획한다\",\"보호자에게 약국에서 목 스프레이를 구입하도록 안내한다\"],\"answer\":4,\"explain\":\"지속되는 음성 문제는 성대결절 외에도 유두종·낭종 등 의학적 처치가 필요한 병변일 수 있으므로, 음성치료 전에 이비인후과 후두 검진(후두내시경)으로 원인을 확인하고 의학적 진단을 바탕으로 치료 계획을 세운다. 진단 없이 치료를 시작하거나(1) 경과만 관찰하는 것(2)은 병변을 놓칠 수 있고, 조음치료 대체(3)나 약 구입 안내(5)는 언어재활사의 업무 범위와 의뢰 원칙에 맞지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"윤리·역할\",\"k\":\"지속 애성 의뢰 원칙\",\"p\":\"진료 이력 없는 지속 음성 문제에서 치료 전 조치 선택\",\"n\":\"지속되는 음성 문제는 음성치료 전 이비인후과 후두 검진으로 의학적 원인 확인\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"18개월 발달지연 영아의 조기개입 팀에 언어재활사·작업치료사·물리치료사·특수교사가 참여한다. 팀은 가족 부담을 줄이기 위해 함께 평가(아레나 평가)하고, 가족과 가장 자주 만나는 특수교사 1명이 주 서비스 제공자가 되어, 다른 전문가가 훈련해 준 언어촉진·자세 지원 전략을 가정 일과에서 통합적으로 실행하도록 하였다.\",\"q\":\"이 팀 모형과 그 핵심 특징으로 옳은 것은?\",\"choices\":[\"다학문적 팀 – 각 전문가가 독립적으로 평가·중재하고 결과만 공유한다\",\"초학문적 팀 – 역할방출을 통해 한 전문가가 통합적으로 중재를 실행한다\",\"다학문적 팀 – 공동 평가 후 한 전문가에게 다른 전문가의 역할을 방출한다\",\"간학문적 팀 – 각자 평가하되 계획을 공동으로 수립하고 중재는 각자 실행한다\",\"협의형 팀 – 언어재활사는 자문만 제공하고 평가에는 참여하지 않는다\"],\"answer\":2,\"explain\":\"공동(아레나) 평가, 역할방출, 주 서비스 제공자를 통한 통합 중재는 초학문적 팀 모형의 핵심 특징이다. 다학문적 팀은 독립적 평가·중재 후 결과만 공유하고, 간학문적 팀은 계획은 공동으로 세우되 중재는 각 전문가가 따로 실행한다. 역할방출은 다학문적 팀의 특징이 아니다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"조기개입 팀 모형 구분\",\"p\":\"공동 평가와 주 서비스 제공자 운영 방식으로 팀 모형 식별\",\"n\":\"초학문적 팀: 아레나 평가, 역할방출, 주 서비스 제공자의 통합 중재\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"어린이집 담임교사가 전화로 \\\"우리 반 아동의 언어평가 결과와 진단명을 알려 달라. 교육에 참고하겠다\\\"고 요청하였다. 보호자에게는 이 요청에 대해 아직 알리지 않은 상태이다.\",\"q\":\"가장 적절한 대처는?\",\"choices\":[\"보호자 서면 동의를 받은 뒤 필요한 범위에서 제공한다\",\"진단명은 알려주지 않고 표준점수 등 수치 결과만 알려준다\",\"교사가 소속 기관 공문을 보내면 보호자 동의 없이 제공한다\",\"먼저 교사에게 결과를 제공한 뒤 보호자에게 사후 통보한다\",\"교육 목적의 요청이므로 요약 결과를 전화로 알려준다\"],\"answer\":1,\"explain\":\"평가 결과·진단명은 민감한 개인정보이므로 제3자 제공에는 정보주체(보호자)의 명시적 동의가 필요하며, 동의서에는 제공 목적·범위·대상이 포함되어야 한다. 교육 목적, 기관 공문, 부분 정보 제공, 사후 통보는 모두 동의 없는 제공에 해당하여 비밀유지 의무와 개인정보보호 원칙에 위배된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"윤리·역할\",\"k\":\"평가 정보 제3자 제공\",\"p\":\"교사의 결과 요청 상황에서 개인정보 제공 절차 선택\",\"n\":\"평가 결과·진단명의 제3자 제공은 보호자 서면 동의 후 필요한 범위에서만 허용\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활센터 원장(1급 언어재활사)이 자격이 없는 직원에게 자신의 자격증을 빌려주어, 언어재활사 명의로 아동 치료를 하게 하였다.\",\"q\":\"「장애인복지법」상 이 원장에 대한 조치로 옳은 것은?\",\"choices\":[\"보수교육을 추가로 이수하면 갈음된다\",\"1회 위반이므로 경고 처분에 그친다\",\"자격증 대여는 자격 취소 사유에 해당한다\",\"최대 1년 이내의 자격정지만 가능하다\",\"원장은 처분 대상이 아니고 직원만 책임진다\"],\"answer\":3,\"explain\":\"「장애인복지법」은 언어재활사가 자격증을 다른 사람에게 대여한 경우를 자격 취소 사유로 규정하며, 대여받거나 알선한 사람도 처벌 대상이다. 경고·보수교육·자격정지로 갈음되지 않고, 대여한 원장 본인이 처분 대상이다. ※자격취소·정지 사유의 세부 조항(제74조 등)과 벌칙은 최신 법령으로 확인 권장.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"법·제도\",\"k\":\"자격증 대여 처분\",\"p\":\"자격증 대여 행위에 대한 장애인복지법상 처분 판단\",\"n\":\"장애인복지법상 언어재활사 자격증 대여는 자격 취소 사유, 대여한 본인이 처분 대상\"}},{\"grade\":1,\"set\":2,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"24개월 아동이 표현 낱말 8개로 말늦은 아동에 해당하며, 이해력과 놀이·상징 발달은 연령 수준이다. 맞벌이 부모는 주 1회 센터 방문도 어렵다고 호소하며, 집에서 어떻게 도와야 할지 모르겠다고 한다.\",\"q\":\"이 가족에게 가장 적절한 중재 접근은?\",\"choices\":[\"센터 방문을 주 3회로 늘려 치료사 주도의 개별치료를 집중 실시한다\",\"가정 일과 속 언어촉진 전략을 부모가 실행하도록 코칭한다\",\"이해력이 정상이므로 만 3세까지 아무 중재 없이 기다린다\",\"어린이집에 보내는 것만으로 충분하므로 별도 중재는 하지 않는다\",\"보호자에게 매일 낱말 카드 학습지를 풀게 하도록 지시한다\"],\"answer\":2,\"explain\":\"조기개입은 가족중심·일과 기반 실제가 원칙이며, 말늦은 아동에게는 부모 실행 언어촉진 중재의 근거가 확립되어 있다. 식사·목욕·놀이 등 가정 일과에 모델링·확장·기다리기 같은 전략을 심도록 부모를 코칭하고, 필요 시 화상 코칭을 병행하며 정기적으로 진전을 점검한다. 가족의 시간 제약을 고려하면 치료사 주도 방문 증가(1)는 실현 가능성이 낮고, 학습지(5)는 영아의 자연스러운 언어 습득에 맞지 않으며, 위험 요인이 있는 아동을 무중재로 기다리거나(3) 어린이집에만 맡기는 것(4)은 적절한 모니터링·촉진을 놓치게 한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"상담\",\"k\":\"말늦은 아동 부모 코칭\",\"p\":\"말늦은 아동과 가족 시간 제약을 고려해 중재 접근 선택\",\"n\":\"말늦은 아동에는 가족중심·일과 기반의 부모 실행 언어촉진 중재 코칭\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 52세 여성, 갑상샘 절제술 2개월 후부터 약하고 기식적인 음성, 물 마실 때 가끔 사레\\n• 후두내시경: 우측 성대가 부정중위(paramedian)에서 고정, 발성 시 성문틈, 가성대의 보상적 과내전\\n• 후두근전도(LEMG): 우측 갑상피열근에서 재신경화 징후(다상성 운동단위전위) 관찰\\n• 환자는 교사로 복직을 앞두고 있음\",\"q\":\"이 시점에서 가장 적절한 관리 계획은?\",\"choices\":[\"회복 가능성이 낮으므로 즉시 제I형 갑상성형술(영구 내측화)을 시행한다\",\"신경 회복을 위해 완전 회복 시까지 절대 음성휴식과 필담만 유지한다\",\"성대 과내전을 막기 위해 우측 갑상피열근에 보툴리눔 독소를 주입한다\",\"음성치료·삼킴 안전 전략을 우선하고 필요 시 일시적 주입술을 고려한다\",\"재신경화 징후는 예후와 무관하므로 즉시 후두신경 재건술을 시행한다\"],\"answer\":4,\"explain\":\"수술 후 2개월이고 LEMG에서 재신경화 징후가 있으면 자연 회복 가능성이 있으므로 비가역적 영구 수술(갑상성형술)은 시기상조이다. 이 시기에는 성대내전 촉진 훈련과 가성대 과보상 감소, 삼킴 안전 전략을 우선하고, 직업적 요구가 크면 흡수성 재료로 일시적 성대주입술을 병행하며 통상 6~12개월 회복 관찰 후 영구 내측화를 결정한다. 보툴리눔 독소는 마비된 성대의 내전을 더 악화시키고, 절대 음성휴식은 성문폐쇄부전 회복에 도움이 되지 않으며 오히려 보상 기전 학습 기회를 잃게 한다. ※영구 수술 결정 시기(6~12개월)는 교재·기관별로 차이가 있을 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"편측 성대마비 초기 관리\",\"p\":\"술후 경과 기간과 재신경화 징후로 관리 우선순위 선택\",\"n\":\"재신경화 징후가 있는 초기 편측마비는 영구 수술 보류, 음성치료·삼킴 전략과 일시적 주입술\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 56세 여성, 30년간 하루 한 갑 흡연, 최근 전화에서 남성으로 오해받는 일이 잦음\\n• 목소리가 낮고 거칠며 아침에 특히 심하고, 잦은 헛기침·속쓰림 동반\\n• 후두내시경: 양측 성대 전장에 걸친 광범위한 반투명 물주머니 모양의 부종, 성대 상면이 흔들림\\n• 음향분석: 습관적 F0 128 Hz(동연령 여성 규준보다 현저히 낮음)\",\"q\":\"이 사례의 감별과 중재 우선순위로 가장 적절한 것은?\",\"choices\":[\"라인케부종 – 금연·역류 관리를 우선하고, 지속 시 수술을 고려한다\",\"성대낭종 – 즉시 후두미세수술을 시행한 뒤 음성치료를 실시한다\",\"라인케부종 – 음도 높이기 훈련만으로 정상 음도와 병변 회복이 가능하다\",\"성대결절 – 반폐쇄성도훈련만으로 양측 병변 소실을 기대할 수 있다\",\"재발성 후두유두종 – 항바이러스 치료와 레이저 절제를 의뢰한다\"],\"answer\":1,\"explain\":\"양측 성대 전장의 광범위·반투명 부종, 장기 흡연력, 현저히 낮은 F0(여성의 남성화된 음성)는 라인케부종(폴립양 변성)의 전형이다. 원인(흡연·역류·음성 남용) 제거가 일차 과제이며, 원인이 지속되면 수술 후 재발하므로 금연 없이 수술만 하는 것은 의미가 적다. 원인 제거 후에도 부종·음성 문제가 지속되면 미세수술과 수술 전후 음성치료를 병행한다. 부종은 기계적 원인이 아니라 점막 고유층의 액체 저류이므로 음도 훈련이나 SOVT만으로 병변이 소실되지는 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"라인케부종 감별\",\"p\":\"흡연력·광범위 반투명 부종·낮은 F0로 병변 감별과 중재 판단\",\"n\":\"라인케부종: 흡연·역류 관련 양측 전장 부종과 낮은 음도, 원인 제거 우선 후 지속 시 수술\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 34세 여성 보육교사, 6개월간 지속된 쉰 목소리\\n• 스트로보스코피: 좌측 성대 막성부 중간의 점막 아래 둥근 백색 병변, 해당 부위 점막파동 소실; 우측 대응 부위에 작은 반응성 부종\\n• 3개월간 음성위생·SOVT 음성치료 실시 → 음성 남용 행동 감소, 우측 부종은 줄었으나 좌측 병변과 음질은 변화 없음\",\"q\":\"가장 적절한 다음 단계는?\",\"choices\":[\"구조적 문제가 아니므로 심인성 음성장애로 보고 정신건강의학과에 의뢰한다\",\"성대결절이 남은 것으로 판단하고 동일한 음성치료를 6개월 더 연장한다\",\"성대폴립으로 판단하고 흡입 스테로이드와 항역류제를 처방받도록 한다\",\"성대낭종으로 보고 후두미세수술 의뢰와 수술 전후 음성치료를 병행한다\",\"양측 병변이므로 양측 성대를 동시에 절제한 뒤 4주간 절대 음성휴식을 취하게 한다\"],\"answer\":4,\"explain\":\"편측성·점막하 병변, 해당 부위의 점막파동 소실, 반대측의 반응성 병변, 그리고 음성치료에 반대측 부종은 반응하나 원발 병변은 반응하지 않는 경과는 성대낭종의 특징이다. 낭종은 행동적 치료로 소실되지 않으므로 미세수술이 필요하며, 수술 전 남용 행동 제거와 수술 후 발성 재교육을 병행한다. 결절은 양측·대칭성이고 점막파동이 보존되며 음성치료에 반응하고, 반응성 부종을 결절로 오인해 양측을 동시에 절제하면 반흔·성대 유착 위험이 커진다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"성대낭종 다음 단계\",\"p\":\"편측 점막하 병변과 음성치료 무반응 경과로 다음 조치 선택\",\"n\":\"성대낭종: 편측·점막파동 소실·행동치료 무반응, 미세수술과 수술 전후 음성치료 병행\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음성범위프로파일(VRP) 결과\\n• 최저 기본주파수: 98 Hz\\n• 최고 기본주파수: 392 Hz\\n• 강도 범위: 55~92 dB SPL\",\"q\":\"이 대상자의 음도 범위를 반음(semitone) 단위로 계산하면?\",\"choices\":[\"12 반음\",\"18 반음\",\"36 반음\",\"30 반음\",\"24 반음\"],\"answer\":5,\"explain\":\"반음 수 = 12 × log₂(최고 F0 ÷ 최저 F0) = 12 × log₂(392 ÷ 98) = 12 × log₂(4) = 12 × 2 = 24 반음(2옥타브). 주파수가 2배가 될 때마다 1옥타브(12반음)이므로 4배는 2옥타브이다. Hz 차이(294 Hz)를 그대로 쓰면 음도 지각의 대수적 특성을 반영하지 못하므로 반드시 비율로 계산한다. ※정상 성인의 VRP 음역 규준(대개 약 24~36반음)은 교재별로 다를 수 있음.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"VRP 반음 범위 산출\",\"p\":\"최고·최저 기본주파수 비율로 음도 범위 반음 수 산출\",\"n\":\"반음 수=12×log2(최고 F0÷최저 F0), 주파수 2배마다 1옥타브(12반음)\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 61세 남성, 약하고 기식적인 음성\\n• 폐활량(VC): 3,500 mL\\n• 최대연장발성시간(MPT): 7초\",\"q\":\"이 환자의 발성지수(phonation quotient, PQ)와 그 시사점으로 옳은 것은?\",\"choices\":[\"175 mL/s – 정상 범위로 발성 효율과 성문폐쇄에 문제가 없다\",\"250 mL/s – 성대 과내전으로 인한 높은 후두저항을 시사한다\",\"350 mL/s – 정상 범위로 호흡 지지와 성문폐쇄가 양호하다\",\"500 mL/s – 성대 과내전으로 인한 높은 후두저항을 시사한다\",\"500 mL/s – 성문폐쇄부전 등으로 인한 공기 낭비를 시사한다\"],\"answer\":5,\"explain\":\"PQ = 폐활량 ÷ MPT = 3,500 mL ÷ 7 s = 500 mL/s. PQ는 발성 1초당 소모되는 공기량의 추정치로, 값이 클수록 같은 공기로 짧게밖에 발성하지 못한다는 뜻이며 성문폐쇄부전(성대마비·위축 등)으로 공기가 새어 나가는 상태를 시사한다. 성대 과내전은 오히려 호기류가 줄어 PQ가 낮아지는 방향이다. ※PQ 정상 범위(대략 120~200 mL/s 내외)는 교재·연령별 규준에 따라 차이가 있음.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"발성지수(PQ) 산출\",\"p\":\"폐활량과 MPT로 PQ를 계산해 공기 효율의 의미 판단\",\"n\":\"PQ=폐활량÷MPT, 값이 크면 성문폐쇄부전 등으로 인한 공기 낭비 시사\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 47세 여성, 3년 전부터 서서히 시작되어 점차 악화된 음성 문제\\n• 말할 때 목소리가 쥐어짜듯 끊기며, 특히 모음으로 시작하는 낱말('아침', '오늘')과 전화 통화에서 심함\\n• 노래·웃음·속삭임에서는 거의 정상\\n• 후두 촉진: 압통 없음, 후두 높이 정상\\n• 8주간 후두마사지·SOVT 중심 음성치료 → 변화 없음\\n• 후두내시경: 구조적 병변 없음, 발성 중 불규칙한 성대 과내전 연축\",\"q\":\"이 사례의 감별과 다음 중재로 가장 적절한 것은?\",\"choices\":[\"근긴장성 발성장애 – 후두마사지와 SOVT를 12주 더 지속한다\",\"심인성 발성장애 – 정신건강의학과 의뢰 후 증상 소거 치료를 한다\",\"내전형 연축성발성장애 – 갑상피열근 보툴리눔 독소 주입을 의뢰한다\",\"본태성 음성진전 – 신경과에 프로프라놀롤 약물치료를 의뢰한다\",\"외전형 연축성발성장애 – 후윤상피열근 보툴리눔 독소 주입을 의뢰한다\"],\"answer\":3,\"explain\":\"모음 시작 낱말에서의 과제 특이적 음성 끊김, 노래·속삭임에서의 증상 감소, 서서히 진행하는 경과, 촉진 소견 정상, 충분한 음성치료에 대한 무반응, 내시경상 불규칙한 내전 연축은 내전형 연축성발성장애(신경학적 국소 근긴장이상)를 시사한다. 표준 치료는 갑상피열근 보툴리눔 독소 주입이며, 주입 후 1~2주 일시적 기식성·액체 사레가 흔하므로 사전 상담이 필요하고, 보조적 음성치료를 병행한다. 근긴장성 발성장애는 촉진 압통·후두 상승이 있고 음성치료에 반응하며, 심인성은 급성 발병·정서적 사건 연관과 상황에 따른 변동이 크다. 본태성 음성진전은 규칙적인 율동성 떨림이 특징이다. 외전형은 무성자음에서 기식성 끊김이 나타난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"내전형 연축성발성장애 감별\",\"p\":\"과제 특이적 끊김과 음성치료 무반응으로 감별과 다음 중재 판단\",\"n\":\"내전형 SD: 모음 시작 낱말 끊김, 노래·속삭임 호전, 갑상피열근 보툴리눔 독소 주입\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 39세 남성, 무성자음(/ㅍ, ㅌ, ㅋ, ㅅ, ㅎ/)으로 시작하는 낱말에서 목소리가 바람 빠지듯 갑자기 끊기고 속삭임처럼 됨\\n• 모음이나 유성음으로 시작하는 낱말은 비교적 안정적\\n• 후두내시경: 무성음 산출 시 성대가 과도하게 외전되어 열린 상태가 지연됨, 구조적 병변 없음\",\"q\":\"이 환자의 진단과 보툴리눔 독소 주입의 표적 근육으로 옳은 것은?\",\"choices\":[\"내전형 연축성발성장애 – 갑상피열근\",\"내전형 연축성발성장애 – 외측윤상피열근\",\"외전형 연축성발성장애 – 후윤상피열근\",\"외전형 연축성발성장애 – 갑상피열근\",\"근긴장성 발성장애 – 윤상갑상근 이완 훈련\"],\"answer\":3,\"explain\":\"무성자음 뒤 모음으로 전환할 때 성대가 지연·과도하게 외전되어 기식성 끊김이 생기는 것은 외전형 연축성발성장애이며, 유일한 외전근인 후윤상피열근(PCA)의 불수의적 연축이 원인이므로 이 근육에 보툴리눔 독소를 주입한다. 갑상피열근·외측윤상피열근은 내전근으로 내전형의 표적이다. 근긴장성 발성장애는 특정 음소 환경에 국한된 규칙적 끊김을 보이지 않는다. 외전형은 양측 PCA를 동시에 약화시키면 기도 협착 위험이 있어 한쪽씩·소량으로 주입한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"외전형 연축성발성장애 감별\",\"p\":\"무성자음 환경의 기식성 끊김으로 진단과 주입 표적 근육 판단\",\"n\":\"외전형 SD: 무성자음 뒤 과도한 외전, 유일한 외전근인 후윤상피열근에 보툴리눔 독소\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 62세 여성, 갑상샘 전절제술 직후부터 흡기 시 협착음(stridor), 계단 오를 때 호흡곤란\\n• 음성은 약간 약하지만 비교적 잘 유지됨\\n• 후두내시경: 양측 성대가 정중위 부근에서 고정, 흡기 시 성문틈 약 2~3 mm\",\"q\":\"이 환자의 관리 우선순위로 가장 적절한 것은?\",\"choices\":[\"양측 성대주입술로 성문을 완전히 폐쇄하여 음성을 강화한다\",\"기관절개술이나 성문확장술로 기도 확보를 우선한다\",\"밀기 접근법으로 성대 내전을 강화하여 음성을 개선한다\",\"양측 제I형 갑상성형술로 성대를 내측화하여 음량을 높인다\",\"양측 갑상피열근에 보툴리눔 독소를 주입하여 성문을 넓힌다\"],\"answer\":2,\"explain\":\"양측 되돌이후두신경 손상으로 양측 성대가 정중위 부근에 고정되면 음성은 비교적 유지되나 흡기 시 기도가 좁아져 협착음·호흡곤란이 생기므로 생명과 직결되는 기도 확보(기관절개술 또는 성대 외측고정술·피열연골절제술 등 성문확장술)가 최우선이다. 내측화(주입술·갑상성형술)나 내전 강화 훈련은 기도를 더 좁혀 금기이며, 성문확장술은 기도를 넓히는 대신 음성이 약해질 수 있어 이후 기도와 음성의 균형을 고려한 음성치료로 보완한다. 보툴리눔 독소는 근긴장이상에 쓰는 것으로 마비된 성대의 위치를 바꾸지 못한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"양측 성대마비 관리 우선순위\",\"p\":\"양측 정중위 고정과 흡기 협착음으로 관리 우선순위 선택\",\"n\":\"양측 정중위 마비는 음성보다 기도 확보 우선, 내측화·내전 강화는 금기\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 후두전적출술 및 방사선치료 종료 후 6개월, 기관식도천공(TEP) 발성을 희망하는 64세 남성\\n• 식도 공기주입검사(insufflation test): 카테터로 공기를 넣으며 발성을 시도했으나 소리가 나지 않고, 목이 조이는 느낌과 함께 하인두 부위가 불룩해지며 공기가 저류됨\",\"q\":\"이 결과의 해석과 조치로 가장 적절한 것은?\",\"choices\":[\"검사를 통과한 것이므로 즉시 TEP를 시행하고 발성 훈련을 시작한다\",\"폐기능 저하가 원인이므로 호흡 근력 훈련을 4주간 실시한 후 재검한다\",\"TEP 발성이 불가능하므로 전기후두 사용도 포기하고 필담으로 전환한다\",\"PE분절 저긴장으로 보고 목 외부 압박 훈련을 실시한 뒤 재검한다\",\"PE분절 과긴장으로 보고 보툴리눔 독소나 근절개술 후 재평가한다\"],\"answer\":5,\"explain\":\"공기주입검사에서 공기를 넣어도 발성이 되지 않고 조임감과 공기 저류(불룩해짐)가 나타나는 것은 PE분절이 과긴장·연축되어 공기가 통과하지 못하는 상태를 뜻한다. 이 경우 TEP를 해도 유창한 발성이 어려우므로 보툴리눔 독소 주입이나 근절개술로 PE분절 긴장을 낮춘 뒤 재평가한다. 저긴장 PE분절은 오히려 소리가 약하고 낮으며 젖은 음질로 나오는 양상이고, 폐기능은 이 검사와 직접 관련이 없다. TEP 부적합이라도 전기후두 등 대안 발성법은 여전히 가능하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"TEP 공기주입검사 해석\",\"p\":\"공기주입 시 발성 불가와 공기 저류 소견으로 PE분절 상태 판단\",\"n\":\"PE분절 과긴장은 공기주입검사 실패 원인, 보툴리눔 독소·근절개술 후 재평가\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 7세 남아, 축구클럽 활동, 형과 다투며 소리 지르는 일이 잦음, 알레르기 비염으로 입호흡\\n• 후두내시경: 양측 성대 전1/3과 중1/3 경계의 대칭적 소결절\\n• 부모는 빨리 낫게 수술을 원함\",\"q\":\"가장 적절한 중재 계획은?\",\"choices\":[\"후두미세수술을 우선 시행하고 수술 후 음성치료를 한다\",\"4주간 절대 음성휴식을 시킨 뒤 후두내시경으로 재평가한다\",\"부모 교육·환경 조정의 간접치료와 발성 재교육을 병행한다\",\"말하는 대신 속삭이도록 하여 성대 부담과 마찰을 줄인다\",\"음성위생 교육만 실시하고 결절이 자연 소실될 때까지 기다린다\"],\"answer\":3,\"explain\":\"아동 성대결절은 음성 남용이 원인인 행동적 문제이므로 원인 행동을 바꾸지 않으면 수술해도 재발하며, 성장 중인 후두에 대한 수술은 반흔 위험이 있어 일반적으로 보류한다. 아동은 스스로 행동을 조절하기 어려우므로 부모 참여형 간접치료(소리 지르기 대체 행동, 환경 소음 조정, 비염·입호흡 관리 의뢰)와 SOVT·쉬운 시작 등 직접적 발성 훈련을 병행해야 한다. 절대 음성휴식은 아동에게 현실적으로 불가능하고 근본 원인을 바꾸지 못하며, 속삭이기는 오히려 후두 긴장을 높인다. 음성위생만으로는 이미 형성된 습관적 발성 패턴을 바꾸기 어렵다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"아동 성대결절 중재\",\"p\":\"음성 남용 행동과 아동 특성으로 결절 중재 계획 선택\",\"n\":\"아동 결절은 수술 보류, 부모 참여 간접치료·환경 조정과 직접 발성 재교육 병행\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 45세 남성, 아침에 목 이물감과 잦은 헛기침, 만성 기침, 쉰 목소리\\n• 흉통·속쓰림은 없다고 함\\n• 역류증상지수(RSI): 21점, 역류소견점수(RFS): 12점\\n• 후두내시경: 후두 후방 발적, 피열간 점막 비후(pachydermia), 가성대 부종\",\"q\":\"이 사례의 판단과 중재로 가장 적절한 것은?\",\"choices\":[\"근긴장성 발성장애이므로 후두마사지만 집중적으로 실시한다\",\"인후두역류를 의심해 약물치료 의뢰와 헛기침 대체 훈련을 한다\",\"속쓰림이 없으므로 역류는 배제하고 2주간 음성휴식을 처방한다\",\"성대결절이므로 반폐쇄성도훈련과 음성위생을 실시한다\",\"알레르기 반응이므로 항히스타민제만 복용하도록 한다\"],\"answer\":2,\"explain\":\"RSI가 절단점(>13)을, RFS가 절단점(>7)을 초과하고 후두 후방 발적·피열간 비후·가성대 부종이 있으면 인후두역류(LPR)를 의심한다. LPR은 위식도역류와 달리 속쓰림 등 전형적 위장 증상 없이 후두 증상만 나타나는 경우가 많으므로 속쓰림이 없다고 배제해서는 안 된다. 중재는 이비인후과 의뢰를 통한 약물치료(PPI 등)·식이 및 생활습관 교정과 함께, 후두 점막을 자극해 악순환을 만드는 헛기침을 힘주어 삼키기·물 마시기 등 대체 행동으로 바꾸는 행동 수정이 핵심이다. ※RSI/RFS 절단점은 원저 기준이며 교재별 표기가 다를 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"인후두역류 판단\",\"p\":\"RSI·RFS 초과와 후두 후방 소견으로 원인 판단과 중재 선택\",\"n\":\"LPR은 속쓰림 없이도 발생, 약물치료 의뢰와 헛기침 대체 행동 수정이 핵심\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음성 피로를 호소하는 성악 전공 대학생에게 성대기능훈련(Vocal Function Exercises, VFE)을 적용하려 한다.\",\"q\":\"VFE의 구성과 시행 원리로 옳은 것은?\",\"choices\":[\"워밍업–스트레칭–수축–내전력 강화를 각 2회씩 하루 2번 부드럽게 한다\",\"워밍업 단계에서는 최고 음도에서 짧고 강하게 스타카토로 여러 번 반복 산출한다\",\"하루 1회, 4단계를 각 1번씩만 실시하며 힘들면 즉시 중단한다\",\"내전력 강화 단계에서는 최대 강도로 고함쳐 성대 접촉과 내전력을 강화한다\",\"스트레칭과 수축 단계는 큰 소리의 스타카토 발성으로 구성된다\"],\"answer\":1,\"explain\":\"Stemple의 VFE는 후두 근육의 균형·지구력을 회복시키는 생리적 접근으로, 워밍업(모음 연장)–스트레칭(상행 활음)–수축(하행 활음)–내전력 강화(음계별 모음 연장)의 4단계를 각 2회씩 하루 2번, 가능한 한 부드럽고 노력 없는 발성으로 수행한다. 연장 시간은 폐활량 기반 목표치를 향해 점진적으로 늘린다. 고함·스타카토·최대 강도 발성은 성대 충격을 높여 VFE의 원리에 반한다. ※사용 모음·기준 음도·목표 산출식 등 세부 프로토콜은 교재별 차이가 있을 수 있음.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성대기능훈련 구성\",\"p\":\"VFE의 단계 구성과 시행 횟수·발성 방식 원리 식별\",\"n\":\"VFE: 워밍업-스트레칭-수축-내전력 강화 4단계, 각 2회씩 하루 2번 부드러운 발성\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"성대결절 치료 후에도 잔여 음성 피로를 호소하는 초등교사에게 치료사가 다음과 같이 지도하였다.\\n\\\"코와 입술 주변 앞쪽에서 울림과 진동을 느끼면서, 성대는 살짝 닿을 듯 말 듯한 상태로 가장 쉽고 편하게 큰 소리를 내 보세요.\\\"\",\"q\":\"이 기법과 그 원리로 옳은 것은?\",\"choices\":[\"악센트 기법 – 복식호흡 리듬의 강세 발성으로 호흡-발성 협응을 높인다\",\"신뢰음성 – 기식적이고 작은 소리로 말해 성대 접촉을 최소화한다\",\"공명음성치료 – 최소한의 성대 충격으로 최대의 음향 출력을 얻는다\",\"밀기 접근법 – 팔을 밀며 발성하여 성대 내전과 성문폐쇄를 강화한다\",\"챈트 말하기 – 음절 강세를 없앤 단조로운 연속 발성으로 후두 긴장을 낮춘다\"],\"answer\":3,\"explain\":\"전방(안면 마스크) 진동감과 '살짝 닿을 듯 말 듯한(barely adducted/abducted)' 성대 자세를 강조하며 쉽고 강한 소리를 찾게 하는 것은 공명음성치료(Lessac-Madsen Resonant Voice Therapy)의 기본 훈련 제스처이다. 성대 충격 응력을 최소화하면서도 충분한 출력을 얻게 하여 직업적 음성 사용자에게 적합하다. 악센트 기법은 리듬·강세와 복식호흡이 핵심이고, 신뢰음성은 수술 직후 등 일시적 보호 목적의 저강도 기식 발성이며 큰 소리를 요구하지 않는다. 밀기 접근법은 성문폐쇄부전에 쓰는 내전 강화 기법이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"공명음성치료 원리\",\"p\":\"전방 진동감과 살짝 닿는 성대 자세 지시로 기법과 원리 식별\",\"n\":\"공명음성치료: 전방 진동감과 약한 내전 자세로 최소 성대 충격에 최대 음향 출력\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"42세 남성 영업직 환자가 성대폴립 후두미세수술을 받았다. 수술 후 음성 관리를 담당하게 되었다.\",\"q\":\"수술 후 음성 관리 프로토콜로 가장 적절한 것은?\",\"choices\":[\"수술 직후부터 큰 소리로 발성하여 성대 유착과 반흔을 예방한다\",\"점막이 완전히 재생되도록 3개월간 절대 음성휴식을 유지한다\",\"회복기 3개월 동안 모든 대화는 속삭임으로만 하게 한다\",\"짧은 절대 음성휴식 후 신뢰음성·SOVT로 사용을 늘려 간다\",\"수술로 원인이 제거되었으므로 별도의 음성치료는 필요하지 않다\"],\"answer\":4,\"explain\":\"수술 직후에는 절개 부위 점막 회복을 위해 짧은 절대 음성휴식(대개 수일~1주)을 두고, 이후 신뢰음성(부드럽고 낮은 강도의 약간 기식적인 발성)·SOVT처럼 성대 충격이 적은 발성으로 점진적으로 사용량을 늘리며 음성위생·수분 섭취·역류 관리를 병행한다. 장기간 절대 휴식은 근위축·발성 회피를 초래하고, 속삭이기는 후두 긴장을 높이며, 큰 소리 발성은 치유 중인 점막에 출혈·반흔을 유발한다. 폴립의 배경에는 음성 남용 습관이 있으므로 수술 후 발성 재교육이 없으면 재발 위험이 높다. ※절대 음성휴식 기간은 술식·교재에 따라 차이가 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성대 수술 후 음성 관리\",\"p\":\"미세수술 후 점막 회복 단계에 맞는 음성 관리 프로토콜 선택\",\"n\":\"수술 후 짧은 절대 음성휴식 뒤 신뢰음성·SOVT로 점진적 사용 증가와 재발 예방 재교육\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 55세 남성 영업직, 잦은 헛기침, 강하게 시작하는 말 습관, 만성 소화불량\\n• 6개월 전 전신마취 수술 시 기관내삽관\\n• 후두내시경: 좌측 성대돌기(vocal process) 부위의 육아종성 병변\\n• 3개월 전 병변 절제술을 받았으나 재발함\",\"q\":\"이 사례의 원인 판단과 중재로 가장 적절한 것은?\",\"choices\":[\"접촉성 육아종으로 보고 역류 관리와 저충격 발성 훈련을 한다\",\"재발했으므로 즉시 더 넓은 범위로 재절제하고 조직검사를 한다\",\"원인은 음성 남용뿐이므로 3주간 음성휴식만 처방한다\",\"재발성 후두유두종으로 보고 항바이러스 치료를 의뢰한다\",\"성대 막성부 병변이므로 성대결절로 보고 SOVT를 실시한다\"],\"answer\":1,\"explain\":\"성대돌기(피열연골 부위)의 접촉성 육아종은 삽관 손상, 인후두역류, 강한 성대 접촉(헛기침·거친 성대 시작)이 복합적으로 작용하여 생기며, 원인을 그대로 둔 채 절제하면 재발률이 매우 높아 재절제는 최후 수단으로 둔다. 따라서 역류 치료, 헛기침·강한 시작을 대체하는 행동 수정, 쉬운 시작·하품-한숨 등 성대 충격을 줄이는 발성 훈련이 일차 치료이고, 난치성이면 보툴리눔 독소로 내전력을 낮추는 방법을 고려한다. 병변 위치가 막성부가 아닌 연골부이므로 결절과 다르며, 유두종은 사마귀 모양의 다발성 병변이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"접촉성 육아종 판단\",\"p\":\"성대돌기 병변 위치와 삽관·역류·헛기침 병력으로 원인과 중재 판단\",\"n\":\"접촉성 육아종: 성대돌기 병변, 원인 방치 시 재발, 역류 관리와 저충격 발성 훈련 우선\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 15세 여자 육상선수, 격렬한 달리기 중 갑자기 흡기 시 협착음과 목이 조이는 느낌, 몇 분 쉬면 소실\\n• 흡입 기관지확장제 효과 없음, 폐기능검사 정상\\n• 운동 유발 후 후두내시경: 흡기 시 성대 앞 2/3가 내전되고 후방에 다이아몬드 모양의 작은 틈만 남음\",\"q\":\"이 사례의 진단과 중재로 가장 적절한 것은?\",\"choices\":[\"운동 유발 천식 – 흡입 스테로이드와 기관지확장제를 증량한다\",\"역설적 성대운동 – 이완 후두 호흡법 훈련을 실시한다\",\"양측 성대마비 – 기관절개술 또는 성문확장술을 의뢰한다\",\"내전형 연축성발성장애 – 갑상피열근 보툴리눔 독소를 주입한다\",\"후두연화증 – 성문상부성형술을 이비인후과에 의뢰한다\"],\"answer\":2,\"explain\":\"흡기 시 성대가 역설적으로 내전되며 후방에 다이아몬드형 틈이 남는 것은 역설적 성대운동(PVFM, 성대기능이상)의 특징적 소견이며, 기관지확장제 무반응과 정상 폐기능은 천식과 감별된다. 삽화가 간헐적이고 휴식 시 소실되므로 마비가 아니며, 기도 문제이지 발성 시 연축이 아니므로 연축성발성장애도 아니다. 중재의 핵심은 발작 시 후두를 여는 이완 후두 호흡법(rescue breathing: 코로 짧게 흡기, 오므린 입술로 호기, 복식호흡)과 유발 상황 인식·자가 관리 훈련이며, 필요 시 역류·불안 관리를 병행한다. 언어재활사가 주도적으로 담당하는 영역이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"역설적 성대운동 감별\",\"p\":\"흡기 시 성대 내전과 기관지확장제 무반응으로 진단과 중재 판단\",\"n\":\"PVFM: 흡기 시 역설적 내전·후방 다이아몬드형 틈, 이완 후두 호흡법 훈련\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 49세 남성 교사, 심한 후두염 후 목소리가 낮고 거칠어졌으며 발성 시 목에 힘이 많이 들어감\\n• 후두내시경: 진성대는 구조적으로 정상이나, 발성 시 양측 가성대가 서로 접근·진동하며 진성대를 가림\",\"q\":\"이 소견에 대한 중재로 가장 적절한 것은?\",\"choices\":[\"습관화된 가성대 발성을 강화하여 안정된 음성으로 만든다\",\"첫 단계로 양측 가성대에 보툴리눔 독소를 소량 주입한다\",\"밀기 접근법으로 진성대와 가성대의 내전을 한층 더 강화한다\",\"진성대 노출을 위해 성문상부 절제술을 의뢰한다\",\"흡기 발성·하품-한숨 등으로 진성대 발성을 재확립한다\"],\"answer\":5,\"explain\":\"진성대가 정상인데 가성대가 접근·진동하는 것은 후두염 시 보상으로 시작된 가성대 발성(성대 대치 발성)이 습관화된 기능적 과기능 장애이다. 흡기 발성은 흡기 중에는 가성대가 진동하기 어려워 진성대 발성을 유도하는 대표적 촉진 기법이며, 음도 상승과 하품-한숨·후두마사지로 성문상부 압축을 풀어 진성대 발성을 재확립한다. 진성대가 정상이므로 가성대 발성을 강화하거나 침습적 처치를 먼저 할 이유가 없고, 밀기 접근법은 과기능을 더 악화시킨다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"가성대 발성 중재\",\"p\":\"진성대 정상과 가성대 진동 소견으로 진성대 발성 재확립 기법 선택\",\"n\":\"가성대 발성은 습관화된 과기능, 흡기 발성·하품-한숨으로 진성대 발성 유도\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"중증 쉰 목소리 환자의 후두 스트로보스코피에서 기본주파수 추적이 되지 않아 화면이 흔들리고 점막파동을 판독할 수 없었다.\",\"q\":\"이 상황의 해석과 대안으로 옳은 것은?\",\"choices\":[\"방법상의 한계로 보고 고속 후두촬영 등으로 보완한다\",\"점막파동이 관찰되지 않았으므로 성대 반흔으로 확진한다\",\"마이크 위치 문제이므로 위치만 조정하여 재검하면 된다\",\"강도를 최대한 높여 발성하게 하면 정상적으로 판독할 수 있다\",\"전기성문파형검사로 대체하여 점막파동을 직접 관찰한다\"],\"answer\":1,\"explain\":\"스트로보스코피는 F0에 동기화된 섬광으로 여러 주기의 조각을 합성해 '느린 움직임'처럼 보이게 하는 착시 기법이므로, 신호가 준주기적이어야 한다. 심한 비주기성(Titze의 3형 신호)에서는 동기화 실패로 판독이 불가능하며, 이는 반흔의 증거가 아니라 방법의 한계이다. 고속 후두촬영은 초당 수천 프레임으로 실제 주기를 촬영하므로 비주기 음성에도 적용된다. EGG는 성대 접촉 면적 변화를 간접 측정할 뿐 점막파동을 시각화하지 못한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"스트로보스코피 한계\",\"p\":\"비주기 음성에서 동기화 실패 상황의 해석과 대체 검사 선택\",\"n\":\"스트로보스코피는 준주기 신호 전제, 심한 비주기 음성은 고속 후두촬영으로 보완\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"중증 기식성 음성 환자의 음향분석에서 파형이 비주기적이어서 jitter·shimmer 값이 산출되지 않거나 극단적인 값으로 나왔다.\",\"q\":\"이 환자의 음성 중증도를 객관적으로 정량화하기 위해 가장 적절한 음향 지표는?\",\"choices\":[\"켑스트럼 피크 현저도(CPPS)를 사용한다\",\"기본주파수 표준편차를 중증도 지표로 사용한다\",\"소음대배음비(NHR)만을 중증도 지표로 사용한다\",\"jitter를 여러 번 재측정하여 평균값을 사용한다\",\"최대연장발성시간(MPT)으로 음향 지표를 대체한다\"],\"answer\":1,\"explain\":\"jitter·shimmer·NHR은 주기 경계 검출을 전제로 하므로 비주기적(3형) 신호에서는 신뢰할 수 없다. 켑스트럼 피크 현저도(CPP)는 주기 검출 없이 스펙트럼의 배음 구조가 얼마나 뚜렷한지를 정량화하므로 중증·비주기 음성에도 안정적이며, 연결발화에도 적용 가능하고 청지각적 중증도와 상관이 높아 최근 권고되는 지표이다. F0 표준편차는 음도 변동을 반영할 뿐 음질 중증도 지표가 아니며, MPT는 공기역학적 지표로 음향분석을 대체하지 못한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"비주기 음성 음향 지표\",\"p\":\"주기 검출 불가 음성에서 중증도 정량 지표 선택\",\"n\":\"CPPS는 주기 검출 없이 배음 구조 뚜렷함을 측정, 중증·비주기 음성에도 안정적\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 36세 여성 콜센터 상담원, 하루 7시간 통화, 목 조임·통증과 음성 피로\\n• 후두 촉진: 후두 상승, 갑상설골 간격 축소, 설골상부 근육 압통\\n• 공기역학 검사: 성문하압 12 cmH₂O(증가), 평균호기류율 80 mL/s(감소), 후두저항 증가\\n• 후두내시경: 병변 없음, 발성 시 후방 성문틈과 전후·좌우 성문상부 압축\",\"q\":\"이 사례의 진단과 중재로 가장 적절한 것은?\",\"choices\":[\"편측 성대마비 – 주입술 등 성대 내측화 수술을 의뢰한다\",\"내전형 연축성발성장애 – 보툴리눔 독소를 주입한다\",\"일차성 근긴장성 발성장애 – 도수치료와 발성 재교육을 한다\",\"심인성 실성증 – 정신건강의학과 의뢰 후 기침 발성을 유도한다\",\"라인케부종 – 금연 교육과 후두미세수술을 의뢰한다\"],\"answer\":3,\"explain\":\"구조적 병변 없이 후두 상승·갑상설골 간격 축소·촉진 압통, 높은 성문하압과 낮은 호기류(높은 후두저항), 성문상부 압축은 과도한 후두 내·외근 긴장에 의한 일차성 근긴장성 발성장애의 전형이다. 중재는 후두 도수치료(circumlaryngeal massage)·후두 하강으로 긴장을 낮춘 뒤 SOVT·공명음성 등으로 효율적 발성 패턴을 재학습시키고, 헤드셋 사용·휴식 등 업무 환경을 조정하는 것이다. 성대마비는 호기류가 증가하고 성문하압이 낮아지는 반대 양상이며, 연축성발성장애는 과제 특이적·불규칙 연축이 특징이고 촉진 소견이 정상이다. ※성문하압·호기류율 정상 범위는 교재별로 차이가 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"근긴장성 발성장애 감별\",\"p\":\"촉진 소견·높은 후두저항·성문상부 압축으로 진단과 중재 판단\",\"n\":\"일차성 MTD: 후두 상승·압통·높은 성문하압과 낮은 호기류, 도수치료와 발성 재교육\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 58세 여성, 천식으로 고용량 흡입 스테로이드(플루티카손)를 6개월간 사용한 뒤 쉰 목소리 발생, 음성 남용력 없음\\n• 후두내시경: 성대 점막에 백색 반점(칸디다 의심), 성대가 약간 활모양으로 휨\",\"q\":\"언어재활사의 대응으로 가장 적절한 것은?\",\"choices\":[\"환자 스스로 흡입 스테로이드를 즉시 중단하도록 지시한다\",\"반폐쇄성도훈련으로 성대 점막의 백색 반점을 제거한다\",\"성대백반증이므로 즉시 조직검사와 레이저 절제를 의뢰한다\",\"입 헹굼·스페이서 사용을 교육하고 처방의와 협의한다\",\"활모양 성대를 교정하기 위해 밀기 접근법을 집중 실시한다\"],\"answer\":4,\"explain\":\"흡입 스테로이드는 후두 칸디다증과 스테로이드 유발 국소 근병증(성대 활모양)을 일으켜 음성 남용 없이도 애성을 유발한다. 일차 조치는 약물 관련 원인 관리(흡입 후 입 헹굼·가글과 스페이서 사용으로 후두 침착 감소, 처방의와 용량·제형 조정 및 항진균 치료 협의, 수분 섭취)이며, 이는 의학적 처치이므로 언어재활사는 교육·협의 역할을 한다. 원인 교정 후에도 음성 문제가 남으면 음성치료를 계획한다. 천식 약을 환자 임의로 중단하게 하는 것은 위험하고, 병변은 감염성이므로 음성 훈련으로 제거되지 않으며, 백반증으로 단정해 조직검사·절제부터 할 상황도 아니다. 근병증에 의한 활모양은 약물 조정 후 회복되는 경우가 많아 밀기 접근법 집중 훈련은 우선순위가 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"흡입 스테로이드 유발 애성\",\"p\":\"흡입 스테로이드 사용력과 칸디다 소견으로 언어재활사 대응 선택\",\"n\":\"흡입 스테로이드는 후두 칸디다증·근병증 유발, 입 헹굼·스페이서 교육과 처방의 협의\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 27세 여성 뮤지컬 배우, 공연 중 갑자기 목소리가 끊겼고 다음 날 심한 애성\\n• 월경 중이며 두통으로 아스피린을 복용함\\n• 후두내시경: 우측 성대 전체가 붉게 물든 출혈 소견\",\"q\":\"가장 적절한 즉각적 조치는?\",\"choices\":[\"반폐쇄성도훈련을 즉시 시작하여 혈종의 빠른 흡수를 유도한다\",\"절대 음성휴식과 아스피린 중단 후 점진적으로 복귀시킨다\",\"밀기 접근법으로 성대 내전을 강화하여 공연에 복귀시킨다\",\"온찜질과 함께 큰 소리 발성 연습으로 혈액 흡수를 촉진한다\",\"즉시 후두미세수술로 출혈 부위와 혈종을 제거한다\"],\"answer\":2,\"explain\":\"성대출혈은 음성 외상에 월경기 혈관 취약성과 아스피린(항혈소판 효과)이 겹쳐 발생하기 쉬운 응급 상황으로, 계속 발성하면 반흔·혈관종으로 진행해 영구적 음질 손상을 남길 수 있다. 급성기에는 절대 음성휴식(대개 1~2주)으로 발성을 완전히 중단해 혈액이 흡수되도록 하고 아스피린·NSAID를 중단하며 항응고 위험 요인을 평가하고, 후두과 추적 후 점진적으로 복귀하며 재발 예방(월경 주기·약물·과다 사용) 교육을 한다. 수술은 급성 출혈의 치료가 아니라 재발성 출혈의 원인이 되는 정맥류에 대해 고려한다. SOVT·밀기·큰 소리 발성은 모두 출혈 부위에 기계적 부하를 주어 금기이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성대출혈 즉각 조치\",\"p\":\"급성 성대출혈과 아스피린·월경 요인으로 즉각 조치 선택\",\"n\":\"급성 성대출혈은 절대 음성휴식과 아스피린 중단 후 점진 복귀, 발성 부하 기법은 금기\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 68세 여성, 3~4년에 걸쳐 서서히 심해진 목소리 떨림, 노래와 말에서 모두 나타남, 손 떨림 동반\\n• 연장모음 /아/에서 4~6 Hz의 규칙적인 음도·강도 변조\\n• 모음 시작 낱말·무성자음 등 특정 음소 환경과 무관하게 지속되며, 속삭일 때도 떨림이 관찰됨\\n• 후두내시경: 발성 시 후두·인두·연구개가 함께 율동적으로 떨림, 구조적 병변 없음\",\"q\":\"이 사례의 감별과 관리로 가장 적절한 것은?\",\"choices\":[\"내전형 연축성발성장애 – 갑상피열근 보툴리눔 독소를 주입한다\",\"본태성 음성진전 – 신경과 의뢰와 보상적 음성치료를 병행한다\",\"파킨슨병 – LSVT LOUD로 음성 강도를 높인다\",\"근긴장성 발성장애 – 후두마사지와 SOVT를 실시한다\",\"심인성 음성장애 – 정신건강의학과 의뢰 후 상담을 병행한다\"],\"answer\":2,\"explain\":\"특정 음소 환경과 무관하게 규칙적(4~6 Hz)으로 나타나는 음도·강도 변조, 속삭임에서도 지속, 손 떨림 동반, 후두 외 구조(인두·연구개)의 율동적 떨림은 본태성 음성진전의 특징이다. 연축성발성장애는 과제 특이적·불규칙적 끊김이 핵심이고 속삭임에서 감소한다. 진전은 여러 구조가 관여하므로 보툴리눔 독소 효과가 부분적이며, 신경과 의뢰로 약물치료(프로프라놀롤 등)를 검토하고 짧은 구·문장 사용, 음도·강도 조절 등 보상적 음성치료로 지각되는 떨림을 줄인다. 파킨슨병은 단조롭고 약한 음성이 특징이며 안정 시 진전을 보인다. ※음성진전 주파수 범위(4~7 Hz 등)는 교재별 표기가 다를 수 있음.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성장애 유형\",\"k\":\"본태성 음성진전 감별\",\"p\":\"규칙적 변조·속삭임 지속·손 떨림 동반으로 감별과 관리 판단\",\"n\":\"본태성 음성진전: 음소 무관 규칙적 떨림, 신경과 의뢰와 보상적 음성치료 병행\"}},{\"grade\":1,\"set\":2,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 6세 남아, 뇌간 종양 수술 후 커프형 기관절개관을 6개월째 유지\\n• 각성 상태 양호, 분비물 적음, 자발 호흡 안정\\n• 아동과 부모 모두 말하기를 강하게 원하며, 의료진과 함께 말하기 밸브(일방향 밸브) 적용을 검토 중\",\"q\":\"말하기 밸브 적용의 필수 조건과 절차로 옳은 것은?\",\"choices\":[\"커프를 팽창시킨 상태로 밸브를 부착하여 기도를 보호한다\",\"상기도가 완전히 폐쇄되어 있어도 밸브 사용이 가능하다\",\"처음부터 수면 중을 포함해 하루 종일 착용시켜 적응하게 한다\",\"커프 완전 감압과 상기도 통기 확인 후 짧은 시간부터 착용한다\",\"분비물이 많을수록 밸브가 분비물 배출을 돕기 때문에 유리하다\"],\"answer\":4,\"explain\":\"일방향 말하기 밸브는 흡기는 관을 통해, 호기는 관 주위를 거쳐 상기도(성대)로 내보내 발성을 가능하게 한다. 따라서 커프를 완전히 감압해야 하고, 관 주위와 상기도가 충분히 열려 있어야 하며(막힘이 있으면 공기가 갇혀 질식 위험), 관을 막고 호기·발성이 가능한지와 산소포화도·호흡 안정을 확인한 뒤 짧은 시간부터 점진적으로 착용한다. 커프 팽창 상태나 상기도 폐쇄에서 밸브를 쓰면 호기가 나가지 못해 매우 위험하고, 과다한 분비물은 밸브 막힘·흡인 위험을 높여 금기에 해당한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"말하기 밸브 적용 조건\",\"p\":\"기관절개 아동의 말하기 밸브 적용 필수 조건과 절차 선택\",\"n\":\"말하기 밸브는 커프 완전 감압과 상기도 통기 확인 후 짧은 시간부터 착용\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"단어 '참새'에 포함된 자음(ㅊ, ㅁ, ㅅ)의 조음방법을 순서대로 옳게 나열한 것은?\",\"choices\":[\"파열음 – 비음 – 마찰음\",\"마찰음 – 비음 – 파찰음\",\"파찰음 – 유음 – 마찰음\",\"파찰음 – 비음 – 마찰음\",\"파찰음 – 비음 – 파열음\"],\"answer\":4,\"explain\":\"/ㅊ/은 경구개 파찰음, 종성 /ㅁ/은 양순 비음, /ㅅ/은 치조 마찰음이다. /ㅊ/을 파열음이나 마찰음으로, /ㅁ/을 유음으로, /ㅅ/을 파열음·파찰음으로 분류한 나머지 보기는 모두 틀리다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"자음 조음방법 분류\",\"p\":\"낱말 속 자음별 조음방법을 순서대로 식별\",\"n\":\"ㅊ 파찰음, ㅁ 비음, ㅅ 마찰음의 조음방법 분류\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 자음의 변별자질에 관한 설명으로 옳은 것은?\",\"choices\":[\"비음 /ㅁ, ㄴ, ㅇ/은 [-공명성] 자질을 갖는다\",\"치조음과 경구개음은 [+설정성] 자질을 공유한다\",\"연구개음 /ㄱ, ㄲ, ㅋ/은 [+전방성] 자질을 갖는다\",\"파찰음 /ㅈ, ㅉ, ㅊ/은 [+지속성] 자질을 갖는다\",\"마찰음 /ㅅ, ㅆ/은 [-지속성] 자질을 갖는다\"],\"answer\":2,\"explain\":\"[설정성(coronal)]은 혀끝·혓날이 올라가 조음되는 치조음·경구개음이 공유하는 자질이다. 비음은 공명음이므로 [+공명성], 파찰음은 폐쇄 구간이 있어 [-지속성], 마찰음은 기류가 지속되므로 [+지속성], 연구개음은 치조 뒤에서 조음되므로 [-전방성]이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"자음 변별자질\",\"p\":\"자음 부류별 변별자질 값의 옳고 그름 판단\",\"n\":\"[+설정성]: 치조음·경구개음 공유, 연구개음은 [-전방성]\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 종성(받침) 자음에 관한 설명으로 옳은 것은?\",\"choices\":[\"종성에서는 /ㄱ, ㄴ, ㄷ, ㄹ, ㅁ, ㅂ, ㅇ/만 발음된다\",\"종성 /ㄹ/은 초성과 같이 탄설음 [ɾ]으로 실현된다\",\"종성 파열음은 파열 단계까지 개방되어 산출된다\",\"종성 위치에서 파찰음 /ㅈ/은 파찰음 그대로 실현된다\",\"발음상 종성에서는 두 개의 자음이 연이어 모두 실현될 수 있다\"],\"answer\":1,\"explain\":\"한국어는 음절 말에서 7개 자음(7종성)만 실현된다(예: '꽃'→[꼳], '부엌'→[부억]). 종성 파열음은 불파음(미파음)으로 산출되고, 종성 /ㄹ/은 설측음 [l]로 실현되며, 겹받침은 자음군 단순화로 하나만 발음된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"종성 실현 규칙\",\"p\":\"음절 말 자음의 실현 방식에 대한 설명 판단\",\"n\":\"7종성 규칙, 종성 파열음 불파, 종성 ㄹ 설측음, 자음군 단순화\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"우리말 /ㄹ/의 변이음 실현이 옳게 연결된 것은?\",\"choices\":[\"'라면'의 /ㄹ/ – 설측음 [l]\",\"'노래'의 /ㄹ/ – 설측음 [l]\",\"'달'의 /ㄹ/ – 설측음 [l]\",\"'빨래'의 첫 번째 /ㄹ/ – 탄설음 [ɾ]\",\"'달'의 /ㄹ/ – 탄설음 [ɾ]\"],\"answer\":3,\"explain\":\"/ㄹ/은 초성(어두, 모음 사이)에서 탄설음 [ɾ], 종성에서 설측음 [l]로 실현된다. '빨래'처럼 /ㄹ/이 연이어 나오면 [ll]로 둘 다 설측음이다. 따라서 '달'의 종성 /ㄹ/ – 설측음 연결만 옳다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"유음 변이음 실현\",\"p\":\"음절 위치에 따른 /ㄹ/ 변이음 연결 판단\",\"n\":\"/ㄹ/: 초성·모음 사이 탄설음 [ɾ], 종성·ㄹㄹ 연쇄 설측음 [l]\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"'고기'의 표준 발음에 대한 음성 전사로 옳은 것은?\",\"choices\":[\"[koki]\",\"[gogi]\",\"[kʰogi]\",\"[kogi]\",\"[k*ogi]\"],\"answer\":4,\"explain\":\"평음 /ㄱ/은 어두에서 무성 파열음 [k]로, 유성음(모음) 사이에서는 유성음화되어 [g]로 실현된다. 어두를 [g]로 전사하거나 어중을 [k]로 전사한 것, 격음 [kʰ]·경음 [k*]으로 전사한 것은 모두 틀리다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성학·음운론 기초\",\"k\":\"평음 유성음화 전사\",\"p\":\"어두·모음 사이 평음의 실현을 근거로 음성 전사 선택\",\"n\":\"평음 /ㄱ/: 어두 무성 [k], 유성음 사이 유성음화 [g]\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 자음의 일반적인 습득 순서에 관한 설명으로 옳은 것은?\",\"choices\":[\"치조 마찰음 /ㅅ, ㅆ/은 가장 이른 시기에 습득된다\",\"유음 /ㄹ/은 양순 파열음보다 먼저 습득된다\",\"모든 종성 자음은 초성 자음보다 늦게 습득된다\",\"치조 마찰음은 만 3세 이전에 완전 습득된다\",\"비음과 파열음은 파찰음·마찰음보다 먼저 습득된다\"],\"answer\":5,\"explain\":\"우리말 자음은 대체로 비음·파열음 → 파찰음 → 유음·마찰음 순으로 습득되며, /ㅅ, ㅆ/과 /ㄹ/이 가장 늦게 완성된다. 종성 비음(/ㅁ, ㅇ/)은 비교적 이른 시기에 습득되므로 모든 종성이 초성보다 늦다는 설명은 틀리다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"자음 습득 순서\",\"p\":\"조음방법별 자음 습득 시기 차이로 옳은 설명 판단\",\"n\":\"비음·파열음 → 파찰음 → 유음·마찰음 순 습득, /ㅅ, ㄹ/ 가장 늦음\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 음운인식 과제 중 일반적으로 가장 늦게 발달하는 것은?\",\"choices\":[\"'토마토'를 듣고 손뼉을 치며 음절 수 세기\",\"'밤'에서 /ㅁ/을 빼고 말하기\",\"'바나나'에서 '바'를 빼고 말하기\",\"/ㄱ/, /ㅗ/, /ㅁ/을 합쳐 '곰' 말하기\",\"'사'와 '자'를 합쳐 '사자' 말하기\"],\"answer\":2,\"explain\":\"음운인식은 큰 단위(음절)에서 작은 단위(음소)로 발달하며, 같은 음소 수준에서도 합성보다 탈락·대치 과제가 더 어렵다. 따라서 음소 탈락('밤'에서 /ㅁ/ 빼기)이 가장 늦게 발달한다. 음절 수 세기·음절 합성·음절 탈락은 음절 수준, 음소 합성은 음소 수준이지만 탈락보다 쉽다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음운인식\",\"k\":\"음운인식 발달 위계\",\"p\":\"단위 크기와 과제 유형으로 가장 늦은 과제 식별\",\"n\":\"음운인식: 음절→음소 순 발달, 합성보다 탈락이 어려움\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말소리 습득 연령 기준에 관한 설명으로 옳은 것은?\",\"choices\":[\"출현연령은 해당 연령 아동의 95% 이상이 정조음한 연령이다\",\"출현연령은 네 단계 중 완전습득연령보다 늦게 나타난다\",\"관습적 습득연령은 해당 연령 아동의 75~94%가 정조음한 연령이다\",\"숙달연령은 해당 연령 아동의 25~49%가 정조음한 연령이다\",\"완전습득연령은 해당 연령 아동의 95~100%가 정조음한 연령이다\"],\"answer\":5,\"explain\":\"우리말 자음 습득 연구(김영태)에서 출현연령은 25~49%, 관습적 습득연령은 50~74%, 숙달연령은 75~94%, 완전습득연령은 95~100%의 아동이 정조음한 연령으로 정의된다. 출현연령이 가장 이르고 완전습득연령이 가장 늦다. ①은 완전습득 기준, ③은 숙달연령 기준, ④는 출현연령 기준을 잘못 연결한 것이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"말소리 습득연령 기준\",\"p\":\"정조음 아동 비율에 따른 습득연령 단계 정의 판단\",\"n\":\"출현 25~49%, 관습 50~74%, 숙달 75~94%, 완전습득 95~100%\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"아동의 말소리 오류를 '성인 형태를 단순화하는 자연스러운 과정(음운변동)'으로 보고, 발달과 함께 이 과정이 억제되면서 성인 음운체계에 도달한다고 설명한 이론은?\",\"choices\":[\"행동주의 학습이론\",\"생성음운론\",\"자연음운론\",\"최적성이론\",\"운율음운론\"],\"answer\":3,\"explain\":\"자연음운론(Stampe)은 아동이 타고난 자연적 음운변동(단순화 과정)을 성장하면서 억제·제한하여 성인 체계에 이른다고 본다. 생성음운론은 변별자질과 규칙 체계, 최적성이론은 제약의 서열, 행동주의는 강화 학습으로 말소리 발달을 설명한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"자연음운론 개념\",\"p\":\"음운변동 억제로 발달을 설명하는 이론 식별\",\"n\":\"자연음운론(Stampe): 타고난 음운변동을 억제해 성인 체계 도달\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 중 왜곡(distortion) 오류에 해당하는 것은?\",\"choices\":[\"'사'의 /ㅅ/을 혀 옆으로 공기가 새는 소리로 산출함\",\"'고래'의 /ㄹ/을 산출하지 않고 [고애]로 말함\",\"'오리'의 어두에 /ㅁ/을 덧붙여 [모리]로 말함\",\"'사탕'의 /ㅅ/을 /ㅌ/으로 바꾸어 [타탕]으로 말함\",\"'밥'의 종성 /ㅂ/을 빼고 [바]로 말함\"],\"answer\":1,\"explain\":\"왜곡은 목표음이 우리말 음소 목록에 없는 비표준 소리로 산출되는 오류로, 공기가 혀 옆으로 새는 /ㅅ/의 설측음화가 대표적이다. ④ [타탕]은 다른 음소로 바뀐 대치, ② [고애]·⑤ [바]는 생략, ③ [모리]는 첨가 오류이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"조음 오류 유형 분류\",\"p\":\"오조음 예시를 보고 왜곡 오류 식별\",\"n\":\"왜곡: 음소 목록에 없는 비표준음 산출, 예 /ㅅ/ 설측음화\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"가방 → [다방]\\n코 → [토]\\n공 → [동]\",\"q\":\"이 아동이 보이는 음운오류패턴은?\",\"choices\":[\"파열음화\",\"치조음 후방화\",\"연구개음 전방화\",\"양순음화\",\"탈기식음화\"],\"answer\":3,\"explain\":\"연구개음 /ㄱ, ㅋ/이 조음위치가 앞쪽인 치조음 /ㄷ, ㅌ/으로 바뀌었으므로 연구개음 전방화이다. 조음방법(파열음)과 발성유형(평음·격음)은 유지되어 파열음화나 탈기식음화가 아니며, 뒤쪽으로 이동한 후방화도 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"음운오류패턴 판별\",\"p\":\"연구개음이 치조음으로 바뀐 예를 근거로 패턴 판단\",\"n\":\"연구개음 전방화: /ㄱ, ㅋ/ → /ㄷ, ㅌ/, 조음방법·발성유형 유지\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 4세 아동의 오류 중 일반적인 음운발달 과정에서 잘 나타나지 않는 비발달적 오류패턴에 해당하여 우선 중재가 필요한 것은?\",\"choices\":[\"나비 → [아비]\",\"딸기 → [딸디]\",\"라면 → [야면]\",\"사자 → [다자]\",\"책 → [채]\"],\"answer\":1,\"explain\":\"어두 초성 생략(나비→[아비])은 정상 발달에서 거의 나타나지 않는 비발달적 패턴이다. 연구개음 전방화([딸디]), 유음의 활음화([야면]), 마찰음의 파열음화([다자]), 종성생략([채])은 어린 아동에게 흔히 관찰되는 발달적 패턴이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"비발달적 오류 식별\",\"p\":\"발달 과정에서 드문 오류를 근거로 우선 중재 대상 식별\",\"n\":\"어두 초성 생략: 정상 발달에서 드문 비발달적 오류패턴\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"사과 → [가과]\\n두부 → [부부]\",\"q\":\"두 오류에 공통적으로 해당하는 오류패턴은?\",\"choices\":[\"순행동화\",\"전방화\",\"음절 반복\",\"후방화\",\"역행동화\"],\"answer\":5,\"explain\":\"두 예 모두 앞 자음이 뒤에 오는 자음(/ㄱ/, /ㅂ/)의 영향을 받아 같은 소리로 바뀌었으므로 뒤 소리가 앞 소리에 영향을 준 역행동화이다. 순행동화는 앞 소리가 뒤 소리를 바꾸는 경우이며, 전방화·후방화는 문맥과 무관하게 조음위치가 이동하는 대치 패턴이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"동화 방향 판별\",\"p\":\"뒤 자음이 앞 자음을 바꾼 공통점으로 동화 유형 판단\",\"n\":\"역행동화: 뒤 소리가 앞 소리에 영향, 순행동화는 반대 방향\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"사과 → [자과]\\n새 → [재]\\n수박 → [주박]\",\"q\":\"이 아동이 보이는 오류패턴은?\",\"choices\":[\"마찰음의 파열음화\",\"파찰음의 마찰음화\",\"구개음화\",\"마찰음의 파찰음화\",\"경음화\"],\"answer\":4,\"explain\":\"치조 마찰음 /ㅅ/이 파찰음 /ㅈ/으로 바뀌었으므로 마찰음의 파찰음화이다. 파열음화는 /ㄷ/ 등 파열음으로 바뀌는 것이고, 파찰음의 마찰음화는 반대 방향(/ㅈ/→/ㅅ/)이며, 경음화는 발성유형 변화이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"조음방법 변동 판별\",\"p\":\"/ㅅ/→/ㅈ/ 대치 예를 근거로 오류패턴 판단\",\"n\":\"마찰음의 파찰음화: /ㅅ/ → /ㅈ/, 반대 방향은 파찰음의 마찰음화\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"자극반응도(stimulability)에 관한 설명으로 옳은 것은?\",\"choices\":[\"독립음 수준에서만 평가하며 단어·문장 수준은 평가하지 않는다\",\"자발화에서 목표 음소가 오조음되는 빈도를 백분율로 나타낸 것이다\",\"자극반응도가 높은 음소는 자연 회복 가능성이 낮아 우선 치료한다\",\"모델이나 단서를 주었을 때 오조음을 정조음할 수 있는 정도이다\",\"말명료도와 같은 개념으로, 청자가 알아듣는 정도를 뜻한다\"],\"answer\":4,\"explain\":\"자극반응도는 청각·시각·촉각 단서나 모델을 주었을 때 오조음을 정조음으로 산출할 수 있는 능력으로, 독립음·음절·단어 수준에서 평가한다. 자극반응도가 높은 음소는 예후가 좋고 자연 회복 가능성이 높다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"자극반응도 개념\",\"p\":\"자극반응도의 정의와 예후 관련성 판단\",\"n\":\"자극반응도: 모델·단서 제공 시 정조음 가능 정도, 높을수록 예후 양호\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"토끼 신발 → [토띠 신발]\",\"q\":\"이 발화의 자음정확도(PCC)는?\",\"choices\":[\"5/6×100(%)\",\"4/6×100(%)\",\"4/7×100(%)\",\"5/7×100(%)\",\"5/8×100(%)\"],\"answer\":1,\"explain\":\"목표 자음은 '토끼'의 /ㅌ, ㄲ/, '신발'의 /ㅅ, ㄴ, ㅂ, ㄹ/로 총 6개이다. 이 중 /ㄲ/→[ㄸ] 1개만 오류이므로 5/6×100이다. 초성 'ㅇ'(음가 없음)이나 모음은 자음 수에 포함하지 않는다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PCC 산출\",\"p\":\"목표 자음 수와 오류 자음 수로 자음정확도 산출\",\"n\":\"PCC: 정조음 자음 수/목표 자음 수×100, 음가 없는 ㅇ 제외\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"모자 → [모다]\\n김 → [김]\",\"q\":\"두 단어의 평균음운길이(PMLU)는?\",\"choices\":[\"8/2\",\"9/2\",\"11/2\",\"10/2\",\"12/2\"],\"answer\":4,\"explain\":\"PMLU는 아동 산출의 분절음마다 1점, 정조음한 자음마다 1점을 추가한다. [모다]는 분절음 4개 + 정조음 자음 /ㅁ/ 1개 = 5점(/ㅈ/→[ㄷ]는 추가점 없음), [김]은 분절음 3개 + 정조음 자음 2개 = 5점이다. 합계 10점을 단어 수 2로 나누어 10/2이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PMLU 산출\",\"p\":\"분절음 수와 정조음 자음 가산점으로 평균음운길이 산출\",\"n\":\"PMLU: 분절음당 1점 + 정조음 자음당 1점, 단어 수로 나눔\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말명료도(speech intelligibility)에 관한 설명으로 옳은 것은?\",\"choices\":[\"자음정확도가 같은 아동은 말명료도도 같게 나타난다\",\"말용인도(acceptability)와 같은 개념이다\",\"청자가 화자의 말을 알아듣는 정도로, 평정척도 등으로 측정한다\",\"왜곡 오류가 생략 오류보다 말명료도를 더 크게 떨어뜨린다\",\"청자의 친숙도는 말명료도 평가 결과에 영향을 미치지 않는다\"],\"answer\":3,\"explain\":\"말명료도는 청자가 화자의 메시지를 알아듣는 정도로 등간척도 평정이나 알아들은 단어 비율(단어 확인 과제)로 측정한다. 오류 유형·일관성·문맥·청자 친숙도 등 여러 요인이 영향을 미치므로 자음정확도와 항상 일치하지 않으며, 생략이 왜곡보다 명료도를 더 떨어뜨린다. 말용인도는 말이 자연스럽고 정상적으로 들리는 정도로 다른 개념이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"말명료도 개념\",\"p\":\"말명료도의 정의·측정·영향 요인에 대한 설명 판단\",\"n\":\"말명료도: 청자가 알아듣는 정도, 평정척도·단어 확인으로 측정\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 중 말명료도를 가장 크게 저하시킬 것으로 예상되는 오류는?\",\"choices\":[\"/ㅅ/의 일관된 치간음화 왜곡\",\"어말 종성 /ㄹ/의 가벼운 왜곡\",\"여러 위치에서 나타나는 초성 생략\",\"/ㅈ/ 한 음소의 일관된 파열음화\",\"어말 종성 /ㅇ/의 약화\"],\"answer\":3,\"explain\":\"오류 유형 중 생략이 명료도에 가장 큰 영향을 주고 대치, 왜곡 순이며, 여러 음소·위치에 걸친 오류일수록 명료도가 더 낮아진다. 단일 음소의 왜곡이나 한 음소의 일관된 대치는 비교적 명료도 저하가 적다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"명료도 영향 요인\",\"p\":\"오류 유형과 범위를 근거로 명료도 저하가 큰 오류 판단\",\"n\":\"명료도 영향: 생략 > 대치 > 왜곡, 여러 음소·위치일수록 더 저하\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"• 37개 단어 이름대기와 연결발화 검사로 구성\\n• 자음정확도와 음운오류패턴 분석 결과를 제공\",\"q\":\"해당하는 검사는?\",\"choices\":[\"아동용 발음평가(APAC)\",\"우리말 조음음운검사2(U-TAP2)\",\"한국어 표준 그림 조음음운검사(KS-PAPT)\",\"한국어 읽기 검사(KOLRA)\",\"취학전 언어발달척도(PRES)\"],\"answer\":1,\"explain\":\"APAC은 37개 단어 검사와 연결발화 검사로 자음정확도와 오류패턴을 분석하는 검사이다. U-TAP2는 단어·문장 수준 검사로 구성되며, KS-PAPT는 선별·정밀검사로 나뉜다. KOLRA는 읽기, PRES는 언어발달 검사이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"조음음운 검사도구 식별\",\"p\":\"검사 구성과 분석 결과 특성으로 해당 검사 식별\",\"n\":\"APAC: 37개 단어 + 연결발화, 자음정확도·오류패턴 분석\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"독립분석(independent analysis)에 관한 설명으로 옳은 것은?\",\"choices\":[\"성인 목표형과 비교하여 대치·생략·왜곡 오류를 분류한다\",\"성인 목표형과 비교 없이 아동의 음소 목록과 음절구조를 기술한다\",\"자음정확도(PCC)를 산출하여 심각도를 판정하는 분석이다\",\"학령기 잔존오류 아동의 왜곡 분석에 가장 적합하다\",\"음운오류패턴별 출현율을 계산하여 치료 목표를 정한다\"],\"answer\":2,\"explain\":\"독립분석은 아동의 산출 자체를 하나의 체계로 보고 자음·모음 목록과 음절구조 목록을 기술하며, 어리거나 명료도가 매우 낮은 아동에게 유용하다. 성인 목표형과 비교하는 오류 분류, 자음정확도, 오류패턴 출현율은 관계분석에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"독립분석과 관계분석\",\"p\":\"성인 목표형 비교 여부로 독립분석 특성 판단\",\"n\":\"독립분석: 목표형 비교 없이 음소·음절구조 목록 기술\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"자음정확도(PCC)가 48%인 아동의 말소리장애 심각도(Shriberg & Kwiatkowski 기준)는?\",\"choices\":[\"중도(severe)\",\"경도-중등도(mild-moderate)\",\"중등도-중도(moderate-severe)\",\"경도(mild)\",\"정상 범위\"],\"answer\":1,\"explain\":\"PCC 심각도 기준은 85% 초과 경도, 65~85% 경도-중등도, 50~65% 중등도-중도, 50% 미만 중도이다. 48%는 50% 미만이므로 중도에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"PCC 심각도 판정\",\"p\":\"자음정확도 수치를 기준 구간에 대응해 심각도 판단\",\"n\":\"PCC 심각도: 50% 미만 중도, 50~65% 중등도-중도\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 아동\\n• 같은 단어를 여러 번 산출할 때 40% 이상 다르게 산출함\\n• 구강운동 기능은 정상이고 모색행동이 없음\\n• 운율은 자연스러움\",\"q\":\"Dodd의 분류에 따른 이 아동의 말소리장애 유형은?\",\"choices\":[\"음운지연\",\"비일관적 음운장애\",\"일관적 음운장애\",\"아동기 말실행증\",\"조음장애\"],\"answer\":2,\"explain\":\"같은 단어를 반복 산출할 때 40% 이상 변이를 보이면서 구강운동·운율 문제가 없으면 비일관적 음운장애이다. 아동기 말실행증도 비일관성을 보이지만 모색행동, 동시조음 전이 어려움, 운율 이상을 동반한다. 음운지연은 발달적 패턴이 늦게까지 남는 것, 일관적 음운장애는 비발달적 패턴을 일관되게 보이는 것이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"말소리장애 하위유형 감별\",\"p\":\"반복 산출 변이율과 운동 소견으로 Dodd 유형 판단\",\"n\":\"비일관적 음운장애: 40% 이상 변이, 모색행동·운율 이상 없음\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"아동기 말실행증(CAS)의 핵심 특징으로 옳게 묶인 것은?\",\"choices\":[\"발달적 오류패턴, 양호한 말명료도, 정확한 모음 산출\",\"과다비성, 말 근육의 근력 약화, 느린 말속도\",\"일관된 대치, 높은 자극반응도, 정상적인 운율\",\"한 음소의 일관된 왜곡, 청력 손실, 구조적 이상\",\"비일관적 오류, 동시조음 전이 어려움, 부적절한 운율\"],\"answer\":5,\"explain\":\"CAS는 말운동 계획·프로그래밍의 문제로 자음·모음의 비일관적 오류, 음소·음절 간 전이의 연장과 단절, 부적절한 강세·운율이 핵심 특징이다. 근력 약화와 과다비성은 마비말장애, 일관된 발달적 대치는 음운지연의 특징이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말운동 말소리장애\",\"k\":\"아동기 말실행증 특징\",\"p\":\"말운동 계획 결함의 핵심 증상 조합 식별\",\"n\":\"CAS: 비일관적 오류, 음소·음절 간 전이 어려움, 부적절한 운율\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"구개열 아동의 말 특성에 관한 설명으로 옳은 것은?\",\"choices\":[\"비음 /ㅁ, ㄴ, ㅇ/이 구강 자음보다 더 큰 영향을 받는다\",\"고압력 자음이 약하게 산출되고 비누출이 동반될 수 있다\",\"보상조음은 조음위치가 구강 앞쪽으로 전방화된 것이다\",\"모음이 자음보다 더 큰 영향을 받아 명료도가 낮아진다\",\"비강 공명이 부족한 과소비성이 주된 공명 문제이다\"],\"answer\":2,\"explain\":\"연인두 폐쇄부전이 있으면 구강 내 압력을 형성해야 하는 고압력 자음(파열·마찰·파찰음)이 약해지고 비누출과 과다비성이 나타난다. 비음은 원래 비강 공명을 이용하므로 영향이 적고, 보상조음(성문파열음·인두마찰음 등)은 조음위치가 뒤쪽(후방)으로 이동한 것이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"구개열·기질적 말소리장애\",\"k\":\"구개열 말 특성\",\"p\":\"연인두 폐쇄부전 영향을 근거로 말 특성 판단\",\"n\":\"연인두 폐쇄부전: 고압력 자음 약화, 비누출, 과다비성, 후방 보상조음\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"선천성 심도 감각신경성 난청 아동의 말 특성으로 옳은 것은?\",\"choices\":[\"저주파수 비음 /ㅁ, ㄴ/이 마찰음보다 먼저 손상된다\",\"모음은 손상되지 않고 자음에서만 오류가 나타난다\",\"운율과 음도는 건청 아동과 같이 정상적으로 유지된다\",\"말속도가 빠르고 말명료도가 대체로 양호하다\",\"고주파수 마찰음의 생략·왜곡, 모음 중립화가 나타난다\"],\"answer\":5,\"explain\":\"청각 피드백 결여로 고주파수 에너지가 큰 마찰음이 생략·왜곡되고, 모음이 중앙화(중립화)되며, 종성 생략과 음도·운율 이상, 과다비성이 나타나 명료도가 낮다. 저주파수 비음은 비교적 잘 산출된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"청각·청각장애\",\"k\":\"청각장애 말 특성\",\"p\":\"청각 피드백 결여에 따른 말 산출 특성 식별\",\"n\":\"심도 난청: 고주파 마찰음 생략·왜곡, 모음 중립화, 운율 이상\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"음운장애보다 조음장애(운동적 말소리장애)에 더 부합하는 특징은?\",\"choices\":[\"여러 음소에 걸쳐 일관되게 나타나는 대치 패턴\",\"종성생략이 많아 나타나는 낮은 말명료도\",\"음운인식 결함과 읽기·쓰기 어려움을 동반함\",\"/ㅅ/의 일관된 설측음화 외 다른 음소는 정확함\",\"여러 음소가 하나의 음소로 대치되는 음소 붕괴 현상\"],\"answer\":4,\"explain\":\"조음장애는 말소리 산출의 운동적 문제로 소수 음소의 일관된 왜곡이 특징이며 명료도 저하가 적다. 여러 음소에 걸친 대치 패턴, 종성생략, 음소 붕괴, 음운인식 결함은 음운 체계(언어적) 문제인 음운장애의 특징이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말소리 발달·오류패턴\",\"k\":\"조음장애·음운장애 구분\",\"p\":\"오류 범위와 일관성으로 조음장애 특징 식별\",\"n\":\"조음장애: 소수 음소 일관된 왜곡, 음운장애는 체계적 대치 패턴\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"전통적 조음치료법(Van Riper)의 단계 순서로 옳은 것은?\",\"choices\":[\"단어 훈련 → 독립음 확립 → 감각-지각 훈련 → 유지 → 전이\",\"감각-지각 훈련 → 독립음 확립 → 안정화 → 전이 → 유지\",\"독립음 확립 → 감각-지각 훈련 → 전이 → 문장 안정화 → 유지\",\"전이 → 감각-지각 훈련 → 독립음 확립 → 안정화 → 유지\",\"감각-지각 훈련 → 문장 훈련 → 독립음 확립 → 유지 → 전이\"],\"answer\":2,\"explain\":\"전통적 접근법은 목표음을 듣고 변별하는 감각-지각(청지각) 훈련으로 시작하여 독립음에서 목표음을 확립한 뒤, 음절·단어·구·문장·대화로 점차 확장(안정화)하고 치료실 밖으로 전이시킨 후 유지 단계를 거친다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"전통적 조음치료 단계\",\"p\":\"Van Riper 접근의 치료 단계 순서 선택\",\"n\":\"감각-지각 훈련 → 독립음 확립 → 안정화 → 전이 → 유지\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"짝자극 기법(paired-stimuli approach)에 관한 설명으로 옳은 것은?\",\"choices\":[\"핵심단어는 목표음을 10회 중 3회 이하로 정조음하는 단어이다\",\"정조음하는 핵심단어와 오조음하는 훈련단어를 짝지어 연습한다\",\"최소대립쌍을 이용하여 단어 간 의미 대조를 가르친다\",\"독립음 수준에서 목표음을 확립하며 훈련을 시작한다\",\"청각적 자극(auditory bombardment)이 핵심이다\"],\"answer\":2,\"explain\":\"짝자극 기법은 아동이 목표음을 안정적으로 정조음하는 핵심단어(10회 중 9회 이상 정조음)를 오조음하는 훈련단어와 번갈아 산출하게 하여 정조음을 전이시키는 단어 수준의 기법이다. 최소대립쌍은 음운론적 접근, 청각적 자극은 주기법의 절차이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"짝자극 기법 원리\",\"p\":\"핵심단어와 훈련단어 짝짓기 원리로 기법 특성 판단\",\"n\":\"짝자극 기법: 정조음 핵심단어와 오조음 훈련단어 교대 산출\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 아동이 /ㅅ, ㅈ, ㄱ, ㅋ/을 모두 /ㄷ/으로 대치함\\n(예: 사과 → [다과], 자 → [다], 공 → [동], 코 → [도])\",\"q\":\"이 아동에게 가장 적합한 대조 접근법은?\",\"choices\":[\"최소대립쌍 접근법\",\"최대대립 접근법\",\"짝자극 기법\",\"다중대립 접근법\",\"핵심어휘 접근법\"],\"answer\":4,\"explain\":\"여러 음소가 하나의 음소로 붕괴(phoneme collapse)된 경우, 대치음 /ㄷ/과 여러 목표음을 동시에 대조하는 다중대립 접근법이 적합하다. 최소대립쌍은 한 자질 차이의 두 음소, 최대대립은 자질 차이가 큰 두 음소를 대조하고, 핵심어휘 접근법은 비일관적 음운장애에 사용한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"대조 접근법 선택\",\"p\":\"여러 음소가 한 음소로 붕괴된 양상으로 접근법 선택\",\"n\":\"다중대립 접근법: 음소 붕괴 시 대치음과 여러 목표음 동시 대조\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"주기법(cycles approach)에 관한 설명으로 옳은 것은?\",\"choices\":[\"잔존오류를 보이는 학령기 아동이 주된 치료 대상이다\",\"말소리 자질에 대한 상위언어적 인식 지도가 치료의 1단계이다\",\"한 패턴을 완전히 숙달한 뒤에 다음 패턴으로 넘어간다\",\"독립음 수준의 반복적인 산출 훈련이 중심이 된다\",\"숙달 여부와 관계없이 정해진 기간 후 다음 패턴으로 순환한다\"],\"answer\":5,\"explain\":\"주기법(Hodson & Paden)은 말명료도가 매우 낮은 아동을 대상으로 오류패턴별 목표음을 일정 시간 훈련한 뒤 숙달 기준 없이 다음 패턴으로 순환하고, 회기마다 청각적 자극(auditory bombardment)을 제공한다. 숙달 후 진행은 수직적 접근, 상위언어적 인식 지도는 상위음운 접근법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"주기법 원리\",\"p\":\"숙달 기준 없는 순환 진행을 근거로 주기법 특성 판단\",\"n\":\"주기법: 명료도 낮은 아동, 숙달과 무관한 패턴 순환, 청각적 자극\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"상위음운 접근법(Metaphon)의 1단계에서 실시하는 활동으로 적절한 것은?\",\"choices\":[\"최대대립쌍 단어를 반복 산출하며 산출 정확도를 높인다\",\"구강 근육 강화 운동으로 조음기관을 준비시킨다\",\"'긴 소리/짧은 소리' 같은 대조 개념을 인식하게 한다\",\"대화 수준에서 의사소통 수정 전략을 반복 연습한다\",\"비단어 따라말하기로 음운 작업기억을 훈련한다\"],\"answer\":3,\"explain\":\"상위음운 접근법 1단계는 개념 수준(긴/짧은, 앞/뒤 등 비언어적 속성)에서 시작해 소리·음소·단어 수준으로 말소리 자질의 대조를 인식시키는 단계이고, 2단계에서 의사소통 상황에서 이를 활용해 산출을 수정하게 한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"상위음운 접근법 단계\",\"p\":\"개념 수준 대조 인식 여부로 Metaphon 1단계 활동 선택\",\"n\":\"Metaphon 1단계: 긴/짧은 등 개념 수준부터 소리 자질 대조 인식\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"핵심어휘 접근법(core vocabulary approach)에 관한 설명으로 옳은 것은?\",\"choices\":[\"최소대립쌍의 의미 대조를 이용해 음운 체계를 재구조화한다\",\"잔존오류 아동을 대상으로 /ㅅ/ 등의 왜곡음을 교정한다\",\"하나의 음소를 독립음 수준에서 먼저 확립하고 확장한다\",\"말실행증 아동의 운율과 강세 개선을 1차 목표로 삼는다\",\"비일관적 음운장애 아동에게 기능적 단어를 일관되게 산출시킨다\"],\"answer\":5,\"explain\":\"핵심어휘 접근법(Dodd)은 비일관적 음운장애 아동에게 자주 쓰는 기능적 단어를 선정하여 완전한 정조음이 아니더라도 아동이 할 수 있는 최선의 산출을 일관되게 하도록 훈련한다. 의미 대조를 이용한 재구조화는 최소대립쌍 등 음운론적 대조 접근법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"핵심어휘 접근법 대상\",\"p\":\"대상 유형과 훈련 목표로 핵심어휘 접근법 특성 판단\",\"n\":\"핵심어휘 접근법: 비일관적 음운장애, 기능적 단어의 일관된 산출\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"치료 결과, 어두 초성에서만 훈련한 /ㅅ/를 훈련하지 않은 어중 초성('가수', '버섯')에서도 정조음하게 되었다.\",\"q\":\"이에 해당하는 일반화 유형은?\",\"choices\":[\"위치 일반화\",\"언어단위 일반화\",\"상황 일반화\",\"음소 간 일반화\",\"문맥 일반화\"],\"answer\":1,\"explain\":\"단어 내 훈련하지 않은 위치(어두→어중·어말)로 정조음이 확대되는 것은 위치 일반화이다. 문맥 일반화는 인접 모음 등 음성 문맥, 언어단위 일반화는 음절→단어→문장, 상황 일반화는 치료실 밖 장소·대화상대, 음소 간 일반화는 훈련하지 않은 다른 음소로의 확대를 말한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가·분석 지표\",\"k\":\"일반화 유형 판별\",\"p\":\"훈련하지 않은 단어 내 위치로의 확대를 근거로 일반화 유형 판단\",\"n\":\"위치 일반화: 어두 훈련 효과가 어중·어말 위치로 확대\"}},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"치료사가 한 회기 안에서 /ㅅ/, /ㄹ/, 종성 /ㄱ/ 세 가지 목표를 각각 15분씩 나누어 동시에 훈련하고 있다.\",\"q\":\"이 치료사가 사용한 목표 접근 전략은?\",\"choices\":[\"수직적 접근법\",\"주기적 접근법\",\"수평적 접근법\",\"절충적 접근법\",\"위계적 접근법\"],\"answer\":3,\"explain\":\"여러 목표음을 한 회기에서 동시에 다루는 것은 수평적 접근법이다. 수직적 접근법은 한두 개 목표를 준거에 도달할 때까지 집중 훈련한 뒤 다음으로 넘어가고, 주기적 접근법은 일정 기간 단위로 목표를 순환한다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"치료 접근·목표 선정\",\"k\":\"목표 접근 전략 구분\",\"p\":\"한 회기 여러 목표 동시 훈련을 근거로 전략 식별\",\"n\":\"수평적 접근: 여러 목표 동시 훈련, 수직적은 준거 도달 후 이동\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 행동을 핵심행동과 부수행동(탈출행동·회피행동)으로 분류하려 한다.\",\"q\":\"행동과 분류가 옳게 연결된 것은?\",\"choices\":[\"말하는 도중 입술이 붙은 채 소리가 막힘 – 탈출행동\",\"막힌 순간 눈을 세게 깜박임 – 핵심행동\",\"첫소리를 길게 늘여 말함(소리 연장) – 회피행동\",\"어려운 낱말을 다른 낱말로 바꿔 말하기 – 회피행동\",\"고개를 갑자기 젖히며 막힘에서 벗어나기 – 핵심행동\"],\"answer\":4,\"explain\":\"핵심행동은 반복·연장·막힘 등 말더듬 자체이고, 부수행동은 이에 대한 반응으로 학습된 행동이다. 낱말 대치(바꿔 말하기)는 말더듬을 예상하고 미리 피하는 회피행동이다. 막힘과 연장은 핵심행동이며, 눈 깜박임·고개 젖히기처럼 이미 시작된 말더듬에서 빠져나오려는 행동은 탈출행동(부수행동)이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"핵심·부수행동 분류\",\"p\":\"말더듬 자체와 학습된 반응의 구분으로 행동 분류 짝 식별\",\"n\":\"핵심행동은 반복·연장·막힘, 낱말 대치는 회피행동, 눈 깜박임·고개 젖히기는 탈출행동\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"아동의 비유창성을 진성 비유창성(SLD)과 기타 비유창성(OD)으로 나누어 분석하려 한다.\",\"q\":\"비유창성 유형과 분류가 옳게 연결된 것은?\",\"choices\":[\"\\\"나 나 나 갈래\\\"(1음절 낱말 반복) – 기타 비유창성\",\"\\\"나는 나는 갈래\\\"(구 반복) – 기타 비유창성\",\"\\\"음, 어\\\"(간투사) – 진성 비유창성\",\"\\\"나는, 아니 우리는 갈래\\\"(수정) – 진성 비유창성\",\"\\\"ㅅ---사탕\\\"(소리 연장) – 기타 비유창성\"],\"answer\":2,\"explain\":\"진성 비유창성(SLD)은 낱말부분(음소·음절) 반복, 1음절 낱말 반복, 연장·막힘 등 비운율적 발성으로, 말더듬 아동에게 특징적이다. 기타 비유창성(OD)은 간투사, 수정, 미완성, 구·다음절 낱말 전체 반복 등 일반 아동에게도 흔한 비유창성이다. 따라서 구 반복을 기타 비유창성으로 연결한 ②만 옳다. 1음절 낱말 반복(①)과 소리 연장(⑤)은 진성 비유창성이고, 간투사(③)와 수정(④)은 기타 비유창성이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"SLD·OD 분류\",\"p\":\"비유창성 형태별 특성으로 진성·기타 비유창성 분류 판단\",\"n\":\"SLD: 낱말부분·1음절 낱말 반복·연장·막힘, OD: 간투사·수정·구 반복\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 발생·발달을 설명하는 이론에 대한 설명으로 옳은 것은?\",\"choices\":[\"진단착오이론 – 양쪽 대뇌반구의 우세 경쟁으로 말운동 협응이 실패하여 말더듬이 생긴다\",\"요구-용량 모델 – 환경적 요구가 아동의 말 산출 용량을 초과하면 비유창성이 생긴다\",\"대뇌반구 우세이론 – 부모가 정상적 비유창성을 말더듬으로 낙인찍어 말더듬이 생긴다\",\"예기투쟁가설 – 말더듬은 유전적 요인으로 생기는 말운동 조절 장애로, 학습의 영향은 적다\",\"내적수정가설 – 말더듬은 청자의 부정적 반응에 의해 강화되어 유지되는 조작적 행동이다\"],\"answer\":2,\"explain\":\"요구-용량 모델(Starkweather)은 말속도·언어 복잡성·시간 압박 등 요구가 아동의 말운동·언어·정서·인지 용량을 넘어설 때 비유창성이 발생한다고 본다. 진단착오이론은 부모의 낙인, 대뇌반구 우세이론은 양반구 우세 경쟁, 예기투쟁가설은 말더듬을 예상하고 피하려는 투쟁 반응, 내적수정가설은 음운 계획 오류를 내적으로 감지·수정하는 과정에서 비유창성이 생긴다는 설명이므로 보기의 연결은 모두 잘못되었다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"말더듬 발생 이론\",\"p\":\"이론별 핵심 설명 내용 대조로 옳은 이론 연결 식별\",\"n\":\"요구-용량 모델: 환경적 요구가 아동의 말 산출 용량을 초과하면 비유창성 발생\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"Guitar의 말더듬 발달 단계 중 '경계선급 말더듬'에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"반복 단위 수가 많으나 긴장·부수행동이 거의 없고 인식도 없다\",\"말더듬을 예상한 낱말 회피와 말하기 상황 회피가 나타나기 시작한다\",\"말더듬에 대한 두려움과 부정적 자아개념이 확고하게 자리 잡혀 있다\",\"막힘과 함께 눈 깜박임 등 탈출행동이 뚜렷하게 나타난다\",\"비유창성 대부분이 간투사·수정이며 그 빈도도 낮은 편이다\"],\"answer\":1,\"explain\":\"경계선급 말더듬은 정상적 비유창성보다 비유창성 빈도가 높고(대략 100낱말당 10회 이상) 반복 단위 수가 2회 이상으로 많으나, 긴장·막힘·탈출행동은 거의 없고 아동이 자신의 말을 의식하지 않는 단계이다. 막힘과 탈출행동은 초기 말더듬, 회피와 두려움은 중간급, 부정적 자아개념의 확립은 심화된 말더듬의 특징이며 간투사·수정 위주의 낮은 빈도는 정상적 비유창성에 해당한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"발달 단계·감별\",\"k\":\"Guitar 발달 단계 특징\",\"p\":\"반복 단위 수·긴장·인식 유무로 경계선급 말더듬 특징 식별\",\"n\":\"경계선급 말더듬: 반복 단위 수 많음, 긴장·부수행동 거의 없음, 인식 없음\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 52세 남성, 뇌경색 후 말더듬이 시작됨\\n• 아동기 말더듬 병력 없음\\n• 조사·어미 등 기능어와 내용어를 가리지 않고 반복이 나타남\\n• 같은 문장을 반복해서 읽어도 말더듬이 줄지 않음\\n• 부수행동과 말에 대한 불안이 거의 없음\",\"q\":\"이 대상자에게 가장 적절한 유창성장애 유형은?\",\"choices\":[\"발달성 말더듬\",\"속화(말빠름증)\",\"심인성 말더듬\",\"신경학적 말더듬\",\"경계선급 말더듬\"],\"answer\":4,\"explain\":\"성인기 뇌손상 이후 시작되고, 기능어·내용어 구분 없이 낱말 위치와 무관하게 비유창성이 나타나며, 적응효과가 없고 부수행동과 불안이 적은 것은 신경학적 말더듬의 특징이다. 발달성 말더듬은 아동기에 시작되고 적응효과와 부수행동을 보이며, 심인성 말더듬은 심리적 외상·스트레스 사건 이후 시작되고 뇌손상이 없다. 속화는 빠르고 불규칙한 말속도와 명료도 저하가 핵심이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"발달 단계·감별\",\"k\":\"신경학적 말더듬 감별\",\"p\":\"뇌손상 후 발병·적응효과 부재·불안 부재로 유창성장애 유형 판단\",\"n\":\"신경학적 말더듬: 뇌손상 후 발병, 낱말 위치 무관, 적응효과 없음, 불안 적음\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"속화(cluttering)에 대한 설명으로 옳은 것은?\",\"choices\":[\"자신의 말 문제를 잘 인식하며 말하기 불안과 회피가 높다\",\"소리·음절 반복과 막힘, 탈출행동이 핵심행동으로 나타난다\",\"말에 주의를 기울여 천천히 말할수록 명료도가 더 나빠진다\",\"언어·화용 및 주의집중 문제는 대체로 동반되지 않는다\",\"빠르고 불규칙한 말속도와 음절 축약·생략으로 명료도가 낮다\"],\"answer\":5,\"explain\":\"속화는 빠르거나 불규칙한 말속도, 음절·낱말의 축약과 생략, 과도한 정상적 비유창성으로 명료도가 떨어지는 유창성장애이며, 언어·화용·주의 문제를 자주 동반한다. 말더듬과 달리 자신의 문제에 대한 인식과 불안이 낮고, 주의를 기울이면 말이 오히려 좋아지는 경향이 있다. 막힘·탈출행동은 말더듬의 특징이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"발달 단계·감별\",\"k\":\"속화 특징\",\"p\":\"말속도·명료도·인식 수준으로 말더듬과 구별되는 속화 특징 식별\",\"n\":\"속화: 빠르고 불규칙한 말속도, 음절 축약·생략, 명료도 저하, 인식·불안 낮음\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말의 유창성을 구성하는 요소로 옳게 묶인 것은?\",\"choices\":[\"명료도 – 강도 – 음도 – 공명\",\"연속성 – 정확성 – 강도 – 음도\",\"정확성 – 명료도 – 억양 – 공명\",\"연속성 – 말속도 – 리듬 – 노력\",\"정확성 – 노력 – 공명 – 억양\"],\"answer\":4,\"explain\":\"유창한 말은 끊김 없이 이어지고(연속성), 적절한 속도와 리듬을 유지하며, 신체적·정신적 노력이 적게 드는 말이다. 명료도·강도·음도·공명·정확성은 조음·음성 영역의 개념으로 유창성 자체의 구성요소가 아니다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"유창성 구성요소\",\"p\":\"유창성 요소와 조음·음성 영역 개념 구분으로 구성요소 식별\",\"n\":\"유창성 구성요소: 연속성·말속도·리듬·노력, 명료도·공명은 조음·음성 개념\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"학령전 말더듬 아동 중 자연회복 가능성이 가장 높은 경우는?\",\"choices\":[\"음운·언어 능력이 또래보다 뚜렷하게 낮은 남아이다\",\"말더듬이 성인기까지 지속된 가족력이 있는 남아이다\",\"발병 후 18개월 이상 지속되며 부수행동이 늘고 있다\",\"여아이며 발병 후 수개월 사이 비유창성이 줄고 있다\",\"5세 이후에 발병하였고 비유창성 빈도에 변화가 없다\"],\"answer\":4,\"explain\":\"자연회복과 관련된 긍정적 예후 요인은 여아, 발병 초기 수개월 이내에 비유창성이 감소하는 경향, 이른 발병, 회복된 가족력, 양호한 음운·언어 능력 등이다. 반대로 남아, 지속된 가족력, 발병 후 12개월 이상 지속, 늦은 발병, 음운 능력 저하, 부수행동 증가는 지속 위험 요인이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"말더듬 이론·특성\",\"k\":\"자연회복 예후 요인\",\"p\":\"성별·발병 후 경과·가족력으로 자연회복 가능성 판단\",\"n\":\"자연회복 긍정 요인: 여아, 발병 초기 비유창성 감소, 회복된 가족력, 양호한 언어능력\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말을 더듬는 사람의 말더듬이 일반적으로 감소하는 조건은?\",\"choices\":[\"전화로 낯선 사람과 통화하며 용건을 전할 때\",\"노래하거나 다른 사람과 함께 소리 내어 읽을 때\",\"시간 압박이 큰 상황에서 빠르게 대답할 때\",\"이름·주소 등 바꿔 말할 수 없는 정보를 말할 때\",\"권위 있는 사람 앞에서 공식적으로 발표할 때\"],\"answer\":2,\"explain\":\"노래, 합창읽기(함께 읽기), 혼잣말, 리듬에 맞춰 말하기, 속삭이기 등은 대표적인 유창성 유도 조건이다. 전화 통화, 권위 있는 청자, 시간 압박, 대치할 수 없는 고유 정보(이름·주소) 말하기는 말더듬이 증가하는 상황이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"유창성 유도 조건\",\"p\":\"말더듬 감소 조건과 증가 상황 구분으로 해당 조건 식별\",\"n\":\"유창성 유도 조건: 노래·합창읽기·리듬 말하기·속삭이기, 시간 압박은 증가 요인\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인이 같은 지문을 5회 반복해서 읽었다. 1회에서 더듬은 낱말의 대부분을 5회에서도 같은 위치에서 더듬었다.\",\"q\":\"이 현상을 설명하는 용어는?\",\"choices\":[\"적응효과\",\"일관성 효과\",\"인접효과\",\"청자규모효과\",\"교환효과\"],\"answer\":2,\"explain\":\"반복 읽기에서 말더듬이 발생하는 낱말의 위치가 일정하게 유지되는 현상은 일관성 효과이다. 적응효과는 반복 읽기에서 말더듬 빈도가 점차 감소하는 현상, 인접효과는 이전에 더듬었던 낱말을 제거하면 그 인접 낱말에서 말더듬이 나타나는 현상, 청자규모효과는 청자 수가 많아질수록 말더듬이 증가하는 현상이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"반복 읽기 효과 용어\",\"p\":\"반복 읽기에서 같은 위치 말더듬 유지 현상으로 용어 식별\",\"n\":\"일관성 효과: 반복 읽기에서 같은 낱말 위치에 말더듬 유지, 적응효과는 빈도 감소\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 역학적 특성에 대한 설명으로 옳은 것은?\",\"choices\":[\"출현율은 일생 동안 한 번이라도 말더듬을 경험한 사람의 비율이다\",\"성인기로 갈수록 남녀 비율이 점차 1:1에 가까워진다\",\"대부분 학령기 이후인 7세 이후에 처음 발병한다\",\"발생률이 출현율보다 높은 것은 상당수가 자연회복되기 때문이다\",\"말더듬 발생은 가족력과 뚜렷한 관련이 없다\"],\"answer\":4,\"explain\":\"발생률(일생 중 말더듬을 경험하는 비율, 약 5% 내외)이 출현율(특정 시점의 말더듬 인구 비율, 약 1%)보다 높은 이유는 학령전기에 발병한 아동의 상당수가 자연회복되기 때문이다. 출현율은 특정 시점의 비율이고, 남녀 비율은 연령이 높아질수록 남성 쪽으로 더 커지며(약 4:1), 발병은 대부분 2~5세 학령전기에 일어나고 가족력은 중요한 위험 요인이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"말더듬 역학\",\"p\":\"발생률과 출현율 정의 및 자연회복 관계로 옳은 설명 식별\",\"n\":\"발생률이 출현율보다 높은 이유: 학령전 발병 아동 상당수의 자연회복\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"회피행동의 유형과 예가 옳게 연결된 것은?\",\"choices\":[\"상황회피 – 더듬을 것 같은 어려운 낱말을 쉬운 다른 낱말로 바꿔 말함\",\"대치(substitution) – 막힌 순간 눈을 깜박이며 빠져나옴\",\"에두르기(circumlocution) – 말해야 하는 상황 자체에 참여하지 않음\",\"시작기법(starter) – 더듬었던 낱말을 다시 한 번 말함\",\"연기(postponement) – 어려운 낱말 앞에서 '음…'을 넣어 시작을 미룸\"],\"answer\":5,\"explain\":\"연기는 어려운 낱말 앞에서 간투사·쉼 등으로 시간을 끌어 말더듬을 미루는 회피행동이다. 대치는 어려운 낱말을 다른 낱말로 바꾸는 것이고, 에두르기는 낱말을 피해 돌려 설명하는 것이며, 시작기법은 '그러니까' 같은 말을 앞에 붙여 발화를 시작하는 것, 상황회피는 말하는 상황 자체를 피하는 것이다. 눈 깜박임으로 빠져나오는 것은 회피가 아니라 탈출행동이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"말더듬 이론·특성\",\"k\":\"회피행동 유형\",\"p\":\"회피행동 하위 유형의 정의와 예의 연결로 옳은 짝 식별\",\"n\":\"연기: 어려운 낱말 앞 간투사·쉼으로 시작 지연, 대치·에두르기·상황회피와 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"학령기 말더듬 아동의 치료에 대한 설명으로 옳은 것은?\",\"choices\":[\"학교 환경(교사·또래) 요인은 치료 범위에 포함하지 않는다\",\"인식이 생기기 전이므로 부모 중심의 간접치료만 실시한다\",\"놀림에 대처하는 방법과 말더듬에 대한 개방적 태도를 함께 다룬다\",\"부모의 참여는 학령전기에만 필요하므로 치료에서 배제한다\",\"소리 내어 읽기 등 학급 활동에서 면제받도록 교사에게 요청한다\"],\"answer\":3,\"explain\":\"학령기 아동은 말더듬에 대한 인식과 부정적 감정, 또래의 놀림이 문제가 되는 시기이므로 유창성 기법과 함께 놀림·괴롭힘 대처, 말더듬에 대한 개방적 태도, 교사·부모와의 협력을 다룬다. 이 시기에는 직접치료가 중심이 되며, 학급 활동 면제는 회피를 강화하므로 적절하지 않다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"학령기 말더듬 치료 원칙\",\"p\":\"학령기 인식·놀림 문제 고려로 적절한 치료 내용 선택\",\"n\":\"학령기 치료: 직접치료 중심, 놀림 대처·개방적 태도·교사·부모 협력\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"파라다이스-유창성 검사-II(P-FA-II)에 대한 설명으로 옳은 것은?\",\"choices\":[\"의사소통태도 평가는 취학전 아동을 포함한 모든 연령 집단에 실시한다\",\"필수과제는 연령과 관계없이 읽기와 대화 두 가지로만 구성된다\",\"취학전·초등학생·중학생 이상의 연령 집단별로 과제가 구성되어 있다\",\"결과는 %SS로만 산출하며 백분위 점수는 제공하지 않는다\",\"구어 평가에서 핵심행동만 평가하고 부수행동은 평가하지 않는다\"],\"answer\":3,\"explain\":\"P-FA-II는 취학전 아동, 초등학생, 중학생 이상의 세 연령 집단에 맞춘 필수과제와 선택과제로 구성되며, 구어 평가(핵심행동)와 부수행동, 의사소통태도를 평가하고 백분위 점수로 중증도를 해석한다. 의사소통태도 평가는 초등학생 이상에게 실시하며, 필수과제는 연령별로 낱말그림·따라말하기·문장그림·읽기·이야기그림·말하기그림 등 여러 과제로 구성된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"P-FA-II 구성\",\"p\":\"연령 집단별 과제 구성과 평가 영역으로 검사 특징 식별\",\"n\":\"P-FA-II: 취학전·초등·중학생 이상별 과제, 구어·부수행동·의사소통태도, 백분위\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대화 발화 표본 분석\\n• 전체 음절 수: 250음절\\n• 말더듬이 나타난 음절 수: 15음절\",\"q\":\"이 대상자의 말더듬 음절 백분율(%SS)은?\",\"choices\":[\"4 %SS\",\"5 %SS\",\"15 %SS\",\"7.5 %SS\",\"6 %SS\"],\"answer\":5,\"explain\":\"%SS = (말더듬 음절 수 ÷ 전체 음절 수) × 100 = 15 ÷ 250 × 100 = 6 %SS이다. 말더듬 음절 백분율은 발화 표본의 전체 음절 수를 분모로 하며, 말더듬 순간의 횟수를 그대로 백분율로 쓰지 않는다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"%SS 산출\",\"p\":\"말더듬 음절 수와 전체 음절 수로 말더듬 음절 백분율 산출\",\"n\":\"%SS: 말더듬 음절 수 ÷ 전체 음절 수 × 100\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬 정도 측정 검사(SSI-4)에서 '지속시간' 점수를 산출하는 방법은?\",\"choices\":[\"가장 긴 말더듬 순간 3개의 평균 지속시간을 구한다\",\"가장 짧은 말더듬 순간의 지속시간을 사용한다\",\"전체 발화 시간에서 말더듬 시간이 차지하는 비율을 구한다\",\"모든 말더듬 순간의 지속시간을 평균한다\",\"모든 말더듬 순간의 지속시간을 합산한다\"],\"answer\":1,\"explain\":\"SSI-4의 지속시간 점수는 발화 표본에서 가장 긴 말더듬 순간 3개의 평균 지속시간을 측정하여 척도 점수로 변환한다. SSI-4의 총점은 빈도(%SS), 지속시간, 신체적 부수행동 점수의 합으로 산출된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"SSI-4 지속시간 채점\",\"p\":\"SSI-4 채점 규칙으로 지속시간 점수 산출 방법 선택\",\"n\":\"SSI-4 지속시간: 가장 긴 말더듬 3개의 평균, 총점은 빈도·지속시간·부수행동 합\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인이 말더듬에 대해 느끼는 정서·행동적 반응, 일상 의사소통의 어려움, 삶의 질에 미치는 영향을 자기보고식으로 평가하려 한다.\",\"q\":\"가장 적절한 도구는?\",\"choices\":[\"말더듬 전반적 경험 평가(OASES)\",\"P-FA-II 필수과제\",\"말더듬 음절 백분율(%SS) 산출\",\"말더듬 정도 측정 검사(SSI-4)\",\"한국 아동 말더듬 검사(KOCS)\"],\"answer\":1,\"explain\":\"OASES는 말더듬에 대한 일반 정보, 정서·행동·인지적 반응, 일상 의사소통, 삶의 질의 네 영역을 자기보고로 평가하여 말더듬이 화자의 삶에 미치는 영향을 파악하는 도구이다. SSI-4와 %SS는 외현적 말더듬 행동의 중증도·빈도를 측정하고, KOCS는 아동용 검사이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"평가도구\",\"k\":\"말더듬 삶의 질 평가도구\",\"p\":\"자기보고로 정서·일상·삶의 질 영향을 보는 목적으로 도구 선택\",\"n\":\"OASES: 정서·행동·인지 반응, 일상 의사소통, 삶의 질을 자기보고로 평가\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"아동 발화: \\\"책책책상 위에 있어요.\\\"\",\"q\":\"'책책책상'에서 나타난 낱말부분 반복의 단위반복수는?\",\"choices\":[\"2\",\"1\",\"3\",\"4\",\"5\"],\"answer\":1,\"explain\":\"단위반복수는 목표 낱말이 산출되기 전에 반복된 단위의 횟수이다. '책책책상'은 목표 낱말 '책상'의 첫 음절 '책'이 두 번 더 반복된 것이므로 단위반복수는 2이다. 산출된 음절 '책'의 총 개수(3)와 혼동하지 않아야 한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"단위반복수 산출\",\"p\":\"목표 낱말 산출 전 반복된 단위 횟수로 단위반복수 산출\",\"n\":\"단위반복수: 목표 낱말 산출 전에 반복된 단위의 횟수, 산출 음절 총수와 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말속도 측정에 대한 설명으로 옳은 것은?\",\"choices\":[\"전체 말속도는 발화 중 쉼 시간을 제외하고 산출한다\",\"조음속도는 쉼과 비유창성 시간을 제외하고 산출한다\",\"말속도는 분당 낱말 수(WPM)로만 측정할 수 있다\",\"조음속도는 일반적으로 전체 말속도보다 느리게 산출된다\",\"말더듬에 소요된 시간은 조음속도 산출에 포함한다\"],\"answer\":2,\"explain\":\"조음속도는 쉼·주저·말더듬 등 비유창성 시간을 제외한 순수 조음 시간을 기준으로 산출하므로 전체 말속도보다 같거나 빠르게 나온다. 전체 말속도는 쉼을 포함한 전체 발화 시간으로 산출하며, 말속도는 초당 음절 수, 분당 음절 수, 분당 낱말 수 등 여러 단위로 측정할 수 있다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"비유창성 분석\",\"k\":\"말속도·조음속도 측정\",\"p\":\"쉼·비유창성 시간 포함 여부로 말속도와 조음속도 구분 판단\",\"n\":\"조음속도: 쉼·비유창성 시간 제외로 산출, 전체 말속도보다 같거나 빠름\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"Yairi와 Ambrose의 기준에 따라 학령전 아동을 말더듬으로 판단하는 진성 비유창성(SLD) 빈도는?\",\"choices\":[\"100음절당 3회 이상\",\"100음절당 2회 이상\",\"100음절당 1회 이상\",\"100음절당 5회 이상\",\"100음절당 10회 이상\"],\"answer\":1,\"explain\":\"Yairi와 Ambrose는 100음절당 진성 비유창성(낱말부분 반복, 1음절 낱말 반복, 비운율적 발성)이 3회 이상이면 말더듬으로 간주하는 기준을 제시하였다. 진성 비유창성이 3회 미만이고 간투사·수정 등 기타 비유창성 위주이면 정상적 비유창성으로 본다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"발달 단계·감별\",\"k\":\"말더듬 판정 SLD 기준\",\"p\":\"100음절당 진성 비유창성 빈도로 학령전 말더듬 여부 판단\",\"n\":\"Yairi와 Ambrose 기준: 100음절당 SLD 3회 이상이면 말더듬으로 간주\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"유창성완성법과 말더듬수정법을 비교한 설명으로 옳은 것은?\",\"choices\":[\"유창성완성법은 조절 유창성과 수용 말더듬을 최종 치료 목표로 한다\",\"말더듬수정법은 느린 말속도·부드러운 발성 등 새 말하기 방식을 모든 발화에 적용한다\",\"말더듬수정법은 더 쉽게 더듬도록 말더듬 순간을 수정하고 두려움·회피를 줄인다\",\"두 접근 모두 부수행동과 말더듬에 대한 정서·태도는 다루지 않는다\",\"유창성완성법은 말더듬에 대한 감정·태도 변화를 가장 우선적인 목표로 한다\"],\"answer\":3,\"explain\":\"말더듬수정법(Van Riper)은 말더듬 순간을 확인·둔감·수정하여 더 쉽고 편하게 더듬게 하며, 말더듬에 대한 두려움과 회피를 줄이는 데 초점을 둔다(목표: 조절 유창성·수용 말더듬). 유창성완성법은 느린 말속도, 부드러운 발성 등 새로운 말하기 방식을 학습하여 유창한 말을 산출하는 것을 목표로 하며 감정·태도는 부차적으로 다룬다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"유창성완성법·수정법 비교\",\"p\":\"두 치료 접근의 목표와 초점 차이로 옳은 비교 설명 선택\",\"n\":\"말더듬수정법: 더 쉽게 더듬기와 두려움·회피 감소, 유창성완성법은 새 말하기 방식 학습\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"Van Riper 말더듬수정법의 치료 단계를 순서대로 옳게 나열한 것은?\",\"choices\":[\"둔감 → 확인 → 변형 → 수정 → 안정\",\"확인 → 변형 → 둔감 → 수정 → 안정\",\"확인 → 둔감 → 수정 → 변형 → 안정\",\"변형 → 확인 → 둔감 → 수정 → 안정\",\"확인 → 둔감 → 변형 → 수정 → 안정\"],\"answer\":5,\"explain\":\"말더듬수정법은 자신의 말더듬 행동을 인식하는 확인(동일시) 단계, 말더듬과 청자 반응에 대한 두려움을 줄이는 둔감 단계, 말더듬 형태를 의도적으로 바꾸어 통제 가능성을 경험하는 변형 단계, 취소·빠져나오기·준비하기로 더 쉽게 더듬는 수정(접근) 단계, 이를 일상에 유지·일반화하는 안정 단계 순으로 진행된다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬 수정법 단계\",\"p\":\"Van Riper 말더듬수정법 단계의 진행 순서 선택\",\"n\":\"Van Riper 단계: 확인→둔감→변형→수정→안정\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대상자가 낱말 도중 막힘이 나타나자 멈추거나 되돌아가지 않고, 막힌 상태에서 조음기관의 긴장을 서서히 풀면서 소리를 부드럽게 늘여 그 낱말을 끝까지 산출하였다.\",\"q\":\"이 장면에서 사용된 말더듬수정법의 기법은?\",\"choices\":[\"준비하기(preparatory set)\",\"취소(cancellation)\",\"빠져나오기(pull-out)\",\"가벼운 조음접촉(light contact)\",\"지연청각피드백(DAF)\"],\"answer\":3,\"explain\":\"빠져나오기는 말더듬이 진행되는 도중에 멈추지 않고 긴장을 풀며 부드럽게 낱말을 완성하는 기법이다. 취소는 더듬은 낱말을 끝낸 뒤 잠시 멈추고 다시 편안하게 말하는 것이고, 준비하기는 더듬을 것이 예상되는 낱말 앞에서 미리 부드럽게 접근하는 것이다. 가벼운 조음접촉과 지연청각피드백은 말더듬수정법의 단계별 기법이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령기·성인 치료\",\"k\":\"말더듬 수정 기법 식별\",\"p\":\"막힘 도중 긴장을 풀며 낱말을 완성하는 장면으로 기법 식별\",\"n\":\"빠져나오기: 말더듬 도중 멈추지 않고 긴장을 풀며 낱말 완성, 취소·준비하기와 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"리드콤 프로그램(Lidcombe Program)에 대한 설명으로 옳은 것은?\",\"choices\":[\"치료사가 아동에게 느린 말속도와 부드러운 발성을 직접 훈련한다\",\"아동의 말더듬에 대해서는 어떤 언급도 하지 않는 것이 원칙이다\",\"부모의 말속도와 가정 환경을 조정하는 간접치료 방식의 프로그램이다\",\"학령기 이상 아동과 성인에게 주로 적합한 프로그램이다\",\"부모가 아동의 유창한 말에 구어 수반 자극을 제공하는 직접치료이다\"],\"answer\":5,\"explain\":\"리드콤 프로그램은 학령전 말더듬 아동을 대상으로, 훈련받은 부모가 가정의 일상 대화에서 아동의 유창한 말에 칭찬을, 더듬은 말에는 가끔 부드러운 지적을 제공하는 행동주의(조작적 조건화)에 기초한 직접치료이며 부모가 매일 말더듬 중증도를 평정한다. 새로운 말하기 방식을 가르치거나 환경만 조정하는 접근이 아니다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"리드콤 프로그램 원리\",\"p\":\"부모가 제공하는 구어 수반 자극 방식으로 프로그램 특징 식별\",\"n\":\"리드콤: 학령전 대상, 부모가 유창한 말에 칭찬·더듬은 말에 지적하는 직접치료\"}},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 3세 2개월 아동, 3개월 전부터 말더듬 시작\\n• 긴장이 없는 낱말부분 반복이 주로 관찰됨\\n• 아동은 자신의 말을 의식하지 않음\\n• 부모가 빠른 말속도로 질문을 많이 함\",\"q\":\"이 아동에게 우선적으로 적용할 접근으로 가장 적절한 것은?\",\"choices\":[\"말더듬에 대한 둔감화 훈련을 아동에게 직접 실시한다\",\"아동에게 취소·빠져나오기 기법을 직접 훈련한다\",\"부모 교육으로 부모의 말속도를 늦추고 질문을 줄이게 한다\",\"말할 때 지연청각피드백 기기를 사용하게 한다\",\"아동에게 말더듬을 의도적으로 흉내 내게 하여 인식을 높인다\"],\"answer\":3,\"explain\":\"발병 초기이고 긴장·인식이 없는 학령전 아동에게는 요구-용량 모델에 근거하여 부모의 말속도, 질문 빈도, 대화 차례 주고받기 등 환경적 요구를 줄이는 간접치료(부모 교육)를 우선 적용한다. 취소·빠져나오기·둔감화는 말더듬을 인식하고 있는 학령기 이상 대상자의 말더듬수정법 기법이며, 아동에게 말더듬을 의식시키는 활동은 이 단계에서 적절하지 않다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"학령전 아동 치료·부모 상담\",\"k\":\"학령전 간접치료 선택\",\"p\":\"발병 초기·인식 없음·부모 빠른 말속도로 우선 중재 접근 선택\",\"n\":\"인식 없는 학령전 아동: 부모 말속도·질문 줄이기 등 환경 요구 조정 간접치료\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동은 성인과의 상호작용 속에서 혼자서는 할 수 없지만 도움을 받으면 할 수 있는 수준의 과제를 수행하며 언어를 습득한다. 성인은 아동의 수준에 맞추어 지원(비계)을 제공하고 점차 줄여 나간다.\",\"q\":\"이 설명에 해당하는 언어습득 이론은?\",\"choices\":[\"행동주의 학습 이론\",\"생득주의 언어 이론\",\"인지적 구성주의 이론\",\"연결주의 이론\",\"사회적 상호작용주의 이론\"],\"answer\":5,\"explain\":\"근접발달영역과 비계(scaffolding)는 비고츠키의 사회적 상호작용주의의 핵심 개념으로, 성인과의 상호작용이 언어 습득의 주된 동력이라고 본다. 행동주의는 모방·강화, 생득주의는 타고난 언어습득장치(LAD), 인지적 구성주의(피아제)는 인지 발달이 언어에 선행한다고 보며, 연결주의는 입력의 통계적 규칙성 학습으로 설명한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"언어습득 이론 구분\",\"p\":\"근접발달영역과 비계 개념으로 언어습득 이론 식별\",\"n\":\"사회적 상호작용주의(비고츠키): 근접발달영역, 비계, 성인과의 상호작용\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"반복적(음절성) 옹알이 단계에 관한 설명으로 옳은 것은?\",\"choices\":[\"문장과 유사한 억양 패턴을 지닌 자곤(jargon)이 주로 나타난다\",\"목 뒤쪽에서 나는 '구구' 소리가 특징이며 생후 2~3개월경 나타난다\",\"'바바바'처럼 동일한 자음-모음 음절을 반복하며 6~9개월경 나타난다\",\"관습적 의미를 지닌 첫 낱말이 이 시기에 처음 산출되기 시작한다\",\"서로 다른 자음과 모음이 섞인 '바다구'와 같은 다양한 음절 연쇄가 주를 이룬다\"],\"answer\":3,\"explain\":\"반복적(canonical) 옹알이는 동일 CV 음절을 반복하는 것으로 대략 6~9개월경 출현한다. ②는 쿠잉(2~3개월), ①은 자곤(10개월 이후), ④는 첫 낱말기(12개월 전후), ⑤는 다양한 음절이 섞이는 변형적(variegated) 옹알이에 해당한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"옹알이 발달 단계\",\"p\":\"음절 반복 형태와 출현 시기로 반복적 옹알이 특성 판단\",\"n\":\"반복적 옹알이: 동일 CV 음절 반복, 6~9개월경 출현\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"12개월 아동\\n• 원하는 장난감을 향해 손을 뻗으며 '어어' 소리를 내고 엄마 얼굴을 번갈아 쳐다본다.\\n• 아직 관습적인 낱말은 산출하지 않는다.\",\"q\":\"베이츠(Bates)의 의사소통 의도 발달 단계 중 이 아동이 속한 단계는?\",\"choices\":[\"언향적(perlocutionary) 단계\",\"언표적(locutionary) 단계\",\"언표내적(illocutionary) 단계\",\"자곤 단계\",\"낱말조합 단계\"],\"answer\":3,\"explain\":\"몸짓·발성·시선 교대로 의도를 관습적으로 표현하지만 아직 낱말을 사용하지 않는 시기는 언표내적 단계(약 8~12개월)이다. 언향적 단계는 아동에게 의도가 없고 성인이 해석해 주는 시기이며, 언표적 단계는 낱말로 의도를 표현하는 시기이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"의사소통 의도 발달 단계\",\"p\":\"몸짓·시선 교대 사용과 낱말 부재로 Bates 단계 판단\",\"n\":\"언표내적 단계: 몸짓·발성·시선 교대로 의도 표현, 낱말 이전\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"엄마와 아동이 창가에 있다.\\n아동: (창밖의 새를 가리키며 엄마 얼굴을 쳐다본다) 어! 어!\\n엄마: 응, 새가 있네.\",\"q\":\"아동이 보인 의사소통 기능은?\",\"choices\":[\"사물 요구하기\",\"행동 요구하기\",\"거부하기\",\"인사하기\",\"서술하기\"],\"answer\":5,\"explain\":\"아동이 대상을 가리키며 성인의 시선을 끌어 관심을 공유하려는 행동은 원시서술(protodeclarative)로, 서술·주의끌기 기능에 해당한다. 사물을 얻거나 행동을 시키기 위한 가리키기는 원시명령(protoimperative)에 해당하는 요구하기 기능이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"의사소통 기능 판별\",\"p\":\"관심 공유를 위한 가리키기와 시선으로 기능 판단\",\"n\":\"원시서술: 관심 공유를 위한 가리키기, 원시명령은 요구 목적\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"두 낱말 발화의 의미관계 분석으로 옳은 것은?\",\"choices\":[\"\\\"엄마 가방\\\": 행위자-대상\",\"\\\"공 커\\\": 대상-행위\",\"\\\"또 줘\\\": 재현-행위\",\"\\\"안 먹어\\\": 부정-대상\",\"\\\"여기 앉아\\\": 대상-행위\"],\"answer\":3,\"explain\":\"'또 줘'는 되풀이를 요구하는 재현(recurrence)-행위 관계이다. '엄마 가방'은 소유자-대상, '공 커'는 실체-서술(상태), '안 먹어'는 부정-행위, '여기 앉아'는 장소-행위로 분석한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"두 낱말 의미관계 분석\",\"p\":\"두 낱말 발화의 의미 구성으로 의미관계 판단\",\"n\":\"재현-행위: 또 줘, 소유자-대상·부정-행위·장소-행위 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동 발화 4개\\n① 엄마 물 줘\\n② 공 던져\\n③ 아빠가 왔어\\n④ 안 먹어\",\"q\":\"위 발화의 평균형태소길이(MLU-m)는? (용언의 어간과 어미는 각각 형태소로 계산한다)\",\"choices\":[\"3.75\",\"3.50\",\"3.25\",\"4.00\",\"4.25\"],\"answer\":1,\"explain\":\"①엄마/물/주-/-어(4) ②공/던지-/-어(3) ③아빠/-가/오-/-았-/-어(5) ④안/먹-/-어(3)로 총 15개 형태소이며, 15÷4=3.75이다. 조사(-가)와 선어말어미(-았-), 종결어미(-어)를 각각 세지 않으면 값이 낮게 산출된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"MLU-m 산출\",\"p\":\"어간·어미·조사를 각각 세어 평균형태소길이 산출\",\"n\":\"MLU-m: 총 형태소 수/발화 수, 조사·선어말어미·어말어미 각각 계산\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"자발화 표본 수집과 분석에 관한 설명으로 옳은 것은?\",\"choices\":[\"'네/아니오'로 답하는 질문을 주로 사용하여 발화를 유도한다\",\"아동이 직전 발화를 그대로 반복한 발화도 모두 분석 대상에 포함한다\",\"발화 10개 정도만 수집해도 신뢰로운 분석이 가능하다\",\"알아들을 수 없는 발화도 형태소 수 계산에 포함한다\",\"놀이·대화 등 두 가지 이상의 상황에서 표본을 수집한다\"],\"answer\":5,\"explain\":\"자발화는 아동의 대표적 언어 수행을 반영해야 하므로 여러 상황·대화 상대에서 충분한 양(일반적으로 50~100발화 이상)을 수집한다. 예/아니오 질문은 발화 길이를 제한하고, 즉각 반복·모방 발화와 불명료 발화는 MLU 등 분석에서 제외하는 것이 원칙이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"문법·형태\",\"k\":\"자발화 표본 수집 원칙\",\"p\":\"표본 수집 상황과 분석 제외 기준으로 옳은 원칙 판단\",\"n\":\"자발화: 둘 이상 상황에서 충분히 수집, 모방·불명료 발화 제외\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동: 잼 줘.\\n치료사: 응? 뭐라고?\\n아동: 딸기 잼 줘요, 빵에 발라 먹게.\",\"q\":\"치료사의 명료화 요구에 대해 아동이 사용한 대화 수정 전략은?\",\"choices\":[\"반복(repetition)\",\"첨가(addition)\",\"단서 제공(cue)\",\"수정(revision)\",\"무반응\"],\"answer\":2,\"explain\":\"원래 발화의 내용을 유지하면서 새로운 정보(딸기, 빵에 발라 먹게)를 덧붙였으므로 첨가 전략이다. 반복은 같은 발화를 그대로 되풀이하는 것, 수정은 낱말이나 문장 형태를 바꾸어 말하는 것이며, 단서 제공은 배경 정보를 설명해 청자의 이해를 돕는 전략이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"화용·대화\",\"k\":\"대화 수정 전략 판별\",\"p\":\"원 발화에 새 정보를 덧붙인 반응으로 수정 전략 판단\",\"n\":\"첨가 전략: 원 발화 유지하며 새 정보 추가, 수정은 형태 변경\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"어느 날 지우는 공원에서 연을 날렸어요.\\n그런데 연줄이 끊어져 연이 나무에 걸렸어요.\\n지우는 너무 속상해서 울고 싶었어요.\\n지우는 긴 막대기로 연을 내리려고 했어요.\\n결국 연을 다시 찾았어요.\\n지우는 기분이 좋아졌어요.\",\"q\":\"세 번째 문장 '지우는 너무 속상해서 울고 싶었어요.'에 해당하는 이야기 문법(story grammar) 요소는?\",\"choices\":[\"내적 반응\",\"계기 사건\",\"배경\",\"시도\",\"결과\"],\"answer\":1,\"explain\":\"계기 사건(연이 나무에 걸림)에 대한 주인공의 감정·생각은 내적 반응이다. 첫 문장은 배경, 둘째는 계기 사건, 넷째는 시도, 다섯째는 결과, 마지막은 반응(결말)에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"이야기·담화\",\"k\":\"이야기 문법 요소 판별\",\"p\":\"계기 사건에 대한 인물의 감정 진술로 이야기 문법 요소 판단\",\"n\":\"내적 반응: 계기 사건에 대한 주인공의 감정·생각\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"이야기에 나타난 결속표지(cohesive device)의 유형이 옳게 연결된 것은?\",\"choices\":[\"\\\"비가 많이 왔어. 그래서 우산을 썼어.\\\" – 생략\",\"\\\"형이 공을 찼어. 그것은 멀리 갔어.\\\" – 지시(대용)\",\"\\\"강아지가 크게 짖었어. 그 개는 무서웠어.\\\" – 접속\",\"\\\"나는 빵을, 동생은 우유를 먹었어.\\\" – 지시(대용)\",\"\\\"먼저 손을 씻고, 그다음에 밥을 먹어.\\\" – 어휘적 결속\"],\"answer\":2,\"explain\":\"'그것'이 앞 문장의 '공'을 가리키므로 지시(대용) 결속이다. ①의 '그래서'와 ⑤의 '먼저·그다음에'는 접속, ③의 '강아지→개'는 상위어를 활용한 어휘적 결속, ④는 서술어 '먹었어'가 앞 절에서 생략된 생략 결속이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"이야기·담화\",\"k\":\"결속표지 유형 판별\",\"p\":\"지시어가 앞 문장 명사를 가리키는지로 결속 유형 판단\",\"n\":\"지시(대용) 결속: 대명사가 앞 명사 지칭, 접속·어휘·생략과 구분\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"다음 과제 중 상위언어(metalinguistic) 능력을 평가하는 것은?\",\"choices\":[\"들려준 문장을 그대로 따라 말하기\",\"그림을 보고 사물의 이름 말하기\",\"책을 책상 위에 올려놓으세요. 지시 따르기\",\"'나무'에서 '나'를 빼면 무엇이 남지?\",\"그림 속 사물의 색깔과 모양 말하기\"],\"answer\":4,\"explain\":\"상위언어 능력은 언어 자체를 사고의 대상으로 삼아 조작·판단하는 능력으로, 음절 탈락과 같은 음운인식 과제가 대표적이다. 이름대기·지시 따르기·문장 따라말하기·속성 말하기는 언어를 사용하는 과제이지 언어 자체를 분석하는 과제가 아니다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"읽기·쓰기\",\"k\":\"상위언어 과제 식별\",\"p\":\"언어 자체를 조작하는 과제인지로 상위언어 평가 과제 식별\",\"n\":\"상위언어 능력: 언어를 분석·조작하는 능력, 예 음절 탈락\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"초기 어휘 습득에 관한 개념과 예가 옳게 연결된 것은?\",\"choices\":[\"과잉확장 – '공'이라는 낱말을 자기 공에만 사용한다\",\"과소확장 – '아빠'를 길에서 본 모든 성인 남자에게 사용한다\",\"전체대상 가정 – 새 낱말을 사물의 부분이나 색깔로 해석한다\",\"상호배타성 가정 – 새 낱말을 이름을 모르는 낯선 사물에 대응시킨다\",\"빠른 연결(fast mapping) – 수십 번의 노출 후에야 낱말을 습득한다\"],\"answer\":4,\"explain\":\"상호배타성 가정은 한 사물에 하나의 이름만 있다고 여겨 새 낱말을 낯선 사물에 연결하는 것이다. ①은 과소확장, ②는 과잉확장의 예이며, 전체대상 가정은 새 낱말을 사물 전체를 지칭하는 것으로 해석하는 것이고, 빠른 연결은 한두 번의 노출로 낱말과 의미를 잠정 연결하는 것이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"어휘·의미\",\"k\":\"초기 어휘 습득 원리\",\"p\":\"어휘 습득 제약과 확장 현상의 개념-예 연결 판단\",\"n\":\"상호배타성 가정: 한 사물에 한 이름, 새 낱말을 낯선 사물에 연결\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"읽기의 단순관점(Simple View of Reading)에 따를 때 난독증(dyslexia) 아동의 전형적인 프로파일은?\",\"choices\":[\"해독 정상, 듣기이해 저하\",\"해독 저하, 듣기이해 저하\",\"해독 정상, 듣기이해 정상, 읽기이해만 저하\",\"해독 저하, 듣기이해 정상\",\"해독과 듣기이해 모두 우수\"],\"answer\":4,\"explain\":\"단순관점에서 읽기이해는 해독과 언어(듣기)이해의 곱으로 설명된다. 난독증은 언어이해가 정상이면서 낱말 해독이 선택적으로 손상된 유형이다. ①은 특정 읽기이해 결함, ②는 혼합형(일반 읽기부진)에 해당하며, ③은 이 모델에서 설명되지 않는 조합이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"읽기·쓰기\",\"k\":\"읽기 단순관점 프로파일\",\"p\":\"해독과 듣기이해 조합으로 난독증 프로파일 판단\",\"n\":\"단순관점: 읽기이해=해독×언어이해, 난독증은 해독 저하·이해 정상\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"다음 음운인식 과제 중 일반적으로 가장 늦게 발달하는 것은?\",\"choices\":[\"낱말의 음절 수를 손뼉으로 세기\",\"'사'와 '자'를 합쳐 '사자' 만들기\",\"'나비'와 '나무'의 첫음절이 같은지 판단하기\",\"두 낱말의 끝음절이 같은지 판단하기\",\"'산'에서 /ㅅ/를 빼고 말하기\"],\"answer\":5,\"explain\":\"음운인식은 음절 수준에서 음소 수준으로 발달하며, 같은 수준 안에서는 변별·합성보다 탈락·대치 같은 조작 과제가 더 어렵다. 음소 탈락 과제는 음소 수준의 조작 과제이므로 음절 세기·음절 합성·음절 변별보다 늦게 발달한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"읽기·쓰기\",\"k\":\"음운인식 발달 위계\",\"p\":\"단위 크기와 조작 유형으로 가장 늦은 과제 식별\",\"n\":\"음운인식: 음절→음소 순 발달, 변별·합성보다 탈락·대치가 어려움\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"초등학교 2학년 아동의 받아쓰기 오류\\n• 꽃이 → 꼬치\\n• 먹어서 → 머거서\\n• 높이 → 노피\",\"q\":\"이 아동의 철자 오류 유형과 우선적으로 필요한 교수 초점은?\",\"choices\":[\"음운처리 오류 – 자소-음소 대응 지도\",\"형태처리 오류 – 형태소 원형 인식 지도\",\"표기처리 오류 – 관습적 표기 낱말 암기 지도\",\"의미처리 오류 – 낱말 뜻과 쓰임 지도\",\"시각기억 오류 – 낱말 형태 시각화 지도\"],\"answer\":2,\"explain\":\"발음은 정확히 반영했으나 어간·어미와 조사의 경계를 나누지 못하고 소리 나는 대로 썼으므로 형태소 원형을 유지하지 못한 형태처리 오류이다. 음운처리 오류는 소리 자체가 틀리는 것(꽃→꼭), 표기처리 오류는 소리로 설명되지 않는 관습 표기의 오류(며칠→몇일)이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"읽기·쓰기\",\"k\":\"철자 오류 유형과 지도\",\"p\":\"소리 나는 대로 쓴 오류를 근거로 교수 초점 선택\",\"n\":\"형태처리 오류: 형태소 경계 미표기, 형태소 원형 인식 지도\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"표준화 언어검사와 그 특성이 옳게 연결된 것은?\",\"choices\":[\"수용·표현 어휘력 검사(REVT) – 수용과 표현 어휘를 각각 평가하여 등가연령과 백분위수를 산출한다\",\"취학전 아동의 수용언어 및 표현언어 발달척도(PRES) – 초등학생의 담화와 읽기 능력을 평가한다\",\"학령기 아동 언어 검사(LSSC) – 영유아의 의사소통 발달을 선별한다\",\"한국어 읽기 검사(KOLRA) – 학령전기 아동의 어휘 능력을 평가한다\",\"맥아더-베이츠 의사소통발달 검사(K M-B CDI) – 검사자가 아동에게 직접 그림 이름대기를 실시한다\"],\"answer\":1,\"explain\":\"REVT는 그림 지적(수용)과 그림 이름대기(표현)로 어휘력을 각각 평가하여 등가연령과 백분위수를 제공한다. K M-B CDI는 부모 보고형 검사이고, PRES는 학령전기 아동 대상, LSSC와 KOLRA는 초등학생 대상 검사이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"언어검사 특성 연결\",\"p\":\"검사별 대상 연령과 평가 방식으로 옳은 연결 판단\",\"n\":\"REVT: 수용·표현 어휘 각각 평가, 등가연령·백분위수 제공\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"언어검사 결과 아동의 표현 어휘 백분위수가 5로 나타났다.\",\"q\":\"이 결과의 해석으로 옳은 것은?\",\"choices\":[\"전체 검사 문항 중 5%의 문항에 정답을 맞혔음을 뜻한다\",\"규준집단에서 약 5%만이 이 아동보다 낮은 점수를 받았다\",\"또래 규준집단의 평균 점수보다 원점수가 5점 낮음을 뜻한다\",\"규준집단 평균에서 -1 표준편차에 해당하는 위치이다\",\"아동의 표현 어휘 등가연령이 5세 수준에 해당한다\"],\"answer\":2,\"explain\":\"백분위수는 규준집단에서 해당 점수 이하를 받은 사람의 비율이므로 백분위수 5는 하위 5%에 해당한다. 정답률이나 점수 차이를 의미하지 않으며, -1 표준편차는 약 백분위수 16에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"어휘·의미\",\"k\":\"백분위수 해석\",\"p\":\"백분위수 정의를 근거로 검사 결과 의미 판단\",\"n\":\"백분위수: 규준집단 중 해당 점수 이하 비율, 5는 하위 5%\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"역동적 평가(dynamic assessment)에 관한 설명으로 옳은 것은?\",\"choices\":[\"규준집단과 비교하여 표준점수를 산출하는 것이 목적이다\",\"결과는 규준에 근거한 등가연령으로 보고한다\",\"부모의 보고만으로 아동의 현재 언어 능력을 추정한다\",\"한 시점의 수행만을 측정하므로 이중언어 아동에게는 부적합하다\",\"검사-교수-재검사 형식으로 아동의 학습 잠재력을 평가한다\"],\"answer\":5,\"explain\":\"역동적 평가는 중재 반응을 통해 학습 잠재력을 파악하는 방법으로, 언어 차이와 언어장애를 감별해야 하는 이중언어·다문화 아동 평가에 특히 유용하다. 규준 비교나 표준점수·등가연령 산출은 정적(표준화) 평가의 특성이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"역동적 평가 특성\",\"p\":\"검사-교수-재검사 형식을 근거로 역동적 평가 특성 판단\",\"n\":\"역동적 평가: 중재 반응으로 학습 잠재력 파악, 이중언어 아동에 유용\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"단순언어장애(SLI) 진단 준거로 옳은 것은?\",\"choices\":[\"언어검사 -1.25 SD 이하, 비언어성 지능 85 이상\",\"양측 감각신경성 난청이 언어 지연과 함께 동반된다\",\"자폐스펙트럼장애 진단이 언어 문제와 함께 동반된다\",\"비언어성 지능지수가 70 이하로 지적장애 범위이다\",\"언어 지연을 설명할 수 있는 뇌손상 등 신경학적 손상이 확인된다\"],\"answer\":1,\"explain\":\"레너드(Leonard)의 준거에 따르면 단순언어장애는 언어검사 -1.25 SD 이하이면서 비언어성 지능 85 이상이고, 청력·구강구조·신경학적 손상·자폐 등 언어 지연을 설명할 다른 원인이 배제되어야 한다. 나머지는 모두 배제 준거에 해당한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"단순언어장애 진단 준거\",\"p\":\"언어 점수와 비언어성 지능 기준으로 진단 준거 판단\",\"n\":\"SLI 준거: 언어 -1.25 SD 이하, 비언어성 지능 85 이상, 타 원인 배제\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"단순언어장애 아동의 언어 특성으로 옳은 것은?\",\"choices\":[\"비언어성 인지 저하가 언어 지연의 원인이다\",\"수용언어는 손상되지 않으며 표현언어만 손상된다\",\"화용 능력은 영향을 받지 않아 또래와 비슷하다\",\"첫 낱말 출현 시기가 또래보다 빠른 편이다\",\"조사·어미 등 문법형태소 습득이 특히 지연된다\"],\"answer\":5,\"explain\":\"단순언어장애 아동은 문법형태소 습득이 두드러지게 지연되고 낱말 찾기 어려움, 늦은 첫 낱말 등을 보인다. 수용언어도 손상될 수 있고, 언어 문제로 인한 대화·이야기 등 화용의 어려움이 동반될 수 있으며, 비언어성 인지는 정상 범위인 것이 진단의 전제이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"대상군 특성\",\"k\":\"단순언어장애 언어 특성\",\"p\":\"문법형태소 습득 지연 여부로 SLI 특성 판단\",\"n\":\"SLI: 문법형태소 습득 지연 두드러짐, 낱말 찾기 어려움, 늦은 첫 낱말\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"말 늦은 아동(late talker)의 판별 기준으로 옳은 것은?\",\"choices\":[\"18개월에 두 낱말 조합이 아직 나타나지 않는다\",\"24개월에 표현 어휘 50개 미만이거나 낱말 조합이 없다\",\"36개월에 완전한 문장을 아직 산출하지 못한다\",\"수용언어 검사 결과가 -2 SD 이하로 매우 낮게 나타난다\",\"청력 손실을 동반하여 말소리 표현이 늦다\"],\"answer\":2,\"explain\":\"말 늦은 아동은 인지·청력·신경학적 문제 없이 24개월에 표현 어휘 50개 미만 또는 두 낱말 조합이 없는 아동을 말한다. 18개월에 낱말 조합이 없는 것은 정상 범위이다. 수용언어는 대체로 정상 범위이며, 청력 손실이 있으면 말 늦은 아동으로 분류하지 않는다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"말 늦은 아동 판별 기준\",\"p\":\"24개월 표현 어휘 수와 낱말 조합 여부로 판별 기준 판단\",\"n\":\"말 늦은 아동: 24개월 표현 어휘 50개 미만 또는 낱말 조합 없음\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"5세 자폐스펙트럼장애 아동\\n• 과자가 먹고 싶을 때마다 며칠 전에 본 광고 문구인 \\\"맛있게 드세요~\\\"를 억양까지 그대로 말한다.\",\"q\":\"이 발화의 유형과 기능이 옳게 연결된 것은?\",\"choices\":[\"지연 반향어 – 요청\",\"즉각 반향어 – 대답\",\"지연 반향어 – 거부\",\"자곤 – 서술\",\"즉각 반향어 – 요청\"],\"answer\":1,\"explain\":\"이전에 들은 말을 시간이 지난 뒤 그대로 반복하는 것은 지연 반향어이며, 과자를 얻으려는 상황에서 사용하므로 요청 기능을 수행한다. 즉각 반향어는 상대의 말을 직후에 따라 하는 것이고, 자곤은 의미 없는 옹알이성 발화이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"반향어 유형·기능 판별\",\"p\":\"반복 시점과 사용 상황으로 반향어 유형과 기능 판단\",\"n\":\"지연 반향어: 시간 지난 뒤 반복, 상황에 따라 요청 기능 수행\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"다음 중 '공동주의 시작하기(initiating joint attention)'에 해당하는 행동은?\",\"choices\":[\"성인이 가리키는 곳을 따라 쳐다본다\",\"이름을 부르면 고개를 돌린다\",\"장난감을 들어 성인에게 보여주며 쳐다본다\",\"과자를 얻으려고 성인의 손을 잡아 끌어당긴다\",\"성인의 박수 동작을 따라 한다\"],\"answer\":3,\"explain\":\"공동주의 시작하기는 아동이 먼저 보여주기·가리키기·시선 교대로 성인의 관심을 대상에 끌어들이는 행동이다. ①은 공동주의에 반응하기, ②는 이름 반응, ④는 요구를 위한 도구적 행동, ⑤는 모방으로 공동주의 시작과 구분된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"초기 의사소통·상징행동\",\"k\":\"공동주의 시작하기\",\"p\":\"아동이 먼저 관심을 끄는 행동인지로 공동주의 시작 식별\",\"n\":\"공동주의 시작: 보여주기·가리키기·시선 교대로 성인 관심 유도\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"증후군과 언어 특성이 옳게 연결된 것은?\",\"choices\":[\"윌리엄스증후군 – 어휘와 표현언어가 인지 수준에 비해 현저히 낮다\",\"윌리엄스증후군 – 언어보다 시공간 인지 능력이 상대적 강점이다\",\"취약X증후군 – 사회성이 과도하게 높아 낯선 사람에게도 친근하게 다가간다\",\"다운증후군 – 수용언어가 표현언어보다 더 심하게 손상되는 편이다\",\"다운증후군 – 표현언어와 구문이 인지 수준에 비해 더 지연된다\"],\"answer\":5,\"explain\":\"다운증후군은 수용에 비해 표현·구문이 특히 약하고 저긴장·구강구조 특성으로 말명료도가 낮다. 윌리엄스증후군은 시공간 인지가 약한 반면 어휘·표현언어와 사회성이 상대적 강점이며, 취약X증후군은 사회적 불안·시선 회피와 보속적·빠른 말이 특징이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"대상군 특성\",\"k\":\"증후군별 언어 특성\",\"p\":\"증후군별 강약점 프로파일로 옳은 연결 판단\",\"n\":\"다운증후군: 수용보다 표현·구문 지연, 윌리엄스는 시공간 약점\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"청각장애 아동의 언어 특성으로 옳은 것은?\",\"choices\":[\"조사·어미 같은 기능어보다 내용어 습득이 더 어렵다\",\"문장 구조가 단순하고 문법형태소 생략이 흔하다\",\"비유·관용 표현의 이해에 별다른 어려움이 없다\",\"낱말의 다의적 의미 이해가 또래보다 우수하다\",\"말명료도는 청력 손실 정도와 관계가 거의 없다\"],\"answer\":2,\"explain\":\"청각장애 아동은 청각 입력이 제한되어 강세가 약하고 짧은 문법형태소를 놓치기 쉬워 조사·어미 생략과 단순한 문장 구조를 보인다. 내용어보다 기능어 습득이 더 어렵고, 추상어·다의어·비유 이해도 제한되며, 말명료도는 청력 손실 정도와 관련된다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"대상군 특성\",\"k\":\"청각장애 아동 언어 특성\",\"p\":\"청각 입력 제한의 영향으로 언어 특성 판단\",\"n\":\"청각장애 아동: 문법형태소 생략, 단순 문장 구조, 기능어 습득 어려움\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"이중언어 아동의 언어장애 판별에 관한 설명으로 옳은 것은?\",\"choices\":[\"한국어 표준화 검사의 규준만으로 언어장애를 판정한다\",\"제2언어인 한국어에서만 지연이 있어도 언어장애로 진단한다\",\"두 언어 모두에서 지연이 나타날 때 언어장애를 의심한다\",\"새 언어에 노출된 초기의 침묵기는 언어장애의 징후이다\",\"모국어 사용을 중단시켜야 한국어 발달이 촉진된다\"],\"answer\":3,\"explain\":\"언어장애는 특정 언어가 아니라 언어 학습 능력 자체의 문제이므로 두 언어 모두에서 지연이 나타나야 의심할 수 있다. 한 언어에서만의 지연은 언어 차이(노출 부족)일 수 있고, 침묵기는 순차적 이중언어 습득의 정상적 과정이며, 모국어 유지는 제2언어 발달에도 도움이 된다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"대상군 특성\",\"k\":\"이중언어 아동 장애 판별\",\"p\":\"두 언어 모두의 지연 여부로 언어장애 판별 원칙 판단\",\"n\":\"이중언어 아동: 두 언어 모두 지연 시 장애 의심, 한 언어만은 언어 차이\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동이 블록을 쌓고 있다.\\n치료사: (아동의 행동을 보며) 블록을 높이 쌓네. 또 올리네. 와, 무너졌다.\",\"q\":\"치료사가 사용한 언어촉진 기법은?\",\"choices\":[\"혼잣말 기법(self-talk)\",\"확장(expansion) 기법\",\"확대(extension) 기법\",\"평행발화(parallel talk)\",\"개작(recast) 기법\"],\"answer\":4,\"explain\":\"치료사가 아동이 하고 있는 행동을 아동의 입장에서 말로 묘사하는 것은 평행발화이다. 혼잣말 기법은 치료사 자신의 행동을 말로 표현하는 것이며, 확장·확대·개작은 아동의 발화가 있은 뒤 이를 문법적으로 보완하거나 의미를 덧붙이거나 문장 형태를 바꾸어 되돌려 주는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"언어촉진 기법 구분\",\"p\":\"아동 행동을 치료사가 묘사하는 방식으로 기법 식별\",\"n\":\"평행발화: 아동 행동을 아동 입장에서 묘사, 혼잣말은 자기 행동 묘사\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"간식 시간마다 치료사가 아동에게 주스를 따라 주는 것이 반복되어 왔다.\\n오늘 치료사는 주스병을 들고 아동을 바라보며 기대하는 표정으로 약 5초간 기다렸다.\\n아동: 주스!\\n치료사: 그래, 주스 줄게.\",\"q\":\"치료사가 사용한 환경중심 언어중재 절차는?\",\"choices\":[\"시간지연(time delay)\",\"요구-모델(mand-model)\",\"아동중심 시범(child-cued modeling)\",\"우발교수(incidental teaching)\",\"스크립트 중재\"],\"answer\":1,\"explain\":\"익숙한 일과에서 성인이 도움을 주지 않고 기대하는 표정으로 기다려 아동의 자발적 의사소통을 유도하는 것은 시간지연 절차이다. 요구-모델은 '뭐 줄까?'와 같은 요구(질문)를 먼저 제시하고, 아동중심 시범은 아동의 관심사에 대해 시범을 보이며, 우발교수는 아동이 먼저 요구를 시작했을 때 이를 확장해 가르친다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"환경중심 언어중재 절차\",\"p\":\"익숙한 일과에서 기대하며 기다리는 방식으로 절차 식별\",\"n\":\"시간지연: 익숙한 일과에서 기대 표정으로 기다려 자발적 요구 유도\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"스크립트 중재의 절차로 옳은 것은?\",\"choices\":[\"친숙한 활동 순서를 먼저 확립한 뒤 계획된 위반을 도입한다\",\"첫 회기부터 예고 없이 활동 순서를 바꾸어 아동의 반응을 유도한다\",\"아동에게 낯선 활동을 선택하여 새로운 경험을 제공한다\",\"목표 언어는 스크립트의 하위 행동과 관계없이 삽입한다\",\"스크립트의 하위 행동은 하나로 제한하여 단순화한다\"],\"answer\":1,\"explain\":\"스크립트 중재는 생일잔치·마트놀이 등 친숙한 일상 활동의 순서를 먼저 익히게 하여 인지적 부담을 줄인 뒤, 각 하위 행동에 목표 언어를 배치하고 필요 시 순서를 빠뜨리거나 사물을 빼는 계획된 위반으로 발화를 유도한다. 낯선 활동이나 처음부터의 무작위 변형은 이 원리에 어긋난다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"스크립트 중재 절차\",\"p\":\"친숙한 활동 확립과 계획된 위반 순서로 절차 판단\",\"n\":\"스크립트 중재: 친숙한 일상 순서 확립 후 계획된 위반으로 발화 유도\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"수직적 목표 달성 전략에 관한 설명으로 옳은 것은?\",\"choices\":[\"여러 목표를 한 회기 안에서 동시에 지도한다\",\"일정 기간마다 여러 목표를 순환하며 번갈아 지도한다\",\"한 목표가 준거에 도달한 뒤 다음 목표로 넘어간다\",\"목표 도달 여부와 관계없이 매 회기 목표를 바꾼다\",\"아동이 선택한 목표만 지도한다\"],\"answer\":3,\"explain\":\"수직적 전략은 한 번에 하나의 목표를 집중 지도하여 준거에 도달한 후 다음 목표로 이동한다. ①은 수평적 전략, ②는 주기적 전략에 해당하며, ④·⑤는 목표 달성 전략에 해당하지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"목표 달성 전략 구분\",\"p\":\"준거 도달 후 이동 여부로 수직적 전략 특성 판단\",\"n\":\"수직적 전략: 한 목표 준거 도달 후 다음 목표, 수평적은 동시 지도\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"장기목표: 연결어미가 포함된 복문을 사용하여 사건을 표현할 수 있다.\",\"q\":\"이 장기목표에 대한 단기목표로 가장 적절하게 기술된 것은?\",\"choices\":[\"아동의 구문 능력이 전반적으로 향상된다\",\"아동은 일상 대화에서 복문을 이해하고 사용한다\",\"치료사가 그림을 보며 연결어미 '-고'를 시범 보인다\",\"그림카드 10장 중 '-고' 문장을 8회 이상 말한다\",\"아동은 연결어미를 여러 상황에서 잘 사용할 수 있다\"],\"answer\":4,\"explain\":\"단기목표는 조건(그림카드 10장), 아동의 행동(연결어미 '-고' 문장 말하기), 준거(8회 이상)가 측정 가능하게 기술되어야 한다. ①·②·⑤는 준거가 없거나 장기목표 수준의 포괄적 진술이고, ③은 아동이 아닌 치료사의 행동을 기술한 것이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"단기목표 기술\",\"p\":\"조건·행동·준거 포함 여부로 적절한 단기목표 선택\",\"n\":\"단기목표: 조건·아동 행동·준거를 측정 가능하게 기술\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"언어 이전기·초기 언어기 아동의 목표 어휘 선정 원칙으로 옳은 것은?\",\"choices\":[\"아동이 이미 자발적으로 산출하는 낱말을 중심으로 선정한다\",\"추상적인 개념어를 구체어보다 우선 선정한다\",\"일상에서 자주 쓰이고 즉각적인 기능을 갖는 낱말을 우선한다\",\"발음이 어려운 낱말을 우선하여 조음 연습을 겸한다\",\"아동이 관심 없는 사물의 이름을 선정하여 새로운 흥미를 유도한다\"],\"answer\":3,\"explain\":\"초기 어휘는 아동의 관심과 일상에서 자주 접하고 요구·거부 등 의사소통 기능을 바로 수행할 수 있는 기능적 낱말이어야 습득과 일반화가 빠르다. 이미 산출하는 낱말은 목표가 아니며, 추상어·발음이 어려운 낱말·관심 없는 사물은 초기 목표로 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"초기 목표 어휘 선정\",\"p\":\"일상 빈도와 기능성을 근거로 목표 어휘 선정 원칙 선택\",\"n\":\"초기 목표 어휘: 일상에서 자주 쓰이고 즉각적 기능을 갖는 낱말\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"보완대체의사소통(AAC) 상징체계에 관한 설명으로 옳은 것은?\",\"choices\":[\"블리스 상징은 도상성이 높아 학습이 쉽다\",\"수어는 도구적(보조) 상징체계이다\",\"도상성이 낮은 상징일수록 초기 학습이 더 쉽다\",\"실물 사진은 선화보다 도상성이 높은 상징이다\",\"스캐닝은 상징의 도상성을 높이는 기법이다\"],\"answer\":4,\"explain\":\"도상성(iconicity)은 상징이 지시 대상과 닮은 정도로, 실물 사진 > 컬러 선화 > 흑백 선화 > 블리스·문자 순으로 낮아지며 도상성이 높을수록 초기 학습이 쉽다. 수어·몸짓은 도구가 필요 없는 비도구적 상징이고, 스캐닝은 상징을 선택하는 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"AAC 상징 도상성\",\"p\":\"상징이 지시 대상과 닮은 정도로 AAC 상징 특성 판단\",\"n\":\"도상성: 실물 사진 > 컬러 선화 > 흑백 선화 > 블리스, 높을수록 학습 쉬움\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"• 아동이 어려워하는 특정 사회적 상황(예: 줄 서기)을 짧고 구체적인 문장으로 서술한다.\\n• 그 상황에서 다른 사람이 어떻게 느끼고 무엇을 기대하는지, 아동이 할 수 있는 적절한 행동이 무엇인지를 아동의 관점에서 설명한다.\\n• 아동에게 맞게 개별화된 글이며 그림을 함께 제시하기도 한다.\",\"q\":\"이 설명에 해당하는 중재 기법은?\",\"choices\":[\"비디오 모델링\",\"사회적 상황 이야기\",\"사회적 기술 훈련 집단\",\"또래 매개 중재\",\"상호적 모방 훈련\"],\"answer\":2,\"explain\":\"사회적 상황 이야기는 자폐스펙트럼장애 아동이 사회적 상황의 단서와 타인의 관점, 기대되는 행동을 이해하도록 개별화된 짧은 이야기로 설명하는 기법이다. 비디오 모델링은 영상 속 모델을 관찰·모방하게 하는 것이고, 또래 매개 중재는 훈련된 또래가 상호작용을 이끄는 것이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"자폐 사회성 중재 기법\",\"p\":\"개별화된 짧은 이야기로 상황 설명하는 방식으로 기법 식별\",\"n\":\"사회적 상황 이야기: 사회적 단서·타인 관점·기대 행동을 개별화된 글로 설명\"}},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"부모 교육 프로그램(예: 해넌 프로그램)에서 부모에게 강조하는 반응적 상호작용 전략으로 옳은 것은?\",\"choices\":[\"아동에게 질문을 많이 하여 발화를 유도한다\",\"아동의 발화 오류를 즉시 교정한다\",\"성인이 대화 주제를 정하고 이끌어 간다\",\"아동의 주도를 따르며 관찰하고 기다려 준다\",\"아동에게 더 긴 문장으로 말하도록 요구한다\"],\"answer\":4,\"explain\":\"반응적 상호작용 접근은 아동의 관심과 주도를 따르고(관찰하기-기다리기-듣기), 아동의 신호에 즉각적이고 따뜻하게 반응하며 자연스러운 시범을 제공하는 것을 핵심으로 한다. 잦은 질문·즉각 교정·성인 주도·발화 요구는 아동의 의사소통 시도를 줄이는 지시적 상호작용이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"중재 방법·AAC\",\"k\":\"반응적 상호작용 전략\",\"p\":\"아동 주도 따르기 여부로 부모 교육 전략 선택\",\"n\":\"반응적 상호작용: 아동 주도 따르기, 관찰-기다리기-듣기, 즉각 반응\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두 연골에 대한 설명으로 옳은 것은?\",\"choices\":[\"갑상연골은 좌우 한 쌍으로 이루어진 연골이다\",\"피열연골은 갑상연골의 앞쪽 내면과 관절을 이룬다\",\"윤상연골은 유일하게 완전한 고리 모양의 연골이다\",\"후두개는 유리연골로 성인기에 빠르게 골화된다\",\"설골은 후두 연골 중 가장 위에 위치한 연골이다\"],\"answer\":3,\"explain\":\"윤상연골은 뒤쪽이 넓은 반지 모양으로, 후두 연골 중 유일하게 기도를 완전히 둘러싸는 고리 형태이다. 갑상연골은 두 판이 앞에서 융합된 단일 연골이고, 피열연골은 윤상연골 위판(후방)에 얹혀 관절하며, 후두개는 탄력연골이라 골화가 잘 일어나지 않는다. 설골은 연골이 아닌 뼈로 후두를 매다는 구조이며 후두 연골에 포함되지 않는다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"후두 연골 구조\",\"p\":\"연골별 형태·수·위치 특징으로 옳은 설명 식별\",\"n\":\"윤상연골: 유일한 완전 고리 모양 후두 연골, 설골은 뼈로 후두 연골 아님\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두 내근과 그 작용이 옳게 연결된 것은?\",\"choices\":[\"윤상갑상근 – 성대 신장\",\"측윤상피열근 – 성대 외전\",\"후윤상피열근 – 성대 내전\",\"갑상피열근 – 성문 개방\",\"횡피열근 – 성대의 신장\"],\"answer\":1,\"explain\":\"윤상갑상근은 갑상연골을 앞으로 기울여 성대를 길게 늘이고 긴장시켜 음도를 높이는 근육이다. 후윤상피열근은 유일한 외전근(성문 개방), 측윤상피열근과 횡·사피열근은 내전근이며, 갑상피열근(성대근)은 성대를 짧고 두껍게 하여 긴장을 조절한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"후두 내근 작용\",\"p\":\"내근별 내전·외전·신장 작용 연결로 옳은 짝 식별\",\"n\":\"윤상갑상근은 성대 신장, 후윤상피열근은 유일한 외전근, 측윤상피열근은 내전근\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두의 신경 지배에 대한 설명으로 옳은 것은?\",\"choices\":[\"상후두신경 외지는 후윤상피열근을 지배한다\",\"왼쪽 되돌이후두신경은 오른쪽보다 주행 경로가 짧다\",\"되돌이후두신경은 윤상갑상근만 지배한다\",\"상후두신경 내지는 성문 상부의 감각을 담당한다\",\"되돌이후두신경은 설인신경(9번)의 가지이다\"],\"answer\":4,\"explain\":\"상후두신경(미주신경 가지)의 내지는 감각 신경으로 성문 상부 점막의 감각을 담당하고, 외지는 운동 신경으로 윤상갑상근을 지배한다. 되돌이후두신경은 미주신경(10번)의 가지로 윤상갑상근을 제외한 모든 후두 내근을 지배하며, 왼쪽은 대동맥궁을 돌아 올라오므로 오른쪽보다 주행이 길어 손상에 더 취약하다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"후두 신경 지배\",\"p\":\"상후두신경 가지와 되돌이후두신경의 지배 범위로 설명 식별\",\"n\":\"상후두신경 내지는 성문 상부 감각, 외지는 윤상갑상근, 되돌이후두신경은 나머지 내근\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"성대의 층 구조(몸체-덮개 모형)에 대한 설명으로 옳은 것은?\",\"choices\":[\"점막파동은 몸체(body)인 성대근에서 주로 발생한다\",\"갑상피열근(성대근)은 덮개(cover)에 해당한다\",\"성대인대는 상피 바로 아래 고유층 표층으로 이루어진다\",\"라인케 공간은 성대근과 맞닿은 고유층 심층에 위치한다\",\"상피와 고유층 표층은 덮개(cover)에 해당한다\"],\"answer\":5,\"explain\":\"몸체-덮개 모형에서 덮개는 상피와 느슨한 고유층 표층(라인케 공간)으로 구성되어 점막파동이 일어나는 부위이며, 몸체는 성대근(갑상피열근)이다. 성대인대는 고유층 중간층과 심층으로 이루어진 이행부이다. 라인케 공간은 고유층 표층이며, 점막파동은 덮개에서 발생한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"성대 몸체-덮개 모형\",\"p\":\"성대 층별 구성과 점막파동 발생 부위로 옳은 설명 식별\",\"n\":\"덮개: 상피와 고유층 표층(라인케 공간), 몸체: 성대근, 점막파동은 덮개에서 발생\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"음성 강도를 높일 때 나타나는 생리적 변화로 옳은 것은?\",\"choices\":[\"성문하압이 감소하고 성대 긴장이 줄어든다\",\"진동 주기에서 개방기가 길어지고 폐쇄기가 짧아진다\",\"성문하압이 증가하고 성대 폐쇄기가 길어진다\",\"성대 진동의 진폭이 작아지고 폐쇄가 약해진다\",\"성대 접촉이 느슨해져 성문 통과 기류가 줄어든다\"],\"answer\":3,\"explain\":\"강도를 높이려면 성문하압을 높이고 성대를 더 단단히 접촉시켜 진동 주기 중 폐쇄기가 길어지도록 해야 한다. 이때 성대가 더 크게 열렸다 빠르게 닫히므로 진동 진폭도 커진다. 성문하압 감소, 개방기 연장, 진폭 감소는 오히려 강도를 낮추는 변화이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"해부·생리·음향 기초\",\"k\":\"음성 강도 조절 생리\",\"p\":\"성문하압과 폐쇄기 변화로 강도 상승 시 생리적 변화 식별\",\"n\":\"강도 증가: 성문하압 증가, 성대 폐쇄기 연장, 진동 진폭 증가\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"45세 여성의 청지각적 평가(GRBAS) 결과\\nG2 R1 B2 A0 S0\",\"q\":\"결과 해석으로 옳은 것은?\",\"choices\":[\"전반적 중증도는 경도이다\",\"거친소리가 바람새는소리보다 더 두드러진다\",\"쥐어짜는소리가 중등도로 지각된다\",\"바람새는소리가 중등도로 지각된다\",\"무력성이 경도로 관찰된다\"],\"answer\":4,\"explain\":\"GRBAS는 각 항목을 0(정상)~3(심도)의 4점 척도로 평정한다. B2는 바람새는소리가 중등도라는 의미이며, G2이므로 전반적 중증도도 중등도이다. R1(경도)은 B2보다 덜 두드러지고, A0·S0은 무력성과 쥐어짜는소리가 관찰되지 않음을 뜻한다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"GRBAS 결과 해석\",\"p\":\"항목별 0~3점 평정값으로 음질 특성과 중증도 판단\",\"n\":\"GRBAS: 0 정상~3 심도, B2는 바람새는소리 중등도, G는 전반적 중증도\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"CAPE-V(Consensus Auditory-Perceptual Evaluation of Voice)에 대한 설명으로 옳은 것은?\",\"choices\":[\"평가자가 각 항목을 0~3점의 4점 등간척도로 평정한다\",\"6개 항목을 100mm 시각아날로그척도로 평정한다\",\"문장이나 자발화 없이 지속 모음 과제만으로 평가한다\",\"환자가 스스로 음성 문제의 심각도를 보고하는 도구이다\",\"각 항목의 점수는 음향 분석 소프트웨어가 자동으로 산출한다\"],\"answer\":2,\"explain\":\"CAPE-V는 평가자가 지속 모음, 표준 문장, 자발화를 듣고 6개 핵심 항목(전반적 중증도, 거친소리, 바람새는소리, 쥐어짜는소리, 음도, 강도)을 100mm 시각아날로그척도(VAS)로 표시하고, 각 특성이 지속적(C)인지 간헐적(I)인지도 기록하는 청지각적 평가이다. 4점 척도는 GRBAS의 방식이고, 자기보고 도구(VHI 등)나 음향 분석과는 다르다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"CAPE-V 평정 방식\",\"p\":\"평정 척도·항목 수·과제 구성으로 CAPE-V 특징 식별\",\"n\":\"CAPE-V: 6개 항목을 100mm 시각아날로그척도로 평정, 지속 모음·문장·자발화 사용\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"6세 남아\\n• 6개월 전부터 지속되는 쉰 목소리\\n• 음성 문제가 아동의 일상생활과 학교생활에 미치는 영향을 보호자 보고로 파악하려 함\",\"q\":\"가장 적절한 도구는?\",\"choices\":[\"음성장애지수(VHI-30)\",\"소아 음성장애지수(pVHI)\",\"음성피로도 검사(VFI)\",\"음성과 관련된 삶의 질(V-RQOL)\",\"GRBAS 청지각적 평가\"],\"answer\":2,\"explain\":\"pVHI는 성인용 VHI를 아동에게 맞게 수정하여 부모(보호자)가 아동의 음성 문제가 기능·신체·정서 영역에 미치는 영향을 보고하는 도구이다. VHI-30, V-RQOL, VFI는 성인 환자 본인이 작성하는 자기보고 도구이고, GRBAS는 평가자의 청지각적 평정 척도이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"아동 음성 자기보고 도구\",\"p\":\"아동 대상·보호자 보고 목적으로 적절한 음성 평가 도구 선택\",\"n\":\"pVHI: 보호자가 아동 음성 문제의 기능·신체·정서 영향을 보고하는 도구\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"음향학적 변수에 대한 설명으로 옳게 연결된 것은?\",\"choices\":[\"주파수변동률(jitter) – 인접 주기 간 진폭의 변동\",\"진폭변동률(shimmer) – 인접 주기 간 기본주파수의 변동\",\"배음대소음비(HNR) – 값이 클수록 잡음 성분이 많음\",\"발화기본주파수(SFF) – 지속 모음에서 측정한 최고 음도\",\"기본주파수(F0) – 성대가 1초 동안 진동하는 횟수\"],\"answer\":5,\"explain\":\"기본주파수는 1초당 성대 진동 횟수(Hz)이다. jitter는 주기(주파수)의 단기 변동, shimmer는 진폭의 단기 변동으로 서로 바뀌어 있고, HNR은 값이 클수록 배음 성분이 많고 잡음이 적어 음질이 좋음을 뜻한다. 발화기본주파수는 연결발화에서의 평균 F0이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"음향학적 변수 정의\",\"p\":\"jitter·shimmer·HNR·F0의 측정 내용 구분으로 옳은 연결 식별\",\"n\":\"F0는 초당 성대 진동 횟수, jitter는 주기 변동, shimmer는 진폭 변동, HNR 클수록 양호\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"38세 남성 교사\\n• 최근 3개월간 쉰 목소리\\n• 최대발성지속시간: /s/ 22초, /z/ 11초\",\"q\":\"s/z 비율 결과에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"s/z 비율이 2.0으로, 호흡 지지 부족이 주된 원인으로 추정된다\",\"s/z 비율이 2.0이므로 공명 문제를 우선 평가해야 한다\",\"s/z 비율이 0.5로 정상 범위이며 추가 평가는 불필요하다\",\"s/z 비율이 2.0으로 성대 병변에 의한 폐쇄부전이 의심된다\",\"/s/와 /z/ 모두 정상보다 짧아 폐활량 저하가 의심된다\"],\"answer\":4,\"explain\":\"s/z 비율은 /s/ 지속시간을 /z/ 지속시간으로 나눈 값(22/11=2.0)이다. 무성음 /s/는 정상인데 유성음 /z/만 짧다면 호흡 능력은 보존되었으나 성대 진동 시 공기가 새는 것이므로 성대 병변(결절·폴립 등)에 의한 성문 폐쇄부전을 시사한다. 일반적으로 1.4 이상이면 성대 병리를 의심한다. 호흡 지지 부족이면 /s/와 /z/가 모두 짧아진다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"s/z 비율 해석\",\"p\":\"/s/ 정상·/z/ 단축 결과로 s/z 비율 산출과 원인 판단\",\"n\":\"s/z 비율 상승: 호흡 보존·유성음만 단축, 성대 병변에 의한 폐쇄부전 시사\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두스트로보스코피 검사에 대한 설명으로 옳은 것은?\",\"choices\":[\"점막파동·진폭·성문폐쇄·대칭성 등을 관찰한다\",\"기본주파수를 알 필요 없이 임의의 빛 주기로 촬영한다\",\"성대 진동의 실제 주기 하나하나를 그대로 보여준다\",\"심한 비주기적 음성일수록 정확한 영상을 얻을 수 있다\",\"성대 접촉 면적의 변화를 전기 신호로 기록한다\"],\"answer\":1,\"explain\":\"스트로보스코피는 성대 진동 주파수와 약간 다른 주기로 빛을 비추어 여러 주기의 조각을 합성한 느린 가상 영상을 만드는 검사로, 점막파동·진동 진폭·성문폐쇄 양상·좌우 대칭성·주기성·비진동 부위 등을 관찰한다. 기본주파수에 동기화해야 하므로 심하게 비주기적인 음성에서는 신뢰도가 떨어진다. 성대 접촉 면적을 전기 신호로 기록하는 것은 전기성문파형검사(EGG)이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성 평가\",\"k\":\"후두스트로보스코피 원리\",\"p\":\"가상 느린 영상 원리와 관찰 항목으로 검사 특징 식별\",\"n\":\"스트로보스코피: F0 동기화 섬광으로 점막파동·진폭·성문폐쇄·대칭성 관찰\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"후두스트로보스코피 소견\\n• 양측 성대의 앞쪽 1/3과 중간 1/3 경계 부위에 좌우 대칭적인 작은 융기\\n• 융기 부위 앞뒤로 성문이 닫히지 않는 모래시계형 폐쇄 양상\",\"q\":\"가장 가능성이 높은 병변은?\",\"choices\":[\"성대폴립\",\"성대결절\",\"성대낭종\",\"라인케부종\",\"후두횡격막\"],\"answer\":2,\"explain\":\"성대결절은 음성 남용·오용으로 성대 진동 시 충격이 가장 큰 막성 성대 앞쪽 1/3~중간 1/3 경계에 양측 대칭으로 생기는 병변이며, 두 결절이 맞닿아 그 앞뒤가 열리는 모래시계형 폐쇄부전이 특징이다. 폴립은 대개 편측이고, 낭종은 편측 점막 내 병변이며, 라인케부종은 성대 전체가 붓고, 후두횡격막은 성대 전방이 막으로 붙은 상태이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"스트로보 소견으로 병변 판별\",\"p\":\"양측 대칭 융기 위치와 모래시계형 폐쇄로 병변 판단\",\"n\":\"성대결절: 앞쪽 1/3~중간 1/3 경계 양측 대칭 병변, 모래시계형 폐쇄부전\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"56세 여성\\n• 30년 이상 흡연\\n• 낮고 거칠고 굵은 목소리, 전화 통화 시 남성으로 오인됨\\n• 후두내시경: 양측 성대 전체가 물주머니처럼 부어 있음\",\"q\":\"가장 가능성이 높은 진단은?\",\"choices\":[\"성대결절\",\"접촉성 육아종\",\"후두유두종\",\"성대구증\",\"라인케부종\"],\"answer\":5,\"explain\":\"라인케부종은 장기 흡연이 주요 원인으로, 고유층 표층(라인케 공간)에 액체가 차서 양측 성대 전체가 미만성으로 부어 성대 질량이 늘고 음도가 현저히 낮아진다. 중년 여성에서 남성 목소리로 오인되는 것이 전형적이다. 성대결절은 국소적 양측 융기, 접촉성 육아종은 피열연골 성대돌기 부위 병변, 유두종은 사마귀 모양 종양, 성대구증은 성대 가장자리의 홈이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"흡연 관련 음성장애 진단\",\"p\":\"장기 흡연·저음·양측 성대 미만성 부종으로 진단 판단\",\"n\":\"라인케부종: 장기 흡연, 고유층 표층 부종으로 양측 성대 전체 부음, 음도 저하\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"재발성 호흡기 유두종증(후두유두종)에 대한 설명으로 옳은 것은?\",\"choices\":[\"음성치료만으로 병변을 완전히 소실시킬 수 있다\",\"주로 장기 흡연 성인 남성에게만 발생한다\",\"인유두종바이러스(HPV) 감염과 관련이 있다\",\"양성 병변이므로 기도 폐쇄의 위험은 없다\",\"편측 성대 전방 1/3에만 국한되어 발생한다\"],\"answer\":3,\"explain\":\"후두유두종은 HPV(주로 6·11형) 감염으로 생기는 사마귀 모양의 양성 종양으로, 소아에서 흔하며 수술로 제거해도 재발이 잦다. 기도 여러 부위에 다발성으로 자랄 수 있어 특히 소아에서 기도 폐쇄 위험이 있다. 음성치료는 수술 후 음성 기능 회복을 돕는 보조적 역할이며 병변 자체를 없애지는 못한다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"후두유두종 특징\",\"p\":\"원인·호발 대상·재발성·기도 위험으로 옳은 설명 식별\",\"n\":\"후두유두종: HPV 감염 관련 양성 종양, 소아 호발, 재발 잦고 기도 폐쇄 위험\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"내전형 경련성 발성장애의 특징으로 옳은 것은?\",\"choices\":[\"무성 자음에서 기식성 음성 끊김이 나타난다\",\"음성위생 교육이 일차적 치료법으로 권장된다\",\"속삭이거나 웃을 때 증상이 더 뚜렷하게 심해진다\",\"심리적 갈등에서 비롯된 기능적 음성장애로 분류된다\",\"모음 산출 시 쥐어짜는 듯한 음성 끊김이 나타난다\"],\"answer\":5,\"explain\":\"내전형 경련성 발성장애는 국소 근긴장이상증으로, 발성 중 성대가 불수의적으로 과도하게 내전되어 모음에서 쥐어짜는 듯한 긴장성 음성 끊김이 나타난다. 무성 자음에서 성대가 벌어져 기식성 끊김이 생기는 것은 외전형이다. 속삭임·웃음·노래 등에서는 오히려 증상이 줄어드는 경우가 많고, 신경학적 음성장애로 분류되며 일차 치료는 보툴리눔 독소 주입이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"음성장애 유형\",\"k\":\"경련성 발성장애 특징\",\"p\":\"음성 끊김 양상과 분류·치료로 내전형 특징 식별\",\"n\":\"내전형 경련성 발성장애: 모음에서 쥐어짜는 음성 끊김, 신경학적, 보툴리눔 치료\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"17세 남학생\\n• 변성기가 지났으나 여전히 높고 가는 목소리\\n• 기침을 하거나 웃을 때는 순간적으로 낮은 음성이 나옴\\n• 후두내시경: 후두 구조와 성대 운동 정상\",\"q\":\"가장 적절한 진단은?\",\"choices\":[\"편측 성대마비\",\"기능적 실성증\",\"내전형 경련성 발성장애\",\"성대구증\",\"변성발성장애\"],\"answer\":5,\"explain\":\"변성발성장애는 후두가 정상적으로 성장했음에도 사춘기 이후에도 소년기의 높은 음도를 유지하는 기능적 음성장애이다. 기침·웃음 시 낮은 음성이 나오는 것은 생리적으로 저음 산출이 가능함을 뜻하며, 후두 하강·손가락 조작·기침 유도 등으로 비교적 빠르게 개선된다. 기능적 실성증은 음성이 전혀 나오지 않고, 성대구증과 성대마비는 내시경에서 이상 소견이 보인다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"변성발성장애 진단\",\"p\":\"변성기 이후 고음 유지·기침 시 저음·정상 후두로 진단 판단\",\"n\":\"변성발성장애: 정상 후두에서 사춘기 이후 높은 음도 유지, 기침·웃음 시 저음 가능\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"48세 남성\\n• 아침에 심한 쉰 목소리, 잦은 헛기침, 목 이물감, 가슴쓰림\\n• 후두내시경: 피열연골 부위 점막 발적·부종, 피열간 점막 비후\",\"q\":\"가장 가능성이 높은 진단은?\",\"choices\":[\"인후두역류질환\",\"후두유두종\",\"변성발성장애\",\"급성 바이러스성 후두염\",\"성대낭종\"],\"answer\":1,\"explain\":\"위 내용물이 후두까지 올라오는 인후두역류는 아침 쉰 목소리, 헛기침, 목 이물감, 가슴쓰림을 흔히 동반하며 후두 후방(피열연골·피열간 부위)의 발적·부종·점막 비후가 특징적 소견이다. 급성 후두염은 감기 등에 뒤따르는 단기 증상이고, 유두종·낭종은 종괴성 병변, 변성발성장애는 후두 소견이 정상이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"음성장애 유형\",\"k\":\"인후두역류 진단\",\"p\":\"아침 쉰 목소리·헛기침과 후두 후방 점막 소견으로 진단 판단\",\"n\":\"인후두역류: 아침 쉰 목소리·헛기침·이물감, 피열연골·피열간 부위 발적·비후\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• 소리가 비강이나 인두 뒤쪽에 갇혀 밖으로 잘 나오지 못하는 듯 답답하고 먹먹하게 들림\\n• 비강 앞쪽 폐쇄나 후방 인두 협착 시 나타날 수 있음\",\"q\":\"해당하는 공명 유형은?\",\"choices\":[\"과다비성\",\"과소비성\",\"맹관공명\",\"혼합 공명\",\"비강 난류\"],\"answer\":3,\"explain\":\"맹관공명(cul-de-sac resonance)은 소리가 막힌 공간에 갇혀 흡수되는 듯 답답하게 들리는 공명으로, 앞쪽 비강 폐쇄나 인두 협착, 혀의 후방 위치 등에서 나타난다. 과다비성은 모음에서 비강 공명이 과도한 것, 과소비성은 비음 /m, n/에서 비강 공명이 부족한 것, 비강 난류는 압력자음 산출 시 코로 공기가 새면서 들리는 소음이다.\",\"tag\":{\"c\":\"평가·해석\",\"a\":\"공명장애\",\"k\":\"공명 유형 식별\",\"p\":\"답답하게 갇힌 음질과 비강·인두 폐쇄 원인으로 공명 유형 판단\",\"n\":\"맹관공명: 막힌 공간에 소리가 갇혀 먹먹함, 앞쪽 비강 폐쇄·인두 협착에서 발생\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"편측 성대마비로 성문 폐쇄가 불완전한 환자에게 성대 내전을 촉진하기 위해 적용하는 음성치료 기법은?\",\"choices\":[\"하품-한숨법\",\"저작하기\",\"속삭이기\",\"밀기 기법\",\"후두 마사지\"],\"answer\":4,\"explain\":\"밀기 기법은 발성하면서 팔로 벽·의자를 밀거나 손을 맞잡아 당기는 등 힘을 주어 성대 내전을 반사적으로 강화하는 기법으로, 성대마비·성대 활 모양 등 저기능성(성문 폐쇄부전) 음성장애에 사용한다. 하품-한숨법, 저작하기, 후두 마사지는 과기능성 음성장애의 긴장을 낮추는 이완 기법이고, 속삭이기는 성대 접촉을 오히려 줄인다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성문 폐쇄부전 치료 기법\",\"p\":\"편측 성대마비의 폐쇄 부전 개선 목표로 내전 촉진 기법 선택\",\"n\":\"밀기 기법: 힘주기로 성대 내전 반사 강화, 저기능성 음성장애에 적용\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"40세 여성 콜센터 상담원\\n• 근긴장성 발성장애(1형)로 진단됨\\n• 발성 시 목 앞쪽 근육이 단단하게 만져지고 후두가 높게 위치함\",\"q\":\"우선적으로 적용할 치료로 적절한 것은?\",\"choices\":[\"밀기 기법으로 성대 내전과 접촉을 강화한다\",\"리실버만 음성치료로 큰 소리 산출을 훈련한다\",\"후두 마사지와 하품-한숨법으로 긴장을 이완한다\",\"강한 성문파열음 시작으로 힘 있는 발성을 유도한다\",\"보툴리눔 독소를 양측 갑상피열근에 주입한다\"],\"answer\":3,\"explain\":\"근긴장성 발성장애는 후두 외근·내근의 과도한 긴장으로 생기는 과기능성 음성장애이므로, 후두 마사지(후두 하강), 하품-한숨법, 저작하기 등 이완 중심 기법이 우선이다. 밀기 기법·강한 성문파열음·큰 소리 훈련은 성대 접촉과 긴장을 더 높여 부적절하고, 보툴리눔 독소 주입은 경련성 발성장애의 치료이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"근긴장성 발성장애 치료\",\"p\":\"과기능성 긴장과 후두 상승 소견으로 우선 치료 기법 선택\",\"n\":\"근긴장성 발성장애: 과기능성, 후두 마사지·하품-한숨법 등 이완 기법 우선\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• /m/ 허밍으로 입술·안면 앞쪽의 진동감을 느끼게 함\\n• 성대가 살짝 벌어진 상태에서 최소한의 노력으로 최대의 공명을 얻도록 함\\n• 성대 충격 스트레스를 줄이는 것이 목표\",\"q\":\"해당하는 음성치료는?\",\"choices\":[\"리실버만 음성치료\",\"액센트 기법\",\"성대기능훈련\",\"공명음성치료\",\"빨대발성\"],\"answer\":4,\"explain\":\"공명음성치료(Lessac-Madsen Resonant Voice Therapy)는 성대가 살짝 벌어진 상태에서 앞쪽 안면·입술의 진동감을 단서로 편안하고 울림 있는 음성을 산출하게 하여 성대 충격을 줄이면서도 강도를 확보하는 방법이다. LSVT는 큰 소리 산출 훈련, 액센트 기법은 복식호흡과 리듬 강세 훈련, 성대기능훈련은 4단계 성대 근육 운동, 빨대발성은 반폐쇄성도 기법이다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"음성치료 기법 식별\",\"p\":\"앞쪽 진동감과 최소 노력 최대 공명 목표로 치료법 식별\",\"n\":\"공명음성치료: 성대 살짝 벌린 상태에서 앞쪽 안면 진동감으로 성대 충격 감소\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"성대기능훈련(Vocal Function Exercises)에 대한 설명으로 옳은 것은?\",\"choices\":[\"준비·신장·수축·내전력 강화 운동으로 구성된다\",\"최대한 큰 소리로 밀어내며 강하게 발성하도록 한다\",\"속삭임으로 성대를 충분히 쉬게 하는 훈련이다\",\"음도 변화 없이 습관적 음도에서만 모음을 연장한다\",\"후두 마사지로 근육의 긴장을 낮추는 이완 기법이다\"],\"answer\":1,\"explain\":\"Stemple의 성대기능훈련은 준비운동(/i/ 연장), 신장(저음→고음 활주), 수축(고음→저음 활주), 내전력 강화(여러 음도에서 /ol/ 연장)의 4가지를 부드럽고 작은 소리로 하루 2회, 각 2번씩 수행하는 생리적 접근이다. 큰 소리·속삭임·이완 마사지는 해당하지 않으며, 음도 활주가 핵심이므로 습관적 음도에서만 연장하는 것도 틀리다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"성대기능훈련 구성\",\"p\":\"4가지 운동 구성과 발성 방식으로 성대기능훈련 특징 식별\",\"n\":\"성대기능훈련: 준비·신장·수축·내전력 강화 4운동, 부드럽고 작은 소리로 수행\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"68세 남성, 파킨슨병\\n• 목소리가 작고 단조로우며 기식적임\\n• 본인은 자신의 목소리가 충분히 크다고 느낌\",\"q\":\"가장 적절한 음성치료는?\",\"choices\":[\"하품-한숨법\",\"리실버만 음성치료\",\"속삭이기\",\"공명음성치료\",\"흡기발성\"],\"answer\":2,\"explain\":\"LSVT LOUD는 파킨슨병 환자의 낮은 강도·단조로운 음성을 위해 개발된 집중 치료(주 4회, 4주)로, '크게 생각하기'를 통해 발성 노력을 높이고 자기 음성 크기에 대한 지각을 재조정한다. 하품-한숨법·공명음성치료는 과기능성 음성의 긴장을 낮추는 방법이며, 흡기발성은 가성대 발성·기능적 실성증에, 속삭이기는 강도를 더 낮추므로 부적절하다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"특수 대상\",\"k\":\"파킨슨병 음성치료 선택\",\"p\":\"작고 단조로운 음성과 자기 음량 지각 저하로 치료법 선택\",\"n\":\"LSVT LOUD: 파킨슨병 저강도 음성, 크게 생각하기로 발성 노력과 음량 지각 재조정\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• 발성 시 진성대 대신 가성대(false vocal folds)가 진동함\\n• 낮고 거친 음질\",\"q\":\"진성대 발성을 유도하기 위해 사용할 수 있는 기법은?\",\"choices\":[\"흡기발성\",\"밀기 기법\",\"강한 성문파열음 시작\",\"큰 소리로 소리 지르기\",\"저음 유지 훈련\"],\"answer\":1,\"explain\":\"흡기발성은 숨을 들이마시면서 소리를 내는 방법으로, 흡기 시에는 가성대가 벌어지고 진성대만 진동하므로 가성대 발성이나 기능적 실성증 환자에게 진성대 발성을 되찾게 하는 데 유용하다. 밀기 기법·강한 성문파열음·소리 지르기는 성문 상부의 압축과 긴장을 더 높이고, 가성대 발성은 이미 낮은 음도이므로 저음 훈련은 목표와 맞지 않는다.\",\"tag\":{\"c\":\"중재·상담\",\"a\":\"음성치료 기법·음성위생\",\"k\":\"가성대 발성 치료 기법\",\"p\":\"가성대 진동 소견으로 진성대 발성 유도 기법 선택\",\"n\":\"흡기발성: 흡기 시 가성대 벌어지고 진성대만 진동, 가성대 발성·기능적 실성증에 적용\"}},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"기관식도발성(TEP)에 대한 설명으로 옳은 것은?\",\"choices\":[\"전기후두처럼 외부 진동원을 목에 대어 소리를 낸다\",\"폐의 공기를 식도로 보내 인두식도분절을 진동시킨다\",\"식도로 삼킨 공기를 역류시켜 발성하므로 발화 길이가 짧다\",\"후두를 적출하지 않고 시행하는 성대 재건술이다\",\"발성을 위해 호흡과 무관하게 단어 단위로만 말한다\"],\"answer\":2,\"explain\":\"기관식도발성은 후두전적출 후 기관과 식도 사이에 만든 천공에 일방향 밸브 보철을 삽입하여, 기공을 막고 내쉰 폐의 공기를 식도로 보내 인두식도분절을 진동시키는 방법이다. 폐의 공기를 사용하므로 식도발성보다 발화 길이가 길고 강도가 크다. 외부 진동원을 쓰는 것은 전기후두, 삼킨 공기를 쓰는 것은 식도발성이다.\",\"tag\":{\"c\":\"이론·개념\",\"a\":\"특수 대상\",\"k\":\"무후두 발성 방법 비교\",\"p\":\"진동원과 공기 공급원 구분으로 기관식도발성 특징 식별\",\"n\":\"기관식도발성: 폐 공기를 보철로 식도에 보내 인두식도분절 진동, 발화 길이 김\"}},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"다음은 좌측 중대뇌동맥 경색 환자의 파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R) 하위검사 원점수를 치료 전과 6개월 치료 후에 비교한 것이다.\\n• 스스로 말하기: 9/20 → 12/20\\n• 알아듣기: 120/200 → 150/200\\n• 따라말하기: 40/100 → 55/100\\n• 이름대기 및 낱말 찾기: 30/100 → 45/100\\n※ AQ = (스스로 말하기 + 알아듣기÷20 + 따라말하기÷10 + 이름대기÷10) × 2\",\"q\":\"이 환자의 치료 전후 실어증지수(AQ) 변화량은?\",\"choices\":[\"7.5점 증가\",\"12.5점 증가\",\"15.0점 증가\",\"17.5점 증가\",\"30.0점 증가\"],\"answer\":3,\"explain\":\"치료 전 AQ = (9 + 120÷20 + 40÷10 + 30÷10) × 2 = (9 + 6 + 4 + 3) × 2 = 44.0. 치료 후 AQ = (12 + 150÷20 + 55÷10 + 45÷10) × 2 = (12 + 7.5 + 5.5 + 4.5) × 2 = 59.0. 따라서 변화량은 59.0 − 44.0 = 15.0점이다. ⑤ 30.0은 ×2를 한 번 더 적용한 오류, ① 7.5는 마지막 ×2를 빠뜨린 오류에서 나오기 쉬운 값이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"62세 실어증 환자에게 복잡한 그림 설명하기 과제를 실시하였다.\\n• 발화 시간: 2분\\n• 산출한 총 낱말 수: 150개\\n• 이 중 정확하고 정보적이며 과제와 관련된 낱말(CIU): 90개\",\"q\":\"Nicholas와 Brookshire의 CIU 분석에 따른 이 환자의 %CIU와 분당 CIU 수는?\",\"choices\":[\"%CIU 45, 분당 CIU 60개\",\"%CIU 60, 분당 CIU 45개\",\"%CIU 60, 분당 CIU 90개\",\"%CIU 75, 분당 CIU 45개\",\"%CIU 40, 분당 CIU 75개\"],\"answer\":2,\"explain\":\"%CIU = CIU 수 ÷ 총 낱말 수 × 100 = 90 ÷ 150 × 100 = 60%. 분당 CIU = CIU 수 ÷ 발화 시간(분) = 90 ÷ 2 = 45개/분이다. 분당 낱말 수(WPM)는 150 ÷ 2 = 75개로, ⑤는 %CIU와 WPM을 혼동한 것이고 ③은 발화 시간을 나누지 않은 값이다. %CIU는 발화의 정보성(산출한 낱말 중 정보를 담은 낱말의 비율)을, 분당 CIU는 정보 전달의 효율성을 나타낸다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"다음은 58세 여자 환자의 뇌자기공명영상(B-MRI) 축상면이다. [그림 1]\",\"q\":\"빗금 친 영역이 손상되었을 때 이 환자에게 나타날 가능성이 가장 높은 의사소통·인지 특성은?\",\"choices\":[\"글을 읽을 때 줄의 왼쪽을 빠뜨리고 그림의 왼쪽 세부를 놓친다\",\"조사와 어미를 생략한 짧은 전보식 발화를 주로 산출한다\",\"음소착어가 잦고 따라말하기가 선택적으로 심하게 손상된다\",\"근력 저하 없이 조음 모색행동을 보이며 자동구어는 비교적 유창하다\",\"글자를 하나씩 짚어 가며 읽고 자신이 쓴 글을 다시 읽지 못한다\"],\"answer\":1,\"explain\":\"[그림 1]의 빗금은 R로 표시된 쪽, 곧 환자의 우측 대뇌반구 뒤쪽 바깥 부위(측두두정엽, 하두정소엽 및 상측두회 후방)에 있다. 우측 측두두정엽(하두정소엽) 손상은 좌측 편측무시의 대표적인 병소로, 읽기에서 줄의 왼쪽을 빠뜨리는 무시실독과 그림의 왼쪽 세부를 놓치는 시공간적 무시가 나타난다. ②는 좌측 하전두회(브로카 영역), ③은 좌측 궁상다발(전도실어증), ④는 좌측 전운동/뇌섬엽(말실행증), ⑤는 좌측 후두엽·뇌량 팽대(순수실독증) 손상에서 나타나는 특성이다.\",\"image\":\"data:image/webp;base64,\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"56세 남자 환자가 일산화탄소 중독으로 인한 저산소성 뇌손상 후 언어평가를 받았다.\\n• 파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R) 결과\\n – 스스로 말하기: 5/20점(내용전달 3점, 유창성 2점)\\n – 알아듣기: 64/200점\\n – 따라말하기: 82/100점\\n – 이름대기 및 낱말 찾기: 12/100점\\n• 검사자의 질문을 그대로 되풀이하는 반향어가 빈번함\",\"q\":\"이 환자의 실어증 유형과 추정되는 손상 부위가 옳게 연결된 것은?\",\"choices\":[\"전반실어증 – 좌측 중대뇌동맥 영역 전체\",\"브로카실어증 – 좌측 하전두회 후방\",\"베르니케실어증 – 좌측 상측두회 후방\",\"연결피질운동실어증 – 좌측 보충운동영역\",\"혼합연결피질실어증 – 분수계 영역\"],\"answer\":5,\"explain\":\"비유창한 발화(유창성 2점), 심하게 저하된 청각적 이해(64/200), 심한 이름대기 장애에도 불구하고 따라말하기만 82/100으로 뚜렷하게 보존되고 반향어가 나타나는 양상은 혼합연결피질실어증(고립증후군)의 특징이다. PK-WAB-R 10점 척도로 환산하면 유창성 2, 알아듣기 3.2(64÷20), 따라말하기 8.2(82÷10), 이름대기 1.2(12÷10)로, 혼합연결피질실어증 분류 기준(유창성 0~4, 알아듣기 0~3.9, 따라말하기 5~10, 이름대기 0~6)에 모두 들어간다. 저산소성 뇌손상이나 일산화탄소 중독은 전·후 분수계(경계역) 영역을 함께 손상시켜 언어 영역(페리실비안)은 남기고 주변 연합영역을 손상시키므로 이 유형이 발생한다. 전반실어증(①)은 따라말하기도 심하게 손상되며, 연결피질운동실어증(④)은 청각적 이해가 비교적 양호하다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"브로카실어증 환자의 문장-그림 짝짓기 검사 결과\\n• 비가역 문장(예: '소년이 사과를 먹었다'): 정답률 95%\\n• 가역 능동문(예: '소녀가 소년을 밀었다'): 정답률 45%\\n• 가역 피동문(예: '소년이 소녀에게 밀렸다'): 정답률 40%\\n• 오류는 대부분 행위자와 대상이 뒤바뀐 그림을 선택하는 것이었음\",\"q\":\"이 환자의 문장 이해 결함을 개선하기 위해 가장 적절한 치료법은?\",\"choices\":[\"멜로디억양치료\",\"의미자질분석\",\"시각동작치료\",\"매핑치료\",\"의사소통효과증진법\"],\"answer\":4,\"explain\":\"비가역 문장은 의미·상식 단서로 이해할 수 있어 정답률이 높지만, 가역 문장에서 행위자와 대상을 뒤바꾸는 오류는 통사 구조에 의미역(행위자·대상)을 할당하는 '매핑'의 결함을 시사한다. 매핑치료는 동사를 중심으로 '누가·무엇을·누구에게'를 확인하며 문장 구조와 의미역의 대응을 훈련하는 방법으로 이러한 실문법성 이해 결함에 직접 적용된다. ①은 비유창 환자의 구어 산출 유도, ②는 이름대기, ③은 전반실어증의 제스처 소통, ⑤는 기능적 정보 교환 훈련이 목적이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"언어재활사가 실문법증 환자의 문장 산출 치료를 계획하면서 단순한 능동문 대신 목적어 관계절이 포함된 문장(예: '엄마가 아이가 안고 있는 강아지를 쓰다듬는다')을 먼저 훈련하기로 하였다. 치료 후 훈련하지 않은, 같은 유형의 구조를 공유하는 더 단순한 문장(목적어를 묻는 의문사 의문문, 예: '아이가 무엇을 안고 있니?')에서도 산출이 향상되었다.\",\"q\":\"이러한 치료 계획의 근거가 되는 원리는?\",\"choices\":[\"자극의 난이도 위계에 따라 쉬운 구조부터 훈련해야 오류가 줄어든다\",\"복잡한 구조 훈련이 언어학적으로 관련된 단순 구조로 일반화된다\",\"오류 없는 학습을 통해 잘못된 반응이 강화되는 것을 막는다\",\"자동구어를 먼저 활용하면 명제적 발화의 산출이 촉진된다\",\"우반구의 운율 처리 능력을 활용하여 좌반구 기능을 보완한다\"],\"answer\":2,\"explain\":\"Thompson 등의 복잡성 효과(complexity account of treatment efficacy, CATE)와 기저형 치료(TUF)에 따르면, 언어학적으로 더 복잡한 구조(목적어 관계절 등 논항 이동이 포함된 구조)를 훈련하면 그 하위 과정을 공유하는 단순한 구조로 일반화되지만, 반대 방향의 일반화는 잘 일어나지 않는다. 일반화는 같은 유형의 이동(wh-이동)을 공유하는 구조 사이에서 일어나며, 이동 유형이 다른 피동문(NP-이동)이나 이동이 없는 능동문으로는 일반화되지 않는다. ①은 전통적 난이도 위계 원리로 문제의 계획과 반대이며, ③·④·⑤는 각각 오류 없는 학습, 자동구어 활용, 멜로디억양치료의 원리이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"세 명의 환자에게 교대운동속도(AMR: /퍼/, /터/, /커/ 각각 반복)와 일련운동속도(SMR: /퍼터커/ 반복) 과제를 실시하였다.\\n• 환자 A: AMR은 속도와 규칙성이 정상 범위이나, SMR에서 음절 순서가 뒤바뀌고 모색행동이 나타나며 여러 번 시도함\\n• 환자 B: AMR과 SMR 모두 느리지만 규칙적이고, 쥐어짜는 듯한 거친 음성이 동반됨\\n• 환자 C: AMR의 속도·강도·음도가 불규칙하게 변동하고 음절이 갑자기 폭발적으로 산출됨\",\"q\":\"세 환자의 말운동장애 유형이 옳게 연결된 것은?\",\"choices\":[\"A: 말실행증, B: 경직형 마비말장애, C: 실조형 마비말장애\",\"A: 실조형 마비말장애, B: 말실행증, C: 경직형 마비말장애\",\"A: 경직형 마비말장애, B: 실조형 마비말장애, C: 말실행증\",\"A: 말실행증, B: 실조형 마비말장애, C: 이완형 마비말장애\",\"A: 이완형 마비말장애, B: 경직형 마비말장애, C: 말실행증\"],\"answer\":1,\"explain\":\"말실행증은 근력·협응의 문제가 아니라 운동 계획·프로그래밍의 문제이므로 단일 음절 반복(AMR)은 비교적 정상이지만 조음 위치를 순서대로 전환해야 하는 SMR에서 순서 오류와 모색행동이 두드러진다(A). 경직형은 양측 상부운동신경 손상으로 느리지만 규칙적인 AMR·SMR과 쥐어짜는 음성이 특징이다(B). 실조형은 소뇌 손상으로 운동의 시간·힘 조절이 불규칙해져 AMR의 속도·강도·음도가 불규칙하고 폭발적인 산출을 보인다(C). 이완형은 AMR이 느리고 약하며 기식 음성·과다비성이 동반된다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"좌측 전운동피질 손상으로 말실행증을 보이는 54세 환자의 치료 경과\\n• 회기 내에서는 목표 낱말('구두', '기차', '토마토')의 정확도가 90%까지 향상됨\\n• 그러나 다음 회기 시작 시 정확도가 40%로 떨어지고, 훈련하지 않은 낱말로의 전이가 거의 없음\\n• 현재 치료 방식: 목표 낱말별 블록 연습, 매 시행마다 즉각적인 피드백 제공\",\"q\":\"운동학습 원리에 근거하여 파지와 전이를 높이기 위해 치료 조건을 조정한 것으로 가장 적절한 것은?\",\"choices\":[\"블록 연습을 유지하고 매 시행 피드백 횟수를 더 늘린다\",\"목표 낱말 수를 줄이고 매 시행마다 즉각 피드백을 계속 제공한다\",\"한 회기에 많은 시행을 몰아서 하는 집중(massed) 연습만 한다\",\"모든 시행에서 치료사가 먼저 모델을 제공한 후 따라 하게 한다\",\"낱말을 무작위 순서로 연습하고 피드백을 지연·저빈도로 준다\"],\"answer\":5,\"explain\":\"운동학습 원리(Maas 등)에 따르면 블록 연습과 매 시행 즉각 피드백은 회기 내 수행(습득)은 높이지만 파지·전이에는 불리하다. 무작위 연습, 분산 연습, 지연·저빈도(매 시행이 아닌 일부 시행에만 주는) 결과지식(KR) 피드백은 학습자의 내적 오류 탐지와 문제 해결을 촉진하여 장기 파지와 일반화를 향상시킨다. ①·②·③·④는 모두 습득 단계의 수행은 높여도 파지를 저해하는 조건이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"48세 헌팅턴병 환자의 말 평가 결과\\n• 얼굴·사지의 무도성 불수의 운동이 지속적으로 나타남\\n• 발화 중 갑작스러운 음성 강도 변동과 호흡의 흐트러짐\\n• 불규칙한 말속도와 부적절한 침묵, 예기치 않은 모음 왜곡\\n• 근력 저하는 뚜렷하지 않음\",\"q\":\"이 환자의 마비말장애 유형과 적절한 중재가 옳게 연결된 것은?\",\"choices\":[\"과소운동형 – 리실버만음성치료로 음성 강도 증진\",\"실조형 – 메트로놈을 이용한 규칙적 음절 산출 훈련\",\"과다운동형 – 구 단위 끊어 말하기와 페이싱\",\"경직형 – 하품한숨기법으로 후두 긴장 이완\",\"이완형 – 저항 운동을 통한 구강 근력 강화\"],\"answer\":3,\"explain\":\"헌팅턴병은 기저핵(미상핵·피각) 퇴행으로 무도증을 일으키며, 불수의 운동이 말에 침범되어 갑작스러운 강도·호흡 변동, 불규칙한 말속도, 예기치 않은 왜곡을 보이는 과다운동형 마비말장애를 유발한다. 불수의 운동 자체를 직접 없앨 수 없으므로 짧은 구 단위로 나누어 말하기, 페이싱, 불수의 운동이 덜 개입되는 자세 및 보상 전략이 적절하다. ①은 파킨슨병(과소운동형), ②는 소뇌 손상(실조형), ④는 경직형, ⑤는 근력 저하가 있는 이완형에 해당한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"42세 여자 환자의 호소\\n• \\\"오후가 되면 눈꺼풀이 처지고 말이 더 어눌해져요.\\\"\\n• \\\"전화를 오래 하면 점점 콧소리가 나고 목소리에 바람이 새는데, 잠깐 쉬면 다시 괜찮아져요.\\\"\\n• 검사 시 1부터 100까지 세는 동안 과다비성과 기식성이 점차 심해졌고 5분 휴식 후 회복됨\",\"q\":\"이 환자의 마비말장애 유형과 손상 부위가 옳게 연결된 것은?\",\"choices\":[\"경직형 – 양측 상부운동신경\",\"과소운동형 – 기저핵 조절회로\",\"실조형 – 소뇌와 그 연결 경로\",\"이완형 – 신경근접합부\",\"편측 상부운동신경형 – 피질뇌간로\"],\"answer\":4,\"explain\":\"지속적인 근육 사용에 따라 악화되고 휴식 후 회복되는 피로성 약화, 안검하수, 점진적 과다비성·기식성은 신경근접합부의 아세틸콜린 수용체 장애인 중증근무력증의 전형적인 소견이다. 신경근접합부 병변은 하부운동신경 단위(운동단위)의 병변에 포함되므로 이완형 마비말장애로 분류된다. 스트레스 검사(숫자 세기 등 지속 발화)로 피로에 따른 악화를 확인하는 것이 진단에 유용하다. 나머지 유형은 말을 계속할수록 악화되고 휴식하면 회복되는 피로성 변동이 특징적이지 않다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"66세 남자 환자\\n• 좌측 후대뇌동맥 경색, 우측 동측반맹\\n• 글을 읽을 때 글자를 하나씩 짚어 가며 읽고, 낱말이 길수록 읽는 시간이 뚜렷하게 길어짐\\n• 받아쓰기와 자발적 쓰기는 정상이나, 방금 자신이 쓴 문장을 다시 읽지 못함\\n• 구어 표현과 청각적 이해는 정상 범위\",\"q\":\"이 환자의 진단명과 손상 부위가 옳게 연결된 것은?\",\"choices\":[\"순수실독증 – 좌측 후두엽과 뇌량 팽대\",\"심층실독증 – 좌측 전두·두정 광범위 병변\",\"표층실독증 – 좌측 측두엽 전방부\",\"무시실독증 – 우측 하두정소엽\",\"실독증을 동반한 실서증 – 좌측 각회\"],\"answer\":1,\"explain\":\"쓰기는 보존되나 자신이 쓴 글조차 읽지 못하는 '실서증 없는 실독증', 글자 하나씩 읽기(letter-by-letter reading)와 낱말 길이 효과, 우측 동측반맹의 동반은 순수실독증의 전형적 특징이다. 좌측 후두엽(시각피질) 손상으로 좌측 시야의 시각 정보만 우측 후두엽에서 처리되는데, 뇌량 팽대가 함께 손상되어 이 정보가 좌반구의 언어 영역(각회)으로 전달되지 못하는 단절증후군이다. ⑤ 각회 손상은 읽기와 쓰기가 모두 손상되는 실독·실서증을 일으킨다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"좌반구 뇌졸중 환자의 받아쓰기 검사 결과\\n• 규칙어('나무', '바지')와 불규칙어('닭', '굳이', '넋'): 모두 정확하게 씀\\n• 비단어('소딥', '가믄', '누텔'): 쓰지 못하거나 실제 낱말로 바꾸어 씀('소딥'→'소득')\\n• 구체어와 추상어 쓰기의 차이는 뚜렷하지 않음\\n• 베껴 쓰기와 글자 형태는 정상\",\"q\":\"이 환자의 실서증 유형과 손상된 쓰기 경로가 옳게 연결된 것은?\",\"choices\":[\"표층실서증 – 어휘 경로\",\"심층실서증 – 의미 경로\",\"실행실서증 – 운동 프로그래밍\",\"공간실서증 – 시공간 처리\",\"음운실서증 – 음운 경로\"],\"answer\":5,\"explain\":\"비단어는 음소-자소 변환(음운 경로)을 거쳐야만 쓸 수 있는데 이것이 선택적으로 손상되고, 어휘 경로가 보존되어 불규칙어를 포함한 실제 낱말은 정확히 쓰는 양상은 음운실서증이다. 표층실서증(①)은 반대로 어휘 경로가 손상되어 불규칙어를 소리 나는 대로('닭'→'닥') 쓰고 비단어는 잘 쓴다. 심층실서증(②)은 비단어 쓰기 불가에 더해 의미착오('의자'→'책상')와 구체어-추상어 차이가 나타난다. ③·④는 언어적 경로가 아닌 운동·공간 처리의 문제로 글자 형태나 배열이 손상된다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"70세 남자 환자\\n• 고혈압·당뇨 병력, 3년 동안 두 차례 소혈관 뇌졸중\\n• 인지 저하가 뇌졸중 시점마다 계단식으로 악화됨\\n• 처리속도와 실행기능(계획, 전환)이 뚜렷하게 저하됨\\n• 이야기 지연회상은 낮으나 재인 단서를 주면 대부분 회상함\\n• 보행 불안정과 배뇨 절박 동반\",\"q\":\"이 환자에게 가장 의심되는 진단명은?\",\"choices\":[\"알츠하이머 치매\",\"루이소체 치매\",\"혈관성 치매\",\"전두측두치매\",\"의미치매\"],\"answer\":3,\"explain\":\"혈관 위험인자, 뇌졸중 병력과 시간적으로 연관된 계단식 악화, 실행기능·처리속도의 초기 저하, 저장보다 인출의 결함(단서 제공 시 회상 향상), 보행 장애와 배뇨 증상 같은 국소 신경학적 징후는 혈관성 치매(특히 피질하 소혈관성)의 전형적 특징이다. 알츠하이머 치매(①)는 서서히 진행하며 단서를 주어도 회상되지 않는 저장 결함이 특징이고, 루이소체 치매(②)는 인지 변동·시각환각·파킨슨증, 전두측두치매(④, 특히 행동변이형)는 탈억제·무감동 등 행동 변화, 의미치매(⑤)는 낱말 의미와 사물 지식 상실이 두드러진다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"63세 여자 환자\\n• 2년 전부터 서서히 진행되는 노력성·비유창 발화\\n• 조사·어미를 생략하고 문장이 짧음\\n• 발화 중 모색행동과 일관성 없는 조음 오류가 관찰됨\\n• 피동문과 관계절이 포함된 문장의 이해가 저하됨\\n• 뇌 영상에서 좌측 하전두회·뇌섬엽의 위축\",\"q\":\"이 환자의 진단명을 고려할 때, 질환 초기에 상대적으로 보존될 것으로 기대되는 능력은?\",\"choices\":[\"문법형태소의 정확한 산출\",\"조음의 순서화와 프로그래밍\",\"피동문의 이해\",\"단일 낱말의 의미 이해\",\"긴 문장의 따라말하기\"],\"answer\":4,\"explain\":\"점진적 진행, 실문법증, 말실행증 동반, 복잡한 통사 이해 저하, 좌측 하전두회·뇌섬엽 위축은 원발성 진행성 실어증의 비유창/실문법형(nfvPPA)에 해당한다. 이 유형의 핵심 진단 기준은 단일 낱말 이해와 사물 지식이 상대적으로 보존된다는 점으로, 의미형 PPA와 감별되는 핵심 특징이다. ①·②·③·⑤는 모두 이 유형에서 손상되는 영역이다(긴 문장 따라말하기는 통사·운동 프로그래밍 부담으로 손상된다).\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"79세 여자 환자, 고관절 골절 수술 3일째 언어치료 의뢰됨\\n• 수술 전 인지·언어 기능은 정상이었다고 가족이 보고함\\n• 밤에 심해지는 혼란, 대화 중 주의가 갑자기 흐트러졌다가 돌아오는 변동\\n• 낮에는 졸려 하고 질문에 맥락 없는 답을 함\\n• 보호자: \\\"어제는 멀쩡하게 이야기했는데 오늘은 저를 못 알아봐요.\\\"\",\"q\":\"이 상황에서 언어재활사의 판단으로 가장 적절한 것은?\",\"choices\":[\"알츠하이머 치매 초기로 판단하고 기억 훈련을 즉시 시작한다\",\"섬망을 의심하여 의료진에게 알리고 공식 평가는 연기한다\",\"베르니케실어증으로 판단하고 청각적 이해력 훈련을 계획한다\",\"PK-WAB-R을 즉시 실시하여 실어증 유형을 분류한다\",\"우반구 손상에 의한 화용 결함으로 판단하고 대화 훈련을 시작한다\"],\"answer\":2,\"explain\":\"급성 발병, 수술·입원과의 시간적 연관성, 하루 중 변동하는 의식 수준과 주의력, 야간 악화, 이전 정상 인지는 치매가 아닌 섬망의 핵심 특징이다. 섬망은 감염·약물·대사 이상 등 급성 의학적 원인에 의한 가역적 상태이므로 언어재활사는 이 시기에 공식 평가나 치료를 시행해 결과를 해석하기보다 의료진에게 알리고 원인 교정 후 안정된 상태에서 재평가해야 한다. 변동하는 주의력 상태에서 얻은 검사 결과는 실어증이나 치매로 잘못 해석될 수 있다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"외상성 뇌손상 후 3주가 지난 27세 남자 환자\\n• 랜초 로스 아미고스 인지기능척도(RLA) IV 수준(혼돈-초조)\\n• 주변 소음이나 낯선 사람에게 공격적으로 반응함\\n• 주의 지속 시간이 수 분 이내이고 시간·장소 지남력이 없음\\n• 자신이 어디에 있는지 반복해서 묻고 병실을 벗어나려 함\",\"q\":\"이 시기에 적절한 인지-의사소통 중재 접근은?\",\"choices\":[\"자극을 줄인 구조화된 환경에서 짧고 잦은 회기로 지남력을 유지한다\",\"실행기능 회복을 위해 복잡한 문제 해결 과제를 집중적으로 훈련한다\",\"표준화된 인지·언어검사 배터리를 완료하여 정확한 기초선을 먼저 확보한다\",\"또래 환자와의 그룹 대화 훈련으로 사회적 의사소통을 촉진한다\",\"공격 행동이 나타날 때 과제 난이도를 높여 주의를 다른 곳으로 돌린다\"],\"answer\":1,\"explain\":\"RLA IV(혼돈-초조) 수준은 주의 지속이 매우 짧고 외부 자극에 과민하게 반응하며 새로운 학습이 어려운 시기이다. 이때는 회복 훈련보다 환경 조절(자극 감소, 일관된 일과와 사람), 짧고 잦은 접촉, 지남력 정보의 반복 제공, 안전 확보, 익숙한 사람·물건 활용이 원칙이다. 복잡한 과제(②), 긴 표준화 검사(③), 자극이 많은 그룹 활동(④)은 초조를 악화시키며, 난이도를 높이는 것(⑤)은 좌절과 공격성을 유발한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"외상성 뇌손상 후 8개월 된 35세 환자\\n• 기억력과 언어 능력은 비교적 보존됨\\n• 과제 수행 전에 계획을 세우지 못하고 충동적으로 시작함\\n• 자신의 오류를 알아차리지 못하며, \\\"나는 아무 문제 없다\\\"고 말함\\n• 직장 복귀를 원하나 스스로의 능력을 과대평가함\",\"q\":\"이 환자에게 가장 적절한 중재는?\",\"choices\":[\"반복적인 컴퓨터 자극 훈련으로 손상된 기능을 회복시킨다\",\"외부 기억 보조 도구(다이어리, 알림) 사용만 훈련한다\",\"메타인지 전략과 자기 예측·평가 비교로 병식을 높인다\",\"오류 없는 학습을 적용하여 오류에 노출되지 않도록 한다\",\"문장 산출을 위한 통사 구조 훈련을 집중 실시한다\"],\"answer\":3,\"explain\":\"계획 부족, 충동성, 오류 인식 부재, 병식 결여는 실행기능과 자기 인식(self-awareness)의 결함으로 TBI 후 흔한 양상이다. 목표-계획-실행-점검(Goal-Plan-Do-Review) 등 메타인지 전략 교수(MSI)는 자기 조절 능력을 기르는 근거 기반 접근이며, 수행 전 예측과 실제 수행을 비교하는 절차는 병식 향상에 효과적이다. 기억(②)과 언어(⑤)는 보존되어 있어 주 표적이 아니며, 오류 없는 학습(④)은 오류를 경험하고 알아차리는 것이 목표인 이 환자에게는 적합하지 않다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"우반구 뇌졸중 환자\\n• 감정적으로 중립인 문장(\\\"그 사람이 집에 왔어\\\")을 화난 목소리, 기쁜 목소리, 슬픈 목소리로 들려주고 감정을 고르게 하면 우연 수준으로 반응함\\n• 문장의 언어적 의미 이해는 정상\\n• 환자 자신의 발화 억양은 다양하고 감정 표현이 자연스러움\",\"q\":\"이 환자의 운율장애 유형과 추정 병소가 옳게 연결된 것은?\",\"choices\":[\"표현성 감정 운율장애 – 우측 전두엽\",\"실어증성 운율 결함 – 좌측 하전두회\",\"과소운동형 운율 저하 – 양측 기저핵\",\"언어적 운율 결함 – 좌측 측두두정엽\",\"수용성 감정 운율장애 – 우측 측두두정\"],\"answer\":5,\"explain\":\"언어적 의미 이해는 정상이면서 감정 운율의 해석만 손상되고 자신의 운율 산출은 보존된 양상은 수용성(감각성) 감정 운율장애로, Ross의 모델에 따르면 우반구 후방(베르니케 영역의 우반구 상동 부위인 측두두정)이 담당한다. 표현성 운율장애(①)는 우반구 전방 손상으로 단조로운 억양 산출이 문제가 되며, 이 환자는 산출이 보존되어 해당하지 않는다. 기저핵 손상(③)은 산출의 단조로움, 좌반구 손상(②·④)은 감정 운율보다 언어적 운율·문법적 강세와 관련된다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"비디오투시조영삼킴검사(VFSS)에서 얇은 액체 5mL 삼킴 시 관찰된 소견\\n• 조영제가 후두 전정을 지나 진성대 아래 기관으로 들어감\\n• 기침이나 헛기침 등 배출 시도가 전혀 없음\\n• 환자는 이상을 전혀 느끼지 못한다고 보고함\",\"q\":\"침습-흡인 척도(Penetration-Aspiration Scale, PAS)에 따른 이 소견의 점수와 해석은?\",\"choices\":[\"2점 – 성대 위 침습 후 배출됨\",\"3점 – 성대 위 침습, 배출되지 않음\",\"5점 – 성대 접촉 침습, 배출되지 않음\",\"6점 – 흡인 후 기도 밖으로 배출됨\",\"8점 – 배출 시도 없는 무증상 흡인\"],\"answer\":5,\"explain\":\"PAS는 1(기도 진입 없음)에서 8까지의 8단계로, 진성대 아래로 들어가면 흡인(6~8점)이다. 6점은 흡인 후 배출됨, 7점은 배출 시도가 있으나 배출되지 않음, 8점은 배출 시도 자체가 없는 무증상 흡인(silent aspiration)이다. 이 환자는 기관으로 들어간 조영제에 대해 기침 등 반응이 전혀 없으므로 8점에 해당하며, 감각 결함으로 인한 무증상 흡인은 임상(침상) 평가에서 놓치기 쉬워 기기 검사가 필수적임을 시사한다. ①~③은 성대 위에 머무는 침습(2~5점)에 해당한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"68세 삼킴장애 환자의 VFSS 소견\\n• 삼킴 중 후두 거상과 전방 이동이 불충분함\\n• 상부식도괄약근의 개방이 짧고 불완전하여 이상동(조롱박오목)에 다량의 잔여물이 남음\\n• 멘델슨기법을 적용하면 잔여물이 감소하나, 언어재활사는 보상이 아닌 근본적 기능 개선을 위한 운동 훈련을 병행하고자 함\",\"q\":\"이 목적에 가장 적합한 운동 훈련과 그 기전은?\",\"choices\":[\"샤커 운동 – 설골상근의 근력과 지구력 강화\",\"마사코 기법 – 혀 기저부와 인두벽 접촉 강화\",\"온도촉각자극법 – 인두 삼킴 반사 유발 촉진\",\"노력삼킴 – 혀 기저부의 후방 이동 강화\",\"턱 당기기 – 기도 입구 좁힘으로 흡인 예방\"],\"answer\":1,\"explain\":\"샤커(Shaker) 운동은 누운 자세에서 어깨를 바닥에 붙인 채 머리만 들어 발끝을 보는 등척성·등장성 운동으로, 설골상근(턱끝목뿔근·턱목뿔근 등)을 강화하여 후두의 전상방 이동을 늘리고 그 결과 상부식도괄약근의 개방을 개선한다는 근거가 확립된 재활 운동이다. 마사코(②)와 노력삼킴(④)은 혀 기저부-인두벽 접촉 문제, 온도촉각자극(③)은 삼킴 반사 지연이 주된 문제일 때 적용한다. 턱 당기기(⑤)는 자세 보상 기법으로 근본적 기능 개선 목적이 아니다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"61세 남자 환자\\n• 우측 외측 연수 경색(발렌베르크 증후군)\\n• 쉰 목소리, 우측 얼굴 감각 저하, 어지럼과 보행 불안정\\n• 삼킴장애로 언어치료 의뢰됨\",\"q\":\"이 환자에게 예상되는 삼킴 소견으로 가장 적절한 것은?\",\"choices\":[\"저작 곤란과 음식덩이 형성 실패가 두드러진다\",\"인두 삼킴 지연, 우측 인두 약화와 이상동 잔여물\",\"혀의 운동 저하로 구강 내 측면 고랑에 잔여물이 남는다\",\"식도 연동 운동 저하로 인한 식도기 정체만 관찰된다\",\"연구개 기능은 정상이나 비강 역류가 반복된다\"],\"answer\":2,\"explain\":\"외측 연수에는 삼킴 중추(고립로핵·의문핵)와 미주신경 관련 구조가 있어 발렌베르크 증후군은 심한 인두기 삼킴장애를 일으키는 대표적인 병변이다. 삼킴 반사의 촉발 지연·부재, 병변 동측 인두·후두 약화, 윤상인두근 이완 실패로 인한 상부식도괄약근 개방 부전과 이상동 잔여물이 전형적이며, 구강기는 상대적으로 보존된다. ①·③은 구강기(피질·하위 뇌신경 V·XII) 문제이며, ④는 인두기 문제 없이 식도기만 문제된다는 점에서, ⑤는 미주신경 손상 시 연구개 약화가 동반된다는 점에서 옳지 않다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"중환자실 환자의 삼킴 평가 의뢰\\n• 인공호흡기 이탈 후 2일째, 기관절개관 유지 중\\n• 혈역학적으로 불안정하여 방사선실로 이동이 어려움\\n• 침상 평가에서 젖은 음성이 관찰되어 삼킴 전 분비물 고임과 후두 감각 확인이 필요함\\n• 향후 여러 차례 반복 평가가 예상됨\",\"q\":\"이 환자에게 비디오투시조영삼킴검사(VFSS)보다 내시경삼킴검사(FEES)를 우선 선택하는 근거로 옳은 것은?\",\"choices\":[\"구강 준비기와 식도기를 직접 관찰할 수 있다\",\"삼킴 순간의 흡인을 실시간으로 직접 볼 수 있다\",\"휴대용 장비로 침상에서 반복 시행할 수 있다\",\"조영제로 음식물 이동 경로를 정량화할 수 있다\",\"후두 거상과 상부식도괄약근 개방을 측정할 수 있다\"],\"answer\":3,\"explain\":\"FEES는 휴대용 장비로 침상·중환자실에서 시행할 수 있고, 방사선 노출이 없어 반복 검사가 가능하며, 삼킴 전 후두·이상동의 분비물 고임과 후두 감각(공기 자극 또는 내시경 접촉 반응)을 직접 평가할 수 있다는 점에서 이 환자에게 적합하다. 반면 FEES는 삼킴 순간 인두 수축으로 화면이 하얗게 가려지는 '백색 소실(white-out)'로 흡인의 순간을 직접 보지 못하고(②), 구강기·식도기 관찰(①), 후두 거상·UES 개방 등 생리 측정(⑤), 조영제 이동의 정량화(④)는 VFSS의 장점이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"중등도 실어증 환자와 배우자의 대화 관찰\\n• 환자가 낱말을 찾는 동안 배우자가 대신 대답하고 대화를 이어감\\n• 환자가 오류를 보이면 즉시 교정하고 다시 말해 보게 함\\n• 배우자: \\\"남편이 무슨 말을 하려는지 몰라서 제가 그냥 넘겨요.\\\"\\n• 환자는 대화 참여를 점점 피함\",\"q\":\"성인 실어증을 위한 지원대화(SCA) 원리에 근거한 의사소통 파트너 훈련 목표로 가장 적절한 것은?\",\"choices\":[\"환자의 발화 오류를 정확히 교정해 주는 방법을 익힌다\",\"대화의 혼란을 줄이기 위해 그림이나 몸짓 사용을 삼간다\",\"환자가 글자를 쓰려 할 때 구어로만 말하도록 유도한다\",\"핵심어·그림·몸짓으로 이해와 표현을 돕고 확인한다\",\"배우자가 대화의 주제와 순서를 주도하여 환자의 부담을 줄인다\"],\"answer\":4,\"explain\":\"SCA(Supported Conversation for Adults with Aphasia)는 실어증이 언어의 문제이지 능력의 문제가 아니라는 전제에서 파트너가 '능력 인정하기(acknowledging competence)'와 '능력 드러내기(revealing competence)'를 실천하도록 훈련한다. 능력 드러내기는 핵심어 쓰기·그림·제스처 등 다중 양식으로 정보를 '들어가게(getting the message in)' 하고, 환자가 표현할 수 있도록 선택지·예/아니오 질문 등으로 '나오게(getting the message out)' 도우며, 이해했는지 확인하는 세 요소로 이루어진다. 배우자의 대화 주도(⑤), 즉시 교정(①), 다중 양식 제한(②·③)은 환자의 참여를 위축시킨다.\"},{\"grade\":1,\"set\":3,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"치료사: (연필 그림을 보여주며) \\\"이것의 이름을 말해 보세요.\\\"\\n환자 A: \\\"어… 이거… 쓰는 거… 아, 연필!\\\" (에두르기 후 스스로 목표 낱말을 인출하여 정반응)\\n환자 B: \\\"여, 열, 연빌… 연필.\\\" (음소를 바꾸어 여러 차례 접근하다가 정반응)\\n환자 C: \\\"…\\\" (무반응) → 치료사: \\\"글씨를 쓸 때 사용하는…\\\" → 환자 C: \\\"연필.\\\"\\n※ 세 환자 모두 발화는 유창하고 청각적 이해력은 양호함\",\"q\":\"세 환자의 이름대기 오류 특성과 우선 적용할 중재의 연결로 가장 적절한 것은?\",\"choices\":[\"A: 음소 접근 행동 – 음소 단서 위계 / B: 낱말 인출 지연 – 의미 단서 / C: 인출 실패 – 따라말하기\",\"A: 낱말 인출 지연 – 자기 단서 전략 / B: 음소 접근 행동 – 음운 단서 / C: 인출 실패 – 의미자질분석\",\"A: 인출 실패 – 의미자질분석 / B: 낱말 인출 지연 – 에두르기 / C: 음소 접근 행동 – 음운 단서\",\"A: 의미착어 – 의미자질분석 / B: 신조어 – 따라말하기 / C: 반향어 – 문장 완성 단서\",\"A: 낱말 인출 지연 – 멜로디억양치료 / B: 음소 접근 행동 – 제약유발 언어치료 / C: 인출 실패 – 시각동작치료\"],\"answer\":2,\"explain\":\"A는 에두르기(우회 표현) 후 스스로 목표 낱말에 도달하는 인출 지연으로, 이미 효과적인 에두르기 등 자기 단서 전략을 강화하고 인출 속도를 높이는 접근이 적합하다. B는 음소를 조금씩 바꾸며 목표에 접근하는 음소 접근 행동(conduite d'approche)으로 전도실어증에서 흔하며, 음소 수준의 자기 점검과 음운 단서가 효과적이다. C는 자발 인출은 실패하나 의미 단서(기능 설명)에 즉시 반응하므로 의미망을 활성화하는 의미자질분석이 적합하다. ④는 관찰되지 않은 오류 유형(신조어·반향어)을 기술하였고, ⑤의 치료법들(MIT·CILT·VAT)은 이름대기 오류 유형에 맞춘 중재가 아니다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"25개월 아동의 두 낱말 발화와 산출 맥락\\n㉠ \\\"엄마 신발\\\" – 현관에 놓인 엄마의 구두를 가리키며\\n㉡ \\\"아빠 가\\\" – 아빠가 문을 열고 나가는 것을 보며\\n㉢ \\\"안 먹어\\\" – 숟가락을 밀어내며\\n㉣ \\\"빵 먹어\\\" – 빵을 집어 입에 넣으며\\n㉤ \\\"여기 앉아\\\" – 의자를 두드리며 엄마를 부르며\",\"q\":\"위 발화의 의미관계 분석이 옳은 것은?\",\"choices\":[\"㉠ 행위자–대상\",\"㉡ 소유자–대상\",\"㉢ 행위자–행위\",\"㉣ 대상–행위\",\"㉤ 대상–장소\"],\"answer\":4,\"explain\":\"㉣ '빵 먹어'는 행위의 대상(빵)과 행위(먹어)가 결합한 대상–행위 관계이다. ㉠ '엄마 신발'은 엄마의 신발을 가리키는 소유자–대상(소유), ㉡ '아빠 가'는 행위자–행위, ㉢ '안 먹어'는 부정–행위, ㉤ '여기 앉아'는 장소–행위 관계이다. 의미관계는 발화 형태만이 아니라 산출 맥락(가리키는 대상, 동작)을 근거로 판단해야 한다. ※ 의미관계 범주의 명칭·분류는 교재별로 다를 수 있다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"엄마: 어린이집에서 뭐 했어?\\n아동: 친구랑 블록으로 성 만들었어.\\n엄마: 우와, 누구랑 만들었어?\\n아동: 형아랑 같이 만들었어.\\n엄마: 성 다 만들었어?\\n아동: 선생님이 밥 먹으라고 해서 못 만들었어.\\n엄마: 아이고, 그래서?\\n아동: 내일 또 만들 거야.\",\"q\":\"위 대화에서 아동 발화를 분석한 결과로 옳은 것은? (엄마 발화 제외, 체언에 붙은 조사는 한 낱말로 계산)\",\"choices\":[\"아동의 평균낱말길이는 4.0이다.\",\"부사격 조사를 사용하지 않았다.\",\"인용절을 포함한 복문을 산출하였다.\",\"과거시제 선어말어미 오류가 나타났다.\",\"부정 부사를 사용한 발화가 없었다.\"],\"answer\":3,\"explain\":\"'선생님이 밥 먹으라고 해서 못 만들었어'는 인용절(먹으라고)과 연결어미 '-어서'가 결합된 복문이다. ① 체언에 붙은 조사를 따로 한 낱말로 세면 친구/랑/블록/으로/성/만들었어(6), 형아/랑/같이/만들었어(4), 선생님/이/밥/먹으라고/해서/못/만들었어(7), 내일/또/만들/거/야(5, '거야'는 의존명사 '거'와 서술격조사 '이다'로 나누어 2낱말)로 총 22낱말이고, 발화 수 4이므로 MLU-w는 22÷4=5.5이다. 조사를 앞말에 붙여 어절로 세면 평균어절길이(MLU-c) 17÷4=4.25가 되며, MLU-w와 구별해야 한다. ② '친구랑', '블록으로', '형아랑'에 부사격 조사(공동·도구)가 사용되었다. ④ '만들었어'의 과거시제는 정확하다. ⑤ 부정 부사 '못'이 사용되었다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 1학년 아동의 이야기 산출\\n\\\"곰이 꿀을 먹고 싶어서 나무에 올라갔어요. 그런데 벌들이 나와서 곰을 쏘았어요. 곰은 아파서 울었고 토끼가 약을 발라 주었어요. 곰은 다시는 꿀을 훔치지 않겠다고 약속했어요.\\\"\",\"q\":\"위 이야기의 최소종결단위(T-unit) 수와 T-unit당 평균어절수(MLT-c)는? (대등절은 분리하고 종속절·인용절은 주절에 포함하여 계산)\",\"choices\":[\"4개, 6.0\",\"5개, 4.8\",\"4개, 4.8\",\"5개, 6.0\",\"6개, 4.0\"],\"answer\":2,\"explain\":\"첫째 문장(종속절 '-어서'+주절)=1, 둘째 문장=1, 셋째 문장은 대등 연결어미 '-고'로 이어진 두 절이므로 2, 넷째 문장(인용절 내포)=1 → T-unit 5개. 어절 수는 6+5+7+6=24이므로 MLT-c=24÷5=4.8이다. 대등절을 분리하지 않으면 4개(①·③)로 잘못 세게 된다. ※ 대등절 분리 여부 등 T-unit 산정 기준은 교재별로 차이가 있을 수 있다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 2개월 아동의 표준화 언어검사 결과(평균 100, 표준편차 15)\\n• 수용언어: 표준점수 84, 백분위 14, 등가연령 4;4\\n• 표현언어: 표준점수 68, 백분위 2, 등가연령 3;2\\n• 청력·비언어성 지능: 정상 범위\",\"q\":\"위 결과의 해석으로 가장 적절한 것은?\",\"choices\":[\"표현언어는 −2SD 이하로 유의하게 지체되어 우선 중재 목표가 된다.\",\"수용언어 표준점수 84는 −1SD 이상이므로 수용언어에는 문제가 없다.\",\"등가연령 3;2는 아동의 언어 특성이 3세 2개월 아동과 동일하다는 의미이다.\",\"수용·표현 표준점수 차이 16점은 우연 범위이므로 두 영역에 차이가 없다고 본다.\",\"표현언어 백분위 2는 또래 98%보다 높은 수행 수준을 의미한다.\"],\"answer\":1,\"explain\":\"표현언어 표준점수 68은 z=(68−100)÷15≈−2.1로 −2SD 이하의 유의한 지체이며, 수용언어 84는 z≈−1.07로 −1SD 부근의 경계선 수준이다. 따라서 결함이 뚜렷한 표현언어를 우선 목표로 한다. ② 84는 −1SD(85)보다 낮다. ③ 등가연령은 원점수가 해당 연령 평균과 같다는 뜻일 뿐 언어 특성이 동일함을 의미하지 않는다. ④ 16점은 약 1SD 이상의 차이로 무시할 수 없다. ⑤ 백분위 2는 또래의 2%만이 이 아동보다 낮다는 뜻이다. ※ 지체 판정 절단점(−1SD, −1.25SD, −2SD 등)은 검사·기관별로 다를 수 있다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"6세 아동의 자발화 일부\\n• \\\"놀이터에 친구랑 놀았어요.\\\"\\n• \\\"인형이 상자 안에서 있어요.\\\"\\n• \\\"동생이 의자에서 앉았어요.\\\"\\n• \\\"내가 우유를 다 먹었어요.\\\"\\n• \\\"아빠가 어제 늦게 왔어요.\\\"\",\"q\":\"위 아동에게 우선적으로 중재가 필요한 문법형태소는?\",\"choices\":[\"부사격 조사 '에/에서'의 구분\",\"주격 조사 '이/가'의 산출\",\"목적격 조사 '을/를'의 산출\",\"과거시제 어미 '-었-'의 산출\",\"종결어미 '-어요'의 산출\"],\"answer\":1,\"explain\":\"'놀이터에 놀았어요'(→놀이터에서), '상자 안에서 있어요'(→상자 안에), '의자에서 앉았어요'(→의자에)처럼 처소를 나타내는 부사격 조사 '에'(도착점·정지 위치)와 '에서'(행위가 일어나는 장소)를 서로 바꾸어 쓰는 오류가 일관되게 나타난다. 주격 조사(동생이, 내가, 아빠가), 목적격 조사(우유를), 과거시제(놀았어요, 앉았어요, 왔어요), 종결어미는 모두 정확하게 산출되었다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"4세 6개월 발달성 언어장애 아동의 구조화된 문장 완성 과제에서 문법형태소별 정확률\\n• 주격 조사 '이/가': 92%\\n• 목적격 조사 '을/를': 45%\\n• 과거시제 선어말어미 '-었-': 88%\\n• 연결어미 '-어서': 5%\\n• 관형사형 어미 '-ㄴ/은': 0%\",\"q\":\"중재 효율성을 고려할 때 가장 먼저 목표로 설정할 문법형태소는?\",\"choices\":[\"주격 조사 '이/가'\",\"목적격 조사 '을/를'\",\"과거시제 선어말어미 '-었-'\",\"연결어미 '-어서'\",\"관형사형 어미 '-ㄴ/은'\"],\"answer\":2,\"explain\":\"목표 선택의 일반 원칙은 이미 나타나기 시작했으나 아직 불안정한(출현 단계, 대략 10~50% 수준) 형태를 우선하는 것이다. 목적격 조사(45%)는 출현했으나 숙달되지 않아 중재 효과가 가장 빠르게 나타날 수 있다. 주격 조사와 과거시제는 이미 90% 가까이 숙달되어 목표로 부적절하고, '-어서'(5%)와 관형사형 어미(0%)는 아직 거의 출현하지 않은 형태로 이후 단계에서 다룬다. ※ '출현 단계' 판정 기준(10~50%, 30~60% 등)은 교재별로 다를 수 있다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"7세 자폐스펙트럼장애 아동(표현어휘 약 20개)\\n• 교실에서 쓰기 과제를 제시하면 소리를 지르고 학습지를 던짐\\n• ABC 관찰: 선행사건은 대부분 '어려운 과제 제시', 후속결과는 '교사가 과제를 치우고 아동을 쉬게 함'\\n• 자유놀이 시간에는 문제행동이 거의 나타나지 않음\",\"q\":\"긍정적 행동지원 관점에서 가장 적절한 중재는?\",\"choices\":[\"문제행동이 나타날 때마다 교실 밖 타임아웃을 실시한다.\",\"문제행동을 무시하고 과제를 그대로 계속 제시하여 소거한다.\",\"과제를 끝낼 때마다 좋아하는 간식을 제공하여 과제 수행을 강화한다.\",\"문제행동을 유발하는 쓰기 과제를 교육과정에서 완전히 제외한다.\",\"휴식을 요구하는 카드 사용을 가르치고 과제 난이도를 조정한다.\"],\"answer\":5,\"explain\":\"기능평가 결과 문제행동의 기능은 어려운 과제로부터의 회피(도피)이다. 긍정적 행동지원에서는 같은 기능을 하는 적절한 의사소통 행동('쉬고 싶어요/도와주세요' 카드 등으로 휴식·도움 요구)을 가르치고, 카드를 사용하면 즉시 휴식이나 도움을 제공해 대체하는 기능적 의사소통 훈련과, 선행사건(과제 난이도) 조정을 함께 실시한다. ① 타임아웃은 과제 회피를 오히려 강화한다. ② 대체행동 없는 소거만으로는 문제행동이 일시 증가(소거 폭발)할 수 있고 의사소통 수단을 주지 못한다. ③ 간식 강화는 회피 기능과 무관하다. ④ 과제 제거는 학습 기회를 박탈하고 기능을 다루지 않는다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"4세 발달성 언어장애 아동에게 '햄버거 가게 놀이' 스크립트(주문하기 → 돈 내기 → 햄버거 받기 → 먹기)를 4회기에 걸쳐 익히도록 하였다. 5회기에 치료사(점원)는 돈을 받은 뒤 햄버거를 넣지 않은 빈 쟁반을 아동에게 건넸다. 아동은 \\\"햄버거 없어요. 햄버거 주세요.\\\"라고 말하였다.\",\"q\":\"5회기에 치료사가 사용한 절차와 그 목적으로 옳은 것은?\",\"choices\":[\"스크립트 위반 – 익숙한 사건 순서를 어겨 자발적 요구를 유도한다.\",\"시간지연 – 아동의 발화 뒤에 반응을 지연시켜 발화 길이를 늘린다.\",\"우발교수 – 아동이 먼저 시작한 주제를 따라가며 정교화된 발화를 요구한다.\",\"역할 교대 – 아동이 점원 역할을 맡게 하여 스크립트 어휘를 일반화한다.\",\"스크립트 소거 – 스크립트 단서를 점차 줄여 자연스러운 대화로 전환한다.\"],\"answer\":1,\"explain\":\"스크립트 중재에서 아동이 사건 순서를 충분히 익힌 뒤 예상되는 단계를 빠뜨리거나 잘못 수행하는 '스크립트 위반(사건 방해)'을 도입하면, 아동은 익숙한 맥락 지식을 바탕으로 문제를 지적하고 요구하는 발화를 자발적으로 산출하게 된다. ②는 발화 유도 시 반응을 기다리는 환경중심 기법이고, ③은 아동이 시작한 상호작용에 성인이 반응하는 절차이며, ④·⑤는 스크립트 중재의 다른 단계로 이 장면의 절차가 아니다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"3세 다운증후군 아동\\n• 표현어휘 5개, 언어 이해는 표현보다 상대적으로 양호\\n• 요구는 주로 손잡아 끌기와 소리 내기로 표현\\n• 치료사가 그림상징 의사소통판 도입을 제안하자 어머니가 \\\"그림으로 말하면 아이가 말을 아예 안 배울까 봐 걱정돼요.\\\"라고 함\",\"q\":\"어머니에게 제공할 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"\\\"구어가 나올 때까지 기다렸다가 그래도 안 되면 그때 그림판을 시작하겠습니다.\\\"\",\"\\\"AAC는 구어 발달을 방해하지 않으며, 구어 자극과 함께 병행해서 사용합니다.\\\"\",\"\\\"그림판을 시작하면 구어 중재는 중단하고 상징 사용에만 집중하게 됩니다.\\\"\",\"\\\"AAC는 구어가 전혀 불가능한 아동에게만 적용하므로 이 아동에게는 아직 이릅니다.\\\"\",\"\\\"지적장애 아동은 상징을 이해하기 어려우므로 AAC보다 구어 모방 훈련이 우선입니다.\\\"\"],\"answer\":2,\"explain\":\"AAC가 구어 발달을 저해한다는 것은 대표적인 오해이며, 연구들은 AAC 사용이 구어 산출을 감소시키지 않고 오히려 증가시키는 경향을 보고한다. AAC는 구어 자극과 병행(다중양식)하며, 의사소통 의도가 있으나 표현 수단이 부족한 아동에게 조기에 도입해 좌절과 문제행동을 줄이고 언어 발달을 지원한다. ①·④는 도입 시기를 부당하게 늦추고, ③은 구어 중재 중단이 옳지 않으며, ⑤는 지적장애 아동도 실물·사진 등 투명도 높은 상징부터 단계적으로 사용할 수 있으므로 틀렸다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 인공와우 착용 아동(착용 2년, 인공와우 착용 역치 25dB HL)\\n• 수용·표현 어휘: 또래 범위\\n• 자발화: \\\"엄마 회사 가\\\", \\\"어제 놀이터 놀아\\\", \\\"형 과자 먹어\\\"처럼 조사와 과거시제 선어말어미가 대부분 생략됨\\n• 내용어는 비교적 정확하게 산출함\",\"q\":\"이 아동의 문법형태소 습득을 촉진하기 위한 중재 전략으로 가장 적절한 것은?\",\"choices\":[\"의미 이해가 우선이므로 어휘 확장 활동에 집중한다.\",\"입 모양을 크게 보여 주는 독화 훈련으로 형태소를 지도한다.\",\"조음 정확도 훈련을 통해 어미 산출을 유도한다.\",\"청각적 강조 기법으로 조사·어미를 두드러지게 들려준다.\",\"구어 대신 수어를 도입하여 문법 표지를 시각적으로 제시한다.\"],\"answer\":4,\"explain\":\"조사와 선어말어미는 짧고 강세가 약해 음향적으로 두드러지지 않는 요소로, 청각장애 아동이 놓치기 쉽다. 청각적 강조(acoustic highlighting)는 목표 형태소를 약간 크고 느리게, 문장 끝이나 앞에 두어 두드러지게 들려준 뒤 점차 자연스러운 강도로 되돌리는 청각구어 기법이다. 착용 역치가 어음역을 충분히 포함하고 어휘가 또래 수준이므로 ①은 초점이 어긋나고, ②·⑤는 청각 활용을 우선하는 아동에게 시각 양식을 앞세우는 것이며, ③은 조음이 아닌 형태소 사용의 문제이므로 부적절하다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 1학년 양측 중등도 감각신경성 난청 아동(보청기 착용)\\n• 조용한 방에서 어음 인지 정확도 90%\\n• 소음 상황(신호대잡음비 +5dB) 어음 인지 정확도 40%\\n• 담임교사 보고: 수업 중 지시를 자주 놓치고 되묻는 일이 많음\\n• 어휘·구문은 또래 범위\",\"q\":\"이 아동에게 가장 우선적으로 권고할 조치는?\",\"choices\":[\"교사가 원격 마이크 송신기를 착용하여 수업한다.\",\"수어를 병행하는 이중양식 의사소통으로 전환한다.\",\"보청기 대신 인공와우 이식 수술을 의뢰한다.\",\"개별 언어치료 회기를 주 1회에서 주 3회로 늘린다.\",\"소음 속 듣기 훈련 전까지 통합학급 수업을 보류한다.\"],\"answer\":1,\"explain\":\"조용한 곳에서는 양호하지만 소음에서 어음 인지가 급격히 떨어지는 양상은 교실 소음·거리·반향의 영향을 시사한다. 원격 마이크 시스템은 교사의 음성을 아동 보청기로 직접 전달해 신호대잡음비를 개선하는 가장 직접적인 교육적 지원이다. ② 어휘·구문이 또래 수준이고 청각 활용이 양호하므로 수어 전환의 근거가 없다. ③ 중등도 난청은 보청기 적용 대상이며 인공와우 적응증이 아니다. ④ 언어 능력은 정상 범위이므로 치료 빈도 증가가 핵심 해결책이 아니다. ⑤ 수업 배제는 부적절하다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"17세 중등도 지적장애 학생(특수학급)\\n• 언어 능력은 대략 5세 수준, 2~3어절 단문으로 의사소통\\n• 졸업 후 지역 보호작업장 취업 예정\\n• 낯선 사람에게 도움을 요청하지 못하고, 작업 지시를 이해하지 못해도 아는 척하고 넘어감\",\"q\":\"이 학생의 언어 중재 목표로 가장 적절한 것은?\",\"choices\":[\"언어연령에 맞는 그림책으로 어휘를 확장한다.\",\"복문 산출과 문법형태소 정확도를 높인다.\",\"도움 요청과 지시 확인하기를 작업 현장에서 교수한다.\",\"음운인식과 낱말 해독 훈련으로 읽기를 지도한다.\",\"표준화 언어검사를 반복하여 언어연령 향상을 확인한다.\"],\"answer\":3,\"explain\":\"전환기 지적장애 청소년의 중재는 생활연령과 미래 환경(직장·지역사회)의 요구에 맞춘 기능적 의사소통에 초점을 두며, 일반화를 위해 실제 또는 유사 환경에서 교수한다. 특히 '모르면 다시 묻기', '도움 요청하기'는 안전과 직무 수행에 직결되는 기술이다. ①·②·④는 언어연령 중심의 발달적 목표로 생활연령·환경 요구와 맞지 않고, ⑤는 평가일 뿐 중재 목표가 아니다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"3세 6개월 아동\\n• 출생 시부터 어머니는 한국어, 아버지는 영어로 대화(동시적 이중언어)\\n• 한국어 표현어휘 검사: 12%ile / 영어 표현어휘 검사: 15%ile\\n• 두 언어 어휘를 합산하고 번역 등가어(같은 뜻의 두 낱말)는 하나로 세는 개념적 어휘 점수: 또래 단일언어 아동 평균 범위\\n• 두 언어의 이해 모두 양호, \\\"엄마, water 줘\\\"와 같은 혼용 발화가 자주 나타남\",\"q\":\"이 결과에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"한국어 어휘가 12%ile이므로 표현어휘 지체로 진단하고 어휘 중재를 시작한다.\",\"혼용 발화는 언어 혼란의 징후이므로 가정에서 한 언어만 사용하도록 권고한다.\",\"동시적 이중언어 아동이므로 단일언어 규준을 그대로 적용해 각 언어를 판정한다.\",\"개념적 어휘와 이해가 정상 범위이므로 전형적인 이중언어 발달로 본다.\",\"두 언어 모두 20%ile 미만이므로 두 언어에서 동시에 지체된 발달성 언어장애이다.\"],\"answer\":4,\"explain\":\"이중언어 아동은 어휘가 두 언어에 분산되므로 한 언어만 단일언어 규준과 비교하면 지체로 오판되기 쉽다. 번역 등가어를 하나로 세는 개념적 채점에서 정상 범위이고 이해력이 양호하면 전형적인 이중언어 발달로 본다. 코드 혼용(부호 혼용)은 이중언어 아동의 정상적이고 규칙적인 현상이며(②), 언어장애라면 두 언어 모두에서 개념적 어휘를 포함한 전반적 결함이 나타난다(⑤). ①·③은 단일언어 규준을 한 언어에만 적용하는 오류이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 2학년 2학기 아동의 읽기 평가 결과\\n• 자소–음소 대응 지식: 95% / 규칙 낱말 읽기 정확도: 92% / 비단어 읽기 정확도: 85%\\n• 1분당 정확하게 읽은 어절 수: 학년 규준 −2SD\\n• 글 읽기 이해: 학년 규준 −1.5SD / 듣기 이해: 정상 범위\\n• 관찰: 한 글자씩 끊어 읽으며 음운변동 낱말(예: '국물', '읽고')에서 머뭇거림\",\"q\":\"이 아동에게 가장 우선적으로 실시할 읽기 중재는?\",\"choices\":[\"음절·음소 수준의 음운인식 훈련\",\"총체적 언어 접근의 이야기책 통독\",\"반복 읽기 중심의 읽기 유창성 중재\",\"읽기이해 전략(예측·요약) 교수\",\"자소–음소 대응의 체계적 재교수\"],\"answer\":3,\"explain\":\"해독 정확도는 확립되었으나(규칙 낱말 92%, 비단어 85%) 읽기 속도가 −2SD로 현저히 느리고 한 글자씩 읽는 양상은 해독의 자동화(유창성) 부족이며, 듣기 이해가 정상인 점으로 보아 읽기 이해 저하는 느린 해독의 결과이다. 따라서 반복 읽기·짝 읽기와 음운변동 낱말 자동화로 유창성을 높이는 것이 우선이다. ①·⑤는 이미 확립된 기초 기술의 중복 훈련이고, ②는 해독 결함 아동에게 근거가 약하며, ④는 유창성이 확보된 뒤 병행할 목표이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 5학년 아동\\n• 문장 수준 쓰기: 문법·철자 오류 거의 없음, 어휘 또래 범위\\n• '우리 학교 소개하기' 글쓰기: 계획 없이 바로 쓰기 시작하여 떠오르는 문장을 나열, 문단 구분·주제문 없음, 다 쓴 뒤 다시 읽지 않음\\n• 읽기 이해: 정상 범위\",\"q\":\"이 아동에게 가장 적절한 쓰기 중재는?\",\"choices\":[\"받아쓰기 훈련을 통해 문장 정확도를 높인다.\",\"철자 규칙을 지도하여 맞춤법 오류를 줄인다.\",\"두 문장을 하나로 합치는 문장 결합 훈련을 실시한다.\",\"학습 어휘를 확장하여 다양한 낱말을 사용하게 한다.\",\"그래픽 조직자로 글의 계획·수정 전략을 지도한다.\"],\"answer\":5,\"explain\":\"문장 수준의 형식(문법·철자·어휘)은 양호하나 글 수준의 계획·조직·점검이 부재한 아동이므로, 쓰기 과정(계획–작성–수정) 전략과 그래픽 조직자(생각 그물, 개요표)를 활용한 담화 구조 지도가 적절하다. ①~④는 이미 또래 수준인 낱말·문장 단위의 기술을 반복하는 것으로 아동의 핵심 결함(텍스트 조직·자기 점검)을 다루지 못한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 4학년 아동\\n• 어휘·구문·읽기 해독·읽기 유창성: 또래 범위\\n• 글에 직접 나온 사실을 묻는 질문(누가, 어디서, 무엇을)에는 대부분 정확히 답함\\n• \\\"민수는 펼친 우산을 현관에 세워 두고 젖은 양말부터 벗었다.\\\"를 읽은 뒤 \\\"밖의 날씨는 어땠을까?\\\"라는 질문에 \\\"글에 안 나와 있어요.\\\"라고 답함\\n• 사건의 원인이나 이어질 결과를 묻는 질문에서 오답이 많음\",\"q\":\"이 아동에게 가장 적절한 중재 활동은?\",\"choices\":[\"글 속 단서와 배경지식을 연결해 숨은 내용을 추론하고 근거를 말하게 한다.\",\"글을 읽은 뒤 누가·언제·어디서를 묻는 사실 확인 질문에 답하는 연습을 반복한다.\",\"같은 글을 소리 내어 여러 번 반복해 읽게 하여 읽기 속도를 높인다.\",\"글에 나온 낱말의 사전적 정의를 찾아 쓰게 하여 어휘 지식을 늘린다.\",\"이야기를 들은 순서대로 다시 말하게 하여 사건 순서 기억을 강화한다.\"],\"answer\":1,\"explain\":\"글에 명시된 사실의 이해는 양호하나, 글 속 단서(펼친 우산, 젖은 양말)와 배경지식을 연결해야 알 수 있는 내용(비가 왔다)이나 사건의 원인·결과를 파악하지 못하는 것은 추론적 이해의 결함이다. 효과적인 중재는 글에서 단서를 찾아 표시하고, 관련 배경지식을 떠올려 연결한 뒤, 추론한 내용과 그 근거를 말로 설명하게 하는 것이다(예: 질문-대답 관계 전략의 '생각하고 찾기' 질문, 소리 내어 생각하기 시범). ② 사실적 이해는 이미 양호하고, ③ 해독·유창성과 ④ 어휘는 또래 범위이므로 초점이 어긋난다. ⑤ 순서대로 다시 말하기는 글에 나온 내용의 회상에 머물러 추론 결함을 직접 다루지 못한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"26개월 아동\\n• 표현어휘 8개, 언어 이해도 또래보다 지체\\n• 놀이 관찰: 블록을 두드리거나 던지고, 자동차 바퀴를 돌리며 봄. 컵을 입에 대는 척하기, 인형에게 밥 먹이기 등은 관찰되지 않음\\n• 성인의 동작 모방은 가끔 나타남\",\"q\":\"이 아동의 놀이 수준을 고려한 중재 방향으로 가장 적절한 것은?\",\"choices\":[\"상징놀이가 가능한 수준이므로 역할놀이 대본을 이용해 대화를 지도한다.\",\"사물의 기능적 놀이를 모델링하고 그 행동에 낱말을 짝지어 준다.\",\"놀이는 언어와 무관하므로 낱말 따라 말하기 훈련에 집중한다.\",\"규칙이 있는 보드게임을 통해 차례 지키기를 지도한다.\",\"또래와의 협동 놀이를 우선 목표로 하여 집단 활동에 참여시킨다.\"],\"answer\":2,\"explain\":\"두드리기·던지기·바퀴 돌리기는 감각운동적 탐색 놀이로, 26개월에 기대되는 초기 상징놀이(자기 중심 가상행동)가 나타나지 않는다. 상징놀이는 표상 능력을 반영하여 초기 낱말 발달과 밀접히 관련되므로, 사물의 기능적 사용과 자기 중심 가상놀이를 모델링하고 그 행동에 언어를 연결하는 것이 적절하다. ①·④·⑤는 아동의 현재 놀이 수준을 크게 넘어서는 목표이고, ③은 놀이(표상)와 언어의 관계를 무시한 접근이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"30개월 아동의 20분 자유놀이 표본에서 관찰된 의사소통 행위\\n• 총 100회(몸짓·발성·낱말 포함)\\n• 기능별 빈도: 물건 요구 60회, 행동 요구 25회, 거부 12회, 언급(사물 보여주기·가리키며 이름 말하기) 3회, 정보 요구 0회\",\"q\":\"이 결과의 해석과 우선 중재 목표로 가장 적절한 것은?\",\"choices\":[\"의사소통 빈도가 매우 낮으므로 전체 빈도 증가를 우선 목표로 한다.\",\"요구하기가 가장 많으므로 요구 발화를 3어절로 늘린다.\",\"거부하기 빈도가 낮으므로 거부 표현을 우선 지도한다.\",\"정보 요구가 없으므로 의문사 질문하기를 우선 목표로 한다.\",\"기능이 요구에 편중되어 있으므로 언급 기능 확대를 우선한다.\"],\"answer\":5,\"explain\":\"분당 5회의 의사소통 빈도는 이 연령대 기대 수준(여러 낱말 단계 약 분당 5회)으로 부족하지 않으나, 100회 중 85회(85%)가 행동 조절(요구) 기능이고 사회적 상호작용·공동주의 기능(언급·보여주기)이 거의 없어 기능 분포가 편중되어 있다. 언급하기와 공동주의는 어휘·사회적 의사소통 발달의 토대이므로 우선 목표가 된다. ① 빈도는 낮지 않다. ②는 이미 우세한 기능의 정교화, ③은 이미 나타나는 기능이며, ④ 의문사 질문은 언급·공동주의 기능이 확립된 이후에 기대되는 발달 순서상 뒤의 목표이다. ※ 연령별 의사소통 빈도 기준치는 자료마다 차이가 있다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 2학년 자폐스펙트럼장애 아동\\n• 언어성 지능 정상, 어휘·구문 또래 범위\\n• 친구가 넘어진 뒤 \\\"아, 진짜 좋다.\\\"라고 말하자 정말 좋아하는 줄 알고 웃음\\n• 틀린 믿음 과제(위치 바꾸기)에서 \\\"원래 있던 데를 찾는다\\\"고 답하지 못하고 실제 위치를 말함\\n• 이야기 속 인물이 왜 화가 났는지 설명하지 못함\",\"q\":\"이 아동에게 가장 적절한 중재는?\",\"choices\":[\"복문 산출 훈련으로 구문 복잡성을 높인다.\",\"비디오 자기모델링으로 인사하기 행동을 습득시킨다.\",\"생각 풍선으로 인물의 생각과 감정을 추론하게 한다.\",\"음운인식 훈련으로 읽기 기초를 다진다.\",\"감정 어휘 목록을 정의와 함께 암기하도록 한다.\"],\"answer\":3,\"explain\":\"틀린 믿음 과제 실패, 반어 이해 실패, 인물의 정서 원인 추론 실패는 타인의 마음 상태를 표상하는 마음이론 결함을 반영한다. 생각 풍선, 만화 대화 등 시각적 지원을 활용해 인물의 생각·믿음·감정과 화자의 의도를 명시적으로 추론하게 하는 중재가 적절하다. ①·④는 이미 양호한 영역이고, ②는 특정 행동 습득에 유용하나 마음 상태 추론을 다루지 못하며, ⑤ 감정 어휘 암기만으로는 맥락에서 상대의 마음을 추론하는 능력이 길러지지 않는다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"18개월 아동의 발달 선별 결과\\n• 표현 낱말 0개, 옹알이는 있으나 자음 종류가 적음\\n• 원하는 것을 가리키지 않고 관심 있는 것을 보여 주지 않음\\n• 이름을 불러도 반응이 드물고 눈맞춤이 짧음\\n• 신생아 청력 선별 통과, 최근 청력 재검사도 정상\\n• 운동 발달은 정상\",\"q\":\"이 아동에 대한 조치로 가장 적절한 것은?\",\"choices\":[\"늦게 말하는 아동으로 보고 6개월 후 재평가까지 추적 관찰만 한다.\",\"24개월까지는 개인차가 크므로 그때 다시 검사하도록 안내한다.\",\"낱말 모방을 목표로 한 개별시도 훈련을 즉시 시작한다.\",\"청력이 정상이므로 언어 문제가 아니라고 안심시킨다.\",\"자폐 선별검사를 의뢰하고 부모 매개 중재를 바로 시작한다.\"],\"answer\":5,\"explain\":\"18개월에 가리키기·보여주기 부재, 이름 반응 저하, 눈맞춤 부족은 낱말 지체와 함께 나타날 때 자폐스펙트럼장애의 조기 위험 신호(red flags)이므로 선별검사와 종합 평가를 지체 없이 의뢰해야 한다. 진단 확정을 기다리지 않고 공동주의·사회적 상호작용을 표적으로 하는 부모 매개 조기 중재를 병행하는 것이 권장된다. ①·②는 사회적 의사소통 위험 신호를 간과한 것이고, ③은 전제 기술(공동주의·모방)이 없는 상태에서 낱말 모방을 앞세우는 것이며, ④ 청력 정상은 원인 하나를 배제할 뿐 문제가 없음을 의미하지 않는다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"언어 중재의 행동 목표로 가장 적절하게 진술된 것은?\",\"choices\":[\"아동은 간식 시간에 요구하기를 잘하게 된다.\",\"간식 시간에 아동은 2어절 요구를 80% 이상 산출한다.\",\"아동의 어휘력과 의사소통 능력을 향상시킨다.\",\"치료사는 아동이 요구할 때마다 원하는 간식을 제공한다.\",\"아동은 두 낱말로 요구하는 것이 필요함을 이해한다.\"],\"answer\":2,\"explain\":\"행동 목표는 조건(어떤 상황·자극에서), 관찰 가능한 행동(무엇을 산출하는가), 준거(어느 수준까지)의 세 요소를 구체적으로 포함해야 측정과 진전 평가가 가능하다. ②는 조건(간식 시간), 행동(2어절 요구 산출), 준거(80% 이상)를 모두 갖추었다. ①·③은 관찰·측정할 수 없는 모호한 진술이고(①은 상황이 제시되었으나 행동과 준거가 불명확하다), ④는 아동이 아닌 치료사의 행동이며, ⑤는 '이해한다'가 직접 관찰 가능한 행동이 아니다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 4학년 언어학습장애 아동의 담임교사가 사회 교과 '옛날과 오늘날의 생활 도구' 단원 지문을 보내며, 제한된 회기 안에 어떤 낱말을 가르쳐야 할지 문의하였다. 지문에는 다음 낱말들이 포함되어 있다.\\n밥, 집, 사람 / 변화, 영향, 비교하다, 발달하다, 원인 / 맷돌, 다듬잇돌, 절구\",\"q\":\"교과 학습 전반에 대한 효과를 고려할 때 우선적으로 지도할 어휘군과 그 근거로 옳은 것은?\",\"choices\":[\"밥·집·사람 – 고빈도 기본 어휘이므로 정확한 이해가 최우선이다.\",\"맷돌·다듬잇돌·절구 – 단원 내용 이해에 직접 필요한 전문 어휘이다.\",\"변화·영향·비교하다·발달하다·원인 – 교과 공통 학습 어휘이다.\",\"아동이 이미 아는 낱말 – 반복 노출로 인출 자동화를 높인다.\",\"지문 속 관용어와 속담 – 비유언어 이해가 학습의 핵심이다.\"],\"answer\":3,\"explain\":\"어휘 선정의 3층위 틀에서 '변화, 영향, 비교하다, 원인' 같은 2층위(Tier 2) 어휘는 일상 대화보다 학습 상황에서 여러 교과와 텍스트에 걸쳐 반복 등장하므로 제한된 회기에 가르칠 때 학업 전반에 대한 전이 효과가 가장 크다. 1층위(밥·집·사람)는 대부분 이미 습득된 기본 어휘이고, 3층위(맷돌·절구)는 특정 단원에만 국한된 저빈도 전문 어휘로 교과 수업에서 다루는 것이 효율적이다. ④는 새로운 학습이 없고, ⑤는 지문에 제시된 낱말군이 아니다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"5세 여아, 유치원 교사가 '언어장애 의심'으로 의뢰\\n• 유치원 입학 후 8개월째 교사·또래에게 말을 전혀 하지 않고 고개 끄덕임으로만 반응\\n• 어머니가 제공한 가정 녹음: 복문 산출, 어휘·발음 연령 적절, 동생과 활발히 대화\\n• 치료실 첫 방문 시 표준화 표현언어 검사에서 무반응으로 원점수 0\\n• 낯선 사람 앞에서 몸이 굳고, 상동행동·제한된 관심사는 없음\",\"q\":\"이 아동에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"검사 결과 원점수 0이므로 −2SD 이하의 심한 표현언어 지체로 진단한다.\",\"발달성 언어장애로 판단하고 표현언어 중재를 시작한다.\",\"유치원에서 말할 때까지 발화를 강하게 요구하는 훈련을 실시한다.\",\"선택적 함구증을 의심하여 전문가와 협력하고 점진적 노출을 계획한다.\",\"눈맞춤 회피와 무발화를 근거로 자폐스펙트럼장애 평가를 우선 의뢰한다.\"],\"answer\":4,\"explain\":\"특정 사회적 상황(유치원)에서만 지속적으로 말하지 않고 다른 상황(가정)에서는 연령 적절한 언어를 사용하는 양상은 언어 능력의 결함이 아니라 불안 관련 장애인 선택적 함구증의 특징이다. 이 경우 정신건강 전문가와 협력하여 자극 용암법, 점진적 노출 등 불안을 낮추는 행동적 접근을 적용하고 언어재활사는 말하기를 강요하지 않는다. ①·②는 가정 자료와 모순되는 검사 결과를 그대로 해석한 오류이며, ③ 압박은 불안을 높여 증상을 악화시키고, ⑤는 상동행동·제한된 관심사가 없고 가정에서 상호작용이 활발하므로 근거가 부족하다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 3학년 아동의 그림책 이야기 다시 말하기 평가 결과이다. 어휘·구문·읽기 해독은 또래 범위이며, 아동은 이야기할 때 \\\"그 사람이 그거를 했어요. 그리고 갔어요.\\\"처럼 말해 듣는 사람이 누구·무엇을 가리키는지 되묻는 일이 잦다.\\n\\n〈이야기 다시 말하기 평가 기록〉\\n평가 영역 | 아동 점수 | 또래 평균(표준편차)\\n이야기 문법 요소 회상률 | 78% | 74%(13)\\n완전한 일화 수 | 3개 | 2.9개(1.0)\\n결속표지 정확률 | 52% | 88%(15)\\n지시 대용어 적절 사용률 | 48% | 82%(16)\\nT-unit당 비유창성률 | 4% | 4%(2)\\n문법형태소 오류율 | 1.2% | 1.6%(2.0)\",\"q\":\"위 결과에 근거한 중재 방향으로 가장 적절한 것은?\",\"choices\":[\"계기사건–시도–결과를 갖춘 완전한 일화 구성을 지도한다.\",\"조사·어미의 정확한 산출에 초점을 둔 문법형태소 중재를 실시한다.\",\"이야기 산출 시 반복·수정 등 비유창성을 줄이는 중재를 실시한다.\",\"문장을 잇는 접속 표현과 지시어를 명확히 쓰도록 지도한다.\",\"T-unit 길이를 늘리기 위해 문장 확장 훈련을 실시한다.\"],\"answer\":4,\"explain\":\"각 영역의 z점수를 구하면 이야기 문법 요소 회상률 (78−74)÷13 ≈ +0.3, 완전한 일화 수 (3−2.9)÷1.0 = +0.1, 결속표지 정확률 (52−88)÷15 = −2.4, 지시 대용어 적절 사용률 (48−82)÷16 ≈ −2.1, 비유창성률 (4−4)÷2 = 0.0, 문법형태소 오류율 (1.2−1.6)÷2.0 = −0.2(오류율은 평균보다 낮을수록 양호)이다. 결속표지 정확률과 지시 대용어 적절 사용률만 −2SD 미만이고 나머지는 평균 범위이다. 즉 이야기의 거시구조(사건 구성)는 갖추었으나 문장·명제를 이어 주고 지시 대상을 명확히 하는 미시구조(결속)가 약하므로, 접속·연결 표지와 대용어의 적절한 사용을 목표로 하는 결속표지 중재가 우선이다. \\\"그 사람이 그거를\\\"처럼 지시 대상이 불분명한 발화도 이를 뒷받침한다. ①·②·③은 표에서 평균 범위인 영역을 목표로 한 것이고, ⑤ T-unit 길이는 표에 제시되지 않았으며 구문이 또래 범위이므로 우선 목표가 아니다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"치료사: 주말에 뭐 했어요?\\n대상자: 저는 저는 음 (쉼) 가족이랑 ㅂㅂㅂ백화점에 갔어요. 거기서 거기서 시---계를 샀어요. (막힘)기분이 좋았어요.\\n\\na. 저는 저는   b. 음 (쉼)   c. ㅂㅂㅂ백화점   d. 거기서 거기서   e. 시---계   f. (막힘)기분\",\"q\":\"EXPLAN 모델에서 계획이 완성되기 전에 낱말 산출을 시작하는 '진행(advancing)' 유형으로 설명되는 비유창성만 묶인 것은?\",\"choices\":[\"a, b, d\",\"a, c, e\",\"c, e, f\",\"b, d, f\",\"c, d, e\"],\"answer\":3,\"explain\":\"EXPLAN 모델(Howell)은 언어 계획(PLAN)과 실행(EX)의 비동시성으로 비유창성을 설명한다. 다음 낱말의 계획이 준비되지 않았을 때 화자가 (1) 앞선 낱말·구를 반복하거나 쉼·간투사로 시간을 버는 '지연(stalling)'을 택하면 낱말전체 반복·구 반복·간투사·쉼이 나타나고, (2) 불완전한 계획으로 낱말 산출을 시작하는 '진행(advancing)'을 택하면 낱말의 일부만 산출되어 음소·음절 반복, 연장, 막힘이 나타난다. 따라서 c(음소 반복), e(연장), f(막힘)이 진행 유형이다. a(낱말전체 반복), b(간투사·쉼), d(구 반복)은 지연 유형으로, 어린 아동의 비유창성과 회복군에서 우세하다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인에 관한 연구 결과\\n• 말 산출 시 우반구 운동·전운동 영역의 과활성과 좌반구 청각 영역의 활성 저하\\n• 좌측 하전두회 아래 백질(궁상다발) 완전성 저하\\n• 도파민 D2 수용체 길항제 투여 후 말더듬 감소, 도파민 작용제 투여 후 악화 보고\\n• 일란성 쌍생아의 말더듬 일치율이 이란성보다 높음\",\"q\":\"위 결과들을 통합적으로 설명하는 진술로 옳은 것은?\",\"choices\":[\"부모가 정상적 비유창성을 말더듬으로 잘못 진단해 반응함으로써 학습된 행동이다.\",\"좌반구 말운동 신경망 취약성과 기저핵-도파민 타이밍 문제에 유전적 소인이 관여한다.\",\"우반구 과활성이 말더듬의 일차 원인이므로 우반구 활성을 억제하는 훈련이 근본 치료가 된다.\",\"도파민 결핍이 일차 원인이므로 도파민 작용제가 우선적인 약물 치료제로 권고된다.\",\"조음 실행에는 문제가 없고 음운 부호화의 사후 점검 과정에서만 문제가 생긴다.\"],\"answer\":2,\"explain\":\"제시된 영상·백질·약물·유전 자료는 신경생리학적 모델의 근거다. 좌반구 언어-운동 신경망(하전두회, 궁상다발)의 취약성, 기저핵-시상-피질 회로의 도파민 과활성으로 인한 말운동 타이밍 문제, 유전적 소인이 함께 작용한다고 본다. ①은 진단착오이론, ⑤는 내적수정가설의 설명이다. ③ 우반구 과활성은 좌반구 결함에 대한 보상적 활성으로 해석되므로 억제 훈련이 근본 치료라는 주장은 틀리다. ④ 도파민 작용제는 오히려 악화시키며, 감소 효과가 보고된 것은 길항제이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 5세 4개월 여아\\n• 6개월 전 큰 개에게 쫓겨 크게 놀란 사건 직후 말더듬이 갑자기 시작됨\\n• 그 이전 말·언어발달 정상, 가족력 없음\\n• 주 비유창성: 긴장된 막힘, 후두 부위 긴장과 숨 참기 동반\\n• 말하기를 두려워하며 \\\"말이 안 나와\\\"라고 울음\",\"q\":\"Van Riper의 말더듬 발달 경로(track) 중 이 아동에 해당하는 경로와 그 특징으로 옳은 것은?\",\"choices\":[\"경로 I – 점진적 시작, 긴장 없는 음절 반복, 말더듬에 대한 인식 없음\",\"경로 II – 언어발달 지연 동반, 빠르고 불규칙한 말, 속화와 유사한 양상\",\"경로 IV – 늦은 시작, 의도적이고 고정된 형태의 반복, 회피 없음\",\"경로 III – 외상 후 갑작스러운 시작, 긴장된 막힘, 높은 인식과 공포\",\"경로 II – 갑작스러운 시작, 긴장 없는 연장 위주, 말더듬에 대한 인식 없음\"],\"answer\":4,\"explain\":\"Van Riper의 경로 III은 놀람·외상 사건 후 갑작스럽게 시작되며, 처음부터 긴장된 막힘·후두 긴장·숨 참기가 나타나고 아동이 말더듬을 뚜렷이 인식해 공포와 회피가 빠르게 발달하는 것이 특징이다. 경로 I은 가장 흔한 형태로 점진적 시작과 쉬운 반복, 경로 II는 언어발달 지연과 속화 유사 양상, 경로 IV는 늦은 시작과 의도적·상동적 반복 및 회피 결여가 특징이다. ⑤는 경로 II의 특징을 잘못 기술한 것이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"[그림 1]은 초등학교 2학년 아동이 \\\"우리 반은 금요일에 미술관으로 견학을 갔는데 거기서 커다란 공룡 뼈를 봤어요.\\\"라고 말한 발화를 전사한 것이다. 목표 음절 수는 반복·연장 등 비유창 부분을 제외한 의도한 발화의 음절 수로 산정한다.\",\"q\":\"[그림 1]의 비유창성 분석으로 옳은 것은?\",\"choices\":[\"발화의 목표 음절 수는 41음절이다.\",\"단어부분 반복은 모두 3회 나타났다.\",\"반복의 평균 단위반복수는 1.8회이다.\",\"비운율적 발성은 모두 2회 나타났다.\",\"100음절당 진성 비유창성은 20회이다.\"],\"answer\":3,\"explain\":\"목표 발화 '우리 반은 금요일에 미술관으로 견학을 갔는데 거기서 커다란 공룡 뼈를 봤어요'는 2+2+4+5+3+3+3+3+2+2+3 = 32음절이다(①은 '---' 칸을 뺀 전체 칸 수 41과 혼동한 것). 단어부분 반복은 우우우리(단위 2), 금금요일(1), 거거거거기서(3), ㅋㅋ커다란(음소 반복, 단위 2), 봤봤어요(1)로 5회이며, 음소 반복 'ㅋㅋ커'를 따로 분류하더라도 4회이므로 ②의 3회는 오답이다, 총 단위반복수 2+1+3+2+1 = 9회 ÷ 5회 = 평균 단위반복수 1.8회로 ③이 옳다. 비운율적 발성은 연장 1회(미---)와 막힘 2회(견, 공)로 3회이다(④ 오답). 진성 비유창성은 5+3 = 8회이므로 100음절당 8/32×100 = 25회이다(⑤ 오답). 부수행동은 눈 깜박임 1회로 핵심행동 계산에 포함하지 않는다.\",\"image\":\"data:image/svg+xml;base64,\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"치료사: 요즘 회사 생활은 어때요?\\n대상자: (목청 가다듬기) 요즘 ㅂㅂ바쁜 편이에요.\\n치료사: 주로 어떤 일을 하세요?\\n대상자: (목청 가다듬기) 보고… (고개를 옆으로 홱 돌리며)보고서 쓰는 일이요.\\n치료사: 회의도 자주 있나요?\\n대상자: 있잖아요, 회의는 팀장님이 (3초 쉼)진행하세요. 저는 ㅍㅍ (손으로 책상을 치며)프레젠테이션… 아니 발표 자료만 만들어요.\\n치료사: 발표는 직접 하시나요?\\n대상자: (목청 가다듬기) 웬만하면 동료한테 부탁해요.\",\"q\":\"위 대화에서 가장 많이 나타난 이차행동(부수행동)은?\",\"choices\":[\"시작행동\",\"연기책\",\"도피(탈출)행동\",\"대용어 사용하기\",\"상황 회피\"],\"answer\":1,\"explain\":\"시작행동(starter)은 말을 시작하기 위해 덧붙이는 소리·말·동작으로, 목청 가다듬기 3회와 '있잖아요' 1회, 총 4회로 가장 많다. 도피(탈출)행동은 막힘에서 빠져나오기 위한 고개 돌리기·책상 치기 2회, 연기책(postponement)은 어려운 낱말 앞의 3초 쉼 1회, 대용어 사용은 '프레젠테이션'을 '발표 자료'로 바꾼 1회, 상황 회피는 발표를 동료에게 부탁하는 1회이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"성인 대상자의 발화\\n\\\"저는 (막힘)주말에 어 동생이랑 ㅈㅈㅈ자전거를 타고 하---ㄴ강에 갔다가 갔다가 라면을 먹었어요.\\\"\\n(총 발화 시간: 12초, 말속도는 목표 음절 수 기준으로 산출)\",\"q\":\"위 발화의 분석 내용으로 옳은 것은?\",\"choices\":[\"기타 비유창성은 3회이고 진성 비유창성은 3회이다.\",\"진성 비유창성은 4회이고 기타 비유창성은 2회이다.\",\"말속도는 140 SPM이고 %SS는 약 7.1이다.\",\"말속도는 120 SPM이고 %SS는 약 10.7이다.\",\"말속도는 140 SPM이고 %SS는 약 10.7이다.\"],\"answer\":5,\"explain\":\"목표 발화 '저는 주말에 동생이랑 자전거를 타고 한강에 갔다가 라면을 먹었어요'는 2+3+4+4+2+3+3+3+4 = 28음절이다. 말속도는 28음절 ÷ 12초 × 60 = 140 SPM이다(④ 오답). 말더듬이 나타난 음절은 막힘(주), 음소 반복(자), 연장(하) 3음절이므로 %SS = 3/28 × 100 ≈ 10.7이다(③은 2/28로 잘못 계산한 값). 진성 비유창성은 막힘·음소 반복·연장 3회(② 오답), 기타 비유창성은 간투사 '어'와 구 반복 '갔다가 갔다가' 2회이다(① 오답).\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"4세 아동의 발화 (밑줄은 각 기호가 가리키는 구간)\\n\\\"__엄마가 엄마가(a)__ 어제 __음(b)__ __시---장에서(c)__ __귤을, 아니 사과를(d)__ __사 사 사 왔는데(e)__ __(막힘)너무(f)__ 맛있었어요.\\\"\",\"q\":\"위 발화에서 기타(정상적) 비유창성에 해당하는 것만 묶인 것은?\",\"choices\":[\"a, b, c\",\"a, b, d\",\"b, d, e\",\"a, d, f\",\"b, c, e\"],\"answer\":2,\"explain\":\"기타 비유창성(OD)은 다음절 낱말전체 반복·구 반복, 간투사, 수정·미완성 구 등이다. a '엄마가 엄마가'는 다음절 어절(낱말) 전체 반복, b '음'은 간투사, d '귤을, 아니 사과를'은 수정으로 모두 OD이다. c '시---장'은 연장, f '(막힘)너무'는 막힘으로 비운율적 발성(진성 비유창성)이며, e '사 사 사'는 일음절 낱말 전체 반복으로 Yairi와 Ambrose의 분류 및 P-FA-II의 R2(비정상적 반복)에서 모두 진성(비정상적) 비유창성으로 분류된다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"다음 중 말더듬 지속(persistence) 위험이 가장 높아 직접치료를 우선 고려해야 하는 아동은?\",\"choices\":[\"3세 2개월 여아, 발병 3개월, 가족력 없음, 최근 진성 비유창성 감소 추세, 음운발달 정상\",\"4세 남아, 발병 5개월, 삼촌이 어릴 때 더듬다 자연회복, 긴장 없는 음절 반복 위주, 인식 없음\",\"3세 8개월 여아, 발병 4개월, 가족력 없음, 언어발달이 또래보다 앞섬, 비유창성 빈도 증가 없음\",\"4세 6개월 남아, 발병 15개월, 아버지가 지속형 말더듬, 음운장애 동반, 막힘·연장 증가\",\"2세 10개월 남아, 발병 2개월, 가족력 없음, 다음절 낱말 전체 반복 위주, 말더듬 인식 없음\"],\"answer\":4,\"explain\":\"지속 위험요인은 남아, 지속형 말더듬 가족력, 발병 후 12개월 이상 경과, 발병 후 비유창성이 감소하지 않거나 증가, 막힘·연장 등 비운율적 발성 증가, 음운·언어 능력 저하, 아동의 인식·부정적 반응 등이다. ④는 남아, 아버지의 성인기까지 지속된 말더듬, 발병 15개월 경과, 음운장애 동반, 막힘·연장 증가로 이 요인을 다수 충족하므로 자연회복을 기다리기보다 직접치료를 우선해야 한다. ①·③은 여아·가족력 없음·감소 또는 증가 없음으로 회복 가능성이 높고, ②는 회복형 가족력과 쉬운 반복, 인식 없음으로 위험이 낮으며, ⑤는 발병 직후이고 비유창성이 정상적 비유창성에 가까워 관찰이 우선이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"리드콤 프로그램 훈련 중 어머니의 발화\\nㄱ. (유창한 발화 후) \\\"부드럽게 잘 말했네!\\\"\\nㄴ. (유창한 발화 후) \\\"방금 말 부드러웠어?\\\"\\nㄷ. (말더듬 후) \\\"조금 울퉁불퉁했네.\\\"\\nㄹ. (말더듬 후) \\\"울퉁불퉁했지? 다시 한 번 말해 볼래?\\\"\\nㅁ. (유창한 발화 후) \\\"그렇지, 부드러운 말이야.\\\"\",\"q\":\"언어적 수반자극(verbal contingency)의 유형이 옳게 연결된 것은?\",\"choices\":[\"ㄱ – 유창한 발화에 대한 인정\",\"ㄴ – 말더듬에 대한 자기평가 요청\",\"ㄷ – 말더듬에 대한 인정\",\"ㄹ – 말더듬에 대한 칭찬\",\"ㅁ – 유창한 발화에 대한 자기수정 요청\"],\"answer\":3,\"explain\":\"리드콤 프로그램의 언어적 수반자극은 유창한 발화에 대해 칭찬(ㄱ), 인정(acknowledgement, ㅁ), 자기평가 요청(ㄴ)의 세 가지, 명백한 말더듬에 대해 인정(ㄷ)과 자기수정 요청(ㄹ)의 두 가지이다. 따라서 ㄷ이 '말더듬에 대한 인정'으로 옳다. ㄱ은 칭찬, ㄴ은 유창한 발화에 대한 자기평가 요청, ㄹ은 자기수정 요청, ㅁ은 유창한 발화에 대한 인정이다. 말더듬에 대해서는 칭찬이나 자기평가 요청을 하지 않으며, 유창한 발화에는 자기수정을 요청하지 않는다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"스토커 프로브 테크닉(Stocker Probe Technique)을 적용 중인 5세 아동\\n• 치료사가 장난감 자동차를 보여주며 \\\"이것에 대해 이야기해 줄래?\\\"(4수준)라고 묻자 아동이 \\\"이이이거는 (막힘)바퀴가…\\\"라며 심하게 더듬음\",\"q\":\"이 상황에서 치료사가 취할 조치로 가장 적절한 것은?\",\"choices\":[\"같은 4수준 질문을 아동이 유창하게 답할 때까지 반복한다.\",\"5수준 질문(이야기 만들기)으로 올려 도전하게 한다.\",\"사물을 다른 장난감으로 바꾸어 같은 수준의 질문을 계속한다.\",\"말더듬이 나타났으므로 강화물을 주고 활동을 종료한다.\",\"더 낮은 수준의 질문으로 내려가 유창성을 회복시킨다.\"],\"answer\":5,\"explain\":\"스토커 프로브 테크닉은 의사소통 요구 수준을 5단계(두 사물 중 선택 → 이름 대기 → 위치·기능 → 사물 설명 → 이야기 만들기)로 나누어, 아동이 유창하면 요구 수준을 올리고 더듬으면 요구 수준을 낮추어 유창성을 유지하도록 조절하는 접근이다. 따라서 4수준에서 더듬으면 낮은 수준 질문(\\\"이건 뭐야?\\\", \\\"이건 자동차야, 기차야?\\\")으로 내려가 유창한 반응을 확보한 뒤 다시 단계적으로 올린다. ①·③은 같은 요구 수준을 유지해 말더듬을 지속시키고, ②는 요구를 더 높이며, ④는 조절 원리에 맞지 않는다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 14세 중학생, 파라다이스-유창성 검사-II(P-FA-II) 실시 계획\\n• 치료사가 준비한 과제: ㄱ. 읽기  ㄴ. 이야기그림  ㄷ. 말하기그림  ㄹ. 대화  ㅁ. 의사소통태도 평가\",\"q\":\"위 계획에 대한 설명으로 옳은 것은?\",\"choices\":[\"ㄱ, ㄷ, ㄹ이 필수과제이며 ㅁ을 함께 실시한다.\",\"ㄴ이 필수과제이고 ㄹ은 선택과제이다.\",\"ㅁ은 성인에게만 실시하므로 제외한다.\",\"낱말그림과 따라말하기를 필수과제로 추가한다.\",\"읽기는 초등학생에게만 실시하므로 ㄱ을 제외한다.\"],\"answer\":1,\"explain\":\"P-FA-II에서 중·고등학생과 성인의 필수과제는 읽기, 말하기그림, 대화이며, 낱말그림·따라말하기는 선택과제이다(문장그림은 취학 전 필수과제). 이야기그림은 초등학생 필수과제이므로 중학생에게는 해당하지 않는다(② 오답). 의사소통태도 평가는 초등학생 이상에게 실시하므로 중학생도 포함된다(③ 오답). ④ 낱말그림·따라말하기는 선택과제이다. ⑤ 읽기는 초등학생 이상 모두의 필수과제이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인의 사전-사후 평가 결과\\n가. 말더듬 음절 백분율(%SS): 14 → 3\\n나. 전반적 말더듬 경험 평가(OASES) 총 영향 점수: 3.6 → 2.1\\n다. 행동통제소 검사(LCB): 42 → 24\\n라. 말더듬 지각 검사(PSI) 기대(expectancy) 점수: 15 → 5\\n마. 의사소통태도 검사(S-24): 22 → 8\",\"q\":\"위 결과의 해석으로 옳은 것은?\",\"choices\":[\"나: 말더듬이 삶에 미치는 부정적 영향이 커졌다.\",\"다: 말의 통제가 자신에게 있다고 느끼게 되었다.\",\"라: 말을 더듬을 것이라고 예상하는 상황이 늘어났다.\",\"마: 의사소통 태도가 부정적으로 변하였다.\",\"가: 말더듬 빈도에는 의미 있는 변화가 없다.\"],\"answer\":2,\"explain\":\"LCB는 점수가 높을수록 외적 통제소재(운·타인이 결과를 결정한다고 믿음)를 뜻하므로 42 → 24로 감소한 것은 내적 통제감이 커진 긍정적 변화이다. OASES는 점수가 낮을수록 말더듬의 부정적 영향이 적으므로 나는 영향이 줄어든 것이고(① 오답), PSI 기대 점수 감소는 말더듬을 예상하는 상황이 줄었음을(③ 오답), S-24 점수 감소는 의사소통 태도가 긍정적으로 변했음을(④ 오답) 의미한다. %SS는 14에서 3으로 크게 감소하였다(⑤ 오답).\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"치료사: 지난주 녹화를 보면 막힐 때마다 입술을 꽉 다물고 힘을 주셨죠. 오늘은 일부러 막히는 순간에 그 형태를 바꿔 볼 거예요. 입술에 힘을 주는 대신 '바바바'처럼 가볍게 반복해서 더듬어 보세요.\\n대상자: 바바바바나나… (웃으며) 이렇게요?\\n치료사: 네. 같은 낱말을 이번엔 첫소리를 길게 늘여서 더듬어 볼까요?\",\"q\":\"위 대화에 해당하는 Van Riper 말더듬수정법의 치료 단계는?\",\"choices\":[\"확인\",\"둔감화\",\"접근\",\"변형\",\"안정화\"],\"answer\":4,\"explain\":\"변형(variation) 단계는 대상자가 습관적으로 굳어진 말더듬 형태(예: 입술에 힘을 주는 막힘)를 의도적으로 다른 형태(가벼운 반복, 연장 등)로 바꾸어 보게 함으로써 말더듬이 고정된 반응이 아니라 스스로 변화시킬 수 있는 행동임을 경험하게 하는 단계이다. 확인 단계는 자신의 말더듬 행동을 분석·기술하고, 둔감화는 말더듬과 청자 반응에 대한 두려움을 줄이며, 접근 단계에서는 취소·빠져나오기·예비책으로 더 쉬운 말더듬을 배우고, 안정화는 자기치료와 재발 대비를 다룬다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 68세 남성, 파킨슨병 진단 8년\\n• \\\"밥 먹었어요 먹었어요 먹었어요 먹었어요…\\\"처럼 낱말·구를 여러 차례 반복하며, 반복할수록 속도가 빨라지고 목소리가 작아짐\\n• 반복이 발화의 끝부분에서도 나타나며 긴장·막힘·연장은 없음\\n• 반복을 스스로 멈추기 어렵다고 하나 불안이나 부수행동은 없음\",\"q\":\"이 대상자의 유창성 문제로 가장 적절한 것은?\",\"choices\":[\"발달성 말더듬(developmental stuttering)\",\"신경인성 말더듬(neurogenic stuttering)\",\"동어반복증(palilalia)\",\"심인성 말더듬(psychogenic stuttering)\",\"속화(cluttering)\"],\"answer\":3,\"explain\":\"동어반복증(palilalia)은 기저핵 병변(파킨슨병 등)과 관련되어 낱말이나 구를 강박적으로 여러 번 반복하되 반복할수록 속도가 빨라지고 음량이 감소하는 것이 특징이며, 발화의 끝부분에서도 잘 나타난다. 신경인성 말더듬은 음소·음절 반복, 연장, 막힘이 낱말 위치와 무관하게 나타나는 것으로 낱말·구 전체의 가속·감음 반복과 구분된다. 발달성 말더듬은 아동기 발병과 긴장·부수행동, 심인성 말더듬은 심리적 외상 후 발생과 기이한 양상, 속화는 빠르고 불규칙한 말속도와 명료도 저하가 특징이므로 해당하지 않는다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 10세 남아, 통합적 말더듬 치료 18개월째\\n• 치료실 대화 %SS 0.8, 자기 평정 말더듬 정도 1~2점(9점 척도)\\n• 가정 녹음 %SS 1.5\\n• 학교 발표 상황 %SS 6.5, 담임 보고: 발표 순서가 오면 화장실에 간다며 자리를 비움\\n• 아동: \\\"학교에서는 기법이 생각 안 나요.\\\"\\n• 부모가 치료 종결을 문의함\",\"q\":\"치료사의 결정으로 가장 적절한 것은?\",\"choices\":[\"치료실·가정 준거를 충족했으므로 종결하고 추후 관리는 생략한다.\",\"유창성 확립 단계부터 프로그램 전체를 처음부터 다시 실시한다.\",\"리드콤 프로그램으로 전환하여 부모의 언어적 수반자극을 시작한다.\",\"학교에 발표 면제를 요청하여 말하기 부담을 없애 준다.\",\"종결을 보류하고 학교 발표 상황으로의 전이 활동을 실시한다.\"],\"answer\":5,\"explain\":\"치료실·가정에서는 유창하지만 학교 발표에서 %SS가 높고 회피(자리 비움)가 지속되므로 전이(일반화)가 완료되지 않은 상태이다. 종결 준거는 여러 상황·대화상대에서의 유창성과 회피·태도 개선까지 포함하므로, 종결을 보류하고 발표 상황 위계(짝 → 모둠 → 학급)에 따른 전이 활동, 교사 협력, 기법 사용 자기점검과 회피 감소 활동을 거쳐 유지 단계로 넘어가는 것이 적절하다. ①은 전이 미완료 상태의 조기 종결, ②는 이미 확립된 기술을 불필요하게 반복, ③은 학령전기 아동용 프로그램으로 부적절, ④는 회피를 강화한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 9세 여아, 말더듬 치료 중\\n• 최근 반 친구들이 \\\"말 좀 똑바로 해\\\"라며 말더듬을 흉내 내어 놀림\\n• 아동은 말수가 줄고 학교에 가기 싫다고 함\\n• 부모: \\\"놀리는 애들 부모한테 직접 따지겠어요.\\\"\",\"q\":\"치료사가 우선적으로 취할 접근으로 가장 적절한 것은?\",\"choices\":[\"아동과 놀림 대응법을 역할극으로 연습하고 담임교사와 협력한다.\",\"유창성 기법 훈련 시간을 늘려 말더듬을 빨리 감소시킨다.\",\"부모가 놀린 아동의 부모와 직접 만나 항의하도록 지지한다.\",\"놀림이 줄어들 때까지 등교를 잠시 중단하도록 권고한다.\",\"친구들이 눈치채지 못하게 어려운 낱말을 바꾸어 말하도록 지도한다.\"],\"answer\":1,\"explain\":\"놀림(bullying) 대응은 아동 자신의 대처 기술 훈련과 학교 환경 개입을 병행하는 것이 핵심이다. 역할극으로 놀림에 대한 대응(사실대로 말하기, 유머, 무시, 도움 요청)을 연습하고, 아동의 동의하에 담임교사와 협력하여 학급 차원의 말더듬 이해 교육을 계획하면 놀림이 줄고 아동의 위축과 회피를 예방할 수 있다. ②는 말더듬 감소가 곧 놀림 해결이라는 잘못된 전제이며 유창성 압박을 높인다. ③은 갈등을 키우고 아동의 문제해결 경험을 빼앗으며, ④는 회피를 강화하고, ⑤는 낱말 회피를 가르쳐 말더듬을 숨기게 만드는 부적절한 접근이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 15세 남학생, 어머니의 권유로 방문\\n• \\\"저는 괜찮아요. 엄마가 오라고 해서 왔어요.\\\"\\n• 대화 %SS 9, 전화·발표 상황 회피 뚜렷, 면담 중 눈맞춤을 피함\",\"q\":\"첫 회기에서 치료사의 접근으로 가장 적절한 것은?\",\"choices\":[\"어머니가 정한 목표에 따라 곧바로 유창성 확립 훈련을 시작한다.\",\"청소년 본인이 바라는 변화를 탐색하고 목표 설정에 참여시킨다.\",\"치료 동기가 없으므로 치료가 불가능하다고 알리고 종결한다.\",\"어머니에게 리드콤 프로그램의 언어적 수반자극 방법을 훈련한다.\",\"회피를 줄이기 위해 첫 회기에 낯선 사람에게 전화하게 한다.\"],\"answer\":2,\"explain\":\"청소년 말더듬 치료에서는 본인의 동기와 참여가 성과를 좌우한다. 부모가 의뢰했더라도 청소년 스스로 말더듬의 영향(회피, 눈맞춤 회피 등)을 인식하고 원하는 변화를 찾아 목표 설정에 참여하도록 돕는 동기 단계가 우선이며, 비밀보장과 자율성 존중이 신뢰 관계의 기초가 된다. ①·④는 본인의 동기를 배제한 채 부모 중심으로 진행하는 것이고(리드콤은 학령전기용), ③은 동기 형성을 치료의 일부로 보지 않는 잘못된 판단, ⑤는 준비 없는 급격한 노출로 회피와 불안을 오히려 강화할 수 있다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"13세 남학생. 담임교사가 \\\"말이 너무 빨라 무슨 말인지 모르겠다\\\"며 의뢰하였다.\\n• 음절 축약('할머니가'→'함니가'), 낱말·구 반복과 수정이 잦음\\n• 천천히 말하라고 하면 잠시 명료해지나 곧 원래 속도로 돌아감\\n• \\\"다들 잘 알아듣는데요?\\\"라고 말함\",\"q\":\"이 학생을 말더듬이 아닌 속화로 판단하는 근거로 가장 적절한 것은?\",\"choices\":[\"막힘이 나타날 때 후두와 입술에 긴장이 동반된다.\",\"말하기 어려운 낱말과 상황을 미리 예상하고 피한다.\",\"말을 더듬을 때 눈 깜박임 같은 부수행동이 나타난다.\",\"주의를 기울이면 나아지고 말 문제를 잘 인식하지 못한다.\",\"말을 더듬을 것이라는 예기 불안과 두려움을 호소한다.\"],\"answer\":4,\"explain\":\"속화는 말속도가 빠르거나 불규칙하여 음절 축약, 명료도 저하, 과도한 정상적 비유창성(낱말·구 반복, 수정)이 나타나는 유창성장애로, 말에 주의를 기울이거나 천천히 말하면 일시적으로 나아지고 자신의 말 문제에 대한 인식이 낮은 것이 말더듬과 구별되는 특징이다. 반대로 말더듬은 말에 주의를 기울이거나 긴장할수록 오히려 심해지는 경향이 있고, 자신의 말더듬을 뚜렷이 인식하여 예기 불안과 회피가 발달한다. ①(막힘과 긴장), ②(낱말·상황 회피), ③(부수행동), ⑤(예기 불안과 두려움)은 모두 말더듬의 특징이며 이 학생에게서 보고되지 않았다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 32세 남성 말더듬 성인, 지연청각피드백(DAF)을 이용한 유창성 형성 치료 중\\n• 250 ms 지연 조건에서 매우 느리고 연장된 말로 거의 유창하게 말함\",\"q\":\"이후 치료 진행 방향으로 가장 적절한 것은?\",\"choices\":[\"250 ms 지연을 유지한 채 일상에서도 계속 착용하게 한다.\",\"지연 시간을 더 늘려 말속도를 더욱 느리게 만든다.\",\"지연 시간을 단계적으로 줄이며 기기 없는 말로 전이한다.\",\"즉시 기기를 제거하고 곧바로 정상 속도로 말하게 한다.\",\"DAF 대신 차폐 소음 기기를 영구적으로 병행 사용한다.\"],\"answer\":3,\"explain\":\"DAF 기반 유창성 형성에서는 긴 지연(약 250 ms)으로 느리고 연장된 유창한 말을 확립한 뒤, 각 단계에서 유창성이 유지되면 지연을 점진적으로 줄여(예: 250 → 200 → … → 50 ms) 말속도와 자연스러움을 회복하고, 마지막에는 기기를 제거한 상태에서 유창성을 유지·전이하도록 진행한다. ①·⑤는 기기 의존을 고착시키고, ②는 자연스러움을 해치며, ④는 단계적 전이 없이 급격히 제거하여 재발을 초래하기 쉽다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 34세 여성 말더듬 성인\\n• %SS: 대화 11, 읽기 4\\n• 주 비유창성: 긴장된 막힘(최장 4초), 부수행동으로 눈 감기·턱 떨림\\n• 의사소통태도 검사(S-24): 20점(부정적)\\n• 어려운 낱말을 자주 바꾸어 말하며 자기소개 상황을 회피함\\n• 치료 목표: 관찰 가능한 말더듬 감소와 태도·회피 개선\",\"q\":\"가장 적절한 치료 계획은?\",\"choices\":[\"유창성완성법만 적용하고 태도와 회피는 다루지 않는다.\",\"말더듬수정법만 적용하고 유창성 촉진 기법은 배제한다.\",\"지연청각피드백 기기만 단독으로 장기간 사용한다.\",\"리드콤 프로그램을 성인용으로 축약하여 적용한다.\",\"유창성 형성 기법과 말더듬수정법, 둔감화를 병행한다.\"],\"answer\":5,\"explain\":\"대상자는 말더듬 빈도와 긴장이 높고(핵심행동) 동시에 부정적 태도·회피(내면 요소)도 뚜렷하므로, 부드러운 발성 시작·가벼운 조음접촉 등 유창성 형성 기법으로 유창성을 확립하면서 남는 막힘에는 말더듬수정법의 기법(빠져나오기·취소)을 적용하고, 낱말 회피와 부정적 태도에는 의도적 말더듬·자기공개·상황 위계 노출로 둔감화를 병행하는 통합적 접근이 목표에 부합한다. ①·③은 태도·회피를 다루지 못하고, ②는 %SS 11의 빈번한 긴장 막힘을 줄일 유창성 촉진 요소를 배제하며, ④는 부모 수반자극에 기반한 학령전기 프로그램이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 남아, 300음절 대화 표본 분석\\n• 단어부분 반복 9회(총 단위반복수 18회)\\n• 일음절 낱말 전체 반복 3회(총 단위반복수 3회)\\n• 비운율적 발성 6회\\n• 간투사 5회, 구 반복 2회, 수정 1회\",\"q\":\"위 자료의 분석으로 옳은 것은?\",\"choices\":[\"100음절당 진성 비유창성은 6회이다.\",\"100음절당 기타 비유창성은 8회이다.\",\"가중 진성 비유창성 점수는 6이다.\",\"진성 비유창성 반복(단어부분·일음절 낱말 반복)의 평균 단위반복수는 2.0회이다.\",\"진성 비유창성의 비율은 약 40%이다.\"],\"answer\":1,\"explain\":\"진성 비유창성(SLD) = 단어부분 반복 9 + 일음절 낱말 반복 3 + 비운율적 발성 6 = 18회 → 100음절당 18/300×100 = 6회로, 말더듬 기준(100음절당 진성 비유창성 3회 이상)을 충족한다. 평균 단위반복수 = (18+3)/(9+3) = 21/12 = 1.75회(④ 오답). 기타 비유창성 = 5+2+1 = 8회 → 100음절당 2.67회(② 오답). 전체 비유창성 26회 중 SLD 비율 = 18/26 ≈ 69%로 말더듬 아동에서 나타나는 높은 비율이다(⑤ 오답). 가중 SLD(weighted SLD) = [(단어부분 반복 + 일음절 낱말 반복) × 평균 단위반복수 + 2 × 비운율적 발성] ÷ 총 음절 × 100 = [(12 × 1.75) + 12]/300 × 100 = 33/300 × 100 = 11(③ 오답).\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"ㄱ. 음운적으로 복잡하거나 사용 빈도가 낮은 낱말에서 말더듬이 더 많이 나타난다.\\nㄴ. 말더듬은 부모의 부정적 반응에 대한 학습된 회피 반응이다.\\nㄷ. 말더듬 화자는 음운 부호화(음운 표상 활성화) 속도가 느리다.\\nㄹ. 비유창성은 조음 전에 음성 계획의 오류를 감지하고 수정하는 과정의 부산물이다.\\nㅁ. 말더듬은 예상되는 말더듬을 피하려는 투쟁 반응이다.\",\"q\":\"내적수정가설(Covert Repair Hypothesis)에 근거해 설명되는 것만 묶인 것은?\",\"choices\":[\"ㄱ, ㄴ, ㄷ\",\"ㄴ, ㄷ, ㅁ\",\"ㄱ, ㄹ, ㅁ\",\"ㄱ, ㄷ, ㄹ\",\"ㄷ, ㄹ, ㅁ\"],\"answer\":4,\"explain\":\"내적수정가설(Postma & Kolk)은 말더듬 화자의 음운 부호화가 느리고 오류가 잦으며(ㄷ), 내적 모니터가 조음 전에 음성 계획의 오류를 감지해 중단·수정하는 과정에서 반복·연장·막힘이 부산물로 나타난다고 본다(ㄹ). 따라서 부호화 부담이 큰 음운적으로 복잡하거나 저빈도 낱말에서 말더듬이 증가한다고 예측한다(ㄱ). ㄴ은 진단착오이론·학습이론, ㅁ은 예기투쟁가설의 설명이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 8개월 남아, 말더듬 시작 10개월 경과\\n• 수용·표현언어 검사 결과 모두 -1.5 SD\\n• 단문에서는 거의 유창하나 복문을 시도할 때 비유창성이 급증함\\n• 부모: \\\"언어를 먼저 치료해야 하나요, 말더듬을 먼저 치료해야 하나요?\\\"\",\"q\":\"이 아동의 중재 계획으로 가장 적절한 것은?\",\"choices\":[\"언어치료가 끝날 때까지 말더듬 중재는 모두 보류한다.\",\"유창성이 유지되는 발화 수준에서 언어 목표를 점차 늘린다.\",\"복문 산출을 집중 훈련해 언어 수준을 먼저 끌어올린다.\",\"말더듬이 사라질 때까지 부모의 언어 자극을 최소화한다.\",\"리드콤 프로그램의 수반자극을 언어 오류에도 동일하게 적용한다.\"],\"answer\":2,\"explain\":\"언어 능력이 낮은 아동에게 언어적 요구(복문)가 용량을 초과하면 비유창성이 증가한다(요구-용량 관점). 따라서 언어 목표와 유창성 목표를 분리하지 않고 통합하여, 유창성이 유지되는 발화 길이·복잡성에서 언어 목표를 시작해 점진적으로 늘리며 느린 말속도·기다리기 등 유창성 촉진 전략을 병행하는 계획이 적절하다. ①은 발병 10개월이 지난 아동의 말더듬을 방치하고, ③은 요구를 급격히 높여 비유창성을 악화시키며, ④는 언어발달을 저해하고, ⑤는 리드콤 수반자극이 말더듬 여부에만 적용되는 원칙에 어긋난다.\"},{\"grade\":1,\"set\":3,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 24세 남성, 소송과 관련하여 말더듬 장애 진단서를 요구하며 방문\\n• 아동기 말더듬 병력 없음, 신경학적 검사 정상\\n• 검사 시 모든 낱말의 첫 음절을 5~6회씩 균일하게 반복하며 부수행동이 과장됨\\n• 대기실에서 보호자와 대화할 때는 전혀 더듬지 않음\\n• 읽기를 반복해도 빈도 변화가 없고, 제창·노래 조건에서도 비유창성이 그대로이나 회기마다 양상이 크게 달라짐\",\"q\":\"이 대상자에 대한 감별과 대처로 가장 적절한 것은?\",\"choices\":[\"위장 말더듬 가능성을 고려해 여러 조건의 발화를 체계적으로 비교한다.\",\"심인성 말더듬으로 판단하고 정신건강의학과 의뢰 후 치료를 종결한다.\",\"신경인성 말더듬으로 판단하고 신경학적 정밀검사를 의뢰한다.\",\"발달성 말더듬으로 판단하고 말더듬수정법을 바로 시작한다.\",\"속화로 판단하고 말속도 조절 훈련을 곧바로 시작한다.\"],\"answer\":1,\"explain\":\"외적 이득(소송)이 걸려 있고, 관찰되지 않는다고 여길 때 유창하며, 병력·신경학적 근거가 없고, 지나치게 균일하고 과장된 반복과 회기 간 비일관성이 나타나는 점은 위장(malingering) 말더듬을 시사한다. 이 경우 여러 조건·시점의 발화 표본, 관찰 인식 여부에 따른 비교, 적응·제창 등 유창성 유도 조건에 대한 반응을 체계적으로 검토해 일관성을 확인하고 객관적으로 기록해야 하며, 단정적으로 낙인찍는 판단은 피해야 한다. ②는 심인성 말더듬의 경우에도 관찰되지 않는 상황에서 유창한 점과 이득 동기를 설명하지 못하고, ③은 신경학적 검사가 정상이며, ④는 아동기 병력이 없고, ⑤는 속화의 특징(빠른 속도, 명료도 저하)이 없다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 41세 여성 학원 강사, 6개월 전부터 말할 때 목소리가 끊기고 힘이 든다고 호소\\n• 연장모음 /아/: CPP 13.8 dB, jitter 0.52 %, HNR 21 dB, CAPE-V 전반적 중증도 8/100 mm\\n• 표준 문장 읽기: CPPS 4.2 dB, CAPE-V 전반적 중증도 62/100 mm\\n• VHI-10: 26점\\n• 후두스트로보스코피: 구조적 병변 없음\",\"q\":\"이 결과에 대한 해석과 조치로 가장 적절한 것은?\",\"choices\":[\"연장모음 지표가 정상이므로 음성장애가 없다고 판정하고 심리 상담을 의뢰한다\",\"문장 과제의 낮은 CPPS는 검사자의 마이크 거리 오류로 보고 모음 결과를 채택한다\",\"연장모음 결과만으로 정상 판정하지 말고 연결발화 지표로 정밀 평가한다\",\"VHI-10 26점은 정상 범위이므로 치료 없이 6개월 뒤 추적 관찰만 한다\",\"모음과 문장 결과가 서로 다르므로 두 값을 평균하여 경도 음성장애로 판정한다\"],\"answer\":3,\"explain\":\"연장모음에서는 CPP·jitter·HNR과 청지각 중증도가 모두 정상 범위이지만 연결발화에서는 CPPS가 현저히 낮고 청지각 중증도가 높으며, 환자의 핸디캡(VHI-10 26점)도 크다. 이는 음성 문제가 과제 의존적으로 연결발화에서 두드러진다는 뜻이며(연축성발성장애·근긴장성발성장애 등에서 흔함), 모음 지표만으로 정상 판정하면 위음성이 된다. CPPS는 연결발화에서도 산출할 수 있는 안정적 지표이므로 문장 과제 결과를 중증도 판정에 반영해야 한다. VHI-10은 통상 11점을 넘으면 비정상으로 보므로 26점은 정상이 아니며, 서로 다른 과제의 값을 평균하는 것은 근거가 없다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 29세 남성 콜센터 상담원, 목 조임과 음성 피로 호소\\n• /파/ 음절 반복 과제에서 추정한 성문하압(구강내압 최고치): 12.0 cmH₂O\\n• 동일 과제에서 모음 구간의 평균호기류율: 100 mL/sec\",\"q\":\"이 환자의 후두기류저항(laryngeal airway resistance)과 해석으로 옳은 것은?\",\"choices\":[\"120 cmH₂O/(L/sec)로 정상보다 높으며, 성대 과내전을 시사한다\",\"120 cmH₂O/(L/sec)로 정상보다 낮으며, 성문폐쇄부전을 시사한다\",\"0.12 cmH₂O/(L/sec)로 정상 범위이며, 효율적 발성을 시사한다\",\"1,200 cmH₂O·L/sec로 정상보다 높으며, 호흡 지지 부족을 시사한다\",\"8.3 (L/sec)/cmH₂O로 정상보다 높으며, 성대 과내전을 시사한다\"],\"answer\":1,\"explain\":\"후두기류저항 = 성문하압 ÷ 성문통과기류율이다. 100 mL/sec = 0.1 L/sec이므로 12.0 ÷ 0.1 = 120 cmH₂O/(L/sec)이다. 성인 편안한 발성의 정상 저항은 대략 30~70 cmH₂O/(L/sec) 범위로 보고되므로 120은 뚜렷이 증가된 값이며, 성문하압이 높은데 기류가 적게 통과한다는 것은 성대가 과도하게 내전(과기능)되어 있음을 뜻한다. ②는 값은 맞으나 방향 해석이 반대이고, ③·④·⑤는 단위 환산이나 분수 방향이 틀렸다. ※정상 저항 범위는 측정 방법·교재별로 차이가 있음.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"세 환자의 공기역학적 검사 결과(폐활량 외 모든 과제는 편안한 발성)\\n• 환자 A: MPT 6초, 평균호기류율 380 mL/sec, 성문하압 5.5 cmH₂O, 폐활량 3.6 L(정상)\\n• 환자 B: MPT 9초, 평균호기류율 60 mL/sec, 성문하압 13 cmH₂O, 폐활량 정상\\n• 환자 C: MPT 7초, 평균호기류율 110 mL/sec, 성문하압 4 cmH₂O, 폐활량 1.9 L(저하)\",\"q\":\"각 환자에게 가장 가능성이 높은 발성 문제의 기전을 옳게 연결한 것은?\",\"choices\":[\"A – 과기능적 성대 과내전, B – 성문폐쇄부전, C – 호흡 지지 부족\",\"A – 호흡 지지 부족, B – 성문폐쇄부전, C – 과기능적 성대 과내전\",\"A – 성문폐쇄부전, B – 호흡 지지 부족, C – 과기능적 성대 과내전\",\"A – 성문폐쇄부전, B – 과기능적 성대 과내전, C – 호흡 지지 부족\",\"A – 호흡 지지 부족, B – 과기능적 성대 과내전, C – 성문폐쇄부전\"],\"answer\":4,\"explain\":\"A는 폐활량이 정상인데 기류율이 크게 증가(정상 약 80~200 mL/sec)하고 MPT가 짧으므로 성문에서 공기가 새는 성문폐쇄부전(성대마비·위축 등)이다. B는 기류율이 낮고 성문하압이 높으므로(정상 약 5~10 cmH₂O) 성대를 과도하게 조여 발성하는 과기능 양상이다. C는 기류율은 정상 범위이나 성문하압이 낮고 폐활량 자체가 저하되어 있어 발성을 구동할 호흡 지지가 부족한 경우(신경근육질환·폐질환 등)이다. 세 환자 모두 MPT가 짧지만 원인 기전이 다르므로 MPT만으로는 감별할 수 없다. ※기류율·성문하압 정상 범위는 교재별로 차이가 있음.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 26세 성악 전공 대학원생, 고음역에서 소리가 갈라지고 연습 후 피로 호소\\n• GRBAS: G1 R0 B1 A0 S0\\n• 음성장애지수(VHI-30): 14점\\n• 가창음성장애지수(SVHI): 92/144점\\n• 후두스트로보스코피: 양측 성대에 경미한 부종, 발성 시 미세한 방추형 성문틈\",\"q\":\"이 결과에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"VHI-30이 낮으므로 음성 문제가 일상에 미치는 영향이 없다고 판단하고 치료를 종결한다\",\"SVHI는 VHI-30과 달리 가창 핸디캡을 반영하므로 가창 요구를 치료 목표에 둔다\",\"GRBAS가 경도이므로 자기보고 도구의 높은 점수는 과장된 호소로 보고 해석에서 제외한다\",\"SVHI는 청지각적 평가 도구이므로 GRBAS 등급과 일치할 때에만 타당하다고 본다\",\"두 설문 점수가 서로 크게 다르므로 검사 신뢰도가 낮다고 보고 전체 재검사를 실시한다\"],\"answer\":2,\"explain\":\"VHI-30은 일상적 말하기 음성이 신체·기능·정서 영역에 미치는 영향을 묻는 도구여서 말 음성이 비교적 유지되는 가수에서는 낮게 나올 수 있다. SVHI는 노래 수행에 특화된 자기보고 도구로 92/144점은 상당한 핸디캡을 나타내며, 스트로보스코피의 경미한 부종·성문틈이 고음역 문제와 부합한다. 청지각적 중증도가 경도라도 직업적 요구가 높은 가수에게는 작은 변화가 큰 기능 손실이 되므로 자기보고 결과를 과장으로 보아서는 안 된다. SVHI는 청지각 평가가 아니라 자기보고 도구이며, 두 도구는 측정 영역이 달라 점수 불일치가 신뢰도 문제를 뜻하지 않는다. ※VHI-30 절단점은 연구별로 차이가 있음.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 31세 여성 실용음악 보컬, 수년간 지속된 기식적 음성과 음성 피로, 고음 산출 곤란\\n• 후두스트로보스코피: 양측 성대 유리연을 따라 길게 파인 홈, 방추형 성문틈, 홈 부위 점막파동 현저히 감소\\n• 8개월 전 흡수성 재료 성대주입술 후 일시 호전되었으나 재발\\n• 발성 시 목과 어깨에 힘을 주어 소리를 내는 습관이 생김\",\"q\":\"이 환자의 음성치료 계획으로 가장 적절한 것은?\",\"choices\":[\"밀기 기법을 집중 적용하여 성문틈을 강제로 닫도록 훈련한다\",\"3개월간 절대 음성휴식을 지시한 뒤 후두 상태를 재평가한다\",\"보툴리눔 독소 주입을 의뢰하여 성대와 후두 긴장을 낮춘다\",\"제II형 갑상성형술을 의뢰하여 성문을 넓히고 긴장을 줄인다\",\"반폐쇄성도훈련으로 효율적 발성을 익히고 과기능을 줄인다\"],\"answer\":5,\"explain\":\"성대 유리연의 홈과 국소적 점막파동 소실, 방추형 성문틈은 성대구증(고유층 결손)의 소견으로, 병변 자체는 음성치료로 없어지지 않고 수술(주입술·성형술)의 효과도 제한적이거나 일시적이다. 따라서 치료 목표는 남은 조직으로 가장 효율적인 발성을 얻는 것이며, 반폐쇄성도훈련과 공명음성으로 성문 상부 압력을 활용해 성문틈을 보상하고, 이미 형성된 목·어깨의 보상적 과기능을 줄이면서 현실적인 기대치를 상담하는 것이 적절하다. 밀기 기법은 이미 있는 과기능을 강화하고, 장기 절대 음성휴식은 근거가 없으며, 보툴리눔 독소는 연축성발성장애의 치료이고, 제II형 갑상성형술은 성문을 넓히는 수술이라 성문틈이 있는 환자에게 반대 방향의 처치이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 71세 남성, 폐암으로 좌측 상엽 절제술 14개월 후, 수술 직후부터 약하고 기식적인 음성과 물 마실 때 사레\\n• 4개월간 성대내전 촉진 음성치료를 받았으나 MPT 5초, 평균호기류율 420 mL/sec로 변화 없음\\n• 후두근전도: 좌측 갑상피열근에서 재신경화 징후 없음\\n• 발성 시 후두내시경 소견: 좌측 성대 부정중위 고정 및 궁형(bowing) 변화, 우측 성대의 보상적 과내전에도 성문 후방부 폐쇄 부전 지속, 좌측 성대 수직 위치 저하\",\"q\":\"후두내시경 소견과 경과를 고려할 때 가장 적절한 치료는?\",\"choices\":[\"제I형 갑상성형술과 피열연골내전술 병행을 고려한다\",\"제II형 갑상성형술로 성문을 넓혀 기도를 확보한다\",\"건측 성대에 보툴리눔 독소를 주입하여 보상적 과내전을 줄인다\",\"흡수성 젤 성대주입술 후 6개월간 자연 회복을 더 기다린다\",\"양측 후윤상피열근 절제술로 성대 위치를 교정한다\"],\"answer\":1,\"explain\":\"수술 후 14개월이 지났고 후두근전도에서 재신경화 징후가 없으며 충분한 음성치료에도 공기역학 지표가 개선되지 않았으므로 자연 회복 가능성은 낮고 영구적 내측화 수술의 적응증이다. 내시경의 성문 후방부 폐쇄 부전은 후방 성문틈이 크다는 뜻이고, 마비측 성대의 수직 위치 저하는 좌우 성대의 높이 차이를 뜻한다. 제I형 갑상성형술은 마비된 성대를 정중선 쪽으로 밀어 성문틈을 줄이지만 성대 앞쪽 위주로 작용하므로, 후방 성문틈이 넓고 좌우 성대의 높이 차이가 있으면 피열연골내전술을 병행하여 후방 폐쇄와 높이를 맞춘다. 제II형은 성문을 넓히는 수술(연축성발성장애 등), 보툴리눔 독소는 건측의 보상까지 없애 음성을 악화시키며, 흡수성 주입은 회복이 기대되는 시기의 임시 처치이고, 후윤상피열근 절제술은 존재하지 않는 표준 술식이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 58세 남성 회사원, 6개월 전부터 목소리가 쉬고 숨이 새며 점점 콧소리가 심해짐, 최근 물을 마실 때 가끔 사레가 들림\\n• 후두내시경: 구조적 병변 없음, 성대 내전이 다소 약하나 마비는 없음\\n• 구강 검사: 혀 가장자리의 위축과 혀 표면의 미세한 꿈틀거림(섬유속연축)\\n• 최근 오른손으로 젓가락질과 단추 채우기가 서툴러졌다고 함\\n• 휴식 후에도 증상의 변화가 없음\",\"q\":\"언어재활사의 대응으로 가장 적절한 것은?\",\"choices\":[\"기능적 음성장애로 판단하고 성대기능훈련을 바로 시작한다\",\"음성 과사용에 의한 근피로이므로 음성위생 교육과 확성기 사용을 권한다\",\"운동신경원질환을 의심하여 신경과 진료를 먼저 의뢰한다\",\"내전형 연축성발성장애로 판단하고 보툴리눔 독소 주입을 의뢰한다\",\"성대마비 초기로 판단하고 밀기 기법으로 성대 내전을 강화한다\"],\"answer\":3,\"explain\":\"수개월에 걸쳐 진행하는 쉰·기식 음성과 과다비성, 삼킴 곤란에 더해 혀의 위축과 섬유속연축(하부운동신경원 징후), 손의 미세운동 저하(사지 침범)가 함께 나타나는 것은 근위축성 측삭경화증(ALS) 등 운동신경원질환을 시사한다. 구근형으로 시작하는 경우 음성·말 증상이 첫 증상이어서 음성장애로 먼저 의뢰되기도 하므로, 언어재활사는 음성 문제로만 해석하지 말고 신경과 진료를 먼저 의뢰해야 한다. 진단 후의 중재는 근력 강화보다 에너지 보존, 보완대체의사소통(AAC)의 조기 준비, 삼킴 관리가 중심이 된다. ① 기능적 음성장애와 ② 음성 과사용은 혀 위축·섬유속연축·사지 근력 저하를 설명하지 못하고, ④ 연축성발성장애는 과제 특이적인 긴장성 음성 단절이 특징이며, ⑤ 성대마비 소견이 없고, 진행성 신경근 질환에서 밀기 기법 같은 근력 강화 훈련은 피로를 가중시킬 수 있다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 34세 여성 합창단원, 상기도 감염 후 2개월째 고음이 나오지 않음, 노래할 때 음도를 올리려 하면 소리가 갈라지고 말소리는 약간 낮아지고 숨이 섞임\\n• 음성범위프로파일: 최고 주파수가 이전 기록보다 1옥타브 이상 감소\\n• 후두내시경: 양측 성대의 내·외전 운동은 정상 범위이나, 음도 활주 시 좌측 성대가 짧고 처져 보이며 후방 성문이 좌측으로 회전되어 성대 길이가 비대칭임\",\"q\":\"이 사례의 진단과 중재로 가장 적절한 것은?\",\"choices\":[\"좌측 되돌이후두신경 마비 – 제I형 갑상성형술을 의뢰한다\",\"좌측 상후두신경 외지 마비 – 음도 확장 훈련 등 음성치료를 한다\",\"변성발성장애 – 손가락 조작법으로 습관적 음도를 낮춘다\",\"근긴장성발성장애 – 후두 마사지로 후두 긴장을 이완한다\",\"양측 성대마비 – 기도 확보를 위해 성대 외측고정술을 의뢰한다\"],\"answer\":2,\"explain\":\"상후두신경 외지는 윤상갑상근을 지배하며, 이 근육은 성대를 늘여 음도를 높인다. 바이러스성 상기도 감염 후 한쪽 윤상갑상근이 약해지면 내·외전은 정상이지만 고음 산출이 안 되고, 활주 시 마비측 성대가 짧고 처지며 후방 성문이 마비측으로 회전하는 특징적인 비대칭이 나타난다. 치료는 회복을 기다리며 음도 확장 훈련·건측 보상 등 음성치료가 중심이며, 되돌이후두신경 마비처럼 성대 내전이 안 되는 것이 아니므로 내측화 수술은 적응증이 아니다. 변성발성장애·근긴장성발성장애는 신경학적 비대칭 소견을 설명하지 못하고, 양측 성대마비는 내·외전 운동 자체가 소실된다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 68세 남성, 후두전적출술과 경부 방사선치료 종료 후 3개월, 전기후두 훈련을 시작함\\n• 경부형 전기후두를 목 여러 부위에 대어 보았으나 피부가 단단하고 부어 있어 소리가 거의 입 밖으로 전달되지 않음\\n• 인지·손 기능은 양호하고 구강 구조와 조음 기능은 정상\",\"q\":\"이 시점에서 가장 적절한 조치는?\",\"choices\":[\"전기후두를 포기하고 식도발성 훈련으로 즉시 전환한다\",\"기기의 진동 강도를 최대로 높여 목에 세게 눌러 사용하도록 한다\",\"방사선 부종이 있으므로 모든 무후두 발성 훈련을 1년 뒤로 미룬다\",\"구강형 어댑터로 진동음을 입안에 전달하며 조음 훈련을 한다\",\"기관식도천공 발성이 가능하도록 즉시 보철 삽입을 의뢰한다\"],\"answer\":4,\"explain\":\"경부형 전기후두는 목 조직을 통해 진동을 인두·구강으로 전달하는데, 방사선치료 후 부종·섬유화가 있으면 진동이 흡수되어 소리가 나오지 않는다. 이때는 기기에 구강형 어댑터(튜브)를 연결해 진동음을 입안으로 직접 넣어 조음하는 방법으로 즉시 의사소통을 확보할 수 있으며, 조직 상태가 좋아지면 경부형으로 옮겨갈 수 있다. 식도발성은 습득에 오랜 시간이 걸려 당장의 대안이 되지 못하고, 강한 압박은 조직 손상과 통증을 유발하며, 훈련을 미루면 의사소통 단절 기간이 길어진다. 기관식도천공 발성은 별도의 적응 평가(공기주입검사 등)가 필요하므로 이 시점의 즉각적 해결책이 아니다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 62세 남성, 기관식도천공(TEP) 발성으로 2년간 잘 지내 옴\\n• 최근 2주 전부터 물을 마시면 기침이 나고, 확인해 보니 물이 보철의 가운데 구멍을 통해 기관 쪽으로 새어 나옴\\n• 발성은 이전과 같이 잘 되며 보철 주변 조직에서는 누출이 없음\\n• 보철을 교체한 지 9개월 됨\",\"q\":\"이 문제의 원인과 조치로 가장 적절한 것은?\",\"choices\":[\"천공이 늘어나 보철 둘레로 새는 것이므로 더 큰 지름의 보철로 교체한다\",\"인두식도분절 경직이 원인이므로 보툴리눔 독소 주입을 의뢰한다\",\"보철을 제거하고 천공을 폐쇄한 뒤 식도발성으로 전환한다\",\"보철 위치가 잘못되었으므로 기공을 완전히 막고 발성 연습을 늘린다\",\"밸브가 완전히 닫히지 않는 보철 고장이므로 보철 교체를 의뢰한다\"],\"answer\":5,\"explain\":\"TEP 보철의 일방향 밸브는 발성 시 폐 공기를 식도로 보내고 삼킬 때는 닫혀 식도 내용물이 기관으로 넘어오지 않게 한다. 밸브 중심(내강)을 통한 누출은 밸브 판막이 칸디다 집락·마모로 완전히 닫히지 않는 보철 자체의 고장이며, 통상 보철 교체와 항진균 관리로 해결된다. 보철 둘레 누출은 천공 확대가 원인으로 다른 처치(작은 지름·조직 수축 조치)가 필요하고, 발성이 잘 되므로 인두식도분절 경직은 아니며, 잘 작동하던 TEP를 폐쇄할 이유도 없다. 기공 폐쇄나 발성 연습은 흡인 위험을 해결하지 못한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 7세 여아, 생후 12개월에 구개열 봉합술, 최근 심한 알레르기 비염으로 입으로 숨 쉼\\n• 나조미터 검사: 구강음 문장 비성치 36 %, 비음 문장 비성치 42 %\\n• 청지각: 모음에서 과다비성이 들리고, /ㅁ, ㄴ/의 비음 공명은 오히려 약하며 압력자음에서 비강 난기류가 들림\",\"q\":\"이 결과의 해석과 다음 조치로 가장 적절한 것은?\",\"choices\":[\"구강음 비성치가 높은 전형적 과다비성이므로 즉시 인두피판술을 의뢰한다\",\"혼합비성이 의심되므로 연인두 폐쇄와 비강 기도 폐쇄를 함께 평가한다\",\"비강 폐쇄에 의한 과소비성이므로 아데노이드 절제술을 의뢰한다\",\"두 비성치가 모두 정상 범위이므로 압력자음 조음치료만 실시한다\",\"연인두 폐쇄가 정상이므로 비강 기류 훈련(부는 연습)을 실시한다\"],\"answer\":2,\"explain\":\"구강음 문장 비성치는 정상 상한(대략 15~20 %)을 크게 넘고 비음 문장 비성치는 정상(대략 55~65 %)보다 낮다. 구강음에서 코로 소리가 새면서(연인두 폐쇄부전) 동시에 비음의 비강 공명이 부족한 것은 비강 기도 폐쇄가 함께 있는 혼합비성의 전형이다. 비강 폐쇄가 있으면 나조미터 값이 실제 연인두 기능보다 낮게 나와 과다비성이 과소평가될 수 있으므로, 수술 결정 전에 비강 기도 문제를 평가·관리하고 비인두내시경으로 폐쇄 양상을 직접 확인해야 한다. 과소비성 단독이나 정상 판정은 구강음 문장의 높은 비성치와 맞지 않고, 부는 연습은 연인두 폐쇄부전을 개선하지 못한다. ※비성치 정상 범위는 검사 문장·연령·교재별로 차이가 있음.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 45세 여성, 1년 전부터 말할 때 목소리가 걸린 듯 끊기고 쥐어짜는 소리가 남\\n• 모음이 많은 문장('아이와 엄마가 우유를 마셔요')에서 음성 단절이 특히 잦음\\n• 웃거나 울 때, 노래하거나 속삭일 때는 음성이 비교적 정상\\n• 후두내시경: 구조적 병변 없음, 발화 중 간헐적인 성대 과내전\\n• 6개월간 음성치료(하품-한숨, 반폐쇄성도훈련) 후에도 변화 없음\",\"q\":\"이 환자에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"내전형 연축성발성장애를 의심해 보툴리눔 독소 치료를 의뢰한다\",\"근긴장성발성장애로 보고 같은 음성치료를 더 오래 지속한다\",\"외전형 연축성발성장애로 보고 무성자음 문장으로 재평가한다\",\"심인성 실성증으로 보고 정신건강의학과 의뢰 후 종결한다\",\"성대마비 초기로 보고 제I형 갑상성형술을 의뢰한다\"],\"answer\":1,\"explain\":\"말하기에서만 나타나고 웃음·울음·노래·속삭임에서는 비교적 정상인 과제 특이성, 모음(유성음)이 많은 문장에서 두드러지는 쥐어짜는 음성 단절, 구조적 병변 없이 발화 중 간헐적으로 나타나는 성대 과내전은 내전형 연축성발성장애의 특징이다. 이는 후두의 국소 근긴장이상(신경학적 질환)이어서 음성치료 단독으로는 효과가 제한적이며, 갑상피열근에 대한 보툴리눔 독소 주입이 표준 치료이고 음성치료는 주입 후 보조적으로 병행한다. ② 근긴장성발성장애는 음성치료에 반응하는 경우가 많고 이처럼 과제 특이적인 단절 양상을 보이지 않는다. ③ 외전형은 무성자음이 많은 문장에서 숨이 새는 단절이 특징으로, 이 환자의 쥐어짜는 단절과 반대 양상이다. ④ 심인성 실성증은 대개 갑자기 시작되어 속삭임 음성이 지속되는 양상이며, ⑤ 성대 운동 저하가 아니라 과내전이 문제이므로 내측화 수술은 적응증이 아니다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 33세 여성 유치원 교사, 하루 6시간 이상 소음이 큰 교실에서 발화, 오후마다 쉰 목소리와 목 통증, 주말이면 회복\\n• 후두내시경: 양측 성대 경미한 발적과 부종, 명확한 결절 없음\\n• 음성 사용을 줄이기는 현실적으로 어렵다고 함\",\"q\":\"이 교사에게 가장 적절한 음성 관리 지도는?\",\"choices\":[\"수업 중에는 속삭여서 말하여 성대 접촉 부담을 줄이도록 한다\",\"목이 쉬면 멘톨 사탕과 진한 커피로 목을 풀고 수업하도록 한다\",\"확성기 사용과 잦은 음성휴식으로 하루 음성 부하량을 낮춘다\",\"음성 문제가 반복되므로 3개월간 절대 음성휴식을 취하게 한다\",\"큰 소리로 말하는 훈련을 통해 성대 근육을 단련하도록 한다\"],\"answer\":3,\"explain\":\"직업적 음성 사용자의 과사용 초기 소견(발적·부종, 주말 회복)에서는 음성 부하량을 낮추는 환경·행동 조정이 핵심이다. 확성기는 소음 환경에서 강도를 높이지 않고도 전달을 가능하게 해 부하를 실질적으로 줄이며, 소음 감소·짧고 잦은 휴식·수분 섭취가 함께 권장된다. 속삭임은 성대에 오히려 긴장을 주고, 멘톨과 카페인은 점막을 건조하게 하며, 장기 절대 휴식은 근거가 없고 직업적으로 비현실적이다. 큰 소리 훈련은 부하를 더 늘려 병변으로 진행시킬 위험이 있다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 22세 여성 서비스직, 약하고 기식적이며 단조로운 목소리로 손님이 잘 못 알아듣는다고 호소\\n• 관찰: 말할 때 어깨가 들리는 얕은 쇄골호흡, 짧은 구절 단위로 자주 숨을 쉼, 리듬과 억양의 변화가 거의 없음\\n• MPT 8초, 후두내시경: 병변 없음, 발성 시 경미한 방추형 성문틈\",\"q\":\"이 대상자에게 가장 적합한 음성치료는?\",\"choices\":[\"리실버만음성치료로 큰 소리 산출을 집중 훈련한다\",\"손가락 조작법으로 습관적 음도를 낮추도록 훈련한다\",\"흡기발성으로 진성대 발성을 유도하여 훈련한다\",\"악센트 기법으로 복식호흡과 리듬적 강세를 결합한다\",\"차폐 기법으로 무의식적인 음성 강도 증가를 유도한다\"],\"answer\":4,\"explain\":\"얕은 쇄골호흡, 호흡 지지 부족에 따른 약하고 기식적인 음성, 단조로운 리듬·억양은 악센트 기법의 주된 적응증이다. 악센트 기법은 복식(횡격막)호흡을 기반으로 느린 템포부터 빠른 템포까지 리듬적 강세를 주며 발성하여 호흡-발성-조음의 협응을 개선하고 음성의 역동성을 높인다. LSVT는 파킨슨병의 감소된 강도에 특화된 방법이고, 손가락 조작법·흡기발성은 각각 변성발성장애·가성대 발성/기능적 실성증에 쓰이며, 차폐 기법은 롬바르드 효과로 강도만 올리는 방법이라 호흡 양상과 리듬 문제를 다루지 못한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 58세 여성, 폐 결핵 수술 후 우측 성대마비로 진단, 발성 시 기식적이고 약한 음성\\n• 음성치료 중 치료사가 환자의 갑상연골 우측 판(lamina)을 손가락으로 안쪽으로 부드럽게 누른 상태에서 /아/를 연장하게 하자 음성이 즉시 뚜렷하게 커지고 맑아짐\",\"q\":\"이 절차의 명칭과 임상적 의미로 옳은 것은?\",\"choices\":[\"후두 하강법 – 후두를 낮춰 근긴장을 이완시키는 절차이다\",\"갑상연골 전방 압박 – 음도를 낮추는 변성발성장애 치료이다\",\"후두 마사지 – 후두 외근의 긴장을 줄여 근긴장성발성장애를 치료한다\",\"윤상갑상근 자극법 – 성대를 늘여 음도 범위를 넓히는 절차이다\",\"갑상연골 측면 압박 – 마비 성대를 내측화하여 수술 효과를 예측한다\"],\"answer\":5,\"explain\":\"갑상연골 판을 옆에서 안쪽으로 누르면 그 아래의 성대가 정중선 쪽으로 밀려 성문 폐쇄가 일시적으로 좋아진다. 편측 성대마비에서 이 조작으로 음성이 즉시 개선되면 내측화(갑상성형술·주입술)의 효과를 예측할 수 있고, 치료 중에는 성문 폐쇄 감각을 익히는 촉진 기법으로도 쓴다. 갑상연골을 앞에서 뒤로 눌러 성대를 느슨하게 하여 음도를 낮추는 것은 변성발성장애의 손가락 조작법이며, 후두 하강·후두 마사지는 과기능성 음성장애의 이완 기법이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 38세 남성, 성인형 재발성 후두유두종으로 4년간 CO₂ 레이저 수술 6회\\n• 후두내시경: 현재 활동성 유두종은 소량이나 전방 성문 유착(전교련 웹)과 양측 성대 반흔이 있음\\n• 음성: 거칠고 기식적이며, 발성 시 가성대가 좁혀지고 목에 힘을 많이 줌\\n• 이비인후과에서 음성치료를 의뢰함\",\"q\":\"이 환자의 음성치료 목표와 원칙으로 가장 적절한 것은?\",\"choices\":[\"음성치료로 남은 유두종을 소실시키고 재발을 막는 것을 일차 목표로 한다\",\"남은 조직으로 효율적인 발성을 얻고 보상적 과기능 발성을 줄인다\",\"유착 부위를 벌리기 위해 밀기 기법과 강한 성문파열음 시작을 훈련한다\",\"유두종은 전염성이므로 대면 치료를 중단하고 음성위생 자료만 제공한다\",\"완전한 정상 음성 회복을 목표로 주 5회 강도 높은 훈련을 계획한다\"],\"answer\":2,\"explain\":\"반복 수술로 생긴 전교련 웹과 성대 반흔은 진동 조직 자체의 손실이므로 음성치료로 되돌릴 수 없고, 활동성 유두종 병변은 수술(그리고 필요 시 보조 약물)로 관리한다. 언어재활사의 역할은 남은 조직의 진동 효율을 높이고 보상적으로 생긴 가성대 압박·노력 발성을 줄여 음성과 피로를 개선하는 것이며, 병변 재발이나 기도 협착의 징후를 관찰해 의뢰하는 것이다. 밀기·강한 성문파열음은 과기능을 강화하고 반흔 조직에 부담을 주며, 유두종은 일상적 대면 치료로 전염되는 것이 아니고, 구조적 손상이 있어 완전한 정상 음성이라는 목표는 비현실적이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"성대폴립 후두미세수술 후 1주가 지난 영업직 환자에게 이비인후과에서 '비밀스러운 음성(confidential voice)'으로 말하도록 하라는 의뢰가 왔다.\",\"q\":\"이 기법을 적용할 때 언어재활사의 지도로 가장 적절한 것은?\",\"choices\":[\"속삭임이 아닌 낮은 강도의 유성 발성으로, 수술 후 단기간만 사용한다\",\"성대를 완전히 벌리고 공기 소리만 내는 속삭임으로 말하도록 안내한다\",\"기식성이 좋은 음질이므로 수술 후 6개월 이상 습관화되도록 유지한다\",\"낮은 강도가 목표이므로 목을 조여 작은 소리를 내도록 지도한다\",\"음성휴식과 같은 효과이므로 말하는 양을 제한할 필요는 없다고 안내한다\"],\"answer\":1,\"explain\":\"비밀스러운 음성은 가까운 사람에게 비밀을 말하듯 낮은 강도에 약간 기식적인, 그러나 유성음이 유지되는 편안한 음성으로, 성대 접촉 충격을 줄이면서 최소한의 의사소통을 가능하게 한다. 속삭임은 성대를 강하게 벌리고 후두 긴장을 높여 오히려 해롭고, 목을 조이는 것은 과기능을 유발한다. 이 기법은 수술 직후나 급성 염증기에 단기간 쓰는 과도기적 방법이며, 장기간 사용하면 기식성 발성이 습관화될 수 있으므로 상처 회복 후 공명음성·반폐쇄성도훈련 등 정상 발성 훈련으로 옮겨가야 한다. 또한 음성휴식을 완전히 대체하는 것은 아니므로 말하는 양도 함께 조절한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 29세 여성 뮤지컬 배우, 감기 후 2일 전부터 목이 쉬고 통증, 이틀 뒤 주연 공연 예정\\n• 공연을 강행하려 하며 '목을 아끼기 위해 리허설은 속삭여서 하겠다'고 함\\n• 후두내시경: 양측 성대 전반의 발적과 부종, 점막파동 감소, 출혈·종괴 없음\",\"q\":\"언어재활사의 대응으로 가장 적절한 것은?\",\"choices\":[\"속삭임은 성대 접촉이 없으므로 리허설 방식으로 적절하다고 확인해 준다\",\"밀기 기법으로 성대 접촉을 강화하여 공연에 필요한 강도를 확보한다\",\"부종이 심한 급성기이므로 즉시 후두미세수술을 의뢰한다\",\"손상 위험을 설명하고 이비인후과 치료와 상대적 음성휴식을 권한다\",\"공연 전까지 고음 발성 연습량을 늘려 성대를 부하에 적응시킨다\"],\"answer\":4,\"explain\":\"급성 후두염으로 부종·발적이 있는 성대에 공연 수준의 발성 부하가 가해지면 성대 출혈이나 폴립 등 영구적 손상으로 이어질 수 있어, 전문 공연자에게는 특히 위험을 명확히 설명하고 의료진과 공연 여부를 결정하게 해야 한다. 이 시기의 관리는 이비인후과 약물 치료와 상대적 음성휴식, 가습·수분 섭취이며 속삭임은 후두 긴장을 높여 회복에 해롭다. 밀기 기법과 고음 연습은 부하를 늘리고, 급성 염증은 수술 대상이 아니다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 62세 남성, 30년 흡연·잦은 음주, 3개월 전부터 점차 심해지는 쉰 목소리, 최근 목 이물감\\n• 후두스트로보스코피: 우측 성대 중간부에 경계가 불규칙한 두꺼운 백색 융기 병변, 병변 부위 점막파동 소실, 좌측은 정상\\n• 이비인후과 진료 없이 지인의 소개로 음성치료를 받으러 옴\",\"q\":\"언어재활사의 대응으로 가장 적절한 것은?\",\"choices\":[\"성대결절로 판단하고 음성위생 교육과 반폐쇄성도훈련을 시작한다\",\"라인케부종이므로 금연 상담을 하고 3개월 뒤 재평가한다\",\"음성치료를 보류하고 즉시 이비인후과에 정밀 진단을 의뢰한다\",\"음성 남용에 의한 접촉성 육아종이므로 헛기침 줄이기를 지도한다\",\"기능적 음성장애이므로 심리 상담과 함께 하품-한숨법을 실시한다\"],\"answer\":3,\"explain\":\"장기 흡연·음주력이 있는 60대 남성의 진행하는 쉰 목소리에서 편측의 불규칙한 백색 융기 병변과 국소적 점막파동 소실은 백반증(이형성)이나 침윤성 후두암을 시사하는 적신호이며, 조직검사 없이는 양성 여부를 판단할 수 없다. 음성치료는 악성이 배제된 뒤 시작해야 하므로 우선 이비인후과 정밀 진단을 의뢰한다. 성대결절은 양측 대칭 병변, 라인케부종은 양측 전장의 반투명 부종, 접촉성 육아종은 성대돌기(후방) 부위 병변이고, 구조적 병변이 뚜렷하므로 기능적 음성장애로 볼 수 없다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 55세 여성, 8개월간 지속되는 마른 기침, 하루 수십 회 발작적으로 나타나며 말하거나 웃을 때, 향수·찬 공기에 노출될 때 유발됨\\n• 목이 간질거리는 느낌이 기침에 선행, 밤에 잠들면 기침 없음\\n• 흉부 영상·폐기능검사·역류 치료·천식 치료·비염 치료에 반응 없음\\n• 후두내시경: 구조적 이상 없음, 흡기 시 성대가 살짝 안쪽으로 모이는 경향\",\"q\":\"이 사례의 판단과 중재로 가장 적절한 것은?\",\"choices\":[\"역류가 원인이므로 양성자펌프억제제 용량을 늘리도록 권한다\",\"기침을 참으면 해로우므로 기침을 충분히 하도록 교육한다\",\"말할 때 유발되므로 성대결절을 의심하고 음성휴식을 지시한다\",\"심인성 기침으로 판단하고 정신건강의학과 의뢰만 한다\",\"후두 과민성 기침으로 보고 행동적 기침 억제 치료를 실시한다\"],\"answer\":5,\"explain\":\"흉부·폐기능 검사가 정상이고 역류·천식·비염 치료에 반응하지 않으며, 목의 간질거림이 선행하고 말·웃음·냄새·찬 공기 같은 비특이 자극에 유발되면서 수면 중에는 없는 기침은 후두 과민성에 의한 만성 난치성 기침의 전형이다. 이 경우 언어재활사가 시행하는 행동적 기침 억제 치료(교육, 기침 대체 전략, 후두 이완·호흡 재훈련, 유발 요인 관리)가 근거 있는 중재이며, 흡기 시 성대가 모이는 경향은 역행성 성대운동과의 연관성을 시사한다. 이미 효과 없던 역류 치료를 늘리는 것은 근거가 없고, 기침을 반복하면 후두 자극이 강화되어 악순환이 된다. 병변이 없으므로 결절·음성휴식과는 무관하며, 심인성으로 단정해 정신과에만 의뢰하는 것도 부적절하다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 37세 남성 강사, 근긴장성발성장애로 8회기 음성치료(후두 마사지, 하품-한숨, 반폐쇄성도훈련) 실시\\n• 전기성문파형검사(EGG) 접촉률(CQ, closed quotient): 치료 전 0.71 → 치료 후 0.52\\n• 청지각: 쥐어짜는 소리(S) 2 → 0\",\"q\":\"이 결과에 대한 해석으로 옳은 것은?\",\"choices\":[\"과도했던 성대 접촉이 완화되어 정상 범위에 가까워졌음을 뜻한다\",\"접촉률이 감소하였으므로 성문폐쇄부전이 새로 발생했음을 뜻한다\",\"EGG는 성문하압을 직접 측정하므로 호흡 지지가 감소한 것이다\",\"접촉률은 점막파동의 진폭을 나타내므로 점막 유연성이 줄어든 것이다\",\"접촉률 증가가 치료 목표였으므로 밀기 기법을 추가해야 한다\"],\"answer\":1,\"explain\":\"EGG 접촉률(CQ)은 성대 진동 한 주기에서 성대가 접촉(폐쇄)되어 있는 시간의 비율로, 과기능적 발성에서 높고 기식적 발성에서 낮다. 편안한 발성의 CQ는 대략 0.4~0.6 범위로 보고되므로 0.71에서 0.52로의 감소는 과도한 성대 접촉이 완화되어 정상 범위로 들어왔음을 의미하며, 청지각적 긴장성 감소와 부합한다. 0.52는 성문폐쇄부전을 뜻하는 낮은 값이 아니고, EGG는 목에 댄 전극으로 성대 접촉 면적 변화를 기록하는 검사이지 압력이나 점막파동 진폭을 측정하지 않는다. 과기능 환자에게 접촉률 증가는 목표가 아니며 밀기 기법은 금기에 가깝다. ※CQ 정상 범위는 기기·산출 방식(기준선 설정)에 따라 차이가 있음.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 47세 남성, 좌측 성대 중간부 폴립(우측 성대 정상)\\n• 거칠고 두 개의 음이 동시에 들리는 듯한 음성을 호소함\\n• 후두스트로보스코피: 좌우 성대의 진동이 비대칭적이고 불규칙함, 가성대 접근 없음\\n• 연인두 기능 정상\\n• 청지각: G2 R2 B1 A0 S1\",\"q\":\"이 환자에게서 두 개의 음이 동시에 들리는 현상(이중음성)을 가장 잘 설명하는 기전은?\",\"choices\":[\"성대 긴장이 높아져 기본주파수 자체가 상승하였다\",\"연인두 폐쇄부전으로 비강 공명이 함께 들린다\",\"가성대가 진성대와 함께 진동하여 낮은 음이 더해진다\",\"좌우 성대 질량 차이로 두 성대가 다른 주기로 진동한다\",\"성문이 완전히 닫히지 않아 기류 소음이 섞여 들린다\"],\"answer\":4,\"explain\":\"편측 폴립처럼 좌우 성대의 질량·긴장이 다르면 두 성대가 각자 다른 주기로 진동하거나 진동 주기가 두 배로 늘어나, 두 개의 음높이가 동시에 지각되는 이중음성과 거친 음질(R2)이 나타난다. 이는 성대 진동이 완전히 주기적이지 않다는 뜻으로, 스트로보스코피의 비대칭·불규칙 진동과 부합한다. ① 이중음성은 기본주파수 상승이 아니라 서로 다른 두 진동이 겹쳐 생기고, ② 연인두 기능은 정상이며, ③ 가성대 발성도 이중음성을 만들 수 있으나 이 환자는 가성대 접근이 없다. ⑤ 불완전한 성문 폐쇄에 의한 기류 소음은 기식성(B1)을 설명할 뿐 두 음이 동시에 들리는 현상을 설명하지 못한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 24세 트랜스젠더 남성, 테스토스테론 호르몬 치료 10개월째\\n• 습관적 F0: 치료 전 210 Hz → 현재 125 Hz\\n• 호소: 목소리가 낮아지긴 했으나 갈라지고 갑자기 높은 음이 튀어나오며, 조금만 말해도 목이 피로하고 조임\\n• 후두내시경: 병변 없음, 발성 시 전후 압축과 가성대 접근 관찰\",\"q\":\"이 사례에 대한 판단과 중재로 가장 적절한 것은?\",\"choices\":[\"음도가 남성 범위에 못 미치므로 제III형 갑상성형술을 의뢰한다\",\"새 음도의 안정화와 과기능 감소를 목표로 음성치료를 실시한다\",\"여성 음성이 남아 있으므로 흉성 공명 강화를 위해 밀기 기법을 훈련한다\",\"호르몬 부작용에 의한 증상이므로 테스토스테론 중단을 권한다\",\"가성구 발성을 집중 훈련하여 음도 급변을 없애도록 한다\"],\"answer\":2,\"explain\":\"테스토스테론은 성대의 질량과 두께를 늘려 트랜스젠더 남성의 음도를 대개 남성 범위로 낮추므로, 트랜스젠더 여성과 달리 음도 자체를 바꾸는 수술은 보통 필요하지 않다(125 Hz는 성인 남성 범위). 문제는 변화한 후두에 맞는 발성 조절을 아직 익히지 못해 생기는 음도 불안정(갈라짐, 음도 급변)과 이를 보상하려는 과기능(전후 압축, 가성대 접근, 피로)이며, 이는 음성치료의 영역이다. 제III형 갑상성형술은 음도를 더 낮추는 수술로 적응증이 아니고, 밀기 기법은 과기능을 악화시키며, 호르몬 중단 권고는 언어재활사의 역할을 벗어나고, 가성구 훈련은 낮은 음도 안정화와 반대 방향이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 생후 4개월 영아, 동맥관개존증(PDA) 결찰술 후 울음소리가 약하고 쉬었으며, 수유 중 기침과 사레가 잦음\\n• 후두내시경: 좌측 성대가 부정중위에서 움직이지 않음, 우측 성대 운동 정상\\n• 체중 증가가 느려 부모가 걱정함\",\"q\":\"이 영아의 관리 계획으로 가장 적절한 것은?\",\"choices\":[\"성문을 닫아 흡인을 막도록 즉시 제I형 갑상성형술을 의뢰한다\",\"울음 강화를 위해 밀기 기법을 부모에게 교육하여 시행한다\",\"편측 마비이므로 기도 확보를 위해 기관절개술을 의뢰한다\",\"음성 문제는 성인이 된 뒤 치료하면 되므로 그대로 퇴원시킨다\",\"삼킴 평가와 안전한 수유 관리를 하며 성대 운동을 추적한다\"],\"answer\":5,\"explain\":\"좌측 되돌이후두신경은 대동맥궁 아래를 돌아 올라오므로 동맥관 결찰술 중 손상되기 쉽고, 영아에서 편측 성대마비는 약한 울음보다 흡인과 수유 곤란·체중 증가 지연이 더 시급한 문제이다. 따라서 우선 기기적 삼킴 평가로 흡인 여부를 확인하고 수유 전략과 영양을 관리해야 하며, 신경 손상은 수개월~1년 이상에 걸쳐 회복될 수 있으므로 성대 운동을 추적 관찰하고 영구 수술은 보류한다. 갑상성형술은 성장 중인 영아의 후두에 시행하지 않으며, 밀기 기법은 영아에게 적용할 수 없고, 편측 마비는 기도 폐쇄를 일으키지 않아 기관절개술의 적응증이 아니다. 흡인 위험을 방치한 채 퇴원시키는 것은 위험하다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"[그림 1]은 7세 아동의 순음청력검사 결과이다(우측 귀는 반대 귀를 차폐한 역치, 좌측 귀는 비차폐 역치, 헤드폰 검사).\",\"q\":\"[그림 1]에 대한 설명으로 옳은 것은?\",\"choices\":[\"왼쪽 귀의 3분법 기도 청력역치는 40 dB HL로 중등도 난청이다\",\"오른쪽 귀는 혼합성, 왼쪽 귀는 고주파수 경사형 감각신경성 난청이다\",\"오른쪽 귀는 기도-골도 차가 없으므로 감각신경성 난청으로 본다\",\"오른쪽 귀 기도 검사에서는 교차청취 우려가 없어 차폐가 필요하지 않다\",\"오른쪽 귀의 3분법 기도 청력역치는 55 dB HL로 중등도 난청이다\"],\"answer\":2,\"explain\":\"그림에서 읽은 값 — 오른쪽 기도(△, 차폐): 250 Hz 55, 500 Hz 60, 1 kHz 65, 2 kHz 70, 4 kHz 75, 8 kHz 80 dB HL / 오른쪽 골도([, 차폐): 500 Hz 35, 1 kHz 40, 2 kHz 45, 4 kHz 55 / 왼쪽 기도(X): 250 Hz 10, 500 Hz 15, 1 kHz 20, 2 kHz 40, 4 kHz 65, 8 kHz 75 / 왼쪽 골도(>): 500 Hz 15, 1 kHz 20, 2 kHz 40, 4 kHz 60. 오른쪽은 골도 자체가 상승(3분법 골도 (35+40+45)/3=40)하면서 기도-골도 차가 25 dB로 10 dB 이상 존재하므로 혼합성 난청이고, 왼쪽은 기도·골도가 거의 일치(차 0~5 dB)하며 2 kHz 이상에서 급격히 나빠지는 고주파수 경사형 감각신경성 난청이다(②). 3분법 기도역치는 오른쪽 (60+65+70)/3=65 dB HL(중등고도), 왼쪽 (15+20+40)/3=25 dB HL(경도)이므로 ①·⑤는 틀리다. ③은 기골도차 25 dB가 있어 틀리다. ④ 헤드폰 기도검사에서 검사 귀 기도역치와 반대 귀 골도역치의 차가 이간감쇠(약 40 dB) 이상이면 교차청취가 일어날 수 있다. 오른쪽 500 Hz 기도 60 − 왼쪽 골도 15 = 45 dB이므로 차폐가 필요했고, 그래서 오른쪽은 왼쪽 귀를 차폐한 역치로 기록되었다. 골도는 이간감쇠가 거의 0이어서 비차폐로는 어느 귀가 반응했는지 알 수 없으므로, 오른쪽의 혼합성 판단은 차폐한 골도역치를 근거로 한다. ※ 이간감쇠 기준(헤드폰 40 dB, 삽입형 이어폰은 더 큼)과 난청 정도 분류 절단점은 교재에 따라 다를 수 있음.\",\"image\":\"data:image/svg+xml;base64,\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아의 낱말검사 전사 자료(목표 낱말 /표준 발음/ → 아동 발화)\\n김밥 /kimp*ap̚/ → [kiba]\\n연필 /jʌnpʰil/ → [jʌpʰil]\\n장갑 /tɕaŋgap̚/ → [tɕaŋga]\\n손톱 /sontʰop̚/ → [sontʰo]\\n풍선 /pʰuŋsʌn/ → [pʰusʌn]\\n바지 /padʑi/ → [padʑi]\",\"q\":\"위 자료에서 종성생략의 출현율은? (출현율 = 음운변동 출현 횟수 ÷ 출현 기회 수 × 100)\",\"choices\":[\"5/10 × 100\",\"5/12 × 100\",\"6/10 × 100\",\"6/12 × 100\",\"7/12 × 100\"],\"answer\":3,\"explain\":\"종성생략의 출현 기회는 목표 낱말에 종성이 있는 자리의 수이다. 김밥(ㅁ, ㅂ)·연필(ㄴ, ㄹ)·장갑(ㅇ, ㅂ)·손톱(ㄴ, ㅂ)·풍선(ㅇ, ㄴ) 각 2개, 바지 0개로 총 10개이다(김밥은 표준 발음 /kimp*ap̚/에서도 종성이 /m/, /p̚/ 두 개). 실제 생략은 [kiba](/m/, /p̚/ 2회), [jʌpʰil](/n/ 1회), [tɕaŋga](/p̚/ 1회), [sontʰo](/p̚/ 1회), [pʰusʌn](/ŋ/ 1회)로 총 6회이므로 출현율은 6/10 × 100 = 60%이다. 분모를 12로 둔 보기는 종성이 없는 '바지'까지 기회로 잘못 계산한 것이고, 5/10은 [kiba]의 이중 생략을 1회로 센 오류이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아의 문장 따라말하기\\n목표 문장: 고구마 캐러 갔다가 개구리 잡았어요\\n표준 발음: /koguma kʰɛɾʌ kat̚t*aga kɛguɾi tɕabas*ʌjo/\\n아동 발화: [toduma kʰɛɾʌ tat̚t*aga kɛduɾi tɕabat*ʌjo]\",\"q\":\"위 발화에서 연구개 파열음(/ㄱ, ㄲ, ㅋ/)의 정확도는?\",\"choices\":[\"3/7 × 100\",\"4/7 × 100\",\"3/8 × 100\",\"4/8 × 100\",\"2/7 × 100\"],\"answer\":1,\"explain\":\"목표 문장의 연구개 파열음은 고/k/·구/g/·캐/kʰ/·갔/k/·가/g/·개/k/·구/g/의 7개이다(표준 발음 /kat̚t*aga/의 /t*/는 경음화된 치조음, /tɕabas*ʌjo/의 /s*/는 치조 마찰음이므로 연구개음이 아니다). 아동은 [toduma]에서 2개, [tat̚t*aga]에서 첫 /k/ 1개, [kɛduɾi]에서 /g/ 1개를 치조음 [t, d]로 전방화하여 총 4개 오류이고, 캐[kʰ]·가[g]·개[k] 3개는 정확하므로 3/7 × 100이다. [tɕabat*ʌjo]의 /s*/→[t*] 파열음화는 연구개음 정확도와 무관하다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"두 아동의 낱말 전사 자료\\n목표 낱말 → 아동 A / 아동 B\\n다리 [taɾi] → [paɾi] / [kaɾi]\\n두부 [tubu] → [pubu] / [kubu]\\n나비 [nabi] → [mabi] / [ŋabi]\\n언니 [ʌnni] → [ʌmmi] / [ʌŋŋi]\",\"q\":\"두 아동의 오류에서 공통적으로 상실된 변별자질은?\",\"choices\":[\"[+전방성]\",\"[+비음성]\",\"[+지속성]\",\"[+설정성]\",\"[+긴장성]\"],\"answer\":4,\"explain\":\"아동 A는 치경음 /ㄷ, ㄴ/을 양순음 [ㅂ, ㅁ]으로, 아동 B는 같은 치경음을 연구개음 [ㄱ, ŋ]으로 대치한다. 치경음은 혀끝·혓날로 조음되는 [+설정성(coronal)] 음인데 양순음과 연구개음은 모두 [−설정성]이므로 두 아동이 공통으로 잃은 자질은 설정성이다. [+전방성]은 아동 B(연구개음, [−전방성])만 상실했고 아동 A의 양순음은 [+전방성]을 유지한다. 비음성은 두 아동 모두 /ㄴ/→비음으로 유지되었고, 지속성·긴장성(파열음·평음 유지)도 변화가 없다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"7세 남아 두 명의 말 평가 소견\\n아동 A: 같은 낱말의 자음·모음 오류가 매번 다르고, 낱말이 길어질수록 오류가 급증하며, 발화 전 입 모양을 더듬는 모색행동과 균등한 강세가 관찰됨. 혀·입술 근력과 반사는 정상\\n아동 B: 모든 음소가 일관되게 약하고 부정확(왜곡)하며, 과다비성·침 흘림·혀와 입술의 근력 저하가 있고 말속도가 느림\",\"q\":\"두 아동을 아동기 말실행증과 마비말장애로 감별할 때 근거로 옳은 것은?\",\"choices\":[\"아동 A는 근력 저하와 침 흘림이 있어 마비말장애, 아동 B는 오류가 일관되어 말실행증이다\",\"두 아동 모두 비일관적 오류와 느린 말속도를 보이므로 말실행증과 마비말장애를 감별할 수 없다\",\"아동 B가 /퍼터커/ 순서 오류만 보이고 /퍼퍼퍼/ 반복은 정상이면 마비말장애이다\",\"아동 A는 오류가 비일관적이고 근력이 정상이므로 소수 음소에 국한된 운동적 조음장애이다\",\"아동 A는 비일관성·모색행동으로 말실행증, 아동 B는 근력 저하·일관된 왜곡으로 마비말장애이다\"],\"answer\":5,\"explain\":\"아동기 말실행증은 신경근육 결함 없이 말운동의 계획·프로그래밍이 손상된 것으로 비일관적 자음·모음 오류, 발화 길이가 늘수록 오류 증가, 모색행동, 부적절한 운율(균등 강세)이 핵심 특징이다. 마비말장애는 신경근육 실행의 문제로 근력 저하·침 흘림·과다비성과 함께 모든 음소에 걸친 일관된 왜곡, 느린 말속도를 보인다. ①은 두 아동의 소견을 바꿔 기술했고, ②는 아동 B의 오류가 일관적이므로 틀리다. ③에서 /퍼터커/ 순서 오류는 있으나 단일 음절 반복은 정상인 양상은 순서화 결함인 말실행증에 가깝고, 마비말장애는 단일 음절 반복도 느리고 약하다. ④ 운동적 조음장애는 소수 음소의 일관된 오류가 특징이므로 아동 A와 맞지 않는다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 여아, 양측 심도 감각신경성 난청으로 2세에 양이 인공와우 이식. 최근 청능 평가\\n• Ling 6음 탐지·변별: 모두 가능\\n• 폐쇄형(그림 4장 제시) 낱말 확인: 90%\\n• 개방형(그림 없이 듣고 따라 말하기) 낱말 확인: 30%\\n• 짧은 이야기를 듣고 질문에 답하기: 거의 불가\",\"q\":\"청능훈련 위계에 따라 다음 단계로 적절한 활동은?\",\"choices\":[\"북소리와 종소리를 들려주고 소리가 났는지 안 났는지 손 들기\",\"'공'과 '곰' 그림 두 장을 보여 주고 들은 낱말의 그림 가리키기\",\"그림 없이 친숙한 낱말을 듣고 따라 말하며 범주 단서를 줄여 가기\",\"긴 이야기를 들려주고 등장인물과 사건을 순서대로 다시 말하기\",\"입 모양을 보고 낱말을 알아맞히는 독화 중심 연습으로 전환하기\"],\"answer\":3,\"explain\":\"청능훈련은 탐지 → 변별 → 확인 → 이해 순으로 진행하며, 확인 단계에서도 보기가 있는 폐쇄형에서 보기가 없는 개방형으로 난이도를 높인다. 이 아동은 탐지·변별과 폐쇄형 확인을 통과했으나 개방형 확인이 30%로 낮으므로, 보기 없이 낱말을 듣고 반응하는 개방형 확인 과제를 의미 범주 단서(예: '과일 이름이야')를 주었다가 점차 줄이며 훈련하는 것이 다음 단계이다. ①·②는 이미 통과한 탐지·폐쇄형 확인 수준, ④는 개방형 확인이 미완성인 상태에서 지나치게 어려운 이해 수준이며, ⑤는 청각 정보 처리를 훈련하는 청능훈련의 방향과 맞지 않는다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"8세 남아, 양측 고주파수 경사형 감각신경성 난청(2 kHz 이상 60~70 dB HL), 양측 보청기 착용\\n• /ㅅ, ㅆ, ㅊ/ 생략 또는 약화, '옷'·'빗'처럼 마찰음이 든 낱말 구별이 어려움\\n• /ㅁ, ㄴ, ㅂ, ㄷ/와 모음은 정확\\n• 청각 모델만 반복해 들려주어도 /ㅅ/ 산출이 개선되지 않음\\n• 구강 구조·운동 기능 정상\",\"q\":\"이 아동의 오류 원인 해석과 중재 방향으로 가장 적절한 것은?\",\"choices\":[\"고주파수 마찰음을 잘 듣지 못한 오류로 보고 보청기 점검과 시각·촉각 단서를 병행한다\",\"마찰음의 파열음화가 지속된 음운지연이므로 최소대립쌍 변별 훈련만 실시한다\",\"혀 근력 부족으로 인한 조음장애이므로 비구어 구강운동 훈련을 먼저 충분히 실시한다\",\"저주파수 음소인 비음부터 다시 훈련하여 청각적 자신감을 높인 뒤 마찰음으로 넘어간다\",\"청각 단서를 더 크게 반복 제시하면 충분하므로 보청기 조정은 따로 필요하지 않다\"],\"answer\":1,\"explain\":\"/ㅅ, ㅆ, ㅊ/의 마찰 소음은 4~8 kHz의 고주파수에 에너지가 집중되어 있어 고주파수 손실이 큰 아동은 보청기를 착용해도 이 소리를 충분히 듣지 못하며, 그 결과 저주파수 에너지가 큰 비음·파열음·모음은 정확한데 마찰음만 생략·약화되는 양상이 나타난다. 청각 모델 반복이 효과가 없는 것도 같은 이유이다. 따라서 보청기 적합 상태(고주파수 이득, 주파수 하향 변환 기능)를 청각사에게 점검 의뢰하고, 청각으로 접근이 어려운 소리는 시각·촉각 단서로 산출을 확립하는 것이 적절하다. ②는 청력 손실이라는 원인을 무시한 해석이고, ③ 구강 기능 정상, ④ 이미 정확한 비음 훈련은 불필요, ⑤는 청각 접근 자체가 제한된 상황에서 효과가 없다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아, 구개열 병력 없음, 구강 구조 정상\\n• /ㅅ, ㅆ/ 산출 시에만 콧구멍에서 기류가 새고 비강 마찰 소음이 들림\\n• 파열음·파찰음·/ㅎ/와 모음에서는 비강누출·과다비성 없음\\n• 나조미터 구강문장 비음치 정상 범위\\n• 코를 손으로 막고 /ㅅ/를 산출하게 하면 정조음 가능\",\"q\":\"이 아동에 대한 판단과 조치로 가장 적절한 것은?\",\"choices\":[\"연인두폐쇄부전이 확실하므로 인두피판술을 위해 성형외과에 의뢰한다\",\"음소특정적 비강누출로 보고 구강 기류를 유도하는 조음치료를 실시한다\",\"과소비성이므로 비음이 든 낱말로 비음 산출 훈련을 먼저 실시한다\",\"구개거상기를 제작하여 착용시킨 뒤 /ㅅ/ 계열 조음치료를 시작한다\",\"청력 손실에 의한 마찰음 왜곡이므로 청력검사 결과가 나올 때까지 치료를 보류한다\"],\"answer\":2,\"explain\":\"비강누출이 특정 음소(/ㅅ, ㅆ/)에서만 나타나고 다른 압력자음과 모음은 정상이며 비음치도 정상이라면, 구조적 연인두폐쇄부전이 아니라 해당 음소를 비강 마찰음(인두·비강 통로)으로 잘못 학습한 음소특정적 비강누출이다. 이는 기질적 문제가 아니라 학습된 오조음이므로 수술(①)·구개거상기(④) 대상이 아니고, 코를 막았을 때 정조음이 가능하다는 점이 구강 기류 유도 조음치료의 근거가 된다. ③ 과다비성·과소비성이 아니며, ⑤ 다른 고주파수 음소가 정상이고 소견이 학습된 오류에 부합하므로 치료를 보류할 이유가 없다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"생후 14개월 여아, 편측 완전 구순구개열로 3개월에 구순성형술, 12개월에 구개성형술을 받음\\n• 옹알이에서 [ʔaʔa], [hã], [mama] 위주로 산출하고 구강 파열음은 거의 나타나지 않음\\n• 반복성 중이염 병력이 있으나 현재 환기관 삽입 상태로 청력 정상\\n• 부모가 '말이 늦을까 봐' 걱정하며 상담을 요청함\",\"q\":\"이 시기의 중재 목표로 가장 적절한 것은?\",\"choices\":[\"비인두내시경으로 연인두 기능을 먼저 평가하고 그때까지 중재를 보류한다\",\"/ㅅ, ㅈ/ 등 후기 발달음을 독립음 수준에서 반복하여 따라 말하게 한다\",\"성문파열음도 발성 시도이므로 그대로 강화하여 발화량을 늘린다\",\"부모 교육으로 놀이 중 구강 앞쪽 파열음이 든 초기 낱말을 모델링·강화한다\",\"과다비성 감소를 위해 구개거상기를 제작하여 가정에서 착용시킨다\"],\"answer\":4,\"explain\":\"구개성형술 직후의 영아기 중재 목표는 구강 압력자음(특히 양순·치경 파열음)이 옹알이와 초기 낱말에 출현하도록 부모 중심의 모델링과 놀이로 촉진하고(예: [바바], [빠], [마마], [두] 같은 초기 낱말), 수술 전에 형성되기 쉬운 성문파열음 등 보상조음이 굳어지지 않게 하는 것이다. ① 이 연령에서는 협조가 어렵고 발화 표본이 충분히 쌓인 뒤(대개 3세 전후) 연인두 기능을 평가하므로 중재를 보류할 이유가 없다. ② 14개월에게 후기 발달음 독립음 훈련은 발달적으로 부적절하다. ③ 성문파열음을 강화하면 보상조음이 습관화된다. ⑤ 과다비성이 확인되지 않았고 영아에게 구개거상기는 적용하지 않는다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"9세 남아, 어두 /ㄹ/(탄설음) 왜곡. 12회기 치료 후\\n• 독립음·음절·낱말 수준 정확도 95% 이상(치료사가 매 시행마다 즉각 피드백)\\n• 매 회기 같은 낱말 목록을 같은 순서로 반복 연습함\\n• 문장·대화 수준 정확도 35%, 가정에서도 오류 지속\",\"q\":\"운동학습 원리에 근거하여 이 단계의 연습 조건을 수정한 것으로 가장 적절한 것은?\",\"choices\":[\"같은 낱말 목록을 더 많이 반복하고 매 시행 즉각 피드백을 유지한다\",\"낱말 연습을 중단하고 독립음 수준으로 돌아가 정확도를 100%로 만든다\",\"시각·촉각 단서를 늘려 낱말 수준의 정확도를 100%까지 더 높인다\",\"치료사가 혀끝 위치를 매 시행 설명하는 수행 지식(KP) 피드백을 늘린다\",\"여러 낱말·문맥을 무작위로 섞어 연습하고 KR 피드백 빈도를 줄인다\"],\"answer\":5,\"explain\":\"운동학습 원리에서 구획(blocked)·일정(constant) 연습과 빈번한 즉각 피드백·수행 지식(KP)은 습득(확립) 단계의 수행은 높이지만 파지·전이는 오히려 저해한다. 이미 낱말 수준에서 95% 이상 확립된 아동이 문장·대화로 일반화되지 않는다면, 무작위(random)·변동(variable) 연습으로 여러 낱말·문맥·과제를 섞고 피드백은 결과 지식(KR) 위주로 빈도를 낮추고 지연시켜 아동이 스스로 오류를 탐지·수정하게 해야 전이가 촉진된다. ①·④는 습득기 조건을 유지·강화하는 것이고, ②·③은 이미 확립된 단계로 되돌아가거나 단서 의존을 높여 일반화를 늦춘다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아, 자음정확도 45%\\n• 산출 자음 목록: /ㅁ, ㄴ, ㅇ, ㅂ, ㅃ, ㄷ, ㄸ, ㄱ, ㄲ/\\n• 미습득 음소: /ㅍ, ㅌ, ㅋ, ㅅ, ㅆ, ㅈ, ㅉ, ㅊ, ㅎ, ㄹ/\\n• 여러 음소가 [ㄷ] 또는 [ㅂ]로 붕괴됨\",\"q\":\"최대대립(maximal opposition)·빈 집합(empty set) 원리에 따라 대립쌍을 선정할 때 가장 적절한 것은?\",\"choices\":[\"'살–달': 미습득 /ㅅ/와 습득 /ㄷ/의 자질 차이를 최소로 한 쌍\",\"'사–싸': 둘 다 미습득이지만 긴장성 자질 하나만 다른 쌍\",\"'코–소': 둘 다 미습득이고 위치·방법·기식성이 모두 다른 쌍\",\"'방–망': 이미 습득한 두 음소로 비음성 대조를 확인하는 쌍\",\"'토–코': 둘 다 미습득이지만 조음위치 자질 하나만 다른 쌍\"],\"answer\":3,\"explain\":\"최대대립 접근은 아동이 모르는 음소를 목표로 하되 대립하는 두 음소가 조음위치·조음방법·발성유형 등 여러 자질(가능하면 주요 부류까지)에서 최대한 다른 쌍을 사용하며, 특히 빈 집합(empty set)은 두 음소 모두 아동의 목록에 없는 쌍을 대조하여 음운 체계 전반의 재구조화와 폭넓은 일반화를 노린다. '코–소'는 /ㅋ/(연구개 파열 격음)와 /ㅅ/(치경 마찰 평음)가 모두 미습득이면서 위치·방법·기식성이 모두 다르므로 가장 부합한다. ①은 최소대립쌍 논리이고, ②·⑤는 둘 다 미습득이지만 자질 차이가 하나뿐이며, ④는 이미 습득한 음소끼리의 쌍이어서 치료 목표가 되지 않는다. ※ 최대대립·빈 집합의 정의와 자질 수 기준은 교재에 따라 표기가 다를 수 있음.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 6개월 남아, 청력·구강 구조·언어 이해 정상\\n• 어두 초성 생략(사과→[아과], 나비→[아비])과 치경음의 후방화(다리→[가리], 두부→[구부])가 모든 낱말에서 일관되게 나타남\\n• 같은 낱말 25개를 3회 산출했을 때 변이율 8%\\n• 모색행동·운율 이상 없음, 교대운동속도 정상\",\"q\":\"Dodd의 분류에 따른 유형과 그에 적합한 중재 접근은?\",\"choices\":[\"음운지연 – 발달 순서에 따른 전통적 조음 훈련\",\"일관적 음운장애 – 최소대립쌍 등 음운 대조 접근\",\"비일관적 음운장애 – 핵심어휘 접근으로 일관성 확립\",\"조음장애 – 조음점 지시법으로 개별 음소의 운동을 확립\",\"아동기 말실행증 – 촉각 단서 기반 PROMPT 훈련\"],\"answer\":2,\"explain\":\"어두 초성 생략과 후방화는 정상 발달에서 거의 나타나지 않는 비발달적(비전형적) 오류패턴이고, 변이율 8%로 일관되며 운동 결함이 없으므로 Dodd 분류의 일관적 음운장애이다. 이 유형은 음운 규칙(대조) 체계의 문제이므로 최소대립쌍·상위음운 접근 등 음운 대조 접근이 적합하다. ① 음운지연은 발달적 패턴이 늦게까지 남는 것, ③ 비일관적 음운장애는 변이율 40% 이상일 때, ④ 조음장애는 소수 음소의 일관된 왜곡, ⑤ 말실행증은 비일관성·모색·운율 이상을 동반할 때 해당한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아, 아동기 말실행증 진단\\n• 산출 가능 자음 /ㅁ, ㅂ, ㄷ/, 모음 왜곡 다수\\n• 2음절 이상 낱말에서 음절 순서 오류·모색행동\\n• 자극반응도: 치료사와 동시에 천천히 말하면 [바], [마]는 산출 가능\",\"q\":\"동적 시간·촉각 단서법(DTTC)의 원리에 따른 중재 절차로 옳은 것은?\",\"choices\":[\"기능적 낱말을 동시 산출에서 시작해 단서를 점차 줄이며 집중 반복한다\",\"음운변동별 목표를 주기마다 순환하며 청각적 자극을 제공한다\",\"'말–발'과 같은 최소대립쌍의 의미 대조를 통해 음운 체계를 재구조화한다\",\"빨대 불기·혀 내밀기 등 비구어 구강운동으로 근력을 키운 뒤 말소리 훈련을 시작한다\",\"말소리 자질 개념(긴 소리/짧은 소리)을 상위언어적으로 인식시킨 뒤 산출로 넘어간다\"],\"answer\":1,\"explain\":\"DTTC(Strand)는 운동학습 원리에 기반한 말실행증 중재로, 통합자극(동시 산출)에서 시작해 아동의 수행에 따라 촉각·시각·청각 단서와 속도를 동적으로 조절하고, 직접 모방→지연 모방→자발 산출로 단서를 점차 소거하면서 자연스러운 속도·운율을 회복시키며, 소수의 기능적 목표를 집중적으로 많은 시행 반복하는 것이 핵심이다. ②는 주기법, ③은 최소대립쌍 접근, ⑤는 상위음운 접근으로 음운 체계 문제에 쓰는 방법이며, ④ 비구어 구강운동은 근력 결함이 없는 말실행증에 근거가 없다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 남아, 어두 /ㅅ/→[ㄷ] 대치. 표준화 낱말검사에는 /ㅅ/ 검사 낱말이 3개뿐이어서 촉진 문맥을 확인할 수 없었다.\",\"q\":\"촉진 문맥을 찾기 위한 심층검사(문맥검사) 자극 구성으로 가장 적절한 것은?\",\"choices\":[\"'사자, 사과, 사탕'처럼 /ㅏ/ 모음 앞 어두 문맥만 10회 반복 유도\",\"사자–자자 최소대립쌍을 듣고 같은지 다른지 판단하는 변별 과제\",\"긴 문장을 따라 말하게 하여 자발화에 가까운 /ㅅ/ 산출을 관찰\",\"인접 모음과 낱말 내 위치를 체계적으로 바꾼 음절·낱말을 반복 유도\",\"/ㅅ/를 독립음으로 길게 산출하게 하고 마찰 지속시간을 측정\"],\"answer\":4,\"explain\":\"문맥검사(심층검사)는 목표음이 정조음되는 촉진 문맥을 찾기 위해 인접 모음, 낱말 내 위치(어두·어중·연음 환경), 선행·후행 자음 등 음성 문맥을 체계적으로 변화시킨 다수의 자극으로 목표음을 반복 유도하는 검사이다(예: '사·시·수·세·소', '아사·이시·우수·에세·오소', '옷을·빗이'(연음)). ①은 한 문맥만 반복하므로 문맥 간 비교가 불가능하고, ②는 산출이 아닌 지각 검사, ③은 문맥 통제가 되지 않으며, ⑤는 독립음 지속시간 측정으로 문맥 효과와 무관하다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"2세 2개월 남아의 자발화 표본(부모 보고 및 관찰)\\n[마], [마마], [빠], [바바], [뿌], [암], [빠빠], [무], [아빠], [엄마]\\n(부모가 알아들은 의도: 엄마, 밥, 물, 아빠, 안아 등)\",\"q\":\"독립분석(independent analysis)의 결과로 옳은 것은?\",\"choices\":[\"종성생략이 대부분의 낱말에서 나타난다\",\"자음정확도(PCC)는 약 80%이다\",\"연구개음 전방화가 일관되게 나타난다\",\"치경음 /ㄷ, ㄴ/이 초성 목록에 포함된다\",\"초성 자음 목록은 양순음으로 제한된다\"],\"answer\":5,\"explain\":\"독립분석은 성인 목표형과 비교하지 않고 아동이 실제 산출한 말소리 목록과 음절구조를 그 자체로 기술한다. 표본에서 초성 자음은 [ㅁ, ㅂ, ㅃ]뿐이고 종성은 [암], [엄마]의 /ㅁ/만 나타나며, 음절구조는 CV([마], [빠], [뿌], [무]), VC([암]), CVCV([마마], [바바], [빠빠]), VCV([아빠]), VCCV([엄마])로 제한된다. ①·②·③은 목표형과 비교해야 알 수 있는 관계분석 항목이고, ④ 치경음은 표본에 전혀 나타나지 않는다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 여아. '가위', '고기', '거울'에서 /ㄱ/을 정조음한다.\",\"q\":\"다음 오류 가운데 동화(assimilation)로 분석해야 하는 것은?\",\"choices\":[\"가방 /kabaŋ/ → [pabaŋ]\",\"토끼 /tʰok*i/ → [tok*i]\",\"시소 /ɕiso/ → [tido]\",\"라면 /ɾamjʌn/ → [jamjʌn]\",\"책 /tɕʰɛk̚/ → [tɕʰɛ]\"],\"answer\":1,\"explain\":\"동화는 낱말 안의 다른 소리의 영향을 받아 목표음이 그 소리와 같거나 비슷하게 바뀌는 문맥 의존적 오류이다. '가방 /kabaŋ/→[pabaŋ]'은 뒤에 오는 양순음 /b/의 영향으로 /k/가 [p]로 바뀐 역행 양순음 동화이며, 아동이 '가위·고기·거울'에서는 /ㄱ/을 정조음한다는 점이 문맥에 의한 동화임을 뒷받침한다. ②는 격음→평음의 탈기식음화, ③은 마찰음의 파열음화(낱말 안에 영향을 줄 파열음이 없음), ④는 유음의 활음화, ⑤는 종성생략으로 모두 문맥과 무관한 대치·생략 변동이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"3세 남아, 양측 중등고도(65~70 dB HL) 감각신경성 난청. 보청기 착용 6개월\\n• 보청 상태 음장 역치: 전 주파수 25~30 dB HL\\n• Ling 6음 탐지·확인 모두 가능, 보청기 착용 후 낱말 산출이 빠르게 증가\\n• 부모가 인공와우 수술을 받아야 하는지 문의함\",\"q\":\"언어재활사의 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"심도 난청이 아니어도 3세 이전 조기 이식이 원칙이므로 즉시 수술을 권한다\",\"보청기 이득이 충분하므로 현재 중재를 지속하며 청력과 발달을 추적한다\",\"보청기 이득이 확인되었으므로 청능훈련은 종결하고 조음치료만 진행한다\",\"감각신경성 난청은 보청기 효과가 없으므로 골도 보청기로 교체한다\",\"한쪽 귀만 인공와우를 이식하고 반대쪽 귀의 보청기는 제거하도록 한다\"],\"answer\":2,\"explain\":\"인공와우는 일반적으로 양측 고도~심도 감각신경성 난청이면서 적절한 보청기 착용에도 말소리 접근·청능 발달 이득이 제한적일 때 적응증이 된다. 이 아동은 중등고도 난청이지만 보청 역치가 말소리 범위(25~30 dB HL)에 들어오고 Ling 6음 확인과 낱말 산출이 빠르게 늘고 있으므로 보청기 이득이 충분하다. 따라서 보청기와 청능·언어 중재를 지속하며 청력 변동(진행성 여부)과 발달을 추적하는 것이 적절하고, 최종 판단은 이비인후과·청각사와 협진한다. ①·⑤는 적응증 미충족, ③ 청능훈련은 이득이 있어도 지속해야 하며, ④ 골도 보청기는 전음성·편측 난청 등에 쓰이고 감각신경성 난청도 기도 보청기 효과가 있다. ※ 인공와우 적응증의 세부 역치 기준(국내 급여 기준 등)은 시기·기관에 따라 다를 수 있음.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 여아, 인공와우 착용 3년, 개방형 문장 지각 80%\\n• /ㅅ/를 [ʃ]에 가깝게 왜곡, /ㅈ/를 [ㄷ]로 대치\\n• 치료사가 입 모양을 보여 주면 정조음하지만 청각 자극만 주면 오류가 지속됨\\n• 자신의 산출 오류를 듣고 알아채지 못함\",\"q\":\"청각 활용(auditory-verbal) 원리에 따른 중재로 가장 적절한 것은?\",\"choices\":[\"매 시행 입 모양 시범을 먼저 제시하여 정확도를 빠르게 높인다\",\"청각 단서를 배제하고 촉각 단서만 사용하여 조음 위치를 익힌다\",\"독화(입술 읽기) 훈련을 병행하여 부족한 청각 지각을 보완한다\",\"청각 단서를 우선 제시하고 청각 자기 모니터링을 훈련한다\",\"왜곡 오류는 명료도에 영향이 적으므로 /ㅈ/ 대치만 치료한다\"],\"answer\":4,\"explain\":\"인공와우로 개방형 문장 지각이 80%에 이르는 아동은 청각 경로로 말소리를 학습할 수 있으므로, 청각 활용 원리에 따라 청각 단서를 우선 제시하고(음향적 강조) 시각·촉각 단서는 보조적으로 잠시만 사용한 뒤 다시 청각 단서로 돌아가야 청각 피드백에 기반한 자기 모니터링이 발달한다. 이 아동은 시각 단서에 의존하고 자기 오류를 듣지 못하므로 청각 자기 모니터링 훈련이 특히 필요하다. ①·③은 시각 의존을 강화하고, ②는 잘 발달한 청각 경로를 버리는 것이며, ⑤ /ㅅ/ 왜곡도 청각 피드백을 활용해 수정할 수 있는 목표이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 남아, 어두 /ㄱ/ 전방화. 확립 단계 치료계획서를 작성하려 한다.\",\"q\":\"측정 가능한 단기 행동목표로 가장 적절하게 진술된 것은?\",\"choices\":[\"아동은 치료 후 /ㄱ/ 소리를 여러 낱말에서 잘 낼 수 있다\",\"아동은 연구개음 /ㄱ/의 조음 위치와 조음 방법을 이해한다\",\"아동은 청각 모델 후 어두 /ㄱ/ 낱말을 3회기 연속 80% 이상 정조음한다\",\"치료사는 거울과 설압자를 이용하여 아동에게 /ㄱ/의 조음점을 지시한다\",\"아동은 가정과 학교의 대화 상황에서 /ㄱ/ 오류를 보이지 않는다\"],\"answer\":3,\"explain\":\"행동목표는 수행 주체(아동), 관찰 가능한 행동(정조음), 조건(청각 모델 후, 어두 /ㄱ/ 낱말), 준거(3회기 연속 80% 이상)를 포함해야 측정·판정이 가능하다. ①·②는 '잘', '이해'처럼 관찰·측정할 수 없고, ④는 아동의 행동이 아닌 치료사의 활동이며, ⑤는 측정 기준(몇 회, 몇 %)이 불분명하고, 확립 단계가 아닌 일반화 단계의 장기목표 수준 진술이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"11세 남아, /ㅅ, ㅆ/ 치간음화 왜곡 잔존(다른 음소 정상). 청각 변별은 정상이나 자신의 산출을 조절하지 못해 실시간 스펙트로그램 시각 피드백을 도입하려 한다.\",\"q\":\"피드백 화면에서 아동에게 목표로 제시할 음향 지표로 가장 적절한 것은?\",\"choices\":[\"모음의 제1·제2 포먼트 위치\",\"기본주파수(F0)의 높이\",\"파열음의 성대진동 시작시간(VOT)\",\"마찰 구간을 포함한 음절 지속시간\",\"마찰 소음의 에너지 집중 주파수 대역\"],\"answer\":5,\"explain\":\"정상 /ㅅ, ㅆ/는 혀끝이 치조에 좁은 틈을 만들어 4 kHz 이상 고주파수에 에너지가 집중된 마찰 소음을 만든다. 혀가 앞니 사이로 나오는 치간음화는 마찰 소음의 에너지가 낮은 주파수로 분산·약화되므로, 스펙트로그램에서 마찰 구간 소음 에너지가 고주파수 대역에 집중되도록 시각 목표를 제시하는 것이 적절하다. 포먼트(①)는 모음·유음 왜곡, F0(②)는 음도, VOT(③)는 파열음 발성유형, 지속시간(④)은 말속도·운율 피드백에 해당한다. ※ 마찰 소음의 구체적 주파수 기준값은 화자·교재에 따라 다를 수 있음.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"4세 9개월 여아, /ㅈ/→[ㄷ], /ㅋ/→[ㄷ] 오류. 자극반응도 검사 결과\\n• /ㅈ/: 독립음·음절·낱말 수준 모두 모방 불가(시각·촉각 단서를 주어도 불가)\\n• /ㅋ/: 독립음 모방 가능, 음절 '카'·'쿠'는 청각+시각 단서로 가능, 낱말 수준은 불가\",\"q\":\"자극반응도 결과의 해석과 활용으로 옳은 것은?\",\"choices\":[\"/ㅋ/는 음절 수준부터 확립하고, /ㅈ/는 조음 위치·방법 지시부터 시작한다\",\"/ㅈ/는 자극반응도가 없으므로 자연 회복 가능성이 높아 치료에서 제외한다\",\"자극반응도는 낱말 수준에서만 평가하므로 두 음소 모두 자극반응도가 없다\",\"/ㅋ/는 낱말 수준에서 산출하지 못하므로 자극반응도가 없다고 판정한다\",\"자극반응도가 있는 /ㅋ/는 저절로 습득되므로 /ㅈ/만 치료 목표로 삼는다\"],\"answer\":1,\"explain\":\"자극반응도는 독립음·음절·낱말 등 여러 수준에서 단서·모방 조건으로 평가하며, 어느 수준에서든 산출이 가능하면 자극반응도가 있다고 본다. /ㅋ/는 음절 수준까지 가능하므로 예후가 좋고 가능한 수준에서 단서를 소거하며 빠르게 확립할 수 있다. 자극반응도가 없는 /ㅈ/는 자연 회복 가능성이 낮아 치료가 필요하고, 모방이 되지 않으므로 청지각 훈련과 조음점 지시 등 직접적 확립 절차부터 시작한다. ②는 자극반응도와 자연 회복의 관계를 반대로 기술했고, ③·④는 평가 수준을 잘못 제한했으며, ⑤ 자극반응도가 있어도 반드시 저절로 습득되는 것은 아니다. ※ 자극반응도가 없는 음소를 먼저 목표로 하는 복잡성 접근의 논리도 있으나, 자극반응도가 있는 음소를 치료 대상에서 제외하는 것은 어느 접근에서도 타당하지 않음.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 4개월 남아(취학 전)\\n• /ㅅ, ㅈ/의 파열음화가 지속되고 낱말 수준 정확도 50%\\n• 음운인식 평가: 음절 수 세기·음절 합성은 가능, 첫소리 변별('사'와 '다'의 첫소리가 같은가)·음소 탈락은 불가\\n• 부모는 입학 전 읽기 준비를 걱정함\",\"q\":\"말소리 산출과 읽기 준비를 함께 고려한 중재로 가장 적절한 것은?\",\"choices\":[\"읽기 문제는 별개이므로 조음치료를 종결한 뒤 음운인식 훈련을 시작한다\",\"/ㅅ, ㅈ/가 든 낱말로 첫소리 변별 활동과 산출 연습을 결합한다\",\"음절 수 세기 활동만 반복하여 음운인식의 기초를 먼저 다진다\",\"음소 탈락 과제부터 시작하여 가장 어려운 수준을 먼저 훈련한다\",\"한글 자모 이름 외우기를 조음치료보다 우선하여 실시한다\"],\"answer\":2,\"explain\":\"말소리장애 아동, 특히 취학 직전까지 오류가 지속되는 아동은 음운인식·읽기 어려움의 위험이 높으므로 산출 중재에 음운인식 활동을 통합하는 것이 권장된다. 이 아동은 음절 수준은 통과했고 음소 수준(첫소리 변별)에서 실패하므로, 목표음이 든 낱말로 첫소리 변별·짝 맞추기 등 음소 수준 활동을 하면서 자소 단서를 결합해 산출을 연습하면 두 영역을 동시에 촉진할 수 있다. ①은 통합 중재의 이점을 버리고, ③은 이미 가능한 수준의 반복, ④는 발달 순서를 무시한 가장 어려운 과제, ⑤ 자모 이름 암기는 음소 인식·산출과 직접 관련이 없다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"13세 여학생, /ㅅ, ㅆ, ㅈ, ㅊ/의 치간음화(혀끝이 앞니 사이로 나옴) 왜곡\\n• 개방교합(앞니가 다물어지지 않음), 안정 시 혀 내밀기, 삼킴 시 혀 밀기 관찰\\n• 치과 교정 계획 중\\n• 자극반응도: 거울 단서로 혀끝을 앞니 뒤에 두게 하면 산출 가능\",\"q\":\"가장 적절한 중재 계획은?\",\"choices\":[\"교정 치료가 끝날 때까지 조음치료를 보류하고 경과를 관찰한다\",\"혀 밀기 삼킴과 무관하므로 /ㅅ/ 계열 조음치료만 실시한다\",\"치과와 협진하여 구강근기능 훈련과 /ㅅ/ 계열 조음치료를 병행한다\",\"혀 근력이 약한 것이 원인이므로 혀 저항 운동만 집중 실시한다\",\"사춘기 이후에는 조음 교정이 어려우므로 보호자에게 치료 불가를 안내한다\"],\"answer\":3,\"explain\":\"개방교합·안정 시 혀 내밀기·혀 밀기 삼킴과 치간음화가 함께 나타나는 경우, 혀 밀기 습관은 교정 후 재발(교합 재개방)의 원인이 되고 치간음화 지속과도 관련되므로 치과 협진 아래 구강근기능 훈련(안정 시 혀 위치, 삼킴 패턴)과 조음치료를 병행하는 것이 적절하다. 자극반응도가 있으므로 시각 단서로 혀끝을 치조에 두는 산출을 확립하고 자기 모니터링으로 일반화한다. ①은 습관이 굳어지고 교정 효과를 해칠 수 있으며, ②는 재발 요인을 방치하고, ④ 근력 저하의 근거가 없으며, ⑤ 청소년·성인도 잔존오류 치료가 가능하다.\"},{\"grade\":1,\"set\":3,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"3세 8개월 남아, 자음정확도 55%\\n• 할아버지 /haɾabʌdʑi/ → [habʌdʑi], 자전거 /tɕadʑʌngʌ/ → [tɕagʌ], 냉장고 /nɛŋdʑaŋgo/ → [nɛŋgo]\\n• 코끼리 /kʰok*iɾi/ → [kʰok*i], 크레파스 /kʰɯɾepʰasɯ/ → [pʰasɯ]\\n• 1~2음절 낱말은 비교적 정확하며 각 음소는 단독으로 산출 가능\",\"q\":\"이 오류 양상에 대한 분석과 중재로 가장 적절한 것은?\",\"choices\":[\"종성생략이 주된 문제이므로 종성 /ŋ, l/을 먼저 확립하는 음소 중심 중재를 한다\",\"연구개음 전방화가 주된 문제이므로 /k, kʰ/를 목표로 최소대립쌍 중재를 한다\",\"개별 음소 오류가 주된 문제이므로 음소별 전통적 조음 접근으로 정확도를 높인다\",\"음절 생략이 주된 문제이므로 음절 수를 늘려 가며 박수 등 리듬 단서로 산출을 돕는다\",\"비일관적 음운장애이므로 핵심어휘 접근으로 자주 쓰는 낱말의 산출 일관성을 높인다\"],\"answer\":4,\"explain\":\"오류는 모두 3음절 이상 낱말에서 음절 전체가 탈락하는 음절 생략(다음절 축약)으로, 음소가 아니라 음절구조·낱말 길이의 문제이다. 따라서 음절 수를 단계적으로 늘리며 박수·리듬으로 각 음절을 표시하는 운율 단서를 활용해 모든 음절을 산출하게 하는 음절구조 중재가 적절하다. ① 종성만 생략된 것이 아니라 음절째 사라진 것이며 [nɛŋgo]에서 종성 /ŋ/은 정확하고, ② 연구개음은 [kʰok*i], [nɛŋgo], [tɕagʌ]에서 정확하며, ③ 각 음소는 단독으로 산출 가능하므로 음소별 전통적 접근은 문제의 본질과 맞지 않고, ⑤ 같은 낱말을 매번 다르게 산출한다는 비일관성의 근거가 없다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"[그림 1]은 7세 지적장애 아동의 '두 낱말 요구 발화' 정반응률을 A-B 설계로 측정한 결과이다(1~5회기 기초선, 6~15회기 중재).\",\"q\":\"[그림 1]에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"기초선 자료의 변동 폭이 커서 안정적이지 않으므로 중재를 시작하기에 부적절한 시점이었다\",\"중재 첫 회기(6회기)부터 기초선 최고점을 초과하였으므로 즉각적인 수준 변화가 확인된다\",\"PND는 90%이지만 A-B 설계이므로 중재의 인과적 효과로 단정할 수 없다\",\"중재기 자료점이 모두 기초선 최고점을 초과하므로 PND는 100%이며 실험적 통제가 입증되었다\",\"기초선과 중재기의 평균 차이가 크므로 반전(A2) 구간 없이도 기능적 관계가 실험적으로 입증되었다\"],\"answer\":3,\"explain\":\"그래프 값: 기초선 20, 25, 20, 30, 25(범위 20~30, 최고점 30, 상승 추세 없음 → 비교적 안정적), 중재기 30, 35, 45, 50, 60, 65, 70, 75, 80, 85. PND는 기초선 최고점(30)을 '초과'하는 중재기 자료점의 비율로, 6회기 값 30은 최고점과 같아 제외되므로 9/10 = 90%이다(④의 100%는 오류). 6회기는 최고점을 초과하지 않았으므로 ②도 틀렸다. 기초선은 10%p 범위에서 안정적이므로 ①은 부적절하다. A-B 설계는 반전이나 중다기초선처럼 효과의 반복 입증이 없어 실험적 통제(기능적 관계)를 입증하지 못하므로 ④·⑤처럼 인과 관계를 단정할 수 없다. ※PND 산출 시 '초과' 기준과 해석 절단점은 교재별로 확인 권장.\",\"image\":\"data:image/svg+xml;base64,\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"8세 지적장애 아동에게 '조사 -을/를 포함한 3어절 문장 산출'을 목표로 ABAB 설계를 적용하였다.\\n• A1(기초선 5회기): 10~15%\\n• B1(중재 8회기): 점진적 상승 후 70% 도달\\n• A2(중재 철회 5회기): 65~70%로 유지\\n• B2(중재 재도입 5회기): 72~78%\",\"q\":\"이 결과에 대한 해석과 후속 판단으로 가장 적절한 것은?\",\"choices\":[\"A2에서 수행이 유지된 것은 중재 효과가 강력하다는 실험적 증거이므로 기능적 관계가 입증되었다\",\"A2에서 기초선 수준으로 되돌아가지 않아 기능적 관계를 입증하지 못했으며 중다기초선 설계가 더 적합했다\",\"B1의 상승은 우연에 의한 것이므로 중재는 효과가 없었다고 결론 내리고 중재를 종료한다\",\"기능적 관계를 입증하기 위해 행동이 기초선 수준으로 떨어질 때까지 A2 구간을 무기한 연장한다\",\"A2 자료는 관찰자 기록 오류로 간주하여 분석에서 제외하고 B1·B2 자료만으로 효과를 판단한다\"],\"answer\":2,\"explain\":\"ABAB 설계는 중재 철회 시 행동이 기초선 방향으로 되돌아가고 재도입 시 다시 개선되는 '반복 입증'으로 기능적 관계를 보여 준다. A2에서 수행이 그대로 유지되면 B1의 변화가 중재 때문인지 성숙·연습 등 외부 요인 때문인지 구분할 수 없어 실험적 통제가 입증되지 않는다(①은 반대로 해석). 한 번 학습되면 되돌리기 어려운 언어 기술(비가역성)에는 반전을 요구하지 않는 중다기초선 설계가 적합하다. 중재 효과가 없었다고 단정하거나(③), 윤리적으로 문제가 되는 무기한 철회(④), 자료 임의 제외(⑤)는 부적절하다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"6세 말소리장애 아동 1명에게 전통적 조음치료와 최소대립쌍 치료 중 어느 것이 더 효과적인지 알아보기 위해, 한 회기 안에서 두 중재를 번갈아 실시하는 교대중재 설계를 계획하였다.\",\"q\":\"이 설계의 내적 타당도를 확보하기 위한 절차로 가장 적절한 것은?\",\"choices\":[\"두 중재를 동일한 목표 음소에 적용하여 비교 조건을 같게 만들고 회기마다 번갈아 실시한다\",\"실시 순서를 매 회기 고정하여 절차의 일관성을 높이고 아동의 예측 가능성을 확보한다\",\"기초선 측정을 생략하고 중재 종료 후 두 중재의 최종 정반응률만 t검정으로 비교한다\",\"두 중재에 난이도가 동등한 서로 다른 목표 음소를 배정하고 실시 순서를 역균형화한다\",\"아동이 더 좋아하는 중재를 매 회기 먼저 실시하여 동기를 유지하고 참여를 높인다\"],\"answer\":4,\"explain\":\"교대중재 설계의 주요 위협은 한 중재의 효과가 다른 중재로 번지는 다중처치 간섭(이월 효과)과 순서 효과이다. 이를 통제하려면 각 중재에 독립적이면서 난이도가 동등한 목표 세트를 배정하고 실시 순서를 역균형화(counterbalancing)해야 한다. 같은 목표 음소에 두 중재를 적용하면(①) 효과가 섞여 구분되지 않고, 순서 고정(②·⑤)은 순서 효과를 혼입시키며, 단일대상연구에서 기초선 생략과 t검정만의 비교(③)는 설계 논리에 맞지 않는다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 5분 만에 실시할 수 있는 학령전 어휘 선별검사를 개발하였다. 타당화를 위해 아동 120명에게 새 선별검사와 기존 표준화 어휘검사를 같은 날 실시하고 두 점수 간 상관(r = .82)을 구하였다.\",\"q\":\"이 절차로 확인하려는 것은?\",\"choices\":[\"공인타당도\",\"예측타당도\",\"내용타당도\",\"검사-재검사 신뢰도\",\"반분 신뢰도\"],\"answer\":1,\"explain\":\"공인(동시)타당도는 새 검사와 이미 타당성이 확립된 준거 검사를 '같은 시점'에 실시하여 상관을 구하는 준거관련 타당도이다. 예측타당도는 일정 기간 후의 준거(예: 1년 후 언어장애 진단 여부)를 예측하는 정도, 내용타당도는 문항이 측정 영역을 대표하는지에 대한 전문가 판단, 검사-재검사 신뢰도는 같은 검사를 시간 간격을 두고 두 번 실시한 일관성, 반분 신뢰도는 한 검사를 두 부분으로 나누어 얻는 내적 일관성이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"연구 요약\\n• 실어증 환자 16명을 무작위로 중재집단(8명)과 대기집단(8명)에 배정\\n• 8주 이름대기 중재 후 사후 점수 비교: p = .08 (유의수준 .05), Cohen's d = 0.92\\n• 사전 동질성 확인, 중도 탈락 없음\",\"q\":\"이 결과에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"통계적으로 유의하지 않으므로 이 중재는 효과가 없다고 결론 내린다\",\"효과크기는 통계적 유의성보다 중요하지 않으므로 보고에서 제외한다\",\"p 값이 .05에 근접하므로 이 결과에서는 1종 오류가 발생하였다고 본다\",\"유의수준을 .10으로 사후 조정하여 중재 효과가 유의한 것으로 보고한다\",\"표본이 작아 검정력이 낮을 수 있으므로 더 큰 표본으로 반복 연구한다\"],\"answer\":5,\"explain\":\"집단당 8명은 매우 작은 표본이어서 검정력이 낮고, 실제 효과가 있어도 유의하지 않게 나올(2종 오류) 가능성이 크다. Cohen's d 0.92는 큰 효과에 해당하므로 '효과 없음'(①)으로 단정할 수 없고, 효과크기는 유의성과 함께 보고해야 한다(②). 1종 오류는 효과가 없는데 있다고 판단하는 오류이므로(③) 상황에 맞지 않고, 결과를 본 뒤 유의수준을 올리는 것(④)은 연구 윤리와 통계 원칙에 어긋난다. ※효과크기 해석 기준(0.2/0.5/0.8)은 교재별 확인 권장.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"만 4세 아동 80명에게 언어 선별검사를 실시하고, 전원에게 정밀 언어평가를 실시하여 언어장애 여부를 확정하였다.\\n• 정밀평가 결과 언어장애: 16명, 비장애: 64명\\n• 선별검사 '양성': 언어장애 아동 16명 중 14명, 비장애 아동 64명 중 16명\",\"q\":\"이 선별검사의 정확도에 대한 설명으로 옳은 것은?\",\"choices\":[\"민감도는 75%, 특이도는 87.5%이다\",\"민감도는 87.5%, 특이도는 75%이다\",\"민감도는 30명 중 14명인 46.7%이다\",\"특이도는 64명 중 16명이므로 25%이다\",\"위양성률은 16명 중 2명이므로 12.5%이다\"],\"answer\":2,\"explain\":\"민감도 = 실제 장애 아동 중 선별 양성 비율 = 14/16 = 87.5%. 특이도 = 실제 비장애 아동 중 선별 음성 비율 = (64−16)/64 = 48/64 = 75%. ①은 두 값을 바꾼 것이다. ③의 14/30(=46.7%)은 양성예측도이지 민감도가 아니다. 16/64 = 25%는 특이도가 아니라 위양성률이므로 ④는 틀렸다. ⑤의 2/16(=12.5%)은 장애 아동을 놓친 위음성률이며, 위양성률은 16/64 = 25%이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 3세 아동의 언어평가 보고서를 작성하고 있다. 아동은 검사 중 눈맞춤과 공동주의가 제한되었고, 검사자의 지시에 반응하지 않는 경우가 잦았으며, 어머니는 직장 때문에 아동과 보내는 시간이 적다고 보고하였다.\",\"q\":\"평가보고서에 기술할 문장으로 가장 적절한 것은?\",\"choices\":[\"검사 중 관찰된 행동으로 보아 아동은 자폐스펙트럼장애로 진단됨\",\"어머니의 양육 시간 부족이 언어지연의 원인으로 판단됨\",\"아동이 게으르고 비협조적이어서 검사 결과는 신뢰할 수 없음\",\"관찰된 사회적 의사소통 특성을 기술하고 전문의 의뢰를 권고함\",\"수용어휘 원점수가 35점이므로 심각한 수준의 언어지체로 판단됨\"],\"answer\":4,\"explain\":\"보고서는 관찰된 행동(눈맞춤·공동주의 제한, 지시 반응의 비일관성)을 객관적으로 기술하고, 그 함의에 따라 사회적 의사소통 특성의 감별을 위한 소아정신건강의학과 의뢰 등 권고를 제시해야 한다(④). 자폐스펙트럼장애의 확정 진단은 의사의 영역이므로 언어재활사가 '진단됨'이라고 쓰는 것(①)은 업무 범위를 벗어나고, 근거 없는 인과 귀인(②)이나 가치 판단적 표현(③)은 부적절하다. 원점수만으로 지체 정도를 판정하는 것(⑤)은 규준 참조(표준점수·백분위·등가연령) 없이 해석한 오류이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"대학 부설 언어치료실에서 학생 임상가가 '임상 슈퍼비전 목적'이라고 명시된 동의서를 보호자에게 받고 회기를 녹화하였다. 이후 지도교수가 이 영상을 학부 강의 자료로 사용하고자 한다.\",\"q\":\"가장 적절한 조치는?\",\"choices\":[\"동의서의 목적을 벗어나므로 강의 활용에 대한 별도 동의를 새로 받는다\",\"이미 녹화에 대한 동의를 받았으므로 추가 동의 없이 사용할 수 있다\",\"얼굴을 모자이크 처리하여 식별할 수 없게 하면 동의 없이 사용할 수 있다\",\"교육 목적의 활용은 개인정보 이용 동의의 예외이므로 사용할 수 있다\",\"치료가 종결된 후에는 기관 소유 자료이므로 자유롭게 사용할 수 있다\"],\"answer\":1,\"explain\":\"개인정보(영상)는 동의받은 목적 범위 안에서만 이용할 수 있으며, 목적이 달라지면(슈퍼비전 → 강의) 활용 목적·범위·대상을 명시한 별도 동의를 보호자에게 새로 받아야 한다. 모자이크를 하더라도 음성·발화 내용 등으로 식별 가능성이 남고, 교육 목적이라는 이유만으로 동의가 면제되지 않으며, 치료 종결이나 기관 보관 여부는 이용 목적 제한을 해제하지 않는다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"임상실습 3학기째인 학생 임상가는 회기 계획을 스스로 세우고 자료를 분석하며, 슈퍼비전 시간에 \\\"촉진을 줄이는 시점을 어떻게 잡아야 할지 의견을 듣고 싶다\\\"처럼 구체적인 질문을 가지고 온다. 다만 아직 자신의 문제를 완전히 독립적으로 해결하지는 못한다.\",\"q\":\"Anderson의 슈퍼비전 연속체 모형에 따를 때 이 학생에게 가장 적합한 슈퍼비전 방식은?\",\"choices\":[\"평가-피드백 단계의 지시적 방식으로 매 회기 계획을 슈퍼바이저가 작성해 준다\",\"전환 단계의 협력적 방식으로 학생과 함께 문제를 분석하고 대안을 정한다\",\"자기 슈퍼비전 단계로 보고 슈퍼바이저의 관찰과 피드백을 모두 중단한다\",\"학생의 판단이 아직 미숙하므로 모든 임상 결정을 슈퍼바이저가 내린다\",\"자문 방식으로 학생이 요청할 때만 개입하고 회기 관찰은 하지 않는다\"],\"answer\":2,\"explain\":\"Anderson의 연속체 모형은 평가-피드백(직접·지시적) → 전환(협력적) → 자기 슈퍼비전(자문적) 단계로 이어진다. 스스로 계획·분석하고 구체적 질문을 가져오지만 아직 독립적 문제 해결이 어려운 학생은 전환 단계에 해당하므로 협력적 방식이 적합하다. 지시적 방식(①·④)은 초기 단계에, 자문 방식(③·⑤)은 자기 슈퍼비전 단계에 해당하며, 관찰과 피드백을 중단하는 것은 내담자 보호 책무에도 어긋난다. ※단계 명칭과 구분 기준은 교재별 확인 권장.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"뇌전증 병력이 있는 5세 아동이 치료 중 갑자기 의식을 잃고 전신 경직-간대 발작을 보였다. 치료실에는 언어재활사 혼자 있고 보호자는 대기실에 있다.\",\"q\":\"언어재활사의 대처로 가장 적절한 것은?\",\"choices\":[\"혀를 깨물지 않도록 설압자나 손수건을 입에 물려 기도를 확보한다\",\"부상을 막기 위해 팔다리를 단단히 붙잡아 경련 움직임을 억제한다\",\"위험물을 치우고 머리를 보호하며 옆으로 눕힌 뒤 발작 지속 시간을 확인한다\",\"의식 회복을 돕기 위해 물을 조금씩 마시게 하고 이름을 불러 깨운다\",\"발작이 끝나고 안정되면 바로 회기를 재개하고 보호자에게는 회기 후 알린다\"],\"answer\":3,\"explain\":\"발작 시에는 억제하거나 입에 물건을 넣지 말고, 부상 방지(위험물 제거·머리 보호)와 기도 확보(회복 자세로 옆으로 눕힘)를 하며, 발작 시작 시각을 확인하여 5분 이상 지속·반복되거나 호흡 곤란이 있으면 119에 신고한다. 입에 물건을 넣는 것(①)은 치아 손상·기도 폐쇄 위험, 신체 억제(②)는 골절 위험, 의식이 불분명한 상태에서 물을 먹이는 것(④)은 흡인 위험이 있다. 발작 후에는 회기를 중단하고 보호자에게 즉시 알리며 기록을 남겨야 한다(⑤).\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"영유아를 주로 보는 언어재활센터의 감염관리 지침을 점검하였다.\\n\\nㄱ. 회기 전후와 구강 접촉 도구를 다룬 뒤에는 손위생을 실시한다\\nㄴ. 아동이 입에 넣는 장난감은 회기마다 세척·소독한 뒤 재사용한다\\nㄷ. 설압자 등 구강 접촉 일회용품은 소독 후 다른 아동에게 재사용할 수 있다\\nㄹ. 수족구병으로 진단된 아동은 전염 가능 기간 동안 회기를 연기한다\",\"q\":\"옳은 것을 모두 고른 것은?\",\"choices\":[\"ㄱ, ㄴ\",\"ㄱ, ㄷ\",\"ㄴ, ㄷ, ㄹ\",\"ㄱ, ㄴ, ㄹ\",\"ㄱ, ㄴ, ㄷ, ㄹ\"],\"answer\":4,\"explain\":\"표준주의 원칙에 따라 손위생(ㄱ), 구강 접촉 장난감의 회기별 세척·소독(ㄴ), 전염성 질환 시 회기 연기(ㄹ)는 옳다. 설압자·일회용 장갑 등 일회용품은 소독하더라도 다른 아동에게 재사용해서는 안 되므로(ㄷ) 틀렸다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"내년에 초등학교 입학 예정인 6세 언어장애 아동의 어머니가 \\\"장애인 등록은 하지 않았는데, 학교에서도 언어치료 지원을 받을 수 있나요?\\\"라고 물었다.\",\"q\":\"「장애인 등에 대한 특수교육법」에 근거한 안내로 옳은 것은?\",\"choices\":[\"등록 여부와 무관하게 특수교육대상자로 선정되면 치료지원으로 언어치료를 받을 수 있다\",\"장애인복지법상 장애인으로 등록된 아동만 특수교육대상자로 선정될 수 있다\",\"특수교육대상자로 선정되더라도 특수학교에 배치되어야만 치료지원을 받을 수 있다\",\"담임교사의 판단만으로 별도의 선정 절차 없이 치료지원이 바로 제공된다\",\"발달재활서비스를 이용 중이면 특수교육대상자 선정 없이 학교 치료지원이 자동으로 제공된다\"],\"answer\":1,\"explain\":\"장애인 등록 여부와 관계없이 보호자가 교육장(교육감)에게 진단·평가를 의뢰할 수 있다. 특수교육대상자 선정은 특수교육지원센터의 진단·평가와 특수교육운영위원회 심사를 거쳐 교육장·교육감이 결정하며, 장애인 등록 여부와 별개이다. 선정되면 일반학급·특수학급·특수학교 어디에 배치되든 관련서비스로 치료지원(언어치료 포함)을 받을 수 있다. 등록 장애인 한정(②), 특수학교 배치 조건(③), 교사 단독 판단(④), 발달재활서비스와의 자동 연계(⑤)는 모두 법의 절차와 다르다. ※진단·평가 기한(30일), 통지 기한 등 세부 절차는 최신 법령 확인 권장.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"55세 남성이 뇌졸중으로 실어증이 발생한 지 2개월 되었고, 현재 재활병원에서 언어치료를 받고 있다. 보호자가 \\\"지금 바로 언어장애로 장애인 등록을 하고 싶다\\\"고 문의하였다.\",\"q\":\"「장애인복지법」상 장애 판정에 대한 안내로 가장 적절한 것은?\",\"choices\":[\"발병 즉시 언어검사 결과만 있으면 판정할 수 있다\",\"언어재활사가 장애진단서를 작성하여 주민센터에 제출하면 된다\",\"장애 심사는 국민건강보험공단에서 담당하므로 공단에 직접 신청한다\",\"실어증은 언어장애 판정 대상이 아니므로 등록할 수 없다\",\"장애가 고착된 뒤 의사가 판정하므로 아직 시기가 아니다\"],\"answer\":5,\"explain\":\"언어장애 판정은 원인 질환을 충분히 치료하여 장애가 고착된 뒤에 하며, 뇌졸중 등 후천적 원인은 원칙적으로 발병 후 6개월 이상 치료 후 판정한다. 장애진단은 의료기관의 전문의(재활의학과·신경과·정신건강의학과·이비인후과 등)가 언어검사 결과를 근거로 하며, 언어재활사는 검사·소견 제공은 할 수 있으나 진단서를 작성할 수 없다(②). 장애 심사는 국민연금공단이 담당한다(③). 실어증은 언어장애 판정 대상에 포함된다(④). ※판정 시기(6개월)와 진단 가능 전문의 범위는 최신 장애정도판정기준으로 확인 권장.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"5세 언어발달지연 아동의 두 목표에 대한 회기별 정반응률\\n• 목표 A(낱말 수준 /ㄱ/ 산출, 준거 90% 3회기 연속): 최근 3회기 92%, 95%, 96%\\n• 목표 B(2어절 요구 문장): 최근 6회기 35%, 40%, 30%, 40%, 35%, 40%\",\"q\":\"자료에 근거한 목표 수정으로 가장 적절한 것은?\",\"choices\":[\"목표 A는 문장 수준으로 상향하고, 목표 B는 단계를 세분화하거나 촉진을 조정한다\",\"목표 A는 안정성을 위해 낱말 수준을 5회기 더 반복하고, 목표 B는 그대로 유지한다\",\"목표 A는 종결하고, 목표 B는 아동에게 어려우므로 목표에서 삭제한다\",\"목표 A는 문장 수준으로 상향하고, 목표 B는 동기 유발을 위해 3어절 문장으로 상향한다\",\"두 목표 모두 현재 절차를 4회기 더 유지한 뒤 자료를 모아 다시 검토한다\"],\"answer\":1,\"explain\":\"목표 A는 준거(90%, 3회기 연속)를 충족하였으므로 다음 수준으로 진행해야 하며, 준거 달성 후 불필요한 반복(②)은 회기를 낭비한다. 목표 B는 6회기 동안 30~40%에 정체되어 있으므로 현재 절차가 효과적이지 않다는 신호이며, 과제 분석·단계 세분화·촉진 조정·선수 기술 점검 등 절차 수정이 필요하다. 목표 삭제(③)는 아동의 요구를 방치하고, 더 어려운 수준으로 상향(④)하거나 무변화 유지(⑤)는 자료에 반하는 결정이다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"파킨슨병으로 운동저하형 마비말장애를 보이는 60대 남성이 집중 음성치료를 권유받자 \\\"어차피 병은 진행하는데 해봤자 소용없다\\\"며 참여를 거부하였다. 보호자는 손주와 전화 통화가 어려워진 것을 환자가 속상해한다고 전하였다.\",\"q\":\"언어재활사의 상담 접근으로 가장 적절한 것은?\",\"choices\":[\"보호자를 설득하여 환자가 치료에 참여하도록 가정에서 매일 강하게 권하게 한다\",\"환자의 치료 거부 의사를 존중하여 기록하고 즉시 서비스를 종결한다\",\"\\\"치료를 안 하면 곧 말을 전혀 못 하게 됩니다\\\"라고 경고하여 동기를 높인다\",\"양가감정을 반영하고 중요한 목표와 치료를 연결하되 결정은 환자에게 맡긴다\",\"저항을 줄이기 위해 환자 모르게 보호자와 치료 일정을 정해 진행한다\"],\"answer\":4,\"explain\":\"치료 동기가 낮은 성인에게는 동기강화상담의 원리(공감·반영적 경청, 양가감정 탐색, 손주와의 통화처럼 개인이 중요하게 여기는 가치·목표와 연결, 허락 후 정보 제공, 자율성 존중)가 적합하다. 보호자를 통한 압박(①), 겁주기(③), 환자 배제(⑤)는 저항을 키우고 자기결정권을 침해하며, 거부 즉시 종결(②)은 양가감정을 다룰 기회를 놓친다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 종이 치료기록지에 회기 날짜와 정반응률을 잘못 기재한 것을 이틀 뒤 발견하였다.\",\"q\":\"기록 수정 방법으로 옳은 것은?\",\"choices\":[\"수정액으로 오류를 완전히 지우고 올바른 내용을 적는다\",\"원 기록에 한 줄을 긋고 바른 내용과 수정 일자·서명을 적는다\",\"해당 페이지를 새로 작성하여 교체하고 원본은 파기한다\",\"오류가 있었음을 기관장에게 구두로 보고하는 것으로 갈음한다\",\"다음 회기 기록에 올바른 값을 적고 이전 기록은 그대로 둔다\"],\"answer\":2,\"explain\":\"임상 기록은 법적 문서이므로 수정 시 원 기록의 흔적을 남기고(한 줄 긋기) 수정 내용·일자·서명(필요시 사유)을 기재하여 누가 언제 무엇을 고쳤는지 추적할 수 있어야 한다. 수정액 사용(①), 원본 파기(③)는 기록 위·변조 의혹을 낳고, 구두 보고(④)나 이전 기록 방치(⑤)는 기록의 정확성을 확보하지 못한다. 전자기록도 수정 이력이 남도록 처리한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"센터에 근무하는 언어재활사가 자신이 치료 중인 학령전 아동들을 대상으로 새로운 어휘 중재의 효과 연구를 수행하려 한다.\",\"q\":\"연구 윤리상 가장 적절한 절차는?\",\"choices\":[\"자신의 내담자는 치료의 일부이므로 별도 동의 없이 연구에 포함한다\",\"아동은 미성년자이므로 보호자 동의만 받고 아동의 참여 의사는 확인하지 않는다\",\"IRB 승인과 보호자 동의·아동 승낙을 받고 불참 시 불이익이 없음을 알린다\",\"참여를 거부하면 치료를 종결할 수 있음을 미리 알려 참여율을 높인다\",\"참여 아동에게만 추가 회기를 무료로 제공하겠다고 약속하여 모집한다\"],\"answer\":3,\"explain\":\"치료자가 자신의 내담자를 연구 대상으로 삼을 때는 치료 관계에서 오는 강압 가능성이 크므로, IRB 심의, 보호자 동의와 아동 연령에 맞는 승낙, 불참·철회 시 불이익 없음 보장이 필수이다. 동의 생략(①), 아동 의사 무시(②), 치료 종결 위협(④)은 자발성을 침해하고, 참여자에게만 특혜를 주는 것(⑤)은 부당한 유인에 해당한다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"개인 언어재활센터 홈페이지에 다음 문구가 게시되어 있다.\\n\\\"국내 유일! 3개월 안에 완치를 보장합니다. 해외 특허 언어치료법(근거 자료 없음).\\\"\",\"q\":\"이 광고에 대한 판단으로 가장 적절한 것은?\",\"choices\":[\"홍보 문구는 사업자의 영업 자유에 해당하므로 윤리적 문제가 없다\",\"결과 보장은 치료사의 전문성과 자신감을 표현한 것이므로 허용된다\",\"완치된 사례가 실제로 1건이라도 있으면 완치 보장 표현이 허용된다\",\"내담자 후기를 실명으로 함께 게시하면 신뢰성이 확보되어 문제가 없다\",\"치료 효과를 보장하는 허위·과장 광고로 전문가 윤리에 위배된다\"],\"answer\":5,\"explain\":\"전문가 윤리는 서비스 효과를 보장하거나 근거 없는 우수성을 주장하는 광고를 금지한다. '완치 보장', '국내 유일', 근거 없는 '특허 치료법'은 소비자를 오인하게 하는 허위·과장 광고로, 언어재활사의 정직성·품위 유지 윤리에 위배되며 표시·광고 관련 법 위반 소지도 있다. 사업자의 자유(①), 자신감(②), 단일 사례(③)는 정당화 근거가 되지 못하며, 내담자 실명 후기 게시(④)는 오히려 비밀유지 문제를 추가로 일으킨다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"베트남어를 주로 사용하고 한국어가 서툰 어머니에게 4세 아동의 언어평가 결과를 설명해야 한다. 한국어가 유창한 8세 형이 \\\"제가 통역할게요\\\"라고 나섰다.\",\"q\":\"언어재활사의 대처로 가장 적절한 것은?\",\"choices\":[\"형이 한국어에 능숙하므로 형에게 통역을 맡겨 결과를 전달한다\",\"번역 앱으로 결과지를 번역해 전달하고 질문은 받지 않는다\",\"한국어로 천천히 크게 말하면 이해할 수 있으므로 그대로 진행한다\",\"어머니 대신 한국어가 가능한 아버지에게만 설명하고 결정을 맡긴다\",\"전문 통역 지원을 요청하고 형에게는 통역을 맡기지 않는다\"],\"answer\":5,\"explain\":\"가족 구성원, 특히 아동에게 통역을 맡기면 정보 왜곡, 민감한 내용(진단·예후) 전달 부담, 가족 역할 혼란이 생기므로 다문화가족지원센터 통·번역 서비스 등 훈련된 통역사를 이용해야 한다(①은 틀림). 통역 시에는 통역사와 용어·목적을 사전에 협의하고, 짧은 문장으로 어머니를 직접 바라보며 말하는 것이 원칙이다. 번역 앱만으로 결과를 통보하거나(②), 큰 소리로 말하기(③), 어머니를 의사결정에서 배제하기(④)는 정보 접근권과 가족중심 원칙에 어긋난다.\"},{\"grade\":1,\"set\":3,\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"9세 뇌성마비 아동(경직형 마비말장애)의 평가 내용을 ICF(국제 기능·장애·건강 분류) 틀로 정리하려 한다.\\n㉠ 문장 수준 말명료도 55%\\n㉡ 모둠 토론 시간에 발표를 전혀 하지 않음\\n㉢ 소음이 큰 교실 환경과 또래의 놀림\\n㉣ 실패를 걱정하여 말하기를 스스로 피하는 성향\",\"q\":\"ICF 구성요소로 옳게 분류한 것은?\",\"choices\":[\"㉠ 활동, ㉡ 신체기능, ㉢ 환경요인, ㉣ 참여\",\"㉠ 신체기능, ㉡ 참여, ㉢ 개인요인, ㉣ 환경요인\",\"㉠ 신체기능, ㉡ 참여, ㉢ 환경요인, ㉣ 개인요인\",\"㉠ 신체구조, ㉡ 활동, ㉢ 개인요인, ㉣ 참여\",\"㉠ 참여, ㉡ 활동, ㉢ 환경요인, ㉣ 신체기능\"],\"answer\":3,\"explain\":\"ICF에서 말명료도 저하는 음성·말 기능의 손상이므로 신체기능(㉠), 학교 모둠 토론이라는 생활 상황 참여의 제한은 참여(㉡), 물리적 환경(소음)과 타인의 태도(놀림)는 환경요인(㉢), 성격·대처 방식 등 개인의 특성은 개인요인(㉣)에 해당한다. 환경요인과 개인요인을 바꾼 ②, 신체기능·활동·참여를 뒤섞은 ①·④·⑤는 틀렸다.\"}];\n</script>\n<script>\nwindow.DETAILS = {\"1-1-1-1\":{\"p\":\"좌측 하전두엽(브로카 영역) 손상, 느리고 노력성인 비유창 발화, 조사·어미를 생략하는 전보식 발화(실문법증)가 핵심 단서이다. 단순 지시 이해는 비교적 양호하지만 통사적으로 복잡한 문장 이해에 어려움이 있고 따라말하기도 손상되어 있다. 비유창·이해 상대적 양호·따라말하기 손상의 조합은 브로카실어증에 해당한다.\",\"w\":{\"1\":\"베르니케실어증은 유창한 발화와 심한 청각적 이해력 손상을 보이므로 비유창 발화와 맞지 않는다.\",\"2\":\"연결피질운동실어증은 비유창하나 따라말하기가 보존되므로 따라말하기 손상 소견과 모순된다.\",\"4\":\"전도실어증은 유창한 발화에 따라말하기가 선택적으로 손상되는 유형으로 비유창·전보식 발화와 맞지 않는다.\",\"5\":\"명칭실어증은 유창하고 이해·따라말하기가 양호하며 이름대기 결함만 두드러지는 유형이다.\"}},\"1-1-1-2\":{\"p\":\"스스로 말하기 8/20점으로 비유창하고, 알아듣기 170/200(8.5/10)으로 청각적 이해가 양호하다. 따라말하기 88/100(8.8/10)은 유창성에 비해 뚜렷하게 보존되어 있다. 비유창·이해 양호·따라말하기 보존의 조합은 연결피질운동실어증의 전형적 프로파일이다.\",\"w\":{\"2\":\"전도실어증은 유창한 발화에 따라말하기가 선택적으로 손상되므로 비유창·따라말하기 88점 보존과 반대이다.\",\"3\":\"베르니케실어증은 유창하고 이해가 심하게 손상되므로 알아듣기 170점과 맞지 않는다.\",\"4\":\"브로카실어증은 비유창하지만 따라말하기도 손상되므로 88점의 보존된 따라말하기와 맞지 않는다.\",\"5\":\"연결피질감각실어증은 따라말하기는 보존되나 유창하고 이해가 저하되는 유형이다.\"}},\"1-1-1-3\":{\"p\":\"실제 낱말을 의미적으로 관련된 낱말로 대치하는 의미착어('버스'→'기차')가 결정적 단서이다. 비단어 읽기가 거의 불가능하여 음운(비어휘) 경로가 손상되었고, 추상어보다 구체어를 잘 읽는 심상성 효과가 나타난다. 의미 오류·비단어 읽기 불능·심상성 효과의 조합은 심층실독증의 특징이다.\",\"w\":{\"1\":\"표층실독증은 어휘 경로 손상으로 불규칙 낱말을 규칙화하여 읽는 오류를 보이며 비단어 읽기는 보존된다.\",\"2\":\"음운실독증도 비단어 읽기가 손상되지만 의미착어(의미적 대치 오류)는 나타나지 않는다.\",\"3\":\"순수실독증은 쓰기는 보존되면서 읽기만 손상되고 글자 하나씩 읽는(letter-by-letter) 양상을 보인다.\",\"5\":\"무시실독증은 편측 무시로 낱말의 한쪽(주로 왼쪽) 글자를 생략·대치하는 오류를 보인다.\"}},\"1-1-1-4\":{\"p\":\"기저핵 회로의 퇴행성 병변은 파킨슨병을 시사한다. 단조로운 음도·감소된 강도, 점점 빨라지는 말속도(가속)와 짧은 말 뭉침, 안정 시 떨림은 과소운동형 마비말장애의 전형적 특징이다.\",\"w\":{\"1\":\"이완형은 하위운동신경 손상으로 근약화·과다비성·기식 음성을 보인다.\",\"3\":\"경직형은 양측 상위운동신경 손상으로 느리고 노력성인 말과 쥐어짜는 음성을 보이며 말속도 가속과 맞지 않는다.\",\"4\":\"실조형은 소뇌 손상으로 불규칙한 조음 붕괴와 과도한 강세 변동을 보인다.\",\"5\":\"과다운동형도 기저핵 병변이지만 무도증·근긴장이상 등 불수의 운동으로 인한 예측 불가능한 변이를 보이며 단조로운 음도·가속과는 다르다.\"}},\"1-1-1-5\":{\"p\":\"근력 저하 없이 나타나는 모색행동, 같은 낱말에서의 비일관적 오류, 발화 길이에 따른 오류 증가, 자동구어의 상대적 보존은 말실행증의 특징이다. 말실행증은 말운동 계획·프로그래밍의 손상이므로 느린 속도에서 조음 동작 전환을 반복 연습하고 운동학습 원리(집중 연습, 점진적 난이도 상승)를 적용하는 것이 적절하다.\",\"w\":{\"1\":\"AAC는 중증에서 보완적으로 고려할 수 있으나 제시된 대상자는 자동구어가 가능한 수준이므로 즉시 도입할 근거가 없다.\",\"2\":\"근력 저하가 없는 운동 프로그래밍 장애이므로 비구어 구강 근력 강화 훈련은 적절하지 않다.\",\"3\":\"청각적 이해력 결함에 대한 단서가 없으므로 이해력 훈련을 우선할 이유가 없다.\",\"5\":\"호흡 지구력 훈련은 호흡 지지가 약한 마비말장애 등에 적용하는 것으로 말실행증의 핵심 문제와 무관하다.\"}},\"1-1-1-6\":{\"p\":\"삼킴 반사가 유발되기 전에 음식물이 인두로 조기 유입되었으므로 '삼킴 전' 단계의 문제이다. 음식물이 진성대 아래로 내려갔으므로 침습이 아니라 흡인이며, 기침 반응이 없으므로 무증상 흡인이다. 따라서 삼킴 전 무증상 흡인에 해당한다.\",\"w\":{\"1\":\"구강 잔여물은 삼킴 후 구강 내에 음식물이 남는 것으로 인두·기도 유입 소견과 무관하다.\",\"2\":\"침습은 음식물이 후두 전정에 들어가되 진성대 위에 머무는 경우로, 진성대 아래로 내려간 본 소견과 다르다.\",\"3\":\"음식물 유입은 삼킴 반사 유발 전에 일어났으므로 '삼킴 후' 흡인이 아니다.\",\"5\":\"비강 역류는 연인두 폐쇄 부전으로 음식물이 비강으로 넘어가는 것이다.\"}},\"1-1-1-7\":{\"p\":\"발화는 유창하고 문법적으로 완전하지만 사물의 이름뿐 아니라 용도(의미 지식)까지 상실되어 있고, 의미 과제의 어려움이 점진적으로 심화된다. 불규칙 낱말을 규칙화하여 읽는 표층실독증이 동반되고 일상 기억과 시공간 능력은 보존된다. 이는 의미치매(의미변이형 원발성 진행성 실어증)의 특징이다.\",\"w\":{\"1\":\"알츠하이머성 치매는 초기부터 일화 기억 저하가 두드러지므로 일상 기억 보존 소견과 맞지 않는다.\",\"3\":\"비유창형 원발성 진행성 실어증은 실문법증·노력성 발화·말실행증을 보이므로 유창하고 문법적으로 완전한 발화와 맞지 않는다.\",\"4\":\"혈관성 치매는 뇌혈관 질환에 따른 계단식 악화와 국소 신경학적 징후가 특징이며 선택적 의미 지식 상실과는 거리가 있다.\",\"5\":\"루이소체 치매는 인지 기능의 변동, 환시, 파킨슨증이 특징이다.\"}},\"1-1-1-8\":{\"p\":\"지속적 주의력은 일정 시간 동안 주의를 유지하는 능력이다. 일정 시간 동안 목표 소리가 들릴 때마다 버튼을 누르는 과제는 지속 수행 과제(CPT)로 지속적 주의력 평가에 적합하다.\",\"w\":{\"1\":\"선택적 주의력은 방해 자극 속에서 목표에 주의를 두는 능력이므로 조용한 방에서의 숫자 따라 외우기(작업기억·주의 폭 과제)와 맞지 않는다.\",\"3\":\"두 규칙을 번갈아 적용하는 과제는 교대적 주의력 과제이며 초점적 주의력은 특정 자극에 대한 기본 반응 능력이다.\",\"4\":\"분리적 주의력은 두 과제를 동시에 수행하는 능력이므로 하나만 골라 수행하는 과제와 맞지 않는다.\",\"5\":\"소음 속에서 이야기를 듣고 답하는 과제는 방해 자극을 억제하는 선택적 주의력 과제이다.\"}},\"1-1-1-9\":{\"p\":\"광범위한 좌반구 병소, 상동어에 제한된 구어 표현, 심한 청각적 이해력 손상은 전반실어증 양상이다. 몸짓 모방이 부분적으로 가능하므로 구어를 사용하지 않고 시각 자극과 몸짓 상징을 단계적으로 훈련하는 시각동작치료(VAT)를 우선 적용할 수 있다.\",\"w\":{\"1\":\"멜로디억양치료는 청각적 이해가 비교적 양호한 비유창 실어증에 적합하므로 이해력이 심하게 손상된 본 환자에게 부적절하다.\",\"2\":\"지연청각피드백은 말더듬·속화 등에서 말속도를 늦추는 기기로 실어증 치료법이 아니다.\",\"3\":\"문장산출프로그램(SPPA)은 일정 수준의 이해력과 구어 산출이 가능한 실문법증 환자를 위한 것이다.\",\"4\":\"의미자질분석은 이름대기 치료로, 상동어 수준의 산출과 심한 이해 손상을 보이는 환자에게는 적용이 어렵다.\"}},\"1-1-1-10\":{\"w\":{\"1\":\"스스로 말하기(내용 전달·유창성)는 AQ 산출 영역에 포함된다.\",\"2\":\"따라말하기는 AQ 산출 영역에 포함된다.\",\"4\":\"이름대기 및 낱말 찾기는 AQ 산출 영역에 포함된다.\",\"5\":\"알아듣기는 AQ 산출 영역에 포함된다.\"}},\"1-1-1-11\":{\"p\":\"보호자는 긴 설명을 하면 환자가 이해하지 못한다고 호소하고 있다. 중등도 실어증 환자에게는 짧고 단순한 문장, 느린 말속도, 충분한 반응 시간, 몸짓 등 다중 양식 활용이 권장되므로 짧고 단순하게 말하고 반응할 시간을 충분히 주도록 교육한다.\",\"w\":{\"2\":\"틀릴 때마다 즉시 교정하면 의사소통 의욕이 저하되고 대화 흐름이 끊긴다.\",\"3\":\"환자가 말하기 전에 대신 말해 주면 스스로 표현할 기회를 빼앗는다.\",\"4\":\"대화 기회를 줄이면 의사소통 참여와 회복 기회가 감소한다.\",\"5\":\"빠른 속도는 처리 부담을 늘리므로 느린 속도로 말해야 한다.\"}},\"1-1-1-12\":{\"p\":\"성문위삼킴법은 숨을 들이쉬고 참은 상태에서 삼킨 뒤 곧바로 기침하는 기법이다. 삼킴 전과 삼킴 중에 진성대 수준에서 기도를 자발적으로 폐쇄하여 흡인을 방지하는 것이 일차적 목적이다.\",\"w\":{\"1\":\"중력을 이용한 잔여물 처리는 자세 기법(머리 기울이기 등)에 해당한다.\",\"2\":\"후두 상승 연장과 상부식도괄약근 개방 시간 연장은 멘델슨기법의 목적이다.\",\"3\":\"혀 기저부 후방 운동 강화는 노력삼킴 등의 목적이다.\",\"4\":\"삼킴 반사 유발 촉진은 온도-촉각 자극 등 감각 자극 기법의 목적이다.\"}},\"1-1-1-13\":{\"p\":\"좌측 상측두회(베르니케 영역) 손상, 착어가 많은 유창한 발화, 심한 청각적 이해력 저하, 따라말하기 손상, 병식 부족이 모두 나타난다. 이 조합은 베르니케실어증의 전형적 특징이다.\",\"w\":{\"2\":\"전도실어증은 청각적 이해가 비교적 양호하고 병식이 있어 자기수정을 시도한다.\",\"3\":\"명칭실어증은 이해·따라말하기가 양호하고 이름대기 결함만 두드러진다.\",\"4\":\"연결피질감각실어증은 베르니케실어증과 유사하나 따라말하기가 보존된다.\",\"5\":\"브로카실어증은 비유창한 발화를 보이므로 유창한 발화와 맞지 않는다.\"}},\"1-1-1-14\":{\"p\":\"유창한 발화와 비교적 양호한 청각적 이해력에도 따라말하기가 선택적으로 심하게 손상되고 음소착어가 두드러지는 것은 전도실어증의 특징이다. 주로 활꼴다발(궁상속)이나 모서리위이랑 부위 손상과 관련되며, 목표어에 가까워지려는 접근행동(conduite d'approche)을 보인다.\",\"w\":{\"1\":\"연결피질운동실어증은 비유창하고 따라말하기가 보존된다.\",\"2\":\"베르니케실어증은 청각적 이해력이 심하게 손상된다.\",\"3\":\"브로카실어증은 비유창한 발화를 보인다.\",\"5\":\"전반실어증은 비유창하고 이해·따라말하기가 모두 심하게 손상된다.\"}},\"1-1-1-15\":{\"p\":\"소뇌 손상과 함께 불규칙한 조음 붕괴, 과도하고 불규칙한 강세, 술 취한 듯한 말이 나타난다. 이는 운동 협응(타이밍·범위) 결함에 의한 실조형 마비말장애의 특징이다.\",\"w\":{\"1\":\"이완형은 하위운동신경 손상으로 근약화·과다비성·기식 음성이 특징이다.\",\"2\":\"경직형은 양측 상위운동신경 손상으로 느리고 노력성인 말과 쥐어짜는 음성이 특징이다.\",\"4\":\"과소운동형은 기저핵(파킨슨병) 병변으로 단조로운 음도·감소된 강도·말속도 가속을 보인다.\",\"5\":\"과다운동형은 기저핵 병변으로 불수의 운동에 따른 말의 변이를 보이며 소뇌 손상과 관련이 없다.\"}},\"1-1-1-16\":{\"w\":{\"1\":\"이완형은 하위운동신경 손상에 의한 근약화·저긴장으로 기식 음성을 보이며 쥐어짜는 음성과 다르다.\",\"2\":\"과소운동형은 기저핵 병변으로 단조로운 음도와 말속도 가속을 보인다.\",\"3\":\"실조형은 소뇌 손상으로 불규칙한 조음 붕괴와 강세 이상을 보인다.\",\"4\":\"편측 상부운동신경형은 한쪽 상위운동신경 손상으로 증상이 대체로 경미하므로 '양측' 손상 소견과 맞지 않는다.\"}},\"1-1-1-17\":{\"p\":\"안면신경·설하신경 등 뇌신경의 하위운동신경 손상으로 침범 근육의 약화와 위축이 나타난다. 과다비성, 기식 음성, 부정확한 자음은 이완형 마비말장애의 특징이다.\",\"w\":{\"1\":\"과다운동형은 기저핵 병변에 의한 불수의 운동이 특징이다.\",\"2\":\"경직형은 상위운동신경 양측 손상으로 근긴장 증가와 쥐어짜는 음성을 보인다.\",\"3\":\"실조형은 소뇌 손상으로 불규칙한 조음 붕괴를 보인다.\",\"5\":\"과소운동형은 기저핵 병변(파킨슨병)으로 단조로운 음도와 강도 감소를 보이며 근위축과 관련이 없다.\"}},\"1-1-1-18\":{\"p\":\"우반구 손상 환자는 음운·구문 등 언어 구조 자체는 비교적 보존되지만 담화 조직, 추론, 비유·유머 이해 등 화용언어와 운율에서 결함을 보인다. 시공간 처리 결함으로 좌측 무시가 동반될 수 있다.\",\"w\":{\"1\":\"심한 실문법증은 좌반구 브로카 영역 손상(브로카실어증)의 특징이다.\",\"2\":\"따라말하기의 선택적 손상은 전도실어증의 특징이다.\",\"3\":\"빈번한 음소착어는 전도실어증 등 좌반구 손상 실어증의 특징이다.\",\"5\":\"심한 청각적 이해력 손상은 베르니케실어증·전반실어증 등 좌반구 손상의 특징이다.\"}},\"1-1-1-19\":{\"w\":{\"1\":\"청각적 이해력이 심하게 손상된 전반실어증 환자는 MIT의 적용 대상이 아니다.\",\"3\":\"베르니케실어증 환자는 유창하지만 이해력이 낮아 MIT 적용 대상이 아니다.\",\"4\":\"우반구 손상 환자의 화용 결함은 MIT의 목표가 아니며 우반구 기능 활용 원리와도 맞지 않는다.\",\"5\":\"과다비성은 마비말장애의 공명 문제로 MIT의 적용 대상이 아니다.\"}},\"1-1-1-20\":{\"w\":{\"1\":\"멜로디억양치료는 멜로디·리듬을 이용해 비유창 실어증의 발화 산출을 유도하는 치료이다.\",\"3\":\"시각동작치료는 구어 대신 몸짓 상징을 훈련하는 전반실어증 치료이다.\",\"4\":\"각본치료는 일상 대화 각본을 반복 연습하여 자동화하는 치료이다.\",\"5\":\"성문위삼킴법은 흡인을 방지하는 삼킴 기법으로 이름대기와 무관하다.\"}},\"1-1-1-21\":{\"p\":\"한국판 보스턴이름대기검사(K-BNT)는 흑백 선화 60개를 보고 이름을 말하게 하는 대면 이름대기(confrontation naming) 검사이다. 자발적으로 이름을 대지 못하면 의미 단서와 음소 단서를 제공한다.\",\"w\":{\"1\":\"K-BNT는 구어로 이름을 말하는 검사이며 쓰기 표현을 평가하지 않는다.\",\"2\":\"청각적 이해력은 PK-WAB-R의 알아듣기 등으로 평가한다.\",\"3\":\"문장 따라말하기는 PK-WAB-R의 따라말하기 영역에서 평가한다.\",\"5\":\"읽기 이해는 읽기 검사 영역으로 K-BNT의 평가 대상이 아니다.\"}},\"1-1-1-22\":{\"w\":{\"1\":\"성문위삼킴법은 숨을 참아 진성대 수준에서 기도를 폐쇄하여 흡인을 방지하는 기법이다.\",\"2\":\"최대성문위삼킴법은 숨을 참고 힘을 주어 가성대·피열연골 수준까지 기도 입구를 폐쇄하는 기법이다.\",\"3\":\"노력삼킴은 힘껏 삼켜 혀 기저부 후방 운동을 증가시키고 후두개곡 잔여물을 줄이는 기법이다.\",\"5\":\"머리 회전법은 약한 쪽으로 머리를 돌려 그쪽 인두 경로를 닫고 건강한 쪽으로 음식물을 통과시키는 자세 기법이다.\"}},\"1-1-1-23\":{\"w\":{\"1\":\"조음은 알츠하이머성 치매에서 말기까지 비교적 보존된다.\",\"2\":\"구문 구조는 초기에 비교적 보존되고 후기에야 단순화된다.\",\"3\":\"따라말하기는 초기에 비교적 보존된다.\",\"4\":\"함구증은 말기 단계에서 나타나는 특징이다.\"}},\"1-1-1-24\":{\"w\":{\"1\":\"fMRI는 과제 수행 중 혈류 변화를 측정하는 기능적 영상이므로 구조적 병변만 보여준다는 설명은 틀리다.\",\"3\":\"CT는 구조적 영상이며 과제 수행 중 뇌 활성화를 측정하지 않는다.\",\"4\":\"DTI는 물 분자의 확산 방향성을 이용해 백질 신경섬유로의 구조·연결성을 보여주며 혈류 속도를 측정하지 않는다.\",\"5\":\"CT·구조 MRI·DTI처럼 구조적 정보를 제공하는 영상도 있으므로 틀리다.\"}},\"1-1-1-25\":{\"w\":{\"1\":\"2.25는 총 9낱말(9 ÷ 4)로 계산한 값으로 낱말을 여럿 누락한 오답이다.\",\"2\":\"2.5는 총 10낱말(10 ÷ 4)로 계산한 값으로 낱말 두 개를 빠뜨린 경우이다.\",\"3\":\"2.75는 총 11낱말(11 ÷ 4)로, '나도'를 한 낱말로 세어 체언 뒤 조사 '도'를 따로 세지 않은 오답이다.\",\"5\":\"3.25는 총 13낱말(13 ÷ 4)로, 합성어 '곰인형'까지 '곰/인형'으로 나누어 과다 계산한 오답이다.\"}},\"1-1-1-26\":{\"p\":\"아동은 '가위', '시계', '칫솔'의 목표 낱말을 산출하지 못하고 '자르는 거'(기능), '똑딱똑딱'(소리 특징), '이 닦는 거'(기능)로 대신 설명하고 있다. 이는 에두르기(circumlocution)로, 의미 지식은 있으나 낱말 인출에 어려움이 있음을 시사한다.\",\"w\":{\"2\":\"음소착어는 목표 낱말의 음소를 대치·첨가·생략하는 오류(예: 가위→가비)로, 기능 설명 반응과 다르다.\",\"3\":\"보속은 이전 반응을 다음 자극에 반복하는 것이나 세 반응은 각각 다르다.\",\"4\":\"세 항목 모두 목표 낱말을 산출하지 못했으므로 정상 범위로 볼 수 없다.\",\"5\":\"반응은 모두 목표와 의미적으로 관련된 실제 표현이므로 의미 없는 신조어가 아니다.\"}},\"1-1-1-27\":{\"p\":\"이야기에는 '그리고'(나열·순서), '그런데'(대조), '왜냐하면'(인과)의 접속부사가 사용되어 문장과 사건을 논리적으로 연결하고 있다. 이러한 접속 표현은 담화의 결속표지로서 이 이야기에서 가장 두드러진 언어 특성이다.\",\"w\":{\"1\":\"이야기에 '그것'이라는 지시 대용어가 쓰였으므로 대용어를 전혀 사용하지 않았다고 볼 수 없다.\",\"2\":\"배경·계기사건(당근을 심음), 시도(물을 줌), 결과(자라지 않음)와 이유 설명 등 이야기 문법 요소가 나타난다.\",\"4\":\"'토끼가', '당근을', '-었어요' 등 조사와 어미가 모두 바르게 사용되었다.\",\"5\":\"'씨앗을 거꾸로 심었기 때문이에요'처럼 명사절이 안긴 복문이 포함되어 있다.\"}},\"1-1-1-28\":{\"p\":\"KOLRA(한국어 읽기 검사)는 해독, 읽기이해, 읽기 유창성, 음운처리 등 읽기 능력과 관련 인지 처리를 평가하는 검사이다. 자발화 산출 능력은 평가 영역이 아니므로 연결이 옳지 않다.\",\"w\":{\"1\":\"REVT는 수용·표현 어휘력을 평가하므로 올바른 연결이다.\",\"3\":\"언어문제해결력검사는 원인 이유, 해결 추론, 단서 추측 등 상위언어·추론 능력을 평가하므로 올바른 연결이다.\",\"4\":\"PRES는 취학 전 아동의 수용·표현 언어 발달을 평가하므로 올바른 연결이다.\",\"5\":\"KOSECT는 구문의미 이해력을 평가하므로 올바른 연결이다.\"}},\"1-1-1-29\":{\"p\":\"가정에서는 베트남어만 사용하고 만 3세 어린이집 입소 후 한국어에 처음 본격 노출되었으므로 순차적 이중언어 아동이다. 한국어 노출 기간이 약 2년으로 짧아 한국어 수행이 낮게 나타날 수 있으므로 노출 기간과 모국어 능력을 함께 고려해 해석해야 한다.\",\"w\":{\"1\":\"만 3세 이후 제2언어에 노출되었으므로 동시적 이중언어가 아니며, 단일언어 규준을 그대로 적용할 수도 없다.\",\"2\":\"한국어 검사만으로는 노출 부족과 언어장애를 구별할 수 없으므로 모국어 능력 평가가 함께 필요하다.\",\"3\":\"모국어 사용 중단은 부모-자녀 상호작용의 질을 떨어뜨리므로 권고하지 않는다.\",\"4\":\"이중언어 노출 자체는 언어지연의 원인이 아니다.\"}},\"1-1-1-30\":{\"p\":\"아동은 인지·언어 이해력은 연령 수준이나 사지 운동 조절이 어려워 손가락 직접선택이 불가능하다. 눈 움직임과 머리 움직임이 안정적이므로 시선 응시를 통한 선택이나 머리 스위치를 이용한 스캐닝(간접선택)이 가장 적절하다.\",\"w\":{\"1\":\"수어는 정교한 손 움직임이 필요하므로 사지 운동 조절이 어려운 아동에게 적절하지 않다.\",\"2\":\"필담은 손으로 글씨를 써야 하므로 사지 운동장애 아동에게 부적절하다.\",\"3\":\"구어 산출이 어려운 아동에게 구어 훈련만 하면 기능적 의사소통 수단이 마련되지 않는다.\",\"5\":\"손가락으로 상징을 짚는 것이 불가능하다고 제시되어 있으므로 직접선택은 부적절하다.\"}},\"1-1-1-31\":{\"p\":\"낱말·비단어 읽기의 속도와 정확도가 또래 수준이므로 해독 능력에는 문제가 없다. 읽은 글의 이해·요약에서만 크게 어려워하고, 들려주면 이해하는 등 듣기이해는 양호하다. 해독은 정상이면서 읽기이해만 저조한 양상은 읽기이해부진에 해당한다.\",\"w\":{\"1\":\"난독증(해독 부진)은 낱말·비단어 해독의 정확도·유창성 결함이 핵심인데 이 아동은 해독이 또래 수준이다.\",\"3\":\"말소리장애는 조음·음운 산출의 문제로 제시된 소견과 무관하다.\",\"4\":\"쓰기 능력에 대한 정보가 없으며 핵심 문제는 읽기이해이다.\",\"5\":\"유창성장애는 말의 흐름(말더듬 등) 문제로 읽기이해와 무관하다.\"}},\"1-1-1-32\":{\"p\":\"상대의 말이 끝나기 전에 끼어들고(차례 주고받기 실패), 자신의 관심사만 일방적으로 말하며(주제 유지·전환 실패), 질문에 맞지 않게 대답하는(대화 연결 실패) 것은 대화 규칙의 어려움이다. 따라서 대화 차례 주고받기와 주제 유지를 우선 화용 목표로 설정한다.\",\"w\":{\"1\":\"낱말 해독 정확도는 읽기 영역의 목표로 제시된 화용 문제와 무관하다.\",\"2\":\"조음 정확도는 말소리 영역 목표로 제시된 문제와 무관하다.\",\"3\":\"MLU는 구문 길이 지표로 화용 능력 목표가 아니다.\",\"5\":\"음절·음소 인식은 읽기 선행 기술로 화용 목표가 아니다.\"}},\"1-1-1-33\":{\"w\":{\"2\":\"서술하기는 사물·사건에 대한 정보를 공유하는 기능으로 첫 번째 행동(요구)과 맞지 않는다.\",\"3\":\"첫 번째 행동은 거부가 아니라 요구이며, 두 번째 행동은 인사하기가 아니다.\",\"4\":\"공동주의(공동관심)는 사물에 대한 관심을 공유하는 기능으로 사물 획득이 목적인 첫 번째 행동과 다르다.\",\"5\":\"두 번째 행동은 관심 공유가 아니라 거부이다.\"}},\"1-1-1-34\":{\"p\":\"REVT 백분위수 수용 8, 표현 6으로 모두 10%ile 미만이어서 또래 대비 유의한 어휘 지체에 해당한다. 비언어성 지능과 청력이 정상이므로 언어 영역에 특정된 어려움이며, 자발화에서 제한된 어휘와 조사 생략이 관찰되므로 어휘 중심 언어치료가 필요하다고 상담한다.\",\"w\":{\"2\":\"청력이 정상이므로 청력 손실을 원인으로 볼 수 없다.\",\"3\":\"비언어성 지능이 정상 범위이므로 지능 저하가 원인이라 할 수 없다.\",\"4\":\"평가 결과는 어휘·문법의 문제이며 발음 문제에 대한 단서가 없다.\",\"5\":\"백분위수 10 미만은 정상 범위가 아니므로 치료가 필요하다.\"}},\"1-1-1-35\":{\"p\":\"원하는 주스를 눈에 보이지만 손이 닿지 않는 곳에 두고, 뚜껑을 꼭 닫아 도움이 필요한 상황을 만든 뒤 반응을 기다리고 있다. 이는 환경중심 언어중재에서 환경을 조작하여 아동의 자발적 요구하기를 유도하는 환경 조성 전략이다.\",\"w\":{\"1\":\"청각적 집중 자극은 목표 언어 형태를 반복적으로 들려주는 기법으로 반응을 기다리는 본 장면과 다르다.\",\"2\":\"스크립트 문맥 활용은 익숙한 일상 사건의 순서를 활용하는 중재이다.\",\"3\":\"비연속 개별시도 교수는 치료사가 자극-반응-강화를 통제하는 구조화된 행동주의 방법이다.\",\"4\":\"반응대가는 오반응 시 이미 받은 강화물을 회수하는 행동 감소 기법이다.\"}},\"1-1-1-36\":{\"p\":\"복문 산출·문법형태소, 조음, 읽기 해독은 연령 수준이다. 그러나 상위개념 어휘 이해(하위 5%)와 동의어·반의어 표현(하위 3%)에서만 유의한 지체를 보이므로, 어휘의 의미 관계(상위어·동의어·반의어)를 확장하는 중재를 우선 목표로 설정한다.\",\"w\":{\"1\":\"문법형태소 사용이 연령 수준이므로 우선 목표가 아니다.\",\"2\":\"읽기 해독이 연령 수준이므로 우선 목표가 아니다.\",\"3\":\"복문 산출이 연령 수준이므로 우선 목표가 아니다.\",\"4\":\"조음이 연령 수준이므로 우선 목표가 아니다.\"}},\"1-1-1-37\":{\"p\":\"상대의 말을 그대로 따라 말하는 반향어, 너/나를 뒤바꾸는 대명사 전도, 특정 관심사의 반복적 언급(제한된 관심사), 부족한 눈맞춤은 사회적 의사소통 결함과 제한적·반복적 행동을 함께 보이는 자폐스펙트럼장애의 대표적 특징이다.\",\"w\":{\"1\":\"단순언어장애는 언어 발달 지체가 주된 문제이며 반향어·제한된 관심사·눈맞춤 부족을 핵심 특징으로 하지 않는다.\",\"2\":\"청각장애 아동은 반향어와 대명사 전도, 제한된 관심사를 핵심 특징으로 보이지 않는다.\",\"3\":\"지적장애는 전반적 인지 지체가 핵심이며 제시된 사회적 상호작용·반복 행동 특징을 설명하지 못한다.\",\"5\":\"조음음운장애는 말소리 산출의 문제로 제시된 특징과 무관하다.\"}},\"1-1-1-38\":{\"p\":\"T-unit은 하나의 주절과 그에 딸린 종속절(내포절)을 한 단위로 센다. '토끼랑 거북이가 달리기를 했어요'(1), '토끼는 빨리 뛰다가 낮잠을 잤어요'(종속적 연결어미 '-다가'로 이어진 1), '그래서 거북이가 먼저 도착했어요'(1)로 총 3개이다.\",\"w\":{\"1\":\"2는 세 문장 중 하나를 앞 문장에 합쳐 센 과소 계산이다.\",\"3\":\"4는 '뛰다가'의 종속절을 별도 T-unit으로 분리한 오답이다.\",\"4\":\"5는 종속절과 절 단위를 과도하게 분리해 센 오답이다.\",\"5\":\"6은 T-unit이 아닌 절 또는 어절 단위로 과다 계산한 오답이다.\"}},\"1-1-1-39\":{\"p\":\"'창문이 열려 있네'가 '창문을 닫아 달라'는 요청일 수 있음을 아는 것은 간접 화행의 이해이다. 딴짓하는 학생에게 '지금 뭐 하고 있니?'라고 묻는 것이 실제 질문이 아니라 주의를 주는 말임을 아는 것은 함축된 의도의 이해이다. 이는 문자적 의미 너머의 의도를 파악하는 상위화용 능력이다.\",\"w\":{\"1\":\"음운인식은 말소리 단위를 인식·조작하는 능력으로 제시된 질문과 무관하다.\",\"2\":\"구문 산출 능력은 문장 구조를 만드는 능력으로 의도 해석 과제와 무관하다.\",\"4\":\"낱말 해독은 글자를 소리로 바꾸어 읽는 능력으로 제시된 구어 질문과 무관하다.\",\"5\":\"조음 정확도는 말소리 산출 능력으로 제시된 과제와 무관하다.\"}},\"1-1-1-40\":{\"p\":\"아동의 '차 가'를 치료사가 의미는 그대로 유지한 채 조사 '-가'와 어미 '-네'를 보태 '차가 가네'로 문법적으로 완전하게 다시 들려주었다. 이는 확장(expansion)에 해당한다.\",\"w\":{\"2\":\"혼잣말기법은 치료사가 자신의 행동을 스스로 말로 표현하는 기법이다.\",\"3\":\"평행발화기법은 아동의 행동이나 관심을 아동 입장에서 대신 말해 주는 기법이다.\",\"4\":\"확대(extension)는 아동 발화에 새로운 의미 정보를 덧붙이는 기법(예: '빨간 차가 빨리 가네')이다.\",\"5\":\"분리 및 합성은 아동 발화를 요소로 나누었다가 다시 합쳐 들려주는 기법이다.\"}},\"1-1-1-41\":{\"p\":\"스크립트 중재는 생일잔치, 마트 놀이처럼 아동에게 친숙한 일상 사건의 순서(스크립트)를 활용한다. 사건 구조가 익숙해 인지적 부담이 줄어들므로 새로운 언어 형식의 학습과 사용이 촉진된다.\",\"w\":{\"1\":\"감각통합 치료는 감각 처리·조절 능력을 향상시키는 작업치료적 접근이다.\",\"2\":\"청지각 훈련은 소리 변별·기억 등 청지각 능력을 훈련하는 접근이다.\",\"4\":\"핵심어휘 접근법은 사용 빈도가 높은 핵심 어휘를 중심으로 지도하는 접근으로 사건 순서 활용과 다르다.\",\"5\":\"청각구어법은 청각장애 아동의 잔존 청력을 활용해 듣기·말하기를 발달시키는 접근이다.\"}},\"1-1-1-42\":{\"w\":{\"1\":\"치료사가 자극과 강화를 모두 통제하는 개별시도 형식은 비연속 개별시도 교수(DTT)의 특징이다.\",\"3\":\"구조화된 책상 과제와 인위적 강화물 사용은 DTT의 특징이며 PRT와 반대된다.\",\"4\":\"PRT는 의사소통·사회적 행동을 목표로 하며 구강운동 훈련에 초점을 두지 않는다.\",\"5\":\"PRT는 아동 주도를 활용하므로 성인 주도 지시 따르기 우선은 틀리다.\"}},\"1-1-1-43\":{\"w\":{\"1\":\"0.4는 공식에 맞지 않는 계산 오류 값이다(16 ÷ 40에 해당).\",\"3\":\"0.6은 공식에 맞지 않는 계산 오류 값이다(24 ÷ 40에 해당).\",\"4\":\"0.8은 공식에 맞지 않는 계산 오류 값이다(32 ÷ 40에 해당).\",\"5\":\"2.0은 분자와 분모를 뒤바꿔 40 ÷ 20으로 계산한 오답이며, TTR은 1을 넘을 수 없다.\"}},\"1-1-1-44\":{\"p\":\"PECS 1단계(교환)는 아동이 원하는 사물의 그림카드를 집어 의사소통 상대에게 건네고 그 사물을 받는 교환 행동을 지도한다. 요구하기의 기본 형태를 가장 먼저 확립한다.\",\"w\":{\"1\":\"여러 그림 중 목표 그림을 변별하는 것은 3단계(그림 변별)이다.\",\"2\":\"'나는 ~을 원해요' 문장판 구성은 4단계(문장 구성)이다.\",\"3\":\"그림으로 감정·경험을 설명하는 것은 이후 단계의 언급하기(설명하기)에 해당한다.\",\"4\":\"PECS는 그림 교환 체계이며 그림 없이 음성으로 요구하는 것은 1단계 목표가 아니다.\"}},\"1-1-1-45\":{\"w\":{\"1\":\"시도는 주인공이 목표를 이루기 위해 하는 행동으로 이야기 문법 요소이다.\",\"2\":\"계기사건은 이야기를 시작하게 하는 사건으로 이야기 문법 요소이다.\",\"3\":\"내적 반응은 계기사건에 대한 인물의 감정·생각으로 이야기 문법 요소이다.\",\"5\":\"배경은 인물·시간·장소를 소개하는 이야기 문법 요소이다.\"}},\"1-1-1-46\":{\"p\":\"K-CTONI-2 지능지수 96으로 인지는 정상이고, 눈맞춤이 짧으며 상황에 맞지 않는 말, 주제 이탈, 비유·간접표현의 문자적 이해 등 화용 결함이 두드러진다(KOPLAC 3%ile). 제한된 관심사·상동행동·감각 특이성이 관찰되지 않으므로 사회적(화용) 의사소통장애로 진단한다.\",\"w\":{\"1\":\"자폐스펙트럼장애는 제한적·반복적 행동이 함께 나타나야 하는데 관찰되지 않았다.\",\"2\":\"비언어성 지능지수 96은 정상 범위이므로 지적장애가 아니다.\",\"4\":\"단순언어장애는 어휘·문법 등 언어 구조 결함이 핵심이며 본 아동은 화용 결함이 두드러진다.\",\"5\":\"학습장애는 읽기·쓰기·수학 등 학업 기술의 결함으로 제시된 화용 문제와 맞지 않는다.\"}},\"1-1-1-47\":{\"p\":\"제시된 오류는 형태소 규칙으로 설명되지 않는 관습적 표기 낱말에서 나타난다. 이러한 낱말은 소리나 형태소 분석만으로는 올바른 표기를 도출하기 어려우므로, 낱말의 표기형(철자 패턴) 자체를 기억하고 인출하도록 돕는 표기처리 중심 중재가 적절하다.\",\"w\":{\"2\":\"형태소의 원형을 밝혀 적는 형태처리 중재는 형태소 규칙으로 설명되는 표기에 효과적이며, 관습적 표기 오류를 해결하기 어렵다.\",\"3\":\"소리 나는 대로 적도록 하면 '할께요', '몇일'과 같은 오류를 오히려 강화한다.\",\"4\":\"쓰기(철자) 오류이므로 조음 중재와 무관하다.\",\"5\":\"읽기 유창성 훈련은 철자 표기 오류를 직접 다루지 않는다.\"}},\"1-1-1-48\":{\"w\":{\"1\":\"모든 발화가 두 낱말 조합으로 절을 이어 붙인 복문은 나타나지 않는다.\",\"3\":\"한 낱말 시기는 하나의 낱말로 의사소통하는 단계로 두 낱말 조합이 나타난 본 자료와 맞지 않는다.\",\"4\":\"문법형태소 자체가 아직 나타나지 않으므로 형태소 오류가 빈번한 단계로 볼 수 없다.\",\"5\":\"이야기 문법을 갖춘 담화는 학령전기 이후에 나타난다.\"}},\"1-1-1-49\":{\"w\":{\"1\":\"예기투쟁가설은 말더듬을 예상하고 이를 피하려는 긴장·투쟁 반응이 말더듬이라고 보는 이론으로, 부모의 오진단을 핵심으로 하지 않는다.\",\"3\":\"요구용량모델은 환경의 요구가 아동의 유창성 용량을 초과할 때 말더듬이 나타난다고 본다.\",\"4\":\"내적수정가설은 음운 부호화 오류를 내적으로 탐지·수정하는 과정에서 비유창성이 생긴다고 본다.\",\"5\":\"대뇌반구우세이론은 한쪽 대뇌반구의 우세성이 확립되지 않아 말운동 조절에 문제가 생긴다고 본다.\"}},\"1-1-1-50\":{\"w\":{\"1\":\"2회는 반복 2회만 세고 막힘과 연장을 누락한 계산이다.\",\"2\":\"3회는 막힘 또는 연장 중 하나를 누락한 계산이다.\",\"4\":\"5회는 간투사 '어'를 SLD에 포함한 오답이다.\",\"5\":\"6회는 반복의 반복 횟수 등을 개별적으로 과다 계산한 오답이다.\"}},\"1-1-1-51\":{\"w\":{\"1\":\"6%는 9 ÷ 150에 해당하는 값으로 계산 오류이다.\",\"3\":\"10%는 15 ÷ 150에 해당하는 값으로 계산 오류이다.\",\"4\":\"12.5%는 분자와 분모를 뒤바꿔 150 ÷ 12로 계산한 오답이다.\",\"5\":\"15%는 계산 오류이다(말더듬 음절이 22.5개일 때의 값).\"}},\"1-1-1-52\":{\"p\":\"빙산 모델(Sheehan)에서 수면 위는 반복·연장·막힘과 부수행동처럼 겉으로 관찰되는 행동이다. 수면 아래는 말더듬에 대한 두려움, 수치심, 죄책감, 좌절, 회피 등 드러나지 않는 감정과 태도로, 빙산처럼 더 큰 부분을 차지한다.\",\"w\":{\"1\":\"반복·연장·막힘은 관찰 가능한 핵심행동으로 수면 위에 해당한다.\",\"2\":\"관찰 가능한 신체적 부수행동은 수면 위에 해당한다.\",\"3\":\"말속도와 조음 정확도는 관찰·측정 가능한 말 특성으로 수면 아래 요소가 아니다.\",\"5\":\"문법 오류는 언어적 요소로 빙산 모델의 구성 요소가 아니다.\"}},\"1-1-1-53\":{\"p\":\"아동기 병력 없이 가족을 잃은 심리적 외상 후 성인기에 갑자기 발생하였다. 낱말 유형·위치와 무관한 일관된 반복, 반복 읽기에도 빈도가 줄지 않음(적응효과 없음), 부수행동·불안 부재는 심인성 말더듬의 특징이다.\",\"w\":{\"1\":\"위장 말더듬은 이득을 얻기 위해 의도적으로 더듬는 것으로 제시된 정보에 그런 동기가 없다.\",\"2\":\"신경학적 말더듬은 뇌졸중·외상성 뇌손상 등 신경학적 손상 병력이 있어야 하는데 제시되지 않았다.\",\"4\":\"속화는 빠르고 불규칙한 말속도와 명료도 저하가 특징이며 외상 후 급성 발병과 맞지 않는다.\",\"5\":\"발달성 말더듬은 대부분 2~5세에 시작되므로 아동기 병력 없는 성인기 발병과 맞지 않는다.\"}},\"1-1-1-54\":{\"w\":{\"1\":\"필수과제는 약함이지만 의사소통태도 17점은 초등학생 기준 81~90%ile로 '심함'이다. 두 결과가 모두 약할 때 유창성 완성법에 비중을 둔다.\",\"3\":\"두 결과가 모두 심할 때 말더듬 수정법과 심리치료 의뢰를 고려한다. 이 아동은 필수과제가 1~10%ile로 말더듬 정도가 '약함'이다.\",\"4\":\"의사소통태도 평가는 말을 더듬는 사람이 할 법한 답에 1점을 주므로 점수가 높을수록 부정적이다. 채점 방향이 반대이다.\",\"5\":\"P-FA-II 백분위는 말더듬 정도를 나타내며 1~10%ile은 '약함'이다. 정상 범위라는 뜻이 아니고, 의사소통태도가 심하므로 치료가 필요하다.\"}},\"1-1-1-55\":{\"p\":\"부모가 훈련을 받아 가정의 일상 대화에서 중재하며, 유창한 발화에 언어적 칭찬을, 말더듬에 간헐적 자기수정 요청을 제공한다. 치료사는 매주 말더듬 심한 정도(SR) 기록을 확인한다. 이는 조작적 조건화에 기반한 학령전기 부모 주도 프로그램인 리드콤 프로그램이다.\",\"w\":{\"1\":\"스토커 프로브 테크닉은 질문-응답의 단계적 복잡성으로 유창성을 높이는 치료사 중심 기법이다.\",\"2\":\"말더듬수정법은 말더듬을 편안하게 더듬도록 수정하는 기법(취소·빠져나오기·예비책)으로 부모의 언어적 유관 제공과 다르다.\",\"4\":\"GILCU는 치료사가 발화 길이와 복잡성을 단계적으로 늘려 가는 프로그램이다.\",\"5\":\"페일린 부모-아동 상호작용치료는 부모의 상호작용 방식(말속도, 차례 주고받기 등)을 조정하는 간접치료로, 말더듬에 대한 직접 수정 요청을 사용하지 않는다.\"}},\"1-1-1-56\":{\"w\":{\"1\":\"가벼운 조음접촉은 조음기관을 가볍게 접촉하는 유창성완성법의 기법이다.\",\"2\":\"빠져나오기는 말더듬이 일어나는 도중에 긴장을 풀며 벗어나는 기법이다.\",\"3\":\"예비책은 말더듬이 예상되는 낱말을 산출하기 직전에 적용하는 기법이다.\",\"4\":\"둔감화는 말더듬과 관련된 두려움·부정적 감정을 줄이는 단계이다.\"}},\"1-1-1-57\":{\"p\":\"빠르고 불규칙한 말속도, 음절 생략·낱말 축약에 의한 명료도 저하, 주제 이탈과 발화 조직화 어려움, 문제 인식 부족은 속화의 특징이다. 따라서 말속도를 낮추고 쉼을 넣는 말속도 조절과 녹음 청취 등을 통한 자기 모니터링 훈련을 우선 적용한다.\",\"w\":{\"1\":\"가벼운 조음접촉은 말더듬의 막힘을 줄이는 유창성완성법 기법이다.\",\"2\":\"호흡-발성 협응 훈련은 속화의 핵심 문제(말속도, 자기 인식)를 다루지 않는다.\",\"4\":\"둔감화는 말더듬에 대한 두려움을 다루는 기법으로 문제 인식이 부족한 속화와 맞지 않는다.\",\"5\":\"회피행동 감소 훈련은 말더듬의 회피행동을 다루는 것으로, 속화 화자는 대개 회피행동을 보이지 않는다.\"}},\"1-1-1-58\":{\"w\":{\"1\":\"말속도와 조음정확도는 SSI-4 중증도 산출 요소가 아니다.\",\"2\":\"어휘다양도와 발화길이는 언어 분석 지표로 SSI-4 산출 요소가 아니다.\",\"3\":\"음도와 강도는 음성 지표로 SSI-4 산출 요소가 아니다.\",\"4\":\"의사소통태도·자아효능감·회피는 별도의 자기보고 척도로 측정하며 SSI-4 산출 요소가 아니다.\"}},\"1-1-1-59\":{\"w\":{\"1\":\"SESAS는 말더듬 빈도를 측정하지 않으며 점수 상승은 긍정적 변화를 의미한다.\",\"2\":\"점수 상승은 부정적 변화가 아니라 긍정적 변화이다.\",\"3\":\"점수 상승은 말에 대한 통제력(자신감)의 증가를 의미한다.\",\"4\":\"44점 상승은 치료 효과가 나타났음을 시사한다.\"}},\"1-1-1-60\":{\"p\":\"아버지는 더듬을 때마다 '천천히 말해', '다시 말해 봐'라고 지적하고 말을 대신 끝맺어 주고 있다. 지적·교정·대신 말하기는 아동의 긴장과 시간 압박을 높이므로, 지적을 줄이고 말을 끝까지 기다리며 느리고 편안한 대화 분위기를 만들도록 상담한다.\",\"w\":{\"1\":\"즉각적 교정은 아동의 말에 대한 의식과 긴장을 높인다.\",\"2\":\"말을 대신 끝맺는 것은 시간 압박을 주고 표현 기회를 빼앗는다.\",\"4\":\"빠른 말 시범은 아동의 말속도 압박을 높이므로 느린 말 시범이 권장된다.\",\"5\":\"더듬은 낱말을 반복시키는 것은 말더듬에 대한 부정적 주의를 높인다.\"}},\"1-1-1-61\":{\"w\":{\"1\":\"막힘은 핵심행동이다.\",\"2\":\"소리 연장은 핵심행동이다.\",\"3\":\"단어부분 반복은 핵심행동이다.\",\"4\":\"음절 반복은 핵심행동이다.\"}},\"1-1-1-62\":{\"w\":{\"2\":\"남아의 유병률이 여아보다 높다는 것은 옳은 설명이다.\",\"3\":\"상당수가 자연회복된다는 것은 옳은 설명이다.\",\"4\":\"유전적 요인이 관여한다는 것은 옳은 설명이다.\",\"5\":\"대부분 2~5세에 시작된다는 것은 옳은 설명이다.\"}},\"1-1-1-63\":{\"w\":{\"2\":\"완전히 유창한 말의 확립은 유창성완성법의 목표이다.\",\"3\":\"말더듬수정법은 말더듬의 완전 제거를 목표로 하지 않는다.\",\"4\":\"말더듬수정법은 회피행동을 줄이는 것을 목표로 한다.\",\"5\":\"느린 말의 영구적 사용은 말더듬수정법의 목표가 아니며, 느린 말은 유창성완성법의 초기 확립 수단이다.\"}},\"1-1-1-64\":{\"w\":{\"1\":\"긴장된 막힘은 진성 비유창성(SLD)에 해당한다.\",\"2\":\"소리 연장은 진성 비유창성에 해당한다.\",\"3\":\"긴장을 동반한 음절 반복은 진성 비유창성에 해당한다.\",\"5\":\"긴장을 동반한 일음절 낱말 반복은 진성 비유창성에 해당한다.\"}},\"1-1-1-65\":{\"w\":{\"1\":\"뇌졸중·외상성 뇌손상 이후 발생한다는 것은 옳은 설명이다.\",\"2\":\"적응효과가 잘 나타나지 않는다는 것은 옳은 설명이다.\",\"3\":\"낱말 유형·위치와 무관하게 나타난다는 것은 옳은 설명이다.\",\"4\":\"발달성 말더듬에 비해 부수행동·불안이 적다는 것은 옳은 설명이다.\"}},\"1-1-1-66\":{\"w\":{\"1\":\"대뇌우세이론은 대뇌반구 우세성의 불완전 확립을 말더듬 원인으로 보는 이론이다.\",\"2\":\"진단착오이론은 부모의 오진단과 부정적 반응이 말더듬을 만든다고 보는 이론이다.\",\"3\":\"요구용량모델은 환경의 요구가 아동의 용량을 초과할 때 말더듬이 나타난다고 보는 이론이다.\",\"5\":\"이원이론(Brutten & Shoemaker)은 고전적 조건화된 부정적 정서가 핵심 비유창을, 조작적 조건화가 부수행동을 만든다고 보는 이론이다.\"}},\"1-1-1-67\":{\"p\":\"적응효과는 같은 자료를 반복해서 읽을수록 말더듬 빈도가 점차 감소하는 현상이다. 발달성 말더듬에서 흔히 관찰되며 신경학적·심인성 말더듬과의 감별에 활용된다.\",\"w\":{\"1\":\"일관성효과는 반복 읽기에서 같은 낱말·위치에서 반복적으로 더듬는 경향이다.\",\"2\":\"자발회복(자연회복)은 치료 없이 말더듬이 사라지는 현상이다.\",\"3\":\"인접효과는 이전에 더듬은 위치에 인접한 곳에서 새로운 말더듬이 나타나는 경향이다.\",\"4\":\"후속효과는 반복 읽기에 따른 말더듬 빈도 감소를 가리키는 용어가 아니다.\"}},\"1-1-1-68\":{\"w\":{\"1\":\"에둘러 말하기는 어려운 낱말을 피하는 회피행동이다.\",\"3\":\"말할 순서를 미루는 것은 발화 시점을 피하는 회피행동이다.\",\"4\":\"전화 받기를 피하는 것은 상황 회피행동이다.\",\"5\":\"낱말을 다른 낱말로 바꾸는 것은 낱말 대치 회피행동이다.\"}},\"1-1-1-69\":{\"w\":{\"1\":\"느린 말·부드러운 발성 시작으로 유창한 말을 확립하는 것은 유창성완성법의 옳은 설명이다.\",\"2\":\"가벼운 조음접촉은 유창성완성법의 대표 기법이다.\",\"3\":\"확립된 유창성을 실제 상황으로 일반화하는 것은 유창성완성법의 옳은 설명이다.\",\"4\":\"말더듬 자체보다 유창한 말 패턴 형성에 초점을 두는 것은 유창성완성법의 옳은 설명이다.\"}},\"1-1-1-70\":{\"w\":{\"1\":\"차폐기는 소음으로 화자 자신의 말소리를 차단하는 기기로 지연 청취와 다르다.\",\"3\":\"비음측정기는 비음치(nasalance)를 측정하는 공명 평가 기기이다.\",\"4\":\"전기성문파형기는 성대 접촉 양상을 측정하는 음성 평가 기기이다.\",\"5\":\"스펙트로그램은 음향 신호의 주파수·시간·강도를 시각화하는 분석 도구이다.\"}},\"1-1-1-71\":{\"w\":{\"1\":\"말더듬 빈도는 %SS 등 발화 표본 분석으로 측정한다.\",\"2\":\"말더듬 지속시간은 SSI-4 등 관찰 측정으로 평가한다.\",\"4\":\"신체적 부수행동은 SSI-4 등 관찰 평가로 측정한다.\",\"5\":\"말속도는 발화 표본의 초당·분당 음절 수로 측정한다.\"}},\"1-1-1-72\":{\"w\":{\"2\":\"빠져나오기는 말더듬이 일어나는 도중에 적용하는 기법이다.\",\"3\":\"취소는 말더듬이 끝난 후 멈추었다가 다시 말하는 기법이다.\",\"4\":\"둔감화는 말더듬에 대한 두려움과 부정적 감정을 줄이는 단계이다.\",\"5\":\"고유수용감각 훈련은 조음 동작의 감각을 인식하도록 하는 확인 단계 활동으로, 말더듬 직전 긴장 완화 기법이 아니다.\"}},\"1-1-2-1\":{\"p\":\"음원-여과기 이론에서 성대 진동은 기본주파수(F0)와 그 배음을 포함한 음원 스펙트럼을 만들고, 성도(인두강·구강·비강)는 그 형태와 길이에 따라 특정 주파수 대역을 강조하거나 감쇠시키는 여과기로 작용한다. 성도의 공명 특성에 의해 강조된 주파수 대역이 포먼트이다. 따라서 음원(성대)과 여과기(성도)는 서로 독립적으로 작동하며, 포먼트는 음원이 아니라 여과기의 특성으로 결정된다.\",\"w\":{\"1\":\"포먼트는 성도의 형태·길이(공명 특성)에 의해 결정되며, 성대 진동수는 기본주파수와 배음 간격을 결정한다.\",\"2\":\"기본주파수는 성대의 길이·긴장도·질량과 성문하압에 의해 결정되며 성도 길이는 포먼트에 영향을 준다.\",\"4\":\"음원(후두의 성대)과 여과기(성문 위 성도)는 해부학적으로 분리된 구조이며 서로 독립적으로 작동한다는 것이 이 이론의 핵심이다.\",\"5\":\"폐의 공기압은 성대 진동을 일으키는 에너지원(동력원)이며 여과 기능은 성도가 담당한다.\"}},\"1-1-2-2\":{\"p\":\"음도는 성대의 진동수(기본주파수)에 의해 결정되며, 진동수는 성대의 길이·긴장도·질량의 영향을 받는다. 윤상갑상근(CT)이 수축하면 갑상연골이 앞아래로 기울어 성대가 길어지고 얇아지며 긴장되므로 단위 질량당 긴장도가 커져 진동수가 증가한다. 이것이 음도 상승의 대표적 생리 기전이다.\",\"w\":{\"1\":\"성대가 짧아지고 두꺼워지면 질량이 증가하고 긴장도가 감소하여 진동수가 낮아지므로 음도는 내려간다.\",\"3\":\"호기류량 증가만으로는 음도를 조절할 수 없으며, 음도는 주로 성대의 길이·긴장도 조절에 의해 결정된다.\",\"4\":\"성문하압을 높이면 진동수가 다소 증가하는 경향이 있으므로 성문하압을 낮추는 것은 음도 상승 기전이 아니다.\",\"5\":\"갑상피열근은 성대 몸체를 이루는 근육으로, 이 근육만 이완시키는 것은 음도 상승의 주된 기전이 아니며 음도 상승의 핵심은 윤상갑상근의 수축이다.\"}},\"1-1-2-3\":{\"p\":\"폐활량과 성문하압이 정상이므로 호흡 기능의 문제는 배제된다. MPT 5.2초는 성인 정상치(약 15~20초 이상)에 비해 현저히 짧고, 평균호기류율 260 mL/sec는 정상 범위(약 100~200 mL/sec)보다 증가하여 발성 중 성문에서 공기가 새는 성문폐쇄부전을 나타낸다. 여기에 기식적이고 약한 음성이 동반되므로 성대가 정중선으로 충분히 내전되지 못하는 편측 성대마비가 가장 적절하다.\",\"w\":{\"1\":\"근긴장성 발성장애는 후두 근육의 과긴장으로 쥐어짜는 음성을 보이며 대개 호기류율이 감소하는 경향이 있다.\",\"2\":\"라인케부종은 성대 전장의 부종으로 질량이 증가하여 낮고 거친 음성이 특징이며, 기식성·호기류율 증가가 핵심 소견이 아니다.\",\"4\":\"내전형 연축성발성장애는 과내전으로 인한 쥐어짜는 음성과 음성 끊김이 특징이며 호기류율은 감소한다.\",\"5\":\"변성발성장애는 변성기 이후에도 높은 음도가 유지되는 기능적 장애로, 성문폐쇄부전을 시사하는 공기역학적 소견과 관련이 없다.\"}},\"1-1-2-4\":{\"p\":\"음성장애지수(VHI)는 환자 스스로 음성 문제로 인해 겪는 불편감을 신체(Physical)·기능(Functional)·정서(Emotional) 세 영역으로 평정하는 자기보고식 설문이다. 문항에서 요구하는 '환자가 지각하는', '일상생활에 미치는 영향', '자기보고식'이라는 조건을 모두 충족한다.\",\"w\":{\"1\":\"CAPE-V는 평가자가 시각적 아날로그 척도로 음성 특성을 평정하는 청지각적 평가 도구이다.\",\"2\":\"MPT는 한 번의 흡기 후 최대로 발성을 지속하는 시간을 측정하는 공기역학적 지표이다.\",\"3\":\"GRBAS 척도는 평가자가 G·R·B·A·S 다섯 항목을 0~3점으로 평정하는 청지각적 평가 도구이다.\",\"5\":\"음성범위프로파일(VRP)은 음도별 최소·최대 강도를 측정하여 발성 가능 범위를 나타내는 음향학적 측정이다.\"}},\"1-1-2-5\":{\"w\":{\"1\":\"제시된 지표는 주기성·잡음 관련 측정치이며 음성 강도(dB)는 측정되지 않았다.\",\"3\":\"기본주파수(F0)가 성별·연령 규준 범위이므로 습관적 음도가 높다고 볼 수 없다.\",\"4\":\"MDVP의 jitter·shimmer·NHR은 발성(음원)의 규칙성을 반영하며 공명 문제는 비음치 등 별도 측정으로 확인한다.\",\"5\":\"jitter·shimmer·NHR이 모두 증가하였으므로 정상 음질이 아니며 거친 음성·기식성 등 음질 이상을 시사한다.\"}},\"1-1-2-6\":{\"p\":\"양측 성대 막성부 중간(전방 1/3과 중간 1/3 경계)의 대칭적 양성 병변과 모래시계형 성문폐쇄는 성대결절의 전형적 소견이며, 하루 6교시 수업과 잦은 큰 소리 사용은 음성 남용·오용 원인을 보여 준다. 성대결절은 음성 사용 습관 개선으로 호전 가능한 병변이므로 반폐쇄성도훈련(SOVT) 등 음성치료와 음성위생 교육을 우선 적용한다. 수술은 충분한 음성치료 후에도 호전이 없을 때 고려한다.\",\"w\":{\"2\":\"보툴리눔 독소 주입은 연축성발성장애 등 근육의 불수의적 과활동에 적용하는 치료이다.\",\"3\":\"성대 주입술은 성대마비·성대구증·위축 등 성문폐쇄부전을 보완하기 위한 수술적 처치이다.\",\"4\":\"제I형 갑상성형술은 성대를 내측으로 이동시키는 수술로 편측 성대마비 등 성문폐쇄부전에 적용한다.\",\"5\":\"후두미세수술은 음성치료에 반응하지 않는 결절이나 폴립·낭종 등에서 고려하며 결절의 일차 치료가 아니다.\"}},\"1-1-2-7\":{\"p\":\"후두내시경상 구조적 이상이 없는데도 발화 시에는 속삭임만 가능하고, 기침·웃음 같은 반사적(생리적) 발성에서는 정상 유성음이 산출되는 것은 기능적(심인성) 실성증의 특징이다. 성대가 발성 가능한 상태임이 확인되므로 기침·헛기침·허밍 등 보존된 반사적 발성에서 출발하여 모음·낱말·문장으로 확장하며 발성을 재확립한다.\",\"w\":{\"1\":\"후두내시경에서 구조적 이상이 없으므로 기질적 실성증이 아니다.\",\"2\":\"구조적 병변이 없는 기능적 장애이므로 수술이 아니라 음성치료가 우선이다.\",\"3\":\"사례에서 기침과 웃음 시 정상 유성음이 산출된다고 제시되어 있다.\",\"5\":\"성대마비라면 기침·웃음에서도 성문폐쇄부전이 나타나고 내시경에서 성대 운동 이상이 관찰되어야 한다.\"}},\"1-1-2-8\":{\"p\":\"변성기가 지난 남성이 후두 구조와 호르몬이 정상인데도 높은 음도를 지속하는 것은 변성발성장애(청년기 가성)이다. 갑상연골 전면을 손가락으로 부드럽게 후하방으로 누르면 성대가 짧아지고 이완되어 낮은 진성 발성이 유도되며(손가락 조작법), 이렇게 얻은 낮은 음도를 모음·낱말·대화 수준으로 안정화한다.\",\"w\":{\"1\":\"가성구 발성은 이미 문제가 되는 높은 음도를 강화하므로 목표와 반대이다.\",\"2\":\"큰 소리의 고음 발성 반복은 높은 음도 습관을 고착시키고 성대에 부담을 준다.\",\"3\":\"속삭이는 소리는 음도 조절 훈련이 되지 않으며 성대 긴장을 유발할 수 있다.\",\"4\":\"성대 과내전 유도는 성문폐쇄부전 환자에게 적용하는 접근이며 음도를 낮추는 기법이 아니다.\"}},\"1-1-2-9\":{\"p\":\"파킨슨병 환자는 음성 강도 저하(hypophonia), 단조로운 음도, 말끝 흐림을 보이며, 스스로 목소리가 작다고 느끼지 않는 감각 인식(자기 감시) 저하가 특징이다. 리실버만음성치료(LSVT LOUD)는 '크게 말하기'라는 단일 목표를 고강도·고빈도로 반복 훈련하고 새로운 강도 수준을 정상으로 느끼도록 감각을 재보정하는 근거 기반 치료로, 강도와 명료도 개선 효과가 보고되어 있다.\",\"w\":{\"1\":\"차폐 기법(롬바드 효과)은 일시적으로 강도를 높일 뿐 치료 효과의 유지·일반화가 어렵고 파킨슨병의 대표 치료가 아니다.\",\"2\":\"속삭임 발성은 강도를 더 낮추므로 약한 음성을 가진 환자의 목표와 반대이다.\",\"3\":\"가성대 발성은 진성대 발성이 불가능할 때 대안으로 고려하는 방법이며 파킨슨병의 음성 강도 문제에 적용하지 않는다.\",\"5\":\"저작하기 기법은 과긴장성 발성에서 후두 긴장을 이완시키는 기법으로 강도 저하 문제의 주된 치료가 아니다.\"}},\"1-1-2-10\":{\"w\":{\"1\":\"모음으로 시작하는 낱말에서 내전근 연축으로 쥐어짜는 듯한 음성 끊김이 나타나는 것은 내전형의 전형적 특징이다.\",\"3\":\"속삭임·노래·웃음 등에서 증상이 감소하는 과제 특이성은 연축성발성장애의 특징이다.\",\"4\":\"갑상피열근에 보툴리눔 독소를 주입하는 것이 내전형 연축성발성장애의 대표적 치료이다.\",\"5\":\"성대 내전근의 불수의적 연축에 의한 신경학적 장애라는 설명은 이 장애의 정의에 해당한다.\"}},\"1-1-2-11\":{\"p\":\"후두전적출술 후에는 기관이 목의 영구 기관공으로 분리되어 폐의 공기가 구강으로 올라오지 못한다. 식도발성은 공기를 주입(삼키기·흡입)하여 식도 상부에 넣었다가 역류시키면서 인두식도분절(PE segment)을 진동시켜 새로운 음원으로 삼는 무후두 음성 방법이며, 별도 보철 없이 훈련할 수 있다.\",\"w\":{\"1\":\"후두전적출 후에는 성대가 없고 폐의 공기가 기관공으로 배출되므로 폐의 공기를 성대로 보낼 수 없다.\",\"3\":\"보철(프로테제) 삽입이 필요한 것은 기관식도발성(TE 발성)이며 식도발성은 보철 없이 가능하다.\",\"4\":\"목에 전기 진동자를 대어 소리를 내는 것은 인공후두(전기후두) 발성이다.\",\"5\":\"후두전적출로 제거된 성대는 재생되지 않는다.\"}},\"1-1-2-12\":{\"p\":\"74세 고령, 성대 위축과 활모양(bowing) 성문틈, 병변과 신경학적 이상이 없다는 소견은 노인성 음성(presbyphonia)을 시사하며, 핵심 문제는 성문폐쇄부전으로 인한 약하고 쉽게 피로한 음성이다. 따라서 밀기 접근법, 강한 성대접촉 유도 등 성대내전을 강화하고 발성 효율을 높이는 음성치료가 적절하다.\",\"w\":{\"1\":\"음성 사용 제한은 급성 염증·수술 후 등에 적용하며, 위축된 성대는 오히려 적절한 발성 훈련이 필요하다.\",\"2\":\"속삭임은 성문을 열어 두고 발성하므로 성문폐쇄부전을 악화시키고 강도 증가에 도움이 되지 않는다.\",\"3\":\"보툴리눔 독소 주입은 과내전을 약화시키는 치료로 성문폐쇄부전 환자에게는 역효과이다.\",\"5\":\"음도를 낮추는 훈련은 이 환자의 핵심 문제인 성문폐쇄부전과 약한 강도를 개선하는 목표가 아니다.\"}},\"1-1-2-13\":{\"p\":\"GRBAS 척도는 G(Grade, 전반적 중증도), R(Roughness, 조조성·거친 소리), B(Breathiness, 기식성), A(Asthenia, 무력성), S(Strain, 긴장성)의 다섯 항목을 평정한다. 따라서 R은 조조성(거친 소리)을 의미한다.\",\"w\":{\"1\":\"전반적 중증도는 G(Grade)에 해당한다.\",\"3\":\"기식성은 B(Breathiness)에 해당한다.\",\"4\":\"무력성은 A(Asthenia)에 해당한다.\",\"5\":\"긴장성은 S(Strain)에 해당한다.\"}},\"1-1-2-14\":{\"p\":\"편측성의 유경성(줄기 달린) 병변, 갑작스러운 고함 등 급성 음성 남용 후 발생, 거칠고 낮은 음성은 성대폴립의 전형적 소견이다. 성대폴립은 대개 편측성이며 유경성 또는 무경성으로 나타나고, 병변으로 인한 질량 증가로 음도가 낮아지고 거친 음성이 나타난다.\",\"w\":{\"1\":\"성대결절은 만성적 음성 남용으로 발생하며 대개 양측성·대칭성의 무경성 병변이다.\",\"2\":\"성대구증은 성대 유리연을 따라 고랑이 패인 형태로, 줄기 달린 병변이 아니다.\",\"3\":\"라인케부종은 흡연 등과 관련된 성대 전장의 양측성 부종으로 유경성 병변이 아니다.\",\"4\":\"후두유두종은 HPV 감염과 관련된 사마귀 모양 병변으로 급성 음성 남용과 무관하다.\"}},\"1-1-2-15\":{\"p\":\"근긴장성 발성장애(MTD)는 후두에 기질적 병변이나 신경학적 원인 없이 후두 내·외근의 과도한 긴장으로 쥐어짜는 음성, 음성 피로 등이 나타나는 기능적 음성장애이다. 문항의 '기질적 병변 없음'과 '후두 주변 근육의 과도한 긴장'이 핵심 단서이다.\",\"w\":{\"1\":\"편측 성대마비는 신경 손상에 의한 장애로 기식적이고 약한 음성이 특징이다.\",\"2\":\"변성발성장애는 변성기 이후에도 높은 음도가 유지되는 장애로 근육 과긴장이 핵심 정의가 아니다.\",\"3\":\"연축성 발성장애는 불수의적 근육 연축에 의한 신경학적 장애로 단순한 근육 과긴장과 구별된다.\",\"5\":\"성대구증은 성대 유리연에 고랑이 있는 기질적 병변이다.\"}},\"1-1-2-16\":{\"p\":\"shimmer는 성대 진동의 주기 간 진폭(강도) 변동률을 나타내는 측정치로, 값이 클수록 진폭이 불규칙함을 의미한다. 주기 간 주파수 변동률인 jitter와 짝을 이루어 음성의 안정성을 평가한다.\",\"w\":{\"2\":\"F0(기본주파수)는 초당 성대 진동 횟수로, 변동률이 아니라 음도의 음향학적 대응치이다.\",\"3\":\"NHR은 소음 성분 대 배음 성분의 비율로 신호 내 잡음 정도를 나타낸다.\",\"4\":\"CPP(켑스트럼 최고점 돌출도)는 신호의 주기성(배음 구조의 뚜렷함)을 반영하는 지표로 기식성·중증도 평가에 활용된다.\",\"5\":\"jitter는 주기 간 기본주파수의 변동률이다.\"}},\"1-1-2-17\":{\"p\":\"/s/는 무성음이므로 연장 시간이 주로 호흡 기능을 반영하고, /z/는 유성음이므로 호흡과 성대 진동(발성) 기능을 함께 반영한다. 정상인은 두 시간이 비슷하여 비율이 약 1.0이며, 1.4 이상으로 증가하면 /z/ 연장이 상대적으로 짧다는 뜻이므로 성대 병변 등으로 인한 성문폐쇄부전(발성 시 공기 누출)을 우선 의심한다.\",\"w\":{\"1\":\"호흡 기능만 저하되었다면 /s/와 /z/가 함께 짧아져 비율은 1.0 근처로 유지된다.\",\"2\":\"s/z 비율은 성문 수준의 발성 효율을 반영하며 조음기관의 구조적 이상을 평가하는 지표가 아니다.\",\"3\":\"s/z 비율은 청력 손실과 직접 관련된 지표가 아니다.\",\"5\":\"공명강 협착은 공명 특성에 영향을 주며 s/z 비율 증가의 원인으로 해석하지 않는다.\"}},\"1-1-2-18\":{\"p\":\"속삭이는 소리는 성문을 부분적으로 열고 후두 근육을 긴장시킨 상태로 산출되어 오히려 성대에 과도한 긴장과 부담을 줄 수 있으므로 음성위생법으로 권장되지 않는다. 음성 휴식이 필요할 때는 속삭임 대신 발화량을 줄이거나 편안한 음성을 짧게 사용하도록 교육한다.\",\"w\":{\"1\":\"충분한 수분 섭취는 성대 점막의 윤활을 도와 음성위생에 해당한다.\",\"2\":\"소음 환경에서 큰 소리로 말하기를 줄이는 것은 음성 남용을 예방하는 음성위생 교육 내용이다.\",\"4\":\"습관적 헛기침은 성대에 충격을 주므로 줄이도록 하는 것이 적절한 음성위생 교육이다.\",\"5\":\"과도한 카페인은 이뇨 작용으로 성대 건조를 유발할 수 있어 줄이도록 권장한다.\"}},\"1-1-2-19\":{\"p\":\"되돌이후두신경(반회후두신경)은 미주신경의 분지로 윤상갑상근을 제외한 후두 내근을 지배하며, 갑상샘 뒤쪽 기관식도구를 따라 주행하므로 갑상샘 수술 시 손상되기 쉽다. 손상되면 편측 성대마비가 발생하여 기식적이고 약한 음성이 나타난다.\",\"w\":{\"2\":\"안면신경(제7뇌신경)은 얼굴 표정근을 지배하며 성대 운동과 무관하다.\",\"3\":\"설하신경(제12뇌신경)은 혀의 운동을 지배한다.\",\"4\":\"삼차신경(제5뇌신경)은 저작근 운동과 얼굴 감각을 담당한다.\",\"5\":\"부신경(제11뇌신경)은 흉쇄유돌근·승모근을 지배하며 후두 내근을 지배하지 않는다.\"}},\"1-1-2-20\":{\"p\":\"MPT는 최대 흡기 후 모음을 편안한 음도·강도로 최대한 지속하는 시간으로, 호흡 지지와 성문 폐쇄 효율을 함께 반영한다. 현저히 짧으면 발성 중 성문에서 공기가 새는 성문폐쇄부전이나 호흡 지지(폐활량·호기 조절)의 부족을 우선 시사한다.\",\"w\":{\"1\":\"MPT는 발성 지속 능력을 측정하며 청력과 직접 관련이 없다.\",\"3\":\"성대 과내전은 공기 누출이 적어 MPT가 현저히 짧아지는 주된 원인이 아니다.\",\"4\":\"MPT는 모음 연장 과제로 조음기관의 이상을 반영하지 않는다.\",\"5\":\"MPT는 공명강의 이상을 평가하는 지표가 아니다.\"}},\"1-1-2-21\":{\"p\":\"인유두종바이러스(HPV) 감염, 성대의 사마귀 모양 병변, 애성과 기도 폐쇄, 소아에서의 반복적 재발은 재발성 후두유두종(재발성 호흡기 유두종증)의 핵심 특징이다. 기도 폐쇄 위험이 있어 반복적인 수술적 제거가 필요한 경우가 많다.\",\"w\":{\"1\":\"성대결절은 음성 남용으로 인한 양측성 양성 병변으로 바이러스 감염이나 기도 폐쇄와 관련이 없다.\",\"2\":\"라인케부종은 주로 흡연 성인에게 나타나는 성대 부종이다.\",\"4\":\"성대구증은 성대 유리연의 고랑으로 바이러스성 사마귀 모양 병변이 아니다.\",\"5\":\"근긴장성 발성장애는 병변이 없는 기능적 장애이다.\"}},\"1-1-2-22\":{\"p\":\"전기성문파형검사(EGG)는 목의 갑상연골 양쪽에 전극을 대고 미세 전류를 흘려 성대 접촉 면적 변화에 따른 전기 저항의 변화를 기록한다. 이를 통해 성대의 개방·폐쇄 주기와 접촉 양상(접촉률 등)을 비침습적으로 간접 측정할 수 있다.\",\"w\":{\"2\":\"나조미터는 구강·비강 음향 에너지를 측정하여 비음치를 산출하는 공명 평가 도구이다.\",\"3\":\"스펙트로그램은 시간에 따른 주파수·강도 변화를 시각화하는 음향 분석 도구로 성대 접촉을 직접 측정하지 않는다.\",\"4\":\"순음청력검사는 주파수별 청력역치를 측정하는 청각 검사이다.\",\"5\":\"음성범위프로파일은 음도별 강도 범위를 측정하는 음향학적 도구이다.\"}},\"1-1-2-23\":{\"p\":\"빨대 발성(물컵 속 빨대 포함), 입술 트릴, 허밍은 모두 반폐쇄성도훈련(SOVT)이다. 성도의 출구를 부분적으로 좁히면 성문 상부(성도 내) 압력이 높아져 성문 위아래 압력 차가 줄어들고, 이로써 성대 접촉 충격은 감소하면서 적은 노력으로 효율적인 발성이 유도된다.\",\"w\":{\"1\":\"SOVT는 성대 접촉 충격을 줄이는 원리이며 성대를 강하게 접촉시키는 것은 밀기 접근법 등의 원리이다.\",\"2\":\"성문을 완전히 개방하면 발성이 이루어지지 않으며 기식성을 늘리는 것은 치료 목표가 아니다.\",\"3\":\"SOVT는 편안한 음도 범위에서 실시하며 가성구로만 발성하도록 하는 기법이 아니다.\",\"4\":\"호흡을 멈추면 발성이 불가능하며 SOVT는 지속적인 호기류를 이용한다.\"}},\"1-1-2-24\":{\"p\":\"성대구증은 성대 유리연(자유연)을 따라 점막층에 고랑이 패인 질환으로, 이 고랑 때문에 발성 시 성대가 완전히 닫히지 않아 성문폐쇄부전, 기식 음성, 음성 피로가 나타난다. 문항의 '유리연을 따라 고랑'이 결정적 단서이다.\",\"w\":{\"1\":\"후두유두종은 HPV 관련 사마귀 모양 증식성 병변이다.\",\"2\":\"성대결절은 막성부 중간의 양측성 결절 병변으로 고랑 형태가 아니다.\",\"3\":\"라인케부종은 성대 전장의 부종으로 질량 증가가 특징이다.\",\"4\":\"성대폴립은 편측성의 유경성 또는 무경성 돌출 병변이다.\"}},\"1-1-2-25\":{\"p\":\"Dodd의 분류에서 음운지연은 오류패턴 자체는 정상 발달에서 나타나는 음운변동이지만, 그 변동이 해당 연령이 지나서도 지속되는 경우이다. 아동1은 어린 정상 아동에게 나타나는 종성생략·연구개음 전방화가 4세에도 지속되므로 음운지연에 해당한다.\",\"w\":{\"2\":\"아동2는 혀 내밀기로 인한 /ㅅ/ 왜곡이 모든 문맥에서 일관되므로 운동적 산출 문제인 조음장애에 해당한다.\",\"3\":\"아동3은 발달과정에서 드문 비전형적 오류패턴이 일관되게 나타나므로 일관적 음운장애에 해당한다.\",\"4\":\"아동4는 같은 낱말을 40% 이상 다르게 산출하므로 비일관적 음운장애에 해당한다.\",\"5\":\"아동1이 음운지연에 해당하므로 해당 아동이 없다는 진술은 틀리다.\"}},\"1-1-2-26\":{\"w\":{\"1\":\"수박의 종성 /ㄱ/을 포함하여 모든 종성이 산출되었으므로 종성생략은 0회이다.\",\"2\":\"호랑이→[호앙이]는 /ㄹ/이 활음이 아닌 생략(탈락)으로 나타난 것이며 활음화는 나타나지 않았다.\",\"4\":\"연구개음 전방화는 코끼리의 첫 /ㅋ/→[ㅌ], 그네의 /ㄱ/→[ㄷ]의 2회이며 코끼리의 /ㄲ/은 정조음되었다.\",\"5\":\"비음이 아닌 음이 비음으로 대치된 예가 없으므로 비음화는 0회이다.\"}},\"1-1-2-27\":{\"p\":\"조음해야 할 자음은 가방 3개(ㄱ,ㅂ,ㅇ), 모자 2개(ㅁ,ㅈ), 나무 2개(ㄴ,ㅁ), 딸기 3개(ㄸ,ㄹ,ㄱ)로 총 10개이다. 오류는 가방→[가바]의 종성 /ㅇ/ 생략과 모자→[모다]의 /ㅈ/→[ㄷ] 대치로 2개이므로 정확하게 산출한 자음은 8개이다. 따라서 PCC = 8/10 × 100 = 80%이다.\",\"w\":{\"1\":\"오류를 4개로 계산한 것으로, 정확한 자음 수를 실제보다 2개 적게 센 결과이다.\",\"2\":\"오류를 3개로 계산한 것으로, 정조음된 딸기의 /ㄹ/ 등을 오류로 잘못 센 결과이다.\",\"4\":\"오류를 1개로 계산한 것으로, 종성 /ㅇ/ 생략 또는 /ㅈ/→[ㄷ] 대치 중 하나를 누락한 결과이다.\",\"5\":\"오류가 없는 경우이며 실제로는 생략 1개와 대치 1개의 오류가 있다.\"}},\"1-1-2-28\":{\"p\":\"무의미음절 /사/, /수/에서 단서를 주면 정조음이 가능하므로 다음 단계는 목표음을 의미 있는 낱말에서 확립하는 것이다. 현재 목표는 어두 /ㅅ/이므로 어두에 /ㅅ/가 오는 '사탕, 손, 시소'가 적절하며, 안정되면 어중·어말, 구·문장 수준으로 확장한다.\",\"w\":{\"1\":\"'단추, 다리, 도장'은 아동의 오류음인 /ㄷ/로 시작하는 낱말로 목표음 /ㅅ/가 없다.\",\"2\":\"'거울, 가위, 구두'는 연구개음 /ㄱ/ 낱말로 목표음 /ㅅ/가 없다.\",\"4\":\"'라면, 리본, 로봇'은 유음 /ㄹ/ 낱말로 목표음 /ㅅ/가 없다.\",\"5\":\"'모자, 무지개, 미소'는 어두가 /ㅁ/이며, 미소의 /ㅅ/는 어중 위치이므로 어두 /ㅅ/ 목표에 맞지 않다.\"}},\"1-1-2-29\":{\"p\":\"골도 역치가 10 dB HL로 정상이어서 내이·청신경 기능은 정상이고, 기도 역치가 45 dB HL로 상승하여 기도-골도 차가 35 dB로 크게 나타난다. 이는 소리 전달 경로(외이·중이)의 문제를 뜻하는 전음성 난청 소견이므로 중이염 등 중이 질환 여부를 확인해야 한다.\",\"w\":{\"1\":\"감각신경성 난청은 기도·골도 역치가 함께 상승하고 기도-골도 차가 거의 없다.\",\"3\":\"기도 역치 45 dB HL은 정상 범위(약 25 dB HL 이하)를 벗어나 경도~중도 난청에 해당한다.\",\"4\":\"혼합성 난청은 골도 역치도 상승해야 하는데 골도 역치가 10 dB HL로 정상이다.\",\"5\":\"청신경 종양은 후미로성(감각신경성) 병변으로 골도 역치 상승을 동반한다.\"}},\"1-1-2-30\":{\"p\":\"평음 /ㅂ, ㄷ, ㄱ/이 각각 경음 [ㅃ, ㄸ, ㄲ]으로 대치되는 경음화가 일관되게 나타났다. 평음과 경음은 조음 위치·방법이 같고 [긴장성] 자질에서만 대립하므로(평음 [−긴장성], 경음 [+긴장성]), 아동은 긴장성 자질의 대립을 아직 확립하지 못한 것이다.\",\"w\":{\"1\":\"지속성은 파열음·파찰음과 마찰음 등을 구분하는 자질이며, 제시된 대치는 파열음 간 대치로 지속성 값이 같다.\",\"3\":\"비음성은 비음과 구강음을 구분하는 자질이며 제시된 오류에 비음이 관여하지 않는다.\",\"4\":\"설측성은 유음 /ㄹ/의 설측음을 구분하는 자질로 제시된 오류와 무관하다.\",\"5\":\"공명성은 공명음(비음·유음·모음)과 장애음을 구분하는 자질이며 목표음과 대치음이 모두 장애음이다.\"}},\"1-1-2-31\":{\"w\":{\"1\":\"음운변동 분석은 목표 형태와 아동 산출을 비교하는 관계분석에 해당한다.\",\"2\":\"자음정확도(PCC)는 목표 자음 대비 정확한 자음 비율로 관계분석 지표이다.\",\"3\":\"목표 음소 대비 정확도 산출은 목표와 비교하는 관계분석이다.\",\"5\":\"자극반응도는 단서·모방 조건에서의 오류음 산출 가능성을 평가하는 것으로 독립분석의 정의가 아니다.\"}},\"1-1-2-32\":{\"p\":\"문맥검사에서 /ㅅ/가 /ㅣ/ 모음 앞에서만 정조음된다는 것은 /시/가 촉진 문맥임을 뜻한다. 촉진 문맥은 아동이 이미 성공할 수 있는 지점이므로 치료의 출발점으로 삼고, /시/에서 안정적으로 산출한 뒤 다른 모음 문맥, 음절·낱말 수준으로 점진적으로 확대한다.\",\"w\":{\"1\":\"비언어적 구강운동 훈련만으로는 말소리 산출 개선 효과의 근거가 부족하며 확인된 촉진 문맥을 활용하지 못한다.\",\"3\":\"오류가 가장 심한 문맥부터 시작하면 실패 경험이 많아지고 촉진 문맥의 이점을 활용하지 못한다.\",\"4\":\"정조음 가능한 문맥이 있어 자극반응도가 있는 음소이므로 훈련을 중단할 이유가 없다.\",\"5\":\"초기부터 모든 문맥을 무작위로 섞으면 성공 기반을 확보하기 어렵다. 무작위 연습은 산출이 안정된 뒤 일반화 단계에 적합하다.\"}},\"1-1-2-33\":{\"w\":{\"1\":\"음절 수 세기가 음소 분절보다 먼저 발달한다.\",\"2\":\"각운 인식이 음소 조작보다 먼저 발달하며 음소 조작은 가장 늦게 발달하는 과제에 속한다.\",\"3\":\"음운인식은 해독 능력의 핵심 예측 변인으로 읽기와 밀접하게 관련된다.\",\"4\":\"음절 탈락이 음소 탈락보다 먼저 발달한다.\"}},\"1-1-2-34\":{\"w\":{\"1\":\"목록에 없는 음소로만 구성된 낱말은 초기 성공 경험을 제공하기 어렵다.\",\"3\":\"초기에는 단순한 음절 구조의 짧은 낱말에서 시작하고 점차 복잡성을 높인다.\",\"4\":\"초기 낱말 선정에서는 발음 난이도보다 의사소통 기능과 의미가 우선한다.\",\"5\":\"사용 빈도가 낮은 낱말은 일상 의사소통에 활용되기 어려워 기능성이 낮다.\"}},\"1-1-2-35\":{\"p\":\"구개열 수술 후 아동이 압력자음(파열음·마찰음) 산출 시 코로 공기가 새는 것은 연인두폐쇄부전에 의한 비강누출을 시사한다. 차가운 거울(비경)을 콧구멍 아래 대고 압력자음을 산출하게 하여 김서림을 관찰하면 비강누출을 간편하게 선별할 수 있다.\",\"w\":{\"1\":\"교호운동속도(DDK)는 조음기관의 운동 속도·규칙성을 평가하며 비강누출을 선별하지 않는다.\",\"2\":\"청력역치 측정은 구개열 아동에게 필요한 검사이지만 비강누출·과다비성 선별 방법이 아니다.\",\"4\":\"최대연장발성시간은 호흡·발성 효율을 평가하며 공명을 선별하지 않는다.\",\"5\":\"수용어휘력 검사는 언어 이해 능력을 평가하며 공명과 무관하다.\"}},\"1-1-2-36\":{\"p\":\"청능훈련은 소리의 유무를 아는 탐지, 두 소리가 같은지 다른지 구별하는 변별, 들은 소리가 무엇인지 알아 지적·반복하는 확인, 말의 의미를 파악하는 이해의 순서로 진행한다(Erber의 위계). 따라서 탐지 → 변별 → 확인 → 이해가 바른 순서이다.\",\"w\":{\"2\":\"소리가 있는지 알아야 두 소리를 비교할 수 있으므로 탐지가 변별보다 먼저이다.\",\"3\":\"같고 다름을 구별하는 변별이 무슨 소리인지 지적하는 확인보다 먼저이다.\",\"4\":\"확인이 가장 먼저 올 수 없으며 탐지가 첫 단계이다.\",\"5\":\"발달 순서를 역순으로 나열한 것이다.\"}},\"1-1-2-37\":{\"p\":\"최소대립쌍 치료는 '불-풀'처럼 한 음소의 차이로 의미가 구별되는 낱말 쌍을 이용하여, 아동이 오류로 인해 두 낱말의 의미가 혼동됨을 인식하게 하고 음운 대조를 확립하도록 유도하는 음운론적 접근이다.\",\"w\":{\"1\":\"짝자극 기법은 목표음을 정조음하는 핵심 낱말과 훈련 낱말을 짝지어 전이를 유도하는 조음 접근이다.\",\"3\":\"주기법은 여러 오류 음운패턴을 주기마다 순환하며 목표로 하는 접근이다.\",\"4\":\"전통적 조음지시법은 조음 위치·방법을 직접 지시하여 개별 음소 산출을 훈련하는 운동적 접근이다.\",\"5\":\"구강운동 훈련은 말소리가 아닌 구강 움직임 연습으로 의미 대조를 이용하지 않는다.\"}},\"1-1-2-38\":{\"p\":\"주기법(cycles approach, Hodson)은 명료도가 매우 낮은 아동을 대상으로 여러 오류 음운패턴을 정해진 기간씩 주기(cycle)마다 순환하며 목표로 삼는 음운적 접근이다. 한 패턴의 완전한 습득을 기다리지 않고 순환하며 점진적 발달을 유도한다.\",\"w\":{\"1\":\"짝자극 기법은 핵심 낱말과 훈련 낱말을 짝지어 목표음을 일반화하는 기법이다.\",\"2\":\"감각운동 기법(McDonald)은 음성 문맥을 활용하여 음절 단위의 조음 운동을 훈련하는 방법이다.\",\"3\":\"조음점 지시법은 조음 위치·방법을 직접 지시하여 개별 음소를 유도하는 방법이다.\",\"5\":\"변별자질 접근법은 오류에 공통된 변별자질의 대립을 목표로 하는 방법으로 패턴을 순환하지 않는다.\"}},\"1-1-2-39\":{\"w\":{\"2\":\"말명료도는 청자가 화자의 말을 알아듣는 정도이다.\",\"3\":\"말소리목록은 아동이 산출할 수 있는 음소의 목록이다.\",\"4\":\"일관성은 같은 낱말을 반복 산출할 때 오류 형태가 동일한 정도이다.\",\"5\":\"음운인식은 말소리 단위를 인식하고 조작하는 상위언어 능력이다.\"}},\"1-1-2-40\":{\"w\":{\"1\":\"자음의 정확도는 PCC 등으로 측정되는 조음 정확도이며 명료도에 영향을 주는 요인 중 하나일 뿐이다.\",\"2\":\"음도·강도의 적절성은 음성 영역의 평가 요소이다.\",\"3\":\"문법적 정확성은 언어(구문) 영역의 평가 요소이다.\",\"4\":\"말속도는 명료도에 영향을 줄 수 있지만 명료도의 정의가 아니다.\"}},\"1-1-2-41\":{\"p\":\"/ㅂ/와 /ㅁ/는 모두 양순음으로 조음 위치가 같지만, /ㅁ/는 연구개를 내려 비강으로 공기를 보내는 [+비음성], /ㅂ/는 [−비음성]이다. 따라서 두 음은 비음성 자질에서 대립한다.\",\"w\":{\"2\":\"지속성은 마찰음 등 기류가 지속되는 음을 구분하며 /ㅂ/와 /ㅁ/의 핵심 대립이 아니다.\",\"3\":\"설정성은 혀끝·혓날이 관여하는 음을 구분하며 양순음인 두 음은 모두 [−설정성]이다.\",\"4\":\"긴장성은 평음·경음 등을 구분하는 자질로 /ㅂ/와 /ㅃ/의 대립에 해당한다.\",\"5\":\"고설성은 혀몸을 높이는 음(경구개·연구개음)을 구분하며 두 음 모두 [−고설성]이다.\"}},\"1-1-2-42\":{\"p\":\"한국어 자음 습득에서 양순음·비음·파열음은 이른 시기에 습득되는 반면, 치경마찰음 /ㅅ, ㅆ/은 유음 /ㄹ/과 함께 가장 늦게 완전 습득되는 말소리에 속한다. 제시된 선택지 중 가장 늦게 습득되는 음은 /ㅅ/이다.\",\"w\":{\"1\":\"/ㄷ/는 치경 파열음으로 이른 시기에 습득된다.\",\"2\":\"/ㅂ/는 양순 파열음으로 가장 이른 시기에 습득되는 음에 속한다.\",\"3\":\"/ㅁ/는 양순 비음으로 가장 이른 시기에 습득된다.\",\"5\":\"종성 /ㅇ/는 비음으로 이른 시기에 습득된다.\"}},\"1-1-2-43\":{\"p\":\"라면→[야면], 나라→[나야]에서 유음 /ㄹ/이 활음 /j/로 대치되었고, 리본→[이본]에서도 /ㄹ/이 활음화(또는 탈락)되어 나타났다. 이처럼 유음 /ㄹ/이 활음으로 대치되거나 생략되는 것은 유음의 단순화(활음화)이다.\",\"w\":{\"1\":\"유음의 비음화라면 /ㄹ/이 /ㄴ/ 등 비음으로 대치되어야 하지만(예: 라면→[나면]) 비음 대치는 없다.\",\"2\":\"파열음화는 마찰음·파찰음이 파열음으로 대치되는 변동으로 제시된 자료에 없다.\",\"3\":\"라면·리본의 종성 /ㄴ/이 모두 산출되어 종성생략은 없다.\",\"4\":\"전방화는 조음 위치가 앞으로 이동하는 대치(예: 연구개음→치경음)로 제시된 오류와 다르다.\"}},\"1-1-2-44\":{\"p\":\"코→[고], 토끼→[도끼], 파→[바]에서 격음(기식음) /ㅋ, ㅌ, ㅍ/이 같은 조음 위치의 평음 /ㄱ, ㄷ, ㅂ/으로 대치되었다. 조음 위치·방법은 유지되고 기식성만 사라졌으므로 탈기식음화(이완음화)이다.\",\"w\":{\"2\":\"조음 위치는 연구개·치경·양순 그대로 유지되어 전방화가 아니다.\",\"3\":\"경음화는 평음이 경음으로 대치되는 변동인데 대치음 /ㄱ, ㄷ, ㅂ/은 평음이다.\",\"4\":\"목표음이 이미 파열음이므로 마찰음·파찰음이 파열음이 되는 파열음화가 아니다.\",\"5\":\"기식음화는 평음·경음이 격음으로 대치되는 변동으로 제시된 오류와 반대 방향이다.\"}},\"1-1-2-45\":{\"p\":\"단어단위정확률(PWC)은 목표 형태와 완전히 동일하게 산출한 낱말 수를 전체 낱말 수로 나눈 값이다. 5개 중 3개를 정확히 산출하였으므로 PWC = 3 ÷ 5 = 0.6이다.\",\"w\":{\"1\":\"오류 낱말 수 2를 분자로 계산한 값(2 ÷ 5)이다.\",\"2\":\"전체 5개 중 절반 정도로 어림한 값이며 3 ÷ 5와 일치하지 않는다.\",\"4\":\"정확한 낱말 수를 실제보다 많게 계산한 값으로 3 ÷ 5와 일치하지 않는다.\",\"5\":\"정확 낱말을 4개로 계산한 값(4 ÷ 5)이다.\"}},\"1-1-2-46\":{\"w\":{\"1\":\"주기법은 여러 음운패턴을 주기적으로 순환하며 목표로 하는 음운적 접근이다.\",\"2\":\"최소대립쌍 치료는 의미 대조를 이용하는 음운적 접근으로 조음 위치를 직접 지시하지 않는다.\",\"4\":\"음운변동 접근법은 오류 패턴(음운변동) 단위로 목표를 선정하는 음운적 접근이다.\",\"5\":\"상위음운 접근법은 말소리 체계에 대한 상위 인식을 높이는 접근이다.\"}},\"1-1-2-47\":{\"w\":{\"2\":\"치경음 후방화라면 치경음이 연구개음 등으로 대치되어야 하는데 반대 방향의 오류가 나타났다.\",\"3\":\"우산의 /ㅅ/가 정조음되었고 마찰음이 파열음으로 대치된 예가 없다.\",\"4\":\"우산의 종성 /ㄴ/ 등 종성이 모두 산출되어 종성생략이 없다.\",\"5\":\"코끼리의 /ㄹ/이 정조음되어 유음의 단순화가 나타나지 않았다.\"}},\"1-1-2-48\":{\"p\":\"'할머니'가 [하머니]로 산출되어 첫 음절의 종성 /ㄹ/이 생략되었으므로 종성생략이 나타났다. 또한 '샀어요'가 [다떠요]로 산출되어 마찰음 /ㅅ, ㅆ/이 파열음 [ㄷ, ㄸ]으로 대치(파열음화)되었다.\",\"w\":{\"1\":\"종성 /ㄹ/ 생략과 마찰음 대치 오류가 있으므로 자음정확도는 100%가 아니다.\",\"3\":\"유음 /ㄹ/이 비음으로 대치된 예가 없으며 '랑'의 /ㄹ/은 정조음되었다.\",\"4\":\"'샀어요→[다떠요]'에서 마찰음이 파열음으로 대치되어 모든 마찰음을 정확히 조음하지 못하였다.\",\"5\":\"'가서'의 /ㄱ/ 등 연구개음이 정조음되어 연구개음 전방화가 나타나지 않았다.\"}},\"1-1-2-49\":{\"p\":\"언어재활사는 자신이 교육·훈련을 받아 역량을 갖춘 영역 내에서 서비스를 제공해야 하며, 새로운 영역은 교육과 슈퍼비전을 통해 역량을 갖춘 뒤 수행해야 한다. 훈련·슈퍼비전 없이 인터넷 정보에만 의존해 삼킴장애 환자를 단독 중재한 것은 전문성 유지의 의무 위반이다.\",\"w\":{\"1\":\"비밀유지의 의무는 내담자 정보를 동의 없이 공개한 경우에 해당하며 사례에 정보 유출이 없다.\",\"2\":\"차별금지는 내담자의 특성을 이유로 서비스를 차별한 경우에 해당한다.\",\"3\":\"연구 윤리는 연구 수행 과정의 윤리 문제로 사례는 임상 중재에 관한 것이다.\",\"5\":\"동료 간 협력 의무와도 관련될 수 있으나, 핵심 위반은 역량 범위를 벗어난 서비스 제공이다.\"}},\"1-1-2-50\":{\"p\":\"발달재활서비스는 만 18세 미만 등록 장애아동을 대상으로 언어·청능·미술·음악·행동·놀이 등 재활서비스를 바우처로 지원하며, 가구 소득 수준에 따라 본인부담금이 차등 부과된다. 만 7세 등록 장애아동이고 소득이 기준 이내이므로 대상에 해당하며 본인부담금을 내고 바우처로 서비스를 이용할 수 있다.\",\"w\":{\"2\":\"발달재활서비스는 등록 장애아동을 주 대상으로 하는 사업이다.\",\"3\":\"대상 연령은 만 18세 미만이다.\",\"4\":\"소득 수준에 따라 본인부담금이 차등 부과되며 전액 무료는 일부 계층(기초생활수급자 등)에 한정된다.\",\"5\":\"의료기관 입원 치료가 아니라 지정 제공기관의 재활서비스를 바우처로 지원한다.\"}},\"1-1-2-51\":{\"w\":{\"1\":\"혼란변인은 독립변인 외에 종속변인에 영향을 주어 결과 해석을 혼란스럽게 하는 통제되지 않은 변인이다.\",\"2\":\"매개변인은 독립변인과 종속변인 사이에서 영향을 전달하는 중간 변인이다.\",\"3\":\"통제변인은 결과에 영향을 주지 않도록 연구자가 일정하게 유지하는 변인이다.\",\"4\":\"종속변인은 처치의 결과로 측정되는 변인으로 이 연구에서는 자발적 의사소통 시도 횟수이다.\"}},\"1-1-2-52\":{\"p\":\"메타분석은 동일 주제의 여러 개별 연구 결과를 체계적으로 수집하고 효과크기로 변환하여 통계적으로 통합함으로써 전체 효과크기를 산출하는 연구 방법이다. 근거 기반 실제(EBP)에서 높은 수준의 근거로 활용된다.\",\"w\":{\"1\":\"횡단적 기술연구는 한 시점에서 여러 대상의 특성을 기술하는 연구이다.\",\"2\":\"단일대상연구는 한 명 또는 소수 대상에게 기초선-중재 설계를 적용하여 효과를 검증하는 연구이다.\",\"3\":\"질적 사례연구는 소수 사례를 심층적으로 기술·해석하는 연구로 통계적 통합을 하지 않는다.\",\"4\":\"델파이 조사는 전문가 집단의 의견을 반복 수렴하여 합의를 도출하는 방법이다.\"}},\"1-1-2-53\":{\"p\":\"잘 진술된 행동목표는 수행 조건(그림자극), 관찰 가능한 목표 행동(어두 /ㅅ/ 정조음), 도달 준거(10개 중 8개), 숙달 기준(3회기 연속)을 포함한다. 어떤 치료 기법으로 가르칠지는 중재 절차에 해당하며 행동목표 진술에 포함되는 요소가 아니다. 제시된 목표에도 치료 기법은 명시되어 있지 않다.\",\"w\":{\"1\":\"'그림자극 10개 중'은 목표 행동이 수행되는 조건으로 목표에 포함되어 있다.\",\"2\":\"'어두 /ㅅ/를 정조음한다'는 관찰·측정 가능한 목표 행동으로 포함되어 있다.\",\"4\":\"'10개 중 8개'는 도달 준거로 포함되어 있다.\",\"5\":\"'3회기 연속'은 숙달 기준으로 포함되어 있다.\"}},\"1-1-2-54\":{\"p\":\"「장애인복지법」상 1급 언어재활사 국가시험은 2급 언어재활사 자격 취득을 전제로 하며, 관련 대학원 석사·박사학위 취득 후 언어재활 경력 1년 이상, 또는 관련 학과 학사학위 취득자로서 경력 3년 이상의 요건을 갖추어야 한다. 2급 자격 없이 경력만으로는 응시할 수 없으므로 ①이 옳지 않다.\",\"w\":{\"2\":\"2급 취득 후 관련 대학원 석·박사학위와 경력 1년 이상은 법정 응시자격에 해당한다.\",\"3\":\"2급 취득 후 관련 학과 학사학위 취득자로서 경력 3년 이상은 법정 응시자격에 해당한다.\",\"4\":\"응시자격에서 요구하는 경력은 언어재활 분야의 경력이므로 옳은 설명이다.\",\"5\":\"1급 응시에는 2급 자격 취득이 전제되므로 옳은 설명이다.\"}},\"1-1-2-55\":{\"p\":\"산업재해보상보험은 업무상 재해에 대한 사용자의 보상 책임을 보험화한 제도이므로 보험료를 사업주가 전액 부담한다. 국민연금·국민건강보험(노인장기요양보험 포함)·고용보험의 실업급여 보험료는 근로자와 사업주가 분담한다.\",\"w\":{\"1\":\"국민연금 보험료는 근로자와 사업주가 각각 절반씩 부담한다.\",\"3\":\"국민건강보험료는 근로자와 사업주가 각각 절반씩 부담한다.\",\"4\":\"고용보험 중 실업급여 보험료는 근로자와 사업주가 절반씩 부담하며, 고용안정·직업능력개발사업분만 사업주가 부담한다.\",\"5\":\"노인장기요양보험료는 건강보험료에 연동되어 근로자와 사업주가 분담한다.\"}},\"1-1-2-56\":{\"p\":\"어머니의 빠른 말속도, 길고 복잡한 문장, 아동의 반응을 기다리지 않는 상호작용은 아동이 입력을 처리하고 반응할 기회를 줄인다. 따라서 말속도를 늦추고 아동의 언어 수준보다 약간 높은 짧고 단순한 문장을 사용하며, 아동이 반응할 시간을 충분히 기다려 주도록 지도하는 것이 적절하다.\",\"w\":{\"2\":\"더 빠른 속도와 많은 어휘는 아동의 처리 부담을 늘리며 문제 행동을 강화한다.\",\"3\":\"아동의 주의와 이해를 돕기 위해서는 낮고 단조로운 억양보다 풍부하고 과장된 억양이 권장된다.\",\"4\":\"아동이 말할 내용을 대신 말하면 아동의 표현 기회를 빼앗는다.\",\"5\":\"잦은 직접 교정은 의사소통 의욕을 떨어뜨리므로 확장·재구성 등 간접 모델링을 사용한다.\"}},\"1-1-2-57\":{\"p\":\"지능은 정상이고 들려주는 이야기의 이해(듣기 이해)도 또래 수준인데, 낱말을 소리 내어 읽는 해독의 정확성과 유창성에서만 두드러진 어려움을 보인다. 이는 단순관점 모델에서 해독 결함에 해당하는 난독증(읽기 특정학습장애)의 핵심 양상이다.\",\"w\":{\"1\":\"지능이 정상 범위이므로 지적장애가 아니다.\",\"2\":\"들려주는 이야기의 이해가 또래 수준이므로 청각장애로 인한 문제로 보기 어렵다.\",\"3\":\"단순언어장애는 구어 이해·표현 전반의 결함이 특징인데 듣기 이해가 정상이다.\",\"5\":\"말소리장애는 말소리 산출의 문제이며, 사례의 핵심은 문자 해독의 어려움이다.\"}},\"1-1-2-58\":{\"w\":{\"1\":\"무발화 영유아에게 표준화 검사 원점수만으로 언어 연령을 산출하면 능력이 제대로 반영되지 않는다.\",\"3\":\"말을 시작할 때까지 평가를 미루면 조기 발견과 조기 중재의 기회를 놓친다.\",\"4\":\"보호자 정보는 일상 의사소통을 파악하는 중요한 자료이므로 배제하지 않고 관찰 자료와 함께 활용한다.\",\"5\":\"단일 회기의 검사 점수만으로 장애를 확정하는 것은 신뢰성이 낮아 부적절하다.\"}},\"1-1-2-59\":{\"w\":{\"1\":\"연구 윤리는 연구 수행 과정의 윤리 문제이며 사례는 연구 상황이 아니다.\",\"3\":\"전문성 유지의 의무는 역량 범위 내 서비스 제공과 지속적 전문성 개발에 관한 것이다.\",\"4\":\"동료 간 협력은 전문가 간 관계에 관한 것으로 사례의 핵심이 아니다.\",\"5\":\"차별금지는 내담자를 특성에 따라 차별하는 경우에 해당한다.\"}},\"1-1-2-60\":{\"w\":{\"1\":\"보수교육은 1급뿐 아니라 2급을 포함한 모든 언어재활사에게 부과된다.\",\"2\":\"보수교육은 최초 취득 시 1회가 아니라 매년 이수해야 한다.\",\"3\":\"보수교육 이수는 자격 유지와 관련되며 미이수 시 제재를 받을 수 있다.\",\"4\":\"보수교육은 대학원 재학 여부와 무관하게 자격 보유자에게 부과된다.\"}},\"1-1-2-61\":{\"p\":\"중재 효과 연구에서 독립변인 외에 종속변인에 영향을 줄 수 있는 외생변인(혼란변인)을 통제하면, 관찰된 종속변인의 변화가 독립변인(중재) 때문이라고 확신할 수 있다. 즉 인과 추론의 정확성인 내적 타당도를 높이기 위해 변인을 통제한다.\",\"w\":{\"1\":\"변인 통제는 대상자 수를 줄이기 위한 것이 아니다.\",\"2\":\"종속변인은 중재 효과를 판단하기 위해 반드시 측정해야 한다.\",\"4\":\"변인 통제의 목적은 결과의 일반화를 제한하는 것이 아니라 인과관계를 명확히 하는 것이다.\",\"5\":\"독립변인은 연구자가 계획적으로 조작하는 변인이며 무작위로 바꾸는 대상이 아니다.\"}},\"1-1-2-62\":{\"w\":{\"1\":\"상관연구는 변인 간의 관련성 정도를 분석하며 중재를 조작하지 않는다.\",\"2\":\"집단비교연구는 다수의 대상을 실험집단과 통제집단으로 나누어 비교한다.\",\"4\":\"델파이 조사는 전문가 의견을 반복 수렴하여 합의를 도출하는 방법이다.\",\"5\":\"메타분석은 여러 연구 결과를 통계적으로 통합하는 방법이다.\"}},\"1-1-2-63\":{\"p\":\"타당도는 검사도구가 측정하고자 하는 개념이나 능력을 실제로 정확하게 측정하는 정도이다. 반면 신뢰도는 측정 결과의 일관성·안정성을 의미하므로 두 개념을 구별해야 한다.\",\"w\":{\"2\":\"실용도는 검사의 실시·채점·해석이 경제적이고 편리한 정도이다.\",\"3\":\"신뢰도는 반복 측정 시 결과가 일관되게 나타나는 정도이다.\",\"4\":\"객관도는 채점자 간 채점 결과가 일치하는 정도(채점자 신뢰도)이다.\",\"5\":\"난이도는 문항의 쉽고 어려운 정도로 문항 분석 지표이다.\"}},\"1-1-2-64\":{\"w\":{\"1\":\"청력역치 측정 결과에 근거한 의학적 진단은 의사의 업무이다.\",\"2\":\"수술적 처치는 의사의 업무이다.\",\"3\":\"약물 처방은 의사의 업무이다.\",\"4\":\"난청의 외과적 치료(예: 인공와우 수술)는 의사의 업무이다.\"}},\"1-1-2-65\":{\"w\":{\"2\":\"한국어 어휘 수만으로 판정하면 몽골어로만 아는 개념이 누락되어 과소평가된다.\",\"3\":\"이중언어 노출 자체는 언어 지체나 장애의 원인이 아니다.\",\"4\":\"가정 언어 사용 중단은 부모-자녀 상호작용의 질을 떨어뜨릴 수 있어 권고하지 않는다.\",\"5\":\"단일언어 규준을 그대로 적용하면 이중언어 아동을 과잉 판별할 위험이 있다.\"}},\"1-1-2-66\":{\"w\":{\"1\":\"사후 보고는 연구 종료 후 결과나 과정을 알리는 것으로 참여 전 동의 절차가 아니다.\",\"3\":\"디브리핑은 연구 종료 후 기만 등 연구의 실제 목적을 설명하는 절차이다.\",\"4\":\"무선 할당은 참여자를 실험·통제 집단에 무작위로 배정하는 연구 설계 절차이다.\",\"5\":\"이중 은폐는 참여자와 연구자 모두 집단 배정을 모르게 하여 편향을 줄이는 설계 방법이다.\"}},\"1-1-2-67\":{\"p\":\"첫 상담에서 상담의 목적과 진행 방식을 안내하고, 아동의 발달력과 가정 내 의사소통 정보를 수집하며, 보호자와 신뢰 관계(라포)를 형성하는 것은 부모상담의 초기(준비) 단계에 해당한다.\",\"w\":{\"1\":\"실행 단계는 공감적 관계를 바탕으로 구체적 문제해결 방안을 제시하고 실천하도록 돕는 단계이다.\",\"2\":\"종결 단계는 상담 목표 달성 여부를 확인하고 상담을 마무리하는 단계이다.\",\"3\":\"추후 단계는 종결 후 변화의 유지 여부를 점검하는 단계이다.\",\"5\":\"평가 단계는 상담의 진행 결과와 효과를 점검하는 단계로 첫 상담의 정보 수집·라포 형성과 다르다.\"}},\"1-1-2-68\":{\"w\":{\"1\":\"이 사업은 등록 장애아동에 한정되지 않으며 의료 서비스가 아니다.\",\"3\":\"아동을 대상으로 하는 언어발달 지원 사업이며 성인 직업재활 사업이 아니다.\",\"4\":\"언어재활사 등 자격을 갖춘 전문 인력이 평가와 중재를 제공한다.\",\"5\":\"언어평가 결과에 따라 개별 아동에게 맞는 언어촉진 교육을 제공한다.\"}},\"1-2-1-1\":{\"p\":\"K-WAB-R의 실어증지수(AQ)는 스스로 말하기 점수(20점 만점)에 알아듣기(200점)÷20, 따라말하기(100점)÷10, 이름대기(100점)÷10을 더해 각각 10점 척도로 환산한 뒤 합계에 2를 곱해 100점 만점으로 만든다. 14 + 160÷20(=8) + 80÷10(=8) + 70÷10(=7) = 37이고, 37 × 2 = 74.0이다. 환산 순서(하위검사별 10점·20점 척도화 → 합산 → ×2)를 지키는 것이 핵심이다.\",\"w\":{\"1\":\"68.0은 합계 34에 2를 곱한 값으로, 하위검사 환산점 중 일부(예: 따라말하기나 이름대기)를 3점가량 적게 환산한 계산 오류에 해당한다.\",\"2\":\"72.0은 합계 36에 해당하며 환산점 하나를 1점 적게 더한 오류로, 정확한 합계 37과 맞지 않는다.\",\"3\":\"82.0은 합계 41에 해당하는 값으로, 알아듣기 등 일부 점수를 과대 환산한 오류이다.\",\"5\":\"88.0은 합계 44에 해당하는 값으로, 환산 비율을 잘못 적용해 점수를 크게 부풀린 오류이다.\"}},\"1-2-1-2\":{\"p\":\"유창한 발화·착어·심한 청각적 이해 손상은 베르니케실어증과 공통되지만, 따라말하기가 88/100으로 보존된 점이 결정적 감별 단서이다. 이해는 손상되고 따라말하기는 보존되는 유창성 실어증은 연결피질감각실어증이며, 후방 분수계(측두-두정-후두 경계) 영역 손상으로 설명된다. 청각-음운 입력에서 구어 출력으로 가는 따라말하기 경로(상측두회-궁상다발-브로카)가 보존되고 의미 체계와의 연결이 끊긴 상태이다.\",\"w\":{\"1\":\"베르니케실어증은 이해와 함께 따라말하기도 심하게 손상되므로 따라말하기 88점과 모순된다.\",\"2\":\"명칭실어증은 청각적 이해가 비교적 양호하고 낱말 찾기 결함이 주 증상이므로 심한 이해 손상과 맞지 않는다.\",\"3\":\"전도실어증은 이해가 양호하고 따라말하기가 선택적으로 손상되는 유형으로 이 사례와 정반대 양상이다.\",\"5\":\"혼합연결피질실어증은 비유창하고 반향어를 보이며 표현·이해가 모두 심하게 손상되는데, 이 환자는 발화가 유창하다.\"}},\"1-2-1-3\":{\"p\":\"삼킴 전 후두계곡으로의 조기 흘러넘침과 삼킴반사 지연으로 얇은 액체가 기도로 들어가며, 기침이 없는 무증상 침습이 관찰된다. 점도를 높이면 침습이 소실되었으므로 점도 증가(식이 조정)가 1차 보상 전략이고, 턱 당기기(chin-tuck)는 후두계곡을 넓히고 기도 입구를 좁혀 삼킴 전 흡인을 줄인다. 여기에 온도-촉각 자극 등 삼킴반사 촉진을 병행하는 조합이 가장 적절하다.\",\"w\":{\"2\":\"얇은 액체는 침습을 유발한 원인 점도이므로 유지하는 것은 부적절하며, 성문상 삼킴만으로 반사 지연·조기 흘러넘침을 해결하지 못한다.\",\"3\":\"점도 조절로 침습이 소실되어 안전한 경구 섭취 조건이 확인되었으므로 전면 금식·비위관 유지는 과잉 조치이다.\",\"4\":\"멘델슨 기법과 혀 저항 운동은 후두 거상 부족·UES 개방 감소·혀 기저부 약화에 대한 기법으로 이 환자의 삼킴 전 단계 문제와 맞지 않는다.\",\"5\":\"고개 젖히기는 기도 입구를 열어 조기 흘러넘침 환자의 흡인 위험을 높이며, 얇은 액체를 반복 섭취하는 것도 침습을 악화시킨다.\"}},\"1-2-1-4\":{\"p\":\"소뇌 병변에 의한 실조형 마비말장애는 조음 운동의 협응(타이밍·범위·방향) 장애로 자음·모음이 불규칙하게 붕괴되는 것이 핵심이다. 또한 음절마다 강세가 과도하고 균등한 과도·균등 강세, 불규칙한 음도·강도 변동 등 운율 붕괴가 동반된다. 이러한 불규칙 조음 오류와 운율 붕괴는 근력 약화에 따른 일관된 부정확성·과비성을 보이는 이완형과 구별되는 소견이다.\",\"w\":{\"1\":\"과비성과 기식성 음성은 하부운동신경원 손상에 의한 이완형 마비말장애의 특징으로, 감별 대상 쪽 소견이다.\",\"2\":\"쥐어짜는 듯한 노력성 음성은 양측 상부운동신경원 손상에 의한 경직형의 특징이다.\",\"3\":\"단조로운 음도와 감소된 강도는 기저핵 손상에 의한 과소운동형(파킨슨병)의 특징이다.\",\"5\":\"말속도가 점점 빨라지고 뭉개지는 가속 현상은 과소운동형의 특징이며, 실조형은 오히려 말속도가 느리다.\"}},\"1-2-1-5\":{\"p\":\"규칙어와 비단어는 정확히 읽는데 불규칙어에서만 규칙화 오류가 나타나면, 자소-음소 변환 규칙에 의존하는 음운(비어휘) 경로는 보존되고 낱말 전체를 인식해 읽는 어휘 경로가 손상된 표층실독증이다. 비단어 '무핀' 읽기가 양호한 것이 음운 경로 보존의 근거이다. 불규칙어의 발음은 어휘 경로를 통해서만 올바르게 인출되므로 규칙화 오류가 핵심 증상이 된다.\",\"w\":{\"1\":\"심층실독증은 의미착어(예: '바다'→'강')와 비단어 읽기의 심한 손상을 보이는데, 이 환자는 비단어를 잘 읽는다.\",\"3\":\"음운실독증은 음운 경로 손상으로 비단어 읽기가 선택적으로 손상되므로 양호한 비단어 읽기와 모순된다.\",\"4\":\"순수실독증은 시각 입력 단계 손상으로 낱자 하나씩 읽기(letter-by-letter)와 낱말 길이 효과를 보이며 규칙화 오류가 특징이 아니다.\",\"5\":\"무시실독증은 편측 공간 무시로 낱말의 한쪽(주로 왼쪽) 부분을 빠뜨리거나 대치하는 오류를 보인다.\"}},\"1-2-1-6\":{\"p\":\"서서히 진행되는 언어 저하는 원발진행실어증(PPA)을 시사하며, 낱말 인출 손상과 문장 따라말하기 손상이 핵심 진단 기준인 유형은 로고페닉형이다. 음소착어와 발화 중 낱말 찾기 휴지가 잦은 반면 낱말 의미·대상 지식과 문법은 상대적으로 보존된다는 점이 이 유형의 전형적 프로파일이다. 음운 작업기억(음운 루프) 결함이 핵심 기제로 설명된다.\",\"w\":{\"1\":\"의미형 PPA는 이름대기와 단일 낱말 이해 손상, 대상 지식 소실이 핵심인데 이 환자는 의미 지식이 보존되어 있다.\",\"3\":\"비유창/실문법형 PPA는 실문법증과 노력성·비유창 발화, 말실행증이 핵심으로 유창하고 문법이 보존된 이 사례와 맞지 않는다.\",\"4\":\"혼합형 PPA는 두 가지 이상 유형의 핵심 특징이 함께 나타날 때 쓰는 분류로, 이 사례는 로고페닉형 기준을 명확히 충족한다.\",\"5\":\"점진적으로 진행하는 언어 중심 저하이며 일상 기능 손상의 주된 원인이 언어 문제이므로 PPA에 해당한다.\"}},\"1-2-1-7\":{\"p\":\"의미자질분석(SFA)은 목표 그림을 중심에 두고 범주·용도·동작·특징·위치·연상 등 의미자질을 스스로 산출하게 하는 이름대기 중재이다. 목표 낱말 주변의 의미망을 활성화해 확산 활성화 원리로 목표 어휘 인출을 촉진하며, 훈련하지 않은 낱말로의 일반화도 기대할 수 있다. 따라서 치료 기전은 의미자질 활성화를 통한 낱말 인출 촉진이다.\",\"w\":{\"1\":\"조음 운동의 반복 학습·자동화는 말실행증의 운동학습 원리 중재에 해당한다.\",\"2\":\"억양과 리듬을 이용한 발화 유도는 멜로디 억양 치료(MIT)의 기전이다.\",\"4\":\"제스처 제한과 구어 산출 강제는 제약유발 언어치료(CILT)의 원리이다.\",\"5\":\"문법형태소 산출의 위계적 훈련은 실문법증 대상 문장 산출 중재의 원리이다.\"}},\"1-2-1-8\":{\"p\":\"우반구 손상 환자는 함축·은유·농담 등 비문자적 의미 이해의 어려움(화용 결함), 정서적 운율의 산출·이해 결함, 좌측 편측 무시를 보인다. 이 환자는 세 영역 모두에서 문제가 나타나므로 화용·운율·주의(훑어보기) 중재가 적절하다. 반면 문법형태소 산출 훈련은 좌반구 브로카실어증의 실문법증에 대한 중재로, 문법 능력이 보존된 우반구 손상 환자에게는 부적절하다.\",\"w\":{\"2\":\"은유·농담의 함축 파악 실패에 대응하는 중재로 적절하다.\",\"3\":\"단조로운 억양과 억양을 통한 감정 인식 실패(운율 결함)에 대응하는 중재로 적절하다.\",\"4\":\"그림 왼쪽 세부를 놓치는 좌측 무시에 대응하는 중재로 적절하다.\",\"5\":\"실제 대화 상황에서 화용 행동을 교정하고 일반화를 돕는 중재로 적절하다.\"}},\"1-2-1-9\":{\"p\":\"비유창성 실어증 환자가 스스로 말하기는 매우 제한적이나 익숙한 노래 가락에서는 구를 산출한다는 점은 멜로디 억양 치료(MIT)의 적응증을 보여 준다. MIT는 억양·리듬·노래 처리에 관여하는 비교적 보존된 우반구 기능을 활용하고, 억양 읊조리기와 손 두드리기로 발화를 유도한 뒤 점차 일반 운율로 이행한다. 따라서 치료법과 근거는 멜로디 억양 치료 – 우반구 활용이다.\",\"w\":{\"1\":\"의미자질분석은 낱말 인출을 위한 의미망 강화 기법으로 노래 가락에서 발화가 촉진되는 특성을 활용하지 않는다.\",\"3\":\"제약유발 언어치료는 비구어 수단을 제한하고 구어를 강제하는 기법으로 이 사례의 핵심 단서(노래)와 연결되지 않는다.\",\"4\":\"각본 훈련은 특정 상황 대화를 반복 연습해 자동화하는 기법이며, 노래를 통한 우반구 활용과는 기전이 다르다.\",\"5\":\"노래 맥락에서 구어 산출이 가능하므로 구어를 포기하고 AAC로 전환할 근거가 없다.\"}},\"1-2-1-10\":{\"p\":\"전도실어증은 유창한 발화와 양호한 청각적 이해 속에 음소착어와 선택적인 따라말하기 손상을 보이며, 자기 오류를 인식하고 반복 수정하는 접근 시도(conduite d'approche)가 특징이다. 이 환자의 결함은 음운 수준의 산출·따라말하기에 있으므로, 음소 단서를 활용한 따라말하기 반복 훈련으로 음운 부호화와 자기 수정을 강화하는 것이 가장 적절하다. 보존된 이해력과 오류 인식 능력이 중재의 강점으로 활용된다.\",\"w\":{\"1\":\"청각적 이해가 양호하므로 이해력 향상 훈련을 우선할 이유가 없다.\",\"2\":\"문법형태소 산출 훈련은 실문법증을 보이는 브로카실어증의 중재로, 발화가 유창한 전도실어증의 핵심 결함과 맞지 않는다.\",\"3\":\"구어가 유창하고 이해가 양호하므로 제스처만으로 의사소통하게 하는 것은 잔존 능력을 버리는 부적절한 접근이다.\",\"5\":\"유창한 발화가 있으므로 완전 무발화로 볼 수 없고 AAC를 즉시 도입할 근거가 없다.\"}},\"1-2-1-11\":{\"p\":\"전반실어증은 발화·이해·따라말하기·이름대기가 모두 심하게 손상된 유형으로, 초기 단계에서 구어 기능 회복을 겨냥한 고난도 과제는 성공 경험을 주기 어렵다. 남아 있는 자동구어·표정·제스처를 활용해 AAC(의사소통판·제스처 등)로 기능적 의사소통 통로를 확보하고, 가족 등 의사소통 파트너가 환자의 시도를 알아채고 지원하도록 훈련하는 것이 우선이다. 이는 참여 중심·기능 중심 중재 원칙에 부합한다.\",\"w\":{\"1\":\"복잡한 통사 구조 이해는 전반실어증 초기 환자의 수준을 크게 넘는 과제이다.\",\"2\":\"비단어 따라말하기는 기능적 가치가 낮고 따라말하기가 심하게 손상된 환자에게 부적절하다.\",\"3\":\"불규칙어 소리 내어 읽기는 표층실독증 등 읽기 경로 중재에 해당하며 초기 기능적 의사소통 확보와 거리가 멀다.\",\"4\":\"이름대기가 심하게 손상된 상태에서 속도 훈련은 부적절하며, 속도는 정확성 확보 이후의 목표이다.\"}},\"1-2-1-12\":{\"p\":\"이름대기 단서 위계는 환자의 자기 인출 노력을 최대한 요구하는 약한 단서에서 시작해 점차 목표 낱말의 형태 정보를 더 많이 주는 강한 단서로 진행한다. 의미 단서(범주·기능)는 형태 정보를 주지 않아 가장 약하고, 초성 음소 단서는 음운 형태 일부를, 문장 완성 단서는 문맥상 거의 유일한 답을 유도하며, 따라말하기는 목표어 전체를 제시하므로 가장 강하다. 따라서 의미 → 초성 음소 → 문장 완성 → 따라말하기 순이 옳다(교재에 따라 음소 단서와 문장 완성 순서가 바뀌기도 한다).\",\"w\":{\"1\":\"초성 음소 단서를 의미 단서보다 먼저 제시하여 음운 형태 정보를 담은 강한 단서가 앞에 온다.\",\"2\":\"가장 강한 따라말하기를 두 번째에 배치하여 이후 단서가 오히려 약해지는 역위계이다.\",\"3\":\"가장 강한 따라말하기로 시작해 약한 단서로 가는 역순(강→약)에 가깝다.\",\"4\":\"문장 완성과 따라말하기 같은 강한 단서가 앞에 오고 의미 단서가 뒤에 와 위계가 뒤섞여 있다.\"}},\"1-2-1-13\":{\"p\":\"근력 저하 없이 조음 위치를 찾는 모색행동, 같은 낱말에서도 일관되지 않은 조음 오류, 자동구어의 상대적 보존은 말운동 계획·프로그래밍 장애인 말실행증의 특징이다. 근육 자체가 아니라 운동 계획의 문제이므로 운동학습 원리(집중적 반복 연습, 무선 연습, 점진적 난이도 조절, 적절한 피드백 빈도)를 적용한 조음·조음 전환 연습이 치료의 핵심이다. 따라서 운동학습 원리의 집중 조음 연습이 가장 적절하다.\",\"w\":{\"2\":\"근력 저하가 없는 말실행증에 구강 근력 강화 저항 운동은 근거가 약하며, 이는 마비말장애 등 근력 약화에 대한 접근이다.\",\"3\":\"청각적 이해력 훈련은 실어증의 이해 결함에 대한 중재로 말실행증의 운동 계획 결함과 무관하다.\",\"4\":\"호흡 지구력 훈련은 호흡 지지가 약한 마비말장애 환자에게 고려되는 중재이다.\",\"5\":\"과비성 감소 공명 훈련은 구개인두 기능부전(이완형 등)에 대한 중재로 이 사례의 특징과 맞지 않는다.\"}},\"1-2-1-14\":{\"p\":\"양측 상부운동신경원(추체로) 병변에 의한 경직형 마비말장애는 근긴장 항진과 근약화로 느리고 노력성인 말, 쥐어짜는 듯한 거친 음성, 과비성을 보인다. 과도한 근긴장이 음성·조음 문제의 핵심이므로 이완 기법 등 근긴장 완화 중재와 함께 말속도·강세 조절을 통해 명료도와 자연스러움을 높이는 것이 적절하다. 성대 과내전을 줄이는 부드러운 발성 시작도 같은 맥락이다.\",\"w\":{\"1\":\"경직형은 말속도를 높이면 조음 정확도가 더 떨어지므로 말속도 증가는 부적절하다.\",\"2\":\"이미 성대가 과도하게 내전되어 쥐어짜는 음성이 나오므로 성대를 더 조이는 훈련은 증상을 악화시킨다.\",\"3\":\"불수의 운동 억제는 과다운동형 마비말장애의 문제이며, 경직형에는 불수의 운동이 핵심 증상이 아니다.\",\"4\":\"과비성이 이미 동반되어 있으므로 비강 공명을 늘리는 훈련은 역효과를 낸다.\"}},\"1-2-1-15\":{\"p\":\"하부운동신경원·뇌신경 병변으로 연구개 근약화가 생기면 구개인두 폐쇄부전이 나타나 과비성, 비누출, 약한 압력 자음이 발생한다. 근약화가 심해 행동 중재만으로 구개인두 폐쇄를 확보하기 어려울 때는 연구개를 물리적으로 들어 올려 주는 구개거상장치(palatal lift)를 우선 고려한다. 이는 공명과 구강 내압을 개선해 말명료도를 직접 높인다.\",\"w\":{\"1\":\"말속도 감소는 실조형·과소운동형 등에서 명료도를 높이는 전략으로, 구개인두 폐쇄부전의 직접 해결책이 아니다.\",\"2\":\"불수의 운동 억제는 과다운동형 마비말장애의 중재 목표이다.\",\"4\":\"좌측 훑어보기 훈련은 우반구 손상 환자의 좌측 무시에 대한 중재이다.\",\"5\":\"억양·리듬 치료(MIT)는 비유창성 실어증 중재로 이완형의 공명 문제와 무관하다.\"}},\"1-2-1-16\":{\"p\":\"파킨슨병에 의한 과소운동형 마비말장애는 단조로운 음도, 감소된 강도, 가속된 말속도가 특징이며, 환자가 자신의 목소리가 작다는 것을 인식하지 못하는 감각 인식(보정) 결함이 동반된다. LSVT LOUD는 '크게 말하기'라는 단일 목표를 고강도로 반복해 발성 강도를 높이고 강도 감각을 재보정하며, 파킨슨병 말장애에 대해 가장 근거가 확립된 치료법이다. 따라서 LSVT LOUD – 강도 증대가 옳다.\",\"w\":{\"1\":\"CILT는 만성 실어증 환자의 구어 사용을 늘리는 실어증 중재이다.\",\"2\":\"MIT는 비유창성 실어증의 발화 유도 기법으로 과소운동형 마비말장애의 표적과 맞지 않는다.\",\"4\":\"SFA는 실어증의 이름대기 중재 기법이다.\",\"5\":\"chin-tuck은 삼킴장애의 자세 보상 기법으로 말장애 치료법이 아니다.\"}},\"1-2-1-17\":{\"p\":\"숨 참기 → 삼키기 → 삼킨 직후 기침 → 다시 삼키기의 순서는 성문상 삼킴(supraglottic swallow)이다. 삼키기 전에 숨을 참아 성대를 자발적으로 내전시켜 삼킴 전·중 기도를 보호하고, 삼킨 직후 기침으로 성문 위에 남은 잔여물을 배출한다. 따라서 목적은 삼킴 전·중 성대를 닫아 기도를 보호하는 것이다.\",\"w\":{\"1\":\"상부식도괄약근 개방 시간 연장은 후두 거상을 유지하는 멘델슨 기법의 목적이다.\",\"2\":\"식도 연동 운동은 불수의적 식도 단계 기능으로 행동적 삼킴 기법으로 촉진하는 대상이 아니다.\",\"3\":\"혀 기저부 후방 이동 강화는 노력 삼킴이나 혀 기저부 운동의 목적이다.\",\"4\":\"저작 촉진은 구강 준비 단계 중재로, 기도 보호를 위한 성문상 삼킴의 목적과 무관하다.\"}},\"1-2-1-18\":{\"p\":\"후두 거상 불충분과 짧은 상부식도괄약근(UES) 개방으로 인두 잔여물이 남는 환자에게는 멘델슨 기법이 적절하다. 멘델슨 기법은 삼킴 중 후두가 최고로 올라간 상태를 수초간 의도적으로 유지하게 하여 후두 거상의 범위·지속 시간과 UES 개방 시간을 늘리고 인두 잔여물을 줄인다. 이 환자의 병태생리에 직접 대응하는 기법이다.\",\"w\":{\"1\":\"턱 당기기는 후두계곡을 넓히고 기도 입구를 좁혀 삼킴 전 흡인을 줄이는 자세로 UES 개방 연장 효과가 없다.\",\"2\":\"고개 돌리기는 편측 인두 약화 시 약한 쪽을 막아 식괴를 건강한 쪽으로 보내는 자세이다.\",\"3\":\"성문상 삼킴은 삼킴 전·중 기도 보호가 목적으로 후두 거상·UES 개방 문제를 직접 해결하지 않는다.\",\"5\":\"고개 젖히기는 구강 운반 장애 시 중력을 이용하는 자세로, 인두 단계 문제가 있으면 흡인 위험을 높인다.\"}},\"1-2-1-19\":{\"p\":\"제약유발 언어치료(CILT)는 제약유발 운동치료에서 유래한 기법으로, 제스처·그림·글 등 보상적 비구어 수단의 사용을 제한하고 카드 게임 등 상호작용 맥락에서 짧은 기간 고강도로 구어 산출을 요구한다. 이를 통해 구어를 쓰지 않게 되는 학습된 미사용(learned nonuse)을 극복하고 일상 구어 사용을 늘린다. 따라서 핵심 원리는 비구어 수단 제한과 구어 산출 강제이다.\",\"w\":{\"1\":\"비구어 수단을 적극 허용하는 것은 PACE 등 다중 양식 접근의 원리로 CILT와 정반대이다.\",\"2\":\"억양과 리듬을 이용한 발화 유도는 MIT의 원리이다.\",\"4\":\"목표 낱말 의미자질 분석은 SFA의 원리이다.\",\"5\":\"보호자가 대신 말하게 하는 것은 환자의 구어 사용 기회를 줄여 CILT의 목적에 어긋난다.\"}},\"1-2-1-20\":{\"p\":\"각본(스크립트) 훈련은 병원 접수·전화처럼 환자에게 필요한 특정 상황의 대화문을 함께 만들고 반복 연습하여 해당 발화를 유창하고 자동적으로 산출하게 하는 기능적 중재이다. 경도~중등도 실어증 환자가 특정 상황에서 필요한 발화의 자동화를 원한다는 목표와 정확히 일치한다. 연습된 각본이 실제 상황에서 쓰이도록 일반화 연습을 함께 계획한다.\",\"w\":{\"1\":\"비단어 따라말하기는 음운 처리 훈련으로 상황 특이적 기능적 발화의 자동화와 거리가 멀다.\",\"3\":\"불규칙어 읽기 훈련은 표층실독증 등 읽기 중재에 해당한다.\",\"4\":\"좌측 훑어보기는 우반구 손상 환자의 좌측 무시 중재이다.\",\"5\":\"구강 근력 강화는 마비말장애 등 말운동 약화에 대한 접근으로 실어증의 발화 자동화 목표와 무관하다.\"}},\"1-2-1-21\":{\"p\":\"환자 A의 문법형태소 생략·전보식·비유창 발화는 브로카실어증의 특징이므로 발화 산출과 문법 구조 중재가 우선된다. 환자 B의 유창하나 착어가 많고 공허한 발화는 베르니케실어증의 특징으로, 이해 손상과 자기 점검 부족이 근본 문제이므로 청각적 이해 중재가 우선된다. 진단과 우선 중재가 모두 올바르게 짝지어진 것은 A 브로카·산출, B 베르니케·이해이다.\",\"w\":{\"2\":\"A와 B의 진단이 서로 뒤바뀌었고 중재도 각 유형의 핵심 결함과 어긋난다.\",\"3\":\"진단은 맞으나 A(브로카)에 이해 중재, B(베르니케)에 문법 중재를 짝지어 우선순위가 뒤바뀌었다.\",\"4\":\"A는 비유창, B는 이해 손상이 두드러져 이해가 양호하고 유창한 전도실어증으로 볼 수 없다.\",\"5\":\"두 환자 모두 명칭실어증보다 광범위한 결함(비유창 문법 결함, 이해 손상)을 보인다.\"}},\"1-2-1-22\":{\"p\":\"새 정보를 즉시 회상하지 못하고 일정을 잊는 것은 일화기억·전향기억 결함, 장황하고 주제에서 벗어나는 대화는 집행기능 저하에 따른 화용 결함으로, TBI의 전형적인 인지-의사소통장애이다. 따라서 다이어리·스마트폰 알림 등 외부 기억 보조 수단 사용 훈련과 주제 유지·차례 지키기 등 화용 중재를 결합하는 것이 가장 적절하다. 이는 기능 회복과 보상 전략을 함께 활용하는 접근이다.\",\"w\":{\"1\":\"불규칙어 읽기 훈련은 후천성 실독증 중재로 기억·화용 결함을 다루지 못한다.\",\"2\":\"과비성 감소 공명 훈련은 마비말장애의 공명 문제에 대한 중재로 사례와 무관하다.\",\"4\":\"성문상 삼킴은 삼킴장애 기법으로 인지-의사소통 중재가 아니다.\",\"5\":\"좌측 공간 훑어보기는 우반구 손상 편측 무시에 대한 중재로 이 환자의 문제와 맞지 않는다.\"}},\"1-2-1-23\":{\"p\":\"초기 알츠하이머병은 일화기억(최근 기억) 저하가 두드러지지만 절차기억과 점화(암묵기억)는 비교적 보존된다. 간격 회상 기법(spaced retrieval)은 정보를 점차 늘어나는 시간 간격으로 반복 인출하게 하여 보존된 암묵기억을 활용하며, 무오류 학습 원리를 적용해 이름·일상 정보를 유지시키는 근거 기반 중재이다. 따라서 이 환자에게 가장 적절하다.\",\"w\":{\"1\":\"복잡한 통사 이해 훈련은 인지 부담이 크고 이름대기·일상 기억 유지라는 목표와 맞지 않는다.\",\"3\":\"비단어 따라말하기는 기능적 가치가 낮고 기억 유지 전략이 아니다.\",\"4\":\"제약유발 언어치료는 실어증 환자의 구어 사용 증대 기법으로 치매 기억 중재가 아니다.\",\"5\":\"구강 근력 강화는 말운동·삼킴 관련 중재로 기억·이름대기 목표와 무관하다.\"}},\"1-2-1-24\":{\"p\":\"의사소통효과증진법(PACE)은 실제 대화 원리를 치료에 옮긴 화용 중심 접근으로, 치료사와 환자가 동등한 참여자로서 순번을 교대하며 상대가 모르는 새 정보를 전달한다. 전달 수단은 구어·제스처·그림·글 등 환자가 자유롭게 선택하며, 피드백은 형식의 정확성보다 메시지 전달 성공 여부에 근거한다. 따라서 새 정보를 다양한 수단으로 주고받는 것이 원리이다.\",\"w\":{\"2\":\"PACE에서는 청자가 정보를 모르는 상태여야 하므로 치료사가 정답을 먼저 알려 주면 새 정보 원리에 어긋난다.\",\"3\":\"구어만 사용하도록 제한하는 것은 CILT의 원리로 PACE의 다중 양식 허용과 반대이다.\",\"4\":\"문법형태소의 정확한 산출은 형식 중심 목표로, 전달 성공을 중시하는 PACE의 원리가 아니다.\",\"5\":\"그림 이름 순서대로 따라 말하기는 전통적 자극-반응 훈련으로 새 정보 교환이 없다.\"}},\"1-2-1-25\":{\"p\":\"ND 점수 = 9 ÷ 300 × 100 = 3이고, AD 점수 = 12 ÷ 300 × 100 × 1.5 = 4 × 1.5 = 6이다. 따라서 비유창성 총점은 3 + 6 = 9이다. 비정상적 비유창성에만 가중치 1.5를 곱한다는 점이 계산의 핵심이다.\",\"w\":{\"1\":\"7은 AD에 가중치 1.5를 적용하지 않고 ND 3 + AD 4를 더한 값이다.\",\"2\":\"10.5는 ND에도 가중치 1.5를 잘못 곱해(3 × 1.5 = 4.5) AD 6과 더한 값이다.\",\"4\":\"12는 AD 횟수(12회)를 음절 수로 환산하지 않고 그대로 점수로 쓰는 등 산출식을 잘못 적용한 값이다.\",\"5\":\"15는 AD에 가중치를 과다 적용(4 × 3 = 12)한 뒤 ND 3을 더한 값 등 가중치 오류에 해당한다.\"}},\"1-2-1-26\":{\"w\":{\"2\":\"SLD 100음절당 5.2회는 학령전기 기준(3회)을 넘으므로 정상 범위라는 해석은 틀렸다.\",\"3\":\"SLD 비율이 72%로 높고 긴장이 동반되어 간투사·구 반복 중심의 정상적 비유창성으로 볼 수 없다.\",\"4\":\"반복 단위 수는 평균 2회 이상이면 이미 말더듬 지표에 해당하며, 3회 미만이라는 이유로 말더듬을 배제할 수 없다.\",\"5\":\"학령전기 아동에게 성인 %SS 기준을 적용하는 것은 부적절하고, 연장된 말 훈련은 3세 아동의 1차 선택이 아니다.\"}},\"1-2-1-27\":{\"p\":\"여아, 발병 후 12개월 미만(4개월), 자연회복한 친척(외삼촌) 가족력, SLD 8회→4회의 감소 추세, 정상 음운·언어발달, 말더듬 인식 없음은 모두 자연회복을 예측하는 요인이다. 반면 부모의 불안과 '천천히' 지시는 아동에게 압박이 될 수 있다. 따라서 부모 상담과 상호작용 조정 등 간접 중재를 제공하면서 정기적으로 재평가해 추이를 감시하는 것이 가장 적절하다.\",\"w\":{\"1\":\"자연회복 예후 요인이 많고 호전 추세이므로 리드콤을 즉시 시작하는 것은 시기상조이며, 관찰 후 호전이 없을 때 고려한다.\",\"2\":\"말더듬수정법의 확인 훈련은 자신의 말더듬을 인식하지 않는 2세 아동에게 부적절하고 오히려 인식을 유발할 수 있다.\",\"4\":\"자연회복 가능성이 높아도 지속 여부를 확인해야 하므로 추후 관리 없는 종결은 부적절하다.\",\"5\":\"성인용 유창성완성 프로그램은 2세 아동의 발달 수준에 맞지 않는다.\"}},\"1-2-1-28\":{\"w\":{\"1\":\"경계선 말더듬은 긴장·회피 없이 반복이 많은 초기 단계로, 부정적 태도와 회피가 뚜렷한 9세 아동과 맞지 않는다.\",\"2\":\"초기 말더듬은 긴장·탈출행동이 나타나기 시작하는 학령전기 단계이며 회피·공포는 두드러지지 않고, 리드콤도 주로 학령전기 대상이다.\",\"3\":\"진전된 말더듬은 청소년·성인의 고착된 단계이며, DAF 기기 단독 사용으로는 회피·태도 문제를 다룰 수 없다.\",\"5\":\"긴장된 막힘·부수행동·회피가 있으므로 정상적 비유창성이 아니다.\"}},\"1-2-1-29\":{\"p\":\"리드콤 프로그램 1단계의 목표는 클리닉 %SS 1.0 미만과 부모 SR 1~2 유지를 3주 연속 충족하는 것이다. 이 아동은 3주 연속 %SS 0.6, 0.4, 0.5이고 SR 1~2를 유지했으므로 1단계 준거에 도달하였다. 따라서 2단계(유지)로 진입하여 방문 간격을 점차 늘리고 수반자극을 단계적으로 줄이며 재발을 감시해야 한다.\",\"w\":{\"1\":\"이미 1단계 준거를 충족했으므로 1단계를 6개월 더 유지할 이유가 없다.\",\"2\":\"리드콤이 효과를 보이고 있는데 다른 접근(말더듬수정법)으로 전환할 근거가 없으며, 취소 기법은 5세 아동에게 적합하지 않다.\",\"3\":\"리드콤은 재발 감시를 위한 2단계를 거쳐야 하므로 즉시 종결은 부적절하다.\",\"4\":\"2단계에서도 수반자극과 SR 측정은 점진적으로 줄여 가며 재발을 감시하므로 일괄 중단은 원리에 어긋난다.\"}},\"1-2-1-30\":{\"p\":\"리드콤 프로그램의 언어적 수반자극은 유창한 발화에 대한 칭찬·인정이 중심이고, 말더듬에 대한 인정·수정 요구는 간헐적으로만 제공해야 한다. 이 어머니는 매번 수정을 요구하고 칭찬이 거의 없어 아동이 말하기를 꺼리고 짜증을 내는 부작용이 나타났다. 따라서 유창한 발화에 대한 칭찬 비율을 수정 요구보다 훨씬 높게(예: 5:1 이상) 조정하도록 지도하는 것이 가장 적절하다.\",\"w\":{\"2\":\"수정 요구를 더 강하게 하면 이미 나타난 회피·짜증 반응을 악화시키며 리드콤의 긍정적 수반자극 원리에 어긋난다.\",\"3\":\"수반자극을 모두 중단하면 리드콤의 핵심 기제를 버리는 것이며, 부모 말속도 늦추기는 간접 중재의 요소이다.\",\"4\":\"아동의 짜증은 과도한 수정 요구의 부작용이므로 타임아웃으로 처벌할 것이 아니라 수반자극 비율을 조정해야 한다.\",\"5\":\"말더듬 순간의 자기분석은 말더듬수정법의 요소로 학령전기 아동에게 부적합하다.\"}},\"1-2-1-31\":{\"p\":\"Palin PCI는 부모-아동 놀이를 녹화한 영상을 함께 보며 부모가 아동의 유창성에 도움이 되는 상호작용 전략(말속도 늦추기, 기다리기, 질문 줄이기 등)을 스스로 찾아 선택하게 하는 간접 중재이다. 부모는 매주 수차례 5분 정도의 특별시간에 선택한 전략을 실천하고, 불안·죄책감 등 가족 전략도 함께 다룬다. 빠른 부모 말속도와 끼어들기, 높은 부모 불안이 나타난 이 사례에 적합하다.\",\"w\":{\"1\":\"PCI는 부모 참여가 핵심인 프로그램으로 부모를 배제하고 치료사가 단독으로 치료하는 것은 정반대이다.\",\"2\":\"유창한 발화에 칭찬하고 말더듬에 수정 요구하며 SR을 기록하는 것은 리드콤 프로그램의 절차이다.\",\"3\":\"연장된 말 시범으로 유창한 말 패턴을 확립하는 것은 유창성완성법의 절차이다.\",\"4\":\"말더듬 순간 확인과 취소 기법은 말더듬수정법(Van Riper)의 절차이다.\"}},\"1-2-1-32\":{\"w\":{\"1\":\"복잡한 문장 산출 요구는 언어적 요구를 더 높여 요구-용량 불균형을 악화시킨다.\",\"2\":\"취소·빠져나오기는 말더듬수정법 기법으로 4세 아동의 용량을 높이는 방법이 아니며 모델의 중재 방향과 다르다.\",\"4\":\"발화 기회 제한은 비현실적이고 의사소통 발달을 저해하며 모델이 권장하는 방법이 아니다.\",\"5\":\"동생과의 상호작용 차단은 비현실적이고 정서적으로 해로우며, 정서적 요구는 차단이 아니라 지지와 예측 가능한 일과로 낮춘다.\"}},\"1-2-1-33\":{\"p\":\"Van Riper의 말더듬수정법은 동기-확인-둔감화-변형-접근-안정화(MIDVAS) 순서로 진행된다. 확인 단계를 마쳤으나 말더듬 순간의 강한 공포와 청자 시선 회피가 남아 있으므로, 다음 단계는 둔감화이다. 둔감화에서는 의도적(가짜) 말더듬, 말더듬 순간 얼어붙기(freezing), 청자 반응 직면 등을 통해 공포와 긴장을 줄인다.\",\"w\":{\"1\":\"변형은 둔감화 다음 단계로 습관화된 말더듬 패턴을 바꾸어 보는 단계이며, 취소 기법은 접근 단계의 기법이다.\",\"2\":\"빠져나오기와 예비책은 접근 단계의 기법으로 둔감화를 거치기 전에 적용하기에는 이르다.\",\"4\":\"안정화는 MIDVAS의 마지막 단계로 확인 직후에 진행할 단계가 아니다.\",\"5\":\"동기는 첫 단계로 이미 확인 단계까지 마친 대상자에게 다음 단계가 될 수 없다.\"}},\"1-2-1-34\":{\"p\":\"%SS 1.2로 겉으로는 거의 유창하나 낱말 대치와 전화·주문·자기소개 회피, 말더듬 은폐, OASES 총 영향 '심함'은 내재화(covert) 말더듬의 전형이다. 이 대상자의 핵심 문제는 핵심행동 빈도가 아니라 회피와 두려움, 부정적 삶의 영향이므로, 회피하던 낱말·상황에 대한 위계적 노출, 의도적 말더듬, 말더듬 자기공개로 회피를 줄이고 둔감화하는 것이 우선 목표이다.\",\"w\":{\"1\":\"이미 낮은 %SS를 0에 가깝게 낮추는 훈련은 회피·두려움이라는 핵심 문제를 다루지 못하고 '더듬으면 안 된다'는 신념을 강화할 수 있다.\",\"3\":\"부모 참여 언어적 수반자극 프로그램(리드콤)은 학령전기 아동 대상이다.\",\"4\":\"취소 기법으로 핵심행동 지속시간을 줄이는 것은 드러난 말더듬 행동을 겨냥한 것으로 회피가 주 문제인 이 사례의 우선 목표가 아니다.\",\"5\":\"DAF 기기는 말속도를 낮춰 일시적 유창성을 유도할 뿐 회피와 부정적 태도를 다루지 못한다.\"}},\"1-2-1-35\":{\"p\":\"전체 말속도는 총 음절 수를 소요 시간(분)으로 나누어 구하므로 375 ÷ 2.5분 = 150 SPM이다. %SS는 말더듬 음절 수를 총 음절 수로 나누어 100을 곱하므로 15 ÷ 375 × 100 = 4%이다. 2분 30초를 2.5분으로 정확히 환산하는 것이 핵심이다.\",\"w\":{\"1\":\"125 SPM은 375음절을 3분으로 나눈 오류이다(%SS 4%는 맞다).\",\"2\":\"150 SPM은 맞으나 2.5%는 %SS를 잘못 계산한 값(예: 15 ÷ 600 × 100)이다.\",\"3\":\"187.5 SPM은 375음절을 2분으로 나눈 오류로 30초를 누락했다(%SS 4%는 맞다).\",\"5\":\"150 SPM은 맞으나 6%는 %SS를 잘못 계산한 값(예: 15 ÷ 250 × 100)이다.\"}},\"1-2-1-36\":{\"w\":{\"1\":\"취소·빠져나오기·예비책은 말더듬수정법 기법으로 유창성완성법을 선택한 이 대상자의 접근과 맞지 않는다.\",\"3\":\"차폐 소음과 메트로놈 리듬 말하기는 일시적 유창성 유도 조건으로 특정 막힘 양상을 겨냥한 기법이 아니다.\",\"4\":\"의도적 말더듬과 자기공개는 말더듬수정법·회피 감소 기법으로 성대·조음기관 긴장에 직접 대응하지 않는다.\",\"5\":\"호흡 근력 강화와 큰 소리로 말하기는 말더듬의 긴장된 발성 개시·조음 접촉 문제와 무관하며 오히려 긴장을 높일 수 있다.\"}},\"1-2-1-37\":{\"w\":{\"2\":\"리드콤은 학령전기 아동 대상으로 부모가 언어적 수반자극을 제공하는 프로그램이다.\",\"3\":\"GILCU는 발화 길이와 복잡성을 단계적으로 늘리는 프로그램된 조작적 접근으로 정해진 위계가 있다.\",\"4\":\"페일린 PCI는 학령전기 아동의 부모-아동 상호작용을 조정하는 간접 중재이다.\",\"5\":\"스토커 프로브 테크닉은 질문-응답 형태의 발화 요구 수준을 위계적으로 조절하는 아동 대상 기법이다.\"}},\"1-2-1-38\":{\"p\":\"치료 종료 시 %SS 0.8이던 대상자가 6개월 후 %SS 6.2로 상승하고 전화 회피가 재개된 것은 재발이다. 기법 사용 시 어색함 때문에 기법을 쓰지 않게 된 것이 원인이므로, 추후 회기에서 기법을 재확립하되 자연스러움 훈련, 자기 모니터링, 인지-정서 요소, 자조모임 등 유지 전략을 보강해야 한다. 재발은 유창성완성법 후 흔한 현상으로 치료 실패가 아니라 관리 대상이다.\",\"w\":{\"1\":\"동일 프로그램을 처음부터 반복하면 재발 원인(어색함, 유지 전략 부족)을 다루지 못한다.\",\"2\":\"%SS 상승과 회피 재개가 뚜렷한 재발 상태를 방치하면 회피와 부정적 태도가 고착될 수 있다.\",\"3\":\"DAF 기기의 영구 착용은 자연스러움과 자기관리 문제를 해결하지 못하며 근거 있는 유지 전략이 아니다.\",\"4\":\"유창성 기법 사용을 금지하고 전면 교체할 근거가 없으며, 두 접근은 통합적으로 활용할 수 있다.\"}},\"1-2-1-39\":{\"w\":{\"1\":\"A와 B의 진단이 서로 뒤바뀌었다.\",\"3\":\"A에게 DAF 단독 사용은 회피·두려움을 다루지 못하고, B의 속화에는 둔감화가 아니라 말속도 조절·자기 모니터링이 필요하다.\",\"4\":\"A는 긴장·회피·두려움이 뚜렷해 속화로 볼 수 없다.\",\"5\":\"B는 말더듬 특징보다 속화 특징을 보이며, 리드콤은 학령전기 말더듬 아동 대상 프로그램이다.\"}},\"1-2-1-40\":{\"p\":\"뇌경색 후 성인기에 발생하고, 기능어·낱말 끝 등 문장 내 위치와 무관한 반복, 부수행동·공포가 거의 없음, 적응효과 미미는 신경학적(후천성 신경인성) 말더듬의 특징이다. 심리적 요소가 적으므로 pacing 보드·말속도 감소·DAF 등 보상 전략이 중재의 중심이 되며, 동반된 마비말장애 중재와 통합하는 것이 효율적이다. 원인 질환에 대한 의학적 협진도 병행한다.\",\"w\":{\"1\":\"의도적 말더듬과 얼어붙기는 공포·회피를 줄이는 둔감화 기법으로 공포가 거의 없는 신경학적 말더듬에 우선할 이유가 없다.\",\"3\":\"부모 수반자극 방식의 조작적 프로그램은 학령전기 아동 말더듬(리드콤) 중재이다.\",\"4\":\"심리치료 우선 의뢰는 심인성 말더듬의 접근으로 뇌경색 후 발생한 이 사례와 맞지 않는다.\",\"5\":\"회피 낱말 위계 노출은 회피 행동이 두드러진 발달성 말더듬에 대한 중재이다.\"}},\"1-2-1-41\":{\"w\":{\"2\":\"신경과 검사가 정상이고 뇌손상 병력이 없으므로 신경학적 말더듬으로 볼 근거가 없다.\",\"3\":\"빠르고 불규칙한 말속도나 음절 축약이 아니라 균일한 음절 반복이 주 증상이므로 속화가 아니다.\",\"4\":\"아동기 말더듬 병력 없이 성인기에 갑자기 발생했으므로 발달성 말더듬이 아니다.\",\"5\":\"의도적으로 말더듬을 꾸며 낸다는 근거가 없으며, 심인성 말더듬은 치료 대상이다.\"}},\"1-2-1-42\":{\"w\":{\"1\":\"이중언어가 말더듬의 원인이라는 전제는 근거가 없다.\",\"2\":\"영어 사용 중단은 말더듬 개선 근거가 없고 가족 의사소통과 언어발달에 해가 될 수 있다.\",\"3\":\"발화량 자체를 줄이는 것은 언어발달과 의사소통 기회를 박탈하는 해로운 조치이다.\",\"4\":\"말더듬이 두 언어 모두에서 관찰되므로 영어 유창성을 평가하지 않으면 아동의 말더듬을 온전히 파악할 수 없다.\"}},\"1-2-1-43\":{\"w\":{\"1\":\"활동에서 계속 제외하면 회피와 위축이 강화되어 이미 나타난 부작용이 심화된다.\",\"2\":\"'천천히, 숨 쉬고' 같은 즉각적 조언은 아동의 말에 주의를 집중시켜 긴장과 수치심을 높인다.\",\"3\":\"유창해질 때까지 다시 읽게 하는 것은 말더듬을 처벌하는 효과를 내어 불안과 회피를 키운다.\",\"5\":\"말더듬 공개는 아동의 준비와 동의가 있을 때 선택할 수 있는 것으로 교사가 강요할 사항이 아니다.\"}},\"1-2-1-44\":{\"w\":{\"1\":\"유창성 유도 조건은 말더듬의 원인을 제거하지 않으며, 조건을 벗어나면 효과가 사라져 완치 근거가 없다.\",\"3\":\"효과가 대부분의 말더듬 화자에게 일관되게 나타나며 치료 초기 촉진 도구로 유용하게 쓰인다.\",\"4\":\"유창성 유도 조건에서의 유창성은 말더듬 화자에게 공통적인 현상이므로 비말더듬의 증거가 아니다.\",\"5\":\"유창성 유도 조건에 대한 반응은 발달성 말더듬의 일반적 특징이며, 오히려 심인성 말더듬은 이 조건에 반응하지 않는 경우가 많다.\"}},\"1-2-1-45\":{\"p\":\"'한 번이라도 막히면 모두가 무능하다고 생각할 것'이라는 신념은 파국화·독심술 같은 인지 왜곡이며, 이로 인한 회피와 자책이 사회불안을 유지하는 악순환을 만든다. 인지행동치료 원리에 따라 왜곡된 신념의 근거를 검토해 재구조화하고, 실제 발언 후 청자 반응을 확인하는 행동 실험·점진적 노출로 신념을 검증하는 것이 가장 적절하다. 이는 말더듬 성인의 인지-정서적 문제에 대한 근거 기반 접근이다.\",\"w\":{\"1\":\"말더듬 빈도를 0으로 낮추려는 목표는 비현실적이고 '막히면 안 된다'는 왜곡된 신념을 강화한다.\",\"2\":\"발표 상황을 완전히 피하게 하면 회피가 강화되어 악순환이 심화된다.\",\"4\":\"취소 기법 반복은 말더듬 행동 수정에 초점을 둘 뿐 신념·불안이라는 인지-정서적 문제를 다루지 못한다.\",\"5\":\"DAF 기기 사용은 일시적 유창성만 유도하며 부정적 신념과 사회불안을 해결하지 못한다.\"}},\"1-2-1-46\":{\"w\":{\"1\":\"리드콤은 부모가 일상 대화에서 수반자극을 제공하는 프로그램으로 발화 길이 위계가 핵심이 아니다.\",\"2\":\"캠퍼다운은 프로그램된 발화 길이 위계 없이 연장된 말 시범과 자기평정으로 진행된다.\",\"3\":\"동기·확인·둔감화·변형·접근·안정화는 Van Riper 말더듬수정법(MIDVAS)의 단계로 조작적 접근이 아니다.\",\"5\":\"페일린 PCI는 부모-아동 상호작용 조정 중심의 간접 중재이다.\"}},\"1-2-1-47\":{\"p\":\"중등도 지적장애 아동은 추상적 설명 이해와 자기분석에 어려움이 있고 새 기술의 유지·일반화가 느리다. 따라서 느린 말·부드러운 시작 등 유창성 기법을 단순화해 시범과 반복, 그림·몸짓 같은 시각적 단서로 지도하고, 협조적인 부모·교사가 동일한 단서와 강화를 일상에서 제공해 일반화를 돕는 것이 가장 적절하다. 인식이 낮은 특성에 맞춰 구체적·행동적 접근을 택한다.\",\"w\":{\"2\":\"말더듬 순간 분석과 인지 재구조화는 높은 수준의 추상적 사고를 요구해 지적장애 아동에게 부담이 크다.\",\"3\":\"지적장애가 있어도 말더듬 중재 효과는 기대할 수 있으므로 말더듬 치료를 배제할 근거가 없다.\",\"4\":\"성인용 캠퍼다운 프로그램의 자기평정·문제해결 절차는 수정 없이 적용하기에 지적장애 아동의 수준과 맞지 않는다.\",\"5\":\"말더듬 인식 부족은 치료 제외 사유가 아니라 중재 설계 시 고려할 특성이며, 긴장된 막힘이 있어 중재가 필요하다.\"}},\"1-2-1-48\":{\"w\":{\"1\":\"클리닉 표본만을 가장 객관적인 자료로 보고 부모 보고를 배제하면 말더듬의 맥락별 변이를 놓친다.\",\"2\":\"부모 보고만으로 즉시 직접 치료를 시작하는 것은 객관적 자료 확인 없이 결정하는 것이다.\",\"3\":\"단일 클리닉 표본의 %SS만으로 말더듬을 배제하고 종결하는 것은 변이성을 고려하지 않은 결정이다.\",\"5\":\"표준화 언어검사는 동반 언어 문제를 평가할 뿐 말더듬 진단에 필요한 유창성 표본을 대신할 수 없다.\"}},\"1-2-1-49\":{\"p\":\"26개월에 표현어휘 30개(10%ile 미만)와 낱말 조합 없음은 표현언어 지체이지만, 수용언어가 연령 수준이고 가리키기·보여주기 몸짓과 상징놀이가 적절하며 가족력이 없다. 이는 예후가 좋은 저위험 늦게 말하는 아동(late talker) 프로파일이다. 따라서 부모 매개 언어촉진(반응적 상호작용·집중자극) 교육 후 3~6개월 간격으로 재평가하는 것이 가장 적절하다.\",\"w\":{\"1\":\"위험 요인이 적은 저위험 프로파일에 주 3회 개별 집중치료는 과잉 개입이며, 부모 매개 중재가 1차 선택이다.\",\"3\":\"DLD 진단은 보통 만 4세 전후에도 언어 문제가 지속될 때 내리므로 26개월에 진단을 확정하는 것은 부적절하다.\",\"4\":\"저위험이라도 일부는 언어 문제가 지속되므로 아무 조치 없이 만 4세까지 기다리는 것은 부적절하다.\",\"5\":\"몸짓, 상징놀이, 이해가 양호해 자폐스펙트럼장애를 의심할 근거가 없으며, 낱말 조합 부재는 자폐의 핵심 징후가 아니다.\"}},\"1-2-1-50\":{\"w\":{\"1\":\"z = −0.75는 차이 12를 표준편차 16(8의 2배)으로 나눈 계산 오류이며, 백분위 23도 z = −1.5와 맞지 않는다.\",\"2\":\"z = −2.0은 차이 12를 6으로 나눈 계산 오류로, 실제 표준편차 8을 적용하지 않았다.\",\"3\":\"z = −1.5는 맞지만 백분위 16은 z = −1에 해당하므로 z와 백분위가 서로 맞지 않는다.\",\"5\":\"z = +1.5는 원점수가 평균보다 낮은데 부호를 반대로 적용한 오류이다.\"}},\"1-2-1-51\":{\"p\":\"문제의 기준(조사·어미·선어말어미를 각각 하나의 형태소로 계산)에 따르면 ① 아빠/신문/읽-/-어 = 4, ② 나/우유/먹-/-었-/-어 = 5, ③ 동생/-이/울-/-어 = 4, ④ 엄마/-가/책/찾-/-아 = 5로 분석한다. 총 형태소 18개를 발화 수 4로 나누면 MLU-m = 4.5이다. MLU-m은 총 형태소 수를 총 발화 수로 나눈 값으로, 조사와 어미를 빠뜨리면 낮게, 어간을 더 쪼개면 높게 산출된다.\",\"w\":{\"2\":\"4.0은 총 16개로, 조사 '-이'와 '-가'를 형태소로 세지 않아 과소 계산한 값이다.\",\"3\":\"3.5는 총 14개로, 조사와 어미를 형태소로 세지 않고 낱말(어절) 단위에 가깝게 센 값이다.\",\"4\":\"5.0은 총 20개로, 어간을 더 분리하는 등 형태소를 과도하게 나눈 값이다.\",\"5\":\"5.5는 총 22개로, 정답 기준보다 형태소를 크게 과대 계산한 값이다.\"}},\"1-2-1-52\":{\"p\":\"청력과 비언어성 지능(98)이 정상이고 눈맞춤·상호작용·상징놀이가 양호한데, 수용·표현언어가 지체되고 표현어휘 9%ile, 비단어 따라말하기 저하, 주격조사 생략·시제 오류·연결어미 부재 등 문법형태소 결함이 두드러진다. 이는 발달성 언어장애(단순언어장애)의 전형적 프로파일이며 비단어 따라말하기 저하는 대표적 임상 표지이다. 따라서 진단은 발달성 언어장애, 우선 중재 목표는 격조사·시제 등 문법형태소 산출이다.\",\"w\":{\"2\":\"눈맞춤·상호작용·상징놀이가 양호하고 상동행동이 없어 자폐스펙트럼장애로 볼 근거가 없다.\",\"3\":\"사회적 상호작용이 양호하고 형식(문법) 결함이 핵심이므로 사회적(화용) 의사소통장애가 아니다.\",\"4\":\"비언어성 지능지수가 98로 정상이므로 지적장애가 아니다.\",\"5\":\"결함은 조음이 아니라 문법형태소·어휘 등 언어 영역이므로 말소리장애 중재는 핵심 결함과 맞지 않는다.\"}},\"1-2-1-53\":{\"p\":\"전체 지능지수 62와 적응행동 저하는 지적장애에 해당하며, 언어 발달연령(약 3;6)이 인지 수준과 대체로 일치한다. 요구하기를 손잡아끌기로 하고 배운 낱말을 치료실 밖에서 쓰지 못하는 것은 기능적 의사소통 부족과 일반화의 어려움을 보여 준다. 따라서 요구·거부·선택 등 일상 기능과 생활 어휘를 목표로 실제 일과 속에서 반복·분산 연습하며 일반화를 강조하는 것이 가장 적절하다.\",\"w\":{\"1\":\"인지와 언어는 병행 촉진 대상이며 인지를 정상 범위로 끌어올린 뒤 언어치료를 시작한다는 전제는 비현실적이다.\",\"2\":\"언어 수준이 인지 수준과 대체로 일치하므로 언어-인지 불일치를 전제로 한 단순언어장애 프로토콜은 부적절하다.\",\"4\":\"2~3어절 단문 수준 아동에게 연령 수준의 복문 산출은 발달 수준을 크게 넘는 목표이다.\",\"5\":\"몸짓·그림 등 비구어 수단은 기능적 의사소통을 지원하므로 제한하면 총체적 의사소통 원칙에 어긋난다.\"}},\"1-2-1-54\":{\"p\":\"아동이 원하는 물건에 관심을 보일 때 치료사가 언어적 촉진 없이 기대에 찬 표정으로 약 5초간 기다려 자발적 산출을 유도하고, 산출하자 즉시 원하는 물건으로 자연적 강화를 준 것은 시간지연(time delay) 절차이다. 시간지연은 비언어적 단서(기다림·기대 표정)만으로 아동의 의사소통 시작을 이끄는 것이 핵심이다. 따라서 정답은 시간지연이다.\",\"w\":{\"1\":\"요구-모델은 치료사가 '뭐 줄까?'처럼 먼저 언어적 요구(질문·지시)를 하는 절차로, 이 사례에서는 말없이 기다렸다.\",\"2\":\"우연교수는 아동이 먼저 요구를 시작한 뒤 치료사가 더 정교한 발화를 요청하는 절차이다.\",\"3\":\"아동중심 시범은 아동의 관심에 맞춰 목표 발화를 먼저 들려주는 절차로, 이 사례에서는 시범을 제공하지 않았다.\",\"4\":\"환경 조성은 물건을 닿지 않는 곳에 두는 등 의사소통 기회를 만드는 사전 설정으로, 기다림을 통한 촉진 절차 자체를 가리키지 않는다.\"}},\"1-2-1-55\":{\"p\":\"과거시제 '-었-'을 담은 문장을 놀이 맥락에서 한 회기에 수십 번 자연스럽게 들려주되 모방이나 산출을 요구하지 않는 것은 집중자극(focused stimulation) 기법이다. 목표 형태를 의미 있는 맥락에서 고빈도로 입력하여 아동이 스스로 규칙을 추출하도록 돕는 것이 원리이다. 따라서 집중자극 – 목표 형태의 고빈도 입력이 옳다.\",\"w\":{\"1\":\"확대는 아동이 먼저 한 발화에 새로운 의미 정보를 덧붙여 되돌려 주는 반응 기법으로, 치료사가 먼저 반복 입력하는 이 사례와 다르다.\",\"2\":\"유도모방은 모델 직후 아동이 즉시 따라 말하도록 요구하는데, 이 사례에서는 산출을 요구하지 않았다.\",\"3\":\"비연속 개별시도 교수는 자극-반응-강화의 구조화된 시행으로 아동의 반응을 직접 요구한다.\",\"5\":\"혼잣말 기법은 치료사가 자신의 행동을 말로 기술하는 것으로, 특정 문법형태소를 고밀도로 입력하는 것이 목적이 아니다.\"}},\"1-2-1-56\":{\"p\":\"매 회기마다 세 가지 목표를 모두 다루며 회기 시간을 나누어 배분하는 것은 수평적(horizontal) 목표 공략 전략이다. 수평적 전략은 여러 목표를 동시에 다루어 목표 간 연결과 다양한 경험을 제공하는 장점이 있다. 따라서 정답은 수평적 전략이다.\",\"w\":{\"2\":\"주기적 전략은 준거 도달과 무관하게 정해진 기간마다 목표를 교체하며 순환하는 방식으로, 매 회기 모든 목표를 다루지 않는다.\",\"3\":\"수직적 전략은 한 목표가 준거에 도달한 뒤 다음 목표로 넘어가는 순차적 방식이다.\",\"4\":\"위계적 전략은 목표 공략 전략의 공식적 분류(수직적·수평적·주기적)에 포함되지 않는다.\",\"5\":\"절충적 전략(치료사 목표·아동 활동 선택)은 목표 공략 전략의 공식적 분류가 아니다.\"}},\"1-2-1-57\":{\"p\":\"역동적 평가에서 짧은 교수 후 새 낱말을 대부분 습득하고 검사자 노력이 적으며 수정가능성이 높은 것은 언어 학습 능력 자체가 온전함을 보여 준다. 모국어(중국어) 발달이 또래 수준이라는 점도 이를 지지하므로, 낮은 한국어 표준화 점수는 짧은 노출 기간에 따른 언어 차이로 해석한다. 따라서 모국어를 유지하면서 한국어 입력을 늘리고 추적 관찰하는 것이 적절하다.\",\"w\":{\"1\":\"한국어 단일언어 규준의 표준화 검사 점수만으로 이중언어 아동을 발달성 언어장애로 진단하는 것은 과잉 진단 오류이다.\",\"2\":\"이중언어가 혼란이나 언어장애를 유발한다는 전제는 근거가 없으며, 모국어 사용 중단은 발달과 가족 관계에 해롭다.\",\"4\":\"이중언어 아동 평가에서는 역동적 평가가 규준 편향을 줄이는 핵심 자료이므로 참고자료로만 취급하는 것은 부적절하다.\",\"5\":\"한국어 노출 확대와 추적 관찰 등 지원 필요성이 있으므로 평가를 종료하고 무시하는 것은 부적절하다.\"}},\"1-2-1-58\":{\"w\":{\"1\":\"수어를 주 수단으로 먼저 확립하는 것은 청각구어법이 아니라 수어 중심 또는 이중언어-이중문화 접근이다.\",\"2\":\"그림 기반 AAC를 주 의사소통 수단으로 삼는 것은 청각을 통한 구어 습득을 최우선하는 원리와 맞지 않는다.\",\"3\":\"독순 중심의 시각 단서 제공은 청각구어법이 최소화하려는 방식으로, 오히려 청각 활용을 약화시킨다.\",\"5\":\"부모 참여 배제는 부모 코칭을 핵심으로 하는 청각구어법의 원리에 어긋난다.\"}},\"1-2-1-59\":{\"p\":\"현재 의사소통판은 명사 20개로만 구성되어 요구하기 기능에만 쓰이고, 상대도 주로 어머니로 제한되어 있다. '더, 아니야, 싫어, 다했어, 봐' 같은 핵심어휘를 추가하면 거부·언급·질문 등으로 기능이 넓어지고 상징 조합이 가능해지며, 상대가 상징을 짚으며 말하는 보조 언어 자극으로 입력 모델을 제공해야 한다. 이해가 연령 수준이므로 이러한 확장이 충분히 가능하다.\",\"w\":{\"2\":\"AAC는 구어 발달을 방해하지 않으며, 명료도가 매우 낮은 아동의 AAC 사용을 중단하면 의사소통 수단을 빼앗는 결과가 된다.\",\"3\":\"판을 구어 따라말하기 훈련 도구로 바꾸는 것은 AAC를 기능적 의사소통 수단이 아닌 조음 훈련으로 대체하는 잘못된 접근이다.\",\"4\":\"사용 상대와 상황을 어머니로 한정하면 의사소통 상대·환경의 확장을 오히려 막는다.\",\"5\":\"명사(부수어휘)만 늘리면 요구하기 이외의 기능이 확장되지 않는다.\"}},\"1-2-1-60\":{\"w\":{\"2\":\"사회적 의사소통의 기반(공동주의) 없이 낱말 따라말하기를 우선하면 기능적 의사소통으로 이어지기 어렵다.\",\"3\":\"반복 놀이는 즉시 소거할 대상이 아니라 아동의 관심을 활용해 놀이를 확장하는 출발점으로 삼는다.\",\"4\":\"'자폐 아동은 시각 학습자라 읽기가 빠르다'는 일반화는 근거가 약하며, 30개월 무발화 아동의 우선 목표로 문자 읽기는 부적절하다.\",\"5\":\"성인 지시 따르기(순응)는 언어 학습의 전제 조건이 아니며, 아동 주도의 사회적 상호작용 확립이 우선이다.\"}},\"1-2-1-61\":{\"w\":{\"1\":\"상황에 따라 일관되게 쓰이는 반향어는 의사소통 기능을 지니므로 무의미한 자기자극으로 보고 소거하는 것은 부적절하다.\",\"3\":\"반향어는 통째로 저장된 비생성적 발화이므로 이를 적절한 언어 수준의 증거로 볼 수 없다.\",\"4\":\"과거에 들은 말을 나중에 재현하므로 즉각 반향어가 아니며, 억제는 기능을 무시한 대처이다.\",\"5\":\"비생성적 문구를 더 암기시키는 것은 생성적 언어 발달이라는 중재 방향과 반대이다.\"}},\"1-2-1-62\":{\"p\":\"해독·유창성과 어휘는 정상이나, 단문을 '그리고'로만 잇고 원인-결과를 표현하지 못하며 관형절·종속 연결어미 사용이 거의 없는 것은 후기 구문과 설명담화 구조화의 결함이다. 교과 서술형 평가 점수가 낮은 것도 이를 반영한다. 따라서 교과 내용을 활용해 문장 결합(sentence combining)으로 복문 구문을 지도하고, 원인-결과 등 설명담화 구조를 도식 조직자로 지도하는 것이 가장 적절하다.\",\"w\":{\"1\":\"낱말 해독과 읽기 유창성은 학년 수준이므로 유창성 훈련은 핵심 결함을 겨냥하지 않는다.\",\"3\":\"어휘는 정상 범위이므로 어휘 목록 암기는 표적이 틀리다.\",\"4\":\"허구적 이야기(서사 담화) 다시 말하기는 교과 설명담화·복문 결함이라는 핵심 문제와 맞지 않는다.\",\"5\":\"음운인식 훈련은 해독 문제가 있을 때의 중재로, 해독이 정상인 이 아동에게는 불필요하다.\"}},\"1-2-1-63\":{\"w\":{\"1\":\"문장 수를 늘리는 것은 이야기 길이라는 양적 지표만 겨냥하며, 인과적 구조 결함을 해결하지 못한다.\",\"2\":\"새 낱말 추가는 어휘다양도라는 양적 지표에 초점을 두어 이야기 문법 구조 결함과 무관하다.\",\"3\":\"청각 기억 훈련은 이야기 구조 지식을 가르치지 않으며, 시각 지원을 제거해 오히려 과제를 어렵게 한다.\",\"5\":\"아동의 결함은 조음이 아니라 이야기 구조이므로 조음 훈련은 핵심 결함과 무관하다.\"}},\"1-2-1-64\":{\"p\":\"음절 수 세기·합성·분리는 90% 이상 정확하므로 음절 수준 음운인식은 완성되었으나, 초성 변별·분리가 20%로 음소 수준 인식이 부족하고 자모의 소리값을 모른다. 해독 습득에는 음소 인식과 자소-음소 대응 지식이 결정적이므로, 다음 단계인 음소 수준 인식을 글자-소리 대응과 통합하여 지도하는 것이 가장 효과적이다. 음운인식 훈련은 글자와 연계할 때 읽기 효과가 커진다.\",\"w\":{\"1\":\"음절 수준 인식은 이미 숙달되었으므로 계속 반복하는 것은 다음 발달 단계로의 진전을 막는다.\",\"2\":\"통문자 암기는 자소-음소 대응 원리를 우회하여 새로운 낱말을 해독하는 능력을 기르지 못한다.\",\"4\":\"음소 인식 지도를 초등 입학 후로 미루는 것은 읽기 준비 중재를 불필요하게 지연시키며, 자모 이름만으로는 해독이 되지 않는다.\",\"5\":\"어휘·구문은 연령 수준이므로 어휘 확장은 이 아동의 핵심 약점이 아니다.\"}},\"1-2-1-65\":{\"p\":\"빈칸 채우기(Completion), 회상(Recall), 개방형(Open-ended), wh-질문(Wh-), 경험 연결(Distancing)의 CROWD 질문으로 아동을 이야기의 능동적 화자로 만드는 것은 대화식 책읽기(dialogic reading)이다. 아동이 대답하면 칭찬(평가)하고, 문장으로 확장해 들려준 뒤 다시 말하게 하는 것은 PEER 절차(촉진-평가-확장-반복)에 해당한다. 따라서 대화식 책읽기 – 질문으로 아동이 이야기의 화자가 되게 한다가 옳다.\",\"w\":{\"1\":\"글을 정확히 끝까지 읽어 주는 것은 성인이 주도하는 수동적 읽어주기로, 아동의 참여를 핵심으로 하는 이 방법과 다르다.\",\"2\":\"질문을 최소화하는 반응적 상호작용은 CROWD 질문이 핵심인 이 접근과 반대이다.\",\"3\":\"스크립트 중재는 익숙한 일상 사건의 순서(각본)를 활용하는 방법으로 책읽기 질문 전략과 다르다.\",\"5\":\"청각적 집중 자극은 산출을 요구하지 않고 목표어를 반복 입력하는 기법으로, 질문과 따라 말하기로 산출을 유도하는 이 사례와 다르다.\"}},\"1-2-1-66\":{\"w\":{\"1\":\"과잉규칙화는 퇴행이 아니라 규칙 습득을 보여 주는 정상 발달 현상이므로 즉시 중재할 필요가 없다.\",\"3\":\"오류가 규칙 적용에 따른 체계적 형태이므로 청각 문제로 어미를 잘못 듣는 것으로 볼 근거가 없다.\",\"4\":\"'듣어요', '짓어요'는 성인 입력에 없는 형태이므로 모방으로 설명되지 않는다.\",\"5\":\"과잉규칙화는 처리 속도 저하의 징후가 아니며 작업기억 훈련이 필요한 근거가 없다.\"}},\"1-2-1-67\":{\"p\":\"비단어·문장 따라말하기 저조, 3단계 지시 중 첫 단계만 수행하나 한 단계씩 나누면 모두 수행, 빠른 말에서 이해 급락은 발달성 언어장애 아동의 제한된 처리 용량(음운 작업기억·처리 속도)을 반영한다. 정보처리 관점의 중재는 입력 속도를 늦추고, 정보를 작은 단위로 나누어 제시하며, 핵심어 강조와 시각 지원으로 처리 부담을 줄이면서 목표 언어 형식을 학습시키는 것이다. 한 단계씩 나누면 수행이 된다는 점이 이 원리의 직접적 근거이다.\",\"w\":{\"1\":\"언어와 분리된 숫자 거꾸로 외우기 등 기억 훈련은 언어 능력으로의 전이 효과가 제한적이다.\",\"3\":\"처리 부담을 고려하지 않고 긴 문장을 그대로 제시하면 아동의 처리 용량을 넘어서 학습이 일어나기 어렵다.\",\"4\":\"정보량·속도에 따라 이해가 달라지는 양상은 언어 처리 용량 문제를 시사하며, 주의력 문제로 단정할 근거가 없다.\",\"5\":\"같은 지시를 반복 연습시키는 것은 처리 용량 문제를 해결하지 못하며 순응 문제로 오해한 접근이다.\"}},\"1-2-1-68\":{\"p\":\"어휘·구문·조음은 정상이나 대화 시작, 주제 유지(자기 관심사 독점), 상대의 비언어적 반응 읽기에 어려움이 있고 치료실에서 배운 기술이 교실로 일반화되지 않는다. 화용 결함은 실제 상호작용 맥락에서 역할놀이·비디오 모델링으로 연습하고, 또래를 참여시켜 자연 환경(교실)으로의 일반화를 계획해야 효과가 있다. 따라서 역할놀이·비디오 모델링과 또래 참여로 교실 일반화를 계획하는 것이 가장 적절하다.\",\"w\":{\"1\":\"어휘·구문이 정상이므로 언어 형식 훈련은 화용 결함이라는 핵심 표적을 겨냥하지 않는다.\",\"2\":\"대화 규칙 설명과 문제집 정답 고르기는 지식 수준에 머물러 실제 대화로의 일반화가 어렵다.\",\"4\":\"조음이 정상이므로 조음 정확도 훈련은 표적이 틀리다.\",\"5\":\"관심사를 금지하기보다 상대 반응에 맞추어 주제를 조절하고 전환하도록 지도하는 것이 적절하다.\"}},\"1-2-1-69\":{\"w\":{\"1\":\"약점인 청각 기억에 긴 문장을 반복 제시하면 처리 부담만 커지고 강점인 시각 처리를 활용하지 못한다.\",\"2\":\"명료도가 낮아도 구어 가능성이 있으므로 구어를 중단하고 문자 소통으로 전환하는 것은 부적절하다.\",\"4\":\"표현(구문·문법형태소)이 가장 취약한 영역이므로 표현 중재를 생략하면 핵심 약점을 방치하게 된다.\",\"5\":\"시각 자료는 다운증후군 아동의 상대적 강점을 활용하는 수단으로 사용을 배제할 이유가 없다.\"}},\"1-2-1-70\":{\"p\":\"언어재활사가 담임교사와 매주 협의해 교과 핵심 어휘·개념을 목표로 삼고, 일부 회기는 교실 수업에 참여해 아동을 지원하며, 교사에게 언어 촉진 전략을 안내하는 것은 교실 중심(pull-in)·협력적 서비스 모델이다. 교육과정과 연계된 목표를 실제 교실 맥락에서 다루므로 학령기 아동의 실제 환경 일반화와 학업 성취를 촉진하는 것이 주요 장점이다. 직접 지원과 자문이 함께 이루어진다는 점이 핵심이다.\",\"w\":{\"1\":\"분리(pull-out) 모델은 아동을 교실 밖 치료실로 데려가 치료하는 방식으로, 교실 참여가 포함된 이 사례와 다르다.\",\"2\":\"의료 모델은 손상·원인 중심 접근으로 학교 서비스 전달 모델의 분류가 아니다.\",\"3\":\"언어재활사가 교실에서 아동을 직접 지원하는 서비스가 병행되므로 자문 모델만 적용한 것이 아니다.\",\"4\":\"비연속 개별시도는 교수 기법으로 서비스 전달 모델의 분류가 아니다.\"}},\"1-2-1-71\":{\"w\":{\"1\":\"말할 때까지 원하는 것을 주지 않는 것은 비윤리적이고 좌절만 유발하며 자연스러운 일반화 전략이 아니다.\",\"2\":\"치료실 정확도만으로 목표를 종결하면 실제 생활에서의 사용이 확보되지 않은 채 다음 목표로 넘어가게 된다.\",\"3\":\"치료실 과제의 정확도를 더 높여도 다른 환경으로의 일반화는 보장되지 않는다.\",\"4\":\"이미 치료실에서 습득된 기술이므로 목표를 재설정하고 같은 훈련을 반복하는 것은 불필요하다.\"}},\"1-2-1-72\":{\"p\":\"어머니 발화의 80%가 질문·지시이고, 아동의 놀이에 주목하지 않으며, 아동의 발성·몸짓 시작에 반응하는 비율이 낮고 놀이 주제가 자주 어긋나는 것은 성인 주도·저반응성 상호작용이다. 부모 매개 중재(Hanen 등)의 핵심은 아동 주도 따르기, 시작 행동에 즉각 반응하기, 행동·발성을 해석해 말로 들려주고 확장하기 같은 반응적 상호작용 전략이다. 따라서 이 전략들을 지도하는 것이 우선 목표이다.\",\"w\":{\"1\":\"소리·몸짓 같은 언어 이전 의사소통 시도를 무시하면 아동의 시작 행동이 오히려 줄어든다.\",\"2\":\"질문 횟수를 늘리는 것은 이미 과도한 성인 주도 상호작용을 강화한다.\",\"3\":\"그림카드 이름대기 훈련은 자연스러운 상호작용을 반복 훈련으로 대체하며 부모의 반응성 문제를 다루지 못한다.\",\"4\":\"어머니가 주제를 정해 이끄는 것은 성인 주도를 강화하여 아동의 관심과 어긋나는 문제를 악화시킨다.\"}},\"1-2-2-1\":{\"p\":\"명료도 향상과 빠른 성공을 최우선할 때는 발달적(전통적) 목표 선정 원칙에 따라 연령상 이미 습득되었어야 할 음, 사용 빈도가 높은 음, 자극반응도가 있는 음을 먼저 선택한다. /ㄱ, ㅋ/는 5세 2개월이면 습득되었어야 할 이른 발달음이고 모든 낱말 위치에서 대치되어 명료도 저하에 크게 기여하며 자극반응도도 있다. 따라서 세 조건을 모두 충족하는 /ㄱ/이 첫 목표음으로 가장 적절하다.\",\"w\":{\"1\":\"늦은 발달음을 먼저 훈련해 일반화를 노리는 것은 복잡성 접근의 논리로, 자극반응도가 없는 /ㅅ/은 명료도 향상과 빠른 성공이라는 이 사례의 목표와 맞지 않는다.\",\"2\":\"어중 /ㄹ/ 생략이 모든 위치에서 나타나는 연구개음 대치보다 명료도를 더 떨어뜨린다고 볼 근거가 없으며, 생략이 항상 대치보다 심각하다는 일반화도 성립하지 않는다.\",\"4\":\"여러 음소를 같은 비중으로 동시에 훈련하는 것은 우선순위 설정이라는 문항의 요구를 무시하며 치료 기간 단축의 근거도 없다.\",\"5\":\"비구어 구강운동 훈련은 말소리 산출 개선에 대한 근거가 부족하고 이 아동은 기질적 결함도 없다.\"}},\"1-2-2-2\":{\"p\":\"주기법(Hodson)은 명료도가 매우 낮은 아동에게 출현율 40% 이상의 음운패턴을 목표로 삼아 일정 기간씩 순환하는 방법이다. 각 패턴은 숙달이 아니라 출현(emergence)을 목표로 하며, 정해진 시간이 지나면 다음 패턴으로 넘어가고 다음 주기에서 다시 다룬다. 이 아동은 파열음화·종성생략·전방화·활음화가 40% 이상이므로 이 패턴들을 순환하는 것이 원리에 맞다.\",\"w\":{\"1\":\"주기법 회기는 청각 자극(auditory bombardment)과 산출 연습을 함께 포함하며, 산출 연습을 뒤로 미루지 않는다.\",\"2\":\"한 패턴을 90% 정확도까지 훈련하는 것은 숙달 기준(수직적) 접근으로, 시간 기준으로 순환하는 주기법의 원리와 반대이다.\",\"3\":\"어중초성 생략(15%)은 40% 기준에 미달해 목표 대상이 아니며, 우선순위 없이 균등 배분하는 것도 주기법의 목표 선정 원리가 아니다.\",\"5\":\"출현율이 가장 낮고 기준 미달인 패턴부터 시작하는 것은 주기법의 목표 선정 우선순위와 반대이다.\"}},\"1-2-2-3\":{\"w\":{\"1\":\"PCC 값은 맞으나 경도-중등도는 65~85% 구간이므로 58%의 중증도 판정이 틀렸다.\",\"2\":\"경도는 PCC 85% 초과에 해당하므로 58%를 경도로 본 것은 판정 오류이다.\",\"4\":\"42%는 대치·생략·왜곡을 합한 오류율(42/100)로, 정확률인 PCC와 혼동한 값이다.\",\"5\":\"61%는 왜곡 3개를 정조음으로 인정한 수정 자음정확도(PCC-R, 61/100)이며 원래 산출식의 값이 아니다.\"}},\"1-2-2-4\":{\"w\":{\"1\":\"최소대립쌍 치료는 일관된 오류패턴을 보이는 일관적 음운장애에 적합하며 비일관적 산출에는 효과가 제한적이다.\",\"2\":\"전통적 조음치료는 특정 음소의 운동적 산출 문제에 적합하나 이 아동은 대부분의 음소를 모방 산출할 수 있어 운동 확립이 핵심 문제가 아니다.\",\"3\":\"주기법은 일관된 음운패턴이 높은 출현율로 나타나는 아동에게 적용하며, 매번 형태가 달라지는 비일관적 산출에는 맞지 않는다.\",\"5\":\"DTTC는 모색행동·운율 이상·모음 오류를 보이는 아동기 말실행증의 접근인데 이 아동에게는 해당 징후가 없다.\"}},\"1-2-2-5\":{\"w\":{\"1\":\"음운지연은 발달적 음운패턴이 일관되게 나타나는 것으로 모색행동·모음 오류·운율 이상을 설명하지 못한다.\",\"3\":\"근력 저하·반사 이상이 없으므로 마비말장애가 아니며, 근력 강화 훈련은 근거도 부족하다.\",\"4\":\"조음장애는 특정 음소에 국한된 일관된 오류를 보이며, 모음 오류·비일관성·운율 이상을 동반하지 않는다.\",\"5\":\"비일관적 음운장애는 모색행동·운율 이상·모음 오류가 없고 모방 시 산출이 개선된다는 점에서 이 아동과 다르다.\"}},\"1-2-2-6\":{\"w\":{\"1\":\"자극반응도가 있는 음부터 빠른 성공을 노리는 것은 발달적(전통적) 목표 선정 원리로 복잡성 접근과 반대이다.\",\"2\":\"이른 발달음 우선은 전통적 발달 접근의 기준이며, 복잡성 접근은 오히려 늦은 발달음을 우선한다.\",\"3\":\"이 아동은 모음 문제가 보고되지 않았고, 모음 체계를 먼저 안정시키라는 원칙은 복잡성 접근에 없다.\",\"4\":\"오류 빈도가 가장 낮은 음소부터 훈련한다는 기준은 어떤 목표 선정 접근에서도 근거가 없다.\"}},\"1-2-2-7\":{\"p\":\"/ㅅ, ㅆ, ㅈ, ㅊ, ㄱ, ㅋ/ 여러 음소가 모두 [ㄷ] 하나로 붕괴(phoneme collapse)되어 살·잘·찰·갈이 모두 [달]이 되는 동음이의가 다수 발생하였다. 이처럼 하나의 대치음에 여러 목표음이 합쳐진 경우에는 대치음과 여러 목표음을 한 세트로 동시에 대조하는 다중대립 접근이 음운체계 재구조화에 가장 효율적이다.\",\"w\":{\"2\":\"최소대립쌍은 한 번에 한 쌍의 대조만 다루므로 여섯 음소가 한 음소로 붕괴된 광범위한 체계 문제에는 비효율적이다.\",\"3\":\"짝자극 기법은 이미 정조음하는 핵심낱말로 개별 음소의 정확한 산출을 전이시키는 운동적 접근으로 음소 붕괴 자체를 다루지 못한다.\",\"4\":\"전통적 조음치료는 한 음소의 조음 운동 확립에 초점을 두어 여러 음소의 대조 부재라는 음운적 문제를 직접 해결하지 못한다.\",\"5\":\"상위음운 접근은 소리 속성 인식을 기르는 방법이며, 길고 짧음 개념만 반복하는 것은 이 아동의 조음 위치·방법 대조 문제와 맞지 않는다.\"}},\"1-2-2-8\":{\"w\":{\"2\":\"빨기·불기 등 비구어 구강운동은 구강 내압이나 보상조음 교정에 효과가 입증되지 않았다.\",\"3\":\"성문파열음·인두마찰음은 정상 발달에서 나타나는 음운변동이 아니며, 6세까지 지속된 학습된 오류는 자연 소실을 기대하기 어렵다.\",\"4\":\"내시경과 나조미터에서 폐쇄 기능이 정상이므로 재수술을 의뢰할 근거가 없다.\",\"5\":\"비음치가 정상 범위이고 문제는 과비성이 아니라 조음 위치의 오류이므로 비음치 낮추기 훈련은 목표와 맞지 않는다.\"}},\"1-2-2-9\":{\"p\":\"구강문장 비음치 38%는 정상 기준(약 15% 이하)을 크게 초과하고, 대화 전반에서 일관된 과다비성과 압력자음 비강누출이 있으며, 단서를 주어도 변화가 없다. 보상조음 없이 조음 위치가 정확하다는 점도 기능적 문제보다 구조적 구개인두폐쇄부전(VPI)을 시사한다. 따라서 비인두내시경·비디오투시 등 기구 평가로 폐쇄 양상을 확인하고 인두피판술·구개거상장치 등 수술적·보철적 관리를 의뢰하는 것이 우선이다.\",\"w\":{\"1\":\"불기·빨기 훈련은 구개인두 폐쇄 기능 향상에 근거가 없으며 구조적 결함을 해결하지 못한다.\",\"2\":\"자극반응도가 없는 구조적 VPI에 청각 피드백 훈련을 장기간 실시하는 것은 효과가 없고 물리적 관리를 지연시킨다.\",\"3\":\"조음 위치가 정확한 아동의 과다비성은 조음 문제가 아니라 공명(구조) 문제이므로 조음치료로 교정할 수 없다.\",\"5\":\"구강문장 비음치 38%는 정상 기준을 크게 초과하므로 정상 범위라는 판단 자체가 틀렸다.\"}},\"1-2-2-10\":{\"w\":{\"1\":\"음소별 전통적 조음치료는 특정 음소의 오류에 적합하며 모든 음소에 걸친 신경운동성 왜곡에는 효율이 낮다.\",\"2\":\"최소대립쌍 치료는 음운 대조 결함을 다루는 음운적 접근으로, 운동 실행 문제인 마비말장애에는 맞지 않는다.\",\"4\":\"주기법은 기능적 음운장애 아동의 음운패턴을 다루는 방법으로 신경운동 결함에 기인한 오류를 해결하지 못한다.\",\"5\":\"비구어 근력강화 운동만으로는 말명료도 개선의 근거가 부족하며 호흡·말속도 등 핵심 요소를 다루지 못한다.\"}},\"1-2-2-11\":{\"w\":{\"1\":\"보청 상태가 양호하고 파열음·비음이 비교적 정확해 구어 발달 가능성이 있으므로 수어로 전면 전환할 근거가 없다.\",\"2\":\"보청 효과가 있는 아동에게 청각 단서를 배제하는 것은 인공와우 이식의 이점을 활용하지 못하는 계획이다.\",\"3\":\"이 아동의 오류는 청각적 입력 제한에 기인한 것이며, 비구어 구강운동은 말소리 개선에 근거가 부족하다.\",\"4\":\"청각장애로 인한 오류를 정상 발달 시기에 맞춰 보류하면 중재가 지연되며, 6세 아동의 마찰음 목표 보류는 근거가 없다.\"}},\"1-2-2-12\":{\"p\":\"혀를 내밀 때 혀끝이 하트 모양으로 패이고 치조에 닿지 않는 것은 설소대 단축증의 소견이다. 혀끝 접촉이 필요한 /ㄹ, ㄷ, ㄴ/에만 모든 문맥에서 일관된 왜곡이 나타나고 음운변동이 없으므로 구조적 원인에 따른 음성적(조음) 오류이다. 따라서 의학적 평가(설소대 절제술 여부)를 의뢰하면서 가능한 조음 위치를 확립하는 조음 훈련을 병행한다.\",\"w\":{\"1\":\"음운변동이 관찰되지 않고 특정 구조와 관련된 왜곡만 있으므로 음운체계의 문제가 아니다.\",\"3\":\"오류가 모든 문맥에서 일관되므로 비일관적 음운장애가 아니다.\",\"4\":\"/ㄹ, ㄷ, ㄴ/은 7세에 이미 습득되었어야 할 음소이고 구조적 원인이 있어 자연 개선을 기대하기 어렵다.\",\"5\":\"비구어 혀 스트레칭으로 설소대를 늘릴 수 있다는 근거가 없으며 의학적 평가 의뢰를 누락한 계획이다.\"}},\"1-2-2-13\":{\"w\":{\"1\":\"설압자로 조음 위치를 직접 지시하는 것은 전통적 조음치료의 운동 확립 기법으로 Metaphon의 1단계가 아니다.\",\"2\":\"1단계는 산출 정확도가 아니라 소리 속성에 대한 상위음운 인식을 기르는 단계이며, 90% 산출 준거 반복은 목적과 맞지 않는다.\",\"4\":\"핵심낱말과 훈련낱말을 번갈아 산출하는 것은 짝자극 기법의 절차이다.\",\"5\":\"구강운동으로 근력을 기르는 것은 Metaphon의 절차가 아니며 말소리 개선 근거도 부족하다.\"}},\"1-2-2-14\":{\"p\":\"낱말 92%, 구조화된 문장 85%로 구조화된 상황에서는 확립되었으나 자발 대화 40%, 가정에서도 오류가 대부분인 것은 전이(일반화) 단계의 문제이다. 아동이 자신의 오류를 알아채지 못하므로 자기 모니터링 훈련으로 스스로 오류를 탐지·수정하게 하고, 훈련 장면을 가정·학교 등 다양한 상대·장소·활동으로 확대하며 부모·교사를 통해 일상 속 단서와 강화를 제공해야 한다.\",\"w\":{\"1\":\"낱말 수준 92%로 조음 운동은 이미 확립되었으므로 무의미음절 수준으로 돌아갈 필요가 없다.\",\"2\":\"문제는 운동 능력이 아니라 일반화이며, 구강운동 훈련은 말소리 개선 근거도 부족하다.\",\"3\":\"자발 대화 정확도가 40%에 불과해 일상으로 전이되지 않았으므로 종결 기준을 충족하지 못한다.\",\"4\":\"/ㅅ/는 이미 구조화된 수준에서 확립되었으므로 목표를 보류하면 지금까지의 진전을 일반화로 연결하지 못한다.\"}},\"1-2-2-15\":{\"w\":{\"1\":\"'기' 문맥은 전설모음이 혀를 앞으로 끌어 전방화를 유도하는 가장 어려운 문맥이므로 확립 단계의 출발점으로 부적절하다.\",\"3\":\"확립 단계에서 문맥을 무작위로 제시하면 촉진 문맥의 이점을 잃고 성공률이 낮아진다.\",\"4\":\"아직 확립되지 않은 음을 문장 수준에서 바로 시작하면 오류가 많아 확립이 어렵다.\",\"5\":\"이 아동은 어두보다 어중에서 정조음 비율이 높으므로 어두 '가'가 촉진 문맥이 아니며, 지각적 두드러짐은 산출 촉진의 근거가 아니다.\"}},\"1-2-2-16\":{\"w\":{\"2\":\"핵심낱말은 오조음하는 낱말이 아니라 이미 정조음하는 낱말이어야 전이의 기준이 될 수 있다.\",\"3\":\"9회 이상 정조음 기준은 핵심낱말의 기준이며, 훈련낱말은 오조음하는 낱말로 선정한다.\",\"4\":\"짝자극 기법은 같은 목표음의 산출 전이를 이용하며 최소대립쌍과 같은 의미 대조를 요구하지 않는다.\",\"5\":\"핵심낱말과 훈련낱말은 같은 목표음을 포함해야 정확한 조음 운동이 전이된다.\"}},\"1-2-2-17\":{\"w\":{\"1\":\"'달-갈'은 치경과 연구개의 조음 위치 대조로 이 아동이 이미 확립한 자질이다.\",\"2\":\"'달-탈'은 평음과 격음의 기식성 대조로 이 아동의 결함 자질이 아니다.\",\"3\":\"'달-날'은 파열음과 비음의 비음성 대조로 이 아동의 오류와 관련이 없다.\",\"5\":\"'달-딸'은 평음과 경음의 긴장성 대조로 이 아동은 발성유형을 정확히 유지하고 있다.\"}},\"1-2-2-18\":{\"w\":{\"2\":\"주기법은 명료도가 낮고 여러 음운패턴이 높은 출현율로 나타나는 아동에게 적용하며 단일 음소군의 왜곡에는 맞지 않는다.\",\"3\":\"핵심어휘 접근은 비일관적 산출에 적용하나 이 아동의 오류는 모든 문맥·과제에서 일관된다.\",\"4\":\"최소대립쌍 치료는 음소 대조가 붕괴된 음운적 오류에 적용하며, 대조가 유지되는 왜곡에는 적합하지 않다.\",\"5\":\"이 아동은 청각 변별과 음운인식이 정상이어서 소리 속성 인식을 가르치는 상위음운 접근의 필요가 없다.\"}},\"1-2-2-19\":{\"p\":\"이중언어 아동의 말소리장애는 두 언어 모두에서 오류가 나타나고 모국어 음운체계로 설명되지 않을 때 판단한다. 이 아동은 통역사 평가에서 베트남어 산출이 또래 수준이고, 한국어 오류(경음·/ㅡ/·종성 /ㄹ/)가 모두 베트남어 음운체계에 없거나 다르게 실현되는 소리에 국한된다. 따라서 장애가 아니라 모국어 영향에 따른 언어 차이로 판단한다.\",\"w\":{\"1\":\"베트남어 산출이 정상이므로 두 언어 모두에서 치료가 필요한 장애라는 판단은 근거가 없다.\",\"3\":\"오류가 특정 소리에 일관되게 나타나고 모국어 체계로 설명되므로 비일관적 음운장애가 아니다.\",\"4\":\"모국어 사용 중단은 근거가 없으며 오히려 언어 발달과 가족 의사소통에 해롭다.\",\"5\":\"모색행동·운율 이상 등 말실행증 징후가 없고 모국어 산출이 정상이므로 말운동 평가를 추가할 근거가 없다.\"}},\"1-2-2-20\":{\"w\":{\"1\":\"명료도는 자음정확도와 관련은 있으나 청자·문맥 요인이 반영되는 별개의 지표이므로 따로 측정해야 한다.\",\"2\":\"어머니는 친숙한 청자로서 명료도를 과대평가하기 쉬우므로 가장 신뢰할 만한 지표로 볼 수 없다.\",\"3\":\"척도 평정(4점)과 낱말확인 백분율은 측정 방법이 다른 자료라 평균할 수 없으며, 약 70%라는 값은 두 결과를 혼합한 오류이다.\",\"4\":\"낱말확인 과제는 문맥 단서가 없어 오히려 순수한 말 신호의 명료도를 보여 주는 객관적 방법이다.\"}},\"1-2-2-21\":{\"p\":\"치료 효과를 성숙·자연 회복과 구분하려면 단일대상 연구의 논리에 따라 안정된 기초선을 확보하고, 훈련 음소(/ㄱ/)와 훈련하지 않은 통제 음소(/ㅅ/)를 탐침으로 반복 측정해야 한다. 훈련 음소의 급격한 향상과 통제 음소의 완만한 변화를 비교하면 변화가 중재 시작과 함께 훈련 대상에서만 나타났음을 보여 줄 수 있다.\",\"w\":{\"1\":\"회기 내 목표음 자료만으로는 비교 대상이 없어 성숙 효과와 치료 효과를 구분할 수 없다.\",\"3\":\"사후 표준화 검사 1회는 변화의 시점과 원인을 보여 주지 못해 인과 추론이 불가능하다.\",\"4\":\"기초선 1회 측정은 안정성을 확인할 수 없어 사전-사후 비교만으로는 성숙 효과를 배제하지 못한다.\",\"5\":\"부모 만족도와 가정 관찰 보고는 주관적 자료로 치료 효과를 실험적으로 입증하지 못한다.\"}},\"1-2-2-22\":{\"w\":{\"1\":\"이 아동은 초성이 대부분 정확하므로 초성 조음 위치 대조는 핵심 문제가 아니다.\",\"2\":\"4세 9개월에 종성 전면 생략은 이미 지연된 것이며 명료도 영향이 커서 목표 보류는 부적절하다.\",\"3\":\"종성 산출의 문제는 턱 근력이 아니라 음절구조 표상의 문제이며 비구어 구강운동은 근거가 부족하다.\",\"5\":\"종성 없는 낱말만 사용하면 가장 시급한 종성생략 문제를 다루지 못한다.\"}},\"1-2-2-23\":{\"p\":\"표준화 낱말 검사는 단일 낱말 정확도만 측정하므로 연결발화에서 나타나는 동시조음, 빠른 말속도, 발화 길이에 따른 붕괴를 놓칠 수 있다. 이 아동은 낱말 검사 88%(정상 범위)와 달리 대화 자음정확도 64%, 종성·어중초성 생략, 부모·교사의 명료도 문제 보고가 일치한다. 임상 결정은 여러 자료를 통합해 내려야 하므로 치료 대상으로 판정하고 연결발화 수준의 목표를 세운다.\",\"w\":{\"1\":\"표준화 점수 하나만으로 판정하면 자발화·명료도에서 드러난 실제 의사소통 문제를 놓친다.\",\"2\":\"부모·교사 보고는 일상 명료도를 반영하는 중요한 자료로, 자발화 분석 결과와도 일치하므로 배제할 이유가 없다.\",\"4\":\"다른 낱말 검사를 반복해도 단일 낱말 과제의 한계는 같아 연결발화 문제를 확인하지 못한다.\",\"5\":\"발화 길이에 따른 오류 증가는 말 산출 부담과 관련된 것으로 음운인식 결함이나 읽기 중재의 근거가 아니다.\"}},\"1-2-2-24\":{\"w\":{\"2\":\"0.625는 5 ÷ 8로, 정확히 산출한 종성 /ㅇ/의 자음 점수를 빠뜨린 값이다.\",\"3\":\"0.80은 목표 PMLU나 아동 PMLU 산출 규칙을 잘못 적용한 값으로, 정확한 산출식(6 ÷ 8)과 맞지 않는다.\",\"4\":\"0.875는 7 ÷ 8로, 아동의 [ㅌ](어두)을 목표 /ㅌ/과 같은 자음으로 잘못 인정하는 등 오류 자음 하나를 정확으로 계산한 값이다.\",\"5\":\"1.0은 분절음 수만 비교(5 ÷ 5)하고 자음 정확도 점수를 반영하지 않은 값이다.\"}},\"1-2-2-25\":{\"p\":\"요구하기는 한 번 습득되면 중재를 철회해도 사라지지 않는 비가역적 행동이고, 습득된 기술을 되돌리는 것은 윤리적으로 부적절하다. 대상자 간 중다기초선 설계는 여러 대상에게 시차를 두고 중재를 도입해 중재가 시작된 대상에서만 변화가 나타남을 보이므로, 철회 없이 실험적 통제를 입증할 수 있다. 대상 아동이 3명이라는 조건도 이 설계에 부합한다.\",\"w\":{\"2\":\"ABAB 설계는 중재를 철회해 기초선 수준으로의 복귀를 보여야 하므로 비가역적 행동과 윤리적 제약이 있는 이 상황에 부적합하다.\",\"3\":\"교대중재 설계는 둘 이상의 중재 효과를 비교할 때 사용하는데 이 사례는 한 가지 중재만 적용한다.\",\"4\":\"AB 설계는 반복 입증이 없어 실험적 통제를 확보하지 못하므로 효과를 입증하기에 부족하다.\",\"5\":\"기준변경 설계는 이미 레퍼토리에 있는 행동의 수준을 단계적으로 높일 때 사용하는 설계이다.\"}},\"1-2-2-26\":{\"w\":{\"1\":\"62.5%는 5/8로, 기초선 최고점을 초과하는 중재기 자료점 수를 잘못 센 값이다.\",\"2\":\"75.0%는 6/8로, 초과 자료점 7개 중 하나를 누락하는 등 비교 기준을 잘못 적용한 값이다.\",\"3\":\"100%는 기초선 최저점(20)이나 평균을 기준으로 삼아 중재기 모든 자료점을 비중복으로 계산한 값이다.\",\"5\":\"50.0%는 4/8로, 기초선 최고점 35가 아닌 더 높은 값을 기준으로 삼은 결과이다.\"}},\"1-2-2-27\":{\"w\":{\"1\":\"15%는 9 ÷ 60으로 불일치율을 계산한 값이며, 이를 근거로 재분석하는 판단도 틀렸다.\",\"2\":\"51%는 일치 발화 수(51개)를 백분율로 착각한 값이다.\",\"4\":\"일치율 계산은 맞으나 80% 이상이면 일반적으로 수용 가능하므로 90%에 못 미친다고 자료를 폐기하는 것은 과도한 조치이다.\",\"5\":\"567%는 51 ÷ 9로 일치 수를 불일치 수로 나눈 값이며 일치율 산출식이 아니다.\"}},\"1-2-2-28\":{\"w\":{\"2\":\"표현어휘 94가 수용어휘 76보다 높으므로 표현어휘가 더 낮다는 해석은 수치상 틀렸다.\",\"3\":\"76은 −1.6SD로 −1SD 이내가 아니며 지체 범위에 해당한다.\",\"4\":\"수용어휘 76은 정상 범위를 벗어나므로 두 영역 모두 정상이라는 판단은 틀렸다.\",\"5\":\"18점 차이는 1SD 이상으로 측정 오차 범위로 보기 어렵다.\"}},\"1-2-2-29\":{\"w\":{\"1\":\"치료 기회 확대라는 명분이 있어도 치료사 개인의 경제적 이익이 개입된 유인은 이해상충으로 윤리적 문제가 된다.\",\"2\":\"사후 보고로는 이미 발생한 이해상충과 환자 유인 행위가 해소되지 않는다.\",\"3\":\"이 사례의 핵심 쟁점은 비밀유지가 아니라 이해상충이므로 보호자 동의 여부로 허용되지 않는다.\",\"4\":\"자신의 센터로 유인하는 것은 전문성 유지 의무와 무관하며 이해상충에 해당한다.\"}},\"1-2-2-30\":{\"p\":\"반복되는 새로운 멍, 아동의 피해 진술, 보호자의 설명 불일치는 아동학대를 의심할 만한 정황이며, 아동학대는 의심만으로도 즉시 신고해야 한다. 언어재활사 등 재활·복지·의료기관 종사자는 신고의무자이므로 지체 없이 112에 신고하고, 관찰한 신체 소견과 아동의 말을 해석 없이 객관적으로 기록해 두어야 한다.\",\"w\":{\"1\":\"확증을 기다리며 신고를 미루면 아동이 추가 피해에 노출되며, 신고의무는 의심 단계에서 발생한다.\",\"2\":\"보호자에게 먼저 따져 물으면 증거 인멸이나 아동에 대한 보복 등 위험이 커지며, 인정 여부는 신고 요건이 아니다.\",\"3\":\"기관 내 보고는 수사기관 신고를 대신하지 못하므로 신고 의무를 다한 것이 아니다.\",\"5\":\"아동에게 반복 질문하면 2차 피해와 진술 오염을 초래하며, 진술 확보는 전문 조사기관의 역할이다.\"}},\"1-2-2-31\":{\"w\":{\"1\":\"보호자의 선호만 따르고 연구 근거와 임상 전문성을 배제한 대응으로 EBP에 어긋난다.\",\"2\":\"가족의 가치와 선호를 배제하는 것은 EBP의 세 요소 중 하나를 무시한 것이다.\",\"4\":\"근거 없는 요구가 있다는 이유만으로 종결하는 것은 설명과 공동 의사결정의 기회를 포기한 것이다.\",\"5\":\"개인 임상 경험만으로는 통제된 연구 근거를 대신할 수 없어 EBP의 기준을 충족하지 못한다.\"}},\"1-2-2-32\":{\"p\":\"SOAP에서 S(주관적)는 보호자·대상자의 보고, O(객관적)는 측정·관찰된 수행 자료, A(평가)는 자료에 대한 임상적 해석과 진전 판단, P(계획)는 이후 회기 계획이다. 어머니의 보고(㉠)는 S, 20개 중 14개(70%) 등 수치 자료(㉡)는 O, 지난 회기 대비 향상과 준거 미달 판단(㉢)은 A, 시간지연·놀이 상황 확장 계획(㉣)은 P에 해당한다.\",\"w\":{\"1\":\"어머니의 보고(㉠)는 관찰 자료가 아닌 주관적 정보이고, 수치 자료(㉡)는 객관적 자료이므로 ㉠ O, ㉡ S는 틀렸다.\",\"2\":\"수치 수행 자료(㉡)를 평가(A)로, 진전 판단(㉢)을 객관적 자료(O)로 분류하여 틀렸다.\",\"4\":\"보호자 보고(㉠)를 평가(A)로, 진전 판단(㉢)을 계획(P)으로, 다음 회기 계획(㉣)을 주관적 정보(S)로 잘못 분류하였다.\",\"5\":\"진전 판단(㉢)은 평가(A)이고 다음 회기 계획(㉣)은 계획(P)인데 둘을 서로 바꾸어 분류하였다.\"}},\"1-2-2-33\":{\"p\":\"모델 제공 조건에서 정반응률 95%로 반응은 습득되었으나 자발 산출이 거의 없는 것은 촉진 의존 상태이다. 시간지연 절차는 자극 제시 후 모델 제공까지의 대기 시간을 0초에서 2초, 4초로 점차 늘려 아동이 모델 전에 스스로 반응할 기회를 주며, 오류를 최소화하면서 자극 통제를 촉진에서 자연 자극으로 옮긴다.\",\"w\":{\"1\":\"완전 구어 모델을 계속 제공하면 촉진 의존이 유지되어 자발 산출로 이행하지 못한다.\",\"3\":\"신체적 촉진을 추가해 촉진 강도를 높이면 오히려 의존이 강화된다.\",\"4\":\"촉진을 한꺼번에 제거하면 오반응이 급증하고, 오반응을 무시하는 것은 체계적 촉진 소거가 아니다.\",\"5\":\"같은 자극을 반복 제시하는 것은 촉진 소거 원리에 해당하지 않으며 자발 산출을 유도하지 못한다.\"}},\"1-2-2-34\":{\"p\":\"각 목표를 정해진 기간(3회기) 동안 다루고 준거 도달 여부와 관계없이 다음 목표로 넘어가며 한 바퀴를 돈 뒤 첫 목표로 돌아오는 방식은 주기적(cyclical) 목표 공격 전략이다. 이는 여러 언어 형태가 한 번에 하나씩 완성되기보다 동시에 점진적으로 발달한다는 자연 습득 원리를 반영한다.\",\"w\":{\"2\":\"수직적 접근은 한 목표를 준거에 도달할 때까지 훈련한 뒤 다음으로 넘어가므로 준거와 무관하게 순환하는 이 계획과 다르다.\",\"3\":\"수평적 접근은 한 회기 안에서 여러 목표를 동시에 다루는 방식으로, 목표를 회기 단위로 번갈아 순환하는 이 계획과 다르다.\",\"4\":\"발달 순서대로 한 목표씩 준거까지 훈련하는 것은 수직적 성격의 계획으로 이 사례의 순환 방식과 맞지 않는다.\",\"5\":\"아동의 선호에 따라 목표를 고르는 선택적 접근은 표준적인 목표 공격 전략이 아니며 이 계획의 특징도 아니다.\"}},\"1-2-2-35\":{\"w\":{\"1\":\"낱말 수준 준거만 충족했고 일상 대화로 전이되지 않았으므로 즉시 종결은 시기상조이다.\",\"2\":\"낱말 수준은 이미 90% 이상 도달했으므로 처음부터 반복하는 것은 현재 문제인 일반화를 다루지 못한다.\",\"3\":\"일반화는 자연히 일어나지 않는 경우가 많아 계획적으로 프로그래밍해야 하며, 기다리기만 하면 오류가 고착될 수 있다.\",\"4\":\"/ㅅ/의 일반화가 완료되지 않은 상태에서 목표를 바꾸면 현재의 문제를 방치하게 된다.\"}},\"1-2-2-36\":{\"p\":\"또래에게 먼저 의사소통을 시작하는 행동은 시작과 끝이 분명한 이산 행동이며, 30분 동안 2~5회로 낮은 빈도로 나타난다. 이런 행동은 관찰 시간 중 발생 횟수를 세는 사건(빈도) 기록법이 가장 적합하며, 관찰 시간이 달라질 경우 분당 비율로 환산해 비교한다.\",\"w\":{\"1\":\"지속시간 기록법은 행동이 얼마나 오래 지속되는지가 목표일 때 사용하며, 시작하기의 횟수 변화를 반영하지 못한다.\",\"2\":\"영속적 산물 기록법은 활동 후 결과물이 남는 행동에 쓰며 의사소통 시작은 물리적 산물을 남기지 않는다.\",\"3\":\"부분간격 기록법은 고빈도이거나 시작과 끝이 불분명한 행동에 적합하며 저빈도 이산 행동의 실제 횟수를 왜곡할 수 있다.\",\"4\":\"지연시간 기록법은 지시 후 반응까지의 시간을 재는 방법인데 이 목표는 지시에 대한 반응이 아닌 자발적 시작이다.\"}},\"1-2-2-37\":{\"p\":\"치료실에서는 목표 문장을 잘 산출하지만 교실에서 사용하지 않는 일반화 문제와, 교사가 지원 방법을 모르는 상황이 핵심이다. 교실 기반 협력 모형은 실제 수업 맥락에서 목표를 다루고 교사를 코칭하여 교실에서의 의사소통 지원 역량을 높이므로 두 문제를 동시에 해결한다.\",\"w\":{\"1\":\"분리 치료 회기를 늘려도 치료실 밖으로의 일반화 문제는 해결되지 않는다.\",\"2\":\"보고서 전달만으로는 교사가 교실에서 구체적으로 지원하는 방법을 익히기 어렵다.\",\"3\":\"교과 학습지 풀이는 언어재활의 의사소통 목표가 아니며 교실 일반화에도 도움이 되지 않는다.\",\"5\":\"전일 특수학급 배치는 최소제한환경 원칙에 어긋나고 통합학급에서의 일반화 문제를 해결하지 못한다.\"}},\"1-2-2-38\":{\"p\":\"원격치료 전에는 대상자의 적합성(주의집중, 청각 환경, 기기 조작)을 평가하고(ㄱ), 보호자를 현장 보조자(e-helper)로 교육하며(ㄴ), 보안 플랫폼 사용과 녹화 사전 동의로 개인정보를 보호해야 한다(ㄷ). 원격치료에도 대면치료와 동일한 자격·윤리·서비스 질 기준이 적용되므로 ㄹ은 틀렸다. 따라서 ㄱ, ㄴ, ㄷ이 옳다.\",\"w\":{\"1\":\"ㄷ의 보안 플랫폼 사용과 녹화 동의는 원격치료의 필수 고려사항인데 누락되었다.\",\"3\":\"ㄹ은 틀린 진술이며 필수 사항인 ㄱ, ㄷ이 빠졌다.\",\"4\":\"원격치료에서 자격·윤리 기준이 완화된다는 ㄹ은 틀렸고 보조자 교육(ㄴ)이 빠졌다.\",\"5\":\"ㄹ은 틀린 진술이므로 모두 고른 조합은 옳지 않다.\"}},\"1-2-2-39\":{\"w\":{\"1\":\"감정이 고조된 상태에서 점수표로 논증하면 보호자의 방어가 더 강해진다.\",\"2\":\"진단 결과 설명을 생략하는 것은 보호자의 알 권리를 침해하고 이후 중재 결정을 어렵게 한다.\",\"3\":\"부정은 정상적인 반응이며 협조 거부로 보고 상담을 종료하면 라포 형성과 중재 기회를 잃는다.\",\"4\":\"경고성 발언은 죄책감과 방어를 자극하여 상담 관계를 악화시킨다.\"}},\"1-2-2-40\":{\"w\":{\"1\":\"진단 없이 음성치료를 시작하면 치료가 필요한 병변을 놓칠 수 있어 의뢰 원칙에 어긋난다.\",\"2\":\"3개월 이상 지속된 음성 문제를 경과 관찰만 하면 병변 발견이 늦어질 수 있다.\",\"3\":\"음성 문제를 조음치료로 대체하는 것은 문제의 성격과 맞지 않는 부적절한 중재이다.\",\"5\":\"약물 구입 안내는 언어재활사의 업무 범위를 벗어나며 원인 진단을 대신하지 못한다.\"}},\"1-2-2-41\":{\"p\":\"여러 전문가가 함께 관찰하는 아레나 평가, 한 명의 주 서비스 제공자가 다른 전문가에게서 훈련받은 전략을 대신 실행하는 역할방출(role release), 가정 일과 속 통합 중재는 초학문적 팀 모형의 핵심 특징이다. 이 모형은 가족이 만나는 전문가 수를 줄여 가족 부담을 낮춘다.\",\"w\":{\"1\":\"다학문적 팀은 각 전문가가 독립적으로 평가·중재하므로 공동 평가와 주 서비스 제공자 구조가 있는 이 사례와 다르다.\",\"3\":\"공동 평가와 역할방출은 다학문적 팀이 아니라 초학문적 팀의 특징이다.\",\"4\":\"간학문적 팀은 중재를 각 전문가가 따로 실행하는데 이 사례는 한 전문가가 통합적으로 실행한다.\",\"5\":\"이 사례에서 언어재활사는 평가에 함께 참여하고 전략을 훈련해 주므로 자문만 하는 구조가 아니다.\"}},\"1-2-2-42\":{\"w\":{\"2\":\"표준점수 등 수치 결과도 개인정보이므로 진단명만 뺀다고 동의 없이 제공할 수 있는 것은 아니다.\",\"3\":\"기관 공문은 정보주체의 동의를 대신하지 못한다.\",\"4\":\"사후 통보는 동의 없는 제3자 제공에 해당하여 비밀유지 의무 위반이다.\",\"5\":\"교육 목적이라도 보호자 동의 없는 제공은 허용되지 않으며, 전화로 제공하면 신원 확인도 어렵다.\"}},\"1-2-2-43\":{\"w\":{\"1\":\"자격증 대여는 보수교육 이수로 갈음되는 경미한 위반이 아니라 자격 취소 사유이다.\",\"2\":\"자격증 대여는 1회 위반이라도 경고로 그치지 않고 자격 취소 사유에 해당한다.\",\"4\":\"자격정지가 아니라 자격 취소 사유이므로 처분 범위를 잘못 제시하였다.\",\"5\":\"자격증을 대여한 원장 본인이 처분 대상이며 대여받은 직원도 함께 처벌 대상이 된다.\"}},\"1-2-2-44\":{\"w\":{\"1\":\"주 1회 방문도 어려운 가족에게 주 3회 방문은 실현 가능성이 낮고 가정 일과로의 일반화도 보장하지 못한다.\",\"3\":\"이해력이 정상이라도 표현 지연 아동을 무중재로 기다리면 모니터링과 촉진의 기회를 놓친다.\",\"4\":\"어린이집 등원만으로는 구조화된 언어촉진과 진전 점검이 이루어지지 않는다.\",\"5\":\"학습지 방식의 낱말 카드 학습은 영아의 자연스러운 상호작용 기반 언어 습득 원리에 맞지 않는다.\"}},\"1-2-2-45\":{\"w\":{\"1\":\"재신경화 징후가 있어 회복 가능성이 있으므로 비가역적인 영구 갑상성형술을 즉시 시행하는 것은 시기상조이다.\",\"2\":\"절대 음성휴식은 성문폐쇄부전 회복에 도움이 되지 않으며 보상적 발성을 학습할 기회를 잃게 한다.\",\"3\":\"보툴리눔 독소는 이미 마비된 성대의 내전을 더 약화시켜 성문틈과 흡인 위험을 악화시킨다.\",\"5\":\"재신경화 징후는 회복 가능성을 시사하는 예후 인자이며, 이를 무시하고 즉시 신경 재건술을 시행할 근거가 없다.\"}},\"1-2-2-46\":{\"w\":{\"2\":\"성대낭종은 대개 편측·국소적 점막하 병변으로 양측 전장의 광범위한 부종과 다르며, 원인 관리 없이 즉시 수술하는 것도 부적절하다.\",\"3\":\"진단은 맞으나 라인케부종은 점막 고유층의 액체 저류이므로 음도 훈련만으로 병변이 회복되지 않는다.\",\"4\":\"성대결절은 전1/3과 중1/3 경계의 국소적 대칭 병변으로, 전장에 걸친 광범위 부종과 다르다.\",\"5\":\"재발성 후두유두종은 사마귀 모양의 다발성 병변으로, 반투명 물주머니 모양 부종과 소견이 다르다.\"}},\"1-2-2-47\":{\"w\":{\"1\":\"스트로보스코피에서 명확한 구조적 병변이 확인되므로 심인성 음성장애로 볼 근거가 없다.\",\"2\":\"결절은 양측·대칭성이고 점막파동이 보존되며 음성치료에 반응하므로, 편측 병변이 치료에 반응하지 않는 이 사례와 다르다.\",\"3\":\"점막 아래 둥근 백색 병변과 점막파동 소실은 폴립보다 낭종의 소견이며, 약물 처방 안내는 언어재활사의 역할도 아니다.\",\"5\":\"우측은 반응성 부종으로 음성치료에 반응해 감소하고 있으므로 양측 동시 절제는 반흔·유착 위험만 높인다.\"}},\"1-2-2-48\":{\"w\":{\"1\":\"12반음은 주파수 비가 2배인 1옥타브에 해당하며, 이 대상자의 주파수 비는 4배이다.\",\"2\":\"18반음은 1.5옥타브로 주파수 비 약 2.83배에 해당하여 4배 비율과 맞지 않는다.\",\"3\":\"36반음은 3옥타브(주파수 비 8배)에 해당하는 값이다.\",\"4\":\"30반음은 2.5옥타브(주파수 비 약 5.66배)에 해당하는 값으로 계산이 틀렸다.\"}},\"1-2-2-49\":{\"w\":{\"1\":\"175 mL/s는 3,500 ÷ 20 s에 해당하는 값으로 MPT 7초로 계산하면 나올 수 없다.\",\"2\":\"250 mL/s는 3,500 ÷ 14 s의 값이며, 과내전은 호기류를 줄여 PQ를 낮추는 방향이다.\",\"3\":\"350 mL/s는 3,500 ÷ 10 s의 값으로 계산이 틀렸고 정상 범위(대략 120~200 mL/s)도 아니다.\",\"4\":\"수치는 맞으나 성대 과내전은 호기류가 줄어 PQ가 낮아지는 방향이므로 해석이 반대이다.\"}},\"1-2-2-50\":{\"w\":{\"1\":\"근긴장성 발성장애는 촉진 압통·후두 상승이 있고 음성치료에 반응하는데 이 사례는 둘 다 해당하지 않는다.\",\"2\":\"심인성 발성장애는 급성 발병과 정서적 사건 연관이 특징이며, 서서히 진행하고 음소 환경 특이적인 이 사례와 다르다.\",\"4\":\"본태성 음성진전은 규칙적인 율동성 떨림이 특징이며, 모음 시작 낱말에 국한된 불규칙 끊김과 다르다.\",\"5\":\"외전형은 무성자음 환경에서 기식성 끊김을 보이며 후윤상피열근이 표적인데, 이 사례는 모음 시작 낱말의 쥐어짜는 끊김이다.\"}},\"1-2-2-51\":{\"w\":{\"1\":\"내전형은 모음 시작 낱말에서 쥐어짜는 끊김을 보이며, 무성자음 환경의 기식성 끊김과 다르다.\",\"2\":\"외측윤상피열근은 내전근이며, 이 환자는 내전형이 아니라 외전형이다.\",\"4\":\"진단은 맞으나 갑상피열근은 내전근으로 내전형의 표적이며 외전형의 표적은 후윤상피열근이다.\",\"5\":\"근긴장성 발성장애는 특정 음소 환경에 국한된 끊김을 보이지 않으며, 윤상갑상근 이완 훈련은 보툴리눔 독소 표적이 아니다.\"}},\"1-2-2-52\":{\"w\":{\"1\":\"성대주입술은 성문을 더 좁혀 기도 폐쇄를 악화시키므로 금기이다.\",\"3\":\"밀기 접근법은 성대 내전을 강화해 이미 좁은 기도를 더 좁히므로 금기이다.\",\"4\":\"갑상성형술로 성대를 내측화하면 기도가 더 좁아져 호흡곤란이 악화된다.\",\"5\":\"보툴리눔 독소는 근긴장이상에 쓰는 것으로 마비된 성대의 위치를 바꾸어 성문을 넓히지 못한다.\"}},\"1-2-2-53\":{\"w\":{\"1\":\"발성이 되지 않고 공기가 저류되었으므로 검사를 통과한 것이 아니다.\",\"2\":\"공기주입검사는 PE분절의 진동 가능성을 보는 검사로 폐기능과 직접 관련이 없다.\",\"3\":\"TEP가 당장 어렵더라도 전기후두 등 대안 발성법은 여전히 사용할 수 있다.\",\"4\":\"저긴장 PE분절은 소리가 약하고 낮으며 젖은 음질로 나오는 양상으로, 조임감과 공기 저류를 보이는 이 결과와 반대이다.\"}},\"1-2-2-54\":{\"w\":{\"1\":\"원인 행동을 바꾸지 않은 수술은 재발 위험이 크고 아동 후두에 반흔을 남길 수 있어 일차 치료가 아니다.\",\"2\":\"절대 음성휴식은 아동에게 현실적으로 불가능하고 근본 원인인 발성 습관을 바꾸지 못한다.\",\"4\":\"속삭이기는 오히려 후두 긴장을 높여 성대 부담을 줄이지 못한다.\",\"5\":\"음성위생 교육만으로는 이미 형성된 습관적 발성 패턴을 바꾸기 어렵다.\"}},\"1-2-2-55\":{\"w\":{\"1\":\"근긴장성 발성장애의 촉진 소견은 제시되지 않았고, 역류를 시사하는 지표와 내시경 소견을 설명하지 못한다.\",\"3\":\"LPR은 속쓰림 없이 나타나는 경우가 많으므로 속쓰림이 없다는 이유로 역류를 배제할 수 없다.\",\"4\":\"내시경에서 결절 소견이 없으며 후두 후방의 발적·비후는 역류 소견이다.\",\"5\":\"알레르기를 시사하는 근거가 없고 RSI·RFS와 후두 후방 소견은 역류를 가리킨다.\"}},\"1-2-2-56\":{\"w\":{\"2\":\"워밍업은 편안한 음도에서 모음을 부드럽게 최대한 길게 연장하는 단계이며, 최고 음도의 강한 스타카토는 VFE 원리에 반한다.\",\"3\":\"VFE는 4단계를 각 2회씩 하루 2번 실시하는 프로토콜이다.\",\"4\":\"내전력 강화 단계도 부드러운 모음 연장으로 수행하며, 최대 강도로 고함치는 것은 성대에 충격을 준다.\",\"5\":\"스트레칭과 수축 단계는 부드러운 상행·하행 활음으로 구성되며 큰 소리 스타카토가 아니다.\"}},\"1-2-2-57\":{\"w\":{\"1\":\"악센트 기법은 복식호흡 리듬에 맞춘 강세 발성이 핵심이며 전방 공명 진동감을 중심으로 하지 않는다.\",\"2\":\"신뢰음성은 수술 직후 등 일시적 보호 목적의 작고 약간 기식적인 발성으로, 큰 소리를 요구하는 이 지시와 다르다.\",\"4\":\"밀기 접근법은 성문폐쇄부전 환자의 내전을 강화하는 기법으로, 성대결절 후 과기능 경향이 있는 환자에게 맞지 않는다.\",\"5\":\"챈트 말하기는 단조로운 연속 발성으로 긴장을 낮추는 기법이며 전방 진동감과 쉬운 큰 소리를 강조하지 않는다.\"}},\"1-2-2-58\":{\"w\":{\"1\":\"수술 직후 큰 소리 발성은 치유 중인 점막에 출혈과 반흔을 유발한다.\",\"2\":\"3개월간의 장기 절대 음성휴식은 근위축과 발성 회피를 초래한다.\",\"3\":\"속삭임은 후두 긴장을 높여 회복기 성대에 오히려 부담을 준다.\",\"5\":\"폴립의 원인인 음성 남용 습관이 남아 있으면 재발하므로 수술 후 음성치료가 필요하다.\"}},\"1-2-2-59\":{\"w\":{\"2\":\"접촉성 육아종은 원인을 교정하지 않고 재절제하면 다시 재발하므로 재절제는 최후 수단이다.\",\"3\":\"원인은 음성 남용만이 아니라 삽관 손상과 역류가 함께 작용하므로 음성휴식만으로는 부족하다.\",\"4\":\"유두종은 사마귀 모양의 다발성 병변으로, 성대돌기의 단일 육아종성 병변과 다르다.\",\"5\":\"병변 위치는 막성부가 아니라 연골부(성대돌기)이므로 성대결절이 아니다.\"}},\"1-2-2-60\":{\"w\":{\"1\":\"기관지확장제에 반응하지 않고 폐기능이 정상이므로 운동 유발 천식으로 보기 어렵다.\",\"3\":\"증상이 간헐적이고 휴식 시 소실되므로 성대가 고정된 양측 성대마비가 아니다.\",\"4\":\"문제는 흡기 시 기도의 역설적 내전이며 발성 시 연축이 아니므로 연축성발성장애가 아니다.\",\"5\":\"후두연화증은 흡기 시 성문상부 구조가 안으로 말려 들어가는 것으로 주로 영아에서 나타나며, 성대 자체의 내전 소견과 다르다.\"}},\"1-2-2-61\":{\"w\":{\"1\":\"가성대 발성은 낮고 거친 음질과 과긴장을 유발하는 비효율적 발성이므로 강화할 대상이 아니다.\",\"2\":\"기능적 문제에 침습적 처치를 첫 단계로 적용할 근거가 없으며 먼저 행동적 음성치료를 시행한다.\",\"3\":\"밀기 접근법은 내전을 강화해 성문상부 과기능을 더 악화시킨다.\",\"4\":\"가성대 자체에 구조적 이상이 없고 기능적 문제이므로 절제술을 의뢰할 근거가 없다.\"}},\"1-2-2-62\":{\"w\":{\"2\":\"점막파동을 판독할 수 없었던 것은 동기화 실패 때문이며, 관찰되지 않았다는 것을 반흔의 증거로 확진할 수 없다.\",\"3\":\"원인은 마이크 위치가 아니라 음성 신호 자체의 비주기성이므로 위치 조정으로 해결되지 않는다.\",\"4\":\"강도를 높여도 비주기성이 해소된다는 근거가 없고, 무리한 발성은 평가를 왜곡할 수 있다.\",\"5\":\"전기성문파형검사는 성대 접촉 면적 변화를 간접 측정할 뿐 점막파동을 직접 시각화하지 못한다.\"}},\"1-2-2-63\":{\"w\":{\"2\":\"F0 표준편차는 음도 변동을 반영할 뿐 기식성 음질의 중증도 지표가 아니며 역시 주기 검출에 의존한다.\",\"3\":\"NHR도 주기 검출을 전제로 하므로 비주기적 신호에서는 신뢰할 수 없다.\",\"4\":\"비주기 신호에서 jitter는 원리적으로 신뢰할 수 없으므로 반복 측정해 평균해도 타당한 값이 되지 않는다.\",\"5\":\"MPT는 공기역학적 지표로 음질의 음향적 중증도를 대체하지 못한다.\"}},\"1-2-2-64\":{\"w\":{\"1\":\"편측 성대마비는 호기류 증가와 성문하압 저하의 반대 양상을 보이며, 이 사례는 내시경상 병변이 없다.\",\"2\":\"연축성발성장애는 과제 특이적·불규칙 연축이 특징이며 촉진 소견이 정상인데 이 사례는 촉진 압통이 뚜렷하다.\",\"4\":\"심인성 실성증은 소리를 내지 못하는 상태로, 발성은 가능하나 과긴장을 보이는 이 사례와 다르다.\",\"5\":\"내시경에서 병변이 없으므로 라인케부종이 아니다.\"}},\"1-2-2-65\":{\"w\":{\"1\":\"천식 약을 환자 임의로 즉시 중단하게 하는 것은 천식 악화 위험이 있고 언어재활사의 권한 밖이다.\",\"2\":\"백색 반점은 감염성 병변이므로 음성 훈련으로 제거되지 않는다.\",\"3\":\"약물 사용력과 소견으로 칸디다증이 의심되는 상황에서 백반증으로 단정해 조직검사·절제부터 할 이유가 없다.\",\"5\":\"근병증에 의한 활모양은 약물 조정 후 회복되는 경우가 많아 밀기 접근법 집중 훈련은 우선순위가 아니다.\"}},\"1-2-2-66\":{\"w\":{\"1\":\"SOVT도 발성이므로 출혈 부위에 기계적 부하를 주어 급성기에는 금기이다.\",\"3\":\"밀기 접근법은 성대에 강한 충격을 주어 출혈을 악화시키므로 금기이다.\",\"4\":\"큰 소리 발성은 출혈을 확대시키며, 온찜질로 흡수를 촉진한다는 근거도 없다.\",\"5\":\"급성 출혈은 음성휴식으로 흡수되므로 즉시 수술하지 않으며, 수술은 재발성 출혈의 원인인 정맥류에 대해 고려한다.\"}},\"1-2-2-67\":{\"w\":{\"1\":\"내전형 연축성발성장애는 모음 시작 낱말 등 과제 특이적인 불규칙 끊김이 핵심이고 속삭임에서 감소하는데 이 사례는 그렇지 않다.\",\"3\":\"파킨슨병은 단조롭고 약한 음성과 안정 시 진전이 특징이며 규칙적인 음성 떨림이 핵심 증상이 아니다.\",\"4\":\"근긴장성 발성장애는 과긴장에 의한 음질 문제로, 규칙적 율동성 떨림과 손 떨림을 설명하지 못한다.\",\"5\":\"서서히 진행하는 규칙적 떨림과 손 떨림 동반은 신경학적 원인을 시사하므로 심인성으로 볼 근거가 없다.\"}},\"1-2-2-68\":{\"w\":{\"1\":\"커프가 팽창된 상태에서 밸브를 부착하면 호기가 빠져나가지 못해 공기가 갇히는 매우 위험한 상황이 된다.\",\"2\":\"상기도가 폐쇄되어 있으면 호기가 나갈 길이 없어 질식 위험이 있으므로 밸브 사용의 금기이다.\",\"3\":\"수면 중 착용은 일반적으로 금지되며, 처음부터 장시간 착용하지 않고 짧은 시간부터 점진적으로 늘린다.\",\"5\":\"과다한 분비물은 밸브 막힘과 흡인 위험을 높이므로 오히려 금기 요인이다.\"}},\"1-3-1-1\":{\"w\":{\"1\":\"괄호 안 합계의 변화량(29.5 − 22 = 7.5)만 구하고 마지막 ×2를 빠뜨렸을 때 나오는 값이다.\",\"2\":\"공식대로 계산한 치료 전 44.0점, 치료 후 59.0점의 차이인 15.0점과 맞지 않는다. 하위검사별 환산(÷20, ÷10)을 정확히 적용하면 이 값은 나오지 않는다.\",\"4\":\"실제 변화량 15.0점보다 크게 계산된 값으로, 하위검사 환산이나 합산 과정에서 오류가 생긴 결과이다.\",\"5\":\"올바른 변화량 15.0점에 ×2를 한 번 더 적용한 오류에서 나오는 값이다.\"}},\"1-3-1-2\":{\"w\":{\"1\":\"두 지표의 값을 서로 뒤바꾼 것이다. 60은 %CIU(90 ÷ 150 × 100), 45는 분당 CIU(90 ÷ 2)에 해당한다.\",\"3\":\"%CIU 60은 맞지만 분당 CIU 90개는 CIU 수를 발화 시간 2분으로 나누지 않은 값이다.\",\"4\":\"분당 CIU 45개는 맞지만 %CIU 75는 틀렸다. 75는 총 낱말 수를 발화 시간으로 나눈 분당 낱말 수(150 ÷ 2)이다.\",\"5\":\"분당 CIU 75개는 분당 낱말 수(WPM, 150 ÷ 2)와 혼동한 값이며, %CIU 40도 90 ÷ 150 × 100 = 60%와 맞지 않는다.\"}},\"1-3-1-3\":{\"w\":{\"2\":\"조사와 어미를 생략한 전보식 발화는 좌측 하전두회(브로카 영역) 손상에서 나타나는 특성으로, 우반구 후방 병소와 맞지 않는다.\",\"3\":\"음소착어와 선택적인 따라말하기 손상은 좌측 궁상다발 손상에 의한 전도실어증의 특성이다.\",\"4\":\"근력 저하 없는 조음 모색행동과 비교적 유창한 자동구어는 좌측 전운동영역·뇌섬엽 손상에 의한 말실행증의 특성이다.\",\"5\":\"글자를 하나씩 짚어 읽고 자신이 쓴 글을 다시 읽지 못하는 것은 좌측 후두엽·뇌량 팽대 손상에 의한 순수실독증의 특성이다.\"}},\"1-3-1-4\":{\"w\":{\"1\":\"전반실어증은 따라말하기도 심하게 손상되는데, 이 환자는 따라말하기가 82/100(8.2)으로 보존되어 있다.\",\"2\":\"브로카실어증은 비유창하지만 청각적 이해가 비교적 양호하고 따라말하기도 손상되는데, 이 환자는 알아듣기 3.2로 심하게 저하되고 따라말하기는 보존되어 있다.\",\"3\":\"베르니케실어증은 유창한 발화와 따라말하기 손상이 특징인데, 이 환자는 유창성 2점의 비유창 발화에 따라말하기가 보존되어 있다.\",\"4\":\"연결피질운동실어증도 따라말하기는 보존되지만 청각적 이해가 비교적 양호하다는 점에서, 알아듣기가 64/200으로 심하게 저하된 이 환자와 맞지 않는다.\"}},\"1-3-1-5\":{\"w\":{\"1\":\"멜로디억양치료는 비유창 실어증 환자의 구어 산출을 유도하는 방법으로, 문장 이해 결함을 표적으로 하지 않는다.\",\"2\":\"의미자질분석은 의미망을 활성화해 이름대기를 개선하는 방법으로, 행위자-대상 역할 할당의 문제를 다루지 못한다.\",\"3\":\"시각동작치료는 전반실어증 환자의 제스처를 통한 의사소통을 목적으로 하며, 가역 문장 이해의 결함과 무관하다.\",\"5\":\"의사소통효과증진법은 다양한 양식을 활용한 기능적 정보 교환 훈련으로, 통사 구조와 의미역의 대응을 직접 훈련하지 않는다.\"}},\"1-3-1-6\":{\"w\":{\"1\":\"쉬운 구조부터 훈련하는 전통적 난이도 위계 원리로, 복잡한 구조를 먼저 훈련한 지문의 계획과 정반대이다.\",\"3\":\"오류 없는 학습의 원리로, 복잡한 구조 훈련이 단순 구조로 일반화된 지문의 현상을 설명하지 못한다.\",\"4\":\"자동구어를 발판으로 명제적 발화를 이끌어 내는 원리로, 문장 구조 간 일반화와는 관계가 없다.\",\"5\":\"우반구의 운율 처리 능력을 활용하는 멜로디억양치료의 원리로, 통사 구조 훈련의 근거가 아니다.\"}},\"1-3-1-7\":{\"w\":{\"2\":\"A는 AMR이 정상이고 SMR에서 순서 오류·모색행동을 보여 실조형이 아니며, B의 느리고 규칙적인 AMR과 쥐어짜는 음성은 말실행증이 아닌 경직형의 특징이다.\",\"3\":\"A는 AMR 속도가 정상이어서 경직형이 아니고, B는 규칙적이어서 실조형이 아니며, C의 불규칙·폭발적 산출은 말실행증이 아닌 실조형의 특징이다.\",\"4\":\"A의 말실행증은 맞지만, B는 규칙적인 AMR·SMR을 보여 실조형이 아니고, C는 불규칙·폭발적 산출을 보여 느리고 약하며 기식 음성·과다비성을 보이는 이완형과 맞지 않는다.\",\"5\":\"A는 AMR이 정상이므로 AMR이 느리고 약한 이완형이 아니며, C의 불규칙하게 변동하는 AMR은 말실행증이 아닌 실조형의 특징이다.\"}},\"1-3-1-8\":{\"p\":\"회기 내 정확도는 90%까지 오르지만 다음 회기에 40%로 떨어지고 훈련하지 않은 낱말로의 전이가 거의 없다는 것은 습득은 되었으나 파지와 전이가 부족하다는 뜻이다. 운동학습 원리(Maas 등)에 따르면 현재 사용 중인 블록 연습과 매 시행 즉각 피드백은 회기 내 수행은 높이지만 파지·전이에는 불리하다. 무작위 연습, 분산 연습, 지연·저빈도의 결과지식(KR) 피드백은 학습자의 내적 오류 탐지와 문제 해결을 촉진하여 장기 파지와 일반화를 향상시킨다. 따라서 낱말을 무작위 순서로 연습하고 피드백을 지연·저빈도로 주도록 조정하는 것이 적절하다.\",\"w\":{\"1\":\"블록 연습을 유지하고 피드백을 더 늘리는 것은 회기 내 수행만 높이고 파지를 저해하는 현재 조건을 더 강화하는 것이다.\",\"2\":\"매 시행 즉각 피드백을 계속 제공하는 것은 지문에서 파지·전이 실패를 낳은 조건을 그대로 유지하는 것이다.\",\"3\":\"한 회기에 시행을 몰아서 하는 집중 연습은 습득 단계의 수행은 높여도 분산 연습에 비해 파지에 불리하다.\",\"4\":\"모든 시행에서 치료사의 모델에 의존하게 하면 회기 내 수행은 높아지지만 학습자가 스스로 오류를 탐지하고 수정할 기회가 줄어 파지에 불리하다.\"}},\"1-3-1-9\":{\"w\":{\"1\":\"리실버만음성치료로 음성 강도를 높이는 것은 파킨슨병에 의한 과소운동형 마비말장애의 중재로, 무도성 불수의 운동을 보이는 이 환자와 맞지 않는다.\",\"2\":\"실조형은 소뇌 손상에 의한 유형으로, 기저핵 퇴행으로 무도증을 보이는 헌팅턴병 환자의 유형이 아니다.\",\"4\":\"경직형은 양측 상부운동신경 손상에 의한 유형으로, 불수의 운동이 말에 침범된 이 환자의 양상과 맞지 않는다.\",\"5\":\"이완형은 근력 저하가 핵심인 유형인데, 이 환자는 근력 저하가 뚜렷하지 않아 저항 운동으로 근력을 강화할 근거가 없다.\"}},\"1-3-1-10\":{\"w\":{\"1\":\"경직형은 양측 상부운동신경 손상에 의한 유형으로, 말을 계속할수록 악화되고 휴식하면 회복되는 피로성 변동이 특징적이지 않다.\",\"2\":\"과소운동형은 기저핵 조절회로 이상에 의한 유형으로, 안검하수와 휴식 후 회복되는 피로성 약화를 설명하지 못한다.\",\"3\":\"실조형은 소뇌와 그 연결 경로 손상에 의한 유형으로, 지속 발화에 따른 과다비성·기식성의 점진적 악화와 회복 양상이 특징이 아니다.\",\"5\":\"편측 상부운동신경형은 일측 피질뇌간로 손상에 의한 유형으로, 피로성 변동이라는 이 환자의 핵심 소견과 맞지 않는다.\"}},\"1-3-1-11\":{\"w\":{\"2\":\"심층실독증은 의미착오 등 의미 경로를 통한 읽기 오류가 특징으로, 글자 하나씩 읽기와 낱말 길이 효과, 보존된 쓰기를 보이는 이 환자와 맞지 않는다.\",\"3\":\"표층실독증은 어휘 경로 손상으로 불규칙어를 소리 나는 대로 읽는 유형으로, 좌측 후대뇌동맥 경색과 우측 동측반맹을 동반한 이 환자의 양상과 다르다.\",\"4\":\"무시실독증은 우측 하두정소엽 손상으로 줄의 왼쪽을 빠뜨리는 읽기 오류로, 좌반구 후대뇌동맥 경색인 이 환자의 병소와 맞지 않는다.\",\"5\":\"각회 손상은 읽기와 쓰기가 모두 손상되는 실독·실서증을 일으키는데, 이 환자는 쓰기가 정상이다.\"}},\"1-3-1-12\":{\"p\":\"규칙어와 불규칙어('닭', '굳이', '넋')는 모두 정확하게 쓰지만 비단어('소딥', '가믄', '누텔')는 쓰지 못하거나 실제 낱말('소득')로 바꾸어 쓴다. 비단어는 음소-자소 변환, 곧 음운 경로를 거쳐야만 쓸 수 있으므로 이 경로가 선택적으로 손상된 것이다. 어휘 경로가 보존되어 불규칙어를 포함한 실제 낱말은 정확히 쓰고, 구체어-추상어 차이가 없으며 베껴 쓰기와 글자 형태도 정상이므로 음운실서증에 해당한다.\",\"w\":{\"1\":\"표층실서증은 어휘 경로가 손상되어 불규칙어를 소리 나는 대로('닭'→'닥') 쓰고 비단어는 잘 쓰는 유형으로, 이 환자와 반대 양상이다.\",\"2\":\"심층실서증은 비단어 쓰기 불가에 더해 의미착오('의자'→'책상')와 구체어-추상어 차이가 나타나는데, 이 환자는 구체어-추상어 차이가 뚜렷하지 않다.\",\"3\":\"실행실서증은 운동 프로그래밍의 문제로 글자 형태가 손상되는 유형인데, 이 환자는 글자 형태가 정상이다.\",\"4\":\"공간실서증은 시공간 처리의 문제로 글자 배열이 손상되는 유형인데, 이 환자는 베껴 쓰기와 글자 형태가 정상이다.\"}},\"1-3-1-13\":{\"p\":\"고혈압·당뇨라는 혈관 위험인자와 두 차례 소혈관 뇌졸중 병력이 있고, 인지 저하가 뇌졸중 시점마다 계단식으로 악화되었다. 처리속도와 실행기능이 초기부터 뚜렷하게 저하되었고, 지연회상은 낮으나 재인 단서를 주면 대부분 회상하므로 저장보다 인출의 결함이다. 보행 불안정과 배뇨 절박 같은 국소 신경학적 징후도 동반되어 혈관성 치매, 특히 피질하 소혈관성 치매의 전형적 특징을 보인다.\",\"w\":{\"1\":\"알츠하이머 치매는 서서히 진행하며 단서를 주어도 회상되지 않는 저장 결함이 특징으로, 계단식 악화와 단서 제공 시 회상 향상을 보이는 이 환자와 맞지 않는다.\",\"2\":\"루이소체 치매는 인지 변동, 시각환각, 파킨슨증이 두드러지는데, 지문에는 이러한 소견이 없다.\",\"4\":\"전두측두치매(특히 행동변이형)는 탈억제·무감동 등 행동 변화가 두드러지는데, 지문에는 행동 변화 대신 뇌졸중과 연관된 계단식 악화가 나타난다.\",\"5\":\"의미치매는 낱말 의미와 사물 지식의 상실이 두드러지는데, 이 환자의 핵심 문제는 처리속도·실행기능 저하와 인출 결함이다.\"}},\"1-3-1-14\":{\"w\":{\"1\":\"조사·어미를 생략하는 실문법증이 이 유형의 핵심 특징이므로 문법형태소 산출은 손상되는 영역이다.\",\"2\":\"모색행동과 비일관적 조음 오류는 말실행증을 시사하므로 조음의 순서화와 프로그래밍은 초기부터 손상되는 영역이다.\",\"3\":\"지문에서 피동문과 관계절이 포함된 문장의 이해가 이미 저하되어 있어 보존되는 능력이 아니다.\",\"5\":\"긴 문장 따라말하기는 통사 처리와 운동 프로그래밍의 부담이 커서 이 유형에서 손상된다.\"}},\"1-3-1-15\":{\"p\":\"수술 전 인지·언어 기능이 정상이었고 고관절 골절 수술 3일째에 급성으로 발병했으며, 밤에 심해지는 혼란과 대화 중 주의가 흐트러졌다 돌아오는 변동, 낮 동안의 졸림이 나타난다. '어제는 멀쩡했는데 오늘은 못 알아본다'는 보호자 보고도 하루 단위의 변동을 보여 준다. 이는 치매가 아닌 섬망의 핵심 특징으로, 감염·약물·대사 이상 등 급성 의학적 원인에 의한 가역적 상태이다. 따라서 언어재활사는 의료진에게 알리고 공식 평가는 원인 교정 후 안정된 상태에서 시행해야 한다.\",\"w\":{\"1\":\"알츠하이머 치매는 서서히 진행하는 질환으로, 수술 직후 급성 발병하고 하루 중 변동하는 이 환자의 양상과 맞지 않으며 기억 훈련을 시작할 시기도 아니다.\",\"3\":\"수술 전 언어 기능이 정상이었고 의식과 주의가 변동하는 상태이므로 베르니케실어증으로 판단할 근거가 없다.\",\"4\":\"주의력이 변동하는 상태에서 얻은 검사 결과는 실어증으로 잘못 해석될 수 있으므로 지금 공식 검사를 실시하는 것은 부적절하다.\",\"5\":\"우반구 손상을 시사하는 병력이 없고, 급성 의학적 원인에 의한 상태에서 대화 훈련을 시작하는 것은 순서가 맞지 않다.\"}},\"1-3-1-16\":{\"w\":{\"2\":\"복잡한 문제 해결 과제는 주의 지속이 수 분에 불과한 혼돈-초조 단계의 환자에게 과부하가 되어 초조를 악화시킨다.\",\"3\":\"긴 표준화 검사 배터리는 주의 지속이 짧고 자극에 과민한 이 시기의 환자에게 초조를 악화시킨다.\",\"4\":\"자극이 많은 그룹 활동은 소음과 낯선 사람에게 공격적으로 반응하는 이 환자의 초조를 악화시킨다.\",\"5\":\"공격 행동이 나타날 때 과제 난이도를 높이면 좌절과 공격성이 더 커진다.\"}},\"1-3-1-17\":{\"w\":{\"1\":\"반복적인 컴퓨터 자극 훈련은 이 환자의 핵심 문제인 계획 부족, 오류 인식 부재, 병식 결여를 직접 다루지 못한다.\",\"2\":\"기억은 비교적 보존되어 있어 외부 기억 보조 도구만 훈련하는 것은 주 표적에서 벗어난다.\",\"4\":\"이 환자에게는 오류를 경험하고 스스로 알아차리는 것 자체가 목표이므로 오류에 노출되지 않게 하는 오류 없는 학습은 적합하지 않다.\",\"5\":\"언어 능력은 비교적 보존되어 있어 통사 구조 훈련은 이 환자의 주 표적이 아니다.\"}},\"1-3-1-18\":{\"p\":\"감정적으로 중립인 문장을 다른 감정의 목소리로 들려주었을 때 감정 판별이 우연 수준이지만, 문장의 언어적 의미 이해는 정상이고 자신의 발화 억양과 감정 표현은 자연스럽다. 즉 감정 운율의 해석만 손상되고 산출은 보존된 수용성(감각성) 감정 운율장애이다. Ross의 모델에 따르면 수용성 감정 운율은 베르니케 영역의 우반구 상동 부위인 우측 측두두정이 담당한다.\",\"w\":{\"1\":\"표현성 감정 운율장애는 우반구 전방 손상으로 단조로운 억양 산출이 문제가 되는 유형인데, 이 환자는 운율 산출이 보존되어 있다.\",\"2\":\"좌측 하전두회 손상은 감정 운율보다 언어적 운율·문법적 강세와 관련되며, 이 환자는 우반구 뇌졸중 환자이다.\",\"3\":\"양측 기저핵 손상은 운율 산출의 단조로움을 일으키는데, 이 환자는 억양이 다양하고 감정 표현이 자연스럽다.\",\"4\":\"좌측 측두두정엽 손상은 감정 운율보다 언어적 운율과 관련되며, 이 환자는 언어적 의미 이해가 정상이다.\"}},\"1-3-1-19\":{\"w\":{\"1\":\"2점은 성대 위에 머문 침습이 배출된 경우로, 조영제가 진성대 아래까지 들어가고 배출 시도도 없는 이 소견과 맞지 않다.\",\"2\":\"3점은 성대 위에 머문 침습이 배출되지 않은 경우로, 진성대 아래로 들어간 흡인인 이 소견보다 낮은 단계이다.\",\"3\":\"5점은 성대에 닿았으나 성대 아래로 들어가지 않은 침습으로, 진성대 아래 기관으로 들어간 이 소견은 흡인 단계에 해당한다.\",\"4\":\"6점은 흡인 후 기도 밖으로 배출된 경우인데, 이 환자는 기침 등 배출 시도가 전혀 없었다.\"}},\"1-3-1-20\":{\"w\":{\"2\":\"마사코 기법은 혀 기저부-인두벽 접촉 문제에 적용하는 방법으로, 후두 거상과 상부식도괄약근 개방 부족을 직접 겨냥하지 않는다.\",\"3\":\"온도촉각자극법은 삼킴 반사 지연이 주된 문제일 때 적용하는 방법으로, 이 환자의 핵심 문제와 맞지 않는다.\",\"4\":\"노력삼킴은 혀 기저부-인두벽 접촉 문제에 적용하는 방법으로, 설골상근 강화를 통한 상부식도괄약근 개방 개선이 목적이 아니다.\",\"5\":\"턱 당기기는 자세 보상 기법으로, 근본적 기능 개선을 원하는 언어재활사의 목적에 맞지 않는다.\"}},\"1-3-1-21\":{\"w\":{\"1\":\"저작 곤란과 음식덩이 형성 실패는 구강기(피질, 하위 뇌신경 V·XII) 문제로, 구강기가 상대적으로 보존되는 외측 연수 경색의 양상과 맞지 않는다.\",\"3\":\"혀의 운동 저하로 구강 측면 고랑에 잔여물이 남는 것은 구강기 문제로, 이 환자에게 예상되는 핵심 소견이 아니다.\",\"4\":\"외측 연수 경색의 핵심은 인두기 삼킴장애이므로 인두기 문제 없이 식도기 정체만 관찰된다는 진술은 옳지 않다.\",\"5\":\"미주신경 손상 시 연구개 약화가 동반되므로 연구개 기능이 정상이라는 진술은 옳지 않다.\"}},\"1-3-1-22\":{\"w\":{\"1\":\"구강 준비기와 식도기를 관찰할 수 있는 것은 VFSS의 장점이며, FEES는 내시경으로 인두·후두를 위에서 내려다보므로 이 단계들을 직접 보지 못한다.\",\"2\":\"FEES는 삼킴 순간 인두 수축으로 화면이 하얗게 가려지는 백색 소실(white-out) 때문에 흡인의 순간을 직접 보지 못한다.\",\"4\":\"조영제를 이용해 음식물 이동 경로를 정량화하는 것은 VFSS의 장점이다.\",\"5\":\"후두 거상과 상부식도괄약근 개방 등 생리적 측정은 VFSS의 장점이다.\"}},\"1-3-1-23\":{\"w\":{\"1\":\"즉시 교정은 지문에서 배우자가 이미 하고 있는 행동으로, 환자의 대화 참여를 위축시키는 원인이 된다.\",\"2\":\"그림과 몸짓 사용을 삼가면 다중 양식 지원이 제한되어 SCA의 능력 드러내기 원리에 어긋나고 환자의 참여를 위축시킨다.\",\"3\":\"글자 쓰기를 막고 구어만 요구하는 것은 다중 양식 사용을 제한하여 환자의 표현 기회를 줄인다.\",\"5\":\"배우자가 대화를 주도하는 것은 지문에서 환자가 대화를 피하게 된 원인과 같으며, 환자의 참여를 더 위축시킨다.\"}},\"1-3-1-24\":{\"w\":{\"1\":\"에두르기 후 스스로 인출한 A를 음소 접근 행동으로, 음소를 바꾸며 접근한 B를 인출 지연으로 보아 오류 특성이 뒤바뀌었고, 의미 단서에 반응한 C에게 따라말하기는 맞지 않는다.\",\"3\":\"A는 스스로 목표 낱말을 인출했으므로 인출 실패가 아니고, B는 에두르기가 아닌 음소 접근 행동을 보였으며, C는 무반응 후 의미 단서에 반응했으므로 음소 접근 행동이 아니다.\",\"4\":\"지문에서 의미착어, 신조어, 반향어는 관찰되지 않았으며 A의 '쓰는 거'는 의미착어가 아닌 에두르기이다.\",\"5\":\"멜로디억양치료, 제약유발 언어치료, 시각동작치료는 각 환자의 이름대기 오류 유형에 맞춘 중재가 아니다.\"}},\"1-3-1-25\":{\"w\":{\"1\":\"㉠ '엄마 신발'은 현관에 놓인 엄마의 구두를 가리키며 한 말로, 엄마의 신발이라는 소유자–대상(소유) 관계이다.\",\"2\":\"㉡ '아빠 가'는 아빠가 문을 열고 나가는 것을 보며 한 말로, 행위하는 사람(아빠)과 행위(가)를 결합한 행위자–행위 관계이다.\",\"3\":\"㉢ '안 먹어'는 숟가락을 밀어내며 한 말로, 부정어(안)와 행위(먹어)를 결합한 부정–행위 관계이다.\",\"5\":\"㉤ '여기 앉아'는 의자를 두드리며 엄마를 부르는 맥락에서 장소(여기)와 행위(앉아)를 결합한 장소–행위 관계이다.\"}},\"1-3-1-26\":{\"w\":{\"1\":\"조사를 따로 세면 6 + 4 + 7 + 5 = 22낱말이고 발화 수가 4이므로 MLU-w는 22 ÷ 4 = 5.5이다. 조사를 앞말에 붙여 어절로 세더라도 평균어절길이(MLU-c)는 17 ÷ 4 = 4.25이므로 4.0이 아니다.\",\"2\":\"'친구랑', '형아랑'에는 공동의 부사격 조사, '블록으로'에는 도구의 부사격 조사가 사용되었다.\",\"4\":\"'만들었어'의 과거시제 선어말어미 '-었-'은 정확하게 산출되었으며 오류가 나타나지 않았다.\",\"5\":\"'못 만들었어'에서 부정 부사 '못'을 사용하였다.\"}},\"1-3-1-27\":{\"w\":{\"1\":\"셋째 문장의 대등절('울었고'/'토끼가 … 주었어요')을 분리하지 않아 T-unit을 4개로 세고, 24 ÷ 4 = 6.0으로 계산한 값이다.\",\"3\":\"T-unit 4개는 대등절을 분리하지 않은 잘못된 개수이며, 4.8은 5개로 나눈 값이므로 두 수치가 서로 맞지도 않는다.\",\"4\":\"T-unit 5개는 맞지만 6.0은 총 어절 수 24를 4로 나눈 값으로, 24 ÷ 5 = 4.8과 맞지 않는다.\",\"5\":\"종속절이나 인용절까지 별도 T-unit으로 분리하여 6개로 센 것으로, 종속절·인용절은 주절에 포함해야 한다는 조건에 어긋난다.\"}},\"1-3-1-28\":{\"w\":{\"2\":\"−1SD에 해당하는 표준점수는 85이므로 84는 −1SD보다 낮은 경계선 수준이며, 문제가 없다고 단정할 수 없다.\",\"3\":\"등가연령은 원점수가 해당 연령 평균과 같다는 뜻일 뿐, 아동의 언어 특성이 3세 2개월 아동과 동일하다는 의미가 아니다.\",\"4\":\"16점 차이는 약 1SD 이상의 차이로, 우연 범위로 무시할 수 없다.\",\"5\":\"백분위 2는 또래의 2%만이 이 아동보다 낮은 점수를 받는다는 뜻으로, 또래 98%보다 낮은 수행 수준이다.\"}},\"1-3-1-29\":{\"w\":{\"2\":\"주격 조사는 '동생이', '내가', '아빠가'처럼 모두 정확하게 산출되었다.\",\"3\":\"목적격 조사는 '우유를'처럼 정확하게 산출되었다.\",\"4\":\"과거시제 어미는 '놀았어요', '앉았어요', '왔어요'처럼 모두 정확하게 산출되었다.\",\"5\":\"종결어미 '-어요'는 모든 발화에서 정확하게 산출되었다.\"}},\"1-3-1-30\":{\"w\":{\"1\":\"주격 조사는 정확률 92%로 이미 숙달에 가까워 중재 목표로 부적절하다.\",\"3\":\"과거시제 선어말어미는 정확률 88%로 이미 90% 가까이 숙달되어 목표로 부적절하다.\",\"4\":\"연결어미 '-어서'는 정확률 5%로 아직 거의 출현하지 않은 형태여서 이후 단계에서 다룬다.\",\"5\":\"관형사형 어미는 정확률 0%로 아직 출현하지 않은 형태여서 이후 단계에서 다룬다.\"}},\"1-3-1-31\":{\"w\":{\"1\":\"교실 밖 타임아웃은 아동을 과제에서 벗어나게 하므로 회피 기능의 문제행동을 오히려 강화한다.\",\"2\":\"대체행동 없이 소거만 하면 문제행동이 일시적으로 증가(소거 폭발)할 수 있고 아동에게 의사소통 수단을 주지 못한다.\",\"3\":\"과제 완료 후 간식 강화는 문제행동의 회피 기능과 무관하여 행동의 원인을 다루지 못한다.\",\"4\":\"쓰기 과제를 완전히 제외하면 학습 기회를 박탈하고 문제행동의 기능도 다루지 못한다.\"}},\"1-3-1-32\":{\"p\":\"아동은 4회기에 걸쳐 햄버거 가게 스크립트(주문하기 → 돈 내기 → 햄버거 받기 → 먹기)의 사건 순서를 익혔다. 5회기에 치료사는 예상되는 단계인 햄버거 건네기를 빠뜨리고 빈 쟁반을 주었으며, 아동은 '햄버거 없어요. 햄버거 주세요.'라고 문제를 지적하고 요구하였다. 이처럼 익숙한 사건 순서를 의도적으로 어기는 스크립트 위반(사건 방해)은 아동이 맥락 지식을 바탕으로 자발적 요구 발화를 산출하도록 유도한다.\",\"w\":{\"2\":\"시간지연은 발화 유도 시 반응을 기다려 주는 환경중심 기법으로, 사건 순서를 어긴 이 장면의 절차와 다르다.\",\"3\":\"우발교수는 아동이 먼저 시작한 상호작용에 성인이 반응하는 절차인데, 이 장면은 치료사가 의도적으로 사건을 방해한 것이다.\",\"4\":\"역할 교대는 스크립트 중재의 다른 단계로, 이 장면에서 치료사는 여전히 점원 역할을 맡고 있다.\",\"5\":\"스크립트 소거는 단서를 점차 줄이는 다른 단계로, 예상 단계를 빠뜨려 요구를 유도한 이 장면의 절차가 아니다.\"}},\"1-3-1-33\":{\"w\":{\"1\":\"구어가 나올 때까지 기다리는 것은 의사소통 의도가 있으나 수단이 부족한 아동에게 AAC 도입 시기를 부당하게 늦추는 것이다.\",\"3\":\"AAC는 구어 자극과 병행하는 것이므로 그림판 도입과 함께 구어 중재를 중단하는 것은 옳지 않다.\",\"4\":\"AAC는 구어가 전혀 불가능한 아동에게만 적용하는 것이 아니며, 이 아동처럼 표현 수단이 부족한 아동에게 조기 도입이 권장된다.\",\"5\":\"지적장애 아동도 실물·사진 등 투명도 높은 상징부터 단계적으로 사용할 수 있으므로 상징 이해가 어렵다는 이유로 AAC를 미룰 근거가 없다.\"}},\"1-3-1-34\":{\"w\":{\"1\":\"아동의 수용·표현 어휘는 이미 또래 범위이므로 어휘 확장은 문법형태소 생략이라는 핵심 문제에서 초점이 어긋난다.\",\"2\":\"독화 훈련은 청각 활용을 우선하는 인공와우 착용 아동에게 시각 양식을 앞세우는 것이다.\",\"3\":\"내용어는 비교적 정확하게 산출하므로 조음이 아닌 형태소 사용의 문제이며, 조음 훈련은 부적절하다.\",\"5\":\"착용 역치가 어음역을 충분히 포함하고 청각 활용이 가능한 아동에게 수어로 전환하는 것은 시각 양식을 앞세우는 것이다.\"}},\"1-3-1-35\":{\"w\":{\"2\":\"어휘·구문이 또래 범위이고 조용한 환경에서 청각 활용이 양호하므로 수어 병행으로 전환할 근거가 없다.\",\"3\":\"중등도 난청은 보청기 적용 대상이며 인공와우 이식의 적응증이 아니다.\",\"4\":\"어휘·구문 등 언어 능력은 정상 범위이므로 언어치료 빈도를 늘리는 것은 소음 속 듣기 문제의 핵심 해결책이 아니다.\",\"5\":\"통합학급 수업을 보류하는 것은 교육 기회를 박탈하는 부적절한 조치이다.\"}},\"1-3-1-36\":{\"w\":{\"1\":\"언어연령에 맞춘 그림책 어휘 확장은 발달적 목표로, 17세의 생활연령과 직장 환경의 요구에 맞지 않는다.\",\"2\":\"복문 산출과 문법형태소 정확도는 언어연령 중심의 발달적 목표로, 도움 요청과 지시 확인이라는 기능적 요구를 다루지 못한다.\",\"4\":\"음운인식과 해독 훈련은 언어연령 중심의 학업적 목표로, 졸업 후 작업 환경에서 필요한 기술과 거리가 멀다.\",\"5\":\"표준화 언어검사의 반복은 평가일 뿐 중재 목표가 아니다.\"}},\"1-3-1-37\":{\"w\":{\"1\":\"한국어 한 언어의 점수만 단일언어 규준으로 판정한 오류로, 개념적 어휘가 정상 범위이므로 지체로 진단할 근거가 없다.\",\"2\":\"코드 혼용(부호 혼용)은 이중언어 아동의 정상적이고 규칙적인 현상으로, 언어 혼란의 징후가 아니다.\",\"3\":\"이중언어 아동에게 단일언어 규준을 각 언어에 그대로 적용하면 어휘가 분산된 특성 때문에 지체로 오판하게 된다.\",\"5\":\"언어장애라면 두 언어 모두에서 개념적 어휘를 포함한 전반적 결함이 나타나야 하는데, 이 아동은 개념적 어휘와 이해가 정상 범위이다.\"}},\"1-3-1-38\":{\"w\":{\"1\":\"자소–음소 대응과 비단어 읽기가 이미 확립된 상태여서 음운인식 훈련은 기초 기술의 중복 훈련이다.\",\"2\":\"총체적 언어 접근의 통독은 해독 자동화에 결함이 있는 아동에게 근거가 약하다.\",\"4\":\"읽기이해 저하는 느린 해독의 결과이므로 이해 전략 교수는 유창성이 확보된 뒤 병행할 목표이다.\",\"5\":\"자소–음소 대응 지식이 95%로 이미 확립되어 있어 체계적 재교수는 중복 훈련이다.\"}},\"1-3-1-39\":{\"p\":\"문장 수준 쓰기에서는 문법·철자 오류가 거의 없고 어휘도 또래 범위이며 읽기 이해도 정상이다. 반면 글쓰기에서는 계획 없이 바로 쓰기 시작해 떠오르는 문장을 나열하고, 문단 구분과 주제문이 없으며, 다 쓴 뒤 다시 읽지 않는다. 즉 글 수준의 계획·조직·점검이 부재하므로 쓰기 과정(계획–작성–수정) 전략과 그래픽 조직자(생각 그물, 개요표)를 활용한 담화 구조 지도가 적절하다.\",\"w\":{\"1\":\"받아쓰기를 통한 문장 정확도 향상은 이미 또래 수준인 문장 단위 기술을 반복하는 것으로, 텍스트 조직 결함을 다루지 못한다.\",\"2\":\"이 아동은 철자 오류가 거의 없으므로 철자 규칙 지도는 핵심 결함과 무관하다.\",\"3\":\"문장 결합 훈련은 문장 단위 기술로, 글 전체의 계획·조직·자기 점검 부재라는 핵심 문제를 다루지 못한다.\",\"4\":\"어휘가 이미 또래 범위이므로 어휘 확장은 텍스트 조직과 자기 점검의 결함을 다루지 못한다.\"}},\"1-3-1-40\":{\"w\":{\"2\":\"누가·언제·어디서를 묻는 사실적 이해는 이미 양호하므로 추론 결함을 다루지 못한다.\",\"3\":\"읽기 해독과 유창성이 또래 범위이므로 반복 읽기로 속도를 높이는 것은 초점이 어긋난다.\",\"4\":\"어휘가 또래 범위이므로 사전적 정의 찾기는 추론적 이해의 결함을 다루지 못한다.\",\"5\":\"순서대로 다시 말하기는 글에 나온 내용의 회상에 머물러 단서와 배경지식을 연결하는 추론 결함을 직접 다루지 못한다.\"}},\"1-3-1-41\":{\"w\":{\"1\":\"아동은 아직 상징놀이가 관찰되지 않는 감각운동적 놀이 수준이므로 역할놀이 대본을 이용한 대화 지도는 현재 수준을 크게 넘어선다.\",\"3\":\"상징놀이는 표상 능력을 반영해 초기 낱말 발달과 밀접히 관련되므로 놀이와 언어가 무관하다는 전제는 옳지 않다.\",\"4\":\"규칙이 있는 보드게임은 감각운동적 놀이 수준의 아동에게 현재 수준을 크게 넘어서는 목표이다.\",\"5\":\"또래와의 협동 놀이는 아직 상징놀이도 나타나지 않은 아동의 현재 놀이 수준을 크게 넘어서는 목표이다.\"}},\"1-3-1-42\":{\"w\":{\"1\":\"의사소통 빈도는 분당 5회로 이 연령대 기대 수준에 해당하므로 낮지 않다.\",\"2\":\"요구하기는 이미 85%를 차지하는 우세한 기능이므로 이를 정교화하는 것은 기능 편중이라는 핵심 문제를 해결하지 못한다.\",\"3\":\"거부하기는 12회로 이미 나타나고 있는 기능이므로 우선 목표가 아니다.\",\"4\":\"의문사 질문은 언급·공동주의 기능이 확립된 이후에 기대되는 발달 순서상 뒤의 목표이다.\"}},\"1-3-1-43\":{\"p\":\"아동은 언어성 지능이 정상이고 어휘·구문도 또래 범위이지만, 틀린 믿음 과제(위치 바꾸기)에서 실제 위치를 말하고, 넘어진 친구의 '진짜 좋다'는 반어를 문자 그대로 이해하며, 인물이 화난 이유를 설명하지 못한다. 이는 타인의 마음 상태를 표상하는 마음이론의 결함을 반영한다. 따라서 생각 풍선, 만화 대화 등 시각적 지원을 활용해 인물의 생각·믿음·감정과 화자의 의도를 명시적으로 추론하게 하는 중재가 적절하다.\",\"w\":{\"1\":\"어휘·구문은 이미 또래 범위이므로 복문 산출 훈련은 마음 상태 추론의 결함을 다루지 못한다.\",\"2\":\"비디오 자기모델링은 인사하기 같은 특정 행동 습득에는 유용하지만 타인의 생각과 감정을 추론하는 능력을 다루지 못한다.\",\"4\":\"음운인식 훈련은 이 아동의 문제와 무관한 영역으로, 마음이론 결함을 다루지 못한다.\",\"5\":\"감정 어휘를 정의와 함께 암기하는 것만으로는 맥락 속에서 상대의 마음을 추론하는 능력이 길러지지 않는다.\"}},\"1-3-1-44\":{\"w\":{\"1\":\"단순히 늦게 말하는 아동으로 보고 추적 관찰만 하는 것은 가리키기·보여주기 부재 등 사회적 의사소통 위험 신호를 간과한 것이다.\",\"2\":\"24개월까지 기다리라는 안내는 사회적 의사소통 위험 신호를 간과하고 조기 평가와 중재의 시기를 놓치게 한다.\",\"3\":\"공동주의와 모방 같은 전제 기술이 없는 상태에서 낱말 모방 훈련을 앞세우는 것은 순서가 맞지 않다.\",\"4\":\"청력 정상은 원인 하나를 배제할 뿐이며 언어·사회적 의사소통에 문제가 없음을 의미하지 않는다.\"}},\"1-3-1-45\":{\"w\":{\"1\":\"간식 시간이라는 상황은 제시되었으나 '잘하게 된다'는 관찰·측정할 수 없는 모호한 표현이고 준거도 없다.\",\"3\":\"'향상시킨다'는 관찰·측정할 수 없는 포괄적 진술로, 조건·행동·준거가 모두 불명확하다.\",\"4\":\"아동이 아닌 치료사의 행동을 진술한 것으로, 아동의 행동 목표가 아니다.\",\"5\":\"'이해한다'는 직접 관찰할 수 있는 행동이 아니어서 측정이 불가능하다.\"}},\"1-3-1-46\":{\"w\":{\"1\":\"밥·집·사람은 1층위 기본 어휘로, 초등학교 4학년 아동은 대부분 이미 습득하였다.\",\"2\":\"맷돌·다듬잇돌·절구는 특정 단원에만 국한된 저빈도 3층위 전문 어휘로, 교과 수업에서 다루는 것이 효율적이다.\",\"4\":\"이미 아는 낱말의 반복은 새로운 학습이 없어 제한된 회기에서 교과 학습 전반에 대한 효과가 작다.\",\"5\":\"관용어와 속담은 지문에 제시된 낱말군이 아니므로 근거가 없다.\"}},\"1-3-1-47\":{\"w\":{\"1\":\"가정 녹음에서 연령에 적절한 언어가 확인되므로 무반응으로 얻은 원점수 0을 표현언어 지체로 해석하는 것은 가정 자료와 모순된다.\",\"2\":\"가정에서 복문과 연령 적절한 어휘를 사용하므로 언어 능력의 결함인 발달성 언어장애로 판단할 근거가 없다.\",\"3\":\"발화를 강하게 요구하는 압박은 불안을 높여 증상을 악화시킨다.\",\"5\":\"상동행동·제한된 관심사가 없고 가정에서 상호작용이 활발하므로 자폐스펙트럼장애 평가를 우선할 근거가 부족하다.\"}},\"1-3-1-48\":{\"w\":{\"1\":\"이야기 문법 요소 회상률(z ≈ +0.3)과 완전한 일화 수(z = +0.1)가 평균 범위이므로 일화 구성은 우선 목표가 아니다.\",\"2\":\"문법형태소 오류율은 1.2%로 또래 평균 1.6%보다 낮아(z = −0.2) 양호하므로 우선 목표가 아니다.\",\"3\":\"T-unit당 비유창성률은 4%로 또래 평균과 같아(z = 0.0) 중재가 필요하지 않다.\",\"5\":\"T-unit 길이는 표에 제시되지 않은 지표이며, 구문이 또래 범위이므로 문장 확장은 우선 목표가 아니다.\"}},\"1-3-1-49\":{\"w\":{\"1\":\"a '저는 저는'(낱말전체 반복), b '음 (쉼)'(간투사·쉼), d '거기서 거기서'(구 반복)는 앞선 단위를 되풀이하거나 시간을 버는 지연(stalling) 유형만 모은 것이다.\",\"2\":\"c(음소 반복)와 e(연장)는 진행 유형이지만 a '저는 저는'은 낱말전체 반복으로 지연 유형에 해당한다.\",\"4\":\"f(막힘)는 진행 유형이지만 b(간투사·쉼)와 d(구 반복)는 계획이 준비될 때까지 시간을 버는 지연 유형이다.\",\"5\":\"c와 e는 진행 유형이지만 d '거기서 거기서'는 구 반복으로 지연 유형이며, 진행 유형인 f(막힘)가 빠져 있다.\"}},\"1-3-1-50\":{\"p\":\"제시된 결과는 뇌영상(우반구 운동·전운동 영역 과활성과 좌반구 청각 영역 활성 저하), 백질 구조(궁상다발 완전성 저하), 약물 반응(도파민 D2 길항제로 감소, 작용제로 악화), 유전(일란성 쌍생아 일치율이 더 높음)에 걸친 신경생리학적 근거이다. 이를 통합하면 좌반구 언어-운동 신경망의 취약성, 기저핵-시상-피질 회로의 도파민 과활성으로 인한 말운동 타이밍 문제, 유전적 소인이 함께 작용한다고 설명할 수 있다. 따라서 네 가지 결과를 모두 포괄하는 진술은 2번 보기이다.\",\"w\":{\"1\":\"진단착오이론의 설명으로, 뇌영상·백질·약물·쌍생아 자료처럼 생물학적 근거를 보여 주는 지문의 결과를 설명하지 못한다.\",\"3\":\"우반구 과활성은 좌반구 결함에 대한 보상적 활성으로 해석되므로, 이를 일차 원인으로 보고 억제 훈련을 근본 치료로 제시한 것은 틀렸다.\",\"4\":\"지문에서 도파민 작용제는 말더듬을 악화시켰고 감소 효과는 길항제에서 보고되었으므로, 도파민 결핍을 원인으로 보고 작용제를 권하는 것은 결과와 정반대이다.\",\"5\":\"내적수정가설의 설명으로, 운동 영역 과활성·백질 이상·도파민 반응처럼 말운동 신경망과 관련된 결과를 설명하지 못한다.\"}},\"1-3-1-51\":{\"p\":\"아동은 큰 개에게 쫓겨 크게 놀란 사건 직후 말더듬이 갑자기 시작되었고, 그 이전 말·언어발달은 정상이며 가족력도 없다. 처음부터 긴장된 막힘, 후두 긴장, 숨 참기가 나타나고, 말하기를 두려워하며 '말이 안 나와'라고 우는 것은 말더듬을 뚜렷이 인식하고 공포를 느끼고 있음을 보여 준다. 이는 놀람·외상 사건 후 갑작스럽게 시작되어 긴장된 막힘과 높은 인식, 공포·회피가 빠르게 발달하는 Van Riper의 경로 III에 해당한다.\",\"w\":{\"1\":\"경로 I은 가장 흔한 형태로 점진적 시작과 쉬운 반복이 특징이어서, 갑작스럽게 시작해 긴장된 막힘과 높은 인식을 보이는 이 아동과 맞지 않는다.\",\"2\":\"경로 II는 언어발달 지연과 속화 유사 양상이 특징인데, 이 아동은 이전 말·언어발달이 정상이었다.\",\"3\":\"경로 IV는 늦은 시작, 의도적·상동적 반복, 회피 결여가 특징이어서, 외상 직후 긴장된 막힘으로 시작해 말하기를 두려워하는 이 아동과 다르다.\",\"5\":\"경로 II의 특징을 잘못 기술한 보기이며, 이 아동은 긴장 없는 연장이 아니라 긴장된 막힘을 보이고 말더듬에 대한 인식도 뚜렷하다.\"}},\"1-3-1-52\":{\"w\":{\"1\":\"목표 음절 수는 비유창 부분을 뺀 의도 발화 기준 2+2+4+5+3+3+3+3+2+2+3 = 32음절이며, 41은 '---' 칸을 뺀 전체 칸 수와 혼동한 값이다.\",\"2\":\"단어부분 반복은 우우우리, 금금요일, 거거거거기서, ㅋㅋ커다란, 봤봤어요로 5회이고, 음소 반복 'ㅋㅋ커'를 따로 분류하더라도 4회이므로 3회가 될 수 없다.\",\"4\":\"비운율적 발성은 연장 1회(미---)와 막힘 2회(견, 공)를 합해 3회이므로 2회는 틀렸다.\",\"5\":\"진성 비유창성은 반복 5회와 비운율적 발성 3회를 합한 8회이므로 100음절당 8 ÷ 32 × 100 = 25회이다.\"}},\"1-3-1-53\":{\"w\":{\"2\":\"연기책(postponement)은 어려운 낱말 앞에서 시간을 끄는 행동으로, '(3초 쉼)진행하세요'의 1회만 해당한다.\",\"3\":\"도피(탈출)행동은 막힘에서 빠져나오기 위한 행동으로, 고개를 옆으로 홱 돌리기와 손으로 책상 치기의 2회이다.\",\"4\":\"대용어 사용은 '프레젠테이션'을 '발표 자료'로 바꾼 1회뿐이다.\",\"5\":\"상황 회피는 발표를 동료에게 부탁하는 1회로, 가장 많이 나타난 행동이 아니다.\"}},\"1-3-1-54\":{\"w\":{\"1\":\"진성 비유창성 3회는 맞지만, 기타 비유창성은 간투사 '어'와 구 반복 '갔다가 갔다가'의 2회이므로 3회는 틀렸다.\",\"2\":\"진성 비유창성은 막힘·음소 반복·연장의 3회이므로 4회는 틀렸다.\",\"3\":\"말속도 140 SPM은 맞지만 %SS 약 7.1은 말더듬 음절을 2개로 보고 2 ÷ 28 × 100으로 잘못 계산한 값이다.\",\"4\":\"%SS 약 10.7은 맞지만 말속도는 28음절 ÷ 12초 × 60 = 140 SPM이므로 120 SPM은 틀렸다.\"}},\"1-3-1-55\":{\"w\":{\"1\":\"a와 b는 기타 비유창성이지만 c '시---장'은 연장으로 비운율적 발성(진성 비유창성)에 해당한다.\",\"3\":\"b와 d는 기타 비유창성이지만 e '사 사 사'는 일음절 낱말 전체 반복으로 Yairi와 Ambrose의 분류 및 P-FA-II의 R2(비정상적 반복)에서 모두 진성 비유창성으로 분류된다.\",\"4\":\"a와 d는 기타 비유창성이지만 f '(막힘)너무'는 막힘으로 비운율적 발성(진성 비유창성)이다.\",\"5\":\"b만 기타 비유창성이고, c(연장)와 e(일음절 낱말 전체 반복)는 모두 진성 비유창성이다.\"}},\"1-3-1-56\":{\"w\":{\"1\":\"여아이고 가족력이 없으며 진성 비유창성이 감소 추세이고 음운발달도 정상이어서 자연회복 가능성이 높다.\",\"2\":\"삼촌의 말더듬은 자연회복된 회복형 가족력이고, 긴장 없는 음절 반복 위주에 인식이 없으므로 지속 위험이 낮다.\",\"3\":\"여아이고 가족력이 없으며 언어발달이 또래보다 앞서고 비유창성 빈도도 증가하지 않아 회복 가능성이 높다.\",\"5\":\"발병 2개월로 발병 직후이고 다음절 낱말 전체 반복 위주로 정상적 비유창성에 가까워, 직접치료보다 관찰이 우선이다.\"}},\"1-3-1-57\":{\"w\":{\"1\":\"ㄱ '부드럽게 잘 말했네!'는 유창한 발화를 칭찬하는 말로, 인정이 아니라 칭찬에 해당한다.\",\"2\":\"ㄴ '방금 말 부드러웠어?'는 유창한 발화 후 아동에게 스스로 평가하게 하는 말로 유창한 발화에 대한 자기평가 요청이며, 말더듬에는 자기평가 요청을 하지 않는다.\",\"4\":\"ㄹ은 말더듬 후 다시 말해 보게 하는 자기수정 요청이며, 말더듬에 대해서는 칭찬을 하지 않는다.\",\"5\":\"ㅁ '그렇지, 부드러운 말이야.'는 유창한 발화에 대한 인정이며, 유창한 발화에는 자기수정을 요청하지 않는다.\"}},\"1-3-1-58\":{\"w\":{\"1\":\"같은 4수준 질문을 반복하면 요구 수준이 그대로 유지되어 말더듬이 지속될 수 있다.\",\"2\":\"더듬은 상태에서 5수준으로 올리면 의사소통 요구가 더 높아져 조절 원리와 반대 방향이 된다.\",\"3\":\"사물만 바꾸고 같은 수준의 질문을 계속하면 요구 수준이 낮아지지 않아 말더듬이 지속될 수 있다.\",\"4\":\"말더듬 뒤 강화물을 주고 활동을 끝내는 것은 요구 수준을 조절해 유창성을 회복시키는 이 기법의 원리에 맞지 않는다.\"}},\"1-3-1-59\":{\"w\":{\"2\":\"이야기그림(ㄴ)은 초등학생의 필수과제이므로 중학생에게는 해당하지 않으며, 대화(ㄹ)는 중학생의 필수과제이다.\",\"3\":\"의사소통태도 평가는 초등학생 이상에게 실시하므로 중학생도 대상에 포함된다.\",\"4\":\"낱말그림과 따라말하기는 선택과제이므로 필수과제로 추가한다는 설명은 틀렸다.\",\"5\":\"읽기는 초등학생 이상 모두의 필수과제이므로 중학생에게도 실시해야 한다.\"}},\"1-3-1-60\":{\"p\":\"행동통제소 검사(LCB)는 점수가 높을수록 결과가 운이나 타인에 의해 결정된다고 믿는 외적 통제소재를 뜻한다. 대상자의 LCB가 42에서 24로 감소한 것은 말의 통제가 자신에게 있다고 느끼는 내적 통제감이 커진 긍정적 변화이다. 함께 제시된 %SS, OASES, PSI 기대 점수, S-24도 모두 감소하여 빈도·영향·예기·태도 전반에서 긍정적 변화가 나타났다.\",\"w\":{\"1\":\"OASES는 점수가 낮을수록 말더듬의 부정적 영향이 적으므로, 3.6에서 2.1로 감소한 것은 영향이 줄어든 것이다.\",\"3\":\"PSI 기대 점수가 15에서 5로 감소한 것은 말을 더듬을 것이라고 예상하는 상황이 줄었음을 뜻한다.\",\"4\":\"S-24 점수가 22에서 8로 감소한 것은 의사소통 태도가 긍정적으로 변했음을 뜻한다.\",\"5\":\"%SS가 14에서 3으로 크게 감소하였으므로 말더듬 빈도에 뚜렷한 변화가 있었다.\"}},\"1-3-1-61\":{\"p\":\"치료사는 대상자가 습관적으로 보이던 입술을 꽉 다문 막힘을 의도적으로 '바바바' 같은 가벼운 반복으로, 이어서 첫소리를 길게 늘이는 형태로 바꾸어 더듬어 보게 하고 있다. 이처럼 굳어진 말더듬 형태를 다른 형태로 바꾸어 보게 하여 말더듬이 고정된 반응이 아니라 스스로 변화시킬 수 있는 행동임을 경험하게 하는 것이 변형(variation) 단계이다. 지난주 녹화로 확인한 막힘 형태를 출발점으로 삼아 그 형태를 바꾸는 활동으로 나아간 점도 단서이다.\",\"w\":{\"1\":\"확인 단계는 자신의 말더듬 행동을 분석·기술하는 단계로, 막힘 형태를 의도적으로 바꾸어 보는 대화 속 활동과는 다르다.\",\"2\":\"둔감화 단계는 말더듬과 청자 반응에 대한 두려움을 줄이는 단계로, 말더듬 형태를 여러 가지로 바꾸어 보는 연습이 중심이 아니다.\",\"3\":\"접근 단계는 취소·빠져나오기·예비책으로 더 쉬운 말더듬을 배우는 단계로, 형태를 여러 가지로 바꾸어 보는 변형 단계와 구분된다.\",\"5\":\"안정화 단계는 자기치료와 재발 대비를 다루는 단계로, 말더듬 형태를 바꾸어 보는 연습과는 거리가 있다.\"}},\"1-3-1-62\":{\"p\":\"대상자는 파킨슨병 진단 8년째로, '먹었어요'처럼 낱말·구를 여러 번 반복하면서 반복할수록 속도가 빨라지고 목소리가 작아진다. 반복이 발화 끝부분에서도 나타나고 긴장·막힘·연장이 없으며, 불안이나 부수행동도 없다. 이는 기저핵 병변과 관련되어 낱말·구를 강박적으로 반복하며 가속과 음량 감소를 보이는 동어반복증(palilalia)의 특징이다.\",\"w\":{\"1\":\"발달성 말더듬은 아동기에 발병하고 긴장·부수행동을 동반하는데, 이 대상자는 파킨슨병 이후의 양상이며 긴장·부수행동이 없다.\",\"2\":\"신경인성 말더듬은 음소·음절 반복, 연장, 막힘이 낱말 위치와 무관하게 나타나는 것으로, 낱말·구 전체가 점점 빨라지고 작아지며 반복되는 이 양상과 구분된다.\",\"4\":\"심인성 말더듬은 심리적 외상 후 발생하고 기이한 양상을 보이는데, 지문에는 심리적 사건이 없고 파킨슨병이라는 신경학적 배경이 있다.\",\"5\":\"속화는 빠르고 불규칙한 말속도와 명료도 저하가 특징으로, 같은 낱말·구가 가속·감음되며 반복되는 현상을 설명하지 못한다.\"}},\"1-3-1-63\":{\"w\":{\"1\":\"학교 발표 상황의 높은 %SS와 회피가 남아 있어 전이가 완료되지 않았으므로 종결은 이르며, 추후 관리를 생략하는 것도 부적절하다.\",\"2\":\"치료실과 가정에서 이미 유창성이 확립되었으므로 프로그램을 처음부터 다시 실시하는 것은 불필요한 반복이다.\",\"3\":\"리드콤 프로그램은 학령전기 아동용 프로그램이므로 10세 아동에게 적절하지 않다.\",\"4\":\"발표 면제를 요청하면 이미 나타난 회피(자리 비움)를 오히려 강화하게 된다.\"}},\"1-3-1-64\":{\"w\":{\"2\":\"말더듬이 줄면 놀림이 해결된다는 잘못된 전제에 기반하며, 아동에게 유창성 압박을 높인다.\",\"3\":\"부모가 상대 부모에게 직접 항의하면 갈등이 커지고 아동이 스스로 문제를 해결해 보는 경험을 빼앗는다.\",\"4\":\"등교 중단은 회피를 강화하여 이미 나타난 위축과 등교 거부를 더 굳힐 수 있다.\",\"5\":\"어려운 낱말을 바꾸어 말하게 하는 것은 낱말 회피를 가르쳐 말더듬을 숨기게 만드는 부적절한 접근이다.\"}},\"1-3-1-65\":{\"p\":\"15세 대상자는 '엄마가 오라고 해서 왔어요'라며 스스로 원해 온 것이 아님을 밝히지만, 대화 %SS 9와 전화·발표 회피, 눈맞춤 회피가 관찰된다. 청소년 말더듬 치료는 본인의 동기와 참여가 성과를 좌우하므로, 첫 회기에는 본인이 말더듬의 영향을 인식하고 원하는 변화를 찾아 목표 설정에 참여하도록 돕는 동기 단계가 우선이다. 이때 비밀보장과 자율성 존중이 신뢰 관계의 기초가 된다.\",\"w\":{\"1\":\"어머니가 정한 목표로 곧바로 훈련을 시작하면 본인의 동기를 배제한 부모 중심 진행이 되어 참여를 이끌어 내기 어렵다.\",\"3\":\"동기 형성 자체를 치료의 일부로 보지 않은 잘못된 판단으로, 회피가 뚜렷한 대상자를 그대로 두게 된다.\",\"4\":\"리드콤 프로그램은 학령전기 아동용이며, 청소년 본인을 배제하고 부모 중심으로 진행하는 접근이다.\",\"5\":\"첫 회기에 준비 없이 낯선 사람에게 전화하게 하는 급격한 노출은 회피와 불안을 오히려 강화할 수 있다.\"}},\"1-3-1-66\":{\"p\":\"학생은 음절 축약('할머니가'→'함니가'), 잦은 낱말·구 반복과 수정을 보여 빠른 말속도에 따른 명료도 저하와 과도한 정상적 비유창성이 나타난다. 천천히 말하라고 하면 잠시 명료해지고, '다들 잘 알아듣는데요?'라며 자신의 말 문제를 잘 인식하지 못한다. 주의를 기울이면 나아지고 문제 인식이 낮은 것은 속화의 특징으로, 주의를 기울이거나 긴장할수록 심해지고 자신의 말더듬을 뚜렷이 인식하는 말더듬과 구별되는 근거이다.\",\"w\":{\"1\":\"막힘과 후두·입술 긴장은 말더듬의 특징이며, 이 학생에게서 보고되지 않았다.\",\"2\":\"어려운 낱말과 상황을 예상하고 피하는 회피는 말더듬을 인식하면서 발달하는 특징으로, 자신의 문제를 잘 인식하지 못하는 이 학생과 맞지 않는다.\",\"3\":\"눈 깜박임 같은 부수행동은 말더듬의 특징으로, 이 학생에게서 관찰되지 않았다.\",\"5\":\"예기 불안과 두려움은 말더듬을 뚜렷이 인식하는 화자에게 나타나는 특징으로, '다들 잘 알아듣는데요?'라고 말하는 이 학생과 반대된다.\"}},\"1-3-1-67\":{\"w\":{\"1\":\"250 ms 지연을 일상에서도 계속 사용하면 기기 의존이 고착되고 매우 느린 말이 그대로 유지된다.\",\"2\":\"지연을 더 늘리면 이미 매우 느린 말이 더 느려져 말의 자연스러움을 해친다.\",\"4\":\"단계적 전이 없이 기기를 즉시 제거하고 정상 속도로 말하게 하면 재발을 초래하기 쉽다.\",\"5\":\"차폐 소음 기기를 영구적으로 병행하는 것도 기기 의존을 고착시켜 기기 없는 말로 전이한다는 목표에 맞지 않는다.\"}},\"1-3-1-68\":{\"w\":{\"1\":\"유창성완성법만 적용하면 S-24 20점의 부정적 태도와 낱말·상황 회피를 다루지 못한다.\",\"2\":\"말더듬수정법만 적용하면 %SS 11의 빈번한 긴장된 막힘을 줄일 유창성 촉진 요소가 빠진다.\",\"3\":\"지연청각피드백 기기 단독 사용은 부정적 태도와 회피를 다루지 못한다.\",\"4\":\"리드콤 프로그램은 부모의 언어적 수반자극에 기반한 학령전기 프로그램으로 성인에게 적합하지 않다.\"}},\"1-3-1-69\":{\"w\":{\"2\":\"기타 비유창성 8회(간투사 5 + 구 반복 2 + 수정 1)는 원 빈도이며, 100음절당으로 환산하면 8 ÷ 300 × 100 ≈ 2.67회이다.\",\"3\":\"가중 SLD는 [(단어부분 반복 + 일음절 낱말 반복) × 평균 단위반복수 + 2 × 비운율적 발성] ÷ 총 음절 × 100 = [(12 × 1.75) + 12] ÷ 300 × 100 = 11이므로 6이 아니다.\",\"4\":\"평균 단위반복수는 총 단위반복수 18+3 = 21회를 반복 횟수 9+3 = 12회로 나눈 1.75회이다.\",\"5\":\"전체 비유창성 26회(진성 18 + 기타 8) 중 진성 비유창성의 비율은 18 ÷ 26 ≈ 69%로, 약 40%가 아니다.\"}},\"1-3-1-70\":{\"w\":{\"1\":\"ㄱ, ㄷ은 내적수정가설로 설명되지만 ㄴ은 부모의 부정적 반응에 대한 학습을 강조하는 진단착오이론·학습이론의 설명이다.\",\"2\":\"ㄷ은 내적수정가설에 해당하지만 ㄴ은 진단착오이론·학습이론, ㅁ은 예기투쟁가설의 설명이다.\",\"3\":\"ㄱ, ㄹ은 내적수정가설에 해당하지만 ㅁ '예상되는 말더듬을 피하려는 투쟁 반응'은 예기투쟁가설의 설명이다.\",\"5\":\"ㄷ, ㄹ은 내적수정가설에 해당하지만 ㅁ은 예기투쟁가설의 설명이며, 이 가설의 예측인 ㄱ이 빠져 있다.\"}},\"1-3-1-71\":{\"w\":{\"1\":\"발병 후 10개월이 지난 아동의 말더듬을 언어치료가 끝날 때까지 방치하게 된다.\",\"3\":\"복문 산출을 집중 훈련하면 언어적 요구가 급격히 높아져 비유창성을 악화시킨다.\",\"4\":\"부모의 언어 자극을 최소화하면 이미 낮은 언어발달을 더 저해한다.\",\"5\":\"리드콤 수반자극은 말더듬 여부에만 적용하는 것이 원칙이므로 언어 오류에 동일하게 적용하는 것은 틀렸다.\"}},\"1-3-1-72\":{\"w\":{\"2\":\"심인성 말더듬으로 보면 관찰되지 않는 상황에서 유창한 점과 소송이라는 이득 동기를 설명하지 못하며, 곧바로 종결하는 것도 부적절하다.\",\"3\":\"신경학적 검사가 정상이므로 신경인성 말더듬으로 판단할 근거가 없다.\",\"4\":\"아동기 말더듬 병력이 없으므로 발달성 말더듬으로 볼 수 없다.\",\"5\":\"빠른 말속도나 명료도 저하 같은 속화의 특징이 지문에 나타나지 않는다.\"}},\"1-3-2-1\":{\"w\":{\"1\":\"연장모음 지표만으로 정상 판정하면 연결발화에서 드러나는 음성 문제를 놓치는 위음성이 되며, 심리 상담을 의뢰할 근거도 없다.\",\"2\":\"CPPS는 연결발화에서도 산출할 수 있는 안정적 지표이고 문장의 청지각 중증도(62 mm)도 함께 높으므로, 이를 측정 오류로 보고 버릴 근거가 없다.\",\"4\":\"VHI-10은 통상 11점을 넘으면 비정상으로 보므로 26점은 정상 범위가 아니다.\",\"5\":\"서로 다른 과제의 값을 평균하여 판정하는 것은 근거가 없으며, 연결발화에서 두드러지는 문제를 희석하게 된다.\"}},\"1-3-2-2\":{\"w\":{\"2\":\"120 cmH₂O/(L/sec)라는 값은 맞지만 정상보다 높은 값이므로, '낮다'는 판단과 성문폐쇄부전이라는 해석은 방향이 반대이다.\",\"3\":\"기류율을 L/sec로 환산하지 않고 mL/sec 수치 그대로 나눈 값(12.0 ÷ 100)으로, 단위 환산이 틀렸다.\",\"4\":\"성문하압과 기류율을 곱한 값(12.0 × 100)으로 저항을 구하는 공식이 아니며, 높은 저항은 호흡 지지 부족이 아니라 성대 과내전을 시사한다.\",\"5\":\"분수 방향을 뒤집어 기류율을 성문하압으로 나눈 값(100 ÷ 12.0 ≈ 8.3)으로, 저항이 아니라 그 역수에 해당한다.\"}},\"1-3-2-3\":{\"w\":{\"1\":\"A는 기류율이 크게 증가하여 과내전이 아니라 성문폐쇄부전이고, B는 기류율이 낮고 성문하압이 높아 성문폐쇄부전이 아니라 과기능적 과내전이다.\",\"2\":\"폐활량이 정상인 A를 호흡 지지 부족으로, 기류율이 낮은 B를 성문폐쇄부전으로, 폐활량이 저하된 C를 과내전으로 연결하여 모두 틀렸다.\",\"3\":\"A의 성문폐쇄부전은 맞지만, 폐활량이 정상이고 성문하압이 높은 B는 호흡 지지 부족이 아니며, 성문하압이 낮고 폐활량이 저하된 C는 과내전이 아니라 호흡 지지 부족이다.\",\"5\":\"B의 과내전은 맞지만, 폐활량이 정상이고 기류율이 크게 증가한 A를 호흡 지지 부족으로, 기류율이 정상 범위이고 폐활량이 저하된 C를 성문폐쇄부전으로 잘못 연결하였다.\"}},\"1-3-2-4\":{\"w\":{\"1\":\"VHI-30은 일상 말하기 음성의 영향을 반영할 뿐이므로, SVHI 92점이 보여 주는 가창 핸디캡을 무시하고 치료를 종결하는 것은 잘못이다.\",\"3\":\"직업적 요구가 높은 가수에게는 청지각적으로 경미한 변화도 큰 기능 손실이 되므로 자기보고 결과를 과장으로 보아서는 안 된다.\",\"4\":\"SVHI는 청지각적 평가 도구가 아니라 자기보고 도구이므로, GRBAS와의 일치 여부로 타당성을 판단하는 것은 틀렸다.\",\"5\":\"VHI-30과 SVHI는 측정 영역(일상 말하기와 노래)이 달라 점수 불일치가 신뢰도 문제를 뜻하지 않는다.\"}},\"1-3-2-5\":{\"w\":{\"1\":\"밀기 기법은 이미 목·어깨에 힘을 주어 발성하는 과기능을 더 강화한다.\",\"2\":\"장기 절대 음성휴식은 근거가 없으며, 고유층 결손인 성대구증 병변을 회복시키지도 못한다.\",\"3\":\"보툴리눔 독소 주입은 연축성발성장애의 치료로, 성대구증 환자에게 적응증이 아니다.\",\"4\":\"제II형 갑상성형술은 성문을 넓히는 수술이므로 이미 성문틈이 있는 환자에게는 반대 방향의 처치이다.\"}},\"1-3-2-6\":{\"w\":{\"2\":\"제II형 갑상성형술은 성문을 넓히는 수술(연축성발성장애 등)이므로, 성문 폐쇄 부전이 문제인 이 환자에게는 반대 방향의 처치이다.\",\"3\":\"건측 성대의 보상적 과내전은 성문 폐쇄를 돕고 있으므로, 보툴리눔 독소로 이를 없애면 음성이 더 악화된다.\",\"4\":\"흡수성 주입은 회복이 기대되는 시기의 임시 처치인데, 이 환자는 14개월 경과와 재신경화 징후 부재로 자연 회복을 기대하기 어렵다.\",\"5\":\"양측 후윤상피열근 절제술은 존재하지 않는 표준 술식이며, 편측 마비의 성문 폐쇄 부전을 해결하는 방법도 아니다.\"}},\"1-3-2-7\":{\"w\":{\"1\":\"기능적 음성장애로는 혀 위축, 섬유속연축, 손의 미세운동 저하를 설명할 수 없다.\",\"2\":\"음성 과사용에 의한 근피로로는 혀 위축·섬유속연축·사지 근력 저하를 설명하지 못하며, 지문에서 휴식 후에도 증상 변화가 없다.\",\"4\":\"내전형 연축성발성장애는 과제 특이적인 긴장성 음성 단절이 특징으로, 진행성 기식 음성과 혀·사지 증상을 보이는 이 사례와 다르다.\",\"5\":\"후두내시경에서 마비 소견이 없으며, 진행성 신경근 질환에서 밀기 기법 같은 근력 강화 훈련은 피로를 가중시킬 수 있다.\"}},\"1-3-2-8\":{\"p\":\"상기도 감염 후 고음이 나오지 않고 음성범위프로파일의 최고 주파수가 1옥타브 이상 감소했지만, 양측 성대의 내·외전 운동은 정상 범위이다. 음도 활주 시 좌측 성대가 짧고 처지며 후방 성문이 좌측으로 회전하는 비대칭은 한쪽 윤상갑상근이 약해졌을 때의 특징적 소견이다. 윤상갑상근은 상후두신경 외지의 지배를 받아 성대를 늘여 음도를 높이므로, 좌측 상후두신경 외지 마비로 판단한다. 성대 내전 기능은 유지되므로 내측화 수술보다 회복을 기다리며 음도 확장 훈련·건측 보상 등 음성치료를 하는 것이 중심이다.\",\"w\":{\"1\":\"되돌이후두신경 마비는 성대 내전이 안 되는 것인데 이 환자는 내·외전 운동이 정상이므로, 제I형 갑상성형술 같은 내측화 수술의 적응증이 아니다.\",\"3\":\"변성발성장애는 음도 활주 시 좌측 성대가 짧고 처지는 신경학적 비대칭 소견을 설명하지 못한다.\",\"4\":\"근긴장성발성장애는 상기도 감염 후 나타난 한쪽 성대의 길이 비대칭 같은 신경학적 소견을 설명하지 못한다.\",\"5\":\"양측 성대마비는 내·외전 운동 자체가 소실되는데, 이 환자는 양측 성대의 내·외전 운동이 정상 범위이다.\"}},\"1-3-2-9\":{\"w\":{\"1\":\"식도발성은 습득에 오랜 시간이 걸려 당장의 의사소통 대안이 되지 못한다.\",\"2\":\"진동 강도를 최대로 높여 목에 세게 누르면 조직 손상과 통증을 유발할 수 있다.\",\"3\":\"모든 무후두 발성 훈련을 1년 뒤로 미루면 의사소통 단절 기간이 길어진다.\",\"5\":\"기관식도천공 발성은 공기주입검사 등 별도의 적응 평가가 필요하므로 이 시점의 즉각적 해결책이 아니다.\"}},\"1-3-2-10\":{\"w\":{\"1\":\"천공 확대는 보철 둘레 누출의 원인인데, 이 사례는 주변 누출이 없고 가운데 구멍으로 새고 있다. 또한 둘레 누출이라도 더 큰 지름이 아니라 작은 지름·조직 수축 조치가 필요하다.\",\"2\":\"발성이 이전과 같이 잘 되므로 인두식도분절 경직은 원인이 아니다.\",\"3\":\"2년간 잘 작동해 온 TEP를 폐쇄할 이유가 없으며, 문제는 보철 교체로 해결할 수 있다.\",\"4\":\"보철 위치 이상을 시사하는 소견이 없고, 기공 폐쇄나 발성 연습은 밸브를 통한 흡인 위험을 해결하지 못한다.\"}},\"1-3-2-11\":{\"w\":{\"1\":\"비음 문장 비성치가 낮고 비음 공명도 약해 전형적 과다비성이 아니며, 비강 폐쇄로 과다비성이 과소평가될 수 있으므로 평가 없이 즉시 수술을 의뢰하는 것은 이르다.\",\"3\":\"구강음 문장의 높은 비성치(36 %), 모음 과다비성, 비강 난기류는 과소비성 단독으로 설명되지 않는다.\",\"4\":\"구강음 문장 비성치는 정상 상한을 크게 넘고 비음 문장 비성치는 정상보다 낮으므로 두 값 모두 정상 범위가 아니다.\",\"5\":\"과다비성과 비강 난기류는 연인두 폐쇄부전을 시사하므로 연인두 폐쇄가 정상이라는 전제가 틀렸고, 부는 연습은 연인두 폐쇄부전을 개선하지 못한다.\"}},\"1-3-2-12\":{\"w\":{\"2\":\"근긴장성발성장애는 음성치료에 반응하는 경우가 많고 이처럼 과제 특이적인 단절 양상을 보이지 않으므로, 6개월간 변화가 없던 치료를 그대로 이어가는 것은 부적절하다.\",\"3\":\"외전형 연축성발성장애는 무성자음이 많은 문장에서 숨이 새는 단절이 특징으로, 유성음 문장에서 쥐어짜는 단절을 보이는 이 환자와 반대 양상이다.\",\"4\":\"심인성 실성증은 대개 갑자기 시작되어 속삭임 음성이 지속되는 양상으로, 말하기에서만 쥐어짜는 단절이 나타나는 이 환자와 맞지 않는다.\",\"5\":\"이 환자의 문제는 성대 운동 저하가 아니라 과내전이므로 내측화 수술인 제I형 갑상성형술은 적응증이 아니다.\"}},\"1-3-2-13\":{\"p\":\"유치원 교사는 소음이 큰 교실에서 하루 6시간 이상 발화하며, 오후마다 쉰 목소리와 목 통증이 있고 주말이면 회복된다. 후두내시경의 경미한 발적·부종과 결절이 없는 소견은 직업적 음성 과사용의 초기 단계로, 음성 부하량을 낮추는 환경·행동 조정이 핵심이다. 확성기는 소음 환경에서 강도를 높이지 않고도 전달을 가능하게 해 부하를 실질적으로 줄이며, 짧고 잦은 휴식·소음 감소·수분 섭취와 함께 쓰면 음성 사용을 줄이기 어려운 현실에도 적용할 수 있다.\",\"w\":{\"1\":\"속삭임은 성대 접촉을 줄이는 듯 보이나 성대에 오히려 긴장을 주어 해롭다.\",\"2\":\"멘톨과 카페인은 점막을 건조하게 하므로 목을 푸는 방법으로 적절하지 않다.\",\"4\":\"장기 절대 음성휴식은 근거가 없고, 음성 사용을 줄이기 어려운 직업적 상황에서 비현실적이다.\",\"5\":\"큰 소리 훈련은 음성 부하를 더 늘려 초기 부종을 병변으로 진행시킬 위험이 있다.\"}},\"1-3-2-14\":{\"p\":\"대상자는 말할 때 어깨가 들리는 얕은 쇄골호흡과 짧은 구절 단위의 잦은 호흡, MPT 8초를 보여 호흡 지지가 부족하다. 그 결과 음성이 약하고 기식적이며, 리듬과 억양 변화가 거의 없는 단조로운 말이 나타난다. 악센트 기법은 복식(횡격막)호흡을 기반으로 느린 템포부터 빠른 템포까지 리듬적 강세를 주며 발성하여 호흡-발성-조음의 협응을 개선하고 음성의 역동성을 높이므로, 이 대상자의 문제에 가장 잘 맞는다.\",\"w\":{\"1\":\"리실버만음성치료(LSVT)는 파킨슨병의 감소된 강도에 특화된 방법으로, 쇄골호흡과 단조로운 리듬 문제를 겨냥하지 않는다.\",\"2\":\"손가락 조작법은 변성발성장애에서 습관적 음도를 낮추는 기법으로, 이 대상자의 호흡·리듬 문제와 무관하다.\",\"3\":\"흡기발성은 가성대 발성이나 기능적 실성증에 쓰는 기법으로, 호흡 지지 부족과 단조로운 억양을 다루지 못한다.\",\"5\":\"차폐 기법은 롬바르드 효과로 강도만 올리는 방법이어서 쇄골호흡 양상과 리듬 문제를 다루지 못한다.\"}},\"1-3-2-15\":{\"w\":{\"1\":\"후두 하강법은 과기능성 음성장애의 이완 기법으로, 마비 성대의 성문 폐쇄를 돕는 이 절차와 목적이 다르다.\",\"2\":\"갑상연골을 앞에서 뒤로 눌러 성대를 느슨하게 해 음도를 낮추는 것은 변성발성장애의 손가락 조작법으로, 측면에서 안쪽으로 누르는 이 절차와 방향과 목적이 다르다.\",\"3\":\"후두 마사지는 과기능성 음성장애의 이완 기법으로, 마비 성대를 내측화하는 절차가 아니다.\",\"4\":\"지문의 절차는 성대를 늘여 음도 범위를 넓히는 것이 아니라 갑상연골 판을 측면에서 눌러 성대를 정중선 쪽으로 미는 것이다.\"}},\"1-3-2-16\":{\"w\":{\"1\":\"활동성 유두종 병변은 수술(필요 시 보조 약물)로 관리하는 것으로, 음성치료로 소실시키거나 재발을 막을 수 없다.\",\"3\":\"밀기 기법과 강한 성문파열음은 이미 있는 과기능을 강화하고 반흔 조직에 부담을 준다.\",\"4\":\"유두종은 일상적 대면 치료로 전염되는 것이 아니므로 대면 치료를 중단할 이유가 없다.\",\"5\":\"전교련 웹과 반흔 같은 구조적 손상이 있어 완전한 정상 음성 회복은 비현실적인 목표이다.\"}},\"1-3-2-17\":{\"w\":{\"2\":\"속삭임은 성대를 강하게 벌리고 후두 긴장을 높여 오히려 해로우며, 비밀스러운 음성은 유성음을 유지한다는 점에서 속삭임과 다르다.\",\"3\":\"장기간 사용하면 기식성 발성이 습관화될 수 있으므로 수술 직후 단기간만 쓰는 과도기적 방법이다.\",\"4\":\"목을 조여 작은 소리를 내면 과기능을 유발하므로, 편안하게 강도만 낮춘 음성이어야 한다.\",\"5\":\"비밀스러운 음성은 음성휴식을 완전히 대체하지 않으므로 말하는 양도 함께 조절해야 한다.\"}},\"1-3-2-18\":{\"w\":{\"1\":\"속삭임은 후두 긴장을 높여 회복에 해로우므로 리허설 방식으로 적절하다고 확인해 주어서는 안 된다.\",\"2\":\"밀기 기법은 염증이 있는 성대의 부하를 더 늘려 손상 위험을 높인다.\",\"3\":\"출혈·종괴가 없는 급성 염증은 수술 대상이 아니다.\",\"5\":\"고음 발성 연습을 늘리면 부종이 있는 성대에 부하가 더해져 손상 위험이 커진다.\"}},\"1-3-2-19\":{\"w\":{\"1\":\"성대결절은 양측 대칭 병변인데, 이 환자는 편측의 불규칙한 백색 병변이므로 결절로 판단할 수 없다.\",\"2\":\"라인케부종은 양측 전장의 반투명 부종으로, 편측 국소의 백색 융기 병변과 다르며 진단 없이 3개월을 기다리는 것은 위험하다.\",\"4\":\"접촉성 육아종은 성대돌기(후방) 부위의 병변으로, 성대 중간부의 백색 병변과 위치가 다르다.\",\"5\":\"구조적 병변이 뚜렷하므로 기능적 음성장애로 볼 수 없다.\"}},\"1-3-2-20\":{\"w\":{\"1\":\"역류 치료에 이미 반응하지 않았으므로 양성자펌프억제제 용량을 늘리는 것은 근거가 없다.\",\"2\":\"기침을 반복하면 후두 자극이 강화되어 기침이 다시 유발되는 악순환이 된다.\",\"3\":\"후두내시경에서 구조적 이상이 없으므로 성대결절이나 음성휴식과는 무관하다.\",\"4\":\"심인성으로 단정해 정신건강의학과에만 의뢰하는 것은 근거 있는 행동적 기침 억제 치료의 기회를 놓치는 부적절한 대응이다.\"}},\"1-3-2-21\":{\"w\":{\"2\":\"0.52는 성문폐쇄부전을 뜻하는 낮은 값이 아니라 정상 범위의 값이며, 과도했던 접촉이 줄어든 것이다.\",\"3\":\"EGG는 목에 댄 전극으로 성대 접촉 면적 변화를 기록하는 검사로, 성문하압을 측정하지 않는다.\",\"4\":\"접촉률은 한 주기 중 성대가 접촉된 시간의 비율이며, 점막파동의 진폭을 나타내지 않는다.\",\"5\":\"과기능 환자에게 접촉률 증가는 치료 목표가 아니며, 밀기 기법은 금기에 가깝다.\"}},\"1-3-2-22\":{\"w\":{\"1\":\"이중음성은 기본주파수 자체의 상승이 아니라 서로 다른 두 진동이 겹쳐서 생긴다.\",\"2\":\"지문에서 연인두 기능이 정상이므로 비강 공명으로 이 현상을 설명할 수 없다.\",\"3\":\"가성대 발성도 이중음성을 만들 수 있으나, 이 환자는 스트로보스코피에서 가성대 접근이 없다.\",\"5\":\"불완전한 성문 폐쇄에 의한 기류 소음은 기식성(B1)을 설명할 뿐, 두 음이 동시에 들리는 현상을 설명하지 못한다.\"}},\"1-3-2-23\":{\"p\":\"테스토스테론 치료 10개월 만에 습관적 F0가 210 Hz에서 125 Hz로 낮아져 이미 성인 남성 범위에 들어왔으므로, 음도 자체를 바꾸는 수술은 필요하지 않다. 문제는 갈라짐과 갑작스러운 고음 같은 음도 불안정, 그리고 목 피로·조임과 내시경의 전후 압축·가성대 접근으로 나타나는 과기능이다. 이는 변화한 후두에 맞는 발성 조절을 아직 익히지 못해 생기는 것이므로, 새 음도의 안정화와 과기능 감소를 목표로 하는 음성치료가 적절하다.\",\"w\":{\"1\":\"125 Hz는 이미 성인 남성 범위이며, 제III형 갑상성형술은 음도를 더 낮추는 수술로 이 사례의 적응증이 아니다.\",\"3\":\"밀기 기법은 이미 나타난 전후 압축·가성대 접근 같은 과기능을 악화시킨다.\",\"4\":\"호르몬 중단 권고는 언어재활사의 역할을 벗어나며, 증상은 음성치료로 다룰 발성 조절 문제이다.\",\"5\":\"가성구 발성 훈련은 낮아진 음도를 안정화하는 목표와 반대 방향이다.\"}},\"1-3-2-24\":{\"w\":{\"1\":\"갑상성형술은 성장 중인 영아의 후두에 시행하지 않으며, 회복 가능성이 있는 시기에는 영구 수술을 보류한다.\",\"2\":\"밀기 기법은 영아에게 적용할 수 없으며, 시급한 문제인 흡인과 수유 곤란을 해결하지도 못한다.\",\"3\":\"편측 마비는 기도 폐쇄를 일으키지 않으므로 기관절개술의 적응증이 아니다.\",\"4\":\"수유 중 기침·사레와 체중 증가 지연이 있는데 흡인 위험을 방치한 채 퇴원시키는 것은 위험하다.\"}},\"1-3-2-25\":{\"w\":{\"1\":\"왼쪽 3분법 기도역치는 (15+20+40)/3=25 dB HL로 경도 수준이다. 40 dB HL도, 중등도 판정도 그림의 왼쪽 기도역치(X)와 맞지 않는다.\",\"3\":\"오른쪽은 차폐 기도 60·65·70 dB HL과 차폐 골도 35·40·45 dB HL 사이에 25 dB의 기도-골도 차가 있다. 기골도차가 없다는 전제부터 틀렸으며, 골도도 상승해 있으므로 혼합성으로 본다.\",\"4\":\"헤드폰 기도검사에서 검사 귀 기도역치와 반대 귀 골도역치의 차가 이간감쇠(약 40 dB) 이상이면 교차청취가 일어날 수 있다. 오른쪽 500 Hz 기도 60 − 왼쪽 골도 15 = 45 dB이므로 차폐가 필요했고, 그래서 오른쪽은 차폐한 역치로 기록되었다.\",\"5\":\"오른쪽 3분법 기도역치는 (60+65+70)/3=65 dB HL로 중등고도에 해당한다. 55 dB HL은 250 Hz 한 주파수의 값일 뿐 3분법 평균이 아니다.\"}},\"1-3-2-26\":{\"w\":{\"1\":\"[kiba]에서는 /m/과 /p̚/ 두 종성이 모두 생략되었는데 이를 1회로 센 계산이다. 이중 생략을 각각 세면 분자는 6이 된다.\",\"2\":\"분자는 [kiba]의 이중 생략을 1회로 줄여 셌고, 분모는 종성이 없는 '바지'까지 기회로 넣어 12로 잡았다. 분자와 분모가 모두 틀렸다.\",\"4\":\"분자 6은 맞지만 분모 12는 종성이 없는 '바지'까지 2자리의 기회가 있는 것처럼 계산한 값이다. 출현 기회는 실제 종성 자리 10개이다.\",\"5\":\"자료에서 종성이 생략된 횟수는 6회이므로 분자 7은 과다 집계이다. 분모 12 역시 종성이 없는 '바지'를 기회에 포함한 오류이다.\"}},\"1-3-2-27\":{\"w\":{\"2\":\"4는 연구개음 중 치조음으로 전방화된 오류 개수이다. 정확도의 분자는 바르게 산출한 개수 3이어야 한다.\",\"3\":\"분모 8은 연구개음이 아닌 음까지 기회로 넣은 값이다. /kat̚t*aga/의 /t*/는 치조음, /tɕabas*ʌjo/의 /s*/는 치조 마찰음이므로 연구개 파열음 기회는 7개이다.\",\"4\":\"분자로 오류 수 4를, 분모로 연구개음이 아닌 음까지 포함한 8을 써서 둘 다 틀렸다. 정확히 산출한 연구개음 3개를 기회 7개로 나누어야 한다.\",\"5\":\"캐[kʰ]·가[g]·개[k] 세 개가 모두 연구개음으로 정확히 산출되었으므로 정반응은 2개가 아니라 3개이다.\"}},\"1-3-2-28\":{\"w\":{\"1\":\"연구개음은 [−전방성]이므로 아동 B만 [+전방성]을 잃었다. 아동 A가 산출한 양순음은 [+전방성]이어서 두 아동의 공통 상실 자질이 되지 못한다.\",\"2\":\"두 아동 모두 /ㄴ/을 [m] 또는 [ŋ]이라는 비음으로 바꾸었으므로 비음성은 유지되었다. /ㄷ/도 비음이 아닌 파열음으로 산출되어 비음성 변화가 없다.\",\"3\":\"목표 파열음은 파열음으로, 비음은 비음으로 산출되어 조음방법이 바뀌지 않았다. 따라서 지속성 자질에는 변화가 없다.\",\"5\":\"/ㄷ/이 평음 [ㅂ]이나 [ㄱ]으로 대치되어 평음이 그대로 유지되었다. 긴장성은 경음과 관련된 자질로 이 자료의 오류와 관계없다.\"}},\"1-3-2-29\":{\"p\":\"아동 A는 같은 낱말의 자음·모음 오류가 매번 다르고, 낱말이 길어질수록 오류가 급증하며, 모색행동과 균등한 강세를 보이고 근력·반사는 정상이다. 이는 신경근육 결함 없이 말운동의 계획·프로그래밍이 손상된 아동기 말실행증의 핵심 특징이다. 아동 B는 모든 음소의 일관된 약화·왜곡, 과다비성, 침 흘림, 혀·입술 근력 저하, 느린 말속도를 보여 신경근육 실행의 문제인 마비말장애에 해당한다. 따라서 비일관성·모색행동과 근력 저하·일관된 왜곡이라는 대비가 두 장애를 감별하는 근거가 된다.\",\"w\":{\"1\":\"두 아동의 소견을 서로 바꾸어 기술하였다. 근력 저하와 침 흘림은 아동 B의 소견이고, 아동 A는 근력이 정상이며 오류가 비일관적이다.\",\"2\":\"비일관적 오류는 아동 A에게만 있고 아동 B의 오류는 일관된 왜곡이다. 근력 저하 여부, 오류 일관성, 모색행동에서 두 아동이 뚜렷이 달라 감별이 가능하다.\",\"3\":\"/퍼터커/ 순서 오류는 있으나 /퍼퍼퍼/ 같은 단일 음절 반복이 정상인 양상은 순서화 결함인 말실행증에 가깝다. 마비말장애는 단일 음절 반복도 느리고 약하게 나타난다.\",\"4\":\"운동적 조음장애는 소수 음소에 국한된 일관된 오류가 특징이다. 아동 A는 오류가 비일관적이고 길이 효과·모색행동·운율 이상이 있어 말실행증의 양상에 맞다.\"}},\"1-3-2-30\":{\"w\":{\"1\":\"소리의 유무를 알아차리는 탐지 단계 활동이다. 아동은 이미 Ling 6음 탐지·변별이 가능하므로 위계상 지나치게 낮은 과제이다.\",\"2\":\"그림 두 장 중에서 고르는 폐쇄형 확인 과제이다. 아동은 그림 4장 폐쇄형 확인에서 이미 90%를 보였으므로 이미 통과한 수준이다.\",\"4\":\"긴 이야기를 듣고 다시 말하기는 이해 단계의 과제이다. 개방형 확인이 30%로 아직 미완성인 상태에서는 지나치게 어렵다.\",\"5\":\"독화 중심 연습은 시각 정보에 의존하게 하므로 청각 정보 처리를 훈련하는 청능훈련의 방향과 맞지 않는다. 인공와우로 탐지·변별·폐쇄형 확인이 가능한 아동에게 청각 경로를 포기할 이유가 없다.\"}},\"1-3-2-31\":{\"w\":{\"2\":\"오류 양상이 고주파수 청력 손실과 정확히 맞물리는데 이 원인을 무시한 해석이다. 마찰음을 충분히 듣지 못하는 상태에서 청각 변별 훈련만으로는 효과를 기대하기 어렵다.\",\"3\":\"구강 구조·운동 기능이 정상이고, 같은 조음 기관을 쓰는 /ㄷ/ 등은 정확하므로 혀 근력 부족의 근거가 없다. 비구어 구강운동을 먼저 하는 것은 오류 원인과 맞지 않는다.\",\"4\":\"/ㅁ, ㄴ, ㅂ, ㄷ/와 모음은 이미 정확하므로 비음을 다시 훈련할 필요가 없다. 문제는 고주파수 마찰음에 대한 청각 접근이다.\",\"5\":\"청각 모델을 반복해도 /ㅅ/ 산출이 개선되지 않았으므로 청각 단서를 더 크게 반복하는 것만으로는 충분하지 않다. 고주파수 청각 접근이 제한된 상황이므로 보청기 점검이 필요하다.\"}},\"1-3-2-32\":{\"w\":{\"1\":\"다른 압력자음과 모음에서 비강누출이 없고 비음치도 정상이므로 연인두폐쇄부전이 확실하다는 판단은 근거가 없다. 학습된 오조음은 인두피판술 같은 수술 대상이 아니다.\",\"3\":\"비음치가 정상이고 비음 산출 문제가 보고되지 않았으므로 과소비성이 아니다. 문제는 /ㅅ, ㅆ/에 국한된 비강누출이다.\",\"4\":\"구개거상기는 연인두 기능 문제를 보완하는 보철인데, 이 아동은 기질적 연인두 문제가 아니라 학습된 오조음이다. 보철 없이 구강 기류 유도 조음치료로 바로 접근할 수 있다.\",\"5\":\"다른 음소가 정상이고 코를 막으면 /ㅅ/를 정조음할 수 있어 소견이 학습된 오류에 부합한다. 청력 손실을 이유로 치료를 보류할 근거가 없다.\"}},\"1-3-2-33\":{\"w\":{\"1\":\"이 연령에서는 협조가 어려워 연인두 기능 평가는 발화 표본이 충분히 쌓인 뒤(대개 3세 전후) 실시한다. 평가 시점까지 중재를 보류할 이유가 없다.\",\"2\":\"/ㅅ, ㅈ/는 후기 발달음이고 독립음 반복 훈련은 14개월 영아에게 발달적으로 부적절하다. 이 시기에는 초기 발달음인 앞쪽 파열음을 놀이 속에서 촉진해야 한다.\",\"3\":\"성문파열음은 구개열 아동에게 생기기 쉬운 보상조음이다. 이를 강화하면 보상조음이 습관화되어 이후 교정이 어려워진다.\",\"5\":\"과다비성이 확인되지 않았고 영아에게는 구개거상기를 적용하지 않는다. 이 시기의 과제는 보철이 아니라 구강 압력자음 출현 촉진이다.\"}},\"1-3-2-34\":{\"w\":{\"1\":\"같은 목록 반복과 매 시행 즉각 피드백은 이미 시행해 온 습득기 조건이다. 이를 유지하면 낱말 수준 수행은 높아도 문장·대화로의 전이는 촉진되지 않는다.\",\"2\":\"낱말 수준에서 이미 95% 이상 확립되었으므로 독립음으로 되돌아가는 것은 불필요한 퇴행이다. 문제는 확립이 아니라 일반화이다.\",\"3\":\"시각·촉각 단서를 늘리면 단서 의존이 커져 일반화가 늦어진다. 낱말 정확도는 이미 충분하므로 더 높이는 것은 핵심 과제가 아니다.\",\"4\":\"치료사가 매 시행 혀끝 위치를 설명하는 수행 지식(KP) 피드백은 습득기 조건을 강화하는 것이다. 전이 단계에서는 피드백 빈도를 줄이고 결과 지식 위주로 바꾸어야 한다.\"}},\"1-3-2-35\":{\"w\":{\"1\":\"/ㄷ/는 이미 습득한 음소이고, 자질 차이를 최소로 하는 것은 최소대립쌍 접근의 논리이다. 최대대립·빈 집합 원리와 반대이다.\",\"2\":\"/ㅅ/와 /ㅆ/는 둘 다 미습득이지만 긴장성 자질 하나만 다르다. 자질 차이를 최대로 하라는 최대대립 원리에 맞지 않는다.\",\"4\":\"/ㅂ/와 /ㅁ/는 아동의 산출 목록에 이미 있는 음소이다. 습득된 음소끼리의 쌍은 치료 목표가 되지 않는다.\",\"5\":\"/ㅌ/와 /ㅋ/는 둘 다 미습득이지만 조음위치 자질 하나만 다르다. 빈 집합 조건은 만족해도 최대대립 조건은 만족하지 못한다.\"}},\"1-3-2-36\":{\"w\":{\"1\":\"음운지연은 정상 발달 과정의 패턴이 또래보다 늦게까지 남는 유형이다. 어두 초성 생략과 후방화는 비발달적 패턴이므로 음운지연으로 볼 수 없다.\",\"3\":\"비일관적 음운장애는 같은 낱말 반복 산출의 변이율이 40% 이상일 때 해당한다. 이 아동의 변이율은 8%로 일관적이다.\",\"4\":\"조음장애는 소수 음소의 일관된 왜곡이 특징이다. 이 아동은 생략·후방화라는 규칙적 오류패턴을 보이므로 개별 음소 운동의 문제가 아니다.\",\"5\":\"말실행증은 비일관성·모색행동·운율 이상을 동반하는데, 이 아동은 세 가지가 모두 없고 교대운동속도도 정상이다.\"}},\"1-3-2-37\":{\"w\":{\"2\":\"음운변동별 목표를 주기마다 순환하는 것은 주기법의 절차이다. 음운 체계 문제에 쓰는 방법으로, 운동 계획·프로그래밍 결함인 말실행증의 DTTC 원리와 다르다.\",\"3\":\"최소대립쌍의 의미 대조로 음운 체계를 재구조화하는 것은 음운장애 중재이다. 말실행증 아동의 운동 계획 문제를 직접 다루지 못한다.\",\"4\":\"말실행증은 근력 결함이 없으므로 근력을 키우는 비구어 구강운동은 근거가 없다. DTTC는 실제 말소리 산출을 반복하는 방식이다.\",\"5\":\"말소리 자질 개념을 상위언어적으로 인식시키는 것은 상위음운 접근으로, 음운 체계 문제에 쓰는 방법이다. 동시 산출과 단서 소거라는 DTTC 절차와 관련이 없다.\"}},\"1-3-2-38\":{\"w\":{\"1\":\"/ㅏ/ 모음 앞 어두라는 한 문맥만 반복하므로 문맥 간 비교가 불가능하다. 촉진 문맥을 찾으려면 모음과 위치를 체계적으로 바꾸어야 한다.\",\"2\":\"듣고 같은지 다른지 판단하는 변별 과제는 산출이 아닌 지각 검사이다. 어떤 문맥에서 정조음이 되는지 알려 주지 못한다.\",\"3\":\"긴 문장 따라말하기는 인접 모음이나 낱말 내 위치가 통제되지 않는다. 오류가 나타나도 어떤 문맥이 영향을 주었는지 분석하기 어렵다.\",\"5\":\"독립음 지속시간 측정은 음성 문맥이 없는 조건에서 이루어지므로 문맥 효과와 무관하다. 촉진 문맥 탐색이라는 목적에 맞지 않는다.\"}},\"1-3-2-39\":{\"w\":{\"1\":\"종성생략은 목표 낱말의 종성과 아동 산출을 비교해야 알 수 있는 관계분석 항목이다. 독립분석은 목표형과 비교하지 않으므로 이런 결론을 낼 수 없다.\",\"2\":\"자음정확도(PCC)는 목표 자음 대비 정확히 산출한 자음의 비율로, 목표형과의 비교가 필요한 관계분석 지표이다.\",\"3\":\"연구개음 전방화는 목표 연구개음이 앞쪽 음으로 바뀐 관계를 기술하는 것이므로 관계분석 항목이다. 독립분석으로는 판단할 수 없다.\",\"4\":\"표본에 치경음 /ㄷ, ㄴ/은 전혀 나타나지 않는다. 산출된 초성은 [ㅁ, ㅂ, ㅃ]뿐이다.\"}},\"1-3-2-40\":{\"w\":{\"2\":\"토끼에서 격음 /tʰ/가 평음 [t]로 바뀐 탈기식음화이다. 낱말 안에 /tʰ/를 평음으로 끌어당길 소리가 없어 문맥과 무관한 대치이다.\",\"3\":\"시소에서 마찰음 /ɕ, s/가 [t, d]로 바뀐 마찰음의 파열음화이다. 낱말 안에 영향을 줄 파열음이 없으므로 동화로 볼 수 없다.\",\"4\":\"라면에서 유음 /ɾ/가 활음 [j]로 바뀐 유음의 활음화이다. 문맥과 무관한 대치 변동이다.\",\"5\":\"책의 종성 /k̚/가 사라진 종성생략이다. 다른 소리에 닮아 간 것이 아니라 음이 탈락한 생략 변동이다.\"}},\"1-3-2-41\":{\"w\":{\"1\":\"인공와우는 고도~심도 난청이면서 보청기 이득이 제한적일 때 고려한다. 이 아동은 중등고도이고 보청기 이득이 충분하므로 적응증을 충족하지 않는다.\",\"3\":\"보청기 이득이 확인되었더라도 청능훈련은 청각 기술 발달을 위해 계속해야 한다. 청능훈련을 종결하고 조음치료만 하는 것은 부적절하다.\",\"4\":\"골도 보청기는 전음성·편측 난청 등에 쓰인다. 감각신경성 난청도 기도 보청기 효과가 있으며, 이 아동은 실제로 보청기 이득이 확인되었다.\",\"5\":\"보청기로 충분한 이득을 얻고 있어 인공와우 적응증을 충족하지 않는다. 한쪽 이식과 반대쪽 보청기 제거를 권할 근거가 없다.\"}},\"1-3-2-42\":{\"w\":{\"1\":\"매 시행 입 모양 시범을 먼저 보여 주면 이미 문제인 시각 의존이 더 강해진다. 청각 활용 원리와 반대 방향이다.\",\"2\":\"청각 단서를 배제하면 개방형 문장 지각 80%까지 발달한 청각 경로를 버리는 셈이다. 촉각 단서는 보조적으로만 쓰는 것이 원칙이다.\",\"3\":\"독화 훈련은 시각 정보 의존을 강화하여 청각 피드백 기반의 자기 모니터링 발달을 막는다. 청각 활용 원리와 맞지 않는다.\",\"5\":\"/ㅅ/ 왜곡도 청각 피드백을 활용해 수정할 수 있는 목표이다. 왜곡을 치료 대상에서 빼야 할 근거가 없다.\"}},\"1-3-2-43\":{\"w\":{\"1\":\"'잘 낼 수 있다'는 관찰·측정이 불가능한 표현이고, 조건과 준거도 없다. 목표 달성 여부를 판정할 수 없다.\",\"2\":\"'이해한다'는 내적 상태를 나타낼 뿐 관찰 가능한 행동이 아니다. 측정 기준도 제시되지 않았다.\",\"4\":\"치료사가 무엇을 할지를 적은 중재 절차이지 아동의 행동목표가 아니다. 행동목표의 주체는 아동이어야 한다.\",\"5\":\"몇 회, 몇 %라는 측정 기준이 없어 판정이 불분명하다. 대화 상황의 오류 소거는 확립 단계가 아닌 일반화 단계의 장기목표 수준이다.\"}},\"1-3-2-44\":{\"w\":{\"1\":\"모음의 제1·제2 포먼트는 모음·유음 왜곡의 피드백 지표이다. 마찰음의 치간음화 왜곡을 직접 보여 주지 못한다.\",\"2\":\"기본주파수(F0)는 음도를 반영하는 지표로 음성 치료에 쓰인다. 혀끝 위치와 관련된 마찰음 왜곡과 무관하다.\",\"3\":\"VOT는 파열음의 발성유형(평음·경음·격음)을 구분하는 지표이다. 마찰음 /ㅅ, ㅆ/의 조음 위치 문제를 반영하지 않는다.\",\"4\":\"음절 지속시간은 말속도·운율 피드백에 쓰는 지표이다. 치간음화 여부는 길이보다 마찰 소음의 주파수 분포로 드러난다.\"}},\"1-3-2-45\":{\"w\":{\"2\":\"자극반응도와 자연 회복의 관계를 반대로 기술하였다. 자극반응도가 없는 음소는 자연 회복 가능성이 낮아 오히려 치료가 필요하다.\",\"3\":\"자극반응도는 낱말 수준에만 한정하지 않고 독립음·음절 수준에서도 평가한다. /ㅋ/는 독립음·음절 수준에서 산출이 가능하므로 자극반응도가 있다.\",\"4\":\"낱말 수준에서 산출하지 못하더라도 독립음·음절 수준에서 가능하면 자극반응도가 있다고 본다. 평가 수준을 낱말로 잘못 제한한 판단이다.\",\"5\":\"자극반응도가 있으면 예후가 좋다는 뜻일 뿐 반드시 저절로 습득되는 것은 아니다. /ㅋ/도 음절 수준부터 확립하는 치료 목표로 삼아야 한다.\"}},\"1-3-2-46\":{\"w\":{\"1\":\"조음과 음운인식은 서로 관련되므로 순차적으로 분리하면 통합 중재의 이점을 잃는다. 입학 전이라는 시기를 고려하면 함께 다루는 것이 효율적이다.\",\"3\":\"음절 수 세기는 아동이 이미 통과한 수준이다. 실패한 음소 수준 과제로 나아가야 한다.\",\"4\":\"음소 탈락은 음운인식 중 가장 어려운 과제로, 첫소리 변별도 안 되는 아동에게 먼저 시키는 것은 발달 순서를 무시한 것이다.\",\"5\":\"자모 이름 암기는 음소 인식이나 말소리 산출과 직접 관련이 없다. 이를 조음치료보다 우선할 근거가 없다.\"}},\"1-3-2-47\":{\"w\":{\"1\":\"치료를 보류하면 혀 밀기 습관과 치간음화가 굳어지고 교정 효과도 해칠 수 있다. 자극반응도가 있어 지금 치료를 시작할 수 있다.\",\"2\":\"혀 밀기 삼킴은 교정 후 재발 요인이자 치간음화 지속과 관련된 요인이다. 이를 무관하다고 보고 방치하면 안 된다.\",\"4\":\"지문에 혀 근력 저하를 보여 주는 소견이 없다. 문제는 혀의 위치와 습관이며, 근력 운동만으로는 조음 오류를 다루지 못한다.\",\"5\":\"청소년·성인도 잔존오류 치료가 가능하며, 이 학생은 거울 단서로 정조음이 가능해 예후 근거도 있다. 치료 불가 안내는 부적절하다.\"}},\"1-3-2-48\":{\"w\":{\"1\":\"종성만 생략된 것이 아니라 음절이 통째로 사라진 오류이다. [nɛŋgo]에서는 종성 /ŋ/도 정확히 산출되었다.\",\"2\":\"[kʰok*i], [nɛŋgo], [tɕagʌ]에서 연구개음이 정확히 산출되어 전방화의 근거가 없다.\",\"3\":\"각 음소는 단독으로 산출 가능하므로 개별 음소 오류가 주된 문제가 아니다. 음소별 전통적 접근은 낱말 길이에 따른 음절 생략이라는 본질을 다루지 못한다.\",\"5\":\"같은 낱말을 매번 다르게 산출한다는 비일관성의 근거가 자료에 없다. 오류는 다음절 낱말의 음절 생략으로 일정한 양상을 보인다.\"}},\"1-3-2-49\":{\"w\":{\"1\":\"기초선은 20~30의 10%p 범위에서 변동하고 상승 추세도 없어 비교적 안정적이다. 중재를 시작하기에 부적절한 시점이라고 볼 근거가 없다.\",\"2\":\"6회기 값은 30으로 기초선 최고점 30과 같을 뿐 초과하지 않았다. 따라서 중재 첫 회기부터 최고점을 초과했다는 기술은 그래프와 맞지 않는다.\",\"4\":\"6회기 값 30은 최고점과 같아 PND 계산에서 제외되므로 PND는 100%가 아니라 90%이다. 또한 A-B 설계로는 실험적 통제를 입증할 수 없다.\",\"5\":\"평균 차이가 커도 A-B 설계에는 효과의 반복 입증이 없어 성숙·외부 사건 등의 대안 설명을 배제할 수 없다. 반전 구간 없이 기능적 관계가 실험적으로 입증되었다고 볼 수 없다.\"}},\"1-3-2-50\":{\"w\":{\"1\":\"A2에서 수행이 유지된 것은 반전이 일어나지 않았다는 뜻으로, ABAB 설계의 논리에서는 기능적 관계를 입증하지 못한 결과이다. 이를 강력한 효과의 증거로 본 것은 반대로 해석한 것이다.\",\"3\":\"기능적 관계가 입증되지 않았다는 것이 곧 중재 효과가 없었다는 뜻은 아니다. B1의 상승을 우연으로 단정하고 중재를 종료할 근거가 없다.\",\"4\":\"행동이 떨어질 때까지 중재를 무기한 철회하는 것은 아동에게 필요한 중재를 보류하는 것이어서 윤리적으로 문제가 된다. 비가역적 기술이라면 설계 자체를 바꾸는 것이 적절하다.\",\"5\":\"기대와 다른 자료를 근거 없이 기록 오류로 간주해 제외하는 것은 자료의 임의 조작이다. A2 자료는 설계 해석에 필수적인 구간이다.\"}},\"1-3-2-51\":{\"w\":{\"1\":\"같은 목표 음소에 두 중재를 적용하면 한 중재의 효과가 다른 중재의 결과에 섞여 어느 중재 때문에 향상되었는지 구분할 수 없다.\",\"2\":\"실시 순서를 매 회기 고정하면 먼저 실시한 중재가 유리하거나 불리해지는 순서 효과가 결과에 혼입된다.\",\"3\":\"단일대상연구는 기초선과 반복 측정 자료의 시각적 분석을 기본으로 한다. 기초선을 생략하고 최종 정반응률만 t검정으로 비교하는 것은 설계 논리에 맞지 않는다.\",\"5\":\"아동이 선호하는 중재를 항상 먼저 실시하면 순서가 고정되어 순서 효과가 혼입된다. 선호도라는 변수까지 결과에 섞이게 된다.\"}},\"1-3-2-52\":{\"p\":\"지문에서 새 선별검사와 이미 표준화된 기존 어휘검사를 아동 120명에게 '같은 날' 실시하고 두 점수의 상관(r = .82)을 구하였다. 이처럼 새 검사와 타당성이 확립된 준거 검사를 같은 시점에 실시해 상관을 구하는 것은 준거관련 타당도 중 공인(동시)타당도이다. 상관이 높을수록 새 검사가 기존 검사와 같은 능력을 측정한다는 근거가 된다.\",\"w\":{\"2\":\"예측타당도는 일정 기간 뒤의 준거(예: 1년 후 언어장애 진단 여부)를 예측하는 정도이다. 지문은 같은 날 두 검사를 실시했으므로 예측타당도가 아니다.\",\"3\":\"내용타당도는 문항이 측정하려는 영역을 잘 대표하는지에 대한 전문가 판단이다. 다른 검사와의 상관을 구하는 절차가 아니다.\",\"4\":\"검사-재검사 신뢰도는 같은 검사를 시간 간격을 두고 두 번 실시한 결과의 일관성이다. 지문은 서로 다른 두 검사를 같은 날 실시하였다.\",\"5\":\"반분 신뢰도는 한 검사를 두 부분으로 나누어 얻는 내적 일관성이다. 외부 준거 검사와의 상관과는 관계가 없다.\"}},\"1-3-2-53\":{\"w\":{\"1\":\"유의하지 않다는 것은 효과가 없다는 증명이 아니다. 작은 표본에서 d = 0.92의 큰 효과가 관찰되었으므로 '효과 없음'으로 단정할 수 없다.\",\"2\":\"효과크기는 통계적 유의성과 함께 보고해야 하는 정보이다. 특히 표본이 작을 때는 효과의 실제 크기를 판단하는 데 중요하다.\",\"3\":\"1종 오류는 효과가 없는데 있다고 판단하는 오류이다. 이 연구는 유의하지 않은 결과이므로 상황에 맞지 않으며, 우려되는 것은 오히려 2종 오류이다.\",\"4\":\"결과를 본 뒤 유의수준을 .10으로 올려 유의하다고 보고하는 것은 통계 원칙과 연구 윤리에 어긋난다. 유의수준은 분석 전에 정해야 한다.\"}},\"1-3-2-54\":{\"p\":\"자료를 2×2 표로 정리하면, 언어장애 16명 중 양성 14명(진양성)·음성 2명(위음성), 비장애 64명 중 양성 16명(위양성)·음성 48명(진음성)이다. 민감도는 실제 장애 아동 중 선별 양성의 비율로 14/16 × 100 = 87.5%이다. 특이도는 실제 비장애 아동 중 선별 음성의 비율로 (64 − 16)/64 × 100 = 48/64 × 100 = 75%이다. 따라서 민감도 87.5%, 특이도 75%가 옳다.\",\"w\":{\"1\":\"민감도와 특이도의 값을 서로 바꾸어 적었다. 민감도는 14/16 = 87.5%, 특이도는 48/64 = 75%이다.\",\"3\":\"30명은 선별 양성 전체(14 + 16)이므로 14/30 = 46.7%는 양성예측도이다. 민감도는 실제 장애 아동 16명을 분모로 한다.\",\"4\":\"16/64 = 25%는 비장애 아동 중 양성으로 잘못 분류된 비율, 곧 위양성률이다. 특이도는 비장애 아동 중 음성 비율인 48/64 = 75%이다.\",\"5\":\"2/16 = 12.5%는 장애 아동을 놓친 위음성률이다. 위양성률은 16/64 = 25%이다.\"}},\"1-3-2-55\":{\"w\":{\"1\":\"자폐스펙트럼장애의 확정 진단은 의사의 영역이다. 언어재활사가 '진단됨'이라고 쓰는 것은 업무 범위를 벗어난다.\",\"2\":\"어머니의 양육 시간이 적다는 보고만으로 언어지연의 원인을 단정하는 것은 근거 없는 인과 귀인이다. 보고서에는 확인된 사실만 기술해야 한다.\",\"3\":\"'게으르고 비협조적'은 가치 판단이 담긴 표현으로 보고서에 부적절하다. 관찰된 행동을 객관적으로 기술해야 한다.\",\"5\":\"원점수만으로는 또래 대비 수준을 알 수 없다. 표준점수·백분위·등가연령 등 규준 참조 없이 지체 정도를 판정한 해석 오류이다.\"}},\"1-3-2-56\":{\"p\":\"보호자에게 받은 동의서에는 녹화 목적이 '임상 슈퍼비전'으로 명시되어 있다. 개인정보인 영상은 동의받은 목적 범위 안에서만 이용할 수 있으며, 목적이 학부 강의 자료로 달라지면 활용 목적·범위·대상을 명시한 별도 동의를 보호자에게 새로 받아야 한다. 따라서 강의에 사용하기 전에 새 동의를 받는 것이 적절하다.\",\"w\":{\"2\":\"기존 동의는 슈퍼비전 목적에 한정된 것이다. 녹화 자체에 동의했더라도 다른 목적의 이용까지 동의한 것은 아니다.\",\"3\":\"얼굴을 모자이크해도 음성·발화 내용 등으로 개인을 식별할 가능성이 남는다. 모자이크가 동의를 대신하지 못한다.\",\"4\":\"교육 목적이라는 이유만으로 개인정보 이용 동의가 면제되지 않는다. 목적이 바뀌면 새로 동의를 받아야 한다.\",\"5\":\"치료 종결이나 기관 보관 여부는 이용 목적 제한을 해제하지 않는다. 기관이 보관하는 자료라도 동의받은 목적 밖으로 자유롭게 쓸 수 없다.\"}},\"1-3-2-57\":{\"w\":{\"1\":\"슈퍼바이저가 회기 계획을 대신 작성하는 지시적 방식은 초기의 평가-피드백 단계에 맞는다. 스스로 계획을 세우는 학생의 수준보다 낮다.\",\"3\":\"학생이 아직 독립적으로 문제를 해결하지 못하므로 자기 슈퍼비전 단계로 볼 수 없다. 관찰과 피드백을 모두 중단하는 것은 내담자 보호 책무에도 어긋난다.\",\"4\":\"모든 임상 결정을 슈퍼바이저가 내리는 것은 지시적 방식으로 초기 단계에 해당한다. 학생의 성장 수준을 반영하지 못한다.\",\"5\":\"요청할 때만 개입하는 자문 방식은 자기 슈퍼비전 단계에 해당한다. 회기 관찰을 하지 않으면 내담자 보호 책무도 다하지 못한다.\"}},\"1-3-2-58\":{\"p\":\"뇌전증 병력 아동이 전신 경직-간대 발작을 보일 때는 억제하거나 입에 물건을 넣지 않는다. 주변 위험물을 치우고 머리를 보호하여 부상을 막고, 옆으로 눕혀 회복 자세로 기도를 확보한다. 발작 시작 시각을 확인하여 5분 이상 지속되거나 반복되거나 호흡 곤란이 있으면 119에 신고한다. 따라서 3번 보기가 가장 적절한 대처이다.\",\"w\":{\"1\":\"발작 중 입에 설압자나 손수건을 넣으면 치아 손상과 기도 폐쇄 위험이 있다. 기도 확보는 옆으로 눕히는 방법으로 한다.\",\"2\":\"경련하는 팔다리를 붙잡아 억제하면 골절 등 부상 위험이 있다. 움직임을 막지 말고 주변 위험물을 치워야 한다.\",\"4\":\"의식이 불분명한 상태에서 물을 마시게 하면 흡인 위험이 있다. 의식이 회복될 때까지 입으로 아무것도 주지 않는다.\",\"5\":\"발작 후에는 회기를 중단하고 보호자에게 즉시 알리며 기록을 남겨야 한다. 회기를 바로 재개하고 회기 후에 알리는 것은 부적절하다.\"}},\"1-3-2-59\":{\"p\":\"표준주의 원칙에 따라 회기 전후와 구강 접촉 도구를 다룬 뒤의 손위생(ㄱ), 아동이 입에 넣는 장난감의 회기별 세척·소독 후 재사용(ㄴ), 수족구병 등 전염성 질환의 전염 가능 기간 동안 회기 연기(ㄹ)는 옳은 지침이다. 반면 설압자 같은 구강 접촉 일회용품은 소독하더라도 다른 아동에게 재사용해서는 안 되므로 ㄷ은 틀렸다. 따라서 옳은 것은 ㄱ, ㄴ, ㄹ이다.\",\"w\":{\"1\":\"ㄱ, ㄴ은 옳지만 전염성 질환 아동의 회기 연기(ㄹ)도 옳은 지침인데 빠졌다.\",\"2\":\"일회용품을 소독 후 재사용할 수 있다는 ㄷ은 틀린 지침이다. 또한 옳은 지침인 ㄴ과 ㄹ이 빠졌다.\",\"3\":\"틀린 지침인 ㄷ을 포함했고, 가장 기본적인 손위생 지침인 ㄱ이 빠졌다.\",\"5\":\"설압자 등 일회용품은 소독하더라도 재사용해서는 안 되므로 ㄷ을 포함한 이 조합은 틀렸다.\"}},\"1-3-2-60\":{\"w\":{\"2\":\"특수교육대상자 선정은 장애인 등록 여부와 별개이다. 등록하지 않은 아동도 진단·평가를 거쳐 선정될 수 있다.\",\"3\":\"치료지원은 배치 형태와 관계없이 특수교육대상자에게 제공되는 관련서비스이다. 일반학급이나 특수학급에 배치되어도 받을 수 있다.\",\"4\":\"특수교육대상자 선정에는 특수교육지원센터의 진단·평가와 특수교육운영위원회 심사라는 절차가 필요하다. 담임교사 단독 판단으로 치료지원이 제공되지 않는다.\",\"5\":\"발달재활서비스는 특수교육법상 학교 치료지원과 별개의 제도이다. 이를 이용 중이라고 해서 선정 절차 없이 학교 치료지원이 자동 연계되지 않는다.\"}},\"1-3-2-61\":{\"w\":{\"1\":\"후천적 원인은 장애가 고착된 뒤, 원칙적으로 발병 후 6개월 이상 치료한 뒤에 판정한다. 발병 즉시 언어검사 결과만으로 판정할 수 없다.\",\"2\":\"장애진단서는 의료기관의 전문의가 작성한다. 언어재활사는 검사 결과와 소견을 제공할 수 있으나 진단서를 작성할 수 없다.\",\"3\":\"장애 심사는 국민건강보험공단이 아니라 국민연금공단이 담당한다.\",\"4\":\"실어증은 언어장애 판정 대상에 포함된다. 등록할 수 없다는 안내는 틀렸다.\"}},\"1-3-2-62\":{\"w\":{\"2\":\"목표 A는 이미 준거를 충족했으므로 5회기 더 반복하는 것은 회기 낭비이다. 6회기째 정체된 목표 B를 그대로 유지하는 것도 자료에 반한다.\",\"3\":\"목표 A를 종결만 하고 상위 수준으로 나아가지 않는 것은 다음 목표를 놓친다. 목표 B를 삭제하면 아동에게 필요한 요구하기 기술을 방치하게 된다.\",\"4\":\"목표 B는 2어절 수준에서도 30~40%에 정체되어 있으므로 3어절로 상향하면 더 어려워진다. 절차를 세분화해야 할 상황에서 반대로 결정한 것이다.\",\"5\":\"목표 A는 준거를 충족했고 목표 B는 6회기 동안 정체되었으므로 이미 결정에 필요한 자료가 있다. 현재 절차를 그대로 유지하는 것은 자료에 반한다.\"}},\"1-3-2-63\":{\"p\":\"환자는 '어차피 병은 진행하는데 해봤자 소용없다'며 거부하지만, 손주와 전화 통화가 어려워진 것을 속상해한다는 점에서 변화에 대한 양가감정이 드러난다. 치료 동기가 낮은 성인에게는 공감·반영적 경청, 양가감정 탐색, 개인이 중요하게 여기는 목표와의 연결, 허락 후 정보 제공, 자율성 존중이라는 동기강화상담 원리가 적합하다. 따라서 손주와의 통화라는 목표와 치료를 연결하되 최종 결정은 환자에게 맡기는 접근이 가장 적절하다.\",\"w\":{\"1\":\"보호자를 통해 매일 강하게 권하는 것은 압박이 되어 저항을 키운다. 환자의 자기결정권도 침해한다.\",\"2\":\"거부 의사를 존중하는 것은 필요하지만 즉시 종결하면 양가감정을 다룰 기회를 놓친다. 환자가 중요하게 여기는 목표가 있으므로 탐색할 여지가 있다.\",\"3\":\"겁을 주어 동기를 높이려는 방식은 저항을 키우고 신뢰 관계를 해친다. 동기강화상담의 원리와 반대이다.\",\"5\":\"환자 모르게 보호자와 일정을 정하는 것은 환자를 의사결정에서 배제하여 자기결정권을 침해한다. 저항도 오히려 커진다.\"}},\"1-3-2-64\":{\"p\":\"임상 기록은 법적 문서이므로 수정할 때 원 기록의 흔적을 남겨야 한다. 오류 부분에 한 줄을 긋고 바른 내용, 수정 일자, 서명(필요하면 사유)을 적으면 누가 언제 무엇을 고쳤는지 추적할 수 있다. 이틀 뒤에 발견한 오류라도 같은 방식으로 수정하며, 전자기록도 수정 이력이 남도록 처리한다.\",\"w\":{\"1\":\"수정액으로 원 기록을 완전히 지우면 무엇이 바뀌었는지 추적할 수 없어 기록 위·변조 의혹을 낳는다.\",\"3\":\"페이지를 새로 작성하고 원본을 파기하면 원 기록이 사라져 위·변조 의혹을 낳는다. 원본은 흔적을 남긴 채 보존해야 한다.\",\"4\":\"구두 보고만으로는 기록 자체의 오류가 그대로 남는다. 기록의 정확성을 확보하려면 원 기록을 정해진 방식으로 수정해야 한다.\",\"5\":\"이전 기록의 오류를 그대로 두면 해당 회기 기록이 계속 틀린 채로 남는다. 다음 회기 기록에 적는 것으로는 정확성을 확보하지 못한다.\"}},\"1-3-2-65\":{\"p\":\"치료자가 자신의 내담자를 연구 대상으로 삼으면 치료 관계에서 오는 강압 가능성이 크다. 따라서 IRB 심의를 받고, 보호자 동의와 함께 아동 연령에 맞는 승낙을 받아야 한다. 또한 참여하지 않거나 중간에 철회해도 치료에 불이익이 없음을 보장해야 자발적 참여가 확보된다.\",\"w\":{\"1\":\"치료와 연구는 구별되므로 자신의 내담자라도 연구 참여에는 별도 동의가 필요하다. 동의를 생략하면 자발성을 침해한다.\",\"2\":\"미성년자라도 연령에 맞는 방식으로 아동 본인의 참여 의사(승낙)를 확인해야 한다. 보호자 동의만으로 아동의 의사를 무시해서는 안 된다.\",\"4\":\"참여 거부 시 치료 종결을 언급하는 것은 위협으로 작용하여 자발성을 침해한다. 불참해도 불이익이 없음을 알려야 한다.\",\"5\":\"참여 아동에게만 무료 추가 회기를 주는 것은 부당한 유인에 해당한다. 참여 결정이 자발적 판단이 아닌 이익에 좌우될 수 있다.\"}},\"1-3-2-66\":{\"w\":{\"1\":\"영업의 자유가 있더라도 허위·과장 광고까지 정당화되지는 않는다. 전문가로서 지켜야 할 정직성 윤리가 우선한다.\",\"2\":\"치료 결과는 대상자마다 다르므로 결과를 보장하는 것은 자신감의 표현이 아니라 소비자를 오인하게 하는 약속이다.\",\"3\":\"완치 사례가 1건 있더라도 모든 내담자에게 완치를 보장할 근거가 되지 않는다. 단일 사례로 일반화한 과장이다.\",\"4\":\"실명 후기를 게시하면 광고의 문제가 해결되지 않을 뿐 아니라 내담자 비밀유지 문제가 추가로 생긴다.\"}},\"1-3-2-67\":{\"w\":{\"1\":\"한국어에 능숙하더라도 8세 아동에게 통역을 맡기면 정보 왜곡과 정서적 부담, 가족 역할 혼란이 생긴다. 훈련된 통역사를 이용해야 한다.\",\"2\":\"번역 앱으로 결과지만 전달하고 질문을 받지 않으면 어머니가 결과를 정확히 이해하고 의견을 나눌 기회가 없다. 정보 접근권에 어긋난다.\",\"3\":\"크게 말한다고 언어 장벽이 해결되지 않는다. 한국어가 서툰 어머니는 평가 결과를 정확히 이해하기 어렵다.\",\"4\":\"어머니를 설명과 의사결정에서 배제하는 것은 정보 접근권과 가족중심 원칙에 어긋난다. 통역을 통해 어머니에게 직접 설명해야 한다.\"}},\"1-3-2-68\":{\"p\":\"ICF에서 문장 수준 말명료도 55%(㉠)는 음성·말 기능의 손상이므로 신체기능에 해당한다. 모둠 토론에서 발표를 전혀 하지 않는 것(㉡)은 학교라는 생활 상황에 관여하는 데의 제한이므로 참여에 해당한다. 소음이 큰 교실과 또래의 놀림(㉢)은 물리적 환경과 타인의 태도이므로 환경요인이고, 실패를 걱정해 말하기를 피하는 성향(㉣)은 성격·대처 방식 같은 개인의 특성이므로 개인요인이다.\",\"w\":{\"1\":\"말명료도(㉠)는 활동이 아니라 신체기능이고, 발표 회피(㉡)는 신체기능이 아니라 참여이다. 개인의 성향(㉣)도 참여가 아니라 개인요인이다.\",\"2\":\"㉠과 ㉡의 분류는 맞지만 환경요인과 개인요인을 서로 바꾸었다. 교실 소음과 또래의 놀림(㉢)은 환경요인, 말하기 회피 성향(㉣)은 개인요인이다.\",\"4\":\"말명료도 저하는 신체구조가 아니라 기능의 손상이다. 또래 놀림과 소음(㉢)은 환경요인, 회피 성향(㉣)은 개인요인이어서 두 분류도 틀렸다.\",\"5\":\"말명료도(㉠)를 참여로, 모둠 토론 발표 회피(㉡)를 활동으로, 개인의 성향(㉣)을 신체기능으로 분류하여 신체기능·활동·참여를 뒤섞었다.\"}}};\n</script>\n<script>\n// ═════════ 상태 ═════════\nlet Q = [];                  // 이번 시험 문항\nlet answers = [], checks = [], memos = [], strikes = [];\nlet page = 0, perPage = 1, filter = 'all', fontScale = 1;\nlet limitSec = 0, remainSec = 0, timerId = null, warned = false, warned10 = false;\nlet paused = false, pauseCount = 0, accPauses = 0;\nlet awaitEnd = false, submitRemain = null;   // 제출 완료 창이 떠 있는지 · 마지막으로 제출할 때 남은 시간   // 일시정지 중인지 · 이번 교시 횟수 · 앞 교시까지 합계\nlet memoTarget = -1, submitted = false, startedAt = null;\nlet hlStore = {}, penMode = 'off';   // 형광펜: 하이라이트 저장소 + 모드(off/on)\n\nconst $ = id => document.getElementById(id);\nconst show = id => $(id).classList.remove('hidden');\nconst hide = id => $(id).classList.add('hidden');\n// 문항 이미지 크게 보기(팝업)\n// 떠 있는 창(메모·계산기·그림판·이미지): 누른 창을 맨 위로\nfunction raiseWin(win){ document.querySelectorAll('.float-win').forEach(w => w.style.zIndex = ''); win.style.zIndex = 75; }\ndocument.addEventListener('mousedown', e => { const w = e.target.closest && e.target.closest('.float-win'); if(w) raiseWin(w); }, true);\nfunction fitImgWin(){\n  const win = $('imgWin'), img = $('lbImg'), vw = innerWidth, vh = innerHeight;\n  if(vw < 700){ Object.assign(win.style, {left:'0px', top:'0px', width:vw+'px', height:vh+'px'}); return; }\n  const head = win.querySelector('.fw-head').offsetHeight || 40, pad = 16;\n  const nw = img.naturalWidth || 800, nh = img.naturalHeight || 500;\n  let bw = Math.min(nw, vw*0.8 - pad), bh = bw * nh / nw;\n  const maxBh = vh*0.8 - head - pad;\n  if(bh > maxBh){ bh = maxBh; bw = bh * nw / nh; }\n  const w = Math.max(320, bw + pad), h = Math.max(200, bh + head + pad);\n  Object.assign(win.style, {width:w+'px', height:h+'px', left:Math.round((vw-w)/2)+'px', top:Math.round((vh-h)/2)+'px', right:'auto', bottom:'auto'});\n}\nfunction openImg(src){\n  const win = $('imgWin'), img = $('lbImg'), wasOpen = !win.classList.contains('hidden');\n  img.onload = () => { if(!wasOpen) fitImgWin(); };\n  img.src = src;\n  show('imgWin'); raiseWin(win);\n  if(!wasOpen && img.complete && img.naturalWidth) fitImgWin();\n}\nfunction closeImg(){ hide('imgWin'); $('lbImg').removeAttribute('src'); }\ndocument.addEventListener('keydown', e => { if(e.key==='Escape' && !$('imgWin').classList.contains('hidden')) closeImg(); });\naddEventListener('resize', () => { if(!$('imgWin').classList.contains('hidden') && innerWidth < 700) fitImgWin(); });\nconst circled = i => ['①','②','③','④','⑤'][i];\n// 해설 + 상세해설. 상세해설(details.js, 키 = 급수-회차-교시-번호)이 있는 문항에만 버튼이 붙는다.\n// 정답 근거가 해설과 거의 겹치는 문항은 details.js에 p가 없어서 오답 점검만 보인다.\n// 펼침 상태는 이 기기에 기억해서 다음 문항·다음 접속에도 그대로 둔다.\ntry{ if(localStorage.getItem('kcbt_show_detail')==='1') document.documentElement.classList.add('show-detail'); }catch(e){}\nfunction toggleDetail(){\n  const on = document.documentElement.classList.toggle('show-detail');\n  try{ localStorage.setItem('kcbt_show_detail', on ? '1' : '0'); }catch(e){}\n}\nfunction explainHTML(q, k){\n  const base = q.explain ? `<div class=\"rv-explain\"><b>해설</b> · ${esc(q.explain)}</div>` : '';\n  const d = k && (window.DETAILS || {})[k];\n  if(!d) return base;\n  const wr = Object.keys(d.w).sort().map(n => `<li>${circled(n - 1)} ${esc(d.w[n])}</li>`).join('');\n  return base + `<div class=\"rv-dbtn-row\"><button type=\"button\" class=\"wbtn rv-dbtn\" onclick=\"toggleDetail()\"><span class=\"d-open\">상세해설 보기 ▾</span><span class=\"d-close\">상세해설 접기 ▴</span></button></div>`\n    + `<div class=\"rv-detail\">${d.p ? `<div class=\"rv-dt\"><b>정답 근거</b> · ${esc(d.p)}</div>` : ''}<div><b>오답 점검</b><ul>${wr}</ul></div></div>`;\n}\n\n// ═════════ 시작 화면 ═════════\n// 급수(1급/2급)별 시험 구조. 급수 → 회차(set) → 교시(session) 순으로 선택한다.\n// 문항 데이터에 존재하는 급수·회차만 버튼으로 노출하고, 1개뿐이면 그 선택 UI는 숨긴다.\n// 2급 실제 구조: 1교시 신경언어30·유창성25·음성25(80) / 2교시 언어발달35·조음음운35(70) = 150문항(현장실무 없음).\nconst GRADE_META = {\n  1: { title: '1급 언어재활사 모의 CBT',\n       sess: { 1: { label: '1교시 (신경언어·언어발달·유창성)', min: 75 },\n               2: { label: '2교시 (음성·조음음운·현장실무)', min: 70 } } },\n  2: { title: '2급 언어재활사 모의 CBT',\n       sess: { 1: { label: '1교시 (신경언어·유창성·음성)', min: 75 },\n               2: { label: '2교시 (언어발달·조음음운)', min: 65 } } },\n};\nlet chosenGrade = 1, chosenSet = 1, chosenSess = 1;\n\nconst qGrade = q => q.grade || 1;\nconst qSet   = q => q.set   || 1;\n// HIDDEN_SETS(questions.js)에 적힌 급수/회차는 앱에서 보이지 않게 한다(비공개 세트).\nconst isHidden = q => (window.HIDDEN_SETS || []).some(h => h.grade === qGrade(q) && h.set === qSet(q));\nconst VIS = () => QUESTIONS.filter(q => !isHidden(q));\nfunction availableGrades(){ return Array.from(new Set(VIS().map(qGrade))).sort((a,b)=>a-b); }\nfunction availableSets(g){ return Array.from(new Set(VIS().filter(q=>qGrade(q)===g).map(qSet))).sort((a,b)=>a-b); }\nfunction availableSessions(){ return [1,2].filter(s => VIS().some(q=>qGrade(q)===chosenGrade && qSet(q)===chosenSet && q.session===s)); }\nfunction gradeMeta(){ return GRADE_META[chosenGrade] || GRADE_META[1]; }\nfunction sessMeta(s){ return gradeMeta().sess[s] || { label: s+'교시', min: 70 }; }\n\nfunction poolFor(s){ return VIS().filter(q => q.session===s && qGrade(q)===chosenGrade && qSet(q)===chosenSet); }\nfunction minutesFor(s){ return sessMeta(s).min; }\n// 선택한 교시부터 진행, 끝나면 나머지 교시 이어풀기 — 존재하는 교시 기준으로 큐 구성.\nfunction sessionQueueFrom(s){ const av = availableSessions(); return s===av[0] ? av.slice() : av.slice().reverse(); }\nfunction setLabel(){ return availableSets(chosenGrade).length > 1 ? ` ${chosenSet}회차` : ''; }\nfunction examTitle(){ return gradeMeta().title; }\n\n// 급수·회차·교시 버튼을 데이터에 맞춰 다시 그린다.\nfunction renderStartSelectors(){\n  const grades = availableGrades();\n  if(!grades.includes(chosenGrade)) chosenGrade = grades[0] || 1;\n  const gRow=$('gradeRow'), gBox=$('gradeBtns');\n  if(grades.length <= 1){ if(gRow) gRow.style.display='none'; }\n  else if(gRow && gBox){\n    gRow.style.display='';\n    gBox.innerHTML = grades.map(g=>`<button class=\"sess-btn${g===chosenGrade?' active':''}\" data-grade=\"${g}\">${g}급</button>`).join(' ');\n    gBox.querySelectorAll('button').forEach(b=>b.onclick=()=>{\n      chosenGrade=+b.dataset.grade; chosenSet=availableSets(chosenGrade)[0]||1; renderStartSelectors();\n    });\n  }\n  const sets = availableSets(chosenGrade);\n  if(!sets.includes(chosenSet)) chosenSet = sets[0] || 1;\n  const sRow=$('setRow'), sBox=$('setBtns');\n  if(sets.length <= 1){ if(sRow) sRow.style.display='none'; }\n  else if(sRow && sBox){\n    sRow.style.display='';\n    sBox.innerHTML = sets.map(s=>`<button class=\"sess-btn${s===chosenSet?' active':''}\" data-set=\"${s}\">${s}회차</button>`).join(' ');\n    sBox.querySelectorAll('button').forEach(b=>b.onclick=()=>{ chosenSet=+b.dataset.set; renderStartSelectors(); });\n  }\n  const av = availableSessions();\n  if(!av.includes(chosenSess)) chosenSess = av[0] || 1;\n  const seBox=$('sessBtns');\n  if(seBox){\n    seBox.innerHTML = av.map(s=>`<button class=\"sess-btn${s===chosenSess?' active':''}\" data-sess=\"${s}\">${sessMeta(s).label}</button>`).join(' ');\n    seBox.querySelectorAll('button').forEach(b=>b.onclick=()=>{ chosenSess=+b.dataset.sess; renderStartSelectors(); });\n  }\n  updateStartInfo();\n}\nfunction updateStartInfo(){\n  const other = availableSessions().find(x=>x!==chosenSess);\n  $('stTitle').textContent = examTitle() + setLabel() + ` ${chosenSess}교시`;\n  const tail = other ? ` · 제출 후 ${other}교시 이어풀기 선택` : '';\n  $('stTime').textContent = `${poolFor(chosenSess).length}문항 / ${minutesFor(chosenSess)}분${tail}`;\n}\nfunction tickClock(){\n  const d = new Date();\n  const nd = $('nowDate'), nt = $('nowTime');\n  if(nd) nd.textContent = d.toLocaleDateString('ko-KR');\n  if(nt) nt.textContent = d.toLocaleTimeString('ko-KR', {hour12:false});\n}\nsetInterval(tickClock, 1000); tickClock();\n$('stDate').textContent = new Date().toLocaleDateString('ko-KR');\nrenderStartSelectors();\n\n// ═════════ 로그인 · 기기 바인딩 (베타) ═════════\n// 각 계정(slp01~)은 최초 로그인한 기기 1대에서만 사용 가능.\n// deviceId: 이 브라우저에 저장되는 임의 식별자. Firestore users/{uid}.device 와 일치해야 입장.\nconst EMAIL_DOMAIN = '@kcbt.test';           // slp01 → slp01@kcbt.test (실제로 발송되지 않는 가짜 도메인)\nlet fbAuth = null, fbDb = null, CURRENT_ID = null, loginInProgress = false;\n\n// 체험 계정 제한 — users/{uid}.plan 이 'set1'이면 체험판 사이트에서만 쓸 수 있고,\n// users/{uid}.trialGrade(1 또는 2) 에 적힌 급수의 체험판 사이트에서만 입장된다.\n// 체험판 사이트는 자기 Firebase 설정 파일에서 IS_TRIAL_SITE=true, TRIAL_GRADE=급수 를 켠다.\nconst TRIAL_SITE = !!window.IS_TRIAL_SITE;\nconst TRIAL_GRADE = +(window.TRIAL_GRADE || 1);\nconst TRIAL_URLS = { 1: 'cbt1.sososoop.com', 2: 'cbt2.sososoop.com' };\nfunction trialGradeOf(data){ return +((data && data.trialGrade) || 1); }   // 없으면 1급(기존 계정 호환)\n// users/{uid}.trialEnd('YYYY-MM-DD')가 있으면 그날 밤 12시(한국 시간)까지만 입장된다.\n// 값이 있는데 형식이 이상하면 끝난 것으로 본다(잘못 적힌 값 때문에 기한 없이 열리지 않게).\nfunction trialEnded(data){\n  const raw = (data && data.trialEnd) || '';\n  if(!raw) return false;\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(raw));\n  if(!m) return true;\n  const end = Date.parse(m[1] + '-' + m[2] + '-' + m[3] + 'T23:59:59+09:00');\n  return !(end > 0) || Date.now() > end;\n}\n// 들어갈 수 있는 계정을 허용 목록으로 판단한다(2026-09-30). 모르는 값이면 막는다.\n//  - 체험 사이트(cbt1·cbt2): 체험 계정(plan 'set1')이면서 끝나는 날이 적혀 있고 급수가 맞아야 한다. 베타(slp) 계정은 못 들어온다.\n//  - 그 밖(베타 앱): plan이 없는 베타 계정만. 체험 계정이나 모르는 plan 값은 막는다.\n// ⚠️ 날짜는 이용자 기기 시계로 비교한다. 서버 없는 정적 사이트라 시계를 돌리면 우회할 수 있다(알려진 한계).\nfunction planBlocked(data){\n  if(!data) return true;                                    // 계정 정보가 없으면 막는다\n  if(trialEnded(data)) return true;                         // 끝나는 날이 지남(체험·베타 계정 모두)\n  if(TRIAL_SITE) return data.plan !== 'set1' || !data.trialEnd || trialGradeOf(data) !== TRIAL_GRADE;\n  return data.plan != null;                                 // 베타 앱: plan 없는 베타 계정만\n}\nfunction planBlockMsg(data){\n  if(!data) return '계정 정보를 찾을 수 없어요.\\n소소숲 카카오톡 채널로 문의해 주세요.';\n  if(TRIAL_SITE && data.plan !== 'set1') return '이 사이트는 체험 계정(cbt로 시작하는 아이디) 전용이에요.';\n  if(TRIAL_SITE && !data.trialEnd) return '체험 기간이 아직 정해지지 않은 계정이에요.\\n소소숲 카카오톡 채널로 문의해 주세요.';\n  if(!TRIAL_SITE && data.plan != null && data.plan !== 'set1') return '이 사이트에서 쓸 수 없는 계정이에요.';\n  if(data.trialEnd && !/^\\d{4}-\\d{2}-\\d{2}$/.test(String(data.trialEnd))) return '이용 기간 정보가 잘못 적힌 계정이에요.\\n소소숲 카카오톡 채널로 문의해 주세요.';\n  if(trialEnded(data)){\n    return formatExtendDate(data.trialEnd) + '로 ' + (data.plan === 'set1' ? '체험' : '베타 이용') + ' 기간이 끝났어요.\\n이용해 주셔서 감사합니다. 🌿';\n  }\n  const g = trialGradeOf(data);\n  return '이 계정은 ' + g + '급 1회차 체험판 전용입니다.\\n' + (TRIAL_URLS[g] || TRIAL_URLS[1]) + ' 으로 접속해 주세요.';\n}\nif(TRIAL_SITE){\n  const _s = $('agSub'), _i = $('agId');\n  if(_s) _s.textContent = TRIAL_GRADE + '급 1회차 체험판 · 발급받은 계정으로 로그인해 주세요';\n  if(_i) _i.placeholder = '예: cbt01';\n}\n\nfunction getDeviceId(){\n  let d = localStorage.getItem('kcbt_device_id');\n  if(!d){\n    d = (window.crypto && crypto.randomUUID) ? crypto.randomUUID()\n        : 'dev-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2);\n    localStorage.setItem('kcbt_device_id', d);\n  }\n  return d;\n}\nfunction agShowErr(msg){ $('agErr').textContent = msg || ''; }\nfunction enterApp(id, extendedUntil){\n  CURRENT_ID = id;\n  hide('authGate');\n  if(SHOW_HOME){ renderHome(); show('homeScreen'); show('homeBackBtn'); } else show('startScreen');\n  setTimeout(checkResume, 0);   // 풀던 시험이 있으면 이어 풀기 안내(정식판·베타). 스크립트를 다 읽은 뒤에 확인\n  // 설문 참여로 연장된 계정 → 접속 시 안내 팝업(브라우저 세션당 1회)\n  if(extendedUntil && !sessionStorage.getItem('kcbt_extend_notice_shown')){\n    const el = $('extendUntilText');\n    if(el) el.textContent = formatExtendDate(extendedUntil);\n    show('extendOverlay');\n    try{ sessionStorage.setItem('kcbt_extend_notice_shown', '1'); }catch(e){}\n  }\n}\n// ═════════ 대문(첫 화면) ═════════\n// 소소숲 번들 빌드가 window.SHOW_HOME=true 를 넣는다. 베타·체험판은 대문 없이 바로 응시 정보 입력.\nconst SHOW_HOME = !!window.SHOW_HOME;\n// 제15회(2026) 국시원 공고 기준. 다음 회차 공고가 나오면 이 블록만 고친다.\nconst EXAM_INFO = {\n  round: '2026년도 제15회',\n  exam: '2026-12-05',\n  result: '2026-12-23',\n  schedule: [\n    ['응시원서 접수', '2026-09-02', '2026-09-09', '9. 2.(수) ~ 9. 9.(수)', '국시원 홈페이지 인터넷 접수'],\n    ['시험장 공고 · 선택', '2026-11-04', '2026-11-08', '11. 4.(수) ~ 11. 8.(일)', '본인이 시험장을 직접 선택'],\n    ['응시표 출력', '2026-11-11', '2026-12-05', '11. 11.(수)부터', '시험 당일 아침까지 출력 가능'],\n    ['시험 시행', '2026-12-05', '2026-12-05', '12. 5.(토)', '1급·2급 컴퓨터시험(CBT)'],\n    ['최종합격자 발표', '2026-12-23', '2026-12-23', '12. 23.(수)', '국시원 홈페이지 [합격자조회]'],\n  ],\n  timetable: {\n    1: [['1교시', '신경언어장애 24 · 언어발달장애 24 · 유창성장애 24', 72, '13:30까지', '14:00 ~ 15:15 (75분)'],\n        ['2교시', '음성장애 24 · 조음음운장애 24 · 언어재활현장실무 20', 68, '15:40까지', '15:50 ~ 17:00 (70분)']],\n    2: [['1교시', '신경언어장애 30 · 유창성장애 25 · 음성장애 25', 80, '08:30까지', '09:00 ~ 10:15 (75분)'],\n        ['2교시', '언어발달장애 35 · 조음음운장애 35', 70, '10:40까지', '10:50 ~ 11:55 (65분)']],\n  },\n};\n// 한국 시간 기준 오늘 날짜(YYYY-MM-DD)\nfunction kstToday(){\n  const d = new Date(Date.now() + 9*3600*1000);\n  return d.toISOString().slice(0,10);\n}\nfunction dayDiff(a, b){ return Math.round((Date.parse(b) - Date.parse(a)) / 86400000); }\nfunction renderHome(){\n  const today = kstToday();\n  const toExam = dayDiff(today, EXAM_INFO.exam);\n  const toResult = dayDiff(today, EXAM_INFO.result);\n  const [, tm, td] = today.split('-');\n  $('hmToday').textContent = `오늘 ${parseInt(tm,10)}월 ${parseInt(td,10)}일 기준`;\n  if(toExam > 0){\n    $('hmDday').textContent = 'D-' + toExam;\n  } else if(toExam === 0){\n    $('hmDday').textContent = 'D-DAY';\n    $('hmHeadline').innerHTML = '오늘이 시험일이에요<br>차분하게, 연습한 대로!';\n  } else if(toResult >= 0){\n    $('hmDday').parentNode.querySelector('small').textContent = '합격자 발표까지';\n    $('hmDday').textContent = toResult === 0 ? 'D-DAY' : 'D-' + toResult;\n    $('hmHeadline').innerHTML = '시험 수고 많으셨어요<br>합격자 발표는 12월 23일(수)입니다';\n  } else {\n    // 발표까지 끝나면 다음 회차 공고 전까지 일정 대신 안내만 띄운다\n    $('hmDdayBox').classList.add('hidden');\n    $('hmScheduleCard').classList.add('hidden');\n    $('hmKicker').textContent = '언어재활사 국가시험';\n    $('hmHeadline').innerHTML = '다음 시험 일정은<br>국시원 공고 후 안내해 드릴게요';\n  }\n  let nextMarked = false;\n  $('hmSchedule').innerHTML =\n    '<tr><th>구분</th><th>일정</th><th>비고</th><th style=\"text-align:center;\">상태</th></tr>' +\n    EXAM_INFO.schedule.map(([name, from, to, label, note]) => {\n      let cls = '', tag;\n      if(today > to){ cls = 'is-done'; tag = '<span class=\"home-tag done\">완료</span>'; }\n      else if(today >= from){ cls = 'is-next'; nextMarked = true; tag = '<span class=\"home-tag now\">진행 중</span>'; }\n      else if(!nextMarked){ cls = 'is-next'; nextMarked = true; tag = '<span class=\"home-tag next\">다음 일정</span>'; }\n      else tag = '<span class=\"home-tag plan\">예정</span>';\n      return `<tr class=\"${cls}\"><th>${name}</th><td>${label}</td><td>${note}</td><td class=\"num\">${tag}</td></tr>`;\n    }).join('');\n  homeGrade(1);\n  renderStudyCard();\n}\nfunction homeGrade(g){\n  document.querySelectorAll('.home-grade-tabs button').forEach(b => b.classList.toggle('active', b.dataset.hg == g));\n  const rows = EXAM_INFO.timetable[g];\n  $('hmTimetable').innerHTML =\n    '<tr><th>교시</th><th>시험과목(문항 수)</th><th style=\"text-align:center;\">문항</th><th style=\"text-align:center;\">입장 마감</th><th style=\"text-align:center;\">시험시간</th></tr>' +\n    rows.map(([s, subj, n, enter, time]) =>\n      `<tr><th>${s}</th><td>${subj}</td><td class=\"num\">${n}</td><td class=\"num\">${enter}</td><td class=\"num\">${time}</td></tr>`).join('');\n  const total = rows.reduce((a, r) => a + r[2], 0);\n  $('hmTimeNote').textContent = `※ ${g}급 총 ${total}문항 · ${g === 1 ? '1교시 오후 2시' : '1교시 오전 9시'} 시작. 이 연습앱의 제한시간도 위 시간표와 같아요.`;\n}\nfunction goStart(){ hide('homeScreen'); show('startScreen'); }\nfunction backToHome(){ hide('startScreen'); renderHome(); show('homeScreen'); }\n\n// ═════════ 내 학습 기록(오답노트·응시 기록) — 소소숲 정식판 전용 ═════════\n// 대문과 같은 플래그(SHOW_HOME)로 켠다. 베타·체험판은 꺼진 채로 지금과 똑같이 동작한다.\n// 이 기기의 localStorage에만 계정별로 저장한다. 소소숲 app 라우트가 window.STUDY_USER(회원 id)를 넣어 준다.\n// 문항 키 = 급수-회차-교시-번호(\"1-2-1-37\"). 검수 때 쓰는 \"N교시 N번\"과 같은 기준이라\n// 회차 안에서 문항 순서를 바꾸거나 중간에 끼워 넣으면 기록이 다른 문항을 가리키게 된다.\nconst STUDY_ON = SHOW_HOME;\nconst STUDY_MAX_ATTEMPTS = 50;\nlet drillMode = false, studyRecorded = false;\nlet studyTab = 'wrong', studyGrade = 0, studySubj = '', studyOpenKey = {};\nlet studyArea = '', studyCat = '';   // 약점 그래프에서 누른 세부 영역·분류(오답 목록 거르기)\nconst Q_KEY = new Map(), KEY_Q = new Map();\n(function(){\n  const cnt = {};\n  QUESTIONS.forEach(q => {\n    const base = `${qGrade(q)}-${qSet(q)}-${q.session}`;\n    cnt[base] = (cnt[base] || 0) + 1;\n    const k = base + '-' + cnt[base];\n    Q_KEY.set(q, k);\n    if(!isHidden(q)) KEY_Q.set(k, q);\n  });\n})();\nconst keyParts = k => String(k).split('-').map(Number);          // [급수, 회차, 교시, 번호]\nfunction keyLabel(k){\n  if(!k) return '';\n  const [g, s, se, n] = keyParts(k);\n  return `${g}급 ${s}회차 ${se}교시 ${n}번`;\n}\nfunction keyCmp(a, b){ const x = keyParts(a), y = keyParts(b); for(let i = 0; i < 4; i++) if(x[i] !== y[i]) return x[i] - y[i]; return 0; }\nfunction escAttr(s){ return esc(String(s)).replace(/\"/g, '&quot;'); }\n// 한국 시간으로 'MM-DD' / 'MM-DD HH:mm'\nfunction kstStamp(ts, withTime){\n  const iso = new Date(ts + 9*3600*1000).toISOString();\n  return iso.slice(5, 10) + (withTime ? ' ' + iso.slice(11, 16) : '');\n}\nconst pctOf = (ok, n) => n ? Math.round(ok / n * 100) : 0;\n\nfunction studyStoreKey(){ return 'kcbt_study_v1_' + (window.STUDY_USER || CURRENT_ID || 'local'); }\nfunction loadStudy(){\n  try{\n    const d = JSON.parse(localStorage.getItem(studyStoreKey()) || 'null');\n    if(d && Array.isArray(d.attempts) && d.wrong && typeof d.wrong === 'object') return d;\n  }catch(e){}\n  return { v: 1, attempts: [], wrong: {} };\n}\nfunction saveStudy(d){\n  try{ localStorage.setItem(studyStoreKey(), JSON.stringify(d)); return true; }\n  catch(e){ console.warn('[kcbt] 학습 기록 저장 실패', e); return false; }\n}\n\n// 채점 직후 1회 호출. 틀리거나 비운 문항은 오답노트에 담고, 맞힌 문항은 오답노트에서 뺀다.\n// 오답 다시 풀기(drillMode)는 응시 기록에 남기지 않는다(과목별 추이가 흐려지지 않게).\nfunction recordStudy(bySub, totalN, totalOk, pass, usedSec){\n  const d = loadStudy(), now = Date.now();\n  let wrongNow = 0, removed = 0;\n  Q.forEach((q, i) => {\n    if(!(q.answer >= 1 && q.answer <= 5)) return;\n    const k = Q_KEY.get(q); if(!k) return;\n    if(answers[i] === q.answer){\n      if(d.wrong[k]){ delete d.wrong[k]; removed++; }\n    } else {\n      const w = d.wrong[k] || { n: 0 };\n      w.n++; w.last = now; d.wrong[k] = w; wrongNow++;\n    }\n  });\n  let diffs = [];\n  if(!drillMode){\n    // 문항별 [푼 횟수, 틀린 횟수] — 오답노트 약점 그래프에 쓴다(오답 다시 풀기는 세지 않음)\n    d.items = d.items || {};\n    Q.forEach((q, i) => {\n      if(!(q.answer >= 1 && q.answer <= 5)) return;\n      const k = Q_KEY.get(q); if(!k) return;\n      const it = d.items[k] || [0, 0];\n      it[0]++; if(answers[i] !== q.answer) it[1]++;\n      d.items[k] = it;\n    });\n    const grade = qGrade(Q[0]);\n    const sub = {};\n    Object.entries(bySub).forEach(([s, v]) => { sub[s] = [v.ok, v.n]; });\n    diffs = Object.entries(sub).map(([s, [ok, n]]) => {\n      const prev = d.attempts.slice().reverse().find(a => a.grade === grade && a.sub && a.sub[s]);\n      return prev ? [s, pctOf(ok, n) - pctOf(prev.sub[s][0], prev.sub[s][1])] : null;\n    }).filter(Boolean);\n    d.attempts.push({\n      at: now, grade,\n      set: Array.from(new Set(Q.map(qSet))).join(','),\n      sess: Array.from(new Set(Q.map(q => q.session))),\n      n: totalN, ok: totalOk, pass, sec: usedSec, sub,\n    });\n    if(d.attempts.length > STUDY_MAX_ATTEMPTS) d.attempts = d.attempts.slice(-STUDY_MAX_ATTEMPTS);\n  }\n  const saved = saveStudy(d);\n  return { wrongNow, removed, remain: Object.keys(d.wrong).length, diffs, saved };\n}\n\n// 교시 일부만 푼 기록(합격 판정 없음). 09-30 이전 기록은 pass가 true/false로 남아 있어 푼 교시 수로도 가린다.\nfunction attemptPartial(a){\n  if(a.pass == null) return true;\n  const all = new Set(VIS().filter(q => qGrade(q) === a.grade).map(q => q.session)).size;\n  return (a.sess || []).length < all;\n}\nfunction attemptLabel(a){ return `${a.grade}급 ${a.set}회차 ${(a.sess || []).join('+')}교시`; }\n// 급수별 과목 순서(문항 데이터 순서 그대로)\nfunction subjectsOf(g){ return Array.from(new Set(VIS().filter(q => qGrade(q) === g).map(q => q.subject))); }\n// 과목별 최근 기록(오래된 → 최근, 최대 5회)과 최근 3회 평균\nfunction subjectTrend(d, g){\n  return subjectsOf(g).map(s => {\n    const pts = d.attempts.filter(a => a.grade === g && a.sub && a.sub[s])\n      .map(a => ({ at: a.at, set: a.set, ok: a.sub[s][0], n: a.sub[s][1], pct: pctOf(a.sub[s][0], a.sub[s][1]) }))\n      .slice(-5);\n    const last3 = pts.slice(-3);\n    const avg = last3.length ? Math.round(last3.reduce((t, p) => t + p.pct, 0) / last3.length) : null;\n    return { s, pts, avg, risk: avg === null ? '' : avg < 40 ? 'fail' : avg < 60 ? 'warn' : 'ok' };\n  });\n}\nconst RISK_TXT = { fail: '과락 위험', warn: '주의', ok: '안정' };\n\n// 대문 \"내 학습 기록\" 카드\nfunction renderStudyCard(){\n  if(!STUDY_ON) return;\n  const d = loadStudy(), card = $('hmStudyCard'), body = $('hmStudyBody');\n  card.classList.remove('hidden');\n  const nWrong = Object.keys(d.wrong).filter(k => KEY_Q.has(k)).length;\n  const btns = `<div class=\"hs-btns\">\n      <button class=\"wbtn\" onclick=\"openStudy('wrong')\">&#128213; 오답노트 <b>${nWrong}</b>문항</button>\n      <button class=\"wbtn\" onclick=\"openStudy('hist')\">&#128202; 응시 기록 보기</button></div>`;\n  if(!d.attempts.length){\n    body.innerHTML = `<div class=\"hs-empty\">아직 응시 기록이 없어요. 모의 CBT를 한 교시 이상 풀고 제출하면 <b>과목별 정답률</b>과 <b>틀린 문제</b>가 여기에 쌓여요.</div>` + btns;\n    return;\n  }\n  const last = d.attempts[d.attempts.length - 1];\n  const trend = subjectTrend(d, last.grade).filter(t => t.avg !== null);\n  const fails = trend.filter(t => t.risk === 'fail'), warns = trend.filter(t => t.risk === 'warn');\n  const riskLine = fails.length\n    ? `<span class=\"risk-tag fail\">과락 위험</span>` + fails.map(t => `${esc(t.s)} (최근 평균 ${t.avg}%)`).join(' · ')\n    : warns.length\n      ? `<span class=\"risk-tag warn\">주의</span>` + warns.map(t => `${esc(t.s)} (최근 평균 ${t.avg}%)`).join(' · ')\n      : `<span class=\"risk-tag ok\">안정</span>${last.grade}급 응시한 과목 모두 최근 평균 60% 이상이에요 👏`;\n  body.innerHTML =\n    `<div class=\"hs-line\">최근 응시 <b>${d.attempts.length}회</b> · 마지막 ${kstStamp(last.at)} (${attemptLabel(last)} <b>${pctOf(last.ok, last.n)}%</b>)</div>\n     <div class=\"hs-line\">${riskLine}</div>` + btns;\n}\n\nfunction openStudy(tab){\n  if(!STUDY_ON) return;\n  if(tab) studyTab = tab;\n  ['homeScreen', 'startScreen', 'resultScreen', 'examScreen'].forEach(hide);\n  show('studyScreen');\n  renderStudy();\n  $('studyScreen').scrollTop = 0; window.scrollTo(0, 0);\n}\nfunction closeStudy(){\n  hide('studyScreen');\n  if(SHOW_HOME){ renderHome(); show('homeScreen'); } else show('startScreen');\n}\nfunction renderStudy(){\n  document.querySelectorAll('.st-tabs button').forEach(b => b.classList.toggle('active', b.dataset.st === studyTab));\n  const d = loadStudy();\n  $('studyBody').innerHTML = studyTab === 'hist' ? histHTML(d) : wrongHTML(d);\n}\nfunction setStudyGrade(g){ studyGrade = g; studySubj = ''; studyArea = ''; studyCat = ''; renderStudy(); }\nfunction setStudySubj(s){ studySubj = s; studyArea = ''; studyCat = ''; renderStudy(); }\nfunction setStudyArea(a){ studyArea = studyArea === a ? '' : a; studyCat = ''; renderStudy(); }\nfunction setStudyCat(c){ studyCat = studyCat === c ? '' : c; studyArea = ''; renderStudy(); }\nfunction gradeFilterHTML(grades){\n  if(grades.length < 2) return '';\n  return `<div class=\"st-filter\"><span class=\"lbl\">급수</span>` +\n    grades.map(g => `<button class=\"${g === studyGrade ? 'active' : ''}\" onclick=\"setStudyGrade(${g})\">${g}급</button>`).join('') + `</div>`;\n}\nfunction pickStudyGrade(grades, d){\n  if(grades.includes(studyGrade)) return;\n  const last = d.attempts[d.attempts.length - 1];\n  studyGrade = last && grades.includes(last.grade) ? last.grade : (grades[0] || 1);\n}\n\n// ── 오답노트 ──\nfunction wrongEntries(d){\n  return Object.entries(d.wrong).map(([k, w]) => ({ k, w, q: KEY_Q.get(k) })).filter(x => x.q)\n    .sort((a, b) => keyCmp(a.k, b.k));\n}\nfunction filteredWrong(d){\n  return wrongEntries(d).filter(x => qGrade(x.q) === studyGrade && (!studySubj || x.q.subject === studySubj)\n    && (!studyArea || (x.q.tag && x.q.tag.a === studyArea)) && (!studyCat || (x.q.tag && x.q.tag.c === studyCat)));\n}\n// ── 약점 그래프 ── 문항별 풀이 기록(d.items)을 과목 → 분류·세부 영역으로 모은다.\nconst WK_MIN = 3;   // 푼 문항이 이보다 적으면 '아직 적음'(순위에서 뺌)\nfunction weakStats(d, g){\n  const out = {};\n  Object.entries(d.items || {}).forEach(([k, [seen, wrong]]) => {\n    const q = KEY_Q.get(k);\n    if(!q || qGrade(q) !== g || !q.tag) return;\n    const s = out[q.subject] = out[q.subject] || { area: {}, cat: {}, seen: 0 };\n    s.seen += seen;\n    [['area', q.tag.a], ['cat', q.tag.c]].forEach(([kind, name]) => {\n      const v = s[kind][name] = s[kind][name] || { seen: 0, wrong: 0 };\n      v.seen += seen; v.wrong += wrong;\n    });\n  });\n  return out;\n}\nfunction wkRows(names, bucket, onclick, active, countFew){\n  const rows = names.map(name => {\n    const v = bucket[name] || { seen: 0, wrong: 0 };\n    return { name, ...v, rate: v.seen ? v.wrong / v.seen : 0 };\n  });\n  const ranked = rows.filter(r => r.seen >= WK_MIN).sort((a, b) => b.rate - a.rate || b.wrong - a.wrong);\n  const hot = new Set(ranked.filter(r => r.wrong > 0).slice(0, 2).map(r => r.name));\n  const ordered = ranked.concat(rows.filter(r => r.seen < WK_MIN));\n  return ordered.map(r => {\n    const few = r.seen < WK_MIN;\n    const cls = ['wk-row', few ? 'few' : '', hot.has(r.name) ? 'hot' : '', onclick ? 'click' : '', active === r.name ? 'on' : ''].join(' ');\n    const val = few ? (countFew ? `${r.wrong}/${r.seen}` : r.seen ? `아직 적음 (${r.seen})` : '아직 없음') : `${r.wrong}/${r.seen} · ${Math.round(r.rate * 100)}%`;\n    const click = onclick ? ` onclick=\"${onclick}('${escAttr(r.name)}')\"` : '';\n    return `<div class=\"${cls}\"${click} title=\"${escAttr(r.name)}\"><span class=\"wk-lbl\">${esc(r.name)}</span><span class=\"wk-bar\"><i style=\"width:${few ? 0 : Math.round(r.rate * 100)}%\"></i></span><span class=\"wk-val\">${val}</span></div>`;\n  }).join('');\n}\nfunction weakHTML(d){\n  const st = weakStats(d, studyGrade);\n  const subs = subjectsOf(studyGrade).filter(s => TAG_AREAS[s]);\n  const any = subs.some(s => st[s] && st[s].seen);\n  const head = `<div class=\"home-card\"><div class=\"home-card-body\"><h2 style=\"margin:0 0 4px;font-size:16px;\">어디가 약한지 보기</h2>`;\n  if(!any){\n    return head + `<div class=\"hs-empty\">모의 CBT를 풀고 제출하면 과목마다 세부 영역별 오답률이 여기에 그래프로 쌓여요. (이 기능이 생긴 뒤에 푼 시험부터 셉니다)</div></div></div>`;\n  }\n  if(!studySubj){\n    const cards = subs.map(s => {\n      const v = st[s] || { area: {}, cat: {}, seen: 0 };\n      const cats = TAG_CATS.map(c => {\n        const x = v.cat[c];\n        return `${c.split('·')[0]} ${x && x.seen >= WK_MIN ? Math.round(x.wrong / x.seen * 100) + '%' : '–'}`;\n      }).join(' · ');\n      return `<div class=\"wk-card\"><h3><span>${esc(s)}</span><button onclick=\"setStudySubj('${escAttr(s)}')\">크게 보기</button></h3>\n        <div class=\"wk-cats\">오답률 · ${cats}</div>${wkRows(TAG_AREAS[s], v.area, '', '')}</div>`;\n    }).join('');\n    return head + `<div class=\"wk-note\" style=\"margin:0 0 10px;\">막대는 세부 영역별 오답률이에요. 가장 약한 영역은 빨간색, 푼 문항이 ${WK_MIN}개보다 적으면 회색으로 보여요.</div>\n      <div class=\"wk-grid\">${cards}</div></div></div>`;\n  }\n  const v = st[studySubj] || { area: {}, cat: {}, seen: 0 };\n  return head + `<div class=\"wk-big\">\n      <div class=\"wk-sub\">${esc(studySubj)} · 분류별 오답률</div>${wkRows(TAG_CATS, v.cat, 'setStudyCat', studyCat)}\n      <div class=\"wk-sub\">세부 영역별 오답률</div>${wkRows(TAG_AREAS[studySubj], v.area, 'setStudyArea', studyArea)}\n      <div class=\"wk-note\">막대를 누르면 아래 오답 목록이 그 영역 문항만 보이게 걸러져요. 다시 누르면 풀려요.</div>\n    </div></div></div>`;\n}\nfunction wrongHTML(d){\n  const all = wrongEntries(d);\n  if(!all.length){\n    return `<div class=\"home-card\"><div class=\"home-card-body\"><div class=\"hs-empty\" style=\"text-align:center;padding:18px 0;\">\n      &#127881; 오답노트가 비어 있어요.<br>모의 CBT를 풀고 제출하면 틀리거나 비워 둔 문제가 여기에 모여요.</div></div></div>`;\n  }\n  const grades = Array.from(new Set(all.map(x => qGrade(x.q)))).sort();\n  pickStudyGrade(grades, d);\n  const inGrade = all.filter(x => qGrade(x.q) === studyGrade);\n  const subjCnt = {};\n  inGrade.forEach(x => { subjCnt[x.q.subject] = (subjCnt[x.q.subject] || 0) + 1; });\n  if(studySubj && !subjCnt[studySubj]) studySubj = '';\n  const list = filteredWrong(d);\n  const subjBtns = `<div class=\"st-filter\"><span class=\"lbl\">과목</span>` +\n    `<button class=\"${!studySubj ? 'active' : ''}\" onclick=\"setStudySubj('')\">전체 ${inGrade.length}</button>` +\n    subjectsOf(studyGrade).filter(s => subjCnt[s]).map(s =>\n      `<button class=\"${studySubj === s ? 'active' : ''}\" onclick=\"setStudySubj('${escAttr(s)}')\">${esc(s)} ${subjCnt[s]}</button>`).join('') +\n    `</div>`;\n  const items = list.map(({ k, w, q }) => {\n    const open = !!studyOpenKey[k];\n    const detail = open ? `<div class=\"sw-detail\">\n        ${q.stem ? `<div class=\"rv-stem\">${fmt(q.stem)}</div>` : ''}\n        ${q.image ? `<div class=\"qimg-wrap\"><img class=\"qimg\" src=\"${esc(q.image)}\" alt=\"문항 자료 이미지\" onclick=\"openImg(this.src)\"></div>` : ''}\n        <ul class=\"rv-choices\">${q.choices.map((c, ci) =>\n          `<li class=\"${ci + 1 === q.answer ? 'correct' : ''}\">${circled(ci)} ${esc(c)}${ci + 1 === q.answer ? ' ✔' : ''}</li>`).join('')}</ul>\n        ${tagHTML(q)}\n        ${explainHTML(q, k)}\n      </div>` : '';\n    return `<div class=\"sw-item${open ? ' open' : ''}\">\n      <div class=\"sw-meta\"><b>${keyLabel(k)}</b><span>${esc(q.subject)}</span>${swTagsHTML(q)}<span class=\"sw-n\">${w.n}회 틀림</span><span>마지막 ${kstStamp(w.last)}</span></div>\n      <div class=\"sw-q\">${fmt(q.q)}</div>\n      <div class=\"sw-actions\">\n        <button class=\"wbtn\" onclick=\"toggleWrongOpen('${k}')\">${open ? '해설 닫기' : '해설 보기'}</button>\n        <button class=\"wbtn\" onclick=\"removeWrong('${k}')\">빼기 &#10005;</button>\n      </div>${detail}</div>`;\n  }).join('');\n  const chip = studyArea || studyCat ? `<span class=\"wk-chip\">${esc(studyArea || studyCat)} <button onclick=\"${studyArea ? `setStudyArea('${escAttr(studyArea)}')` : `setStudyCat('${escAttr(studyCat)}')`}\" title=\"거르기 풀기\">&#10005;</button></span>` : '';\n  return `<div class=\"home-card\"><div class=\"home-card-body\">\n      ${gradeFilterHTML(grades)}${subjBtns}\n    </div></div>\n    ${weakHTML(d)}\n    <div class=\"home-card\"><div class=\"home-card-body\">\n      <div class=\"st-drill\" style=\"margin-top:0;padding-top:0;border-top:none;\"><span><b>오답 목록</b>${chip}<br>다시 풀어서 맞히면 오답노트에서 저절로 빠져요. 정규 모의 CBT에서 맞혀도 빠집니다.</span>\n        <button class=\"submit-btn\" onclick=\"startDrill()\">&#9654; 오답만 다시 풀기 (${list.length}문항)</button></div>\n    </div></div>\n    <div>${items}</div>\n    <div style=\"text-align:right;\"><button class=\"st-clear\" onclick=\"clearWrong()\">오답노트 모두 비우기</button></div>`;\n}\n// 오답 목록 접힌 줄에 세부 영역·유형 키워드를 붙인다(출제 포인트·핵심개념은 펼쳤을 때만)\nfunction swTagsHTML(q){\n  const t = tagsOn() && q.tag;\n  if(!t) return '';\n  return (t.a ? `<span class=\"sw-tag\">${esc(t.a)}</span>` : '') + (t.k ? `<span class=\"sw-tag kw\">${esc(t.k)}</span>` : '');\n}\nfunction toggleWrongOpen(k){ studyOpenKey[k] = !studyOpenKey[k]; renderStudy(); }\nfunction removeWrong(k){\n  const d = loadStudy();\n  delete d.wrong[k]; saveStudy(d); renderStudy();\n}\nfunction clearWrong(){\n  if(!confirm('오답노트를 모두 비울까요?\\n지운 문항은 되돌릴 수 없어요. (응시 기록은 그대로 남아요)')) return;\n  const d = loadStudy(); d.wrong = {}; saveStudy(d); renderStudy();\n}\n// 오답만 다시 풀기 — 시험 화면을 그대로 쓴다. 제한시간은 문항 수에 비례(실제 시험 약 1분/문항).\nfunction startDrill(){\n  const list = filteredWrong(loadStudy());\n  if(!list.length){ alert('다시 풀 문항이 없어요.'); return; }\n  drillMode = true;\n  sessQueue = [0]; sessPos = 0; accQ = []; accAns = []; accUsedSec = 0; accLimitSec = 0; accPauses = 0;\n  hide('studyScreen');\n  const title = `오답 다시 풀기 · ${studyGrade}급${studySubj ? ' ' + studySubj : ''}${studyArea || studyCat ? ' · ' + (studyArea || studyCat) : ''} ${list.length}문항`;\n  if(!_launch(list.map(x => x.q), Math.ceil(list.length * 1.05), title)){ drillMode = false; show('studyScreen'); }\n}\n\n// ── 응시 기록 ──\nfunction histHTML(d){\n  if(!d.attempts.length){\n    return `<div class=\"home-card\"><div class=\"home-card-body\"><div class=\"hs-empty\" style=\"text-align:center;padding:18px 0;\">\n      아직 응시 기록이 없어요.<br>모의 CBT를 한 교시 이상 풀고 제출하면 여기에 쌓여요.</div></div></div>`;\n  }\n  const grades = Array.from(new Set(d.attempts.map(a => a.grade))).sort();\n  pickStudyGrade(grades, d);\n  const trend = subjectTrend(d, studyGrade).filter(t => t.pts.length);\n  const trendRows = trend.map(t => {\n    const bars = t.pts.map(p =>\n      `<div class=\"st-bar\" style=\"height:${Math.max(p.pct, 2)}%\" title=\"${escAttr(`${kstStamp(p.at)} · ${p.set}회차 · ${p.pct}% (${p.ok}/${p.n})`)}\"></div>`).join('');\n    const last = t.pts[t.pts.length - 1];\n    return `<tr><th>${esc(t.s)}</th>\n      <td class=\"bars\"><div class=\"st-bars\">${bars}</div><div class=\"st-axis\">최근 ${t.pts.length}회 · 마지막 ${last.pct}%</div></td>\n      <td class=\"num\">${t.avg}%</td>\n      <td class=\"num\"><span class=\"risk-tag ${t.risk}\">${RISK_TXT[t.risk]}</span></td></tr>`;\n  }).join('');\n  const rows = d.attempts.filter(a => a.grade === studyGrade).slice().reverse().map(a => {\n    const failed = Object.entries(a.sub || {}).filter(([, [ok, n]]) => ok / n < 0.4).map(([s]) => s);\n    return `<tr><td class=\"num\">${kstStamp(a.at, true)}</td><td>${attemptLabel(a)}</td>\n      <td class=\"num\"><b>${pctOf(a.ok, a.n)}%</b> <small style=\"color:var(--gray)\">(${a.ok}/${a.n})</small></td>\n      <td class=\"num\">${attemptPartial(a) ? '<span class=\"risk-tag\" style=\"color:var(--gray)\">교시 참고</span>' : a.pass ? '<span class=\"risk-tag ok\">합격권</span>' : '<span class=\"risk-tag fail\">불합격권</span>'}</td>\n      <td>${failed.length ? '과락: ' + failed.map(esc).join(', ') : '-'}</td></tr>`;\n  }).join('');\n  return `${gradeFilterHTML(grades)}\n    <div class=\"home-card\"><h2>과목별 정답률 추이 <small>막대 1개 = 1회 응시 · 점선은 40%·60%</small></h2>\n      <div class=\"home-card-body\"><div class=\"home-tbl-wrap\"><table class=\"home-tbl st-tbl\">\n        <tr><th>과목</th><th>최근 5회</th><th style=\"text-align:center;\">최근 3회 평균</th><th style=\"text-align:center;\">상태</th></tr>${trendRows}\n      </table></div>\n      <div class=\"home-note\">※ 최근 3회 평균이 40% 미만이면 과락 위험, 60% 미만이면 주의로 표시해요. 막대에 마우스를 올리면 날짜와 점수가 보여요.</div></div></div>\n    <div class=\"home-card\"><h2>응시 목록 <small>최근 ${STUDY_MAX_ATTEMPTS}회까지 보관</small></h2>\n      <div class=\"home-card-body\"><div class=\"home-tbl-wrap\"><table class=\"home-tbl\">\n        <tr><th style=\"text-align:center;\">날짜</th><th>시험</th><th style=\"text-align:center;\">총점</th><th style=\"text-align:center;\">판정</th><th>과락 과목</th></tr>${rows}\n      </table></div></div></div>\n    <div style=\"text-align:right;\"><button class=\"st-clear\" onclick=\"clearHist()\">응시 기록 모두 지우기</button></div>`;\n}\nfunction clearHist(){\n  if(!confirm('응시 기록을 모두 지울까요?\\n지운 기록은 되돌릴 수 없어요. (오답노트는 그대로 남아요)')) return;\n  const d = loadStudy(); d.attempts = []; saveStudy(d); renderStudy();\n}\nfunction formatExtendDate(s){\n  // '2026-09-30' → '2026년 9월 30일'\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(s).trim());\n  return m ? `${m[1]}년 ${parseInt(m[2],10)}월 ${parseInt(m[3],10)}일` : String(s);\n}\nfunction showGate(){\n  hide('startScreen'); hide('homeScreen');\n  const g = $('authGate'); g.classList.remove('hidden');\n}\n\n// 로그인 없이 들어가는 건 두 경우뿐이다(2026-09-30):\n//  ① 소소숲 정식판 번들(SHOW_HOME) — 로그인·결제·기기 확인을 소소숲 서버가 이미 했다\n//  ② 내 컴퓨터에서 미리 보기(localhost·파일로 열기)\n// 체험 사이트에서 Firebase 설정 파일만 막아 로그인을 건너뛰던 틈을 닫는다.\nconst _cfg = window.FIREBASE_CONFIG;\nconst DEV_HOST = location.protocol === 'file:' || /^(localhost|127\\.0\\.0\\.1|\\[::1\\])$/.test(location.hostname);\nconst NO_LOGIN_OK = SHOW_HOME || DEV_HOST;\nconst CFG_ERR = '로그인 설정을 불러오지 못했어요.\\n새로고침해 주세요. 계속 안 되면 소소숲 카카오톡 채널로 문의해 주세요.';\nif(!_cfg || !_cfg.apiKey || String(_cfg.apiKey).indexOf('PASTE') === 0){\n  if(NO_LOGIN_OK){\n    console.warn('[kcbt] Firebase 설정 없음 — 로그인 없이 실행(소소숲 정식판·로컬 미리 보기).');\n    enterApp('local');\n  } else {\n    showGate(); agShowErr(CFG_ERR);\n  }\n} else {\n  firebase.initializeApp(_cfg);\n  fbAuth = firebase.auth();\n  fbDb = firebase.firestore();\n\n  // 새로고침해도 로그인 유지 — 단, 기기 일치 재확인 후 입장\n  fbAuth.onAuthStateChanged(async (user) => {\n    if(loginInProgress) return;   // 대화형 로그인 진행 중엔 doLogin이 처리하므로 개입 안 함(레이스 방지)\n    if(!user){ showGate(); return; }\n    try{\n      const snap = await fbDb.collection('users').doc(user.uid).get();\n      const data = snap.exists ? snap.data() : null;\n      if(planBlocked(data)){\n        await fbAuth.signOut(); showGate(); agShowErr(planBlockMsg(data));\n      } else if(data && data.device && data.device === getDeviceId()){\n        enterApp(data.name || (user.email || '').split('@')[0], data.extendedUntil);\n      } else {\n        await fbAuth.signOut();   // 기기 불일치/미등록 → 로그아웃 후 게이트\n        showGate();\n      }\n    }catch(e){ console.error(e); await fbAuth.signOut(); showGate(); }\n  });\n}\n\nasync function doLogin(){\n  if(!fbAuth){ if(NO_LOGIN_OK) enterApp('local'); else agShowErr(CFG_ERR); return; }   // 소소숲 정식판·로컬 미리 보기만 로그인 없이\n  const id = ($('agId').value || '').trim().toLowerCase();\n  const pw = $('agPw').value || '';\n  if(!id || !pw){ agShowErr('아이디와 비밀번호를 입력해 주세요.'); return; }\n  const btn = $('agBtn'); btn.disabled = true; agShowErr('');\n  loginInProgress = true;   // onAuthStateChanged가 로그인 중 개입해 로그아웃시키는 레이스 방지\n  try{\n    const cred = await fbAuth.signInWithEmailAndPassword(id + EMAIL_DOMAIN, pw);\n    const uid = cred.user.uid;\n    const dev = getDeviceId();\n    const ref = fbDb.collection('users').doc(uid);\n    const snap = await ref.get();\n    if(!snap.exists){\n      await fbAuth.signOut();\n      agShowErr('등록되지 않은 계정입니다. 관리자에게 문의해 주세요.');\n      return;\n    }\n    const data = snap.data();\n    if(planBlocked(data)){\n      await fbAuth.signOut();\n      agShowErr(planBlockMsg(data));\n      return;\n    }\n    if(!data.device){\n      // 최초 로그인 → 이 기기를 등록(바인딩)\n      await ref.update({ device: dev, boundAt: firebase.firestore.FieldValue.serverTimestamp() });\n    } else if(data.device !== dev){\n      // 다른 기기에서 로그인 시도 → 차단\n      await fbAuth.signOut();\n      agShowErr('이미 다른 기기에 등록된 계정입니다.\\n기기 변경은 관리자에게 문의해 주세요.');\n      return;\n    }\n    enterApp(data.name || id, data.extendedUntil);\n  }catch(e){\n    console.error(e);\n    const code = e && e.code || '';\n    if(code === 'permission-denied'){\n      agShowErr('기기 등록에 실패했습니다. 관리자에게 문의해 주세요.');\n    } else if(code.indexOf('auth/user-disabled') >= 0){\n      agShowErr((TRIAL_SITE ? '체험' : '베타 이용') + ' 기간이 종료되었습니다.\\n이용해 주셔서 감사합니다. 🌿');\n    } else if(code.indexOf('auth/too-many-requests') >= 0){\n      agShowErr('로그인 시도가 많습니다. 잠시 후 다시 시도해 주세요.');\n    } else {\n      agShowErr('아이디 또는 비밀번호가 올바르지 않습니다.');\n    }\n  }finally{\n    btn.disabled = false;\n    loginInProgress = false;\n  }\n}\n\nasync function doLogout(){\n  // 소소숲 정식판은 Firebase 로그인이 없다 → 소소숲 계정에서 로그아웃하고 바깥(부모) 창을 홈으로 보낸다\n  if(window.SHOW_HOME && !fbAuth){\n    if(!confirm('소소숲에서 로그아웃할까요?')) return;\n    const f = document.createElement('form');\n    f.method = 'post'; f.action = '/auth/signout'; f.target = '_top';\n    document.body.appendChild(f); f.submit();\n    return;\n  }\n  try{ if(fbAuth) await fbAuth.signOut(); }catch(e){}\n  $('agId').value = ''; $('agPw').value = ''; agShowErr('');\n  showGate();\n}\n\n// ═════════ 일시정지 ═════════\n// 실제 시험에는 없는 연습용 기능. 멈춘 동안 타이머를 세우고 문제를 가린다. 쓴 횟수는 결과 화면 풀이 시간 옆에 적는다.\nfunction pauseExam(){\n  if(paused || submitted || $('examScreen').classList.contains('hidden')) return;\n  paused = true; pauseCount++;\n  syncRemain(); clearInterval(timerId);\n  const r = Math.max(0, remainSec);\n  $('pauseRemain').textContent = `${Math.floor(r/60)}분 ${String(r%60).padStart(2,'0')}초`;\n  show('pauseOverlay');\n  saveResume();\n}\nfunction resumeExam(){\n  if(!paused) return;\n  paused = false; hide('pauseOverlay');\n  startTimer();\n}\n\n// ═════════ 풀던 답 저장 · 이어 풀기 (정식판·베타) ═════════\n// 체험 사이트(cbt1·cbt2 = IS_TRIAL_SITE)는 끈다. 이 기기 localStorage에 계정별로 한 건만 둔다.\n// 문항은 급수-회차-교시-번호 키 + 발문·보기 지문(qFp)으로 저장해서, 그사이 문항이 바뀌었으면 이어 풀지 않는다.\n// 창을 닫아 둔 동안에는 시간이 흐르지 않는다(남은 시간을 그대로 되살린다). 오답 다시 풀기는 저장하지 않는다.\nvar resumeSaveT = 0, pendingResume = null, resumeFromStart = false;\nfunction resumeOn(){ return !window.IS_TRIAL_SITE; }\nfunction resumeKey(){ return 'kcbt_resume_v1_' + (window.STUDY_USER || CURRENT_ID || 'local'); }\nfunction qFp(q){\n  const s = (q.q || '') + '|' + (q.choices || []).join('|');\n  let h = 0;\n  for(let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;\n  return (h >>> 0).toString(36);\n}\nfunction saveResumeSoon(){ if(!resumeOn()) return; clearTimeout(resumeSaveT); resumeSaveT = setTimeout(saveResume, 400); }\nfunction saveResume(phase){\n  if(!resumeOn() || drillMode) return;\n  const between = phase === 'between';\n  if(!between && (submitted || !Q.length || $('examScreen').classList.contains('hidden'))) return;\n  const st = {\n    v: 1, at: Date.now(), phase: between ? 'between' : 'exam',\n    grade: chosenGrade, set: chosenSet, queue: sessQueue, pos: sessPos,\n    label: examTitle() + setLabel(), name: $('exName').textContent,\n    acc: { keys: accQ.map(q => Q_KEY.get(q)), fp: accQ.map(qFp), ans: accAns, used: accUsedSec, limit: accLimitSec, pauses: accPauses },\n  };\n  if(!between) Object.assign(st, {\n    title: $('exTitle').textContent, keys: Q.map(q => Q_KEY.get(q)), fp: Q.map(qFp),\n    answers, checks, memos, strikes, hl: hlStore, page, perPage, fontScale,\n    limit: limitSec, remain: Math.max(0, remainSec), warned, warned10, pauses: pauseCount,\n  });\n  try{ localStorage.setItem(resumeKey(), JSON.stringify(st)); }\n  catch(e){ console.warn('[kcbt] 풀던 답 저장 실패', e); }\n}\nfunction clearResume(){\n  clearTimeout(resumeSaveT);\n  try{ localStorage.removeItem(resumeKey()); }catch(e){}\n}\n// 저장본을 읽어 문항 객체까지 되살린다. 없으면 null, 문항이 바뀌어 쓸 수 없으면 'stale'.\nfunction loadResume(){\n  if(!resumeOn()) return null;\n  let st = null;\n  try{ st = JSON.parse(localStorage.getItem(resumeKey()) || 'null'); }catch(e){}\n  if(!st || st.v !== 1 || !st.acc) return null;\n  const toQ = (keys, fps) => {\n    if(!Array.isArray(keys) || !Array.isArray(fps) || keys.length !== fps.length) return null;\n    const out = [];\n    for(let i = 0; i < keys.length; i++){\n      const q = KEY_Q.get(keys[i]);\n      if(!q || qFp(q) !== fps[i]) return null;\n      out.push(q);\n    }\n    return out;\n  };\n  st.accQs = toQ(st.acc.keys, st.acc.fp);\n  if(!st.accQs || !Array.isArray(st.acc.ans) || st.acc.ans.length !== st.accQs.length) return 'stale';\n  if(st.phase === 'exam'){\n    st.qs = toQ(st.keys, st.fp);\n    if(!st.qs || !st.qs.length) return 'stale';\n  } else if(st.phase !== 'between' || !Array.isArray(st.queue) || st.pos >= st.queue.length - 1) return 'stale';\n  return st;\n}\n// 앱에 들어올 때(enterApp) 한 번 확인한다.\nfunction checkResume(){\n  const st = loadResume();\n  if(st === 'stale'){ clearResume(); alert('풀던 시험의 문항이 그사이 바뀌어서 이어 풀 수 없어요.\\n새로 시작해 주세요.'); return; }\n  if(st) openResume(st, false);\n}\nfunction openResume(st, fromStart){\n  pendingResume = st; resumeFromStart = fromStart;\n  let body;\n  if(st.phase === 'between'){\n    const done = st.queue[st.pos], next = st.queue[st.pos + 1];\n    body = `<b>${esc(st.label)} ${done}교시</b>까지 제출했어요.<br>이어서 ${next}교시를 풀거나 결과를 볼 수 있어요.`;\n  } else {\n    const n = st.qs.length, done = st.answers.filter(a => a > 0).length, r = st.remain;\n    body = `<b>${esc(st.title)}</b><br>${done} / ${n}문항 풀이 · 남은 시간 ${Math.floor(r/60)}분 ${String(r%60).padStart(2,'0')}초`;\n  }\n  $('resumeMsg').innerHTML = body + `<br><small style=\"color:#68738a\">${kstStamp(st.at, true)}에 멈춘 시험이에요. 멈춘 동안에는 시간이 흐르지 않았어요.</small>`;\n  show('resumeOverlay');\n}\nfunction resumeDiscard(){\n  hide('resumeOverlay'); pendingResume = null; clearResume();\n  if(resumeFromStart) startExam();\n}\nfunction resumeContinue(){\n  const st = pendingResume; pendingResume = null; hide('resumeOverlay');\n  if(!st) return;\n  drillMode = false;\n  chosenGrade = st.grade; chosenSet = st.set; renderStartSelectors();\n  sessQueue = st.queue.slice(); sessPos = st.pos;\n  accQ = st.accQs; accAns = st.acc.ans.slice(); accUsedSec = st.acc.used || 0; accLimitSec = st.acc.limit || 0; accPauses = st.acc.pauses || 0;\n  hide('homeScreen'); hide('startScreen');\n  if(st.phase === 'between'){\n    // 여기서 [결과 보기]를 누르면 결과 화면이 accQ 기준으로 다시 그려지므로 배열 길이를 맞춰 둔다\n    Q = accQ; answers = accAns.slice(); page = 0; hlStore = {};\n    checks = accQ.map(() => false); memos = accQ.map(() => ''); strikes = accQ.map(() => [false,false,false,false,false]);\n    submitted = true; showNextSessPrompt(); return;\n  }\n  _launch(st.qs, Math.ceil(st.limit / 60), st.title, st);\n}\naddEventListener('pagehide', () => saveResume());\ndocument.addEventListener('visibilitychange', () => { if(document.visibilityState === 'hidden') saveResume(); });\n\n// ═════════ 시험 시작 ═════════\n// 실제 시험 실행부(샘플·커스텀 공용). qArr: 문항배열, minutes: 제한시간, title: 헤더 표기\n// rs: 풀던 시험을 이어 풀 때 저장해 둔 상태(saveResume). 없으면 새 시험.\nfunction _launch(qArr, minutes, title, rs){\n  Q = qArr;\n  if(!Q.length){ alert('시작할 문항이 없습니다.'); return false; }\n  answers = Array(Q.length).fill(0);\n  checks  = Array(Q.length).fill(false);\n  memos   = Array(Q.length).fill('');\n  strikes = Q.map(() => [false,false,false,false,false]);\n  page = 0; filter = 'all'; warned = false; warned10 = false; submitted = false; studyRecorded = false;\n  paused = false; pauseCount = 0; hide('pauseOverlay');\n  awaitEnd = false; submitRemain = null; hide('submittedOverlay');\n  hlStore = {}; penMode = 'off'; $('paper').classList.remove('pen-on');\n  limitSec = remainSec = Math.max(1, minutes) * 60;\n  if(rs){\n    const same = a => Array.isArray(a) && a.length === Q.length;\n    if(same(rs.answers)) answers = rs.answers.slice();\n    if(same(rs.checks))  checks  = rs.checks.slice();\n    if(same(rs.memos))   memos   = rs.memos.slice();\n    if(same(rs.strikes)) strikes = rs.strikes.map(x => x.slice());\n    hlStore = rs.hl || {};\n    limitSec = rs.limit; remainSec = rs.remain;\n    warned = !!rs.warned; warned10 = !!rs.warned10; pauseCount = rs.pauses || 0; page = rs.page || 0;\n    // 저장할 때의 1면/2면 배치·글자 크기로 되돌린다(page는 그 배치 기준 번호라 배치가 다르면 다른 문제로 간다)\n    if(rs.perPage === 1 || rs.perPage === 2){ perPage = rs.perPage; $('lay1').classList.toggle('active', perPage===1); $('lay2').classList.toggle('active', perPage===2); }\n    if(rs.fontScale){\n      fontScale = rs.fontScale;\n      document.querySelectorAll('.fbtn').forEach(x => x.classList.toggle('active', +x.dataset.fs === fontScale));\n    }\n  }\n  startedAt = new Date();\n  $('exName').textContent = (rs && rs.name) || $('inName').value || '소소숲';\n  $('exTitle').textContent = title;\n  $('limitMin').textContent = Math.round(limitSec/60);\n  hide('startScreen'); show('examScreen');\n  buildOMR(); render();\n  startTimer();\n  return true;\n}\nlet sessQueue = [1], sessPos = 0, accQ = [], accAns = [], accUsedSec = 0, accLimitSec = 0;\nfunction startExam(){\n  const st = loadResume();                    // 풀던 시험이 있으면 새로 시작하기 전에 먼저 묻는다\n  if(st === 'stale') clearResume();\n  else if(st){ openResume(st, true); return; }\n  drillMode = false;\n  sessQueue = sessionQueueFrom(chosenSess);\n  sessPos = 0; accQ = []; accAns = []; accUsedSec = 0; accLimitSec = 0; accPauses = 0;\n  launchCurrentSession();\n}\nfunction launchCurrentSession(){\n  const s = sessQueue[sessPos];\n  const p = poolFor(s);\n  if(!p.length){ alert('선택한 교시에 문항이 없습니다.'); return; }\n  _launch(p, minutesFor(s), examTitle() + setLabel() + ` ${s}교시`);\n}\nfunction startNextSession(){ hide('nextSessOverlay'); sessPos++; launchCurrentSession(); }   // 다음 교시로 진행\nfunction resultNow(){ hide('nextSessOverlay'); finishAll(); }                                 // 여기서 멈추고 결과\nfunction finishAll(){\n  Q = accQ; answers = accAns;\n  limitSec = accLimitSec; remainSec = accLimitSec - accUsedSec;   // 지금까지 합산 풀이시간\n  showResult();\n}\n// 한 교시 제출/종료 → 누적 후, 다음 교시가 있으면 [다음 교시 시작 / 결과 보기] 선택\n// choice: 제출 완료 창에서 고른 것('next' 다음 교시 · 'result' 결과 보기). 없으면(시간 종료) 교시 전환 창을 띄운다.\nfunction finishSession(choice){\n  clearInterval(timerId);\n  accQ = accQ.concat(Q);\n  accAns = accAns.concat(answers);\n  accUsedSec += (limitSec - Math.max(0, remainSec));\n  accLimitSec += limitSec;\n  accPauses += pauseCount; pauseCount = 0;\n  if(choice === 'result' || sessPos >= sessQueue.length - 1){ finishAll(); return; }\n  if(choice === 'next'){ sessPos++; launchCurrentSession(); return; }\n  showNextSessPrompt();\n  saveResume('between');   // 교시 사이에 창을 닫아도 앞 교시 답이 남게\n}\nfunction showNextSessPrompt(){\n  const done = sessQueue[sessPos], next = sessQueue[sessPos+1];\n  $('nextSessMsg').innerHTML = `<b>${done}교시</b>가 종료되었습니다.<br>이어서 <b>${next}교시</b>(${minutesFor(next)}분)를 풀거나,<br>여기서 <b>${done}교시 결과</b>만 볼 수 있어요.`;\n  show('nextSessOverlay');\n}\n// 남은 시간은 끝나는 시각(deadline)과 지금 시각의 차이로 센다.\n// setInterval 횟수로 세면 백그라운드 탭·절전 때 콜백이 늦게 와서 시계가 실제보다 느리게 간다.\nlet deadline = 0, lastShownSec = null, lastSaveAt = 0;\nfunction startTimer(){\n  deadline = Date.now() + Math.max(0, remainSec) * 1000; lastShownSec = null;\n  clearInterval(timerId); timerId = setInterval(tickTimer, 250); tickTimer();\n}\nfunction syncRemain(){ if(deadline) remainSec = Math.ceil((deadline - Date.now()) / 1000); }\nfunction tickTimer(){\n  syncRemain();\n  if(remainSec <= 0){\n    remainSec = 0; clearInterval(timerId);\n    $('remainTxt').textContent = '0분 00초';\n    if(awaitEnd){ endSession(); return; }   // 제출해 둔 채로 교시 시간이 끝남\n    autoSubmit(); return;\n  }\n  if(remainSec === lastShownSec) return;   // 0.25초마다 확인하고, 초가 바뀔 때만 화면을 고친다\n  lastShownSec = remainSec;\n  const m = Math.floor(remainSec/60), s = remainSec%60;\n  $('remainTxt').textContent = `${m}분 ${String(s).padStart(2,'0')}초`;\n  if(awaitEnd){ updateSubmittedClock(); }   // 제출 완료 창에서는 남은 시간만 갱신(알림은 문제로 돌아왔을 때)\n  else {\n    // 국시원 CBT처럼 종료 10분 전·5분 전에 알림창\n    if(!warned10 && remainSec <= 600 && limitSec > 600){ warned10 = true; if(remainSec > 300) showWarn(10); }\n    if(!warned && remainSec <= 300 && limitSec > 300){ warned = true; warned10 = true; showWarn(5); }\n  }\n  if(Date.now() - lastSaveAt >= 5000){ lastSaveAt = Date.now(); saveResume(); }\n}\nfunction showWarn(min){ $('warnMin').textContent = min + '분'; show('warnOverlay'); }\n\n// ═════════ 페이지 (시험지는 항상 전체 문제) ═════════\nfunction totalPages(){ return Math.max(1, Math.ceil(Q.length / perPage)); }\nfunction movePage(d){\n  const t = totalPages();\n  page = Math.min(t-1, Math.max(0, page+d));\n  render();\n}\nfunction jumpTo(qi){\n  page = Math.floor(qi / perPage);\n  render();\n}\n\n// ═════════ 렌더링 ═════════\nfunction render(){\n  const t = totalPages();\n  if(page >= t) page = t-1;\n  if(page < 0) page = 0;\n  const start = page*perPage;\n  const slice = Q.map((_,i)=>i).slice(start, start + perPage);\n  const grid = $('paperGrid');\n  grid.className = 'paper-grid' + (perPage===1 ? ' one' : '');\n  grid.style.fontSize = fontScale + 'em';\n  grid.innerHTML = slice.map(i => qcardHTML(i)).join('');\n  $('pageInfo').textContent = `${page+1}/${t}`;\n  // 첫 문제에선 [이전], 마지막 문제에선 [다음]을 숨긴다(자리는 남겨 배치가 밀리지 않게)\n  $('pgPrev').style.visibility = page > 0 ? '' : 'hidden';\n  $('pgNext').style.visibility = page < t-1 ? '' : 'hidden';\n  updateCounts(); updateOMR(slice);\n  $('paper').scrollTop = 0;\n}\n\n// ═════════ 문제 보기 모달 (전체/체크/안푼) ═════════\nlet viewerMode = 'all';\nfunction viewerIdx(mode){\n  if(mode==='chk') return Q.map((_,i)=>i).filter(i=>checks[i]);\n  if(mode==='un')  return Q.map((_,i)=>i).filter(i=>!answers[i]);\n  return Q.map((_,i)=>i);\n}\nfunction openProblemViewer(mode){\n  viewerMode = mode;\n  renderViewer();\n  show('viewerOverlay');\n}\nfunction switchViewerTab(mode){ viewerMode = mode; renderViewer(); }\nfunction renderViewer(){\n  $('vtAll').textContent = `전체문제 (${Q.length})`;\n  $('vtChk').textContent = `체크문제 (${checks.filter(Boolean).length})`;\n  $('vtUn').textContent  = `안푼문제 (${answers.filter(a=>!a).length})`;\n  ['vtAll','vtChk','vtUn'].forEach(id=>$(id).classList.remove('active'));\n  $(viewerMode==='all'?'vtAll':viewerMode==='chk'?'vtChk':'vtUn').classList.add('active');\n  const idxs = viewerIdx(viewerMode);\n  const body = $('viewerBody');\n  body.innerHTML = idxs.length\n    ? idxs.map(i => viewerCard(i)).join('')\n    : '<div style=\"padding:60px;text-align:center;color:#68738a;grid-column:1/-1;\">해당하는 문제가 없습니다.</div>';\n  body.scrollTop = 0;\n}\nfunction viewerCard(i){\n  const q = Q[i];\n  return `<div class=\"v-card\" ondblclick=\"viewerJump(${i})\" title=\"더블클릭하면 이 문제로 이동합니다\">\n    <div class=\"v-head\"><span class=\"v-no\">${i+1}</span><span style=\"flex:1\">${esc(q.q)}</span></div>\n    ${q.stem ? `<div class=\"v-stem\">${fmt(q.stem)}</div>` : ''}\n    <ul class=\"v-choices\">\n      ${q.choices.map((c,ci)=>`<li class=\"${answers[i]===ci+1?'sel':''}\">${circled(ci)} ${esc(c)}</li>`).join('')}\n    </ul>\n  </div>`;\n}\nfunction viewerJump(i){ hide('viewerOverlay'); jumpTo(i); }\nfunction esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\n// 문항 텍스트 서식: __구간__ → 밑줄(발화 전사의 비유창 구간 표시 등)\nfunction fmt(s){ return esc(s).replace(/__(.+?)__/g, '<u class=\"ul\">$1</u>'); }\nfunction qcardHTML(i){\n  const q = Q[i];\n  return `<div class=\"qcol\"><div class=\"qcard\" data-qi=\"${i}\">\n    <div class=\"qtools\">\n      <div class=\"qtools-row\">\n        <button class=\"tool-btn ${checks[i]?'on':''}\" onclick=\"toggleCheck(${i})\">&#10003; 체크문제</button>\n        <button class=\"tool-btn ${memos[i]?'memo-on':''}\" onclick=\"openMemo(${i})\">&#9998; 메모</button>\n      </div>\n      <div class=\"qtools-row\">\n        <button class=\"tool-btn ${penMode==='on'?'pen-on':''}\" onclick=\"togglePen()\">&#128396; 형광펜 ${penMode==='on'?'켜짐':'꺼짐'}</button>\n        <button class=\"tool-btn\" onclick=\"clearHighlights(${i})\">&#9003; 형광펜 지우기</button>\n      </div>\n    </div>\n    <div class=\"qhead\"><span>${i+1}.</span><span style=\"flex:1\" data-hl=\"${i}-q\">${hlHTML(i,'q',q.q)}</span><span class=\"subj\">${esc(q.subject)}</span></div>\n    ${q.stem ? `<div class=\"stem\" data-hl=\"${i}-s\">${hlHTML(i,'s',q.stem)}</div>` : ''}\n    ${q.image ? `<div class=\"qimg-wrap\"><img class=\"qimg\" src=\"${esc(q.image)}\" alt=\"문항 자료 이미지\" title=\"클릭하면 크게 볼 수 있습니다\" onclick=\"openImg(this.src)\"><div class=\"qimg-hint\"><button type=\"button\" class=\"qimg-btn\" onclick=\"openImg(this.closest('.qimg-wrap').querySelector('img').src)\">&#128269; 크게 보기</button></div></div>` : ''}\n    <ul class=\"choices\">\n      ${q.choices.map((c,ci)=>`\n        <li class=\"${answers[i]===ci+1?'sel':''} ${strikes[i][ci]?'strike':''}\">\n          <span class=\"num\">${ci+1}</span>\n          <span class=\"ctext\" data-hl=\"${i}-c${ci}\">${hlHTML(i,'c'+ci,c)}</span>\n          <button class=\"strike-btn ${strikes[i][ci]?'on':''}\" onclick=\"toggleStrike(${i},${ci})\">오답</button>\n        </li>`).join('')}\n    </ul>\n  </div></div>`;\n}\nfunction updateCounts(){\n  $('cntAll').textContent = Q.length;\n  $('cntChk').textContent = checks.filter(Boolean).length;\n  $('cntUn').textContent = answers.filter(a=>!a).length;\n}\n\n// ═════════ OMR ═════════\nfunction buildOMR(){\n  // OMR 패널 제거됨 — 남아있는 경우에만 렌더(호환용)\n  const list = $('omrList'); if(!list) return;\n  list.innerHTML = Q.map((_,i)=>`\n    <div class=\"omr-row ${(i+1)%5===0?'sep':''}\" id=\"omr${i}\">\n      <span class=\"flags\" id=\"flag${i}\"></span>\n      <span class=\"no\" onclick=\"jumpTo(${i})\">${String(i+1).padStart(2,'0')}</span>\n      <span class=\"bubbles\">${[1,2,3,4,5].map(n=>`<button class=\"bub\" onclick=\"pick(${i},${n})\">${circled(n-1)}</button>`).join('')}</span>\n    </div>`).join('');\n}\nfunction updateOMR(visible){\n  // 진행바 갱신(푼 문항 수 기준)\n  const total = Q.length, done = answers.filter(a=>a>0).length;\n  const pb = $('progBar'), pt = $('progText');\n  if(pb) pb.style.width = (total ? done/total*100 : 0) + '%';\n  if(pt) pt.textContent = `${done} / ${total} 문항 풀이`;\n  // OMR 패널이 남아있으면 함께 갱신(호환용)\n  if(!$('omrList')) return;\n  Q.forEach((_,i)=>{\n    const row = $('omr'+i); if(!row) return;\n    row.classList.toggle('cur', visible.includes(i));\n    row.querySelectorAll('.bub').forEach((b,bi)=>b.classList.toggle('mark', answers[i]===bi+1));\n    $('flag'+i).innerHTML = (checks[i]?'<span class=\"chk\">&#10003;</span>':'') + (memos[i]?'<span>&#9998;</span>':'');\n  });\n}\nfunction goHome(){\n  const keep = resumeOn() && !drillMode;   // 정식판·베타는 푼 답을 남겨 두고 다음에 이어 풀게 한다\n  if(!confirm(keep ? '처음(입장) 화면으로 돌아갈까요?\\n푼 답은 저장돼서 다음에 이어서 풀 수 있어요.'\n                   : '처음(입장) 화면으로 돌아갈까요?\\n지금까지 푼 답안은 저장되지 않습니다.')) return;\n  clearInterval(timerId);\n  if(keep) saveResume();\n  hide('examScreen'); hide('resultScreen');\n  if(drillMode){ drillMode = false; openStudy('wrong'); } else show('startScreen');\n}\n\n// ═════════ 상호작용 ═════════\nfunction pick(i,n){\n  answers[i] = (answers[i]===n) ? 0 : n;\n  render(); saveResumeSoon();\n}\nfunction toggleStrike(i,ci){ strikes[i][ci] = !strikes[i][ci]; render(); saveResumeSoon(); }\nfunction toggleCheck(i){ checks[i] = !checks[i]; render(); saveResumeSoon(); }\n\n// 글자 크기 / 화면 배치\ndocument.querySelectorAll('.fbtn').forEach(b=>b.onclick=()=>{\n  document.querySelectorAll('.fbtn').forEach(x=>x.classList.remove('active'));\n  b.classList.add('active'); fontScale = +b.dataset.fs; render(); saveResumeSoon();\n});\n// 배치를 바꿔도 보던 문제에 머문다(2면→1면은 보던 쌍의 앞 문제, 1면→2면은 그 문제가 든 쌍)\nfunction setLayout(n){\n  if(perPage === n) return;\n  const qi = page * perPage;\n  perPage = n;\n  $('lay1').classList.toggle('active', n===1); $('lay2').classList.toggle('active', n===2);\n  page = Math.floor(qi / perPage);\n  render(); saveResumeSoon();\n}\n$('lay1').onclick = ()=> setLayout(1);\n$('lay2').onclick = ()=> setLayout(2);\n\n// ═════════ 형광펜 ═════════\n// 하이라이트는 문항별(data-hl 키)로 innerHTML을 저장해 페이지 이동·재렌더 후에도 유지된다.\nfunction hlHTML(i, part, text){\n  const k = i + '-' + part;\n  return hlStore[k] !== undefined ? hlStore[k] : fmt(text);\n}\nfunction togglePen(){\n  penMode = penMode==='on' ? 'off' : 'on';\n  $('paper').classList.toggle('pen-on', penMode==='on');\n  const sel = window.getSelection && window.getSelection();\n  if(sel) sel.removeAllRanges();\n  render();   // 문제 카드의 형광펜 버튼 상태(켜짐/꺼짐) 갱신\n}\nfunction hlContainerOf(node){\n  while(node){\n    if(node.nodeType===1 && node.dataset && node.dataset.hl!==undefined) return node;\n    node = node.parentNode;\n  }\n  return null;\n}\nfunction saveHl(c){ if(c) hlStore[c.dataset.hl] = c.innerHTML; saveResumeSoon(); }\nfunction clearHighlights(i){   // 해당 문항의 모든 형광펜 하이라이트 제거\n  ['q','s','c0','c1','c2','c3','c4'].forEach(p => delete hlStore[i+'-'+p]);\n  render(); saveResumeSoon();\n}\nfunction onPaperMouseUp(){\n  if(penMode!=='on') return;\n  const sel = window.getSelection();\n  if(!sel || sel.isCollapsed || !String(sel).trim()) return;\n  const range = sel.getRangeAt(0);\n  const startC = hlContainerOf(range.startContainer);\n  const endC = hlContainerOf(range.endContainer);\n  if(!startC || startC !== endC){ sel.removeAllRanges(); return; }   // 한 영역 안에서만 허용\n  const mark = document.createElement('mark');\n  mark.className = 'hl';\n  try{ range.surroundContents(mark); }\n  catch(_){ try{ mark.appendChild(range.extractContents()); range.insertNode(mark); }\n            catch(e){ sel.removeAllRanges(); return; } }\n  saveHl(startC);\n  sel.removeAllRanges();\n}\nfunction onPaperClick(e){\n  const mark = e.target.closest ? e.target.closest('mark.hl') : null;\n  if(penMode==='on' && mark){                       // 형광펜 모드에서 하이라이트 클릭 → 지우기\n    const cont = hlContainerOf(mark), parent = mark.parentNode;\n    while(mark.firstChild) parent.insertBefore(mark.firstChild, mark);\n    parent.removeChild(mark); parent.normalize();\n    saveHl(cont);\n    return;\n  }\n  if(window.getSelection && String(window.getSelection()).trim()) return;  // 드래그 선택 중이면 클릭 무시\n  const ct = e.target.closest ? e.target.closest('.ctext') : null;         // 보기 텍스트 클릭 → 답 선택\n  if(ct){\n    const li = ct.closest('li');\n    const ci = [...li.parentNode.children].indexOf(li);\n    const qi = +li.closest('.qcard').dataset.qi;\n    pick(qi, ci+1);\n  }\n}\n$('paper').addEventListener('mouseup', onPaperMouseUp);\n$('paper').addEventListener('click', onPaperClick);\n\n// ═════════ 메모 ═════════\nfunction openMemo(i){\n  memoTarget = i;\n  $('memoTitle').textContent = `${i+1}번 문제 메모`;\n  $('memoText').value = memos[i];\n  show('memoWin'); $('memoText').focus();\n}\n// 메모는 닫기 전에도 입력할 때마다 반영해 둔다(창을 닫지 않고 탭을 닫아도 이어 풀기에 남게)\n$('memoText').addEventListener('input', () => {\n  if(memoTarget < 0) return;\n  memos[memoTarget] = $('memoText').value.trim(); saveResumeSoon();\n});\nfunction closeMemo(){\n  if(memoTarget>=0) memos[memoTarget] = $('memoText').value.trim();\n  memoTarget = -1; hide('memoWin'); render(); saveResumeSoon();\n}\n\n// ═════════ 계산기 ═════════\nfunction toggleCalc(){ $('calcWin').classList.toggle('hidden'); }\nfunction calcIn(v){ const d=$('calcDisp'); d.value = d.value==='0'&&!'+-*/.'.includes(v) ? v : d.value+v; }\nfunction calcClear(){ $('calcDisp').value='0'; }\nfunction calcBack(){ const d=$('calcDisp'); d.value=d.value.slice(0,-1)||'0'; }\nfunction calcEq(){\n  const d=$('calcDisp');\n  if(!/^[\\d+\\-*/.() ]+$/.test(d.value)) return;\n  try{ d.value = String(Function('\"use strict\";return ('+d.value+')')()); }catch(e){ d.value='오류'; }\n}\n\n// ═════════ 그림판 ═════════\nconst pc = $('padCanvas'), pctx = pc.getContext('2d');\nlet padMode='pen', drawing=false;\nfunction togglePad(){ $('padWin').classList.toggle('hidden'); }\nfunction setPadMode(m){ padMode=m; $('penBtn').classList.toggle('on',m==='pen'); $('eraserBtn').classList.toggle('on',m==='eraser'); }\nfunction clearPad(){ pctx.clearRect(0,0,pc.width,pc.height); }\npc.addEventListener('mousedown',e=>{ drawing=true; pctx.beginPath(); pctx.moveTo(e.offsetX,e.offsetY); });\npc.addEventListener('mousemove',e=>{\n  if(!drawing) return;\n  pctx.lineWidth = padMode==='pen'?2:18;\n  pctx.strokeStyle='#1f3358';\n  pctx.globalCompositeOperation = padMode==='pen'?'source-over':'destination-out';\n  pctx.lineTo(e.offsetX,e.offsetY); pctx.stroke();\n});\n['mouseup','mouseleave'].forEach(ev=>pc.addEventListener(ev,()=>drawing=false));\n\n// 플로팅 창 드래그\ndocument.querySelectorAll('[data-drag]').forEach(h=>{\n  h.addEventListener('mousedown',e=>{\n    if(e.target.tagName==='BUTTON') return;\n    e.preventDefault();\n    const win=$(h.dataset.drag), r=win.getBoundingClientRect();\n    const ox=e.clientX-r.left, oy=e.clientY-r.top;\n    win.style.left=r.left+'px'; win.style.top=r.top+'px'; win.style.right='auto'; win.style.bottom='auto';\n    const mv=ev=>{   // 제목줄 일부는 항상 화면 안에 남도록 제한\n      const x=Math.min(innerWidth-80, Math.max(80-r.width, ev.clientX-ox));\n      const y=Math.min(innerHeight-40, Math.max(0, ev.clientY-oy));\n      win.style.left=x+'px'; win.style.top=y+'px';\n    };\n    const up=()=>{ document.removeEventListener('mousemove',mv); document.removeEventListener('mouseup',up); };\n    document.addEventListener('mousemove',mv); document.addEventListener('mouseup',up);\n  });\n});\n$('imgGrip').addEventListener('mousedown', e => {\n  e.preventDefault(); e.stopPropagation();\n  const win=$('imgWin'), r=win.getBoundingClientRect(), sx=e.clientX, sy=e.clientY;\n  win.style.left=r.left+'px'; win.style.top=r.top+'px';\n  const mv=ev=>{\n    win.style.width = Math.max(260, Math.min(innerWidth - r.left, r.width + ev.clientX - sx)) + 'px';\n    win.style.height = Math.max(180, Math.min(innerHeight - r.top, r.height + ev.clientY - sy)) + 'px';\n  };\n  const up=()=>{ document.removeEventListener('mousemove',mv); document.removeEventListener('mouseup',up); };\n  document.addEventListener('mousemove',mv); document.addEventListener('mouseup',up);\n});\n\n// ═════════ 제출 ═════════\nfunction askSubmit(){\n  const un = answers.filter(a=>!a).length;\n  const isLast = sessPos >= sessQueue.length - 1;\n  const tail = isLast ? '답안을 제출하시겠습니까?'\n                      : `${sessQueue[sessPos]}교시 답안을 제출할까요?`;\n  $('submitMsg').innerHTML = (un ? `안 푼 문제가 <b style=\"color:var(--red)\">${un}개</b> 있습니다.` : '모든 문제에 답하였습니다.')\n    + `<br>${tail}<br><small style=\"color:#68738a\">시간이 남아 있으면 제출한 뒤에도 문제로 돌아가 고칠 수 있어요.</small>`;\n  show('submitOverlay');\n}\nfunction autoSubmit(){\n  if(submitted) return; saveResume(); submitted=true; clearInterval(timerId); hide('warnOverlay');\n  const isLast = sessPos >= sessQueue.length - 1;\n  const btn = $('timeoverBtn'); if(btn) btn.textContent = isLast ? '결과 확인' : '확인';\n  const msg = $('timeoverMsg'); if(msg) msg.innerHTML = isLast\n    ? '시험 시간이 종료되어<br>답안이 자동 제출되었습니다.'\n    : `${sessQueue[sessPos]}교시 시간이 종료되어<br>답안이 자동 제출되었습니다.`;\n  show('timeoverOverlay');\n}\n// 제출해도 이 교시 시간이 남아 있으면 [문제로 돌아가기]로 고칠 수 있다. 타이머는 계속 흐르고,\n// 교시를 끝내는 건 [다음 교시 시작]·[결과 보기]를 누르거나 시간이 다 됐을 때다. 풀이 시간은 마지막으로 제출한 때까지로 센다.\nfunction doSubmit(){\n  hide('submitOverlay');\n  submitRemain = Math.max(0, remainSec);\n  awaitEnd = true;\n  const cur = sessQueue[sessPos], next = sessQueue[sessPos + 1];\n  $('subdTitle').textContent = cur ? `${cur}교시 답안을 제출했어요` : '답안을 제출했어요';\n  $('subdNext').classList.toggle('hidden', sessPos >= sessQueue.length - 1);\n  $('subdNext').textContent = `${next}교시 시작`;\n  updateSubmittedClock();\n  show('submittedOverlay');\n}\nfunction updateSubmittedClock(){\n  const r = Math.max(0, remainSec);\n  $('subdRemain').textContent = `${Math.floor(r/60)}분 ${String(r%60).padStart(2,'0')}초`;\n}\nfunction backToQuestions(){ hide('submittedOverlay'); awaitEnd = false; submitRemain = null; }\n// choice: 'next'(다음 교시) · 'result'(결과 보기) · 없음(제출해 둔 채 시간이 끝남 → 교시 전환 창)\nfunction endSession(choice){\n  hide('submittedOverlay'); awaitEnd = false;\n  submitted = true; clearInterval(timerId);\n  if(submitRemain != null){ remainSec = submitRemain; submitRemain = null; }\n  finishSession(choice);\n}\n\n// ═════════ 결과 ═════════\nfunction showResult(){\n  clearInterval(timerId);\n  if(!drillMode) clearResume();   // 끝까지 푼 시험은 이어 풀기 저장본을 지운다\n  hide('examScreen'); closeMemo(); hide('calcWin'); hide('padWin'); show('resultScreen');\n  const graded = q => q.answer>=1 && q.answer<=5;   // 정답이 지정된 채점 가능 문항\n  const bySub = {};\n  Q.forEach((q,i)=>{\n    if(!graded(q)) return;                            // 정답 미설정 → 채점 제외\n    if(!bySub[q.subject]) bySub[q.subject]={n:0,ok:0};\n    bySub[q.subject].n++;\n    if(answers[i]===q.answer) bySub[q.subject].ok++;\n  });\n  const totalN = Q.filter(graded).length;\n  const totalOk = Q.reduce((s,q,i)=>s+((graded(q)&&answers[i]===q.answer)?1:0),0);\n  const usedSec = limitSec - Math.max(0, remainSec);\n  const timeLine = `풀이 시간: ${Math.floor(usedSec/60)}분 ${usedSec%60}초 / 제한 ${Math.round(limitSec/60)}분` + (accPauses ? ` · 일시정지 ${accPauses}회` : '');\n\n  $('studyNote').classList.add('hidden');\n  $('resArea').classList.add('hidden');\n  $('resStudyBtn').classList.toggle('hidden', !STUDY_ON);\n  if(totalN === 0){   // 방어용: 채점 가능한 문항이 없을 때\n    $('scoreTable').innerHTML =\n      `<tr><th>과목</th><th>문항 수</th><th>정답 수</th><th>정답률</th></tr>\n       <tr class=\"total\"><td>총계</td><td>${Q.length}</td><td>-</td><td>채점 제외</td></tr>`;\n    $('verdict').textContent = '풀이를 마쳤어요 ✅';\n    $('verdict').className = 'verdict pass';\n    document.querySelector('.verdict-sub').innerHTML =\n      `이 세트는 정답이 지정된 문항이 없어 채점을 생략했어요. 아래에서 내가 고른 답을 확인해 보세요.<br>${timeLine}`;\n    setReviewFilter('all');\n    return;\n  }\n\n  let anyFail = false;\n  let rows = Object.entries(bySub).map(([s,v])=>{\n    const pct = Math.round(v.ok/v.n*100);\n    const bad = v.ok / v.n < 0.4; if(bad) anyFail = true;   // 반올림한 %로 비교하면 경계에서 틀린다\n    if(drillMode) return `<tr><td>${s}</td><td>${v.n}</td><td>${v.ok}</td><td>${pct}%</td></tr>`;   // 오답 다시 풀기엔 과락 판정 없음\n    return `<tr><td>${s}</td><td>${v.n}</td><td>${v.ok}</td><td class=\"${bad?'bad':''}\">${pct}%${bad?' (과락)':''}</td></tr>`;\n  }).join('');\n  const totalPct = Math.round(totalOk/totalN*100);\n  // 교시를 다 풀기 전에 [결과 보기]를 누르면 푼 교시만의 참고 점수다 → 합격 판정도, 응시 기록의 합격권 표시도 하지 않는다\n  const partial = !drillMode && sessPos < sessQueue.length - 1;\n  const pass = !partial && totalOk / totalN >= 0.6 && !anyFail;   // 예: 72문항 중 43개(59.7%)는 불합격\n  $('scoreTable').innerHTML =\n    `<tr><th>과목</th><th>문항 수</th><th>정답 수</th><th>정답률</th></tr>${rows}\n     <tr class=\"total\"><td>총계</td><td>${totalN}</td><td>${totalOk}</td><td class=\"${totalPct<60?'bad':''}\">${totalPct}%</td></tr>`;\n  if(resAreaOn()) renderResArea();\n  const st = (STUDY_ON && !studyRecorded) ? recordStudy(bySub, totalN, totalOk, partial ? null : pass, usedSec) : null;\n  studyRecorded = true;\n  if(drillMode){\n    $('scoreTable').querySelector('tr.total td:last-child').className = '';\n    $('verdict').textContent = `${totalN}문항 중 ${totalOk}개 맞혔어요`;\n    $('verdict').className = 'verdict ' + (totalOk === totalN ? 'pass' : 'fail');\n    document.querySelector('.verdict-sub').innerHTML = `오답 다시 풀기는 합격 판정 없이 채점만 해요.<br>${timeLine}`;\n  } else if(partial){\n    $('verdict').textContent = `${sessQueue.slice(0, sessPos + 1).join('·')}교시 참고 점수예요`;\n    $('verdict').className = 'verdict';\n    document.querySelector('.verdict-sub').innerHTML =\n      `${sessQueue.slice(sessPos + 1).join('·')}교시를 풀지 않아 합격 판정은 하지 않아요. 과목별 40% 기준만 참고로 표시했어요.<br>${timeLine}`;\n  } else {\n    $('verdict').textContent = pass ? '합격권입니다! 🎉' : '아쉽지만 불합격권입니다';\n    $('verdict').className = 'verdict ' + (pass?'pass':'fail');\n    document.querySelector('.verdict-sub').innerHTML =\n      `합격 기준: 전 과목 총점의 60% 이상 &amp; 매 과목 40% 이상 (실제 필기시험 기준)<br>${timeLine}`;\n  }\n  if(st){\n    let msg;\n    if(!st.saved) msg = '이 브라우저에서는 기록을 저장하지 못했어요. (저장 공간이 꺼져 있거나 가득 찼을 수 있어요)';\n    else if(drillMode) msg = `맞힌 <b>${st.removed}문항</b>은 오답노트에서 뺐어요 · 남은 오답 <b>${st.remain}문항</b>`;\n    else {\n      msg = st.wrongNow ? `틀리거나 비운 <b>${st.wrongNow}문항</b>을 오답노트에 담았어요` : '틀린 문제가 없어 오답노트에 담을 게 없어요 👏';\n      if(st.removed) msg += ` · 예전에 틀렸다가 이번에 맞힌 ${st.removed}문항은 뺐어요`;\n      if(st.diffs.length) msg += '<br>지난번 대비: ' + st.diffs.map(([s, v]) => `${esc(s)} ${v > 0 ? '+' + v : v < 0 ? '−' + (-v) : '±0'}%p`).join(' · ');\n    }\n    $('studyNote').innerHTML = msg;\n    $('studyNote').classList.remove('hidden');\n  }\n  setReviewFilter('wrong');\n}\n// ═════════ 문항·해설 보호 ═════════\n// 해설은 화면에서만 본다. 인쇄(Ctrl·⌘+P)·페이지 저장(Ctrl·⌘+S) 단축키를 막고, 인쇄 화면엔 안내 문구만 나오게 했다(@media print).\n// 복사·잘라내기·끌어 옮기기는 메모·입력칸 말고는 막는다. 시험 화면의 글자 선택(형광펜)은 그대로 둔다.\n// 우클릭은 결과·오답노트 화면과 그림에서 막는다. 화면 캡처는 웹에서 막을 수 없어 약관·결과 화면 안내로 보완한다.\nfunction editableTarget(t){ return !!(t && t.closest && t.closest('input, textarea, [contenteditable=\"true\"]')); }\ndocument.addEventListener('keydown', e => {\n  const k = (e.key || '').toLowerCase();\n  if((e.ctrlKey || e.metaKey) && (k === 'p' || k === 's')){\n    e.preventDefault();\n    alert('문항과 해설은 화면에서만 볼 수 있어요.\\n인쇄·PDF 저장·페이지 저장은 지원하지 않아요.');\n  }\n});\n['copy', 'cut'].forEach(ev => document.addEventListener(ev, e => { if(!editableTarget(e.target)) e.preventDefault(); }));\ndocument.addEventListener('dragstart', e => { if(!editableTarget(e.target)) e.preventDefault(); });\ndocument.addEventListener('contextmenu', e => {\n  const t = e.target;\n  if(t && t.closest && (t.closest('#resultScreen, #studyScreen') || t.tagName === 'IMG')) e.preventDefault();\n});\n\n// ═════════ 문항 태그 ═════════\n// questions.js 끝의 QTAGS가 문항마다 q.tag = {c:분류, a:세부 영역, k:유형 키워드, p:출제 포인트, n:핵심개념}을 붙인다.\n// 해설 칸 태그는 모든 버전에서 보인다(2026-09-29 체험 사이트 cbt1·cbt2도 켬).\nconst TAG_CATS = ['이론·개념', '평가·해석', '중재·상담'];\nconst TAG_AREAS = {\n  '신경언어장애': ['신경해부·뇌혈관', '실어증', '실독증·실서증', '말운동장애', '삼킴장애', '인지의사소통장애'],\n  '언어발달장애': ['초기 의사소통·상징행동', '어휘·의미', '문법·형태', '화용·대화', '이야기·담화', '읽기·쓰기', '대상군 특성', '중재 방법·AAC'],\n  '유창성장애': ['말더듬 이론·특성', '비유창성 분석', '평가도구', '발달 단계·감별', '학령전 아동 치료·부모 상담', '학령기·성인 치료'],\n  '음성장애': ['해부·생리·음향 기초', '음성장애 유형', '음성 평가', '음성치료 기법·음성위생', '공명장애', '특수 대상'],\n  '조음음운장애': ['음성학·음운론 기초', '말소리 발달·오류패턴', '평가·분석 지표', '치료 접근·목표 선정', '음운인식', '구개열·기질적 말소리장애', '말운동 말소리장애', '청각·청각장애'],\n  '언어재활현장실무': ['법·제도', '윤리·역할', '상담', '연구·통계', '다문화·이중언어', '통합 사례'],\n};\nfunction tagsOn(){ return true; }\n// 결과 화면 '세부 영역별 오답률'은 체험 사이트(cbt1·cbt2)만 — 이번 시험분만 세고 저장하지 않는다.\n// 정식판은 여러 번 푼 기록을 모으는 오답노트 약점 그래프(weakHTML)로 본다.\nfunction resAreaOn(){ return !!window.IS_TRIAL_SITE && !drillMode; }\nfunction renderResArea(){\n  const st = {};\n  Q.forEach((q, i) => {\n    if(!(q.answer >= 1 && q.answer <= 5) || !q.tag || !TAG_AREAS[q.subject]) return;\n    const s = st[q.subject] = st[q.subject] || { area: {}, cat: {} };\n    const wrong = answers[i] === q.answer ? 0 : 1;   // 비운 문항도 틀린 것으로 센다\n    [['area', q.tag.a], ['cat', q.tag.c]].forEach(([kind, name]) => {\n      const v = s[kind][name] = s[kind][name] || { seen: 0, wrong: 0 };\n      v.seen++; v.wrong += wrong;\n    });\n  });\n  const subs = Object.keys(st);\n  if(!subs.length) return;\n  const cards = subs.map(s => {\n    const v = st[s];\n    const cats = TAG_CATS.filter(c => v.cat[c]).map(c => {\n      const x = v.cat[c];\n      return `${c.split('·')[0]} ${x.seen >= WK_MIN ? Math.round(x.wrong / x.seen * 100) + '%' : x.wrong + '/' + x.seen}`;\n    }).join(' · ');\n    return `<div class=\"wk-card\"><h3><span>${esc(s)}</span></h3>\n      <div class=\"wk-cats\">오답률 · ${cats}</div>${wkRows(TAG_AREAS[s].filter(a => v.area[a]), v.area, '', '', true)}</div>`;\n  }).join('');\n  $('resArea').innerHTML = `<h3 class=\"ra-h\">세부 영역별 오답률 (이번 시험)</h3>\n    <div class=\"wk-note\" style=\"margin:0 0 10px;\">막대는 영역마다 틀리거나 비운 문항의 비율이에요. 가장 약한 영역은 빨간색, 문항이 ${WK_MIN}개보다 적은 영역은 회색으로 보여요.</div>\n    <div class=\"wk-grid\">${cards}</div>`;\n  $('resArea').classList.remove('hidden');\n}\nfunction tagHTML(q){\n  const t = tagsOn() && q && q.tag;\n  if(!t) return '';\n  return `<div class=\"rv-tags\"><span class=\"tg-cat\">${esc(t.c)}</span><span class=\"tg-area\">${esc(t.a)}</span>${t.k ? `<span class=\"tg-kw\">${esc(t.k)}</span>` : ''}</div>\n    <div class=\"rv-meta\">${t.p ? `<div><b>출제 포인트</b>${esc(t.p)}</div>` : ''}${t.n ? `<div><b>핵심개념</b>${esc(t.n)}</div>` : ''}</div>`;\n}\n\nfunction setReviewFilter(mode){\n  const area = $('reviewArea');\n  const graded = q => q.answer>=1 && q.answer<=5;\n  const items = Q.map((q,i)=>({q,i})).filter(({q,i}) => mode==='all' || (graded(q) && answers[i]!==q.answer));\n  if(!items.length){\n    area.innerHTML = '<div class=\"rv-card\" style=\"text-align:center;color:#1a7f37;font-weight:700;\">틀린 문제가 없습니다! 완벽해요 👏</div>';\n    return;\n  }\n  area.innerHTML = `<div style=\"text-align:center;color:#68738a;margin-bottom:12px;font-size:14px;\">${mode==='all'?'전체':'틀린'} 문제 해설 (${items.length}문항)</div>` +\n    items.map(({q,i})=>{\n      const my = answers[i], g = graded(q);\n      const badge = !g ? '<span class=\"rv-badge skip\">정답 미설정</span>'\n                  : !my ? '<span class=\"rv-badge skip\">안 품</span>'\n                  : my===q.answer ? '<span class=\"rv-badge ok\">정답</span>'\n                  : '<span class=\"rv-badge no\">오답</span>';\n      return `<div class=\"rv-card\">\n        <div class=\"rv-head\">${badge}${drillMode?`<span class=\"rv-origin\">${keyLabel(Q_KEY.get(q))}</span>`:''}<b>${i+1}.</b> ${esc(q.q)} <span class=\"subj\" style=\"font-size:12px;color:#33518e;\">[${esc(q.subject)}]</span></div>\n        ${q.stem?`<div class=\"rv-stem\">${fmt(q.stem)}</div>`:''}\n        ${q.image?`<div class=\"qimg-wrap\"><img class=\"qimg\" src=\"${esc(q.image)}\" alt=\"문항 자료 이미지\" title=\"클릭하면 크게 볼 수 있습니다\" onclick=\"openImg(this.src)\"><div class=\"qimg-hint\"><button type=\"button\" class=\"qimg-btn\" onclick=\"openImg(this.closest('.qimg-wrap').querySelector('img').src)\">&#128269; 크게 보기</button></div></div>`:''}\n        <ul class=\"rv-choices\">\n          ${q.choices.map((c,ci)=>{\n            const cls = [g&&ci+1===q.answer?'correct':'', my===ci+1?('mine'+(g&&my!==q.answer?' wrong':'')):''].join(' ');\n            return `<li class=\"${cls}\">${circled(ci)} ${esc(c)}${g&&ci+1===q.answer?' ✔':''}${g&&my===ci+1&&my!==q.answer?' ← 내 답':''}${!g&&my===ci+1?' ← 내 답':''}</li>`;\n          }).join('')}\n        </ul>\n        ${tagHTML(q)}\n        ${explainHTML(q, Q_KEY.get(q))}\n      </div>`;\n    }).join('');\n  window.scrollTo(0,0);\n}\n\n</script>\n<script>\n// PC 안내에 지금 접속한 주소를 그대로 표시(소소숲·Vercel 등 배포처가 여럿이라 고정하지 않음)\n(function(){var e=document.getElementById('pcOnlyUrl');\n if(e) e.textContent = location.host + location.pathname.replace(/\\/index\\.html$/,'');})();\n</script>\n</body>\n</html>\n"