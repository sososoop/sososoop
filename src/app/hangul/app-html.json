"<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>한글놀이</title>\n<style>\n  :root{\n    --lime:#eaff3d;      /* 형광 라임 포인트 */\n    --lime-soft:#f2ff8f; /* 옅은 라임(하이라이트 박스) */\n    --blue:#5b6ef5;      /* 선택 탭 */\n    --ink:#141414;       /* 검정 테두리/글자 */\n    --real:#3ecf6a;      /* 의미단어 */\n    --nonsense:#ff8a4c;  /* 무의미단어 */\n    --sent:#b79bff;      /* 문장 */\n    --cho:#bfe3ff;       /* 초성 */\n    --jung:#eaff3d;      /* 중성 */\n    --jong:#ffd6a5;      /* 종성 */\n    --paper:#fff;\n    --bg:#f4f4ef;\n    --bd:2px solid var(--ink);\n    --sh:4px 4px 0 var(--ink);\n    --sh-sm:3px 3px 0 var(--ink);\n  }\n  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\n  html,body{margin:0;padding:0}\n  body{\n    font-family:\"Apple SD Gothic Neo\",\"Malgun Gothic\",Pretendard,sans-serif;\n    background:var(--bg);\n    color:var(--ink);\n    min-height:100vh;\n    -webkit-text-size-adjust:100%;\n  }\n  /* ---------- 상단 라임 바 ---------- */\n  .topbar{\n    background:var(--lime);border-bottom:var(--bd);\n    display:flex;align-items:center;justify-content:space-between;\n    padding:16px 20px;flex-wrap:wrap;gap:8px;\n  }\n  .brand{font-size:22px;font-weight:900;letter-spacing:-.5px;display:flex;align-items:center;gap:8px}\n  .brand .dotmark{width:16px;height:16px;background:var(--ink);border-radius:50%;display:inline-block}\n  .topbar .right{display:flex;align-items:center;gap:8px}\n  .hw-badge{display:none;background:var(--ink);color:var(--lime);font-size:13px;font-weight:900;padding:8px 14px;border-radius:2px}\n  .trial-badge{display:none;background:var(--blue);color:#fff;font-size:13px;font-weight:900;padding:8px 14px;border:2px solid var(--ink);text-decoration:none;box-shadow:3px 3px 0 var(--ink)}\n  .locked-feat{opacity:.55}\n  .top-link{border:2px solid var(--ink);background:#fff;color:var(--ink);text-decoration:none;font-size:13px;font-weight:800;padding:8px 14px;box-shadow:3px 3px 0 var(--ink)}\n\n  .modeswitch{\n    max-width:980px;margin:22px auto 0;padding:0 16px;\n    display:flex;gap:10px;flex-wrap:wrap;\n  }\n  .modeswitch button{\n    border:var(--bd);background:#fff;padding:11px 20px;\n    font-size:15px;font-weight:800;color:var(--ink);cursor:pointer;\n    box-shadow:var(--sh-sm);transition:transform .08s;\n  }\n  .modeswitch button:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .modeswitch button.on{background:var(--blue);color:#fff}\n  main{max-width:980px;margin:0 auto;padding:16px 16px 70px}\n  .panel{display:none}\n  .panel.on{display:block;animation:fade .18s}\n  @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}\n\n  /* ---------- 공용 카드 ---------- */\n  .card{background:var(--paper);border:var(--bd);border-radius:2px;padding:20px;margin:16px 0;box-shadow:var(--sh)}\n  .card h2{font-size:18px;font-weight:900;margin:0 0 14px;display:flex;align-items:center;gap:8px}\n  .eyebrow{font-size:12px;font-weight:900;letter-spacing:2px;color:var(--blue);margin:0 0 4px}\n  .hint{font-size:13px;color:#555;margin:4px 0 14px;line-height:1.6}\n  .hint b{color:var(--ink)}\n  .mini-btn{border:var(--bd);border-radius:2px;background:#fff;font-size:12px;font-weight:800;padding:7px 11px;cursor:pointer;box-shadow:var(--sh-sm);transition:transform .06s;color:var(--ink)}\n  .mini-btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .mini-btn.warn{background:#ffdad7}\n\n  /* ---------- 프로필 바 ---------- */\n  .profile-bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}\n  .profile-bar select{padding:10px 12px;border:var(--bd);border-radius:2px;font-size:15px;font-weight:800;background:#fff;color:var(--ink);min-width:120px}\n\n  /* ---------- 진도 그리드 ---------- */\n  .prog-series{margin:0 0 6px}\n  .series-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:18px 0 8px}\n  .series-title{font-size:15px;font-weight:900}\n  .series-count{font-size:12px;font-weight:800;color:var(--blue)}\n  .pg-grouplabel{font-size:11px;font-weight:900;color:#999;letter-spacing:1px;margin:12px 2px 6px}\n  .pg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(52px,1fr));gap:8px}\n  .pg-tile{\n    position:relative;border:var(--bd);border-radius:2px;background:#fff;\n    font-size:22px;font-weight:900;padding:12px 0;text-align:center;cursor:pointer;\n    box-shadow:var(--sh-sm);transition:transform .06s;color:var(--ink);min-height:48px;\n  }\n  .pg-tile:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .pg-tile.on{background:var(--lime)}\n  .pg-tile.on:after{content:\"✓\";position:absolute;top:2px;right:5px;font-size:11px;font-weight:900;color:var(--ink)}\n  .pg-tile.fixed{background:var(--lime-soft);cursor:default;opacity:.9}\n  .pg-tile.fixed:active{transform:none;box-shadow:var(--sh-sm)}\n  .pg-tile:focus-visible,.jamo-tile:focus-visible{outline:3px solid var(--blue);outline-offset:2px}\n  .active-syls{display:flex;flex-wrap:wrap;gap:7px}\n\n  /* ---------- 놀이: 블렌딩 보드 ---------- */\n  .board{\n    display:flex;gap:10px;justify-content:center;align-items:flex-end;flex-wrap:wrap;\n    min-height:120px;background:var(--lime-soft);border:var(--bd);border-radius:2px;padding:18px 14px;margin-bottom:10px;\n  }\n  .syl-box{\n    position:relative;min-width:74px;min-height:92px;display:flex;align-items:center;justify-content:center;\n    font-size:52px;font-weight:900;line-height:1;border-radius:4px;cursor:pointer;padding:6px 8px;\n  }\n  .syl-box.locked{background:#e7e7de;border:2px solid #b7b7ab;color:#444}\n  .syl-box.active{background:#fff;border:2px dashed var(--blue)}\n  .syl-box.pop{animation:pop .16s}\n  @keyframes pop{from{transform:scale(.6);opacity:.3}to{transform:scale(1);opacity:1}}\n  .board .placeholder{color:#8f8f7a;font-size:16px;font-weight:800}\n  .verdict{text-align:center;font-size:16px;font-weight:900;min-height:26px;margin:8px 0 2px}\n  .verdict.real{color:#2a9d54}\n  .verdict.nonsense{color:#e06a2a}\n  .verdict.checking{color:#888}\n  .buildbtns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:10px}\n  .buildbtns button, .genbtns button{\n    border:var(--bd);border-radius:2px;padding:12px 18px;font-size:14px;font-weight:900;cursor:pointer;box-shadow:var(--sh-sm);transition:transform .08s;color:var(--ink);\n  }\n  .buildbtns button:active, .genbtns button:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .buildbtns button:disabled{opacity:.4;cursor:not-allowed}\n  .btn-next{background:var(--blue);color:#fff}\n  .btn-back{background:#fff}\n  .btn-random{background:var(--cho)}\n  .btn-save{background:var(--lime)}\n\n  /* 자모 존 */\n  .zone{margin-top:14px}\n  .zone-label{font-size:12px;font-weight:900;color:#888;letter-spacing:1px;margin:0 2px 7px;display:flex;align-items:center;gap:8px}\n  .zone-tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(56px,1fr));gap:9px}\n  .jamo-tile{\n    border:var(--bd);border-radius:2px;font-size:26px;font-weight:900;padding:13px 0;cursor:pointer;\n    box-shadow:var(--sh-sm);transition:transform .06s;color:var(--ink);text-align:center;min-height:52px;\n  }\n  .jamo-tile:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .jamo-tile.cho{background:var(--cho)}\n  .jamo-tile.jung{background:var(--jung)}\n  .jamo-tile.jong{background:var(--jong)}\n  .jamo-tile.sel{outline:3px solid var(--ink);outline-offset:-1px}\n  .zone-empty{font-size:13px;color:#999;font-weight:700}\n\n  /* 저장한 단어 / 칩 */\n  .collected{display:flex;flex-wrap:wrap;gap:9px;margin-top:4px}\n  .chip{padding:7px 13px;border:var(--bd);border-radius:2px;font-size:16px;font-weight:800;box-shadow:var(--sh-sm);background:#fff}\n  .chip.real{background:var(--real)}\n  .chip.nonsense{background:var(--nonsense)}\n  .empty{color:#999;font-size:13px;font-weight:600}\n\n  /* ---------- 생성 모드 ---------- */\n  .controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}\n  .field label{display:block;font-size:12px;font-weight:900;color:#666;margin-bottom:6px}\n  .field select,.field input{\n    width:100%;padding:11px 10px;border:var(--bd);border-radius:2px;font-size:14px;font-weight:700;background:#fff;color:var(--ink);\n  }\n  .segrow{display:flex;gap:6px;flex-wrap:wrap}\n  .seg{display:inline-flex;border:var(--bd);border-radius:2px;overflow:hidden;box-shadow:var(--sh-sm)}\n  .seg-btn{border:0;border-right:2px solid var(--ink);background:#fff;font-weight:900;font-size:13px;padding:10px 14px;cursor:pointer;color:var(--ink)}\n  .seg-btn:last-child{border-right:0}\n  .seg-btn.on{background:var(--blue);color:#fff}\n  .genbtns{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}\n  .btn-gen{background:var(--blue);color:#fff}\n  .btn-print{background:var(--lime)}\n  .btn-copy{background:#fff}\n\n  .result-list{margin-top:8px}\n  .result-item{\n    display:flex;align-items:center;gap:12px;padding:11px 4px;border-bottom:2px solid #eee;font-size:20px;font-weight:800;\n  }\n  .result-item:last-child{border-bottom:0}\n  .result-item .idx{font-size:12px;color:#aaa;min-width:24px;font-weight:800}\n  .result-item .tag{font-size:11px;font-weight:900;padding:3px 9px;border:2px solid var(--ink);margin-left:auto}\n  .tag.real{background:var(--real)}\n  .tag.nonsense{background:var(--nonsense)}\n  .tag.sent{background:var(--sent)}\n  .result-empty{color:#999;font-size:14px;font-weight:600;padding:14px 0}\n  .tag.pair{background:var(--lime)}\n  .result-item .tg{text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:5px;text-decoration-color:var(--blue)}\n  .target-box{margin-top:16px;padding:12px 12px 4px;border:var(--bd);border-radius:2px;background:#fafafa}\n  .target-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px}\n  .target-head b{font-size:14px}\n  .target-head .sub{font-size:12px;color:#777;font-weight:700}\n  .target-box .pg-grid{grid-template-columns:repeat(auto-fill,minmax(42px,1fr))}\n  .target-box .pg-tile.on{background:var(--blue);color:#fff}\n  .target-box .pg-tile.on:after{color:#fff}\n  .target-box .pg-tile.on.off{background:repeating-linear-gradient(45deg,#9aa6ff,#9aa6ff 6px,#c9cfff 6px,#c9cfff 12px);color:var(--ink)}\n  .src-note{font-size:12px;color:#888;font-weight:700;margin-top:10px}\n  /* 음절표 */\n  .syl-table{border-collapse:collapse;width:100%;margin-top:8px}\n  .syl-table th,.syl-table td{border:2px solid var(--ink);text-align:center;font-size:22px;font-weight:900;padding:8px 4px}\n  .syl-table th{background:var(--lime-soft);font-size:18px}\n  .syl-table td.real-cell{background:var(--lime);}\n  .syl-table caption{font-weight:900;font-size:14px;margin-bottom:6px;text-align:left}\n\n  /* ---------- 게임 ---------- */\n  .game-top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px}\n  .game-stats{display:flex;gap:16px;font-size:13px;font-weight:800;color:#555}\n  .game-stats b{font-size:20px;color:var(--ink)}\n  .arena{position:relative;height:330px;background:var(--lime-soft);border:var(--bd);border-radius:2px;overflow:hidden;margin-bottom:14px}\n  .bricks{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:16px}\n  .brick{\n    border:var(--bd);border-radius:2px;box-shadow:var(--sh-sm);color:var(--ink);\n    font-size:30px;font-weight:900;min-height:58px;line-height:1;\n    display:flex;align-items:center;justify-content:center;\n  }\n  .brick.shatter{animation:shatter .26s forwards}\n  @keyframes shatter{to{transform:scale(1.5) rotate(12deg);opacity:0}}\n  .ball{position:absolute;left:0;top:0;width:18px;height:18px;border-radius:50%;background:var(--ink);z-index:5;box-shadow:var(--sh-sm)}\n  .paddle{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);width:88px;height:12px;background:var(--blue);border:var(--bd);border-radius:2px;z-index:4}\n  .game-input-row{display:flex;gap:10px;align-items:center}\n  #gameInput{flex:1;padding:14px 16px;border:var(--bd);border-radius:2px;font-size:24px;font-weight:800;background:#fff;color:var(--ink);text-align:center}\n  #gameInput:focus{outline:none;box-shadow:var(--sh-sm)}\n  #gameInput.wrong{background:#ffdad7;animation:shake .2s}\n  @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}\n  .game-msg{text-align:center;font-size:18px;font-weight:900;min-height:26px;margin-top:14px;color:var(--blue)}\n  .game-picker{display:flex;gap:10px;margin:2px 0 14px}\n  .gp-btn{flex:1;border:var(--bd);border-radius:2px;background:#fff;font-weight:900;font-size:16px;padding:14px 10px;cursor:pointer;color:var(--ink);box-shadow:var(--sh-sm);transition:transform .08s}\n  .gp-btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .gp-btn.on{background:var(--lime)}\n  .particle{position:absolute;width:11px;height:11px;border:2px solid var(--ink);pointer-events:none;z-index:8;animation:burst .5s ease-out forwards}\n  @keyframes burst{to{transform:translate(var(--dx),var(--dy)) rotate(200deg);opacity:0}}\n  .rain-arena{overflow:hidden}\n  .rain-ground{position:absolute;left:0;right:0;bottom:0;height:8px;background:var(--ink);z-index:2}\n  .rain-lives{position:absolute;right:12px;bottom:12px;font-size:20px;letter-spacing:2px;z-index:6}\n  .raindrop{position:absolute;left:0;top:0;background:#fff;border:var(--bd);border-radius:2px;box-shadow:var(--sh-sm);font-size:26px;font-weight:900;padding:10px 14px;line-height:1;white-space:nowrap;z-index:3;color:var(--ink);cursor:pointer;touch-action:manipulation}\n  .raindrop:active{background:var(--lime)}\n  .raindrop.splash{animation:splash .3s forwards}\n  @keyframes splash{to{opacity:0;background:#ffb3ad}}\n  .rain-pause{display:none;position:absolute;inset:0;z-index:9;background:rgba(244,244,239,.9);align-items:center;justify-content:center;text-align:center;font-size:28px;font-weight:900;color:var(--ink)}\n  .rain-pause span{display:block;margin-top:8px;font-size:14px;font-weight:800;color:#666}\n\n  footer{text-align:center;font-size:12px;font-weight:700;color:#999;padding:24px 10px}\n\n  /* 모달 */\n  .modal-back{display:none;position:fixed;inset:0;background:rgba(20,20,20,.45);z-index:50;align-items:center;justify-content:center;padding:20px}\n  .modal-back.on{display:flex}\n  .modal{background:#fff;border:var(--bd);border-radius:2px;box-shadow:var(--sh);padding:22px;max-width:380px;width:100%}\n  .modal h3{margin:0 0 12px;font-size:17px;font-weight:900}\n  .modal input{width:100%;padding:12px;border:var(--bd);border-radius:2px;font-size:16px;font-weight:700;margin-bottom:14px}\n  .modal .row{display:flex;gap:10px;justify-content:flex-end}\n  .modal .row button{border:var(--bd);border-radius:2px;padding:10px 16px;font-weight:900;cursor:pointer;box-shadow:var(--sh-sm);background:#fff}\n  .modal .row .ok{background:var(--lime)}\n  .modal .msg{font-size:14px;line-height:1.6;margin-bottom:14px}\n\n  @media print{\n    body{background:#fff}\n    .topbar,.modeswitch,footer,.controls,.genbtns,.hint,.eyebrow,#playPanel,#gamePanel,#progPanel{display:none !important}\n    .card{box-shadow:none;border:2px solid #000;break-inside:avoid}\n    .result-item{font-size:22px}\n    .result-item .tag,.syl-table td.real-cell{-webkit-print-color-adjust:exact;print-color-adjust:exact}\n    .target-box{display:none !important}\n    #printTitle{display:block !important}\n    #printSrc{display:block !important}\n  }\n  #printTitle{display:none;text-align:center;font-size:22px;font-weight:900;margin-bottom:10px}\n</style>\n</head>\n<body>\n<div class=\"topbar\">\n  <div class=\"brand\"><span class=\"dotmark\"></span><span id=\"brandName\">한글놀이</span></div>\n  <div class=\"right\">\n    <span class=\"hw-badge\" id=\"hwBadge\">🏠 오늘의 연습</span>\n    <a class=\"trial-badge\" id=\"trialBadge\" href=\"https://sososoop.com/hangul\" target=\"_blank\" rel=\"noopener\">정식판 보기</a>\n    <a href=\"manual.html\" class=\"top-link\" id=\"manualLink\">❓ 사용법</a>\n  </div>\n</div>\n<div class=\"modeswitch\" id=\"modeswitch\">\n  <button id=\"tabProg\" class=\"on\" onclick=\"switchMode('prog')\">⚙️ 진도 설정</button>\n  <button id=\"tabPlay\" onclick=\"switchMode('play')\">💡 놀이</button>\n  <button id=\"tabGame\" onclick=\"switchMode('game')\">🎮 게임</button>\n  <button id=\"tabGen\" onclick=\"switchMode('gen')\">🖨️ 자료 만들기</button>\n</div>\n\n<main>\n  <!-- ================= 진도 설정 ================= -->\n  <section id=\"progPanel\" class=\"panel on\">\n    <div class=\"card\">\n      <h2>👦 아동 프로필</h2>\n      <p class=\"hint\" style=\"margin-top:0\">아동마다 배운 음소가 다르니, 프로필을 나눠 관리하세요. 실명 대신 <b>별칭</b>을 권장해요. 이름·진도는 이 기기에만 저장됩니다.</p>\n      <div class=\"profile-bar\">\n        <select id=\"profileSelect\" onchange=\"switchProfile(this.value)\"></select>\n        <button class=\"mini-btn\" onclick=\"addProfile()\">＋ 추가</button>\n        <button class=\"mini-btn\" onclick=\"renameProfile()\">✏️ 이름변경</button>\n        <button class=\"mini-btn warn\" onclick=\"deleteProfile()\">🗑 삭제</button>\n        <button class=\"mini-btn\" onclick=\"exportProfiles()\">📤 내보내기</button>\n        <button class=\"mini-btn\" onclick=\"if(TRIAL){trialLock('프로필 가져오기');return;} document.getElementById('importFile').click()\">📥 가져오기</button>\n        <input type=\"file\" id=\"importFile\" accept=\"application/json,.json\" style=\"display:none\" onchange=\"importProfiles(this.files[0])\">\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <h2>🔤 지금 만들 수 있는 글자</h2>\n      <p class=\"hint\" style=\"margin-top:0\">아래에서 켠 초성·중성·종성으로 조합되는 글자 예시입니다. (일부만 표시)</p>\n      <div class=\"active-syls\" id=\"activeSyls\"></div>\n    </div>\n\n    <div class=\"card\">\n      <h2>⚙️ 진도 설정 <button class=\"mini-btn\" style=\"margin-left:auto\" onclick=\"makeHwLink()\">🏠 가정과제 링크</button></h2>\n      <p class=\"hint\" style=\"margin-top:0\">오늘 배운 음소만 켜세요. 켠 음소만 놀이·게임·자료 만들기에 쓰입니다. 변경은 자동 저장됩니다.</p>\n      <div id=\"progGrids\"></div>\n    </div>\n\n    <div class=\"card\">\n      <p class=\"hint\" style=\"margin:0;font-size:12px;color:#888\">\n        📖 의미 단어 출처: 국립국어원 <b>한국어기초사전</b>·<b>표준국어대사전</b> (CC BY-SA 2.0 KR). 사전에 실린 1~3음절 표제어 목록만 쓰며 뜻풀이는 저장·표시하지 않습니다.\n      </p>\n    </div>\n  </section>\n\n  <!-- ================= 놀이(블렌딩 보드) ================= -->\n  <section id=\"playPanel\" class=\"panel\">\n    <div class=\"card\">\n      <p class=\"eyebrow\">BLENDING BOARD</p>\n      <h2>✏️ 초성·중성·종성을 눌러 글자를 만들어요</h2>\n      <div class=\"board\" id=\"board\">\n        <span class=\"placeholder\">아래 자모를 눌러보세요</span>\n      </div>\n      <div class=\"verdict\" id=\"verdict\"></div>\n      <div class=\"buildbtns\">\n        <button class=\"btn-next\" id=\"nextBtn\" onclick=\"nextSyl()\">다음 글자 ＋</button>\n        <button class=\"btn-back\" onclick=\"delLast()\">⬅️ 지우기</button>\n        <button class=\"btn-clear\" onclick=\"clearBoard()\">🧹 처음부터</button>\n        <button class=\"btn-save\" onclick=\"saveWord()\">⭐ 담기</button>\n      </div>\n      <div class=\"buildbtns\" style=\"margin-top:8px\">\n        <span style=\"align-self:center;font-size:14px;font-weight:900\">🎲 랜덤 글자</span>\n        <button class=\"btn-random\" onclick=\"randomWord(1)\">1음절</button>\n        <button class=\"btn-random\" onclick=\"randomWord(2)\">2음절</button>\n        <button class=\"btn-random\" onclick=\"randomWord(3)\">3음절</button>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"zone\">\n        <div class=\"zone-label\">초성 (첫소리)</div>\n        <div class=\"zone-tiles\" id=\"zoneCho\"></div>\n      </div>\n      <div class=\"zone\">\n        <div class=\"zone-label\">중성 (가운뎃소리)</div>\n        <div class=\"zone-tiles\" id=\"zoneJung\"></div>\n      </div>\n      <div class=\"zone\">\n        <div class=\"zone-label\">종성 (받침)</div>\n        <div class=\"zone-tiles\" id=\"zoneJong\"></div>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <h2>⭐ 담은 단어 <span id=\"collectedCount\" style=\"font-size:13px;color:#8a8578;font-weight:600\"></span>\n        <button class=\"mini-btn\" style=\"margin-left:auto\" onclick=\"collectedToHandwriting()\">✍️ 글씨연습장</button></h2>\n      <p class=\"hint\" style=\"margin:0 0 10px\">초록색은 사전에 실린 단어예요. 색이 없으면 사전에서 확인되지 않은 글자예요(활용형·이름일 수 있어요).</p>\n      <div class=\"collected\" id=\"collected\"><span class=\"empty\">아직 담은 단어가 없어요.</span></div>\n    </div>\n  </section>\n\n  <!-- ================= 게임 ================= -->\n  <section id=\"gamePanel\" class=\"panel\">\n    <div class=\"card\">\n      <p class=\"eyebrow\">TYPING GAMES</p>\n      <h2>🎮 타자 게임 <button id=\"soundToggle\" class=\"mini-btn\" style=\"margin-left:auto\" onclick=\"toggleSound()\">🔊</button></h2>\n      <div class=\"game-picker\">\n        <button class=\"gp-btn on\" data-game=\"brick\" onclick=\"selectGame('brick')\">🧱 벽돌깨기</button>\n        <button class=\"gp-btn\" data-game=\"rain\" onclick=\"selectGame('rain')\">💻 글자잡기</button>\n      </div>\n      <p class=\"hint\" id=\"gameHint\">벽돌에 적힌 글자를 <b>타자로 치면</b> 공이 날아가 벽돌을 깨요! 진도에서 켠 음소로 만든 글자만 나와요. 시간제한은 없으니 <b>천천히 소리 내어 읽고</b> 쳐보세요.</p>\n      <div class=\"segrow\" id=\"rainSpeedRow\" style=\"display:none;margin:0 0 14px\">\n        <span style=\"font-size:13px;font-weight:900;align-self:center;margin-right:6px\">속도</span>\n        <div class=\"seg\">\n          <button class=\"seg-btn on\" data-spd=\"1\" onclick=\"setRainSpeed(1)\">1단계·느림</button>\n          <button class=\"seg-btn\" data-spd=\"2\" onclick=\"setRainSpeed(2)\">2단계·보통</button>\n          <button class=\"seg-btn\" data-spd=\"3\" onclick=\"setRainSpeed(3)\">3단계·빠름</button>\n        </div>\n      </div>\n      <div class=\"game-top\">\n        <div class=\"seg\">\n          <button class=\"seg-btn on\" data-diff=\"syl\" onclick=\"setDiff('syl')\">한 글자</button>\n          <button class=\"seg-btn\" data-diff=\"word2\" onclick=\"setDiff('word2')\">두 글자</button>\n          <button class=\"seg-btn\" data-diff=\"word3\" onclick=\"setDiff('word3')\">세 글자</button>\n        </div>\n        <div class=\"game-stats\">\n          <span>점수 <b id=\"gScore\">0</b></span>\n          <span>콤보 <b id=\"gCombo\">0</b></span>\n          <span><span id=\"gThirdLabel\">깬 판</span> <b id=\"gStage\">0</b></span>\n          <span id=\"bestStat\" style=\"display:none\">🏆 최고 <b id=\"gBest\">0</b></span>\n        </div>\n      </div>\n      <p class=\"hint\" style=\"margin:0 0 12px\">💡 <b>한 글자·두 글자·세 글자</b>는 나오는 낱말의 글자 수예요. 두·세 글자는 <b>진도 설정</b>에서 켠 글자를 조합해 만들어서, 실제 낱말이 아닐 수도 있어요.</p>\n\n      <div id=\"brickGame\">\n        <div class=\"arena\" id=\"gameArena\">\n          <div class=\"bricks\" id=\"brickGrid\"></div>\n          <div class=\"ball\" id=\"gameBall\"></div>\n          <div class=\"paddle\" id=\"gamePaddle\"></div>\n        </div>\n      </div>\n      <div id=\"rainGame\" style=\"display:none\">\n        <div class=\"arena rain-arena\" id=\"rainArena\">\n          <div class=\"rain-ground\"></div>\n          <div class=\"rain-lives\" id=\"rainLives\"></div>\n          <div class=\"rain-pause\" id=\"rainPause\"><div>⏸️ 일시정지<br><span>“▶️ 계속하기”를 누르면 이어서 해요</span></div></div>\n        </div>\n      </div>\n\n      <div class=\"game-input-row\">\n        <input id=\"gameInput\" type=\"text\" placeholder=\"글자를 입력하세요\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\">\n        <button class=\"mini-btn\" id=\"pauseBtn\" style=\"display:none\" onclick=\"togglePause()\">⏸️ 일시정지</button>\n        <button class=\"mini-btn\" onclick=\"restartGame()\">🔄 다시</button>\n      </div>\n      <div class=\"game-msg\" id=\"gameMsg\"></div>\n    </div>\n  </section>\n\n  <!-- ================= 자료 만들기 ================= -->\n  <section id=\"genPanel\" class=\"panel\">\n    <div id=\"printTitle\"></div>\n    <div class=\"card\">\n      <p class=\"eyebrow\">AUTO GENERATOR</p>\n      <h2>🖨️ 학습 자료 만들기</h2>\n      <p class=\"hint\">조건을 정하고 <b>생성</b>을 누르면 목록이 만들어져요. 현재 프로필에서 켠 음소만 사용합니다.</p>\n      <div class=\"controls\">\n        <div class=\"field\">\n          <label>유형</label>\n          <select id=\"genType\">\n            <option value=\"real\">의미 단어</option>\n            <option value=\"nonsense\">무의미 단어</option>\n            <option value=\"pair\">헷갈리는 짝 (한 소리만 다른 단어)</option>\n            <option value=\"sentence\">문장</option>\n          </select>\n        </div>\n        <div class=\"field\" id=\"syllField\">\n          <label>음절 수</label>\n          <select id=\"genSyll\">\n            <option value=\"0\">상관없음</option>\n            <option value=\"1\">1음절</option>\n            <option value=\"2\">2음절</option>\n            <option value=\"3\">3음절</option>\n          </select>\n        </div>\n        <div class=\"field\" id=\"batchimField\">\n          <label>받침</label>\n          <select id=\"genBatchim\">\n            <option value=\"mix\">섞기</option>\n            <option value=\"none\">받침 없음만</option>\n            <option value=\"only\">받침 있는것만</option>\n          </select>\n        </div>\n        <div class=\"field\" id=\"levelField\">\n          <label>단어 범위</label>\n          <select id=\"genLevel\">\n            <option value=\"1\">쉬운 단어 (초급)</option>\n            <option value=\"2\" selected>보통 (초·중급)</option>\n            <option value=\"3\">넓게 (고급까지)</option>\n            <option value=\"4\">기초사전 전체</option>\n            <option value=\"5\">더 넓게 (+표준국어대사전 고유어)</option>\n            <option value=\"6\">최대 (+표준국어대사전 전체)</option>\n          </select>\n        </div>\n        <div class=\"field\" id=\"lenField\" style=\"display:none\">\n          <label>문장 길이</label>\n          <select id=\"genLen\">\n            <option value=\"3\">짧게 (3어절까지)</option>\n            <option value=\"5\" selected>보통 (5어절까지)</option>\n            <option value=\"8\">길게 (8어절까지)</option>\n          </select>\n        </div>\n        <div class=\"field\" id=\"outField\" style=\"display:none\">\n          <label>진도 밖 글자</label>\n          <select id=\"genOut\">\n            <option value=\"0\">허용 안 함</option>\n            <option value=\"2\" selected>2글자까지</option>\n            <option value=\"99\">상관없음</option>\n          </select>\n        </div>\n        <div class=\"field\" id=\"countField\">\n          <label>개수</label>\n          <input id=\"genCount\" type=\"number\" min=\"1\" max=\"100\" value=\"20\">\n        </div>\n      </div>\n      <div class=\"target-box\" id=\"targetBox\">\n        <div class=\"target-head\">\n          <b>🎯 집중 음소</b><span class=\"sub\">(선택) 고른 소리가 하나라도 든 것만, 그 소리가 든 글자 비율이 높은 순으로 나와요</span>\n          <span class=\"seg\" id=\"targetPosSeg\" style=\"margin-left:auto\">\n            <button class=\"seg-btn on\" data-tpos=\"cho\" onclick=\"setTargetPos('cho')\">첫소리</button>\n            <button class=\"seg-btn\" data-tpos=\"jong\" onclick=\"setTargetPos('jong')\">받침</button>\n            <button class=\"seg-btn\" data-tpos=\"any\" onclick=\"setTargetPos('any')\">어디든</button>\n          </span>\n          <button class=\"mini-btn\" onclick=\"clearTargets()\">해제</button>\n        </div>\n        <div class=\"pg-grouplabel\">자음</div>\n        <div class=\"pg-grid\" id=\"tgCons\"></div>\n        <div class=\"pg-grouplabel\">모음</div>\n        <div class=\"pg-grid\" id=\"tgVow\"></div>\n      </div>\n      <div class=\"genbtns\">\n        <button class=\"btn-gen\" onclick=\"generate()\">✨ 생성</button>\n        <button class=\"btn-copy\" onclick=\"copyResult(this)\">📋 복사</button>\n        <button class=\"btn-copy\" onclick=\"resultToHandwriting()\">✍️ 글씨연습장 만들기</button>\n        <button class=\"btn-print\" onclick=\"window.print()\">🖨️ 인쇄</button>\n      </div>\n      <p class=\"hint\" style=\"margin:12px 0 0\" id=\"genNote\"></p>\n    </div>\n\n    <div class=\"card\">\n      <h2 id=\"resultHead\">📋 결과</h2>\n      <div class=\"result-list\" id=\"resultList\"><div class=\"result-empty\">조건을 정하고 “생성”을 눌러주세요.</div></div>\n      <p id=\"printSrc\" style=\"display:none;font-size:11px;color:#666;margin:10px 0 0\">의미 단어·예문 출처: 국립국어원 「한국어기초사전」·「표준국어대사전」 (CC BY-SA 2.0 KR · creativecommons.org/licenses/by-sa/2.0/kr) · 소소숲 : 지혜의 기록소 「한글놀이」로 만듦<span id=\"printTrial\"></span></p>\n    </div>\n  </section>\n</main>\n\n<footer>\n  소소숲 : 지혜의 기록소 · 한글놀이<br>\n  <span style=\"font-size:11px\">의미 단어·예문 출처: 국립국어원 「<a href=\"https://krdict.korean.go.kr\" target=\"_blank\" rel=\"noopener\" style=\"color:inherit\">한국어기초사전</a>」·「<a href=\"https://stdict.korean.go.kr\" target=\"_blank\" rel=\"noopener\" style=\"color:inherit\">표준국어대사전</a>」 (<a href=\"https://creativecommons.org/licenses/by-sa/2.0/kr/\" target=\"_blank\" rel=\"noopener\" style=\"color:inherit\">CC BY-SA 2.0 KR</a>)</span>\n</footer>\n\n<!-- 이름 입력 모달 -->\n<div class=\"modal-back\" id=\"nameModal\">\n  <div class=\"modal\">\n    <h3 id=\"nameModalTitle\">프로필 이름</h3>\n    <input id=\"nameModalInput\" maxlength=\"20\" placeholder=\"별칭 (실명 대신)\" autocomplete=\"off\">\n    <div class=\"row\">\n      <button onclick=\"closeNameModal()\">취소</button>\n      <button class=\"ok\" id=\"nameModalOk\">확인</button>\n    </div>\n  </div>\n</div>\n<!-- 안내/링크 모달 -->\n<div class=\"modal-back\" id=\"infoModal\">\n  <div class=\"modal\">\n    <h3 id=\"infoModalTitle\">안내</h3>\n    <div class=\"msg\" id=\"infoModalMsg\"></div>\n    <input id=\"infoModalInput\" style=\"display:none\" readonly onclick=\"this.select()\">\n    <div class=\"row\">\n      <button id=\"infoModalAction\" style=\"display:none\"></button>\n      <button class=\"ok\" onclick=\"closeInfoModal()\">닫기</button>\n    </div>\n  </div>\n</div>\n\n<script>\n/* =========================================================\n   한글 자모 인덱스 기준표 (유니코드 조합 순서, 설계 2-C)\n   음절 = 0xAC00 + (초성 × 21 + 중성) × 28 + 종성\n   ========================================================= */\nconst CHO  = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ']; // 19\nconst JUNG = ['ㅏ','ㅐ','ㅑ','ㅒ','ㅓ','ㅔ','ㅕ','ㅖ','ㅗ','ㅘ','ㅙ','ㅚ','ㅛ','ㅜ','ㅝ','ㅞ','ㅟ','ㅠ','ㅡ','ㅢ','ㅣ']; // 21\nconst JONG = ['','ㄱ','ㄲ','ㄳ','ㄴ','ㄵ','ㄶ','ㄷ','ㄹ','ㄺ','ㄻ','ㄼ','ㄽ','ㄾ','ㄿ','ㅀ','ㅁ','ㅂ','ㅄ','ㅅ','ㅆ','ㅇ','ㅈ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ']; // 28\nfunction composeSyl(ci,mi,ji){ return String.fromCharCode(0xAC00 + (ci*21 + mi)*28 + (ji||0)); }\nfunction decompose(ch){\n  const code=ch.charCodeAt(0)-0xAC00;\n  if(code<0||code>11171) return null;\n  const ji=code%28, mi=((code-ji)/28)%21, ci=Math.floor(code/(21*28));\n  return {ci,mi,ji};\n}\n\n/* 화면 표시용 그룹(표시 순서일 뿐, 저장은 항상 위 유니코드 인덱스) */\nconst CHO_GROUPS=[\n  {label:'기본 자음', idx:[0,2,3,5,6,7,9,11,12,18]},\n  {label:'격음(거센소리)', idx:[14,15,16,17]},\n  {label:'경음(된소리)', idx:[1,4,8,10,13]},\n];\nconst JUNG_GROUPS=[\n  {label:'단모음', idx:[0,4,8,13,18,20,1,5]},\n  {label:'이중모음 · ㅑ계', idx:[2,6,12,17,3,7]},\n  {label:'이중모음 · ㅘ계', idx:[9,14,11,16,10,15]},\n  {label:'ㅢ', idx:[19]},\n];\nconst JONG_GROUPS=[\n  {label:'받침 없음', idx:[0], fixed:true},\n  {label:'대표음 7종성', idx:[1,4,7,8,16,17,21]},\n  {label:'그 외 홑받침', idx:[2,19,20,22,23,24,25,26,27]},\n  {label:'겹받침', idx:[3,5,6,9,10,11,12,13,14,15,18]},\n];\n\n/* 기본 프로필 음소(입문용): 기본자음10 + 기본모음6 + 받침없음 */\nconst DEFAULT_CHO=[0,2,3,5,6,7,9,11,12,18];\nconst DEFAULT_JUNG=[0,4,8,13,18,20];\nconst DEFAULT_JONG=[0];\n\n/* =========================================================\n   의미 단어 사전 (품사/음절수 태깅) — 받침 단어 포함\n   ========================================================= */\nconst LEXICON = {\n  noun: {\n    1:['이','비','무','소','수','기','오','구','모','밥','눈','산','물','곰','문','김','발','손','별','강','공','집','책','꽃','컵','봄','밤','빵','콩','병','말','불','풀','돌','길','힘','감','숲','잎','양','종','창','방','상','담','섬','귤','약','옷','낮','문','달','별'],\n    2:['아기','아가','아이','오이','나이','나무','나비','누나','나사','바지','바다','바보','부자','구두','고기','가구','가지','거미','기구','노조','무지','도마','두부','모자','미소','비누','사자','시소','사기','자두','지구','주사','조기','이사','이마','부사','수도','고도','주부','누이','도구','부부','가수','도시','조사','구조','가사','주소','자수','모기','가마','이모','고모','사이','자기','사탕','가방','사슴','구름','바람','사랑','선물','학교','동생','얼굴','마을','그림','사진','감기','김밥','눈물','손님','연필','책상','창문','신발','양말','얼음','단추','걸음','목욕','생선','공책','바퀴','손수건','수건'],\n    3:['어머니','아버지','주머니','보자기','소나기','가마니','바나나','소시지','비디오','오디오','마사지','고구마','두더지','다시마','바구니','나머지','도가니','기린','다람쥐','코끼리','원숭이','강아지','고양이','병아리','메뚜기','달팽이','무지개','솜사탕','자전거','장난감','냉장고','손톱']\n  },\n  verb: {\n    2:['가다','오다','사다','자다','서다','보다','주다','나다','지다','비다','두다','먹다','앉다','웃다','울다','읽다','씻다','신다','입다','닫다','열다','걷다','잡다','접다','뛰다'],\n    3:['이기다','나누다','다니다','마시다','비비다','지우다','모이다','가시다','고이다','구기다','가두다','모시다','나서다','지나다','만나다','기다리다','일어나다','달리다','넘어지다','올라가다']\n  },\n  adv: {\n    1:['더','다','꼭','또','참','막','잘'],\n    2:['너무','자주','아마','어서','아주','다시','마주','정말','조금','가끔','얼른','천천']\n  },\n  pron: {\n    1:['나','너','저'],\n    2:['어디','거기','저기','누구','당신'],\n    3:[]\n  },\n  interj: {\n    1:['아','오','우','어'],\n    2:['어머','저런'],\n    3:['어머나']\n  }\n};\nfunction lexBucket(pos){\n  if(pos==='pron') return mergeBuckets(LEXICON.pron, LEXICON.interj);\n  return LEXICON[pos];\n}\nfunction mergeBuckets(a,b){\n  const out={1:[],2:[],3:[]};\n  [a,b].forEach(src=>{for(const k in src){out[k]=(out[k]||[]).concat(src[k]||[])}});\n  return out;\n}\nconst REAL_SET = new Set();\n[LEXICON.noun,LEXICON.verb,LEXICON.adv,LEXICON.pron,LEXICON.interj].forEach(b=>{\n  for(const k in b) b[k].forEach(w=>REAL_SET.add(w));\n});\n\nconst SENTENCES = {\n  2:['아기가 자다.','비가 오다.','누나가 오다.','고기 주다.','바다 가다.','오이 사다.','어디 가다?','너무 시다.','밥을 먹다.','책을 읽다.','손을 씻다.','물을 주다.'],\n  3:['아기가 두부 사다.','아버지가 바나나 주다.','누나가 고기 사다.','비가 자주 오다.','어서 바다 가다.','아이가 오이 보다.','마주 서서 보다.','나도 사자 보다.','동생이 밥을 먹다.','강아지가 공을 잡다.','학교에 신발 신다.'],\n  4:['누나가 바나나 더 주다.','어머, 비가 너무 오다.','아버지가 아주 자주 오다.','아이가 바지 자주 구기다.','어머니가 두부 다시 사다.','나도 오이 다시 사다.','동생이 밥을 다 먹다.','강아지가 공을 꼭 잡다.']\n};\n\n/* =========================================================\n   프로필 상태 (localStorage: sp.profiles.v1 / sp.activeProfileId)\n   ========================================================= */\nconst PROFILES_KEY='sp.profiles.v1';\nconst ACTIVE_KEY='sp.activeProfileId';\nconst OLD_KEY='syllable-progress-v1';\nconst RAIN_BEST_KEY='syllable-rain-best-v1';\n\nlet profiles=[];\nlet activeId=null;\nlet lockMode=false;        // 가정과제 잠금 링크로 진입\nlet lockProfile=null;      // 잠금 모드 임시 프로필(저장 안 함)\n\n/* ---- 체험판 (hangul.sososoop.com) — 빌드 때 window.__TRIAL__ 를 넣는다 ---- */\nconst TRIAL=!!window.__TRIAL__;\nconst TRIAL_MAX=10;\nfunction trialLock(what){\n  openInfo('🔒 정식판 기능이에요', '<b>'+what+'</b>은(는) 정식판에서 쓸 수 있어요.<br><br>정식판에는 헷갈리는 짝 · 사전 예문 문장 · 무의미 단어 · 읽기 게임 2종 · 아동별 프로필 · 가정과제 링크가 모두 들어 있어요.<br><br><a href=\"https://sososoop.com/hangul\" target=\"_blank\" rel=\"noopener\" style=\"color:#5b6ef5;font-weight:900\">한글놀이 정식판 보기 →</a>');\n}\nfunction applyTrialUI(){\n  if(!TRIAL) return;\n  document.getElementById('printTrial').textContent=' · 체험판 (정식판: sososoop.com/hangul)';\n  document.getElementById('trialBadge').style.display='inline-block';\n  document.title='한글놀이 체험판';\n  // 자료 만들기: 의미 단어만, 단어 범위 초급·보통만, 개수 10개까지\n  [...document.querySelectorAll('#genType option')].forEach(o=>{ if(o.value!=='real'){ o.textContent+=' 🔒'; } });\n  [...document.querySelectorAll('#genLevel option')].forEach(o=>{ if(+o.value>2){ o.textContent+=' 🔒'; } });\n  const c=document.getElementById('genCount'); c.max=TRIAL_MAX; c.value=Math.min(+c.value||TRIAL_MAX,TRIAL_MAX);\n  c.addEventListener('change',()=>{ if(+c.value>TRIAL_MAX){ c.value=TRIAL_MAX; } });\n  c.parentElement.querySelector('label').textContent='개수 (체험판 10개까지)';\n  // 게임: 벽돌깨기 한 글자만\n  document.querySelector('.gp-btn[data-game=\"rain\"]').textContent+=' 🔒';\n  document.querySelectorAll('[data-diff=\"word2\"],[data-diff=\"word3\"]').forEach(b=>b.textContent+=' 🔒');\n  // 프로필 추가·내보내기·가져오기, 가정과제 링크\n  document.querySelectorAll('.profile-bar .mini-btn').forEach(b=>{ if(/추가|내보내기|가져오기/.test(b.textContent)){ b.textContent+=' 🔒'; b.classList.add('locked-feat'); } });\n  const hw=document.querySelector('button[onclick=\"makeHwLink()\"]'); if(hw){ hw.textContent+=' 🔒'; hw.classList.add('locked-feat'); }\n}\nfunction esc(s){ return String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c])); }\nfunction uid(){ try{ return 'p_'+crypto.randomUUID().slice(0,8); }catch(e){ return 'p_'+Math.floor(performance.now()).toString(36); } }\nfunction nowTs(){ return Date.now ? Date.now() : +new Date(); }\n\nfunction activeProfile(){\n  if(lockMode) return lockProfile;\n  return profiles.find(p=>p.id===activeId) || profiles[0] || null;\n}\nfunction enabled(kind){ const p=activeProfile(); return p ? p[kind] : []; }\nlet progVersion=0, _enCache={v:-1,p:null,sets:null};\nfunction enabledSet(kind){   // 생성·문장 필터가 글자마다 부르므로 진도가 바뀔 때만 다시 만든다\n  const p=activeProfile();\n  if(_enCache.v!==progVersion || _enCache.p!==p) _enCache={v:progVersion,p,sets:{cho:new Set(enabled('cho')),jung:new Set(enabled('jung')),jong:new Set(enabled('jong'))}};\n  return _enCache.sets[kind];\n}\n/* 진도·프로필이 바뀌면: 꺼진 음소를 보드에서 내리고, 게임은 다음에 켤 때 새로 만든다 */\nfunction onProgressChanged(){\n  progVersion++;\n  syllables.forEach(s=>{ if(s.cho!=null && !enabledSet('cho').has(s.cho)) s.cho=null; if(s.jung!=null && !enabledSet('jung').has(s.jung)) s.jung=null; if(s.jong && !enabledSet('jong').has(s.jong)) s.jong=0; });\n  gBricks=[]; gGen++; stopRain();\n}\n\nfunction newProfile(name){\n  return { v:1, id:uid(), name:name||'아이', cho:DEFAULT_CHO.slice(), jung:DEFAULT_JUNG.slice(), jong:DEFAULT_JONG.slice(), createdAt:nowTs(), updatedAt:nowTs() };\n}\nfunction saveProfiles(){\n  try{\n    localStorage.setItem(PROFILES_KEY, JSON.stringify(profiles));\n    if(activeId) localStorage.setItem(ACTIVE_KEY, activeId);\n  }catch(e){}\n}\nfunction persistActive(){\n  const p=activeProfile(); if(!p||lockMode) return;\n  p.updatedAt=nowTs();\n  saveProfiles();\n}\n\n/* 인덱스 배열 정리(범위·정수·중복 제거) */\nfunction cleanIdx(arr,max){\n  if(!Array.isArray(arr)) return [];\n  const s=new Set();\n  arr.forEach(n=>{ n=parseInt(n,10); if(Number.isInteger(n)&&n>=0&&n<max) s.add(n); });\n  return [...s].sort((a,b)=>a-b);\n}\nfunction sanitizeProfile(raw){\n  if(!raw||typeof raw!=='object') return null;\n  const p=newProfile(typeof raw.name==='string'? raw.name.slice(0,20) : '아이');\n  if(typeof raw.id==='string' && /^[A-Za-z0-9_-]{1,32}$/.test(raw.id)) p.id=raw.id;   // 저장된 id 유지 — 새로고침 뒤 활성 프로필 복원\n  if(Number.isFinite(raw.createdAt)) p.createdAt=raw.createdAt;\n  if(Number.isFinite(raw.updatedAt)) p.updatedAt=raw.updatedAt;\n  p.cho=cleanIdx(raw.cho,19);\n  p.jung=cleanIdx(raw.jung,21);\n  p.jong=cleanIdx(raw.jong,28);\n  if(!p.jong.includes(0)) p.jong.unshift(0);\n  if(!p.cho.length) p.cho=DEFAULT_CHO.slice();\n  if(!p.jung.length) p.jung=DEFAULT_JUNG.slice();\n  return p;\n}\n\n/* 최초 로드 + 구버전 마이그레이션 */\n(function loadProfiles(){\n  try{\n    const rawP=JSON.parse(localStorage.getItem(PROFILES_KEY)||'null');\n    if(Array.isArray(rawP)&&rawP.length){\n      profiles=rawP.map(sanitizeProfile).filter(Boolean);\n      activeId=localStorage.getItem(ACTIVE_KEY)||profiles[0].id;\n      if(!profiles.some(p=>p.id===activeId)) activeId=profiles[0].id;\n      return;\n    }\n  }catch(e){}\n  // 구버전 진도 마이그레이션 (syllable-progress-v1: {v:[표시글자], c:[자음]})\n  let migrated=null;\n  try{\n    const old=JSON.parse(localStorage.getItem(OLD_KEY)||'null');\n    if(old && (Array.isArray(old.v)||Array.isArray(old.c))){\n      const vMap={'아':0,'애':1,'야':2,'어':4,'에':5,'여':6,'오':8,'요':12,'우':13,'유':17,'으':18,'이':20};\n      const jung=[]; (old.v||[]).forEach(ch=>{ if(ch in vMap) jung.push(vMap[ch]); });\n      const cho=[11]; (old.c||[]).forEach(ch=>{ const i=CHO.indexOf(ch); if(i>=0) cho.push(i); }); // ㅇ 포함\n      migrated=newProfile('기본');\n      migrated.cho=cleanIdx(cho,19);\n      migrated.jung=jung.length?cleanIdx(jung,21):DEFAULT_JUNG.slice();\n      migrated.jong=[0];\n    }\n  }catch(e){}\n  profiles=[ migrated || newProfile('기본') ];\n  activeId=profiles[0].id;\n  saveProfiles();\n})();\n\n/* =========================================================\n   사전 단어 목록 (국립국어원 「한국어기초사전」 1~3음절 표제어)\n   형식: {\"g\":{\"1\":\"오이 아이 …\",\"2\":…,\"3\":…,\"0\":…}} — 키=등급\n   받지 못하면 내장 LEXICON만으로 동작\n   ========================================================= */\nconst DICT_URL='/hangul-words.json';          // 한국어기초사전 (등급 1·2·3·0)\nconst DICT_STD_URL='/hangul-words-std.json';  // 표준국어대사전 추가분 (sn 고유어 · sa 그 밖)\n// 단어 범위 순서: 1초급 2중급 3고급 4기초사전 등급없음 5표준 고유어 6표준 그 밖\nconst DICT_RANK={'1':1,'2':2,'3':3,'0':4,'sn':5,'sa':6};\nlet DICT={};     // {묶음: [단어…]}\nasync function loadDictFile(url){   // 성공하면 true — 실패하면 다음 '생성' 때 다시 시도\n  const ctl=new AbortController(); const to=setTimeout(()=>ctl.abort(), 15000);\n  try{\n    const r=await fetch(url,{signal:ctl.signal});\n    if(!r.ok) return false;\n    const j=await r.json();\n    if(!j||typeof j.g!=='object') return false;\n    for(const g in j.g){\n      if(!(g in DICT_RANK)) continue;\n      DICT[g]=String(j.g[g]).split(' ').filter(w=>/^[가-힣]{1,3}$/.test(w));\n      DICT[g].forEach(w=>REAL_SET.add(w));   // 무의미 단어에서 사전 단어 빼기\n    }\n    return true;\n  }catch(e){ return false; }\n  finally{ clearTimeout(to); }\n}\nlet dictReady=null, stdReady=null;   // 표준국어대사전은 필요할 때 불러옴\nfunction loadDict(){ if(!dictReady) dictReady=loadDictFile(DICT_URL).then(ok=>{ if(!ok) dictReady=null; return ok; }); return dictReady; }\nfunction loadStd(){ if(!stdReady) stdReady=loadDictFile(DICT_STD_URL).then(ok=>{ if(!ok) stdReady=null; return ok; }); return stdReady; }\nloadDict();\n\n/* =========================================================\n   음소 → 조합 유틸\n   ========================================================= */\nfunction syllableAllowed(ch){\n  const d=decompose(ch); if(!d) return false;\n  return enabledSet('cho').has(d.ci) && enabledSet('jung').has(d.mi) && enabledSet('jong').has(d.ji);\n}\nfunction wordAllowed(word){\n  for(const ch of word){ if(!syllableAllowed(ch)) return false; }\n  return true;\n}\n/* 현재 프로필로 조합 가능한 음절 풀 (받침옵션: 'none'|'only'|'mix') */\nfunction syllablePool(batchim){\n  const cho=enabled('cho'), jung=enabled('jung');\n  let jong=enabled('jong');\n  if(batchim==='none') jong=[0];\n  else if(batchim==='only') jong=jong.filter(j=>j!==0);\n  const out=[];\n  cho.forEach(ci=>jung.forEach(mi=>jong.forEach(ji=>out.push(composeSyl(ci,mi,ji)))));\n  return out;\n}\n/* =========================================================\n   모드 전환\n   ========================================================= */\nfunction switchMode(m){\n  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('on'));\n  document.querySelectorAll('.modeswitch button').forEach(b=>b.classList.remove('on'));\n  if(m!=='game') stopRain();\n  if(m==='play'){ playPanel.classList.add('on'); tabPlay.classList.add('on'); renderZones(); renderBoard(); }\n  if(m==='game'){ gamePanel.classList.add('on'); tabGame.classList.add('on'); startGameTab(); }\n  if(m==='gen'){ genPanel.classList.add('on'); tabGen.classList.add('on'); renderTargets(); }\n  if(m==='prog'){ progPanel.classList.add('on'); tabProg.classList.add('on'); renderProgress(); }\n}\n\n/* =========================================================\n   진도 설정 화면\n   ========================================================= */\nfunction renderProgress(){\n  renderProfileSelect();\n  renderProgGrids();\n  renderActiveSyls();\n}\nfunction renderProfileSelect(){\n  const sel=document.getElementById('profileSelect');\n  sel.innerHTML='';\n  profiles.forEach(p=>{\n    const o=document.createElement('option');\n    o.value=p.id; o.textContent=p.name;   // textContent (XSS 방지)\n    if(p.id===activeId) o.selected=true;\n    sel.appendChild(o);\n  });\n}\nfunction seriesGrid(kind, groups, charFn){\n  const set=enabledSet(kind);\n  const wrap=document.createElement('div');\n  wrap.className='prog-series';\n  const total=enabled(kind).filter(i=>!(kind==='jong'&&i===0)).length;\n  const cap=kind==='cho'?19:kind==='jung'?21:27;\n  const head=document.createElement('div');\n  head.className='series-head';\n  const title=kind==='cho'?'초성':kind==='jung'?'중성':'종성';\n  head.innerHTML='<span class=\"series-title\">'+title+'</span><span class=\"series-count\">'+total+' / '+cap+' 선택</span>';\n  const allBtn=document.createElement('button'); allBtn.className='mini-btn'; allBtn.textContent='모두';\n  allBtn.onclick=()=>setAllSeries(kind,true);\n  const noneBtn=document.createElement('button'); noneBtn.className='mini-btn'; noneBtn.textContent='해제';\n  noneBtn.onclick=()=>setAllSeries(kind,false);\n  head.appendChild(allBtn); head.appendChild(noneBtn);\n  wrap.appendChild(head);\n  groups.forEach(g=>{\n    const lbl=document.createElement('div'); lbl.className='pg-grouplabel'; lbl.textContent=g.label;\n    wrap.appendChild(lbl);\n    const grid=document.createElement('div'); grid.className='pg-grid';\n    g.idx.forEach(i=>{\n      const t=document.createElement('div');\n      const isFixed=g.fixed;\n      t.className='pg-tile'+(set.has(i)?' on':'')+(isFixed?' fixed':'');\n      t.textContent=charFn(i)||'∅';\n      if(!isFixed){ t.onclick=()=>togglePhoneme(kind,i); t.setAttribute('role','button'); t.tabIndex=0; t.setAttribute('aria-pressed',set.has(i)?'true':'false'); }\n      grid.appendChild(t);\n    });\n    wrap.appendChild(grid);\n  });\n  return wrap;\n}\nfunction renderProgGrids(){\n  const box=document.getElementById('progGrids');\n  box.innerHTML='';\n  box.appendChild(seriesGrid('cho',CHO_GROUPS,i=>CHO[i]));\n  box.appendChild(seriesGrid('jung',JUNG_GROUPS,i=>JUNG[i]));\n  box.appendChild(seriesGrid('jong',JONG_GROUPS,i=>JONG[i]));\n}\nfunction togglePhoneme(kind,i){\n  const p=activeProfile(); if(!p) return;\n  const arr=p[kind]; const pos=arr.indexOf(i);\n  if(pos>=0){ if(kind==='jong'&&i===0) return; arr.splice(pos,1); }\n  else arr.push(i);\n  arr.sort((a,b)=>a-b);\n  persistActive(); onProgressChanged();\n  renderProgGrids(); renderActiveSyls();\n}\nfunction setAllSeries(kind,val){\n  const p=activeProfile(); if(!p) return;\n  if(val){\n    const groups = kind==='cho'?CHO_GROUPS : kind==='jung'?JUNG_GROUPS : JONG_GROUPS;\n    const all=[]; groups.forEach(g=>g.idx.forEach(i=>all.push(i)));\n    p[kind]=[...new Set(all)].sort((a,b)=>a-b);\n  }else{\n    p[kind] = kind==='jong' ? [0] : [];\n  }\n  persistActive(); onProgressChanged();\n  renderProgGrids(); renderActiveSyls();\n}\nfunction renderActiveSyls(){\n  const box=document.getElementById('activeSyls');\n  const pool=syllablePool('mix');\n  box.innerHTML='';\n  if(!pool.length){ box.innerHTML='<span class=\"empty\">초성·중성을 켜면 글자가 만들어져요.</span>'; return; }\n  const show=shuffle(pool).slice(0,40);\n  show.forEach(s=>{ const c=document.createElement('span'); c.className='chip'; c.textContent=s; box.appendChild(c); });\n  if(pool.length>40){ const m=document.createElement('span'); m.className='empty'; m.textContent=' …외 '+(pool.length-40)+'개'; box.appendChild(m); }\n}\n\n/* ---- 프로필 CRUD ---- */\nfunction switchProfile(id){   // 아동이 바뀌면 보드·담은 단어도 비운다\n  activeId=id; saveProfiles(); onProgressChanged();\n  collected=[]; syllables=[{cho:null,jung:null,jong:0}]; activeIndex=0;\n  renderProgress(); renderZones(); renderBoard(); renderCollected();\n}\nfunction addProfile(){\n  if(TRIAL){ trialLock('아동 프로필 추가'); return; }\n  openNameModal('새 프로필 이름', '', name=>{\n    const p=newProfile(name||'아이'); profiles.push(p); switchProfile(p.id);\n  });\n}\nfunction renameProfile(){\n  const p=activeProfile(); if(!p) return;\n  openNameModal('이름 변경', p.name, name=>{ p.name=(name||p.name).slice(0,20); persistActive(); renderProfileSelect(); });\n}\nfunction deleteProfile(){\n  if(profiles.length<=1){ openInfo('삭제 불가','프로필이 하나뿐이라 삭제할 수 없어요. 새 프로필을 먼저 만들어 주세요.'); return; }\n  const p=activeProfile(); if(!p) return;\n  openConfirm('프로필 삭제', '“'+esc(p.name)+'” 프로필을 삭제할까요? 되돌릴 수 없어요.', ()=>{\n    profiles=profiles.filter(x=>x.id!==p.id); switchProfile(profiles[0].id);\n  });\n}\nfunction exportProfiles(){\n  if(TRIAL){ trialLock('프로필 내보내기'); return; }\n  const data=JSON.stringify({app:'hangul-blending-board', v:1, exportedAt:nowTs(), profiles}, null, 2);\n  const blob=new Blob([data],{type:'application/json'});\n  const url=URL.createObjectURL(blob);\n  const a=document.createElement('a'); a.href=url; a.download='한글놀이_프로필.json'; a.click();\n  setTimeout(()=>URL.revokeObjectURL(url),1000);\n}\nfunction importProfiles(file){\n  if(!file) return;\n  if(file.size>1024*1024){ openInfo('가져오기 실패','파일이 너무 커요(1MB 초과).'); return; }\n  const rd=new FileReader();\n  rd.onload=()=>{\n    try{\n      const obj=JSON.parse(rd.result);\n      const list=Array.isArray(obj)?obj:(obj&&Array.isArray(obj.profiles)?obj.profiles:null);\n      if(!list||!list.length) throw 0;\n      const existing=new Set(profiles.map(p=>p.id));\n      let added=0;\n      list.forEach(raw=>{\n        const p=sanitizeProfile(raw); if(!p) return;\n        if(existing.has(p.id)) p.id=uid();      // id 충돌 → 새 UUID\n        existing.add(p.id); profiles.push(p); added++;\n      });\n      if(added){ saveProfiles(); renderProgress(); openInfo('가져오기 완료', added+'개 프로필을 불러왔어요.'); }\n      else openInfo('가져오기 실패','유효한 프로필이 없어요.');\n    }catch(e){ openInfo('가져오기 실패','파일 형식을 읽을 수 없어요. 내보낸 JSON 파일인지 확인해 주세요.'); }\n  };\n  rd.readAsText(file);\n  document.getElementById('importFile').value='';\n}\n\n/* =========================================================\n   놀이 — 블렌딩 보드\n   상태: syllables[{cho,jung,jong}] + activeIndex (설계 6-D)\n   ========================================================= */\nlet syllables=[{cho:null,jung:null,jong:0}];\nlet activeIndex=0;\n\nfunction syllChar(s){\n  if(s.cho!=null && s.jung!=null) return composeSyl(s.cho,s.jung,s.jong||0);\n  if(s.cho!=null) return CHO[s.cho];\n  if(s.jung!=null) return JUNG[s.jung];\n  if(s.jong) return JONG[s.jong];\n  return '';\n}\nfunction renderZones(){\n  const mk=(box,kind,cls,charFn,onclick)=>{\n    const el=document.getElementById(box); el.innerHTML='';\n    const list=enabled(kind);\n    if(kind!=='jong' && !list.length){ el.innerHTML='<span class=\"zone-empty\">진도에서 '+(kind==='cho'?'초성':'중성')+'을 켜주세요.</span>'; return; }\n    list.forEach(i=>{\n      const t=document.createElement('div');\n      t.className='jamo-tile '+cls; t.textContent = (kind==='jong'&&i===0)?'∅':charFn(i);\n      t.setAttribute('role','button'); t.tabIndex=0;\n      t.onclick=()=>onclick(i); el.appendChild(t);\n    });\n  };\n  mk('zoneCho','cho','cho',i=>CHO[i],setCho);\n  mk('zoneJung','jung','jung',i=>JUNG[i],setJung);\n  mk('zoneJong','jong','jong',i=>JONG[i],setJong);\n  markSelectedTiles();\n}\nfunction markSelectedTiles(){\n  const s=syllables[activeIndex]||{};\n  const mark=(box,kind,val)=>{\n    const el=document.getElementById(box); if(!el) return;\n    const list=enabled(kind);\n    [...el.children].forEach((t,n)=>{\n      const idx=list[n];\n      t.classList.toggle('sel', kind==='jong' ? (val? idx===val : idx===0 && (s.jong||0)===0 && false) : idx===val);\n    });\n  };\n  mark('zoneCho','cho',s.cho);\n  mark('zoneJung','jung',s.jung);\n  // 종성: 선택된 받침 강조(받침없음 ∅도 선택시 표시)\n  const jel=document.getElementById('zoneJong');\n  if(jel){ const list=enabled('jong'); [...jel.children].forEach((t,n)=>{ t.classList.toggle('sel', list[n]===(s.jong||0)); }); }\n}\nfunction setCho(i){ const s=syllables[activeIndex]; s.cho = (s.cho===i?null:i); afterEdit(true); }\nfunction setJung(i){ const s=syllables[activeIndex]; s.jung = (s.jung===i?null:i); afterEdit(true); }\nfunction setJong(i){ const s=syllables[activeIndex]; s.jong = ((s.jong||0)===i?0:i); afterEdit(true); }\n\nfunction afterEdit(pop){\n  renderBoard(pop); markSelectedTiles();\n  const v=document.getElementById('verdict'); v.textContent=''; v.className='verdict';   // 판별 문구 없음 — 읽기 연습용\n}\n\nfunction renderBoard(pop){\n  const board=document.getElementById('board');\n  board.innerHTML='';\n  const anyContent=syllables.some(s=>s.cho!=null||s.jung!=null||s.jong);\n  if(!anyContent){ board.innerHTML='<span class=\"placeholder\">아래 자모를 눌러보세요</span>'; updateNextBtn(); return; }\n  syllables.forEach((s,i)=>{\n    const box=document.createElement('div');\n    box.className='syl-box '+(i===activeIndex?'active':'locked')+(pop&&i===activeIndex?' pop':'');\n    box.textContent=syllChar(s)||'·';\n    box.onclick=()=>{ activeIndex=i; renderBoard(); markSelectedTiles(); };\n    board.appendChild(box);\n  });\n  updateNextBtn();\n}\nfunction updateNextBtn(){\n  const s=syllables[activeIndex];\n  const canNext = activeIndex===syllables.length-1 && s && s.cho!=null && s.jung!=null && syllables.length<3;\n  document.getElementById('nextBtn').disabled=!canNext;\n}\nfunction nextSyl(){\n  const s=syllables[activeIndex];\n  if(!(activeIndex===syllables.length-1 && s.cho!=null && s.jung!=null && syllables.length<3)) return;\n  syllables.push({cho:null,jung:null,jong:0}); activeIndex=syllables.length-1;\n  renderBoard(true); markSelectedTiles();\n}\nfunction delLast(){\n  const s=syllables[activeIndex];\n  if(s.jong){ s.jong=0; }\n  else if(s.jung!=null){ s.jung=null; }\n  else if(s.cho!=null){ s.cho=null; }\n  else if(activeIndex>0){ syllables.splice(activeIndex,1); activeIndex--; }\n  afterEdit(false);\n}\nfunction clearBoard(){ syllables=[{cho:null,jung:null,jong:0}]; activeIndex=0; afterEdit(false); }\n\nfunction assembledWord(){\n  // 모든 음절이 완성(초성+중성)일 때만 단어로 취급\n  if(!syllables.length) return '';\n  for(const s of syllables){ if(s.cho==null||s.jung==null) return ''; }\n  return syllables.map(s=>composeSyl(s.cho,s.jung,s.jong||0)).join('');\n}\nfunction randomWord(n){\n  const pool=syllablePool('mix');\n  if(!pool.length) return;\n  n = (n===1||n===2||n===3) ? n : (Math.random()<0.5?2:3);\n  syllables=[];\n  for(let i=0;i<n;i++){ const ch=pool[Math.floor(Math.random()*pool.length)]; const d=decompose(ch); syllables.push({cho:d.ci,jung:d.mi,jong:d.ji}); }\n  activeIndex=syllables.length-1;\n  renderBoard(true); markSelectedTiles();\n  const v=document.getElementById('verdict'); v.textContent=''; v.className='verdict';\n}\nlet collected=[];\nfunction saveWord(){\n  const word=assembledWord();\n  if(!word) return;\n  if(collected.some(c=>c.word===word)){ flashSaved(); return; }\n  collected.unshift({word, real:REAL_SET.has(word)});\n  renderCollected(); flashSaved();\n}\nfunction flashSaved(){\n  const v=document.getElementById('verdict');\n  v.textContent='⭐ 담았어요!'; v.className='verdict real';\n  setTimeout(()=>{ v.textContent=''; v.className='verdict'; }, 700);\n}\nfunction renderCollected(){\n  const box=document.getElementById('collected');\n  const cnt=document.getElementById('collectedCount');\n  if(!collected.length){ box.innerHTML='<span class=\"empty\">아직 담은 단어가 없어요.</span>'; cnt.textContent=''; return; }\n  cnt.textContent='('+collected.length+'개)';\n  box.innerHTML='';\n  collected.forEach(c=>{ const chip=document.createElement('span'); chip.className='chip '+(c.real?'real':''); chip.title=c.real?'사전에 실린 단어':'사전에서 확인되지 않은 글자'; chip.textContent=c.word; box.appendChild(chip); });\n}\nfunction collectedToHandwriting(){\n  if(!collected.length){ openInfo('안내','먼저 단어를 담아주세요.'); return; }\n  openHandwriting(collected.map(c=>c.word));\n}\n\n/* =========================================================\n   자료 만들기\n   ========================================================= */\nfunction sylCount(word){ return [...word].filter(ch=>decompose(ch)).length; }\nfunction hasBatchim(word){ return [...word].some(ch=>{ const d=decompose(ch); return d && d.ji!==0; }); }\n\nfunction genRealWords(syll,batchim,count,level){\n  let pool=[];\n  ['noun','verb','adv','pron'].forEach(p=>{\n    const b=lexBucket(p);\n    for(const k in b) b[k].forEach(w=>{ if(syll==0 || sylCount(w)==syll) pool.push(w); });   // 묶음 키가 아니라 실제 음절 수로\n  });\n  // 사전 단어 목록: 고른 범위(level)까지의 묶음만\n  for(const g in DICT){\n    if(DICT_RANK[g]>level) continue;\n    DICT[g].forEach(w=>{ if(syll==0 || sylCount(w)==syll) pool.push(w); });\n  }\n  pool=[...new Set(pool)].filter(wordAllowed).filter(w=>batchimMatch(w,batchim));\n  if(hasTargets()) return byTargetDensity(pool.filter(w=>targetCount(w)>0)).slice(0,count).map(w=>({text:w,type:'real'}));\n  return shuffle(pool).slice(0,count).map(w=>({text:w,type:'real'}));\n}\nfunction batchimMatch(word,batchim){\n  if(batchim==='none') return !hasBatchim(word);\n  if(batchim==='only') return hasBatchim(word);\n  return true;\n}\nfunction genNonsense(syll,batchim,count){\n  const one=syllablePool(batchim==='mix'?'mix':batchim);\n  if(!one.length) return [];\n  const tgt=hasTargets()? one.filter(sylTargetHit) : one;   // 집중 음소가 든 음절\n  if(!tgt.length) return [];\n  const out=[]; const seen=new Set(); let guard=0;\n  while(out.length<count && guard<count*500){\n    guard++;\n    const n = syll!=0 ? Number(syll) : (Math.random()<0.5?2:3);\n    const k=Math.floor(Math.random()*n);                      // 이 자리는 꼭 집중 음소 음절\n    let w=''; for(let i=0;i<n;i++){ const src=(i===k)?tgt:one; w+=src[Math.floor(Math.random()*src.length)]; }\n    if(seen.has(w)||REAL_SET.has(w)) continue;\n    seen.add(w); out.push({text:w,type:'nonsense'});\n  }\n  return out;\n}\n\n/* =========================================================\n   집중 음소 (진도 = 읽을 수 있는 범위, 집중 음소 = 꼭 들어갈 소리)\n   ========================================================= */\nconst TARGET_KEY='sp.targets.v1';\nconst TG={cons:new Set(), vow:new Set(), pos:'cho'};\n(function loadTargets(){\n  try{\n    const t=JSON.parse(localStorage.getItem(TARGET_KEY)||'null');\n    if(t){ (t.cons||[]).forEach(c=>{ if(CHO.includes(c)) TG.cons.add(c); }); (t.vow||[]).forEach(v=>{ if(JUNG.includes(v)) TG.vow.add(v); }); if(['cho','jong','any'].includes(t.pos)) TG.pos=t.pos; }\n  }catch(e){}\n})();\nfunction saveTargets(){ try{ localStorage.setItem(TARGET_KEY, JSON.stringify({cons:[...TG.cons], vow:[...TG.vow], pos:TG.pos})); }catch(e){} }\nfunction hasTargets(){ return TG.cons.size+TG.vow.size>0; }\nfunction targetLabel(){ return [...TG.cons, ...TG.vow].join('')+(TG.cons.size? (TG.pos==='cho'?' 첫소리':TG.pos==='jong'?' 받침':''):''); }\nfunction sylTargetHit(ch){\n  const d=decompose(ch); if(!d) return false;\n  if(TG.vow.has(JUNG[d.mi])) return true;\n  if(TG.pos!=='jong' && TG.cons.has(CHO[d.ci])) return true;\n  if(TG.pos!=='cho' && d.ji && TG.cons.has(JONG[d.ji])) return true;\n  return false;\n}\nfunction targetCount(text){ let n=0; for(const ch of text) if(sylTargetHit(ch)) n++; return n; }\n/* 집중 음소가 차지하는 비율이 높은 순서 (같으면 무작위). 코·토끼처럼 짧은 단어가 긴 외래어에 밀리지 않게 개수 대신 비율 */\nfunction byTargetDensity(arr){\n  return shuffle(arr).map(w=>({w, d:targetCount(w)/Math.max(1,sylCount(w))})).sort((a,b)=>b.d-a.d).map(x=>x.w);\n}\nfunction renderTargets(){\n  const off=targetsOffProgress();\n  const mk=(box,list,set)=>{\n    box.innerHTML='';\n    list.forEach(c=>{\n      const t=document.createElement('div'); t.className='pg-tile'+(set.has(c)?' on':'')+(off.includes(c)?' off':''); t.textContent=c;\n      t.setAttribute('role','button'); t.tabIndex=0; t.setAttribute('aria-pressed',set.has(c)?'true':'false');\n      if(off.includes(c)) t.title='진도 설정에서 꺼져 있어요';\n      t.onclick=()=>{ set.has(c)?set.delete(c):set.add(c); saveTargets(); renderTargets(); };\n      box.appendChild(t);\n    });\n  };\n  mk(document.getElementById('tgCons'), CHO_GROUPS.flatMap(g=>g.idx).map(i=>CHO[i]), TG.cons);\n  mk(document.getElementById('tgVow'), JUNG_GROUPS.flatMap(g=>g.idx).map(i=>JUNG[i]), TG.vow);\n  document.querySelectorAll('#targetPosSeg .seg-btn').forEach(b=>b.classList.toggle('on', b.dataset.tpos===TG.pos));\n}\n/* 진도에 꺼져 있는 집중 음소 (이 소리는 결과에 나올 수 없음) */\nfunction targetsOffProgress(){\n  const cho=new Set(enabled('cho').map(i=>CHO[i])), jung=new Set(enabled('jung').map(i=>JUNG[i])), jong=new Set(enabled('jong').map(i=>JONG[i]));\n  const off=[];\n  TG.cons.forEach(c=>{ const inCho=cho.has(c), inJong=jong.has(c); if(TG.pos==='cho'?!inCho : TG.pos==='jong'?!inJong : !(inCho||inJong)) off.push(c); });\n  TG.vow.forEach(v=>{ if(!jung.has(v)) off.push(v); });\n  return off;\n}\nfunction setTargetPos(p){ TG.pos=p; saveTargets(); renderTargets(); }\nfunction clearTargets(){ TG.cons.clear(); TG.vow.clear(); saveTargets(); renderTargets(); }\n\n/* ---------- 헷갈리는 짝 (한 소리만 다른 단어) ---------- */\nconst CONTRAST_CONS=[['ㄱ','ㅋ','ㄲ'],['ㄷ','ㅌ','ㄸ'],['ㅂ','ㅍ','ㅃ'],['ㅈ','ㅊ','ㅉ'],['ㅅ','ㅆ'],['ㄴ','ㄹ'],['ㅁ','ㅂ']];\nconst CONTRAST_VOW=[['ㅐ','ㅔ'],['ㅓ','ㅗ'],['ㅗ','ㅜ'],['ㅡ','ㅜ'],['ㅓ','ㅕ'],['ㅏ','ㅑ'],['ㅗ','ㅛ'],['ㅜ','ㅠ'],['ㅚ','ㅙ','ㅞ']];\n// 받침은 소리가 실제로 다른 쌍만(입–잎처럼 소리가 같은 받침은 짝이 아님)\nconst CONTRAST_JONG=[['ㄴ','ㄹ'],['ㅁ','ㅂ'],['ㄴ','ㅇ'],['ㅁ','ㄴ']];\nfunction wordRankMap(level){\n  const m=new Map();\n  ['noun','verb','adv','pron','interj'].forEach(p=>{ const b=LEXICON[p]; for(const k in b) b[k].forEach(w=>m.set(w,1)); });\n  for(const g in DICT){ const r=DICT_RANK[g]; if(r>level) continue; DICT[g].forEach(w=>{ if(!m.has(w)||m.get(w)>r) m.set(w,r); }); }\n  return m;\n}\nfunction genPairs(syll,batchim,count,level){\n  const rank=wordRankMap(level);\n  const ok=w=>rank.has(w) && wordAllowed(w) && batchimMatch(w,batchim) && (syll==0 || sylCount(w)==syll);\n  const groups=new Map();   // key → Set(단어)\n  for(const w of rank.keys()){\n    if(!ok(w)) continue;\n    const chars=[...w];\n    chars.forEach((ch,i)=>{\n      const d=decompose(ch); if(!d) return;\n      // [종류, 그 자리 소리를 같은 대비 묶음의 다른 소리로 바꾼 음절들]\n      // 묶음 하나씩 따로 — ㅓ–ㅗ와 ㅗ–ㅜ가 ㅓ–ㅗ–ㅜ 한 줄로 합쳐지지 않게\n      const tries=[];\n      const c=CHO[d.ci];   // 첫소리\n      if(!hasTargets() || (TG.cons.has(c) && TG.pos!=='jong'))\n        CONTRAST_CONS.filter(g=>g.includes(c)).forEach(g=>tries.push(['c'+g.join(''), g.filter(x=>x!==c).map(x=>composeSyl(CHO.indexOf(x),d.mi,d.ji))]));\n      const v=JUNG[d.mi];  // 가운뎃소리\n      if(!hasTargets() || TG.vow.has(v))\n        CONTRAST_VOW.filter(g=>g.includes(v)).forEach(g=>tries.push(['v'+g.join(''), g.filter(x=>x!==v).map(x=>composeSyl(d.ci,JUNG.indexOf(x),d.ji))]));\n      const j=d.ji? JONG[d.ji] : null;   // 받침끼리(밤–밥, 발–반)\n      if(j && (!hasTargets() || (TG.cons.has(j) && TG.pos!=='cho')))\n        CONTRAST_JONG.filter(g=>g.includes(j)).forEach(g=>tries.push(['j'+g.join(''), g.filter(x=>x!==j).map(x=>composeSyl(d.ci,d.mi,JONG.indexOf(x)))]));\n      tries.forEach(([kind,syls])=>{\n        const found=syls.map(sy=>chars.slice(0,i).join('')+sy+chars.slice(i+1).join('')).filter(ok);\n        if(!found.length) return;\n        const all=[w,...found];\n        const key=i+kind+all.slice().sort().join(',');\n        if(!groups.has(key)) groups.set(key,new Set(all));\n      });\n    });\n  }\n  // 같은 단어 묶음 중복 제거, 쉬운 단어 위주 + 무작위\n  const seen=new Set(); const rows=[];\n  for(const set of groups.values()){\n    const ws=[...set].sort((a,b)=>CONTRAST_SORT(a,b));\n    const k=ws.join('|'); if(seen.has(k)) continue; seen.add(k);\n    const r=Math.max(...ws.map(w=>rank.get(w)||9));\n    rows.push({ws, r});\n  }\n  // 큰 묶음 먼저 보고, 이미 나온 짝만 있는 작은 묶음(발–말 ⊂ 발–팔–말)은 빼기\n  rows.sort((a,b)=>b.ws.length-a.ws.length);\n  const covered=new Set(); const uniq=[];\n  rows.forEach(row=>{\n    const prs=[]; for(let i=0;i<row.ws.length;i++) for(let j=i+1;j<row.ws.length;j++) prs.push(row.ws[i]+'|'+row.ws[j]);\n    if(prs.every(x=>covered.has(x))) return;\n    prs.forEach(x=>covered.add(x)); uniq.push(row);\n  });\n  const out=shuffle(uniq).sort((a,b)=>a.r-b.r).slice(0,count);\n  return out.map(x=>({text:x.ws.join(' – '), type:'pair'}));\n}\n/* 짝 안에서는 예사소리→거센소리→된소리 순 */\nconst CONS_ORDER='ㄱㅋㄲㄷㅌㄸㅂㅍㅃㅈㅊㅉㅅㅆㄴㄹㅁ';\nfunction CONTRAST_SORT(a,b){\n  for(let i=0;i<Math.min(a.length,b.length);i++){\n    if(a[i]===b[i]) continue;\n    const da=decompose(a[i]), db=decompose(b[i]); if(!da||!db) break;\n    if(da.ci!==db.ci) return CONS_ORDER.indexOf(CHO[da.ci])-CONS_ORDER.indexOf(CHO[db.ci]);\n    if(da.mi!==db.mi) return da.mi-db.mi;\n    return CONS_ORDER.indexOf(JONG[da.ji])-CONS_ORDER.indexOf(JONG[db.ji]);\n  }\n  return a.localeCompare(b);\n}\n\n/* ---------- 문장: 한국어기초사전 예문에서 고르기 ---------- */\n// 예문은 기초사전 전체 내려받기(2026-09)에서 미리 걸러 둔 파일을 씀 (API 호출 없음)\n// 파일: 표제어 등급별 hangul-sent-{1,2,3,0}.json, s = \"표제어\\t예문\\t예문…\" 줄 모음\nconst sentFiles=new Map();      // 등급 → Promise<[[표제어,[예문…]],…] | null>\nfunction loadSentFile(k){\n  if(!sentFiles.has(k)) sentFiles.set(k,(async()=>{\n    try{\n      const r=await fetch('/hangul-sent-'+k+'.json'); if(!r.ok){ sentFiles.delete(k); return null; }\n      const j=await r.json(); if(!j||typeof j.s!=='string'){ sentFiles.delete(k); return null; }\n      return j.s.split('\\n').map(l=>{ const p=l.split('\\t'); return [p[0],p.slice(1)]; });\n    }catch(e){ sentFiles.delete(k); return null; }\n  })());\n  return sentFiles.get(k);\n}\nconst SENT_BLOCK=['키스','연애','애인','사귀','임신','성관계','음주','흡연','폭력','폭행','흉기','유흥','유혹','섹시','야한','변태','노출','포탄','총알','대포','폭격','전쟁','팬티','브래지어','속옷','섹스','성교','성기','강간','성폭','매춘','마약','자살','자해','살인','살해','시체','사형','학살','고문','도박','포르노','음란','불륜','간통','낙태','총살','폭탄','테러','처형','시신','죽여','죽인','담배','소주','맥주','술집','술을','술에','술이','술잔','이혼','외도'];\nfunction cleanSentence(t){\n  t=t.replace(/\\s+/g,' ').trim();\n  if(!/^[가-힣 .,?!]+$/.test(t)) return null;        // 숫자·영문·따옴표·대화(가:) 등 제외\n  if(SENT_BLOCK.some(b=>t.includes(b))) return null;\n  return t;\n}\nasync function genSentencesOnline(len,count,level,outAllow){\n  len=Number(len)||5; if(!Number.isFinite(outAllow)) outAllow=2;\n  // 1) 단어 범위에 맞는 예문 파일: 초급 → 1, 보통 → 1·2, 넓게 → +3, 그 위 → +등급 없음\n  const cap=Math.min(Math.max(level,1),4);\n  const keys=['1'].concat(cap>=2?['2']:[], cap>=3?['3']:[], cap>=4?['0']:[]);\n  const groups=await Promise.all(keys.map(loadSentFile));\n  const failed=groups.every(g=>g===null);\n  // 2) 거르기: 어절 수, 진도 밖 글자 수, 집중 음소\n  const cand=new Map();\n  groups.forEach(g=>(g||[]).forEach(([hw,list])=>{\n    if(SENT_BLOCK.some(b=>hw.includes(b))) return;\n    const ok=[];\n    for(const raw of list){\n      const t=cleanSentence(raw); if(!t || cand.has(t)) continue;\n      if(t.split(' ').length>len) continue;\n      let out=0, syl=0;\n      for(const ch of t){ if(!decompose(ch)) continue; syl++; if(!syllableAllowed(ch)) out++; }\n      if(out>outAllow || syl<2) continue;\n      const n=hasTargets()? targetCount(t) : 0;\n      if(hasTargets() && n===0) continue;\n      // 서술어로 끝난 문장 우선(“검은색 팬티.” 같은 명사구는 뒤로)\n      const full=/(다|요|까|니|어|아|지|네|래|게|자|라)[.?!]$/.test(t) ? 1 : 0;\n      ok.push({t,n,out,syl,full,d:Math.round(n/Math.max(1,syl)*10)/10,src:'krdict'});\n    }\n    shuffle(ok).slice(0,4).forEach(x=>cand.set(x.t,x));   // 한 표제어에서 4문장까지만 (한 단어로 몰리지 않게)\n  }));\n  // 3) 내장 문장도 후보로\n  ['2','3','4'].forEach(k=>(SENTENCES[k]||[]).forEach(t=>{\n    if(cand.has(t) || t.split(' ').length>len) return;\n    let out=0; for(const ch of t){ if(decompose(ch) && !syllableAllowed(ch)) out++; }\n    if(out>outAllow) return;\n    const n=hasTargets()? targetCount(t) : 0;\n    if(hasTargets() && n===0) return;\n    cand.set(t,{t,n,out,syl:0,full:1,d:Math.round(n/Math.max(1,t.replace(/[^가-힣]/g,'').length)*10)/10,src:'local'});\n  }));\n  let arr=shuffle([...cand.values()]);\n  // 서술어로 끝난 문장 → 집중 음소 2개 이상 → 집중 음소 비율 → 진도 밖 글자 적은 순\n  arr.sort((a,b)=>(b.full-a.full)||((b.n>=2)-(a.n>=2))||(b.d-a.d)||(a.out-b.out));\n  if(failed && !arr.length) openInfo('안내','예문 파일을 불러오지 못했어요. 인터넷 연결을 확인해 주세요.');\n  return arr.slice(0,count).map(x=>({text:x.t,type:'sentence',src:x.src}));\n}\nconst GEN_NOTES={\n  real:'💡 집중 음소를 고르면 그 소리가 든 단어만, 많이 든 순서로 나와요. 밑줄은 집중 음소가 든 글자예요.',\n  nonsense:'💡 “무의미 단어”는 사전(기초사전·표준국어대사전)에 없는 소리 연습용 글자예요. 활용형은 사전에 없어도 실제 말일 수 있으니 <b>선생님이 확인</b>해 주세요.',\n  pair:'💡 한 소리만 다른 단어끼리 묶어요(예: 달–탈–딸, 개–게). 집중 음소를 고르면 그 소리와 헷갈리기 쉬운 짝만 찾아요. 짝 단어도 진도 안의 글자만 써요.',\n  sentence:'💡 사전 예문에서 골라요. 어색한 문장이 섞일 수 있으니 <b>인쇄 전에 확인</b>해 주세요.'\n};\nfunction syncGenFields(){\n  const t=document.getElementById('genType').value;\n  const show=(id,on)=>{ document.getElementById(id).style.display=on?'':'none'; };\n  show('syllField', t==='real'||t==='nonsense'||t==='pair');\n  show('batchimField', t==='real'||t==='nonsense'||t==='pair');\n  show('lenField', t==='sentence');\n  show('outField', t==='sentence');\n  show('levelField', t==='real'||t==='pair'||t==='sentence');\n  document.getElementById('genNote').innerHTML=GEN_NOTES[t]||'';\n}\ndocument.getElementById('genType').addEventListener('change',e=>{\n  if(TRIAL && e.target.value!=='real'){ const o=e.target.selectedOptions[0].textContent.replace(' 🔒',''); e.target.value='real'; trialLock(o); }\n  syncGenFields();\n});\ndocument.getElementById('genLevel').addEventListener('change',e=>{\n  if(TRIAL && +e.target.value>2){ e.target.value='2'; trialLock('넓은 단어 범위(고급·표준국어대사전)'); }\n});\n\nasync function generate(){\n  const type=document.getElementById('genType').value;\n  const level=parseInt(document.getElementById('genLevel').value,10)||2;\n  await loadDict();\n  if(level>=5 || type==='nonsense') await loadStd();\n  if(type==='sentence'){\n    document.getElementById('resultList').innerHTML='<div class=\"result-empty\">사전 예문에서 문장을 찾는 중이에요…</div>';\n  }\n  const syll=document.getElementById('genSyll').value;\n  const batchim=document.getElementById('genBatchim').value;\n  const len=document.getElementById('genLen').value;\n  let count=parseInt(document.getElementById('genCount').value)||20;\n  count=Math.max(1,Math.min(TRIAL?TRIAL_MAX:100,count));\n  if(TRIAL && (type!=='real' || level>2)){ trialLock(type!=='real'?'이 자료 유형':'넓은 단어 범위'); return; }   // 화면 잠금을 우회해도 체험판에서는 만들지 않음\n\n  let items=[], head='';\n  if(type==='real'){ items=genRealWords(syll,batchim,count,level); head='📋 의미 단어'; }\n  else if(type==='nonsense'){ items=genNonsense(syll,batchim,count); head='📋 무의미 단어'; }\n  else if(type==='pair'){ items=genPairs(syll,batchim,count,level); head='📋 헷갈리는 짝'; }\n  else { items=await genSentencesOnline(len,count,level,parseInt(document.getElementById('genOut').value,10)); head='📋 문장'; }\n  if(hasTargets()) head+=' · 🎯'+targetLabel();\n  renderResult(items,head);\n}\nlet lastResult=[];\nfunction renderResult(items,head){\n  document.getElementById('resultHead').textContent=head+' ('+items.length+'개)';\n  document.getElementById('printTitle').textContent=head.replace('📋 ','')+' 연습';\n  const list=document.getElementById('resultList');\n  if(!items.length){\n    const off=hasTargets()? targetsOffProgress() : [];\n    const msg=off.length\n      ? '집중 음소 '+off.join('·')+'이(가) 진도 설정에서 꺼져 있어요. ⚙️ 진도 설정에서 켠 뒤 다시 생성해 주세요.'\n      : '조건에 맞는 항목이 부족해요. 진도를 더 켜거나 조건을 바꿔보세요.';\n    const d=document.createElement('div'); d.className='result-empty'; d.textContent=msg;\n    list.innerHTML=''; list.appendChild(d); lastResult=[]; return;\n  }\n  list.innerHTML='';\n  const tagName={real:'의미',nonsense:'무의미',sentence:'문장',pair:'짝'};\n  items.forEach((it,i)=>{\n    const row=document.createElement('div'); row.className='result-item';\n    const idx=document.createElement('span'); idx.className='idx'; idx.textContent=(i+1);\n    const txt=document.createElement('span');\n    if(hasTargets()){                                                    // 집중 음소 글자에 밑줄 (글자별 textContent)\n      for(const ch of it.text){ const sp=document.createElement('span'); sp.textContent=ch; if(sylTargetHit(ch)) sp.className='tg'; txt.appendChild(sp); }\n    } else txt.textContent=it.text;      // textContent (XSS 방지)\n    const tag=document.createElement('span'); tag.className='tag '+(it.type==='sentence'?'sent':it.type); tag.textContent=tagName[it.type];\n    row.appendChild(idx); row.appendChild(txt); row.appendChild(tag);\n    list.appendChild(row);\n  });\n  lastResult=items.map(it=>it.text);\n  if(items.some(it=>it.src==='krdict')){\n    const n=document.createElement('div'); n.className='src-note';\n    n.innerHTML='문장 출처: 국립국어원 「한국어기초사전」 예문 (<a href=\"https://creativecommons.org/licenses/by-sa/2.0/kr/\" target=\"_blank\" rel=\"noopener\" style=\"color:inherit\">CC BY-SA 2.0 KR</a>)';\n    list.appendChild(n);\n  }\n}\nfunction copyResult(btn){\n  if(!lastResult.length) return;\n  navigator.clipboard.writeText(lastResult.join('\\n')).then(()=>{\n    if(!btn) return; const o=btn.textContent; btn.textContent='✅ 복사됨'; setTimeout(()=>btn.textContent=o,1200);\n  }).catch(()=>openInfo('복사 실패','클립보드를 쓸 수 없어요. 목록을 드래그해서 복사해 주세요.'));\n}\nfunction resultToHandwriting(){\n  if(!lastResult.length){ openInfo('안내','먼저 자료를 생성해 주세요.'); return; }\n  openHandwriting(lastResult);\n}\nfunction openHandwriting(words){\n  // 문장부호 제거, 낱말만 — 글씨연습장 words 파라미터로 전달\n  const clean=words.flatMap(w=>w.split(/\\s*–\\s*/)).map(w=>w.replace(/[.,?!]/g,'').trim()).filter(Boolean).slice(0,60);\n  const url='https://sososoop.github.io/korean-handwriting/?words='+encodeURIComponent(clean.join(','));\n  window.open(url,'_blank');\n}\n\n/* =========================================================\n   가정과제 잠금 링크 (#hw=)  — 68비트 비트마스크(설계 2-B)\n   ========================================================= */\nfunction bytesToB64url(bytes){ let bin=''; bytes.forEach(b=>bin+=String.fromCharCode(b)); return btoa(bin).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,''); }\nfunction b64urlToBytes(s){ s=s.replace(/-/g,'+').replace(/_/g,'/'); while(s.length%4)s+='='; const bin=atob(s); const out=new Uint8Array(bin.length); for(let i=0;i<bin.length;i++)out[i]=bin.charCodeAt(i); return out; }\nfunction encodeHw(cho,jung,jong){\n  const bits=new Uint8Array(9);\n  const set=off=>{ bits[off>>3] |= (0x80 >> (off&7)); };\n  cho.forEach(i=>set(i));            // 0..18\n  jung.forEach(i=>set(19+i));        // 19..39\n  jong.forEach(i=>set(40+i));        // 40..67\n  return '1'+bytesToB64url(bits);\n}\nfunction decodeHw(str){\n  try{ str=decodeURIComponent(str); }catch(e){ return null; }\n  if(!str || str[0]!=='1' || !/^[A-Za-z0-9_-]+$/.test(str.slice(1))) return null;\n  let bytes; try{ bytes=b64urlToBytes(str.slice(1)); }catch(e){ return null; }\n  if(bytes.length!==9) return null;\n  const get=off=>!!(bytes[off>>3] & (0x80 >> (off&7)));\n  const cho=[],jung=[],jong=[];\n  for(let i=0;i<19;i++) if(get(i)) cho.push(i);\n  for(let i=0;i<21;i++) if(get(19+i)) jung.push(i);\n  for(let i=0;i<28;i++) if(get(40+i)) jong.push(i);\n  if(!jong.includes(0)) jong.unshift(0);\n  return {cho,jung,jong};\n}\nfunction makeHwLink(){\n  if(TRIAL){ trialLock('가정과제 링크'); return; }\n  const p=activeProfile(); if(!p) return;\n  const code=encodeHw(p.cho,p.jung,p.jong);\n  // 소소숲 유료판(/hangul/app, 로그인 필요)에서는 보호자용 공개 주소(/hangul/home)로 만든다\n  const base=/\\/hangul\\/app\\/?$/.test(location.pathname) ? location.origin+'/hangul/home' : location.origin+location.pathname;\n  const url=base+'#hw='+code;\n  openLinkModal('🏠 가정과제 링크', '아래 링크를 보호자에게 보내세요. 링크로 들어가면 <b>이 진도 그대로 잠금</b>되어 집에서 같은 범위로 연습할 수 있어요. (진도 변경 불가·아동 이름 미포함)', url);\n}\nfunction applyLockModeIfNeeded(){\n  const h=location.hash||'';\n  const m=h.match(/hw=([^&]+)/);\n  if(!m) return false;\n  const dec=decodeHw(m[1]);\n  if(!dec || !dec.cho.length || !dec.jung.length){   // 초성·중성이 하나라도 없으면 글자를 만들 수 없음\n    document.body.innerHTML='<div style=\"max-width:420px;margin:80px auto;padding:24px;text-align:center;font-family:sans-serif\"><h2>링크가 손상되었어요 😢</h2><p style=\"font-size:15px;color:#555\">선생님께 가정과제 링크를 다시 받아주세요.</p></div>';\n    return true;\n  }\n  // 단어 리스트(선택): 한글 화이트리스트 + textContent 렌더\n  let words=[];\n  const wm=h.match(/[&]w=([^&]+)/);\n  if(wm){ try{ words=decodeURIComponent(wm[1]).split(',').map(w=>w.replace(/[^가-힣]/g,'').slice(0,5)).filter(Boolean).slice(0,30); }catch(e){} }\n  lockMode=true;\n  lockProfile={ v:1, id:'hw', name:'오늘의 연습', cho:dec.cho, jung:dec.jung, jong:dec.jong, hwWords:words };\n  // UI: 진도/게임/자료 탭 숨김, 놀이만\n  document.getElementById('hwBadge').style.display='inline-block';\n  ['tabProg','tabGame','tabGen','manualLink'].forEach(id=>{ const el=document.getElementById(id); if(el) el.style.display='none'; });\n  switchMode('play');\n  if(words.length){ collected=words.map(w=>({word:w, real:REAL_SET.has(w)})); renderCollected(); }\n  return true;\n}\n\n/* =========================================================\n   모달 (커스텀 — 브라우저 alert/prompt 대체)\n   ========================================================= */\nlet nameCb=null, confirmCb=null;\nfunction openNameModal(title,val,cb){\n  document.getElementById('nameModalTitle').textContent=title;\n  const inp=document.getElementById('nameModalInput'); inp.value=val||'';\n  nameCb=cb;\n  document.getElementById('nameModal').classList.add('on');\n  setTimeout(()=>inp.focus(),50);\n}\nfunction closeNameModal(){ document.getElementById('nameModal').classList.remove('on'); nameCb=null; }\ndocument.getElementById('nameModalOk').onclick=()=>{ const v=document.getElementById('nameModalInput').value.trim(); const cb=nameCb; closeNameModal(); if(cb) cb(v); };\ndocument.getElementById('nameModalInput').addEventListener('keydown',e=>{ if(e.key==='Enter') document.getElementById('nameModalOk').click(); });\n\nfunction openInfo(title,msg){\n  document.getElementById('infoModalTitle').textContent=title;\n  document.getElementById('infoModalMsg').innerHTML=msg;\n  document.getElementById('infoModalInput').style.display='none';\n  document.getElementById('infoModalAction').style.display='none';\n  document.getElementById('infoModal').classList.add('on');\n}\nfunction openConfirm(title,msg,cb){\n  document.getElementById('infoModalTitle').textContent=title;\n  document.getElementById('infoModalMsg').innerHTML=msg;\n  document.getElementById('infoModalInput').style.display='none';\n  const act=document.getElementById('infoModalAction');\n  act.style.display=''; act.textContent='삭제'; act.className='warn';\n  act.onclick=()=>{ closeInfoModal(); if(cb) cb(); };\n  document.getElementById('infoModal').classList.add('on');\n}\nfunction openLinkModal(title,msg,url){\n  document.getElementById('infoModalTitle').textContent=title;\n  document.getElementById('infoModalMsg').innerHTML=msg;\n  const inp=document.getElementById('infoModalInput'); inp.style.display=''; inp.value=url;\n  const act=document.getElementById('infoModalAction');\n  act.style.display=''; act.textContent='📋 복사'; act.className='ok';\n  act.onclick=()=>{ navigator.clipboard.writeText(url).then(()=>{ act.textContent='✅ 복사됨'; setTimeout(()=>act.textContent='📋 복사',1200); }); };\n  document.getElementById('infoModal').classList.add('on');\n}\nfunction closeInfoModal(){ document.getElementById('infoModal').classList.remove('on'); }\n\n/* =========================================================\n   게임 (벽돌깨기 + 글자잡기) — 소재를 새 음소 진도에 재연결\n   ========================================================= */\nlet gScore=0, gCombo=0, gStage=0, gDiff='syl', gBricks=[];\nlet gGen=0;   // 판 세대 — 다시·전환 뒤 남은 타이머가 새 판을 건드리지 않게\nlet currentGame='brick';\nconst BRICK_COLORS=['--lime','--cho','--sent','--real','--lime-soft'];\nlet rainItems=[], rainRAF=null, rainActive=false, rainLives=3, lastSpawn=0, rainPaused=false, rainLast=0;\nconst RAIN_SPEEDS={1:0.35, 2:0.5, 3:0.7};   // 60Hz 한 프레임당 px — 화면 주사율과 상관없이 같은 속도가 되게 시간으로 환산해 씀\nlet rainSpeedLevel=1;                         // 기본 1단계(느림)\nconst RAIN_SPAWN_MS=2500, RAIN_MAX=5;\nconst IS_TOUCH = !!(window.matchMedia && window.matchMedia('(hover: none) and (pointer: coarse)').matches); // 모바일/태블릿=터치로 글자잡기\nlet audioCtx=null, soundOn=true;\nlet rainBest={syl:0, word2:0, word3:0};\n(function loadRainBest(){ try{ const s=JSON.parse(localStorage.getItem(RAIN_BEST_KEY)||'null'); if(s) rainBest=Object.assign(rainBest,s); }catch(e){} })();\nfunction saveRainBest(){ try{ localStorage.setItem(RAIN_BEST_KEY, JSON.stringify(rainBest)); }catch(e){} }\nfunction currentBest(){ return rainBest[gDiff]||0; }\nfunction renderBest(){ const el=document.getElementById('gBest'); if(el) el.textContent=currentBest(); }\n\nfunction setDiff(d){ if(TRIAL && d!=='syl'){ trialLock('두 글자 · 세 글자'); return; } gDiff=d; document.querySelectorAll('[data-diff]').forEach(b=>b.classList.toggle('on', b.dataset.diff===d)); restartGame(); }\nfunction setRainSpeed(lv){ rainSpeedLevel=lv; document.querySelectorAll('#rainSpeedRow .seg-btn').forEach(b=>b.classList.toggle('on', +b.dataset.spd===lv)); restartGame(); }\nfunction nSylWords(n){\n  const out=[];\n  const add=w=>{ if(sylCount(w)===n && wordAllowed(w)) out.push(w); };\n  ['noun','verb','adv','pron','interj'].forEach(p=>{ const b=LEXICON[p]; if(!b) return; for(const k in b) b[k].forEach(add); });\n  ['1','2'].forEach(g=>(DICT[g]||[]).forEach(add));   // 기초사전 초·중급 단어도 게임 소재로\n  return [...new Set(out)];\n}\nfunction nSylCombos(n){\n  const pool=[...new Set(syllablePool('mix'))];\n  if(!pool.length) return [];\n  const out=new Set(); let guard=0;\n  const target=Math.min(40, Math.max(12, Math.round(Math.pow(pool.length,n))));\n  while(out.size<target && guard<target*30){\n    let w=''; for(let k=0;k<n;k++) w+=pool[Math.floor(Math.random()*pool.length)];\n    out.add(w); guard++;\n  }\n  return [...out];\n}\nfunction currentDiffItems(){\n  if(gDiff==='word2'){ const items=[...new Set([...nSylWords(2).filter(w=>w.length===2), ...nSylCombos(2)])]; if(items.length) return items; }\n  if(gDiff==='word3'){ const items=[...new Set([...nSylWords(3).filter(w=>w.length===3), ...nSylCombos(3)])]; if(items.length) return items; }\n  return [...new Set(syllablePool('mix'))];\n}\nfunction diffPoints(){ return gDiff==='word3'?3 : gDiff==='word2'?2 : 1; }\nfunction stageItems(){ return shuffle(currentDiffItems()).slice(0,12); }\nfunction newStage(){\n  const grid=document.getElementById('brickGrid'); const msg=document.getElementById('gameMsg');\n  if(!grid) return;\n  gGen++;\n  const items=stageItems();\n  gBricks=[]; grid.innerHTML='';\n  if(!items.length){ msg.textContent='⚙️ 진도에서 음소를 먼저 켜주세요!'; return; }\n  msg.textContent='';\n  items.forEach((t,i)=>{\n    const el=document.createElement('div'); el.className='brick';\n    const cv=BRICK_COLORS[i%BRICK_COLORS.length]; el.style.background='var('+cv+')'; el.textContent=t;\n    grid.appendChild(el); gBricks.push({text:t, el, broken:false, colorVar:cv});\n  });\n  gCombo=0; renderGStats(); requestAnimationFrame(parkBall);\n  const gi=document.getElementById('gameInput'); if(gi){ gi.value=''; gi.focus(); }\n}\nfunction renderGStats(){\n  document.getElementById('gScore').textContent=gScore;\n  document.getElementById('gCombo').textContent=gCombo;\n  document.getElementById('gStage').textContent = currentGame==='rain' ? rainLives : gStage;\n}\nfunction parkBall(){\n  const arena=document.getElementById('gameArena'), ball=document.getElementById('gameBall');\n  if(!arena||!ball) return;\n  const w=arena.clientWidth, h=arena.clientHeight;\n  ball.style.transition='none'; ball.style.transform='translate('+(w/2-9)+'px,'+(h-34)+'px)';\n}\nfunction flyBall(brickEl, cb){\n  const arena=document.getElementById('gameArena'), ball=document.getElementById('gameBall');\n  const a=arena.getBoundingClientRect(), b=brickEl.getBoundingClientRect();\n  const x=b.left-a.left+b.width/2-9, y=b.top-a.top+b.height/2-9;\n  ball.style.transition='transform .16s ease-out'; ball.style.transform='translate('+x+'px,'+y+'px)';\n  setTimeout(()=>{ if(cb) cb(); const w=arena.clientWidth, h=arena.clientHeight; ball.style.transform='translate('+(w/2-9)+'px,'+(h-34)+'px)'; },170);\n}\nfunction resetGameInput(){ const gi=document.getElementById('gameInput'); gi.value=''; gi.blur(); gi.focus(); }\nfunction breakBrick(b){\n  if(b.broken) return;\n  b.broken=true; gScore += diffPoints()+Math.min(gCombo,5); gCombo++; renderGStats(); sfxPop();\n  const arena=document.getElementById('gameArena');\n  flyBall(b.el, ()=>{ b.el.classList.add('shatter'); const a=arena.getBoundingClientRect(), r=b.el.getBoundingClientRect(); burst(arena, r.left-a.left+r.width/2, r.top-a.top+r.height/2, b.colorVar); setTimeout(()=>{ b.el.style.visibility='hidden'; },240); });\n  if(gBricks.every(x=>x.broken)){ const gen=gGen; setTimeout(()=>{ if(gen!==gGen) return; sfxWin(); stageClear(); },300); }\n}\nfunction stageClear(){\n  gStage++; renderGStats();\n  const cheers=['🎉 판 깼다! 잘했어요!','⭐ 멋져요! 다음 판 갈까요?','🏆 최고! 계속 가봐요!','👏 완벽해요!'];\n  document.getElementById('gameMsg').textContent=cheers[Math.floor(Math.random()*cheers.length)];\n  const gen=gGen; setTimeout(()=>{ if(gen===gGen) newStage(); },1300);\n}\nfunction handleGame(composing){ if(currentGame==='rain') handleRain(composing); else handleBrick(composing); }\nfunction handleBrick(composing){\n  const gi=document.getElementById('gameInput');\n  if(!gBricks.length || gBricks.every(b=>b.broken)) return;\n  const v=gi.value.trim(); if(!v) return;\n  const hit=gBricks.find(b=>!b.broken && b.text===v);\n  if(hit){ breakBrick(hit); resetGameInput(); return; }\n  if(composing) return;\n  const isPrefix=gBricks.some(b=>!b.broken && b.text.startsWith(v));\n  if(!isPrefix){ gCombo=0; renderGStats(); flashWrong(); sfxWrong(); gi.value=''; }\n}\nfunction startGameTab(){\n  if(currentGame==='rain'){ if(!rainActive) startRain(); else focusInput(); }\n  else if(!gBricks.length || gBricks.every(b=>b.broken)){ newStage(); }\n  else { requestAnimationFrame(parkBall); focusInput(); }\n}\nfunction focusInput(){ const gi=document.getElementById('gameInput'); if(gi && gi.style.display!=='none') gi.focus(); }\nfunction flashWrong(){ const gi=document.getElementById('gameInput'); gi.classList.add('wrong'); setTimeout(()=>gi.classList.remove('wrong'),200); }\nfunction randColorVar(){ return BRICK_COLORS[Math.floor(Math.random()*BRICK_COLORS.length)]; }\n\nfunction ac(){ if(!audioCtx){ try{ audioCtx=new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ return null; } } if(audioCtx.state==='suspended') audioCtx.resume(); return audioCtx; }\nfunction tone(freq,dur,type,vol,when){ if(!soundOn) return; const c=ac(); if(!c) return; const o=c.createOscillator(), g=c.createGain(); o.type=type||'square'; o.frequency.value=freq; o.connect(g); g.connect(c.destination); const t=c.currentTime+(when||0); g.gain.setValueAtTime(vol||0.15,t); g.gain.exponentialRampToValueAtTime(0.0001,t+dur); o.start(t); o.stop(t+dur); }\nfunction sfxPop(){ tone(660,0.12,'square',0.18,0); tone(990,0.10,'square',0.12,0.02); }\nfunction sfxWrong(){ tone(150,0.18,'sawtooth',0.14,0); }\nfunction sfxWin(){ [523,659,784,1046].forEach((f,i)=>tone(f,0.16,'triangle',0.16,i*0.09)); }\nfunction toggleSound(){ soundOn=!soundOn; document.getElementById('soundToggle').textContent=soundOn?'🔊':'🔇'; if(soundOn) tone(880,0.08,'square',0.12,0); }\n\nfunction burst(arena, cx, cy, colorVar){\n  for(let i=0;i<12;i++){\n    const p=document.createElement('div'); p.className='particle';\n    const ang=Math.random()*Math.PI*2, dist=30+Math.random()*55;\n    p.style.setProperty('--dx',(Math.cos(ang)*dist).toFixed(1)+'px');\n    p.style.setProperty('--dy',(Math.sin(ang)*dist).toFixed(1)+'px');\n    p.style.left=(cx-5)+'px'; p.style.top=(cy-5)+'px';\n    p.style.background='var('+(colorVar||randColorVar())+')';\n    arena.appendChild(p); setTimeout(()=>p.remove(),520);\n  }\n}\nfunction selectGame(g){\n  if(TRIAL && g==='rain'){ trialLock('글자잡기 게임'); return; }\n  currentGame=g;\n  document.querySelectorAll('.gp-btn').forEach(b=>b.classList.toggle('on', b.dataset.game===g));\n  document.getElementById('brickGame').style.display = g==='brick'?'':'none';\n  document.getElementById('rainGame').style.display  = g==='rain'?'':'none';\n  document.getElementById('pauseBtn').style.display   = g==='rain'?'':'none';\n  document.getElementById('bestStat').style.display   = g==='rain'?'':'none';\n  document.getElementById('rainSpeedRow').style.display = g==='rain'?'':'none';\n  document.getElementById('gThirdLabel').textContent = g==='brick'?'깬 판':'생명';\n  // 글자잡기: 모바일(터치)에선 타자 입력창 숨김+글자 터치, PC에선 타자\n  document.getElementById('gameInput').style.display = (g==='rain' && IS_TOUCH) ? 'none' : '';\n  document.getElementById('gameHint').innerHTML = g==='brick'\n    ? '벽돌에 적힌 글자를 <b>타자로 치면</b> 공이 날아가 벽돌을 깨요! 시간제한은 없으니 <b>천천히 소리 내어 읽고</b> 쳐보세요.'\n    : (IS_TOUCH\n        ? '떨어지는 <b>글자를 정확히 읽고 손가락으로 톡!</b> 눌러 잡아요. 바닥에 닿기 전에! 놓쳐도 괜찮아요 — 생명은 하트로 표시돼요.'\n        : '위에서 <b>떨어지는 글자</b>를 바닥에 닿기 전에 <b>타자로 쳐서</b> 없애요! <b>마우스로 글자를 클릭해도</b> 없앨 수 있어요. 놓쳐도 괜찮아요 — 생명은 하트로 표시돼요.');\n  gGen++; gScore=0; gCombo=0; gStage=0; document.getElementById('gameMsg').textContent='';\n  if(g==='brick'){ stopRain(); renderGStats(); newStage(); }\n  else { rainLives=3; startRain(); }\n}\nfunction restartGame(){\n  gGen++; gScore=0; gCombo=0; gStage=0; document.getElementById('gameMsg').textContent='';\n  if(currentGame==='brick'){ renderGStats(); newStage(); }\n  else { rainLives=3; startRain(); }\n}\nfunction renderRainLives(){ const el=document.getElementById('rainLives'); if(!el) return; const n=Math.max(0,rainLives); el.textContent='❤️'.repeat(n)+'🤍'.repeat(Math.max(0,3-n)); }\nfunction startRain(){\n  rainItems.forEach(it=>it.el.remove()); rainItems=[];\n  rainActive=true; rainPaused=false; rainLives=(rainLives>0?rainLives:3); lastSpawn=0; rainLast=0;\n  const btn=document.getElementById('pauseBtn'); if(btn) btn.textContent='⏸️ 일시정지';\n  const ov=document.getElementById('rainPause'); if(ov) ov.style.display='none';\n  gCombo=0; renderGStats(); renderRainLives(); renderBest();\n  if(rainRAF) cancelAnimationFrame(rainRAF);\n  rainRAF=requestAnimationFrame(rainStep); focusInput();\n}\nfunction stopRain(){ rainActive=false; rainPaused=false; if(rainRAF){ cancelAnimationFrame(rainRAF); rainRAF=null; } rainItems.forEach(it=>it.el.remove()); rainItems=[]; }\nfunction togglePause(){\n  if(currentGame!=='rain' || !rainActive) return;\n  rainPaused=!rainPaused;\n  const btn=document.getElementById('pauseBtn'), ov=document.getElementById('rainPause');\n  if(rainPaused){ if(rainRAF){ cancelAnimationFrame(rainRAF); rainRAF=null; } btn.textContent='▶️ 계속하기'; ov.style.display='flex'; }\n  else{ btn.textContent='⏸️ 일시정지'; ov.style.display='none'; lastSpawn=0; rainLast=0; rainRAF=requestAnimationFrame(rainStep); focusInput(); }\n}\nfunction spawnRain(W){\n  const pool=currentDiffItems(); if(!pool.length) return;\n  const text=pool[Math.floor(Math.random()*pool.length)];\n  const el=document.createElement('div'); el.className='raindrop'; el.textContent=text;\n  document.getElementById('rainArena').appendChild(el);\n  const w=el.offsetWidth||60; const x=Math.random()*Math.max(1,(W-w-8))+4;\n  el.style.transform='translate('+x+'px,-46px)';\n  const item={text, el, x, y:-46, speed:RAIN_SPEEDS[rainSpeedLevel], dead:false};\n  // 모바일/클릭: 떨어지는 글자를 읽고 그냥 톡 터치하면 잡힘 (타자와 함께 동작)\n  el.addEventListener('pointerdown', e=>{ e.preventDefault(); if(rainActive && !rainPaused && !item.dead) catchRain(item); });\n  rainItems.push(item);\n}\nfunction rainStep(ts){\n  if(!rainActive) return;\n  const arena=document.getElementById('rainArena'); const H=arena.clientHeight, W=arena.clientWidth;\n  if(!lastSpawn) lastSpawn=ts;\n  if(ts-lastSpawn>RAIN_SPAWN_MS && rainItems.length<RAIN_MAX){ spawnRain(W); lastSpawn=ts; }\n  const step=rainLast? Math.min(50, ts-rainLast)/16.7 : 1; rainLast=ts;\n  rainItems.forEach(it=>{ if(it.dead) return; it.y+=it.speed*step; it.el.style.transform='translate('+it.x+'px,'+it.y+'px)'; if(it.y > H-52) missRain(it); });\n  rainItems=rainItems.filter(it=>!it.dead);\n  rainRAF=requestAnimationFrame(rainStep);\n}\nfunction catchRain(it){\n  it.dead=true; const a=document.getElementById('rainArena');\n  burst(a, it.x+it.el.offsetWidth/2, it.y+it.el.offsetHeight/2, randColorVar()); it.el.remove();\n  gScore += diffPoints()+Math.min(gCombo,5); gCombo++; renderGStats();\n  if(gScore>currentBest()){ rainBest[gDiff]=gScore; saveRainBest(); renderBest(); }\n  sfxPop();\n}\nfunction missRain(it){\n  if(it.dead) return;\n  it.dead=true; it.el.classList.add('splash'); const el=it.el; setTimeout(()=>el.remove(),300);\n  gCombo=0; rainLives--; renderRainLives(); renderGStats(); sfxWrong();\n  if(rainLives<=0) rainGameOver();\n}\nfunction rainGameOver(){\n  rainActive=false; if(rainRAF){ cancelAnimationFrame(rainRAF); rainRAF=null; }\n  rainItems.forEach(it=>it.el.remove()); rainItems=[];\n  document.getElementById('gameMsg').textContent='💪 아깝다! 다시 해볼까요?';\n  const btn=document.getElementById('pauseBtn'); if(btn) btn.textContent='⏸️ 일시정지';\n}\nfunction handleRain(composing){\n  if(!rainActive || rainPaused) return;\n  const gi=document.getElementById('gameInput'); const v=gi.value.trim(); if(!v) return;\n  const hits=rainItems.filter(it=>!it.dead && it.text===v);\n  if(hits.length){ hits.sort((a,b)=>b.y-a.y); catchRain(hits[0]); resetGameInput(); return; }\n  if(composing) return;\n  const isPrefix=rainItems.some(it=>!it.dead && it.text.startsWith(v));\n  if(!isPrefix){ gCombo=0; renderGStats(); flashWrong(); sfxWrong(); gi.value=''; }\n}\n(function bindGame(){\n  const gi=document.getElementById('gameInput'); if(!gi) return;\n  gi.addEventListener('input', e=>handleGame(e.isComposing));\n  gi.addEventListener('compositionend', ()=>handleGame(false));\n  gi.addEventListener('keydown', e=>{ if(e.key==='Escape' && currentGame==='rain'){ e.preventDefault(); togglePause(); } });\n})();\n\ndocument.addEventListener('keydown',e=>{   // 타일을 키보드로도 누를 수 있게\n  if((e.key==='Enter'||e.key===' ') && e.target && e.target.matches && e.target.matches('.pg-tile[role=button],.jamo-tile[role=button]')){ e.preventDefault(); e.target.click(); }\n});\nfunction shuffle(arr){ const a=arr.slice(); for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; }\n\n/* =========================================================\n   초기화\n   ========================================================= */\napplyTrialUI();\nconst hwLocked=applyLockModeIfNeeded();\nif(!hwLocked && window.__HW_ONLY__){\n  // 보호자용 주소(/hangul/home)는 가정과제 링크로만 연다\n  document.body.innerHTML='<div style=\"max-width:440px;margin:80px auto;padding:24px;text-align:center;font-family:sans-serif\"><h2>가정과제 링크로 들어와 주세요 🏠</h2><p style=\"font-size:15px;color:#555;line-height:1.6\">이 주소는 선생님께 받은 가정과제 링크로만 열려요.<br>링크를 다시 받아 그대로 눌러 주세요.</p><p style=\"margin-top:20px\"><a href=\"/hangul\" style=\"color:#5b6ef5;font-weight:700\">한글놀이 소개 보기 →</a></p></div>';\n} else if(!hwLocked){\n  renderProgress();\n  renderZones();\n  renderBoard();\n  renderCollected();\n  renderTargets();\n  syncGenFields();\n}\n</script>\n</body>\n</html>\n"