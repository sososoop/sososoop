"<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>한글놀이</title>\n<style>\n  :root{\n    --lime:#eaff3d;      /* 형광 라임 포인트 */\n    --lime-soft:#f2ff8f; /* 옅은 라임(하이라이트 박스) */\n    --blue:#5b6ef5;      /* 선택 탭 */\n    --ink:#141414;       /* 검정 테두리/글자 */\n    --real:#3ecf6a;      /* 의미단어 */\n    --nonsense:#ff8a4c;  /* 무의미단어 */\n    --sent:#b79bff;      /* 문장 */\n    --cho:#bfe3ff;       /* 초성 */\n    --jung:#eaff3d;      /* 중성 */\n    --jong:#ffd6a5;      /* 종성 */\n    --paper:#fff;\n    --bg:#f4f4ef;\n    --bd:2px solid var(--ink);\n    --sh:4px 4px 0 var(--ink);\n    --sh-sm:3px 3px 0 var(--ink);\n  }\n  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\n  html,body{margin:0;padding:0}\n  body{\n    font-family:\"Apple SD Gothic Neo\",\"Malgun Gothic\",Pretendard,sans-serif;\n    background:var(--bg);\n    color:var(--ink);\n    min-height:100vh;\n    -webkit-text-size-adjust:100%;\n  }\n  /* ---------- 상단 라임 바 ---------- */\n  .topbar{\n    background:var(--lime);border-bottom:var(--bd);\n    display:flex;align-items:center;justify-content:space-between;\n    padding:16px 20px;flex-wrap:wrap;gap:8px;\n  }\n  .brand{font-size:22px;font-weight:900;letter-spacing:-.5px;display:flex;align-items:center;gap:8px}\n  .brand .dotmark{width:16px;height:16px;background:var(--ink);border-radius:50%;display:inline-block}\n  .topbar .right{display:flex;align-items:center;gap:8px}\n  .hw-badge{display:none;background:var(--ink);color:var(--lime);font-size:13px;font-weight:900;padding:8px 14px;border-radius:2px}\n  .top-link{border:2px solid var(--ink);background:#fff;color:var(--ink);text-decoration:none;font-size:13px;font-weight:800;padding:8px 14px;box-shadow:3px 3px 0 var(--ink)}\n\n  .modeswitch{\n    max-width:980px;margin:22px auto 0;padding:0 16px;\n    display:flex;gap:10px;flex-wrap:wrap;\n  }\n  .modeswitch button{\n    border:var(--bd);background:#fff;padding:11px 20px;\n    font-size:15px;font-weight:800;color:var(--ink);cursor:pointer;\n    box-shadow:var(--sh-sm);transition:transform .08s;\n  }\n  .modeswitch button:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .modeswitch button.on{background:var(--blue);color:#fff}\n  main{max-width:980px;margin:0 auto;padding:16px 16px 70px}\n  .panel{display:none}\n  .panel.on{display:block;animation:fade .18s}\n  @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}\n\n  /* ---------- 공용 카드 ---------- */\n  .card{background:var(--paper);border:var(--bd);border-radius:2px;padding:20px;margin:16px 0;box-shadow:var(--sh)}\n  .card h2{font-size:18px;font-weight:900;margin:0 0 14px;display:flex;align-items:center;gap:8px}\n  .eyebrow{font-size:12px;font-weight:900;letter-spacing:2px;color:var(--blue);margin:0 0 4px}\n  .hint{font-size:13px;color:#555;margin:4px 0 14px;line-height:1.6}\n  .hint b{color:var(--ink)}\n  .mini-btn{border:var(--bd);border-radius:2px;background:#fff;font-size:12px;font-weight:800;padding:7px 11px;cursor:pointer;box-shadow:var(--sh-sm);transition:transform .06s;color:var(--ink)}\n  .mini-btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .mini-btn.warn{background:#ffdad7}\n\n  /* ---------- 프로필 바 ---------- */\n  .profile-bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}\n  .profile-bar select{padding:10px 12px;border:var(--bd);border-radius:2px;font-size:15px;font-weight:800;background:#fff;color:var(--ink);min-width:120px}\n\n  /* ---------- 진도 그리드 ---------- */\n  .prog-series{margin:0 0 6px}\n  .series-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:18px 0 8px}\n  .series-title{font-size:15px;font-weight:900}\n  .series-count{font-size:12px;font-weight:800;color:var(--blue)}\n  .pg-grouplabel{font-size:11px;font-weight:900;color:#999;letter-spacing:1px;margin:12px 2px 6px}\n  .pg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(52px,1fr));gap:8px}\n  .pg-tile{\n    position:relative;border:var(--bd);border-radius:2px;background:#fff;\n    font-size:22px;font-weight:900;padding:12px 0;text-align:center;cursor:pointer;\n    box-shadow:var(--sh-sm);transition:transform .06s;color:var(--ink);min-height:48px;\n  }\n  .pg-tile:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .pg-tile.on{background:var(--lime)}\n  .pg-tile.on:after{content:\"✓\";position:absolute;top:2px;right:5px;font-size:11px;font-weight:900;color:var(--ink)}\n  .pg-tile.fixed{background:var(--lime-soft);cursor:default;opacity:.9}\n  .pg-tile.fixed:active{transform:none;box-shadow:var(--sh-sm)}\n  .active-syls{display:flex;flex-wrap:wrap;gap:7px}\n\n  /* ---------- 놀이: 블렌딩 보드 ---------- */\n  .board{\n    display:flex;gap:10px;justify-content:center;align-items:flex-end;flex-wrap:wrap;\n    min-height:120px;background:var(--lime-soft);border:var(--bd);border-radius:2px;padding:18px 14px;margin-bottom:10px;\n  }\n  .syl-box{\n    position:relative;min-width:74px;min-height:92px;display:flex;align-items:center;justify-content:center;\n    font-size:52px;font-weight:900;line-height:1;border-radius:4px;cursor:pointer;padding:6px 8px;\n  }\n  .syl-box.locked{background:#e7e7de;border:2px solid #b7b7ab;color:#444}\n  .syl-box.active{background:#fff;border:2px dashed var(--blue)}\n  .syl-box.pop{animation:pop .16s}\n  @keyframes pop{from{transform:scale(.6);opacity:.3}to{transform:scale(1);opacity:1}}\n  .board .placeholder{color:#8f8f7a;font-size:16px;font-weight:800}\n  .verdict{text-align:center;font-size:16px;font-weight:900;min-height:26px;margin:8px 0 2px}\n  .verdict.real{color:#2a9d54}\n  .verdict.nonsense{color:#e06a2a}\n  .verdict.checking{color:#888}\n  .buildbtns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:10px}\n  .buildbtns button, .genbtns button{\n    border:var(--bd);border-radius:2px;padding:12px 18px;font-size:14px;font-weight:900;cursor:pointer;box-shadow:var(--sh-sm);transition:transform .08s;color:var(--ink);\n  }\n  .buildbtns button:active, .genbtns button:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .buildbtns button:disabled{opacity:.4;cursor:not-allowed}\n  .btn-next{background:var(--blue);color:#fff}\n  .btn-back{background:#fff}\n  .btn-random{background:var(--cho)}\n  .btn-save{background:var(--lime)}\n\n  /* 자모 존 */\n  .zone{margin-top:14px}\n  .zone-label{font-size:12px;font-weight:900;color:#888;letter-spacing:1px;margin:0 2px 7px;display:flex;align-items:center;gap:8px}\n  .zone-tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(56px,1fr));gap:9px}\n  .jamo-tile{\n    border:var(--bd);border-radius:2px;font-size:26px;font-weight:900;padding:13px 0;cursor:pointer;\n    box-shadow:var(--sh-sm);transition:transform .06s;color:var(--ink);text-align:center;min-height:52px;\n  }\n  .jamo-tile:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .jamo-tile.cho{background:var(--cho)}\n  .jamo-tile.jung{background:var(--jung)}\n  .jamo-tile.jong{background:var(--jong)}\n  .jamo-tile.sel{outline:3px solid var(--ink);outline-offset:-1px}\n  .zone-empty{font-size:13px;color:#999;font-weight:700}\n\n  /* 저장한 단어 / 칩 */\n  .collected{display:flex;flex-wrap:wrap;gap:9px;margin-top:4px}\n  .chip{padding:7px 13px;border:var(--bd);border-radius:2px;font-size:16px;font-weight:800;box-shadow:var(--sh-sm);background:#fff}\n  .chip.real{background:var(--real)}\n  .chip.nonsense{background:var(--nonsense)}\n  .empty{color:#999;font-size:13px;font-weight:600}\n\n  /* ---------- 생성 모드 ---------- */\n  .controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}\n  .field label{display:block;font-size:12px;font-weight:900;color:#666;margin-bottom:6px}\n  .field select,.field input{\n    width:100%;padding:11px 10px;border:var(--bd);border-radius:2px;font-size:14px;font-weight:700;background:#fff;color:var(--ink);\n  }\n  .segrow{display:flex;gap:6px;flex-wrap:wrap}\n  .seg{display:inline-flex;border:var(--bd);border-radius:2px;overflow:hidden;box-shadow:var(--sh-sm)}\n  .seg-btn{border:0;border-right:2px solid var(--ink);background:#fff;font-weight:900;font-size:13px;padding:10px 14px;cursor:pointer;color:var(--ink)}\n  .seg-btn:last-child{border-right:0}\n  .seg-btn.on{background:var(--blue);color:#fff}\n  .genbtns{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}\n  .btn-gen{background:var(--blue);color:#fff}\n  .btn-print{background:var(--lime)}\n  .btn-copy{background:#fff}\n\n  .result-list{margin-top:8px}\n  .result-item{\n    display:flex;align-items:center;gap:12px;padding:11px 4px;border-bottom:2px solid #eee;font-size:20px;font-weight:800;\n  }\n  .result-item:last-child{border-bottom:0}\n  .result-item .idx{font-size:12px;color:#aaa;min-width:24px;font-weight:800}\n  .result-item .tag{font-size:11px;font-weight:900;padding:3px 9px;border:2px solid var(--ink);margin-left:auto}\n  .tag.real{background:var(--real)}\n  .tag.nonsense{background:var(--nonsense)}\n  .tag.sent{background:var(--sent)}\n  .result-empty{color:#999;font-size:14px;font-weight:600;padding:14px 0}\n  /* 음절표 */\n  .syl-table{border-collapse:collapse;width:100%;margin-top:8px}\n  .syl-table th,.syl-table td{border:2px solid var(--ink);text-align:center;font-size:22px;font-weight:900;padding:8px 4px}\n  .syl-table th{background:var(--lime-soft);font-size:18px}\n  .syl-table td.real-cell{background:var(--lime);}\n  .syl-table caption{font-weight:900;font-size:14px;margin-bottom:6px;text-align:left}\n\n  /* ---------- 게임 ---------- */\n  .game-top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px}\n  .game-stats{display:flex;gap:16px;font-size:13px;font-weight:800;color:#555}\n  .game-stats b{font-size:20px;color:var(--ink)}\n  .arena{position:relative;height:330px;background:var(--lime-soft);border:var(--bd);border-radius:2px;overflow:hidden;margin-bottom:14px}\n  .bricks{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:16px}\n  .brick{\n    border:var(--bd);border-radius:2px;box-shadow:var(--sh-sm);color:var(--ink);\n    font-size:30px;font-weight:900;min-height:58px;line-height:1;\n    display:flex;align-items:center;justify-content:center;\n  }\n  .brick.shatter{animation:shatter .26s forwards}\n  @keyframes shatter{to{transform:scale(1.5) rotate(12deg);opacity:0}}\n  .ball{position:absolute;left:0;top:0;width:18px;height:18px;border-radius:50%;background:var(--ink);z-index:5;box-shadow:var(--sh-sm)}\n  .paddle{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);width:88px;height:12px;background:var(--blue);border:var(--bd);border-radius:2px;z-index:4}\n  .game-input-row{display:flex;gap:10px;align-items:center}\n  #gameInput{flex:1;padding:14px 16px;border:var(--bd);border-radius:2px;font-size:24px;font-weight:800;background:#fff;color:var(--ink);text-align:center}\n  #gameInput:focus{outline:none;box-shadow:var(--sh-sm)}\n  #gameInput.wrong{background:#ffdad7;animation:shake .2s}\n  @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}\n  .game-msg{text-align:center;font-size:18px;font-weight:900;min-height:26px;margin-top:14px;color:var(--blue)}\n  .game-picker{display:flex;gap:10px;margin:2px 0 14px}\n  .gp-btn{flex:1;border:var(--bd);border-radius:2px;background:#fff;font-weight:900;font-size:16px;padding:14px 10px;cursor:pointer;color:var(--ink);box-shadow:var(--sh-sm);transition:transform .08s}\n  .gp-btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .gp-btn.on{background:var(--lime)}\n  .particle{position:absolute;width:11px;height:11px;border:2px solid var(--ink);pointer-events:none;z-index:8;animation:burst .5s ease-out forwards}\n  @keyframes burst{to{transform:translate(var(--dx),var(--dy)) rotate(200deg);opacity:0}}\n  .rain-arena{overflow:hidden}\n  .rain-ground{position:absolute;left:0;right:0;bottom:0;height:8px;background:var(--ink);z-index:2}\n  .rain-lives{position:absolute;right:12px;bottom:12px;font-size:20px;letter-spacing:2px;z-index:6}\n  .raindrop{position:absolute;left:0;top:0;background:#fff;border:var(--bd);border-radius:2px;box-shadow:var(--sh-sm);font-size:26px;font-weight:900;padding:10px 14px;line-height:1;white-space:nowrap;z-index:3;color:var(--ink);cursor:pointer;touch-action:manipulation}\n  .raindrop:active{background:var(--lime)}\n  .raindrop.splash{animation:splash .3s forwards}\n  @keyframes splash{to{opacity:0;background:#ffb3ad}}\n  .rain-pause{display:none;position:absolute;inset:0;z-index:9;background:rgba(244,244,239,.9);align-items:center;justify-content:center;text-align:center;font-size:28px;font-weight:900;color:var(--ink)}\n  .rain-pause span{display:block;margin-top:8px;font-size:14px;font-weight:800;color:#666}\n\n  footer{text-align:center;font-size:12px;font-weight:700;color:#999;padding:24px 10px}\n\n  /* 모달 */\n  .modal-back{display:none;position:fixed;inset:0;background:rgba(20,20,20,.45);z-index:50;align-items:center;justify-content:center;padding:20px}\n  .modal-back.on{display:flex}\n  .modal{background:#fff;border:var(--bd);border-radius:2px;box-shadow:var(--sh);padding:22px;max-width:380px;width:100%}\n  .modal h3{margin:0 0 12px;font-size:17px;font-weight:900}\n  .modal input{width:100%;padding:12px;border:var(--bd);border-radius:2px;font-size:16px;font-weight:700;margin-bottom:14px}\n  .modal .row{display:flex;gap:10px;justify-content:flex-end}\n  .modal .row button{border:var(--bd);border-radius:2px;padding:10px 16px;font-weight:900;cursor:pointer;box-shadow:var(--sh-sm);background:#fff}\n  .modal .row .ok{background:var(--lime)}\n  .modal .msg{font-size:14px;line-height:1.6;margin-bottom:14px}\n\n  @media print{\n    body{background:#fff}\n    .topbar,.modeswitch,footer,.controls,.genbtns,.hint,.eyebrow,#playPanel,#gamePanel,#progPanel{display:none !important}\n    .card{box-shadow:none;border:2px solid #000;break-inside:avoid}\n    .result-item{font-size:22px}\n    .result-item .tag,.syl-table td.real-cell{-webkit-print-color-adjust:exact;print-color-adjust:exact}\n    #printTitle{display:block !important}\n  }\n  #printTitle{display:none;text-align:center;font-size:22px;font-weight:900;margin-bottom:10px}\n</style>\n</head>\n<body>\n<div class=\"topbar\">\n  <div class=\"brand\"><span class=\"dotmark\"></span><span id=\"brandName\">한글놀이</span></div>\n  <div class=\"right\">\n    <span class=\"hw-badge\" id=\"hwBadge\">🏠 오늘의 연습</span>\n    <a href=\"manual.html\" class=\"top-link\" id=\"manualLink\">❓ 사용법</a>\n  </div>\n</div>\n<div class=\"modeswitch\" id=\"modeswitch\">\n  <button id=\"tabProg\" class=\"on\" onclick=\"switchMode('prog')\">⚙️ 진도 설정</button>\n  <button id=\"tabPlay\" onclick=\"switchMode('play')\">💡 놀이</button>\n  <button id=\"tabGame\" onclick=\"switchMode('game')\">🎮 게임</button>\n  <button id=\"tabGen\" onclick=\"switchMode('gen')\">🖨️ 자료 만들기</button>\n</div>\n\n<main>\n  <!-- ================= 진도 설정 ================= -->\n  <section id=\"progPanel\" class=\"panel on\">\n    <div class=\"card\">\n      <h2>👦 아동 프로필</h2>\n      <p class=\"hint\" style=\"margin-top:0\">아동마다 배운 음소가 다르니, 프로필을 나눠 관리하세요. 실명 대신 <b>별칭</b>을 권장해요. 이름·진도는 이 기기에만 저장됩니다.</p>\n      <div class=\"profile-bar\">\n        <select id=\"profileSelect\" onchange=\"switchProfile(this.value)\"></select>\n        <button class=\"mini-btn\" onclick=\"addProfile()\">＋ 추가</button>\n        <button class=\"mini-btn\" onclick=\"renameProfile()\">✏️ 이름변경</button>\n        <button class=\"mini-btn warn\" onclick=\"deleteProfile()\">🗑 삭제</button>\n        <button class=\"mini-btn\" onclick=\"exportProfiles()\">⭳ 내보내기</button>\n        <button class=\"mini-btn\" onclick=\"document.getElementById('importFile').click()\">⭱ 가져오기</button>\n        <input type=\"file\" id=\"importFile\" accept=\"application/json,.json\" style=\"display:none\" onchange=\"importProfiles(this.files[0])\">\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <h2>🔤 지금 만들 수 있는 글자</h2>\n      <p class=\"hint\" style=\"margin-top:0\">아래에서 켠 초성·중성·종성으로 조합되는 글자 예시입니다. (일부만 표시)</p>\n      <div class=\"active-syls\" id=\"activeSyls\"></div>\n    </div>\n\n    <div class=\"card\">\n      <h2>⚙️ 진도 설정 <button class=\"mini-btn\" style=\"margin-left:auto\" onclick=\"makeHwLink()\">🏠 가정과제 링크</button></h2>\n      <p class=\"hint\" style=\"margin-top:0\">오늘 배운 음소만 켜세요. 켠 음소만 놀이·게임·자료 만들기에 쓰입니다. 변경은 자동 저장됩니다.</p>\n      <div id=\"progGrids\"></div>\n    </div>\n\n    <div class=\"card\">\n      <p class=\"hint\" style=\"margin:0;font-size:12px;color:#888\">\n        📖 온라인 판별 출처: 국립국어원 <b>한국어기초사전</b> (CC BY-SA 2.0 KR). 단어의 사전 등재 여부(사실)만 판별에 쓰며 뜻풀이는 저장·표시하지 않습니다.\n      </p>\n    </div>\n  </section>\n\n  <!-- ================= 놀이(블렌딩 보드) ================= -->\n  <section id=\"playPanel\" class=\"panel\">\n    <div class=\"card\">\n      <p class=\"eyebrow\">BLENDING BOARD</p>\n      <h2>✏️ 초성·중성·종성을 눌러 글자를 만들어요</h2>\n      <div class=\"board\" id=\"board\">\n        <span class=\"placeholder\">아래 자모를 눌러보세요</span>\n      </div>\n      <div class=\"verdict\" id=\"verdict\"></div>\n      <div class=\"buildbtns\">\n        <button class=\"btn-next\" id=\"nextBtn\" onclick=\"nextSyl()\">다음 글자 ＋</button>\n        <button class=\"btn-back\" onclick=\"delLast()\">⬅️ 지우기</button>\n        <button class=\"btn-clear\" onclick=\"clearBoard()\">🧹 처음부터</button>\n        <button class=\"btn-save\" onclick=\"saveWord()\">⭐ 담기</button>\n      </div>\n      <div class=\"buildbtns\" style=\"margin-top:8px\">\n        <span style=\"align-self:center;font-size:14px;font-weight:900\">🎲 랜덤 글자</span>\n        <button class=\"btn-random\" onclick=\"randomWord(1)\">1음절</button>\n        <button class=\"btn-random\" onclick=\"randomWord(2)\">2음절</button>\n        <button class=\"btn-random\" onclick=\"randomWord(3)\">3음절</button>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"zone\">\n        <div class=\"zone-label\">초성 (첫소리)</div>\n        <div class=\"zone-tiles\" id=\"zoneCho\"></div>\n      </div>\n      <div class=\"zone\">\n        <div class=\"zone-label\">중성 (가운뎃소리)</div>\n        <div class=\"zone-tiles\" id=\"zoneJung\"></div>\n      </div>\n      <div class=\"zone\">\n        <div class=\"zone-label\">종성 (받침)</div>\n        <div class=\"zone-tiles\" id=\"zoneJong\"></div>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <h2>⭐ 담은 단어 <span id=\"collectedCount\" style=\"font-size:13px;color:#8a8578;font-weight:600\"></span>\n        <button class=\"mini-btn\" style=\"margin-left:auto\" onclick=\"collectedToHandwriting()\">✍️ 글씨연습장</button></h2>\n      <div class=\"collected\" id=\"collected\"><span class=\"empty\">아직 담은 단어가 없어요.</span></div>\n    </div>\n  </section>\n\n  <!-- ================= 게임 ================= -->\n  <section id=\"gamePanel\" class=\"panel\">\n    <div class=\"card\">\n      <p class=\"eyebrow\">TYPING GAMES</p>\n      <h2>🎮 타자 게임 <button id=\"soundToggle\" class=\"mini-btn\" style=\"margin-left:auto\" onclick=\"toggleSound()\">🔊</button></h2>\n      <div class=\"game-picker\">\n        <button class=\"gp-btn on\" data-game=\"brick\" onclick=\"selectGame('brick')\">🧱 벽돌깨기</button>\n        <button class=\"gp-btn\" data-game=\"rain\" onclick=\"selectGame('rain')\">💻 글자잡기</button>\n      </div>\n      <p class=\"hint\" id=\"gameHint\">벽돌에 적힌 글자를 <b>타자로 치면</b> 공이 날아가 벽돌을 깨요! 진도에서 켠 음소로 만든 글자만 나와요. 시간제한은 없으니 <b>천천히 소리 내어 읽고</b> 쳐보세요.</p>\n      <div class=\"segrow\" id=\"rainSpeedRow\" style=\"display:none;margin:0 0 14px\">\n        <span style=\"font-size:13px;font-weight:900;align-self:center;margin-right:6px\">속도</span>\n        <div class=\"seg\">\n          <button class=\"seg-btn on\" data-spd=\"1\" onclick=\"setRainSpeed(1)\">1단계·느림</button>\n          <button class=\"seg-btn\" data-spd=\"2\" onclick=\"setRainSpeed(2)\">2단계·보통</button>\n          <button class=\"seg-btn\" data-spd=\"3\" onclick=\"setRainSpeed(3)\">3단계·빠름</button>\n        </div>\n      </div>\n      <div class=\"game-top\">\n        <div class=\"seg\">\n          <button class=\"seg-btn on\" data-diff=\"syl\" onclick=\"setDiff('syl')\">한 글자</button>\n          <button class=\"seg-btn\" data-diff=\"word2\" onclick=\"setDiff('word2')\">두 글자</button>\n          <button class=\"seg-btn\" data-diff=\"word3\" onclick=\"setDiff('word3')\">세 글자</button>\n        </div>\n        <div class=\"game-stats\">\n          <span>점수 <b id=\"gScore\">0</b></span>\n          <span>콤보 <b id=\"gCombo\">0</b></span>\n          <span><span id=\"gThirdLabel\">깬 판</span> <b id=\"gStage\">0</b></span>\n          <span id=\"bestStat\" style=\"display:none\">🏆 최고 <b id=\"gBest\">0</b></span>\n        </div>\n      </div>\n      <p class=\"hint\" style=\"margin:0 0 12px\">💡 <b>한 글자·두 글자·세 글자</b>는 나오는 낱말의 글자 수예요. 두·세 글자는 <b>진도 설정</b>에서 켠 글자를 조합해 만들어서, 실제 낱말이 아닐 수도 있어요.</p>\n\n      <div id=\"brickGame\">\n        <div class=\"arena\" id=\"gameArena\">\n          <div class=\"bricks\" id=\"brickGrid\"></div>\n          <div class=\"ball\" id=\"gameBall\"></div>\n          <div class=\"paddle\" id=\"gamePaddle\"></div>\n        </div>\n      </div>\n      <div id=\"rainGame\" style=\"display:none\">\n        <div class=\"arena rain-arena\" id=\"rainArena\">\n          <div class=\"rain-ground\"></div>\n          <div class=\"rain-lives\" id=\"rainLives\"></div>\n          <div class=\"rain-pause\" id=\"rainPause\"><div>⏸️ 일시정지<br><span>“▶️ 계속하기”를 누르면 이어서 해요</span></div></div>\n        </div>\n      </div>\n\n      <div class=\"game-input-row\">\n        <input id=\"gameInput\" type=\"text\" placeholder=\"글자를 입력하세요\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\">\n        <button class=\"mini-btn\" id=\"pauseBtn\" style=\"display:none\" onclick=\"togglePause()\">⏸️ 일시정지</button>\n        <button class=\"mini-btn\" onclick=\"restartGame()\">🔄 다시</button>\n      </div>\n      <div class=\"game-msg\" id=\"gameMsg\"></div>\n    </div>\n  </section>\n\n  <!-- ================= 자료 만들기 ================= -->\n  <section id=\"genPanel\" class=\"panel\">\n    <div id=\"printTitle\"></div>\n    <div class=\"card\">\n      <p class=\"eyebrow\">AUTO GENERATOR</p>\n      <h2>🖨️ 학습 자료 만들기</h2>\n      <p class=\"hint\">조건을 정하고 <b>생성</b>을 누르면 목록이 만들어져요. 현재 프로필에서 켠 음소만 사용합니다.</p>\n      <div class=\"controls\">\n        <div class=\"field\">\n          <label>유형</label>\n          <select id=\"genType\">\n            <option value=\"real\">의미 단어</option>\n            <option value=\"nonsense\">무의미 단어</option>\n            <option value=\"sentence\">문장</option>\n          </select>\n        </div>\n        <div class=\"field\" id=\"syllField\">\n          <label>음절 수</label>\n          <select id=\"genSyll\">\n            <option value=\"0\">상관없음</option>\n            <option value=\"1\">1음절</option>\n            <option value=\"2\">2음절</option>\n            <option value=\"3\">3음절</option>\n          </select>\n        </div>\n        <div class=\"field\" id=\"batchimField\">\n          <label>받침</label>\n          <select id=\"genBatchim\">\n            <option value=\"mix\">섞기</option>\n            <option value=\"none\">받침 없음만</option>\n            <option value=\"only\">받침 있는것만</option>\n          </select>\n        </div>\n        <div class=\"field\" id=\"lenField\" style=\"display:none\">\n          <label>어절 수 (문장)</label>\n          <select id=\"genLen\">\n            <option value=\"0\">섞어서</option>\n            <option value=\"2\">2어절</option>\n            <option value=\"3\">3어절</option>\n            <option value=\"4\">4어절</option>\n          </select>\n        </div>\n        <div class=\"field\" id=\"countField\">\n          <label>개수</label>\n          <input id=\"genCount\" type=\"number\" min=\"1\" max=\"100\" value=\"20\">\n        </div>\n      </div>\n      <div class=\"genbtns\">\n        <button class=\"btn-gen\" onclick=\"generate()\">✨ 생성</button>\n        <button class=\"btn-copy\" onclick=\"copyResult()\">📋 복사</button>\n        <button class=\"btn-copy\" onclick=\"resultToHandwriting()\">✍️ 글씨연습장 만들기</button>\n        <button class=\"btn-print\" onclick=\"window.print()\">🖨️ 인쇄</button>\n      </div>\n      <p class=\"hint\" style=\"margin:12px 0 0\" id=\"genNote\">💡 “무의미 단어”는 실제 사전에 없는 소리 연습용 글자예요. 고유명사·활용형은 사전에 없어도 실제 단어일 수 있으니 <b>선생님이 확인</b>해 주세요.</p>\n    </div>\n\n    <div class=\"card\">\n      <h2 id=\"resultHead\">📋 결과</h2>\n      <div class=\"result-list\" id=\"resultList\"><div class=\"result-empty\">조건을 정하고 “생성”을 눌러주세요.</div></div>\n    </div>\n  </section>\n</main>\n\n<footer>\n  @slp_irudassam 한글놀이<br>\n  <span style=\"font-size:11px\">온라인 사전 판별 시 출처: 국립국어원 「한국어기초사전」 (CC BY-SA 2.0 KR)</span>\n</footer>\n\n<!-- 이름 입력 모달 -->\n<div class=\"modal-back\" id=\"nameModal\">\n  <div class=\"modal\">\n    <h3 id=\"nameModalTitle\">프로필 이름</h3>\n    <input id=\"nameModalInput\" maxlength=\"20\" placeholder=\"별칭 (실명 대신)\" autocomplete=\"off\">\n    <div class=\"row\">\n      <button onclick=\"closeNameModal()\">취소</button>\n      <button class=\"ok\" id=\"nameModalOk\">확인</button>\n    </div>\n  </div>\n</div>\n<!-- 안내/링크 모달 -->\n<div class=\"modal-back\" id=\"infoModal\">\n  <div class=\"modal\">\n    <h3 id=\"infoModalTitle\">안내</h3>\n    <div class=\"msg\" id=\"infoModalMsg\"></div>\n    <input id=\"infoModalInput\" style=\"display:none\" readonly onclick=\"this.select()\">\n    <div class=\"row\">\n      <button id=\"infoModalAction\" style=\"display:none\"></button>\n      <button class=\"ok\" onclick=\"closeInfoModal()\">닫기</button>\n    </div>\n  </div>\n</div>\n\n<script>\n/* =========================================================\n   한글 자모 인덱스 기준표 (유니코드 조합 순서, 설계 2-C)\n   음절 = 0xAC00 + (초성 × 21 + 중성) × 28 + 종성\n   ========================================================= */\nconst CHO  = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ']; // 19\nconst JUNG = ['ㅏ','ㅐ','ㅑ','ㅒ','ㅓ','ㅔ','ㅕ','ㅖ','ㅗ','ㅘ','ㅙ','ㅚ','ㅛ','ㅜ','ㅝ','ㅞ','ㅟ','ㅠ','ㅡ','ㅢ','ㅣ']; // 21\nconst JONG = ['','ㄱ','ㄲ','ㄳ','ㄴ','ㄵ','ㄶ','ㄷ','ㄹ','ㄺ','ㄻ','ㄼ','ㄽ','ㄾ','ㄿ','ㅀ','ㅁ','ㅂ','ㅄ','ㅅ','ㅆ','ㅇ','ㅈ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ']; // 28\nfunction composeSyl(ci,mi,ji){ return String.fromCharCode(0xAC00 + (ci*21 + mi)*28 + (ji||0)); }\nfunction decompose(ch){\n  const code=ch.charCodeAt(0)-0xAC00;\n  if(code<0||code>11171) return null;\n  const ji=code%28, mi=((code-ji)/28)%21, ci=Math.floor(code/(21*28));\n  return {ci,mi,ji};\n}\n\n/* 화면 표시용 그룹(표시 순서일 뿐, 저장은 항상 위 유니코드 인덱스) */\nconst CHO_GROUPS=[\n  {label:'기본 자음', idx:[0,2,3,5,6,7,9,11,12,18]},\n  {label:'격음(거센소리)', idx:[14,15,16,17]},\n  {label:'경음(된소리)', idx:[1,4,8,10,13]},\n];\nconst JUNG_GROUPS=[\n  {label:'단모음', idx:[0,4,8,13,18,20,1,5]},\n  {label:'이중모음 · ㅑ계', idx:[2,6,12,17,3,7]},\n  {label:'이중모음 · ㅘ계', idx:[9,14,11,16,10,15]},\n  {label:'ㅢ', idx:[19]},\n];\nconst JONG_GROUPS=[\n  {label:'받침 없음', idx:[0], fixed:true},\n  {label:'대표음 7종성', idx:[1,4,7,8,16,17,21]},\n  {label:'그 외 홑받침', idx:[2,19,20,22,23,24,25,26,27]},\n  {label:'겹받침', idx:[3,5,6,9,10,11,12,13,14,15,18]},\n];\n\n/* 기본 프로필 음소(입문용): 기본자음10 + 기본모음6 + 받침없음 */\nconst DEFAULT_CHO=[0,2,3,5,6,7,9,11,12,18];\nconst DEFAULT_JUNG=[0,4,8,13,18,20];\nconst DEFAULT_JONG=[0];\n\n/* =========================================================\n   의미 단어 사전 (품사/음절수 태깅) — 받침 단어 포함\n   ========================================================= */\nconst LEXICON = {\n  noun: {\n    1:['이','비','무','소','수','기','오','구','모','밥','눈','산','물','곰','문','김','발','손','별','강','공','집','책','꽃','컵','봄','밤','빵','콩','병','말','불','풀','돌','길','힘','감','숲','잎','양','종','창','방','상','담','섬','귤','약','옷','낮','문','달','별'],\n    2:['아기','아가','아이','오이','나이','나무','나비','누나','나사','바지','바다','바보','부자','구두','고기','가구','가지','거미','기구','노조','무지','도마','두부','모자','미소','비누','사자','시소','사기','자두','지구','주사','조기','이사','이마','부사','수도','고도','주부','누이','도구','부부','가수','도시','조사','구조','가사','주소','자수','모기','가마','이모','고모','사이','자기','사탕','가방','사슴','구름','바람','사랑','선물','학교','동생','얼굴','마을','그림','사진','감기','김밥','눈물','손님','연필','책상','창문','신발','양말','얼음','단추','걸음','목욕','생선','공책','바퀴','손수건','수건'],\n    3:['어머니','아버지','주머니','보자기','소나기','가마니','바나나','소시지','비디오','오디오','마사지','고구마','두더지','다시마','바구니','나머지','도가니','기린','다람쥐','코끼리','원숭이','강아지','고양이','병아리','메뚜기','달팽이','무지개','솜사탕','자전거','장난감','냉장고','손톱']\n  },\n  verb: {\n    2:['가다','오다','사다','자다','서다','보다','주다','나다','지다','비다','두다','먹다','앉다','웃다','울다','읽다','씻다','신다','입다','닫다','열다','걷다','잡다','접다','뛰다'],\n    3:['이기다','나누다','다니다','마시다','비비다','지우다','모이다','가시다','고이다','구기다','가두다','모시다','나서다','지나다','만나다','기다리다','일어나다','달리다','넘어지다','올라가다']\n  },\n  adv: {\n    1:['더','다','꼭','또','참','막','잘'],\n    2:['너무','자주','아마','어서','아주','다시','마주','정말','조금','가끔','얼른','천천']\n  },\n  pron: {\n    1:['나','너','저'],\n    2:['어디','거기','저기','누구','당신'],\n    3:[]\n  },\n  interj: {\n    1:['아','오','우','어'],\n    2:['어머','저런'],\n    3:['어머나']\n  }\n};\nfunction lexBucket(pos){\n  if(pos==='pron') return mergeBuckets(LEXICON.pron, LEXICON.interj);\n  return LEXICON[pos];\n}\nfunction mergeBuckets(a,b){\n  const out={1:[],2:[],3:[]};\n  [a,b].forEach(src=>{for(const k in src){out[k]=(out[k]||[]).concat(src[k]||[])}});\n  return out;\n}\nconst REAL_SET = new Set();\n[LEXICON.noun,LEXICON.verb,LEXICON.adv,LEXICON.pron,LEXICON.interj].forEach(b=>{\n  for(const k in b) b[k].forEach(w=>REAL_SET.add(w));\n});\n\nconst SENTENCES = {\n  2:['아기가 자다.','비가 오다.','누나가 오다.','고기 주다.','바다 가다.','오이 사다.','어디 가다?','너무 시다.','밥을 먹다.','책을 읽다.','손을 씻다.','물을 주다.'],\n  3:['아기가 두부 사다.','아버지가 바나나 주다.','누나가 고기 사다.','비가 자주 오다.','어서 바다 가다.','아이가 오이 보다.','마주 서서 보다.','나도 사자 보다.','동생이 밥을 먹다.','강아지가 공을 잡다.','학교에 신발 신다.'],\n  4:['누나가 바나나 더 주다.','어머, 비가 너무 오다.','아버지가 아주 자주 오다.','아이가 바지 자주 구기다.','어머니가 두부 다시 사다.','나도 오이 다시 사다.','동생이 밥을 다 먹다.','강아지가 공을 꼭 잡다.']\n};\n\n/* =========================================================\n   프로필 상태 (localStorage: sp.profiles.v1 / sp.activeProfileId)\n   ========================================================= */\nconst PROFILES_KEY='sp.profiles.v1';\nconst ACTIVE_KEY='sp.activeProfileId';\nconst OLD_KEY='syllable-progress-v1';\nconst CACHE_STORE='krdict-cache-v1';\nconst RAIN_BEST_KEY='syllable-rain-best-v1';\nconst DICT_PROXY='https://syllable-dict.irudassam.workers.dev';\n\nlet profiles=[];\nlet activeId=null;\nlet lockMode=false;        // 가정과제 잠금 링크로 진입\nlet lockProfile=null;      // 잠금 모드 임시 프로필(저장 안 함)\n\nfunction uid(){ try{ return 'p_'+crypto.randomUUID().slice(0,8); }catch(e){ return 'p_'+Math.floor(performance.now()).toString(36); } }\nfunction nowTs(){ return Date.now ? Date.now() : +new Date(); }\n\nfunction activeProfile(){\n  if(lockMode) return lockProfile;\n  return profiles.find(p=>p.id===activeId) || profiles[0] || null;\n}\nfunction enabled(kind){ const p=activeProfile(); return p ? p[kind] : []; }\nfunction enabledSet(kind){ return new Set(enabled(kind)); }\n\nfunction newProfile(name){\n  return { v:1, id:uid(), name:name||'아이', cho:DEFAULT_CHO.slice(), jung:DEFAULT_JUNG.slice(), jong:DEFAULT_JONG.slice(), createdAt:nowTs(), updatedAt:nowTs() };\n}\nfunction saveProfiles(){\n  try{\n    localStorage.setItem(PROFILES_KEY, JSON.stringify(profiles));\n    if(activeId) localStorage.setItem(ACTIVE_KEY, activeId);\n  }catch(e){}\n}\nfunction persistActive(){\n  const p=activeProfile(); if(!p||lockMode) return;\n  p.updatedAt=nowTs();\n  saveProfiles();\n}\n\n/* 인덱스 배열 정리(범위·정수·중복 제거) */\nfunction cleanIdx(arr,max){\n  if(!Array.isArray(arr)) return [];\n  const s=new Set();\n  arr.forEach(n=>{ n=parseInt(n,10); if(Number.isInteger(n)&&n>=0&&n<max) s.add(n); });\n  return [...s].sort((a,b)=>a-b);\n}\nfunction sanitizeProfile(raw){\n  if(!raw||typeof raw!=='object') return null;\n  const p=newProfile(typeof raw.name==='string'? raw.name.slice(0,20) : '아이');\n  p.cho=cleanIdx(raw.cho,19);\n  p.jung=cleanIdx(raw.jung,21);\n  p.jong=cleanIdx(raw.jong,28);\n  if(!p.jong.includes(0)) p.jong.unshift(0);\n  if(!p.cho.length) p.cho=DEFAULT_CHO.slice();\n  if(!p.jung.length) p.jung=DEFAULT_JUNG.slice();\n  return p;\n}\n\n/* 최초 로드 + 구버전 마이그레이션 */\n(function loadProfiles(){\n  try{\n    const rawP=JSON.parse(localStorage.getItem(PROFILES_KEY)||'null');\n    if(Array.isArray(rawP)&&rawP.length){\n      profiles=rawP.map(sanitizeProfile).filter(Boolean);\n      activeId=localStorage.getItem(ACTIVE_KEY)||profiles[0].id;\n      if(!profiles.some(p=>p.id===activeId)) activeId=profiles[0].id;\n      return;\n    }\n  }catch(e){}\n  // 구버전 진도 마이그레이션 (syllable-progress-v1: {v:[표시글자], c:[자음]})\n  let migrated=null;\n  try{\n    const old=JSON.parse(localStorage.getItem(OLD_KEY)||'null');\n    if(old && (Array.isArray(old.v)||Array.isArray(old.c))){\n      const vMap={'아':0,'애':1,'야':2,'어':4,'에':5,'여':6,'오':8,'요':12,'우':13,'유':17,'으':18,'이':20};\n      const jung=[]; (old.v||[]).forEach(ch=>{ if(ch in vMap) jung.push(vMap[ch]); });\n      const cho=[11]; (old.c||[]).forEach(ch=>{ const i=CHO.indexOf(ch); if(i>=0) cho.push(i); }); // ㅇ 포함\n      migrated=newProfile('기본');\n      migrated.cho=cleanIdx(cho,19);\n      migrated.jung=jung.length?cleanIdx(jung,21):DEFAULT_JUNG.slice();\n      migrated.jong=[0];\n    }\n  }catch(e){}\n  profiles=[ migrated || newProfile('기본') ];\n  activeId=profiles[0].id;\n  saveProfiles();\n})();\n\n/* =========================================================\n   온라인 사전 판별 (설계 5-C: 오류를 미등재로 오판하지 않기)\n   반환: true(등재) / false(미등재) / null(확인 실패 — 캐시 안 함)\n   ========================================================= */\nlet lookupCache={};\n(function loadCache(){\n  try{\n    lookupCache=JSON.parse(localStorage.getItem(CACHE_STORE)||'{}');\n    for(const w in lookupCache){ if(lookupCache[w]) REAL_SET.add(w); }\n  }catch(e){ lookupCache={}; }\n})();\nfunction saveCache(){ try{ localStorage.setItem(CACHE_STORE, JSON.stringify(lookupCache)); }catch(e){} }\n\nlet lookupAbort=null;\nasync function lookupOnline(word){\n  if(word in lookupCache) return lookupCache[word];\n  if(lookupAbort) lookupAbort.abort();\n  const ctl=new AbortController(); lookupAbort=ctl;\n  const to=setTimeout(()=>ctl.abort(), 6000);\n  try{\n    const r=await fetch(DICT_PROXY+'/?q='+encodeURIComponent(word.normalize('NFC')), {signal:ctl.signal});\n    clearTimeout(to);\n    if(!r.ok) return null;                                  // HTTP 오류 → 확인 실패\n    const ct=(r.headers.get('Content-Type')||'').toLowerCase();\n    const t=await r.text();\n    if(ct.includes('json')){                                // Worker가 명시적 오류(JSON) 반환\n      try{ const j=JSON.parse(t); if(j&&typeof j.found==='boolean'){ lookupCache[word]=j.found; if(j.found) REAL_SET.add(word); saveCache(); return j.found; } }catch(e){}\n      return null;\n    }\n    const xml=new DOMParser().parseFromString(t,'text/xml');\n    if(xml.querySelector('parsererror')) return null;       // XML 파싱 실패 → 확인 실패\n    if(xml.querySelector('error')) return null;             // API 오류 → 캐시 안 함\n    const heads=[...xml.getElementsByTagName('word')].map(n=>n.textContent.replace(/[-\\s]/g,''));\n    const found=heads.includes(word);\n    lookupCache[word]=found;                                // 정상 응답만 캐시\n    if(found) REAL_SET.add(word);\n    saveCache();\n    return found;\n  }catch(e){ clearTimeout(to); return null; }               // 네트워크/타임아웃 → 확인 실패\n}\n\n/* =========================================================\n   음소 → 조합 유틸\n   ========================================================= */\nfunction syllableAllowed(ch){\n  const d=decompose(ch); if(!d) return false;\n  return enabledSet('cho').has(d.ci) && enabledSet('jung').has(d.mi) && enabledSet('jong').has(d.ji);\n}\nfunction wordAllowed(word){\n  for(const ch of word){ if(!syllableAllowed(ch)) return false; }\n  return true;\n}\n/* 현재 프로필로 조합 가능한 음절 풀 (받침옵션: 'none'|'only'|'mix') */\nfunction syllablePool(batchim){\n  const cho=enabled('cho'), jung=enabled('jung');\n  let jong=enabled('jong');\n  if(batchim==='none') jong=[0];\n  else if(batchim==='only') jong=jong.filter(j=>j!==0);\n  const out=[];\n  cho.forEach(ci=>jung.forEach(mi=>jong.forEach(ji=>out.push(composeSyl(ci,mi,ji)))));\n  return out;\n}\n/* 진도 미리보기/게임용 대표 음절 집합 */\nfunction activeSyllables(){\n  const all=syllablePool('mix');\n  return { all };\n}\n\n/* =========================================================\n   모드 전환\n   ========================================================= */\nfunction switchMode(m){\n  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('on'));\n  document.querySelectorAll('.modeswitch button').forEach(b=>b.classList.remove('on'));\n  if(m!=='game') stopRain();\n  if(m==='play'){ playPanel.classList.add('on'); tabPlay.classList.add('on'); renderZones(); renderBoard(); }\n  if(m==='game'){ gamePanel.classList.add('on'); tabGame.classList.add('on'); startGameTab(); }\n  if(m==='gen'){ genPanel.classList.add('on'); tabGen.classList.add('on'); }\n  if(m==='prog'){ progPanel.classList.add('on'); tabProg.classList.add('on'); renderProgress(); }\n}\n\n/* =========================================================\n   진도 설정 화면\n   ========================================================= */\nfunction renderProgress(){\n  renderProfileSelect();\n  renderProgGrids();\n  renderActiveSyls();\n}\nfunction renderProfileSelect(){\n  const sel=document.getElementById('profileSelect');\n  sel.innerHTML='';\n  profiles.forEach(p=>{\n    const o=document.createElement('option');\n    o.value=p.id; o.textContent=p.name;   // textContent (XSS 방지)\n    if(p.id===activeId) o.selected=true;\n    sel.appendChild(o);\n  });\n}\nfunction seriesGrid(kind, groups, charFn){\n  const set=enabledSet(kind);\n  const wrap=document.createElement('div');\n  wrap.className='prog-series';\n  const total=enabled(kind).filter(i=>!(kind==='jong'&&i===0)).length;\n  const cap=kind==='cho'?19:kind==='jung'?21:27;\n  const head=document.createElement('div');\n  head.className='series-head';\n  const title=kind==='cho'?'초성':kind==='jung'?'중성':'종성';\n  head.innerHTML='<span class=\"series-title\">'+title+'</span><span class=\"series-count\">'+total+' / '+cap+' 선택</span>';\n  const allBtn=document.createElement('button'); allBtn.className='mini-btn'; allBtn.textContent='모두';\n  allBtn.onclick=()=>setAllSeries(kind,true);\n  const noneBtn=document.createElement('button'); noneBtn.className='mini-btn'; noneBtn.textContent='해제';\n  noneBtn.onclick=()=>setAllSeries(kind,false);\n  head.appendChild(allBtn); head.appendChild(noneBtn);\n  wrap.appendChild(head);\n  groups.forEach(g=>{\n    const lbl=document.createElement('div'); lbl.className='pg-grouplabel'; lbl.textContent=g.label;\n    wrap.appendChild(lbl);\n    const grid=document.createElement('div'); grid.className='pg-grid';\n    g.idx.forEach(i=>{\n      const t=document.createElement('div');\n      const isFixed=g.fixed;\n      t.className='pg-tile'+(set.has(i)?' on':'')+(isFixed?' fixed':'');\n      t.textContent=charFn(i)||'∅';\n      if(!isFixed) t.onclick=()=>togglePhoneme(kind,i);\n      grid.appendChild(t);\n    });\n    wrap.appendChild(grid);\n  });\n  return wrap;\n}\nfunction renderProgGrids(){\n  const box=document.getElementById('progGrids');\n  box.innerHTML='';\n  box.appendChild(seriesGrid('cho',CHO_GROUPS,i=>CHO[i]));\n  box.appendChild(seriesGrid('jung',JUNG_GROUPS,i=>JUNG[i]));\n  box.appendChild(seriesGrid('jong',JONG_GROUPS,i=>JONG[i]));\n}\nfunction togglePhoneme(kind,i){\n  const p=activeProfile(); if(!p) return;\n  const arr=p[kind]; const pos=arr.indexOf(i);\n  if(pos>=0){ if(kind==='jong'&&i===0) return; arr.splice(pos,1); }\n  else arr.push(i);\n  arr.sort((a,b)=>a-b);\n  persistActive();\n  renderProgGrids(); renderActiveSyls();\n}\nfunction setAllSeries(kind,val){\n  const p=activeProfile(); if(!p) return;\n  if(val){\n    const groups = kind==='cho'?CHO_GROUPS : kind==='jung'?JUNG_GROUPS : JONG_GROUPS;\n    const all=[]; groups.forEach(g=>g.idx.forEach(i=>all.push(i)));\n    p[kind]=[...new Set(all)].sort((a,b)=>a-b);\n  }else{\n    p[kind] = kind==='jong' ? [0] : [];\n  }\n  persistActive();\n  renderProgGrids(); renderActiveSyls();\n}\nfunction renderActiveSyls(){\n  const box=document.getElementById('activeSyls');\n  const pool=syllablePool('mix');\n  box.innerHTML='';\n  if(!pool.length){ box.innerHTML='<span class=\"empty\">초성·중성을 켜면 글자가 만들어져요.</span>'; return; }\n  const show=shuffle(pool).slice(0,40);\n  show.forEach(s=>{ const c=document.createElement('span'); c.className='chip'; c.textContent=s; box.appendChild(c); });\n  if(pool.length>40){ const m=document.createElement('span'); m.className='empty'; m.textContent=' …외 '+(pool.length-40)+'개'; box.appendChild(m); }\n}\n\n/* ---- 프로필 CRUD ---- */\nfunction switchProfile(id){ activeId=id; saveProfiles(); renderProgress(); renderZones(); renderBoard(); }\nfunction addProfile(){\n  openNameModal('새 프로필 이름', '', name=>{\n    const p=newProfile(name||'아이'); profiles.push(p); activeId=p.id; saveProfiles(); renderProgress();\n  });\n}\nfunction renameProfile(){\n  const p=activeProfile(); if(!p) return;\n  openNameModal('이름 변경', p.name, name=>{ p.name=(name||p.name).slice(0,20); persistActive(); renderProfileSelect(); });\n}\nfunction deleteProfile(){\n  if(profiles.length<=1){ openInfo('삭제 불가','프로필이 하나뿐이라 삭제할 수 없어요. 새 프로필을 먼저 만들어 주세요.'); return; }\n  const p=activeProfile(); if(!p) return;\n  openConfirm('프로필 삭제', '“'+p.name+'” 프로필을 삭제할까요? 되돌릴 수 없어요.', ()=>{\n    profiles=profiles.filter(x=>x.id!==p.id); activeId=profiles[0].id; saveProfiles(); renderProgress();\n  });\n}\nfunction exportProfiles(){\n  const data=JSON.stringify({app:'hangul-blending-board', v:1, exportedAt:nowTs(), profiles}, null, 2);\n  const blob=new Blob([data],{type:'application/json'});\n  const url=URL.createObjectURL(blob);\n  const a=document.createElement('a'); a.href=url; a.download='한글놀이_프로필.json'; a.click();\n  setTimeout(()=>URL.revokeObjectURL(url),1000);\n}\nfunction importProfiles(file){\n  if(!file) return;\n  if(file.size>1024*1024){ openInfo('가져오기 실패','파일이 너무 커요(1MB 초과).'); return; }\n  const rd=new FileReader();\n  rd.onload=()=>{\n    try{\n      const obj=JSON.parse(rd.result);\n      const list=Array.isArray(obj)?obj:(obj&&Array.isArray(obj.profiles)?obj.profiles:null);\n      if(!list||!list.length) throw 0;\n      const existing=new Set(profiles.map(p=>p.id));\n      let added=0;\n      list.forEach(raw=>{\n        const p=sanitizeProfile(raw); if(!p) return;\n        if(existing.has(p.id)) p.id=uid();      // id 충돌 → 새 UUID\n        existing.add(p.id); profiles.push(p); added++;\n      });\n      if(added){ saveProfiles(); renderProgress(); openInfo('가져오기 완료', added+'개 프로필을 불러왔어요.'); }\n      else openInfo('가져오기 실패','유효한 프로필이 없어요.');\n    }catch(e){ openInfo('가져오기 실패','파일 형식을 읽을 수 없어요. 내보낸 JSON 파일인지 확인해 주세요.'); }\n  };\n  rd.readAsText(file);\n  document.getElementById('importFile').value='';\n}\n\n/* =========================================================\n   놀이 — 블렌딩 보드\n   상태: syllables[{cho,jung,jong}] + activeIndex (설계 6-D)\n   ========================================================= */\nlet syllables=[{cho:null,jung:null,jong:0}];\nlet activeIndex=0;\nlet verdictTimer=null;\n\nfunction syllChar(s){\n  if(s.cho!=null && s.jung!=null) return composeSyl(s.cho,s.jung,s.jong||0);\n  if(s.cho!=null) return CHO[s.cho];\n  if(s.jung!=null) return JUNG[s.jung];\n  if(s.jong) return JONG[s.jong];\n  return '';\n}\nfunction renderZones(){\n  const mk=(box,kind,cls,charFn,onclick)=>{\n    const el=document.getElementById(box); el.innerHTML='';\n    const list=enabled(kind);\n    if(!list.length || (kind==='jong' && list.filter(i=>i!==0).length===0 && kind==='jong')){\n      // 종성은 받침없음만 있으면 안내(선택 불필요)\n    }\n    if(kind==='jong'){\n      list.forEach(i=>{\n        const t=document.createElement('div');\n        t.className='jamo-tile '+cls; t.textContent = i===0?'∅':JONG[i];\n        t.onclick=()=>onclick(i); el.appendChild(t);\n      });\n      return;\n    }\n    if(!list.length){ el.innerHTML='<span class=\"zone-empty\">진도에서 '+(kind==='cho'?'초성':'중성')+'을 켜주세요.</span>'; return; }\n    list.forEach(i=>{\n      const t=document.createElement('div');\n      t.className='jamo-tile '+cls; t.textContent=charFn(i);\n      t.onclick=()=>onclick(i); el.appendChild(t);\n    });\n  };\n  mk('zoneCho','cho','cho',i=>CHO[i],setCho);\n  mk('zoneJung','jung','jung',i=>JUNG[i],setJung);\n  mk('zoneJong','jong','jong',i=>JONG[i],setJong);\n  markSelectedTiles();\n}\nfunction markSelectedTiles(){\n  const s=syllables[activeIndex]||{};\n  const mark=(box,kind,val)=>{\n    const el=document.getElementById(box); if(!el) return;\n    const list=enabled(kind);\n    [...el.children].forEach((t,n)=>{\n      const idx=list[n];\n      t.classList.toggle('sel', kind==='jong' ? (val? idx===val : idx===0 && (s.jong||0)===0 && false) : idx===val);\n    });\n  };\n  mark('zoneCho','cho',s.cho);\n  mark('zoneJung','jung',s.jung);\n  // 종성: 선택된 받침 강조(받침없음 ∅도 선택시 표시)\n  const jel=document.getElementById('zoneJong');\n  if(jel){ const list=enabled('jong'); [...jel.children].forEach((t,n)=>{ t.classList.toggle('sel', list[n]===(s.jong||0)); }); }\n}\nfunction setCho(i){ const s=syllables[activeIndex]; s.cho = (s.cho===i?null:i); afterEdit(true); }\nfunction setJung(i){ const s=syllables[activeIndex]; s.jung = (s.jung===i?null:i); afterEdit(true); }\nfunction setJong(i){ const s=syllables[activeIndex]; s.jong = ((s.jong||0)===i?0:i); afterEdit(true); }\n\nfunction afterEdit(pop){\n  renderBoard(pop); markSelectedTiles();\n  // 판별(의미/무의미 사전 조회)은 하지 않는다 — 읽기·타자 연습용\n  if(verdictTimer) clearTimeout(verdictTimer);\n  const v=document.getElementById('verdict'); v.textContent=''; v.className='verdict';\n}\n\nfunction renderBoard(pop){\n  const board=document.getElementById('board');\n  board.innerHTML='';\n  const anyContent=syllables.some(s=>s.cho!=null||s.jung!=null||s.jong);\n  if(!anyContent){ board.innerHTML='<span class=\"placeholder\">아래 자모를 눌러보세요</span>'; updateNextBtn(); return; }\n  syllables.forEach((s,i)=>{\n    const box=document.createElement('div');\n    box.className='syl-box '+(i===activeIndex?'active':'locked')+(pop&&i===activeIndex?' pop':'');\n    box.textContent=syllChar(s)||'·';\n    box.onclick=()=>{ activeIndex=i; renderBoard(); markSelectedTiles(); };\n    board.appendChild(box);\n  });\n  updateNextBtn();\n}\nfunction updateNextBtn(){\n  const s=syllables[activeIndex];\n  const canNext = activeIndex===syllables.length-1 && s && s.cho!=null && s.jung!=null && syllables.length<3;\n  document.getElementById('nextBtn').disabled=!canNext;\n}\nfunction nextSyl(){\n  const s=syllables[activeIndex];\n  if(!(activeIndex===syllables.length-1 && s.cho!=null && s.jung!=null && syllables.length<3)) return;\n  syllables.push({cho:null,jung:null,jong:0}); activeIndex=syllables.length-1;\n  renderBoard(true); markSelectedTiles();\n}\nfunction delLast(){\n  const s=syllables[activeIndex];\n  if(s.jong){ s.jong=0; }\n  else if(s.jung!=null){ s.jung=null; }\n  else if(s.cho!=null){ s.cho=null; }\n  else if(activeIndex>0){ syllables.splice(activeIndex,1); activeIndex--; }\n  afterEdit(false);\n}\nfunction clearBoard(){ syllables=[{cho:null,jung:null,jong:0}]; activeIndex=0; afterEdit(false); }\n\nfunction assembledWord(){\n  // 모든 음절이 완성(초성+중성)일 때만 단어로 취급\n  if(!syllables.length) return '';\n  for(const s of syllables){ if(s.cho==null||s.jung==null) return ''; }\n  return syllables.map(s=>composeSyl(s.cho,s.jung,s.jong||0)).join('');\n}\nfunction scheduleVerdict(){\n  if(verdictTimer) clearTimeout(verdictTimer);\n  const v=document.getElementById('verdict');\n  const word=assembledWord();\n  if(!word){ v.textContent=''; v.className='verdict'; return; }\n  if(REAL_SET.has(word)){ v.textContent='✅ 뜻이 있는 단어예요! “'+word+'”'; v.className='verdict real'; return; }\n  if(word in lookupCache){\n    v.textContent = lookupCache[word] ? '✅ 뜻이 있는 단어예요! “'+word+'”' : '🔶 소리단어(뜻은 없어요) “'+word+'”';\n    v.className='verdict '+(lookupCache[word]?'real':'nonsense'); return;\n  }\n  v.textContent='🔎 사전에서 찾는 중… “'+word+'”'; v.className='verdict checking';\n  verdictTimer=setTimeout(()=>{\n    lookupOnline(word).then(found=>{\n      if(assembledWord()!==word) return;\n      if(found===true){ v.textContent='✅ 뜻이 있는 단어예요! “'+word+'” (사전)'; v.className='verdict real'; }\n      else if(found===false){ v.textContent='🔶 소리단어(뜻은 없어요) “'+word+'”'; v.className='verdict nonsense'; }\n      else { v.textContent='📴 지금은 사전 확인이 어려워요 “'+word+'”'; v.className='verdict checking'; }\n    });\n  }, 450);\n}\nfunction randomWord(n){\n  const pool=syllablePool('mix');\n  if(!pool.length) return;\n  n = (n===1||n===2||n===3) ? n : (Math.random()<0.5?2:3);\n  syllables=[];\n  for(let i=0;i<n;i++){ const ch=pool[Math.floor(Math.random()*pool.length)]; const d=decompose(ch); syllables.push({cho:d.ci,jung:d.mi,jong:d.ji}); }\n  activeIndex=syllables.length-1;\n  renderBoard(true); markSelectedTiles();\n  // 랜덤 단어는 사전 판별(의미/무의미 조회)을 하지 않는다 — 읽기·타자 연습용 글자만 제시\n  if(verdictTimer) clearTimeout(verdictTimer);\n  const v=document.getElementById('verdict'); v.textContent=''; v.className='verdict';\n}\nlet collected=[];\nfunction saveWord(){\n  const word=assembledWord();\n  if(!word) return;\n  if(collected.some(c=>c.word===word)){ flashSaved(); return; }\n  collected.unshift({word, real:REAL_SET.has(word)||lookupCache[word]===true});\n  renderCollected(); flashSaved();\n}\nfunction flashSaved(){\n  const v=document.getElementById('verdict');\n  v.textContent='⭐ 담았어요!'; v.className='verdict real';\n  setTimeout(()=>{ v.textContent=''; v.className='verdict'; }, 700);\n}\nfunction renderCollected(){\n  const box=document.getElementById('collected');\n  const cnt=document.getElementById('collectedCount');\n  if(!collected.length){ box.innerHTML='<span class=\"empty\">아직 담은 단어가 없어요.</span>'; cnt.textContent=''; return; }\n  cnt.textContent='('+collected.length+'개)';\n  box.innerHTML='';\n  collected.forEach(c=>{ const chip=document.createElement('span'); chip.className='chip '+(c.real?'real':'nonsense'); chip.textContent=c.word; box.appendChild(chip); });\n}\nfunction collectedToHandwriting(){\n  if(!collected.length){ openInfo('안내','먼저 단어를 담아주세요.'); return; }\n  openHandwriting(collected.map(c=>c.word));\n}\n\n/* =========================================================\n   자료 만들기\n   ========================================================= */\nfunction sylCount(word){ return [...word].filter(ch=>decompose(ch)).length; }\nfunction hasBatchim(word){ return [...word].some(ch=>{ const d=decompose(ch); return d && d.ji!==0; }); }\n\nfunction genRealWords(syll,batchim,count){\n  let pool=[];\n  ['noun','verb','adv','pron'].forEach(p=>{\n    const b=lexBucket(p);\n    for(const k in b){ if(syll!=0 && String(syll)!==k) continue; pool.push(...b[k]); }\n  });\n  pool=[...new Set(pool)].filter(wordAllowed).filter(w=>batchimMatch(w,batchim));\n  return shuffle(pool).slice(0,count).map(w=>({text:w,type:'real'}));\n}\nfunction batchimMatch(word,batchim){\n  if(batchim==='none') return !hasBatchim(word);\n  if(batchim==='only') return hasBatchim(word);\n  return true;\n}\nfunction genNonsense(syll,batchim,count){\n  const one=syllablePool(batchim==='mix'?'mix':batchim);\n  if(!one.length) return [];\n  const out=[]; const seen=new Set(); let guard=0;\n  while(out.length<count && guard<count*500){\n    guard++;\n    const n = syll!=0 ? Number(syll) : (Math.random()<0.5?2:3);\n    let w=''; for(let i=0;i<n;i++) w+=one[Math.floor(Math.random()*one.length)];\n    if(seen.has(w)||REAL_SET.has(w)) continue;\n    seen.add(w); out.push({text:w,type:'nonsense'});\n  }\n  return out;\n}\nfunction genSentences(len,count){\n  let pool=[];\n  const keys = len!=0 ? [String(len)] : ['2','3','4'];\n  keys.forEach(k=>{ (SENTENCES[k]||[]).forEach(s=>{ if(wordAllowed(s.replace(/[.,?!\\s]/g,''))) pool.push(s); }); });\n  pool=[...new Set(pool)];\n  return shuffle(pool).slice(0,count).map(s=>({text:s,type:'sentence'}));\n}\n\ndocument.getElementById('genType').addEventListener('change',e=>{\n  const t=e.target.value;\n  document.getElementById('syllField').style.display = (t==='real'||t==='nonsense')?'':'none';\n  document.getElementById('batchimField').style.display = (t==='real'||t==='nonsense')?'':'none';\n  document.getElementById('lenField').style.display = (t==='sentence')?'':'none';\n});\n\nfunction generate(){\n  const type=document.getElementById('genType').value;\n  const syll=document.getElementById('genSyll').value;\n  const batchim=document.getElementById('genBatchim').value;\n  const len=document.getElementById('genLen').value;\n  let count=parseInt(document.getElementById('genCount').value)||20;\n  count=Math.max(1,Math.min(100,count));\n\n  let items=[], head='';\n  if(type==='real'){ items=genRealWords(syll,batchim,count); head='📋 의미 단어'; }\n  else if(type==='nonsense'){ items=genNonsense(syll,batchim,count); head='📋 무의미 단어'; }\n  else { items=genSentences(len,count); head='📋 문장'; }\n  renderResult(items,head);\n}\nlet lastResult=[];\nfunction renderResult(items,head){\n  document.getElementById('resultHead').textContent=head+' ('+items.length+'개)';\n  document.getElementById('printTitle').textContent=head.replace('📋 ','')+' 연습';\n  const list=document.getElementById('resultList');\n  if(!items.length){ list.innerHTML='<div class=\"result-empty\">조건에 맞는 항목이 부족해요. 진도를 더 켜거나 조건을 바꿔보세요.</div>'; lastResult=[]; return; }\n  list.innerHTML='';\n  const tagName={real:'의미',nonsense:'무의미',sentence:'문장'};\n  items.forEach((it,i)=>{\n    const row=document.createElement('div'); row.className='result-item';\n    const idx=document.createElement('span'); idx.className='idx'; idx.textContent=(i+1);\n    const txt=document.createElement('span'); txt.textContent=it.text;      // textContent (XSS 방지)\n    const tag=document.createElement('span'); tag.className='tag '+(it.type==='sentence'?'sent':it.type); tag.textContent=tagName[it.type];\n    row.appendChild(idx); row.appendChild(txt); row.appendChild(tag);\n    list.appendChild(row);\n  });\n  lastResult=items.map(it=>it.text);\n}\nfunction copyResult(){\n  if(!lastResult.length) return;\n  navigator.clipboard.writeText(lastResult.join('\\n')).then(()=>{\n    const b=event.target; const o=b.textContent; b.textContent='✅ 복사됨'; setTimeout(()=>b.textContent=o,1200);\n  });\n}\nfunction resultToHandwriting(){\n  if(!lastResult.length){ openInfo('안내','먼저 자료를 생성해 주세요.'); return; }\n  openHandwriting(lastResult);\n}\nfunction openHandwriting(words){\n  // 문장부호 제거, 낱말만 — 글씨연습장 words 파라미터로 전달\n  const clean=words.map(w=>w.replace(/[.,?!]/g,'').trim()).filter(Boolean).slice(0,60);\n  const url='https://sososoop.github.io/korean-handwriting/?words='+encodeURIComponent(clean.join(','));\n  window.open(url,'_blank');\n}\n\n/* =========================================================\n   가정과제 잠금 링크 (#hw=)  — 68비트 비트마스크(설계 2-B)\n   ========================================================= */\nfunction bytesToB64url(bytes){ let bin=''; bytes.forEach(b=>bin+=String.fromCharCode(b)); return btoa(bin).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,''); }\nfunction b64urlToBytes(s){ s=s.replace(/-/g,'+').replace(/_/g,'/'); while(s.length%4)s+='='; const bin=atob(s); const out=new Uint8Array(bin.length); for(let i=0;i<bin.length;i++)out[i]=bin.charCodeAt(i); return out; }\nfunction encodeHw(cho,jung,jong){\n  const bits=new Uint8Array(9);\n  const set=off=>{ bits[off>>3] |= (0x80 >> (off&7)); };\n  cho.forEach(i=>set(i));            // 0..18\n  jung.forEach(i=>set(19+i));        // 19..39\n  jong.forEach(i=>set(40+i));        // 40..67\n  return '1'+bytesToB64url(bits);\n}\nfunction decodeHw(str){\n  if(str[0]!=='1') return null;\n  const bytes=b64urlToBytes(str.slice(1));\n  if(bytes.length<9) return null;\n  const get=off=>!!(bytes[off>>3] & (0x80 >> (off&7)));\n  const cho=[],jung=[],jong=[];\n  for(let i=0;i<19;i++) if(get(i)) cho.push(i);\n  for(let i=0;i<21;i++) if(get(19+i)) jung.push(i);\n  for(let i=0;i<28;i++) if(get(40+i)) jong.push(i);\n  if(!jong.includes(0)) jong.unshift(0);\n  return {cho,jung,jong};\n}\nfunction makeHwLink(){\n  const p=activeProfile(); if(!p) return;\n  const code=encodeHw(p.cho,p.jung,p.jong);\n  const base=location.origin+location.pathname;\n  const url=base+'#hw='+code;\n  openLinkModal('🏠 가정과제 링크', '아래 링크를 보호자에게 보내세요. 링크로 들어가면 <b>이 진도 그대로 잠금</b>되어 집에서 같은 범위로 연습할 수 있어요. (진도 변경 불가·아동 이름 미포함)', url);\n}\nfunction applyLockModeIfNeeded(){\n  const h=location.hash||'';\n  const m=h.match(/hw=([^&]+)/);\n  if(!m) return false;\n  const dec=decodeHw(decodeURIComponent(m[1]));\n  if(!dec || (!dec.cho.length && !dec.jung.length)){\n    document.body.innerHTML='<div style=\"max-width:420px;margin:80px auto;padding:24px;text-align:center;font-family:sans-serif\"><h2>링크가 손상되었어요 😢</h2><p style=\"font-size:15px;color:#555\">선생님께 가정과제 링크를 다시 받아주세요.</p></div>';\n    return true;\n  }\n  // 단어 리스트(선택): 한글 화이트리스트 + textContent 렌더\n  let words=[];\n  const wm=h.match(/[&]w=([^&]+)/);\n  if(wm){ words=decodeURIComponent(wm[1]).split(',').map(w=>w.replace(/[^가-힣]/g,'')).filter(Boolean).slice(0,30); }\n  lockMode=true;\n  lockProfile={ v:1, id:'hw', name:'오늘의 연습', cho:dec.cho, jung:dec.jung, jong:dec.jong, hwWords:words };\n  // UI: 진도/게임/자료 탭 숨김, 놀이만\n  document.getElementById('hwBadge').style.display='inline-block';\n  ['tabProg','tabGame','tabGen','manualLink'].forEach(id=>{ const el=document.getElementById(id); if(el) el.style.display='none'; });\n  switchMode('play');\n  if(words.length){ collected=words.map(w=>({word:w, real:REAL_SET.has(w)})); renderCollected(); }\n  return true;\n}\n\n/* =========================================================\n   모달 (커스텀 — 브라우저 alert/prompt 대체)\n   ========================================================= */\nlet nameCb=null, confirmCb=null;\nfunction openNameModal(title,val,cb){\n  document.getElementById('nameModalTitle').textContent=title;\n  const inp=document.getElementById('nameModalInput'); inp.value=val||'';\n  nameCb=cb;\n  document.getElementById('nameModal').classList.add('on');\n  setTimeout(()=>inp.focus(),50);\n}\nfunction closeNameModal(){ document.getElementById('nameModal').classList.remove('on'); nameCb=null; }\ndocument.getElementById('nameModalOk').onclick=()=>{ const v=document.getElementById('nameModalInput').value.trim(); const cb=nameCb; closeNameModal(); if(cb) cb(v); };\ndocument.getElementById('nameModalInput').addEventListener('keydown',e=>{ if(e.key==='Enter') document.getElementById('nameModalOk').click(); });\n\nfunction openInfo(title,msg){\n  document.getElementById('infoModalTitle').textContent=title;\n  document.getElementById('infoModalMsg').innerHTML=msg;\n  document.getElementById('infoModalInput').style.display='none';\n  document.getElementById('infoModalAction').style.display='none';\n  document.getElementById('infoModal').classList.add('on');\n}\nfunction openConfirm(title,msg,cb){\n  document.getElementById('infoModalTitle').textContent=title;\n  document.getElementById('infoModalMsg').innerHTML=msg;\n  document.getElementById('infoModalInput').style.display='none';\n  const act=document.getElementById('infoModalAction');\n  act.style.display=''; act.textContent='삭제'; act.className='warn';\n  act.onclick=()=>{ closeInfoModal(); if(cb) cb(); };\n  document.getElementById('infoModal').classList.add('on');\n}\nfunction openLinkModal(title,msg,url){\n  document.getElementById('infoModalTitle').textContent=title;\n  document.getElementById('infoModalMsg').innerHTML=msg;\n  const inp=document.getElementById('infoModalInput'); inp.style.display=''; inp.value=url;\n  const act=document.getElementById('infoModalAction');\n  act.style.display=''; act.textContent='📋 복사'; act.className='ok';\n  act.onclick=()=>{ navigator.clipboard.writeText(url).then(()=>{ act.textContent='✅ 복사됨'; setTimeout(()=>act.textContent='📋 복사',1200); }); };\n  document.getElementById('infoModal').classList.add('on');\n}\nfunction closeInfoModal(){ document.getElementById('infoModal').classList.remove('on'); }\n\n/* =========================================================\n   게임 (벽돌깨기 + 글자잡기) — 소재를 새 음소 진도에 재연결\n   ========================================================= */\nlet gScore=0, gCombo=0, gStage=0, gDiff='syl', gBricks=[];\nlet currentGame='brick';\nconst BRICK_COLORS=['--lime','--cho','--sent','--real','--lime-soft'];\nlet rainItems=[], rainRAF=null, rainActive=false, rainLives=3, lastSpawn=0, rainPaused=false;\nconst RAIN_SPEEDS={1:0.35, 2:0.5, 3:0.7};   // 1단계 느림 ~ 3단계 빠름(기존 속도)\nlet rainSpeedLevel=1;                         // 기본 1단계(느림)\nconst RAIN_SPAWN_MS=2500, RAIN_MAX=5;\nconst IS_TOUCH = !!(window.matchMedia && window.matchMedia('(hover: none) and (pointer: coarse)').matches); // 모바일/태블릿=터치로 글자잡기\nlet audioCtx=null, soundOn=true;\nlet rainBest={syl:0, word2:0, word3:0};\n(function loadRainBest(){ try{ const s=JSON.parse(localStorage.getItem(RAIN_BEST_KEY)||'null'); if(s) rainBest=Object.assign(rainBest,s); }catch(e){} })();\nfunction saveRainBest(){ try{ localStorage.setItem(RAIN_BEST_KEY, JSON.stringify(rainBest)); }catch(e){} }\nfunction currentBest(){ return rainBest[gDiff]||0; }\nfunction renderBest(){ const el=document.getElementById('gBest'); if(el) el.textContent=currentBest(); }\n\nfunction setDiff(d){ gDiff=d; document.querySelectorAll('[data-diff]').forEach(b=>b.classList.toggle('on', b.dataset.diff===d)); restartGame(); }\nfunction setRainSpeed(lv){ rainSpeedLevel=lv; document.querySelectorAll('#rainSpeedRow .seg-btn').forEach(b=>b.classList.toggle('on', +b.dataset.spd===lv)); restartGame(); }\nfunction nSylWords(n){\n  const out=[];\n  ['noun','verb','adv','pron','interj'].forEach(p=>{ const b=LEXICON[p]; if(!b) return; (b[n]||[]).forEach(w=>{ if(wordAllowed(w)) out.push(w); }); });\n  return [...new Set(out)];\n}\nfunction nSylCombos(n){\n  const pool=[...new Set(syllablePool('mix'))];\n  if(!pool.length) return [];\n  const out=new Set(); let guard=0;\n  const target=Math.min(40, Math.max(12, Math.round(Math.pow(pool.length,n))));\n  while(out.size<target && guard<target*30){\n    let w=''; for(let k=0;k<n;k++) w+=pool[Math.floor(Math.random()*pool.length)];\n    out.add(w); guard++;\n  }\n  return [...out];\n}\nfunction currentDiffItems(){\n  if(gDiff==='word2'){ const items=[...new Set([...nSylWords(2).filter(w=>w.length===2), ...nSylCombos(2)])]; if(items.length) return items; }\n  if(gDiff==='word3'){ const items=[...new Set([...nSylWords(3).filter(w=>w.length===3), ...nSylCombos(3)])]; if(items.length) return items; }\n  return [...new Set(syllablePool('mix'))];\n}\nfunction diffPoints(){ return gDiff==='word3'?3 : gDiff==='word2'?2 : 1; }\nfunction stageItems(){ return shuffle(currentDiffItems()).slice(0,12); }\nfunction newStage(){\n  const grid=document.getElementById('brickGrid'); const msg=document.getElementById('gameMsg');\n  if(!grid) return;\n  const items=stageItems();\n  gBricks=[]; grid.innerHTML='';\n  if(!items.length){ msg.textContent='⚙️ 진도에서 음소를 먼저 켜주세요!'; return; }\n  msg.textContent='';\n  items.forEach((t,i)=>{\n    const el=document.createElement('div'); el.className='brick';\n    const cv=BRICK_COLORS[i%BRICK_COLORS.length]; el.style.background='var('+cv+')'; el.textContent=t;\n    grid.appendChild(el); gBricks.push({text:t, el, broken:false, colorVar:cv});\n  });\n  gCombo=0; renderGStats(); requestAnimationFrame(parkBall);\n  const gi=document.getElementById('gameInput'); if(gi){ gi.value=''; gi.focus(); }\n}\nfunction renderGStats(){\n  document.getElementById('gScore').textContent=gScore;\n  document.getElementById('gCombo').textContent=gCombo;\n  document.getElementById('gStage').textContent = currentGame==='rain' ? rainLives : gStage;\n}\nfunction parkBall(){\n  const arena=document.getElementById('gameArena'), ball=document.getElementById('gameBall');\n  if(!arena||!ball) return;\n  const w=arena.clientWidth, h=arena.clientHeight;\n  ball.style.transition='none'; ball.style.transform='translate('+(w/2-9)+'px,'+(h-34)+'px)';\n}\nfunction flyBall(brickEl, cb){\n  const arena=document.getElementById('gameArena'), ball=document.getElementById('gameBall');\n  const a=arena.getBoundingClientRect(), b=brickEl.getBoundingClientRect();\n  const x=b.left-a.left+b.width/2-9, y=b.top-a.top+b.height/2-9;\n  ball.style.transition='transform .16s ease-out'; ball.style.transform='translate('+x+'px,'+y+'px)';\n  setTimeout(()=>{ if(cb) cb(); const w=arena.clientWidth, h=arena.clientHeight; ball.style.transform='translate('+(w/2-9)+'px,'+(h-34)+'px)'; },170);\n}\nfunction resetGameInput(){ const gi=document.getElementById('gameInput'); gi.value=''; gi.blur(); gi.focus(); }\nfunction breakBrick(b){\n  if(b.broken) return;\n  b.broken=true; gScore += diffPoints()+Math.min(gCombo,5); gCombo++; renderGStats(); sfxPop();\n  const arena=document.getElementById('gameArena');\n  flyBall(b.el, ()=>{ b.el.classList.add('shatter'); const a=arena.getBoundingClientRect(), r=b.el.getBoundingClientRect(); burst(arena, r.left-a.left+r.width/2, r.top-a.top+r.height/2, b.colorVar); setTimeout(()=>{ b.el.style.visibility='hidden'; },240); });\n  if(gBricks.every(x=>x.broken)) setTimeout(()=>{ sfxWin(); stageClear(); },300);\n}\nfunction stageClear(){\n  gStage++; renderGStats();\n  const cheers=['🎉 판 깼다! 잘했어요!','⭐ 멋져요! 다음 판 갈까요?','🏆 최고! 계속 가봐요!','👏 완벽해요!'];\n  document.getElementById('gameMsg').textContent=cheers[Math.floor(Math.random()*cheers.length)];\n  setTimeout(newStage,1300);\n}\nfunction handleGame(composing){ if(currentGame==='rain') handleRain(composing); else handleBrick(composing); }\nfunction handleBrick(composing){\n  const gi=document.getElementById('gameInput');\n  if(!gBricks.length || gBricks.every(b=>b.broken)) return;\n  const v=gi.value.trim(); if(!v) return;\n  const hit=gBricks.find(b=>!b.broken && b.text===v);\n  if(hit){ breakBrick(hit); resetGameInput(); return; }\n  if(composing) return;\n  const isPrefix=gBricks.some(b=>!b.broken && b.text.startsWith(v));\n  if(!isPrefix){ gCombo=0; renderGStats(); flashWrong(); sfxWrong(); gi.value=''; }\n}\nfunction startGameTab(){\n  if(currentGame==='rain'){ if(!rainActive) startRain(); else focusInput(); }\n  else if(!gBricks.length || gBricks.every(b=>b.broken)){ newStage(); }\n  else { requestAnimationFrame(parkBall); focusInput(); }\n}\nfunction focusInput(){ const gi=document.getElementById('gameInput'); if(gi && gi.style.display!=='none') gi.focus(); }\nfunction flashWrong(){ const gi=document.getElementById('gameInput'); gi.classList.add('wrong'); setTimeout(()=>gi.classList.remove('wrong'),200); }\nfunction randColorVar(){ return BRICK_COLORS[Math.floor(Math.random()*BRICK_COLORS.length)]; }\n\nfunction ac(){ if(!audioCtx){ try{ audioCtx=new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ return null; } } if(audioCtx.state==='suspended') audioCtx.resume(); return audioCtx; }\nfunction tone(freq,dur,type,vol,when){ if(!soundOn) return; const c=ac(); if(!c) return; const o=c.createOscillator(), g=c.createGain(); o.type=type||'square'; o.frequency.value=freq; o.connect(g); g.connect(c.destination); const t=c.currentTime+(when||0); g.gain.setValueAtTime(vol||0.15,t); g.gain.exponentialRampToValueAtTime(0.0001,t+dur); o.start(t); o.stop(t+dur); }\nfunction sfxPop(){ tone(660,0.12,'square',0.18,0); tone(990,0.10,'square',0.12,0.02); }\nfunction sfxWrong(){ tone(150,0.18,'sawtooth',0.14,0); }\nfunction sfxWin(){ [523,659,784,1046].forEach((f,i)=>tone(f,0.16,'triangle',0.16,i*0.09)); }\nfunction toggleSound(){ soundOn=!soundOn; document.getElementById('soundToggle').textContent=soundOn?'🔊':'🔇'; if(soundOn) tone(880,0.08,'square',0.12,0); }\n\nfunction burst(arena, cx, cy, colorVar){\n  for(let i=0;i<12;i++){\n    const p=document.createElement('div'); p.className='particle';\n    const ang=Math.random()*Math.PI*2, dist=30+Math.random()*55;\n    p.style.setProperty('--dx',(Math.cos(ang)*dist).toFixed(1)+'px');\n    p.style.setProperty('--dy',(Math.sin(ang)*dist).toFixed(1)+'px');\n    p.style.left=(cx-5)+'px'; p.style.top=(cy-5)+'px';\n    p.style.background='var('+(colorVar||randColorVar())+')';\n    arena.appendChild(p); setTimeout(()=>p.remove(),520);\n  }\n}\nfunction selectGame(g){\n  currentGame=g;\n  document.querySelectorAll('.gp-btn').forEach(b=>b.classList.toggle('on', b.dataset.game===g));\n  document.getElementById('brickGame').style.display = g==='brick'?'':'none';\n  document.getElementById('rainGame').style.display  = g==='rain'?'':'none';\n  document.getElementById('pauseBtn').style.display   = g==='rain'?'':'none';\n  document.getElementById('bestStat').style.display   = g==='rain'?'':'none';\n  document.getElementById('rainSpeedRow').style.display = g==='rain'?'':'none';\n  document.getElementById('gThirdLabel').textContent = g==='brick'?'깬 판':'생명';\n  // 글자잡기: 모바일(터치)에선 타자 입력창 숨김+글자 터치, PC에선 타자\n  document.getElementById('gameInput').style.display = (g==='rain' && IS_TOUCH) ? 'none' : '';\n  document.getElementById('gameHint').innerHTML = g==='brick'\n    ? '벽돌에 적힌 글자를 <b>타자로 치면</b> 공이 날아가 벽돌을 깨요! 시간제한은 없으니 <b>천천히 소리 내어 읽고</b> 쳐보세요.'\n    : (IS_TOUCH\n        ? '떨어지는 <b>글자를 정확히 읽고 손가락으로 톡!</b> 눌러 잡아요. 바닥에 닿기 전에! 놓쳐도 괜찮아요 — 생명은 하트로 표시돼요.'\n        : '위에서 <b>떨어지는 글자</b>를 바닥에 닿기 전에 <b>타자로 쳐서</b> 없애요! <b>마우스로 글자를 클릭해도</b> 없앨 수 있어요. 놓쳐도 괜찮아요 — 생명은 하트로 표시돼요.');\n  gScore=0; gCombo=0; gStage=0; document.getElementById('gameMsg').textContent='';\n  if(g==='brick'){ stopRain(); renderGStats(); newStage(); }\n  else { rainLives=3; startRain(); }\n}\nfunction restartGame(){\n  gScore=0; gCombo=0; gStage=0; document.getElementById('gameMsg').textContent='';\n  if(currentGame==='brick'){ renderGStats(); newStage(); }\n  else { rainLives=3; startRain(); }\n}\nfunction stopBrick(){}\nfunction renderRainLives(){ const el=document.getElementById('rainLives'); if(!el) return; const n=Math.max(0,rainLives); el.textContent='❤️'.repeat(n)+'🤍'.repeat(Math.max(0,3-n)); }\nfunction startRain(){\n  stopBrick();\n  rainItems.forEach(it=>it.el.remove()); rainItems=[];\n  rainActive=true; rainPaused=false; rainLives=(rainLives>0?rainLives:3); lastSpawn=0;\n  const btn=document.getElementById('pauseBtn'); if(btn) btn.textContent='⏸️ 일시정지';\n  const ov=document.getElementById('rainPause'); if(ov) ov.style.display='none';\n  gCombo=0; renderGStats(); renderRainLives(); renderBest();\n  if(rainRAF) cancelAnimationFrame(rainRAF);\n  rainRAF=requestAnimationFrame(rainStep); focusInput();\n}\nfunction stopRain(){ rainActive=false; rainPaused=false; if(rainRAF){ cancelAnimationFrame(rainRAF); rainRAF=null; } rainItems.forEach(it=>it.el.remove()); rainItems=[]; }\nfunction togglePause(){\n  if(currentGame!=='rain' || !rainActive) return;\n  rainPaused=!rainPaused;\n  const btn=document.getElementById('pauseBtn'), ov=document.getElementById('rainPause');\n  if(rainPaused){ if(rainRAF){ cancelAnimationFrame(rainRAF); rainRAF=null; } btn.textContent='▶️ 계속하기'; ov.style.display='flex'; }\n  else{ btn.textContent='⏸️ 일시정지'; ov.style.display='none'; lastSpawn=0; rainRAF=requestAnimationFrame(rainStep); focusInput(); }\n}\nfunction spawnRain(W){\n  const pool=currentDiffItems(); if(!pool.length) return;\n  const text=pool[Math.floor(Math.random()*pool.length)];\n  const el=document.createElement('div'); el.className='raindrop'; el.textContent=text;\n  document.getElementById('rainArena').appendChild(el);\n  const w=el.offsetWidth||60; const x=Math.random()*Math.max(1,(W-w-8))+4;\n  el.style.transform='translate('+x+'px,-46px)';\n  const item={text, el, x, y:-46, speed:RAIN_SPEEDS[rainSpeedLevel], dead:false};\n  // 모바일/클릭: 떨어지는 글자를 읽고 그냥 톡 터치하면 잡힘 (타자와 함께 동작)\n  el.addEventListener('pointerdown', e=>{ e.preventDefault(); if(rainActive && !rainPaused && !item.dead) catchRain(item); });\n  rainItems.push(item);\n}\nfunction rainStep(ts){\n  if(!rainActive) return;\n  const arena=document.getElementById('rainArena'); const H=arena.clientHeight, W=arena.clientWidth;\n  if(!lastSpawn) lastSpawn=ts;\n  if(ts-lastSpawn>RAIN_SPAWN_MS && rainItems.length<RAIN_MAX){ spawnRain(W); lastSpawn=ts; }\n  rainItems.forEach(it=>{ if(it.dead) return; it.y+=it.speed; it.el.style.transform='translate('+it.x+'px,'+it.y+'px)'; if(it.y > H-52) missRain(it); });\n  rainItems=rainItems.filter(it=>!it.dead);\n  rainRAF=requestAnimationFrame(rainStep);\n}\nfunction catchRain(it){\n  it.dead=true; const a=document.getElementById('rainArena');\n  burst(a, it.x+it.el.offsetWidth/2, it.y+it.el.offsetHeight/2, randColorVar()); it.el.remove();\n  gScore += diffPoints()+Math.min(gCombo,5); gCombo++; renderGStats();\n  if(gScore>currentBest()){ rainBest[gDiff]=gScore; saveRainBest(); renderBest(); }\n  sfxPop();\n}\nfunction missRain(it){\n  if(it.dead) return;\n  it.dead=true; it.el.classList.add('splash'); const el=it.el; setTimeout(()=>el.remove(),300);\n  gCombo=0; rainLives--; renderRainLives(); renderGStats(); sfxWrong();\n  if(rainLives<=0) rainGameOver();\n}\nfunction rainGameOver(){\n  rainActive=false; if(rainRAF){ cancelAnimationFrame(rainRAF); rainRAF=null; }\n  rainItems.forEach(it=>it.el.remove()); rainItems=[];\n  document.getElementById('gameMsg').textContent='💪 아깝다! 다시 해볼까요?';\n  const btn=document.getElementById('pauseBtn'); if(btn) btn.textContent='⏸️ 일시정지';\n}\nfunction handleRain(composing){\n  if(!rainActive || rainPaused) return;\n  const gi=document.getElementById('gameInput'); const v=gi.value.trim(); if(!v) return;\n  const hits=rainItems.filter(it=>!it.dead && it.text===v);\n  if(hits.length){ hits.sort((a,b)=>b.y-a.y); catchRain(hits[0]); resetGameInput(); return; }\n  if(composing) return;\n  const isPrefix=rainItems.some(it=>!it.dead && it.text.startsWith(v));\n  if(!isPrefix){ gCombo=0; renderGStats(); flashWrong(); sfxWrong(); gi.value=''; }\n}\n(function bindGame(){\n  const gi=document.getElementById('gameInput'); if(!gi) return;\n  gi.addEventListener('input', e=>handleGame(e.isComposing));\n  gi.addEventListener('compositionend', ()=>handleGame(false));\n  gi.addEventListener('keydown', e=>{ if(e.key==='Escape' && currentGame==='rain'){ e.preventDefault(); togglePause(); } });\n})();\n\nfunction shuffle(arr){ const a=arr.slice(); for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; }\n\n/* =========================================================\n   초기화\n   ========================================================= */\nif(!applyLockModeIfNeeded()){\n  renderProgress();\n  renderZones();\n  renderBoard();\n  renderCollected();\n}\n</script>\n</body>\n</html>\n"